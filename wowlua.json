{
  "$schema": "https://raw.githubusercontent.com/DomenikIrrgang/wowlua/main/schema/wowlua-0.1.json",
  "package": {
    "name": "suuui",
    "version": "0.5.0-beta.7",
    "wowlua": "^0.9"
  },
  "addon": {
    "name": "SuuUI",
    "title": "SuuUI",
    "notes": "A full interface replacement for WoW Forever. Quiet until it matters.",
    "icon-texture": "Interface\\AddOns\\SuuUI\\Media\\Textures\\Mark",
    "saved-variables": [
      "SuuUIDB",
      "SuuUIProbe"
    ],
    "toc-extra": {
      "AllowLoadGameType": "camelot"
    }
  },
  "flavors": {
    "camelot": {}
  },
  "dependencies": {
    "foreverlfg": {
      "path": "libs/ForeverLFG"
    }
  },
  "build": {
    "assets": [
      "Media/**/*.{tga,blp,png,jpg,jpeg,ogg,mp3,wav,ttf,otf}"
    ]
  },
  "publish": {
    "targets": {
      "curseforge": {
        "type": "curseforge",
        "project-id": 1742945,
        "profile": "readable"
      },
      "wago": {
        "type": "wago",
        "project-id": "nGv9QzKx",
        "profile": "readable"
      },
      "github": {
        "type": "github",
        "repository": "DomenikIrrgang/suuui",
        "profile": "release"
      }
    }
  },
  "profiles": {
    "release": {
      "bundle": true,
      "minify": "max",
      "minify-libraries": true,
      "optimize": {
        "inline": true,
        "cache-globals": "safe",
        "dead-code": true
      }
    },
    "readable": {
      "inherits": "release",
      "bundle": true,
      "minify": "none",
      "minify-libraries": false,
      "optimize": {
        "inline": false,
        "cache-globals": "off",
        "dead-code": false
      }
    },
    "test": {
      "runtime-checks": "exports"
    }
  },
  "test": {
    "blizzard-ui": true,
    "coverage": {
      "lines": 88,
      "branches": 63.5,
      "functions": 84,
      "conditions": 60
    }
  },
  "check": {
    "mode": "strict"
  },
  "workspace": {
    "members": [
      "libs/*",
      "Examples/*"
    ]
  }
}
