-- HelloPlugin.wowlua
-- A minimal SuuUI plugin: one module with a setting, a chat command, a game
-- event and a message. Build it with `wowlua build` (or install it with
-- `wowlua install`) from this folder; SuuUI must be installed too.
--
--   /suu enable hello        turns it on (it starts off)
--   /suu                     its section is under Plugins in the settings window
--   /suu modules             lists it next to SuuUI's own modules
--   /suu hello               says the greeting
--   /suu set hello.greeting Well met
--   /suu disable hello       removes it at once, command and all
--   /suu edit                drag the Hello frame; it stays where you leave it
--   /suu set hello.failOnEnable on, then /suu disable hello and /suu enable hello
--                            shows how a failing plugin is contained

-- SuuUI's types: a plugin may import them (`import type`), not its code;
-- SuuUI's values come through the SuuUI global.
import type Panel from "suuui/UI/Panel"
import type Text from "suuui/UI/Text"

-- What the plugin keeps while it runs.
local targets = 0
local frame: (Panel & { text: Text })? = nil

SuuUI.RegisterModule({
    id = "hello",
    name = "Hello",
    description = "An example plugin that says hello.",
    api = "0.4",
    -- off until turned on (/suu enable hello, or its section)
    enabledByDefault = false,
    defaults = {
        greeting = "Hello from a SuuUI plugin",
        failOnEnable = false,
        position = { point = "TOP", x = 0, y = -160 }, -- moved in /suu edit
    },
    OnInitialize = function()
        targets = 0
    end,
    OnEnable = function(self)
        if self:Get("failOnEnable") then
            error("failing on purpose (hello.failOnEnable is on)")
        end

        self:RegisterCommand("hello", "Say the Hello plugin's greeting.", function()
            self:Print(
                self:Get("greeting"),
                `(you changed target {targets} times)`
            )
        end)

        -- A small frame on the screen, built from SuuUI's own components and
        -- movable in SuuUI's edit mode.
        local f = frame
        if not f then
            local UI = SuuUI.UI
            local made = UI.Panel(SuuUI.Root, { title = "Hello", meta = "example plugin", width = 220 }) :: Panel
                & { text: Text }
            made.text = UI.Text(made.body, "body", "ink")
            made.text:SetPoint("TOPLEFT")
            made.body:SetHeight(SuuUI.Tokens.type.body.lineHeight)
            frame, f = made, made
        end
        f.text:SetValue(self:Get("greeting"))
        f:Show()
        self:RegisterMover(f, { key = "position", label = "Hello" })

        self:Watch("greeting", function(greeting: string)
            self:Print("New greeting:", greeting)
            f.text:SetValue(greeting)
        end)

        self:OnGameEvent("PLAYER_TARGET_CHANGED", function()
            targets += 1
        end)

        self:On("SUUUI_MODULE_ENABLED", function(_, id: string)
            if id ~= self.id then
                self:Print("Another module turned on:", id)
            end
        end)

        -- A section in SuuUI's settings window, beside the built-in ones.
        self:RegisterSettings({
            id = "hello",
            label = "Hello",
            groups = {
                {
                    title = "Greeting",
                    description = "An example plugin's own settings.",
                    rows = {
                        {
                            key = "greeting",
                            label = "Greeting",
                            control = "text",
                            width = 240,
                            description = "What /suu hello says.",
                        },
                        {
                            key = "failOnEnable",
                            label = "Fail on enable",
                            control = "toggle",
                            description = "Makes the plugin fail the next time it turns on, to show how SuuUI contains a broken plugin.",
                        },
                    },
                },
            },
        })

        self:Print(self:Get("greeting"))
    end,
    OnDisable = function(self)
        if frame then
            frame:Hide()
        end
        self:Print("Goodbye.")
    end,
})
