-- UI/ThreatMeter.wowlua
-- The threat meter (design board "Threat meter"): a glass panel `meter-w`
-- wide, "Threat" and "on <target>" in its head, then rows `meter-row` tall.
-- It always keeps the height of `rows` rows (the damage meter's, beside it).
--
--   local m = threatMeter(parent, { rows = 8 })
--   m:SetTarget(name)               -- may be secret (an enemy in a dungeon)
--   m:SetRows(list, opts)
--   m:SetMaxRows(n)                 -- 0.10: the height in rows, live
--
-- list: { { name, class, role, status, percent, raw, you }, ... } in group
-- order. role "TANK", "HEALER", "DAMAGER", "PET" or nil; status 0-3
-- (UnitThreatSituation; nil while unknown); percent the scaled % (0-100,
-- 100 pulls aggro) and raw the threat value, either possibly secret (nil:
-- unknown). opts:
--   show     "group" | "tanks" (tanks, pets and you) | "self"
--   byState  rows go by threat state, then group order (when the client
--            won't let the % be compared: a secret %), with a note in the
--            last slot; otherwise by % and ranked
--   marker   "role" | "class" | "none": what leads the name
--   raw      the threat number before the %
--   nameColor "class" | "ink"
-- Your row is outlined in ink; past the visible rows it takes the last slot.
--
-- States (only from the status, so they work on bosses too): a tank or pet
-- at 2 "Losing" (amber); anyone else at 2-3 "Aggro" (ember, glowing), at 1
-- "Pulling" (amber). A tank or pet holding the mob reads "Tanking".

import isSecret, isNumber from "wowlua:secret"
import tokens as T, Color from "/Core/Tokens"
import mixins from "/Core/Init"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import stateBadge, StateBadge from "/UI/Controls"

const S = T.space
const COLORS = T.color :: { [string]: Color }

const WHITE = "Interface\\Buttons\\WHITE8X8"

local ROLE_ICON: { [string]: string } = {
    TANK = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleTank.tga",
    HEALER = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleHealer.tga",
    DAMAGER = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleDamage.tga",
}
const CLASS_ICONS = "Interface\\TargetingFrame\\UI-Classes-Circles"

-- One row of the list (see the top). Name, % and raw may be secret.
export type ThreatEntry = {
    name?: string | Secret<string>,
    class?: string,
    role?: string,
    status?: number | Secret<number>,
    percent?: number | Secret<number>,
    raw?: number | Secret<number>,
    you?: boolean,
}

-- the rows the meter keeps its height for
export type ThreatMeterOptions = { rows?: number }
-- SetRows' options (see the top).
export type ThreatOptions = { show?: string, byState?: boolean, marker?: string, raw?: boolean, nameColor?: string }

-- A row of the meter.

-- The meter threatMeter makes.

local function holder(role: string?): boolean
    return role == "TANK" or role == "PET"
end
-- a readable number (a secret one is never compared)
const PCT_W = 34
const RAW_W = 38

-- The state a row shows: tone and word, or nil.
local function stateOf(r: ThreatEntry): (string?, string?)
    local s = r.status
    if isSecret(s) or type(s) ~= "number" then
        return nil, nil
    end
    if holder(r.role) then
        return s == 2 and "warning" or nil, s == 2 and "Losing" or nil
    end
    if s >= 2 then
        return "danger", "Aggro"
    end
    if s == 1 then
        return "warning", "Pulling"
    end
    return nil, nil
end

-- a 70/30 mix of a token and surface-sunk (the design's colour-mix)
local function mix(token: string): (number, number, number)
    local r, g, b = draw.rgba(token)
    local sr, sg, sb = draw.rgba("surface-sunk")
    return r * 0.7 + sr * 0.3, g * 0.7 + sg * 0.3, b * 0.7 + sb * 0.3
end

-- the bar's fill: unit-fill-deep to unit-fill, each mixed (draw.bind: again
-- after a theme change)
local function fillGradient(t: Texture)
    local r1, g1, b1 = mix("unit-fill-deep")
    local r2, g2, b2 = mix("unit-fill")
    t:SetGradient("HORIZONTAL", CreateColor(r1, g1, b1, 1), CreateColor(r2, g2, b2, 1))
end

--------------------------------------------------------------------------------
-- Rows
--------------------------------------------------------------------------------

export class ThreatRow extends Frame
    bar: StatusBar
    edge: draw.Border
    glow: draw.SoftEdge
    rank: Text
    mark: Texture
    name: Text
    pct: Text
    raw: Text
    badge: StateBadge
    sub: Text

    constructor(m: ThreatMeter)
        local h = draw.size("meter-row")
        super(nil, m.body)
        self:SetSize(m.innerW, h)
        draw.fill(self, "surface-sunk", "BACKGROUND"):SetAllPoints()
        self.bar = CreateFrame("StatusBar", nil, self)
        self.bar:SetAllPoints()
        self.bar:SetStatusBarTexture(WHITE)
        self.bar:SetMinMaxValues(0, 100)
        draw.bind(self.bar:GetStatusBarTexture(), fillGradient)
        self.edge = draw.border(self.bar, "gilt-hairline", { layer = "OVERLAY" })
        self.glow = draw.shadow(self, "glow-ember")
        local o = CreateFrame("Frame", nil, self)
        o:SetAllPoints()
        o:SetFrameLevel(self.bar:GetFrameLevel() + 2)
        self.rank = text(o, "caption", "ink")
        self.rank:SetWidth(12)
        self.rank:SetJustifyH("RIGHT")
        self.mark = o:CreateTexture(nil, "OVERLAY")
        self.name = text(o, "label", "ink")
        self.name:SetShadowed(true)
        self.name:SetWordWrap(false)
        self.pct = text(o, "numeric", "ink")
        self.pct:SetShadowed(true)
        self.pct:SetFixedWidth(PCT_W)
        self.pct:SetJustifyH("RIGHT")
        self.pct:SetPoint("RIGHT", -S["space-3"], 0)
        self.raw = text(o, "caption", "ink")
        self.raw:SetShadowed(true)
        self.raw:SetFixedWidth(RAW_W)
        self.raw:SetJustifyH("RIGHT")
        self.raw:SetPoint("RIGHT", self.pct, "LEFT", -S["space-2"], 0)
        self.badge = stateBadge(o, "danger", "Aggro")
        self.sub = text(o, "caption", "ink")
        self.sub:SetShadowed(true)
    end

    function Set(r: ThreatEntry, rank: number?, opts: ThreatOptions)
        local tone, word = stateOf(r)
        -- the edge: your row ink; a state's colour over it
        self.edge:SetColor(
            tone == "danger" and "ember" or tone == "warning" and "amber" or r.you and "ink" or "gilt-hairline"
        )
        self.glow:SetShown(tone == "danger")
        -- the fill: the scaled %, straight to the engine (a secret one too)
        local pct: number | Secret<number> = 0
        local known = false
        local given = r.percent
        if isSecret(given) or type(given) == "number" then
            pct, known = given, true
        end
        self.bar:SetValue(pct)
        -- rank (by % only)
        local x = S["space-2"]
        if rank then
            self.rank:SetValue(rank)
            self.rank:SetVisible(true)
            self.rank:ClearAllPoints()
            self.rank:SetPoint("LEFT", x, 0)
            x = x + 12 + S["space-3"]
        else
            self.rank:SetVisible(false)
        end
        -- the mark before the name
        self.mark:Hide()
        local marker = opts.marker or "role"
        if marker == "role" and ROLE_ICON[r.role] then
            self.mark:SetTexture(ROLE_ICON[r.role])
            self.mark:SetTexCoord(0, 1, 0, 1)
            self.mark:SetSize(11, 11)
        elseif marker == "class" and r.class and CLASS_ICON_TCOORDS and CLASS_ICON_TCOORDS[r.class] then
            self.mark:SetTexture(CLASS_ICONS)
            local tc: number[] = CLASS_ICON_TCOORDS[r.class]
            self.mark:SetTexCoord(tc[1], tc[2], tc[3], tc[4])
            self.mark:SetSize(16, 16)
        else
            marker = nil
        end
        if marker then
            self.mark:ClearAllPoints()
            self.mark:SetPoint("LEFT", x, 0)
            self.mark:Show()
            x = x + self.mark:GetWidth() + S["space-3"] - (marker == "role" and 0 or S["space-1"])
        end
        self.name:SetValue(r.name or "")
        local class = r.class
        local classColor = opts.nameColor ~= "ink" and class and COLORS["class-" .. class:lower()]
        self.name:SetColor(classColor and class and ("class-" .. class:lower()) or "ink")
        -- the right end (fixed widths: a secret % can't be measured): the %,
        -- the raw threat before it, then the badge or "Tanking", then the name
        if known then
            self.pct:SetFormattedText("%.0f%%", pct)
            self.pct.value = nil
        else
            self.pct:SetValue("")
        end
        local raw = r.raw
        local right = self.pct
        if opts.raw and isNumber(raw) then
            -- threat values come at 100x; a secret one can't be divided, so it's left out
            self.raw:SetValue(AbbreviateNumbers and AbbreviateNumbers(raw / 100) or tostring(math.floor(raw / 100)))
            self.raw:SetVisible(true)
            right = self.raw
        else
            self.raw:SetVisible(false)
        end
        local holds = isNumber(r.status) and r.status >= 2 and not word and holder(r.role)
        self.sub:SetValue(holds and (r.role == "PET" and "Pet tanking" or "Tanking") or "")
        self.sub:ClearAllPoints()
        self.sub:SetPoint("RIGHT", right, "LEFT", -S["space-3"], 0)
        self.badge:ClearAllPoints()
        self.badge:SetPoint("RIGHT", right, "LEFT", -S["space-3"], 0)
        self.badge:SetShown(word ~= nil)
        if word then
            self.badge:SetState(tone, word)
        end
        local nameEnd = word and self.badge or (holds and self.sub) or right
        self.name:ClearAllPoints()
        self.name:SetPoint("LEFT", x, 0)
        self.name:SetPoint("RIGHT", nameEnd, "LEFT", -S["space-3"], 0)
        self.name:SetJustifyH("LEFT")
        self:Show()
    end
end

local function buildRow(m: ThreatMeter): ThreatRow
    return ThreatRow.new(m)
end

--------------------------------------------------------------------------------
-- The meter
--------------------------------------------------------------------------------

local function STATUS_RANK(r: ThreatEntry): number
    return isNumber(r.status) and r.status or -1
end

type Entry = { r: ThreatEntry, i: number }

export class ThreatMeter extends Frame
    maxRows: number
    innerW: number
    title: Text
    target: Text
    body: Frame
    rows: ThreatRow[]
    pinLine: Texture
    note: Text
    empty: Text

    constructor(parent: Frame, options: ThreatMeterOptions?)
        local opts = options or {}
        super(nil, parent)
        self.maxRows = math.max(2, opts.rows or 8)
        local w = draw.size("meter-w")
        local h, gap = draw.size("meter-row"), S["space-1"]
        local head = 32
        local bodyH = S["space-3"] * 2 + self.maxRows * h + (self.maxRows - 1) * gap
        self:SetSize(w, head + 1 + bodyH)
        self.innerW = w - S["space-3"] * 2
        -- the glass panel
        draw.fill(self, "surface-glass", "BACKGROUND"):SetAllPoints()
        draw.border(self, "gilt-line")
        draw.shadow(self, "shadow-panel")
        -- head: "Threat", and "on <target>" at the right
        self.title = text(self, "header", "gilt-text")
        self.title:SetPoint("LEFT", self, "TOPLEFT", S["space-3"] + S["space-1"], -head / 2)
        self.title:SetValue("Threat")
        self.target = text(self, "caption", "ink-muted")
        self.target:SetPoint("RIGHT", self, "TOPRIGHT", -S["space-2"] - S["space-2"], -head / 2)
        self.target:SetJustifyH("RIGHT")
        self.target:SetWordWrap(false)
        -- a secret name can't be measured: the target gets the head's free width
        self.target:SetWidth(w - 90)
        local rule = self:CreateTexture(nil, "BORDER")
        draw.paintFill(rule, "gilt-faint")
        rule:SetPoint("TOPLEFT", 1, -head)
        rule:SetPoint("TOPRIGHT", -1, -head)
        rule:SetHeight(1)
        self.body = CreateFrame("Frame", nil, self)
        self.body:SetPoint("TOPLEFT", 0, -head - 1)
        self.body:SetPoint("BOTTOMRIGHT")
        self.rows = {}
        self.pinLine = self.body:CreateTexture(nil, "ARTWORK")
        draw.paintFill(self.pinLine, "gilt-line")
        self.pinLine:SetHeight(1)
        self.pinLine:Hide()
        self.note = text(self.body, "caption", "ink-muted")
        self.note:SetPoint("BOTTOMLEFT", S["space-3"], S["space-3"])
        self.note:SetHeight(h)
        self.note:SetValue("Boss: by threat state, then group")
        self.note:SetVisible(false)
        self.empty = text(self.body, "caption", "ink-muted")
        self.empty:SetPoint("LEFT", S["space-5"], 0)
        self.empty:SetPoint("RIGHT", -S["space-5"], 0)
        self.empty:SetJustifyH("CENTER")
        self.empty:SetWordWrap(true)
        self.empty:SetValue("No threat on your target yet.")
        self:SetTarget(nil)
        self:SetRows({}, {})
        extend.add(extend.Kind.Meter, self, { meter = "threat" })
    end

    function SetTarget(name: string | Secret<string> | nil)
        if not isSecret(name) and name == nil then
            self.target:SetValue("")
            return
        end
        self.target:SetFormattedText("on %s", name)
        self.target.value = nil
    end

    -- The rows the meter keeps its height for (the damage meter's), live.
    function SetMaxRows(n: number?)
        self.maxRows = math.max(2, n or 8)
        local h, gap = draw.size("meter-row"), S["space-1"]
        self:SetHeight(32 + 1 + S["space-3"] * 2 + self.maxRows * h + (self.maxRows - 1) * gap)
        for i = self.maxRows + 1, #self.rows do
            self.rows[i]:Hide()
        end
    end

    function SetRows(list: ThreatEntry[]?, options: ThreatOptions?)
        local opts = options or {}
        local show = opts.show or "group"
        local rows: Entry[] = {}
        for i, r in ipairs(list or {}) do
            if show == "group" or r.you or (show == "tanks" and holder(r.role)) then
                rows[#rows + 1] = { r = r, i = i }
            end
        end
        local byState = opts.byState
        table.sort(rows, function(a: Entry, b: Entry): boolean
            if byState then
                local sa, sb = STATUS_RANK(a.r), STATUS_RANK(b.r)
                if sa ~= sb then
                    return sa > sb
                end
            else
                local pa = isNumber(a.r.percent) and a.r.percent or -1
                local pb = isNumber(b.r.percent) and b.r.percent or -1
                if pa ~= pb then
                    return pa > pb
                end
            end
            return a.i < b.i
        end)
        local max = self.maxRows
        local note = byState and show ~= "self" and #rows > 0
        local slots = note and max - 1 or max
        local n = math.min(slots, #rows)
        local youAt: number? = nil
        for i, x in ipairs(rows) do
            if x.r.you then
                youAt = i
            end
        end
        local pin = youAt and youAt > n
        local h, gap = draw.size("meter-row"), S["space-1"]
        local ranked = not byState and show ~= "self"
        for i = 1, max do
            local x = rows[i]
            if pin and i == n then
                x = rows[youAt :: number]
            end
            local row = self.rows[i]
            if x and i <= n then
                if not row then
                    row = buildRow(self)
                    self.rows[i] = row
                end
                row:ClearAllPoints()
                row:SetPoint("TOPLEFT", self.body, "TOPLEFT", S["space-3"], -S["space-3"] - (i - 1) * (h + gap))
                local rank = ranked and (pin and i == n and youAt or i) or nil
                row:Set(x.r, rank, opts)
            elseif row then
                row:Hide()
            end
        end
        -- your pinned row sits under a dashed line (here: a gilt-line hairline)
        self.pinLine:SetShown(pin and true or false)
        if pin then
            self.pinLine:ClearAllPoints()
            self.pinLine:SetPoint("BOTTOMLEFT", self.rows[n], "TOPLEFT", 0, gap / 2)
            self.pinLine:SetPoint("BOTTOMRIGHT", self.rows[n], "TOPRIGHT", 0, gap / 2)
        end
        self.note:SetVisible(note and true or false)
        self.empty:SetVisible(#rows == 0)
    end
end
mixins.ThreatMeter = ThreatMeter

export function threatMeter(parent: Frame, options: ThreatMeterOptions?): ThreatMeter
    return ThreatMeter.new(parent, options)
end
