-- UI/Loot.wowlua
-- The loot window (design board "Loot window and loot rolls"): a panel
-- titled "Loot" with the corpse's name as its meta, one row per thing to
-- take: its slot (36px, quality border, count) and its name in its quality
-- colour; money as the coin and "42s 3c".
--
--   local lw = lootWindow(parent, { name })
--   lw:SetSource("Ember Hound")
--   lw:SetItems({ { icon, count, quality, label, copper, locked }, … })
--   lw.onClick = fn(index, mouseButton)   -- a row clicked
--   lw.onEnter = fn(index, row), lw.onLeave = fn(index, row)
--   lw.onClose = fn()                     -- the close button
--   lw:FirstSlotOffset()                  -- the first slot's centre from the
--                                         -- panel's top left (to put it
--                                         -- under the cursor)

import tokens as T from "/Core/Tokens"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import itemSlot, money, ItemSlot, Money from "/UI/Inventory"
import Panel from "/UI/Panel"

local S = T.space

local SLOT = T.size["slot"]
local GAP = S["space-2"]
local WIDTH = 260
local BODY_W = WIDTH - S["space-5"] * 2

-- An item the window lists: its slot (what onClick gets, default the
-- position), icon, count, quality, label or money, and whether it's locked.
export type LootItem = {
    index?: number,
    icon?: string | number,
    count?: number,
    quality?: string,
    label?: string,
    copper?: number,
    locked?: boolean,
}

-- A row: the slot, the label or the money, and the loot slot it shows.
export class LootRow extends Button
    readonly hover: Texture
    readonly slot: ItemSlot
    readonly label: Text
    readonly money: Money
    index: number = 0

    constructor(lw: LootWindow)
        super(nil, lw.body)
        self:SetSize(BODY_W, SLOT)
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.hover = draw.fill(self, "surface-raised", "BACKGROUND")
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.slot = itemSlot(self)
        self.slot:SetPoint("LEFT")
        self.slot:EnableMouse(false)
        self.label = text(self, "label", "ink")
        self.label:SetPoint("LEFT", self.slot, "RIGHT", S["space-4"], 0)
        self.label:SetPoint("RIGHT", -S["space-3"], 0)
        self.label:SetJustifyH("LEFT")
        self.money = money(self)
        self.money:SetPoint("LEFT", self.slot, "RIGHT", S["space-4"], 0)
        self.money.text:ClearAllPoints()
        self.money.text:SetPoint("LEFT")
        local skin = self.slot.skin
        self:SetScript("OnClick", function(_, button: string) if lw.onClick then lw.onClick(self.index, button) end end)
        self:SetScript("OnEnter", function()
            self.hover:Show()
            skin.hover = true
            skin:Draw()
            if lw.onEnter then lw.onEnter(self.index, self) end
        end)
        self:SetScript("OnLeave", function()
            self.hover:Hide()
            skin.hover = false
            skin:Draw()
            if lw.onLeave then lw.onLeave(self.index, self) end
        end)
    end
end

export class LootWindow extends Panel
    rows: LootRow[] = {}
    onClose: (() -> ())? = nil
    -- a row clicked, entered or left: its loot slot (and the button)
    onClick: ((slot: number, button: string) -> ())? = nil
    onEnter: ((slot: number, row: LootRow) -> ())? = nil
    onLeave: ((slot: number, row: LootRow) -> ())? = nil

    constructor(parent: Frame, opts: { name?: string }?)
        local o = opts or {}
        super(parent, { name = o.name, title = "Loot", meta = "", closable = true,
            -- (made before `super`: the panel it gets is this window)
            onClose = function(p: Panel)
                local lw = p :: LootWindow
                if lw.onClose then lw.onClose() else lw:Hide() end
            end })
        self:SetItems({})
    end

    private function Row(i: number): LootRow
        local r = self.rows[i]
        if not r then
            r = LootRow.new(self)
            self.rows[i] = r
        end
        return r
    end

    function SetSource(source: string?)
        self:SetTitle("Loot", source or "")
    end

    -- items: { { index, icon, count, quality, label, copper, locked } … } in
    -- order; `index` is what onClick gets (the loot slot), default the position.
    function SetItems(items: LootItem[])
        for i, item in ipairs(items) do
            local r = self:Row(i)
            r.index = item.index or i
            r.slot.skin:SetItem({ icon = item.icon, count = item.count, quality = item.quality or "common", locked = item.locked })
            if item.copper then
                r.label:Hide()
                r.money:SetCopper(item.copper)
                r.money:Show()
            else
                r.money:Hide()
                r.label:Show()
                r.label:SetValue(item.label or "")
                local q = item.quality
                r.label:SetColor((q and q ~= "common") and ("quality-" .. q) or "ink")
            end
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -(i - 1) * (SLOT + GAP))
            r:Show()
        end
        for i = #items + 1, #self.rows do self.rows[i]:Hide() end
        local n = math.max(1, #items)
        self.body:SetSize(BODY_W, n * SLOT + (n - 1) * GAP)
    end

    function FirstSlotOffset(): (number, number)
        return S["space-5"] + SLOT / 2, self:BodyTop() + SLOT / 2
    end
end

export function lootWindow(parent: Frame, opts: { name?: string }?): LootWindow
    return LootWindow.new(parent, opts)
end
