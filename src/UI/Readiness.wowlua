-- UI/Readiness.wowlua
-- Readiness (design board "Insight · Readiness"): a glass panel 340px wide,
-- "Readiness" and "before pull" in its head, one row per shared cooldown:
-- its icon (dim while it cools down), the spell, who has it (class diamond
-- and name), and "Ready" in arcane or the time left. A Ready check button in
-- the foot for whoever may start one.
--
--   local r = readiness(parent, { onReadyCheck = fn })
--   r:SetRows({ { icon, spell, who, class, endsAt (GetTime() it's ready; nil: ready) }, ... })
--   r:SetActionShown(on)

import tokens as T, Color from "/Core/Tokens"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import icon, Icon from "/UI/Icon"
import Panel from "/UI/Panel"
import button, SuuButton from "/UI/Controls"

const S = T.space
const COLORS = T.color :: { [string]: Color }

const WIDTH = 340
const ROW_H = draw.size("icon-md") + S["space-3"] * 2

local function fmtLeft(s: number): string
    s = math.max(0, math.ceil(s))
    if s >= 60 then return ("%d:%02d"):format(math.floor(s / 60), s % 60) end
    return ("%ds"):format(s)
end

export type Entry = { icon?: string | number, spell?: string, who?: string, class?: string, endsAt?: number }

-- what the ready check button calls
export type ReadinessOptions = { onReadyCheck?: () -> () }

-- The panel readiness makes.

-- One row: a shared cooldown.
export class ReadinessRow extends Frame
    rule: Texture
    icon: Icon
    spell: Text
    diamond: Texture
    who: Text
    status: Text

    constructor(r: Readiness, i: number)
        super(nil, r.body)
        self:SetSize(WIDTH - S["space-5"] * 2, ROW_H)
        self.rule = self:CreateTexture(nil, "BORDER")
        draw.paintFill(self.rule, "gilt-faint")
        self.rule:SetPoint("TOPLEFT")
        self.rule:SetPoint("TOPRIGHT")
        self.rule:SetHeight(1)
        self.icon = icon(self, "icon-md")
        self.icon:SetPoint("LEFT", 0, 0)
        self.spell = text(self, "label", "ink")
        self.spell:SetPoint("LEFT", self.icon, "RIGHT", S["space-4"], 0)
        self.spell:SetWordWrap(false)
        self.diamond = draw.diamond(self, 5, "gilt")
        self.diamond:SetPoint("LEFT", self.spell, "RIGHT", S["space-4"] + 2, 0)
        self.who = text(self, "caption", "ink-muted")
        self.who:SetPoint("LEFT", self.diamond, "RIGHT", S["space-3"], 0)
        self.who:SetWordWrap(false)
        self.status = text(self, "label", "arcane")
        self.status:SetPoint("RIGHT", 0, 0)
        self.status:SetJustifyH("RIGHT")
        r.rows[i] = self
    end
end

local function buildRow(r: Readiness, i: number): ReadinessRow
    return ReadinessRow.new(r, i)
end

export class Readiness extends Panel
    rows: ReadinessRow[]
    data: Entry[]
    footRule: Texture
    action: SuuButton
    actionShown: boolean
    listH: number? = nil

    constructor(parent: Frame, options: ReadinessOptions?)
        local opts = options or {}
        super(parent, { title = "Readiness", meta = "before pull", width = WIDTH })
        self.rows, self.data = {}, {}
        self.footRule = self.body:CreateTexture(nil, "BORDER")
        draw.paintFill(self.footRule, "gilt-faint")
        self.footRule:SetHeight(1)
        self.action = button(self.body, { variant = "primary", text = "Ready check",
            onClick = function() if opts.onReadyCheck then opts.onReadyCheck() end end })
        self.actionShown = false
        local wait = 0
        self:SetScript("OnUpdate", function(_, elapsed: number)
            wait = wait - elapsed
            if wait > 0 then return end
            wait = 0.5
            self:Update()
        end)
        self:SetRows({})
    end

    function Update()
        local now = GetTime()
        for i, d in ipairs(self.data) do
            local row = self.rows[i]
            local left = d.endsAt and d.endsAt - now or 0
            if left > 0 then
                row.icon:SetState("dim")
                row.status:SetStyle("numeric")
                row.status:SetColor("ink-muted")
                row.status:SetValue(fmtLeft(left))
            else
                row.icon:SetState("rest")
                row.status:SetStyle("label")
                row.status:SetColor("arcane")
                row.status:SetValue("Ready")
            end
        end
    end

    function SetRows(list: Entry[]?)
        self.data = list or {}
        local y = 0
        for i, d in ipairs(self.data) do
            local row = self.rows[i] or buildRow(self, i)
            row:ClearAllPoints()
            row:SetPoint("TOPLEFT", 0, -y)
            row.rule:SetShown(i > 1)
            row.icon:SetArt(d.icon or 134400)
            row.spell:SetValue(d.spell or "")
            row.who:SetValue(d.who or "")
            local c = d.class and COLORS["class-" .. d.class:lower()] and ("class-" .. d.class:lower())
            row.diamond:SetShown(c and true or false)
            if c then draw.paint(row.diamond, c) end
            row:Show()
            y = y + ROW_H
        end
        for i = #self.data + 1, #self.rows do self.rows[i]:Hide() end
        self:Update()
        self:Layout(y)
    end

    function SetActionShown(on: unknown)
        self.actionShown = on ~= nil and on ~= false
        self:Layout(self.listH or 0)
    end

    function Layout(listH: number)
        self.listH = listH
        local foot = 0
        self.footRule:SetShown(self.actionShown)
        self.action:SetShown(self.actionShown)
        if self.actionShown then
            self.footRule:ClearAllPoints()
            self.footRule:SetPoint("TOPLEFT", self.body, "TOPLEFT", 0, -(listH + S["space-4"]))
            self.footRule:SetPoint("TOPRIGHT", self.body, "TOPRIGHT", 0, -(listH + S["space-4"]))
            self.action:ClearAllPoints()
            self.action:SetPoint("TOPRIGHT", self.footRule, "BOTTOMRIGHT", 0, -S["space-4"])
            foot = S["space-4"] * 2 + 1 + 30
        end
        self.body:SetSize(WIDTH - S["space-5"] * 2, math.max(1, listH + foot))
        self:Fit()
    end
end

export function readiness(parent: Frame, options: ReadinessOptions?): Readiness
    return Readiness.new(parent, options)
end
