-- UI/CastBar.wowlua
-- A cast in progress. An enemy cast you can stop is the arcane one; everything
-- else stays neutral.
--
--   local bar = castBar(parent, "target", {
--       size = "sm",          -- "md" (cast, 24px: your own cast) or "sm" (cast-sm, 18px: under a unit frame),
--                             -- or "plate" (cast-plate, 8px, the spell line under the bar: nameplates;
--                             -- the spell's icon leads the line; the lock sits inside the bar's left end)
--       width = 300,
--       icon = true,          -- the spell's icon as a square at the left end
--       kick = true,          -- your interrupt's state at the right end of interruptible casts
--       target = true,        -- 0.9: who the spell is aimed at; plates: a line under the spell name,
--                             -- other sizes: after it, "Spell › Target", in the spell name's width
--   })
--   bar:Activate(); bar:Deactivate()
--   bar:SetIconShown(on); bar:SetKickShown(on)   -- live, from the settings
--   bar:SetUnit(unit)                             -- another unit (nameplate tokens are reused)
--   bar:SetBarHeight(px)                          -- 0.9: the bar's height (a plate's spell line stays under it)
--   bar:SetTargetShown(on)                        -- 0.9: the cast's target, live
--   bar:SetBarWidth(px)                           -- 0.9: the whole bar's width, live
--   bar:SetNeutral(on)                            -- 0.9: a friendly unit's cast: never "you can stop it"
--                                                 -- (no arcane layer, lock or interrupt); a plate's
--                                                 -- owner sets it, other bars at each cast start
--
-- Everything the client may hide is shown without being read: the fill runs
-- from the cast's duration object (StatusBar:SetTimerDuration), the time is
-- the duration's remaining time handed to SetFormattedText, the spell name
-- and icon go straight to the text and texture, and the "can't be
-- interrupted" flag (a secret boolean in combat) sets the alpha of the arcane
-- layer and the lock through SetAlphaFromBoolean on host frames (on a texture
-- it renders invisible on this client). Your own interrupt's "ready" is the
-- readable isActive of its cooldown.

import * as secret from "wowlua:secret"
import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as events from "/Core/Events"
import * as extend from "/Core/Extend"
import debug from "/Core/Settings"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as controls from "/UI/Controls"

const S = T.space

local WHITE = "Interface\\Buttons\\WHITE8X8"
local LOCK = "Interface\\LFGFrame\\UI-LFG-ICON-LOCK"
local DIR = Enum.StatusBarTimerDirection
-- wowlua:secret's isSecret as a local predicate: an imported one doesn't
-- narrow in wowlua 0.9.1 while the project has an import cycle (port notes)
local function isSecret(v: unknown): v is Secret<unknown> return secret.isSecret(v) end
local LINE = 13 -- a plate's spell line under the bar

--------------------------------------------------------------------------------
-- Your interrupt: the first of your class's interrupts you know.
--------------------------------------------------------------------------------

-- Per class, interrupt families in order of preference, each with its ranks.
local INTERRUPTS: { [string]: number[][] } = {
    ROGUE = { { 1766, 1767, 1768, 1769 } },                              -- Kick
    WARRIOR = { { 6552, 6554 }, { 72, 1671, 1672 } },                    -- Pummel, then Shield Bash
    SHAMAN = { { 8042, 8044, 8045, 8046, 10412, 10413, 10414 } },        -- Earth Shock
    MAGE = { { 2139 } },                                                 -- Counterspell
    PRIEST = { { 15487 } },                                              -- Silence
    PALADIN = { { 853, 5588, 5589, 10308 } },                            -- Hammer of Justice
    DRUID = { { 5211, 6798, 8983 } },                                    -- Bash
    HUNTER = { { 19503 } },                                              -- Scatter Shot
}

-- Each interrupt's own cooldown in seconds, if the client can't tell us
-- (GetSpellBaseCooldown): vanilla values.
local BASE_COOLDOWN: { [number]: number } = {
    [1766] = 10, [1767] = 10, [1768] = 10, [1769] = 10,
    [6552] = 10, [6554] = 10, [72] = 12, [1671] = 12, [1672] = 12,
    [8042] = 6, [8044] = 6, [8045] = 6, [8046] = 6, [10412] = 6, [10413] = 6, [10414] = 6,
    [2139] = 24, [15487] = 45, [853] = 60, [5588] = 60, [5589] = 60, [10308] = 60,
    [5211] = 60, [6798] = 60, [8983] = 60, [19503] = 30,
}

export type InterruptState = { spell: number?, bars: { [any]: boolean }, usedAt: number?, cooldown: number }
export const interrupt = { spell = nil, bars = {}, usedAt = nil, cooldown = 0 } :: InterruptState
-- Your class's file name ("" while unknown).
local function playerClass(): string
    local _, c = UnitClass("player")
    return secret.known(c, "")
end

-- (class: the player's by default; a parameter for tests)
local function isInterrupt(id: number, class: string?): boolean
    class = class or playerClass()
    for _, family in ipairs(INTERRUPTS[class] or {}) do
        for _, x in ipairs(family) do
            if x == id then return true end
        end
    end
    return false
end

local function known(id: number): boolean
    return (IsPlayerSpell and IsPlayerSpell(id)) or (IsSpellKnown and IsSpellKnown(id, false))
end

-- The highest known rank of the first family you know (Pummel before Shield Bash).
-- (class: the player's by default; a parameter for tests)
export function find(class: string?)
    class = class or playerClass()
    interrupt.spell = nil
    for _, family in ipairs(INTERRUPTS[class] or {}) do
        for i = #family, 1, -1 do
            if known(family[i]) then
                interrupt.spell = family[i]
                return
            end
        end
    end
end

-- Seconds left on the interrupt's own cooldown, from when you last used it:
-- your own cast, always readable (after a reload, the cooldown's own start,
-- see Ready). 0 when it is up.
export function remaining(): number
    if not interrupt.usedAt then return 0 end
    return math.max(0, interrupt.usedAt + interrupt.cooldown - GetTime())
end

-- true (ready), false (cooling down) or nil (no interrupt known). The game's
-- "on cooldown" also covers the global cooldown after any cast; when the
-- interrupt's own cooldown is over, that is all it is, and it counts as ready.
-- What the interrupt's cooldown (C_Spell.GetSpellCooldown's answer) says.
local function readyFrom(cd: any): boolean?
    if not cd or isSecret(cd) or isSecret(cd.isActive) then return nil end
    if not cd.isActive then return true end
    if not interrupt.usedAt then
        -- used before a reload: SuuUI never saw the cast, so the cooldown's
        -- own start and length stand in, when readable and longer than a
        -- global cooldown
        local start, length = cd.startTime, cd.duration
        if not isSecret(start) and not isSecret(length) and start and length and length > 1.5 then
            interrupt.usedAt, interrupt.cooldown = start, length
        end
    end
    return remaining() <= 0
end

export function ready(): boolean?
    if not interrupt.spell then return nil end
    return readyFrom(C_Spell.GetSpellCooldown(interrupt.spell))
end

events.onUnit("UNIT_SPELLCAST_SUCCEEDED", "player", function(_, _, _, spellID)
    if isSecret(spellID) or not spellID or not isInterrupt(spellID) then return end
    local ms = GetSpellBaseCooldown and GetSpellBaseCooldown(spellID)
    interrupt.cooldown = (not isSecret(ms) and ms and ms > 0) and ms / 1000 or BASE_COOLDOWN[spellID] or 0
    interrupt.usedAt = GetTime()
    for bar in pairs(interrupt.bars) do bar:UpdateKick() end
end, "Interrupt")

local function refreshKicks()
    for bar in pairs(interrupt.bars) do bar:UpdateKick() end
end

events.onGame("SPELLS_CHANGED", function() find(); refreshKicks() end, "Interrupt")
events.onGame("PLAYER_LOGIN", function() find() end, "Interrupt")
events.onGame("SPELL_UPDATE_COOLDOWN", refreshKicks, "Interrupt")

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

local CB = {}
mixins.CastBar = CB

local function fillBar(parent: Frame, level: number, deep: string, top: string, edge: string): StatusBar
    local b = CreateFrame("StatusBar", nil, parent)
    b:SetStatusBarTexture(WHITE)
    local tex = b:GetStatusBarTexture()
    tex:SetSnapToPixelGrid(false)
    draw.paintGradient(tex, "HORIZONTAL", deep, top)
    b:SetFrameLevel(level)
    -- the 2px edge at the fill's leading end
    local e = b:CreateTexture(nil, "OVERLAY")
    draw.paintFill(e, edge)
    e:SetPoint("TOPRIGHT", tex, "TOPRIGHT")
    e:SetPoint("BOTTOMRIGHT", tex, "BOTTOMRIGHT")
    e:SetWidth(2)
    return b
end

export function castBar(parent: Frame, unit: string, opts: { [string]: any }?): any
    opts = opts or {}
    local enemy = unit ~= "player"
    local plate = opts.size == "plate"
    local h = draw.size(opts.size == "md" and "cast" or (plate and "cast-plate" or "cast-sm"))
    local f = CreateFrame("Frame", opts.name, parent)
    Mixin(f, CB)
    f.unit, f.opts, f.enemy, f.plate = unit, opts, enemy, plate
    f:SetSize(draw.size(opts.width or 300), plate and (h + S["space-1"] + LINE) or h)
    f:Hide()

    local x = 0
    if opts.icon ~= false and not plate then
        f.icon = CreateFrame("Frame", nil, f)
        f.icon:SetSize(h, h)
        f.icon:SetPoint("TOPLEFT")
        draw.fill(f.icon, "surface-sunk"):SetAllPoints()
        f.iconArt = f.icon:CreateTexture(nil, "ARTWORK")
        f.iconArt:SetPoint("TOPLEFT", 1, -1)
        f.iconArt:SetPoint("BOTTOMRIGHT", 0, 1)
        f.iconArt:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        draw.border(f.icon, "gilt-hairline")
        x = h
    end

    -- The bar: ground, the neutral (or locked) fill, then the arcane layer.
    local bar = CreateFrame("Frame", nil, f)
    bar:SetPoint("TOPLEFT", x, 0)
    if plate then
        bar:SetPoint("TOPRIGHT")
        bar:SetHeight(h)
    else
        bar:SetPoint("BOTTOMRIGHT")
    end
    f.bar = bar
    draw.fill(bar, "surface-sunk"):SetAllPoints()
    local inner = CreateFrame("Frame", nil, bar)
    inner:SetPoint("TOPLEFT", 1, -1)
    inner:SetPoint("BOTTOMRIGHT", -1, 1)
    inner:SetClipsChildren(true)
    local level = f:GetFrameLevel()
    if enemy then
        f.fill = fillBar(inner, level + 1, "unit-fill-deep", "unit-fill", "ink-muted")
    else
        -- your own cast: transparent to ghost, an ink edge
        f.fill = fillBar(inner, level + 1, "ghost", "ghost", "ink")
        draw.paintGradient(f.fill:GetStatusBarTexture(), "HORIZONTAL", "ghost", "ghost", 0)
    end
    f.fill:SetAllPoints(inner)
    f.border = draw.border(bar, "gilt-hairline", { layer = "OVERLAY" })

    -- Everything that marks an interruptible cast lives on one host frame, so
    -- one SetAlphaFromBoolean shows or hides it all.
    if enemy then
        local host = CreateFrame("Frame", nil, f)
        host:SetAllPoints(f)
        host:SetFrameLevel(level + 2)
        f.arcane = host
        f.arcaneFill = fillBar(host, level + 2, "arcane-soft", "arcane-glow", "arcane")
        f.arcaneFill:SetPoint("TOPLEFT", inner, "TOPLEFT")
        f.arcaneFill:SetPoint("BOTTOMRIGHT", inner, "BOTTOMRIGHT")
        f.arcaneEdge = CreateFrame("Frame", nil, host)
        f.arcaneEdge:SetAllPoints(bar)
        draw.border(f.arcaneEdge, "arcane")
        if f.icon then
            f.iconEdge = CreateFrame("Frame", nil, host)
            f.iconEdge:SetAllPoints(f.icon)
            draw.border(f.iconEdge, "arcane")
        end
        f.glow = draw.shadow(f.arcaneEdge, "glow-arcane")
        -- the lock, on its own host, shown when the cast can't be interrupted
        f.lockHost = CreateFrame("Frame", nil, f)
        f.lockHost:SetAllPoints(bar)
        f.lockHost:SetFrameLevel(level + 4)
        local lock = f.lockHost:CreateTexture(nil, "OVERLAY")
        lock:SetTexture(LOCK)
        lock:SetDesaturated(true)
        draw.paint(lock, "ink")
        local ls = opts.size == "md" and 12 or 10
        lock:SetSize(ls, ls)
        f.lockW = ls + S["space-2"]
        if plate then
            -- on a plate the lock sits inside the bar's left end, as tall as
            -- the bar (8px at least), so the spell line keeps its icon
            local px = math.max(8, h)
            lock:SetSize(px, px)
            lock:SetPoint("LEFT", 2, 0)
            f.lock = lock
        else
            lock:SetPoint("LEFT", S["space-3"], 0)
        end
    end

    -- Text over everything (a plate's: the line under the bar).
    local text = CreateFrame("Frame", nil, f)
    if plate then
        text:SetPoint("TOPLEFT", bar, "BOTTOMLEFT", 0, -S["space-1"])
        text:SetPoint("TOPRIGHT", bar, "BOTTOMRIGHT", 0, -S["space-1"])
        text:SetHeight(LINE)
    else
        text:SetAllPoints(bar)
    end
    text:SetFrameLevel(level + 5)
    if plate then
        -- the spell's icon leads the line
        local slot = CreateFrame("Frame", nil, text)
        slot:SetSize(LINE, LINE)
        slot:SetPoint("LEFT")
        draw.fill(slot, "surface-sunk"):SetAllPoints()
        f.iconArt = slot:CreateTexture(nil, "ARTWORK")
        f.iconArt:SetPoint("TOPLEFT", 1, -1)
        f.iconArt:SetPoint("BOTTOMRIGHT", -1, 1)
        f.iconArt:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        draw.border(slot, "gilt-hairline")
        f.lineIcon = slot
        f.lockW = LINE + S["space-2"]
    end
    local pad = plate and 0 or (opts.size == "md" and S["space-4"] or S["space-3"])
    f.time = uiText.text(text, plate and "caption" or "numeric", "ink")
    f.time:SetShadowed(true)
    f.time:SetPoint("RIGHT", -pad, 0)
    f.spell = uiText.text(text, plate and "caption" or "label", "ink")
    -- a plate's target line: "› name" under the spell name, in the target's
    -- class colour, only while the cast has a target
    if plate and opts.target then
        local t = CreateFrame("Frame", nil, f)
        t:SetPoint("TOPLEFT", text, "BOTTOMLEFT", 0, 0)
        t:SetPoint("TOPRIGHT", text, "BOTTOMRIGHT", 0, 0)
        t:SetHeight(LINE)
        t:SetFrameLevel(level + 5)
        t.mark = uiText.text(t, "caption", "ink-muted")
        t.mark:SetShadowed(true)
        t.mark:SetPoint("LEFT", f.lockW or 0, 0)
        t.mark:SetValue("›")
        t.name = uiText.text(t, "caption", "ink")
        t.name:SetShadowed(true)
        t.name:SetWordWrap(false)
        t.name:SetPoint("LEFT", t.mark, "RIGHT", 3, 0)
        t.name:SetWidth(draw.size(opts.width or 300) - (f.lockW or 0) - 12)
        -- aimed at you: the "you" badge in the name's place
        t.you = controls.stateBadge(t, "neutral", "you")
        t.you:SetPoint("LEFT", t.mark, "RIGHT", 3, 0)
        t.you:SetAlpha(0)
        t:Hide()
        f.target = t
    end
    f.spell:SetShadowed(true)
    f.spell:SetPoint("LEFT", pad + (f.lockW or 0), 0)
    -- aimed at you (off a plate): "Spell ›" and the "you" badge in the
    -- line's place, shown by the game's answer (secret in combat)
    if not plate then
        f.spellYou = uiText.text(text, "label", "ink")
        f.spellYou:SetShadowed(true)
        f.spellYou:SetPoint("LEFT", pad + (f.lockW or 0), 0)
        f.spellYou:SetAlpha(0)
        f.you = controls.stateBadge(text, "neutral", "you")
        f.you:SetPoint("LEFT", f.spellYou, "RIGHT", 4, 0)
        f.you:SetAlpha(0)
    end
    -- the name gives way to the time (and the interrupt): a fixed width, so a
    -- secret name is shortened by the engine with an ellipsis
    local reserve = 40 + ((enemy and opts.kick ~= false) and 30 or 0)
    f.spell:SetWidth(draw.size(opts.width or 300) - x - pad * 2 - (f.lockW or 0) - reserve)

    -- Your interrupt: the stop glyph (arcane when ready) and its seconds.
    if enemy and opts.kick ~= false then
        local k = CreateFrame("Frame", nil, f.arcane)
        k:SetFrameLevel(level + 6)
        k:SetSize(28, plate and LINE or h)
        k:SetPoint("RIGHT", f.time, "LEFT", -S["space-2"], 0)
        k.glyph = draw.diamond(k, opts.size == "md" and 8 or 7, "arcane")
        k.glyph:SetPoint("RIGHT", 0, 0)
        k.secs = uiText.text(k, "micro", "ink-muted")
        k.secs:SetShadowed(true)
        k.secs:SetPoint("RIGHT", k.glyph, "LEFT", -3, 0)
        f.kick = k
    end

    f:SetScript("OnUpdate", function(self) self:Tick() end)
    f.pad, f.h, f.totalW = pad, h, draw.size(opts.width or 300)
    -- off a plate the target goes after the spell name, only when asked for
    if not plate then f.targetShown = opts.target and true or false end
    f.iconShown = f.icon ~= nil
    f.kickShown = f.kick ~= nil
    extend.add(extend.Kind.CastBar, f, { unit = unit, name = f:GetName() })
    return f
end

-- Lays out the bar beside the icon (when shown), and sizes the spell name
-- to the room the time and the interrupt leave.
function CB:Arrange()
    local x = (self.icon and self.iconShown) and self.h or 0
    if self.icon then self.icon:SetShown(self.iconShown) end
    if self.iconEdge then self.iconEdge:SetShown(self.iconShown) end
    if not self.plate then
        self.bar:ClearAllPoints()
        self.bar:SetPoint("TOPLEFT", x, 0)
        self.bar:SetPoint("BOTTOMRIGHT")
    end
    local reserve = 40 + ((self.kick and self.kickShown) and 30 or 0)
    self.spell:SetWidth(self.totalW - x - self.pad * 2 - (self.lockW or 0) - reserve)
    if self.target then self.target.name:SetWidth(self.totalW - (self.lockW or 0) - 12) end
end

-- The whole bar's width, live: the spell name keeps the room the time and
-- the interrupt leave.
function CB:SetBarWidth(w: any)
    self.totalW = draw.size(w)
    self:SetWidth(self.totalW)
    self:Arrange()
end

-- The bar's height, live. On a plate only the bar changes (the spell line
-- keeps its size under it); otherwise the icon square follows the bar.
function CB:SetBarHeight(h: number)
    self.h = h
    if self.plate then
        self.bar:SetHeight(h)
        self:SetHeight(h + S["space-1"] + LINE)
        if self.lock then self.lock:SetSize(math.max(8, h), math.max(8, h)) end
        return
    end
    self:SetHeight(h)
    if self.icon then self.icon:SetSize(h, h) end
    if self.kick then self.kick:SetHeight(h) end
    self:Arrange()
end

function CB:SetNeutral(on: any)
    self.neutral = on and true or false
    if self.arcane then self.arcane:SetAlpha(self.neutral and 0 or 1) end
    if self.lockHost then self.lockHost:SetAlpha(0) end
    self:UpdateKick()
end

function CB:SetTargetShown(on: any)
    self.targetShown = on and true or false
    if self.target and not on then self.target:Hide() end
    -- changed mid-cast: the target shows (or goes) now, not at the next cast
    if self.duration then self:UpdateTarget() end
end

-- Who the spell is aimed at. The name, class and whether it's you may be
-- secret (probed 2026-10-18: in combat all three): never tested, only
-- handed on, the class's colour to the text (its colour object's RGB and
-- hex code take a secret class) and "is it you" to SetAlphaFromBoolean.
-- (A: the game's functions, a parameter for tests)
local function spellTarget(unit: string, A: any = _G): (any, any, any)
    if not (A.UnitShouldDisplaySpellTargetName and A.UnitSpellTargetName) then return end
    if not A.UnitShouldDisplaySpellTargetName(unit) then return end
    local name = A.UnitSpellTargetName(unit)
    if type(name) == "nil" then return end
    local class = A.UnitSpellTargetClass and A.UnitSpellTargetClass(unit)
    local you = A.PlayerIsSpellTarget and A.PlayerIsSpellTarget(unit)
    return name, class, you
end

-- A class's colour object (the class may be secret), or nil.
local function classColor(class: any): any
    if type(class) == "nil" or not C_ClassColor then return nil end
    local ok, c = pcall(C_ClassColor.GetClassColor, class)
    return ok and c or nil
end

-- "you" shown or not by the game's answer, the line it stands in for the
-- other way round
local function showYou(you: any, badge: any, line: any, youLine: any?)
    if type(you) == "nil" then you = false end
    if not pcall(badge.SetAlphaFromBoolean, badge, you, 1, 0) then badge:SetAlpha(0) end
    if youLine then pcall(youLine.SetAlphaFromBoolean, youLine, you, 1, 0) end
    if not pcall(line.SetAlphaFromBoolean, line, you, 0, 1) then line:SetAlpha(1) end
end

-- The cast's target: name, class and "is it you" (any may be secret), or
-- nothing (a method, so tests can stand in for the game's answer).
function CB:SpellTarget(): (any, any, any)
    return spellTarget(self.unit)
end

function CB:UpdateTarget()
    if not self.plate then
        -- "Spell › Target" in the spell name's fixed width, so the engine
        -- shortens it; both may be secret, so they only go to the text
        local spell = self.spellName
        if type(spell) == "nil" then return end
        if self.targetShown then
            local ok, name, class, you = pcall(self.SpellTarget, self)
            if ok and type(name) ~= "nil" then
                self.spellYou:SetFormattedText("%s ›", spell)
                showYou(you, self.you, self.spell, self.spellYou)
                -- the target's name in its class colour (asked 2026-10-18)
                local c = classColor(class)
                local okHex, hex = pcall(function() return c and c:GenerateHexColor() end)
                if okHex and hex then return self.spell:SetFormattedText("%s › |c%s%s|r", spell, hex, name) end
                return self.spell:SetFormattedText("%s › %s", spell, name)
            end
        end
        showYou(false, self.you, self.spell, self.spellYou)
        return self.spell:SetText(spell)
    end
    local t = self.target
    if not t then return end
    if self.targetShown == false then return t:Hide() end
    local ok, name, class, you = pcall(self.SpellTarget, self)
    if not ok or type(name) == "nil" then return t:Hide() end
    t.name:SetText(name)
    t.name:SetColor("ink")
    local c = classColor(class)
    if c then pcall(function() t.name:SetTextColor(c:GetRGB()) end) end
    showYou(you, t.you, t.name)
    t:Show()
end

function CB:SetIconShown(on: any)
    self.iconShown = on and self.icon ~= nil
    self:Arrange()
end

function CB:SetKickShown(on: any)
    self.kickShown = on and self.kick ~= nil
    self:UpdateKick()
    self:Arrange()
end

--------------------------------------------------------------------------------
-- Drawing
--------------------------------------------------------------------------------

-- Your interrupt's readiness (ready()); a method, so tests can stand in.
function CB:KickReady(): boolean?
    return ready()
end

function CB:UpdateKick()
    local k = self.kick
    if not k then return end
    local isReady = self:KickReady()
    k:SetShown(isReady ~= nil and self.kickShown ~= false and not self.neutral)
    -- unknown (secret in combat): its seconds go too, or every frame of the
    -- cast asked for the cooldown again
    if isReady == nil then k.secs:Hide() return end
    draw.paint(k.glyph, isReady and "arcane" or "ink-faint")
    k.secs:SetShown(not isReady)
end

function CB:Tick()
    local d = self.duration
    if not d then return end
    -- A missed stop event (a unit that despawns mid-cast) never leaves a bar
    -- standing: a few times a second, check the cast still runs.
    local now = GetTime()
    if now - (self.lastCheck or 0) > 0.25 then
        self.lastCheck = now
        if not (UnitExists(self.unit) and (UnitCastingDuration(self.unit) or UnitChannelDuration(self.unit))) then
            return self:Stop()
        end
    end
    local left = d:GetRemainingDuration()
    self.time:SetFormattedText("%.1fs", left)
    self.time.value = nil
    if self.kick and self.kick.secs:IsShown() then
        local r = remaining()
        if r > 0 then
            self.kick.secs:SetValue(tostring(math.ceil(r)))
        else
            -- the cooldown just ran out
            self:UpdateKick()
        end
    end
end

function CB:Start(channel: boolean)
    local u = self.unit
    local name, _, texture, _, _, _, a7, a8 = (channel and UnitChannelInfo or UnitCastingInfo)(u)
    -- UnitCastingInfo: …, castID, notInterruptible; UnitChannelInfo: …, notInterruptible
    local notInterruptible
    if channel then notInterruptible = a7 else notInterruptible = a8 end
    local d
    if channel then d = UnitChannelDuration(u) else d = UnitCastingDuration(u) end
    if not d then self:Stop() return end
    self.duration = d
    self.fill:SetTimerDuration(d, nil, channel and DIR.RemainingTime or DIR.ElapsedTime)
    if self.arcaneFill then
        self.arcaneFill:SetTimerDuration(d, nil, channel and DIR.RemainingTime or DIR.ElapsedTime)
    end
    self.spellName = name
    self.spell:SetText(name)
    if self.iconArt then self.iconArt:SetTexture(texture) end
    self:UpdateTarget()
    if self.enemy and not self.plate then
        -- a unit frame's bar: a friendly unit's cast is neutral (a plate's
        -- owner decides that itself). Secret reads as attackable.
        local attackable = UnitCanAttack("player", u)
        self:SetNeutral(not isSecret(attackable) and not attackable)
    end
    self:SetInterruptible(notInterruptible)
    self:UpdateKick()
    self:Show()
    self:Tick()
end

-- notInterruptible may be a secret boolean: never tested, only handed to the engine.
function CB:SetInterruptible(notInterruptible: any)
    if not self.arcane then return end
    if self.neutral then
        self.arcane:SetAlpha(0)
        self.lockHost:SetAlpha(0)
        return
    end
    if not isSecret(notInterruptible) and notInterruptible == nil then notInterruptible = false end
    self.arcane:SetAlphaFromBoolean(notInterruptible, 0, 1)
    self.lockHost:SetAlphaFromBoolean(notInterruptible, 1, 0)
end

function CB:Stop()
    self.duration, self.spellName = nil, nil
    if self.target then self.target:Hide() end
    self:Hide()
end

function CB:Refresh()
    if not UnitExists(self.unit) then return self:Stop() end
    -- Ask for the duration objects, not the spell name: the name may be a
    -- secret string, which can't be tested.
    if UnitCastingDuration(self.unit) then
        self:Start(false)
    elseif UnitChannelDuration(self.unit) then
        self:Start(true)
    else
        self:Stop()
    end
end

--------------------------------------------------------------------------------
-- Events
--------------------------------------------------------------------------------

local START: string[] = { "UNIT_SPELLCAST_START", "UNIT_SPELLCAST_DELAYED" }
local CHANNEL: string[] = { "UNIT_SPELLCAST_CHANNEL_START", "UNIT_SPELLCAST_CHANNEL_UPDATE" }
local STOP: string[] = { "UNIT_SPELLCAST_STOP", "UNIT_SPELLCAST_FAILED", "UNIT_SPELLCAST_INTERRUPTED", "UNIT_SPELLCAST_CHANNEL_STOP" }

local function onUnit(self: any, event: string, fn: events.Listener)
    local ok = pcall(events.onUnit, event, self.unit, fn, self)
    if not ok then debug("CastBar: no event", event) end
end

function CB:Activate()
    if self.active then return end
    self.active = true
    interrupt.bars[self] = true
    for _, e in ipairs(START) do onUnit(self, e, function() self:Start(false) end) end
    for _, e in ipairs(CHANNEL) do onUnit(self, e, function() self:Start(true) end) end
    for _, e in ipairs(STOP) do onUnit(self, e, function() self:Refresh() end) end
    onUnit(self, "UNIT_SPELLCAST_INTERRUPTIBLE", function() self:SetInterruptible(false) end)
    onUnit(self, "UNIT_SPELLCAST_NOT_INTERRUPTIBLE", function() self:SetInterruptible(true) end)
    if self.unit == "target" then
        events.onGame("PLAYER_TARGET_CHANGED", function() self:Refresh() end, self)
    elseif self.unit == "focus" then
        events.onGame("PLAYER_FOCUS_CHANGED", function() self:Refresh() end, self)
    elseif self.unit:find("^boss") then
        events.onGame("INSTANCE_ENCOUNTER_ENGAGE_UNIT", function() self:Refresh() end, self)
    end
    self:Refresh()
end

function CB:Deactivate()
    if not self.active then return end
    self.active = false
    interrupt.bars[self] = nil
    events.offAll(self)
    self:Stop()
end

function CB:SetUnit(unit: string?)
    if unit == self.unit then return self:Refresh() end
    local was = self.active
    if was then self:Deactivate() end
    self.unit = unit
    if was and unit then self:Activate() end
end
