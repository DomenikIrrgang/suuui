-- UI/Crest.wowlua
-- The rare and elite crest (design "Rare and elite units", option B "Crest",
-- chosen 2026-10-18): the dragon flattened into a diamond with 1 px wings
-- that run out and fade. Gilt for elite, silver (an ink outline on
-- surface-sunk) for rare, silver wings with a gilt jewel ringed in silver for
-- a rare elite; a world boss gets longer wings and three jewels.
--   frame: on a unit frame's top edge over its right end, wings both ways
--   plate: just outside a nameplate bar's right end, one wing outward
--
--   local crest = crest(parent, "frame")   -- or "plate"
--   crest:SetPoint("CENTER", frame, "TOPRIGHT", -64, 0)
--   crest:SetClassification(UnitClassification(unit))   -- nil/"normal"/…: hidden

import isSecret from "wowlua:secret"
import * as draw from "./Draw"

local WHITE = "Interface\\Buttons\\WHITE8X8"
local KINDS: { [string]: boolean } = { elite = true, rare = true, rareelite = true, worldboss = true }

-- A diamond jewel: gilt, silver or both, `size` px a side, centred at x, y.
local function jewel(c: Frame, kind: string, size: number, x: number, y: number): Texture[]
    local parts: Texture[] = {}
    local function d(px: number, color: string, sub: number, alpha: number?)
        local t = draw.diamond(c, px, color, "OVERLAY", sub)
        if alpha then t:SetVertexColor(0, 0, 0, alpha) end
        t:SetPoint("CENTER", c, "CENTER", x, y)
        parts[#parts + 1] = t
    end
    if kind == "gilt" then
        d(size + 2, "ink", 1, 0.65)
        d(size, "gilt", 3)
    elseif kind == "silver" then
        d(size + 5, "ink", 1, 0.65)
        d(size + 3, "ink", 2)
        d(size, "surface-sunk", 3)
    else -- both: a gilt jewel ringed in silver
        d(size + 4, "ink", 1)
        d(size + 2, "surface-sunk", 2)
        d(size, "gilt", 3)
    end
    return parts
end

-- A 1 px wing from x outward by `length`, fading toward its tip.
local function wing(c: Frame, color: string, x: number, y: number, length: number, toLeft: boolean?): Texture[]
    local t = c:CreateTexture(nil, "OVERLAY", nil, 0)
    t:SetTexture(WHITE)
    t:SetSize(length, 1)
    t:SetPoint(toLeft and "RIGHT" or "LEFT", c, "CENTER", x, y)
    if not pcall(draw.paintGradient, t, "HORIZONTAL", color, color, toLeft and 0 or 1, toLeft and 1 or 0) then
        draw.paint(t, color)
    end
    return { t }
end

export class Crest extends Frame
    variant: string
    looks: { [string]: Texture[] }? = nil
    kind: string? = nil

    constructor(parent: Frame, variant: string?)
        super(nil, parent)
        self.variant = variant or "frame"
        self:SetSize(1, 1)
        self:SetFrameLevel(parent:GetFrameLevel() + 8)
        self:Hide()
    end

    -- The pieces of one look, made once.
    function Look(kind: string): Texture[]
        local looks: { [string]: Texture[] } = self.looks or {}
        self.looks = looks
        local made = looks[kind]
        if made then return made end
        local parts: Texture[], plate = {}, self.variant == "plate"
        local function add(list: Texture[]) for _, t in ipairs(list) do parts[#parts + 1] = t end end
        local metal = (kind == "elite" or kind == "worldboss") and "gilt" or "ink"
        local stone = kind == "rare" and "silver" or kind == "rareelite" and "both" or "gilt"
        if plate then
            add(jewel(self, stone, 5, 0, 0))
            add(wing(self, metal, 3.5, 0, 10))
            if kind == "worldboss" then add(jewel(self, "gilt", 3, 8, 0)) end
        elseif kind == "worldboss" then
            add(wing(self, "gilt", -6, 0, 44, true))
            add(wing(self, "gilt", 6, 0, 44))
            add(jewel(self, "gilt", 5, -10.5, 0))
            add(jewel(self, "gilt", 5, 10.5, 0))
            add(jewel(self, "gilt", 9, 0, 0))
        else
            add(wing(self, metal, -4, 0, 26, true))
            add(wing(self, metal, 4, 0, 26))
            add(jewel(self, stone, 7, 0, 0))
        end
        for _, t in ipairs(parts) do t:Hide() end
        looks[kind] = parts
        return parts
    end

    -- The unit's classification (a secret one: hidden, like the meta words).
    function SetClassification(given: string | Secret<string> | nil)
        local c = not isSecret(given) and given or nil
        local kind: string? = c ~= nil and KINDS[c] and c or nil
        if kind == self.kind then return end
        local was = self.kind
        if was then for _, t in ipairs(self:Look(was)) do t:Hide() end end
        self.kind = kind
        if kind then for _, t in ipairs(self:Look(kind)) do t:Show() end end
        self:SetShown(kind ~= nil)
    end
end

export function crest(parent: Frame, variant: string?): Crest
    return Crest.new(parent, variant)
end

--------------------------------------------------------------------------------
-- The elite dragon (asked 2026-10-18, design "Elite dragon (with crest B)"
-- A, in place of the crest when its setting is on): the art Forever's own
-- target frame wears (Camelot TargetFrameUtils' GetBossPortraitFrameData),
-- its size from the client (probe dragon: 100 x 100, 110 x 90, 110 x 89),
-- placed as on Blizzard's 232 x 100 frame around its 58 px portrait, scaled
-- so the right end of a bar `height` tall stands in for the portrait.
--
-- A rare elite's silver dragon wears the crest's gilt jewel ringed in silver
-- on its breast (asked 2026-10-19, the design's A: 7 px on a 32 px frame),
-- so it reads apart from a rare's.
--
--   local art = dragonArt(UnitClassification(unit), UnitIsBossMob(unit))
--   placeDragon(texture, art, bar, bar:GetHeight())   -- nil art: hidden
--------------------------------------------------------------------------------

-- the atlas, its size and offset (and the breast jewel)
export type DragonArt = { atlas: string, width: number, height: number, x: number, y: number, jewel?: boolean }

local RARE = "UI-HUD-UnitFrame-Target-PortraitOn-Boss-Rare-Silver-Winged"
local DRAGON: { [string]: DragonArt } = {
    elite = { atlas = "UI-HUD-UnitFrame-Target-PortraitOn-Boss-Gold", width = 100, height = 100, x = 0, y = 1 },
    boss = { atlas = "UI-HUD-UnitFrame-Target-PortraitOn-Boss-Gold-Winged", width = 110, height = 90, x = 11, y = -4 },
    rare = { atlas = RARE, width = 110, height = 89, x = 8, y = -7 },
    rareelite = { atlas = RARE, width = 110, height = 89, x = 8, y = -7, jewel = true },
}

export function dragonArt(classification: string | Secret<string> | nil, isBoss: boolean | Secret<boolean> | nil): DragonArt?
    if isSecret(classification) or classification == nil then return nil end
    if (not isSecret(isBoss) and isBoss) or classification == "worldboss" then return DRAGON.boss end
    if classification == "rare" then return DRAGON.rare end
    if classification == "rareelite" then return DRAGON.rareelite end
    if classification == "elite" then return DRAGON.elite end
end

-- The breast jewel: on the texture's parent, over it; 7 px at a 32 px
-- height, its centre 31 x 50 of the art's px in from its top right.
local jewels: { [Texture]: Frame } = setmetatable({}, { __mode = "k" })
local function breastJewel(t: Texture): Frame
    local made = jewels[t]
    if made then return made end
    local host = t:GetParent()
    local j = CreateFrame("Frame", nil, host)
    j:SetSize(1, 1)
    j:SetFrameLevel(host:GetFrameLevel() + 1)
    jewel(j, "both", 7, 0, 0)
    jewels[t] = j
    return j
end

-- TOPRIGHT at ((x + 26) s, (y + 19) s) of `anchor`, s = height / 58
export function placeDragon(t: Texture, art: DragonArt | false | nil, anchor: Region, height: number)
    local made = jewels[t]
    if made then made:Hide() end
    if not art then return t:Hide() end
    local s = height / 58
    t:SetAtlas(art.atlas)
    t:SetSize(art.width * s, art.height * s)
    t:ClearAllPoints()
    t:SetPoint("TOPRIGHT", anchor, "TOPRIGHT", (art.x + 26) * s, (art.y + 19) * s)
    t:Show()
    if art.jewel then
        local j, k = breastJewel(t), height / 32
        j:SetScale(k)
        j:ClearAllPoints()
        j:SetPoint("CENTER", t, "TOPRIGHT", -31 * s / k, -50 * s / k)
        j:Show()
    end
end
