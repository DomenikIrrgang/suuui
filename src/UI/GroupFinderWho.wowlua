-- UI/GroupFinderWho.wowlua
-- The Group Finder's Who page (design component GroupFinder, "Who"): who is
-- online, by name, guild, zone or level range.
--   The bar: the search field (300), Search (primary), Filter (the game's
--   own menu: Class, Race, Zone, Sort), "24 players found" at the right
--   ("· showing the first 50" when the server caps it).
--   The list: a sunk box with Name (a class diamond, the name in class
--   colour), Level, Race, Class, <Guild>, Zone; 24px rows; the selected one
--   arcane-soft with an arcane edge; right-click for the game's player menu.
--   Before a search: "Who is online?"; nothing found: "No players found".
--   The foot: Add friend, then Whisper and Invite (primary), for the
--   selected player (off until one is chosen).
--
--   local w = groupFinderWho(parent)  (SuuUI.UI.GroupFinderWho)
--   w:SetData({ state = "idle" | "results" | "none", query = "", total = n, capped = bool,
--               results = { { name, level, race, class (file), className, guild, zone } } })
--   w.onSearch(text), w.onFilter(button), w.onAddFriend(row), w.onWhisper(row),
--   w.onInvite(row), w.onMenu(row)

import tokens as T from "/Core/Tokens"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as controls from "/UI/Controls"
import * as inputs from "/UI/Inputs"
import * as panel from "/UI/Panel"
import Text from "/UI/Text"
import SuuButton from "/UI/Controls"
import TextField, Glyph from "/UI/Inputs"
import ScrollArea from "/UI/Panel"

-- A player the server found.
export type WhoResult = {
    name?: string,
    level?: number,
    race?: string,
    class?: string,      -- the class file ("MAGE")
    className?: string,
    guild?: string,
    zone?: string,
}

export type WhoData = {
    state: string,       -- "idle" (before a search), "results" or "none"
    query?: string,
    total?: number,
    capped?: boolean,
    results?: WhoResult[],
}

-- Filter: a quiet button with a chevron after its word.
export interface WhoFilterButton extends SuuButton
    chev: Glyph
end

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"

local BAR_H = 30
local HEAD_H = 22
local ROW_H = 24
local FOOT_H = 26
local LEVEL_W = 44
-- the columns' shares of what's left (Name, Race, Class, Guild, Zone)
local SHARES: { [string]: number } = { name = 24, race = 14, class = 14, guild = 26, zone = 26 }
local ORDER = { "name", "level", "race", "class", "guild", "zone" }
local LABEL: { [string]: string } = { name = "Name", level = "Level", race = "Race", class = "Class", guild = "Guild", zone = "Zone" }

-- Each column's x and width in a row this wide.
-- the left: room for the class diamond before the name (the diamond sat on
-- the box's edge, found in game)
local LEFT = S["space-4"] + 6 + S["space-4"]

export type WhoColumn = { x: number, w: number }

local function columns(width: number): { [string]: WhoColumn }
    local gap = S["space-4"]
    local inner = width - LEFT - S["space-4"] - gap * 5 - S["space-4"] - LEVEL_W
    local total = 0
    for _, v in pairs(SHARES) do total = total + v end
    local out: { [string]: WhoColumn }, x = {}, LEFT
    for _, key in ipairs(ORDER) do
        local w = key == "level" and LEVEL_W or math.floor(inner * (SHARES[key] or 0) / total)
        out[key] = { x = x, w = w }
        -- a little more after the right-aligned level, before Race
        x = x + w + gap + (key == "level" and S["space-4"] or 0)
    end
    return out
end

local function cell(parent: Frame, style: string, color: string): Text
    local fs = uiText.text(parent, style, color)
    fs:SetWordWrap(false)
    fs:SetJustifyH("LEFT")
    return fs
end

-- what the list shows with no one in it: a glyph, a title and a line
export class WhoEmpty extends Frame
    readonly glyph: Texture
    readonly title: Text
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(380, 100)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. "search.tga")
        self.glyph:SetSize(24, 24)
        draw.paint(self.glyph, "ink-faint")
        self.glyph:SetPoint("TOP")
        self.title = uiText.text(self, "label", "ink")
        self.title:SetPoint("TOP", self.glyph, "BOTTOM", 0, -S["space-3"])
        self.text = uiText.text(self, "caption", "ink-muted")
        self.text:SetWidth(380)
        self.text:SetJustifyH("CENTER")
        self.text:SetPoint("TOP", self.title, "BOTTOM", 0, -S["space-3"])
    end
end

export class WhoRow extends Button
    index: number = 0
    data?: WhoResult
    selected: Texture
    edge: Texture
    hover: Texture
    dia: Texture
    name: Text
    level: Text
    race: Text
    class: Text
    guild: Text
    zone: Text

    constructor(w: GroupFinderWho)
        super(nil, w.list.child)
        self:SetHeight(ROW_H)
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.selected = draw.fill(self, "arcane-soft", "BACKGROUND")
        self.selected:SetAllPoints()
        self.edge = draw.fill(self, "arcane", "ARTWORK")
        self.edge:SetWidth(2)
        self.edge:SetPoint("TOPLEFT")
        self.edge:SetPoint("BOTTOMLEFT")
        self.hover = draw.fill(self, "gilt-faint", "BACKGROUND", 1)
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.dia = draw.diamond(self, 6, "ink")
        self.name = cell(self, "label", "ink")
        self.level = cell(self, "caption", "ink")
        self.level:SetJustifyH("RIGHT")
        self.race = cell(self, "caption", "ink")
        self.class = cell(self, "caption", "ink")
        self.guild = cell(self, "caption", "ink")
        self.zone = cell(self, "caption", "ink")
        self:SetScript("OnEnter", function() self.hover:Show() end)
        self:SetScript("OnLeave", function() self.hover:Hide() end)
        self:SetScript("OnClick", function(_: WhoRow, button: string)
            local data = self.data
            if not data then return end
            if button == "RightButton" then
                if w.onMenu then w.onMenu(data) end
            else
                w.selected = self.index
                w:Draw()
            end
        end)
    end
end

local function makeRow(w: GroupFinderWho): WhoRow
    return WhoRow.new(w)
end

-- What the bar says at the right: "24 players found" ("· showing the first
-- 50" when the server caps it); nothing before a search.
local function countText(d: WhoData): string
    if d.state == "idle" then return "" end
    local n = d.total or #(d.results or {})
    return n .. (n == 1 and " player found" or " players found") .. ((d.capped or n > 50) and " · showing the first 50" or "")
end

export class GroupFinderWho extends Frame
    rows: WhoRow[]
    heads: { [string]: Text }
    query: TextField
    search: SuuButton
    filter: WhoFilterButton
    count: Text
    box: Frame
    headRow: Frame
    list: ScrollArea
    empty: WhoEmpty
    addFriend: SuuButton
    invite: SuuButton
    whisper: SuuButton
    data: WhoData? = nil
    lastResults: WhoResult[]? = nil
    selected: number? = nil
    onSearch: ((text: string) -> ())? = nil
    onFilter: ((button: SuuButton) -> ())? = nil
    onAddFriend: ((row: WhoResult) -> ())? = nil
    onWhisper: ((row: WhoResult) -> ())? = nil
    onInvite: ((row: WhoResult) -> ())? = nil
    onMenu: ((row: WhoResult) -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.rows, self.heads = {}, {}
        -- the bar
        local function search() if self.onSearch then self.onSearch(self.query:GetValue()) end end
        self.query = inputs.textField(self, { width = 300, placeholder = "Search Name, Guilds, Levels", onChange = function() end })
        self.query:SetPoint("TOPLEFT")
        self.query.edit:HookScript("OnEnterPressed", search)
        self.search = controls.button(self, { text = "Search", variant = "primary", icon = "search", onClick = search })
        self.search:SetHeight(BAR_H)
        self.search:SetPoint("LEFT", self.query, "RIGHT", S["space-4"], 0)
        -- Filter: the glyph, the word, a chevron, laid out left to right (the
        -- word centred between them overlapped the chevron, found in game)
        self.filter = controls.button(self, { text = "Filter", width = 1,
            onClick = function(obj: SuuButton) if self.onFilter then self.onFilter(obj) end end }) :: WhoFilterButton
        self.filter:SetHeight(BAR_H)
        self.filter:SetPoint("LEFT", self.search, "RIGHT", S["space-4"], 0)
        local fg = self.filter:CreateTexture(nil, "ARTWORK")
        fg:SetTexture(GLYPHS .. "filter.tga")
        fg:SetSize(12, 12)
        draw.paint(fg, "ink-muted")
        fg:SetPoint("LEFT", S["space-5"], 0)
        self.filter.label:ClearAllPoints()
        self.filter.label:SetPoint("LEFT", fg, "RIGHT", S["space-3"], 0)
        self.filter.chev = inputs.chevron(self.filter, "ink-muted")
        self.filter.chev:SetPoint("LEFT", self.filter.label, "RIGHT", S["space-3"], 0)
        local function fitFilter()
            self.filter:SetWidth(S["space-5"] * 2 + 12 + S["space-3"] + math.ceil(self.filter.label:GetUnboundedStringWidth()) + S["space-3"] + 12)
        end
        fitFilter()
        self.filter:HookScript("OnShow", fitFilter) -- measured again once its font is in
        self.filter:SetScript("OnMouseDown", nil)
        self.filter:SetScript("OnMouseUp", nil)
        self.count = uiText.text(self, "caption", "ink-muted")
        self.count:SetPoint("RIGHT", self, "TOPRIGHT", 0, -BAR_H / 2)
        -- the list
        self.box = CreateFrame("Frame", nil, self)
        self.box:SetPoint("TOPLEFT", 0, -(BAR_H + S["space-4"]))
        self.box:SetPoint("BOTTOMRIGHT", 0, FOOT_H + S["space-4"])
        draw.fill(self.box, "surface-sunk"):SetAllPoints()
        draw.border(self.box, "gilt-faint")
        self.headRow = CreateFrame("Frame", nil, self.box)
        self.headRow:SetPoint("TOPLEFT", 1, -1)
        self.headRow:SetPoint("TOPRIGHT", -1, -1)
        self.headRow:SetHeight(HEAD_H)
        local rule = draw.fill(self.headRow, "gilt-faint", "ARTWORK")
        rule:SetHeight(1)
        rule:SetPoint("BOTTOMLEFT")
        rule:SetPoint("BOTTOMRIGHT")
        for _, key in ipairs(ORDER) do
            local h = cell(self.headRow, "caption", "ink-muted")
            if key == "level" then h:SetJustifyH("RIGHT") end
            h:SetValue(LABEL[key])
            self.heads[key] = h
        end
        self.list = panel.scrollArea(self.box, 2)
        self.list:SetPoint("TOPLEFT", self.headRow, "BOTTOMLEFT", 0, 0)
        self.list:SetPoint("BOTTOMRIGHT", -S["space-2"], S["space-2"])
        self.list:HookScript("OnSizeChanged", function() self:Draw() end)
        -- empty
        local e = WhoEmpty.new(self.box)
        e:SetPoint("CENTER", 0, -HEAD_H / 2)
        self.empty = e
        -- the foot
        local function act(get: () -> ((row: WhoResult) -> ())?): () -> ()
            return function()
                local c, fn = self:Chosen(), get()
                if c and fn then fn(c) end
            end
        end
        self.addFriend = controls.button(self, { text = "Add friend", icon = "userPlus", onClick = act(function() return self.onAddFriend end) })
        self.addFriend:SetHeight(FOOT_H)
        self.addFriend:SetPoint("BOTTOMLEFT")
        self.invite = controls.button(self, { text = "Invite", variant = "primary", icon = "plus", onClick = act(function() return self.onInvite end) })
        self.invite:SetHeight(FOOT_H)
        self.invite:SetPoint("BOTTOMRIGHT")
        self.whisper = controls.button(self, { text = "Whisper", icon = "chat", onClick = act(function() return self.onWhisper end) })
        self.whisper:SetHeight(FOOT_H)
        self.whisper:SetPoint("RIGHT", self.invite, "LEFT", -S["space-3"], 0)
        -- disabled, they still say why
        for _, b in ipairs({ self.addFriend, self.whisper, self.invite }) do b:SetMotionScriptsWhileDisabled(true) end
        self:SetData({ state = "idle" })
    end

    function SetData(d: WhoData)
        self.data = d
        -- a new search: nothing chosen
        if d.results ~= self.lastResults then self.selected = nil end
        self.lastResults = d.results
        self.count:SetValue(countText(d))
        self:Draw()
    end

    function Draw()
        local d: WhoData = self.data or { state = "idle" }
        local width = math.max(1, self.list:GetWidth())
        self.list.child:SetWidth(width)
        local cols = columns(self.box:GetWidth())
        for _, key in ipairs(ORDER) do
            local h, c = self.heads[key] :: Text, cols[key] :: WhoColumn
            h:ClearAllPoints()
            h:SetPoint("LEFT", self.headRow, "LEFT", c.x, 0)
            h:SetWidth(c.w)
        end
        local rows = d.state == "results" and d.results or {}
        for i, row in ipairs(rows) do
            local r = self.rows[i] or makeRow(self)
            self.rows[i] = r
            r.index, r.data = i, row
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", self.list.child, "TOPLEFT", 0, -(i - 1) * ROW_H)
            r:SetWidth(width)
            local on = self.selected == i
            r.selected:SetShown(on)
            r.edge:SetShown(on)
            local token = draw.classColor(row.class, "ink")
            draw.paint(r.dia, token)
            r.dia:ClearAllPoints()
            r.dia:SetPoint("CENTER", r, "LEFT", S["space-4"] + 3, 0)
            local function place(fs: Text, key: string, text: string?)
                local c = cols[key] :: WhoColumn
                fs:ClearAllPoints()
                fs:SetPoint("LEFT", r, "LEFT", c.x, 0)
                fs:SetWidth(c.w)
                fs:SetValue(text or "")
            end
            place(r.name, "name", row.name)
            r.name:SetColor(token)
            place(r.level, "level", row.level and tostring(row.level) or "")
            place(r.race, "race", row.race)
            place(r.class, "class", row.className)
            place(r.guild, "guild", (row.guild and row.guild ~= "") and ("<" .. row.guild .. ">") or "")
            place(r.zone, "zone", row.zone)
            r:Show()
        end
        for i = #rows + 1, #self.rows do self.rows[i]:Hide() end
        self.list.child:SetHeight(math.max(1, #rows * ROW_H))
        -- before a search, or nothing found
        local empty = d.state ~= "results"
        self.empty:SetShown(empty)
        if empty then
            local none = d.state == "none"
            self.empty.title:SetValue(none and "No players found" or "Who is online?")
            self.empty.text:SetValue(none
                and ("Nobody online matches “" .. (d.query or "") .. "” and your filters. Try fewer words, or check the Filter menu.")
                or "Search for players by name, guild, zone or level range, e.g. 20-30")
        end
        -- the foot acts on the chosen player
        local chosen = self.selected and rows[self.selected]
        for _, b in ipairs({ self.addFriend, self.whisper, self.invite }) do
            b:SetEnabledState(chosen ~= nil)
            b.tooltip = not chosen and { title = b.label:GetText(), description = "Choose a player first" } or nil
        end
    end

    function Chosen(): WhoResult?
        local d = self.data
        if not (d and d.state == "results" and self.selected and d.results) then return nil end
        return d.results[self.selected]
    end
end

export function groupFinderWho(parent: Frame): GroupFinderWho
    return GroupFinderWho.new(parent)
end
