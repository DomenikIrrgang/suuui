-- UI/ClassBars.wowlua
-- The stance/form bar and the pet bar: rows of action-sm (18px) buttons drawn
-- like ActionButton, fed from the shapeshift and pet action APIs instead of
-- action slots.
--
--   local stance = stanceBar(parent, { name = "SuuUIStanceBar" })
--   local pet = petBar(parent, { name = "SuuUIPetBar" })
--   bar:SetHotkeysShown(on); bar:SetEnabled(on); bar.header
--
-- Stance buttons cast their form by name; the row holds as many buttons as
-- you have forms (relaid out of combat when you learn one). The pet bar shows
-- itself while you have a pet and no vehicle (a secure state driver, so it
-- works in combat), and in keybind mode; right click toggles autocast
-- (/petautocasttoggle), shown as a dashed ink ring. Keys bound to the game's stance and pet commands
-- click these buttons. Anything secure waits for the end of combat.

import * as secret from "wowlua:secret"
import after from "wowlua:timer"
import tokens as T from "/Core/Tokens"
import * as combat from "/Core/Combat"
import * as events from "/Core/Events"
import * as fonts from "/Core/Fonts"
import * as extend from "/Core/Extend"
import mixins from "/Core/Init"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as actionButton from "/UI/ActionButton"
import ActionButton from "/UI/ActionButton"
import * as keybindMode from "/UI/KeybindMode"
import durationTextBinding, DurationText from "/UI/Auras"
import Text from "/UI/Text"

const S = T.space

const SLOTS = 10
-- wowlua:secret's isSecret as a local predicate: an imported one doesn't
-- narrow in wowlua 0.9.1 while the project has an import cycle (port notes)
local function isSecret(v: unknown): v is Secret<unknown> return secret.isSecret(v) end

const known = secret.known

-- Where the game's form, pet, totem, spell and cursor functions are read
-- from: the game's (a table, so tests can stand in for one).
type Game = {
    GetShapeshiftFormInfo: typeof(GetShapeshiftFormInfo),
    GetNumShapeshiftForms?: typeof(GetNumShapeshiftForms),
    GetBindingKey: typeof(GetBindingKey),
    GetPetActionInfo: typeof(GetPetActionInfo),
    GetPetActionCooldown: typeof(GetPetActionCooldown),
    GetPetActionSlotUsable?: typeof(GetPetActionSlotUsable),
    GetCVarBool: typeof(GetCVarBool),
    GetCursorInfo: typeof(GetCursorInfo),
    IsPlayerSpell?: typeof(IsPlayerSpell),
    GetMultiCastTotemSpells: typeof(GetMultiCastTotemSpells),
    GetActionInfo: typeof(GetActionInfo),
    GetTotemInfo: typeof(GetTotemInfo),
    GetTotemDuration: typeof(GetTotemDuration),
    C_Spell: {
        GetSpellName: typeof(C_Spell.GetSpellName),
        GetSpellTexture: typeof(C_Spell.GetSpellTexture),
        IsSpellUsable: typeof(C_Spell.IsSpellUsable),
    },
    C_SpellBook?: { IsSpellInSpellBook?: typeof(C_SpellBook.IsSpellInSpellBook) },
    C_DurationUtil: { CreateDuration: typeof(C_DurationUtil.CreateDuration) },
}
local G = setmetatable({}, { __index = function(_: unknown, k: string): unknown return _G[k] end }) :: Game

-- A class bar's options: the header's name, the binding list's label, and
-- what a layout or (totems) a set change calls.
export type ClassBarOptions = {
    name: string,
    label?: string,
    onLayout?: (bar: ClassBarBase) -> (),
    page?: number,
    onPage?: (page: number) -> (),
}

-- What every class bar has, whatever its buttons: what a layout's callback
-- gets.
export abstract class ClassBarBase
    name: string
    binding: string
    enabled: boolean = true
    onLayout: ((bar: ClassBarBase) -> ())? = nil
    header: Frame
    hotkeysShown: boolean = false
    size: number? = nil
    count: number? = nil

    constructor(parent: Frame, opts: ClassBarOptions, binding: string)
        self.name, self.binding = opts.name, binding
        self.onLayout = opts.onLayout
        self.header = CreateFrame("Frame", opts.name, parent, "SecureHandlerStateTemplate")
        self.header:SetSize(1, 1)
    end
end

-- A class bar: a row of action buttons on a secure header (the stance,
-- pet and totem bars). Raw.Mixins.ClassBar is the class.
export abstract class ClassBar<B extends ActionButton> extends ClassBarBase
    buttons: B[] = {}

    constructor(parent: Frame, opts: ClassBarOptions, binding: string)
        super(parent, opts, binding)
    end

    -- The SLOTS buttons of a stance or pet bar, each made by `make`.
    protected function addSlots(opts: ClassBarOptions, binding: string, make: (name: string, i: number) -> B)
        for i = 1, SLOTS do
            local b = make(opts.name .. "Button" .. i, i)
            b.bindCommand = binding .. i
            b.bindLabel = (opts.label or opts.name) .. " button " .. i
            b:SetID(0)
            b:RegisterForClicks("AnyUp", "AnyDown")
            self.buttons[i] = b
        end
    end

    function SetHotkeysShown(shown: unknown)
        self.hotkeysShown = shown ~= nil and shown ~= false
        for _, b in ipairs(self.buttons) do b:SetHotkeyShown(self.hotkeysShown) end
    end

    function UpdateBindings()
        combat.run("classbar:bind:" .. self.name, function()
            ClearOverrideBindings(self.header)
            for i, b in ipairs(self.buttons) do
                local keys = { G.GetBindingKey(self.binding .. i) }
                if self.enabled then
                    for _, key in ipairs(keys) do
                        SetOverrideBindingClick(self.header, false, key, b:GetName(), "LeftButton")
                    end
                end
                b:SetHotkey(actionButton.shortKey(keys[1]))
            end
        end, "Action bars")
    end

    -- The buttons' size (follows the dock's). Out of combat.
    function SetButtonSize(px: number)
        self.size = px
        self:Layout(self.count or SLOTS)
    end

    -- One row, buttons space-1 apart; `count` of them shown.
    function Layout(count: number?)
        combat.run("classbar:layout:" .. self.name, function()
            local n = count or SLOTS
            local px, gap = self.size or self.buttons[1]:GetWidth(), S["space-1"]
            for i, b in ipairs(self.buttons) do
                b:Resize(px)
                b:ClearAllPoints()
                b:SetPoint("BOTTOMLEFT", self.header, "BOTTOMLEFT", (i - 1) * (px + gap), 0)
                b:SetShown(i <= n)
            end
            local shown = math.max(n, 1)
            self.header:SetSize(shown * px + (shown - 1) * gap, px)
            self.count = n
            if self.onLayout then self.onLayout(self) end
        end, "Action bars")
    end

    function UpdateAll()
        for _, b in ipairs(self.buttons) do b:Update() end
    end

    -- Empty slots: with the setting, or while you drag something that fits.
    function SetShowEmpty(shown: unknown)
        for _, b in ipairs(self.buttons) do
            b.showEmpty = shown ~= nil and shown ~= false
            b:UpdateEmpty()
        end
    end

    abstract function SetEnabled(on: unknown)
end
mixins.ClassBar = ClassBar

--------------------------------------------------------------------------------
-- Stance / form bar
--------------------------------------------------------------------------------

-- A form's button: drawn from the shapeshift API.
class StanceButton extends ActionButton
    index: number = 0
    spellID: number? = nil

    constructor(parent: Frame, name: string, i: number)
        super(parent, name, "action-sm")
        self.index = i
    end

    override function Update()
        local icon, active, castable, spellID = G.GetShapeshiftFormInfo(self.index)
        self.hasAction = icon ~= nil
        self.spellID = spellID
        if self.hasAction then
            self.art:SetTexture(icon)
            self.art:Show()
            self:ShowSpellCooldown(spellID)
            self:ShowUsable(not known(castable, true))
            self:ShowActive(uiText.flag(active))
        else
            self.art:Hide()
            self.cooldown:Clear()
            self:ShowActive(false)
            self:ShowUsable(false)
        end
        self.count:SetText("")
        self:UpdateHotkey()
        self:UpdateEmpty()
    end

    override function ShowTooltip()
        GameTooltip:SetShapeshift(self.index)
    end
end

-- The stance / form bar.
export class StanceBar extends ClassBar<StanceButton>
    constructor(parent: Frame, opts: ClassBarOptions)
        super(parent, opts, "SHAPESHIFTBUTTON")
        self:addSlots(opts, "SHAPESHIFTBUTTON", function(name: string, i: number) return StanceButton.new(self.header, name, i) end)
        local function forms() self:UpdateForms() end
        local function all() self:UpdateAll() end
        events.onGame("UPDATE_SHAPESHIFT_FORMS", forms, self)
        events.onGame("PLAYER_ENTERING_WORLD", forms, self)
        events.onGame("SPELLS_CHANGED", forms, self)
        local gameEvents: EventName[] = { "UPDATE_SHAPESHIFT_FORM", "UPDATE_SHAPESHIFT_USABLE", "UPDATE_SHAPESHIFT_COOLDOWN",
                                          "SPELL_UPDATE_COOLDOWN", "SPELL_UPDATE_USABLE", "ACTIONBAR_UPDATE_COOLDOWN" }
        for _, e in ipairs(gameEvents) do
            events.onGame(e, all, self)
        end
        events.onGame("UPDATE_BINDINGS", function() self:UpdateBindings() end, self)
        self:UpdateForms()
        self:UpdateBindings()
    end

    -- Which spell each button casts, and how many buttons: out of combat.
    function UpdateForms()
        local count = G.GetNumShapeshiftForms
        local n = count and count() or 0
        combat.run("classbar:forms:" .. self.name, function()
            for i, b in ipairs(self.buttons) do
                local spellID = i <= n and select(4, G.GetShapeshiftFormInfo(i)) or nil
                local name = spellID and G.C_Spell.GetSpellName(spellID)
                b:SetAttribute("type", name and "spell" or nil)
                b:SetAttribute("spell", name)
            end
            self.header:SetShown(self.enabled and n > 0)
        end, "Action bars")
        self:Layout(n)
        self:UpdateAll()
    end

    override function SetEnabled(on: unknown)
        self.enabled = on ~= nil and on ~= false
        self:UpdateForms()
        self:UpdateBindings()
    end

end

export function stanceBar(parent: Frame, opts: ClassBarOptions): StanceBar
    return StanceBar.new(parent, opts)
end

--------------------------------------------------------------------------------
-- Pet bar
--------------------------------------------------------------------------------

-- A pet action's button: drawn from the pet action API.
class PetButton extends ActionButton
    index: number = 0
    petName: string? = nil
    autoCastAllowed: boolean? = nil
    petDuration: LuaDurationObject? = nil

    constructor(parent: Frame, name: string, i: number)
        super(parent, name, "action-sm")
        self.index = i
    end

    override function Update()
        local name, texture, isToken, isActive, autoCastAllowed, autoCastEnabled, spellID, checksRange, inRange = G.GetPetActionInfo(self.index)
        self.hasAction = name ~= nil
        self.petName, self.autoCastAllowed = name, autoCastAllowed
        if self.hasAction then
            -- (a token names a global holding the texture's path)
            local art: unknown = texture
            if isToken then art = _G[texture] end
            self.art:SetTexture(type(art) == "string" and art or texture)
            self.art:Show()
            if spellID then
                self:ShowSpellCooldown(spellID)
            else
                local start, duration = G.GetPetActionCooldown(self.index)
                local live = not isSecret(duration) and not isSecret(start) and duration and duration > 0
                local d = self.petDuration
                if live then
                    d = d or G.C_DurationUtil.CreateDuration()
                    self.petDuration = d
                    d:SetTimeFromStart(start, duration)
                end
                self:ShowCooldown(live and true or false, false, live and d or nil)
            end
            local usable = G.GetPetActionSlotUsable
            self:ShowUsable(usable and not known(usable(self.index), true) or false)
            self:ShowActive(uiText.flag(isActive))
            self:ShowAutocast(uiText.flag(autoCastEnabled))
            self:SetOutOfRange(uiText.flag(checksRange) and not known(inRange, true))
        else
            self.art:Hide()
            self.cooldown:Clear()
            self:ShowActive(false)
            self:ShowAutocast(false)
            self:ShowUsable(false)
            self:SetOutOfRange(false)
        end
        self.count:SetText("")
        self:UpdateHotkey()
        self:UpdateEmpty()
    end

    override function ShowTooltip()
        GameTooltip:SetPetAction(self.index)
    end
end

local PET_VISIBILITY = "[@pet,exists,nopossessbar,novehicleui] show; hide"

local PET_DRAG = [[
    if self:GetAttribute("suu-locked") and not IsModifiedClick("PICKUPACTION") then return false end
    return "petaction", self:GetAttribute("action")
]]
local PET_RECEIVE = [[ return "petaction", self:GetAttribute("action") ]]

-- The pet bar.
export class PetBar extends ClassBar<PetButton>
    constructor(parent: Frame, opts: ClassBarOptions)
        super(parent, opts, "BONUSACTIONBUTTON")
        self:addSlots(opts, "BONUSACTIONBUTTON", function(name: string, i: number) return PetButton.new(self.header, name, i) end)
        for i, b in ipairs(self.buttons) do
            b:SetAttribute("type", "pet")
            b:SetAttribute("action", i)
            b:RegisterForDrag("LeftButton")
            SecureHandlerWrapScript(b, "OnDragStart", self.header, PET_DRAG)
            SecureHandlerWrapScript(b, "OnReceiveDrag", self.header, PET_RECEIVE)
        end
        self:Layout(SLOTS)
        local function lock()
            combat.run("classbar:lock:" .. self.name, function()
                local locked = G.GetCVarBool("lockActionBars") and true or false
                for _, b in ipairs(self.buttons) do b:SetAttribute("suu-locked", locked) end
            end, "Action bars")
        end
        lock()
        events.onGame("CVAR_UPDATE", lock, self)
        -- A pet ability on the cursor shows the empty slots it can go to.
        events.onGame("CURSOR_CHANGED", function()
            local on = G.GetCursorInfo() == "petaction"
            for _, b in ipairs(self.buttons) do b:SetGrid(on) end
        end, self)

        local function all()
            self:UpdateAll()
            self:UpdateAutocastClicks()
        end
        local gameEvents: EventName[] = { "PET_BAR_UPDATE", "PET_UI_UPDATE", "PLAYER_CONTROL_LOST", "PLAYER_CONTROL_GAINED",
                                          "PLAYER_FARSIGHT_FOCUS_CHANGED", "PLAYER_ENTERING_WORLD", "PET_BAR_UPDATE_USABLE" }
        for _, e in ipairs(gameEvents) do
            events.onGame(e, all, self)
        end
        events.onGame("PET_BAR_UPDATE_COOLDOWN", function() self:UpdateAll() end, self)
        events.onUnit("UNIT_PET", "player", all, self)
        events.onUnit("UNIT_FLAGS", "pet", all, self)
        events.onUnit("UNIT_AURA", "pet", all, self)
        events.onGame("UPDATE_BINDINGS", function() self:UpdateBindings() end, self)
        events.on("SUUUI_KEYBINDMODE_CHANGED", function() self:UpdateShown() end, self)
        self:SetEnabled(true)
        all()
    end

    -- Right click toggles autocast where the ability allows it. Out of combat.
    function UpdateAutocastClicks()
        combat.run("classbar:autocast:" .. self.name, function()
            for _, b in ipairs(self.buttons) do
                local name = b.petName
                local allowed = name ~= nil and uiText.flag(b.autoCastAllowed)
                b:SetAttribute("type2", allowed and "macro" or "pet")
                b:SetAttribute("macrotext2", allowed and ("/petautocasttoggle " .. (name or "")) or nil)
            end
        end, "Action bars")
    end

    -- Shown by its state driver; keybind mode shows it even without a pet, so
    -- its keys can be bound (the driver comes back when the mode ends). Out of
    -- combat.
    function UpdateShown()
        combat.run("classbar:shown:" .. self.name, function()
            local binding = keybindMode.isActive()
            UnregisterStateDriver(self.header, "visibility")
            if not self.enabled then
                self.header:Hide()
            elseif binding then
                self.header:Show()
            else
                RegisterStateDriver(self.header, "visibility", PET_VISIBILITY)
            end
        end, "Action bars")
    end

    override function SetEnabled(on: unknown)
        self.enabled = on ~= nil and on ~= false
        self:UpdateShown()
        self:UpdateBindings()
    end

end

export function petBar(parent: Frame, opts: ClassBarOptions): PetBar
    return PetBar.new(parent, opts)
end

--------------------------------------------------------------------------------
-- Totem bar (1.6d; the design's "Totem bar options", direction B)
--------------------------------------------------------------------------------
-- A shaman's totems in the stance bar's place: the four elements (earth,
-- fire, water, air) as action-sm buttons that cast the totem the game's own
-- totem bar holds for each, a thin strip above them with each totem's time
-- left and its drain, and after a hairline Call of the Elements and Totemic
-- Recall once learned (Recall faint while no totem is down; asked
-- 2026-10-18: its own button at the right end). An element with no totem
-- yet is dashed with its glyph. Probed 2026-10-18:
--   * left click: the game's slot action (132 + slot on page 1), cast by a
--     secure "action" button, in combat too; right click: "destroytotem"
--   * the strip runs from GetTotemDuration's duration object (in combat the
--     totem's values are secret, but the object comes, nil when empty):
--     the drain through SetTimerDuration, the time through a text binding
--   * sets (asked 2026-10-18): Call of the Elements, of the Ancestors and of
--     the Spirits each drop their own four (the game's pages 1-3: slot
--     actions 132 + (page - 1) * 4 + slot); the arrow under the Call button
--     lists the sets you know, out of combat, and the four buttons, their
--     lists and the Call button follow the chosen one
--   * choosing a slot's totem: secure "multispell" buttons in a list over
--     the slot, opened by the arrow that shows under it on hover (out of
--     combat)
--   * the slots' actions have no texture: the icon is the spell's
-- The game has no key bindings for its totem buttons on this client.
--
--   local totems = totemBar(parent, { name = "SuuUITotemBar", page = 1, onPage = fn(page) })
--   totems:SetButtonSize(px); totems:SetEnabled(on); totems:SetPage(page); totems.header

local GLYPH = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local WHITE = "Interface\\Buttons\\WHITE8X8"
local STRIP_H = 12
local EXPIRE = 3

type Element = { slot: number, glyph: string, word: string }
local ELEMENTS: Element[] = {
    { slot = EARTH_TOTEM_SLOT or 2, glyph = "rock", word = "Earth" },
    { slot = FIRE_TOTEM_SLOT or 1, glyph = "sun", word = "Fire" },
    { slot = WATER_TOTEM_SLOT or 3, glyph = "drop", word = "Water" },
    { slot = AIR_TOTEM_SLOT or 4, glyph = "wave", word = "Air" },
}
local RECALL = (TOTEM_MULTI_CAST_RECALL_SPELLS and TOTEM_MULTI_CAST_RECALL_SPELLS[1]) or 36936
-- the summon spells, one per set: Call of the Elements, Ancestors, Spirits
local SUMMONS: number[] = TOTEM_MULTI_CAST_SUMMON_SPELLS :: number[] or { 66842, 66843, 66844 }

local DIR = Enum.StatusBarTimerDirection or {}
local IMMEDIATE = Enum.StatusBarInterpolation and Enum.StatusBarInterpolation.Immediate

local function knows(spellID: number?): boolean
    if not spellID then return false end
    local book = G.C_SpellBook
    local inBook = book and book.IsSpellInSpellBook
    if inBook then
        local ok, yes = pcall(inBook, spellID, Enum.SpellBookSpellBank.Player, false)
        if ok then return yes and true or false end
    end
    local isPlayerSpell = G.IsPlayerSpell
    return isPlayerSpell and isPlayerSpell(spellID) or false
end

-- The totems you know for an element (the game's list for its slot).
local function elementSpells(slot: number): number[]
    local ok, list = pcall(function(): number[] return { G.GetMultiCastTotemSpells(slot) } end)
    return ok and list or {}
end

-- The game's action for an element's slot in a set (its bar's page).
local function slotAction(slot: number, page: number?): number
    return 132 + ((page or 1) - 1) * 4 + slot
end

-- The spell an element's slot holds in a set (readable in combat too).
local function slotSpell(slot: number, page: number?): number?
    local kind, id = G.GetActionInfo(slotAction(slot, page))
    if kind == "spell" and id and not isSecret(id) then return id :: number end
    return nil
end

-- An element's empty look: dashed, its glyph faint (the design's).
class EmptyLook extends Frame
    readonly glyph: Texture

    constructor(parent: Frame, element: Element)
        super(nil, parent)
        self:SetAllPoints()
        draw.fill(self, "surface-sunk", "BACKGROUND", 1):SetAllPoints()
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPH .. element.glyph .. ".tga")
        draw.paint(self.glyph, "ink-faint")
        self.glyph:SetPoint("CENTER")
    end
end

-- The strip over an element: its time and drain while its totem is down.
class StripSegment extends Frame
    readonly track: Texture
    readonly drain: StatusBar
    readonly text: FontString
    readonly binding: DurationText?

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(STRIP_H)
        self.track = self:CreateTexture(nil, "BACKGROUND")
        self.track:SetPoint("BOTTOMLEFT")
        self.track:SetPoint("BOTTOMRIGHT")
        self.track:SetHeight(2)
        draw.paintFill(self.track, "track")
        self.drain = CreateFrame("StatusBar", nil, self)
        self.drain:SetPoint("BOTTOMLEFT")
        self.drain:SetPoint("BOTTOMRIGHT")
        self.drain:SetHeight(2)
        self.drain:SetStatusBarTexture(WHITE)
        draw.paint(self.drain, "ink")
        self.drain:SetMinMaxValues(0, 1)
        self.drain:Hide()
        self.text = self:CreateFontString(nil, "OVERLAY")
        fonts.apply(self.text, "micro")
        self.text:SetShadowColor(0, 0, 0, 1)
        self.text:SetShadowOffset(0, -1)
        self.text:SetPoint("TOP", 0, 0)
        self.text:SetJustifyH("CENTER")
        self.binding = durationTextBinding(self.text, EXPIRE)
    end
end

-- The arrow on a hovered button, under its bottom edge: opens its list
-- (an element's totems while it has more than one; the Call button's sets
-- while you know more than one). Out of combat.
class PickArrow extends Button
    readonly bg: Texture
    readonly icon: Texture
    over: boolean = false

    constructor(b: Button, open: () -> (), wanted: () -> boolean)
        -- under the button: above it the strip shows the time (asked in game:
        -- the timer covered the arrow while a totem was down)
        super(nil, b)
        self:SetSize(14, 8)
        self:SetPoint("TOP", b, "BOTTOM", 0, 3)
        self:SetFrameStrata("HIGH")
        self.bg = draw.fill(self, "surface-glass", "BACKGROUND")
        self.bg:SetAllPoints()
        self.icon = self:CreateTexture(nil, "ARTWORK")
        self.icon:SetTexture(GLYPH .. "chevronUp.tga")
        draw.paint(self.icon, "gilt-text")
        self.icon:SetSize(10, 10)
        self.icon:SetPoint("CENTER")
        self:SetScript("OnClick", open)
        self:SetScript("OnEnter", function() self.over = true end)
        self:SetScript("OnLeave", function()
            self.over = false
            after(0.3, function() if not (self.over or b:IsMouseOver()) then self:Hide() end end)
        end)
        self:Hide()
        b:HookScript("OnEnter", function()
            if not InCombatLockdown() and wanted() then self:Show() end
        end)
        b:HookScript("OnLeave", function()
            after(0.3, function() if not (self.over or b:IsMouseOver()) then self:Hide() end end)
        end)
    end
end

-- An element's button: casts the totem its slot holds in the bar's set.
class TotemButton extends ActionButton
    readonly element: Element
    readonly bar: TotemBar
    empty: EmptyLook
    segment: StripSegment
    arrow?: PickArrow
    spellID: number? = nil
    known: boolean = false
    picking: boolean = false
    castAt: number? = nil
    -- whether the totem down is the one it casts (kept while combat hides it)
    chosen: boolean? = nil

    constructor(bar: TotemBar, name: string, element: Element)
        super(bar.header, name, "action-sm")
        self.element, self.bar = element, bar
        self.empty = EmptyLook.new(self.face, element)
        self.segment = StripSegment.new(bar.header)
        -- the dashes: the pet bar's autocast ring, in gilt-faint (showEmpty)
        self:ShowAutocast(true)
    end

    -- The empty look (dashes, the faint glyph) while the slot holds nothing; by
    -- alpha, so it changes in combat too.
    function ShowEmptyLook()
        local on = not self.hasAction
        self.empty:SetAlpha(on and 1 or 0)
        for _, t in ipairs(self.dashes or {}) do
            draw.paintFill(t, "gilt-faint")
            t:SetAlpha(on and 1 or 0)
        end
    end

    override function Update()
        local spellID = slotSpell(self.element.slot, self.bar.page)
        self.spellID = spellID
        self.hasAction = spellID ~= nil
        self.known = #elementSpells(self.element.slot) > 0
        if spellID then
            self.art:SetTexture((G.C_Spell.GetSpellTexture(spellID)))
            self.art:Show()
            self:ShowSpellCooldown(spellID)
            local usable, noMana = G.C_Spell.IsSpellUsable(spellID)
            self:ShowUsable(not (known(usable, true) and not known(noMana, false)))
        else
            self.art:Hide()
            self.cooldown:Clear()
            self:ShowUsable(false)
        end
        self:ShowEmptyLook()
        self:ShowActive(self.picking)
        self.count:SetText("")
        self:UpdateHotkey()
        self:UpdateEmpty()
    end

    override function ShowTooltip()
        if self.spellID then GameTooltip:SetSpellByID(self.spellID) end
        if self.known then
            local cr, cg, cb = draw.rgba("ink-muted")
            GameTooltip:AddLine("Right click: dismiss it. The arrow: choose another.", cr, cg, cb, true)
        end
    end
end

-- Call of the Elements: casts the set's summon spell; its arrow, the sets.
class CallButton extends ActionButton
    readonly bar: TotemBar
    spellID: number? = nil
    arrow?: PickArrow

    constructor(bar: TotemBar, name: string)
        super(bar.header, name, "action-sm")
        self.bar = bar
        self.showEmpty = false
    end

    override function Update() end

    override function ShowTooltip()
        if self.spellID then GameTooltip:SetSpellByID(self.spellID) end
        if self.bar.knownSets > 1 then
            local cr, cg, cb = draw.rgba("ink-muted")
            GameTooltip:AddLine("The arrow: another set of totems.", cr, cg, cb, true)
        end
    end
end

-- Totemic Recall.
class RecallButton extends ActionButton
    constructor(bar: TotemBar, name: string)
        super(bar.header, name, "action-sm")
        self.showEmpty = false
    end

    override function Update() end

    override function ShowTooltip() GameTooltip:SetSpellByID(RECALL) end
end

-- A row of a list over the bar: its hover, icon, label and tick.
class PickRow extends Button
    readonly hover: Texture
    readonly icon: Texture
    readonly label: Text
    readonly check: Texture
    -- (the sets' list) the set and its four totems
    page: number = 1
    totems: Texture[] = {}

    constructor(parent: Frame, template: string?, height: number, iconSize: number)
        super(nil, parent, template)
        self:SetHeight(height)
        self.hover = draw.fill(self, "surface-raised", "BACKGROUND")
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.icon = self:CreateTexture(nil, "ARTWORK")
        self.icon:SetSize(iconSize, iconSize)
        self.icon:SetPoint("LEFT", 4, 0)
        self.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        self.label = uiText.text(self, "caption", "ink")
        self.label:SetPoint("LEFT", self.icon, "RIGHT", 6, 0)
        self.check = self:CreateTexture(nil, "ARTWORK")
        self.check:SetTexture(GLYPH .. "check.tga")
        draw.paint(self.check, "gilt-text")
        self.check:SetSize(10, 10)
        self.check:SetPoint("RIGHT", -6, 0)
        self:SetScript("OnEnter", function() self.hover:Show() end)
        self:SetScript("OnLeave", function() self.hover:Hide() end)
    end
end

-- A list over the bar (an element's totems, the sets): a glass panel with a
-- title, its rows, and a catcher that closes it on a click elsewhere.
class PickList extends Frame
    readonly title: Text
    readonly rows: PickRow[] = {}
    readonly catcher: Button

    constructor(onOutside: () -> ())
        super(nil, UIParent)
        self:SetFrameStrata("DIALOG")
        draw.fill(self, "surface-glass", "BACKGROUND"):SetAllPoints()
        draw.border(self, "gilt-line")
        self.title = uiText.text(self, "micro", "gilt-text")
        self.title:SetPoint("TOPLEFT", 8, -6)
        -- a click anywhere else closes it
        local catcher = CreateFrame("Button", nil, UIParent)
        self.catcher = catcher
        catcher:SetFrameStrata("DIALOG")
        catcher:SetAllPoints(UIParent)
        catcher:RegisterForClicks("AnyUp")
        catcher:SetScript("OnClick", onOutside)
        catcher:Hide()
        self:SetFrameLevel(catcher:GetFrameLevel() + 5)
        self:Hide()
    end
end

-- Whether the totem down in a slot is the one its button casts (asked
-- 2026-10-18: a totem chosen in its place hides the old one's time). Out of
-- combat the slot's spell answers (GetTotemInfo, by ID or by name: a rank
-- may differ); in combat it is secret, so the answer is kept, and a totem
-- that goes down just after its button or Call was clicked is the chosen one.
local function totemIsChosen(b: TotemButton): boolean
    local slot = b.element.slot
    local ok, have, _, _, _, _, _, spellID = pcall(G.GetTotemInfo, slot)
    if not ok or isSecret(have) or isSecret(spellID) then
        if b.castAt and GetTime() - b.castAt < 1 then b.chosen = true end
        return b.chosen ~= false
    end
    b.castAt = nil
    if not have then
        b.chosen = nil
        return true
    end
    local chosen = slotSpell(slot, b.bar.page)
    local same = not chosen or spellID == chosen
        or (G.C_Spell.GetSpellName(spellID :: number) or 1) == (G.C_Spell.GetSpellName(chosen) or 2)
    b.chosen = same and true or false
    return b.chosen == true
end

-- The totem bar (Forever): a button per element, Call and Recall.
export class TotemBar extends ClassBar<TotemButton>
    page: number = 1
    onPage: ((page: number) -> ())? = nil
    rule: Texture
    call: CallButton
    recall: RecallButton
    hasCall: boolean = false
    knownSets: number = 0
    hasRecall: boolean = false
    anyKnown: boolean = false
    picker: PickList? = nil
    sets: PickList? = nil

    constructor(parent: Frame, opts: ClassBarOptions)
        super(parent, opts, "MULTICASTACTIONBUTTON")
        self.page, self.onPage = opts.page or 1, opts.onPage
        for i, element in ipairs(ELEMENTS) do
            local b = TotemButton.new(self, opts.name .. "Button" .. i, element)
            b:SetID(0)
            b:RegisterForClicks("AnyUp", "AnyDown")
            b.showEmpty = true
            b.bindLabel = (opts.label or opts.name) .. ": " .. element.word
            b.arrow = PickArrow.new(b, function() self:OpenPicker(b) end, function() return #elementSpells(element.slot) > 1 end)
            b:HookScript("OnClick", function(_: Button, button: string) if button == "LeftButton" then b.castAt = GetTime() end end)
            self.buttons[i] = b
        end
        -- Call of the Elements, after a hairline
        self.rule = self.header:CreateTexture(nil, "ARTWORK")
        self.rule:SetSize(1, 12)
        draw.paintFill(self.rule, "gilt-hairline")
        self.call = CallButton.new(self, opts.name .. "Call")
        self.call:SetID(0)
        self.call:RegisterForClicks("AnyUp", "AnyDown")
        self.call.arrow = PickArrow.new(self.call, function() self:OpenSets() end, function() return self.knownSets > 1 end)
        self.call:HookScript("OnClick", function()
            for _, b in ipairs(self.buttons) do b.castAt = GetTime() end
        end)
        -- Totemic Recall: the last button, on the right of Call
        self.recall = RecallButton.new(self, opts.name .. "Recall")
        self.recall:SetID(0)
        self.recall:RegisterForClicks("AnyUp", "AnyDown")

        local function refresh() self:Refresh() end
        local function all() self:UpdateAll() end
        local gameEvents: EventName[] = { "PLAYER_ENTERING_WORLD", "SPELLS_CHANGED", "UPDATE_MULTI_CAST_ACTIONBAR", "LEARNED_SPELL_IN_SKILL_LINE" }
        for _, e in ipairs(gameEvents) do
            pcall(events.onGame, e, refresh, self)
        end
        local updates: EventName[] = { "ACTIONBAR_SLOT_CHANGED", "SPELL_UPDATE_COOLDOWN", "SPELL_UPDATE_USABLE", "ACTIONBAR_UPDATE_COOLDOWN" }
        for _, e in ipairs(updates) do
            events.onGame(e, all, self)
        end
        events.onGame("PLAYER_TOTEM_UPDATE", function() self:UpdateTimers() end, self)
        -- out of a fight the slots' totems can be read again
        events.onGame("PLAYER_REGEN_ENABLED", function() self:UpdateTimers() end, self)
        -- a fight closes the list while it still may (the start of combat
        -- allows it)
        events.onGame("PLAYER_REGEN_DISABLED", function()
            self:ClosePicker()
            local sets = self.sets
            if sets and sets:IsShown() then sets:Hide(); sets.catcher:Hide() end
        end, self)
        self:Refresh()
        extend.add(extend.Kind.ActionBar, self, { name = opts.name, totems = true })
    end

    -- Every element's time and drain (only for the totem its button casts), and
    -- Recall faint while nothing is down. The duration object comes in combat
    -- too (its values secret); none: empty.
    function UpdateTimers()
        local anyDown = false
        for _, b in ipairs(self.buttons) do
            local s = b.segment
            local ok, d = pcall(G.GetTotemDuration, b.element.slot)
            if ok and d then anyDown = true end
            if ok and d and totemIsChosen(b) then
                pcall(s.drain.SetTimerDuration, s.drain, d, IMMEDIATE, DIR.RemainingTime)
                s.drain:Show()
                local binding = s.binding
                if binding then
                    pcall(binding.SetDuration, binding, d)
                    pcall(binding.SetEnabled, binding, true)
                end
                s.text:Show()
            else
                s.drain:Hide()
                local binding = s.binding
                if binding then pcall(binding.SetEnabled, binding, false) end
                s.text:SetText("")
                s.text:Hide()
            end
        end
        -- Recall: faint while no totem is down (an alpha: in combat too)
        self.recall:ShowUsable(not anyDown)
    end

    -- Which totem each button casts and what the bar holds: out of combat.
    function Refresh()
        combat.run("classbar:totems:" .. self.name, function()
            local anyKnown = false
            -- the set: the chosen one while you know its summon spell, else the first
            if self.page ~= 1 and not knows(SUMMONS[self.page]) then self.page = 1 end
            for _, b in ipairs(self.buttons) do
                local slot = b.element.slot
                b:SetAttribute("type1", "action")
                b:SetAttribute("action", slotAction(slot, self.page))
                b:SetAttribute("type2", "destroytotem")
                b:SetAttribute("totem-slot", slot)
                if #elementSpells(slot) > 0 then anyKnown = true end
            end
            local summon = SUMMONS[self.page]
            self.hasCall = knows(summon)
            self.knownSets = 0
            for _, id in ipairs(SUMMONS) do if knows(id) then self.knownSets = self.knownSets + 1 end end
            self.call:SetAttribute("type", self.hasCall and "spell" or nil)
            self.call:SetAttribute("spell", self.hasCall and summon or nil)
            self.call.spellID = self.hasCall and summon or nil
            self.hasRecall = knows(RECALL)
            self.recall:SetAttribute("type", self.hasRecall and "spell" or nil)
            self.recall:SetAttribute("spell", self.hasRecall and RECALL or nil)
            self.header:SetShown(self.enabled and anyKnown)
            self.anyKnown = anyKnown
            self:Layout()
        end, "Action bars")
        self:UpdateAll()
    end

    override function UpdateAll()
        for _, b in ipairs(self.buttons) do b:Update() end
        local c = self.call
        local spellID = c.spellID
        if spellID then
            c.hasAction = true
            c.art:SetTexture((G.C_Spell.GetSpellTexture(spellID)))
            c.art:Show()
            c:ShowSpellCooldown(spellID)
        else
            c.hasAction = false
        end
        c:UpdateEmpty()
        local r = self.recall
        r.hasAction = self.hasRecall
        if r.hasAction then
            r.art:SetTexture((G.C_Spell.GetSpellTexture(RECALL)))
            r.art:Show()
            r:ShowSpellCooldown(RECALL)
        end
        r:UpdateEmpty()
        self:UpdateTimers()
    end

    -- The row and the strip over it (Call of the Elements after a hairline),
    -- Call and Recall after a hairline.
    override function Layout(_count: number?)
        combat.run("classbar:totemlayout:" .. self.name, function()
            local px, gap = self.size or 18, S["space-2"]
            local rowY = 0
            local stripY = px + S["space-1"]
            for i, b in ipairs(self.buttons) do
                b:Resize(px)
                b:ClearAllPoints()
                b:SetPoint("BOTTOMLEFT", self.header, "BOTTOMLEFT", (i - 1) * (px + gap), rowY)
                b.empty.glyph:SetSize(math.floor(px * 0.55), math.floor(px * 0.55))
                -- Resize draws the dashes again at a new size (in ink): gilt-faint
                b:ShowEmptyLook()
                local s = b.segment
                s:ClearAllPoints()
                s:SetPoint("BOTTOMLEFT", self.header, "BOTTOMLEFT", (i - 1) * (px + gap), stripY)
                s:SetWidth(px)
            end
            local rowEnd = #self.buttons * (px + gap) - gap
            self.rule:ClearAllPoints()
            self.rule:SetPoint("BOTTOMLEFT", self.header, "BOTTOMLEFT", rowEnd + 2, math.floor((px - 12) / 2))
            self.rule:SetShown(self.hasCall or self.hasRecall)
            -- after the hairline: Call, then Recall, each only once learned
            local x = rowEnd + 5
            local extras: { button: ActionButton, shown: boolean }[] = {
                { button = self.call, shown = self.hasCall }, { button = self.recall, shown = self.hasRecall },
            }
            for _, extra in ipairs(extras) do
                local b, shown = extra.button, extra.shown
                b:Resize(px)
                b:ClearAllPoints()
                b:SetPoint("BOTTOMLEFT", self.header, "BOTTOMLEFT", x, rowY)
                b:SetShown(shown)
                if shown then x = x + px + gap end
            end
            local width = (self.hasCall or self.hasRecall) and (x - gap) or rowEnd
            self.header:SetSize(width, stripY + STRIP_H)
            if self.onLayout then self.onLayout(self) end
        end, "Action bars")
    end

    override function SetButtonSize(px: number)
        self.size = px
        self:Layout()
    end

    override function SetEnabled(on: unknown)
        self.enabled = on ~= nil and on ~= false
        self:Refresh()
    end

    -- The list of an element's totems, over its slot: one secure "multispell"
    -- row each (the game's own way of choosing), the chosen one ticked. Out of
    -- combat only: it closes when a fight starts.
    function OpenPicker(b: TotemButton)
        if InCombatLockdown() then return end
        local p = self.picker
        if not p then
            p = PickList.new(function() self:ClosePicker() end)
            p:SetSize(136, 40)
            self.picker = p
        end
        local slot = b.element.slot
        local chosen = slotSpell(slot, self.page)
        local spells = elementSpells(slot)
        p.title:SetValue((b.element.word .. " totems"):upper())
        local y = -6 - 12 - 4
        for i, id in ipairs(spells) do
            local r = p.rows[i]
            if not r then
                r = PickRow.new(p, "SecureActionButtonTemplate", 20, 14)
                r:RegisterForClicks("AnyUp", "AnyDown")
                r:HookScript("PostClick", function()
                    after(0, function() self:ClosePicker(); self:UpdateAll() end)
                end)
                p.rows[i] = r
            end
            r:SetAttribute("type", "multispell")
            r:SetAttribute("action", slotAction(slot, self.page))
            r:SetAttribute("spell", id)
            r.icon:SetTexture((G.C_Spell.GetSpellTexture(id)))
            r.label:SetValue(G.C_Spell.GetSpellName(id) or "")
            r.check:SetShown(id == chosen)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 4, y)
            r:SetPoint("TOPRIGHT", -4, y)
            r:Show()
            y = y - 21
        end
        for i = #spells + 1, #p.rows do p.rows[i]:Hide() end
        p:SetHeight(-y + 4)
        p:ClearAllPoints()
        p:SetPoint("BOTTOMLEFT", b, "TOPLEFT", 0, STRIP_H + S["space-1"] + 6)
        for _, other in ipairs(self.buttons) do other.picking = other == b end
        p.catcher:Show()
        p:Show()
        self:UpdateAll()
    end

    function ClosePicker()
        local p = self.picker
        if not p or InCombatLockdown() then return end
        p:Hide()
        p.catcher:Hide()
        for _, b in ipairs(self.buttons) do b.picking = false end
        self:UpdateAll()
    end

    -- The set the bar works on (1-3: Call of the Elements, Ancestors,
    -- Spirits). Out of combat.
    function SetPage(page: number)
        if InCombatLockdown() then return end
        self.page = page
        if self.onPage then self.onPage(page) end
        self:Refresh()
    end

    -- The list of your sets over the Call button: each summon spell you know,
    -- its four chosen totems after it, the one in use ticked. Out of combat.
    function OpenSets()
        if InCombatLockdown() then return end
        local p = self.sets
        if not p then
            local list: PickList
            list = PickList.new(function() list:Hide(); list.catcher:Hide() end)
            list.title:SetValue("TOTEM SETS")
            self.sets = list
            p = list
        end
        local y, n = -6 - 12 - 4, 0
        for page, id in ipairs(SUMMONS) do
            if knows(id) then
                n = n + 1
                local r = p.rows[n]
                if not r then
                    local row = PickRow.new(p, nil, 22, 16)
                    r = row
                    for k = 1, 4 do
                        local t = row:CreateTexture(nil, "ARTWORK")
                        t:SetSize(12, 12)
                        t:SetTexCoord(0.08, 0.92, 0.08, 0.92)
                        row.totems[k] = t
                    end
                    local list = p
                    row:SetScript("OnClick", function()
                        list:Hide()
                        list.catcher:Hide()
                        self:SetPage(row.page)
                    end)
                    p.rows[n] = row
                end
                r.page = page
                r.icon:SetTexture((G.C_Spell.GetSpellTexture(id)))
                r.label:SetValue(G.C_Spell.GetSpellName(id) or "")
                -- its four totems, earth to air, before the tick
                local x = -22
                for k = #ELEMENTS, 1, -1 do
                    local t = r.totems[k]
                    local sid = slotSpell(ELEMENTS[k].slot, page)
                    t:ClearAllPoints()
                    t:SetPoint("RIGHT", x, 0)
                    t:SetTexture(sid and G.C_Spell.GetSpellTexture(sid) or nil)
                    t:SetShown(sid ~= nil)
                    x = x - 14
                end
                r.check:SetShown(page == self.page)
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", 4, y)
                r:SetPoint("TOPRIGHT", -4, y)
                r:Show()
                y = y - 23
            end
        end
        for i = n + 1, #p.rows do p.rows[i]:Hide() end
        p:SetSize(240, -y + 4)
        p:ClearAllPoints()
        p:SetPoint("BOTTOMLEFT", self.call, "TOPLEFT", 0, STRIP_H + S["space-1"] + 6)
        p.catcher:Show()
        p:Show()
    end

end

export function totemBar(parent: Frame, opts: ClassBarOptions): TotemBar
    return TotemBar.new(parent, opts)
end
