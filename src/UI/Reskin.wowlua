-- UI/Reskin.wowlua
-- Blizzard's list and detail parts in SuuUI's look, restyled in place (Phase
-- 3's windows): rows, collapsible category bars, status bars, check
-- buttons, the thin scrollbar, dividers. Clicks and data stay Blizzard's; a
-- pass only changes how things look, so it can run again whenever Blizzard
-- redraws (each ScrollBox update).
--
--   reskin(frame)                 -- the frame and everything in it, once more
--                                 -- (SuuUI's own frames skipped: markOwn)
--   reskinScrollBox(box)          -- its rows now and after every update
--   reskinStatusBar(bar)          -- a flat bar on a track, standing colours kept
--   reskinCheckButton(button)     -- a 16px box, arcane check
--   reskinScrollBar(bar)          -- no track art, a 2px gilt-line thumb
--
-- What a pass does, by what it finds (Blizzard's atlas names, probed in the
-- Character window 2026-10-13):
--   *collapseExpand*, *ScrollLine*, *insideframe*, *stat-bar-BG*, the
--   panes' backgrounds: hidden
--   a row's minus/plus state icon: tinted gilt-text
--   a category row (one with a collapse/expand bar): its name in `header`
--   gilt-text, a gilt-faint rule under it
--   *highlight*/*hover* textures: surface-raised; *select* ones: arcane-soft
--   text: Blizzard's yellow and white become ink, grey ink-muted, green fel,
--   red ember-text; the font follows the text's size (label, body, caption);
--   big titles become `header` gilt-text
--
-- This file is the entry point: it re-exports what its parts define, so
-- importers see one module.
--   Reskin/Registry  SuuUI's own frames and art (markOwn, markArt), what is
--                    left alone (leave), what a pass did to each part (Skin),
--                    and the undo list of the shared frames
--   Reskin/Pieces    the one-off pieces: scroll bar, status bar, fill bar,
--                    icon button, check button, button, edit box, collapse
--   Reskin/Menu      Blizzard's menus (undone on close) and dropdowns
--   Reskin/Pass      the generic pass: textures, texts, ScrollBox rows,
--                    small dialogs
--   Reskin/Popup     the shared StaticPopups (undone when they hide)
import * as registry from "./Reskin/Registry"
import * as pieces from "./Reskin/Pieces"
import * as menu from "./Reskin/Menu"
import * as passes from "./Reskin/Pass"
import * as popup from "./Reskin/Popup"

-- SuuUI's own frames and art, and what the passes leave alone
export const markOwn = registry.markOwn
export const isOwn = registry.isOwn
export const markArt = registry.markArt
export const isArt = registry.isArt
export type Leave = registry.Leave
export const leave = registry.leave

-- what a pass did to each of the game's parts
export type IconSkin = registry.IconSkin
export type CheckSkin = registry.CheckSkin
export type Skin = registry.Skin

-- pieces
export const reskinScrollBar = pieces.reskinScrollBar
export const reskinStatusBar = pieces.reskinStatusBar
export const reskinFillBar = pieces.reskinFillBar
export const reskinIconButton = pieces.reskinIconButton
export const reskinCheckButton = pieces.reskinCheckButton
export const reskinButton = pieces.reskinButton
export const reskinEditBox = pieces.reskinEditBox
export const reskinCollapseButton = pieces.reskinCollapseButton

-- menus and dropdowns
export const openRoot = menu.openRoot
export const reskinMenu = menu.reskinMenu
export const reskinDropdown = menu.reskinDropdown

-- a pass over a frame
export const reskin = passes.reskin
export const reskinPart = passes.reskinPart
export const reskinScrollBox = passes.reskinScrollBox
export const reskinDialog = passes.reskinDialog

-- popups
export const PopupSkin = popup.PopupSkin
export type PopupSkin = popup.PopupSkin
export const reskinPopup = popup.reskinPopup
