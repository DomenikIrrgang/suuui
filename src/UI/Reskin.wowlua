-- UI/Reskin.wowlua
-- Blizzard's list and detail parts in SuuUI's look, restyled in place (Phase
-- 3's windows): rows, collapsible category bars, status bars, check
-- buttons, the thin scrollbar, dividers. Clicks and data stay Blizzard's; a
-- pass only changes how things look, so it can run again whenever Blizzard
-- redraws (each ScrollBox update).
--
--   reskin(frame)                 -- the frame and everything in it, once more
--                                 -- (SuuUI's own frames skipped: markOwn)
--   reskinScrollBox(box)          -- its rows now and after every update
--   reskinStatusBar(bar)          -- a flat bar on a track, standing colours kept
--   reskinCheckButton(button)     -- a 16px box, arcane check
--   reskinScrollBar(bar)          -- no track art, a 2px gilt-line thumb
--
-- What a pass does, by what it finds (Blizzard's atlas names, probed in the
-- Character window 2026-10-13):
--   *collapseExpand*, *ScrollLine*, *insideframe*, *stat-bar-BG*, the
--   panes' backgrounds: hidden
--   a row's minus/plus state icon: tinted gilt-text
--   a category row (one with a collapse/expand bar): its name in `header`
--   gilt-text, a gilt-faint rule under it
--   *highlight*/*hover* textures: surface-raised; *select* ones: arcane-soft
--   text: Blizzard's yellow and white become ink, grey ink-muted, green fel,
--   red ember-text; the font follows the text's size (label, body, caption);
--   big titles become `header` gilt-text
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as fonts from "/Core/Fonts"
import * as draw from "/UI/Draw"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local WHITE = "Interface\\Buttons\\WHITE8X8"

local HIDE: string[] = { "collapseexpand", "scrollline", "insideframe", "stat%-bar%-bg", "stat%-bg", "%-info%-.*%-bg",
               "stattab", "button%-list%-header", "common%-search%-border", "plunderstorm" }
local BAR_COLORS: { [string]: string } = {
    red = "rep-hostile", orange = "rep-unfriendly", yellow = "rep-neutral", green = "rep-friendly",
    blue = "progress-fill", purple = "arcane", gold = "gilt-text",
}

--------------------------------------------------------------------------------
-- Reading the game's frames: what is there is checked as it's read
--------------------------------------------------------------------------------

-- (the game's frames are read with wowlua:frames, wowlua:table's field and
-- wowlua:errors' tryMethod: what is there is checked as it's read)

-- A method's answer when it is a (readable) string.
local function askString(r: unknown, method: string): string?
    return secret.asString(errors.tryMethod(r, method))
end

-- A texture's atlas, lower case ("" without one).
local function atlasOf(t: unknown): string
    return (askString(t, "GetAtlas") or ""):lower()
end

-- SuuUI's own frames inside the game's windows, and its own textures on the
-- game's parts: a pass leaves them be (`f.suuOwn = true`, the plugins' way,
-- counts too).
local ownFrames: { [Region]: true } = tbl.weakKeys()
local ownArt: { [Region]: true } = tbl.weakKeys()

export function markOwn(f: Region) ownFrames[f] = true end

export function isOwn(f: unknown): boolean
    if type(f) ~= "table" then return false end
    return ownFrames[f :: Region] == true or (f :: { [string]: unknown }).suuOwn == true
end

export function markArt(t: Region) ownArt[t] = true end

export function isArt(t: unknown): boolean
    return type(t) == "table" and ownArt[t :: Region] == true
end

-- A flag a plugin (or a module) set on one of the game's frames: suuOwn,
-- suuNoCheck, suuNoButton, suuSkip.
local function flagged(f: unknown, key: string): boolean
    return tbl.field(f, key) == true
end

-- A part of `f` that can be faded (anything with SetAlpha).
local function fade(v: unknown)
    local r = frames.asRegion(v)
    if r then r:SetAlpha(0) end
end

local function matchesAny(s: string, list: string[]): boolean
    for _, p in ipairs(list) do if s:find(p) then return true end end
    return false
end

-- The textures and font strings among a frame's regions.
local function textures(f: Frame): Texture[]
    local out: Texture[] = {}
    for _, r in ipairs({ f:GetRegions() }) do
        if r:GetObjectType() == "Texture" then out[#out + 1] = r :: Texture end
    end
    return out
end

local function fontStrings(f: Frame): FontString[]
    local out: FontString[] = {}
    for _, r in ipairs({ f:GetRegions() }) do
        if r:GetObjectType() == "FontString" then out[#out + 1] = r :: FontString end
    end
    return out
end

--------------------------------------------------------------------------------
-- What a pass did to each of the game's parts (kept off the game's frames)
--------------------------------------------------------------------------------

type Redraw = { draw: () -> () }
export type IconSkin = { edge: draw.Border, hover: boolean, draw: () -> () }
export type CheckSkin = { box: Frame, draw: () -> () }

export type Skin = {
    -- a scrollbar, status bar, dropdown, edit box, scroll box, dialog or a
    -- dialog's box: done
    scrollBar?: boolean,
    statusBar?: boolean,
    dropdown?: boolean,
    edit?: boolean,
    scrollBox?: boolean,
    dialog?: boolean,
    box?: boolean,
    scrollingFont?: boolean,
    -- a status bar's: its fill's atlas, its track, whether its fill is hooked
    atlas?: string,
    track?: Frame,
    flattening?: boolean,
    fillHooked?: boolean,
    -- a fill bar's: its atlas's colour word, its share, how it's drawn again
    fillBar?: boolean,
    atlasWord?: string,
    percent?: number,
    flat?: () -> (),
    tint?: () -> (),
    sizeFill?: () -> (),
    -- buttons
    icon?: IconSkin,
    check?: CheckSkin,
    button?: Redraw,
    collapse?: Redraw,
    -- a list row's check moved to its corner; a category row's rule
    moved?: boolean,
    headRule?: Texture,
    -- a text's colour token; a text left as it is
    token?: string,
    skip?: boolean,
}

local skins: { [Region]: Skin } = setmetatable({}, { __mode = "k" })

local function skinOf(r: Region): Skin
    local s = skins[r]
    if not s then
        s = {}
        skins[r] = s
    end
    return s
end

-- Whether a text is left as it is: marked by a pass, or by a module (suuSkip).
local function skipped(fs: FontString): boolean
    local s = skins[fs]
    return (s ~= nil and s.skip == true) or flagged(fs, "suuSkip")
end

--------------------------------------------------------------------------------
-- Pieces
--------------------------------------------------------------------------------

export function reskinScrollBar(given: unknown)
    local bar = frames.asFrame(given)
    if not bar then return end
    local s = skinOf(bar)
    if s.scrollBar then return end
    s.scrollBar = true
    local track = frames.asFrame(tbl.field(bar, "Track"))
    if track then
        for _, r in ipairs({ track:GetRegions() }) do r:SetAlpha(0) end
        local thumb = frames.asFrame(tbl.field(track, "Thumb"))
        if thumb then
            for _, r in ipairs({ thumb:GetRegions() }) do r:SetAlpha(0) end
            local t = thumb:CreateTexture(nil, "OVERLAY")
            draw.paintFill(t, "gilt-line")
            t:SetPoint("TOP")
            t:SetPoint("BOTTOM")
            t:SetWidth(2)
            -- under the mouse: gilt and a little wider, so it reads as
            -- something to grab (it showed no hover, found in game)
            hookScript(thumb, "OnEnter", function() draw.paintFill(t, "gilt"); t:SetWidth(4) end)
            hookScript(thumb, "OnLeave", function() draw.paintFill(t, "gilt-line"); t:SetWidth(2) end)
        end
    end
    for _, key in ipairs({ "Back", "Forward" }) do fade(tbl.field(bar, key)) end
end

-- A flat fill on a track inside a gilt-hairline edge, as tall as Blizzard's
-- fill; the colour from the fill's atlas (standing colours kept).
export function reskinStatusBar(given: unknown)
    local bar = frames.asStatusBar(given)
    if not bar then return end
    local s = skinOf(bar)
    local fill = frames.asTexture(errors.tryMethod(bar, "GetStatusBarTexture"))
    local atlas = fill and askString(fill, "GetAtlas")
    if atlas and atlas ~= "" then s.atlas = atlas end
    if not s.statusBar then
        s.statusBar = true
        for _, r in ipairs({ bar:GetRegions() }) do
            local t = r:GetObjectType()
            if t == "Texture" and r ~= fill then r:SetAlpha(0) end
            if t == "MaskTexture" and fill then pcall(fill.RemoveMaskTexture, fill, r :: MaskTexture) end
        end
        -- the track as tall as the fill, whatever the fill's height comes to
        -- be (a bar skinned while hidden reported none and got a guess)
        local track = CreateFrame("Frame", nil, bar)
        track:SetPoint("LEFT")
        track:SetPoint("RIGHT")
        if fill then
            track:SetPoint("TOP", fill, "TOP")
            track:SetPoint("BOTTOM", fill, "BOTTOM")
        else
            track:SetHeight(math.min(14, bar:GetHeight()))
        end
        track:SetFrameLevel(math.max(0, bar:GetFrameLevel() - 1))
        draw.fill(track, "track"):SetAllPoints()
        draw.border(track, "gilt-hairline")
        s.track = track
    end
    local function flatten()
        local f = frames.asTexture(errors.tryMethod(bar, "GetStatusBarTexture"))
        if not f then return end
        local a = askString(f, "GetAtlas")
        if a and a ~= "" then s.atlas = a end
        s.flattening = true
        f:SetTexture(WHITE)
        local word = s.atlas and s.atlas:lower():match("stat%-bar%-(%a+)")
        draw.paint(f, BAR_COLORS[word or ""] or "progress-fill")
        s.flattening = false
    end
    if fill and not s.fillHooked then
        s.fillHooked = true
        -- Blizzard sets the fill again (its standing's atlas): flat again
        local function again() if not s.flattening then flatten() end end
        hook(fill, "SetAtlas", again)
        hook(bar, "SetStatusBarTexture", again)
    end
    flatten()
    for _, r in ipairs(fontStrings(bar)) do
        fonts.apply(r, "numeric")
        r:SetJustifyH("CENTER")
        -- on the track's middle, a pixel up (the figures sit low otherwise)
        local track = s.track
        if track then
            r:ClearAllPoints()
            r:SetPoint("LEFT", track, "LEFT", 0, 1)
            r:SetPoint("RIGHT", track, "RIGHT", 0, 1)
        end
        draw.paint(r, "ink")
        r:SetShadowColor(0, 0, 0, 1)
        r:SetShadowOffset(0, -1)
    end
end

local fillBars: { [Frame]: boolean } = setmetatable({}, { __mode = "k" })
events.on("SUUUI_THEME_CHANGED", function()
    for bar in pairs(fillBars) do
        local tint = skinOf(bar).tint
        if tint then tint() end
    end
end, "UI.ReskinFillBar")

-- A bar Blizzard draws itself (a frame with a Fill texture it sizes and
-- tints: the reputation's standing bars, the skills' bars): the fill flat in
-- Blizzard's tint (the standing's colour) or its atlas's colour (the skills'
-- blue), a track in a gilt-hairline edge, the text centred.
export function reskinFillBar(given: unknown)
    local bar = frames.asFrame(given)
    local fill = frames.asTexture(tbl.field(bar, "Fill"))
    if not (bar and fill) then return end
    local s = skinOf(bar)
    if not s.fillBar then
        s.fillBar = true
        for _, r in ipairs({ bar:GetRegions() }) do
            local t = r:GetObjectType()
            if t == "Texture" and r ~= fill then r:SetAlpha(0) end
            if t == "MaskTexture" then pcall(fill.RemoveMaskTexture, fill, r :: MaskTexture) end
        end
        local h = math.max(6, math.min(14, fill:GetHeight() or 12))
        local track = CreateFrame("Frame", nil, bar)
        track:SetPoint("LEFT")
        track:SetPoint("RIGHT")
        track:SetHeight(h)
        track:SetFrameLevel(math.max(0, bar:GetFrameLevel() - 1))
        draw.fill(track, "track"):SetAllPoints()
        draw.border(track, "gilt-hairline")
        s.track = track
        fill:SetHeight(h - 2)
        -- the colour: Blizzard's tint on a white atlas (the reputation's
        -- standings); a coloured atlas (the skills' blue, tinted white on
        -- top) keeps its colour as a token
        -- (set raw, not painted: the SetVertexColor hook below would tint
        -- again inside a repaint; fillBars tints again on a theme change)
        local flattening = false
        local function tint()
            local token = BAR_COLORS[s.atlasWord or ""]
            if not token then return end
            flattening = true
            fill:SetVertexColor(draw.rgba(token))
            flattening = false
        end
        local function flat()
            if flattening then return end
            local a = atlasOf(fill)
            if a ~= "" then s.atlasWord = a:match("stat%-bar%-(%a+)") end
            flattening = true
            fill:SetTexture(WHITE)
            flattening = false
            tint()
        end
        hook(fill, "SetAtlas", flat)
        hook(fill, "SetVertexColor", function() if not flattening then tint() end end)
        s.flat = flat
        s.tint = tint
        fillBars[bar] = true
        -- Blizzard sizes the fill as a share of its FillArea's width once
        -- (SetFillPercent); a row filled in before it had a width got 0,
        -- which a texture draws at its own size (8 px of white: seen
        -- 2026-10-18, 3,210 / 6,000 as a sliver). Keep the share and size the
        -- fill again whenever the width changes; none: no fill.
        local area = frames.asFrame(tbl.field(bar, "FillArea"))
        if tbl.field(bar, "SetFillPercent") and area then
            -- the share Blizzard set before this: the right edge of its
            -- texture coordinates (SetTexCoord(0, p, 1, 0)), read before
            -- the flat texture goes on
            local _, _, _, _, right = fill:GetTexCoord()
            s.percent = tonumber(right) and math.min(1, math.max(0, right)) or nil
            local function size()
                local w = (s.percent or 0) * (area:GetWidth() or 0)
                fill:SetAlpha(w >= 0.5 and 1 or 0)
                if w >= 0.5 then fill:SetWidth(w) end
            end
            hook(bar :: unknown, "SetFillPercent", function(_: unknown, percent: unknown)
                s.percent = math.min(1, math.max(0, tonumber(percent) or 0))
                size()
            end)
            hookScript(area, "OnSizeChanged", size)
            s.sizeFill = size
        end
    end
    local flat, sizeFill, track = s.flat, s.sizeFill, s.track
    if flat then flat() end
    if sizeFill then sizeFill() end
    for _, r in ipairs(fontStrings(bar)) do
        fonts.apply(r, "numeric")
        r:SetJustifyH("CENTER")
        -- on the track's middle (the reputation's figures sit right there;
        -- a pixel up was too high, found in game)
        r:ClearAllPoints()
        if track then
            r:SetPoint("LEFT", track, "LEFT", 0, 0)
            r:SetPoint("RIGHT", track, "RIGHT", 0, 0)
        end
        draw.paint(r, "ink")
        r:SetShadowColor(0, 0, 0, 1)
        r:SetShadowOffset(0, -1)
    end
end

-- One of Blizzard's menus (Menu.GetManager():GetOpenMenu(), probed
-- 2026-10-14: a common-dropdown-bg texture, 20px rows with a radio or check
-- and a highlight, the rows' text) in the context menu's look: glass, a
-- gilt-line edge, the gilt corner diamond, rows in body ink on arcane-soft
-- while hovered, the chosen one marked by an arcane check. The game reuses
-- its menu frames for every menu, so all of it is undone when it closes.
-- A restyled menu's state: what to undo, SuuUI's art.
type MenuState = {
    undo: (() -> ())[],
    panel: Frame,
    hover: Texture,
    marks: Texture[],
    nMarks: number,
    chevrons: Texture[],
    nChevrons: number,
    active?: boolean,
}

local menus: { [Frame]: MenuState } = setmetatable({}, { __mode = "k" })
local rowMenu: { [Frame]: MenuState } = setmetatable({}, { __mode = "k" }) -- a row: the menu state it belongs to now
local hooked: { [Frame]: boolean } = setmetatable({}, { __mode = "k" })

-- The open root menu, if the game has one open.
export function openRoot(): Frame?
    local getManager = tbl.field(tbl.field(_G, "Menu"), "GetManager")
    if type(getManager) ~= "function" then return nil end
    local ok, manager = pcall(getManager :: () -> unknown)
    if not ok then return nil end
    return frames.asFrame(errors.tryMethod(manager, "GetOpenMenu"))
end

-- A hook on a script of one of the game's pooled frames (its menus, menu
-- rows, popups) that lasts: the game sets those scripts again whenever it
-- reuses the frame (Menu.lua: SetScript("OnEnter", …) on each row it
-- lays out, SetScript("OnHide", …) on each menu it opens), and SetScript
-- drops the hooks on a script; the hook goes on again right after.
local function lastingHookScript(f: Frame, script: string, fn: (self: Frame) -> ())
    hookScript(f, script, fn)
    hook(f, "SetScript", function(self: Frame, name: unknown)
        if name == script then hookScript(self, script, fn) end
    end)
end

local function restoreMenu(st: MenuState)
    for i = #st.undo, 1, -1 do pcall(st.undo[i]) end
    st.undo = {}
    st.panel:Hide()
    for _, t in pairs(st.marks) do t:Hide() end
    for _, t in pairs(st.chevrons) do t:Hide() end
    st.hover:Hide()
    st.nMarks, st.nChevrons = 0, 0
    st.active = false
end

-- What undoing a change needs: a list of functions.
type Undo = { undo: (() -> ())[] }

local function hideRegion(st: Undo, r: Region)
    if isArt(r) then return end
    local a = r:GetAlpha()
    -- (an alpha once set from a secret reads back secret: left as it is)
    if issecretvalue(a) or a == 0 then return end
    r:SetAlpha(0)
    st.undo[#st.undo + 1] = function() r:SetAlpha(a) end
end

local function menuText(st: Undo, fs: FontString, color: string)
    local fo = fs:GetFontObject()
    local file, size, flags = fs:GetFont()
    local r, g, b, a = fs:GetTextColor()
    local sx, sy = fs:GetShadowOffset()
    st.undo[#st.undo + 1] = function()
        if fo then fs:SetFontObject(fo) elseif file then fs:SetFont(file, size, flags) end
        fs:SetTextColor(r, g, b, a)
        fs:SetShadowOffset(sx, sy)
    end
    fonts.apply(fs, "body")
    -- (set raw: again on every open, and the game's shared menu rows get
    -- no hooks of SuuUI's)
    fs:SetTextColor(draw.rgba(color))
    fs:SetShadowOffset(0, 0)
end

local function menuRow(st: MenuState, row: Frame)
    local chosen: boolean?, indicator: Texture? = nil, nil
    local texts: FontString[] = {}
    for _, r in ipairs({ row:GetRegions() }) do
        local kind = r:GetObjectType()
        if kind == "Texture" and not isArt(r) then
            local t = r :: Texture
            local atlas = atlasOf(t)
            if atlas:find("common%-dropdown%-icon") then
                -- the chosen row's tick
                if t:IsShown() then chosen = true end
                indicator = indicator or t
                hideRegion(st, t)
            elseif atlas:find("common%-dropdown%-tick") then
                indicator = t
                hideRegion(st, t)
            elseif t:GetDrawLayer() == "HIGHLIGHT" or not t:IsShown() then
                hideRegion(st, t)
            end
        elseif kind == "FontString" then
            texts[#texts + 1] = r :: FontString
        end
    end
    for _, fs in ipairs(texts) do menuText(st, fs, "ink") end
    -- a submenu's arrow (a plain texture, the game's yellow): SuuUI's chevron
    local arrow = frames.asRegion(tbl.field(row, "arrow"))
    if arrow and arrow:IsShown() then
        hideRegion(st, arrow)
        st.nChevrons = st.nChevrons + 1
        local chev = st.chevrons[st.nChevrons]
        if not chev then
            chev = st.panel:CreateTexture(nil, "OVERLAY", nil, 7)
            chev:SetTexture(GLYPHS .. "chevronRight.tga")
            chev:SetSize(12, 12)
            draw.paint(chev, "ink-muted")
            st.chevrons[st.nChevrons] = chev
        end
        chev:ClearAllPoints()
        chev:SetPoint("CENTER", arrow, "CENTER", 0, 0)
        chev:Show()
    end
    -- SuuUI's hover and mark: on its own panel behind the rows (the game
    -- forbids new textures on its menu rows)
    rowMenu[row] = st
    -- (lasting: the game sets a reused row's scripts again; the hover band
    -- showed on a row's first menu only)
    if not hooked[row] then
        hooked[row] = true
        lastingHookScript(row, "OnEnter", function(self: Frame)
            local owner = rowMenu[self]
            if owner and owner.active then
                owner.hover:ClearAllPoints()
                owner.hover:SetAllPoints(self)
                owner.hover:Show()
            end
        end)
        lastingHookScript(row, "OnLeave", function(self: Frame)
            local owner = rowMenu[self]
            if owner then owner.hover:Hide() end
        end)
    end
    if chosen then
        st.nMarks = st.nMarks + 1
        local mark = st.marks[st.nMarks]
        if not mark then
            mark = st.panel:CreateTexture(nil, "OVERLAY", nil, 7)
            mark:SetTexture(GLYPHS .. "check.tga")
            mark:SetSize(12, 12)
            draw.paint(mark, "arcane")
            st.marks[st.nMarks] = mark
        end
        mark:ClearAllPoints()
        if indicator then mark:SetPoint("CENTER", indicator, "CENTER", 0, 0) else mark:SetPoint("LEFT", row, "LEFT", 2, 0) end
        mark:Show()
    end
end

-- Whether a row has words in it (the game ends some menus, the unit menus,
-- with an empty spacer: the panel stopped a row too low, found in game).
local function hasText(row: Frame): boolean
    local function any(f: Frame): boolean
        for _, fs in ipairs(fontStrings(f)) do
            if fs:IsShown() then
                local t = fs:GetText()
                if t and t ~= "" then return true end
            end
        end
        return false
    end
    if any(row) then return true end
    for _, c in ipairs({ row:GetChildren() }) do
        if any(c) then return true end
    end
    return false
end

export function reskinMenu(given: unknown)
    local menu = frames.asFrame(given)
    if not menu or errors.tryMethod(menu, "IsForbidden") then return end
    local st = menus[menu]
    if not st then
        local panel = CreateFrame("Frame", nil, menu)
        panel:SetAllPoints()
        panel:SetFrameLevel(menu:GetFrameLevel())
        panel:EnableMouse(false)
        draw.fill(panel, "surface-glass"):SetAllPoints()
        draw.border(panel, "gilt-line")
        draw.shadow(panel, "shadow-panel")
        draw.diamond(panel, 7, "gilt"):SetPoint("CENTER", panel, "TOPLEFT", 0, 0)
        local hover = panel:CreateTexture(nil, "ARTWORK")
        draw.paintFill(hover, "arcane-soft")
        hover:Hide()
        local made: MenuState = { undo = {}, panel = panel, hover = hover, marks = {}, nMarks = 0, chevrons = {}, nChevrons = 0 }
        st = made
        menus[menu] = made
        -- (lasting: the game sets a menu frame's OnHide again each time it
        -- opens one; the look stayed on its shared frames)
        lastingHookScript(menu, "OnHide", function() if made.active then restoreMenu(made) end end)
        -- a choice that refreshes the menu (a sort order) sets its rows up
        -- again: marked again
        if tbl.field(menu, "ReinitializeAll") then
            hook(menu :: unknown, "ReinitializeAll", function()
                if made.active then after(0, function() if made.active and menu:IsShown() then reskinMenu(menu) end end) end
            end)
        end
    end
    -- a second pass (the rows came later) starts from the game's look again
    if st.active then restoreMenu(st) end
    st.active = true
    st.panel:Show()
    for _, t in ipairs(textures(menu)) do hideRegion(st, t) end
    local rows: Frame[] = {}
    for _, c in ipairs({ menu:GetChildren() }) do
        if c:GetObjectType() == "Button" then rows[#rows + 1] = c end
    end
    local scrollBox = frames.asFrame(tbl.field(menu, "ScrollBox"))
    local target = frames.asFrame(tbl.field(scrollBox, "ScrollTarget"))
    local scrolling = scrollBox ~= nil and target ~= nil and scrollBox:IsShown()
    if target and scrolling then
        for _, c in ipairs({ target:GetChildren() }) do
            if c:GetObjectType() == "Button" then rows[#rows + 1] = c end
        end
    end
    for _, row in ipairs(rows) do menuRow(st, row) end
    -- the game's frame keeps room under its rows for its own drop shadow: the
    -- panel ends under the last row instead, as far below it as the first
    -- row is below the top
    local top = menu:GetTop()
    local first: Frame?, firstTop: number? = nil, nil
    local last: Frame?, lastBottom: number? = nil, nil
    -- every line with words counts for the edges: the buttons, and titles
    -- and headings, which aren't buttons (a unit menu's name on top: the
    -- panel's padding came out 28 instead of 8, found with /suu probe unitmenu)
    local lines: Frame[] = {}
    for _, c in ipairs({ menu:GetChildren() }) do
        if c ~= st.panel then lines[#lines + 1] = c end
    end
    if target and scrolling then
        for _, c in ipairs({ target:GetChildren() }) do lines[#lines + 1] = c end
    end
    for _, row in ipairs(lines) do
        local t, b = row:GetTop(), row:GetBottom()
        if row:IsShown() and t and b and hasText(row) then
            if not firstTop or t > firstTop then first, firstTop = row, t end
            if not lastBottom or b < lastBottom then last, lastBottom = row, b end
        end
    end
    st.panel:ClearAllPoints()
    -- (a scrolling menu's last row can sit below what shows: then all of it)
    local bottom = menu:GetBottom()
    if top and first and firstTop and last and lastBottom and bottom and lastBottom >= bottom then
        local pad = math.max(0, top - firstTop)
        st.panel:SetPoint("TOPLEFT", menu, "TOPLEFT")
        st.panel:SetPoint("RIGHT", menu, "RIGHT")
        st.panel:SetPoint("BOTTOM", last, "BOTTOM", 0, -pad)
    else
        st.panel:SetAllPoints(menu)
    end
end

-- A submenu opened from a menu SuuUI restyled (the Who filter's Class,
-- Race, Zone, Sort): restyled too. Every menu frame announces itself.
local registry = tbl.field(_G, "EventRegistry")
if tbl.field(registry, "RegisterCallback") then
    -- (the event hands over the menu's frame, which has no GetLevel: any
    -- menu other than the open root, while the root is restyled)
    errors.tryMethod(registry, "RegisterCallback", "MenuProxy.OnShow", function(_: unknown, given: unknown)
        local menu = frames.asFrame(given)
        if not menu then return end
        local root = openRoot()
        local st = root and root ~= menu and menus[root]
        if st and st.active then
            reskinMenu(menu)
            after(0, function() if menu:IsShown() then reskinMenu(menu) end end)
        end
    end, "SuuUI.Reskin")
end

-- Blizzard's dropdown (WowStyle): surface-sunk in a gilt-line edge, its text
-- in label ink, a chevron on the right.
export function reskinDropdown(given: unknown, opts: { glyph?: string }?)
    local d = frames.asButton(given)
    if not d then return end
    local s = skinOf(d)
    if s.dropdown then return end
    for _, t in ipairs(textures(d)) do t:SetAlpha(0) end
    for _, key in ipairs({ "Arrow", "Background" }) do fade(tbl.field(d, key)) end
    local text = frames.asFontString(tbl.field(d, "Text")) or frames.asFontString(tbl.field(d, "text"))
    local glyphName = opts and opts.glyph
    if glyphName then
        -- an icon-only dropdown (the map's filter): a glyph, its edge on hover
        fade(tbl.field(d, "Icon"))
        local edge = draw.border(d, "gilt-line")
        edge:SetShown(false)
        local glyph = d:CreateTexture(nil, "OVERLAY", nil, 7)
        glyph:SetTexture(GLYPHS .. glyphName .. ".tga")
        glyph:SetSize(14, 14)
        glyph:SetPoint("CENTER")
        draw.paint(glyph, "ink-muted")
        markArt(glyph)
        hookScript(d, "OnEnter", function() edge:SetShown(true); draw.paint(glyph, "ink") end)
        hookScript(d, "OnLeave", function() edge:SetShown(false); draw.paint(glyph, "ink-muted") end)
        if text then text:SetAlpha(0) end
        text = nil
    else
        local bg = d:CreateTexture(nil, "BACKGROUND", nil, -7)
        draw.paintFill(bg, "surface-sunk")
        bg:SetAllPoints()
        markArt(bg)
        local edge = draw.border(d, "gilt-line")
        local chev = d:CreateTexture(nil, "OVERLAY", nil, 7)
        chev:SetTexture(GLYPHS .. "chevronDown.tga")
        chev:SetSize(12, 12)
        chev:SetPoint("RIGHT", -S["space-3"], 0)
        draw.paint(chev, "ink-muted")
        markArt(chev)
        hookScript(d, "OnEnter", function() edge:SetColor("gilt") end)
        hookScript(d, "OnLeave", function() edge:SetColor("gilt-line") end)
    end
    if text then
        fonts.apply(text, "label")
        draw.paint(text, "ink")
        text:SetShadowOffset(0, 0)
    end
    -- the menu it opens: in SuuUI's look while it's this dropdown's
    local event = tbl.field(tbl.field(tbl.field(_G, "DropdownButtonMixin"), "Event"), "OnMenuOpen")
    if event and tbl.field(d, "RegisterCallback") then
        errors.tryMethod(d, "RegisterCallback", event, function()
            local menu = openRoot()
            if not menu then return end
            reskinMenu(menu)
            -- its rows may come a frame later
            after(0, function() if menu:IsShown() then reskinMenu(menu) end end)
        end, d)
    end
    s.dropdown = true
end

-- An icon button (the set popup's grid and its chosen icon): every bit of
-- Blizzard's frame art away, the icon cropped on a surface-sunk well in a
-- gilt-hairline edge, gilt on hover, arcane while selected (Blizzard's own
-- SelectedTexture says when).
export function reskinIconButton(given: unknown)
    local b = frames.asButton(given)
    if not b then return end
    local s = skinOf(b)
    local icon = frames.asTexture(tbl.field(b, "Icon")) or frames.asTexture(tbl.field(b, "icon"))
    local st = s.icon
    if not st then
        local well = b:CreateTexture(nil, "BACKGROUND", nil, -8)
        draw.paintFill(well, "surface-sunk")
        well:SetAllPoints()
        markArt(well)
        local edgeHolder = CreateFrame("Frame", nil, b)
        edgeHolder:SetAllPoints()
        edgeHolder:EnableMouse(false)
        edgeHolder:SetFrameLevel(b:GetFrameLevel() + 2)
        local edge = draw.border(edgeHolder, "gilt-hairline")
        local sel = frames.asRegion(tbl.field(b, "SelectedTexture")) or frames.asRegion(tbl.field(b, "selectedTexture"))
        local made: IconSkin = { edge = edge, hover = false, draw = function() end }
        made.draw = function()
            local on = sel ~= nil and sel:IsShown()
            edge:SetColor(on and "arcane" or (made.hover and "gilt" or "gilt-hairline"))
        end
        st = made
        s.icon = made
        hookScript(b, "OnEnter", function() made.hover = true; made.draw() end)
        hookScript(b, "OnLeave", function() made.hover = false; made.draw() end)
        if sel then
            for _, m in ipairs({ "Show", "Hide", "SetShown" }) do hook(sel, m, function() made.draw() end) end
        end
    end
    for _, get in ipairs({ "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture", "GetDisabledTexture", "GetCheckedTexture" }) do
        local t = frames.asRegion(errors.tryMethod(b, get))
        if t and t ~= icon then t:SetAlpha(0) end
    end
    for _, t in ipairs(textures(b)) do
        if t ~= icon and not isArt(t) then t:SetAlpha(0) end
    end
    if icon then
        icon:SetAlpha(1)
        icon:ClearAllPoints()
        icon:SetPoint("TOPLEFT", 1, -1)
        icon:SetPoint("BOTTOMRIGHT", -1, 1)
        icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
    end
    st.draw()
end

export function reskinCheckButton(given: unknown)
    local b = frames.asCheckButton(given)
    if not b then return end
    local s = skinOf(b)
    if s.check then return end
    for _, get in ipairs({ "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture", "GetCheckedTexture", "GetDisabledCheckedTexture" }) do
        fade(errors.tryMethod(b, get))
    end
    local box = CreateFrame("Frame", nil, b)
    box:SetSize(16, 16)
    box:SetPoint("CENTER")
    box:EnableMouse(false)
    draw.fill(box, "surface-sunk"):SetAllPoints()
    local edge = draw.border(box, "gilt-line")
    local check = box:CreateTexture(nil, "OVERLAY")
    check:SetTexture(GLYPHS .. "check.tga")
    check:SetSize(14, 14)
    check:SetPoint("CENTER")
    draw.paint(check, "arcane")
    local function redraw()
        local checked = errors.tryMethod(b, "GetChecked")
        local on = checked ~= nil and checked ~= false
        check:SetShown(on)
        edge:SetColor(on and "arcane" or "gilt-line")
    end
    hook(b, "SetChecked", redraw)
    hookScript(b, "OnClick", redraw)
    hookScript(b, "OnShow", redraw)
    s.check = { box = box, draw = redraw }
    redraw()
end

-- Blizzard's panel button (Left/Middle/Right art, or a red button atlas) as
-- SuuUI's quiet button: surface-raised, gilt-line edge (gilt on hover), its
-- label in `label` ink; dimmed while disabled.
export function reskinButton(given: unknown)
    local b = frames.asButton(given)
    if not b then return end
    local s = skinOf(b)
    if s.button then return end
    for _, key in ipairs({ "Left", "Middle", "Center", "Right", "LeftSeparator", "RightSeparator" }) do fade(tbl.field(b, key)) end
    -- any other button art (an atlas with "button" in it)
    for _, t in ipairs(textures(b)) do
        if atlasOf(t):find("button") then t:SetAlpha(0) end
    end
    for _, get in ipairs({ "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture", "GetDisabledTexture" }) do
        fade(errors.tryMethod(b, get))
    end
    local bg = b:CreateTexture(nil, "BACKGROUND", nil, -7)
    draw.paintFill(bg, "surface-raised")
    bg:SetAllPoints()
    local edge = draw.border(b, "gilt-line")
    hookScript(b, "OnEnter", function() edge:SetColor("gilt") end)
    hookScript(b, "OnLeave", function() edge:SetColor("gilt-line") end)
    local function redraw()
        b:SetAlpha(errors.tryMethod(b, "IsEnabled") == false and T.opacity["opacity-disabled"] or 1)
        local fs = frames.asFontString(errors.tryMethod(b, "GetFontString"))
        if fs then
            fonts.apply(fs, "label")
            draw.paint(fs, "ink")
            fs:SetShadowOffset(0, 0)
        end
    end
    hook(b, "SetEnabled", redraw)
    if tbl.field(b, "Enable") then hook(b, "Enable", redraw) end
    if tbl.field(b, "Disable") then hook(b, "Disable", redraw) end
    s.button = { draw = redraw }
    redraw()
end

-- An input box: Blizzard's Left/Middle/Right art away, surface-sunk inside a
-- gilt-line edge (arcane while typing), body ink.
export function reskinEditBox(given: unknown)
    local e = frames.asEditBox(given)
    if not e then return end
    local s = skinOf(e)
    if s.edit then return end
    for _, key in ipairs({ "Left", "Middle", "Right", "Mid" }) do fade(tbl.field(e, key)) end
    local name = e:GetName()
    if name then
        for _, suffix in ipairs({ "Left", "Middle", "Right", "Mid" }) do fade(tbl.field(_G, name .. suffix)) end
    end
    -- whatever else Blizzard drew it with (its own art, a backdrop frame)
    for _, t in ipairs(textures(e)) do t:SetAlpha(0) end
    for _, c in ipairs({ e:GetChildren() }) do
        fade(tbl.field(c, "NineSlice"))
        for _, t in ipairs(textures(c)) do t:SetAlpha(0) end
    end
    fade(tbl.field(e, "NineSlice"))
    -- a search box (its magnifier and "Search" placeholder): the field is the
    -- box itself, the text and placeholder space-3 in from its left
    local search = tbl.field(e, "searchIcon") or tbl.field(e, "Instructions")
    local bg = e:CreateTexture(nil, "BACKGROUND", nil, -7)
    draw.paintFill(bg, "surface-sunk")
    if search then
        bg:SetAllPoints()
        e:SetTextInsets(S["space-3"], S["space-5"], 0, 0)
        local hint = frames.asFontString(tbl.field(e, "Instructions"))
        if hint then
            hint:ClearAllPoints()
            hint:SetPoint("LEFT", S["space-3"], 0)
            hint:SetPoint("RIGHT", -S["space-3"], 0)
            hint:SetJustifyH("LEFT")
            fonts.apply(hint, "body")
            draw.paint(hint, "ink-muted")
            skinOf(hint).skip = true
        end
    else
        bg:SetPoint("TOPLEFT", -4, -1)
        bg:SetPoint("BOTTOMRIGHT", 0, 1)
    end
    local holder = CreateFrame("Frame", nil, e)
    holder:SetPoint("TOPLEFT", bg)
    holder:SetPoint("BOTTOMRIGHT", bg)
    holder:EnableMouse(false)
    local edge = draw.border(holder, "gilt-line")
    hookScript(e, "OnEditFocusGained", function() edge:SetColor("arcane") end)
    hookScript(e, "OnEditFocusLost", function() edge:SetColor("gilt-line") end)
    e:SetFontObject(fonts.get("body"))
    draw.paint(e, "ink")
    s.edit = true
end

-- A small collapse/expand button (Statistics' sub-categories): SuuUI's
-- minus or plus in gilt-text, following the state Blizzard sets.
export function reskinCollapseButton(given: unknown)
    local b = frames.asButton(given)
    if not b then return end
    local s = skinOf(b)
    if s.collapse then return end
    local glyph = b:CreateTexture(nil, "OVERLAY", nil, 7)
    glyph:SetSize(12, 12)
    glyph:SetPoint("CENTER")
    draw.paint(glyph, "gilt-text")
    local function redraw()
        local t = frames.asTexture(errors.tryMethod(b, "GetNormalTexture"))
        local name = ""
        if t then
            name = (askString(t, "GetAtlas") or tostring(errors.tryMethod(t, "GetTexture") or "")):lower()
            t:SetAlpha(0)
        end
        for _, get in ipairs({ "GetPushedTexture", "GetHighlightTexture", "GetDisabledTexture" }) do fade(errors.tryMethod(b, get)) end
        for _, r in ipairs(textures(b)) do
            if r ~= glyph then r:SetAlpha(0) end
        end
        local plus = name:find("plus") or name:find("expand") and not name:find("expanded")
        glyph:SetTexture(GLYPHS .. (plus and "plus" or "minus") .. ".tga")
    end
    if tbl.field(b, "SetNormalTexture") then hook(b, "SetNormalTexture", redraw) end
    if tbl.field(b, "SetNormalAtlas") then hook(b, "SetNormalAtlas", redraw) end
    hookScript(b, "OnClick", function() after(0, redraw) end)
    s.collapse = { draw = redraw }
    redraw()
end

local function isPanelButton(b: Button): boolean
    if tbl.field(b, "Left") and tbl.field(b, "Right") and (tbl.field(b, "Middle") or tbl.field(b, "Center")) then return true end
    -- art with "button" in its atlas (not a list's collapse bar or a minus/plus)
    for _, t in ipairs(textures(b)) do
        local a = atlasOf(t)
        if a:find("button") and not a:find("list") and not a:find("minus") and not a:find("plus") then return true end
    end
    local t = frames.asTexture(errors.tryMethod(b, "GetNormalTexture"))
    if not t then return false end
    local name = (askString(t, "GetAtlas") or tostring(errors.tryMethod(t, "GetTexture") or "")):lower()
    return (name:find("panel%-button") or name:find("redbutton") or name:find("128%-red") or name:find("common%-button")) ~= nil
end

--------------------------------------------------------------------------------
-- Text
--------------------------------------------------------------------------------

local function textColor(r: number?, g: number, b: number): string?
    if not r then return "ink" end
    if r > 0.9 and g > 0.7 and g < 0.9 and b < 0.2 then return "ink" end -- Blizzard's yellow
    if r > 0.85 and g > 0.85 and b > 0.85 then return "ink" end
    if g > 0.7 and r < 0.5 and b < 0.5 then return "fel" end
    if r > 0.8 and g < 0.4 and b < 0.4 then return "ember-text" end
    if math.abs(r - g) < 0.1 and math.abs(g - b) < 0.1 and r < 0.75 then return "ink-muted" end
    return nil -- another colour of Blizzard's (a quality, a standing): kept
end

local function sameColor(token: string, r: number, g: number, b: number): boolean
    local tr, tg, tb = draw.rgba(token)
    return math.abs(r - tr) < 0.01 and math.abs(g - tg) < 0.01 and math.abs(b - tb) < 0.01
end

-- A text's colour, read safely (nil: unreadable).
local function colorOf(fs: FontString): (number?, number, number)
    local r, g, b = errors.tryMethod(fs, "GetTextColor")
    if type(r) == "number" and type(g) == "number" and type(b) == "number" then return r, g, b end
    return nil, 0, 0
end

local function reskinText(fs: FontString, isHead: boolean)
    if skipped(fs) then return end
    local s = skinOf(fs)
    local _, given = errors.tryMethod(fs, "GetFont")
    local size = tonumber(given) or 12
    local fo = errors.tryMethod(fs, "GetFontObject")
    local foName = fo and askString(fo, "GetName") or ""
    local text = errors.tryMethod(fs, "GetText")
    local long = type(text) == "string" and not secret.isSecret(text) and #text > 40
    if isHead then
        fonts.apply(fs, "header")
        draw.paint(fs, "gilt-text")
    elseif not long and (size >= 14 or foName:find("Med") or foName:find("Large")) then
        fonts.apply(fs, "header")
        draw.paint(fs, "gilt-text")
    else
        local r, g, b = colorOf(fs)
        local token = textColor(r, g, b)
        -- a text an earlier pass coloured still has its token's colour: kept
        -- (a theme's colours may read as none of Blizzard's)
        local kept = s.token
        if kept and r and sameColor(kept, r, g, b) then token = kept end
        s.token = token
        fonts.apply(fs, foName:find("Number") and "numeric" or (size < 11 and "caption" or (long and "body" or "label")))
        if token then draw.paint(fs, token) elseif r then fs:SetTextColor(r, g, b) end
    end
    fs:SetShadowOffset(0, 0)
end

--------------------------------------------------------------------------------
-- A pass over a frame
--------------------------------------------------------------------------------

-- Blizzard's scrolling text (a side pane's description): it measures its
-- text for the font it has when the text is set, so after SuuUI's font goes
-- on the box was a line short and its first line out of view (the skills'
-- description, seen 2026-10-18). Measured again, from the top, a frame
-- after SuuUI's pass and after each text.
local function refitScrollingFont(f: Frame)
    local fs = frames.asFontString(errors.tryMethod(f, "GetFontString"))
    local box = frames.asFrame(errors.tryMethod(f, "GetScrollBox"))
    local container = frames.asFrame(errors.tryMethod(f, "GetFontStringContainer"))
    if not (fs and box and container) then return end
    container:SetHeight(fs:GetStringHeight())
    local consts = ScrollBoxConstants or {}
    errors.tryMethod(box, "FullUpdate", tbl.field(consts, "UpdateImmediately"))
    errors.tryMethod(box, "ScrollToBegin", tbl.field(consts, "NoScrollInterpolation"))
end

local function reskinScrollingFont(f: Frame)
    local s = skinOf(f)
    if not s.scrollingFont then
        s.scrollingFont = true
        hook(f :: unknown, "SetText", function() after(0, function() refitScrollingFont(f) end) end)
    end
    after(0, function() refitScrollingFont(f) end)
end

-- A pass's context: the depth of the row it started at, and whether that
-- row is a category bar.
type Ctx = { rowDepth: number, head?: boolean }

local function reskinTexture(t: Texture, ctx: Ctx)
    local a = atlasOf(t)
    local layer = errors.tryMethod(t, "GetDrawLayer")
    if a ~= "" and matchesAny(a, HIDE) then
        if a:find("collapseexpand") then ctx.head = true end
        t:SetAlpha(0)
    elseif a:find("checkmark") and not a:find("minimal") and not skinOf(t).moved then
        -- a list row's check (the equipment set you wear): its top right corner
        local parent = t:GetParent()
        skinOf(t).moved = true
        t:ClearAllPoints()
        t:SetPoint("TOPRIGHT", parent, "TOPRIGHT", -S["space-2"], -S["space-2"])
        t:SetSize(12, 12)
    elseif a:find("minus") or a:find("plus") then
        t:SetDesaturated(true)
        draw.paint(t, "gilt-text")
    elseif a:find("select") then
        -- the chosen fill goes behind what it marks (an icon, a row's text)
        draw.paintFill(t, "arcane-soft")
        t:SetDrawLayer("BACKGROUND", 2)
    elseif layer == "HIGHLIGHT" or a:find("highlight") or a:find("hover") then
        draw.paintFill(t, "surface-raised")
        t:SetAlpha(0.6)
    end
end

local function pass(f: Frame, depth: number, ctx: Ctx)
    if depth > 6 or errors.tryMethod(f, "IsForbidden") then return end
    -- SuuUI's own frames inside a Blizzard window (pages, the skin's header):
    -- never restyled
    if isOwn(f) then return end
    local kind = askString(f, "GetObjectType")
    if tbl.field(f, "GetFontStringContainer") and tbl.field(f, "ScrollBox") and tbl.field(f, "SetText") then reskinScrollingFont(f) end
    -- Blizzard's coloured progress bar (a Fill it sizes itself: the
    -- reputation's and the skills' bars, the skills' a StatusBar)
    local fill = tbl.field(f, "Fill")
    if fill and tbl.field(f, "FillArea") and tbl.field(f, "SetFillPercent") then reskinFillBar(f); return end
    if kind == "StatusBar" then reskinStatusBar(f); return end
    if kind == "CheckButton" and not flagged(f, "suuNoCheck") then reskinCheckButton(f) end
    if kind == "EditBox" then reskinEditBox(f) end
    local s = skinOf(f)
    if kind == "DropdownButton" or (tbl.field(f, "Arrow") and tbl.field(f, "Text") and kind == "Button" and not s.button) then
        reskinDropdown(f)
        return
    end
    if askString(fill, "GetObjectType") == "Texture" then
        if atlasOf(fill):find("stat%-bar") or s.fillBar then reskinFillBar(f); return end
    end
    local b = kind == "Button" and frames.asButton(f) or nil
    if b then
        local key = askString(b, "GetParentKey") or ""
        if key:find("Collapse") or key:find("Expand") then reskinCollapseButton(b)
        elseif not flagged(b, "suuNoButton") and isPanelButton(b) then reskinButton(b) end
        local collapse, button = s.collapse, s.button
        if collapse then collapse.draw() end
        if button then button.draw() end
    end
    -- a ScrollBar (Blizzard's minimal one)
    if tbl.field(f, "Track") and tbl.field(f, "Back") and tbl.field(f, "Forward") then reskinScrollBar(f); return end
    -- a ScrollBox: its rows, one by one, now and after every update
    if tbl.field(f, "ScrollTarget") and tbl.field(f, "ForEachFrame") then reskinScrollBox(f); return end
    local texts: FontString[] = {}
    for _, r in ipairs({ f:GetRegions() }) do
        local t = r:GetObjectType()
        if t == "Texture" then reskinTexture(r :: Texture, ctx)
        elseif t == "FontString" then texts[#texts + 1] = r :: FontString end
    end
    -- a category row: its name as a head, a rule under it
    if ctx.head and depth == ctx.rowDepth then
        for _, fs in ipairs(texts) do reskinText(fs, true) end
        if not s.headRule then
            local rule = f:CreateTexture(nil, "ARTWORK")
            draw.paintFill(rule, "gilt-faint")
            rule:SetHeight(1)
            rule:SetPoint("BOTTOMLEFT", S["space-3"], 0)
            rule:SetPoint("BOTTOMRIGHT", -S["space-3"], 0)
            s.headRule = rule
        end
    else
        for _, fs in ipairs(texts) do reskinText(fs, false) end
    end
    for _, c in ipairs({ f:GetChildren() }) do pass(c, depth + 1, ctx) end
end

export function reskin(given: unknown)
    local frame = frames.asFrame(given)
    if not frame then return end
    pass(frame, 0, { rowDepth = 0 })
end

-- One row: a fresh context, so a category bar marks only its own row.
local function reskinRow(given: unknown)
    local row = frames.asFrame(given)
    if not row then return end
    local ctx: Ctx = { rowDepth = 0 }
    -- a category bar is a texture of the row itself: look first
    for _, t in ipairs(textures(row)) do
        if atlasOf(t):find("collapseexpand") then ctx.head = true end
    end
    pass(row, 0, ctx)
end

export function reskinScrollBox(given: unknown)
    local box = frames.asFrame(given)
    if not box then return end
    local s = skinOf(box)
    if s.scrollBox then return end
    s.scrollBox = true
    local function all()
        -- (no view yet: the box updates as it is sized, before its list is set)
        if tbl.field(box, "ForEachFrame") then
            if tbl.field(box, "GetView") and not errors.tryMethod(box, "GetView") then return end
            errors.tryMethod(box, "ForEachFrame", reskinRow)
        else
            local target = frames.asFrame(tbl.field(box, "ScrollTarget"))
            if target then
                for _, row in ipairs({ target:GetChildren() }) do reskinRow(row) end
            end
        end
    end
    if tbl.field(box, "Update") then hook(box :: unknown, "Update", all) end
    local changed = tbl.field(tbl.field(box, "Event"), "OnDataRangeChanged")
    if tbl.field(box, "RegisterCallback") and changed then
        errors.tryMethod(box, "RegisterCallback", changed, all, box)
    end
    hookScript(box, "OnShow", function() after(0, all) end)
    fade(tbl.field(box, "Shadows"))
    all()
end

-- One of Blizzard's small dialogs (the guild's text editor for the message
-- of the day and the information) as a SuuUI panel: its frame art away,
-- surface-glass inside a gilt-line edge with the gilt corner diamond, its
-- title in `header` gilt-text, its corner close as SuuUI's cross, the box
-- inside on surface-sunk in a gilt-line edge, the rest (buttons, the text,
-- the scrollbar) by the usual pass. Its clicks stay Blizzard's.
local function dialogBox(c: Frame)
    -- a frame holding the text (Blizzard's inset box): its own art away
    local s = skinOf(c)
    if s.box then return end
    s.box = true
    fade(tbl.field(c, "NineSlice"))
    for _, t in ipairs(textures(c)) do t:SetAlpha(0) end
    local bg = c:CreateTexture(nil, "BACKGROUND", nil, -7)
    draw.paintFill(bg, "surface-sunk")
    bg:SetAllPoints()
    markArt(bg)
    draw.border(c, "gilt-line")
    -- the text inside: the box is its field already (no second edge)
    local function walk(fr: Frame, depth: number)
        if depth > 4 then return end
        for _, k in ipairs({ fr:GetChildren() }) do
            local e = k:GetObjectType() == "EditBox" and frames.asEditBox(k) or nil
            if e then
                skinOf(e).edit = true
                e:SetFontObject(fonts.get("body"))
                draw.paint(e, "ink")
            end
            walk(k, depth + 1)
        end
    end
    walk(c, 0)
end

export function reskinDialog(given: unknown)
    local f = frames.asFrame(given)
    if not f or errors.tryMethod(f, "IsForbidden") then return end
    local s = skinOf(f)
    if not s.dialog then
        s.dialog = true
        for _, r in ipairs({ f:GetRegions() }) do
            local kind = r:GetObjectType()
            if kind == "Texture" then
                r:SetAlpha(0)
            elseif kind == "FontString" then
                local fs = r :: FontString
                fonts.apply(fs, "header")
                draw.paint(fs, "gilt-text")
                fs:SetShadowOffset(0, 0)
                skinOf(fs).skip = true
            end
        end
        for _, key in ipairs({ "NineSlice", "Border", "Bg", "TitleBg" }) do fade(tbl.field(f, key)) end
        local panel = CreateFrame("Frame", nil, f)
        panel:SetAllPoints()
        panel:SetFrameLevel(f:GetFrameLevel())
        panel:EnableMouse(false)
        markOwn(panel)
        draw.fill(panel, "surface-glass"):SetAllPoints()
        draw.border(panel, "gilt-line")
        draw.shadow(panel, "shadow-panel")
        draw.diamond(panel, 7, "gilt"):SetPoint("CENTER", panel, "TOPLEFT", 0, 0)
        local closeButton = tbl.field(f, "CloseButton")
        for _, c in ipairs({ f:GetChildren() }) do
            local kind = c:GetObjectType()
            local name = c:GetName() or ""
            local text = errors.tryMethod(c, "GetText")
            local close = kind == "Button" and frames.asButton(c) or nil
            if close and (name:find("Close") or c == closeButton) and (not text or text == "") then
                -- the corner close: SuuUI's cross
                for _, get in ipairs({ "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture", "GetDisabledTexture" }) do
                    fade(errors.tryMethod(close, get))
                end
                for _, t in ipairs(textures(close)) do t:SetAlpha(0) end
                close:SetSize(22, 22)
                close:ClearAllPoints()
                close:SetPoint("TOPRIGHT", f, "TOPRIGHT", -S["space-3"], -S["space-3"])
                local border = draw.border(close, "gilt-line")
                border:SetShown(false)
                local cross = draw.cross(close, 10, "ink-muted")
                cross:SetPoint("CENTER")
                hookScript(close, "OnEnter", function() border:SetShown(true); cross:SetColor("ink") end)
                hookScript(close, "OnLeave", function() border:SetShown(false); cross:SetColor("ink-muted") end)
            elseif kind == "Frame" or kind == "ScrollFrame" then
                if (c:GetWidth() or 0) > 100 and (c:GetHeight() or 0) > 40 then dialogBox(c) end
            end
        end
    end
    pass(f, 0, { rowDepth = 0 })
end

-- One of the game's shared popups (StaticPopup1-4: the guild note popup)
-- in SuuUI's look while it shows that dialog: solid surface inside a gilt-line edge
-- with the corner diamond, its text in body ink, the edit box as a sunk
-- field, Accept as the primary (arcane) button, the others quiet. The game
-- reuses these frames for every popup, so it's all undone when it hides.
-- SuuUI's art lives on its own child frames (shown only while it's ours).

-- A surface and edge on a frame of its own over a part of the popup.
export class PopupSkin extends Frame
    readonly fill: Texture
    readonly edge: draw.Border

    constructor(parent: Frame, fill: string, edge: string, level: number?)
        super(nil, parent)
        self:SetAllPoints()
        self:SetFrameLevel(level or parent:GetFrameLevel())
        self:EnableMouse(false)
        self.fill = draw.fill(self, fill)
        self.fill:SetAllPoints()
        self.edge = draw.border(self, edge)
        self:Hide()
    end
end

type PopupState = { undo: (() -> ())[], skins: { [Frame]: PopupSkin }, active?: boolean }

local popups: { [Frame]: PopupState } = setmetatable({}, { __mode = "k" })

local function restorePopup(st: PopupState)
    for i = #st.undo, 1, -1 do pcall(st.undo[i]) end
    st.undo = {}
    for _, f in pairs(st.skins) do f:Hide() end
    st.active = false
end

local function popupButton(st: PopupState, given: unknown, primary: boolean)
    local b = frames.asButton(given)
    if not (b and b:IsShown()) then return end
    for _, get in ipairs({ "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture", "GetDisabledTexture" }) do
        local t = frames.asRegion(errors.tryMethod(b, get))
        if t then hideRegion(st, t) end
    end
    for _, t in ipairs(textures(b)) do hideRegion(st, t) end
    local skin = st.skins[b]
    if not skin then
        local made = PopupSkin.new(b, primary and "arcane" or "surface-raised", primary and "arcane" or "gilt-line")
        skin = made
        st.skins[b] = made
        hookScript(b, "OnEnter", function() if st.active and not primary then made.edge:SetColor("gilt") end end)
        hookScript(b, "OnLeave", function() if st.active and not primary then made.edge:SetColor("gilt-line") end end)
    end
    skin.edge:SetColor(primary and "arcane" or "gilt-line")
    skin:Show()
    local fs = frames.asFontString(errors.tryMethod(b, "GetFontString"))
    if fs then menuText(st, fs, primary and "on-signal" or "ink"); fonts.apply(fs, "label") end
end

export function reskinPopup(given: unknown)
    local dialog = frames.asFrame(given)
    if not dialog or errors.tryMethod(dialog, "IsForbidden") then return end
    local st = popups[dialog]
    if not st then
        -- solid: it opens over windows, whose text showed through the glass
        local panel = PopupSkin.new(dialog, "surface", "gilt-line")
        draw.shadow(panel, "shadow-panel")
        draw.diamond(panel, 7, "gilt"):SetPoint("CENTER", panel, "TOPLEFT", 0, 0)
        local made: PopupState = { undo = {}, skins = { [dialog] = panel } }
        st = made
        popups[dialog] = made
        -- (lasting: the game sets a popup's OnHide while it waits on events)
        lastingHookScript(dialog, "OnHide", function() if made.active then restorePopup(made) end end)
    end
    if st.active then restorePopup(st) end
    st.active = true
    local own = st.skins[dialog]
    if own then own:Show() end
    -- the game's frame art
    for _, key in ipairs({ "Border", "NineSlice", "BG", "Bg" }) do
        local art = frames.asRegion(tbl.field(dialog, key))
        if art then hideRegion(st, art) end
    end
    for _, t in ipairs(textures(dialog)) do hideRegion(st, t) end
    local text = frames.asFontString(tbl.field(dialog, "Text"))
    if text then menuText(st, text, "ink") end
    -- the edit box: a sunk field
    local edit = frames.asEditBox(tbl.field(dialog, "EditBox"))
    if edit and edit:IsShown() then
        local nine = frames.asRegion(tbl.field(edit, "NineSlice"))
        if nine then hideRegion(st, nine) end
        for _, t in ipairs(textures(edit)) do hideRegion(st, t) end
        local skin = st.skins[edit]
        if not skin then
            skin = PopupSkin.new(edit, "surface-sunk", "gilt-line")
            skin:ClearAllPoints()
            skin:SetPoint("TOPLEFT", -4, 2)
            skin:SetPoint("BOTTOMRIGHT", 4, -2)
            st.skins[edit] = skin
        end
        skin:Show()
    end
    local container = tbl.field(dialog, "ButtonContainer")
    for i = 1, 4 do
        local b = tbl.field(container, "Button" .. i) or tbl.field(dialog, "button" .. i)
        popupButton(st, b, i == 1)
    end
end
