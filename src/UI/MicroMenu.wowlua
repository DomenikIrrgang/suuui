-- UI/MicroMenu.wowlua
-- The micro menu (design board "Micro menu and XP"): a glass panel of
-- `menu-button` square buttons, space-2 apart, each a line glyph (18px, ink)
-- that lifts to surface-raised with a gilt-line edge on hover; an arcane
-- diamond in its top right corner while there's something to act on there.
--
--   local m = microMenu(parent, { name = "SuuUIMicroMenu" })
--   m:SetItems({ { key, glyph, label, click = "CharacterMicroButton" | onClick = fn }, ... })
--   m:SetAlert(key, text or nil)
--   m:SetActive(key, on)      -- its window is open: the hover look stays
--   m:SetCount(key, text, color, fill)  -- 0.17: a count in a pill
--   m:SetLines(key, lines or nil)       -- 0.17: lines in its tooltip
--
-- An item with `click` is a secure button clicking that Blizzard micro
-- button (so it works in combat wherever the game allows the window); one
-- with `onClick` is a plain button. SetItems lays the menu out again, out of
-- combat only (secure buttons): call it then.

import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as events from "/Core/Events"
import * as extend from "/Core/Extend"
import * as fonts from "/Core/Fonts"
import * as draw from "/UI/Draw"
import showTooltip, hideTooltip from "/UI/Tooltip"

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local DISC = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga"

-- The tooltip: the item's label, and the key from Blizzard's own tooltip.
local function keyOf(blizzard: string?): string?
    local b = blizzard and _G[blizzard]
    local tip = b and b.tooltipText
    if type(tip) ~= "string" then return nil end
    local key = tip:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", ""):match("%(([^%)]+)%)%s*$")
    return key
end

-- A pill's shape, `inset` px in from its frame: two half discs and the
-- middle between them, apart, so a see-through colour stays even.
type Pill = { left: Texture, right: Texture, mid: Texture, Paint: (token: string) -> () }

local function pill(f: any, inset: number, layer: DrawLayer): Pill
    local r = 7 - inset
    local p: Pill = {} :: any
    p.left = f:CreateTexture(nil, layer)
    p.left:SetTexture(DISC)
    p.left:SetTexCoord(0, 0.5, 0, 1)
    p.left:SetSize(r, r * 2)
    p.left:SetPoint("LEFT", inset, 0)
    p.right = f:CreateTexture(nil, layer)
    p.right:SetTexture(DISC)
    p.right:SetTexCoord(0.5, 1, 0, 1)
    p.right:SetSize(r, r * 2)
    p.right:SetPoint("RIGHT", -inset, 0)
    p.mid = f:CreateTexture(nil, layer)
    p.mid:SetTexture("Interface\\Buttons\\WHITE8X8")
    p.mid:SetPoint("TOPLEFT", p.left, "TOPRIGHT")
    p.mid:SetPoint("BOTTOMRIGHT", p.right, "BOTTOMLEFT")
    function p.Paint(token: string)
        draw.paint(p.left, token)
        draw.paint(p.right, token)
        draw.paint(p.mid, token)
    end
    return p
end

local menus: { [any]: boolean } = setmetatable({}, { __mode = "k" })

-- A pill as a count's badge: its outline and its fill.
type Badge = Frame & { edge: Pill, fill: Pill }

-- One button: a secure one clicking a Blizzard micro button (`item.click`),
-- else a plain one calling `item.onClick`.
export class MenuButton extends Button
    item: { [string]: any }
    hover: Texture
    edge: draw.Border
    glyph: Texture
    alert: Frame
    alertRing: Texture
    alertDot: Texture
    alertGlow: draw.SoftEdge
    badge: Badge
    count: FontString
    active: boolean? = nil
    alertText: string? = nil
    lines: any[]? = nil

    constructor(menu: MicroMenu, item: { [string]: any })
        super(menu.name and (menu.name .. item.key) or nil, menu, item.click ~= nil and "SecureActionButtonTemplate" or nil)
        self.item = item
        local px = draw.size("menu-button")
        self:SetSize(px, px)
        -- both: a secure button acts on the one the game's ActionButtonUseKeyDown names
        if item.click ~= nil then
            self:RegisterForClicks("AnyDown", "AnyUp")
            self:SetAttribute("type", "click")
            self:SetAttribute("clickbutton", _G[item.click])
        else
            self:RegisterForClicks("LeftButtonUp")
            self:SetScript("OnClick", function() if item.onClick then item.onClick() end end)
        end
        self.hover = draw.fill(self, "surface-raised", "BACKGROUND")
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.edge = draw.border(self, "gilt-line")
        self.edge:SetShown(false)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetSize(18, 18)
        self.glyph:SetPoint("CENTER")
        self.glyph:SetTexture(GLYPHS .. item.glyph .. ".tga")
        draw.paint(self.glyph, "ink")
        -- the alert: a 6px arcane diamond, 3px in from the top right, glowing
        self.alert = CreateFrame("Frame", nil, self)
        self.alert:SetSize(8, 8)
        self.alert:SetPoint("CENTER", self, "TOPRIGHT", -6, -6)
        self.alert:SetFrameLevel(self:GetFrameLevel() + 2)
        self.alertRing = draw.diamond(self.alert, 8, "surface", "OVERLAY", 6)
        self.alertRing:SetPoint("CENTER")
        self.alertDot = draw.diamond(self.alert, 6, "arcane", "OVERLAY", 7)
        self.alertDot:SetPoint("CENTER")
        self.alertGlow = draw.shadow(self.alert, "glow-arcane")
        self.alert:Hide()
        -- a count (the bags' free slots) in a pill on the bottom right corner
        -- (design "Micro menu: Collections glyph and bag count" D): 14 px
        -- tall, hanging into the panel's padding, a gilt-line edge around
        -- its fill
        local badge: Badge = CreateFrame("Frame", nil, self) :: any
        badge:SetHeight(14)
        badge:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", 4, -3)
        badge:SetFrameLevel(self:GetFrameLevel() + 2)
        badge.edge = pill(badge, 0, "BACKGROUND")
        badge.fill = pill(badge, 1, "ARTWORK")
        self.badge = badge
        self.count = badge:CreateFontString(nil, "OVERLAY")
        fonts.apply(self.count, "label")
        self.count:SetPoint("CENTER", 0, 0)
        badge:Hide()
    end

    @script("OnEnter", { hook = true })
    function entered()
        self.hover:Show()
        self.edge:SetShown(true)
        local key = keyOf(self.item.click)
        showTooltip(self, { title = self.item.label, subtitle = key and ("Key: " .. key) or nil,
            lines = self.lines, maxWidth = self.lines and 320 or nil, description = self.alertText })
    end

    @script("OnLeave", { hook = true })
    function left()
        self.hover:SetShown(self.active and true or false)
        self.edge:SetShown(self.active and true or false)
        hideTooltip()
    end

    @script("OnMouseDown", { hook = true })
    function pressed() self.glyph:SetPoint("CENTER", 0, -1) end

    @script("OnMouseUp", { hook = true })
    function released() self.glyph:SetPoint("CENTER", 0, 0) end

    -- The pill fitted around the count.
    function fitBadge()
        self.badge:SetWidth(math.max(14, math.ceil(self.count:GetStringWidth()) + 6))
    end
end

-- The menu (Raw.Mixins.MicroMenu is the class).
export class MicroMenu extends Frame
    name: string?
    buttons: { [string]: MenuButton } = {}
    items: { [string]: any }[] = {}

    constructor(parent: any, opts: { name?: string }?)
        super(opts and opts.name, parent)
        self.name = opts and opts.name
        draw.fill(self, "surface-glass", "BACKGROUND"):SetAllPoints()
        draw.border(self, "gilt-line")
        draw.shadow(self, "shadow-panel")
        self:SetSize(1, 1)
        menus[self] = true
        extend.add(extend.Kind.MicroMenu, self, { name = self.name })
    end

    function SetItems(items: { [string]: any }[]): boolean
        if InCombatLockdown() then return false end
        self.items = items
        local px, gap, pad = draw.size("menu-button"), S["space-2"], S["space-2"]
        for _, b in pairs(self.buttons) do b:Hide() end
        local x = pad
        for _, item in ipairs(items) do
            local b = self.buttons[item.key]
            if not b then
                b = MenuButton.new(self, item)
                self.buttons[item.key] = b
            end
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", x, -pad)
            b:Show()
            x = x + px + gap
        end
        self:SetSize(math.max(1, x - gap + pad), px + pad * 2)
        return true
    end

    function SetActive(key: string, active: any)
        local b = self.buttons[key]
        local on = active and true or false
        if not b or b.active == on then return end
        b.active = on
        if not b:IsMouseOver() then
            b.hover:SetShown(on)
            b.edge:SetShown(on)
        end
    end

    function SetAlert(key: string, text: string?)
        local b = self.buttons[key]
        if not b then return end
        b.alertText = text
        b.alert:SetShown(text ~= nil)
    end

    -- 0.17: lines in a button's tooltip, under its key (showTooltip's
    -- lines: { left, right }); nil takes them away.
    function SetLines(key: string, lines: any[]?)
        local b = self.buttons[key]
        if not b then return end
        b.lines = lines
    end

    -- 0.17: a count on a button, in a pill on its bottom right corner (nil
    -- clears it): its text colour token (ink by default) and the pill's
    -- fill (surface by default).
    function SetCount(key: string, text: string?, color: string?, fill: string?)
        local b = self.buttons[key]
        if not b then return end
        if text == nil or text == "" then
            b.badge:Hide()
            return
        end
        b.count:SetText(text)
        draw.paint(b.count, color or "ink")
        b.badge.edge.Paint("gilt-line")
        b.badge.fill.Paint(fill or "surface")
        b:fitBadge()
        b.badge:Show()
    end
end
mixins.MicroMenu = MicroMenu

-- a theme's label size: the counts' pills fitted again
events.on("SUUUI_THEME_CHANGED", function()
    for m in pairs(menus) do
        for _, b in pairs((m :: MicroMenu).buttons) do b:fitBadge() end
    end
end, "MicroMenu")

export function microMenu(parent: any, opts: { name?: string }?): MicroMenu
    return MicroMenu.new(parent, opts)
end
