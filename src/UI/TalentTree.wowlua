-- UI/TalentTree.wowlua
-- The Talents page (design boards "Talents" and "Talent nodes"): the class's
-- trees side by side, each a panel on surface-sunk with its name and points,
-- the talents on a 4-column grid (32px icons, a rank badge at the bottom
-- right) with prerequisite arrows; above, the spec's name and the points per
-- tree; below, the points to spend, what is planned, Undo and Apply.
--
--   local tt = talentTree(parent)
--   tt:SetSpecs(list, viewing)  -- { { label, name, active, locked } } or nil
--                               -- (one spec: no row); viewing: an index
--   tt:SetData({ name, available, pending, editable, hint, rows (7),
--       trees = { { name, points, more, nodes = { node }, links = { link } } } })
--     more: a line under the tree ("2 more talents in a future update")
--     0.17: head = { name, class, line }: someone else's talents read only:
--       their class diamond, the name in its class colour, the line (Level 30
--       Shaman), the points per tree by name and a "Read only" badge;
--       readOnly = true: no points to spend, Undo or Apply; back = "label":
--       a button at the foot's right (tt.onBack())
--     0.17 (talent builds): actions = { primary = { label, enabled, onClick },
--       secondary = { … } } in place of Apply and Undo; status = text and
--       statusColor = token in place of the planned points' line; unspent =
--       text in place of "N points to spend"
--   tt.noSummary = true   -- no summary line (a page with its own head)
--   tt.fillPanels = true  -- the trees' panels down to the foot (a taller page)
--     node = { row, col, rank, pending, max, icon, locked, canSpend, ... }
--       0.17: next = true: the build's next talent (a fel ring and a Next tag)
--     link = { from = node, to = node, met }
--   tt.onClick(node) / onRemove(node) / onEnter(button, node) / onLeave()
--   tt.onApply() / onUndo() / onSpec(i) / onActivate()
--
-- 0.17, talent builds (design board "Talent builds", B and F):
--   tt:SetBuilds({ options, value, onChange, foot, diamond, badge, buttons })
--     the build picker in the summary's place: a Select of `options` (its
--     search always shown; `foot` its links), the class `diamond` token left
--     of it, a `badge` ("Active") after it, `buttons` ({ label, variant,
--     onClick, disabled, reason }) at the row's right; nil: the summary
--   tt:SetOrder(lines)     -- the order panel right of the trees (nil: none);
--     lines = { { levels = "10–14", name, ranks = "1–5", icon, state =
--     "learned"|"next"|nil, node } }; hovering one calls tt.onOrderEnter(line)
--     and tt.onOrderLeave(); dragging one calls tt.onOrderMove(from, before)
--     (before: the index of the line it goes in front of, #lines + 1 the end)
--   tt:MarkNode(nodeID)    -- outlines one talent (the hovered line's), nil: none
--   TALENT_ORDER_W         -- the width the order panel adds to the page
--
-- A node: full or partly learned in ink; one that can take a point in arcane
-- with a glow; planned points (not applied yet) with an arcane badge; locked
-- dim on a faint edge.

import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import icon, Icon from "/UI/Icon"
import * as panel from "/UI/Panel"
import ScrollArea from "/UI/Panel"
import * as inputs from "/UI/Inputs"
import Segmented from "/UI/Inputs"
import * as controls from "/UI/Controls"
import SuuButton, StateBadge from "/UI/Controls"
import * as uiSelect from "/UI/Select"
import Select, SelectOption, SelectFootLink from "/UI/Select"
import showTooltip, hideTooltip from "/UI/Tooltip"

local S = T.space

local CW, RH, OX, NS = 44, 46, 20, 32   -- column and row step, left inset, node size
local ROWS = 7
local GRAPH_W = 200
local function graphH(rows: number): number return rows * RH - (RH - NS) end
local GRAPH_H = graphH(ROWS)
local PAD = S["space-4"]
local GAP = S["space-6"]
local HEAD_H = 16
local FOOT_H = 38
local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"

-- The width the page needs: three panels and their gaps.
local PANEL_W = GRAPH_W + PAD * 2
export const TALENT_TREE_W = PANEL_W * 3 + GAP * 2
-- the order panel (talent builds): its lines and the room it adds
local ORDER_W = 220
local LINE_H, LINE_STEP = 22, 23
export const TALENT_ORDER_W = ORDER_W + GAP
local PICKER_H = 30

local hex = draw.hex

--------------------------------------------------------------------------------
-- The data (see the header)
--------------------------------------------------------------------------------

-- A talent: where it sits and what it holds; the caller's own fields ride
-- along (the tree hands the node back in its callbacks).
export type TalentNode = {
    [string]: unknown,
    row: number,
    col: number,
    id?: number,
    rank?: number,
    pending?: number,
    max?: number,
    icon?: number | string,
    locked?: boolean,
    canSpend?: boolean,
    next?: boolean,
}

-- A prerequisite arrow.
export type TalentLink = { from: TalentNode, to: TalentNode, met?: boolean }

export type TalentTreeData = { name?: string, points?: number, more?: string, nodes?: TalentNode[], links?: TalentLink[] }

-- Someone else's talents (0.17): who.
export type TalentHead = { name?: string, class?: string, line?: string }

-- A button of a build's plan (0.17) in place of Apply or Undo.
export type TalentAction = { label: string, enabled?: boolean, onClick: () -> () }

export type TalentData = {
    name?: string,
    available?: number,
    pending?: number,
    editable?: boolean,
    hint?: string,
    rows?: number,
    trees?: TalentTreeData[],
    head?: TalentHead,
    readOnly?: boolean,
    back?: string,
    actions?: { primary?: TalentAction, secondary?: TalentAction },
    status?: string,
    statusColor?: string,
    unspent?: string,
    spentLabel?: string,
}

-- A spec of the spec row.
export type TalentSpec = { label: string, name?: string, active?: boolean, locked?: boolean }

-- A line of the order panel: a run of a talent's ranks (the build's steps
-- `from` to `to`).
export type OrderLineData = { levels?: string, name?: string, ranks?: string, icon?: number | string, state?: string,
    node?: number, count?: number, from?: number, to?: number }

-- A button at the build picker's right.
export type BuildButton = { label: string, variant?: string, onClick?: () -> (), disabled?: boolean, reason?: string }

-- The build picker (0.17): its options, the build shown, and the row's parts.
export type TalentBuilds = {
    options?: SelectOption<string>[],
    value?: string,
    onChange?: (value: string) -> (),
    foot?: SelectFootLink[],
    diamond?: string,
    badge?: string,
    buttons?: BuildButton[],
}

-- built trees, drawn again on a theme change
local live: { [TalentTree]: boolean } = setmetatable({}, { __mode = "k" })

--------------------------------------------------------------------------------
-- A node
--------------------------------------------------------------------------------

-- A small fel tag ("Next").
class Tag extends Frame
    readonly text: Text

    constructor(parent: Frame, label: string)
        super(nil, parent)
        self:SetHeight(12)
        draw.fill(self, "fel"):SetAllPoints()
        self.text = text(self, "micro", "on-signal")
        self.text:SetPoint("CENTER", 0, 0)
        self.text:SetValue(label)
    end

    function Fit() self:SetWidth(math.ceil(self.text:GetUnboundedStringWidth()) + 8) end
end

-- A node's rank badge, at its bottom right.
class RankBadge extends Frame
    readonly bg: Texture
    readonly edge: draw.Border
    readonly text: Text

    constructor(b: Button)
        super(nil, b)
        self:SetFrameLevel(b:GetFrameLevel() + 3)
        self:SetHeight(12)
        self:SetPoint("BOTTOMRIGHT", b, "BOTTOMRIGHT", 6, -6)
        self.bg = self:CreateTexture(nil, "BACKGROUND")
        self.bg:SetAllPoints()
        self.edge = draw.border(self, "gilt-line")
        self.text = text(self, "micro", "ink-muted")
        self.text:SetPoint("CENTER", 0, 0)
    end
end

class NodeButton extends Button
    readonly icon: Icon
    readonly badge: RankBadge
    data: TalentNode? = nil
    hover: boolean = false
    marked: boolean = false
    -- the build's next talent: a fel ring and a Next tag (made when first needed)
    ring: Frame? = nil
    tag: Tag? = nil

    constructor(tt: TalentTree, graph: Frame)
        super(nil, graph)
        self:SetSize(NS, NS)
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.icon = icon(self, NS)
        self.icon:SetAllPoints()
        self.badge = RankBadge.new(self)
        self:SetScript("OnClick", function(_: Button, button: string)
            local d = self.data
            if not d then return end
            if button == "RightButton" then
                if tt.onRemove then tt.onRemove(d) end
            elseif tt.onClick then
                tt.onClick(d)
            end
        end)
        self:SetScript("OnEnter", function()
            self.hover = true
            self:Draw()
            local d = self.data
            if tt.onEnter and d then tt.onEnter(self, d) end
        end)
        self:SetScript("OnLeave", function()
            self.hover = false
            self:Draw()
            if tt.onLeave then tt.onLeave() end
        end)
    end

    function Draw()
        local d = self.data
        if not d then return end
        local total = (d.rank or 0) + (d.pending or 0)
        local full = total >= (d.max or 1)
        local some = total > 0
        local canSpend = d.canSpend and not full and not d.locked
        local border: string
        if (d.pending or 0) > 0 then border = "arcane"
        elseif canSpend then border = "arcane"
        elseif d.locked then border = "gilt-faint"
        elseif some then border = "ink"
        else border = "gilt-hairline" end
        if (self.hover or self.marked) and not d.locked then border = "gilt" end
        if self.marked then border = "gilt" end
        self.icon:SetState((d.locked or not some) and "dim" or "rest")
        self.icon:SetBorder(border)
        self.icon:SetGlow(self.marked and "glow-ward" or (canSpend and "glow-arcane" or nil))
        -- the build's next talent: a fel ring and a Next tag above it
        if d.next and not self.ring then
            local ring = CreateFrame("Frame", nil, self)
            ring:SetPoint("TOPLEFT", -4, 4)
            ring:SetPoint("BOTTOMRIGHT", 4, -4)
            ring:SetFrameLevel(self:GetFrameLevel() + 2)
            draw.border(ring, "fel", { width = 2 })
            self.ring = ring
            local tag = Tag.new(self, "Next")
            tag:SetFrameLevel(self:GetFrameLevel() + 5)
            tag:SetPoint("BOTTOMLEFT", self, "TOPLEFT", -4, 5)
            self.tag = tag
        end
        local ring, tag = self.ring, self.tag
        if ring and tag then
            ring:SetShown(d.next == true)
            tag:SetShown(d.next == true)
            tag:Fit()
        end
        local badge = self.badge
        badge.text:SetValue(total .. "/" .. (d.max or 1))
        badge:SetWidth(math.ceil(badge.text:GetUnboundedStringWidth()) + 6)
        if (d.pending or 0) > 0 then
            draw.paintFill(badge.bg, "arcane")
            badge.edge:SetColor("arcane")
            badge.text:SetColor("on-signal")
        else
            draw.paintFill(badge.bg, "surface")
            badge.edge:SetColor(canSpend and "arcane" or "gilt-line")
            badge.text:SetColor(canSpend and "arcane" or (some and "ink" or "ink-muted"))
        end
    end
end

--------------------------------------------------------------------------------
-- A tree panel
--------------------------------------------------------------------------------

class TreePanel extends Frame
    readonly name: Text
    readonly points: Text
    readonly graph: Frame
    readonly more: Text
    readonly nodes: NodeButton[] = {}
    readonly lines: Line[] = {}
    readonly heads: Texture[] = {}

    constructor(tt: TalentTree)
        super(nil, tt.treesRow)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-faint")
        self.name = text(self, "header", "gilt-text")
        self.name:SetPoint("TOPLEFT", PAD, -PAD)
        self.points = text(self, "numeric", "ink")
        self.points:SetPoint("TOPRIGHT", -PAD, -PAD)
        self.graph = CreateFrame("Frame", nil, self)
        self.graph:SetSize(GRAPH_W, GRAPH_H)
        self.graph:SetPoint("TOP", self, "TOP", 0, -(PAD + HEAD_H + PAD))
        self.more = text(self, "caption", "ink-muted")
        self.more:SetPoint("BOTTOM", self, "BOTTOM", 0, PAD)
    end

    -- A prerequisite arrow from one node to another (down, or sideways in a row).
    function DrawLink(i: number, l: TalentLink)
        local line = self.lines[i]
        if not line then
            line = self.graph:CreateLine(nil, "ARTWORK")
            line:SetThickness(2)
            self.lines[i] = line
            local head = self.graph:CreateTexture(nil, "ARTWORK", nil, 1)
            head:SetSize(8, 8)
            self.heads[i] = head
        end
        local head = self.heads[i]
        local a, b = l.from, l.to
        local x1: number, y1: number, x2: number, y2: number
        local glyph: string
        if a.row == b.row then
            local right = b.col > a.col
            x1 = a.col * CW + OX + (right and NS or 0)
            x2 = b.col * CW + OX + (right and -1 or NS + 1)
            y1, y2 = a.row * RH + NS / 2, a.row * RH + NS / 2
            glyph = right and "chevronRight" or "chevronLeft"
        else
            x1 = a.col * CW + OX + NS / 2
            x2 = b.col * CW + OX + NS / 2
            y1 = a.row * RH + NS
            y2 = b.row * RH - 1
            glyph = "chevronDown"
        end
        local token = l.met and "ink-muted" or "gilt-line"
        draw.paintFill(line, token)
        line:SetStartPoint("TOPLEFT", self.graph, x1, -y1)
        line:SetEndPoint("TOPLEFT", self.graph, x2, -y2)
        line:Show()
        head:SetTexture(GLYPHS .. glyph .. ".tga")
        draw.paint(head, token)
        head:ClearAllPoints()
        head:SetPoint("CENTER", self.graph, "TOPLEFT", x2, -y2 + (glyph == "chevronDown" and 3 or 0))
        head:Show()
    end

    function Fill(tt: TalentTree, t: TalentTreeData)
        self.more:SetValue(t.more or "")
        self.more:SetShown(t.more ~= nil)
        self.name:SetValue(t.name or "")
        self.points:SetValue(tostring(t.points or 0))
        local nodes = t.nodes or {}
        for i, d in ipairs(nodes) do
            local b = self.nodes[i] or NodeButton.new(tt, self.graph)
            self.nodes[i] = b
            b.data = d
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", self.graph, "TOPLEFT", d.col * CW + OX, -(d.row * RH))
            b.icon:SetArt(d.icon or 134400)
            b:Draw()
            b:Show()
        end
        for i = #nodes + 1, #self.nodes do self.nodes[i]:Hide(); self.nodes[i].data = nil end
        local links = t.links or {}
        for i, l in ipairs(links) do self:DrawLink(i, l) end
        for i = #links + 1, #self.lines do self.lines[i]:Hide(); self.heads[i]:Hide() end
    end
end

--------------------------------------------------------------------------------
-- The order panel (talent builds, design F): one line per run of a talent's
-- ranks, in the build's order; a line drags to another place
--------------------------------------------------------------------------------

-- How far the cursor is below the top of `frame`, in its own scale.
local function cursorBelow(frame: Frame): number?
    local top = frame:GetTop()
    if not top then return nil end
    local _, y = GetCursorPosition()
    return top - y / frame:GetEffectiveScale()
end

class OrderLine extends Button
    readonly hoverFill: Texture
    readonly edge: draw.Border
    readonly levels: Text
    readonly icon: Texture
    readonly tag: Tag
    readonly name: Text
    data: OrderLineData? = nil
    index: number = 0
    hover: boolean = false
    dragged: boolean = false

    constructor(tt: TalentTree, o: OrderPanel)
        super(nil, o.scroll.child)
        self:SetHeight(LINE_H)
        self.hoverFill = draw.fill(self, "surface-raised")
        self.hoverFill:SetAllPoints()
        self.hoverFill:Hide()
        self.edge = draw.border(self, "arcane")
        self.edge:SetShown(false)
        self.levels = text(self, "micro", "ink-muted")
        self.levels:SetPoint("LEFT", S["space-3"], 0)
        self.icon = self:CreateTexture(nil, "ARTWORK")
        self.icon:SetSize(16, 16)
        self.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        self.icon:SetPoint("LEFT", S["space-3"] + 40, 0)
        self.tag = Tag.new(self, "Next")
        self.tag:SetPoint("RIGHT", -S["space-3"], 0)
        self.name = text(self, "caption", "ink")
        self.name:SetPoint("LEFT", self.icon, "RIGHT", S["space-3"], 0)
        self.name:SetPoint("RIGHT", self.tag, "LEFT", -S["space-2"], 0)
        self.name:SetJustifyH("LEFT")
        self.name:SetWordWrap(false)
        self:SetScript("OnEnter", function()
            self.hover = true
            self:Draw()
            local d = self.data
            if d and not o.dragging and tt.onOrderEnter then tt.onOrderEnter(d, self) end
        end)
        self:SetScript("OnLeave", function()
            self.hover = false
            self:Draw()
            local d = self.data
            if d and not o.dragging and tt.onOrderLeave then tt.onOrderLeave(d) end
        end)
        self:SetScript("OnMouseDown", function(_: Button, button: string)
            if button ~= "LeftButton" then return end
            o.press = { index = self.index, y = cursorBelow(o.scroll.child) or 0, line = self }
        end)
        self:SetScript("OnMouseUp", function() o:Finish() end)
    end

    function Draw()
        local d = self.data
        if not d then return end
        local on = self.hover or self.dragged
        self.hoverFill:SetShown(on)
        self.edge:SetShown(on)
        local learned = d.state == "learned"
        self.levels:SetColor(learned and "ink-faint" or "ink-muted")
        self.name:SetColor(learned and "ink-muted" or "ink")
        self.icon:SetDesaturated(learned)
        self.icon:SetAlpha(learned and 0.6 or 1)
        self.tag:SetShown(d.state == "next")
        self.tag:Fit()
        self:SetAlpha(self.dragged and 0.4 or 1)
    end
end

-- The dragged line, lifted onto a plate under the cursor.
class OrderPlate extends Frame
    readonly icon: Texture
    readonly name: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(LINE_H)
        self:SetFrameLevel(parent:GetFrameLevel() + 10)
        draw.fill(self, "surface-raised"):SetAllPoints()
        draw.border(self, "arcane")
        self.icon = self:CreateTexture(nil, "ARTWORK")
        self.icon:SetSize(16, 16)
        self.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        self.icon:SetPoint("LEFT", S["space-3"] + 40, 0)
        self.name = text(self, "caption", "ink")
        self.name:SetPoint("LEFT", self.icon, "RIGHT", S["space-3"], 0)
        self:Hide()
    end
end

-- A line pressed: which, where the cursor was.
type Press = { index: number, y: number, line: OrderLine }

class OrderPanel extends Frame
    readonly tt: TalentTree
    readonly title: Text
    readonly count: Text
    readonly scroll: ScrollArea
    readonly empty: Text
    readonly lines: OrderLine[] = {}
    -- where a dragged line lands: an arcane rule between two lines
    readonly drop: Texture
    readonly plate: OrderPlate
    press: Press? = nil
    dragging: boolean? = nil

    constructor(tt: TalentTree)
        super(nil, tt)
        self.tt = tt
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-faint")
        self.title = text(self, "header", "gilt-text")
        self.title:SetPoint("TOPLEFT", PAD, -PAD)
        self.title:SetValue("Order")
        self.count = text(self, "numeric", "ink")
        self.count:SetPoint("TOPRIGHT", -PAD, -PAD)
        local scroll = panel.scrollArea(self, 2)
        self.scroll = scroll
        scroll:SetPoint("TOPLEFT", self, "TOPLEFT", S["space-2"], -(PAD + HEAD_H + PAD))
        scroll:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", -(S["space-2"] + 6), PAD)
        scroll:HookScript("OnSizeChanged", function(_: ScrollFrame, w: number) scroll.child:SetWidth(w) end)
        self.empty = text(scroll.child, "caption", "ink-muted")
        self.empty:SetPoint("TOPLEFT", S["space-3"], -S["space-2"])
        self.empty:SetPoint("RIGHT", -S["space-3"], 0)
        self.empty:SetJustifyH("LEFT")
        self.empty:SetWordWrap(true)
        self.empty:SetValue("Click talents in the order you'll learn them.")
        self.drop = scroll.child:CreateTexture(nil, "OVERLAY")
        draw.paintFill(self.drop, "arcane")
        self.drop:SetHeight(2)
        self.drop:Hide()
        self.plate = OrderPlate.new(scroll.child)
        self:SetScript("OnUpdate", function() self:Drag() end)
    end

    -- The slot under the cursor (0: before the first line) and how far down it is.
    private function slot(): (number, number)
        local y = cursorBelow(self.scroll.child) or 0
        local n = #(self.tt.orderLines or {})
        return math.max(0, math.min(n, math.floor((y + LINE_STEP / 2) / LINE_STEP))), y
    end

    -- The press ends: a drag drops its line where the cursor is.
    function Finish()
        local press, dragging = self.press, self.dragging
        self.press, self.dragging = nil, nil
        self.drop:Hide()
        self.plate:Hide()
        if press then press.line.dragged = false; press.line:Draw() end
        if not (press and dragging) then return end
        local before = self:slot() + 1
        local move = self.tt.onOrderMove
        if before ~= press.index and before ~= press.index + 1 and move then
            move(press.index, before)
        end
    end

    -- While a line is pressed: past 4px it drags, the plate and the drop
    -- following the cursor; near an edge the list scrolls along.
    private function Drag()
        local press = self.press
        if not press then return end
        if not IsMouseButtonDown("LeftButton") then self:Finish() return end
        local s, y = self:slot()
        if not self.dragging then
            if math.abs(y - press.y) < 4 then return end
            self.dragging = true
            local line = press.line
            line.dragged = true
            line:Draw()
            self.plate:SetWidth(line:GetWidth())
            local d = line.data
            self.plate.icon:SetTexture(d and d.icon or 134400)
            self.plate.name:SetValue(line.name:GetText() or "")
            self.plate:Show()
            if d and self.tt.onOrderLeave then self.tt.onOrderLeave(d) end
        end
        local child = self.scroll.child
        self.plate:ClearAllPoints()
        self.plate:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -(y - LINE_H / 2))
        self.drop:ClearAllPoints()
        self.drop:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -(s * LINE_STEP) + 1)
        self.drop:SetPoint("RIGHT", child, "RIGHT", 0, 0)
        self.drop:Show()
        local sc = self.scroll
        local at = cursorBelow(sc)
        local max = math.max(0, child:GetHeight() - sc:GetHeight())
        if at and at < 14 then
            sc:SetVerticalScroll(math.max(0, sc:GetVerticalScroll() - 4))
        elseif at and at > sc:GetHeight() - 14 then
            sc:SetVerticalScroll(math.min(max, sc:GetVerticalScroll() + 4))
        end
    end
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

-- A button of the build picker's row, with what it does.
class PickerButton extends SuuButton
    def: BuildButton

    constructor(parent: Frame, def: BuildButton)
        super(parent, { text = def.label, variant = def.variant or "quiet", onClick = function(b: SuuButton)
            local d = (b :: PickerButton).def
            local click = d.onClick
            if click and not d.disabled then click() end
        end })
        self.def = def
        self:HookScript("OnEnter", function()
            local d = self.def
            if d.reason then showTooltip(self, { title = d.label, description = d.reason }) end
        end)
        self:HookScript("OnLeave", function() hideTooltip() end)
    end
end

export class TalentTree extends Frame
    panels: TreePanel[] = {}
    specRow: Frame
    activeBadge: StateBadge
    activate: SuuButton
    summary: Frame
    summaryName: Text
    summaryPoints: Text
    summaryDiamond: Texture
    summaryLine: Text
    summaryBadge: StateBadge
    treesRow: Frame
    foot: Frame
    apply: SuuButton
    undo: SuuButton
    back: SuuButton
    unspent: Text
    status: Text
    order: OrderPanel? = nil
    orderLines: OrderLineData[]? = nil
    specList: TalentSpec[]? = nil
    segmented: Segmented<number>? = nil
    segmentedFor: number? = nil
    builds: TalentBuilds? = nil
    picker: Select<string>? = nil
    pickerBadge: StateBadge? = nil
    pickerButtons: PickerButton[] = {}
    data: TalentData = {}
    headShown: boolean? = nil
    -- what the page asks of its owner (see the header)
    noSummary: boolean? = nil
    fillPanels: boolean? = nil
    onClick: ((node: TalentNode) -> ())? = nil
    onRemove: ((node: TalentNode) -> ())? = nil
    onEnter: ((button: Button, node: TalentNode) -> ())? = nil
    onLeave: (() -> ())? = nil
    onApply: (() -> ())? = nil
    onUndo: (() -> ())? = nil
    onSpec: ((index: number) -> ())? = nil
    onActivate: (() -> ())? = nil
    onBack: (() -> ())? = nil
    onOrderEnter: ((line: OrderLineData, button: Button) -> ())? = nil
    onOrderLeave: ((line: OrderLineData) -> ())? = nil
    onOrderMove: ((from: number, before: number) -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        -- the specs (two talent groups only)
        self.specRow = CreateFrame("Frame", nil, self)
        self.specRow:SetHeight(30)
        self.activeBadge = controls.stateBadge(self.specRow, "neutral", "Active")
        self.activate = controls.button(self.specRow, { text = "Activate", variant = "quiet",
            onClick = function() if self.onActivate then self.onActivate() end end })
        self.activeBadge:SetPoint("RIGHT", self.specRow, "RIGHT", 0, 0)
        self.activate:SetPoint("RIGHT", self.specRow, "RIGHT", 0, 0)
        self.specRow:Hide()
        -- the summary
        self.summary = CreateFrame("Frame", nil, self)
        self.summary:SetSize(1, T.type.label.lineHeight)
        self.summaryName = text(self.summary, "label", "ink")
        self.summaryName:SetPoint("LEFT")
        self.summaryPoints = text(self.summary, "caption", "ink-muted")
        self.summaryPoints:SetPoint("LEFT", self.summaryName, "RIGHT", S["space-5"], 0)
        -- someone else's (0.17): the class diamond, the line, Read only
        self.summaryDiamond = draw.diamond(self.summary, 7, "ink", "OVERLAY")
        self.summaryDiamond:SetPoint("CENTER", self.summary, "LEFT", 4, 0)
        self.summaryDiamond:Hide()
        self.summaryLine = text(self.summary, "caption", "ink-muted")
        self.summaryLine:SetPoint("LEFT", self.summaryName, "RIGHT", S["space-4"], -1)
        self.summaryLine:Hide()
        self.summaryBadge = controls.stateBadge(self.summary, "neutral", "Read only")
        self.summaryBadge:SetPoint("RIGHT")
        self.summaryBadge:Hide()
        -- the trees
        self.treesRow = CreateFrame("Frame", nil, self)
        -- the foot: a faint rule, the points, the status, Undo and Apply
        self.foot = CreateFrame("Frame", nil, self)
        self.foot:SetPoint("BOTTOMLEFT")
        self.foot:SetPoint("BOTTOMRIGHT")
        self.foot:SetHeight(FOOT_H)
        local rule = draw.fill(self.foot, "gilt-faint", "ARTWORK")
        rule:SetHeight(1)
        rule:SetPoint("TOPLEFT")
        rule:SetPoint("TOPRIGHT")
        self.apply = controls.button(self.foot, { text = "Apply", variant = "primary", onClick = function()
            local a = self.data.actions
            local primary = a and a.primary
            if primary then primary.onClick() elseif self.onApply then self.onApply() end
        end })
        self.apply:SetPoint("BOTTOMRIGHT", self.foot, "BOTTOMRIGHT", 0, 0)
        self.undo = controls.button(self.foot, { text = "Undo", variant = "quiet", onClick = function()
            local a = self.data.actions
            local secondary = a and a.secondary
            if secondary then secondary.onClick() elseif self.onUndo then self.onUndo() end
        end })
        self.undo:SetPoint("RIGHT", self.apply, "LEFT", -S["space-3"], 0)
        self.back = controls.button(self.foot, { text = "Back", icon = "chevronLeft",
            onClick = function() if self.onBack then self.onBack() end end })
        self.back:SetPoint("BOTTOMRIGHT", self.foot, "BOTTOMRIGHT", 0, 0)
        self.back:Hide()
        self.unspent = text(self.foot, "caption", "ink-muted")
        self.unspent:SetPoint("LEFT", self.foot, "BOTTOMLEFT", 0, 15)
        self.status = text(self.foot, "caption", "ink-muted")
        self.status:SetPoint("LEFT", self.unspent, "RIGHT", S["space-5"], 0)
        self.status:SetPoint("RIGHT", self.undo, "LEFT", -S["space-5"], 0)
        self.status:SetJustifyH("LEFT")
        self:Layout()
        self:SetData({})
        live[self] = true
    end

    function SetOrder(lines: OrderLineData[]?)
        self.orderLines = lines
        local o = self.order
        if lines and not o then
            o = OrderPanel.new(self)
            self.order = o
        end
        if o then
            o:SetShown(lines ~= nil)
            if lines then
                o.empty:SetShown(#lines == 0)
                local steps = 0
                for i, d in ipairs(lines) do
                    local l = o.lines[i] or OrderLine.new(self, o)
                    o.lines[i] = l
                    l.data, l.index = d, i
                    l:ClearAllPoints()
                    l:SetPoint("TOPLEFT", o.scroll.child, "TOPLEFT", 0, -(i - 1) * LINE_STEP)
                    l:SetPoint("RIGHT", o.scroll.child, "RIGHT", 0, 0)
                    l.levels:SetValue(d.levels or "")
                    l.icon:SetTexture(d.icon or 134400)
                    local ranks = d.ranks and d.ranks ~= "" and (" |cff" .. hex("ink-muted") .. d.ranks .. "|r") or ""
                    l.name:SetValue((d.name or "") .. ranks)
                    l:Draw()
                    l:Show()
                    steps = steps + (d.count or 1)
                end
                for i = #lines + 1, #o.lines do o.lines[i]:Hide(); o.lines[i].data = nil end
                o.scroll.child:SetHeight(math.max(1, #lines * LINE_STEP))
                o.count:SetValue(tostring(steps))
            end
        end
        self:Layout()
    end

    function MarkNode(nodeID: number?)
        for _, p in ipairs(self.panels) do
            for _, b in ipairs(p.nodes) do
                local d = b.data
                local marked = nodeID ~= nil and d ~= nil and d.id == nodeID
                if b.marked ~= marked then
                    b.marked = marked
                    b:Draw()
                end
            end
        end
    end

    function SetSpecs(list: TalentSpec[]?, viewing: number?)
        self.specList = list
        local show = list ~= nil and #list > 1
        self.specRow:SetShown(show)
        if list and show then
            local seg = self.segmented
            if not seg or self.segmentedFor ~= #list then
                if seg then seg:Hide() end
                local options: inputs.SegmentedOption<number>[] = {}
                for i, s in ipairs(list) do
                    options[i] = { value = i, label = s.label .. (s.name and s.name ~= "" and (": " .. s.name) or ""), disabled = s.locked }
                end
                seg = inputs.segmented(self.specRow, {
                    options = options,
                    onChange = function(v: number) if self.onSpec then self.onSpec(v) end end,
                })
                seg:SetPoint("LEFT")
                self.segmented = seg
                self.segmentedFor = #list
            end
            seg:SetValue(viewing or 1)
            local spec = list[viewing or 1]
            local active = spec ~= nil and spec.active == true
            self.activeBadge:SetShown(active)
            self.activate:SetShown(not active)
            if spec and not active then
                self.activate:SetLabel("Activate " .. (spec.name ~= "" and spec.name or spec.label or ""))
            elseif not active then
                self.activate:SetLabel("Activate ")
            end
        end
        self:Layout()
    end

    -- The build picker in the summary's place (nil: the summary as before).
    function SetBuilds(b: TalentBuilds?)
        self.builds = b
        if b and not self.picker then
            self.picker = uiSelect.select(self.summary, { width = 280, search = "always", maxRows = 12, minListWidth = 300,
                onChange = function(v: string)
                    local builds = self.builds
                    local change = builds and builds.onChange
                    if change then change(v) end
                end })
            self.pickerBadge = controls.stateBadge(self.summary, "neutral", "Active")
        end
        local picker, badge = self.picker, self.pickerBadge
        if picker and badge then
            picker:SetShown(b ~= nil)
            badge:SetShown(b ~= nil and b.badge ~= nil)
            if b then
                picker.foot = b.foot
                picker:SetOptions(b.options or {})
                picker:SetValue(b.value)
                if b.badge then badge:SetState("neutral", b.badge) end
                picker:ClearAllPoints()
                if b.diamond and draw.isColor(b.diamond) then
                    self.summaryDiamond:Show()
                    draw.paint(self.summaryDiamond, b.diamond)
                    picker:SetPoint("LEFT", self.summary, "LEFT", 14, 0)
                else
                    self.summaryDiamond:Hide()
                    picker:SetPoint("LEFT", self.summary, "LEFT", 0, 0)
                end
                badge:ClearAllPoints()
                badge:SetPoint("LEFT", picker, "RIGHT", S["space-4"], 0)
            end
            -- the row's buttons, right to left
            local last: PickerButton? = nil
            local defs = b and b.buttons or {}
            for i, def in ipairs(defs) do
                local btn = self.pickerButtons[i]
                if not btn then
                    btn = PickerButton.new(self.summary, def)
                    self.pickerButtons[i] = btn
                end
                btn.def = def
                btn:SetLabel(def.label)
                btn:SetEnabledState(not def.disabled)
                btn:ClearAllPoints()
                if last then btn:SetPoint("RIGHT", last, "LEFT", -S["space-3"], 0)
                else btn:SetPoint("RIGHT", self.summary, "RIGHT", 0, 0) end
                btn:Show()
                last = btn
            end
            for i = #defs + 1, #self.pickerButtons do self.pickerButtons[i]:Hide() end
        end
        self:Layout()
    end

    function Layout()
        local top = 0
        if self.specRow:IsShown() then
            self.specRow:ClearAllPoints()
            self.specRow:SetPoint("TOPLEFT", self, "TOPLEFT", 0, 0)
            self.specRow:SetPoint("TOPRIGHT", self, "TOPRIGHT", 0, 0)
            top = top + 30 + S["space-5"]
        end
        self.summary:ClearAllPoints()
        self.summary:SetPoint("TOPLEFT", self, "TOPLEFT", 0, -top)
        self.summary:SetPoint("RIGHT", self, "RIGHT", 0, 0)
        self.summary:SetShown(not self.noSummary)
        local sh = self.headShown and T.type["unit-name-lg"].lineHeight or T.type.label.lineHeight
        if self.builds then sh = PICKER_H end
        self.summary:SetHeight(sh)
        if not self.noSummary then top = top + sh + S["space-5"] end
        local order = self.order
        local shown = order ~= nil and order:IsShown()
        self.treesRow:ClearAllPoints()
        self.treesRow:SetPoint("TOPLEFT", self, "TOPLEFT", 0, -top)
        self.treesRow:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", shown and -TALENT_ORDER_W or 0, FOOT_H + S["space-5"])
        if order and shown then
            order:ClearAllPoints()
            order:SetPoint("TOPRIGHT", self, "TOPRIGHT", 0, -top)
            order:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", 0, FOOT_H + S["space-5"])
            order:SetWidth(ORDER_W)
        end
    end

    function SetData(data: TalentData?)
        local d = data or {}
        self.data = d
        local trees = d.trees or {}
        -- the summary: the spec, the points per tree
        local per: string[], total = {}, 0
        for i, t in ipairs(trees) do per[i] = tostring(t.points or 0); total = total + (t.points or 0) end
        local head = d.head
        if (head ~= nil) ~= (self.headShown or false) then
            self.headShown = head ~= nil
            self:Layout()
        end
        local builds = not head and self.builds or nil
        self.summaryDiamond:SetShown(head ~= nil or (builds ~= nil and builds.diamond ~= nil))
        self.summaryBadge:SetShown(head ~= nil)
        self.summaryLine:SetShown(head ~= nil)
        self.summaryName:ClearAllPoints()
        if head then
            -- someone else's: who, and the points per tree by name
            local class = head.class
            local token: string? = class and "class-" .. class:lower()
            if not (token and draw.isColor(token)) then token = nil end
            if token then draw.paint(self.summaryDiamond, token) else self.summaryDiamond:SetVertexColor(1, 1, 1, 1) end
            self.summaryName:SetStyle("unit-name-lg")
            self.summaryName:SetPoint("LEFT", self.summaryDiamond, "RIGHT", S["space-4"], 0)
            self.summaryName:SetColor(token or "ink")
            self.summaryName:SetValue(head.name or "")
            self.summaryLine:SetValue(head.line or "")
            local named: string[] = {}
            for i, t in ipairs(trees) do named[i] = ("%s |cff%s%d|r"):format(t.name or "", hex("ink"), t.points or 0) end
            self.summaryPoints:SetValue(table.concat(named, "   "))
        else
            self.summaryName:SetStyle("label")
            self.summaryName:SetColor("ink")
            self.summaryName:SetPoint("LEFT")
            self.summaryName:SetValue(builds and "" or (d.name or ""))
            self.summaryPoints:SetValue(#per > 0 and (table.concat(per, " / ") .. " · " .. total .. (d.spentLabel or " spent")) or "")
        end
        self.summaryPoints:ClearAllPoints()
        local after: Region = head and self.summaryLine or self.summaryName
        local picker, badge = self.picker, self.pickerBadge
        if builds and picker and badge then after = builds.badge and badge or picker end
        self.summaryPoints:SetPoint("LEFT", after, "RIGHT", S["space-5"], 0)
        -- the trees, side by side, as wide as the row allows
        local width = self.treesRow:GetWidth()
        if not width or width <= 0 then width = TALENT_TREE_W end
        local n = math.max(1, #trees)
        local panelW = math.max(PANEL_W, math.floor((width - GAP * (n - 1)) / n))
        local rows = d.rows or ROWS
        local anyMore = false
        for _, t in ipairs(trees) do if t.more then anyMore = true end end
        for i, t in ipairs(trees) do
            local p = self.panels[i] or TreePanel.new(self)
            self.panels[i] = p
            p:ClearAllPoints()
            p:SetPoint("TOPLEFT", self.treesRow, "TOPLEFT", (i - 1) * (panelW + GAP), 0)
            p.graph:SetHeight(graphH(rows))
            local h = PAD + HEAD_H + PAD + graphH(rows) + PAD + (anyMore and (S["space-3"] + T.type.caption.lineHeight) or 0)
            if self.fillPanels then
                local room = self.treesRow:GetHeight()
                if room and room > h then h = room end
            end
            p:SetSize(panelW, h)
            p:Fill(self, t)
            p:Show()
        end
        for i = #trees + 1, #self.panels do self.panels[i]:Hide() end
        -- the foot
        local available = d.available or 0
        local ro = d.readOnly == true
        self.unspent:SetShown(not ro)
        self.apply:SetShown(not ro)
        self.undo:SetShown(not ro)
        local back = d.back
        self.back:SetShown(back ~= nil)
        if back then self.back:SetLabel(back) end
        self.status:ClearAllPoints()
        if ro then
            self.status:SetPoint("LEFT", self.foot, "BOTTOMLEFT", 0, 15)
        else
            self.status:SetPoint("LEFT", self.unspent, "RIGHT", S["space-5"], 0)
        end
        self.status:SetPoint("RIGHT", back and self.back or (ro and self.foot or self.undo), back and "LEFT" or (ro and "RIGHT" or "LEFT"), -S["space-5"], 0)
        self.unspent:SetText(d.unspent or ("|cff%s%d|r %s"):format(hex("ink"), available, available == 1 and "point to spend" or "points to spend"))
        local pending = d.pending or 0
        if d.status then
            self.status:SetColor(d.statusColor or "ink-muted")
            self.status:SetValue(d.status)
        elseif pending > 0 then
            self.status:SetColor("arcane")
            self.status:SetValue(pending .. (pending == 1 and " point" or " points") .. " not applied yet · right-click to take one back")
        else
            self.status:SetColor("ink-muted")
            self.status:SetValue(d.hint or "Click a talent to plan a point. Nothing changes until you apply.")
        end
        -- a build's plan has its own two (Discard, Save build)
        local a = d.actions
        local primary, secondary = a and a.primary, a and a.secondary
        self.undo:SetLabel(secondary and secondary.label or "Undo")
        self.apply:SetLabel(primary and primary.label or "Apply")
        if a then
            self.undo:SetShown(secondary ~= nil and not ro)
            self.apply:SetShown(primary ~= nil and not ro)
            self.undo:SetEnabledState(secondary ~= nil and secondary.enabled ~= false)
            self.apply:SetEnabledState(primary ~= nil and primary.enabled ~= false)
        else
            self.undo:SetEnabledState(pending > 0)
            self.apply:SetEnabledState(pending > 0 and d.editable ~= false)
        end
    end
end

export function talentTree(parent: Frame): TalentTree
    return TalentTree.new(parent)
end

-- A theme can change the colours in the summary and the foot, and the
-- caption style the panels are measured in.
events.on("SUUUI_THEME_CHANGED", function()
    for f in pairs(live) do
        f:Layout()
        f:SetData(f.data)
        if f.orderLines then f:SetOrder(f.orderLines) end
    end
end, "UI.TalentTree")

--------------------------------------------------------------------------------
-- A talent's tooltip: the game's own, as Blizzard's talent buttons build it
--------------------------------------------------------------------------------
--   traitTooltip(owner, configID, nodeID, {
--       name, treeName,      -- the title; the tree, for the game's "spend N
--                            -- more points in the X tree" lines
--       conditions,          -- the node's condition IDs
--       canSpend, pending,   -- a click plans a point; planned ranks
--       needs = { text },    -- more red lines (a talent above it)
--       blocked = text,      -- why nothing can change now
--   })
-- The title, "Rank 2/5", the talent's text at this rank and the next, what a
-- click does, what it still needs.

export type TraitTooltipOptions = {
    name?: string,
    treeName?: string,
    conditions?: number[],
    canSpend?: boolean,
    pending?: number,
    needs?: string[],
    blocked?: string,
}

local function plainValue(v: unknown): boolean return v ~= nil and not (issecretvalue and issecretvalue(v)) end

export function traitTooltip(owner: Frame, configID: number, nodeID: number, opts: TraitTooltipOptions?)
    local o = opts or {}
    local ok, ni = pcall(C_Traits.GetNodeInfo, configID, nodeID)
    if not ok or not ni then return end
    local tip = GameTooltip
    tip:SetOwner(owner, "ANCHOR_RIGHT")
    GameTooltip_SetTitle(tip, o.name or "")
    local current = plainValue(ni.currentRank) and ni.currentRank or 0
    local max = plainValue(ni.maxRanks) and ni.maxRanks or 1
    GameTooltip_AddHighlightLine(tip, (TALENT_BUTTON_TOOLTIP_RANK_FORMAT or "Rank %s/%s"):format(current, max))
    local increased = plainValue(ni.ranksIncreased) and ni.ranksIncreased or 0
    local active = ni.activeEntry
    if active and active.entryID then
        GameTooltip_AddBlankLineToTooltip(tip)
        tip:AppendInfo("GetTraitEntry", active.entryID, (active.rank or 0) + increased)
    end
    local nextEntry = ni.nextEntry
    if nextEntry and nextEntry.entryID and (ni.ranksPurchased or 0) > 0 then
        GameTooltip_AddBlankLineToTooltip(tip)
        GameTooltip_AddHighlightLine(tip, TALENT_BUTTON_TOOLTIP_NEXT_RANK or "Next Rank:")
        tip:AppendInfo("GetTraitEntry", nextEntry.entryID, (nextEntry.rank or 0) + increased)
    end
    if o.canSpend then
        GameTooltip_AddBlankLineToTooltip(tip)
        GameTooltip_AddInstructionLine(tip, TALENT_BUTTON_TOOLTIP_PURCHASE_INSTRUCTIONS or "Click to learn")
    elseif (o.pending or 0) > 0 then
        GameTooltip_AddBlankLineToTooltip(tip)
        GameTooltip_AddDisabledLine(tip, "Right-click to take a planned point back")
    end
    local spacer = true
    local function need(line: string, isError: boolean?)
        if spacer then GameTooltip_AddBlankLineToTooltip(tip); spacer = false end
        if isError then GameTooltip_AddErrorLine(tip, line) else GameTooltip_AddHighlightLine(tip, line) end
    end
    local best: TraitCondInfo? = nil
    local bestText: string? = nil
    for _, condID in ipairs(o.conditions or {}) do
        local okC, c = pcall(C_Traits.GetConditionInfo, configID, condID, false, o.treeName)
        local said = okC and c and c.tooltipText
        if okC and c and c.isMet == false and said and plainValue(said) and said ~= "" then
            if not best or (c.spentAmountRequired or 0) > (best.spentAmountRequired or 0) then
                best, bestText = c, said
            end
        end
    end
    if bestText then need(bestText) end
    for _, line in ipairs(o.needs or {}) do need(line, true) end
    if o.blocked then need(o.blocked, true) end
    tip:Show()
end
