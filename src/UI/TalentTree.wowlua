-- UI/TalentTree.wowlua
-- The Talents page (design boards "Talents" and "Talent nodes"): the class's
-- trees side by side, each a panel on surface-sunk with its name and points,
-- the talents on a 4-column grid (32px icons, a rank badge at the bottom
-- right) with prerequisite arrows; above, the spec's name and the points per
-- tree; below, the points to spend, what is planned, Undo and Apply.
--
--   local tt = talentTree(parent)
--   tt:SetSpecs(list, viewing)  -- { { label, name, active, locked } } or nil
--                               -- (one spec: no row); viewing: an index
--   tt:SetData({ name, available, pending, editable, hint, rows (7),
--       trees = { { name, points, more, nodes = { node }, links = { link } } } })
--     more: a line under the tree ("2 more talents in a future update")
--     0.17: head = { name, class, line }: someone else's talents read only:
--       their class diamond, the name in its class colour, the line (Level 30
--       Shaman), the points per tree by name and a "Read only" badge;
--       readOnly = true: no points to spend, Undo or Apply; back = "label":
--       a button at the foot's right (tt.onBack())
--     0.17 (talent builds): actions = { primary = { label, enabled, onClick },
--       secondary = { … } } in place of Apply and Undo; status = text and
--       statusColor = token in place of the planned points' line; unspent =
--       text in place of "N points to spend"
--   tt.noSummary = true   -- no summary line (a page with its own head)
--   tt.fillPanels = true  -- the trees' panels down to the foot (a taller page)
--     node = { row, col, rank, pending, max, icon, locked, canSpend, ... }
--       0.17: next = true: the build's next talent (a fel ring and a Next tag)
--     link = { from = node, to = node, met }
--   tt.onClick(node) / onRemove(node) / onEnter(button, node) / onLeave()
--   tt.onApply() / onUndo() / onSpec(i) / onActivate()
--
-- 0.17, talent builds (design board "Talent builds", B and F):
--   tt:SetBuilds({ options, value, onChange, foot, diamond, badge, buttons })
--     the build picker in the summary's place: a Select of `options` (its
--     search always shown; `foot` its links), the class `diamond` token left
--     of it, a `badge` ("Active") after it, `buttons` ({ label, variant,
--     onClick, disabled, reason }) at the row's right; nil: the summary
--   tt:SetOrder(lines)     -- the order panel right of the trees (nil: none);
--     lines = { { levels = "10–14", name, ranks = "1–5", icon, state =
--     "learned"|"next"|nil, node } }; hovering one calls tt.onOrderEnter(line)
--     and tt.onOrderLeave(); dragging one calls tt.onOrderMove(from, before)
--     (before: the index of the line it goes in front of, #lines + 1 the end)
--   tt:MarkNode(nodeID)    -- outlines one talent (the hovered line's), nil: none
--   TALENT_ORDER_W         -- the width the order panel adds to the page
--
-- A node: full or partly learned in ink; one that can take a point in arcane
-- with a glow; planned points (not applied yet) with an arcane badge; locked
-- dim on a faint edge.

import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import icon from "/UI/Icon"
import * as panel from "/UI/Panel"
import * as inputs from "/UI/Inputs"
import * as controls from "/UI/Controls"
import * as uiSelect from "/UI/Select"
import showTooltip, hideTooltip from "/UI/Tooltip"

local S = T.space

local CW, RH, OX, NS = 44, 46, 20, 32   -- column and row step, left inset, node size
local ROWS = 7
local GRAPH_W = 200
local function graphH(rows: number): number return rows * RH - (RH - NS) end
local GRAPH_H = graphH(ROWS)
local PAD = S["space-4"]
local GAP = S["space-6"]
local HEAD_H = 16
local FOOT_H = 38
local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"

-- The width the page needs: three panels and their gaps.
local PANEL_W = GRAPH_W + PAD * 2
export const TALENT_TREE_W = PANEL_W * 3 + GAP * 2
-- the order panel (talent builds): its lines and the room it adds
local ORDER_W = 220
local LINE_H, LINE_STEP = 22, 23
export const TALENT_ORDER_W = ORDER_W + GAP
local PICKER_H = 30

local function hex(token: string): string return T.color[token].hex end
local live: { [any]: boolean } = setmetatable({}, { __mode = "k" }) -- built trees, drawn again on a theme change

--------------------------------------------------------------------------------
-- A node
--------------------------------------------------------------------------------

local function drawNode(b: any)
    local d = b.data
    if not d then return end
    local total = (d.rank or 0) + (d.pending or 0)
    local full = total >= (d.max or 1)
    local some = total > 0
    local canSpend = d.canSpend and not full and not d.locked
    local border
    if (d.pending or 0) > 0 then border = "arcane"
    elseif canSpend then border = "arcane"
    elseif d.locked then border = "gilt-faint"
    elseif some then border = "ink"
    else border = "gilt-hairline" end
    if (b.hover or b.marked) and not d.locked then border = "gilt" end
    if b.marked then border = "gilt" end
    b.icon:SetState((d.locked or not some) and "dim" or "rest")
    b.icon:SetBorder(border)
    b.icon:SetGlow(b.marked and "glow-ward" or (canSpend and "glow-arcane" or nil))
    -- the build's next talent: a fel ring and a Next tag above it
    if d.next and not b.ring then
        b.ring = CreateFrame("Frame", nil, b)
        b.ring:SetPoint("TOPLEFT", -4, 4)
        b.ring:SetPoint("BOTTOMRIGHT", 4, -4)
        b.ring:SetFrameLevel(b:GetFrameLevel() + 2)
        draw.border(b.ring, "fel", { width = 2 })
        b.tag = CreateFrame("Frame", nil, b)
        b.tag:SetFrameLevel(b:GetFrameLevel() + 5)
        b.tag:SetHeight(12)
        b.tag:SetPoint("BOTTOMLEFT", b, "TOPLEFT", -4, 5)
        draw.fill(b.tag, "fel"):SetAllPoints()
        b.tag.text = text(b.tag, "micro", "on-signal")
        b.tag.text:SetPoint("CENTER", 0, 0)
        b.tag.text:SetValue("Next")
    end
    if b.ring then
        b.ring:SetShown(d.next and true or false)
        b.tag:SetShown(d.next and true or false)
        b.tag:SetWidth(math.ceil(b.tag.text:GetUnboundedStringWidth()) + 8)
    end
    local badge = b.badge
    badge.text:SetValue(total .. "/" .. (d.max or 1))
    badge:SetWidth(math.ceil(badge.text:GetUnboundedStringWidth()) + 6)
    if (d.pending or 0) > 0 then
        draw.paintFill(badge.bg, "arcane")
        badge.edge:SetColor("arcane")
        badge.text:SetColor("on-signal")
    else
        draw.paintFill(badge.bg, "surface")
        badge.edge:SetColor(canSpend and "arcane" or "gilt-line")
        badge.text:SetColor(canSpend and "arcane" or (some and "ink" or "ink-muted"))
    end
end

local function makeNode(tt: any, graph: any): any
    local b = CreateFrame("Button", nil, graph)
    b:SetSize(NS, NS)
    b:RegisterForClicks("LeftButtonUp", "RightButtonUp")
    b.icon = icon(b, NS)
    b.icon:SetAllPoints()
    b.badge = CreateFrame("Frame", nil, b)
    b.badge:SetFrameLevel(b:GetFrameLevel() + 3)
    b.badge:SetHeight(12)
    b.badge:SetPoint("BOTTOMRIGHT", b, "BOTTOMRIGHT", 6, -6)
    b.badge.bg = b.badge:CreateTexture(nil, "BACKGROUND")
    b.badge.bg:SetAllPoints()
    b.badge.edge = draw.border(b.badge, "gilt-line")
    b.badge.text = text(b.badge, "micro", "ink-muted")
    b.badge.text:SetPoint("CENTER", 0, 0)
    b:SetScript("OnClick", function(self, button)
        if not self.data then return end
        if button == "RightButton" then
            if tt.onRemove then tt.onRemove(self.data) end
        elseif tt.onClick then
            tt.onClick(self.data)
        end
    end)
    b:SetScript("OnEnter", function(self)
        self.hover = true
        drawNode(self)
        if tt.onEnter and self.data then tt.onEnter(self, self.data) end
    end)
    b:SetScript("OnLeave", function(self)
        self.hover = false
        drawNode(self)
        if tt.onLeave then tt.onLeave() end
    end)
    return b
end

--------------------------------------------------------------------------------
-- A tree panel
--------------------------------------------------------------------------------

local function makePanel(tt: any): any
    local p = CreateFrame("Frame", nil, tt.treesRow)
    draw.fill(p, "surface-sunk"):SetAllPoints()
    draw.border(p, "gilt-faint")
    p.name = text(p, "header", "gilt-text")
    p.name:SetPoint("TOPLEFT", PAD, -PAD)
    p.points = text(p, "numeric", "ink")
    p.points:SetPoint("TOPRIGHT", -PAD, -PAD)
    p.graph = CreateFrame("Frame", nil, p)
    p.graph:SetSize(GRAPH_W, GRAPH_H)
    p.graph:SetPoint("TOP", p, "TOP", 0, -(PAD + HEAD_H + PAD))
    p.more = text(p, "caption", "ink-muted")
    p.more:SetPoint("BOTTOM", p, "BOTTOM", 0, PAD)
    p.nodes, p.lines, p.heads = {}, {}, {}
    return p
end

-- A prerequisite arrow from one node to another (down, or sideways in a row).
local function drawLink(p: any, i: number, l: any)
    local line = p.lines[i]
    if not line then
        line = p.graph:CreateLine(nil, "ARTWORK")
        line:SetThickness(2)
        p.lines[i] = line
        local head = p.graph:CreateTexture(nil, "ARTWORK", nil, 1)
        head:SetSize(8, 8)
        p.heads[i] = head
    end
    local head = p.heads[i]
    local a, b = l.from, l.to
    local x1, y1, x2, y2
    local glyph
    if a.row == b.row then
        local right = b.col > a.col
        x1 = a.col * CW + OX + (right and NS or 0)
        x2 = b.col * CW + OX + (right and -1 or NS + 1)
        y1, y2 = a.row * RH + NS / 2, a.row * RH + NS / 2
        glyph = right and "chevronRight" or "chevronLeft"
    else
        x1 = a.col * CW + OX + NS / 2
        x2 = b.col * CW + OX + NS / 2
        y1 = a.row * RH + NS
        y2 = b.row * RH - 1
        glyph = "chevronDown"
    end
    local token = l.met and "ink-muted" or "gilt-line"
    draw.paintFill(line, token)
    line:SetStartPoint("TOPLEFT", p.graph, x1, -y1)
    line:SetEndPoint("TOPLEFT", p.graph, x2, -y2)
    line:Show()
    head:SetTexture(GLYPHS .. glyph .. ".tga")
    draw.paint(head, token)
    head:ClearAllPoints()
    head:SetPoint("CENTER", p.graph, "TOPLEFT", x2, -y2 + (glyph == "chevronDown" and 3 or 0))
    head:Show()
end

local function fillPanel(tt: any, p: any, t: any)
    p.more:SetValue(t.more or "")
    p.more:SetShown(t.more ~= nil)
    p.name:SetValue(t.name or "")
    p.points:SetValue(tostring(t.points or 0))
    local nodes = t.nodes or {}
    for i, d in ipairs(nodes) do
        local b = p.nodes[i] or makeNode(tt, p.graph)
        p.nodes[i] = b
        b.data = d
        b:ClearAllPoints()
        b:SetPoint("TOPLEFT", p.graph, "TOPLEFT", d.col * CW + OX, -(d.row * RH))
        b.icon:SetArt(d.icon or 134400)
        drawNode(b)
        b:Show()
    end
    for i = #nodes + 1, #p.nodes do p.nodes[i]:Hide(); p.nodes[i].data = nil end
    local links = t.links or {}
    for i, l in ipairs(links) do drawLink(p, i, l) end
    for i = #links + 1, #p.lines do p.lines[i]:Hide(); p.heads[i]:Hide() end
end

--------------------------------------------------------------------------------
-- The order panel (talent builds, design F): one line per run of a talent's
-- ranks, in the build's order; a line drags to another place
--------------------------------------------------------------------------------

-- How far the cursor is below the top of `frame`, in its own scale.
local function cursorBelow(frame: any): number?
    local top = frame:GetTop()
    if not top then return nil end
    local _, y = GetCursorPosition()
    return top - y / frame:GetEffectiveScale()
end

local function smallTag(parent: any, label: string): any
    local tag = CreateFrame("Frame", nil, parent)
    tag:SetHeight(12)
    draw.fill(tag, "fel"):SetAllPoints()
    tag.text = text(tag, "micro", "on-signal")
    tag.text:SetPoint("CENTER", 0, 0)
    tag.text:SetValue(label)
    return tag
end

local function drawLine(l: any)
    local d = l.data
    local on = l.hover or l.dragged
    l.hoverFill:SetShown(on and true or false)
    l.edge:SetShown(on and true or false)
    local learned = d.state == "learned"
    l.levels:SetColor(learned and "ink-faint" or "ink-muted")
    l.name:SetColor(learned and "ink-muted" or "ink")
    l.icon:SetDesaturated(learned)
    l.icon:SetAlpha(learned and 0.6 or 1)
    l.tag:SetShown(d.state == "next")
    l.tag:SetWidth(math.ceil(l.tag.text:GetUnboundedStringWidth()) + 8)
    l:SetAlpha(l.dragged and 0.4 or 1)
end

local function makeLine(tt: any, o: any): any
    local l = CreateFrame("Button", nil, o.scroll.child)
    l:SetHeight(LINE_H)
    l.hoverFill = draw.fill(l, "surface-raised")
    l.hoverFill:SetAllPoints()
    l.hoverFill:Hide()
    l.edge = draw.border(l, "arcane")
    l.edge:SetShown(false)
    l.levels = text(l, "micro", "ink-muted")
    l.levels:SetPoint("LEFT", S["space-3"], 0)
    l.icon = l:CreateTexture(nil, "ARTWORK")
    l.icon:SetSize(16, 16)
    l.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
    l.icon:SetPoint("LEFT", S["space-3"] + 40, 0)
    l.tag = smallTag(l, "Next")
    l.tag:SetPoint("RIGHT", -S["space-3"], 0)
    l.name = text(l, "caption", "ink")
    l.name:SetPoint("LEFT", l.icon, "RIGHT", S["space-3"], 0)
    l.name:SetPoint("RIGHT", l.tag, "LEFT", -S["space-2"], 0)
    l.name:SetJustifyH("LEFT")
    l.name:SetWordWrap(false)
    l:SetScript("OnEnter", function(self)
        self.hover = true
        drawLine(self)
        if not o.dragging and tt.onOrderEnter then tt.onOrderEnter(self.data, self) end
    end)
    l:SetScript("OnLeave", function(self)
        self.hover = false
        drawLine(self)
        if not o.dragging and tt.onOrderLeave then tt.onOrderLeave(self.data) end
    end)
    l:SetScript("OnMouseDown", function(self, button)
        if button ~= "LeftButton" then return end
        o.press = { index = self.index, y = cursorBelow(o.scroll.child) or 0, line = self }
    end)
    l:SetScript("OnMouseUp", function() o.finish() end)
    return l
end

local function makeOrder(tt: any): any
    local o = CreateFrame("Frame", nil, tt)
    draw.fill(o, "surface-sunk"):SetAllPoints()
    draw.border(o, "gilt-faint")
    o.title = text(o, "header", "gilt-text")
    o.title:SetPoint("TOPLEFT", PAD, -PAD)
    o.title:SetValue("Order")
    o.count = text(o, "numeric", "ink")
    o.count:SetPoint("TOPRIGHT", -PAD, -PAD)
    o.scroll = panel.scrollArea(o, 2)
    o.scroll:SetPoint("TOPLEFT", o, "TOPLEFT", S["space-2"], -(PAD + HEAD_H + PAD))
    o.scroll:SetPoint("BOTTOMRIGHT", o, "BOTTOMRIGHT", -(S["space-2"] + 6), PAD)
    o.scroll:HookScript("OnSizeChanged", function(sc, w) sc.child:SetWidth(w) end)
    o.empty = text(o.scroll.child, "caption", "ink-muted")
    o.empty:SetPoint("TOPLEFT", S["space-3"], -S["space-2"])
    o.empty:SetPoint("RIGHT", -S["space-3"], 0)
    o.empty:SetJustifyH("LEFT")
    o.empty:SetWordWrap(true)
    o.empty:SetValue("Click talents in the order you'll learn them.")
    o.lines = {}
    -- where a dragged line lands: an arcane rule between two lines
    o.drop = o.scroll.child:CreateTexture(nil, "OVERLAY")
    draw.paintFill(o.drop, "arcane")
    o.drop:SetHeight(2)
    o.drop:Hide()
    -- the dragged line, lifted onto a plate under the cursor
    o.plate = CreateFrame("Frame", nil, o.scroll.child)
    o.plate:SetHeight(LINE_H)
    o.plate:SetFrameLevel(o.scroll.child:GetFrameLevel() + 10)
    draw.fill(o.plate, "surface-raised"):SetAllPoints()
    draw.border(o.plate, "arcane")
    o.plate.icon = o.plate:CreateTexture(nil, "ARTWORK")
    o.plate.icon:SetSize(16, 16)
    o.plate.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
    o.plate.icon:SetPoint("LEFT", S["space-3"] + 40, 0)
    o.plate.name = text(o.plate, "caption", "ink")
    o.plate.name:SetPoint("LEFT", o.plate.icon, "RIGHT", S["space-3"], 0)
    o.plate:Hide()

    local function slot()
        local y = cursorBelow(o.scroll.child) or 0
        local n = #(tt.orderLines or {})
        return math.max(0, math.min(n, math.floor((y + LINE_STEP / 2) / LINE_STEP))), y
    end
    function o.finish()
        local press, dragging = o.press, o.dragging
        o.press, o.dragging = nil, nil
        o.drop:Hide()
        o.plate:Hide()
        if press and press.line then press.line.dragged = false; drawLine(press.line) end
        if not (press and dragging) then return end
        local before = slot() + 1
        if before ~= press.index and before ~= press.index + 1 and tt.onOrderMove then
            tt.onOrderMove(press.index, before)
        end
    end
    o:SetScript("OnUpdate", function()
        local press = o.press
        if not press then return end
        if not IsMouseButtonDown("LeftButton") then o.finish() return end
        local s, y = slot()
        if not o.dragging then
            if math.abs(y - press.y) < 4 then return end
            o.dragging = true
            press.line.dragged = true
            drawLine(press.line)
            o.plate:SetWidth(press.line:GetWidth())
            o.plate.icon:SetTexture(press.line.data.icon or 134400)
            o.plate.name:SetValue(press.line.name:GetText() or "")
            o.plate:Show()
            if tt.onOrderLeave then tt.onOrderLeave(press.line.data) end
        end
        o.plate:ClearAllPoints()
        o.plate:SetPoint("TOPLEFT", o.scroll.child, "TOPLEFT", 0, -(y - LINE_H / 2))
        o.drop:ClearAllPoints()
        o.drop:SetPoint("TOPLEFT", o.scroll.child, "TOPLEFT", 0, -(s * LINE_STEP) + 1)
        o.drop:SetPoint("RIGHT", o.scroll.child, "RIGHT", 0, 0)
        o.drop:Show()
        -- near an edge the list scrolls along
        local sc = o.scroll
        local at = cursorBelow(sc)
        local max = math.max(0, sc.child:GetHeight() - sc:GetHeight())
        if at and at < 14 then
            sc:SetVerticalScroll(math.max(0, sc:GetVerticalScroll() - 4))
        elseif at and at > sc:GetHeight() - 14 then
            sc:SetVerticalScroll(math.min(max, sc:GetVerticalScroll() + 4))
        end
    end)
    return o
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

export class TalentTree extends Frame
    panels: any
    specRow: Frame
    activeBadge: any
    activate: any
    summary: Frame
    summaryName: Text
    summaryPoints: Text
    summaryDiamond: Texture
    summaryLine: Text
    summaryBadge: any
    treesRow: Frame
    foot: Frame
    apply: any
    undo: any
    back: any
    unspent: Text
    status: Text
    orderLines: any? = nil
    specList: any? = nil
    segmented: any? = nil
    segmentedFor: any? = nil
    builds: any? = nil
    picker: any? = nil
    pickerBadge: any? = nil
    pickerButtons: any? = nil
    data: any? = nil
    headShown: any? = nil

    constructor(parent: any)
        super(nil, parent)
        self.panels = {}
        -- the specs (two talent groups only)
        self.specRow = CreateFrame("Frame", nil, self)
        self.specRow:SetHeight(30)
        self.activeBadge = controls.stateBadge(self.specRow, "neutral", "Active")
        self.activate = controls.button(self.specRow, { text = "Activate", variant = "quiet",
            onClick = function() if self.onActivate then self.onActivate() end end })
        self.activeBadge:SetPoint("RIGHT", self.specRow, "RIGHT", 0, 0)
        self.activate:SetPoint("RIGHT", self.specRow, "RIGHT", 0, 0)
        self.specRow:Hide()
        -- the summary
        self.summary = CreateFrame("Frame", nil, self)
        self.summary:SetSize(1, T.type.label.lineHeight)
        self.summaryName = text(self.summary, "label", "ink")
        self.summaryName:SetPoint("LEFT")
        self.summaryPoints = text(self.summary, "caption", "ink-muted")
        self.summaryPoints:SetPoint("LEFT", self.summaryName, "RIGHT", S["space-5"], 0)
        -- someone else's (0.17): the class diamond, the line, Read only
        self.summaryDiamond = draw.diamond(self.summary, 7, "ink", "OVERLAY")
        self.summaryDiamond:SetPoint("CENTER", self.summary, "LEFT", 4, 0)
        self.summaryDiamond:Hide()
        self.summaryLine = text(self.summary, "caption", "ink-muted")
        self.summaryLine:SetPoint("LEFT", self.summaryName, "RIGHT", S["space-4"], -1)
        self.summaryLine:Hide()
        self.summaryBadge = controls.stateBadge(self.summary, "neutral", "Read only")
        self.summaryBadge:SetPoint("RIGHT")
        self.summaryBadge:Hide()
        -- the trees
        self.treesRow = CreateFrame("Frame", nil, self)
        -- the foot: a faint rule, the points, the status, Undo and Apply
        self.foot = CreateFrame("Frame", nil, self)
        self.foot:SetPoint("BOTTOMLEFT")
        self.foot:SetPoint("BOTTOMRIGHT")
        self.foot:SetHeight(FOOT_H)
        local rule = draw.fill(self.foot, "gilt-faint", "ARTWORK")
        rule:SetHeight(1)
        rule:SetPoint("TOPLEFT")
        rule:SetPoint("TOPRIGHT")
        self.apply = controls.button(self.foot, { text = "Apply", variant = "primary", onClick = function()
            local a = self.data and self.data.actions
            if a and a.primary then a.primary.onClick() elseif self.onApply then self.onApply() end
        end })
        self.apply:SetPoint("BOTTOMRIGHT", self.foot, "BOTTOMRIGHT", 0, 0)
        self.undo = controls.button(self.foot, { text = "Undo", variant = "quiet", onClick = function()
            local a = self.data and self.data.actions
            if a and a.secondary then a.secondary.onClick() elseif self.onUndo then self.onUndo() end
        end })
        self.undo:SetPoint("RIGHT", self.apply, "LEFT", -S["space-3"], 0)
        self.back = controls.button(self.foot, { text = "Back", icon = "chevronLeft",
            onClick = function() if self.onBack then self.onBack() end end })
        self.back:SetPoint("BOTTOMRIGHT", self.foot, "BOTTOMRIGHT", 0, 0)
        self.back:Hide()
        self.unspent = text(self.foot, "caption", "ink-muted")
        self.unspent:SetPoint("LEFT", self.foot, "BOTTOMLEFT", 0, 15)
        self.status = text(self.foot, "caption", "ink-muted")
        self.status:SetPoint("LEFT", self.unspent, "RIGHT", S["space-5"], 0)
        self.status:SetPoint("RIGHT", self.undo, "LEFT", -S["space-5"], 0)
        self.status:SetJustifyH("LEFT")
        self:Layout()
        self:SetData({})
        live[self] = true
    end

    function SetOrder(lines: any[]?)
        self.orderLines = lines
        if lines and not self.order then self.order = makeOrder(self) end
        local o = self.order
        if o then
            o:SetShown(lines ~= nil)
            if lines then
                o.empty:SetShown(#lines == 0)
                local steps = 0
                for i, d in ipairs(lines) do
                    local l = o.lines[i] or makeLine(self, o)
                    o.lines[i] = l
                    l.data, l.index = d, i
                    l:ClearAllPoints()
                    l:SetPoint("TOPLEFT", o.scroll.child, "TOPLEFT", 0, -(i - 1) * LINE_STEP)
                    l:SetPoint("RIGHT", o.scroll.child, "RIGHT", 0, 0)
                    l.levels:SetValue(d.levels or "")
                    l.icon:SetTexture(d.icon or 134400)
                    local ranks = d.ranks and d.ranks ~= "" and (" |cff" .. hex("ink-muted") .. d.ranks .. "|r") or ""
                    l.name:SetValue((d.name or "") .. ranks)
                    drawLine(l)
                    l:Show()
                    steps = steps + (d.count or 1)
                end
                for i = #lines + 1, #o.lines do o.lines[i]:Hide(); o.lines[i].data = nil end
                o.scroll.child:SetHeight(math.max(1, #lines * LINE_STEP))
                o.count:SetValue(tostring(steps))
            end
        end
        self:Layout()
    end

    function MarkNode(nodeID: any)
        for _, p in ipairs(self.panels) do
            for _, b in ipairs(p.nodes) do
                local marked = nodeID ~= nil and b.data ~= nil and b.data.id == nodeID
                if (b.marked or false) ~= marked then
                    b.marked = marked
                    drawNode(b)
                end
            end
        end
    end

    function SetSpecs(list: any, viewing: number?)
        self.specList = list
        local show = list and #list > 1
        self.specRow:SetShown(show and true or false)
        if show then
            if not self.segmented or self.segmentedFor ~= #list then
                if self.segmented then self.segmented:Hide() end
                local options = {}
                for i, s in ipairs(list) do
                    options[i] = { value = i, label = s.label .. (s.name and s.name ~= "" and (": " .. s.name) or ""), disabled = s.locked }
                end
                self.segmented = inputs.segmented(self.specRow, {
                    options = options,
                    onChange = function(v: any) if self.onSpec then self.onSpec(v) end end,
                })
                self.segmented:SetPoint("LEFT")
                self.segmentedFor = #list
            end
            self.segmented:SetValue(viewing or 1)
            local spec = list[viewing or 1] or {}
            self.activeBadge:SetShown(spec.active and true or false)
            self.activate:SetShown(not spec.active)
            if not spec.active then self.activate:SetLabel("Activate " .. (spec.name ~= "" and spec.name or spec.label or "")) end
        end
        self:Layout()
    end

    -- The build picker in the summary's place (nil: the summary as before).
    function SetBuilds(b: any)
        self.builds = b
        if b and not self.picker then
            self.picker = uiSelect.select(self.summary, { width = 280, search = "always", maxRows = 12, minListWidth = 300,
                onChange = function(v: any) if self.builds and self.builds.onChange then self.builds.onChange(v) end end })
            self.pickerBadge = controls.stateBadge(self.summary, "neutral", "Active")
            self.pickerButtons = {}
        end
        if self.picker then
            self.picker:SetShown(b ~= nil)
            self.pickerBadge:SetShown(b ~= nil and b.badge ~= nil)
            if b then
                self.picker.foot = b.foot
                self.picker:SetOptions(b.options or {})
                self.picker:SetValue(b.value)
                if b.badge then self.pickerBadge:SetState("neutral", b.badge) end
                self.picker:ClearAllPoints()
                if b.diamond and T.color[b.diamond] then
                    self.summaryDiamond:Show()
                    draw.paint(self.summaryDiamond, b.diamond)
                    self.picker:SetPoint("LEFT", self.summary, "LEFT", 14, 0)
                else
                    self.summaryDiamond:Hide()
                    self.picker:SetPoint("LEFT", self.summary, "LEFT", 0, 0)
                end
                self.pickerBadge:ClearAllPoints()
                self.pickerBadge:SetPoint("LEFT", self.picker, "RIGHT", S["space-4"], 0)
            end
            -- the row's buttons, right to left
            local last
            for i, def in ipairs(b and b.buttons or {}) do
                local btn = self.pickerButtons[i]
                if not btn then
                    btn = controls.button(self.summary, { text = def.label, variant = def.variant or "quiet",
                        onClick = function(x) if x.def and x.def.onClick and not x.def.disabled then x.def.onClick() end end })
                    btn:HookScript("OnEnter", function(x)
                        if x.def and x.def.reason then showTooltip(x, { title = x.def.label, description = x.def.reason }) end
                    end)
                    btn:HookScript("OnLeave", function() hideTooltip() end)
                    self.pickerButtons[i] = btn
                end
                btn.def = def
                btn:SetLabel(def.label)
                btn:SetEnabledState(not def.disabled)
                btn:ClearAllPoints()
                if last then btn:SetPoint("RIGHT", last, "LEFT", -S["space-3"], 0)
                else btn:SetPoint("RIGHT", self.summary, "RIGHT", 0, 0) end
                btn:Show()
                last = btn
            end
            for i = #(b and b.buttons or {}) + 1, #self.pickerButtons do self.pickerButtons[i]:Hide() end
        end
        self:Layout()
    end

    function Layout()
        local top = 0
        if self.specRow:IsShown() then
            self.specRow:ClearAllPoints()
            self.specRow:SetPoint("TOPLEFT", self, "TOPLEFT", 0, 0)
            self.specRow:SetPoint("TOPRIGHT", self, "TOPRIGHT", 0, 0)
            top = top + 30 + S["space-5"]
        end
        self.summary:ClearAllPoints()
        self.summary:SetPoint("TOPLEFT", self, "TOPLEFT", 0, -top)
        self.summary:SetPoint("RIGHT", self, "RIGHT", 0, 0)
        self.summary:SetShown(not self.noSummary)
        local sh = self.headShown and T.type["unit-name-lg"].lineHeight or T.type.label.lineHeight
        if self.builds then sh = PICKER_H end
        self.summary:SetHeight(sh)
        if not self.noSummary then top = top + sh + S["space-5"] end
        local order = self.order and self.order:IsShown()
        self.treesRow:ClearAllPoints()
        self.treesRow:SetPoint("TOPLEFT", self, "TOPLEFT", 0, -top)
        self.treesRow:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", order and -TALENT_ORDER_W or 0, FOOT_H + S["space-5"])
        if order then
            self.order:ClearAllPoints()
            self.order:SetPoint("TOPRIGHT", self, "TOPRIGHT", 0, -top)
            self.order:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", 0, FOOT_H + S["space-5"])
            self.order:SetWidth(ORDER_W)
        end
    end

    function SetData(data: any)
        local d = data or {}
        self.data = d
        local trees = d.trees or {}
        -- the summary: the spec, the points per tree
        local per, total = {}, 0
        for i, t in ipairs(trees) do per[i] = tostring(t.points or 0); total = total + (t.points or 0) end
        local head = d.head
        if (head ~= nil) ~= (self.headShown or false) then
            self.headShown = head ~= nil
            self:Layout()
        end
        local builds = self.builds ~= nil and not head
        self.summaryDiamond:SetShown(head ~= nil or (builds and self.builds.diamond ~= nil))
        self.summaryBadge:SetShown(head ~= nil)
        self.summaryLine:SetShown(head ~= nil)
        self.summaryName:ClearAllPoints()
        if head then
            -- someone else's: who, and the points per tree by name
            local token = head.class and "class-" .. head.class:lower()
            if not (token and T.color[token]) then token = nil end
            if token then draw.paint(self.summaryDiamond, token) else self.summaryDiamond:SetVertexColor(1, 1, 1, 1) end
            self.summaryName:SetStyle("unit-name-lg")
            self.summaryName:SetPoint("LEFT", self.summaryDiamond, "RIGHT", S["space-4"], 0)
            self.summaryName:SetColor(token or "ink")
            self.summaryName:SetValue(head.name or "")
            self.summaryLine:SetValue(head.line or "")
            local named = {}
            for i, t in ipairs(trees) do named[i] = ("%s |cff%s%d|r"):format(t.name or "", hex("ink"), t.points or 0) end
            self.summaryPoints:SetValue(table.concat(named, "   "))
        else
            self.summaryName:SetStyle("label")
            self.summaryName:SetColor("ink")
            self.summaryName:SetPoint("LEFT")
            self.summaryName:SetValue(builds and "" or (d.name or ""))
            self.summaryPoints:SetValue(#per > 0 and (table.concat(per, " / ") .. " · " .. total .. (d.spentLabel or " spent")) or "")
        end
        self.summaryPoints:ClearAllPoints()
        local after = head and self.summaryLine or self.summaryName
        if builds then after = self.builds.badge and self.pickerBadge or self.picker end
        self.summaryPoints:SetPoint("LEFT", after, "RIGHT", S["space-5"], 0)
        -- the trees, side by side, as wide as the row allows
        local width = self.treesRow:GetWidth()
        if not width or width <= 0 then width = TALENT_TREE_W end
        local n = math.max(1, #trees)
        local panelW = math.max(PANEL_W, math.floor((width - GAP * (n - 1)) / n))
        local rows = d.rows or ROWS
        local anyMore = false
        for _, t in ipairs(trees) do if t.more then anyMore = true end end
        for i, t in ipairs(trees) do
            local p = self.panels[i] or makePanel(self)
            self.panels[i] = p
            p:ClearAllPoints()
            p:SetPoint("TOPLEFT", self.treesRow, "TOPLEFT", (i - 1) * (panelW + GAP), 0)
            p.graph:SetHeight(graphH(rows))
            local h = PAD + HEAD_H + PAD + graphH(rows) + PAD + (anyMore and (S["space-3"] + T.type.caption.lineHeight) or 0)
            if self.fillPanels then
                local room = self.treesRow:GetHeight()
                if room and room > h then h = room end
            end
            p:SetSize(panelW, h)
            fillPanel(self, p, t)
            p:Show()
        end
        for i = #trees + 1, #self.panels do self.panels[i]:Hide() end
        -- the foot
        local available = d.available or 0
        local ro = d.readOnly
        self.unspent:SetShown(not ro)
        self.apply:SetShown(not ro)
        self.undo:SetShown(not ro)
        self.back:SetShown(d.back ~= nil)
        if d.back then self.back:SetLabel(d.back) end
        self.status:ClearAllPoints()
        if ro then
            self.status:SetPoint("LEFT", self.foot, "BOTTOMLEFT", 0, 15)
        else
            self.status:SetPoint("LEFT", self.unspent, "RIGHT", S["space-5"], 0)
        end
        self.status:SetPoint("RIGHT", d.back and self.back or (ro and self.foot or self.undo), d.back and "LEFT" or (ro and "RIGHT" or "LEFT"), -S["space-5"], 0)
        self.unspent:SetText(d.unspent or ("|cff%s%d|r %s"):format(hex("ink"), available, available == 1 and "point to spend" or "points to spend"))
        local pending = d.pending or 0
        if d.status then
            self.status:SetColor(d.statusColor or "ink-muted")
            self.status:SetValue(d.status)
        elseif pending > 0 then
            self.status:SetColor("arcane")
            self.status:SetValue(pending .. (pending == 1 and " point" or " points") .. " not applied yet · right-click to take one back")
        else
            self.status:SetColor("ink-muted")
            self.status:SetValue(d.hint or "Click a talent to plan a point. Nothing changes until you apply.")
        end
        -- a build's plan has its own two (Discard, Save build)
        local a = d.actions
        self.undo:SetLabel(a and a.secondary and a.secondary.label or "Undo")
        self.apply:SetLabel(a and a.primary and a.primary.label or "Apply")
        if a then
            self.undo:SetShown(a.secondary ~= nil and not ro)
            self.apply:SetShown(a.primary ~= nil and not ro)
            self.undo:SetEnabledState(a.secondary ~= nil and a.secondary.enabled ~= false)
            self.apply:SetEnabledState(a.primary ~= nil and a.primary.enabled ~= false)
        else
            self.undo:SetEnabledState(pending > 0)
            self.apply:SetEnabledState(pending > 0 and d.editable ~= false)
        end
    end
end

export function talentTree(parent: any): TalentTree
    return TalentTree.new(parent)
end

-- A theme can change the colours in the summary and the foot, and the
-- caption style the panels are measured in.
events.on("SUUUI_THEME_CHANGED", function()
    for f in pairs(live) do
        f:Layout()
        f:SetData(f.data)
        if f.orderLines then f:SetOrder(f.orderLines) end
    end
end, "UI.TalentTree")

--------------------------------------------------------------------------------
-- A talent's tooltip: the game's own, as Blizzard's talent buttons build it
--------------------------------------------------------------------------------
--   traitTooltip(owner, configID, nodeID, {
--       name, treeName,      -- the title; the tree, for the game's "spend N
--                            -- more points in the X tree" lines
--       conditions,          -- the node's condition IDs
--       canSpend, pending,   -- a click plans a point; planned ranks
--       needs = { text },    -- more red lines (a talent above it)
--       blocked = text,      -- why nothing can change now
--   })
-- The title, "Rank 2/5", the talent's text at this rank and the next, what a
-- click does, what it still needs.

local function plainValue(v: any): boolean return v ~= nil and not (issecretvalue and issecretvalue(v)) end

export function traitTooltip(owner: any, configID: number, nodeID: number, opts: { [string]: any }?)
    local o: { [string]: any } = opts or {}
    local ok, ni = pcall(C_Traits.GetNodeInfo, configID, nodeID)
    if not ok or not ni then return end
    local tip = GameTooltip
    tip:SetOwner(owner, "ANCHOR_RIGHT")
    GameTooltip_SetTitle(tip, o.name or "")
    local current = plainValue(ni.currentRank) and ni.currentRank or 0
    local max = plainValue(ni.maxRanks) and ni.maxRanks or 1
    GameTooltip_AddHighlightLine(tip, (TALENT_BUTTON_TOOLTIP_RANK_FORMAT or "Rank %s/%s"):format(current, max))
    local increased = plainValue(ni.ranksIncreased) and ni.ranksIncreased or 0
    if ni.activeEntry and ni.activeEntry.entryID then
        GameTooltip_AddBlankLineToTooltip(tip)
        tip:AppendInfo("GetTraitEntry", ni.activeEntry.entryID, (ni.activeEntry.rank or 0) + increased)
    end
    if ni.nextEntry and ni.nextEntry.entryID and (ni.ranksPurchased or 0) > 0 then
        GameTooltip_AddBlankLineToTooltip(tip)
        GameTooltip_AddHighlightLine(tip, TALENT_BUTTON_TOOLTIP_NEXT_RANK or "Next Rank:")
        tip:AppendInfo("GetTraitEntry", ni.nextEntry.entryID, (ni.nextEntry.rank or 0) + increased)
    end
    if o.canSpend then
        GameTooltip_AddBlankLineToTooltip(tip)
        GameTooltip_AddInstructionLine(tip, TALENT_BUTTON_TOOLTIP_PURCHASE_INSTRUCTIONS or "Click to learn")
    elseif (o.pending or 0) > 0 then
        GameTooltip_AddBlankLineToTooltip(tip)
        GameTooltip_AddDisabledLine(tip, "Right-click to take a planned point back")
    end
    local spacer = true
    local function need(line: string, isError: boolean?)
        if spacer then GameTooltip_AddBlankLineToTooltip(tip); spacer = false end
        if isError then GameTooltip_AddErrorLine(tip, line) else GameTooltip_AddHighlightLine(tip, line) end
    end
    local best: any = nil
    for _, condID in ipairs(o.conditions or {}) do
        -- (tooltipText isn't in the declared TraitCondInfo: read untyped)
        local okC, c: any = pcall(C_Traits.GetConditionInfo, configID, condID, false, o.treeName)
        if okC and c and c.isMet == false and plainValue(c.tooltipText) and c.tooltipText ~= "" then
            if not best or (c.spentAmountRequired or 0) > (best.spentAmountRequired or 0) then best = c end
        end
    end
    if best then need(best.tooltipText) end
    for _, line in ipairs(o.needs or {}) do need(line, true) end
    if o.blocked then need(o.blocked, true) end
    tip:Show()
end

