-- UI/Alert.wowlua
-- An alert (design board "Alerts and badges"): a title in the display face
-- over a detail caption, centred, between a 1px rule above and below, with a
-- 9px diamond on each end of the band.
--
--   local a = alert(parent)
--   a:SetAlert(tone, title, detail[, ...])
--
-- tone: "danger" (ember-soft ground, ember rules and glow, ember-text title),
-- "warning" (glass ground, amber rules and title) or "info" (glass ground,
-- gilt-line rules, gilt diamonds, gilt-text title). The detail is a format
-- string when arguments follow (a target's name may be secret in a dungeon):
-- they go to SetFormattedText untouched. A detail with a secret argument
-- can't be measured, so the band then takes at least `notice-w` plus space-6
-- either side, and a longer detail is cut. A plain detail may hold several
-- lines ("\n"): the band grows down, as wide as the longest (0.12).

import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import text, measureText, Text from "/UI/Text"

local S = T.space

local isSecret: (v: unknown) -> boolean = issecretvalue or function() return false end -- wowlua: coverage ignore (a client without secret values)

-- How urgent an alert is.
export type AlertTone = "danger" | "warning" | "info"
-- What a detail's format takes: a target's name may be secret in a dungeon.
export type FormatArg = string | number | Secret<string> | Secret<number>

type ToneLook = { ground: string, line: string, jewel: string, title: string, glow?: boolean }

local TONES: { danger: ToneLook, warning: ToneLook, info: ToneLook } = {
    danger = { ground = "ember-soft", line = "ember", jewel = "ember", title = "ember-text", glow = true },
    warning = { ground = "surface-glass", line = "amber", jewel = "amber", title = "amber" },
    info = { ground = "surface-glass", line = "gilt-line", jewel = "gilt", title = "gilt-text" },
}
local JEWEL = 9

-- The detail: plain text, or a format with arguments (secret ones allowed).
-- Returns the text to measure, or nil when an argument is secret.
local function plain(v: FormatArg): v is string | number return not isSecret(v) end

local function setDetail(self: Alert, detail: string?, ...: FormatArg): string?
    local n = select("#", ...)
    -- the arguments as text can be measured only when none is secret
    local readable: (string | number)[] = {}
    local secret = false
    for i = 1, n do
        local v = (select(i, ...))
        if plain(v) then readable[i] = v else secret = true end
    end
    if not detail or detail == "" then
        self.detail:SetVisible(false)
        return ""
    end
    self.detail:SetVisible(true)
    if n > 0 then
        self.detail:SetFormattedText(detail, ...)
        self.detail.value = nil
    else
        self.detail:SetValue(detail)
    end
    if secret then return nil end
    return n > 0 and detail:format(unpack(readable, 1, n)) or detail
end

local alerts: { [Alert]: boolean } = setmetatable({}, { __mode = "k" })
events.on("SUUUI_THEME_CHANGED", function()
    for a in pairs(alerts) do a:Fit() end
end, "UI.Alert")

export class Alert extends Frame
    ground: Texture
    glow: draw.SoftEdge
    rules: draw.Border
    left: Texture
    right: Texture
    title: Text
    detail: Text
    tone: AlertTone? = nil
    titleText: string = ""
    detailText: string? = nil

    constructor(parent: Frame)
        super(nil, parent)
        alerts[self] = true
        self.ground = self:CreateTexture(nil, "BACKGROUND")
        self.ground:SetAllPoints()
        self.glow = draw.shadow(self, "glow-ember")
        -- the rules above and below (a border without its sides)
        self.rules = draw.border(self, "ember")
        self.rules.left:Hide()
        self.rules.right:Hide()
        self.left = draw.diamond(self, JEWEL, "ember")
        self.left:SetPoint("CENTER", self, "LEFT", 0, 0)
        self.right = draw.diamond(self, JEWEL, "ember")
        self.right:SetPoint("CENTER", self, "RIGHT", 0, 0)
        self.title = text(self, "alert", "ember-text")
        -- the display face is small caps with no descenders: its line box
        -- centres 2px high, so it sits 2px lower
        self.title:SetPoint("TOP", 0, -S["space-4"] - 2)
        self.detail = text(self, "caption", "ink")
        self.detail:SetPoint("TOP", self.title, "BOTTOM", 0, -S["space-1"])
        self:SetAlert("danger", "")
    end

    function SetTone(tone: AlertTone)
        -- (a plugin's unknown tone: danger)
        local t = TONES[tone] or TONES.danger
        self.tone = TONES[tone] and tone or "danger"
        draw.paintFill(self.ground, t.ground)
        self.rules:SetColor(t.line)
        draw.paint(self.left, t.jewel)
        draw.paint(self.right, t.jewel)
        self.title:SetColor(t.title)
        self.glow:SetShown(t.glow and true or false)
    end

    -- The band's size from the title and the readable detail (nil: secret);
    -- again after a theme changed the text styles.
    function Fit()
        local readable: string? = self.detailText
        local detailW: number? = nil
        local lines = 1
        if readable then
            local w, n = 0, 0
            for line in (readable .. "\n"):gmatch("(.-)\n") do
                n = n + 1
                w = math.max(w, measureText("caption", line))
            end
            detailW, lines = w, n
        end
        local titleW = measureText("alert", self.titleText)
        local inner = math.max(titleW, detailW or draw.size("notice-w"))
        -- a secret detail: fixed width, cut at the band's edge; several lines:
        -- as wide as the longest, centred
        if lines > 1 then
            self.detail:SetWidth(math.ceil(detailW or 0) + 2)
            self.detail:SetWordWrap(true)
        else
            self.detail:SetWidth(detailW and 0 or inner)
            self.detail:SetWordWrap(false)
        end
        local h = S["space-4"] * 2 + T.type.alert.lineHeight
        if self.detail:IsShown() then h = h + S["space-1"] + T.type.caption.lineHeight * lines end
        self:SetSize(math.ceil(inner) + S["space-6"] * 2, h)
    end

    function SetAlert(tone: AlertTone, title: string?, detail: string?, ...: FormatArg)
        self:SetTone(tone)
        self.title:SetValue(title or "")
        self.titleText = title or ""
        self.detailText = setDetail(self, detail, ...)
        self:Fit()
    end
end

export function alert(parent: Frame): Alert
    return Alert.new(parent)
end
