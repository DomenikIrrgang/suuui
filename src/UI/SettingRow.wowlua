-- UI/SettingRow.wowlua
-- SettingRow: one setting, with what it does, its control, and a way back to
-- the default. SettingsGroup: a titled block of rows.
--
--   local row = settingRow(parent, { label, description, control = ctl, stacked = false,
--                                       onReset = fn, width = 600 })
--   row:SetModified(changed)            an ink diamond before the label, the reset arrow
--   row:SetDisabled(disabled, reason)   label to ink-muted, control dimmed, a lock and the reason
--
--   local group = settingsGroup(parent, { title, meta, description, width })
--   group:AddRow(row); group:SetMeta("2 changed")

import after from "wowlua:timer"
import tokens as T from "/Core/Tokens"
import * as draw from "./Draw"
import text, Text from "./Text"
import stack, Layout from "./Layout"
import showTooltip, hideTooltip from "./Tooltip"

local S = T.space

local RESET_ICON = "Interface\\Buttons\\UI-RefreshButton"
local LOCK_ICON = "Interface\\LFGFrame\\UI-LFG-ICON-LOCK"
local RESET_COL = 24

--------------------------------------------------------------------------------
-- SettingRow
--------------------------------------------------------------------------------

export type SettingRowOptions = {
    label?: string,
    description?: string,
    -- any control: a frame, with SetDisabled(disabled) when it has one
    control?: any,
    stacked?: boolean,
    onReset?: () -> (),
    width?: number,
}

-- the reset arrow
export interface ResetButton extends Button
    edge: draw.Border
    icon: Texture
end

export class SettingRow extends Frame
    stacked: boolean? = nil
    rule: Frame
    dot: Texture
    label: Text
    desc: Text
    why: Frame
    whyText: Text
    reset: ResetButton
    control: any? = nil
    lastWidth: number? = nil
    relayoutQueued: boolean? = nil
    descValue: string? = nil
    modified: boolean = false
    disabled: boolean? = nil

    constructor(parent: Frame, opts: SettingRowOptions)
        super(nil, parent)
        self:SetWidth(opts.width or 600)
        self.stacked = opts.stacked

        self.rule = draw.hairline(self, "gilt-faint")
        self.rule:SetPoint("TOPLEFT")
        self.rule:SetPoint("TOPRIGHT")

        self.dot = draw.diamond(self, 5, "ink")
        self.label = text(self, "label", "ink")
        self.label:SetValue(opts.label or "")
        self.desc = text(self, "caption", "ink-muted")
        self.desc:SetWordWrap(true)
        self.desc:SetJustifyH("LEFT")
        self.desc:SetValue(opts.description or "")
        self.desc:SetShown(opts.description ~= nil and opts.description ~= "")

        self.why = CreateFrame("Frame", nil, self)
        self.why:SetSize(1, 12)
        local lock = self.why:CreateTexture(nil, "ARTWORK")
        lock:SetTexture(LOCK_ICON)
        lock:SetDesaturated(true)
        draw.paint(lock, "ink-muted")
        lock:SetSize(11, 11)
        lock:SetPoint("TOPLEFT", 0, -1)
        self.whyText = text(self.why, "caption", "ink-muted")
        self.whyText:SetWordWrap(true)
        self.whyText:SetJustifyH("LEFT")
        self.whyText:SetPoint("TOPLEFT", lock, "TOPRIGHT", S["space-2"], 1)
        self.why:Hide()

        local reset: ResetButton = CreateFrame("Button", nil, self) :: any
        reset:SetSize(22, 22)
        reset:SetPoint("RIGHT", -1, 0)
        reset.edge = draw.border(reset, "gilt-line")
        reset.edge:SetShown(false)
        reset.icon = reset:CreateTexture(nil, "ARTWORK")
        reset.icon:SetTexture(RESET_ICON)
        reset.icon:SetDesaturated(true)
        draw.paint(reset.icon, "ink-muted")
        reset.icon:SetSize(14, 14)
        reset.icon:SetPoint("CENTER")
        reset:SetScript("OnEnter", function(b: ResetButton)
            b.edge:SetShown(true)
            draw.paint(b.icon, "ink")
            showTooltip(b, { title = "Reset to default" })
        end)
        reset:SetScript("OnLeave", function(b: ResetButton)
            b.edge:SetShown(false)
            draw.paint(b.icon, "ink-muted")
            hideTooltip()
        end)
        reset:SetScript("OnClick", function() if opts.onReset then opts.onReset() end end)
        self.reset = reset

        if opts.control then
            self.control = opts.control
            self.control:SetParent(self)
            self.control:HookScript("OnSizeChanged", function() self:Relayout() end)
        end
        self:SetScript("OnSizeChanged", function(_, w: number)
            if w ~= self.lastWidth then
                self.lastWidth = w
                self:Relayout()
            end
        end)
        self:SetModified(false)
    end

    -- Lays the row out now, and once more on the next frame: WoW wraps text at
    -- the next render, so a description's wrapped height is only right then.
    function Relayout()
        self:Arrange()
        if not self.relayoutQueued then
            self.relayoutQueued = true
            after(0, function()
                self.relayoutQueued = false
                self:Arrange()
            end)
        end
    end

    function Arrange()
        local width = self:GetWidth()
        local ctl = self.control
        local ctlW, ctlH = 0, 0
        if ctl then ctlW, ctlH = ctl:GetWidth(), ctl:GetHeight() end
        local textW = width - RESET_COL - S["space-5"] - (self.stacked and 0 or (ctlW + S["space-5"]))

        local x = self.modified and (5 + S["space-3"]) or 0
        self.dot:SetShown(self.modified and not self.disabled)

        local textH = self.label:GetStringHeight()
        if self.desc:IsShown() then
            self.desc:SetFixedWidth(textW)
            textH = textH + 1 + self.desc:GetStringHeight()
        end
        if self.why:IsShown() then
            self.whyText:SetWidth(textW - 15)
            textH = textH + 2 + math.max(11, self.whyText:GetStringHeight())
        end

        local height: number
        if self.stacked then
            height = S["space-4"] + textH + (ctl and (S["space-3"] + ctlH) or 0) + S["space-4"]
        else
            height = math.max(textH, ctlH) + S["space-4"] * 2
        end
        local top = self.stacked and S["space-4"] or (height - textH) / 2

        self.label:ClearAllPoints()
        self.label:SetPoint("TOPLEFT", x, -top)
        self.dot:ClearAllPoints()
        self.dot:SetPoint("CENTER", self, "TOPLEFT", 2.5, -top - self.label:GetStringHeight() / 2)
        self.desc:ClearAllPoints()
        self.desc:SetPoint("TOPLEFT", self.label, "BOTTOMLEFT", -x, -1)
        self.why:ClearAllPoints()
        self.why:SetPoint("TOPLEFT", self.desc:IsShown() and self.desc or self.label, "BOTTOMLEFT", self.desc:IsShown() and 0 or -x, -2)

        if ctl then
            ctl:ClearAllPoints()
            if self.stacked then
                ctl:SetPoint("TOPLEFT", 0, -(S["space-4"] + textH + S["space-3"]))
            else
                ctl:SetPoint("RIGHT", self, "RIGHT", -(RESET_COL + S["space-5"]), 0)
            end
        end
        self:SetHeight(height)
    end

    function SetDescription(value: string?)
        if value == self.descValue then return end
        self.descValue = value
        self.desc:SetValue(value or "")
        self.desc:SetShown(value ~= nil and value ~= "")
        self:Relayout()
    end

    function SetModified(modified: any)
        self.modified = modified and true or false
        local canReset = self.modified and not self.disabled
        self.reset:SetAlpha(canReset and 1 or 0)
        self.reset:EnableMouse(canReset)
        self:Relayout()
    end

    function SetDisabled(disabled: any, reason: string?)
        self.disabled = disabled and true or false
        self.label:SetColor(self.disabled and "ink-muted" or "ink")
        if self.control and self.control.SetDisabled then self.control:SetDisabled(self.disabled) end
        self.why:SetShown(self.disabled and reason ~= nil)
        self.whyText:SetValue(reason or "")
        self:SetModified(self.modified)
    end
end

export function settingRow(parent: Frame, opts: SettingRowOptions): SettingRow
    return SettingRow.new(parent, opts)
end

--------------------------------------------------------------------------------
-- SettingsGroup
--------------------------------------------------------------------------------

export type SettingsGroupOptions = { title?: string, meta?: string, description?: string, width?: number }

export class SettingsGroup extends Frame
    title: Text
    meta: Text
    desc: Text
    rows: Frame
    stack: Layout
    relayoutQueued: boolean? = nil

    constructor(parent: Frame, opts: SettingsGroupOptions)
        super(nil, parent)
        self:SetWidth(opts.width or 600)
        self.title = text(self, "header", "gilt-text")
        self.title:SetPoint("TOPLEFT")
        self.title:SetValue(opts.title or "")
        self.meta = text(self, "caption", "ink-muted")
        self.meta:SetPoint("TOPRIGHT")
        self.meta:SetValue(opts.meta or "")
        self.desc = text(self, "caption", "ink-muted")
        self.desc:SetWordWrap(true)
        self.desc:SetJustifyH("LEFT")
        self.desc:SetPoint("TOPLEFT", self.title, "BOTTOMLEFT", 0, -S["space-1"])
        self.desc:SetValue(opts.description or "")
        self.desc:SetShown(opts.description ~= nil)

        self.rows = CreateFrame("Frame", nil, self)
        self.rows:SetWidth(self:GetWidth())
        self.stack = stack(self.rows, { autoSize = "height" })
        self.rows:SetScript("OnSizeChanged", function() self:Relayout() end)
        self:Relayout()
    end

    function AddRow<R extends Region>(row: R): R
        row:SetWidth(self:GetWidth())
        self.stack:Add(row)
        return row
    end

    function SetMeta(value: string?)
        self.meta:SetValue(value or "")
    end

    function Relayout()
        self:Arrange()
        if not self.relayoutQueued then
            self.relayoutQueued = true
            after(0, function()
                self.relayoutQueued = false
                self:Arrange()
            end)
        end
    end

    function Arrange()
        local headH = self.title:GetStringHeight()
        if self.desc:IsShown() then
            self.desc:SetFixedWidth(self:GetWidth())
            headH = headH + S["space-1"] + self.desc:GetStringHeight()
        end
        self.rows:ClearAllPoints()
        self.rows:SetPoint("TOPLEFT", 0, -(headH + S["space-4"]))
        self:SetHeight(headH + S["space-4"] + self.rows:GetHeight())
    end
end

export function settingsGroup(parent: Frame, opts: SettingsGroupOptions): SettingsGroup
    return SettingsGroup.new(parent, opts)
end
