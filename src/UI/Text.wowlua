-- UI/Text.wowlua
-- Text in a design text style and token colour.
--
--   local t = text(parent, "label", "ink")
--   t:SetValue(value)    secret values go straight to the engine; readable
--                        ones are compared first, so an unchanged text costs nothing
--   t:SetStyle("caption"), t:SetColor("ink-muted"), t:SetShadowed(true)
--   t:SetVisible(shown)  Show/Hide that tells the layout only when it changes
--
-- A text whose value may be secret can't be measured in code: give it a
-- fixed width (t:SetFixedWidth(w)) when it sits in a layout.

import isSecret from "wowlua:secret"
import * as fonts from "/Core/Fonts"
import * as events from "/Core/Events"
import paint from "./Draw"

-- What a text shows: readable text or a number, or a secret text (it
-- goes to the engine untouched).
export type TextValue = string | number | Secret<string>

-- What holds a text and lays it out again when it changes (UI/Layout).
export interface Relayout
    function Invalidate()
end

-- The texts made (weak), for a theme change.
local texts: { [Text]: boolean } = setmetatable({}, { __mode = "k" })

-- A SuuUI text: a FontString class, built on the font string its frame
-- makes (`text()` below).
export class Text extends FontString
    style: string? = nil
    -- the readable value shown (nil: a secret one, or none yet)
    value: (string | number)? = nil
    fixedWidth: number? = nil
    -- the layout it sits in (UI/Layout.wowlua), set by the layout
    layout: Relayout? = nil

    constructor(style: string?, color: string?)
        super()
        self:SetWordWrap(false)
        self:SetStyle(style or "body")
        self:SetColor(color or "ink")
        texts[self] = true
    end

    function SetStyle(style: string)
        fonts.apply(self, style)
        self.style = style
        self:Changed()
    end

    -- A token (kept: it follows the theme, Draw's paint) or r, g, b, a.
    function SetColor(r: string | number, g: number?, b: number?, a: number?)
        if type(r) == "string" then
            return paint(self, r, g)
        end
        self:SetTextColor(r, g :: number, b :: number, a)
    end

    function SetValue(v: TextValue?)
        if isSecret(v) then
            self.value = nil
            self:SetText(v)
            self:Changed()
            return
        end
        if v == self.value then
            return
        end
        self.value = v
        if type(v) == "number" then
            self:SetText(tostring(v))
        else
            self:SetText(v)
        end
        self:Changed()
    end

    -- The shadow every label straight on the world carries (0 1px 2px black, 90%).
    function SetShadowed(on: boolean?)
        if on then
            self:SetShadowColor(0, 0, 0, 0.9)
            self:SetShadowOffset(0, -1)
        else
            self:SetShadowOffset(0, 0)
        end
    end

    function SetFixedWidth(w: number)
        self.fixedWidth = w
        self:SetWidth(w)
        self:Changed()
    end

    -- (anything: shown when it is true-ish)
    function SetVisible(given: unknown)
        local shown = given ~= nil and given ~= false
        if shown == self:IsShown() then
            return
        end
        self:SetShown(shown)
        self:Changed()
    end

    function Changed()
        local layout = self.layout
        if layout then
            layout:Invalidate()
        end
    end
end

-- A yes/no from the game as a plain boolean. In combat many unit queries
-- return a secret boolean, and testing one (if, and, or, not) errors; a
-- secret answer counts as unknown and reads as false. To show something from
-- a secret boolean, use region:SetAlphaFromBoolean instead.
export function flag(v: unknown): boolean
    if isSecret(v) then
        return false
    end
    return v ~= nil and v ~= false
end

-- The width of `value` in a text style, measured on a hidden FontString that
-- is anchored to nothing. A region anchored after one with secret text (an
-- enemy's name in combat) reports its own size as secret too, so anything in
-- such a chain must be measured here instead.
local measurer: FontString? = nil
export function measureText(style: string, value: string?): number
    if not measurer then
        measurer = UIParent:CreateFontString(nil, "OVERLAY")
        measurer:Hide()
    end
    fonts.apply(measurer, style)
    measurer:SetText(value or "")
    return measurer:GetUnboundedStringWidth()
end

export function text(parent: Frame, style: string?, color: string?, layer: DrawLayer?): Text
    return Text.adopt(parent:CreateFontString(nil, layer or "OVERLAY"), style, color)
end

-- A theme can change a text style's size (the Font object follows by
-- itself): the layouts holding SuuUI texts measure them again.
events.on(
    "SUUUI_THEME_CHANGED",
    function()
        for fs in pairs(texts) do
            fs:Changed()
        end
    end,
    "Text"
)
