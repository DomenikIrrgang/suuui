-- UI/GroupFinder.wowlua
-- The Group Finder's Browse page (design component GroupFinder, "Browse"):
-- one list of groups and players looking, from the game's tool and from
-- chat (ForeverLFG), in two collapsible sections, Groups and Players.
--   The bar: category, filter by activity, search, "Only what fits me",
--   Show (groups / players / both); the tool's age and Refresh (the tool
--   only searches on a click; primary once the results are stale). Too
--   narrow, the search field gives way first, then the selects.
--   A row (44px): a crown for a group or the player's class icon; the
--   activity, a level chip, a sprout (new player friendly), the reason it
--   concerns you (arcane, with the row in arcane-soft and a 2px arcane
--   edge); the leader in class colour, "Lvl 31 Mage", the play style and
--   the post or the listing's comment in quotes (the whole of it on
--   hover); role slots and "3/5" (or the roles offered), source badges,
--   age; Whisper, and Invite for a player looking.
--   Searching the tool for the first time: skeleton rows under what chat
--   has so far. Nothing to show: Clear filters and Refresh.
--
--   local b = groupFinderBrowse(parent)  (SuuUI.UI.GroupFinderBrowse)
--   b:SetData({
--       groups = { row }, players = { row }, collapsed = { groups, players },
--       tool = { age = seconds | nil, stale = bool, searching = bool, loading = bool },
--       category = value, categories = { { value, label } },
--       activities = { value, ... }, activityOptions = { { value, label } },
--       search = "", fits = bool, show = "both" | "group" | "player",
--   })
--     row = { key, activity, level ("29+"), newPlayerFriendly, reason, match,
--             leader, class (file), who ("Lvl 31 Mage"), playstyle, post,
--             slots = { "tank" | "healer" | "damage" (offered) | "has:tank" | "has:none"
--                       (a member, greyed) | "need:tank" | "open" }, rolesTip (hover text),
--             offered = { tank, healer, damage }, members = { have, max },
--             sources = { "Tool", "LookingForGroup", ... }, age ("2m"), canInvite }
--   b.onRefresh(), b.onFilter(changes), b.onWhisper(row), b.onInvite(row),
--   b.onToggle("groups" | "players"), b.onClear()

import tokens as T from "/Core/Tokens"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as controls from "/UI/Controls"
import * as inputs from "/UI/Inputs"
import * as uiSelect from "/UI/Select"
import * as panel from "/UI/Panel"
import * as tooltip from "/UI/Tooltip"
import Text from "/UI/Text"
import SuuButton from "/UI/Controls"
import TextField, Checkbox from "/UI/Inputs"
import Select, SelectOption from "/UI/Select"
import ScrollArea from "/UI/Panel"

-- A group or a player looking (see the header for the fields).
export type BrowseRow = {
    key?: string,
    -- the tool's entry, handed back to whisper or invite
    entry?: unknown,
    isPlayer?: boolean,
    activity?: string,
    level?: string,
    newPlayerFriendly?: boolean,
    reason?: string,
    match?: boolean,
    leader?: string,
    class?: string,
    who?: string,
    playstyle?: string,
    post?: string,
    slots?: string[],
    rolesTip?: string,
    mine?: { [string]: boolean },
    offered?: { [string]: boolean },
    members?: number[],
    sources?: string[],
    age?: string,
    canInvite?: boolean,
}

export type BrowseTool = { age?: number, stale?: boolean, searching?: boolean, loading?: boolean }

export type BrowseData = {
    groups?: BrowseRow[],
    players?: BrowseRow[],
    collapsed?: { [string]: boolean },
    tool?: BrowseTool,
    category?: string,
    categories?: SelectOption<string>[],
    activities?: string[],
    activityOptions?: SelectOption<string>[],
    search?: string,
    fits?: boolean,
    show?: string,
}

-- What a change in the bar reports (one field each time).
export type BrowseFilter = { category?: string, activities?: string[], search?: string, fits?: boolean, show?: string }

-- A quiet 24px button with a glyph (Whisper, Invite); its word in a tooltip.
export class GlyphButton extends SuuButton
    readonly glyph: Texture

    constructor(parent: Frame, glyph: string, title: string, description: string, onClick: () -> ())
        super(parent, { text = "", width = 24, onClick = onClick, tooltip = { title = title, description = description } })
        self:SetHeight(24)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. glyph .. ".tga")
        self.glyph:SetSize(12, 12)
        self.glyph:SetPoint("CENTER")
    end
end

-- A row's level range.
export class LevelChip extends Frame
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(14)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-faint")
        self.text = uiText.text(self, "micro", "ink-muted")
        self.text:SetPoint("CENTER")
    end
end

-- Over a row's role slots: what they mean, in a tooltip.
export class SlotsHit extends Frame
    tip?: string
end

-- What the list shows with nothing in it.
export class BrowseEmpty extends Frame
    readonly glyph: Texture
    readonly title: Text
    readonly text: Text
    readonly clear: SuuButton
    readonly refresh: SuuButton

    constructor(parent: Frame, gap: number, onClear: () -> (), onRefresh: () -> ())
        super(nil, parent)
        local g = gap
        self:SetSize(360, 140)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. "search.tga")
        self.glyph:SetSize(24, 24)
        draw.paint(self.glyph, "ink-faint")
        self.glyph:SetPoint("TOP")
        self.title = uiText.text(self, "label", "ink")
        self.title:SetPoint("TOP", self.glyph, "BOTTOM", 0, -g)
        self.title:SetValue("Nothing matches your filters")
        self.text = uiText.text(self, "caption", "ink-muted")
        self.text:SetWidth(360)
        self.text:SetJustifyH("CENTER")
        self.text:SetPoint("TOP", self.title, "BOTTOM", 0, -g)
        self.text:SetValue("Chat posts show up here as they’re written. Clear a filter, or refresh the tool for new listings.")
        self.clear = controls.button(self, { text = "Clear filters", icon = "close", onClick = onClear })
        self.refresh = controls.button(self, { text = "Refresh", icon = "reset", onClick = onRefresh })
        for _, btn in ipairs({ self.clear, self.refresh }) do btn:SetHeight(26) end
        self.clear:SetPoint("TOPRIGHT", self.text, "BOTTOM", -g / 2, -g * 2)
        self.refresh:SetPoint("TOPLEFT", self.text, "BOTTOM", g / 2, -g * 2)
    end
end

local S = T.space

local TEX = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local GLYPHS = TEX .. "Glyphs\\"
local ROLE_TEX = { tank = TEX .. "RoleTank.tga", healer = TEX .. "RoleHealer.tga", damage = TEX .. "RoleDamage.tga" }

local BAR_H = 30
local HEAD_H = 26
local ROW_H = 44
local ICON = 18

--------------------------------------------------------------------------------
-- Small parts: a role icon, a source badge
--------------------------------------------------------------------------------

-- A role icon (design component RoleIcon): filled (offered), has (a member
-- with it: greyed, ink-faint in gilt-faint, no fill), needed (a dim edge),
-- your role (arcane), a member with no role (a greyed diamond), open (hollow).
export class RoleIcon extends Frame
    bg: Texture
    edge: draw.Border
    glyph: Texture
    dot: Texture

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(ICON, ICON)
        self.bg = draw.fill(self, "surface-raised")
        self.bg:SetAllPoints()
        self.edge = draw.border(self, "gilt-line")
        self.glyph = self:CreateTexture(nil, "OVERLAY")
        self.glyph:SetSize(ICON - 6, ICON - 6)
        self.glyph:SetPoint("CENTER")
        self.dot = draw.diamond(self, 5, "ink-muted")
        self.dot:SetPoint("CENTER")
    end

    function Set(kind: string, mine: boolean?)
        local need = kind:match("^need:(.+)$")
        local has = kind:match("^has:(.+)$")
        if kind == "member" then has = "none" end
        local role = need or has or kind
        self.dot:Hide()
        self.glyph:Show()
        self.bg:Show()
        self.edge:SetShown(true)
        if has then
            -- what the group has: greyed
            self.bg:Hide()
            local tex = ROLE_TEX[has]
            if tex then
                self.glyph:SetTexture(tex)
                draw.paint(self.glyph, "ink-faint")
                self.edge:SetColor("gilt-faint")
            else
                self.glyph:Hide(); self.edge:SetShown(false)
                draw.paint(self.dot, "ink-faint")
                self.dot:Show()
            end
        elseif ROLE_TEX[role] then
            self.glyph:SetTexture(ROLE_TEX[role] :: string)
            if need then
                self.bg:Hide()
                self.edge:SetColor(mine and "arcane" or "ink-faint")
                draw.paint(self.glyph, mine and "arcane" or "ink-muted")
            else
                self.edge:SetColor("gilt-line")
                draw.paint(self.glyph, "ink")
            end
        else
            -- an open spot
            self.glyph:Hide(); self.bg:Hide()
            self.edge:SetColor("ink-faint")
        end
    end
end

local function roleIcon(parent: Frame): RoleIcon
    return RoleIcon.new(parent)
end

-- A source badge (design component SourceBadge): "Tool" or the channel.
export class SourceBadge extends Frame
    text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(16)
        draw.fill(self, "surface-raised"):SetAllPoints()
        draw.border(self, "gilt-line")
        self.text = uiText.text(self, "micro", "ink-muted")
        self.text:SetPoint("CENTER")
    end

    function SetLabel(s: string)
        self.text:SetValue(s)
        self:SetWidth(math.ceil(self.text:GetUnboundedStringWidth()) + 10)
    end
end

local function badge(parent: Frame): SourceBadge
    return SourceBadge.new(parent)
end

--------------------------------------------------------------------------------
-- A row
--------------------------------------------------------------------------------

local function iconButton(parent: Frame, glyph: string, title: string, description: string, onClick: () -> ()): GlyphButton
    return GlyphButton.new(parent, glyph, title, description, onClick)
end

export class BrowseRowFrame extends Button
    data?: BrowseRow
    match: Texture
    edge: Texture
    hover: Texture
    rule: Texture
    lead: Texture
    activity: Text
    levelChip: LevelChip
    sprout: Texture
    reason: Text
    leader: Text
    who: Text
    post: Text
    invite: GlyphButton
    whisper: GlyphButton
    age: Text
    badges: SourceBadge[]
    slots: RoleIcon[]
    count: Text
    rolesLabel: Text
    slotsHit: SlotsHit

    constructor(b: GroupFinderBrowse)
        super(nil, b.list.child)
        self:SetHeight(ROW_H)
        self.match = draw.fill(self, "arcane-soft", "BACKGROUND")
        self.match:SetAllPoints()
        self.edge = draw.fill(self, "arcane", "ARTWORK")
        self.edge:SetWidth(2)
        self.edge:SetPoint("TOPLEFT")
        self.edge:SetPoint("BOTTOMLEFT")
        self.hover = draw.fill(self, "gilt-faint", "BACKGROUND", 1)
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.rule = draw.fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetHeight(1)
        self.rule:SetPoint("BOTTOMLEFT", S["space-4"], 0)
        self.rule:SetPoint("BOTTOMRIGHT", -S["space-4"], 0)
        -- the lead: centred in a 20px column (drawRow sizes it)
        self.lead = self:CreateTexture(nil, "ARTWORK")
        self.lead:SetSize(20, 20)
        self.lead:SetPoint("CENTER", self, "LEFT", S["space-4"] + 10, 0)
        -- line 1
        self.activity = uiText.text(self, "label", "ink")
        self.activity:SetPoint("TOPLEFT", self, "LEFT", S["space-4"] + 20 + S["space-4"], 18)
        self.levelChip = LevelChip.new(self)
        self.sprout = self:CreateTexture(nil, "ARTWORK")
        self.sprout:SetTexture(GLYPHS .. "leaf.tga")
        self.sprout:SetSize(11, 11)
        draw.paint(self.sprout, "ink-muted")
        self.reason = uiText.text(self, "caption", "arcane")
        -- line 2
        self.leader = uiText.text(self, "caption", "ink")
        self.leader:SetPoint("TOPLEFT", self.activity, "BOTTOMLEFT", 0, -3)
        self.who = uiText.text(self, "caption", "ink-muted")
        self.who:SetPoint("LEFT", self.leader, "RIGHT", S["space-3"], 0)
        self.post = uiText.text(self, "caption", "ink-muted")
        self.post:SetPoint("LEFT", self.who, "RIGHT", S["space-4"], 0)
        -- the right: Invite, Whisper, age, sources, roles
        -- Whisper and Invite as 24px glyph buttons (asked for in game: words
        -- took too much room), the word on hover
        self.invite = iconButton(self, "plus", "Invite", "Invite this player to your group",
            function() local d = self.data; if b.onInvite and d then b.onInvite(d) end end)
        self.invite:SetPoint("RIGHT", -S["space-4"], 0)
        self.whisper = iconButton(self, "chat", "Whisper", "An empty whisper to them",
            function() local d = self.data; if b.onWhisper and d then b.onWhisper(d) end end)
        -- always where it is on a player's row, so the column lines up
        self.whisper:SetPoint("RIGHT", self.invite, "LEFT", -S["space-3"], 0)
        self.age = uiText.text(self, "caption", "ink-faint")
        self.age:SetJustifyH("RIGHT")
        self.age:SetWidth(30)
        self.badges, self.slots = {}, {}
        self.count = uiText.text(self, "numeric", "ink-muted")
        self.rolesLabel = uiText.text(self, "caption", "ink-muted")
        self.slotsHit = SlotsHit.new(nil, self)
        self.slotsHit:SetFrameLevel(self:GetFrameLevel() + 5)
        self.slotsHit:SetScript("OnEnter", function(hit: SlotsHit)
            self.hover:Show()
            tooltip.showTooltip(hit, { title = "Roles", description = hit.tip })
        end)
        self.slotsHit:SetScript("OnLeave", function() self.hover:Hide(); tooltip.hideTooltip() end)
        self.slotsHit:Hide()
        self:SetScript("OnEnter", function()
            self.hover:Show()
            local d = self.data
            if d and d.post and d.post ~= "" then
                GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                GameTooltip_SetTitle(GameTooltip, d.leader or "")
                GameTooltip_AddNormalLine(GameTooltip, d.post, true)
                GameTooltip:Show()
            end
        end)
        self:SetScript("OnLeave", function() self.hover:Hide(); GameTooltip:Hide() end)
    end
end

local function makeRow(b: GroupFinderBrowse): BrowseRowFrame
    return BrowseRowFrame.new(b)
end

local function drawRow(b: GroupFinderBrowse, r: BrowseRowFrame, d: BrowseRow, y: number, width: number)
    r.data = d
    r:ClearAllPoints()
    r:SetPoint("TOPLEFT", b.list.child, "TOPLEFT", 0, -y)
    r:SetWidth(width)
    r.match:SetShown(d.match and true or false)
    r.edge:SetShown(d.match and true or false)
    -- the leading icon: a group's crown, or the player's class (people
    -- when it isn't known)
    local atlas = d.class and GetClassAtlas and GetClassAtlas(d.class)
    r.lead:ClearAllPoints()
    if d.isPlayer and atlas then
        r.lead:SetAtlas(atlas)
        r.lead:SetVertexColor(1, 1, 1, 1)
        r.lead:SetSize(20, 20)
    else
        r.lead:SetTexture(GLYPHS .. (d.isPlayer and "people.tga" or "crown.tga"))
        draw.paint(r.lead, "gilt-text")
        local size = d.isPlayer and 20 or 16
        r.lead:SetSize(size, size)
    end
    r.lead:SetPoint("CENTER", r, "LEFT", S["space-4"] + 10, 0)
    r.activity:SetValue(d.activity or "")
    if d.level then
        r.levelChip.text:SetValue(d.level)
        r.levelChip:SetWidth(math.ceil(r.levelChip.text:GetUnboundedStringWidth()) + 8)
        r.levelChip:ClearAllPoints()
        r.levelChip:SetPoint("LEFT", r.activity, "RIGHT", S["space-3"], 0)
        r.levelChip:Show()
    else
        r.levelChip:Hide()
    end
    local last = d.level and r.levelChip or r.activity
    r.sprout:SetShown(d.newPlayerFriendly and true or false)
    if d.newPlayerFriendly then
        r.sprout:ClearAllPoints()
        r.sprout:SetPoint("LEFT", last, "RIGHT", S["space-3"], 0)
        last = r.sprout
    end
    r.reason:SetValue(d.reason or "")
    r.reason:ClearAllPoints()
    r.reason:SetPoint("LEFT", last, "RIGHT", S["space-4"], 0)
    local color = d.class and T.color["class-" .. d.class:lower()] and ("class-" .. d.class:lower()) or "ink"
    r.leader:SetValue(d.leader or "")
    r.leader:SetColor(color)
    r.who:SetValue(d.who or "")
    local post = d.playstyle or ""
    if d.post and d.post ~= "" then post = (post ~= "" and (post .. "  ") or "") .. "\"" .. d.post .. "\"" end
    r.post:SetValue(post)
    -- the right side, from the right edge leftwards
    r.invite:SetShown(d.canInvite and true or false)
    r.age:SetValue(d.age or "")
    r.age:ClearAllPoints()
    r.age:SetPoint("RIGHT", r.whisper, "LEFT", -S["space-4"], 0)
    -- right to left: the age, then the role slots and "3/5" (always the
    -- same distance from the age, so they line up from row to row: after
    -- the badges, whose width varies, they didn't; asked for in game), then
    -- the source badges, then the text
    local anchor = r.age
    -- a group's size ("3/5"), after its slots, in a column of its own
    local members = (not d.isPlayer) and d.members or nil
    local have, max = members and members[1], members and members[2]
    local counted = (have and max) and true or false
    r.count:SetShown(counted)
    if have and max then
        r.count:SetValue(have .. "/" .. max)
        r.count:SetWidth(34)
        r.count:SetJustifyH("RIGHT")
        r.count:ClearAllPoints()
        r.count:SetPoint("RIGHT", anchor, "LEFT", -S["space-5"], 0)
        anchor = r.count
    end
    -- roles: a group's slots, or what a player offers
    local slots = d.slots or {}
    for i = #slots, 1, -1 do
        local sl = r.slots[i] or roleIcon(r)
        r.slots[i] = sl
        sl:Set(slots[i], d.mine and d.mine[slots[i]:match("^need:(.+)$") or ""])
        sl:ClearAllPoints()
        local gap = i < #slots and -3 or (counted and -(S["space-2"] + 3) or -S["space-5"])
        sl:SetPoint("RIGHT", anchor, "LEFT", gap, 0)
        sl:Show()
        anchor = sl
    end
    for i = #slots + 1, #r.slots do r.slots[i]:Hide() end
    -- hovering the slots: all the group has and needs
    r.slotsHit:ClearAllPoints()
    if #slots > 0 and d.rolesTip then
        r.slotsHit:SetPoint("TOPLEFT", r.slots[1], "TOPLEFT", -2, 2)
        r.slotsHit:SetPoint("BOTTOMRIGHT", r.slots[#slots], "BOTTOMRIGHT", 2, -2)
        r.slotsHit.tip = d.rolesTip
        r.slotsHit:Show()
    else
        r.slotsHit:Hide()
    end
    r.rolesLabel:SetValue(d.isPlayer and #slots > 0 and "Roles:" or "")
    r.rolesLabel:ClearAllPoints()
    r.rolesLabel:SetPoint("RIGHT", anchor, "LEFT", -S["space-3"], 0)
    if r.rolesLabel:GetText() ~= "" then anchor = r.rolesLabel end
    -- where it was seen
    local sources = d.sources or {}
    for i = #sources, 1, -1 do
        local bd = r.badges[i] or badge(r)
        r.badges[i] = bd
        bd:SetLabel(sources[i])
        bd:ClearAllPoints()
        bd:SetPoint("RIGHT", anchor, "LEFT", i == #sources and -S["space-5"] or -S["space-3"], 0)
        bd:Show()
        anchor = bd
    end
    for i = #sources + 1, #r.badges do r.badges[i]:Hide() end
    -- the text stops before the right side
    r.post:SetPoint("RIGHT", anchor, "LEFT", -S["space-4"], 0)
    r.post:SetWordWrap(false)
    r:Show()
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

export class SectionHead extends Button
    text: Text
    count: Text
    glyph: Texture
    note: Text
    rule: Frame
    label: string

    constructor(b: GroupFinderBrowse, key: "groups" | "players", label: string)
        super(nil, b.list.child)
        self:SetHeight(HEAD_H)
        self.text = uiText.text(self, "header", "gilt-text")
        self.text:SetPoint("LEFT", S["space-4"], 0)
        self.count = uiText.text(self, "caption", "ink-muted")
        self.count:SetPoint("LEFT", self.text, "RIGHT", S["space-3"], 0)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetSize(12, 12)
        self.glyph:SetPoint("RIGHT", -S["space-4"], 0)
        draw.paint(self.glyph, "ink-muted")
        -- a note before the chevron ("from chat so far" while the tool searches)
        self.note = uiText.text(self, "caption", "ink-faint")
        self.note:SetPoint("RIGHT", self.glyph, "LEFT", -S["space-3"], 0)
        self.rule = draw.hairline(self, "gilt-line", "out")
        self.rule:SetPoint("LEFT", self.count, "RIGHT", S["space-4"], 0)
        self.rule:SetPoint("RIGHT", self.note, "LEFT", -S["space-4"], 0)
        self.label = label
        self:SetScript("OnClick", function() if b.onToggle then b.onToggle(key) end end)
    end
end

local function sectionHead(b: GroupFinderBrowse, key: "groups" | "players", label: string): SectionHead
    return SectionHead.new(b, key, label)
end

-- Skeleton rows stand in for the tool's while it searches the first time:
-- a square, two lines, a block at the right, in surface-raised.
export class SkeletonRow extends Frame
    a: Texture
    b: Texture
    b2: Texture
    c: Texture
    rule: Texture

    constructor(b: GroupFinderBrowse)
        super(nil, b.list.child)
        self:SetHeight(ROW_H)
        self.a = draw.fill(self, "surface-raised")
        self.a:SetSize(14, 14)
        self.a:SetPoint("CENTER", self, "LEFT", S["space-4"] + 10, 0)
        self.b = draw.fill(self, "surface-raised")
        self.b:SetHeight(10)
        self.b:SetPoint("LEFT", S["space-4"] * 2 + 20, 5)
        self.b2 = draw.fill(self, "surface-raised")
        self.b2:SetHeight(6)
        self.b2:SetPoint("TOPLEFT", self.b, "BOTTOMLEFT", 0, -4)
        self.c = draw.fill(self, "surface-raised")
        self.c:SetSize(92, 14)
        self.c:SetPoint("RIGHT", -S["space-4"], 0)
        self.rule = draw.fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetHeight(1)
        self.rule:SetPoint("BOTTOMLEFT", S["space-4"], 0)
        self.rule:SetPoint("BOTTOMRIGHT", -S["space-4"], 0)
    end
end

local function makeSkeleton(b: GroupFinderBrowse): SkeletonRow
    return SkeletonRow.new(b)
end

-- What the bar says about the tool's results: searching, never searched, or
-- how old (and whether stale).
local function toolText(tool: BrowseTool): string
    if tool.searching then return "Searching the tool…" end
    local age = tool.age
    if not age then return "Tool not searched yet" end
    local m = math.floor(age / 60)
    return "Tool results " .. (m < 1 and "just now" or (m .. "m old")) .. (tool.stale and " · stale" or "")
end

-- The bar's widths (design: 150, 190, 170, the checkbox, 120; the tool's age
-- and Refresh at the right). Too narrow: Search gives way first (down to
-- 56), then the three selects by their widths; the age is cut short last.
-- Refresh never shrinks.
local BAR_BASIS = { category = 150, activity = 190, search = 170, show = 120 }
local BAR_MIN = { category = 80, activity = 90, search = 56, show = 80 }

export type BarWidths = { category: number, activity: number, search: number, show: number }

-- The bar's widths in `width`: `fixed` for what never shrinks (Refresh, the
-- checkbox, the gaps), `fresh` for the tool's age (hourglass, gap, text).
-- Returns the four widths and the room left for the age.
local function barWidths(width: number, fixed: number, fresh: number): (BarWidths, number)
    local w: BarWidths = { category = BAR_BASIS.category, activity = BAR_BASIS.activity,
                           search = BAR_BASIS.search, show = BAR_BASIS.show }
    local over = fixed + fresh + w.category + w.activity + w.search + w.show - width
    if over > 0 then
        local cut = math.min(over, w.search - BAR_MIN.search)
        w.search, over = w.search - cut, over - cut
    end
    if over > 0 then
        local room = 0
        for _, k in ipairs({ "category", "activity", "show" }) do room = room + (w[k] - BAR_MIN[k]) end
        local share = math.min(1, over / math.max(1, room))
        for _, k in ipairs({ "category", "activity", "show" }) do
            local cut = math.floor((w[k] - BAR_MIN[k]) * share + 0.5)
            w[k], over = w[k] - cut, over - cut
        end
    end
    if over > 0 then fresh = math.max(12, fresh - over) end
    return w, fresh
end

export class GroupFinderBrowse extends Frame
    rows: BrowseRowFrame[]
    heads: { [string]: SectionHead }
    skeletons: SkeletonRow[]
    category: Select<string>
    activity: Select<string>
    search: TextField
    fits: Checkbox
    show: Select<string>
    refreshQuiet: SuuButton
    refreshPrimary: SuuButton
    refresh: SuuButton
    staleText: Text
    hourglass: Texture
    box: Frame
    list: ScrollArea
    loadNote: Text
    empty: BrowseEmpty
    data: BrowseData? = nil
    onRefresh: (() -> ())? = nil
    onFilter: ((changes: BrowseFilter) -> ())? = nil
    onWhisper: ((row: BrowseRow) -> ())? = nil
    onInvite: ((row: BrowseRow) -> ())? = nil
    onToggle: ((key: "groups" | "players") -> ())? = nil
    onClear: (() -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.rows, self.heads, self.skeletons = {}, {}, {}
        -- the bar
        local function changed(t: BrowseFilter) if self.onFilter then self.onFilter(t) end end
        local g = S["space-3"]
        self.category = uiSelect.select(self, { width = 150, placeholder = "Category",
            onChange = function(v: string) changed({ category = v }) end })
        self.category:SetPoint("TOPLEFT")
        self.category:SetHeight(BAR_H)
        self.activity = uiSelect.select(self, { width = 190, multiple = true, maxShown = 1, placeholder = "Filter by activity", maxRows = 12,
            onChangeAll = function(v: string[]) changed({ activities = v }) end })
        self.activity:SetPoint("LEFT", self.category, "RIGHT", g, 0)
        self.activity:SetHeight(BAR_H)
        self.search = inputs.textField(self, { width = 170, placeholder = "Search",
            onTextChanged = function(text: string) changed({ search = text }) end })
        self.search:SetPoint("LEFT", self.activity, "RIGHT", g, 0)
        self.fits = inputs.checkbox(self, { label = "Only what fits me", onChange = function(on: boolean) changed({ fits = on }) end })
        self.fits:SetPoint("LEFT", self.search, "RIGHT", g * 2, 0)
        self.show = uiSelect.select(self, { width = 120, options = {
            { value = "both", label = "Both" }, { value = "group", label = "Groups" }, { value = "player", label = "Players looking" } },
            onChange = function(v: string) changed({ show = v }) end })
        self.show:SetPoint("LEFT", self.fits, "RIGHT", g * 2, 0)
        self.show:SetHeight(BAR_H)
        -- the tool's age and Refresh, at the right (primary once stale)
        local function refresh() if self.onRefresh then self.onRefresh() end end
        self.refreshQuiet = controls.button(self, { text = "Refresh", variant = "quiet", onClick = refresh,
            tooltip = { title = "Refresh", description = "Search the tool again (chat entries are live)" } })
        self.refreshPrimary = controls.button(self, { text = "Refresh", variant = "primary", onClick = refresh,
            tooltip = { title = "Refresh", description = "Search the tool again (chat entries are live)" } })
        for _, r in ipairs({ self.refreshQuiet, self.refreshPrimary }) do
            r:SetHeight(BAR_H)
            r:SetPoint("TOPRIGHT")
        end
        self.refreshPrimary:Hide()
        self.refresh = self.refreshQuiet
        self.staleText = uiText.text(self, "caption", "ink-muted")
        self.staleText:SetWordWrap(false)
        self.staleText:SetJustifyH("RIGHT")
        self.staleText:SetPoint("RIGHT", self.refresh, "LEFT", -g, 0)
        self.hourglass = self:CreateTexture(nil, "ARTWORK")
        self.hourglass:SetTexture(GLYPHS .. "hourglass.tga")
        self.hourglass:SetSize(12, 12)
        draw.paint(self.hourglass, "ink-muted")
        self.hourglass:SetPoint("RIGHT", self.staleText, "LEFT", -g, 0)
        self:HookScript("OnSizeChanged", function() self:LayoutBar() end)
        -- the list
        self.box = CreateFrame("Frame", nil, self)
        self.box:SetPoint("TOPLEFT", 0, -(BAR_H + S["space-4"]))
        self.box:SetPoint("BOTTOMRIGHT")
        draw.fill(self.box, "surface-sunk"):SetAllPoints()
        draw.border(self.box, "gilt-faint")
        self.list = panel.scrollArea(self.box, 2)
        self.list:SetPoint("TOPLEFT", 1, -S["space-2"])
        self.list:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-2"])
        self.list:HookScript("OnSizeChanged", function() self:Draw() end)
        self.heads.groups = sectionHead(self, "groups", "Groups")
        self.heads.players = sectionHead(self, "players", "Players")
        self.loadNote = uiText.text(self.list.child, "caption", "ink-muted")
        self.loadNote:SetValue("Searching the tool… Chat posts show up as they’re written.")
        -- nothing to show: a faint search glyph, what happened, Clear filters and Refresh
        local e = BrowseEmpty.new(self.box, g, function() if self.onClear then self.onClear() end end, refresh)
        e:SetPoint("CENTER")
        e:Hide()
        self.empty = e
    end

    function SetData(d: BrowseData)
        self.data = d
        -- the bar
        self.category:SetOptions(d.categories or {})
        self.category:SetValue(d.category)
        self.activity:SetOptions(d.activityOptions or {})
        self.activity:SetValue(d.activities or {})
        if self.search:GetValue() ~= (d.search or "") and not self.search.edit:HasFocus() then self.search:SetValue(d.search or "") end
        self.fits:SetValue(d.fits)
        self.show:SetValue(d.show or "both")
        -- the tool's age
        local tool = d.tool or {}
        self.staleText:SetValue(toolText(tool))
        self.staleText:SetColor(tool.stale and "amber" or "ink-muted")
        draw.paint(self.hourglass, tool.stale and "amber" or "ink-muted")
        -- stale: Refresh is the suggested action
        local stale = tool.stale and not tool.searching
        self.refreshQuiet:SetShown(not stale)
        self.refreshPrimary:SetShown(stale and true or false)
        self.refresh = stale and self.refreshPrimary or self.refreshQuiet
        self:LayoutBar()
        self:Draw()
    end

    function LayoutBar()
        local width = self:GetWidth()
        if not width or width <= 1 then return end
        local g = S["space-3"]
        local textW = math.ceil(uiText.measureText("caption", self.staleText:GetText() or ""))
        local w, fresh = barWidths(width, self.refresh:GetWidth() + self.fits:GetWidth() + g * 8, 12 + g + textW)
        self.category:SetWidth(w.category)
        self.activity:SetWidth(w.activity)
        self.search:SetWidth(w.search)
        self.show:SetWidth(w.show)
        self.staleText:ClearAllPoints()
        self.staleText:SetPoint("RIGHT", self.refresh, "LEFT", -g, 0)
        self.staleText:SetWidth(math.max(1, fresh - 12 - g))
        self.staleText:SetShown(fresh > 12)
    end

    function Draw()
        local d = self.data
        if not d then return end
        local width = math.max(1, self.list:GetWidth())
        self.list.child:SetWidth(width)
        local loading = d.tool and d.tool.loading
        local none = #(d.groups or {}) + #(d.players or {}) == 0 and not loading
        local y = 0
        local used, skels = 0, 0
        for _, key in ipairs({ "groups", "players" }) do
            local rows = d[key] or {}
            local h = self.heads[key] :: SectionHead
            h:SetShown(not none)
            if not none then
                h:ClearAllPoints()
                h:SetPoint("TOPLEFT", self.list.child, "TOPLEFT", 0, -y)
                h:SetWidth(width)
                h.text:SetValue(h.label)
                h.count:SetValue(tostring(#rows))
                h.note:SetValue(loading and "from chat so far" or "")
                local closed = d.collapsed and d.collapsed[key]
                h.glyph:SetTexture(GLYPHS .. (closed and "chevronRight.tga" or "chevronDown.tga"))
                y = y + HEAD_H
                if not closed then
                    for _, row in ipairs(rows) do
                        used = used + 1
                        local r = self.rows[used] or makeRow(self)
                        self.rows[used] = r
                        drawRow(self, r, row, y, width)
                        y = y + ROW_H
                    end
                    -- the tool's rows still to come
                    for _ = 1, loading and (key == "groups" and 3 or 2) or 0 do
                        skels = skels + 1
                        local r = self.skeletons[skels] or makeSkeleton(self)
                        self.skeletons[skels] = r
                        r:ClearAllPoints()
                        r:SetPoint("TOPLEFT", self.list.child, "TOPLEFT", 0, -y)
                        r:SetWidth(width)
                        r.b:SetWidth(math.max(40, (width - 20 - S["space-4"] * 4 - 132) * 0.62))
                        r.b2:SetWidth(math.max(36, r.b:GetWidth() - 4))
                        r:Show()
                        y = y + ROW_H
                    end
                end
                y = y + S["space-3"]
            end
        end
        for i = used + 1, #self.rows do self.rows[i]:Hide() end
        for i = skels + 1, #self.skeletons do self.skeletons[i]:Hide() end
        self.loadNote:SetShown(loading and true or false)
        if loading then
            self.loadNote:ClearAllPoints()
            self.loadNote:SetPoint("TOP", self.list.child, "TOP", 0, -(y + S["space-5"]))
            y = y + S["space-5"] * 2 + 16
        end
        self.list.child:SetHeight(math.max(1, y))
        self.empty:SetShown(none)
    end
end

export function groupFinderBrowse(parent: Frame): GroupFinderBrowse
    return GroupFinderBrowse.new(parent)
end
