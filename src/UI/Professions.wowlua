-- UI/Professions.wowlua
-- The Professions window's body (design boards "Professions · Overview" and
-- "Professions · Alchemy"): a rail of tabs down the right (the overview,
-- then each crafting profession), and the page:
--   overview  "Primary professions  2 of 2": two cards; "Secondary
--             professions": a row of cards. A card: the profession's icon,
--             name and rank, its skill bar, its spells (icon and name)
--   crafting  the skill bar and rank; the recipes (search, filters, by
--             category, in the game's difficulty colours, how many you can
--             make, an eye on tracked ones) beside the chosen recipe: its
--             product, what it needs (tools), its reagents (have / need), a
--             cooldown, Track, a quantity, Create all and Create
--
--   local p = professions(parent, { edgeInset = 20 })  -- the page's distance
--                          -- from the window's edge (the rail's tabs centre between)
--   p:SetTabs({ { key, label, icon, glyph } }, selected)   p.onTab(key)
--   p:SetOverview({ primary = { card }, secondary = { card } })
--     card = { name, rank, icon, skill, max, crafting, recipes = { learned,
--       total } (nil: not counted yet), spells = { spell } },
--       or { name, rank, icon, untrained = true, hint } for one not learned
--       (dimmed, the hint where the skill bar goes)
--     spell = { name, icon, active, onClick, onEnter(owner), onLeave, onDrag }
--     card.onDrag()           -- the card dragged (its profession's own spell)
--     card.onUnlearn()        -- a learned one: the trash glyph in its corner
--     p.onOpen(card)          -- a crafting profession's card clicked
--   p:SetCrafting({ name, rank, skill, max, recipes = { learned, total },
--       categories = { { name, recipes } },
--       selected (recipe id) })
--     a category with flat = true: no header (a list sorted across them all)
--     recipe = { id, name, difficulty (0 optimal .. 3 trivial), canMake,
--       tracked, learned }
--   p:SetRecipe(r)            -- the chosen recipe, or nil
--     r = { name, quality (0-5), qualityName ("rare"), icon, makes, desc,
--       tools = { { name, met } }, reagents = { { name, icon, quality,
--       qualityName, have, need } }, cooldown (text), source (where to
--       learn it: { item = { icon, name, quality, qualityName, note,
--       onEnter(owner) }, lines = { text } }), tracked,
--       canMake, ready, why, onProduct(owner), onReagent(i, owner) }
--   p.onSelect(id), p.onRecipeEnter(recipe, owner), p.onSearch(text),
--   p.onFilters({ show = "all" | "learned" | "unlearned", difficulty = { "optimal",
--       "medium", "easy", "trivial" }, quality = { 0..4 }, other = { "materials",
--       "skillup" } }), p.onSort("category" | "difficulty" | "skill" | "level" | "name"),
--   p:SetFilters(value), p:SetSort(key), p.onTrack(on),
--   p.onCreate(count), p.onCreateAll(),
--   p.onLink()                -- the Link button: the profession in chat
--   p.onLinkRecipe(id)        -- a recipe or its product Shift-clicked

import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as controls from "/UI/Controls"
import * as draw from "/UI/Draw"
import * as filterMenu from "/UI/FilterMenu"
import * as uiIcon from "/UI/Icon"
import * as inputs from "/UI/Inputs"
import * as inventory from "/UI/Inventory"
import * as panel from "/UI/Panel"
import * as selectModule from "/UI/Select"
import * as tabMarker from "/UI/TabMarker"
import * as uiText from "/UI/Text"

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local RAIL_W = 44
local LIST_W = 250
local ROW_H = 20
local QUALITY: { [number]: string } = { [0] = "quality-poor", "quality-common", "quality-uncommon", "quality-rare", "quality-epic", "quality-legendary" }
-- the game's difficulty colours (the ones quest titles use)
local DIFFICULTY: { [number]: string } = { [0] = "quest-very-difficult", "quest-difficult", "quest-standard", "quest-trivial" }

export const PROFESSIONS_W = 720
export const PROFESSIONS_H = 600

-- a thin bar with its numbers ("83 / 150"), a caption before it ("Skill")
local BAR_LABEL_W = 50
local function skillBar(parent: any, label: string?): any
    local f = CreateFrame("Frame", nil, parent)
    f:SetHeight(T.type.numeric.lineHeight)
    f.num = uiText.text(f, "numeric", "ink")
    f.num:SetPoint("RIGHT")
    f.track = draw.fill(f, "track", "ARTWORK")
    f.track:SetHeight(6)
    if label then
        f.label = uiText.text(f, "caption", "ink-muted")
        f.label:SetPoint("LEFT")
        f.label:SetValue(label)
        f.track:SetPoint("LEFT", f, "LEFT", BAR_LABEL_W, 0)
    else
        f.track:SetPoint("LEFT") -- wowlua: coverage ignore (every bar has its caption)
    end
    f.track:SetPoint("RIGHT", f.num, "LEFT", -S["space-4"], 0)
    f.fill = draw.fill(f, "progress-fill", "ARTWORK", 1)
    f.fill:SetHeight(6)
    f.fill:SetPoint("LEFT", f.track, "LEFT")
    function f:SetSkill(skill: number?, max: number?)
        self.skill, self.max = skill or 0, max or 0
        self.num:SetValue(self.skill .. " / " .. self.max)
        self:Draw()
    end
    -- the fill from the numbers kept (the width settles after the first
    -- layout: drawn again then, the numbers untouched)
    function f:Draw()
        local frac = (self.max or 0) > 0 and math.min(1, (self.skill or 0) / self.max) or 0
        local w = self.track:GetWidth()
        self.fill:SetShown(frac > 0 and w > 0)
        if w > 0 then self.fill:SetWidth(math.max(0.01, w * frac)) end
    end
    f:SetScript("OnSizeChanged", function(self) if self.max then self:Draw() end end)
    return f
end

--------------------------------------------------------------------------------
-- The rail
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- Overview
--------------------------------------------------------------------------------

local function makeSpell(parent: any): any
    local s = CreateFrame("Button", nil, parent)
    s:SetSize(120, 22)
    s.icon = uiIcon.icon(s, 20)
    s.icon:SetPoint("LEFT")
    s.label = uiText.text(s, "caption", "ink-muted")
    s.label:SetPoint("LEFT", s.icon, "RIGHT", S["space-3"], 0)
    s:SetScript("OnClick", function(self) if self.spell and self.spell.onClick then self.spell.onClick() end end)
    -- a gilt edge under the mouse: it does something (asked for in game)
    s:SetScript("OnEnter", function(self)
        self.icon:SetBorder("gilt")
        if self.spell and self.spell.onEnter then self.spell.onEnter(self) end
    end)
    s:SetScript("OnLeave", function(self)
        self.icon:SetBorder(self.spell and self.spell.active and "arcane" or nil)
        if self.spell and self.spell.onLeave then self.spell.onLeave() end
    end)
    -- onto an action bar (Disenchant: asked for in game)
    s:RegisterForDrag("LeftButton")
    s:SetScript("OnDragStart", function(self) if self.spell and self.spell.onDrag then self.spell.onDrag() end end)
    return s
end

local function makeCard(view: any): any
    local c = CreateFrame("Button", nil, view.overview)
    draw.fill(c, "surface-sunk"):SetAllPoints()
    c.border = draw.border(c, "gilt-faint")
    c.icon = uiIcon.icon(c, "icon-lg")
    c.icon:SetPoint("TOPLEFT", S["space-5"], -S["space-5"])
    c.name = uiText.text(c, "header", "gilt-text")
    c.name:SetPoint("TOPLEFT", c.icon, "TOPRIGHT", S["space-4"], -1)
    c.rank = uiText.text(c, "caption", "ink-muted")
    c.rank:SetPoint("TOPLEFT", c.name, "BOTTOMLEFT", 0, -1)
    c.open = uiText.text(c, "caption", "gilt-text")
    c.open:SetPoint("TOPRIGHT", -S["space-5"], -S["space-5"] - 2)
    c.skill = skillBar(c, "Skill")
    c.skill:SetPoint("TOPLEFT", c.icon, "BOTTOMLEFT", 0, -S["space-4"])
    c.skill:SetPoint("RIGHT", c, "RIGHT", -S["space-5"], 0)
    -- a crafting profession's recipes: learned of all (counted when it was
    -- last open)
    c.recipes = skillBar(c, "Recipes")
    c.recipes:SetPoint("TOPLEFT", c.skill, "BOTTOMLEFT", 0, -S["space-3"])
    c.recipes:SetPoint("RIGHT", c, "RIGHT", -S["space-5"], 0)
    c.recipesHint = uiText.text(c, "caption", "ink-faint")
    c.recipesHint:SetPoint("LEFT", c.recipes, "LEFT", 0, 0)
    c.spells = {}
    c.empty = uiText.text(c, "caption", "ink-muted")
    c.empty:SetPoint("CENTER")
    c.hint = uiText.text(c, "caption", "ink-faint")
    c.hint:SetPoint("LEFT", c.skill, "LEFT", 0, 0)
    -- Unlearn: a quiet trash glyph in the bottom right corner of a learned
    -- one (always there: shown only on hover, it never showed in game);
    -- the game's own confirmation
    c.unlearn = CreateFrame("Button", nil, c)
    c.unlearn:SetSize(22, 22)
    c.unlearn:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-4"])
    c.unlearn.edge = draw.border(c.unlearn, "gilt-line")
    c.unlearn.edge:SetShown(false)
    c.unlearn.glyph = c.unlearn:CreateTexture(nil, "ARTWORK")
    c.unlearn.glyph:SetTexture(GLYPHS .. "trash.tga")
    c.unlearn.glyph:SetSize(14, 14) -- even, like the button: whole pixels each side
    c.unlearn.glyph:SetPoint("CENTER")
    draw.paint(c.unlearn.glyph, "ink-faint")
    c.unlearn:SetFrameLevel(c:GetFrameLevel() + 5)
    c.unlearn:Hide()
    c.unlearn:SetScript("OnEnter", function(self)
        self.edge:SetShown(true)
        draw.paint(self.glyph, "ember-text")
        GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
        GameTooltip_SetTitle(GameTooltip, "Unlearn " .. (c.card and c.card.name or ""))
        GameTooltip_AddNormalLine(GameTooltip, "You lose your skill and the recipes you know.")
        GameTooltip:Show()
    end)
    c.unlearn:SetScript("OnLeave", function(self)
        self.edge:SetShown(false)
        draw.paint(self.glyph, "ink-faint")
        GameTooltip:Hide()
    end)
    c.unlearn:SetScript("OnClick", function() if c.card and c.card.onUnlearn then c.card.onUnlearn() end end)
    c:SetScript("OnEnter", function(self)
        if self.card and self.card.crafting then self.border:SetColor("gilt-line") end
        if self.card and self.card.onDrag then self.icon:SetBorder("gilt") end
    end)
    c:SetScript("OnLeave", function(self)
        self.border:SetColor("gilt-faint")
        self.icon:SetBorder(nil)
    end)
    c:SetScript("OnClick", function(self) if self.card and self.card.crafting and view.onOpen then view.onOpen(self.card) end end)
    -- the card dragged: the profession's own spell (Enchanting) onto a bar
    c:RegisterForDrag("LeftButton")
    c:SetScript("OnDragStart", function(self) if self.card and self.card.onDrag then self.card.onDrag() end end)
    return c
end

-- a card's height: its head and bars, then its spells one under another
-- (side by side they ran into the Unlearn glyph: found in game), as many
-- rows as the profession with the most has
local SPELL_H = 22
local function cardHeight(rows: number?): number
    rows = math.max(1, rows or 1)
    return S["space-5"] * 2 + 30 + S["space-4"] + T.type.numeric.lineHeight * 2 + S["space-3"] + S["space-4"]
        + rows * SPELL_H + (rows - 1) * S["space-2"]
end

local function fillCard(c: any, card: any, empty: string?)
    c.card = card
    local has = card ~= nil
    c.icon:SetShown(has); c.name:SetShown(has); c.rank:SetShown(has); c.skill:SetShown(has); c.open:SetShown(has and card.crafting)
    c.empty:SetShown(not has)
    if not has then
        c.empty:SetValue(empty or "Learn a profession from a trainer")
        c.hint:Hide()
        c.unlearn:Hide()
        c.recipes:Hide(); c.recipesHint:Hide()
        for _, s in ipairs(c.spells) do s:Hide() end
        return
    end
    c.icon:SetArt(card.icon)
    c.name:SetValue(card.name or "")
    c.rank:SetValue(card.rank or "")
    c.open:SetValue("Recipes")
    -- not learned: dimmed, how to learn it where the skill bar goes
    local off = card.untrained and true or false
    c.icon:SetState(off and "dim" or "rest")
    c.name:SetColor(off and "ink-muted" or "gilt-text")
    c.skill:SetShown(not off)
    c.hint:SetShown(off)
    c.hint:SetValue(card.hint or "")
    c.skill:SetSkill(card.skill, card.max)
    local counted = card.crafting and not off and card.recipes
    c.recipes:SetShown(counted and true or false)
    if counted then c.recipes:SetSkill(card.recipes.learned, card.recipes.total) end
    c.recipesHint:SetShown(card.crafting and not off and not counted or false)
    c.recipesHint:SetValue("Recipes: open it once to count them")
    c.unlearn:SetShown(card.onUnlearn ~= nil)
    local below = (card.crafting and not off) and c.recipes or c.skill
    local y = S["space-4"]
    for i, sp in ipairs(card.spells or {}) do
        local s = c.spells[i] or makeSpell(c)
        c.spells[i] = s
        s.spell = sp
        s.icon:SetArt(sp.icon)
        s.icon:SetBorder(sp.active and "arcane" or nil)
        s.icon:SetGlow(sp.active and "glow-arcane" or nil)
        s.label:SetValue(sp.name or "")
        s.label:SetColor(sp.active and "arcane" or (sp.onClick and "ink" or "ink-muted"))
        local w = 20 + S["space-3"] + math.ceil(s.label:GetUnboundedStringWidth()) + 2
        s:SetWidth(w)
        s:ClearAllPoints()
        s:SetPoint("TOPLEFT", below, "BOTTOMLEFT", 0, -y)
        s:Show()
        y = y + SPELL_H + S["space-2"]
    end
    for i = #(card.spells or {}) + 1, #c.spells do c.spells[i]:Hide() end
end

--------------------------------------------------------------------------------
-- Crafting: the recipe list
--------------------------------------------------------------------------------

local function makeListRow(view: any): any
    local r = CreateFrame("Button", nil, view.list.child)
    r:SetHeight(ROW_H)
    r.sel = draw.fill(r, "arcane-soft", "BACKGROUND")
    r.sel:SetAllPoints()
    r.selEdge = draw.fill(r, "arcane", "ARTWORK")
    r.selEdge:SetWidth(2)
    r.selEdge:SetPoint("TOPLEFT")
    r.selEdge:SetPoint("BOTTOMLEFT")
    r.hover = draw.fill(r, "gilt-faint", "BACKGROUND", 1)
    r.hover:SetAllPoints()
    r.hover:Hide()
    r.chevron = r:CreateTexture(nil, "ARTWORK")
    r.chevron:SetSize(10, 10)
    r.chevron:SetPoint("LEFT", 2, 0)
    draw.paint(r.chevron, "gilt-text")
    r.eye = r:CreateTexture(nil, "ARTWORK")
    r.eye:SetTexture(GLYPHS .. "eye.tga")
    r.eye:SetSize(12, 12)
    r.eye:SetPoint("RIGHT", -S["space-3"], 0)
    draw.paint(r.eye, "gilt-text")
    r.count = uiText.text(r, "caption", "ink-muted")
    r.count:SetPoint("RIGHT", r.eye, "LEFT", -S["space-3"], 0)
    r.label = uiText.text(r, "label", "ink")
    r.label:SetPoint("LEFT", r, "LEFT", S["space-5"], 0)
    r.label:SetPoint("RIGHT", r.count, "LEFT", -S["space-3"], 0)
    r.label:SetJustifyH("LEFT")
    r:SetScript("OnEnter", function(self)
        self.hover:Show()
        if self.recipe and view.onRecipeEnter then view.onRecipeEnter(self.recipe, self) end
    end)
    r:SetScript("OnLeave", function(self) self.hover:Hide(); GameTooltip:Hide() end)
    r:SetScript("OnClick", function(self)
        if self.category then
            view.folded[self.category] = not view.folded[self.category]
            view:DrawList()
        elseif self.recipe and IsModifiedClick("CHATLINK") and view.onLinkRecipe then
            -- Shift-click: the recipe's link in chat
            view.onLinkRecipe(self.recipe.id)
        elseif self.recipe and view.onSelect then
            view.onSelect(self.recipe.id)
        end
    end)
    return r
end

--------------------------------------------------------------------------------
-- Crafting: the chosen recipe
--------------------------------------------------------------------------------

local function makeReagent(view: any): any
    local r = CreateFrame("Frame", nil, view.recipe.body)
    r:SetHeight(32)
    r.slot = inventory.itemSlot(r, 30)
    r.slot:SetPoint("LEFT")
    r.slot:SetScript("OnEnter", function(self) if view.recipeData and view.recipeData.onReagent then view.recipeData.onReagent(self.index, self) end end)
    r.slot:SetScript("OnLeave", function() GameTooltip:Hide() end)
    r.count = uiText.text(r, "numeric", "ink")
    r.count:SetPoint("RIGHT")
    r.name = uiText.text(r, "label", "ink")
    r.name:SetPoint("LEFT", r.slot, "RIGHT", S["space-4"], 0)
    r.name:SetPoint("RIGHT", r.count, "LEFT", -S["space-4"], 0)
    r.name:SetJustifyH("LEFT")
    return r
end

-- The recipe list's filters (design board "Professions · Filters"):
-- what the module reads, by group key.
local FILTER_GROUPS: any[] = {
    { key = "show", label = "Show", kind = "one", options = {
        { value = "all", label = "All" }, { value = "learned", label = "Learned" },
        { value = "unlearned", label = "Unlearned" } } },
    { key = "difficulty", label = "Difficulty", kind = "many", options = {
        { value = "optimal", label = "Optimal", color = "quest-very-difficult" },
        { value = "medium", label = "Medium", color = "quest-difficult" },
        { value = "easy", label = "Easy", color = "quest-standard" },
        { value = "trivial", label = "Trivial", color = "quest-trivial" } } },
    { key = "quality", label = "Product quality", kind = "many", options = {
        { value = 0, label = "Poor", color = "quality-poor" }, { value = 1, label = "Common", color = "quality-common" },
        { value = 2, label = "Uncommon", color = "quality-uncommon" }, { value = 3, label = "Rare", color = "quality-rare" },
        { value = 4, label = "Epic", color = "quality-epic" } } },
    { key = "other", label = "Other", kind = "toggles", options = {
        { value = "materials", label = "Have materials" }, { value = "skillup", label = "Skill up" } } },
}
export const PROFESSION_FILTER_DEFAULTS = { show = "learned", difficulty = {}, quality = {}, other = {} } :: { [string]: any }

local SORTS: any[] = {
    { value = "category", label = "Category", summary = "Sort: Category" },
    { value = "difficulty", label = "Difficulty", summary = "Sort: Difficulty" },
    { value = "skill", label = "Skill required", summary = "Sort: Skill" },
    { value = "level", label = "Level to use", summary = "Sort: Level" },
    { value = "name", label = "Name", summary = "Sort: Name" },
}

local views: { [any]: boolean } = setmetatable({}, { __mode = "k" })
events.on("SUUUI_THEME_CHANGED", function()
    for f in pairs(views) do f:PlaceForType() end
end, "UI.Professions")

--------------------------------------------------------------------------------
-- The whole
--------------------------------------------------------------------------------

export class Professions extends Frame
    edgeInset: any
    tabs: any
    cards: any
    listRows: any
    folded: any
    rail: Frame
    main: Frame
    overview: Frame
    primaryHead: any
    primaryCount: any
    secondaryHead: any
    crafting: Frame
    craftRank: any
    craftName: any
    craftSkill: any
    craftRecipes: any
    link: Button
    search: any
    filterMenu: any
    sort: any
    listBox: Frame
    list: any
    listEmpty: any
    recipe: any
    tabList: any? = nil
    tabMarker: any? = nil
    mode: string? = nil
    overviewData: any? = nil
    recipeData: any? = nil
    recipeShown: any? = nil
    craftData: any? = nil

    constructor(parent: any, opts: { [string]: any }?)
        super(nil, parent)
        self.edgeInset = opts and opts.edgeInset or 20
        self.tabs, self.cards, self.listRows, self.folded = {}, {}, {}, {}
        -- the rail
        self.rail = CreateFrame("Frame", nil, self)
        self.rail:SetPoint("TOPRIGHT")
        self.rail:SetPoint("BOTTOMRIGHT")
        self.rail:SetWidth(RAIL_W)
        local divider = draw.fill(self, "gilt-faint", "ARTWORK")
        divider:SetWidth(1)
        divider:SetPoint("TOPRIGHT", self.rail, "TOPLEFT", 0, 0)
        divider:SetPoint("BOTTOMRIGHT", self.rail, "BOTTOMLEFT", 0, 0)
        self.main = CreateFrame("Frame", nil, self)
        self.main:SetPoint("TOPLEFT")
        self.main:SetPoint("BOTTOMRIGHT", self.rail, "BOTTOMLEFT", -S["space-5"], 0)
        -- the overview
        self.overview = CreateFrame("Frame", nil, self.main)
        self.overview:SetAllPoints()
        self.primaryHead = uiText.text(self.overview, "header", "gilt-text")
        self.primaryCount = uiText.text(self.overview, "caption", "ink-muted")
        self.primaryCount:SetPoint("LEFT", self.primaryHead, "RIGHT", S["space-4"], 0)
        self.secondaryHead = uiText.text(self.overview, "header", "gilt-text")
        -- crafting
        self.crafting = CreateFrame("Frame", nil, self.main)
        self.crafting:SetAllPoints()
        self.crafting:Hide()
        self.craftRank = uiText.text(self.crafting, "caption", "ink-muted")
        self.craftRank:SetPoint("TOPRIGHT", 0, 0)
        self.craftName = uiText.text(self.crafting, "header", "gilt-text")
        self.craftName:SetPoint("TOPLEFT", 0, 0)
        self.craftSkill = skillBar(self.crafting, "Skill")
        self.craftSkill:SetPoint("LEFT", self.craftName, "RIGHT", S["space-5"], 0)
        self.craftRecipes = skillBar(self.crafting, "Recipes")
        self.craftRecipes:SetPoint("LEFT", self.craftSkill, "RIGHT", S["space-5"] * 2, 0)
        -- Link: the profession in chat, at the end of the head row (design
        -- board "Professions · Link")
        self.link = CreateFrame("Button", nil, self.crafting)
        self.link:SetSize(22, 22)
        self.link.edge = draw.border(self.link, "gilt-line")
        self.link.edge:SetShown(false)
        self.link.glyph = self.link:CreateTexture(nil, "ARTWORK")
        self.link.glyph:SetTexture(GLYPHS .. "chain.tga")
        self.link.glyph:SetSize(14, 14)
        self.link.glyph:SetPoint("CENTER")
        draw.paint(self.link.glyph, "ink-muted")
        self.link:SetScript("OnEnter", function(obj)
            obj.edge:SetShown(true)
            draw.paint(obj.glyph, "ink")
            local name = self.craftData and self.craftData.name or "this profession"
            GameTooltip:SetOwner(obj, "ANCHOR_BOTTOMLEFT")
            GameTooltip_SetTitle(GameTooltip, "Link " .. name .. " in chat")
            GameTooltip_AddNormalLine(GameTooltip, "Whoever clicks it sees your recipes.")
            GameTooltip_AddBlankLineToTooltip(GameTooltip)
            GameTooltip_AddNormalLine(GameTooltip, "Shift-click a recipe, in the list or its product, to link that recipe.")
            GameTooltip:Show()
        end)
        self.link:SetScript("OnLeave", function(obj)
            obj.edge:SetShown(false)
            draw.paint(obj.glyph, "ink-muted")
            GameTooltip:Hide()
        end)
        self.link:SetScript("OnClick", function() if self.onLink then self.onLink() end end)
        -- the list: search on its own row, the filters and the sort under it
        -- (one row of the three didn't fit the 250 px column), then the recipes
        self.search = inputs.textField(self.crafting, { width = LIST_W, placeholder = "Search recipes",
            onTextChanged = function(text: string) if self.onSearch then self.onSearch(text) end end })
        local half = math.floor((LIST_W - S["space-3"]) / 2)
        self.filterMenu = filterMenu.filterMenu(self.crafting, { groups = FILTER_GROUPS, defaults = PROFESSION_FILTER_DEFAULTS,
            width = half, onChange = function(v) if self.onFilters then self.onFilters(v) end end })
        self.filterMenu:SetPoint("TOPLEFT", self.search, "BOTTOMLEFT", 0, -S["space-3"])
        self.sort = selectModule.select(self.crafting, { width = LIST_W - half - S["space-3"], options = SORTS, value = "category",
            onChange = function(v) if self.onSort then self.onSort(v) end end })
        self.sort:SetPoint("LEFT", self.filterMenu, "RIGHT", S["space-3"], 0)
        self.listBox = CreateFrame("Frame", nil, self.crafting)
        self.listBox:SetPoint("TOPLEFT", self.filterMenu, "BOTTOMLEFT", 0, -S["space-4"])
        self.listBox:SetPoint("BOTTOM", self.crafting, "BOTTOM", 0, 0)
        self.listBox:SetWidth(LIST_W)
        draw.fill(self.listBox, "surface-sunk"):SetAllPoints()
        draw.border(self.listBox, "gilt-faint")
        self.list = panel.scrollArea(self.listBox, 2)
        self.list:SetPoint("TOPLEFT", S["space-2"], -S["space-3"])
        self.list:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-3"])
        self.listEmpty = uiText.text(self.listBox, "caption", "ink-muted")
        self.listEmpty:SetPoint("CENTER")
        self.listEmpty:SetValue("No recipes match")
        self.listEmpty:Hide()
        -- the recipe
        local v = CreateFrame("Frame", nil, self.crafting)
        self.recipe = v
        v:SetPoint("TOPLEFT", self.listBox, "TOPRIGHT", S["space-6"], 0)
        v:SetPoint("BOTTOMRIGHT", self.crafting, "BOTTOMRIGHT", 0, 0)
        v.none = uiText.text(v, "caption", "ink-muted")
        v.none:SetPoint("CENTER")
        v.none:SetValue("Choose a recipe")
        -- the foot: Track, quantity, Create all, Create
        v.foot = CreateFrame("Frame", nil, v)
        v.foot:SetPoint("BOTTOMLEFT")
        v.foot:SetPoint("BOTTOMRIGHT")
        v.foot:SetHeight(30)
        v.why = uiText.text(v, "caption", "ember-text")
        v.why:SetPoint("BOTTOMRIGHT", v.foot, "TOPRIGHT", 0, S["space-3"])
        -- everything above it scrolls when it's taller than the pane
        v.scroll = panel.scrollArea(v, S["space-3"])
        v.scroll:SetPoint("TOPLEFT")
        v.body = v.scroll.child
        v.scroll:HookScript("OnSizeChanged", function(obj) v.body:SetWidth(math.max(1, obj:GetWidth())) end)
        local c = v.body
        v.product = inventory.itemSlot(c, 36)
        v.product:SetPoint("TOPLEFT")
        v.product:SetScript("OnEnter", function(obj) if self.recipeData and self.recipeData.onProduct then self.recipeData.onProduct(obj) end end)
        v.product:SetScript("OnClick", function()
            if IsModifiedClick("CHATLINK") and self.onLinkRecipe and self.craftData and self.craftData.selected then
                self.onLinkRecipe(self.craftData.selected)
            end
        end)
        v.product:SetScript("OnLeave", function() GameTooltip:Hide() end)
        v.title = uiText.text(c, "unit-name-lg", "ink")
        v.title:SetPoint("TOPLEFT", v.product, "TOPRIGHT", S["space-5"], 0)
        v.title:SetPoint("RIGHT", c, "RIGHT")
        v.title:SetJustifyH("LEFT")
        v.makes = uiText.text(c, "caption", "ink-muted")
        v.makes:SetPoint("TOPLEFT", v.title, "BOTTOMLEFT", 0, -1)
        v.desc = uiText.text(c, "caption", "ink-muted")
        v.desc:SetPoint("TOPLEFT", v.makes, "BOTTOMLEFT", 0, -1)
        v.desc:SetPoint("RIGHT", c, "RIGHT")
        v.desc:SetJustifyH("LEFT")
        v.desc:SetWordWrap(true)
        v.tools, v.reagents = {}, {}
        v.reagentHead = uiText.text(c, "header", "gilt-text")
        v.reagentHead:SetValue("Reagents")
        v.cooldown = uiText.text(c, "caption", "amber")
        v.source = uiText.text(c, "caption", "ink-muted")
        v.source:SetJustifyH("LEFT")
        v.source:SetWordWrap(true)
        v.source:SetSpacing(2)
        v.sourceHead = uiText.text(c, "header", "gilt-text")
        v.sourceHead:SetValue("Source")
        v.sourceItem = makeReagent(self)
        v.sourceItem.slot:SetScript("OnEnter", function(obj)
            local src = self.recipeData and self.recipeData.source
            if src and src.item and src.item.onEnter then src.item.onEnter(obj) end
        end)
        v.sourceItem:Hide()
        v.create = controls.button(v.foot, { text = "Create", variant = "primary",
            onClick = function() if self.onCreate then self.onCreate(v.qty.value or 1) end end })
        v.create:SetPoint("BOTTOMRIGHT")
        v.createAll = controls.button(v.foot, { text = "Create all", variant = "quiet",
            onClick = function() if self.onCreateAll then self.onCreateAll() end end })
        v.createAll:SetPoint("RIGHT", v.create, "LEFT", -S["space-3"], 0)
        v.qty = inputs.stepper(v.foot, { min = 1, max = 1, value = 1 })
        v.qty:SetPoint("RIGHT", v.createAll, "LEFT", -S["space-3"], 0)
        v.track = inputs.checkbox(v.foot, { label = "Track", onChange = function(on: boolean) if self.onTrack then self.onTrack(on) end end })
        v.track:SetPoint("LEFT", v.foot, "LEFT", 0, 0)
        self:PlaceForType()
        self:SetRecipe(nil)
        views[self] = true
    end

    function SetTabs(list: any[]?, selected: any)
        self.tabList = list or {}
        -- the chosen one's jewel, gliding along the rail (tabMarker)
        self.tabMarker = self.tabMarker or tabMarker.tabMarker(self.rail, { vertical = true, side = "LEFT", x = -6, jewel = 7 })
        local chosen: any
        for i, t in ipairs(self.tabList) do
            local b = self.tabs[i]
            if not b then
                b = CreateFrame("Button", nil, self.rail) :: any
                b:SetSize(32, 32)
                b.icon = uiIcon.icon(b, 28)
                b.icon:SetPoint("CENTER")
                b.glyph = b:CreateTexture(nil, "OVERLAY")
                b.glyph:SetSize(16, 16)
                b.glyph:SetPoint("CENTER")
                b:SetScript("OnClick", function(tab) if tab.key and tab.owner.onTab then tab.owner.onTab(tab.key) end end)
                b:SetScript("OnEnter", function(tab)
                    GameTooltip:SetOwner(tab, "ANCHOR_LEFT")
                    GameTooltip_SetTitle(GameTooltip, tab.label or "")
                    GameTooltip:Show()
                end)
                b:SetScript("OnLeave", function() GameTooltip:Hide() end)
                self.tabMarker:Track(b)
                self.tabs[i] = b
            end
            b.owner, b.key, b.label = self, t.key, t.label
            b:ClearAllPoints()
            -- centred between the divider and the window's edge (edgeInset past
            -- the page), as the Spellbook's schools are
            b:SetPoint("TOP", self.rail, "TOP", self.edgeInset / 2, -(i - 1) * (32 + S["space-4"]))
            if t.icon then
                b.icon:SetArt(t.icon)
                b.icon:Show()
                b.glyph:Hide()
            else
                b.icon:SetArt(nil)
                b.icon:Show()
                b.glyph:SetTexture(GLYPHS .. (t.glyph or "book") .. ".tga")
                draw.paint(b.glyph, "gilt-text")
                b.glyph:Show()
            end
            local on = t.key == selected
            b.icon:SetBorder(on and "gilt" or "gilt-hairline")
            if on then chosen = b end
            b:Show()
        end
        for i = #self.tabList + 1, #self.tabs do self.tabs[i]:Hide() end
        self.tabMarker:SetChosen(chosen)
    end

    function SetOverview(d: any)
        d = d or {}
        self.mode = "overview"
        self.overviewData = d
        self.overview:Show()
        self.crafting:Hide()
        local w = self.overview:GetWidth()
        if not w or w <= 0 then w = PROFESSIONS_W - 40 - RAIL_W - S["space-5"] end
        local rows = 1
        for _, list in ipairs({ d.primary or {}, d.secondary or {} }) do
            for _, card in pairs(list) do rows = math.max(rows, #(card.spells or {})) end
        end
        local cardH = cardHeight(rows)
        local gap = S["space-5"]
        local y = 0
        self.primaryHead:ClearAllPoints()
        self.primaryHead:SetPoint("TOPLEFT", self.overview, "TOPLEFT", 0, -y)
        self.primaryHead:SetValue("Primary professions")
        self.primaryCount:SetValue(#(d.primary or {}) .. " of 2")
        y = y + T.type.header.lineHeight + S["space-4"]
        local half = math.floor((w - gap) / 2)
        for i = 1, 2 do
            local c = self.cards[i] or makeCard(self)
            self.cards[i] = c
            c:ClearAllPoints()
            c:SetPoint("TOPLEFT", self.overview, "TOPLEFT", (i - 1) * (half + gap), -y)
            c:SetSize(half, cardH)
            fillCard(c, d.primary and d.primary[i])
            c:Show()
        end
        y = y + cardH + S["space-6"]
        self.secondaryHead:ClearAllPoints()
        self.secondaryHead:SetPoint("TOPLEFT", self.overview, "TOPLEFT", 0, -y)
        self.secondaryHead:SetValue("Secondary professions")
        y = y + T.type.header.lineHeight + S["space-4"]
        local sec = d.secondary or {}
        local n = math.max(1, #sec)
        local third = math.floor((w - gap * 2) / 3)
        for i = 1, math.max(n, 3) do
            local c = self.cards[2 + i] or makeCard(self)
            self.cards[2 + i] = c
            local col, row = (i - 1) % 3, math.floor((i - 1) / 3)
            c:ClearAllPoints()
            c:SetPoint("TOPLEFT", self.overview, "TOPLEFT", col * (third + gap), -(y + row * (cardH + gap)))
            c:SetSize(third, cardH)
            if sec[i] then
                fillCard(c, sec[i])
                c:Show()
            else
                c:Hide()
            end
        end
        for i = 2 + math.max(n, 3) + 1, #self.cards do self.cards[i]:Hide() end
    end

    function DrawList()
        local d = self.craftData
        if not d then return end
        local child = self.list.child
        child:SetWidth(math.max(1, self.list:GetWidth()))
        local y, n = 0, 0
        local function row()
            n = n + 1
            local r = self.listRows[n] or makeListRow(self)
            self.listRows[n] = r
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -y)
            r:SetPoint("RIGHT", child, "RIGHT", -S["space-4"], 0)
            r:Show()
            y = y + ROW_H
            return r
        end
        for _, cat in ipairs(d.categories or {}) do
            -- a flat list (sorted across categories): no header, never folded
            local folded = not cat.flat and self.folded[cat.name]
            if not cat.flat then
                local r = row()
                r.category, r.recipe = cat.name, nil
                r.chevron:SetTexture(GLYPHS .. (folded and "chevronRight" or "chevronDown") .. ".tga")
                r.chevron:Show()
                r.eye:Hide()
                r.sel:Hide(); r.selEdge:Hide()
                r.label:SetStyle("header")
                r.label:SetColor("gilt-text")
                r.label:SetValue(cat.name or "")
                r.count:SetValue(tostring(#(cat.recipes or {})))
            end
            if not folded then
                for _, rec in ipairs(cat.recipes or {}) do
                    local rr = row()
                    rr.category, rr.recipe = nil, rec
                    rr.chevron:Hide()
                    rr.label:SetStyle("label")
                    rr.label:SetColor(rec.learned == false and "ink-faint" or (DIFFICULTY[rec.difficulty or 3] or "quest-trivial"))
                    rr.label:SetValue(rec.name or "")
                    rr.count:SetValue((rec.canMake or 0) > 0 and ("[" .. rec.canMake .. "]") or "")
                    rr.eye:SetShown(rec.tracked and true or false)
                    local on = rec.id == d.selected
                    rr.sel:SetShown(on); rr.selEdge:SetShown(on)
                end
            end
            y = y + S["space-2"]
        end
        for i = n + 1, #self.listRows do self.listRows[i]:Hide() end
        self.listEmpty:SetShown(n == 0)
        child:SetHeight(math.max(1, y))
    end

    function SetRecipe(r: any)
        self.recipeData = r
        local v = self.recipe
        local c = v.body
        local w = v.scroll:GetWidth()
        if w and w > 0 then c:SetWidth(w) end
        v.none:SetShown(r == nil)
        for _, part in ipairs({ v.product, v.title, v.makes, v.desc, v.reagentHead, v.foot }) do part:SetShown(r ~= nil) end
        if not r then
            for _, x in ipairs(v.tools) do x:Hide() end
            for _, x in ipairs(v.reagents) do x:Hide() end
            v.cooldown:Hide()
            v.source:Hide()
            v.sourceHead:Hide()
            v.sourceItem:Hide()
            v.why:Hide()
            return
        end
        v.product.skin:SetItem({ icon = r.icon, quality = r.qualityName })
        v.title:SetValue(r.name or "")
        v.title:SetColor(QUALITY[r.quality or 1] or "ink")
        v.makes:SetValue((r.makes and r.makes > 1) and ("Makes " .. r.makes) or "")
        v.desc:SetValue(r.desc or "")
        local y = 36 + S["space-4"]
        local dh = (r.desc and r.desc ~= "") and v.desc:GetStringHeight() or 0
        y = math.max(y, T.type["unit-name-lg"].lineHeight + T.type.caption.lineHeight + dh + S["space-4"])
        -- what it needs
        for i, t in ipairs(r.tools or {}) do
            local line = v.tools[i]
            if not line then
                line = CreateFrame("Frame", nil, c) :: any
                line:SetHeight(T.type.caption.lineHeight + 2)
                line.glyph = line:CreateTexture(nil, "ARTWORK")
                line.glyph:SetSize(11, 11)
                line.glyph:SetPoint("LEFT")
                line.text = uiText.text(line, "caption", "ink-muted")
                line.text:SetPoint("LEFT", line.glyph, "RIGHT", S["space-3"], 0)
                v.tools[i] = line
            end
            line:ClearAllPoints()
            line:SetPoint("TOPLEFT", v, "TOPLEFT", 0, -y)
            line:SetPoint("RIGHT", c, "RIGHT")
            line.glyph:SetTexture(GLYPHS .. (t.met and "check" or "close") .. ".tga")
            draw.paint(line.glyph, t.met and "fel" or "ember-text")
            line.text:SetValue("Requires " .. (t.name or ""))
            line.text:SetColor(t.met and "ink-muted" or "ember-text")
            line:Show()
            y = y + T.type.caption.lineHeight + 2
        end
        for i = #(r.tools or {}) + 1, #v.tools do v.tools[i]:Hide() end
        -- where a recipe not learned yet is learned: its recipe item (hover
        -- for its tooltip) and where that is, or a trainer
        local src = r.source
        v.sourceHead:SetShown(src ~= nil)
        v.sourceItem:SetShown(src ~= nil and src.item ~= nil)
        v.source:SetShown(src ~= nil and src.lines ~= nil and #src.lines > 0)
        if src then
            y = y + S["space-5"]
            v.sourceHead:ClearAllPoints()
            v.sourceHead:SetPoint("TOPLEFT", v, "TOPLEFT", 0, -y)
            y = y + T.type.header.lineHeight + S["space-3"]
            local item = src.item
            if item then
                local row = v.sourceItem
                row:ClearAllPoints()
                row:SetPoint("TOPLEFT", v, "TOPLEFT", 0, -y)
                row:SetPoint("RIGHT", c, "RIGHT")
                row.slot.skin:SetItem({ icon = item.icon, quality = item.qualityName })
                row.name:SetValue(item.name or "…")
                row.name:SetColor(QUALITY[item.quality or 1] or "ink")
                row.count:SetValue(item.note or "")
                row.count:SetColor("fel")
                y = y + 32 + S["space-2"]
            end
            if src.lines and #src.lines > 0 then
                v.source:ClearAllPoints()
                v.source:SetPoint("TOPLEFT", v, "TOPLEFT", 0, -y)
                v.source:SetWidth(math.max(100, c:GetWidth()))
                v.source:SetValue(table.concat(src.lines, "\n"))
                y = y + v.source:GetStringHeight()
            end
        end
        y = y + S["space-5"]
        v.reagentHead:ClearAllPoints()
        v.reagentHead:SetPoint("TOPLEFT", v, "TOPLEFT", 0, -y)
        y = y + T.type.header.lineHeight + S["space-4"]
        for i, g in ipairs(r.reagents or {}) do
            local row = v.reagents[i] or makeReagent(self)
            v.reagents[i] = row
            row.slot.index = i
            row:ClearAllPoints()
            row:SetPoint("TOPLEFT", v, "TOPLEFT", 0, -y)
            row:SetPoint("RIGHT", c, "RIGHT")
            local short = (g.have or 0) < (g.need or 0)
            row.slot.skin:SetItem({ icon = g.icon, quality = g.qualityName, dim = short })
            row.name:SetValue(g.name or "…")
            row.name:SetColor(short and "ink-muted" or (QUALITY[g.quality or 1] or "ink"))
            row.count:SetValue((g.have or 0) .. " / " .. (g.need or 0))
            row.count:SetColor(short and "ember-text" or "ink")
            row:Show()
            y = y + 32 + S["space-2"]
        end
        for i = #(r.reagents or {}) + 1, #v.reagents do v.reagents[i]:Hide() end
        v.cooldown:SetShown(r.cooldown ~= nil)
        if r.cooldown then
            v.cooldown:ClearAllPoints()
            v.cooldown:SetPoint("TOPLEFT", v, "TOPLEFT", 0, -(y + S["space-3"]))
            v.cooldown:SetValue("Cooldown " .. r.cooldown)
            y = y + S["space-3"] + T.type.caption.lineHeight
        end
        -- taller than the pane: it scrolls (a long Source pushed the reagents
        -- under the foot: found in game); a new recipe starts at its top
        c:SetHeight(math.max(1, y))
        if self.recipeShown ~= r.name then
            self.recipeShown = r.name
            v.scroll:SetVerticalScroll(0)
        end
        v.track:SetValue(r.tracked and true or false)
        local ready = r.ready and true or false
        v.create:SetEnabledState(ready)
        v.createAll:SetEnabledState(ready and (r.canMake or 0) > 1)
        v.createAll:SetLabel("Create all" .. ((r.canMake or 0) > 1 and (" (" .. r.canMake .. ")") or ""))
        v.qty.max = math.max(1, r.canMake or 1)
        if (v.qty.value or 1) > v.qty.max then v.qty:SetValue(v.qty.max) end
        v.qty:SetDisabled(not ready)
        v.why:SetShown(not ready and r.why ~= nil)
        v.why:SetValue(r.why or "")
    end

    -- The saved choices back in the controls.
    function SetFilters(value: any) self.filterMenu:SetValue(value) end

    function SetSort(key: string?) self.sort:SetValue(key or "category") end

    function SetCrafting(d: any)
        d = d or {}
        self.mode = "crafting"
        self.craftData = d
        self.overview:Hide()
        self.crafting:Show()
        self.craftName:SetValue(d.name or "")
        self.craftRank:SetValue(d.rank or "")
        self.craftSkill:SetSkill(d.skill, d.max)
        self.craftRecipes:SetShown(d.recipes ~= nil)
        if d.recipes then self.craftRecipes:SetSkill(d.recipes.learned, d.recipes.total) end
        -- the two bars share what the name and rank leave
        local gap = S["space-5"]
        local rankW = (d.rank and d.rank ~= "") and (self.craftRank:GetUnboundedStringWidth() + gap) or 0
        rankW = rankW + self.link:GetWidth() + gap
        local room = (self.crafting:GetWidth() or 0) - self.craftName:GetUnboundedStringWidth() - rankW - gap * 2
        local bar = d.recipes and math.floor((room - gap * 2) / 2) or room
        self.craftSkill:SetWidth(math.max(80, bar))
        self.craftRecipes:SetWidth(math.max(80, bar))
        self:DrawList()
    end

    -- What is sized from the text styles' line heights: when built, and again
    -- when a theme changes them (then what is shown too): the head row's bars
    -- and Link, the search, the recipe pane.
    function PlaceForType()
        local numeric = T.type.numeric.lineHeight
        self.craftSkill:SetHeight(numeric)
        self.craftRecipes:SetHeight(numeric)
        for _, c in ipairs(self.cards) do
            c.skill:SetHeight(numeric)
            c.recipes:SetHeight(numeric)
        end
        self.link:SetPoint("RIGHT", self.crafting, "TOPRIGHT", 0, -T.type.header.lineHeight / 2)
        self.search:SetPoint("TOPLEFT", self.crafting, "TOPLEFT", 0, -(T.type.header.lineHeight + S["space-5"]))
        local v = self.recipe
        v.scroll:SetPoint("BOTTOMRIGHT", v.foot, "TOPRIGHT", -S["space-4"],
            S["space-3"] + T.type.caption.lineHeight + S["space-3"])
        if self.mode == "overview" then
            self:SetOverview(self.overviewData)
        elseif self.mode == "crafting" then
            self:SetCrafting(self.craftData)
            self:SetRecipe(self.recipeData)
        end
    end
end

export function professions(parent: any, opts: { [string]: any }?): Professions
    return Professions.new(parent, opts)
end
