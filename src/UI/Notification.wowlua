-- UI/Notification.wowlua
-- Notifications (design boards "Notifications", "Notification stack"): a
-- glass card `notice-w` wide, gilt-line edge (amber for a warning, ember for
-- danger), space-4 inside: the head (a 24px icon, the category caption over
-- the title, the time for requests (amber under soonAt), a close button for
-- notes), then the body caption, the item it is about, the confirm field
-- ("Type DELETE to confirm"), what makes it go (hourglass, "Goes when you
-- repair"), the actions right-aligned, and a 2px drain along the foot.
--
--   local n = notification(parent)
--   n:SetData({ kind, tone, category, title, body, icon = { glyph | texture,
--               tooltip = fn(owner) },
--               bodyTooltip = { title, description },
--               duration, remaining, soonAt, ["until"], item = { icon,
--               label, quality }, confirmText, actions = { { label,
--               variant = "primary"|"quiet"|"danger", onClick,
--               count, pressed, disabled, tooltip } },
--               host = { buttons = n, confirm = true, roles = n }, warning,
--               closable, onClose })
--   0.13: source = { tool = true, channel = "LookingForGroup", text = "…" }:
--     where a Group Finder note came from (source badges: "Tool", the
--     channel) and the post as written in quotes, caption ink-muted, two
--     lines at most, the whole of it on hover; actions[i].icon = a glyph
--     left of a button's label.
--   0.13: host.roles = n: a row for the game's role buttons (a group invite
--     that asks for your role; the owner places them in n.rolesRow);
--     warning = "…": an amber caption under it (the invite takes you out
--     of your queue).
--   0.13: presence = { online, source ("Battle.net", "Friend", the guild's
--     name), people = { { name, color (a class token), tag (a BattleTag's
--     #1234), detail ("Kaelith · World of Warcraft Forever"), whisper = fn,
--     icon = { texture, coords } } }, invite = fn }: a friend or guild member
--     came online (a status diamond in arcane, their class icon, the name in
--     class colour, the detail, Whisper and Invite; a click whispers) or went offline
--     (one quiet line: an ink-faint diamond, the name in ink-muted, where
--     they're from at the right). Several at once: one card, "4 guild members
--     came online", each name whispering them (design board "Notifications ·
--     Friends").
--   n:SetRemaining(seconds)   -- the drain and the time, without a layout
--   n:SetTitle(text)          -- a title that counts (logging out in 12 s)
--   n.actionsRow, n.confirmBox  -- where hosted buttons and an edit box go
--   n.rolesRow                  -- where hosted role buttons go (0.13)
--
-- `host`: the actions (and the confirm box) belong to someone else, Blizzard's
-- own popup buttons placed by the owner into n.actionsRow (right-aligned,
-- `host.width` wide) and n.confirmBox; the card only keeps the room.
--
--   local s = notificationStack(parent, { max = 5 })
--   s:SetItems(list, inCombat)  -- each with an `id`; requests first, then
--                               -- conditions, notes, timed ones; in combat
--                               -- only requests and conditions
--   s:CardFor(id)               -- the card showing that id
--   s.onClearAll

import hook from "wowlua:hooks"
import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as events from "/Core/Events"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import button from "/UI/Controls"
import icon as iconFrame from "/UI/Icon"
import closeButton from "/UI/Panel"
import showTooltip, hideTooltip from "/UI/Tooltip"

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local WIDTH = T.size["notice-w"]
local PAD = S["space-4"]
local ICON = 24
local ACTION_H = 26
local FIELD_H = 30
-- a row of round role toggles: the 36px icon and its word under it
local function rolesH(): number return 36 + S["space-2"] + T.type.caption.lineHeight end

local TONE_EDGE: { [string]: string } = { warning = "amber", danger = "ember" }

local function clock(seconds: number): string
    local s = math.max(0, math.floor(seconds + 0.5))
    if s >= 60 then return ("%d:%02d"):format(math.floor(s / 60), s % 60) end
    return tostring(s)
end

-- A quiet, primary or danger button of the card's own (a SuuUI note); one
-- pool per look (a button's variant is set when it's made).
local function noteButton(n: any, i: number, variant: string): any
    local pool = n.buttons[variant]
    if not pool then pool = {}; n.buttons[variant] = pool end
    local b = pool[i]
    if b then return b end
    b = button(n.actionsRow, { text = "", variant = variant == "primary" and "primary" or "quiet" })
    b:SetHeight(ACTION_H)
    if variant == "danger" then
        b.border:SetColor("ember")
        b.label:SetColor("ember-text")
        b:HookScript("OnLeave", function(self) self.border:SetColor("ember") end)
    end
    -- a choice made stays pressed in arcane (a loot roll's)
    b.pressedBg = draw.fill(b, "arcane-soft", "BACKGROUND", 1)
    b.pressedBg:SetAllPoints()
    b.pressedBg:Hide()
    b:HookScript("OnLeave", function(self) if self.pressed then self.border:SetColor("arcane") end end)
    pool[i] = b
    return b
end

-- A name on a group presence card: whispers them.
local function nameButton(n: any, i: number): any
    local b = n.names[i]
    if b then return b end
    b = CreateFrame("Button", nil, n.namesRow)
    b.text = text(b, "label", "ink")
    b.text:SetPoint("LEFT")
    b:SetScript("OnEnter", function(self) self.text:SetAlpha(0.75) end)
    b:SetScript("OnLeave", function(self) self.text:SetAlpha(1) end)
    b:SetScript("OnClick", function(self) if self.person and self.person.whisper then self.person.whisper() end end)
    n.names[i] = b
    return b
end

local notes: { [any]: boolean } = setmetatable({}, { __mode = "k" })

export class Notification extends Frame
    buttons: any
    border: draw.Border
    head: Frame
    icon: Frame
    iconArt: Texture
    category: Text
    title: Text
    time: Text
    close: any
    bodyRow: Frame
    body: Text
    itemRow: Frame
    item: any
    itemLabel: Text
    confirmRow: Frame
    confirmLabel: Text
    confirmBox: Frame
    untilRow: Frame
    untilGlyph: Texture
    untilText: Text
    sourceRow: Frame
    badges: any
    quote: Text
    rolesRow: Frame
    warningRow: Frame
    warningText: Text
    actionsRow: Frame
    status: Texture
    source: Text
    namesRow: Frame
    names: any
    drain: Texture
    iconTip: any = nil
    onCardClick: any = nil
    data: any = nil

    constructor(parent: any)
        super(nil, parent)
        notes[self] = true
        self:SetSize(WIDTH, 80)
        self.buttons = {}
        draw.fill(self, "surface-glass", "BACKGROUND"):SetAllPoints()
        self.border = draw.border(self, "gilt-line")
        draw.shadow(self, "shadow-panel")
        self:EnableMouse(true)

        self.head = CreateFrame("Frame", nil, self)
        self.head:SetPoint("TOPLEFT", PAD, -PAD)
        self.head:SetPoint("TOPRIGHT", -PAD, -PAD)
        self.head:SetHeight(ICON)
        self.icon = CreateFrame("Frame", nil, self.head)
        self.icon:SetSize(ICON, ICON)
        draw.fill(self.icon, "surface-sunk"):SetAllPoints()
        draw.border(self.icon, "gilt-hairline", { layer = "OVERLAY" })
        self.iconArt = self.icon:CreateTexture(nil, "ARTWORK")
        -- icon.tooltip(owner): what hovering the icon shows (an item's tooltip)
        self.icon:EnableMouse(true)
        self.icon:SetScript("OnEnter", function(owner: Frame) if self.iconTip then self.iconTip(owner) end end)
        self.icon:SetScript("OnLeave", function() if self.iconTip then GameTooltip:Hide() end end)
        self.icon:SetPoint("TOPLEFT")
        self.category = text(self.head, "caption", "ink-muted")
        self.category:SetJustifyH("LEFT")
        self.title = text(self.head, "label", "ink")
        self.title:SetJustifyH("LEFT")
        self.title:SetWordWrap(true)
        self.time = text(self.head, "numeric", "ink-muted")
        self.close = closeButton(self.head, function()
            local d = self.data
            if d and d.onClose then d.onClose(self) end
        end)
        self.close:SetPoint("TOPRIGHT")

        self.bodyRow = CreateFrame("Frame", nil, self)
        self.body = text(self.bodyRow, "caption", "ink-muted")
        self.body:SetJustifyH("LEFT")
        self.body:SetWordWrap(true)
        self.body:SetPoint("TOPLEFT")
        -- bodyTooltip: what hovering the body shows (everyone still choosing)
        self.bodyRow:SetScript("OnEnter", function(row: Frame) if self.data and self.data.bodyTooltip then showTooltip(row, self.data.bodyTooltip) end end)
        self.bodyRow:SetScript("OnLeave", function() hideTooltip() end)

        self.itemRow = CreateFrame("Frame", nil, self)
        self.item = iconFrame(self.itemRow, 28)
        self.item:SetPoint("LEFT")
        self.itemLabel = text(self.itemRow, "label", "ink")
        self.itemLabel:SetPoint("LEFT", self.item, "RIGHT", S["space-4"], 0)

        self.confirmRow = CreateFrame("Frame", nil, self)
        self.confirmLabel = text(self.confirmRow, "caption", "ink-muted")
        self.confirmLabel:SetPoint("TOPLEFT")
        -- the field a hosted edit box sits on
        self.confirmBox = CreateFrame("Frame", nil, self.confirmRow)
        self.confirmBox:SetPoint("BOTTOMLEFT")
        self.confirmBox:SetPoint("BOTTOMRIGHT")
        self.confirmBox:SetHeight(FIELD_H)
        draw.fill(self.confirmBox, "surface-sunk", "BACKGROUND"):SetAllPoints()
        self.confirmBox.edge = draw.border(self.confirmBox, "gilt-line")

        self.untilRow = CreateFrame("Frame", nil, self)
        self.untilGlyph = self.untilRow:CreateTexture(nil, "ARTWORK")
        self.untilGlyph:SetTexture(GLYPHS .. "hourglass.tga")
        draw.paint(self.untilGlyph, "ink-muted")
        self.untilGlyph:SetSize(11, 11)
        self.untilGlyph:SetPoint("LEFT")
        self.untilText = text(self.untilRow, "caption", "ink-muted")
        self.untilText:SetPoint("LEFT", self.untilGlyph, "RIGHT", S["space-2"], 0)

        -- where a Group Finder note came from
        self.sourceRow = CreateFrame("Frame", nil, self)
        self.sourceRow:Hide()
        self.badges = {}
        self.quote = text(self.sourceRow, "caption", "ink-muted")
        self.quote:SetJustifyH("LEFT")
        self.quote:SetWordWrap(true)
        self.quote:SetMaxLines(2)
        self.sourceRow:SetScript("OnEnter", function(row)
            if row.post and self.quote:IsTruncated() then showTooltip(row, { description = row.post }) end
        end)
        self.sourceRow:SetScript("OnLeave", function() hideTooltip() end)

        self.rolesRow = CreateFrame("Frame", nil, self)
        self.rolesRow:Hide()
        self.warningRow = CreateFrame("Frame", nil, self)
        self.warningRow:Hide()
        self.warningText = text(self.warningRow, "caption", "amber")
        self.warningText:SetPoint("TOPLEFT")
        self.warningText:SetJustifyH("LEFT")
        self.warningText:SetWordWrap(true)

        self.actionsRow = CreateFrame("Frame", nil, self)

        -- presence: the status diamond, where they're from (offline), the names
        self.status = draw.diamond(self.head, 6, "arcane")
        self.status:Hide()
        self.source = text(self.head, "caption", "ink-faint")
        self.source:Hide()
        self.namesRow = CreateFrame("Frame", nil, self)
        self.namesRow:Hide()
        self.names = {}
        self:SetScript("OnMouseUp", function(_: Frame, mouseButton: string)
            if mouseButton == "LeftButton" and self.onCardClick then self.onCardClick() end
        end)

        self.drain = self:CreateTexture(nil, "OVERLAY")
        self.drain:SetPoint("BOTTOMLEFT", 1, 1)
        self.drain:SetHeight(2)
        self.drain:Hide()
        extend.add(extend.Kind.Notification, self, {})
    end

    function SetIcon(def: { [string]: any }?)
        local icon = def or {}
        self.iconTip = icon.tooltip
        local art = self.iconArt
        if icon.glyph then
            art:SetTexture(GLYPHS .. icon.glyph .. ".tga")
            art:SetTexCoord(0, 1, 0, 1)
            art:ClearAllPoints()
            art:SetPoint("TOPLEFT", 4, -4)
            art:SetPoint("BOTTOMRIGHT", -4, 4)
            draw.paint(art, icon.color or "ink")
        else
            art:SetTexture(icon.texture or (GLYPHS .. "bell.tga"))
            if icon.coords then art:SetTexCoord(unpack(icon.coords))
            else art:SetTexCoord(0.08, 0.92, 0.08, 0.92) end
            art:ClearAllPoints()
            art:SetPoint("TOPLEFT", 1, -1)
            art:SetPoint("BOTTOMRIGHT", -1, 1)
            art:SetVertexColor(1, 1, 1, 1)
        end
    end

    function SetTitle(title: string?)
        self.title:SetValue(title or "")
    end

    -- The presence layout (see SetData's presence).
    function SetPresence(d: { [string]: any }): number
        local p = d.presence
        local people = p.people or {}
        local single = #people == 1
        for _, f in ipairs({ self.bodyRow, self.itemRow, self.confirmRow, self.untilRow }) do f:Hide() end
        for _, pool in pairs(self.buttons) do for _, b in ipairs(pool) do b:Hide() end end
        for _, b in ipairs(self.names) do b:Hide() end
        self.namesRow:Hide()
        self.time:Hide()
        self.drain:Hide()
        self.border:SetColor("gilt-line")
        self.status:Show()
        draw.paint(self.status, p.online and "arcane" or "ink-faint")
        -- a click on the card: whisper the one person on it
        self.onCardClick = single and people[1].whisper or nil
        if not p.online then
            -- offline: one quiet line
            self.icon:Hide()
            self.close:Hide()
            self.category:Hide()
            local names: string[] = {}
            for i, person in ipairs(people) do
                if i > 2 then break end
                names[#names + 1] = person.name
            end
            local line = table.concat(names, ", ")
            if #people > 2 then line = line .. " and " .. (#people - 2) .. " more" end
            self.title:SetValue(line .. " went offline")
            self.title:SetColor("ink-muted")
            self.source:SetValue(p.source or "")
            self.source:Show()
            local lineH = T.type.label.lineHeight
            self.head:SetHeight(lineH)
            self.status:ClearAllPoints()
            self.status:SetPoint("CENTER", self.head, "LEFT", 4, 0)
            self.title:SetWidth(WIDTH - PAD * 2 - 14 - self.source:GetUnboundedStringWidth() - S["space-4"])
            self.title:ClearAllPoints()
            self.title:SetPoint("LEFT", self.head, "LEFT", 14, 0)
            self.source:ClearAllPoints()
            self.source:SetPoint("RIGHT", self.head, "RIGHT")
            self:SetHeight(PAD * 2 + lineH)
            return PAD * 2 + lineH
        end
        -- online
        self.icon:Show()
        self.source:Hide()
        self.close:Show()
        if single and people[1].icon then
            self:SetIcon(people[1].icon)
        else
            self:SetIcon({ glyph = p.glyph or "people" })
        end
        self.category:SetValue("Online · " .. (p.source or ""))
        self.category:Show()
        local title: string
        if single then
            local person = people[1]
            title = person.name .. (person.tag and ("|cff" .. T.color["ink-faint"].hex .. person.tag .. "|r") or "")
            self.title:SetColor(person.color or "ink")
        else
            title = #people .. " " .. (p.plural or "people") .. " came online"
            self.title:SetColor("ink")
        end
        self.title:SetValue(title)
        local textW = WIDTH - PAD * 2 - ICON - S["space-4"] - 22 - S["space-3"]
        self.title:SetWidth(textW)
        self.category:SetWidth(textW - 10)
        local titleH = T.type.label.lineHeight
        local catH = T.type.caption.lineHeight
        local headH = math.max(ICON, catH + titleH)
        self.head:SetHeight(headH)
        local top = math.max(0, (headH - catH - titleH) / 2)
        local x = ICON + S["space-4"]
        self.status:ClearAllPoints()
        self.status:SetPoint("CENTER", self.head, "TOPLEFT", x + 3, -(top + catH / 2))
        self.category:ClearAllPoints()
        self.category:SetPoint("TOPLEFT", x + 10, -top)
        self.title:ClearAllPoints()
        self.title:SetPoint("TOPLEFT", x, -(top + catH))
        local y = PAD + headH
        if single then
            local person = people[1]
            if person.detail and person.detail ~= "" then
                self.body:SetWidth(WIDTH - PAD * 2)
                self.body:SetValue(person.detail)
                local h = T.type.caption.lineHeight
                y = y + S["space-3"]
                self.bodyRow:ClearAllPoints()
                self.bodyRow:SetPoint("TOPLEFT", PAD, -y)
                self.bodyRow:SetPoint("TOPRIGHT", -PAD, -y)
                self.bodyRow:SetHeight(h)
                self.bodyRow:EnableMouse(false)
                self.bodyRow:Show()
                y = y + h
            end
            -- Whisper (always) and Invite (when they can be invited), right-aligned
            local actions: { label: string, onClick: () -> () }[] = {}
            if person.whisper then actions[#actions + 1] = { label = "Whisper", onClick = person.whisper } end
            if p.invite then actions[#actions + 1] = { label = "Invite", onClick = p.invite } end
            if #actions > 0 then
                y = y + S["space-3"]
                self.actionsRow:ClearAllPoints()
                self.actionsRow:SetPoint("TOPLEFT", PAD, -y)
                self.actionsRow:SetPoint("TOPRIGHT", -PAD, -y)
                self.actionsRow:SetHeight(ACTION_H)
                self.actionsRow:Show()
                local bx = 0
                for i = #actions, 1, -1 do
                    local a = actions[i]
                    local btn = noteButton(self, i, "quiet")
                    btn:SetLabel(a.label)
                    btn.pressed = false
                    btn.pressedBg:SetShown(false)
                    btn.border:SetColor("gilt-line")
                    btn.label:SetColor("ink")
                    btn:SetEnabledState(true)
                    btn.tooltip = nil
                    btn:SetScript("OnClick", function() a.onClick() end)
                    btn:ClearAllPoints()
                    btn:SetPoint("RIGHT", -bx, 0)
                    btn:Show()
                    bx = bx + btn:GetWidth() + S["space-3"]
                end
                y = y + ACTION_H
            else
                self.actionsRow:Hide()
            end
        else
            -- the names, each whispering them, wrapping
            self.actionsRow:Hide()
            y = y + S["space-3"]
            local inner, x2, rowY = WIDTH - PAD * 2, 0, 0
            local lineH = T.type.label.lineHeight
            for i, person in ipairs(people) do
                local b = nameButton(self, i)
                b.person = person
                local sep = i < #people and "," or ""
                b.text:SetValue(person.name .. sep)
                b.text:SetColor(person.color or "ink")
                local w = math.ceil(b.text:GetUnboundedStringWidth())
                if x2 > 0 and x2 + w > inner then x2 = 0; rowY = rowY + lineH + S["space-1"] end
                b:SetSize(w, lineH)
                b:ClearAllPoints()
                b:SetPoint("TOPLEFT", self.namesRow, "TOPLEFT", x2, -rowY)
                b:Show()
                x2 = x2 + w + S["space-3"]
            end
            local h = rowY + lineH
            self.namesRow:ClearAllPoints()
            self.namesRow:SetPoint("TOPLEFT", PAD, -y)
            self.namesRow:SetPoint("TOPRIGHT", -PAD, -y)
            self.namesRow:SetHeight(h)
            self.namesRow:Show()
            y = y + h
        end
        y = y + PAD
        self:SetHeight(y)
        -- the drain of a timed note
        if d.duration and d.remaining then
            self.drain:Show()
            draw.paintFill(self.drain, "gilt-line")
            self:SetRemaining(d.remaining)
        end
        return y
    end

    function SetData(d: { [string]: any }): number
        self.data = d
        self.status:Hide()
        self.source:Hide()
        self.namesRow:Hide()
        self.rolesRow:Hide()
        self.warningRow:Hide()
        self.sourceRow:Hide()
        self.onCardClick = nil
        if d.presence then return self:SetPresence(d) end
        self.icon:Show()
        self.category:Show()
        self.title:SetColor("ink")
        local kind = d.kind or "timed"
        self.border:SetColor(TONE_EDGE[d.tone] or "gilt-line")
        self:SetIcon(d.icon)
        self.category:SetValue(d.category or "")
        self.category:SetShown(d.category ~= nil and d.category ~= "")
        self.title:SetValue(d.title or "")
        local closable = d.closable
        if closable == nil then closable = kind == "sticky" or kind == "timed" end
        self.close:SetShown(closable and true or false)
        local hasTime = d.duration and d.remaining
        self.time:SetShown(hasTime and kind ~= "timed" and true or false)
        -- the titles' width: what's left of the head
        local right = (closable and 22 + S["space-3"] or 0) + ((hasTime and kind ~= "timed") and 36 or 0)
        local textW = WIDTH - PAD * 2 - ICON - S["space-4"] - right
        self.title:SetWidth(textW)
        self.category:SetWidth(textW)
        local titleH = math.max(T.type.label.lineHeight, math.ceil(self.title:GetStringHeight()))
        local catH = self.category:IsShown() and T.type.caption.lineHeight or 0
        local headH = math.max(ICON, catH + titleH)
        self.head:SetHeight(headH)
        -- category over title, the two centred on the icon's height
        local top = math.max(0, (headH - catH - titleH) / 2)
        local x = ICON + S["space-4"]
        self.category:ClearAllPoints()
        self.category:SetPoint("TOPLEFT", x, -top)
        self.title:ClearAllPoints()
        self.title:SetPoint("TOPLEFT", x, -(top + catH))
        -- the time: left of the close button, or at the right edge
        self.time:ClearAllPoints()
        if closable then self.time:SetPoint("RIGHT", self.close, "LEFT", -S["space-3"], 0)
        else self.time:SetPoint("TOPRIGHT", 0, -(headH - T.type.numeric.lineHeight) / 2) end
        local y = PAD + headH
        local function place(f: any, h: number)
            y = y + S["space-3"]
            f:ClearAllPoints()
            f:SetPoint("TOPLEFT", PAD, -y)
            f:SetPoint("TOPRIGHT", -PAD, -y)
            f:SetHeight(h)
            f:Show()
            y = y + h
        end
        -- body
        if d.body and d.body ~= "" then
            self.body:SetWidth(WIDTH - PAD * 2)
            self.body:SetValue(d.body)
            local h = math.ceil(self.body:GetStringHeight())
            self.bodyRow:SetHeight(h)
            self.bodyRow:EnableMouse(d.bodyTooltip ~= nil)
            place(self.bodyRow, h)
        else
            self.bodyRow:Hide()
        end
        -- where it came from (a Group Finder note): badges, then the post
        if d.source then
            local bx = 0
            local function badge(i: number, word: string)
                local b = self.badges[i]
                if not b then
                    b = CreateFrame("Frame", nil, self.sourceRow) :: any
                    b:SetHeight(16)
                    draw.fill(b, "surface-raised"):SetAllPoints()
                    draw.border(b, "gilt-line")
                    b.text = text(b, "micro", "ink-muted")
                    b.text:SetPoint("CENTER")
                    self.badges[i] = b
                end
                b.text:SetValue(word)
                b:SetWidth(math.ceil(b.text:GetUnboundedStringWidth()) + S["space-4"] * 2)
                b:ClearAllPoints()
                b:SetPoint("TOPLEFT", self.sourceRow, "TOPLEFT", bx, 0)
                b:Show()
                bx = bx + b:GetWidth() + S["space-2"]
            end
            local n = 0
            if d.source.tool then n = n + 1; badge(n, "Tool") end
            if d.source.channel then n = n + 1; badge(n, d.source.channel) end
            for i = n + 1, #self.badges do self.badges[i]:Hide() end
            local h = n > 0 and 16 or 0
            local post = d.source.text
            if post and post ~= "" then
                self.quote:SetWidth(WIDTH - PAD * 2)
                self.quote:SetValue("“" .. post .. "”")
                self.quote:ClearAllPoints()
                -- the post space-3 under its badges (2px sat it on them, found in game)
                local gap = h > 0 and S["space-3"] or 0
                self.quote:SetPoint("TOPLEFT", self.sourceRow, "TOPLEFT", 0, -(h + gap))
                self.quote:Show()
                h = h + gap + math.ceil(self.quote:GetStringHeight())
                self.sourceRow.post = post
            else
                self.quote:Hide()
                self.sourceRow.post = nil
            end
            self.sourceRow:EnableMouse(self.sourceRow.post ~= nil)
            if h > 0 then place(self.sourceRow, h) end
        end
        -- the item
        if d.item then
            self.item:SetArt(d.item.icon)
            self.item:SetBorder(d.item.quality and ("quality-" .. d.item.quality) or "gilt-hairline")
            self.itemLabel:SetValue(d.item.label or "")
            self.itemLabel:SetColor(d.item.quality and ("quality-" .. d.item.quality) or "ink")
            place(self.itemRow, 28)
        else
            self.itemRow:Hide()
        end
        -- the role choices (hosted), and a warning under them
        if d.host and d.host.roles and d.host.roles > 0 then
            place(self.rolesRow, rolesH())
        end
        if d.warning and d.warning ~= "" then
            self.warningText:SetWidth(WIDTH - PAD * 2)
            self.warningText:SetValue(d.warning)
            place(self.warningRow, math.ceil(self.warningText:GetStringHeight()))
        end
        -- the confirm field
        if d.confirmText then
            self.confirmLabel:SetValue("Type " .. d.confirmText .. " to confirm")
            place(self.confirmRow, T.type.caption.lineHeight + S["space-2"] + FIELD_H)
        else
            self.confirmRow:Hide()
        end
        -- what makes it go
        if d["until"] then
            self.untilText:SetValue(d["until"])
            place(self.untilRow, T.type.caption.lineHeight)
        else
            self.untilRow:Hide()
        end
        -- actions
        for _, pool in pairs(self.buttons) do
            for _, b in ipairs(pool) do b:Hide() end
        end
        local actions = d.actions or {}
        if d.host and d.host.buttons and d.host.buttons > 0 then
            place(self.actionsRow, ACTION_H)
        elseif #actions > 0 then
            place(self.actionsRow, ACTION_H)
            local bx = 0
            for i = #actions, 1, -1 do
                local a = actions[i]
                local b = noteButton(self, i, a.variant or "quiet")
                -- a count after the label: how many chose it (a loot roll's votes)
                local label = a.label or ""
                if a.count then
                    label = label .. "  |cff" .. T.color[a.count > 0 and "ink-muted" or "ink-faint"].hex .. a.count .. "|r"
                end
                b:SetLabel(label)
                b:SetIcon(a.icon)
                b.pressed = a.pressed and true or false
                b.pressedBg:SetShown(b.pressed)
                if b.variant ~= "primary" then b.border:SetColor(b.pressed and "arcane" or (a.variant == "danger" and "ember" or "gilt-line")) end
                b.label:SetColor(b.pressed and "arcane" or (b.variant == "primary" and "on-signal" or (a.variant == "danger" and "ember-text" or "ink")))
                b:SetEnabledState(not a.disabled or b.pressed)
                b.tooltip = a.tooltip
                b:SetScript("OnClick", function() if a.onClick and not a.disabled then a.onClick(self) end end)
                b:ClearAllPoints()
                b:SetPoint("RIGHT", -bx, 0)
                b:Show()
                bx = bx + b:GetWidth() + S["space-3"]
            end
        else
            self.actionsRow:Hide()
        end
        y = y + PAD
        self:SetHeight(y)
        -- the drain
        self.drain:SetShown(hasTime and true or false)
        draw.paintFill(self.drain, kind == "timed" and "gilt-line" or "ink-muted")
        if hasTime then self:SetRemaining(d.remaining) end
        return y
    end

    function SetRemaining(remaining: number)
        local d = self.data
        if not d or not d.duration then return end
        d.remaining = remaining
        local frac = math.max(0, math.min(1, remaining / math.max(0.01, d.duration)))
        self.drain:SetWidth(math.max(0.01, (WIDTH - 2) * frac))
        local soon = (d.kind or "timed") ~= "timed" and remaining <= (d.soonAt or 10)
        self.time:SetValue(clock(remaining))
        self.time:SetColor(soon and "amber" or "ink-muted")
        if soon then draw.paintFill(self.drain, "amber") end
    end
end
mixins.Notification = Notification

export function notification(parent: any): Notification
    return Notification.new(parent)
end

--------------------------------------------------------------------------------
-- The stack
--------------------------------------------------------------------------------

local ORDER: { [string]: number } = { action = 0, roll = 0, ["until"] = 1, sticky = 2, timed = 3 }

type Entry = { d: { [string]: any }, i: number }

local function link(parent: any, label: string, onClick: () -> ()): any
    local b = CreateFrame("Button", nil, parent) :: any
    b.label = text(b, "caption", "gilt-text")
    b.label:SetPoint("LEFT")
    b.label:SetValue(label)
    b:SetSize(80, T.type.caption.lineHeight)
    b:SetScript("OnClick", onClick)
    b:SetScript("OnEnter", function(self: any) self.label:SetColor("ink") end)
    b:SetScript("OnLeave", function(self: any) self.label:SetColor("gilt-text") end)
    -- as wide as its words (the first text too: it was 80 wide, its words at
    -- the left, so a right-aligned link stood in from the edge)
    local function fit() b:SetWidth(math.ceil(b.label:GetUnboundedStringWidth())) end
    hook(b.label, "SetValue", fit)
    b:HookScript("OnShow", fit) -- the font may not measure before it's shown
    fit()
    return b
end

local stacks: { [any]: boolean } = setmetatable({}, { __mode = "k" })

-- A theme change: the cards laid out again (colour codes in the titles and
-- counts, the text styles' line heights), a stack's with its items.
events.on("SUUUI_THEME_CHANGED", function()
    for s in pairs(stacks) do
        s.foot:SetHeight(T.type.caption.lineHeight)
        s.moreLink:SetHeight(T.type.caption.lineHeight)
        s.clearLink:SetHeight(T.type.caption.lineHeight)
        if s.items then s:SetItems(s.items, s.inCombat) end
    end
    for n in pairs(notes) do
        if n.data and not stacks[n:GetParent()] then n:SetData(n.data) end
    end
end, "UI.Notification")

export class NotificationStack extends Frame
    max: any
    foot: Frame
    moreLink: any
    expanded: boolean = false
    heldText: Text
    clearLink: any
    notesHidden: any = nil

    constructor(parent: any, opts: { name?: string, max?: number }?)
        opts = opts or {}
        super(opts.name, parent)
        stacks[self] = true
        self:SetSize(WIDTH, 1)
        self.max = opts.max or 5
        self.cards, self.spare = {}, {}
        self.foot = CreateFrame("Frame", nil, self)
        self.foot:SetHeight(T.type.caption.lineHeight)
        self.moreLink = link(self.foot, "+1 more", function()
            self.expanded = true
            if self.onExpand then self.onExpand() end
        end)
        self.heldText = text(self.foot, "caption", "ink-muted")
        self.clearLink = link(self.foot, "Dismiss all", function() if self.onClearAll then self.onClearAll() end end)
        self.clearLink:SetPoint("RIGHT")
        self.foot:Hide()
    end

    -- Notes out of sight (a window covers them), requests kept.
    function SetNotesHidden(hidden: any)
        local on = hidden and true or false
        if self.notesHidden == on then return end
        self.notesHidden = on
        for _, card in pairs(self.cards) do
            if card.data then card:SetShown(card.request or not on) end
        end
        self.foot:SetAlpha(on and 0 or 1)
    end

    function CardFor(id: any): any
        return self.cards[id]
    end

    function SetItems(items: { [string]: any }[]?, inCombat: boolean?)
        self.items, self.inCombat = items, inCombat
        local list: Entry[], held = {}, 0
        for i, d in ipairs(items or {}) do
            local kind = d.kind or "timed"
            if inCombat and (kind == "sticky" or kind == "timed") then
                held = held + 1
            else
                list[#list + 1] = { d = d, i = i }
            end
        end
        table.sort(list, function(a: Entry, b: Entry): boolean
            local oa, ob = ORDER[a.d.kind or "timed"] or 3, ORDER[b.d.kind or "timed"] or 3
            if oa ~= ob then return oa < ob end
            return a.i < b.i
        end)
        local max = self.expanded and #list or math.min(#list, self.max)
        local used: { [any]: boolean } = {}
        local y = 0
        for k = 1, max do
            local d = list[k].d
            local card = self.cards[d.id]
            if not card then
                card = table.remove(self.spare) or notification(self)
                self.cards[d.id] = card
            end
            used[d.id] = true
            -- requests (popups to answer, loot rolls) above open windows; notes
            -- at the stack's own layer, under them (asked for in game)
            local request = d.kind == "action" or d.kind == "roll"
            card.request = request
            card:SetFrameStrata(request and "DIALOG" or self:GetFrameStrata())
            card:SetData(d)
            card:ClearAllPoints()
            card:SetPoint("TOPLEFT", 0, -y)
            card:SetShown(request or not self.notesHidden)
            y = y + card:GetHeight() + S["space-3"]
        end
        for id, card in pairs(self.cards) do
            if not used[id] then
                card:Hide()
                card.data = nil
                self.cards[id] = nil
                self.spare[#self.spare + 1] = card
            end
        end
        -- the foot: more, held in combat, dismiss all
        local more = #list - max
        local sticky = 0
        for _, x in ipairs(list) do if (x.d.kind or "timed") == "sticky" then sticky = sticky + 1 end end
        self.moreLink:SetShown(more > 0)
        self.moreLink.label:SetValue("+" .. more .. " more")
        self.heldText:SetShown(held > 0)
        self.heldText:SetValue(held .. " waiting for the end of combat")
        self.clearLink:SetShown(sticky > 1 and not inCombat)
        local footShown = more > 0 or held > 0 or (sticky > 1 and not inCombat)
        self.foot:SetShown(footShown)
        if footShown then
            self.foot:ClearAllPoints()
            -- flush with the cards' edges: Dismiss all ends at their right edge
            self.foot:SetPoint("TOPLEFT", 0, -y)
            self.foot:SetPoint("TOPRIGHT", 0, -y)
            local x = 0
            for _, f in ipairs({ self.moreLink, self.heldText }) do
                if f:IsShown() then
                    f:ClearAllPoints()
                    f:SetPoint("LEFT", x, 0)
                    x = x + (f.GetUnboundedStringWidth and f:GetUnboundedStringWidth() or f:GetWidth()) + S["space-4"]
                end
            end
            y = y + T.type.caption.lineHeight
        end
        self:SetHeight(math.max(1, y))
    end
end

export function notificationStack(parent: any, opts: { name?: string, max?: number }?): NotificationStack
    return NotificationStack.new(parent, opts)
end
