-- UI/SettingsMatrix.wowlua
-- Settings that repeat per row as one grid (design component
-- SettingsMatrix): rows down, options across. A sunk box in a gilt-faint
-- edge; a 28px header of caption ink-muted column names, centred; 36px rows
-- on gilt-faint rules: the row's name in label (its description under it in
-- caption), then a checkbox per cell, a small select, or "—" in ink-faint
-- where the option doesn't apply. The `master` column is the row's on/off:
-- off greys the name and disables its other cells, which keep their values.
--
--   local m = settingsMatrix(parent, {
--       width = 640,
--       columns = { { key = "on", label = "On", width = 34, master = true },
--                   { key = "conf", label = "Confidence", width = 78, kind = "select",
--                     options = { { value = 70, label = "70%" } }, title = "…" } },
--       rows = { { key = "role", label = "Your role is needed", description = "…" } },
--       onChange = fn(value),
--   })
--   m:SetValue({ role = { on = true, conf = 70 }, ... })  -- a cell with no value: "—"
--   m:GetValue()

import tokens as T from "/Core/Tokens"
import * as draw from "./Draw"
import text, Text from "./Text"
import select from "./Select"
import checkbox from "./Inputs"
import showTooltip, hideTooltip from "./Tooltip"

local S = T.space

export type MatrixColumn = {
    key: string,
    label: string,
    width: number,
    master?: boolean,
    kind?: string,
    options?: any[],
    title?: string,
}

export type MatrixRowDef = { key: string, label: string, description?: string }

export type SettingsMatrixOptions = {
    width?: number,
    columns: MatrixColumn[],
    rows: MatrixRowDef[],
    onChange?: (value: { [string]: { [string]: any } }) -> (),
}

-- one cell: "—", and the control when the option applies
type Cell = { none: Text, control?: any }

export interface MatrixRow extends Frame
    def: MatrixRowDef
    name: Text
    desc?: Text
    cells: { [string]: Cell }
end

export interface SettingsMatrix extends Frame
    columns: MatrixColumn[]
    onChange?: (value: { [string]: { [string]: any } }) -> ()
    rowFrames: MatrixRow[]
    value: { [string]: { [string]: any } }
    function SetValue(value: { [string]: { [string]: any } }?)
    function GetValue(): { [string]: { [string]: any } }
    function Set(rowKey: string, colKey: string, v: any)
end

local HEAD_H = 28
local ROW_H = 36
local GAP = S["space-3"]

local Matrix = {} :: SettingsMatrix

local function copy(t: any): any
    local out: { [any]: any } = {}
    for k, v in pairs(t or {}) do out[k] = type(v) == "table" and copy(v) or v end
    return out
end

function Matrix:SetValue(value: { [string]: { [string]: any } }?)
    self.value = copy(value)
    for _, row in ipairs(self.rowFrames) do
        local vals = self.value[row.def.key] or {}
        local on = true
        for _, col in ipairs(self.columns) do
            if col.master then on = vals[col.key] and true or false end
        end
        row.name:SetColor(on and "ink" or "ink-faint")
        for _, col in ipairs(self.columns) do
            local cell = row.cells[col.key] :: Cell
            local v = vals[col.key]
            cell.none:SetShown(v == nil)
            if cell.control then
                cell.control:SetShown(v ~= nil)
                if v ~= nil then cell.control:SetValue(v) end
                if cell.control.SetDisabled then cell.control:SetDisabled(not col.master and not on) end
            end
        end
    end
end

function Matrix:GetValue(): { [string]: { [string]: any } } return copy(self.value) end

function Matrix:Set(rowKey: string, colKey: string, v: any)
    local vals = self.value[rowKey] or {}
    self.value[rowKey] = vals
    vals[colKey] = v
    self:SetValue(self.value)
    if self.onChange then self.onChange(self:GetValue()) end
end

export function settingsMatrix(parent: Frame, opts: SettingsMatrixOptions): SettingsMatrix
    local m = CreateFrame("Frame", nil, parent) :: SettingsMatrix
    Mixin(m, Matrix)
    m.columns, m.onChange, m.rowFrames, m.value = opts.columns, opts.onChange, {}, {}
    local width = opts.width or 640
    draw.fill(m, "surface-sunk"):SetAllPoints()
    draw.border(m, "gilt-faint")
    -- the columns from the right, each centred in its width
    local x = width - S["space-4"]
    local colX: { [string]: number } = {}
    for i = #m.columns, 1, -1 do
        local col = m.columns[i]
        x = x - col.width
        colX[col.key] = x
        x = x - GAP
    end
    local nameW = x - S["space-4"]
    for _, col in ipairs(m.columns) do
        local h = text(m, "caption", "ink-muted")
        h:SetWidth(col.width + GAP)
        h:SetJustifyH("CENTER")
        h:SetWordWrap(false)
        h:SetPoint("CENTER", m, "TOPLEFT", (colX[col.key] :: number) + col.width / 2, -HEAD_H / 2)
        h:SetValue(col.label)
        if col.title then
            local hit = CreateFrame("Frame", nil, m)
            hit:SetAllPoints(h)
            hit:SetScript("OnEnter", function(self) showTooltip(self, { title = col.label, description = col.title }) end)
            hit:SetScript("OnLeave", function() hideTooltip() end)
        end
    end
    local y = HEAD_H
    for _, def in ipairs(opts.rows) do
        local row = CreateFrame("Frame", nil, m) :: MatrixRow
        row.def = def
        row:SetPoint("TOPLEFT", m, "TOPLEFT", 0, -y)
        row:SetSize(width, ROW_H)
        local rule = draw.fill(row, "gilt-faint", "ARTWORK")
        rule:SetHeight(1)
        rule:SetPoint("TOPLEFT", S["space-4"], 0)
        rule:SetPoint("TOPRIGHT", -S["space-4"], 0)
        row.name = text(row, "label", "ink")
        row.name:SetWidth(nameW)
        row.name:SetJustifyH("LEFT")
        row.name:SetWordWrap(false)
        row.name:SetValue(def.label)
        if def.description then
            row.name:SetPoint("BOTTOMLEFT", row, "LEFT", S["space-4"], 1)
            local desc = text(row, "caption", "ink-muted")
            row.desc = desc
            desc:SetPoint("TOPLEFT", row, "LEFT", S["space-4"], -1)
            desc:SetWidth(nameW)
            desc:SetJustifyH("LEFT")
            desc:SetWordWrap(false)
            desc:SetValue(def.description)
        else
            row.name:SetPoint("LEFT", S["space-4"], 0)
        end
        row.cells = {}
        for _, col in ipairs(m.columns) do
            local cell: Cell = { none = text(row, "body", "ink-faint") }
            local cx = (colX[col.key] :: number) + col.width / 2
            cell.none:SetPoint("CENTER", row, "LEFT", cx, 0)
            cell.none:SetValue("—")
            if col.kind == "select" then
                cell.control = select(row, { width = col.width, options = col.options,
                    onChange = function(v: any) m:Set(def.key, col.key, v) end })
                cell.control:SetHeight(24)
            else
                cell.control = checkbox(row, { onChange = function(on: boolean) m:Set(def.key, col.key, on) end })
            end
            cell.control:SetPoint("CENTER", row, "LEFT", cx, 0)
            row.cells[col.key] = cell
        end
        m.rowFrames[#m.rowFrames + 1] = row
        y = y + ROW_H
    end
    m:SetSize(width, y + S["space-2"])
    return m
end
