-- UI/SettingsMatrix.wowlua
-- Settings that repeat per row as one grid (design component
-- SettingsMatrix): rows down, options across. A sunk box in a gilt-faint
-- edge; a 28px header of caption ink-muted column names, centred; 36px rows
-- on gilt-faint rules: the row's name in label (its description under it in
-- caption), then a checkbox per cell, a small select, or "—" in ink-faint
-- where the option doesn't apply. The `master` column is the row's on/off:
-- off greys the name and disables its other cells, which keep their values.
--
--   local m = settingsMatrix(parent, {
--       width = 640,
--       columns = { { key = "on", label = "On", width = 34, master = true },
--                   { key = "conf", label = "Confidence", width = 78, kind = "select",
--                     options = { { value = 70, label = "70%" } }, title = "…" } },
--       rows = { { key = "role", label = "Your role is needed", description = "…" } },
--       onChange = fn(value),
--   })
--   m:SetValue({ role = { on = true, conf = 70 }, ... })  -- a cell with no value: "—"
--   m:GetValue()

import tokens as T from "/Core/Tokens"
import * as draw from "./Draw"
import text, Text from "./Text"
import select, Select, SelectOption, SelectValue from "./Select"
import checkbox, Checkbox from "./Inputs"
import showTooltip, hideTooltip from "./Tooltip"

local S = T.space

export type MatrixColumn = {
    key: string,
    label: string,
    width: number,
    master?: boolean,
    kind?: string,
    options?: SelectOption<SelectValue>[],
    title?: string,
}

-- the matrix's values: by row, by column, a checkbox's or a select's
export type MatrixValue = { [string]: { [string]: SelectValue } }

export type MatrixRowDef = { key: string, label: string, description?: string }

export type SettingsMatrixOptions = {
    width?: number,
    columns: MatrixColumn[],
    rows: MatrixRowDef[],
    onChange?: (value: MatrixValue) -> (),
}

-- one cell: "—", and the control when the option applies
export type MatrixCell = { none: Text, control?: Checkbox | Select<SelectValue> }
type Cell = MatrixCell

export class MatrixRow extends Frame
    readonly name: Text
    desc?: Text
    readonly cells: { [string]: Cell } = {}

    constructor(parent: Frame, readonly def: MatrixRowDef)
        super(nil, parent)
        self.name = text(self, "label", "ink")
    end
end

local HEAD_H = 28
local ROW_H = 36
local GAP = S["space-3"]

local function copy(t: MatrixValue?): MatrixValue
    local out: MatrixValue = {}
    for k, row in pairs(t or {}) do
        local r: { [string]: SelectValue } = {}
        for c, v in pairs(row) do r[c] = v end
        out[k] = r
    end
    return out
end

export class SettingsMatrix extends Frame
    columns: MatrixColumn[]
    onChange: ((value: MatrixValue) -> ())? = nil
    rowFrames: MatrixRow[]
    value: MatrixValue

    constructor(parent: Frame, opts: SettingsMatrixOptions)
        super(nil, parent)
        self.columns, self.onChange, self.rowFrames, self.value = opts.columns, opts.onChange, {}, {}
        local width = opts.width or 640
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-faint")
        -- the columns from the right, each centred in its width
        local x = width - S["space-4"]
        local colX: { [string]: number } = {}
        for i = #self.columns, 1, -1 do
            local col = self.columns[i]
            x = x - col.width
            colX[col.key] = x
            x = x - GAP
        end
        local nameW = x - S["space-4"]
        for _, col in ipairs(self.columns) do
            local h = text(self, "caption", "ink-muted")
            h:SetWidth(col.width + GAP)
            h:SetJustifyH("CENTER")
            h:SetWordWrap(false)
            h:SetPoint("CENTER", self, "TOPLEFT", (colX[col.key] :: number) + col.width / 2, -HEAD_H / 2)
            h:SetValue(col.label)
            if col.title then
                local hit = CreateFrame("Frame", nil, self)
                hit:SetAllPoints(h)
                hit:SetScript("OnEnter", function(obj) showTooltip(obj, { title = col.label, description = col.title }) end)
                hit:SetScript("OnLeave", function() hideTooltip() end)
            end
        end
        local y = HEAD_H
        for _, def in ipairs(opts.rows) do
            local row = MatrixRow.new(self, def)
            row:SetPoint("TOPLEFT", self, "TOPLEFT", 0, -y)
            row:SetSize(width, ROW_H)
            local rule = draw.fill(row, "gilt-faint", "ARTWORK")
            rule:SetHeight(1)
            rule:SetPoint("TOPLEFT", S["space-4"], 0)
            rule:SetPoint("TOPRIGHT", -S["space-4"], 0)
            row.name:SetWidth(nameW)
            row.name:SetJustifyH("LEFT")
            row.name:SetWordWrap(false)
            row.name:SetValue(def.label)
            if def.description then
                row.name:SetPoint("BOTTOMLEFT", row, "LEFT", S["space-4"], 1)
                local desc = text(row, "caption", "ink-muted")
                row.desc = desc
                desc:SetPoint("TOPLEFT", row, "LEFT", S["space-4"], -1)
                desc:SetWidth(nameW)
                desc:SetJustifyH("LEFT")
                desc:SetWordWrap(false)
                desc:SetValue(def.description)
            else
                row.name:SetPoint("LEFT", S["space-4"], 0)
            end
            for _, col in ipairs(self.columns) do
                local cell: Cell = { none = text(row, "body", "ink-faint") }
                local cx = (colX[col.key] :: number) + col.width / 2
                cell.none:SetPoint("CENTER", row, "LEFT", cx, 0)
                cell.none:SetValue("—")
                local control: Checkbox | Select<SelectValue>
                if col.kind == "select" then
                    local sel = select(row, { width = col.width, options = col.options or {},
                        onChange = function(v: SelectValue) self:Set(def.key, col.key, v) end })
                    sel:SetHeight(24)
                    control = sel
                else
                    control = checkbox(row, { onChange = function(on: boolean) self:Set(def.key, col.key, on) end })
                end
                control:SetPoint("CENTER", row, "LEFT", cx, 0)
                cell.control = control
                row.cells[col.key] = cell
            end
            self.rowFrames[#self.rowFrames + 1] = row
            y = y + ROW_H
        end
        self:SetSize(width, y + S["space-2"])
    end

    function SetValue(value: MatrixValue?)
        self.value = copy(value)
        for _, row in ipairs(self.rowFrames) do
            local vals = self.value[row.def.key] or {}
            local on = true
            for _, col in ipairs(self.columns) do
                if col.master then on = vals[col.key] and true or false end
            end
            row.name:SetColor(on and "ink" or "ink-faint")
            for _, col in ipairs(self.columns) do
                local cell = row.cells[col.key] :: Cell
                local v = vals[col.key]
                cell.none:SetShown(v == nil)
                local control = cell.control
                if control then
                    control:SetShown(v ~= nil)
                    if v ~= nil then control:SetValue(v) end
                    control:SetDisabled(not col.master and not on)
                end
            end
        end
    end

    function GetValue(): MatrixValue return copy(self.value) end

    function Set(rowKey: string, colKey: string, v: SelectValue)
        local vals = self.value[rowKey] or {}
        self.value[rowKey] = vals
        vals[colKey] = v
        self:SetValue(self.value)
        if self.onChange then self.onChange(self:GetValue()) end
    end
end

export function settingsMatrix(parent: Frame, opts: SettingsMatrixOptions): SettingsMatrix
    return SettingsMatrix.new(parent, opts)
end
