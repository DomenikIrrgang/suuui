-- UI/GroupFinderListing.wowlua
-- The Group Finder's List yourself page (design component GroupFinder,
-- "List yourself"): the game's own listing panel (LFGListingFrame, from
-- Blizzard's secure group finder addon) restyled and laid out in place.
-- Every control stays the game's (addon code can't list you); only looks
-- and places change. What the game keeps on its frames is read, never
-- written: SuuUI's parts live in tables of their own.
--   Top: the role toggles (round, a checkbox on the corner, the role under
--        it); in a group your role, the role dropdown and Role Check; past
--        a rule, New player friendly. A gilt-faint rule under it all.
--   Step 1: "Step 1 of 2 · What are you listing for?" and the categories
--        as cards (glyph, name, a line).
--   Step 2: on the left Playstyle (required: amber until chosen) and Show
--        All Level Ranges over the activities in a sunk tree (chevrons,
--        checkboxes, "4 chosen", level ranges, the lock warning); on the
--        right More details about your group with its count, Voice Chat.
--        Custom: the details across the page.
--   Locked (in a group, not its leader): the game's text in a sunk panel
--        under a lock.
--   Foot: Back (Unlist once listed), List Self (primary; Update once listed).
--
--   skinGroupFinderListing(LFGListingFrame)  (SuuUI.UI.SkinGroupFinderListing)

import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import tokens as T from "/Core/Tokens"
import * as fonts from "/Core/Fonts"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as reskin from "/UI/Reskin"
import Text from "/UI/Text"
import * as tbl from "wowlua:table"

local S = T.space

local TEX = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local GLYPHS = TEX .. "Glyphs\\"
local TANK_TEX, HEALER_TEX, DAMAGE_TEX = TEX .. "RoleTank.tga", TEX .. "RoleHealer.tga", TEX .. "RoleDamage.tga"
local ROLE_TEX: { [string]: string } = { TANK = TANK_TEX, HEALER = HEALER_TEX, DAMAGER = DAMAGE_TEX }
local ROLE_WORD: { [string]: string } = {
    TANK = TANK or "Tank",
    HEALER = HEALER or "Healer",
    DAMAGER = DAMAGER or "Damage",
}

-- the page inside the window (as the Browse page): 20px in, 24px under the
-- tab rule, 16px above the foot
local SIDE, TOP, BOTTOM = 20, 44, 16
local TOGGLE = 36
local TOP_H = TOGGLE + S["space-2"] + 14 -- a toggle with its word
local RULE_Y = TOP + TOP_H + S["space-4"] -- the rule under the top
local FOOT_H = 26
local FOOT_RULE = BOTTOM + FOOT_H + S["space-4"] -- the rule over the foot
local BODY_TOP = RULE_Y + S["space-4"]
local BODY_BOTTOM = FOOT_RULE + S["space-4"]

-- the categories' cards (the game's category IDs on Forever)
local CARDS: { [number]: { glyph: string, text: string } } = {
    [2] = { glyph = "door", text = "Instances for five. Pick every one you’d go to." },
    [116] = { glyph = "scroll", text = "Group quests and elites, one activity per zone." },
    [120] = { glyph = "chat", text = "Anything else, in your own words." },
}

-- the game's group finder (load-on-demand): its global functions are hooked
-- through wowlua:hooks with the addon named (it has loaded by the time a
-- page is skinned, so the hooks go in at once)
local ON_DEMAND = { addon = "Blizzard_GroupFinder_VanillaStyle" }

--------------------------------------------------------------------------------
-- The game's panel: the parts SuuUI reads and lays out (each may be missing
-- on a client without it)
--------------------------------------------------------------------------------

-- A round button of the top row: a role, New player friendly, your role.
export interface RoundButton extends Frame
    Background?: Region
    cover?: Region
end

-- A role toggle or New player friendly: the round button and its check.
export interface CheckToggle extends RoundButton
    CheckButton?: CheckButton
end

-- Your role in a group.
export interface RoleIcon extends RoundButton
    roleID?: string
end

export interface SoloRoles extends Frame
    Tank?: CheckToggle
    Healer?: CheckToggle
    DPS?: CheckToggle
end

export interface GroupRoles extends Frame
    RoleIcon?: RoleIcon
    RoleDropdown?: Frame
    RolePollButton?: Button
end

-- A category's card (a ResizeLayoutFrame: it keeps its fixed size).
export interface CategoryButton extends Button
    categoryID?: number
    Label?: FontString
    Icon?: Region
    Cover?: Region
    fixedWidth?: number
    fixedHeight?: number
end

export interface CategoryView extends Frame
    CategoryButtons?: CategoryButton[]
end

export interface LevelRanges extends Frame
    Checkbox?: CheckButton
    Text?: FontString
end

export interface CommentBox extends EditBox
    Instructions?: FontString
end

export interface CommentField extends Frame
    ScrollBar?: Frame
    EditBox?: CommentBox
end

export interface ActivityView extends Frame
    BarTop?: Region
    BarMiddle?: Region
    BarComponents?: Region[]
    PlayStyleDropdown?: Frame
    generalPlaystyle?: unknown
    LevelRangesCheckbox?: LevelRanges
    ScrollBox?: Frame
    ScrollBar?: Frame
    Comment?: CommentField
    VoiceChatDropdown?: Frame
    VoiceChatLabel?: FontString
end

export interface LockedView extends Frame
    ErrorText?: FontString
    ActivityText?: FontString
end

-- A panel button of the game's (UIPanelButtonTemplate).
export interface PanelButton extends Button
    Left?: Region
    Middle?: Region
    Right?: Region
end

-- Whether the panel has an activity group's (or an activity's) ID chosen.
type Selected = (f: ListingFrame, id: number) -> boolean

-- The game's LFGListingFrame.
export interface ListingFrame extends Frame
    SoloRoleButtons?: SoloRoles
    GroupRoleButtons?: GroupRoles
    NewPlayerFriendlyButton?: CheckToggle
    CategoryView?: CategoryView
    ActivityView?: ActivityView
    LockedView?: LockedView
    BackButton: Button
    PostButton: PanelButton
    AreAllActivitiesForActivityGroupSelected?: Selected
    IsAnyActivityForActivityGroupSelected?: Selected
    IsActivitySelected?: Selected
    function UpdatePostButtonEnableState()
    function UpdateFrameView()
end

-- The activity tree's rows (LFGListingActivityRowTemplate) and the data the
-- game sets them up with.
export interface NameButton extends Button
    Name?: FontString
end

export type ActivityData = { activityID?: number, minLevel?: number, maxLevel?: number }
export type GroupData = { activityGroupID?: number }
export type TreeChild = { GetData?: (c: TreeChild) -> ActivityData? }
export type TreeNode = { nodes?: TreeChild[] }

export interface ActivityRow extends Frame
    CheckButton?: CheckButton
    ExpandOrCollapseButton?: Button
    NameButton?: NameButton
    InstanceLockWarningIcon?: Frame
    Level?: FontString
    GetElementData?: (row: ActivityRow) -> TreeNode?
end

--------------------------------------------------------------------------------
-- Pieces
--------------------------------------------------------------------------------

local skinned: ListingSkin? = nil

local function fade(r: Region?)
    if r then
        r:SetAlpha(0)
    end
end

-- A frame's own art: a button's textures (and a check button's), its textures.
local function hideArt(f: Frame)
    if f:IsObjectType("Button") then
        local b = f :: Button
        fade(b:GetNormalTexture())
        fade(b:GetPushedTexture())
        fade(b:GetHighlightTexture())
        fade(b:GetDisabledTexture())
        if f:IsObjectType("CheckButton") then
            local c = f :: CheckButton
            fade(c:GetCheckedTexture())
            fade(c:GetDisabledCheckedTexture())
        end
    end
    for _, r in ipairs({ f:GetRegions() }) do
        if r:GetObjectType() == "Texture" then
            r:SetAlpha(0)
        end
    end
end

-- The panel's answer, false when it has no such question or errs.
local function asks(f: ListingFrame?, question: Selected?, id: number?): boolean
    if not (f and question and id) then
        return false
    end
    local ok, yes = pcall(question, f, id)
    return ok and yes == true
end

local function circle(parent: Frame, file: string, color: string, layer: DrawLayer, sub: number?): Texture
    local t = parent:CreateTexture(nil, layer, nil, sub)
    t:SetTexture(TEX .. file)
    draw.paint(t, color)
    t:SetAllPoints()
    return t
end

local function glyph(parent: Frame, name: string, size: number, color: string, layer: DrawLayer?): Texture
    local t = parent:CreateTexture(nil, layer or "ARTWORK")
    t:SetTexture(GLYPHS .. name .. ".tga")
    t:SetSize(size, size)
    draw.paint(t, color)
    return t
end

local function font(fs: FontString?, style: string, color: string?)
    if not fs then
        return
    end
    fonts.apply(fs, style)
    if color then
        draw.paint(fs, color)
    end
    fs:SetShadowOffset(0, 0)
end

-- A small frame for an edge (a texture's frame level can't rise above its own).
local function edgeOver(parent: Frame, color: string, level: number?): (draw.Border, Frame)
    local h = CreateFrame("Frame", nil, parent)
    h:SetAllPoints()
    h:EnableMouse(false)
    h:SetFrameLevel(parent:GetFrameLevel() + (level or 2))
    return draw.border(h, color), h
end

--------------------------------------------------------------------------------
-- The round toggles (RoleToggle): a role's checkbox button, or your role
--------------------------------------------------------------------------------

type CornerBox = { fill: Texture, edge: draw.Border, tick: Texture }

-- A 14px box over the game's check button, which keeps the click.
local function cornerBox(check: CheckButton, owner: Frame): CornerBox
    hideArt(check)
    check:SetSize(14, 14)
    check:ClearAllPoints()
    check:SetPoint("BOTTOMRIGHT", owner, "BOTTOMRIGHT", 3, -3)
    check:SetFrameLevel(owner:GetFrameLevel() + 4)
    local fill = draw.fill(check, "surface-sunk", "BACKGROUND", 7)
    fill:SetAllPoints()
    local edge = edgeOver(check, "gilt-line")
    local tick = glyph(check, "check", 10, "on-signal", "OVERLAY")
    tick:SetPoint("CENTER")
    return { fill = fill, edge = edge, tick = tick }
end

-- A round icon's parts: its fill, its edge, the glyph and the word under it.
export type Round = { fill: Texture, edge: Texture, glyph: Texture, word: Text }

local function roundIcon(b: RoundButton, texture: string, word: string, glyphSize: number?): Round
    hideArt(b)
    fade(b.Background)
    fade(b.cover)
    b:SetSize(TOGGLE, TOGGLE)
    local fill = circle(b, "CircleFill.tga", "surface-sunk", "BACKGROUND", 7)
    -- the band: the thin edge texture broke into dots at 36px (found in game)
    local edge = circle(b, "CircleBand.tga", "gilt-line", "BORDER", 7)
    local g = b:CreateTexture(nil, "ARTWORK", nil, 7)
    g:SetTexture(texture)
    g:SetSize(glyphSize or 18, glyphSize or 18)
    g:SetPoint("CENTER")
    local w = uiText.text(b, "caption", "ink-muted")
    w:SetPoint("TOP", b, "BOTTOM", 0, -S["space-2"])
    w:SetWordWrap(false)
    w:SetValue(word)
    return { fill = fill, edge = edge, glyph = g, word = w }
end

-- A toggle's parts: the round icon, the corner box, hovered, its redraw.
export type Toggle = {
    fill: Texture,
    edge: Texture,
    glyph: Texture,
    word: Text,
    box: CornerBox,
    hover: boolean,
    draw: () -> (),
}

local toggles: { [Frame]: Toggle } = setmetatable({}, { __mode = "k" })

local function toggle(b: CheckToggle, check: CheckButton, texture: string, word: string, glyphSize: number?): Toggle
    local made = toggles[b]
    if made then
        return made
    end
    local r = roundIcon(b, texture, word, glyphSize)
    local p: Toggle = {
        fill = r.fill,
        edge = r.edge,
        glyph = r.glyph,
        word = r.word,
        box = cornerBox(check, b),
        hover = false,
        draw = function() end,
    }
    p.draw = function()
        local on = check:GetChecked()
        local cover = b.cover
        local usable = check:IsEnabled() and not (cover and cover:IsShown())
        draw.paint(p.edge, on and "arcane" or (p.hover and "gilt" or "gilt-line"))
        draw.paint(p.fill, on and "surface-raised" or "surface-sunk")
        draw.paint(p.glyph, on and "ink" or "ink-faint")
        p.word:SetColor(on and "ink" or "ink-muted")
        draw.paintFill(p.box.fill, on and "arcane" or "surface-sunk")
        p.box.edge:SetColor(on and "arcane" or "gilt-line")
        p.box.tick:SetShown(on)
        b:SetAlpha(usable and 1 or T.opacity["opacity-disabled"])
    end
    hook(check, "SetChecked", p.draw)
    hook(check, "SetEnabled", p.draw)
    hookScript(check, "OnClick", p.draw)
    hookScript(check, "OnShow", p.draw)
    hookScript(b, "OnShow", p.draw)
    hookScript(b, "OnEnter", function()
        p.hover = true
        p.draw()
    end)
    hookScript(b, "OnLeave", function()
        p.hover = false
        p.draw()
    end)
    toggles[b] = p
    p.draw()
    return p
end

--------------------------------------------------------------------------------
-- Buttons
--------------------------------------------------------------------------------

-- the primary buttons, by their redraw
local primaries: { [Button]: () -> () } = setmetatable({}, { __mode = "k" })

-- The game's panel button as SuuUI's primary: arcane, on-signal label.
local function primaryButton(b: PanelButton)
    if primaries[b] then
        return
    end
    fade(b.Left)
    fade(b.Middle)
    fade(b.Right)
    hideArt(b)
    local bg = draw.fill(b, "arcane", "BACKGROUND", 7)
    bg:SetAllPoints()
    local glow = draw.shadow(b, "glow-arcane")
    glow:SetShown(false)
    local function redraw()
        b:SetAlpha(b:IsEnabled() and 1 or T.opacity["opacity-disabled"])
        font(b:GetFontString(), "label", "on-signal")
    end
    hookScript(b, "OnEnter", function()
        if b:IsEnabled() then
            glow:SetShown(true)
        end
    end)
    hookScript(b, "OnLeave", function()
        glow:SetShown(false)
    end)
    hook(b, "SetEnabled", redraw)
    primaries[b] = redraw
    redraw()
end

-- As wide as its label (the game changes it: Back / Unlist, List Self / Update).
local function fitButton(b: Button)
    local fs = b:GetFontString()
    local w = fs and fs:GetUnboundedStringWidth() or 60
    b:SetSize(math.max(72, math.ceil(w) + S["space-5"] * 2), FOOT_H)
end

--------------------------------------------------------------------------------
-- The activity tree's rows (the game's ScrollBox rows, set up again on
-- every redraw: restyled after each)
--------------------------------------------------------------------------------

export type RowParts = {
    box: Frame,
    fill: Texture,
    edge: draw.Border,
    tick: Texture,
    mixed: Texture,
    chevron: Texture,
    count: Text,
    lock?: Texture,
    redraw?: () -> (),
}

local rows: { [Frame]: RowParts } = setmetatable({}, { __mode = "k" })

local function rowParts(row: ActivityRow, check: CheckButton): RowParts
    local made = rows[row]
    if made then
        return made
    end
    hideArt(check)
    local box = CreateFrame("Frame", nil, check)
    box:SetSize(16, 16)
    box:SetPoint("CENTER")
    box:EnableMouse(false)
    local fill = draw.fill(box, "surface-sunk")
    fill:SetAllPoints()
    local tick = glyph(box, "check", 12, "on-signal", "OVERLAY")
    tick:SetPoint("CENTER")
    local mixed = glyph(box, "minus", 12, "on-signal", "OVERLAY")
    mixed:SetPoint("CENTER")
    local ec = row.ExpandOrCollapseButton
    if ec then
        hideArt(ec)
    end
    local chevron = glyph(ec or row, "chevronDown", 12, "ink-muted", "OVERLAY")
    chevron:SetPoint("CENTER")
    local count = uiText.text(row, "caption", "ink-faint")
    count:SetPoint("RIGHT", row, "RIGHT", -S["space-4"], 0)
    local p: RowParts = {
        box = box,
        fill = fill,
        edge = draw.border(box, "gilt-line"),
        tick = tick,
        mixed = mixed,
        chevron = chevron,
        count = count,
    }
    local warning = row.InstanceLockWarningIcon
    if warning then
        for _, r in ipairs({ warning:GetRegions() }) do
            r:SetAlpha(0)
        end
        local lock = glyph(warning, "lock", 12, "amber", "OVERLAY")
        lock:SetPoint("CENTER")
        p.lock = lock
    end
    -- after a click, the row's own box: the game redraws only the group's
    -- heading and relies on the check button's own tick, which is hidden
    -- (found in game). PostClick, since the game sets OnClick on each setup.
    hookScript(check, "PostClick", function()
        local redraw = p.redraw
        if redraw then
            redraw()
        end
    end)
    rows[row] = p
    return p
end

local function drawBox(p: RowParts, state: string?)
    draw.paintFill(p.fill, state and "arcane" or "surface-sunk")
    p.edge:SetColor(state and "arcane" or "gilt-line")
    p.tick:SetShown(state == "all")
    p.mixed:SetShown(state == "some")
end

-- The panel the rows belong to.
local function listing(): ListingFrame?
    local s = skinned
    return s and s.frame
end

local function skinGroupRow(row: ActivityRow?, data: GroupData?, collapsed: boolean?)
    if not (row and data) then
        return
    end
    local check = row.CheckButton
    if not check then
        return
    end
    local p = rowParts(row, check)
    p.redraw = nil -- the game sets the heading up again after its clicks
    local f = listing()
    local id = data.activityGroupID
    local all = f and asks(f, f.AreAllActivitiesForActivityGroupSelected, id)
    local some = f and asks(f, f.IsAnyActivityForActivityGroupSelected, id)
    drawBox(p, all and "all" or (some and "some") or nil)
    p.chevron:SetTexture(GLYPHS .. (collapsed and "chevronRight" or "chevronDown") .. ".tga")
    local nameButton = row.NameButton
    local name = nameButton and nameButton.Name
    font(name, "header", "gilt-text")
    if nameButton and name then
        nameButton:SetWidth(name:GetUnboundedStringWidth())
    end
    -- how many are chosen ("4 chosen"), else how many there are
    local get = row.GetElementData
    local ok: boolean, got: unknown = false, nil
    if get then
        ok, got = pcall(get, row)
    end
    local node = ok and got :: TreeNode? or nil
    local chosen, total = 0, 0
    for _, child in ipairs(node and node.nodes or {}) do
        local getData = child.GetData
        local gotData: boolean, childData: unknown = false, nil
        if getData then
            gotData, childData = pcall(getData, child)
        end
        local d = gotData and childData :: ActivityData? or nil
        local activity = d and d.activityID
        if activity then
            total = total + 1
            if f and asks(f, f.IsActivitySelected, activity) then
                chosen = chosen + 1
            end
        end
    end
    p.count:SetValue(chosen > 0 and (chosen .. " chosen") or (total > 0 and tostring(total) or ""))
    p.count:Show()
end

local function skinActivityRow(row: ActivityRow?, data: ActivityData?)
    if not (row and data) then
        return
    end
    local check = row.CheckButton
    if not check then
        return
    end
    local p = rowParts(row, check)
    local f = listing()
    p.redraw = function()
        drawBox(p, f and asks(f, f.IsActivitySelected, data.activityID) and "all" or nil)
    end
    p.redraw()
    p.count:Hide()
    -- the game's difficulty colours, in SuuUI's quest colours
    local lvl = UnitLevel("player")
    local color = "ink"
    local maxLevel, minLevel = data.maxLevel, data.minLevel
    if maxLevel and maxLevel ~= 0 and maxLevel < lvl then
        color = "quest-trivial"
    elseif minLevel and minLevel ~= 0 and minLevel > lvl then
        color = "quest-difficult"
    end
    local nameButton = row.NameButton
    local name = nameButton and nameButton.Name
    font(name, "body", color)
    if nameButton and name then
        nameButton:SetWidth(name:GetUnboundedStringWidth())
    end
    -- "20 - 30" in caption ink-muted, at the right
    local level = row.Level
    if level then
        font(level, "caption", "ink-muted")
        local text = level:GetText()
        if type(text) == "string" then
            level:SetText((text:gsub("[()]", "")))
        end
        level:SetJustifyH("RIGHT")
        level:ClearAllPoints()
        level:SetPoint("RIGHT", row, "RIGHT", -S["space-4"], 0)
    end
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

-- The parts SuuUI adds to the listing's activity step.
type ActivityParts = { psLabel: Text, tree: Frame, detailsLabel: Text, field: Frame, count: Text }

-- A category card's parts.
export type CardParts = { fill: Texture, edge: draw.Border, glyph: Texture, line: Text }
local cards: { [Frame]: CardParts } = setmetatable({}, { __mode = "k" })

-- The solo role buttons, in order, with their roles.
local SOLO: { key: string, texture: string, word: string }[] = {
    { key = "Tank", texture = TANK_TEX, word = TANK or "Tank" },
    { key = "Healer", texture = HEALER_TEX, word = HEALER or "Healer" },
    { key = "DPS", texture = DAMAGE_TEX, word = DAMAGER or "Damage" },
}

local function soloButton(solo: SoloRoles, key: string): CheckToggle?
    if key == "Tank" then
        return solo.Tank
    end
    if key == "Healer" then
        return solo.Healer
    end
    return solo.DPS
end

-- The skinned panel. `frame` is the game's LFGListingFrame.
export class ListingSkin
    frame: ListingFrame
    topRule: Texture
    footRule: Texture
    npfRule: Texture
    hint: Text? = nil
    psMissing: Frame? = nil
    -- your role in a group (where the panel has its icon)
    roleIcon: Round? = nil
    -- the activity step's parts (where the frame has its ActivityView)
    activity: ActivityParts? = nil
    -- the locked view's glyph (where it has one)
    lockGlyph: Texture? = nil
    placing: boolean? = nil
    queued: boolean? = nil

    constructor(f: ListingFrame)
        self.frame = f
        skinned = self

        -- the rules under the top and over the foot, and between the roles and New player friendly
        self.topRule = draw.fill(f, "gilt-faint", "ARTWORK")
        self.topRule:SetHeight(1)
        self.topRule:SetPoint("TOPLEFT", f, "TOPLEFT", SIDE, -RULE_Y)
        self.topRule:SetPoint("TOPRIGHT", f, "TOPRIGHT", -SIDE, -RULE_Y)
        self.footRule = draw.fill(f, "gilt-faint", "ARTWORK")
        self.footRule:SetHeight(1)
        self.footRule:SetPoint("BOTTOMLEFT", f, "BOTTOMLEFT", SIDE, FOOT_RULE)
        self.footRule:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -SIDE, FOOT_RULE)
        self.npfRule = draw.fill(f, "gilt-faint", "ARTWORK")

        -- the top: the role toggles, your role in a group, New player friendly
        local solo = f.SoloRoleButtons
        if solo then
            for _, r in ipairs(SOLO) do
                local b = soloButton(solo, r.key)
                local check = b and b.CheckButton
                if b and check then
                    toggle(b, check, r.texture, r.word)
                end
            end
        end
        local group = f.GroupRoleButtons
        if group then
            local icon = group.RoleIcon
            if icon then
                local p = roundIcon(icon, DAMAGE_TEX, "")
                draw.paint(p.edge, "arcane")
                draw.paint(p.fill, "surface-raised")
                draw.paint(p.glyph, "ink")
                p.word:SetColor("ink")
                local function update()
                    local role = icon.roleID
                    p.glyph:SetTexture(role and ROLE_TEX[role] or DAMAGE_TEX)
                    p.word:SetValue(role and ROLE_WORD[role] or "")
                    -- the game sets its own art again
                    if icon:IsObjectType("Button") then
                        fade((icon :: Button):GetNormalTexture())
                    end
                end
                hook(
                    _G,
                    "LFGListingRoleIcon_UpdateRoleTexture",
                    function(b: unknown)
                        if b == icon then
                            update()
                        end
                    end,
                    ON_DEMAND
                )
                hookScript(icon, "OnShow", update)
                update()
                self.roleIcon = p
            end
            if group.RoleDropdown then
                reskin.reskinDropdown(group.RoleDropdown)
            end
            if group.RolePollButton then
                reskin.reskinButton(group.RolePollButton)
            end
            hookScript(group, "OnShow", function()
                self:Queue()
            end)
            hookScript(group, "OnHide", function()
                self:Queue()
            end)
        end
        local npf = f.NewPlayerFriendlyButton
        local npfCheck = npf and npf.CheckButton
        if npf and npfCheck then
            local word = tbl.field(_G, "LFG_LIST_NEW_PLAYER_FRIENDLY")
            toggle(npf, npfCheck, GLYPHS .. "leaf.tga", type(word) == "string" and word or "New player friendly", 16)
        end

        -- step 1: the hint over the cards
        local view = f.CategoryView
        if view then
            view:ClearAllPoints()
            view:SetPoint("TOPLEFT", f, "TOPLEFT", SIDE, -(RULE_Y + S["space-5"]))
            view:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -SIDE, BODY_BOTTOM)
            local hint = uiText.text(view, "caption", "ink-muted")
            self.hint = hint
            hint:SetPoint("TOPLEFT")
            hint:SetValue("Step 1 of 2 · What are you listing for?")
            hookScript(view, "OnShow", function()
                self:Queue()
            end)
            if tbl.field(_G, "LFGListingCategorySelection_UpdateCategoryButtons") then
                hook(
                    _G,
                    "LFGListingCategorySelection_UpdateCategoryButtons",
                    function()
                        self:Queue()
                    end,
                    ON_DEMAND
                )
            end
        end

        -- step 2
        local av = f.ActivityView
        if av then
            av:ClearAllPoints()
            av:SetPoint("TOPLEFT", f, "TOPLEFT", SIDE, -BODY_TOP)
            av:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -SIDE, BODY_BOTTOM)
            fade(av.BarTop)
            fade(av.BarMiddle)
            for _, t in ipairs(av.BarComponents or {}) do
                t:SetAlpha(0)
            end
            local psLabel = uiText.text(av, "caption", "ink-muted")
            local dd = av.PlayStyleDropdown
            if dd then
                reskin.reskinDropdown(dd)
                -- amber until a play style is chosen
                local _, holder = edgeOver(dd, "amber", 3)
                self.psMissing = holder
            end
            local lr = av.LevelRangesCheckbox
            if lr then
                if lr.Checkbox then
                    reskin.reskinCheckButton(lr.Checkbox)
                end
                font(lr.Text, "body", "ink")
            end
            local tree = CreateFrame("Frame", nil, av)
            local box = av.ScrollBox
            tree:SetFrameLevel(math.max(0, (box and box:GetFrameLevel() or av:GetFrameLevel() + 1) - 1))
            draw.fill(tree, "surface-sunk"):SetAllPoints()
            draw.border(tree, "gilt-faint")
            if box then
                hook(box, "SetPoint", function()
                    self:PlaceScrollBox()
                end)
            end
            if av.ScrollBar then
                reskin.reskinScrollBar(av.ScrollBar)
            end
            -- the details
            local detailsLabel = uiText.text(av, "caption", "ink-muted")
            local field = CreateFrame("Frame", nil, av)
            draw.fill(field, "surface-sunk"):SetAllPoints()
            local edge = draw.border(field, "gilt-line")
            local count = uiText.text(av, "caption", "ink-faint")
            local c = av.Comment
            if c then
                field:SetFrameLevel(math.max(0, c:GetFrameLevel() - 1))
                for _, r in ipairs({ c:GetRegions() }) do
                    if r:GetObjectType() == "Texture" then
                        r:SetAlpha(0)
                    end
                end
                if c.ScrollBar then
                    reskin.reskinScrollBar(c.ScrollBar)
                end
                local e = c.EditBox
                if e then
                    e:SetFontObject(fonts.get("body"))
                    draw.paint(e, "ink")
                    font(e.Instructions, "body", "ink-muted")
                    hookScript(e, "OnTextChanged", function()
                        self:UpdateCount()
                    end)
                    hookScript(e, "OnEditFocusGained", function()
                        edge:SetColor("arcane")
                    end)
                    hookScript(e, "OnEditFocusLost", function()
                        edge:SetColor("gilt-line")
                    end)
                end
            end
            if av.VoiceChatDropdown then
                reskin.reskinDropdown(av.VoiceChatDropdown)
            end
            font(av.VoiceChatLabel, "caption", "ink-muted")
            self.activity = {
                psLabel = psLabel,
                tree = tree,
                detailsLabel = detailsLabel,
                field = field,
                count = count,
            }
            -- the game places its parts again on show; after it
            hookScript(av, "OnShow", function()
                self:LayoutActivities()
                self:Queue()
            end)
            hook(
                _G,
                "LFGListingActivityView_OnPlayStyleSelectedInternal",
                function()
                    self:LayoutActivities()
                end,
                ON_DEMAND
            )
        end
        -- the tree's rows, each time the game sets one up
        hook(_G, "LFGListingActivityView_InitActivityGroupButton", skinGroupRow, ON_DEMAND)
        hook(_G, "LFGListingActivityView_InitActivityButton", skinActivityRow, ON_DEMAND)

        -- locked: the game's text in a sunk panel under a lock
        local lv = f.LockedView
        if lv then
            lv:ClearAllPoints()
            lv:SetPoint("TOPLEFT", f, "TOPLEFT", SIDE, -(RULE_Y + S["space-5"]))
            lv:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -SIDE, BOTTOM)
            local bg = draw.fill(lv, "surface-sunk", "BACKGROUND", -8)
            bg:SetAllPoints()
            draw.border(lv, "gilt-faint")
            local lock = glyph(lv, "lock", 24, "ink-faint")
            lock:SetPoint("TOP", lv, "TOP", 0, -S["space-6"] * 2)
            self.lockGlyph = lock
            hookScript(lv, "OnShow", function()
                self:Queue()
            end)
            if tbl.field(_G, "LFGListingLockedView_RefreshContent") then
                hook(
                    _G,
                    "LFGListingLockedView_RefreshContent",
                    function()
                        self:Queue()
                    end,
                    ON_DEMAND
                )
            end
        end

        -- the foot
        reskin.reskinButton(f.BackButton)
        primaryButton(f.PostButton)
        for _, name in ipairs({ "LFGListingPostButton_UpdateText", "LFGListingBackButton_UpdateText" }) do
            if tbl.field(_G, name) then
                hook(name, function()
                    self:LayoutFoot()
                end)
            end
        end
        hook(f, "UpdatePostButtonEnableState", function()
            local redraw = primaries[f.PostButton]
            if redraw then
                redraw()
            end
            self:LayoutActivities()
        end)
        hook(f, "UpdateFrameView", function()
            self:Queue()
        end)
        hookScript(f, "OnShow", function()
            self:Layout()
            self:Queue()
        end)
        if f:IsShown() then
            self:Layout()
        end
        -- the labels' colour codes (Playstyle, More details) follow the theme
        events.on(
            "SUUUI_THEME_CHANGED",
            function()
                if f:IsShown() then
                    self:Queue()
                end
            end,
            "GroupFinderListing"
        )
    end

    function LayoutTop()
        local f = self.frame
        local solo = f.SoloRoleButtons
        local group = f.GroupRoleButtons
        local slot = 60
        if solo then
            solo:ClearAllPoints()
            solo:SetPoint("TOPLEFT", f, "TOPLEFT", SIDE, -TOP)
            solo:SetSize(slot * 3, TOP_H)
            for i, r in ipairs(SOLO) do
                local b = soloButton(solo, r.key)
                if b then
                    b:ClearAllPoints()
                    b:SetPoint("TOP", solo, "TOPLEFT", slot * (i - 0.5), 0)
                end
            end
        end
        if group then
            group:ClearAllPoints()
            group:SetPoint("TOPLEFT", f, "TOPLEFT", SIDE, -TOP)
            local icon, dd, poll = group.RoleIcon, group.RoleDropdown, group.RolePollButton
            if icon then
                icon:ClearAllPoints()
                icon:SetPoint("TOP", group, "TOPLEFT", slot / 2, 0)
            end
            if dd then
                dd:ClearAllPoints()
                dd:SetSize(120, 30)
                dd:SetPoint("LEFT", group, "TOPLEFT", slot + S["space-4"], -TOGGLE / 2)
            end
            if poll then
                fitButton(poll)
                poll:ClearAllPoints()
                poll:SetPoint("LEFT", dd or group, "RIGHT", S["space-5"], 0)
            end
            local w = slot + S["space-4"] + 120 + S["space-5"] + (poll and poll:GetWidth() or 0)
            group:SetSize(w, TOP_H)
        end
        -- New player friendly past a rule, after whichever role row shows
        local x = (group and group:IsShown() and group:GetWidth() or slot * 3) + S["space-6"]
        self.npfRule:ClearAllPoints()
        self.npfRule:SetPoint("TOPLEFT", f, "TOPLEFT", SIDE + x, -TOP)
        self.npfRule:SetSize(1, TOP_H)
        local npf = f.NewPlayerFriendlyButton
        if npf then
            npf:ClearAllPoints()
            npf:SetPoint("TOP", f, "TOPLEFT", SIDE + x + 1 + S["space-6"] + 55, -TOP)
        end
    end

    function LayoutCategories()
        local view = self.frame.CategoryView
        if not (view and view:IsShown()) then
            return
        end
        local shown: CategoryButton[] = {}
        for _, b in ipairs(view.CategoryButtons or {}) do
            if b:IsShown() then
                shown[#shown + 1] = b
            end
        end
        local gap = S["space-5"]
        local width = view:GetWidth()
        if not width or width < 10 then
            return
        end
        local cw = math.floor((width - gap * (#shown - 1)) / math.max(1, #shown))
        for i, b in ipairs(shown) do
            local p = cards[b]
            if not p then
                fade(b.Icon)
                fade(b.Cover)
                hideArt(b)
                local fill = draw.fill(b, "surface-sunk", "BACKGROUND", 7)
                fill:SetAllPoints()
                local g = glyph(b, "flag", 22, "gilt-text", "OVERLAY")
                g:SetPoint("TOPLEFT", S["space-5"], -S["space-5"])
                local line = uiText.text(b, "caption", "ink-muted")
                line:SetJustifyH("LEFT")
                line:SetWordWrap(true)
                local made: CardParts = { fill = fill, edge = edgeOver(b, "gilt-line"), glyph = g, line = line }
                hookScript(b, "OnEnter", function()
                    made.edge:SetColor("gilt")
                    draw.paintFill(made.fill, "surface-raised")
                end)
                hookScript(b, "OnLeave", function()
                    made.edge:SetColor("gilt-line")
                    draw.paintFill(made.fill, "surface-sunk")
                end)
                -- a ResizeLayoutFrame: its own size, not its children's
                b.fixedWidth, b.fixedHeight = cw, 132
                cards[b] = made
                p = made
            end
            local id = b.categoryID
            local card = id and CARDS[id]
            p.glyph:SetTexture(GLYPHS .. (card and card.glyph or "flag") .. ".tga")
            p.line:SetValue(card and card.text or "")
            b:ClearAllPoints()
            b:SetSize(cw, 132)
            b:SetPoint("TOPLEFT", view, "TOPLEFT", (i - 1) * (cw + gap), -(14 + S["space-4"]))
            local label = b.Label or b:GetFontString()
            if label then
                font(label, "header", "gilt-text")
                label:ClearAllPoints()
                label:SetPoint("TOPLEFT", p.glyph, "BOTTOMLEFT", 0, -S["space-3"])
                p.line:ClearAllPoints()
                p.line:SetPoint("TOPLEFT", label, "BOTTOMLEFT", 0, -S["space-3"])
                p.line:SetWidth(cw - S["space-5"] * 2)
            end
        end
    end

    function LayoutActivities()
        local act = self.activity
        if not act then
            return
        end
        local f = self.frame
        local av = f.ActivityView
        if not av then
            return
        end
        local width = f:GetWidth() - SIDE * 2
        local box = av.ScrollBox
        local custom = box ~= nil and not box:IsShown()
        local left = custom and width or math.floor((width - S["space-6"]) * 0.56)
        local rightX = custom and 0 or (left + S["space-6"])
        local rightW = width - rightX
        -- Playstyle (required by the game in every category) and Show All Level Ranges
        local dd = av.PlayStyleDropdown
        local style = av.generalPlaystyle
        local missing = dd ~= nil and (style == nil or style == false)
        act.psLabel:SetValue("Playstyle |cff" .. draw.hex(missing and "amber" or "ink-muted") .. "· required|r")
        act.psLabel:ClearAllPoints()
        act.psLabel:SetPoint("TOPLEFT", av, "TOPLEFT", 0, 0)
        if dd then
            dd:ClearAllPoints()
            dd:SetSize(200, 30)
            dd:SetPoint("TOPLEFT", av, "TOPLEFT", 0, -(14 + S["space-1"]))
            if self.psMissing then
                self.psMissing:SetShown(missing)
            end
        end
        local lr = av.LevelRangesCheckbox
        local lrText, lrBox = lr and lr.Text, lr and lr.Checkbox
        if lr and lrText and lrBox then
            lrText:ClearAllPoints()
            lrText:SetPoint("RIGHT", av, "TOPLEFT", left, -(14 + S["space-1"] + 15))
            lrBox:ClearAllPoints()
            lrBox:SetPoint("RIGHT", lrText, "LEFT", -S["space-2"], 0)
            lr:SetShown(not custom)
        end
        -- under the Playstyle / Voice Chat row and room for the details' label
        -- (it overlapped Voice Chat), so the tree and the field start level
        local treeTop = 14 + S["space-1"] + 30 + S["space-4"] + 14 + S["space-1"]
        act.tree:ClearAllPoints()
        act.tree:SetPoint("TOPLEFT", av, "TOPLEFT", 0, -treeTop)
        act.tree:SetPoint("BOTTOMLEFT", av, "BOTTOMLEFT", 0, 0)
        act.tree:SetWidth(left)
        act.tree:SetShown(not custom)
        self:PlaceScrollBox()
        -- Voice Chat in the Playstyle row (asked for in game): at the right
        -- column's start, or at the page's right in Custom
        local vlabel, vdd = av.VoiceChatLabel, av.VoiceChatDropdown
        if vlabel and vdd then
            local vx = custom and (width - 200) or rightX
            vlabel:ClearAllPoints()
            vlabel:SetPoint("TOPLEFT", av, "TOPLEFT", vx, 0)
            vlabel:SetJustifyH("LEFT")
            vdd:ClearAllPoints()
            vdd:SetSize(200, 30)
            vdd:SetPoint("TOPLEFT", av, "TOPLEFT", vx, -(14 + S["space-1"]))
        end
        -- the details: a sunk field from the activity tree's top to its foot
        -- (asked for in game), its label over it with the count at the right;
        -- in Custom (no tree) across the page from the same top
        local detailsTop = treeTop - (14 + S["space-1"])
        act.detailsLabel:ClearAllPoints()
        act.detailsLabel:SetPoint("TOPLEFT", av, "TOPLEFT", rightX, -detailsTop)
        act.detailsLabel:SetValue(
            "More details about your group" ..
                (custom and "" or (" |cff" .. T.color["ink-faint"].hex .. "· optional|r"))
        )
        act.field:ClearAllPoints()
        act.field:SetPoint("TOPLEFT", av, "TOPLEFT", rightX, -treeTop)
        act.field:SetPoint("BOTTOMLEFT", av, "BOTTOMLEFT", rightX, 0)
        act.field:SetWidth(rightW)
        local c = av.Comment
        -- the placeholder: the label says what the field is (the game's
        -- authenticator note stays as it is)
        local e = c and c.EditBox
        local instr = e and e.Instructions
        local said = instr and instr:GetText()
        if instr and said and (said == DESCRIPTION_OF_YOUR_GROUP or said == DESCRIPTION_OF_YOUR_GROUP_MANDATORY) then
            instr:SetText(
                custom and "What you’re after, for a Custom listing" or
                    "Route, quests, gear check: anything people should know"
            )
        end
        if c then
            c:ClearAllPoints()
            c:SetPoint("TOPLEFT", act.field, "TOPLEFT", S["space-4"], -S["space-3"])
            c:SetPoint("BOTTOMRIGHT", act.field, "BOTTOMRIGHT", -S["space-4"] - 12, S["space-3"])
            if e then
                e:SetWidth(rightW - S["space-4"] * 2 - 16)
            end
        end
        act.count:ClearAllPoints()
        act.count:SetPoint("BOTTOMRIGHT", act.field, "TOPRIGHT", 0, S["space-1"])
        self:UpdateCount()
    end

    -- The game anchors its list again whenever its scrollbar comes or goes:
    -- inside the sunk tree, every time.
    function PlaceScrollBox()
        local act = self.activity
        if not act then
            return
        end
        local av = self.frame.ActivityView
        local box = av and av.ScrollBox
        if not av or not box or self.placing then
            return
        end
        self.placing = true
        box:ClearAllPoints()
        box:SetPoint("TOPLEFT", act.tree, "TOPLEFT", 1, -S["space-2"])
        box:SetPoint("BOTTOMRIGHT", act.tree, "BOTTOMRIGHT", -14, S["space-2"])
        self.placing = false
        local bar = av.ScrollBar
        if bar then
            bar:ClearAllPoints()
            bar:SetPoint("TOPLEFT", act.tree, "TOPRIGHT", -10, -S["space-3"])
            bar:SetPoint("BOTTOMLEFT", act.tree, "BOTTOMRIGHT", -10, S["space-3"])
        end
    end

    function UpdateCount()
        local act = self.activity
        if not act then
            return
        end
        local av = self.frame.ActivityView
        local c = av and av.Comment
        local e = c and c.EditBox
        local text = e and e:GetText()
        local n = 0
        if type(text) == "string" then
            local utf8len = tbl.field(_G, "strlenutf8")
            local len: unknown = type(utf8len) == "function" and utf8len(text) or nil
            n = type(len) == "number" and len or #text
        end
        act.count:SetValue(n .. " / 255")
    end

    function LayoutLocked()
        local lv = self.frame.LockedView
        if not (lv and lv:IsShown()) then
            return
        end
        reskin.reskin(lv)
        local err = lv.ErrorText
        if err then
            font(err, "label", "ink")
            err:ClearAllPoints()
            err:SetPoint("TOP", self.lockGlyph, "BOTTOM", 0, -S["space-3"])
            err:SetWidth(lv:GetWidth() - S["space-6"] * 2)
            err:SetJustifyH("CENTER")
        end
        font(lv.ActivityText, "caption", "ink-muted")
    end

    function LayoutFoot()
        local f = self.frame
        fitButton(f.BackButton)
        fitButton(f.PostButton)
        f.BackButton:ClearAllPoints()
        f.BackButton:SetPoint("BOTTOMLEFT", f, "BOTTOMLEFT", SIDE, BOTTOM)
        f.PostButton:ClearAllPoints()
        f.PostButton:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -SIDE, BOTTOM)
    end

    function Layout()
        self:LayoutTop()
        self:LayoutCategories()
        self:LayoutActivities()
        self:LayoutLocked()
        self:LayoutFoot()
    end

    -- Again after the game's next redraw (a frame later, once it has drawn).
    function Queue()
        if self.queued then
            return
        end
        self.queued = true
        after(0, function()
            self.queued = false
            if self.frame:IsShown() then
                self:Layout()
            end
        end)
    end
end

export function skinGroupFinderListing(f: ListingFrame?): ListingSkin?
    if not f or skinned then
        return skinned
    end
    return ListingSkin.new(f)
end
