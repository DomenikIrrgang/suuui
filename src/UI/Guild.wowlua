-- UI/Guild.wowlua
-- The Guild window's Roster page (design component GuildWindow, "Roster"):
-- search, Show offline (off by default), "7 online · 26 members"; columns
-- Name, Level, Class (its icon and name), Zone, Rank, Note (click a heading to sort; rank order by
-- default); names in class colour with the class diamond, Away and Busy as
-- neutral badges, offline members' names in class colour too but faded
-- (opacity-disabled) and the rest of their row in ink-faint, with how long ago in place
-- of the zone. The selected member's actions along the foot: Whisper and
-- Invite; Promote, Demote and Remove only when your rank may and only for
-- members below you (Remove in ember); anything your rank can't do stays
-- visible, disabled, with the reason. Invite to guild bottom left.
--
--   local r = guildRoster(parent)  (SuuUI.UI.GuildRoster)
--   r:SetData({ online, total, showOffline, sort, members = { m },
--       selected, actions = { whisper, invite, promote, demote, remove } })
--     m = { key, name, class (its file name), className, level, zone, rank, rankIndex, note, officerNote,
--       online, away, busy, lastOnline ("3 days ago") }
--     actions.x = { enabled, why } (also guildInvite, which needs
--     no member)
--   r.onSearch(text), r.onShowOffline(on), r.onSort(column), r.onSelect(key),
--   r.onAction(name, member) ("whisper", "invite", "promote", "demote",
--   "remove", "guildInvite"), r.onMenu(member, owner), r.onRowEnter(row, member) and
--   r.onRowLeave(row) (a layer over the hovered row: the row's own scripts are
--   row:Click(button), row's OnEnter/OnLeave/OnDoubleClick)

import tokens as T from "/Core/Tokens"
import * as fonts from "/Core/Fonts"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as controls from "/UI/Controls"
import * as inputs from "/UI/Inputs"
import * as panel from "/UI/Panel"
import * as tooltip from "/UI/Tooltip"
import Text from "/UI/Text"
import SuuButton from "/UI/Controls"
import TextField, Checkbox from "/UI/Inputs"
import ScrollArea from "/UI/Panel"

export type GuildMember = {
    key?: any,
    name?: string,
    class?: string,      -- the class file ("MAGE")
    className?: string,
    level?: number,
    zone?: string,
    rank?: string,
    rankIndex?: number,
    note?: string,
    officerNote?: string,
    online?: boolean,
    away?: boolean,
    busy?: boolean,
    lastOnline?: string,
}

-- What a foot button may do: on, or off and why.
export type GuildAction = { enabled?: boolean, why?: string }

export type RosterData = {
    online?: number,
    total?: number,
    showOffline?: boolean,
    sort?: string,
    members?: GuildMember[],
    selected?: any,
    actions?: { [string]: GuildAction },
}

export type RosterColumn = { x: number, w: number }

export interface RosterRow extends Button
    member?: GuildMember
    sel: Texture
    edge: Texture
    hover: Texture
    diamond: Texture
    classIcon: Texture
    cells: Text[]
    badge: RosterBadge
end

export interface RosterBadge extends Frame
    text: Text
end

export interface RosterHead extends Button
    text: Text
end

-- A foot button: why it's off, for its tooltip.
export interface RosterButton extends SuuButton
    reason?: string
end

local S = T.space

local ROW_H = 24
local HEAD_ROW_H = 22
local TOP_H = 30
local FOOT_H = 26

-- the columns: their share of the width after the fixed ones
local COLUMNS = {
    { key = "name", label = "Name", width = 0.30 },
    { key = "level", label = "Level", fixed = 44, align = "RIGHT" },
    { key = "class", label = "Class", fixed = 104 },
    { key = "zone", label = "Zone", width = 0.26 },
    { key = "rank", label = "Rank", width = 0.18 },
    { key = "note", label = "Note", width = 0.26 },
}

-- Each column's x and width for a row `w` wide.
local function columnsFor(w: number): RosterColumn[]
    local fixed = 0
    for _, c in ipairs(COLUMNS) do if c.fixed then fixed = fixed + c.fixed end end
    local gaps = S["space-4"] * (#COLUMNS - 1)
    local room = math.max(0, w - fixed - gaps - S["space-5"] * 2)
    local out: RosterColumn[], x = {}, S["space-5"]
    for i, c in ipairs(COLUMNS) do
        local cw = c.fixed or math.floor(room * c.width)
        out[i] = { x = x, w = cw }
        x = x + cw + S["space-4"]
    end
    return out
end

local function makeRow(g: GuildRoster): RosterRow
    local r: RosterRow = CreateFrame("Button", nil, g.list.child) :: any
    r:SetHeight(ROW_H)
    r:RegisterForClicks("LeftButtonUp", "RightButtonUp")
    r.sel = draw.fill(r, "arcane-soft", "BACKGROUND")
    r.sel:SetAllPoints()
    r.edge = draw.fill(r, "arcane", "ARTWORK")
    r.edge:SetWidth(2)
    r.edge:SetPoint("TOPLEFT")
    r.edge:SetPoint("BOTTOMLEFT")
    r.hover = draw.fill(r, "gilt-faint", "BACKGROUND", 1)
    r.hover:SetAllPoints()
    r.hover:Hide()
    r.diamond = draw.diamond(r, 6, "ink")
    r.classIcon = r:CreateTexture(nil, "ARTWORK")
    r.classIcon:SetSize(16, 16)
    r.cells = {}
    for i, c in ipairs(COLUMNS) do
        local t = uiText.text(r, i == 1 and "label" or "caption", "ink")
        t:SetJustifyH(c.align or "LEFT")
        r.cells[i] = t
    end
    r.badge = CreateFrame("Frame", nil, r) :: any
    r.badge:SetHeight(14)
    draw.fill(r.badge, "surface-raised"):SetAllPoints()
    draw.border(r.badge, "gilt-line")
    r.badge.text = uiText.text(r.badge, "micro", "ink-muted")
    r.badge.text:SetPoint("CENTER")
    r:SetScript("OnEnter", function(self: RosterRow)
        self.hover:Show()
        local m = self.member
        if g.onRowEnter and m then g.onRowEnter(self, m) end
        if m and m.officerNote and m.officerNote ~= "" then
            GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
            GameTooltip_SetTitle(GameTooltip, m.name or "")
            if m.note and m.note ~= "" then GameTooltip_AddNormalLine(GameTooltip, "Note: " .. m.note) end
            GameTooltip_AddNormalLine(GameTooltip, "Officer note: " .. m.officerNote)
            GameTooltip:Show()
        end
    end)
    r:SetScript("OnLeave", function(self: RosterRow)
        self.hover:Hide()
        GameTooltip:Hide()
        if g.onRowLeave then g.onRowLeave(self) end
    end)
    r:SetScript("OnClick", function(self: RosterRow, button: string)
        local m = self.member
        if not m then return end
        if g.onSelect then g.onSelect(m.key) end
        if button == "RightButton" and g.onMenu then g.onMenu(m, self) end
    end)
    r:SetScript("OnDoubleClick", function(self: RosterRow)
        local m = self.member
        if m and m.online and g.onAction then g.onAction("whisper", m) end
    end)
    return r
end

local function footButton(parent: Frame, text: string, variant: string, onClick: () -> ()): RosterButton
    local b = controls.button(parent, { text = text, variant = variant, onClick = onClick }) :: RosterButton
    b:SetHeight(FOOT_H)
    b:HookScript("OnEnter", function(self: RosterButton)
        if self.reason and not self:IsEnabled() then tooltip.showTooltip(self, { title = text, description = self.reason }) end
    end)
    b:HookScript("OnLeave", function() tooltip.hideTooltip() end)
    return b
end

export class GuildRoster extends Frame
    rows: RosterRow[]
    heads: RosterHead[]
    buttons: { [string]: RosterButton }
    search: TextField
    offline: Checkbox
    count: Text
    guildInvite: RosterButton
    box: Frame
    headRow: Frame
    list: ScrollArea
    empty: Text
    selectedMember: GuildMember? = nil
    data: RosterData? = nil
    onSearch: ((text: string) -> ())? = nil
    onShowOffline: ((on: boolean) -> ())? = nil
    onSort: ((column: string) -> ())? = nil
    onSelect: ((key: any) -> ())? = nil
    onAction: ((name: string, member: GuildMember?) -> ())? = nil
    onMenu: ((member: GuildMember, owner: RosterRow) -> ())? = nil
    onRowEnter: ((row: RosterRow, member: GuildMember) -> ())? = nil
    onRowLeave: ((row: RosterRow) -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.rows, self.heads, self.buttons = {}, {}, {}
        -- the top: search, Show offline, the count
        self.search = inputs.textField(self, { width = 200, placeholder = "Search the roster",
            onTextChanged = function(text: string) if self.onSearch then self.onSearch(text) end end })
        self.search:SetPoint("TOPLEFT")
        self.offline = inputs.checkbox(self, { label = "Show offline", onChange = function(on: boolean) if self.onShowOffline then self.onShowOffline(on) end end })
        self.offline:SetPoint("LEFT", self.search, "RIGHT", S["space-5"], 0)
        self.count = uiText.text(self, "caption", "ink-muted")
        self.count:SetPoint("RIGHT", self, "TOPRIGHT", 0, -TOP_H / 2)
        -- the foot: Invite to guild left; the member's actions right
        self.guildInvite = footButton(self, "Invite to guild", "quiet", function() if self.onAction then self.onAction("guildInvite") end end)
        self.guildInvite:SetPoint("BOTTOMLEFT")
        local prev
        for _, def in ipairs({ { "remove", "Remove", "danger" }, { "demote", "Demote", "quiet" }, { "promote", "Promote", "quiet" },
                               { "invite", "Invite", "primary" }, { "whisper", "Whisper", "quiet" } }) do
            local key = def[1]
            local b = footButton(self, def[2], def[3] == "danger" and "quiet" or def[3], function()
                if self.selectedMember and self.onAction then self.onAction(key, self.selectedMember) end
            end)
            if def[3] == "danger" then
                b.border:SetColor("ember")
                b.label:SetColor("ember-text")
                -- back to ember after a hover (the button's own OnLeave sets gilt-line)
                b:HookScript("OnLeave", function(obj: RosterButton) obj.border:SetColor("ember") end)
            end
            if prev then b:SetPoint("RIGHT", prev, "LEFT", -S["space-3"], 0) else b:SetPoint("BOTTOMRIGHT") end
            self.buttons[key] = b
            prev = b
        end
        -- the list: a heading row, then the members
        self.box = CreateFrame("Frame", nil, self)
        self.box:SetPoint("TOPLEFT", self, "TOPLEFT", 0, -(TOP_H + S["space-4"]))
        self.box:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", 0, FOOT_H + S["space-4"])
        draw.fill(self.box, "surface-sunk"):SetAllPoints()
        draw.border(self.box, "gilt-faint")
        self.headRow = CreateFrame("Frame", nil, self.box)
        self.headRow:SetPoint("TOPLEFT", 1, -1)
        self.headRow:SetPoint("TOPRIGHT", -S["space-4"], -1)
        self.headRow:SetHeight(HEAD_ROW_H)
        local rule = draw.fill(self.box, "gilt-faint", "ARTWORK")
        rule:SetHeight(1)
        rule:SetPoint("TOPLEFT", self.headRow, "BOTTOMLEFT")
        rule:SetPoint("TOPRIGHT", self.headRow, "BOTTOMRIGHT")
        for i, c in ipairs(COLUMNS) do
            local h: RosterHead = CreateFrame("Button", nil, self.headRow) :: any
            h:SetHeight(HEAD_ROW_H)
            h.text = uiText.text(h, "caption", "ink-muted")
            h.text:SetAllPoints()
            h.text:SetValue(c.label)
            h:SetScript("OnClick", function() if self.onSort then self.onSort(c.key) end end)
            h:SetScript("OnEnter", function(obj: RosterHead) obj.text:SetColor("ink") end)
            h:SetScript("OnLeave", function(obj: RosterHead)
                local on = ((self.data and self.data.sort) or "rank") == c.key
                obj.text:SetColor(on and "gilt-text" or "ink-muted")
            end)
            self.heads[i] = h
        end
        self.list = panel.scrollArea(self.box, 2)
        self.list:SetPoint("TOPLEFT", self.headRow, "BOTTOMLEFT", 0, -1)
        self.list:SetPoint("BOTTOMRIGHT", self.box, "BOTTOMRIGHT", -S["space-4"], S["space-2"])
        self.list:HookScript("OnSizeChanged", function() if self.data then self:Draw() end end)
        self.empty = uiText.text(self.box, "caption", "ink-muted")
        self.empty:SetPoint("CENTER")
        self.empty:SetValue("No one matches.")
    end

    function Draw()
        local d: RosterData = self.data or {}
        local child = self.list.child
        local w = math.max(1, self.list:GetWidth())
        child:SetWidth(w)
        local cols = columnsFor(w)
        -- the headings
        for i, h in ipairs(self.heads) do
            h:ClearAllPoints()
            h:SetPoint("LEFT", self.headRow, "LEFT", cols[i].x, 0)
            h:SetWidth(cols[i].w)
            local on = (d.sort or "rank") == COLUMNS[i].key
            h.text:SetColor(on and "gilt-text" or "ink-muted")
            h.text:SetJustifyH(COLUMNS[i].align or "LEFT")
        end
        local y, selected = 0, nil :: GuildMember?
        for n, m in ipairs(d.members or {}) do
            local r = self.rows[n] or makeRow(self)
            self.rows[n] = r
            r.member = m
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -y)
            r:SetPoint("RIGHT", child, "RIGHT")
            -- the name in its class colour, online or not (asked for in game);
            -- an offline member's other columns stay ink-faint
            local color = m.class and T.color["class-" .. m.class:lower()] and ("class-" .. m.class:lower()) or (m.online and "ink" or "ink-faint")
            -- offline: still the class colour, greyed out like the rest of the row
            local fade = m.online and 1 or T.opacity["opacity-disabled"]
            draw.paint(r.diamond, color, fade)
            r.diamond:ClearAllPoints()
            r.diamond:SetPoint("CENTER", r, "LEFT", cols[1].x - 8, 0)
            local values = { name = m.name, level = m.level and tostring(m.level) or "", class = m.className or "",
                             zone = m.online and (m.zone or "") or (m.lastOnline or "Offline"), rank = m.rank or "", note = m.note or "" }
            for i, t in ipairs(r.cells) do
                local key = COLUMNS[i].key
                -- the class column: its icon, then its name
                local indent = key == "class" and (16 + S["space-3"]) or 0
                t:ClearAllPoints()
                t:SetPoint("LEFT", r, "LEFT", cols[i].x + indent, 0)
                t:SetWidth(cols[i].w - indent)
                t:SetValue(values[key] or "")
                if i == 1 then t:SetColor(color, fade)
                else t:SetColor(m.online and (key == "note" and "ink-muted" or "ink") or "ink-faint") end
                if key == "class" then
                    local atlas = m.class and GetClassAtlas and GetClassAtlas(m.class)
                    local coords = m.class and CLASS_ICON_TCOORDS and CLASS_ICON_TCOORDS[m.class]
                    if atlas then
                        r.classIcon:SetAtlas(atlas)
                        r.classIcon:SetTexCoord(0, 1, 0, 1)
                    elseif coords then
                        r.classIcon:SetTexture("Interface\\TargetingFrame\\UI-Classes-Circles")
                        r.classIcon:SetTexCoord(coords[1], coords[2], coords[3], coords[4])
                    end
                    r.classIcon:SetShown((atlas or coords) and true or false)
                    r.classIcon:SetDesaturated(not m.online)
                    r.classIcon:SetAlpha(fade)
                    r.classIcon:ClearAllPoints()
                    r.classIcon:SetPoint("LEFT", r, "LEFT", cols[i].x, 0)
                end
            end
            local status = m.busy and "Busy" or (m.away and "Away") or nil
            r.badge:SetShown(status ~= nil and m.online)
            if status then
                r.badge.text:SetValue(status)
                r.badge:SetWidth(math.ceil(r.badge.text:GetUnboundedStringWidth()) + S["space-3"] * 2)
                r.badge:ClearAllPoints()
                r.badge:SetPoint("LEFT", r, "LEFT", cols[1].x + math.min(cols[1].w - 30,
                    math.ceil(r.cells[1]:GetUnboundedStringWidth()) + S["space-3"]), 0)
            end
            local on = m.key == d.selected
            r.sel:SetShown(on); r.edge:SetShown(on)
            if on then selected = m end
            r:Show()
            y = y + ROW_H
        end
        for n = #(d.members or {}) + 1, #self.rows do self.rows[n]:Hide() end
        self.empty:SetShown(#(d.members or {}) == 0)
        child:SetHeight(math.max(1, y))
        -- the foot
        local a = d.actions or {}
        for key, b in pairs(self.buttons) do
            local s = a[key] or {}
            b:SetEnabledState(selected ~= nil and s.enabled and true or false)
            b.reason = not selected and "Choose a member first." or (not s.enabled and s.why) or nil
        end
        self.guildInvite:SetEnabledState(a.guildInvite and a.guildInvite.enabled and true or false)
        self.guildInvite.reason = a.guildInvite and not a.guildInvite.enabled and a.guildInvite.why or nil
        self.selectedMember = selected
    end

    function SetData(d: RosterData)
        self.data = d
        self.count:SetValue((d.online or 0) .. " online · " .. (d.total or 0) .. (d.total == 1 and " member" or " members"))
        self.offline:SetValue(d.showOffline and true or false)
        self:Draw()
    end
end

export function guildRoster(parent: Frame): GuildRoster
    return GuildRoster.new(parent)
end

--------------------------------------------------------------------------------
-- The Info page (design component GuildWindow, "Info"): the guild
-- information down the whole left side (Edit when your rank may), the ranks
-- with how many hold each at the right. The message of the day lives on the
-- Chat tab (GuildMotdBanner).
--
--   local i = guildInfo(parent)  (SuuUI.UI.GuildInfo)
--   i:SetData({ info, canEditInfo, ranks = { { name, count } } })
--   i.onEdit("info")
--------------------------------------------------------------------------------

export type GuildRank = { name?: string, count?: number }
export type GuildInfoData = { info?: string, canEditInfo?: boolean, ranks?: GuildRank[] }

export interface InfoBlock extends Frame
    head: Text
    edit: SuuButton
    text: Text
end

export interface RankRow extends Frame
    name: Text
    count: Text
end

export interface RanksBox extends Frame
    head: Text
end

-- the live pages, drawn again when the theme changes (colour codes in
-- their text, sizes from the text styles)
local infos: { [GuildInfo]: boolean } = setmetatable({}, { __mode = "k" })
local logs: { [GuildLog]: boolean } = setmetatable({}, { __mode = "k" })
local banners: { [GuildMotdBanner]: boolean } = setmetatable({}, { __mode = "k" })

-- Edit level with the heading
local function placeEdit(b: InfoBlock)
    b.edit:SetPoint("RIGHT", b, "TOPRIGHT", -S["space-4"], -(S["space-5"] + T.type.header.lineHeight / 2))
end

local function infoBlock(i: GuildInfo, title: string, key: string): InfoBlock
    local b: InfoBlock = CreateFrame("Frame", nil, i) :: any
    draw.fill(b, "surface-sunk"):SetAllPoints()
    draw.border(b, "gilt-faint")
    b.head = uiText.text(b, "header", "gilt-text")
    b.head:SetPoint("TOPLEFT", S["space-5"], -S["space-5"])
    b.head:SetValue(title)
    b.edit = controls.button(b, { text = "Edit", variant = "quiet", onClick = function() if i.onEdit then i.onEdit(key) end end })
    b.edit:SetHeight(22)
    placeEdit(b)
    b.text = uiText.text(b, "body", "ink")
    b.text:SetPoint("TOPLEFT", b.head, "BOTTOMLEFT", 0, -S["space-3"])
    b.text:SetJustifyH("LEFT")
    b.text:SetWordWrap(true)
    return b
end

export class GuildInfo extends Frame
    rankRows: RankRow[]
    info: InfoBlock
    ranks: RanksBox
    data: GuildInfoData? = nil
    onEdit: ((key: string) -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.rankRows = {}
        self.info = infoBlock(self, "Guild information", "info")
        self.ranks = CreateFrame("Frame", nil, self) :: any
        self.ranks.head = uiText.text(self.ranks, "header", "gilt-text")
        self.ranks.head:SetPoint("TOPLEFT")
        self.ranks.head:SetValue("Ranks")
        self:SetScript("OnSizeChanged", function() if self.data then self:Layout() end end)
        infos[self] = true
    end

    function SetData(d: GuildInfoData)
        self.data = d
        local function block(b: InfoBlock, text: string?, can: boolean?, empty: string)
            b.text:SetValue((text and text ~= "") and text or ("|cff" .. T.color["ink-faint"].hex .. empty .. "|r"))
            b.edit:SetShown(can and true or false)
        end
        block(self.info, d.info, d.canEditInfo, "No guild information yet.")
        self:Layout()
        for i, r in ipairs(d.ranks or {}) do
            local row = self.rankRows[i]
            if not row then
                row = CreateFrame("Frame", nil, self.ranks) :: RankRow
                row.name = uiText.text(row, "body", "ink")
                row.name:SetPoint("LEFT")
                row.count = uiText.text(row, "numeric", "ink-muted")
                row.count:SetPoint("RIGHT")
                self.rankRows[i] = row
            end
            row:SetHeight(T.type.body.lineHeight + S["space-2"])
            row:ClearAllPoints()
            row:SetPoint("TOPLEFT", self.ranks, "TOPLEFT", 0, -(T.type.header.lineHeight + S["space-3"] + (i - 1) * row:GetHeight()))
            row:SetPoint("RIGHT", self.ranks, "RIGHT")
            row.name:SetValue(r.name or "")
            row.count:SetValue(tostring(r.count or 0))
            row:Show()
        end
        for i = #(d.ranks or {}) + 1, #self.rankRows do self.rankRows[i]:Hide() end
    end

    -- The guild information down the left column, the ranks right.
    function Layout()
        local w = self:GetWidth()
        if not w or w <= 0 then return end
        local gap = S["space-6"]
        local left = math.floor((w - gap) * 0.62)
        local b = self.info
        b:ClearAllPoints()
        b:SetPoint("TOPLEFT", self, "TOPLEFT", 0, 0)
        b:SetPoint("BOTTOMLEFT", self, "BOTTOMLEFT", 0, 0)
        b:SetWidth(left)
        b.text:SetWidth(left - S["space-5"] * 2)
        self.ranks:ClearAllPoints()
        self.ranks:SetPoint("TOPLEFT", self, "TOPLEFT", left + gap, 0)
        self.ranks:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT")
    end
end

export function guildInfo(parent: Frame): GuildInfo
    return GuildInfo.new(parent)
end

--------------------------------------------------------------------------------
-- The Log page: the guild's event log (who invited, promoted, demoted,
-- removed whom; who joined or left), newest first, how long ago at the right.
--
--   local l = guildLog(parent)  (SuuUI.UI.GuildLog)
--   l:SetData({ lines = { { text, when } } })
--------------------------------------------------------------------------------

export type GuildLogLine = { text?: string, when?: string }
export type GuildLogData = { lines?: GuildLogLine[] }

export interface LogRow extends Frame
    when: Text
    text: Text
    rule: Texture
end

export class GuildLog extends Frame
    rows: LogRow[]
    list: ScrollArea
    empty: Text
    data: GuildLogData? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.rows = {}
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-faint")
        self.list = panel.scrollArea(self, 2)
        self.list:SetPoint("TOPLEFT", 1, -S["space-2"])
        self.list:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-2"])
        self.list:HookScript("OnSizeChanged", function() if self.data then self:SetData(self.data) end end)
        self.empty = uiText.text(self, "caption", "ink-muted")
        self.empty:SetPoint("CENTER")
        self.empty:SetValue("Nothing has happened in the guild yet.")
        logs[self] = true
    end

    function SetData(d: GuildLogData)
        self.data = d
        local child = self.list.child
        child:SetWidth(math.max(1, self.list:GetWidth()))
        local y = 0
        for i, line in ipairs(d.lines or {}) do
            local r = self.rows[i]
            if not r then
                r = CreateFrame("Frame", nil, child) :: LogRow
                r.when = uiText.text(r, "caption", "ink-faint")
                r.when:SetPoint("RIGHT", -S["space-4"], 0)
                r.text = uiText.text(r, "body", "ink")
                r.text:SetPoint("LEFT", S["space-5"], 0)
                r.text:SetPoint("RIGHT", r.when, "LEFT", -S["space-4"], 0)
                r.text:SetJustifyH("LEFT")
                r.rule = draw.fill(r, "gilt-faint", "ARTWORK")
                r.rule:SetHeight(1)
                r.rule:SetPoint("BOTTOMLEFT", S["space-4"], 0)
                r.rule:SetPoint("BOTTOMRIGHT", -S["space-4"], 0)
                self.rows[i] = r
            end
            r:SetHeight(T.type.body.lineHeight + S["space-3"])
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -y)
            r:SetPoint("RIGHT", child, "RIGHT")
            r.text:SetValue(line.text or "")
            r.when:SetValue(line.when or "")
            r:Show()
            y = y + r:GetHeight()
        end
        for i = #(d.lines or {}) + 1, #self.rows do self.rows[i]:Hide() end
        self.empty:SetShown(#(d.lines or {}) == 0)
        child:SetHeight(math.max(1, y))
    end
end

export function guildLog(parent: Frame): GuildLog
    return GuildLog.new(parent)
end

--------------------------------------------------------------------------------
-- GuildMotdBanner: the guild's message of the day pinned to the top of the
-- Chat tab's messages box (design component GuildMotdBanner): surface-raised
-- with a gilt-faint edge (its bottom is the box's top), a pushpin and
-- "Message of the day" in `header` gilt-text, the message in `body` ink,
-- all centred on its middle with the same room above and below, two lines
-- at most (cut short with an ellipsis, the whole message in a
-- tooltip then). Edit at the right only when your rank may. No message, no
-- banner.
--
--   local b = guildMotdBanner(parent)  (SuuUI.UI.GuildMotdBanner)
--   b:SetData({ text, canEdit })   -- b:Height(): the text's height and its padding, 0 when empty
--   b.onEdit()                      -- b.edit is the Edit button
--------------------------------------------------------------------------------

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
export type MotdData = { text?: string, canEdit?: boolean }

export class GuildMotdBanner extends Frame
    pin: Texture
    head: Text
    message: FontString
    edit: SuuButton
    data: MotdData? = nil
    has: boolean = false
    onEdit: (() -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(2 * S["space-4"] + T.type.body.lineHeight)
        draw.fill(self, "surface-raised"):SetAllPoints()
        draw.border(self, "gilt-faint")
        self:EnableMouse(true)
        self.pin = self:CreateTexture(nil, "OVERLAY")
        self.pin:SetTexture(GLYPHS .. "pushpin.tga")
        self.pin:SetSize(12, 12)
        draw.paint(self.pin, "gilt-text")
        -- all of it centred on the banner's middle, one line or two
        self.pin:SetPoint("LEFT", S["space-5"], 0)
        self.head = uiText.text(self, "header", "gilt-text")
        self.head:SetValue("Message of the day")
        self.head:SetPoint("LEFT", self.pin, "RIGHT", S["space-3"], 0)
        self.message = self:CreateFontString(nil, "OVERLAY")
        fonts.apply(self.message, "body")
        draw.paint(self.message, "ink")
        self.message:SetJustifyH("LEFT")
        self.message:SetJustifyV("TOP")
        self.message:SetWordWrap(true)
        self.message:SetMaxLines(2)
        -- space-6 after the label (a little more room, asked for in game)
        self.message:SetPoint("LEFT", self.head, "RIGHT", S["space-6"], 0)
        self.edit = controls.button(self, { text = "Edit", variant = "quiet", onClick = function() if self.onEdit then self.onEdit() end end })
        self.edit:SetHeight(22)
        self.edit:SetPoint("RIGHT", -S["space-5"], 0)
        self:SetScript("OnSizeChanged", function() self:Layout() end)
        -- cut short: the whole message on hover
        self:SetScript("OnEnter", function()
            local d = self.data
            if not (d and self.has and self.message:IsTruncated()) then return end
            -- (the message, a font string: the declarations take only frames)
            GameTooltip:SetOwner(self.message :: any, "ANCHOR_BOTTOMLEFT", 0, 0)
            GameTooltip_SetTitle(GameTooltip, "Message of the day")
            GameTooltip_AddNormalLine(GameTooltip, d.text or "", true)
            GameTooltip:Show()
        end)
        self:SetScript("OnLeave", function() GameTooltip:Hide() end)
        self:Hide()
        banners[self] = true
    end

    function SetData(d: MotdData?)
        self.data = d
        local text = d and d.text
        local has = type(text) == "string" and text ~= ""
        self.has = has
        self:SetShown(has)
        if not (d and has) then return end
        self.edit:SetShown(d.canEdit and true or false)
        self.message:SetText(text)
        self:Layout()
    end

    function Layout()
        if not self.has then return end
        local w = self:GetWidth()
        if not w or w < 100 then return end
        -- space-6 between the message and Edit (a little more room, asked for in game)
        local right = self.edit:IsShown() and (self.edit:GetWidth() + S["space-5"] + S["space-6"]) or S["space-5"]
        local left = S["space-5"] + 12 + S["space-3"] + self.head:GetStringWidth() + S["space-6"]
        self.message:SetWidth(math.max(60, w - left - right))
        -- as tall as the text really is, the same room above and below it
        local th = math.max(self.message:GetStringHeight() or 0, self.head:GetStringHeight() or 0, 14)
        local h = math.ceil(2 * S["space-4"] + th)
        if math.abs(self:GetHeight() - h) > 0.5 then self:SetHeight(h) end
    end

    function Height(): number
        return self.has and self:GetHeight() or 0
    end
end

export function guildMotdBanner(parent: Frame): GuildMotdBanner
    return GuildMotdBanner.new(parent)
end

events.on("SUUUI_THEME_CHANGED", function()
    for i in pairs(infos) do
        placeEdit(i.info)
        if i.data then i:SetData(i.data) end
    end
    for l in pairs(logs) do if l.data then l:SetData(l.data) end end
    for b in pairs(banners) do b:Layout() end
end, "Guild")
