-- UI/RestedSign.wowlua
-- The rested sign (design "Rested on the player frame", option A "Drift",
-- chosen 2026-10-20): three letters, "z Z Z" in the display font and
-- progress-fill with the names' shadow, over a unit frame's top-right corner
-- on its raid marker's layer. While you earn rested XP each drifts up and
-- fades, one after the other; still, they stand at their start points. With
-- the pool full the first letter is a full moon. It is part of the frame:
-- it takes the frame's alpha, moves and scales with it, and never takes the
-- mouse.
--
--   local sign = restedSign(unitFrame)
--   sign:SetLook(look[, { still = bool, fade = seconds }])
--     look: "earn"  resting with room in the pool: drifting
--           "rest"  resting with nothing to earn (the level cap): still
--           "full"  resting, the pool full: still, the first letter a full moon
--           "carry" out of a rest area with rested XP left: still at opacity-ooc
--           nil     hidden
--     still: stand still even while earning (Animation: Still, edit mode);
--            Reduce motion always does
--     fade: in over that long (ease-out), or out (ease-in); nil: at once

import tokens as T, Easings from "/Core/Tokens"
import * as motion from "/Core/Motion"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import type Text from "/UI/Text"

local DISC = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga"

-- Each letter: its text and style (12 and 16 px), its centre from the
-- frame's TOPRIGHT, its alpha when still, and its loop's start delay. One
-- AnimationGroup per letter, all 4.8 s long: start delay, 2.8 s of drift,
-- end delay, so the three stay in step.
type Letter = { text: string, style: string, x: number, y: number, still: number, delay: number }
local LETTERS: Letter[] = {
    { text = "z", style = "unit-name-sm", x = 7, y = 4, still = 0.55, delay = 0 },
    { text = "Z", style = "unit-name-sm", x = 15, y = 14, still = 0.8, delay = 0.7 },
    { text = "Z", style = "unit-name-lg", x = 26, y = 27, still = 1, delay = 1.4 },
}
local PERIOD, DRIFT = 4.8, 2.8
local DRIFT_X, DRIFT_Y = 3, 8
local FADE_IN, HOLD, FADE_OUT = 0.6, 1.0, 1.2
local MOON = 7

local function smoothing(easing: keyof Easings): SmoothingType
    return T.easing[easing].smoothing :: SmoothingType
end

-- A letter's loop: the holder drifts and fades in, its glyph fades out (an
-- alpha animation of its own on another region, so neither waits on the
-- other's end state). The holder rests at alpha 0 while it loops, so the
-- start delay and the end delay show nothing.
local function buildLoop(holder: Frame, glyph: Region, d: Letter): AnimationGroup
    local g = holder:CreateAnimationGroup()
    g:SetLooping("REPEAT")
    local move = g:CreateAnimation("Translation")
    move:SetOffset(DRIFT_X, DRIFT_Y)
    move:SetDuration(DRIFT)
    move:SetStartDelay(d.delay)
    move:SetEndDelay(PERIOD - DRIFT - d.delay)
    move:SetSmoothing(smoothing("ease-out"))
    local fadeIn = g:CreateAnimation("Alpha")
    fadeIn:SetFromAlpha(0)
    fadeIn:SetToAlpha(1)
    fadeIn:SetDuration(FADE_IN)
    fadeIn:SetStartDelay(d.delay)
    fadeIn:SetSmoothing(smoothing("ease-out"))
    local fadeOut = g:CreateAnimation("Alpha")
    fadeOut:SetTarget(glyph)
    fadeOut:SetFromAlpha(1)
    fadeOut:SetToAlpha(0)
    fadeOut:SetDuration(FADE_OUT)
    fadeOut:SetStartDelay(d.delay + FADE_IN + HOLD)
    fadeOut:SetSmoothing(smoothing("ease-in"))
    return g
end

-- One letter: its glyph drifting in its own frame, the loop, its alpha when
-- still; the first one's full moon (and its shadow) too.
class LetterFrame extends Frame
    readonly glyph: Text
    readonly loop: AnimationGroup
    readonly still: number
    shade?: Texture
    moon?: Texture

    constructor(parent: Frame, anchor: Frame, d: Letter)
        super(nil, parent)
        self:SetSize(1, 1)
        self:SetPoint("CENTER", anchor, "TOPRIGHT", d.x, d.y)
        self.glyph = uiText.text(self, d.style, "progress-fill")
        self.glyph:SetShadowed(true)
        self.glyph:SetPoint("CENTER", self, "CENTER", 0, 0)
        self.glyph:SetValue(d.text)
        self.loop = buildLoop(self, self.glyph, d)
        self.still = d.still
    end
end

export class RestedSign extends Frame
    body: Frame
    letters: LetterFrame[]
    out: AnimationGroup
    outAlpha: Alpha
    animating: boolean? = nil
    look: string? = nil

    -- (over a unit frame's marker layer, when it has one)
    constructor(frame: Frame)
        super(nil, (frame :: { markerLayer?: Frame }).markerLayer or frame)
        self:SetSize(1, 1)
        self:SetPoint("CENTER", frame, "TOPRIGHT", 0, 0)
        self:EnableMouse(false)
        self:Hide()
        -- the body carries opacity-ooc out of a rest area; the sign itself its fades
        self.body = CreateFrame("Frame", nil, self)
        self.body:SetAllPoints()
        self.letters = {}
        for i, d in ipairs(LETTERS) do
            self.letters[i] = LetterFrame.new(self.body, frame, d)
        end
        -- the full moon in the first letter's place, with the same shadow (0 1px, black 90%)
        local first = self.letters[1]
        local shade = first:CreateTexture(nil, "ARTWORK")
        first.shade = shade
        shade:SetTexture(DISC)
        shade:SetSize(MOON, MOON)
        shade:SetPoint("CENTER", first, "CENTER", 0, -1)
        shade:SetVertexColor(0, 0, 0, 0.9)
        local moon = first:CreateTexture(nil, "OVERLAY")
        first.moon = moon
        moon:SetTexture(DISC)
        moon:SetSize(MOON, MOON)
        moon:SetPoint("CENTER", first, "CENTER", 0, 0)
        draw.paint(moon, "progress-fill")

        -- leaving: from where it is to 0, ease-in, then hidden
        self.out = self:CreateAnimationGroup()
        self.outAlpha = self.out:CreateAnimation("Alpha")
        self.outAlpha:SetToAlpha(0)
        self.outAlpha:SetSmoothing(smoothing("ease-in"))
        self.out:SetScript("OnFinished", function()
            self:Gone()
        end)
        -- a loop doesn't run while hidden: shown again, the three start together
        self:SetScript("OnShow", function()
            if self.animating then
                self:Restart()
            end
        end)
        self:SetMoon(false)
    end

    function SetMoon(on: boolean)
        local first = self.letters[1]
        first.glyph:SetShown(not on)
        if first.moon then
            first.moon:SetShown(on)
        end
        if first.shade then
            first.shade:SetShown(on)
        end
    end

    function Restart()
        for _, l in ipairs(self.letters) do
            l.loop:Stop()
            l:SetAlpha(0)
            l.loop:Play()
        end
    end

    -- Drifting, or standing at the start points.
    function Pose(still: boolean?)
        if still then
            self.animating = false
            for _, l in ipairs(self.letters) do
                l.loop:Stop()
                l:SetAlpha(l.still)
            end
        elseif not self.animating then
            self.animating = true
            self:Restart()
        end
    end

    function Gone()
        self:Pose(true)
        self:Hide()
        self:SetAlpha(1)
    end

    function SetLook(look: string?, opts: { still?: boolean, fade?: number }?)
        opts = opts or {}
        if not look then
            if not self.look then
                return
            end
            self.look = nil
            local from = self:GetAlpha()
            motion.stop(self)
            if opts.fade and opts.fade > 0 and self:IsVisible() and not motion.reduced() then
                self.outAlpha:SetFromAlpha(from)
                self.outAlpha:SetDuration(opts.fade)
                self:SetAlpha(0) -- what's left when the fade ends
                self.out:Play()
            else
                self.out:Stop()
                self:Gone()
            end
            return
        end
        local appearing = not self.look
        self.look = look
        self.body:SetAlpha(look == "carry" and T.opacity["opacity-ooc"] or 1)
        self:SetMoon(look == "full")
        self:Pose(opts.still or look ~= "earn" or motion.reduced())
        if appearing then
            self.out:Stop()
            self:Show()
            if opts.fade and opts.fade > 0 then
                motion.fadeIn(self, opts.fade)
            else
                motion.stop(self)
            end
        end
    end
end

export function restedSign(frame: Frame): RestedSign
    return RestedSign.new(frame)
end
