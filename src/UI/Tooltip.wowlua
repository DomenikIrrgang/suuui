-- UI/Tooltip.wowlua
-- SuuUI's own tooltip, the detail layer for its frames: a panel with a single
-- top-left diamond, at most 280px wide, space-4 from its owner. It appears
-- after a 120ms hover intent with a dur-fast fade and hides at once.
-- (Blizzard's GameTooltip is restyled separately, in step 2.7.)
--
--   showTooltip(owner, {
--       title = "Shield Wall", titleColor = "quality-epic",   -- default ink
--       subtitle = "Warrior · Protection",
--       lines = { { "Instant", "30 min cooldown" }, { "Requires a shield" } },
--                 -- 0.17: a line's `gap` = space before it ({ "Next", gap = 8 })
--       description = "Reduces all damage taken by 75% for 10 sec.",
--       meta = "Ready in 21m",
--       maxWidth = 360,                                       -- 0.17; default 280
--   })
--   hideTooltip()
--   tooltipFrame(parent) -> a standalone tooltip with :SetContent(data)

import after from "wowlua:timer"
import isSecret from "wowlua:secret"
import hook, hookScript from "wowlua:hooks"
import tokens as T from "/Core/Tokens"
import root as suuRoot from "/Core/Root"
import * as events from "/Core/Events"
import * as motion from "/Core/Motion"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import Panel from "/UI/Panel"
import stack as layoutStack, Stack from "/UI/Layout"

local S = T.space

local MAX_W = 280
local INTENT = 0.12

-- A line: its left text, an optional right one, and (0.17) the space before it.
export type TooltipLine = { [number]: string, gap?: number }

-- What a tooltip shows.
export type TooltipData = {
    title?: string,
    titleColor?: string,
    subtitle?: string,
    lines?: TooltipLine[],
    description?: string,
    meta?: string,
    maxWidth?: number,
}

-- A tooltip's data, or a function of its owner that makes it.
export type TooltipSource = TooltipData | ((owner: Region) -> TooltipData)

-- A line's row: the left text and the right one.
export class TooltipRow extends Frame
    readonly left: Text
    readonly right: Text

    constructor(parent: Frame)
        super(nil, parent)
        self.left = text(self, "body", "ink")
        self.left:SetPoint("LEFT")
        self.right = text(self, "body", "ink-muted")
        self.right:SetPoint("RIGHT")
    end
end

-- a theme change: the shown ones laid out again (the text styles' sizes)
local tips: { [TooltipFrame]: boolean } = setmetatable({}, { __mode = "k" })
events.on("SUUUI_THEME_CHANGED", function()
    for t in pairs(tips) do
        if t:IsShown() and t.content then t:SetContent(t.content) end
    end
end, "UI.TooltipFrame")

export class TooltipFrame extends Panel
    stackFrame: Frame
    stack: Stack
    heading: Text
    sub: Text
    desc: Text
    status: Text
    rows: TooltipRow[]
    content: TooltipData? = nil

    constructor(parent: Frame)
        super(parent, { ornament = true, solid = false })
        tips[self] = true
        -- Sized by SetContent, not by the panel body.
        self.body:SetScript("OnSizeChanged", nil)
        self.body:Hide()
        self.stackFrame = CreateFrame("Frame", nil, self)
        self.stackFrame:SetPoint("TOPLEFT", S["space-5"], -S["space-5"])
        self.stack = layoutStack(self.stackFrame, { gap = S["space-1"] })
        self.heading = text(self.stackFrame, "unit-name-lg", "ink")
        self.sub = text(self.stackFrame, "caption", "ink-muted")
        self.desc = text(self.stackFrame, "body", "ink")
        self.desc:SetWordWrap(true)
        self.desc:SetJustifyH("LEFT")
        self.status = text(self.stackFrame, "caption", "ink-muted")
        self.rows = {}
    end

    private function Row(i: number): TooltipRow
        local r = self.rows[i]
        if not r then
            r = TooltipRow.new(self.stackFrame)
            self.rows[i] = r
        end
        return r
    end

    function SetContent(d: TooltipData)
        self.content = d
        local stack = self.stack
        stack:Clear()
        local pad = S["space-5"]

        self.heading:SetColor(d.titleColor or "ink")
        self.heading:SetValue(d.title or "")
        local natural = self.heading:GetUnboundedStringWidth()
        stack:Add(self.heading)

        self.sub:SetValue(d.subtitle or "")
        self.sub:SetShown(d.subtitle ~= nil)
        if d.subtitle then
            stack:Add(self.sub)
            natural = math.max(natural, self.sub:GetUnboundedStringWidth())
        end

        for _, r in ipairs(self.rows) do r:Hide() end
        for i, l in ipairs(d.lines or {}) do
            local r = self:Row(i)
            r.left:SetValue(l[1] or "")
            r.right:SetValue(l[2] or "")
            local w = r.left:GetUnboundedStringWidth() + (l[2] and (S["space-5"] + r.right:GetUnboundedStringWidth()) or 0)
            natural = math.max(natural, w)
            r:SetHeight(T.type.body.lineHeight)
            r:Show()
            -- l.gap (0.17): space before a line that starts a new entry
            stack:Add(r, { gapBefore = (i == 1 and d.subtitle and S["space-2"] + S["space-1"]) or l.gap })
        end

        -- with a maxWidth (0.17), a description wraps at that width, not at the
        -- title's (a short title made a quest's objectives wrap early)
        if d.description and d.maxWidth then
            self.desc:SetValue(d.description)
            natural = math.max(natural, self.desc:GetUnboundedStringWidth())
        end
        -- the meta line counts too (a long hint ran past the edge), and wraps
        -- below when wider than the most
        if d.meta then
            self.status:SetValue(d.meta)
            natural = math.max(natural, self.status:GetUnboundedStringWidth())
        end
        local width = math.min(d.maxWidth or MAX_W, math.max(natural, 120) + pad * 2)
        local inner = width - pad * 2

        -- the title and subtitle wrap too when longer than the width
        -- ("Brackenwall Village, Dustwallow Marsh" ran past the edge); always
        -- the inner width (a width of 0 for a short one measured as 0 and
        -- emptied the tooltip; found in game)
        for _, t in ipairs({ self.heading, self.sub }) do
            t:SetWordWrap(true)
            t:SetJustifyH("LEFT")
            t:SetFixedWidth(inner)
        end

        self.desc:SetShown(d.description ~= nil)
        if d.description then
            self.desc:SetFixedWidth(inner)
            self.desc:SetValue(d.description)
            stack:Add(self.desc, { gapBefore = S["space-2"] + S["space-1"] })
        end
        self.status:SetShown(d.meta ~= nil)
        if d.meta then
            self.status:SetWordWrap(true)
            self.status:SetJustifyH("LEFT")
            self.status:SetFixedWidth(inner)
            self.status:SetValue(d.meta)
            stack:Add(self.status, { gapBefore = S["space-2"] + S["space-1"] })
        end
        for i, r in ipairs(self.rows) do
            r:SetWidth(inner)
            -- a line without a right side wraps inside the width (a map pin's
            -- "Varg Windwhisper  Leather Armor Merchant" ran past the edge)
            local l = d.lines and d.lines[i]
            if l and r:IsShown() then
                r.left:ClearAllPoints()
                if l[2] then
                    r.left:SetWordWrap(false)
                    r.left:SetWidth(0)
                    r.left:SetPoint("LEFT")
                else
                    r.left:SetWordWrap(true)
                    r.left:SetJustifyH("LEFT")
                    r.left:SetWidth(inner)
                    r.left:SetPoint("TOPLEFT")
                    r:SetHeight(math.max(T.type.body.lineHeight, math.ceil(r.left:GetStringHeight())))
                end
            end
        end
        self:SetWidth(width)
        stack:ApplyNow()
        self:SetHeight(self.stackFrame:GetHeight() + pad * 2)
    end
end

export function tooltipFrame(parent: Frame): TooltipFrame
    return TooltipFrame.new(parent)
end

--------------------------------------------------------------------------------
-- The shared tooltip
--------------------------------------------------------------------------------

local shared: TooltipFrame?, intent: TimerHandle?
-- what the shared tooltip shows now: its owner and its data
local current: { owner?: Region, data?: TooltipSource } = {}

export function hideTooltip()
    if intent then intent:Cancel() intent = nil end
    if shared then shared:Hide() end
    current.owner, current.data = nil, nil
end

export function showTooltip(owner: Region, data: TooltipSource)
    hideTooltip()
    intent = after(INTENT, function()
        intent = nil
        if not owner:IsVisible() then return end
        local tip = shared or tooltipFrame(suuRoot)
        shared = tip
        tip:SetFrameStrata("TOOLTIP")
        -- seen even while the UI is faded out (the NPC dialogue's scene)
        tip:SetIgnoreParentAlpha(true)
        tip:SetClampedToScreen(true)
        current.owner, current.data = owner, data
        if type(data) == "function" then tip:SetContent(data(owner)) else tip:SetContent(data) end
        tip:ClearAllPoints()
        tip:SetPoint("BOTTOMLEFT", owner, "TOPRIGHT", S["space-4"], S["space-4"])
        tip:Show()
        motion.fadeIn(tip, T.duration["dur-fast"])
    end)
end

-- 0.17: the shared tooltip shown for `owner` again, with its data a function
-- asked again (a modifier key changes what it says): nothing when it shows
-- for another frame, or not yet.
export function refreshTooltip(owner: Region)
    local data, tip = current.data, shared
    if not (tip and tip:IsShown() and current.owner == owner and type(data) == "function") then return end
    tip:SetContent(data(owner))
end

-- Shows `data` (a table, or a function of the frame) while the mouse is over `frame`.
export function attachTooltip(frame: Frame, data: TooltipSource)
    frame:HookScript("OnEnter", function(self: Frame) showTooltip(self, data) end)
    frame:HookScript("OnLeave", hideTooltip)
end

--------------------------------------------------------------------------------
-- Blizzard's tooltips in SuuUI's look (design board "Tooltips")
--
--   skinTooltip(tooltip)  -- GameTooltip, the compare tooltips, ItemRefTooltip
--
-- surface-glass under a gilt-line edge with the gilt diamond at the top left,
-- drawn on the tooltip's own BACKGROUND layer; Blizzard's NineSlice at alpha
-- 0 (again after each SharedTooltip_SetBackdropStyle, which runs on every
-- show). Only art is added: lines, sizes, anchors and every set function stay
-- Blizzard's.
--------------------------------------------------------------------------------

type Art = { bg: Texture, border: draw.Border, ornament: Texture }

local skinned: { [Frame]: Art } = {}

-- Blizzard's tooltip art (the NineSlice its template makes).
local function hideBlizzardArt(tooltip: Frame)
    local nineSlice = (tooltip :: { NineSlice?: Frame }).NineSlice
    if nineSlice then nineSlice:SetAlpha(0) end
end

export function skinTooltip(tooltip: Frame?): Art?
    if not tooltip or skinned[tooltip] then return nil end
    local bg = tooltip:CreateTexture(nil, "BACKGROUND", nil, -8)
    draw.paintFill(bg, "surface-glass")
    bg:SetAllPoints()
    local art: Art = {
        bg = bg,
        border = draw.border(tooltip, "gilt-line", { layer = "BACKGROUND", sublevel = -7 }),
        ornament = draw.diamond(tooltip, 7, "gilt", "OVERLAY", 7),
    }
    art.ornament:SetPoint("CENTER", tooltip, "TOPLEFT", 0, 0)
    skinned[tooltip] = art
    hideBlizzardArt(tooltip)
    return art
end

export function isTooltipSkinned(tooltip: Frame): boolean return skinned[tooltip] ~= nil end

if type(SharedTooltip_SetBackdropStyle) == "function" then
    hook("SharedTooltip_SetBackdropStyle", function(tooltip: Frame)
        if skinned[tooltip] then hideBlizzardArt(tooltip) end
    end)
end

--------------------------------------------------------------------------------
-- A spell's game tooltip with lines of SuuUI's under it (0.12)
--------------------------------------------------------------------------------
-- spellTooltip(owner, spellID, extra[, anchor]): GameTooltip with the
-- spell (SetSpellByID), then `extra` (text, or a list) as last lines. The
-- game redraws the tooltip when a spell's data arrives (the first hover of a
-- spell not loaded yet), which drops lines added after it: these are added
-- in a post-call too, so every draw carries them (found in game: the cost
-- showed only on the second hover).

type Pending = { id: number, owner: Frame, lines: string[], added?: boolean }

local pending: Pending? -- { id, lines }

local function addExtra(tooltip: GameTooltip, lines: string[])
    for _, line in ipairs(lines) do tooltip:AddLine(line, 1, 1, 1, true) end
end

-- The spell post-call: the pending lines on GameTooltip when it draws that
-- spell for that owner.
-- (data: the game's tooltip data; the id is a secret in some places)
local function spellPostCall(tooltip: GameTooltip, data: { id?: number | Secret<number> }?)
    local p = pending
    if tooltip ~= GameTooltip or not p then return end
    local id = data and data.id
    if isSecret(id) then return end
    if id == p.id and tooltip:GetOwner() == p.owner then
        addExtra(tooltip, p.lines)
        p.added = true
    end
end

local hooked: boolean | "post" = false
local function hookSpellTips()
    if hooked then return end
    hooked = true
    if TooltipDataProcessor and TooltipDataProcessor.AddTooltipPostCall and Enum.TooltipDataType and Enum.TooltipDataType.Spell then
        TooltipDataProcessor.AddTooltipPostCall(Enum.TooltipDataType.Spell, spellPostCall)
        hooked = "post"
    end
    hookScript(GameTooltip, "OnHide", function() pending = nil end)
end

export function spellTooltip(owner: Frame, spellID: number, extra: string | string[] | nil, anchor: TooltipAnchor?)
    hookSpellTips()
    local lines: string[] = type(extra) == "table" and extra or (extra and { extra } or {})
    -- the owner first: it hides what the tooltip showed, and its OnHide
    -- clears `pending` (found in game)
    GameTooltip:SetOwner(owner, anchor or "ANCHOR_RIGHT")
    local mine: Pending = { id = spellID, owner = owner, lines = lines }
    pending = mine
    GameTooltip:SetSpellByID(spellID)
    -- no post-call in this client, or it didn't run: add them now
    if hooked ~= "post" or not mine.added then
        pending = mine
        addExtra(GameTooltip, mine.lines)
        mine.added = true
    end
    GameTooltip:Show()
end
