-- UI/Spellbook.wowlua
-- The Spellbook page (design board "Spellbook"): the schools as icons down
-- the left (a gilt diamond by the open one, an arcane dot on one with spells
-- to train), then the school's name, "2 spells to train" in arcane and the
-- Unlearned spells and All ranks switches; the spells in two columns, each
-- an icon and its name over "Rank 3", "Passive", "Train now · 6g 50s" (arcane)
-- or "Level 58"; a pager along the foot.
--
--   local book = spellbook(parent, { rows = 6, edgeInset = 20 })  -- the page's
--                          -- distance from the window's edge (the schools centre between)
--   book:SetSchools({ { label, icon, trainable, active } }); book.onSchool = fn(i)
--   book:SetHead(title, toTrain[, all])   -- all = { count, cost (copper),
--                          -- short (true: you can't afford it all) }: what
--                          -- every school's spells to train cost, the counts
--                          -- on hover; without it the school's count
--   book:SetSwitches(showUnlearned, allRanks); book.onSwitch = fn(key, on)
--   book:SetSpells(list)   -- { label, rank, sub, icon, status = "learned" |
--                          -- "passive" | "trainable" | "future" }, a page's worth
--   book:SetPage(page, pages); book.onPage = fn(delta)
--   book.cells[i].button   -- a SecureActionButton (the owner sets what it casts)
--   book:FitRows()         -- rows to the page's height (a page holds rows × 2)
--   book:SetWidest(px)     -- the longest name anywhere: columns as wide on every page
--   book.onEnter / onLeave = fn(i, cell)
--   (a drag picks up what the cell casts: the game's secure drag handler,
--   in combat too); book.onDragStart = fn(i, cell) after it
--   book:SetCooldown(i, active, gcd, duration)   -- the sweep over a spell's
--                          -- icon: the engine's duration object (secret-safe);
--                          -- the global cooldown sweeps without digits
-- Cells are secure buttons. What each casts on every school's every page
-- is handed over out of combat (book:SetCasts); a secure router points
-- the cells at the page shown, so the schools and pages switch in combat
-- too: the tabs and the pager's arrows each carry an invisible secure
-- button over them that takes the click (the game lets only secure code
-- change what a button casts in combat). In combat the page changes only
-- its look: nothing secure is moved, shown or hidden (an empty slot's
-- content goes see-through instead).
--   book:SetCasts(schools, perPage[, clicks])   -- schools[s][i] = spellID,
--                          -- a spell's name (a pet's) or false, in the order
--                          -- SetSpells shows them; clicks[s][i]: the secure
--                          -- button a right click on it clicks (its name, a
--                          -- pet bar's button: its autocast) or false (a right
--                          -- click casts nothing); out of combat
--   book:SetCastPage(school, page)    -- out of combat: the router to that page
-- Mouseover bindings (0.23):
--   book:SetChips(i, keys)  -- a cell's bindings as key chips after its rank
--                          -- line: two at most, then "+N"; book:ChipsWidth(keys)
--   book.onBind = fn()     -- the head's Bind button; book:SetBindEnabled(on)
--   book.onMenu = fn(i, cell)   -- a right click on a cell
--   book:SetCovers(on, live)    -- bind mode: a cover over each cell takes
--                          -- keys aside, clicks and the wheel (live[i]: a
--                          -- spell that can be bound); book.onCover(i, input),
--                          -- book.onCoverEnter(i), book.onCoverLeave(i)
--   book:SetStrip(title, detail, tone)  -- bind mode's strip over the head
--                          -- (nil: gone); book.onStripDone = fn()
--   book.onBindingsTab = fn()   -- the Bindings tab under the schools
--   book:ShowView(on)      -- book.view over the page (the bindings list),
--                          -- the spells and pager hidden under it

import tokens as T from "/Core/Tokens"
import * as draw from "/UI/Draw"
import text, measureText, Text from "/UI/Text"
import icon, Icon from "/UI/Icon"
import * as inputs from "/UI/Inputs"
import type Toggle from "/UI/Inputs"
import * as controls from "/UI/Controls"
import type SuuButton from "/UI/Controls"
import tabMarker, TabMarker from "/UI/TabMarker"
import keyChip, KeyChip from "/UI/Panel"
import showTooltip, hideTooltip from "/UI/Tooltip"
import type TooltipData, TooltipLine from "/UI/Tooltip"

-- A secure handler frame (SecureHandler*Template): SetFrameRef from its template.
type FrameRefs = { SetFrameRef: (self: Frame, id: string, frame: Region) -> () }

local S = T.space

local ICON = 36
local TAB = 32
local COLUMNS = 2

-- A spell on the page: its label, the line under it, its icon (rank),
-- and what it is to you; autocast: a pet's spell cast on its own (an
-- arcane border on its icon).
export type BookSpell = {
    label?: string,
    rank?: number | string,
    sub?: string,
    icon?: string | number,
    status?: string,
    autocast?: boolean,
}
-- A school's tab.
export type BookSchool = { label?: string, icon?: string | number, trainable?: number, active?: boolean }
-- Every school's spells to train and what they cost; short: you can't afford it all.
export type BookAll = { count?: number, cost?: number, short?: boolean }

-- A cell of the page: the secure button with its icon, the label, the line
-- under it, the cooldown.
export class SpellCell extends Frame
    readonly button: Button
    readonly icon: Icon
    readonly label: Text
    readonly sub: Text
    readonly cooldown: Cooldown
    spell: BookSpell? = nil
    -- its bindings' chips, and bind mode's cover
    chips: KeyChip[] = {}
    cover: Button? = nil

    constructor(book: Spellbook, i: number)
        super(nil, book.grid)
        self:SetHeight(ICON)
        -- (the secure drag template: a drag picks the spell up through the
        -- game's own code; an addon's pickup is blocked in combat, found in game)
        local b = CreateFrame("Button", nil, self, "SecureActionButtonTemplate,SecureHandlerDragTemplate")
        b:SetSize(ICON, ICON)
        b:SetPoint("LEFT")
        -- down and up registered (up alone never cast, found in game), acting
        -- on the release whatever the game's "cast on key down" option says
        -- (useOnKeyDown off): pressing to drag a spell to a bar cast it (found
        -- in game); the press starts the drag, a release on the icon casts
        b:RegisterForClicks("LeftButtonDown", "LeftButtonUp", "RightButtonUp")
        b:SetAttribute("useOnKeyDown", false)
        -- a right click casts nothing ("": the secure template's no-op; else
        -- it falls back to "type"), unless the router gives it a button to
        -- click (a pet's spell: the pet bar's button, its autocast)
        b:SetAttribute("type2", "")
        b:RegisterForDrag("LeftButton")
        self.button = b
        self.icon = icon(b, ICON)
        self.icon:SetAllPoints()
        self.icon:EnableMouse(false)
        self.label = text(self, "label", "ink")
        self.label:SetPoint("TOPLEFT", b, "TOPRIGHT", S["space-4"], -2)
        self.label:SetPoint("RIGHT")
        self.label:SetJustifyH("LEFT")
        self.label:SetWordWrap(false)
        self.sub = text(self, "caption", "ink-muted")
        self.sub:SetPoint("BOTTOMLEFT", b, "BOTTOMRIGHT", S["space-4"], 2)
        self.sub:SetPoint("RIGHT")
        self.sub:SetJustifyH("LEFT")
        self.sub:SetWordWrap(false)
        b:SetScript("OnEnter", function()
            self.icon:SetBorder("gilt")
            if book.onEnter then
                book.onEnter(i, self)
            end
        end)
        b:SetScript("OnLeave", function()
            book:DrawCell(self)
            if book.onLeave then
                book.onLeave(i, self)
            end
        end)
        -- a right click: the owner's menu (the button casts on a left click
        -- only, a right click does what the router set: mostly nothing; the
        -- hook runs after the game's own handling)
        b:HookScript("OnMouseUp", function(_, mouse)
            if mouse == "RightButton" and book.onMenu then
                book.onMenu(i, self)
            end
        end)
        b:SetAttribute("_ondragstart", [=[
            local id = self:GetAttribute("spell")
            if id then return "spell", id end
        ]=])
        -- after the secure handler: the owner's own pickup (a pet's spell)
        b:HookScript("OnDragStart", function()
            if book.onDragStart then
                book.onDragStart(i, self)
            end
        end)
        local cd = CreateFrame("Cooldown", nil, self.icon, "CooldownFrameTemplate")
        self.cooldown = cd
        cd:SetAllPoints(self.icon.art)
        cd:SetDrawEdge(false)
        cd:SetDrawBling(false)
        cd:SetSwipeColor(0, 0, 0, 0.7)
        pcall(cd.SetCountdownFont, cd, "SuuUIFont_micro")
        cd:HookScript("OnCooldownDone", function()
            if book.onCooldownDone then
                book.onCooldownDone()
            end
        end)
    end
end

local function cell(book: Spellbook, i: number): SpellCell
    local c = book.cells[i]
    if c then
        return c
    end
    c = SpellCell.new(book, i)
    book.cells[i] = c
    return c
end

-- The secure side: a router that points the cells at a school's page, and
-- what each cell casts there, as its attributes ("cast<school>_<page>_<i>",
-- "pages<school>"), and what a right click on it runs ("click<school>_<page>_<i>":
-- a macro's text, "/click <button> RightButton"). Out of combat.
-- (The right click is a macro, not the "click" type: secure code can hand a
-- button only a frame handle as its clickbutton, and the game's click action
-- calls frame methods a handle lacks; a real frame can't come through
-- secure code: its attributes scrub it to nil.)
local ROUTE = [=[
    if name ~= "school" and name ~= "page" then return end
    local s, p = self:GetAttribute("school"), self:GetAttribute("page")
    if not s or not p then return end
    for i = 1, self:GetAttribute("cells") or 0 do
        local b = self:GetFrameRef("cell" .. i)
        local id = self:GetAttribute("cast" .. s .. "_" .. p .. "_" .. i)
        if id then
            b:SetAttribute("type", "spell")
            b:SetAttribute("spell", id)
        else
            b:SetAttribute("type", nil)
            b:SetAttribute("spell", nil)
        end
        local click = self:GetAttribute("click" .. s .. "_" .. p .. "_" .. i)
        if click then
            b:SetAttribute("type2", "macro")
            b:SetAttribute("macrotext2", click)
        else
            b:SetAttribute("type2", "")
            b:SetAttribute("macrotext2", nil)
        end
    end
]=]

-- An invisible secure button over a control: it takes the click, runs
-- `snippet` (secure, in combat too), then `onClick`; the control's hover
-- look follows it. It is the control's sibling, placed where the control
-- is (by the caller), never its child nor anchored to it: a frame that
-- holds or anchors a secure one is restricted in combat too, and the
-- control's look changes in combat (an arrow's enabled state).
local function secureOver(
    book: Spellbook,
    control: Region,
    snippet: string,
    onClick: () -> (),
    onEnter: () -> (),
    onLeave: () -> ()
): Button
    local o = CreateFrame("Button", nil, control:GetParent() :: Frame, "SecureHandlerClickTemplate") :: Button
        & FrameRefs
    o:SetSize(control:GetWidth(), control:GetHeight())
    o:SetFrameLevel(control:GetFrameLevel() + 5)
    o:RegisterForClicks("LeftButtonUp")
    o:SetFrameRef("router", book.router)
    o:SetAttribute("_onclick", snippet)
    o:HookScript("OnClick", onClick)
    o:SetScript("OnEnter", onEnter)
    o:SetScript("OnLeave", onLeave)
    return o
end

local hex = draw.hex

-- A mouse button as bindings spell it.
local MOUSE: { [string]: string } = {
    LeftButton = "BUTTON1",
    RightButton = "BUTTON2",
    MiddleButton = "BUTTON3",
    Button4 = "BUTTON4",
    Button5 = "BUTTON5",
}

-- The modifiers held, as bindings spell them ("ALT-CTRL-SHIFT-META-").
local function modifiers(): string
    return (IsAltKeyDown() and "ALT-" or "") ..
        (IsControlKeyDown() and "CTRL-" or "") ..
            (IsShiftKeyDown() and "SHIFT-" or "") .. ((IsMetaKeyDown and IsMetaKeyDown()) and "META-" or "")
end

-- Bind mode's cover over a cell: a click, the wheel and the hover go to the
-- owner (keys come from the owner's own catcher).
local function makeCover(book: Spellbook, c: SpellCell, i: number): Button
    local o = CreateFrame("Button", nil, book.main)
    o:SetAllPoints(c)
    o:SetFrameLevel(c.button:GetFrameLevel() + 10)
    o:EnableMouseWheel(true)
    -- the spell hovered: an arcane edge round it and its icon, the spell
    -- itself in sight (a fill over it hid it: found in game)
    local edge = draw.border(o, "arcane")
    edge:SetShown(false)
    o:SetScript("OnEnter", function()
        edge:SetShown(true)
        c.icon:SetBorder("arcane")
        if book.onCoverEnter then
            book.onCoverEnter(i)
        end
    end)
    o:SetScript("OnLeave", function()
        edge:SetShown(false)
        book:DrawCell(c)
        if book.onCoverLeave then
            book.onCoverLeave(i)
        end
    end)
    o:SetScript("OnMouseDown", function(_, mouse)
        local key = MOUSE[mouse]
        if key and book.onCover then
            book.onCover(i, modifiers() .. key)
        end
    end)
    o:SetScript("OnMouseWheel", function(_, delta)
        if book.onCover then
            book.onCover(i, modifiers() .. (delta > 0 and "MOUSEWHEELUP" or "MOUSEWHEELDOWN"))
        end
    end)
    o:Hide()
    return o
end

-- 3g 20s: the digits in ink and the units in coin colours, or all of it in
-- ember-text when you can't afford it.
local function coinText(amount: number?, short: boolean?): (string, string)
    local copper = math.max(0, math.floor(tonumber(amount) or 0))
    local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local plain: string[], parts: string[] = {}, {}
    local function part(v: number, unit: string, token: string)
        plain[#plain + 1] = v .. unit
        parts[#parts + 1] = short and (v .. unit) or
            ("|cff" .. hex("ink") .. v .. "|r|cff" .. hex(token) .. unit .. "|r")
    end
    if g > 0 then
        part(g, "g", "coin-gold")
    end
    if s > 0 or (g > 0 and c > 0) then
        part(s, "s", "coin-silver")
    end
    if c > 0 or #parts == 0 then
        part(c, "c", "coin-copper")
    end
    local out = table.concat(parts, " ")
    if short then
        out = "|cff" .. hex("ember-text") .. out .. "|r"
    end
    return out, table.concat(plain, " ")
end

local function spells(n: number): string
    return n .. (n == 1 and " spell" or " spells")
end

-- A switch in the head: its label and toggle.
class BookSwitch extends Frame
    readonly toggle: Toggle
    readonly text: Text

    constructor(book: Spellbook, parent: Frame, label: string, key: string)
        super(nil, parent)
        self.toggle = inputs.toggle(self, {
            onChange = function(on: boolean)
                if book.onSwitch then
                    book.onSwitch(key, on)
                end
            end,
        })
        self.toggle:SetPoint("RIGHT")
        self.text = text(self, "label", "ink-muted")
        self.text:SetPoint("RIGHT", self.toggle, "LEFT", -S["space-3"], 0)
        self.text:SetValue(label)
        self:SetSize(self.text:GetUnboundedStringWidth() + S["space-3"] + 34, 18)
    end
end

local function switch(book: Spellbook, parent: Frame, label: string, key: string): BookSwitch
    return BookSwitch.new(book, parent, label, key)
end

-- A school's tab: its icon and "to train" mark; hover and click come from
-- the secure button over it.
class SchoolTab extends Button
    readonly icon: Icon
    readonly ring: Texture
    readonly dot: Texture
    secure?: Button
    index: number = 0
    label?: string
    trainable?: number
    active?: boolean

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(TAB, TAB)
        self.icon = icon(self, TAB)
        self.icon:SetAllPoints()
        self.icon:EnableMouse(false)
        -- the "spells to train" mark, above the icon (the icon is a frame
        -- of its own: drawn on the tab, the mark sat under it)
        local over = CreateFrame("Frame", nil, self)
        over:SetAllPoints()
        over:SetFrameLevel(self.icon:GetFrameLevel() + 3)
        over:EnableMouse(false)
        self.ring = draw.diamond(over, 9, "surface", "OVERLAY", 6)
        self.ring:SetPoint("CENTER", self, "TOPRIGHT", -2, -2)
        self.dot = draw.diamond(over, 7, "arcane", "OVERLAY", 7)
        self.dot:SetPoint("CENTER", self, "TOPRIGHT", -2, -2)
        self:EnableMouse(false)
    end
end

-- The rows a page holds, and the page's distance from the window's edge.
export type SpellbookOptions = { rows?: number, edgeInset?: number }

export class Spellbook extends Frame
    rows: number
    edgeInset: number
    cells: SpellCell[]
    tabs: SchoolTab[]
    tabColumn: Frame
    main: Frame
    title: Text
    toTrain: Text
    -- over the cost: what is left to train, on hover (SetHead)
    toTrainHover: Frame
    trainTip: TooltipData? = nil
    allRanks: Toggle
    unlearned: Toggle
    unlearnedSwitch: BookSwitch
    ranksSwitch: BookSwitch
    -- the pager's arrows' secure buttons
    prevSecure?: Button
    nextSecure?: Button
    grid: Frame
    pager: Frame
    pageText: Text
    prev: SuuButton
    next: SuuButton
    foot: Frame
    router: Frame & FrameRefs
    castKeys: string[]? = nil
    widest: number? = nil
    schoolMarker: TabMarker? = nil
    -- mouseover bindings: the head's button, bind mode's strip, the tab and
    -- the view over the page
    bindButton: SuuButton
    strip: Frame
    stripTitle: Text
    stripDetail: Text
    stripDone: SuuButton
    bindTab: Button
    bindTabIcon: Icon
    bindTabActive: boolean = false
    view: Frame
    onBind: (() -> ())? = nil
    onMenu: ((i: number, cell: SpellCell) -> ())? = nil
    onCover: ((i: number, input: string) -> ())? = nil
    onCoverEnter: ((i: number) -> ())? = nil
    onCoverLeave: ((i: number) -> ())? = nil
    onStripDone: (() -> ())? = nil
    onBindingsTab: (() -> ())? = nil
    -- what the owner hears: a cell entered or left, a school, a switch, a page
    onEnter: ((i: number, cell: SpellCell) -> ())? = nil
    onLeave: ((i: number, cell: SpellCell) -> ())? = nil
    onSchool: ((i: number) -> ())? = nil
    onSwitch: ((key: string, on: boolean) -> ())? = nil
    onPage: ((delta: number) -> ())? = nil
    onCooldownDone: (() -> ())? = nil
    onDragStart: ((i: number, cell: SpellCell) -> ())? = nil

    constructor(parent: Frame, options: SpellbookOptions?)
        local opts = options or {}
        super(nil, parent)
        self.rows = opts.rows or 6
        self.edgeInset = opts.edgeInset or 0 -- from the window's edge to the page
        self.cells, self.tabs = {}, {}
        -- the schools' column and its rule
        self.tabColumn = CreateFrame("Frame", nil, self)
        self.tabColumn:SetPoint("TOPLEFT")
        self.tabColumn:SetPoint("BOTTOMLEFT")
        self.tabColumn:SetWidth(40)
        local rule = self:CreateTexture(nil, "ARTWORK")
        draw.paintFill(rule, "gilt-faint")
        rule:SetWidth(1)
        rule:SetPoint("TOPLEFT", self.tabColumn, "TOPRIGHT", 0, 0)
        rule:SetPoint("BOTTOMLEFT", self.tabColumn, "BOTTOMRIGHT", 0, 0)
        -- the main column
        local main = CreateFrame("Frame", nil, self)
        main:SetPoint("TOPLEFT", self.tabColumn, "TOPRIGHT", S["space-5"], 0)
        main:SetPoint("BOTTOMRIGHT")
        self.main = main
        self.title = text(main, "header", "gilt-text")
        self.title:SetPoint("TOPLEFT", 0, -6)
        self.toTrain = text(main, "caption", "arcane")
        self.toTrain:SetPoint("LEFT", self.title, "RIGHT", S["space-5"], 0)
        local hover = CreateFrame("Frame", nil, main)
        hover:SetAllPoints(self.toTrain)
        hover:EnableMouse(true)
        hover:SetScript("OnEnter", function()
            local tip = self.trainTip
            if tip then
                showTooltip(hover, tip)
            end
        end)
        hover:SetScript("OnLeave", function()
            hideTooltip()
        end)
        self.toTrainHover = hover
        local ranks = switch(self, main, "All ranks", "allRanks")
        self.allRanks = ranks.toggle
        self.ranksSwitch = ranks
        ranks:SetPoint("TOPRIGHT", 0, -6)
        local unlearned = switch(self, main, "Unlearned spells", "unlearned")
        self.unlearned = unlearned.toggle
        self.unlearnedSwitch = unlearned
        unlearned:SetPoint("RIGHT", ranks, "LEFT", -S["space-5"], 0)
        -- Bind: bind mode (mouseover bindings)
        self.bindButton = controls.button(main, {
            text = "Bind",
            tooltip = {
                title = "Mouseover bindings",
                description = "Bind spells to keys, clicks and the wheel: they cast on the unit under the mouse, on unit frames and in the world.",
            },
            onClick = function()
                if self.onBind then
                    self.onBind()
                end
            end,
        })
        self.bindButton:SetHeight(24)
        self.bindButton:SetPoint("RIGHT", unlearned, "LEFT", -S["space-5"], 0)
        -- bind mode's strip, over the head
        local strip = CreateFrame("Frame", nil, main)
        strip:SetPoint("TOPLEFT", 0, 0)
        strip:SetPoint("RIGHT")
        strip:SetHeight(34)
        strip:SetFrameLevel(main:GetFrameLevel() + 20)
        strip:EnableMouse(true)
        draw.fill(strip, "surface-raised"):SetAllPoints()
        draw.border(strip, "arcane")
        self.stripDone = controls.button(strip, {
            text = "Done",
            variant = "primary",
            onClick = function()
                if self.onStripDone then
                    self.onStripDone()
                end
            end,
        })
        self.stripDone:SetHeight(22)
        self.stripDone:SetPoint("RIGHT", -4, 0)
        self.stripTitle = text(strip, "label", "arcane")
        self.stripTitle:SetPoint("LEFT", S["space-4"], 0)
        self.stripTitle:SetWordWrap(false)
        self.stripDetail = text(strip, "caption", "ink-muted")
        self.stripDetail:SetPoint("LEFT", self.stripTitle, "RIGHT", S["space-4"], 0)
        self.stripDetail:SetPoint("RIGHT", self.stripDone, "LEFT", -S["space-4"], 0)
        self.stripDetail:SetJustifyH("LEFT")
        -- (two lines when it's long: one cut it short, found in game)
        self.stripDetail:SetWordWrap(true)
        self.stripDetail:SetMaxLines(2)
        strip:Hide()
        self.strip = strip
        -- the grid
        self.grid = CreateFrame("Frame", nil, main)
        self.grid:SetPoint("TOPLEFT", 0, -(30 + S["space-4"]))
        self.grid:SetPoint("RIGHT")
        self.grid:SetHeight(self.rows * ICON + (self.rows - 1) * S["space-4"])
        -- the pager over a gilt-faint rule
        local foot = CreateFrame("Frame", nil, main)
        foot:SetPoint("BOTTOMLEFT")
        foot:SetPoint("BOTTOMRIGHT")
        foot:SetHeight(30 + S["space-3"])
        local frule = foot:CreateTexture(nil, "ARTWORK")
        draw.paintFill(frule, "gilt-faint")
        frule:SetHeight(1)
        frule:SetPoint("TOPLEFT")
        frule:SetPoint("TOPRIGHT")
        -- the page text in a frame of its own, as wide as its longest text: the
        -- arrows' secure buttons anchor to it (the game refuses to anchor a
        -- protected frame to a text: found in game)
        self.pager = CreateFrame("Frame", nil, foot)
        self.pager:SetSize(math.ceil(measureText("caption", "Page 10 of 10")), 30)
        self.pager:SetPoint("BOTTOM")
        self.pageText = text(self.pager, "caption", "ink-muted")
        self.pageText:SetPoint("BOTTOM", 0, 8)
        self.prev = controls.button(foot, {
            text = "",
            width = 30,
            onClick = function()
                if self.onPage then
                    self.onPage(-1)
                end
            end,
        })
        self.prev:SetPoint("RIGHT", self.pager, "LEFT", -S["space-5"], 0)
        self.next = controls.button(foot, {
            text = "",
            width = 30,
            onClick = function()
                if self.onPage then
                    self.onPage(1)
                end
            end,
        })
        self.next:SetPoint("LEFT", self.pager, "RIGHT", S["space-5"], 0)
        local arrows: { button: SuuButton, glyph: string, delta: number }[] = {
            { button = self.prev, glyph = "chevronLeft", delta = -1 },
            { button = self.next, glyph = "chevronRight", delta = 1 },
        }
        for _, pair in ipairs(arrows) do
            local g = pair.button:CreateTexture(nil, "OVERLAY")
            draw.glyph(g, pair.glyph)
            g:SetSize(14, 14)
            g:SetPoint("CENTER")
            draw.paint(g, "ink")
        end
        self.foot = foot
        -- the view over the page (the bindings list): above the cells and
        -- the pager's secure buttons, taking the mouse from them
        local view = CreateFrame("Frame", nil, self)
        view:SetPoint("TOPLEFT", main, "TOPLEFT")
        view:SetPoint("BOTTOMRIGHT", main, "BOTTOMRIGHT")
        view:SetFrameLevel(main:GetFrameLevel() + 60)
        view:EnableMouse(true)
        view:Hide()
        self.view = view
        -- the Bindings tab, under the schools (not a school: no secure button)
        local tab = CreateFrame("Button", nil, self.tabColumn)
        tab:SetSize(TAB, TAB)
        self.bindTabIcon = icon(tab, TAB)
        self.bindTabIcon:SetAllPoints()
        self.bindTabIcon:EnableMouse(false)
        self.bindTabIcon:SetArt("Interface\\Icons\\INV_Misc_Key_03")
        tab:SetAlpha(0.6)
        tab:SetScript("OnEnter", function()
            tab:SetAlpha(1)
            showTooltip(tab, {
                title = "Bindings",
                description = "Your mouseover bindings: spells on keys, clicks and the wheel.",
            })
        end)
        tab:SetScript("OnLeave", function()
            tab:SetAlpha(self.bindTabActive and 1 or 0.6)
            hideTooltip()
        end)
        tab:SetScript("OnClick", function()
            if self.onBindingsTab then
                self.onBindingsTab()
            end
        end)
        self.bindTab = tab
        -- the secure side: the router, and the pager's arrows' secure buttons
        self.router = CreateFrame("Frame", nil, self, "SecureHandlerAttributeTemplate") :: Frame & FrameRefs
        self.router:SetAttribute("_onattributechanged", ROUTE)
        for _, pair in ipairs(arrows) do
            local arrow, delta = pair.button, pair.delta
            -- the arrow's own hover look, from the button over it
            local enter, leave = arrow:GetScript("OnEnter"), arrow:GetScript("OnLeave")
            local o = secureOver(self, arrow, [=[
                local r = self:GetFrameRef("router")
                local s = r:GetAttribute("school")
                if not s then return end
                local p = (r:GetAttribute("page") or 1) + self:GetAttribute("delta")
                local n = r:GetAttribute("pages" .. s) or 1
                if p < 1 then p = 1 elseif p > n then p = n end
                r:SetAttribute("page", p)
            ]=], function()
                if self.onPage and arrow:IsEnabled() then
                    self.onPage(delta)
                end
            end, function()
                if enter then
                    enter(arrow, true)
                end
            end, function()
                if leave then
                    leave(arrow, true)
                end
            end)
            o:SetAttribute("delta", delta)
            if delta < 0 then
                self.prevSecure = o
            else
                self.nextSecure = o
            end
            -- (where the arrow is: beside the page text's frame)
            if delta < 0 then
                o:SetPoint("RIGHT", self.pager, "LEFT", -S["space-5"], 0)
            else
                o:SetPoint("LEFT", self.pager, "RIGHT", S["space-5"], 0)
            end
        end
    end

    function SetCooldown(i: number, active: unknown, gcd: unknown, duration: LuaDurationObject?)
        local c = self.cells[i]
        if not c then
            return
        end
        if active and duration then
            c.cooldown:SetCooldownFromDurationObject(duration)
            c.cooldown:SetHideCountdownNumbers(gcd ~= nil and gcd ~= false)
        else
            c.cooldown:Clear()
        end
    end

    function DrawCell(c: SpellCell)
        local s = c.spell
        if not s then
            return
        end
        local st = s.status or "learned"
        if st == "trainable" then
            c.icon:SetState("dim")
            c.icon:SetBorder("arcane")
            c.sub:SetColor("arcane")
            c.label:SetColor("ink")
        elseif st == "future" then
            c.icon:SetState("dim")
            c.icon:SetBorder("gilt-hairline")
            c.sub:SetColor("ink-muted")
            c.label:SetColor("ink-muted")
        else
            c.icon:SetState("rest")
            c.icon:SetBorder(s.autocast and "arcane" or "gilt-hairline")
            c.sub:SetColor("ink-muted")
            c.label:SetColor("ink")
        end
    end

    function SetSpells(list: BookSpell[])
        local width = self.main:GetWidth()
        -- the columns as wide as the longest name or line on the page, the pair
        -- centred; the rows centred between the head and the pager (found in
        -- game: half-width columns left space to the right, and a gap below)
        local widest = 0
        for i = 1, self.rows * COLUMNS do
            local s = list[i]
            if s then
                local name = (s.label or "") ..
                    ((s.status ~= "learned" and s.status ~= "passive" and s.rank) and ("  Rank " .. s.rank) or "")
                widest = math.max(widest, measureText("label", name), measureText("caption", s.sub or ""))
            end
        end
        -- (the owner's widest name across every school, when given: the same
        -- columns on every page, one spell alone included: found in game)
        if self.widest then
            widest = math.max(widest, self.widest)
        end
        local colW = math.min((width - S["space-6"]) / COLUMNS, ICON + S["space-4"] + math.ceil(widest) + S["space-3"])
        local used = COLUMNS * colW + (COLUMNS - 1) * S["space-6"]
        local headH = 30 + S["space-4"]
        local room = self.main:GetHeight() - headH - self.foot:GetHeight() - S["space-4"]
        local gridH = self.rows * ICON + (self.rows - 1) * S["space-4"]
        -- (in combat the grid and its cells stay as they are: they hold secure
        -- buttons; the columns are as wide on every page anyway, SetWidest)
        local layout = not InCombatLockdown()
        if layout then
            self.grid:ClearAllPoints()
            self.grid:SetPoint(
                "TOPLEFT",
                self.main,
                "TOPLEFT",
                math.max(0, (width - used) / 2),
                -(headH + math.max(0, (room - gridH) / 2))
            )
            self.grid:SetSize(used, gridH)
        end
        for i = 1, self.rows * COLUMNS do
            local c = cell(self, i)
            local s = list[i]
            c.spell = s
            if layout then
                local r, col = math.floor((i - 1) / COLUMNS), (i - 1) % COLUMNS
                c:ClearAllPoints()
                c:SetPoint("TOPLEFT", self.grid, "TOPLEFT", col * (colW + S["space-6"]), -r * (ICON + S["space-4"]))
                c:SetWidth(colW)
                c:Show()
            end
            -- an empty slot keeps its cell (shown: it can't be shown in combat), see-through
            c:SetAlpha(s and 1 or 0)
            if s then
                c.icon:SetArt(s.icon)
                -- "Healing Wave  Rank 10" for a rank not learned yet (the rank in ink-muted)
                local name = s.label or ""
                if s.status ~= "learned" and s.status ~= "passive" and s.rank then
                    name = name .. "  |cff" .. T.color["ink-muted"].hex .. "Rank " .. s.rank .. "|r"
                end
                c.label:SetValue(name)
                c.sub:SetValue(s.sub or "")
                self:DrawCell(c)
            else
                c.cooldown:Clear()
            end
        end
        -- the rows a taller page had
        if layout then
            for i = self.rows * COLUMNS + 1, #self.cells do
                self.cells[i]:Hide()
            end
        end
    end

    -- schools[s][i]: the spell a school's i-th cell casts (its ID or name),
    -- or false; clicks[s][i]: the secure button a right click on it clicks
    -- (its global name), or false.
    function SetCasts(schools: (number | string | false)[][], perPage: number, clicks: (string | false)[][]?)
        if InCombatLockdown() then
            return
        end
        local r = self.router
        for _, key in ipairs(self.castKeys or {}) do
            r:SetAttribute(key, nil)
        end
        local keys: string[] = {}
        for s, list in ipairs(schools) do
            local pages = math.max(1, math.ceil(#list / perPage))
            r:SetAttribute("pages" .. s, pages)
            keys[#keys + 1] = "pages" .. s
            for i, id in ipairs(list) do
                if id then
                    local p, slot = math.floor((i - 1) / perPage) + 1, (i - 1) % perPage + 1
                    local key = "cast" .. s .. "_" .. p .. "_" .. slot
                    r:SetAttribute(key, id)
                    keys[#keys + 1] = key
                end
            end
            for i, name in ipairs(clicks and clicks[s] or {}) do
                if name then
                    local p, slot = math.floor((i - 1) / perPage) + 1, (i - 1) % perPage + 1
                    local key = "click" .. s .. "_" .. p .. "_" .. slot
                    r:SetAttribute(key, "/click " .. name .. " RightButton")
                    keys[#keys + 1] = key
                end
            end
        end
        self.castKeys = keys
        -- every cell the page may hold, known to the router
        for i = 1, perPage do
            local c = cell(self, i)
            r:SetFrameRef("cell" .. i, c.button)
        end
        r:SetAttribute("cells", perPage)
    end

    function SetCastPage(school: number, page: number)
        if InCombatLockdown() then
            return
        end
        -- (both set: the router points the cells at the page each time)
        self.router:SetAttribute("page", page)
        self.router:SetAttribute("school", school)
    end

    -- As many rows as the page's height holds (out of combat: the cells are
    -- secure buttons). Returns the rows.
    function FitRows()
        local h = self.main:GetHeight()
        if not h or h <= 0 or InCombatLockdown() then
            return self.rows
        end
        local room = h - (30 + S["space-4"]) - self.foot:GetHeight() - S["space-4"]
        local rows = math.max(1, math.floor((room + S["space-4"]) / (ICON + S["space-4"])))
        if rows ~= self.rows then
            self.rows = rows
            self.grid:SetHeight(rows * ICON + (rows - 1) * S["space-4"])
        end
        return rows
    end

    -- The longest name the book has anywhere (columns as wide on every page).
    function SetWidest(px: number?)
        self.widest = px
    end

    function SetSchools(list: BookSchool[])
        -- the chosen school's jewel, gliding down the column (tabMarker)
        local marker = self.schoolMarker or
            tabMarker(self.tabColumn, { vertical = true, side = "RIGHT", x = S["space-4"] + 2 })
        self.schoolMarker = marker
        local chosen: SchoolTab? = nil
        for i, s in ipairs(list) do
            local t = self.tabs[i]
            if not t then
                local tab = SchoolTab.new(self.tabColumn)
                t = tab
                local function entered()
                    tab:SetAlpha(1)
                    marker.hovered = tab
                    marker:Aim()
                    local n = tab.trainable
                    showTooltip(tab, {
                        title = tab.label,
                        description = n and n > 0 and (n .. (n == 1 and " spell" or " spells") .. " to train") or nil,
                    })
                end
                local function left()
                    tab:SetAlpha(tab.active and 1 or 0.6)
                    if marker.hovered == tab then
                        marker.hovered = nil
                    end
                    marker:Aim()
                    hideTooltip()
                end
                tab.secure = secureOver(
                    self,
                    tab,
                    [=[
                    local r = self:GetFrameRef("router")
                    r:SetAttribute("page", 1)
                    r:SetAttribute("school", self:GetAttribute("school"))
                ]=],
                    function()
                        if self.onSchool then
                            self.onSchool(tab.index)
                        end
                    end,
                    entered,
                    left
                )
                self.tabs[i] = tab
            end
            t.index, t.label, t.trainable, t.active = i, s.label, s.trainable, s.active
            t.icon:SetArt(s.icon)
            t.dot:SetShown((s.trainable or 0) > 0)
            t.ring:SetShown((s.trainable or 0) > 0)
            if s.active then
                chosen = t
            end
            t:SetAlpha(s.active and 1 or 0.6)
            -- (in combat the tabs stay where they are: their secure buttons with them)
            local secure = t.secure :: Button
            if not InCombatLockdown() then
                secure:SetAttribute("school", i)
                -- centred between the window's edge (edgeInset to the left) and the divider
                local x, y = (40 - self.edgeInset) / 2, -(i - 1) * (TAB + S["space-3"])
                t:ClearAllPoints()
                t:SetPoint("TOP", self.tabColumn, "TOPLEFT", x, y)
                t:Show()
                secure:ClearAllPoints()
                secure:SetPoint("TOP", self.tabColumn, "TOPLEFT", x, y)
                secure:Show()
            end
        end
        if not InCombatLockdown() then
            for i = #list + 1, #self.tabs do
                self.tabs[i]:Hide()
                local secure = self.tabs[i].secure
                if secure then
                    secure:Hide()
                end
            end
        end
        -- the Bindings tab under the last school (a plain button: in combat too)
        local x = (40 - self.edgeInset) / 2
        self.bindTab:ClearAllPoints()
        self.bindTab:SetPoint("TOP", self.tabColumn, "TOPLEFT", x, -#list * (TAB + S["space-3"]) - S["space-3"])
        marker:SetChosen(self.bindTabActive and self.bindTab or chosen)
    end

    -- The Bindings tab chosen (the schools' marker by it) or not.
    function SetBindingsTab(active: boolean)
        self.bindTabActive = active
        self.bindTab:SetAlpha(active and 1 or 0.6)
        if active and self.schoolMarker then
            self.schoolMarker:SetChosen(self.bindTab)
        end
    end

    -- The view over the page shown (the spells, the head and the pager
    -- see-through under it: they hold secure buttons, hidden only out of
    -- combat) or gone.
    function ShowView(on: boolean)
        self.view:SetShown(on)
        local a = on and 0 or 1
        self.grid:SetAlpha(a)
        self.foot:SetAlpha(a)
        self.title:SetAlpha(a)
        self.toTrain:SetAlpha(a)
        self.toTrainHover:SetShown(not on)
        self.unlearnedSwitch:SetAlpha(a)
        self.ranksSwitch:SetAlpha(a)
        -- (a plain button: hidden, not see-through; its enabled state set
        -- its alpha back, so it showed over the Bindings tab, reported by a
        -- player; the tab has its own Bind spells)
        self.bindButton:SetShown(not on)
        for _, c in ipairs(self.cells) do
            if c.cover then
                c.cover:SetAlpha(a)
            end
        end
    end

    -- A cell's bindings as chips after its rank line: two, then "+N".
    function SetChips(i: number, keys: string[])
        local c = self.cells[i]
        if not c then
            return
        end
        local shown: string[] = {}
        for k = 1, math.min(#keys, 2) do
            shown[#shown + 1] = keys[k]
        end
        if #keys > 2 then
            shown[#shown + 1] = "+" .. (#keys - 2)
        end
        local subW = c.sub:GetUnboundedStringWidth()
        for k, label in ipairs(shown) do
            local chip = c.chips[k] or keyChip(c, "")
            c.chips[k] = chip
            chip:SetKey(label)
            chip:SetHeight(14)
            chip:ClearAllPoints()
            local prev = c.chips[k - 1]
            if k == 1 or not prev then
                chip:SetPoint("LEFT", c.sub, "LEFT", subW > 0 and (subW + S["space-3"]) or 0, 0)
            else
                chip:SetPoint("LEFT", prev, "RIGHT", S["space-2"], 0)
            end
            chip:Show()
        end
        for k = #shown + 1, #c.chips do
            c.chips[k]:Hide()
        end
    end

    -- How wide a cell's chips are (the columns made room for them).
    function ChipsWidth(keys: string[]): number
        if #keys == 0 then
            return 0
        end
        local w = 0
        for k = 1, math.min(#keys, 2) do
            w = w + math.max(20, measureText("micro", keys[k]) + S["space-2"] * 2) + S["space-2"]
        end
        if #keys > 2 then
            w = w + math.max(20, measureText("micro", "+" .. (#keys - 2)) + S["space-2"] * 2)
        end
        return w + S["space-3"]
    end

    -- Bind mode's covers over the cells shown, or gone. live[i]: a spell
    -- that can be bound (the others dimmed under theirs).
    function SetCovers(on: boolean, live: boolean[]?)
        for i, c in ipairs(self.cells) do
            local cover = c.cover or makeCover(self, c, i)
            c.cover = cover
            cover:SetShown(on and c:IsShown())
            local can = live and live[i] or false
            c:SetAlpha(c.spell and ((not on or can) and 1 or 0.35) or 0)
        end
    end

    -- Bind mode's strip over the head (nil: gone); `tone` the title's colour.
    function SetStrip(title: string?, detail: string?, tone: string?)
        if not title then
            self.strip:Hide()
            return
        end
        self.stripTitle:SetValue(title)
        self.stripTitle:SetColor(tone or "arcane")
        self.stripDetail:SetValue(detail or "")
        self.strip:Show()
    end

    function SetBindEnabled(on: boolean)
        self.bindButton:SetEnabledState(on)
    end

    function SetHead(title: string?, trainable: number?, all: BookAll?)
        self.title:SetValue(title or "")
        local toTrain = trainable or 0
        local count = all and all.count or 0
        self.trainTip = nil
        if count <= 0 then
            self.toTrain:SetValue(toTrain > 0 and (spells(toTrain) .. " to train") or "")
            return
        end
        -- only what it all costs (asked 2026-11-07: the counts ran into the
        -- Bind button); the counts on hover
        local cost = coinText((all :: BookAll).cost, (all :: BookAll).short)
        self.toTrain:SetText(cost)
        self.toTrain.value = nil
        local lines: TooltipLine[] = {}
        if toTrain > 0 then
            lines[#lines + 1] = { spells(toTrain) .. " to train here" }
        end
        lines[#lines + 1] = { spells(count) .. " to train in all schools", cost }
        self.trainTip = {
            title = "To train",
            lines = lines,
            description = (all :: BookAll).short and "More than you have with you." or nil,
        }
    end

    function SetSwitches(unlearned: boolean, allRanks: boolean)
        self.unlearned:SetValue(unlearned)
        self.allRanks:SetValue(allRanks)
    end

    function SetPage(page: number, pages: number)
        self.pageText:SetValue(("Page %d of %d"):format(page, math.max(1, pages)))
        self.prev:SetEnabledState(page > 1)
        self.next:SetEnabledState(page < pages)
    end
end

export function spellbook(parent: Frame, options: SpellbookOptions?): Spellbook
    return Spellbook.new(parent, options)
end
