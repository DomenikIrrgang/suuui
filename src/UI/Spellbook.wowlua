-- UI/Spellbook.wowlua
-- The Spellbook page (design board "Spellbook"): the schools as icons down
-- the left (a gilt diamond by the open one, an arcane dot on one with spells
-- to train), then the school's name, "2 spells to train" in arcane and the
-- Unlearned spells and All ranks switches; the spells in two columns, each
-- an icon and its name over "Rank 3", "Passive", "Train now · 6g 50s" (arcane)
-- or "Level 58"; a pager along the foot.
--
--   local book = spellbook(parent, { rows = 6, edgeInset = 20 })  -- the page's
--                          -- distance from the window's edge (the schools centre between)
--   book:SetSchools({ { label, icon, trainable, active } }); book.onSchool = fn(i)
--   book:SetHead(title, toTrain[, all])   -- all = { count, cost (copper),
--                          -- short (true: you can't afford it all) }: every
--                          -- school's spells to train and what they cost,
--                          -- after the school's count, as room allows
--   book:SetSwitches(showUnlearned, allRanks); book.onSwitch = fn(key, on)
--   book:SetSpells(list)   -- { label, rank, sub, icon, status = "learned" |
--                          -- "passive" | "trainable" | "future" }, a page's worth
--   book:SetPage(page, pages); book.onPage = fn(delta)
--   book.cells[i].button   -- a SecureActionButton (the owner sets what it casts)
--   book:FitRows()         -- rows to the page's height (a page holds rows × 2)
--   book:SetWidest(px)     -- the longest name anywhere: columns as wide on every page
--   book.onEnter / onLeave = fn(i, cell)
--   (a drag picks up what the cell casts: the game's secure drag handler,
--   in combat too)
--   book:SetCooldown(i, active, gcd, duration)   -- the sweep over a spell's
--                          -- icon: the engine's duration object (secret-safe);
--                          -- the global cooldown sweeps without digits
-- Cells are secure buttons. What each casts on every school's every page
-- is handed over out of combat (book:SetCasts); a secure router points
-- the cells at the page shown, so the schools and pages switch in combat
-- too: the tabs and the pager's arrows each carry an invisible secure
-- button over them that takes the click (the game lets only secure code
-- change what a button casts in combat). In combat the page changes only
-- its look: nothing secure is moved, shown or hidden (an empty slot's
-- content goes see-through instead).
--   book:SetCasts(schools, perPage)   -- schools[s][i] = spellID or false,
--                          -- in the order SetSpells shows them; out of combat
--   book:SetCastPage(school, page)    -- out of combat: the router to that page

import tokens as T from "/Core/Tokens"
import * as draw from "/UI/Draw"
import text, measureText, Text from "/UI/Text"
import icon from "/UI/Icon"
import * as inputs from "/UI/Inputs"
import * as controls from "/UI/Controls"
import tabMarker from "/UI/TabMarker"
import showTooltip, hideTooltip from "/UI/Tooltip"

local S = T.space

local ICON = 36
local TAB = 32
local COLUMNS = 2

local function cell(book: any, i: number): any
    local c = book.cells[i]
    if c then return c end
    c = CreateFrame("Frame", nil, book.grid)
    c:SetHeight(ICON)
    -- (the secure drag template: a drag picks the spell up through the
    -- game's own code; an addon's pickup is blocked in combat, found in game)
    local b = CreateFrame("Button", nil, c, "SecureActionButtonTemplate,SecureHandlerDragTemplate")
    b:SetSize(ICON, ICON)
    b:SetPoint("LEFT")
    -- down and up registered (up alone never cast, found in game), acting
    -- on the release whatever the game's "cast on key down" option says
    -- (useOnKeyDown off): pressing to drag a spell to a bar cast it (found
    -- in game); the press starts the drag, a release on the icon casts
    b:RegisterForClicks("LeftButtonDown", "LeftButtonUp")
    b:SetAttribute("useOnKeyDown", false)
    b:RegisterForDrag("LeftButton")
    c.button = b
    c.icon = icon(b, ICON)
    c.icon:SetAllPoints()
    c.icon:EnableMouse(false)
    c.label = text(c, "label", "ink")
    c.label:SetPoint("TOPLEFT", b, "TOPRIGHT", S["space-4"], -2)
    c.label:SetPoint("RIGHT")
    c.label:SetJustifyH("LEFT")
    c.label:SetWordWrap(false)
    c.sub = text(c, "caption", "ink-muted")
    c.sub:SetPoint("BOTTOMLEFT", b, "BOTTOMRIGHT", S["space-4"], 2)
    c.sub:SetPoint("RIGHT")
    c.sub:SetJustifyH("LEFT")
    c.sub:SetWordWrap(false)
    b:SetScript("OnEnter", function()
        c.icon:SetBorder("gilt")
        if book.onEnter then book.onEnter(i, c) end
    end)
    b:SetScript("OnLeave", function()
        book:DrawCell(c)
        if book.onLeave then book.onLeave(i, c) end
    end)
    b:SetAttribute("_ondragstart", [=[
        local id = self:GetAttribute("spell")
        if id then return "spell", id end
    ]=])
    c.cooldown = CreateFrame("Cooldown", nil, c.icon, "CooldownFrameTemplate")
    c.cooldown:SetAllPoints(c.icon.art)
    c.cooldown:SetDrawEdge(false)
    c.cooldown:SetDrawBling(false)
    c.cooldown:SetSwipeColor(0, 0, 0, 0.7)
    if c.cooldown.SetCountdownFont then pcall(c.cooldown.SetCountdownFont, c.cooldown, "SuuUIFont_micro") end
    c.cooldown:HookScript("OnCooldownDone", function() if book.onCooldownDone then book.onCooldownDone() end end)
    book.cells[i] = c
    return c
end

-- The secure side: a router that points the cells at a school's page, and
-- what each cell casts there, as its attributes ("cast<school>_<page>_<i>",
-- "pages<school>"). Out of combat.
local ROUTE = [=[
    if name ~= "school" and name ~= "page" then return end
    local s, p = self:GetAttribute("school"), self:GetAttribute("page")
    if not s or not p then return end
    for i = 1, self:GetAttribute("cells") or 0 do
        local b = self:GetFrameRef("cell" .. i)
        local id = self:GetAttribute("cast" .. s .. "_" .. p .. "_" .. i)
        if id then
            b:SetAttribute("type", "spell")
            b:SetAttribute("spell", id)
        else
            b:SetAttribute("type", nil)
            b:SetAttribute("spell", nil)
        end
    end
]=]

-- An invisible secure button over a control: it takes the click, runs
-- `snippet` (secure, in combat too), then `onClick`; the control's hover
-- look follows it. It is the control's sibling, placed where the control
-- is (by the caller), never its child nor anchored to it: a frame that
-- holds or anchors a secure one is restricted in combat too, and the
-- control's look changes in combat (an arrow's enabled state).
local function secureOver(book: any, control: any, snippet: string, onClick: () -> ()): any
    local o = CreateFrame("Button", nil, control:GetParent(), "SecureHandlerClickTemplate")
    o:SetSize(control:GetWidth(), control:GetHeight())
    o:SetFrameLevel(control:GetFrameLevel() + 5)
    o:RegisterForClicks("LeftButtonUp")
    o:SetFrameRef("router", book.router)
    o:SetAttribute("_onclick", snippet)
    o:HookScript("OnClick", onClick)
    o:SetScript("OnEnter", function() if control.suuEnter then control.suuEnter(control) end end)
    o:SetScript("OnLeave", function() if control.suuLeave then control.suuLeave(control) end end)
    return o
end

local function hex(token: string): string return T.color[token].hex end

-- 3g 20s: the digits in ink and the units in coin colours, or all of it in
-- ember-text when you can't afford it.
local function coinText(amount: any, short: any): (string, string)
    local copper = math.max(0, math.floor(tonumber(amount) or 0))
    local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local plain: string[], parts: string[] = {}, {}
    local function part(v: number, unit: string, token: string)
        plain[#plain + 1] = v .. unit
        parts[#parts + 1] = short and (v .. unit) or ("|cff" .. hex("ink") .. v .. "|r|cff" .. hex(token) .. unit .. "|r")
    end
    if g > 0 then part(g, "g", "coin-gold") end
    if s > 0 or (g > 0 and c > 0) then part(s, "s", "coin-silver") end
    if c > 0 or #parts == 0 then part(c, "c", "coin-copper") end
    local out = table.concat(parts, " ")
    if short then out = "|cff" .. hex("ember-text") .. out .. "|r" end
    return out, table.concat(plain, " ")
end

local function spells(n: number): string return n .. (n == 1 and " spell" or " spells") end

local function switch(book: any, parent: any, label: string, key: string): any
    local f = CreateFrame("Frame", nil, parent)
    f.toggle = inputs.toggle(f, { onChange = function(on) if book.onSwitch then book.onSwitch(key, on) end end })
    f.toggle:SetPoint("RIGHT")
    f.text = text(f, "label", "ink-muted")
    f.text:SetPoint("RIGHT", f.toggle, "LEFT", -S["space-3"], 0)
    f.text:SetValue(label)
    f:SetSize(f.text:GetUnboundedStringWidth() + S["space-3"] + 34, 18)
    return f
end

export class Spellbook extends Frame
    rows: any
    edgeInset: any
    cells: any
    tabs: any
    tabColumn: Frame
    main: any
    title: Text
    toTrain: Text
    allRanks: any
    unlearned: any
    grid: Frame
    pager: Frame
    pageText: Text
    prev: any
    next: any
    foot: any
    router: Frame
    castKeys: any? = nil
    widest: any? = nil
    schoolMarker: any? = nil

    constructor(parent: any, options: { [string]: any }?)
        local opts: { [string]: any } = options or {}
        super(nil, parent)
        self.rows = opts.rows or 6
        self.edgeInset = opts.edgeInset or 0 -- from the window's edge to the page
        self.cells, self.tabs = {}, {}
        -- the schools' column and its rule
        self.tabColumn = CreateFrame("Frame", nil, self)
        self.tabColumn:SetPoint("TOPLEFT")
        self.tabColumn:SetPoint("BOTTOMLEFT")
        self.tabColumn:SetWidth(40)
        local rule = self:CreateTexture(nil, "ARTWORK")
        draw.paintFill(rule, "gilt-faint")
        rule:SetWidth(1)
        rule:SetPoint("TOPLEFT", self.tabColumn, "TOPRIGHT", 0, 0)
        rule:SetPoint("BOTTOMLEFT", self.tabColumn, "BOTTOMRIGHT", 0, 0)
        -- the main column
        local main = CreateFrame("Frame", nil, self)
        main:SetPoint("TOPLEFT", self.tabColumn, "TOPRIGHT", S["space-5"], 0)
        main:SetPoint("BOTTOMRIGHT")
        self.main = main
        self.title = text(main, "header", "gilt-text")
        self.title:SetPoint("TOPLEFT", 0, -6)
        self.toTrain = text(main, "caption", "arcane")
        self.toTrain:SetPoint("LEFT", self.title, "RIGHT", S["space-5"], 0)
        self.allRanks = switch(self, main, "All ranks", "allRanks").toggle
        self.allRanks:GetParent():SetPoint("TOPRIGHT", 0, -6)
        self.unlearned = switch(self, main, "Unlearned spells", "unlearned").toggle
        self.unlearned:GetParent():SetPoint("RIGHT", self.allRanks:GetParent(), "LEFT", -S["space-5"], 0)
        -- the grid
        self.grid = CreateFrame("Frame", nil, main)
        self.grid:SetPoint("TOPLEFT", 0, -(30 + S["space-4"]))
        self.grid:SetPoint("RIGHT")
        self.grid:SetHeight(self.rows * ICON + (self.rows - 1) * S["space-4"])
        -- the pager over a gilt-faint rule
        local foot = CreateFrame("Frame", nil, main)
        foot:SetPoint("BOTTOMLEFT")
        foot:SetPoint("BOTTOMRIGHT")
        foot:SetHeight(30 + S["space-3"])
        local frule = foot:CreateTexture(nil, "ARTWORK")
        draw.paintFill(frule, "gilt-faint")
        frule:SetHeight(1)
        frule:SetPoint("TOPLEFT")
        frule:SetPoint("TOPRIGHT")
        -- the page text in a frame of its own, as wide as its longest text: the
        -- arrows' secure buttons anchor to it (the game refuses to anchor a
        -- protected frame to a text: found in game)
        self.pager = CreateFrame("Frame", nil, foot)
        self.pager:SetSize(math.ceil(measureText("caption", "Page 10 of 10")), 30)
        self.pager:SetPoint("BOTTOM")
        self.pageText = text(self.pager, "caption", "ink-muted")
        self.pageText:SetPoint("BOTTOM", 0, 8)
        self.prev = controls.button(foot, { text = "", width = 30, onClick = function() if self.onPage then self.onPage(-1) end end })
        self.prev:SetPoint("RIGHT", self.pager, "LEFT", -S["space-5"], 0)
        self.next = controls.button(foot, { text = "", width = 30, onClick = function() if self.onPage then self.onPage(1) end end })
        self.next:SetPoint("LEFT", self.pager, "RIGHT", S["space-5"], 0)
        for _, pair in ipairs({ { self.prev, "chevronLeft" }, { self.next, "chevronRight" } }) do
            local g = pair[1]:CreateTexture(nil, "OVERLAY")
            g:SetTexture("Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\" .. pair[2] .. ".tga")
            g:SetSize(14, 14)
            g:SetPoint("CENTER")
            draw.paint(g, "ink")
        end
        self.foot = foot
        -- the secure side: the router, and the pager's arrows' secure buttons
        self.router = CreateFrame("Frame", nil, self, "SecureHandlerAttributeTemplate")
        self.router:SetAttribute("_onattributechanged", ROUTE)
        for _, pair in ipairs({ { self.prev, -1 }, { self.next, 1 } }) do
            local arrow, delta = pair[1], pair[2]
            arrow.suuEnter = arrow:GetScript("OnEnter")
            arrow.suuLeave = arrow:GetScript("OnLeave")
            local o = secureOver(self, arrow, [=[
                local r = self:GetFrameRef("router")
                local s = r:GetAttribute("school")
                if not s then return end
                local p = (r:GetAttribute("page") or 1) + self:GetAttribute("delta")
                local n = r:GetAttribute("pages" .. s) or 1
                if p < 1 then p = 1 elseif p > n then p = n end
                r:SetAttribute("page", p)
            ]=], function() if self.onPage and arrow:IsEnabled() then self.onPage(delta) end end)
            o:SetAttribute("delta", delta)
            -- (where the arrow is: beside the page text's frame)
            if delta < 0 then
                o:SetPoint("RIGHT", self.pager, "LEFT", -S["space-5"], 0)
            else
                o:SetPoint("LEFT", self.pager, "RIGHT", S["space-5"], 0)
            end
            arrow.secure = o
        end
    end

    function SetCooldown(i: number, active: any, gcd: any, duration: any)
        local c = self.cells[i]
        if not c then return end
        if active and duration then
            c.cooldown:SetCooldownFromDurationObject(duration)
            c.cooldown:SetHideCountdownNumbers(gcd and true or false)
        else
            c.cooldown:Clear()
        end
    end

    function DrawCell(c: any)
        local s = c.spell
        if not s then return end
        local st = s.status or "learned"
        if st == "trainable" then
            c.icon:SetState("dim")
            c.icon:SetBorder("arcane")
            c.sub:SetColor("arcane")
            c.label:SetColor("ink")
        elseif st == "future" then
            c.icon:SetState("dim")
            c.icon:SetBorder("gilt-hairline")
            c.sub:SetColor("ink-muted")
            c.label:SetColor("ink-muted")
        else
            c.icon:SetState("rest")
            c.icon:SetBorder("gilt-hairline")
            c.sub:SetColor("ink-muted")
            c.label:SetColor("ink")
        end
    end

    function SetSpells(list: any[])
        local width = self.main:GetWidth()
        -- the columns as wide as the longest name or line on the page, the pair
        -- centred; the rows centred between the head and the pager (found in
        -- game: half-width columns left space to the right, and a gap below)
        local widest = 0
        for i = 1, self.rows * COLUMNS do
            local s = list[i]
            if s then
                local name = (s.label or "") .. ((s.status ~= "learned" and s.status ~= "passive" and s.rank) and ("  Rank " .. s.rank) or "")
                widest = math.max(widest, measureText("label", name), measureText("caption", s.sub or ""))
            end
        end
        -- (the owner's widest name across every school, when given: the same
        -- columns on every page, one spell alone included: found in game)
        if self.widest then widest = math.max(widest, self.widest) end
        local colW = math.min((width - S["space-6"]) / COLUMNS, ICON + S["space-4"] + math.ceil(widest) + S["space-3"])
        local used = COLUMNS * colW + (COLUMNS - 1) * S["space-6"]
        local headH = 30 + S["space-4"]
        local room = self.main:GetHeight() - headH - self.foot:GetHeight() - S["space-4"]
        local gridH = self.rows * ICON + (self.rows - 1) * S["space-4"]
        -- (in combat the grid and its cells stay as they are: they hold secure
        -- buttons; the columns are as wide on every page anyway, SetWidest)
        local layout = not InCombatLockdown()
        if layout then
            self.grid:ClearAllPoints()
            self.grid:SetPoint("TOPLEFT", self.main, "TOPLEFT", math.max(0, (width - used) / 2), -(headH + math.max(0, (room - gridH) / 2)))
            self.grid:SetSize(used, gridH)
        end
        for i = 1, self.rows * COLUMNS do
            local c = cell(self, i)
            local s = list[i]
            c.spell = s
            if layout then
                local r, col = math.floor((i - 1) / COLUMNS), (i - 1) % COLUMNS
                c:ClearAllPoints()
                c:SetPoint("TOPLEFT", self.grid, "TOPLEFT", col * (colW + S["space-6"]), -r * (ICON + S["space-4"]))
                c:SetWidth(colW)
                c:Show()
            end
            -- an empty slot keeps its cell (shown: it can't be shown in combat), see-through
            c:SetAlpha(s and 1 or 0)
            if s then
                c.icon:SetArt(s.icon)
                -- "Healing Wave  Rank 10" for a rank not learned yet (the rank in ink-muted)
                local name = s.label or ""
                if s.status ~= "learned" and s.status ~= "passive" and s.rank then
                    name = name .. "  |cff" .. T.color["ink-muted"].hex .. "Rank " .. s.rank .. "|r"
                end
                c.label:SetValue(name)
                c.sub:SetValue(s.sub or "")
                self:DrawCell(c)
            else
                c.cooldown:Clear()
            end
        end
        -- the rows a taller page had
        if layout then
            for i = self.rows * COLUMNS + 1, #self.cells do self.cells[i]:Hide() end
        end
    end

    function SetCasts(schools: any[], perPage: number)
        if InCombatLockdown() then return end
        local r = self.router
        for _, key in ipairs(self.castKeys or {}) do r:SetAttribute(key, nil) end
        local keys: string[] = {}
        for s, list in ipairs(schools) do
            local pages = math.max(1, math.ceil(#list / perPage))
            r:SetAttribute("pages" .. s, pages)
            keys[#keys + 1] = "pages" .. s
            for i, id in ipairs(list) do
                if id then
                    local p, slot = math.floor((i - 1) / perPage) + 1, (i - 1) % perPage + 1
                    local key = "cast" .. s .. "_" .. p .. "_" .. slot
                    r:SetAttribute(key, id)
                    keys[#keys + 1] = key
                end
            end
        end
        self.castKeys = keys
        -- every cell the page may hold, known to the router
        for i = 1, perPage do
            local c = cell(self, i)
            r:SetFrameRef("cell" .. i, c.button)
        end
        r:SetAttribute("cells", perPage)
    end

    function SetCastPage(school: number, page: number)
        if InCombatLockdown() then return end
        -- (both set: the router points the cells at the page each time)
        self.router:SetAttribute("page", page)
        self.router:SetAttribute("school", school)
    end

    -- As many rows as the page's height holds (out of combat: the cells are
    -- secure buttons). Returns the rows.
    function FitRows()
        local h = self.main:GetHeight()
        if not h or h <= 0 or InCombatLockdown() then return self.rows end
        local room = h - (30 + S["space-4"]) - self.foot:GetHeight() - S["space-4"]
        local rows = math.max(1, math.floor((room + S["space-4"]) / (ICON + S["space-4"])))
        if rows ~= self.rows then
            self.rows = rows
            self.grid:SetHeight(rows * ICON + (rows - 1) * S["space-4"])
        end
        return rows
    end

    -- The longest name the book has anywhere (columns as wide on every page).
    function SetWidest(px: number?)
        self.widest = px
    end

    function SetSchools(list: any[])
        -- the chosen school's jewel, gliding down the column (tabMarker)
        self.schoolMarker = self.schoolMarker or tabMarker(self.tabColumn, { vertical = true, side = "RIGHT", x = S["space-4"] + 2 })
        local chosen
        for i, s in ipairs(list) do
            local t = self.tabs[i]
            if not t then
                t = CreateFrame("Button", nil, self.tabColumn)
                t:SetSize(TAB, TAB)
                t.icon = icon(t, TAB)
                t.icon:SetAllPoints()
                t.icon:EnableMouse(false)
                -- the "spells to train" mark, above the icon (the icon is a frame
                -- of its own: drawn on the tab, the mark sat under it)
                local over = CreateFrame("Frame", nil, t)
                over:SetAllPoints()
                over:SetFrameLevel(t.icon:GetFrameLevel() + 3)
                over:EnableMouse(false)
                t.ring = draw.diamond(over, 9, "surface", "OVERLAY", 6)
                t.ring:SetPoint("CENTER", t, "TOPRIGHT", -2, -2)
                t.dot = draw.diamond(over, 7, "arcane", "OVERLAY", 7)
                t.dot:SetPoint("CENTER", t, "TOPRIGHT", -2, -2)
                -- (hover and click come from the secure button over it)
                t:EnableMouse(false)
                local marker = self.schoolMarker
                t.suuEnter = function(btn: any)
                    btn:SetAlpha(1)
                    marker.hovered = btn
                    marker:Aim()
                    showTooltip(btn, { title = btn.label, description = btn.trainable and btn.trainable > 0
                        and (btn.trainable .. (btn.trainable == 1 and " spell" or " spells") .. " to train") or nil })
                end
                t.suuLeave = function(btn: any)
                    btn:SetAlpha(btn.active and 1 or 0.6)
                    if marker.hovered == btn then marker.hovered = nil end
                    marker:Aim()
                    hideTooltip()
                end
                t.secure = secureOver(self, t, [=[
                    local r = self:GetFrameRef("router")
                    r:SetAttribute("page", 1)
                    r:SetAttribute("school", self:GetAttribute("school"))
                ]=], function() if self.onSchool then self.onSchool(t.index) end end)
                self.tabs[i] = t
            end
            t.index, t.label, t.trainable, t.active = i, s.label, s.trainable, s.active
            t.icon:SetArt(s.icon)
            t.dot:SetShown((s.trainable or 0) > 0)
            t.ring:SetShown((s.trainable or 0) > 0)
            if s.active then chosen = t end
            t:SetAlpha(s.active and 1 or 0.6)
            -- (in combat the tabs stay where they are: their secure buttons with them)
            if not InCombatLockdown() then
                t.secure:SetAttribute("school", i)
                -- centred between the window's edge (edgeInset to the left) and the divider
                local x, y = (40 - self.edgeInset) / 2, -(i - 1) * (TAB + S["space-3"])
                t:ClearAllPoints()
                t:SetPoint("TOP", self.tabColumn, "TOPLEFT", x, y)
                t:Show()
                t.secure:ClearAllPoints()
                t.secure:SetPoint("TOP", self.tabColumn, "TOPLEFT", x, y)
                t.secure:Show()
            end
        end
        if not InCombatLockdown() then
            for i = #list + 1, #self.tabs do
                self.tabs[i]:Hide()
                self.tabs[i].secure:Hide()
            end
        end
        self.schoolMarker:SetChosen(chosen)
    end

    function SetHead(title: string?, trainable: number?, all: any)
        self.title:SetValue(title or "")
        local toTrain = trainable or 0
        local count = all and all.count or 0
        if count <= 0 then
            self.toTrain:SetValue(toTrain > 0 and (spells(toTrain) .. " to train") or "")
            return
        end
        local cost, costPlain = coinText(all.cost, all.short)
        local muted = "|cff" .. hex("ink-muted")
        -- the longest form that fits before the switches
        local forms: string[][]
        if toTrain == count then
            forms = { { spells(toTrain) .. " to train", " · " }, { toTrain .. " to train", " · " } }
        elseif toTrain > 0 then
            forms = { { spells(toTrain) .. " to train", " · " .. count .. " in all · " }, { toTrain .. " to train", " · " .. count .. " in all · " },
                { count .. " to train in all", " · " } }
        else
            forms = { { "", spells(count) .. " to train in other schools · " }, { "", count .. " to train elsewhere · " } }
        end
        local room = self.unlearned:GetParent():GetLeft() and self.toTrain:GetLeft()
            and (self.unlearned:GetParent():GetLeft() - self.toTrain:GetLeft() - S["space-5"]) or math.huge
        local pick = forms[#forms]
        for _, f in ipairs(forms) do
            if measureText("caption", f[1] .. f[2] .. costPlain) <= room then pick = f break end
        end
        self.toTrain:SetText(pick[1] .. muted .. pick[2] .. "|r" .. cost)
        self.toTrain.value = nil
    end

    function SetSwitches(unlearned: boolean, allRanks: boolean)
        self.unlearned:SetValue(unlearned)
        self.allRanks:SetValue(allRanks)
    end

    function SetPage(page: number, pages: number)
        self.pageText:SetValue(("Page %d of %d"):format(page, math.max(1, pages)))
        self.prev:SetEnabledState(page > 1)
        self.next:SetEnabledState(page < pages)
    end
end

export function spellbook(parent: any, options: { [string]: any }?): Spellbook
    return Spellbook.new(parent, options)
end
