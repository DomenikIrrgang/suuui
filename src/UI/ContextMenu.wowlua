-- UI/ContextMenu.wowlua
-- SuuUI's right-click menu, in the tooltip's look (asked for in game: the
-- game's menus were Blizzard's): the glass panel with its gilt corner
-- diamond, an optional title in the tooltip's heading face, then the
-- actions, one per row (label in ink, a row on hover on arcane-soft;
-- disabled ones in ink-faint), a gilt-faint rule between groups. It opens
-- at the cursor; a click outside, Esc or picking an action closes it.
--
--   contextMenu(owner, { title = "The Ashmaw Den", items = {
--       { label = "Focus", onClick = fn }, { separator = true },
--       { label = "Stop tracking", onClick = fn, disabled = false } } })
--   closeContextMenu()
-- 0.17: opts.id names the menu and opts.context says what it's about;
-- plugins' entries for that id join before it opens (M:ExtendMenu).

import tokens as T from "/Core/Tokens"
import root as suuRoot from "/Core/Root"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import Panel from "/UI/Panel"
import hideTooltip from "/UI/Tooltip"

local S = T.space

local ROW_H = 24
local MIN_W = 160

-- What a menu shows: its title and items; `id` names it for plugins'
-- entries (M:ExtendMenu) and `context` says what it's about.
export type MenuOptions = {
    title?: string,
    items?: extend.MenuItem[],
    id?: string,
    context?: extend.MenuContext,
}

local menu: MenuFrame? = nil
local catcher: Button? = nil

local function close()
    if menu then menu:Hide() end
    if catcher then catcher:Hide() end
end
export const closeContextMenu = close

-- An action's row: its label, its hover band, the item it picks.
class MenuRow extends Button
    readonly hover: Texture
    readonly label: Text
    item: extend.MenuItem = {}

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(ROW_H)
        self.hover = draw.fill(self, "arcane-soft", "BACKGROUND", 1)
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.label = text(self, "body", "ink")
        self.label:SetPoint("LEFT", S["space-4"], 0)
    end

    @script("OnEnter")
    function entered() if not self.item.disabled then self.hover:Show() end end

    @script("OnLeave")
    function left() self.hover:Hide() end

    @script("OnClick")
    function clicked()
        if self.item.disabled then return end
        close()
        local onClick = self.item.onClick
        if onClick then onClick() end
    end
end

-- The menu: a glass panel with a title, its rows and the rules between
-- groups (both kept for the next opening).
export class MenuFrame extends Panel
    readonly heading: Text
    readonly rows: MenuRow[] = {}
    readonly rules: Texture[] = {}

    constructor(parent: Frame)
        super(parent, { ornament = true, solid = false })
        self.body:Hide()
        self.heading = text(self, "unit-name-lg", "ink")
        self.heading:SetPoint("TOPLEFT", S["space-5"], -S["space-5"])
        self.title = self.heading
        -- Esc closes it (out of combat: the key can't be held back in one)
        self:EnableKeyboard(true)
    end

    @script("OnKeyDown")
    function keyDown(key: string)
        if InCombatLockdown() then return end
        if key == "ESCAPE" then
            self:SetPropagateKeyboardInput(false)
            close()
        else
            self:SetPropagateKeyboardInput(true)
        end
    end

    function row(i: number): MenuRow
        local r = self.rows[i]
        if r then return r end
        r = MenuRow.new(self)
        self.rows[i] = r
        return r
    end

    function rule(i: number): Texture
        local l = self.rules[i]
        if l then return l end
        l = draw.fill(self, "gilt-faint", "ARTWORK")
        l:SetHeight(1)
        self.rules[i] = l
        return l
    end
end

local function build(): MenuFrame
    local c = CreateFrame("Button", nil, UIParent)
    c:SetAllPoints(UIParent)
    c:SetFrameStrata("FULLSCREEN_DIALOG")
    c:RegisterForClicks("AnyDown")
    c:SetScript("OnClick", close)
    c:Hide()
    catcher = c
    local m = MenuFrame.new(suuRoot)
    m:SetFrameStrata("FULLSCREEN_DIALOG")
    m:SetFrameLevel(c:GetFrameLevel() + 10)
    m:SetClampedToScreen(true)
    m:EnableMouse(true)
    m:Hide()
    menu = m
    return m
end

type Placed = { region: MenuRow | Texture, y: number, row?: MenuRow }

export function contextMenu(owner: Region?, given: MenuOptions?): MenuFrame
    local m = menu or build()
    local opts = given or {}
    local items: extend.MenuItem[] = opts.items or {}
    opts.items = items
    -- what plugins' entries see and change before it opens
    local shown: extend.Menu = { title = opts.title, items = items, id = opts.id, context = opts.context }
    if opts.id then extend.applyMenu(opts.id, shown, opts.context) end
    local pad = S["space-5"]
    local y = pad
    local title = shown.title
    m.heading:SetShown(title ~= nil)
    local width = MIN_W
    if title then
        m.heading:SetValue(title)
        width = math.max(width, math.ceil(m.heading:GetUnboundedStringWidth()) + pad * 2)
        y = y + T.type["unit-name-lg"].lineHeight + S["space-3"]
    end
    local nRow, nRule = 0, 0
    local placed: Placed[] = {}
    for _, item in ipairs(shown.items) do
        if item.separator then
            nRule = nRule + 1
            local l = m:rule(nRule)
            y = y + S["space-2"]
            placed[#placed + 1] = { region = l, y = y }
            y = y + 1 + S["space-2"]
        else
            nRow = nRow + 1
            local r = m:row(nRow)
            r.item = item
            r.label:SetValue(item.label or "")
            r.label:SetColor(item.disabled and "ink-faint" or "ink")
            width = math.max(width, math.ceil(r.label:GetUnboundedStringWidth()) + S["space-4"] * 2 + pad * 2 - S["space-3"] * 2)
            placed[#placed + 1] = { region = r, y = y, row = r }
            y = y + ROW_H
        end
    end
    -- the rows reach the panel's edges less a little, so their hover reads
    -- as a band inside the glass
    local inset = pad - S["space-3"]
    for _, p in ipairs(placed) do
        p.region:ClearAllPoints()
        p.region:SetPoint("TOPLEFT", inset, -p.y)
        p.region:SetPoint("TOPRIGHT", -inset, -p.y)
        p.region:Show()
        if p.row then p.row.hover:Hide() end
    end
    for i = nRow + 1, #m.rows do m.rows[i]:Hide() end
    for i = nRule + 1, #m.rules do m.rules[i]:Hide() end
    m:SetSize(width, y + pad - S["space-2"])
    -- at the cursor
    local scale = m:GetEffectiveScale()
    local x, cy = GetCursorPosition()
    m:ClearAllPoints()
    m:SetPoint("TOPLEFT", UIParent, "BOTTOMLEFT", x / scale + 2, cy / scale - 2)
    GameTooltip:Hide()
    hideTooltip()
    if catcher then catcher:Show() end
    m:Show()
    return m
end

-- What contextMenuFrom's describe gets: the game's MenuUtil generator's
-- calls, and what CreateButton gives.
export class MenuButtonDescription
    constructor(private item: extend.MenuItem)
    end

    function SetEnabled(on: boolean) self.item.disabled = not on end
end

export class MenuDescription
    constructor(private opts: MenuOptions, private items: extend.MenuItem[])
    end

    function CreateTitle(title: string) self.opts.title = self.opts.title or title end

    function CreateButton(label: string, onClick: (() -> ())?): MenuButtonDescription
        local item: extend.MenuItem = { label = label, onClick = onClick }
        self.items[#self.items + 1] = item
        return MenuButtonDescription.new(item)
    end

    function CreateDivider() self.items[#self.items + 1] = { separator = true } end
end

-- The same menu described the way the game's are (MenuUtil's generator:
-- root:CreateTitle(text), root:CreateButton(label, fn), root:CreateDivider()),
-- so a menu moves over by its first line.
--   contextMenuFrom(owner, function(owner, root) ... end[, id, context])
export function contextMenuFrom<O>(owner: O, describe: (owner: O, root: MenuDescription) -> (), id: string?,
                                   context: extend.MenuContext?): MenuFrame
    local items: extend.MenuItem[] = {}
    local opts: MenuOptions = { items = items, id = id, context = context }
    describe(owner, MenuDescription.new(opts, items))
    return contextMenu(nil, opts)
end
