-- UI/Auras.wowlua
-- Auras through the engine's aura containers. In combat addon code can't read
-- auras at all ("Auras cannot be accessed when secret"), so SuuUI never does:
-- it declares a container with filter groups, the engine fills it with
-- buttons and drives each one's icon, duration, stacks and dispel colour, and
-- SuuUI only styles the buttons, once, when the engine creates them.
--
--   local c = auraContainer(parent, "player", {
--       size = "icon-lg",          -- icon size token or px
--       spacing = 4,
--       anchor = "TOPRIGHT",       -- the corner the icons start from
--       growth = { "LEFT", "DOWN" },
--       lineWidth = 520,           -- px before wrapping to the next line (nil: never)
--       lazy = true,               -- 0.17: a group with no count yet waits (see addGroup)
--       groups = {
--           { key = "debuffs", filter = { "HARMFUL", "PLAYER" }, max = 16,
--             dispel = true,       -- the dispel-type border on typed debuffs
--             cancel = false,      -- right click cancels (your own buffs)
--             drain = "fel",       -- the duration bar's colour (ink by default)
--             include = { 6673, 5242 },    -- only these spell IDs (the engine
--                                          -- matches them, so it works in combat)
--             exclude = { 871 },           -- 0.16: never these spell IDs
--             index = 2, gap = 4,          -- 0.16: its place among the groups and the
--                                          -- space before it (when icons precede it)
--             harmfulEdge = true,          -- 0.16: the ember edge on debuffs (a
--                                          -- typed one's dispel border covers it)
--             -- per-group looks (the Cooldown Manager's per-entry behaviour):
--             border = "gilt",             -- edge token (gilt-hairline by default)
--             glow = "glow-arcane",        -- a shadow token around the icon
--             digits = false, stacks = false,
--             expiring = 5,                -- seconds: digits amber below (default 3)
--             size = "icon-md",            -- this group's icon size (default: the container's)
--             dispelTypes = { "Curse" },   -- 0.9: only debuffs of these types (instead of include)
--             initialize = fn(button) },   -- 0.9: build the button yourself (default: the AuraIcon)
--       },
--   })
--   c:SetUnit(unit), c:SetGroupMax(key, n), c:SetGroupSpells(key, ids, exclude),
--   c:SetGroupFilter(key, filter)      -- 0.17: a group's filter, live
--   c:SetGroupPlace(key, index, gap)   -- 0.16: a group's order and the space before it
--   c:SetFlow(anchor, growth), c:SetLineWidth(px)   -- 0.9: both after creation too
--   c:Release()                  -- 0.9: parked for reuse (no unit, hidden,
--                                -- deaf) until the next SetUnit
--   c:SetGroupSize(key, size)    -- 0.9: a group's icon size, live (out of combat:
--                                -- in combat the engine's buttons refuse the resize)
--   c:ShowPreview(items, place), c:HidePreview()   -- 0.17: made-up icons ({ {
--                                -- icon, border = token } }) laid out as the engine
--                                -- would, the engine's own out of sight (edit
--                                -- mode's "Buffs and debuffs on every frame");
--                                -- place = { point =, relativeTo =, relativePoint =, x =, y = }:
--                                -- where you put the container (the game won't
--                                -- anchor to it or say where it is)
--
-- Every call into the engine is pcall-guarded: an error inside one aborts the
-- engine's whole button batch, and these APIs were still moving in the beta.
-- Styling happens only in the initializer: once the engine marks a button
-- secret (in combat), addon writes to it are refused.

import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as events from "/Core/Events"
import * as fault from "/Core/Fault"
import * as fonts from "/Core/Fonts"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import * as iconModule from "/UI/Icon"
import Icon from "/UI/Icon"

const S = T.space

local WHITE = "Interface\\Buttons\\WHITE8X8"
local CROP = 0.08
local EXPIRING = 3 -- seconds: the duration digits turn amber below this

--------------------------------------------------------------------------------
-- The options (see the header) and the engine's parts
--------------------------------------------------------------------------------

-- One of a container's groups.
export type AuraGroup = {
    key: string,
    filter: string[],
    max?: number,
    dispel?: boolean,
    cancel?: boolean,
    drain?: string,
    include?: number[],
    exclude?: number[],
    index?: number,
    gap?: number,
    harmfulEdge?: boolean,
    border?: string,
    glow?: string,
    digits?: boolean,
    stacks?: boolean,
    expiring?: number,
    size?: number | string,
    dispelTypes?: string[],
    initialize?: (button: AuraButton) -> (),
}

export type AuraOptions = {
    size?: number | string,
    spacing?: number,
    anchor?: FramePoint,
    growth?: string[],
    lineWidth?: number,
    lazy?: boolean,
    groups: AuraGroup[],
}

-- A made-up icon for ShowPreview, and where the caller put the container.
export type PreviewItem = { icon: number | string | nil, border?: string }
export type AuraPlace = { point: FramePoint, relativeTo: Region, relativePoint?: FramePoint, x?: number, y?: number }

-- Spell lists and dispel types as the engine takes them.
export type AuraCandidates = {
    includeSpellIDs?: { [number]: boolean },
    excludeSpellIDs?: { [number]: boolean },
    includeDispelTypes?: { [string]: boolean },
}

-- A group's layout as the engine takes it.
export type AuraGroupLayout = { elementWidth: number, elementHeight: number, elementSpacing: number, lineSpacing: number,
    layoutIndex?: number, groupSpacing?: number }

-- The engine's aura button (a container makes them for its groups): the
-- registrations SuuUI makes, each pcall-guarded; the duration bar and the
-- dispel textures only on a client that has them.
export interface AuraButton extends Button
    function SetIcon(t: Texture)
    function SetApplicationCount(fs: FontString, opts: CustomAuraButtonApplicationCountOptions)
    function SetDurationText(fs: FontString, opts: CustomAuraButtonDurationTextOptions)
    function SetCancelAuraButtons(buttons: string)
    SetDurationBar?: (b: AuraButton, bar: StatusBar, opts: CustomAuraButtonDurationBarOptions) -> ()
    AddDispelTypeTexture?: (b: AuraButton, t: Texture, opts: CustomAuraButtonDispelTypeTextureOptions) -> ()
    SetAuraBorder?: (b: AuraButton, t: Texture, opts: CustomAuraButtonDispelTypeTextureOptions) -> ()
end

-- What a group gives the engine when it is added.
export type AuraGroupSpec = { maxFrameCount: number, candidateFilters?: AuraCandidates,
    initializeFrame: (button: AuraButton) -> (), layout: AuraGroupLayout }

-- The engine's aura container (CustomAuraContainerTemplate): its calls,
-- each pcall-guarded (an error inside one aborts the engine's whole batch).
export interface AuraEngine extends Frame
    function SetUnit(unit: string)
    function UpdateAllAuras()
    function AddAuraGroup(key: string, filter: string, spec: AuraGroupSpec)
    function SetAuraGroupLayout(key: string, layout: AuraGroupLayout)
    function SetAuraGroupMaxFrameCount(key: string, n: number)
    function SetAuraGroupFilterString(key: string, filter: string)
    function SetAuraGroupCandidateFilters(key: string, candidates: AuraCandidates)
end

-- (addons: the game's C_AddOns, a parameter for tests)
type AddOns = { IsAddOnLoaded: (name: string) -> boolean, LoadAddOn: (name: string) -> ...unknown }

local function loadEngine(addons: AddOns = C_AddOns)
    if not addons.IsAddOnLoaded("Blizzard_AuraContainer") then
        pcall(addons.LoadAddOn, "Blizzard_AuraContainer")
    end
end

-- The engine batches parsing by exact filter string: base polarity first,
-- then the other tokens sorted, so equal filters share one scan.
local function filterString(tokens: string[]): string
    local base: string?, rest: string[] = nil, {}
    for _, t in ipairs(tokens) do
        if t == "HELPFUL" or t == "HARMFUL" then base = t else rest[#rest + 1] = t end
    end
    table.sort(rest)
    if base and #rest > 0 then return base .. "|" .. table.concat(rest, "|") end
    return base or table.concat(rest, "|")
end

--------------------------------------------------------------------------------
-- Duration text: the design's time format, evaluated by the engine against
-- the (possibly secret) remaining time. Whole seconds under a minute, m:ss
-- under ten minutes, then minutes, then hours.
--------------------------------------------------------------------------------

-- the formatter (false: the client has none)
local formatter: NumericRuleFormatter | false | nil = nil
-- the colour curves by their seconds (false: the client has none)
local colorCurves: { [number]: LuaColorCurveObject | false } = {}

local function durationFormatter(): NumericRuleFormatter?
    if formatter ~= nil then return formatter or nil end
    formatter = false
    if not (C_StringUtil and C_StringUtil.CreateNumericRuleFormatter and Enum.NumericRuleFormatRounding) then return nil end
    local Up, Down = Enum.NumericRuleFormatRounding.Up, Enum.NumericRuleFormatRounding.Down
    local f = C_StringUtil.CreateNumericRuleFormatter()
    local breakpoints: NumericRuleFormatBreakpoint[] = {
        { threshold = 0, format = "%d", step = 1, rounding = Up },
        { threshold = 60, format = "%d:%02d", step = 1, rounding = Up, components = { { div = 60 }, { mod = 60 } } },
        { threshold = 600, format = "%dm", step = 1, rounding = Down, components = { { div = 60 } } },
        { threshold = 3600, format = "%dh", step = 1, rounding = Down, components = { { div = 3600 } } },
    }
    local ok = pcall(f.SetBreakpoints, f, breakpoints)
    if ok then formatter = f end
    return formatter or nil
end

local function expiringPoints(c: LuaColorCurveObject, seconds: number)
    c:ClearPoints()
    c:AddPoint(0, CreateColor(draw.rgba("amber")))
    c:AddPoint(seconds, CreateColor(draw.rgba("ink")))
end

-- amber below `seconds` (EXPIRING by default), ink above: a step curve over
-- the remaining time
local function expiringColor(seconds: number?): LuaColorCurveObject?
    local at = seconds or EXPIRING
    local known = colorCurves[at]
    if known ~= nil then return known or nil end
    colorCurves[at] = false
    if not (C_CurveUtil and C_CurveUtil.CreateColorCurve) then return nil end
    local c = C_CurveUtil.CreateColorCurve()
    c:SetType(Enum.LuaCurveType.Step)
    expiringPoints(c, at)
    colorCurves[at] = c
    return c
end

-- The engine keeps the curves it was given: a theme change sets their
-- colours again in place.
events.on("SUUUI_THEME_CHANGED", function()
    for seconds, c in pairs(colorCurves) do
        if c then pcall(expiringPoints, c, seconds) end
    end
end, "Auras")

local function textColorProperty(): DurationTextBindingProperty
    local prop = Enum.DurationTextBindingProperty and Enum.DurationTextBindingProperty.RemainingDuration
    if prop == nil then return 0 end
    return prop
end

local function durationOptions(seconds: number?): CustomAuraButtonDurationTextOptions
    local opts: CustomAuraButtonDurationTextOptions = { textFormatter = durationFormatter() }
    local curve = expiringColor(seconds)
    if curve then opts.textColor = { curve = curve, property = textColorProperty() } end
    return opts
end

-- A duration text binding (the engine's object).
export type DurationText = DurationTextBindingObject

-- 0.17: a text line the engine keeps showing a duration's time left (the
-- aura icons' format: "42", "1:30", "5m"; amber below `seconds`), in combat
-- too: b:SetDuration(d) then b:SetEnabled(true). Nil where the client has no
-- duration text bindings.
export function durationTextBinding(fontString: FontString, seconds: number?): DurationText?
    if not (C_DurationUtil and C_DurationUtil.CreateDurationTextBinding) then return nil end
    local ok, b = pcall(C_DurationUtil.CreateDurationTextBinding)
    if not ok or not b then return nil end
    pcall(b.SetFontString, b, fontString)
    local f = durationFormatter()
    if f then pcall(b.SetFormatter, b, f) end
    local curve = expiringColor(seconds)
    if curve then pcall(b.SetTextColorCurve, b, curve, textColorProperty()) end
    pcall(b.SetZeroDurationText, b, "")
    pcall(b.SetExpiredText, b, "")
    return b
end

-- Registers the duration text, dropping options step by step if the engine
-- refuses them (never let it throw).
local function setDurationText(button: AuraButton, fs: FontString, seconds: number?)
    local opts = durationOptions(seconds)
    if pcall(button.SetDurationText, button, fs, opts) then return end
    opts.textColor = nil
    if pcall(button.SetDurationText, button, fs, opts) then return end
    pcall(button.SetDurationText, button, fs, {})
end

--------------------------------------------------------------------------------
-- The button: the design's AuraIcon
--------------------------------------------------------------------------------

local DISPEL_STYLE = Enum.CustomAuraButtonDispelTypeTextureStyle
    and Enum.CustomAuraButtonDispelTypeTextureStyle.PreserveAsset

-- An engine button SuuUI styled: kept, so SetGroupSize can resize it.
export type StyledButton = { button: AuraButton, key: string, scrim: Texture }

-- The initializer of a group's buttons. `sizes` and `buttons` are the
-- container's (the group's size when a button is made; the buttons made).
local function makeInitializer(group: AuraGroup, size: number, sizes: { [string]: number },
                               buttons: StyledButton[]): (button: AuraButton) -> ()
    return function(button: AuraButton)
        -- the group's size now (SetGroupSize may have changed it)
        size = sizes[group.key] or size
        -- The engine's layout only anchors its buttons; their size is ours to
        -- set, and an unsized button renders nothing.
        pcall(button.SetSize, button, size, size)

        -- Regions first, styled, and only then registered with the button:
        -- each registration makes the engine draw at once, and an unstyled
        -- FontString has no font yet.
        local icon = button:CreateTexture(nil, "ARTWORK")
        icon:SetPoint("TOPLEFT", 1, -1)
        icon:SetPoint("BOTTOMRIGHT", -1, 1)
        icon:SetTexCoord(CROP, 1 - CROP, CROP, 1 - CROP)
        local well = button:CreateTexture(nil, "BACKGROUND")
        well:SetAllPoints()
        draw.paintFill(well, "surface-sunk")

        local over = CreateFrame("Frame", nil, button)
        over:SetAllPoints()
        over:EnableMouse(false)
        over:SetFrameLevel(button:GetFrameLevel() + 2)
        draw.border(over, group.border or (group.harmfulEdge and "ember" or "gilt-hairline"))
        if group.glow then draw.shadow(button, group.glow) end

        -- The dispel border: white edges the engine shows and tints per
        -- debuff type; hidden until it does.
        local edges: Texture[] = {}
        local addDispel = button.AddDispelTypeTexture or button.SetAuraBorder
        if group.dispel and DISPEL_STYLE ~= nil and addDispel then
            local holder = CreateFrame("Frame", nil, button)
            holder:SetAllPoints()
            holder:EnableMouse(false)
            holder:SetFrameLevel(button:GetFrameLevel() + 3)
            local b = draw.border(holder, "ink")
            for _, t in ipairs(b.parts) do
                t:SetColorTexture(1, 1, 1, 1)
                t:Hide()
                edges[#edges + 1] = t
            end
        end

        -- The duration bar inside the bottom edge: 3px from icon-lg up, 2px
        -- below, over the digits' dark fade so it reads on bright art; it drains right
        -- to left. ink by default, fel for HoTs (group.drain). The engine
        -- drives it, so it works in combat; it has no colour curve, so only
        -- the digits turn amber near the end.
        local barH = size >= 30 and 3 or 2
        local drain = CreateFrame("StatusBar", nil, button)
        drain:SetPoint("BOTTOMLEFT", 1, 1)
        drain:SetPoint("BOTTOMRIGHT", -1, 1)
        drain:SetHeight(barH)
        drain:SetStatusBarTexture(WHITE)
        draw.paint(drain, group.drain or "ink")
        -- above the text layer: the digits' dark fade would dim it otherwise
        drain:SetFrameLevel(button:GetFrameLevel() + 6)
        -- No track behind it: the engine leaves the bar empty on permanent
        -- auras (Devotion Aura), and a track would show there as an empty
        -- strip. The digits' dark fade gives the fill its contrast.

        local text = CreateFrame("Frame", nil, button)
        text:SetAllPoints()
        text:EnableMouse(false)
        text:SetFrameLevel(button:GetFrameLevel() + 5)
        -- The design gives the digits a heavy glow (0 0 4px black); WoW draws
        -- only a 1px shadow, so a soft dark fade sits behind the bottom of
        -- the icon instead, and large icons get the bigger numeric digits.
        local scrim = text:CreateTexture(nil, "BACKGROUND")
        scrim:SetPoint("BOTTOMLEFT", 1, 1)
        scrim:SetPoint("BOTTOMRIGHT", -1, 1)
        scrim:SetHeight(math.floor(size * 0.6))
        scrim:SetColorTexture(1, 1, 1, 1)
        scrim:SetGradient("VERTICAL", CreateColor(0, 0, 0, 0.8), CreateColor(0, 0, 0, 0))
        -- kept, so SetGroupSize can resize the buttons the engine already made
        buttons[#buttons + 1] = { button = button, key = group.key, scrim = scrim }
        local duration = text:CreateFontString(nil, "OVERLAY")
        fonts.apply(duration, size >= 30 and "numeric" or "micro")
        duration:SetShadowColor(0, 0, 0, 1)
        duration:SetShadowOffset(0, -1)
        -- the digits sit just above the bar
        duration:SetPoint("BOTTOM", 0, 1 + barH + (size >= 30 and 1 or 0))
        local stacks = text:CreateFontString(nil, "OVERLAY")
        fonts.apply(stacks, "micro")
        stacks:SetShadowColor(0, 0, 0, 1)
        stacks:SetShadowOffset(0, -1)
        stacks:SetPoint("TOPRIGHT", -2, -1)
        -- A thin outline as well, so the digits read on any icon art.
        for _, fs in ipairs({ duration, stacks }) do
            local path, height = fs:GetFont()
            if path then fs:SetFont(path, height, "OUTLINE") end
        end

        -- Clicks only where they do something (cancelling your own buff):
        -- a click-alive icon would swallow clicks meant for what is under it.
        if group.cancel then
            pcall(button.SetCancelAuraButtons, button, "RightButtonUp")
        else
            pcall(button.SetMouseClickEnabled, button, false)
        end

        pcall(button.SetIcon, button, icon)
        if group.stacks ~= false then pcall(button.SetApplicationCount, button, stacks, {}) else stacks:Hide() end
        if group.digits ~= false then setDurationText(button, duration, group.expiring) else duration:Hide(); scrim:Hide() end
        local setBar = button.SetDurationBar
        if setBar then
            local opts: CustomAuraButtonDurationBarOptions = {}
            if Enum.StatusBarInterpolation then opts.interpolation = Enum.StatusBarInterpolation.Immediate end
            if Enum.StatusBarTimerDirection then opts.direction = Enum.StatusBarTimerDirection.RemainingTime end
            pcall(setBar, button, drain, opts)
        else
            drain:Hide()
        end
        if addDispel and #edges > 0 then
            local opts: CustomAuraButtonDispelTypeTextureOptions = { style = DISPEL_STYLE, showWhenHarmful = true,
                showWhenHelpful = false }
            for _, t in ipairs(edges) do
                if not pcall(addDispel, button, t, opts) then break end
            end
        end
    end
end

--------------------------------------------------------------------------------
-- The container
--------------------------------------------------------------------------------

-- the engine's flow directions by name ("Left", "Up", …)
local FLOW: { [string]: unknown } = AnchorUtil and AnchorUtil.FlowDirection or {}

-- The first of these methods the container has, pcall-guarded; false when
-- it has none.
local function call(container: unknown, names: string[], ...: unknown): (boolean, ...unknown)
    if type(container) ~= "table" then return false end
    for _, name in ipairs(names) do
        local f = (container :: { [string]: unknown })[name]
        if type(f) == "function" then return pcall(f, container, ...) end
    end
    return false
end

local RESCAN: { [string]: EventName } = {
    target = "PLAYER_TARGET_CHANGED",
    focus = "PLAYER_FOCUS_CHANGED",
}

-- Spell lists as the engine takes them: { includeSpellIDs = { [id] = true },
-- excludeSpellIDs = { … } } (an empty include list lets nothing through).
local function idSet(ids: number[]): { [number]: boolean }
    local set: { [number]: boolean } = {}
    for _, id in ipairs(ids) do set[id] = true end
    return set
end
local function candidates(ids: number[]?, exclude: number[]?): AuraCandidates?
    if not ids and not exclude then return nil end
    return { includeSpellIDs = ids and idSet(ids) or nil, excludeSpellIDs = exclude and idSet(exclude) or nil }
end

-- Only debuffs of these types: { includeDispelTypes = { Curse = true } }.
-- The engine matches them, in combat too.
local function dispelCandidates(types: string[]): AuraCandidates
    local set: { [string]: boolean } = {}
    for _, t in ipairs(types) do set[t] = true end
    return { includeDispelTypes = set }
end

-- A group as the container keeps it: its count, filter and spells (they wait
-- here until a lazy group goes into the engine), and whether it has.
export type GroupState = { group: AuraGroup, max: number, filter: string, candidates?: AuraCandidates, added?: boolean }

-- The made-up icons of ShowPreview.
class AuraPreview extends Frame
    readonly icons: Icon[] = {}

    constructor(parent: Frame?)
        super(nil, parent)
        self:SetSize(1, 1)
    end
end

-- A unit's auras: the engine's aura container and the groups SuuUI puts in it
-- (Raw.Mixins.AuraContainer is the class).
export class UnitAuras
    container: AuraEngine
    opts: AuraOptions
    sizes: { [string]: number } = {}
    buttons: StyledButton[] = {}
    places: { [string]: { index?: number, gap?: number } } = {}
    groups: { [string]: GroupState } = {}
    spacing: number = 0
    unit: string? = nil
    rescan: EventName? = nil
    released: boolean? = nil
    preview: AuraPreview? = nil
    lineWidth: number? = nil
    flow: { anchor: FramePoint, growth: string[] }? = nil

    constructor(container: AuraEngine, unit: string, opts: AuraOptions)
        self.container = container
        self.opts = opts
        -- a renderable rect from the start: the engine lays out from an OnUpdate
        container:SetSize(1, 1)

        local size = draw.size(opts.size or "icon-md")
        call(container, { "SetFlowLayoutAnchorPoint", "SetAuraLayoutAnchorPoint" }, opts.anchor or "TOPLEFT")
        local g = opts.growth or { "RIGHT", "DOWN" }
        local h = FLOW[g[1] == "LEFT" and "Left" or "Right"]
        local v = FLOW[g[2] == "UP" and "Up" or "Down"]
        if h and v then call(container, { "SetFlowLayoutGrowthDirection", "SetAuraLayoutGrowthDirection" }, h, v) end
        call(container, { "SetFlowLayoutMaximumLineSize", "SetAuraLayoutRowWidth" }, opts.lineWidth)

        self.spacing = opts.spacing or S["space-2"]
        for i, group in ipairs(opts.groups) do
            local groupSize = group.size
            self.sizes[group.key] = groupSize and draw.size(groupSize) or size
            -- its place by its position when it has none: a group added later
            -- (addGroup) keeps the place it has in the list
            self.places[group.key] = { index = group.index or i, gap = group.gap }
            local types = group.dispelTypes
            self.groups[group.key] = { group = group, max = group.max or 16, filter = filterString(group.filter),
                candidates = types and dispelCandidates(types) or candidates(group.include, group.exclude) }
            self:addGroup(group.key)
        end
        self:SetUnit(unit)
        self:listen(unit)
        extend.add(extend.Kind.AuraContainer, self, { unit = unit })
    end

    -- The unit goes last, after the groups (it decides which events the
    -- container listens to), followed by a full re-scan. A released container
    -- comes back with it: shown, and listening for its unit again.
    function SetUnit(unit: string)
        self.unit = unit
        pcall(self.container.SetUnit, self.container, unit)
        if self.released then
            self.released = nil
            self:listen(unit)
            self.container:Show()
        end
        self:Refresh()
    end

    -- 0.9: parks a container nothing uses any more. Engine containers can never
    -- be freed, so whoever rebuilds keeps them for reuse instead: released, one
    -- has no unit, is hidden and stops listening for its re-scan event. SetUnit
    -- brings it back.
    function Release()
        if self.released then return end
        self:SetUnit("none")
        local rescan = self.rescan
        if rescan then
            events.off(rescan, self)
            self.rescan = nil
        end
        self.container:Hide()
        self.released = true
    end

    -- A full re-scan. A container doesn't notice when its unit token points at a
    -- new unit (another target, focus or boss): re-scan on those changes.
    function Refresh()
        pcall(self.container.UpdateAllAuras, self.container)
    end

    -- The corner the icons start from and the way they grow, after creation.
    function SetFlow(anchor: FramePoint?, growth: string[]?)
        self.flow = { anchor = anchor or "TOPLEFT", growth = growth or { "RIGHT", "DOWN" } }
        local c = self.container
        call(c, { "SetFlowLayoutAnchorPoint", "SetAuraLayoutAnchorPoint" }, anchor or "TOPLEFT")
        local g = growth or { "RIGHT", "DOWN" }
        local h = FLOW[g[1] == "LEFT" and "Left" or "Right"]
        local v = FLOW[g[2] == "UP" and "Up" or "Down"]
        if h and v then call(c, { "SetFlowLayoutGrowthDirection", "SetAuraLayoutGrowthDirection" }, h, v) end
        self:Refresh()
    end

    -- A group's whole layout as the engine takes it: its icon size, the
    -- spacing, and its place (SetGroupPlace).
    private function layoutOf(key: string, px: number): AuraGroupLayout
        local place = self.places[key]
        return { elementWidth = px, elementHeight = px, elementSpacing = self.spacing, lineSpacing = self.spacing,
            layoutIndex = place and place.index, groupSpacing = place and place.gap }
    end

    -- A group's icon size, live: the engine's layout, then the buttons it
    -- already made (theirs is ours to set). New buttons take it when made.
    function SetGroupSize(key: string, size: number | string)
        local px = draw.size(size)
        if self.sizes[key] == px then return end
        self.sizes[key] = px
        local g = self.groups[key]
        if not (g and g.added) then return end
        pcall(self.container.SetAuraGroupLayout, self.container, key, self:layoutOf(key, px))
        for _, b in ipairs(self.buttons) do
            if b.key == key then
                pcall(b.button.SetSize, b.button, px, px)
                pcall(b.scrim.SetHeight, b.scrim, math.floor(px * 0.6))
            end
        end
        self:Refresh()
    end

    -- 0.16: where a group sits among the container's groups (index: lower
    -- first; nil: in the order they were added) and the extra space before it
    -- (gap px, only when something is already placed and it has icons), live.
    function SetGroupPlace(key: string, index: number?, gap: number?)
        local place = self.places[key]
        if place and place.index == index and place.gap == gap then return end
        self.places[key] = { index = index, gap = gap }
        local g = self.groups[key]
        if not (g and g.added) then return end
        pcall(self.container.SetAuraGroupLayout, self.container, key, self:layoutOf(key, self.sizes[key] :: number))
        self:Refresh()
    end

    -- 0.9: px before the icons wrap to the next line (nil: never), after creation.
    function SetLineWidth(px: number?)
        self.lineWidth = px
        call(self.container, { "SetFlowLayoutMaximumLineSize", "SetAuraLayoutRowWidth" }, px)
        self:Refresh()
    end

    function SetGroupMax(key: string, n: number)
        local g = self.groups[key]
        if not g then return end
        g.max = n
        if g.added then
            pcall(self.container.SetAuraGroupMaxFrameCount, self.container, key, n)
        else
            self:addGroup(key)
        end
    end

    -- 0.17: a group's filter, live ({ "HARMFUL", "RAID_PLAYER_DISPELLABLE" }):
    -- one group can serve whoever the unit is (you, or someone else).
    function SetGroupFilter(key: string, filter: string[])
        local g = self.groups[key]
        if not g then return end
        g.filter = filterString(filter)
        if g.added then pcall(self.container.SetAuraGroupFilterString, self.container, key, g.filter) end
    end

    -- Only these spell IDs in group `key` (nil: no spell list), and never those
    -- in `exclude` (0.16).
    function SetGroupSpells(key: string, ids: number[]?, exclude: number[]?): boolean
        local g = self.groups[key]
        if not g then return false end
        local list = candidates(ids, exclude) or {}
        g.candidates = list
        if not g.added then return true end
        return (pcall(self.container.SetAuraGroupCandidateFilters, self.container, key, list))
    end

    -- 0.17: made-up icons in the container's place, laid out as the engine lays
    -- out its own (the corner, the growth, the line width, the first group's
    -- size); the engine's icons out of sight meanwhile.
    function ShowPreview(items: PreviewItem[], place: AuraPlace?)
        local c = self.container
        local parent = c:GetParent()
        local pv = self.preview
        if not pv then
            pv = AuraPreview.new(parent)
            self.preview = pv
        end
        local flow: { anchor: FramePoint, growth: string[] } = self.flow
            or { anchor = self.opts.anchor or "TOPLEFT", growth = self.opts.growth or { "RIGHT", "DOWN" } }
        local anchor = flow.anchor
        pv:SetParent(parent)
        pv:SetFrameLevel(c:GetFrameLevel() + 2)
        pv:ClearAllPoints()
        -- where the container is: the caller's place for it (anchoring to the
        -- engine's container is refused, "would inherit forbidden aspects", and
        -- its GetPoint gives nothing usable: found in game)
        if place then
            pv:SetPoint(place.point, place.relativeTo, place.relativePoint or place.point, place.x or 0, place.y or 0)
        else
            pv:SetPoint(anchor, parent, anchor)
        end
        local first = self.opts.groups[1]
        local size = (first and self.sizes[first.key]) or draw.size(self.opts.size or "icon-md")
        local sp = self.spacing
        local line = self.lineWidth or self.opts.lineWidth
        local perLine = line and math.max(1, math.floor((line + sp) / (size + sp))) or #items
        local hx = flow.growth[1] == "LEFT" and -1 or 1
        local vy = flow.growth[2] == "UP" and 1 or -1
        for i, it in ipairs(items) do
            local icon = pv.icons[i]
            if not icon then
                icon = iconModule.icon(pv, size)
                pv.icons[i] = icon
            end
            local col, row = (i - 1) % perLine, math.floor((i - 1) / perLine)
            icon:SetSize(size, size)
            icon:SetArt(it.icon)
            icon:SetBorder(it.border or "gilt-hairline")
            icon:ClearAllPoints()
            icon:SetPoint(anchor, pv, anchor, hx * col * (size + sp), vy * row * (size + sp))
            icon:Show()
        end
        for i = #items + 1, #pv.icons do pv.icons[i]:Hide() end
        pv:Show()
        pcall(c.SetAlpha, c, 0)
    end

    function HidePreview()
        if self.preview then self.preview:Hide() end
        pcall(self.container.SetAlpha, self.container, 1)
    end

    -- Re-scans whenever the unit's token may point at someone new.
    private function listen(unit: string)
        local event: EventName? = RESCAN[unit] or (unit:find("^boss") and "INSTANCE_ENCOUNTER_ENGAGE_UNIT")
            or ((unit:find("^party") or unit:find("^raid")) and "GROUP_ROSTER_UPDATE")
        if event then
            events.onGame(event, function() self:Refresh() end, self)
            self.rescan = event
        end
    end

    -- The engine makes ten buttons for every group up front, whatever its count
    -- (seen 2026-10-18: forty per raid frame, ~10 MB for a raid). With `lazy`
    -- a group goes into the engine only once it may show something (its count
    -- above 0); its count, filter and spells wait in self.groups until then.
    -- In a fight too, at once: containers have always been made in fights (a
    -- nameplate when the pool is empty, the frames after a reload in combat).
    private function addGroup(key: string)
        local g = self.groups[key]
        if not g or g.added or (self.opts.lazy and g.max <= 0) then return end
        local group, gsize = g.group, self.sizes[key] :: number
        local added = pcall(self.container.AddAuraGroup, self.container, key, g.filter, {
            maxFrameCount = g.max,
            candidateFilters = g.candidates,
            initializeFrame = group.initialize or makeInitializer(group, gsize, self.sizes, self.buttons),
            layout = self:layoutOf(key, gsize),
        })
        -- one that failed is tried again with its next count
        g.added = added
        if not added then fault.report("Auras", "couldn't add the aura group " .. key) end
    end
end
mixins.AuraContainer = UnitAuras

-- How a container frame is made (the game's CreateFrame; a stand-in in tests).
type Create = (frameType: string, name: string?, parent: Frame?, template: string?) -> Frame

local function newContainer(parent: Frame, unit: string, opts: AuraOptions, create: Create): UnitAuras?
    loadEngine()
    local ok, container = pcall(create, "AuraContainer", nil, parent, "CustomAuraContainerTemplate")
    if not ok then
        fault.report("Auras", "the client has no aura containers: " .. tostring(container))
        return nil
    end
    return UnitAuras.new(container :: AuraEngine, unit, opts)
end

export function auraContainer(parent: Frame, unit: string, opts: AuraOptions): UnitAuras?
    return newContainer(parent, unit, opts, CreateFrame)
end
