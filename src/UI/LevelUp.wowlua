-- UI/LevelUp.wowlua
-- The level-up card (design board "Level up · new spells"): the alert's
-- family, taller. A title in the display face ("Level 20") over a muted
-- caption, a faint rule, the new spells (an icon with the name beside it and
-- the rank under the name; a spell you never had says New in arcane), an
-- optional "+ 3 more" line, another rule and what training all of it costs.
-- Glass ground, gilt rules above and below, a gilt diamond on each end level
-- with the title.
--
--   local c = levelUp(parent)
--   c:SetLevelUp({ title, detail, spells = { { icon, name, rank, isNew, note } },
--                  more, cost (copper) })
--
-- note: a few words after the rank in ink-faint ("Level 18": a spell from an
-- earlier level still to train). Hovering a spell shows the game's spell
-- tooltip when it carries `spellID` (then `meta` as a last line: what
-- training it costs), else SuuUI's: its name, rank, `text` and `meta`. The card takes
-- the mouse: c:IsHovered() says whether it is under it (it stays then); a
-- click on it calls c.onClick (its owner dismisses it).
--
-- One column for up to four spells, two from five; at most ten rows (the
-- caller says how many more in `more`).

import tokens as T, ColorToken from "/Core/Tokens"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import text, measureText, Text from "/UI/Text"
import icon, Icon from "/UI/Icon"
import showTooltip, hideTooltip, spellTooltip from "/UI/Tooltip"

local S = T.space

local MAX = 10
local ICON = "icon-lg"
local COL_GAP = 24
local ROW_GAP = S["space-4"]
local PAD_X, PAD_TOP, PAD_BOTTOM = 28, 10, 12
local JEWEL = 9

-- A spell on the card: what it is, and its tooltip's parts.
export type LevelUpSpell = {
    icon?: number | string,
    name?: string,
    rank?: number | string,
    isNew?: boolean,
    note?: string,
    spellID?: number,
    text?: string,
    meta?: string,
}
-- What the card says.
export type LevelUpDef = { title?: string, detail?: string, spells?: LevelUpSpell[], more?: string, cost?: number }

local function hex(token: ColorToken): string
    return T.color[token].hex
end

-- (a plugin's cost may be anything: a number, else 0)
local function coins(amount: unknown): string
    local copper = math.max(0, math.floor(tonumber(amount) or 0))
    local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local parts: string[] = {}
    local function part(v: number, unit: string, token: ColorToken)
        parts[#parts + 1] = "|cff" .. hex(token) .. v .. unit .. "|r"
    end
    if g > 0 then
        part(g, "g", "coin-gold")
    end
    if s > 0 or (g > 0 and c > 0) then
        part(s, "s", "coin-silver")
    end
    if c > 0 or #parts == 0 then
        part(c, "c", "coin-copper")
    end
    return table.concat(parts, " ")
end

-- "Rank 3", "Rank 1 · New", "New" or "Rank 2 · Level 18"
local function rankLine(s: LevelUpSpell): string
    local parts: string[] = {}
    if s.rank then
        parts[#parts + 1] = "|cff" .. hex("ink-muted") .. "Rank " .. s.rank .. "|r"
    end
    if s.isNew then
        parts[#parts + 1] = "|cff" .. hex("arcane") .. "New|r"
    end
    if s.note then
        parts[#parts + 1] = "|cff" .. hex("ink-faint") .. s.note .. "|r"
    end
    return table.concat(parts, "|cff" .. hex("ink-faint") .. " · |r")
end

-- a theme change: the colour codes in the ranks and the cost, and the
-- line heights, again
local cards: { [LevelUpCard]: boolean } = setmetatable({}, { __mode = "k" })
events.on(
    "SUUUI_THEME_CHANGED",
    function()
        for c in pairs(cards) do
            c:PlaceHead()
            c:SetLevelUp(c.data)
        end
    end,
    "UI.LevelUp"
)

-- A spell's row: its icon, name and rank line.
class SpellRow extends Frame
    readonly icon: Icon
    readonly name: Text
    readonly rank: Text
    spell: LevelUpSpell? = nil

    constructor(card: LevelUpCard)
        super(nil, card)
        self.icon = icon(self, ICON)
        self.icon:SetPoint("LEFT")
        self.name = text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.icon, "TOPRIGHT", S["space-4"], 0)
        self.rank = text(self, "caption", "ink-muted")
        self.rank:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, 0)
        self:EnableMouse(true)
        self:SetScript("OnMouseUp", function()
            local onClick = card.onClick
            if onClick then
                onClick()
            end
        end)
    end

    @script("OnEnter")
    function entered()
        local s = self.spell
        if not s then
            return
        end
        if s.spellID then
            spellTooltip(self, s.spellID, s.meta)
            return
        end
        showTooltip(self, {
            title = s.name,
            subtitle = s.rank and ("Rank " .. s.rank) or nil,
            description = s.text,
            meta = s.meta,
        })
    end

    @script("OnLeave")
    function left()
        GameTooltip:Hide()
        hideTooltip()
    end
end

export class LevelUpCard extends Frame
    rows: SpellRow[] = {}
    ground: Texture
    rules: draw.Border
    left: Texture
    right: Texture
    title: Text
    detail: Text
    rule1: Texture
    more: Text
    rule2: Texture
    foot: Frame
    label: Text
    cost: Text
    gridTop: number = 0
    data: LevelUpDef = {}
    -- a click on the card or a spell (its owner dismisses it)
    onClick: (() -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        cards[self] = true
        self:EnableMouse(true)
        self:SetScript("OnHide", function()
            hideTooltip()
            local owner = GameTooltip:GetOwner()
            if owner and owner.GetParent and owner:GetParent() == self then
                GameTooltip:Hide()
            end
        end)
        self:SetScript("OnMouseUp", function()
            if self.onClick then
                self.onClick()
            end
        end)
        self.ground = self:CreateTexture(nil, "BACKGROUND")
        self.ground:SetAllPoints()
        draw.paintFill(self.ground, "surface-glass")
        self.rules = draw.border(self, "gilt-line")
        self.rules.left:Hide()
        self.rules.right:Hide()
        self.left = draw.diamond(self, JEWEL, "gilt")
        self.right = draw.diamond(self, JEWEL, "gilt")
        self.title = text(self, "alert", "gilt-text")
        -- the display face sits 2px low in its line box (as on the alert)
        self.title:SetPoint("TOP", 0, -PAD_TOP - 2)
        self.detail = text(self, "caption", "ink-muted")
        self.rule1 = draw.fill(self, "gilt-faint", "ARTWORK")
        self.rule1:SetHeight(1)
        self.more = text(self, "caption", "ink-muted")
        self.rule2 = draw.fill(self, "gilt-faint", "ARTWORK")
        self.rule2:SetHeight(1)
        self.foot = CreateFrame("Frame", nil, self)
        self.label = text(self.foot, "caption", "ink-muted")
        self.label:SetPoint("LEFT")
        self.label:SetText("Train all at your class trainer · ")
        self.cost = text(self.foot, "numeric", "ink")
        self.cost:SetPoint("LEFT", self.label, "RIGHT", 0, 0)
        self:PlaceHead()
        self:SetLevelUp({ title = "" })
    end

    function Row(i: number): SpellRow
        local r = self.rows[i]
        if r then
            return r
        end
        r = SpellRow.new(self)
        self.rows[i] = r
        return r
    end

    -- Under the mouse: the card or one of its spells is what the mouse is on.
    -- Not its rectangle (IsMouseOver): turning the camera with a mouse button
    -- held hides the cursor where it was, over the card, and it never "left"
    -- (found in game: the card stayed).
    function IsHovered(): boolean
        if not self:IsVisible() or (IsMouselooking and IsMouselooking()) then
            return false
        end
        local foci: ScriptRegion[] = GetMouseFoci and GetMouseFoci() or { GetMouseFocus and GetMouseFocus() }
        for _, f in ipairs(foci) do
            if f == self or f:GetParent() == self then
                return true
            end
        end
        return false
    end

    -- The head's lines, from the text styles' line heights.
    function PlaceHead()
        local titleMid = PAD_TOP + T.type.alert.lineHeight / 2
        self.left:ClearAllPoints()
        self.left:SetPoint("CENTER", self, "TOPLEFT", 0, -titleMid)
        self.right:ClearAllPoints()
        self.right:SetPoint("CENTER", self, "TOPRIGHT", 0, -titleMid)
        local detailTop = PAD_TOP + T.type.alert.lineHeight + S["space-4"] - 6
        self.detail:ClearAllPoints()
        self.detail:SetPoint("TOP", 0, -detailTop)
        local ruleTop = detailTop + T.type.caption.lineHeight + S["space-4"]
        self.rule1:ClearAllPoints()
        self.rule1:SetPoint("TOPLEFT", PAD_X, -ruleTop)
        self.rule1:SetPoint("TOPRIGHT", -PAD_X, -ruleTop)
        self.gridTop = ruleTop + 1 + S["space-4"]
    end

    function SetLevelUp(given: LevelUpDef?)
        local d = given or {}
        self.data = d
        local spells = d.spells or {}
        local n = math.min(#spells, MAX)
        local cols = n > 4 and 2 or 1
        self.title:SetValue(d.title or "")
        self.detail:SetValue(d.detail or "")
        local iconPx = draw.size(ICON)
        -- each column as wide as its widest row
        local colW: number[] = { 0, 0 }
        for i = 1, n do
            local s = assert(spells[i])
            local r = self:Row(i)
            r.spell = s
            r.icon:SetArt(s.icon or 134400)
            r.name:SetValue(s.name or "")
            r.rank:SetText(rankLine(s))
            local w = iconPx + S["space-4"] +
                math.max(measureText("label", s.name or ""), measureText("caption", r.rank:GetText() or ""))
            local c = (i - 1) % cols + 1
            colW[c] = math.max(colW[c], math.ceil(w) + 2)
        end
        for i = n + 1, #self.rows do
            self.rows[i]:Hide()
        end
        local gridW = colW[1] + (cols > 1 and (COL_GAP + colW[2]) or 0)
        local lines = math.ceil(n / cols)
        local gridH = lines > 0 and (lines * iconPx + (lines - 1) * ROW_GAP) or 0
        self.more:SetValue(d.more or "")
        self.more:SetVisible(d.more and d.more ~= "" and true or false)
        self.cost:SetText(coins(d.cost))
        local foot = measureText("caption", self.label:GetText() or "") +
            measureText("numeric", self.cost:GetText() or "")
        self.foot:SetSize(math.ceil(foot) + 2, T.type.caption.lineHeight)
        local inner = math.max(
            measureText("alert", d.title or ""),
            measureText("caption", d.detail or ""),
            gridW,
            self.more:IsShown() and measureText("caption", d.more) or 0,
            foot
        )
        local width = math.max(draw.size("notice-w"), math.ceil(inner) + PAD_X * 2)
        -- the rows, centred under the title
        local left = math.floor((width - gridW) / 2)
        for i = 1, n do
            local r = self.rows[i]
            local c, line = (i - 1) % cols, math.floor((i - 1) / cols)
            r:ClearAllPoints()
            r:SetPoint(
                "TOPLEFT",
                self,
                "TOPLEFT",
                left + (c == 1 and (colW[1] + COL_GAP) or 0),
                -(self.gridTop + line * (iconPx + ROW_GAP))
            )
            r:SetSize(colW[c + 1], iconPx)
            r:Show()
        end
        -- below the grid: the more line, the rule, the cost
        local y = self.gridTop + gridH + S["space-4"]
        if self.more:IsShown() then
            self.more:ClearAllPoints()
            self.more:SetPoint("TOP", self, "TOP", 0, -y)
            y = y + T.type.caption.lineHeight + S["space-4"]
        end
        self.rule2:ClearAllPoints()
        self.rule2:SetPoint("TOPLEFT", PAD_X, -y)
        self.rule2:SetPoint("TOPRIGHT", -PAD_X, -y)
        y = y + 1 + S["space-4"]
        self.foot:ClearAllPoints()
        self.foot:SetPoint("TOP", self, "TOP", 0, -y)
        y = y + T.type.caption.lineHeight + PAD_BOTTOM
        self:SetSize(width, y)
    end
end

export function levelUp(parent: Frame): LevelUpCard
    return LevelUpCard.new(parent)
end
