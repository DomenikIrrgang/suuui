-- UI/RaidPlanner.wowlua
-- The raid planner's window (design "Raid planner", A1 "Workbench", picked
-- 2026-10-19): setups down the left by raid size, with the class and spec
-- palette under them; the raid's groups in the middle, each slot a card with
-- what it asks for and who filled it, the group's party-wide buffs at its
-- foot; the raid-wide coverage on the right, then the open slots and the
-- players without a slot. 1400 wide, everything in view.
-- Drag a spec from the palette onto a slot (or a group's Add slot) and the
-- slot asks for it; drag a player onto a slot to place them there, onto
-- another player to swap, onto Without a slot to let them go. The module
-- works out everything shown; this only draws it and reports what was done.
--
--   local w = raidPlanner(parent)
--   w:SetData({ meta, stats = { { n, label, warn } }, note, size,
--       setups = { { id, name, meta, loaded, changed } },
--       palette = { { class, name, specs = { { spec, label, role, icon } } } },
--       groups = { { n, kind, canAdd, slots = { { id, req, who, class, spec,
--           icon, iconClass, state, pinned, player, tip } }, chips = { { text, tone, tip } } } },
--       raidWide = { { label, detail, n, warn, tip } }, raidWideMeta, raidWideEmpty,
--       open = { { label, detail } }, unplaced = { { name, class, icon, known, detail } },
--       hint, fill = { shown, enabled, reason }, inspect = { shown, label, enabled,
--       reason }, arrange = { enabled, reason } })
--   slot states: "filled", "provisional" (spec "?", underlined in dots),
--   "open", "conflict" (two fit it), "away" (pinned, not in the raid); a
--   slot's `player` (a name) makes it draggable
--   a player's icon: `icon` (their spec's), else their class's (`class`, or
--   a slot's `iconClass`), faded while the spec isn't known (a slot's spec
--   "?", a person's `known` false); open and away slots show what they ask
--   for, dimmed
--   chip tones: "ok", "warn" (doubled, missing), "open" (its slot is open)
--   w:EditSlot({ id, title, meta, class, spec, role, label, who, classes,
--       specs, whoOptions }, card) -- the slot editor beside the card
--   w:CloseEditor(), w:EditingSlot(), w:CardFor(id), w:Rename(id), w:ShowMoves({ meta, moves = { { name,
--       class, icon, known, from, to } }, note }, onConfirm)
--   w.onSize(size), w.onSetup(id), w.onSetupMenu(id, owner), w.onNew(owner),
--   w.onRename(id, text), w.onSave(), w.onSaveAsNew(), w.onDuplicate(),
--   w.onDelete(), w.onSlot(id, owner, button), w.onAdd(group, owner),
--   w.onDrop(what, where), w.onPerson(name, owner, button),
--   w.onSlotChange(id, changes), w.onSlotRemove(id), w.onInspect(),
--   w.onArrange(), w.onFill()
--   what: { spec = { class, spec, role } } or { player = name, from = slotId };
--   where: { slot = id } | { group = n } | { unplaced = true }

import after from "wowlua:timer"
import tokens as T, TextStyle from "/Core/Tokens"
import * as events from "/Core/Events"
import * as controls from "/UI/Controls"
import * as draw from "/UI/Draw"
import * as uiIcon from "/UI/Icon"
import * as inputs from "/UI/Inputs"
import * as panel from "/UI/Panel"
import WindowFrame, Panel from "/UI/Panel"
import * as selectModule from "/UI/Select"
import * as uiText from "/UI/Text"
import * as tooltip from "/UI/Tooltip"

local S = T.space

local WIDTH, HEIGHT = 1400, 860
local LEFT_W, RIGHT_W, COL_GAP = 232, 270, 16
local GROUP_GAP = 10
local CHIP_H = 16
local PAL_H = 18
local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local ROLE_GLYPH: { [string]: string } = { TANK = "shield", HEALER = "plus", DAMAGER = "sword" }

local styles: { [string]: TextStyle } = T.type
local function lineH(style: string): number return assert(styles[style]).lineHeight end
-- a slot card: the player's icon, then who and their spec on top, what the
-- slot asks for under it
local function cardH(): number return 3 + lineH("label") + lineH("caption") + 4 end
local function cardIcon(): number return lineH("label") + lineH("caption") - 4 end
local function cardTextX(): number return 5 + cardIcon() + S["space-3"] end

local CROP = 0.08
local CLASS_ART = "Interface\\Glues\\CharacterCreate\\UI-CharacterCreate-Classes"
-- the character creation tiles' coordinates by class (declared as a plain table)
local CLASS_COORDS = (CLASS_ICON_TCOORDS or {}) :: { [string]: number[] }

--------------------------------------------------------------------------------
-- What the window draws (SetData) and reports (the callbacks)
--------------------------------------------------------------------------------

-- A setup's or a slot's ID (the module's: numbers, and "work").
export type PlannerId = string | number
-- A spec: the module's tree number (1-3), or a test's name.
export type PlannerSpec = string | number
-- A spec, class or role art: a texture's file or ID.
export type PlannerArt = string | number

export type PlannerStat = { n: number | string, label: string, warn?: boolean }
export type PlannerSetup = { id: PlannerId, name?: string, meta?: string, loaded?: boolean, changed?: boolean }
export type PaletteSpec = { spec: PlannerSpec, label: string, name?: string, role?: string, icon?: PlannerArt }
export type PaletteClass = { class: string, name: string, specs?: PaletteSpec[] }
-- state: "filled", "provisional", "open", "conflict" or "away"
export type PlannerSlot = { id: PlannerId, req?: string, who?: string, class?: string, spec?: string, icon?: PlannerArt,
                            iconClass?: string, state?: string, pinned?: boolean, player?: string, tip?: string }
-- tone: "ok", "warn" or "open"
export type PlannerChip = { text: string, tone?: string, tip?: string }
export type PlannerGroup = { n: number, kind?: string, canAdd?: boolean, slots?: PlannerSlot[], chips?: PlannerChip[] }
export type PlannerTip = { description?: string, lines?: tooltip.TooltipLine[] }
export type PlannerListItem = { label?: string, detail?: string, n?: number | string, warn?: boolean, tip?: PlannerTip }
export type PlannerPerson = { name?: string, class?: string, icon?: PlannerArt, known?: boolean, detail?: string }
export type PlannerButton = { shown?: boolean, label?: string, enabled?: boolean, reason?: string }

export type PlannerData = {
    meta?: string,
    stats?: PlannerStat[],
    note?: string,
    size?: number,
    setups?: PlannerSetup[],
    palette?: PaletteClass[],
    groups?: PlannerGroup[],
    raidWide?: PlannerListItem[],
    raidWideMeta?: string,
    raidWideEmpty?: string,
    open?: PlannerListItem[],
    unplaced?: PlannerPerson[],
    unplacedMeta?: string,
    hint?: string,
    fill?: PlannerButton,
    inspect?: PlannerButton,
    arrange?: PlannerButton,
}

-- What is dragged: a spec (any of a class or a role), or a player (from a slot).
export type DragSpec = { class?: string, spec?: PlannerSpec, role?: string }
export type DragWhat = { spec?: DragSpec, player?: string, from?: PlannerId }
-- Where it was dropped.
export type DropWhere = { slot?: PlannerId, group?: number, unplaced?: boolean }
-- The art a dragged thing shows.
type DragArt = { icon?: PlannerArt, class?: string, known?: boolean }

-- The slot editor (EditSlot): what the slot asks for, and the choices.
export type SlotEditorDef = {
    id: PlannerId,
    title?: string,
    meta?: string,
    class?: string,
    spec?: PlannerSpec,
    role?: string,
    label?: string,
    who?: string,
    classes?: selectModule.SelectOption<string>[],
    specs?: inputs.SegmentedOption<PlannerSpec>[],
    whoOptions?: selectModule.SelectOption<string>[],
}
-- What the slot editor changed (false: back to any).
export type SlotChanges = { class?: string | false, spec?: PlannerSpec | false, role?: string | false, label?: string,
                            pin?: string | false }

-- The moves Arrange groups would make (ShowMoves).
export type PlannerMove = { name?: string, class?: string, icon?: PlannerArt, known?: boolean, from?: number, to?: number }
export type PlannerMoves = { meta?: string, moves?: PlannerMove[], note?: string }

--------------------------------------------------------------------------------
-- Art
--------------------------------------------------------------------------------

-- A player's art on a texture: their spec's icon, else their class's (the
-- character creation tiles); none when neither is known.
local function setArt(tex: Texture, icon: PlannerArt?, class: string?)
    local coords = class and CLASS_COORDS[class]
    if icon then
        tex:SetTexture(icon)
        tex:SetTexCoord(CROP, 1 - CROP, CROP, 1 - CROP)
    elseif coords then
        tex:SetTexture(CLASS_ART)
        tex:SetTexCoord(coords[1], coords[2], coords[3], coords[4])
    else
        tex:SetTexture(nil)
    end
    tex:SetShown((icon or coords) and true or false)
end

-- The same on a uiIcon.icon: faded while the spec isn't known, dimmed (`dim`)
-- for what an open slot asks for.
local function setPlayerIcon(f: uiIcon.Icon, icon: PlannerArt?, class: string?, known: boolean?, dim: boolean?)
    setArt(f.art, icon, class)
    f:SetState(dim and "dim" or "rest")
    f.art:SetAlpha(dim and 0.5 or ((known or icon) and 1 or 0.6))
end

local function classToken(file: string?): string
    local t = file and ("class-" .. file:lower())
    local colors: { [string]: unknown } = T.color
    if t and colors[t] ~= nil then return t end
    return "ink"
end

-- The i-th of a list of reused frames (made by make() the first time), shown.
local function pool<F extends Region>(list: F[], i: number, make: () -> F): F
    local f = list[i]
    if not f then
        f = make()
        list[i] = f
    end
    f:Show()
    return f
end

local function hideFrom<F extends Region>(list: F[], i: number)
    for k = i, #list do list[k]:Hide() end
end

--------------------------------------------------------------------------------
-- Pieces
--------------------------------------------------------------------------------

-- A small chip (the palette's specs, a group's buffs): caption text in a
-- hairline box, after a glyph or (glyph "icon") a spec's icon. What it
-- carries when dragged: its class, spec, role and icon.
export class PaletteChip extends Button
    readonly bg: Texture
    readonly edge: draw.Border
    readonly glyph: Texture? = nil
    readonly label: uiText.Text
    readonly hasGlyph: boolean
    -- what a drag carries
    text: string = ""
    class: string? = nil
    spec: PlannerSpec? = nil
    role: string? = nil
    icon: PlannerArt? = nil

    constructor(parent: Frame, glyph: string?)
        super(nil, parent)
        self.hasGlyph = glyph ~= nil
        self:SetHeight(PAL_H)
        self.bg = draw.fill(self, "surface-raised")
        self.bg:SetAllPoints()
        self.edge = draw.border(self, "gilt-faint")
        if glyph then
            local g = self:CreateTexture(nil, "ARTWORK")
            g:SetSize(10, 10)
            g:SetPoint("LEFT", 4, 0)
            if glyph ~= "icon" then
                g:SetTexture(GLYPHS .. glyph .. ".tga")
                draw.paint(g, "ink-muted")
            end
            self.glyph = g
        end
        self.label = uiText.text(self, "caption", "ink-muted")
        self.label:SetPoint("LEFT", glyph and 17 or 4, 0)
        self:SetScript("OnEnter", function() self.edge:SetColor("gilt"); self.label:SetColor("ink") end)
        self:SetScript("OnLeave", function() self.edge:SetColor("gilt-faint"); self.label:SetColor("ink-muted") end)
    end

    -- Its text, and a width to fit it.
    function SetChipText(text: string)
        self.label:SetValue(text)
        self:SetWidth(uiText.measureText("caption", text) + (self.hasGlyph and 21 or 8))
    end
end

-- A group's buff chip.
export class GroupChip extends Frame
    readonly edge: draw.Border
    readonly text: uiText.Text
    tip: string? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(CHIP_H)
        self.edge = draw.border(self, "gilt-faint")
        self.text = uiText.text(self, "caption", "ink-muted")
        self.text:SetPoint("CENTER", 0, 0)
        self:EnableMouse(true)
        self:SetScript("OnEnter", function()
            local tip = self.tip
            if tip then tooltip.showTooltip(self, { title = self.text:GetText(), description = tip }) end
        end)
        self:SetScript("OnLeave", function() tooltip.hideTooltip() end)
    end
end

-- A setup in the left column.
export class SetupRow extends Button
    readonly fill: Texture
    readonly edge: draw.Border
    readonly name: uiText.Text
    readonly changed: Texture
    readonly meta: uiText.Text
    id: PlannerId? = nil
    loaded: boolean? = nil

    constructor(planner: RaidPlanner)
        super(nil, planner.left)
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.fill = draw.fill(self, "surface-raised")
        self.fill:SetAllPoints()
        self.edge = draw.border(self, "gilt-line")
        self.name = uiText.text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", 7, -5)
        self.name:SetJustifyH("LEFT")
        self.changed = draw.diamond(self, 5, "ink")
        self.changed:SetPoint("LEFT", self.name, "RIGHT", 6, 0)
        self.meta = uiText.text(self, "caption", "ink-muted")
        self.meta:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -1)
        self.meta:SetJustifyH("LEFT")
        self:SetScript("OnEnter", function() if not self.loaded then self.fill:Show(); self.fill:SetAlpha(0.5) end end)
        self:SetScript("OnLeave", function() if not self.loaded then self.fill:Hide() end; self.fill:SetAlpha(1) end)
        self:SetScript("OnClick", function(_: Button, button: string)
            local id = self.id
            if not id then return end
            if button == "RightButton" then
                local menu = planner.onSetupMenu
                if menu then menu(id, self) end
            else
                local pick = planner.onSetup
                if pick then pick(id) end
            end
        end)
    end
end

-- A coverage or open-slot row in the right column.
export class ListRow extends Frame
    readonly rule: Texture
    readonly mark: Texture
    readonly label: uiText.Text
    readonly n: uiText.Text
    readonly detail: uiText.Text
    tip: PlannerTip? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.rule = draw.fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetHeight(1)
        self.rule:SetPoint("TOPLEFT")
        self.rule:SetPoint("TOPRIGHT")
        self.mark = draw.diamond(self, 5, "ink-muted")
        self.label = uiText.text(self, "label", "ink")
        self.label:SetPoint("TOPLEFT", 14, -4)
        self.label:SetJustifyH("LEFT")
        self.mark:SetPoint("CENTER", self, "TOPLEFT", 5, -(4 + lineH("label") / 2))
        self.n = uiText.text(self, "numeric", "ink")
        self.n:SetPoint("TOPRIGHT", 0, -4)
        self.detail = uiText.text(self, "caption", "ink-muted")
        self.detail:SetPoint("TOPLEFT", self.label, "BOTTOMLEFT", 0, 0)
        self.detail:SetJustifyH("LEFT")
        self.detail:SetWordWrap(true)
        self:EnableMouse(true)
        self:SetScript("OnEnter", function()
            local tip = self.tip
            if tip then tooltip.showTooltip(self, { title = self.label:GetText(), description = tip.description, lines = tip.lines }) end
        end)
        self:SetScript("OnLeave", function() tooltip.hideTooltip() end)
    end

    -- Draws `item` at width w (first: no rule over it); returns its height.
    function Draw(item: PlannerListItem, first: boolean, w: number): number
        self.rule:SetShown(not first)
        self.mark:SetPoint("CENTER", self, "TOPLEFT", 5, -(4 + lineH("label") / 2))
        local warn = item.warn
        self.mark:SetSize(warn and 6 or 5, warn and 6 or 5)
        draw.paint(self.mark, warn and "amber" or "ink-muted")
        self.label:SetValue(item.label or "")
        self.label:SetColor(warn and "amber" or "ink")
        local n = item.n
        self.n:SetValue(n and tostring(n) or "")
        self.n:SetColor(warn and "amber" or "ink")
        local nW = n and (uiText.measureText("numeric", tostring(n)) + S["space-4"]) or 0
        self.label:SetWidth(w - 14 - nW)
        self.detail:SetFixedWidth(w - 14 - nW)
        local detail = item.detail or ""
        self.detail:SetValue(detail)
        self.detail:SetShown(detail ~= "")
        self.tip = item.tip
        local h = 4 + lineH("label") + (detail ~= "" and self.detail:GetStringHeight() or 0) + 4
        self:SetSize(w, h)
        return h
    end
end

local PERSON_ICON = 16
local PERSON_X = PERSON_ICON + S["space-3"]

-- A player without a slot (right column).
export class PersonRow extends Button
    readonly rule: Texture
    readonly icon: uiIcon.Icon
    readonly name: uiText.Text
    readonly detail: uiText.Text
    person: string? = nil
    class: string? = nil
    -- (the icon value in a field of its own: `icon` is the row's icon widget)
    personIcon: PlannerArt? = nil
    known: boolean? = nil

    constructor(planner: RaidPlanner)
        super(nil, planner.unplacedZone)
        self:RegisterForClicks("RightButtonUp")
        self.rule = draw.fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetHeight(1)
        self.rule:SetPoint("TOPLEFT")
        self.rule:SetPoint("TOPRIGHT")
        self.icon = uiIcon.icon(self, PERSON_ICON)
        self.icon:SetPoint("TOPLEFT", 0, -4)
        self.name = uiText.text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", PERSON_X, -4)
        self.detail = uiText.text(self, "caption", "ink-muted")
        self.detail:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, 0)
        self.detail:SetJustifyH("LEFT")
        self.detail:SetWordWrap(true)
        self:SetScript("OnClick", function(_: Button, button: string)
            local person, on = self.person, planner.onPerson
            if person and on then on(person, self, button) end
        end)
        planner:Draggable(self, function(): (DragWhat?, string?, string?, DragArt?)
            return { player = self.person }, self.person, classToken(self.class),
                { icon = self.personIcon, class = self.class, known = self.known }
        end)
    end
end

-- A slot card: who fills the slot and what it asks for; a drop target.
export class SlotCard extends Button
    readonly planner: RaidPlanner
    readonly fill: Texture
    readonly edge: draw.Border
    readonly icon: uiIcon.Icon
    readonly who: uiText.Text
    readonly pin: Texture
    readonly spec: uiText.Text
    readonly dots: Texture[] = {}
    readonly req: uiText.Text
    slot: PlannerSlot? = nil
    state: string? = nil
    class: string? = nil
    dropHover: boolean? = nil
    where: DropWhere? = nil

    constructor(planner: RaidPlanner, g: GroupBox)
        super(nil, g)
        self.planner = planner
        self:SetHeight(cardH())
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.fill = draw.fill(self, "surface-raised")
        self.fill:SetAllPoints()
        self.edge = draw.border(self, "amber")
        self.icon = uiIcon.icon(self, cardIcon())
        self.who = uiText.text(self, "label", "ink")
        self.who:SetPoint("TOPLEFT", cardTextX(), -3)
        self.who:SetJustifyH("LEFT")
        local pin = self:CreateTexture(nil, "ARTWORK")
        pin:SetTexture(GLYPHS .. "pushpin.tga")
        pin:SetSize(9, 9)
        pin:SetPoint("LEFT", self.who, "RIGHT", S["space-2"], 0)
        draw.paint(pin, "gilt-text")
        self.pin = pin
        self.spec = uiText.text(self, "caption", "ink-muted")
        self.spec:SetPoint("TOPRIGHT", -6, -4)
        -- "?": provisional until inspected, underlined in dots
        for i = 1, 3 do
            local d = draw.fill(self, "ink-muted", "ARTWORK")
            d:SetSize(1, 1)
            d:SetPoint("TOPLEFT", self.spec, "BOTTOMLEFT", (i - 1) * 2.5, 0)
            self.dots[i] = d
        end
        self.req = uiText.text(self, "caption", "ink-faint")
        self.req:SetPoint("TOPLEFT", cardTextX(), -(3 + lineH("label")))
        self.req:SetJustifyH("LEFT")
        self:SetScript("OnClick", function(_: Button, button: string)
            local s, on = self.slot, planner.onSlot
            if s and on then on(s.id, self, button) end
        end)
        self:SetScript("OnEnter", function()
            if planner.dragging then return end
            if not self.dropHover and self.state ~= "open" and self.state ~= "away" then
                self.edge:SetShown(true)
                self.edge:SetColor("gilt-line")
            end
            local s = self.slot
            if s then tooltip.showTooltip(self, { title = s.who or s.req, subtitle = s.who and s.req or nil, description = s.tip }) end
        end)
        self:SetScript("OnLeave", function() self:Style(); tooltip.hideTooltip() end)
        planner:Draggable(self, function(): (DragWhat?, string?, string?, DragArt?)
            local s = self.slot
            local player = s and s.player
            if not (s and player) then return nil end
            return { player = player, from = s.id }, player, classToken(s.class),
                { icon = s.icon, class = s.iconClass or s.class, known = s.spec ~= "?" }
        end)
    end

    -- How it looks in its state (and while a drag hovers it).
    function Style()
        local s = self.state or "filled"
        local hover = self.dropHover == true
        local open = s == "open" or s == "away"
        self.fill:SetShown(hover or not open)
        draw.paintFill(self.fill, hover and "arcane-soft" or "surface-raised")
        self.edge:SetShown(hover or open or s == "conflict")
        self.edge:SetColor(hover and "arcane" or "amber", (open and not hover) and 0.7 or nil)
        self.who:SetColor(hover and "ink" or (s == "open" and "amber") or (s == "away" and "ink-muted") or classToken(self.class))
        self.req:SetColor((s == "conflict" and not hover) and "amber" or ((open or hover) and "ink-muted") or "ink-faint")
    end

    function SetDropHover(on: boolean)
        self.dropHover = on
        self:Style()
    end

    -- Shows slot `s` at width w.
    function Fill(s: PlannerSlot, w: number)
        self.slot = s
        self.state, self.class = s.state, s.class
        self:SetSize(w, cardH())
        -- the player's spec icon (their class's while it's "?"); an open or
        -- away slot: what it asks for, dimmed, or an empty well
        local open = s.state == "open" or s.state == "away"
        local size = cardIcon()
        self.icon:SetSize(size, size)
        self.icon:ClearAllPoints()
        self.icon:SetPoint("TOPLEFT", 5, -math.floor((cardH() - size) / 2))
        setPlayerIcon(self.icon, s.icon, s.iconClass or s.class, s.spec ~= "?", open)
        self.who:SetValue(s.who or "Open")
        self.pin:SetShown(s.pinned == true)
        local spec = s.spec or ""
        self.spec:SetValue(spec)
        local q = spec == "?"
        self.spec:SetColor(q and "ink" or "ink-muted")
        for _, d in ipairs(self.dots) do d:SetShown(q) end
        self.req:SetValue(s.req or "")
        -- placed from the text styles each time (a theme can change them)
        local x = cardTextX()
        self.who:SetPoint("TOPLEFT", x, -3)
        self.req:SetPoint("TOPLEFT", x, -(3 + lineH("label")))
        -- the name and what it asks for stop short of the spec and the edge
        local specW = spec ~= "" and (uiText.measureText("caption", spec) + S["space-3"]) or 0
        -- (as wide as the name, so the pin sits right after it)
        local room = math.max(10, w - x - 6 - specW - (s.pinned and 13 or 0))
        self.who:SetWidth(math.min(room, uiText.measureText("label", s.who or "Open") + 1))
        self.req:SetWidth(w - x - 6)
        self.dropHover = false
        self:Style()
    end
end

-- A group's Add slot: a click makes an open slot, a drop one that asks for it.
export class AddSlot extends Button
    readonly edge: draw.Border
    readonly fill: Texture
    readonly label: uiText.Text
    where: DropWhere? = nil

    constructor(planner: RaidPlanner, g: GroupBox)
        super(nil, g)
        self:SetHeight(22)
        self.edge = draw.border(self, "gilt-faint")
        self.fill = draw.fill(self, "arcane-soft")
        self.fill:SetAllPoints()
        self.fill:Hide()
        self.label = uiText.text(self, "caption", "ink-faint")
        self.label:SetPoint("CENTER")
        self.label:SetValue("+ Add slot")
        self:SetScript("OnEnter", function() if not planner.dragging then self.label:SetColor("ink-muted") end end)
        self:SetScript("OnLeave", function() self.label:SetColor("ink-faint") end)
        self:SetScript("OnClick", function()
            local add = planner.onAdd
            if add then add(g.n, self) end
        end)
    end

    function SetDropHover(on: boolean)
        self.fill:SetShown(on)
        self.edge:SetColor(on and "arcane" or "gilt-faint")
        self.label:SetColor(on and "ink" or "ink-faint")
    end
end

-- A group of five: its head, slot cards, Add slot, its party-wide buffs.
export class GroupBox extends Frame
    readonly title: uiText.Text
    readonly kind: uiText.Text
    readonly cards: SlotCard[] = {}
    readonly chips: GroupChip[] = {}
    readonly add: AddSlot
    readonly rule: Texture
    n: number = 0
    h: number = 0

    constructor(planner: RaidPlanner)
        super(nil, planner.mid)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-faint")
        self.title = uiText.text(self, "header", "gilt-text")
        self.title:SetPoint("TOPLEFT", 7, -6)
        self.kind = uiText.text(self, "caption", "ink-muted")
        self.kind:SetPoint("TOPRIGHT", -7, -7)
        self.add = AddSlot.new(planner, self)
        self.rule = draw.fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetHeight(1)
    end
end

-- Without a slot: a drop here lets a placed player go.
export class UnplacedZone extends Frame
    readonly fill: Texture
    readonly empty: uiText.Text
    where: DropWhere? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(RIGHT_W, 24)
        self.fill = draw.fill(self, "arcane-soft")
        self.fill:SetAllPoints()
        self.fill:Hide()
        self.empty = uiText.text(self, "caption", "ink-faint")
        self.empty:SetPoint("TOPLEFT", 0, -4)
        self.empty:SetValue("Nobody: everyone has a slot.")
    end

    function SetDropHover(on: boolean) self.fill:SetShown(on) end
end

-- Anything a drag can be dropped on.
type DropTarget = SlotCard | AddSlot | UnplacedZone

-- A class's row in the palette: its name (any of the class) and its specs.
export class PaletteRow extends Frame
    readonly diamond: Texture
    readonly name: PaletteChip
    readonly specs: PaletteChip[] = {}

    constructor(planner: RaidPlanner)
        super(nil, planner.left)
        self:SetSize(LEFT_W, PAL_H)
        self.diamond = draw.diamond(self, 5, "ink")
        self.diamond:SetPoint("LEFT", 2, 0)
        local name = PaletteChip.new(self)
        name.bg:Hide()
        name.edge:SetShown(false)
        name:SetPoint("LEFT", 8, 0)
        name:SetScript("OnEnter", nil)
        name:SetScript("OnLeave", nil)
        planner:Draggable(name, function(): (DragWhat?, string?, string?, DragArt?)
            return { spec = { class = name.class } }, name.text, classToken(name.class), { class = name.class, known = true }
        end)
        self.name = name
        for k = 1, 3 do
            -- each spec with its icon
            local s = PaletteChip.new(self, "icon")
            planner:Draggable(s, function(): (DragWhat?, string?, string?, DragArt?)
                return { spec = { class = s.class, spec = s.spec, role = s.role } }, s.text, classToken(s.class),
                    { icon = s.icon, class = s.class, known = true }
            end)
            self.specs[k] = s
        end
    end
end

-- A count in the status line.
export class StatItem extends Frame
    readonly n: uiText.Text
    readonly label: uiText.Text

    constructor(parent: Frame)
        super(nil, parent)
        self.n = uiText.text(self, "numeric", "ink")
        self.n:SetPoint("LEFT")
        self.label = uiText.text(self, "caption", "ink-muted")
        self.label:SetPoint("LEFT", self.n, "RIGHT", S["space-2"], 0)
    end
end

-- The card that follows the cursor while dragging.
export class DragGhost extends Frame
    readonly icon: uiIcon.Icon
    readonly text: uiText.Text

    constructor(planner: RaidPlanner)
        super(nil, UIParent)
        self:SetFrameStrata("TOOLTIP")
        self:SetHeight(22)
        draw.fill(self, "surface-raised"):SetAllPoints()
        draw.border(self, "arcane")
        self.icon = uiIcon.icon(self, 16)
        self.icon:SetPoint("LEFT", 3, 0)
        self.text = uiText.text(self, "label", "ink")
        self:SetScript("OnUpdate", function()
            local scale = self:GetEffectiveScale()
            local x, y = GetCursorPosition()
            self:ClearAllPoints()
            self:SetPoint("LEFT", UIParent, "BOTTOMLEFT", x / scale + 12, y / scale)
            local over = planner:TargetUnderCursor()
            if over ~= planner.over then
                local was = planner.over
                if was then was:SetDropHover(false) end
                if over then over:SetDropHover(true) end
                planner.over = over
            end
        end)
    end
end

--------------------------------------------------------------------------------
-- The slot editor: what a slot asks for, beside its card
--------------------------------------------------------------------------------

local ROLES: inputs.SegmentedOption<string>[] = { { value = "any", label = "Any" }, { value = "TANK", label = "Tank" },
                { value = "HEALER", label = "Healer" }, { value = "DAMAGER", label = "Damage" } }
local EDITOR_W = 320

local function field(parent: Frame, label: string): uiText.Text
    local t = uiText.text(parent, "caption", "ink-muted")
    t:SetValue(label)
    return t
end

export class SlotEditor extends Panel
    readonly planner: RaidPlanner
    def: SlotEditorDef? = nil
    readonly classLabel: uiText.Text
    readonly classSelect: selectModule.Select<string>
    readonly specLabel: uiText.Text
    -- one switch per class (its three specs), made when first needed
    readonly specs: { [string]: inputs.Segmented<PlannerSpec> } = {}
    readonly roleLabel: uiText.Text
    readonly role: inputs.Segmented<string>
    readonly labelLabel: uiText.Text
    readonly labelField: inputs.TextField
    readonly whoLabel: uiText.Text
    readonly whoSelect: selectModule.Select<string>
    readonly remove: controls.SuuButton
    readonly done: controls.SuuButton

    constructor(planner: RaidPlanner)
        super(planner, { title = "Slot", closable = true, solid = true, width = EDITOR_W })
        self.planner = planner
        self:SetFrameLevel(planner:GetFrameLevel() + 60)
        self:EnableMouse(true)
        local b = self.body
        local inner = EDITOR_W - S["space-5"] * 2
        self.classLabel = field(b, "Class")
        self.classSelect = selectModule.select(b, { options = {}, width = inner,
            onChange = function(v: string) self:Send({ class = v ~= "any" and v or false }) end })
        self.specLabel = field(b, "Spec")
        self.roleLabel = field(b, "Role")
        self.role = inputs.segmented(b, { options = ROLES, onChange = function(v: string) self:Send({ role = v ~= "any" and v or false }) end })
        self.labelLabel = field(b, "Label (optional)")
        self.labelField = inputs.textField(b, { width = inner, placeholder = "Main tank",
            onChange = function(text: string?) self:Send({ label = strtrim(text or "") }) end })
        self.whoLabel = field(b, "Who")
        self.whoSelect = selectModule.select(b, { options = {}, width = inner,
            onChange = function(v: string) self:Send({ pin = v ~= "any" and v or false }) end })
        self.remove = controls.button(b, { text = "Remove slot", onClick = function()
            local def = self.def
            self:Hide()
            local remove = planner.onSlotRemove
            if def and remove then remove(def.id) end
        end })
        self.done = controls.button(b, { text = "Done", variant = "primary", onClick = function() self:Hide() end })
        self:HookScript("OnHide", function() self.labelField.edit:ClearFocus() end)
        self:Hide()
    end

    -- Reports a change to the slot being edited.
    function Send(changes: SlotChanges)
        local def, change = self.def, self.planner.onSlotChange
        if def and change then change(def.id, changes) end
    end

    -- The spec switch for `class` (any: "any"), shown, the others hidden.
    function SpecSwitch(class: string?, options: inputs.SegmentedOption<PlannerSpec>[]): inputs.Segmented<PlannerSpec>
        local key = class or "any"
        local switch = self.specs[key]
        if not switch then
            switch = inputs.segmented(self.body, { options = options, onChange = function(v: PlannerSpec)
                self:Send({ spec = v ~= "any" and v or false })
            end })
            self.specs[key] = switch
        end
        for k, s in pairs(self.specs) do s:SetShown(k == key) end
        return switch
    end
end

--------------------------------------------------------------------------------
-- Arrange groups: the moves listed before they're made
--------------------------------------------------------------------------------

local MOVES_W = 340

-- A move in the list.
export class MoveRow extends Frame
    readonly icon: uiIcon.Icon
    readonly name: uiText.Text
    readonly from: uiText.Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(20)
        self.icon = uiIcon.icon(self, PERSON_ICON)
        self.icon:SetPoint("LEFT", 0, 0)
        self.name = uiText.text(self, "label", "ink")
        self.name:SetPoint("LEFT", PERSON_X, 0)
        self.name:SetJustifyH("LEFT")
        self.from = uiText.text(self, "caption", "ink-muted")
        self.from:SetPoint("RIGHT")
    end
end

export class MovesPanel extends Panel
    readonly rows: MoveRow[] = {}
    readonly note: uiText.Text
    readonly go: controls.SuuButton
    readonly cancel: controls.SuuButton
    onConfirm: (() -> ())? = nil

    constructor(planner: RaidPlanner)
        super(planner, { title = "Arrange groups", closable = true, solid = true, width = MOVES_W })
        self:SetFrameLevel(planner:GetFrameLevel() + 60)
        self:EnableMouse(true)
        self.note = uiText.text(self.body, "caption", "ink-muted")
        self.note:SetWordWrap(true)
        self.note:SetJustifyH("LEFT")
        self.go = controls.button(self.body, { text = "Move", variant = "primary", onClick = function()
            local fn = self.onConfirm
            self:Hide()
            if fn then fn() end
        end })
        self.cancel = controls.button(self.body, { text = "Cancel", onClick = function() self:Hide() end })
        self:Hide()
    end
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

local planners: { [RaidPlanner]: boolean } = setmetatable({}, { __mode = "k" })
-- a theme's line heights: everything laid out again
events.on("SUUUI_THEME_CHANGED", function()
    for w in pairs(planners) do if w.data and w:IsShown() then w:Draw() end end
end, "UI.RaidPlanner")

-- What carry(frame) gives a drag: what it carries, its text, colour and art.
type Carry = () -> (DragWhat?, string?, string?, DragArt?)

export class RaidPlanner extends WindowFrame
    status: Frame
    stats: StatItem[] = {}
    note: uiText.Text
    left: Frame
    mid: Frame
    right: Frame
    setupsHead: panel.SectionHeader
    sizes: inputs.Segmented<number>
    setupRows: SetupRow[] = {}
    renameField: inputs.TextField
    -- the setup the rename field is for
    renameId: PlannerId? = nil
    renaming: PlannerId? = nil
    newRow: Button
    newLabel: uiText.Text
    tools: controls.SuuButton[] = {}
    paletteHead: panel.SectionHeader
    roleChips: PaletteChip[] = {}
    palRows: PaletteRow[] = {}
    groupFrames: GroupBox[] = {}
    raidHead: panel.SectionHeader
    raidRows: ListRow[] = {}
    raidEmpty: uiText.Text
    openHead: panel.SectionHeader
    openRows: ListRow[] = {}
    openEmpty: uiText.Text
    unplacedHead: panel.SectionHeader
    unplacedZone: UnplacedZone
    personRows: PersonRow[] = {}
    arrange: controls.SuuButton
    inspect: controls.SuuButton
    fill: controls.SuuButton
    hint: uiText.Text
    dragging: DragWhat? = nil
    over: DropTarget? = nil
    ghost: DragGhost? = nil
    data: PlannerData? = nil
    dirty: boolean? = nil
    editor: SlotEditor? = nil
    movesPanel: MovesPanel? = nil
    -- what the module does when something is done (see the header)
    onSize: ((size: number) -> ())? = nil
    onSetup: ((id: PlannerId) -> ())? = nil
    onSetupMenu: ((id: PlannerId, owner: Frame) -> ())? = nil
    onNew: ((owner: Frame) -> ())? = nil
    onRename: ((id: PlannerId, text: string) -> ())? = nil
    onSave: (() -> ())? = nil
    onSaveAsNew: (() -> ())? = nil
    onDuplicate: (() -> ())? = nil
    onDelete: (() -> ())? = nil
    onSlot: ((id: PlannerId, owner: Frame, button: string) -> ())? = nil
    onAdd: ((group: number, owner: Frame) -> ())? = nil
    onDrop: ((what: DragWhat, where: DropWhere) -> ())? = nil
    onPerson: ((name: string, owner: Frame, button: string) -> ())? = nil
    onSlotChange: ((id: PlannerId, changes: SlotChanges) -> ())? = nil
    onSlotRemove: ((id: PlannerId) -> ())? = nil
    onInspect: (() -> ())? = nil
    onArrange: (() -> ())? = nil
    onFill: (() -> ())? = nil

    constructor(parent: Frame)
        super(parent, { name = "SuuUIRaidPlanner", title = "Raid planner", width = WIDTH, height = HEIGHT,
            footer = true, onClose = function(win: Frame) win:Hide() end })
        self:SetPoint("CENTER", UIParent, "CENTER", 0, 20)
        local c = self.content
        local contentW = WIDTH - S["space-5"] * 2
        c:SetWidth(contentW)

        -- the status line: counts, and how auto-fill works
        self.status = CreateFrame("Frame", nil, c)
        self.status:SetPoint("TOPLEFT")
        self.status:SetSize(contentW, 20)
        self.note = uiText.text(self.status, "caption", "ink-muted")
        self.note:SetPoint("RIGHT")

        local top = 20 + S["space-5"]
        self.left = CreateFrame("Frame", nil, c)
        self.left:SetPoint("TOPLEFT", 0, -top)
        self.left:SetSize(LEFT_W, 10)
        self.mid = CreateFrame("Frame", nil, c)
        self.mid:SetPoint("TOPLEFT", LEFT_W + COL_GAP, -top)
        self.mid:SetSize(10, 10)
        self.right = CreateFrame("Frame", nil, c)
        self.right:SetPoint("TOPLEFT", contentW - RIGHT_W, -top)
        self.right:SetSize(RIGHT_W, 10)

        -- left: setups, then the palette
        self.setupsHead = panel.sectionHeader(self.left, "Setups", "", LEFT_W)
        self.sizes = inputs.segmented(self.left, { options = { { value = 40, label = "40" }, { value = 20, label = "20" }, { value = 10, label = "10" } },
            onChange = function(v: number)
                local size = self.onSize
                if size then size(v) end
            end })
        self.renameField = inputs.textField(self.left, { width = LEFT_W, onChange = function(text: string?)
            local id = self.renameId
            self.renaming = nil
            local rename = self.onRename
            if id and rename then rename(id, strtrim(text or "")) end
        end })
        self.renameField.edit:HookScript("OnEditFocusLost", function()
            after(0, function() if self.renaming then self:Rename(nil) end end)
        end)
        self.renameField:Hide()
        local newRow = CreateFrame("Button", nil, self.left)
        newRow:SetSize(LEFT_W, 24)
        local newLabel = uiText.text(newRow, "caption", "ink-muted")
        newLabel:SetPoint("LEFT", 7, 0)
        newLabel:SetValue("+ New setup")
        newRow:SetScript("OnEnter", function() newLabel:SetColor("ink") end)
        newRow:SetScript("OnLeave", function() newLabel:SetColor("ink-muted") end)
        newRow:SetScript("OnClick", function(b: Button)
            local new = self.onNew
            if new then new(b) end
        end)
        self.newRow, self.newLabel = newRow, newLabel
        local bw = (LEFT_W - S["space-2"]) / 2
        local function call(fn: () -> (() -> ())?): () -> ()
            return function()
                local f = fn()
                if f then f() end
            end
        end
        self.tools = {
            controls.button(self.left, { text = "Save", variant = "primary", width = bw, onClick = call(function(): (() -> ())? return self.onSave end) }),
            controls.button(self.left, { text = "Save as new", width = bw, onClick = call(function(): (() -> ())? return self.onSaveAsNew end) }),
            controls.button(self.left, { text = "Duplicate", width = bw, onClick = call(function(): (() -> ())? return self.onDuplicate end) }),
            controls.button(self.left, { text = "Delete", width = bw, onClick = call(function(): (() -> ())? return self.onDelete end) }),
        }
        self.paletteHead = panel.sectionHeader(self.left, "Slot palette", "drag onto a slot", LEFT_W)
        for _, r in ipairs({ { "TANK", "Any tank" }, { "HEALER", "Any healer" }, { "DAMAGER", "Any damage" } }) do
            local b = PaletteChip.new(self.left, ROLE_GLYPH[r[1]])
            b:SetChipText(r[2])
            b.role, b.text = r[1], r[2]
            self:Draggable(b, function(): (DragWhat?, string?, string?, DragArt?) return { spec = { role = b.role } }, b.text, "ink" end)
            self.roleChips[#self.roleChips + 1] = b
        end

        -- right: raid-wide, open slots, without a slot
        self.raidHead = panel.sectionHeader(self.right, "Raid-wide", "tracked only", RIGHT_W)
        self.raidEmpty = uiText.text(self.right, "caption", "ink-faint")
        self.raidEmpty:SetWordWrap(true)
        self.raidEmpty:SetJustifyH("LEFT")
        self.raidEmpty:SetFixedWidth(RIGHT_W)
        self.openHead = panel.sectionHeader(self.right, "Open slots", "", RIGHT_W)
        self.openEmpty = uiText.text(self.right, "caption", "ink-faint")
        self.openEmpty:SetValue("None: every slot is filled.")
        self.unplacedHead = panel.sectionHeader(self.right, "Without a slot", "", RIGHT_W)
        self.unplacedZone = UnplacedZone.new(self.right)

        -- the footer (asked for above)
        local footer = self.footer :: Frame
        self.arrange = controls.button(footer, { text = "Arrange groups", variant = "primary",
            onClick = call(function(): (() -> ())? return self.onArrange end) })
        self.arrange:SetPoint("RIGHT", 0, 0)
        self.inspect = controls.button(footer, { text = "Inspect", icon = "eye",
            onClick = call(function(): (() -> ())? return self.onInspect end) })
        self.fill = controls.button(footer, { text = "Fill slots", onClick = call(function(): (() -> ())? return self.onFill end) })
        self.hint = uiText.text(footer, "caption", "ink-muted")
        self.hint:SetPoint("LEFT", 0, 0)
        self.hint:SetJustifyH("LEFT")
        self.hint:SetWordWrap(false)

        self:HookScript("OnShow", function()
            if self.dirty then self.dirty = nil; self:Draw() end
        end)
        self:HookScript("OnHide", function()
            if self.dragging then self:StopDrag() end
            local editor, moves = self.editor, self.movesPanel
            if editor then editor:Hide() end
            if moves then moves:Hide() end
        end)
        self:Hide()
        planners[self] = true
    end

    --------------------------------------------------------------------------
    -- Dragging: a card follows the cursor; the target under it lights up arcane
    --------------------------------------------------------------------------

    -- Makes `f` draggable: what it carries comes from carry().
    function Draggable(f: Button, carry: Carry)
        f:RegisterForDrag("LeftButton")
        f:SetScript("OnDragStart", function()
            local what, text, token, art = carry()
            if not what then return end
            tooltip.hideTooltip()
            self:StartDrag(what, text, token, art)
        end)
        f:SetScript("OnDragStop", function() self:StopDrag() end)
    end

    -- Everything that takes a drop, shown now: slot cards, Add slot, Without a slot.
    function Targets(): DropTarget[]
        local out: DropTarget[] = {}
        for _, g in ipairs(self.groupFrames) do
            if g:IsShown() then
                for _, c in ipairs(g.cards) do if c:IsShown() then out[#out + 1] = c end end
                if g.add:IsShown() then out[#out + 1] = g.add end
            end
        end
        if self.unplacedZone:IsShown() then out[#out + 1] = self.unplacedZone end
        return out
    end

    function TargetUnderCursor(): DropTarget?
        for _, t in ipairs(self:Targets()) do
            if t:IsMouseOver() then return t end
        end
        return nil
    end

    -- art: a player's or a spec's, or nil.
    function StartDrag(what: DragWhat, text: string?, token: string?, art: DragArt?)
        self.dragging = what
        local gh = self.ghost
        if not gh then
            gh = DragGhost.new(self)
            self.ghost = gh
        end
        local hasArt = art ~= nil and (art.icon ~= nil or art.class ~= nil)
        gh.icon:SetShown(hasArt)
        if art and hasArt then setPlayerIcon(gh.icon, art.icon, art.class, art.known) end
        local x = hasArt and (3 + 16 + S["space-3"]) or S["space-4"]
        gh.text:ClearAllPoints()
        gh.text:SetPoint("LEFT", x, 0)
        gh.text:SetValue(text or "")
        gh.text:SetColor(token or "ink")
        gh:SetWidth(x + uiText.measureText("label", text or "") + S["space-4"])
        gh:Show()
    end

    function StopDrag()
        local over = self:TargetUnderCursor()
        local ghost, lit = self.ghost, self.over
        if ghost then ghost:Hide() end
        if lit then lit:SetDropHover(false); self.over = nil end
        local what = self.dragging
        self.dragging = nil
        local drop, where = self.onDrop, over and over.where
        if what and where and drop then drop(what, where) end
    end

    --------------------------------------------------------------------------
    -- Drawing it all
    --------------------------------------------------------------------------

    -- Lays one group out at width w; returns its height.
    function DrawGroup(g: GroupBox, d: PlannerGroup, w: number): number
        g.n = d.n
        g.title:SetValue("Group " .. d.n)
        g.kind:SetValue(d.kind or "")
        local inner = w - 14
        local y = 6 + lineH("header") + 4
        local slots = d.slots or {}
        for i, s in ipairs(slots) do
            local c = pool(g.cards, i, function(): SlotCard return SlotCard.new(self, g) end)
            c:Fill(s, inner)
            c.where = { slot = s.id }
            c:ClearAllPoints()
            c:SetPoint("TOPLEFT", 7, -y)
            y = y + cardH() + 3
        end
        hideFrom(g.cards, #slots + 1)
        g.add:SetShown(d.canAdd == true)
        if d.canAdd then
            g.add.where = { group = d.n }
            g.add:SetSize(inner, 22)
            g.add:ClearAllPoints()
            g.add:SetPoint("TOPLEFT", 7, -y)
            y = y + 22 + 3
        end
        -- the party-wide buffs, wrapping, under a faint rule
        local chips = d.chips or {}
        g.rule:SetShown(#chips > 0)
        if #chips > 0 then
            y = y + 2
            g.rule:ClearAllPoints()
            g.rule:SetPoint("TOPLEFT", 7, -y)
            g.rule:SetWidth(inner)
            y = y + 4
            local x = 0
            for i, ch in ipairs(chips) do
                local f = pool(g.chips, i, function(): GroupChip return GroupChip.new(g) end)
                f.text:SetValue(ch.text)
                local cw = math.ceil(uiText.measureText("caption", ch.text)) + 10
                if x > 0 and x + cw > inner then x = 0; y = y + CHIP_H + 3 end
                f:SetWidth(math.min(cw, inner))
                local warn = ch.tone == "warn" or ch.tone == "open"
                f.edge:SetColor(warn and "amber" or "gilt-faint", ch.tone == "open" and 0.7 or nil)
                f.text:SetColor(warn and "amber" or "ink-muted")
                f.tip = ch.tip
                f:ClearAllPoints()
                f:SetPoint("TOPLEFT", 7 + x, -y)
                x = x + cw + 3
            end
            y = y + CHIP_H
        end
        hideFrom(g.chips, #chips + 1)
        return y + 7
    end

    function DrawLeft(d: PlannerData): number
        local y = 0
        local setups = d.setups or {}
        self.setupsHead:SetPoint("TOPLEFT", 0, 0)
        self.setupsHead:SetLabel("Setups", tostring(#setups))
        y = y + lineH("header") + S["space-4"]
        self.sizes:ClearAllPoints()
        self.sizes:SetPoint("TOPLEFT", 0, -y)
        self.sizes:SetValue(d.size)
        y = y + 30 + S["space-4"]
        local rowH = 5 + lineH("label") + 1 + lineH("caption") + 5
        self.renameField:Hide()
        for i, s in ipairs(setups) do
            local r = pool(self.setupRows, i, function(): SetupRow return SetupRow.new(self) end)
            r.id, r.loaded = s.id, s.loaded
            r:SetSize(LEFT_W, rowH)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -y)
            r.fill:SetShown(s.loaded == true)
            r.edge:SetShown(s.loaded == true)
            r.name:SetValue(s.name or "")
            r.name:SetWidth(math.min(LEFT_W - 28, uiText.measureText("label", s.name or "") + 1))
            r.name:Show()
            r.changed:SetShown(s.changed == true)
            r.meta:SetValue(s.meta or "")
            r.meta:SetWidth(LEFT_W - 14)
            if self.renaming == s.id then
                -- renaming in place: the field over the row, its own name hidden
                -- (it showed under what's typed)
                local f = self.renameField
                r.name:Hide()
                r.changed:Hide()
                f:SetFrameLevel(r:GetFrameLevel() + 5)
                f:ClearAllPoints()
                f:SetPoint("TOPLEFT", r, "TOPLEFT", 0, 0)
                f:Show()
                self.renameId = s.id
                if not f.edit:HasFocus() then
                    f:SetValue(s.name or "")
                    f.edit:SetFocus()
                    f.edit:HighlightText()
                end
                r.meta:SetValue("Renaming · Enter to keep")
                r:SetHeight(30 + 1 + lineH("caption") + 5)
                r.meta:ClearAllPoints()
                r.meta:SetPoint("TOPLEFT", f, "BOTTOMLEFT", 7, -1)
            else
                r.meta:ClearAllPoints()
                r.meta:SetPoint("TOPLEFT", r.name, "BOTTOMLEFT", 0, -1)
            end
            y = y + r:GetHeight() + S["space-1"]
        end
        hideFrom(self.setupRows, #setups + 1)
        self.newRow:ClearAllPoints()
        self.newRow:SetPoint("TOPLEFT", 0, -y)
        y = y + 24 + S["space-4"]
        -- Save, Save as new, Duplicate, Delete: two by two
        local bw = (LEFT_W - S["space-2"]) / 2
        for i, b in ipairs(self.tools) do
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", ((i - 1) % 2) * (bw + S["space-2"]), -(y + math.floor((i - 1) / 2) * (30 + S["space-2"])))
        end
        y = y + 2 * 30 + S["space-2"] + S["space-6"]
        -- the palette: any by role, then each class's specs
        self.paletteHead:ClearAllPoints()
        self.paletteHead:SetPoint("TOPLEFT", 0, -y)
        y = y + lineH("header") + S["space-4"]
        local x = 0
        for _, b in ipairs(self.roleChips) do
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", x, -y)
            x = x + b:GetWidth() + S["space-2"]
        end
        y = y + PAL_H + S["space-3"]
        local palette = d.palette or {}
        for i, c in ipairs(palette) do
            local row = pool(self.palRows, i, function(): PaletteRow return PaletteRow.new(self) end)
            row:ClearAllPoints()
            row:SetPoint("TOPLEFT", 0, -y)
            draw.paint(row.diamond, classToken(c.class))
            row.name:SetChipText(c.name)
            row.name.label:SetColor(classToken(c.class))
            row.name.class, row.name.text = c.class, "Any " .. c.name:lower()
            local sx = 62
            for k, s in ipairs(row.specs) do
                local sp = c.specs and c.specs[k]
                s:SetShown(sp ~= nil)
                if sp then
                    s:SetChipText(sp.label)
                    local glyph = s.glyph
                    if glyph then setArt(glyph, sp.icon, c.class) end
                    s.class, s.spec, s.role, s.icon, s.text = c.class, sp.spec, sp.role, sp.icon, c.name .. " · " .. (sp.name or sp.label)
                    s:ClearAllPoints()
                    s:SetPoint("LEFT", sx, 0)
                    sx = sx + s:GetWidth() + S["space-2"]
                end
            end
            y = y + PAL_H + S["space-1"]
        end
        hideFrom(self.palRows, #palette + 1)
        return y
    end

    function DrawGroups(d: PlannerData, w: number): number
        local groups = d.groups or {}
        local cols = 4
        local gw = math.floor((w - (cols - 1) * GROUP_GAP) / cols)
        local y = 0
        for first = 1, #groups, cols do
            local rowH = 0
            for i = first, math.min(#groups, first + cols - 1) do
                local g = pool(self.groupFrames, i, function(): GroupBox return GroupBox.new(self) end)
                local h = self:DrawGroup(g, groups[i], gw)
                g.h = h
                rowH = math.max(rowH, h)
                g:ClearAllPoints()
                g:SetPoint("TOPLEFT", (i - first) * (gw + GROUP_GAP), -y)
            end
            for i = first, math.min(#groups, first + cols - 1) do self.groupFrames[i]:SetSize(gw, rowH) end
            y = y + rowH + GROUP_GAP
        end
        hideFrom(self.groupFrames, #groups + 1)
        return y
    end

    function DrawRight(d: PlannerData): number
        local R = self.right
        local y = 0
        local list = d.raidWide or {}
        self.raidHead:SetPoint("TOPLEFT", 0, 0)
        self.raidHead:SetLabel("Raid-wide", d.raidWideMeta or "tracked only")
        y = y + lineH("header") + S["space-3"]
        for i, item in ipairs(list) do
            local r = pool(self.raidRows, i, function(): ListRow return ListRow.new(R) end)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -y)
            y = y + r:Draw(item, i == 1, RIGHT_W)
        end
        hideFrom(self.raidRows, #list + 1)
        self.raidEmpty:SetShown(#list == 0)
        if #list == 0 then
            self.raidEmpty:ClearAllPoints()
            self.raidEmpty:SetPoint("TOPLEFT", 0, -y)
            self.raidEmpty:SetValue(d.raidWideEmpty or "Nothing raid-wide is tracked (Settings › Raid planner).")
            y = y + self.raidEmpty:GetStringHeight()
        end
        y = y + S["space-6"]
        -- open slots
        local open = d.open or {}
        self.openHead:ClearAllPoints()
        self.openHead:SetPoint("TOPLEFT", 0, -y)
        self.openHead:SetLabel("Open slots", tostring(#open))
        y = y + lineH("header") + S["space-3"]
        for i, item in ipairs(open) do
            local r = pool(self.openRows, i, function(): ListRow return ListRow.new(R) end)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -y)
            y = y + r:Draw({ label = item.label, detail = item.detail, warn = true }, i == 1, RIGHT_W)
        end
        hideFrom(self.openRows, #open + 1)
        if #open == 0 then
            self.openEmpty:Show()
            self.openEmpty:ClearAllPoints()
            self.openEmpty:SetPoint("TOPLEFT", 0, -y)
            y = y + lineH("caption")
        else
            self.openEmpty:Hide()
        end
        y = y + S["space-6"]
        -- players without a slot: a drop here lets a placed player go
        local people = d.unplaced or {}
        self.unplacedHead:ClearAllPoints()
        self.unplacedHead:SetPoint("TOPLEFT", 0, -y)
        self.unplacedHead:SetLabel("Without a slot", d.unplacedMeta or tostring(#people))
        y = y + lineH("header") + S["space-3"]
        local zone = self.unplacedZone
        zone:ClearAllPoints()
        zone:SetPoint("TOPLEFT", 0, -y)
        zone.where = { unplaced = true }
        local zy = 0
        for i, p in ipairs(people) do
            local r = pool(self.personRows, i, function(): PersonRow return PersonRow.new(self) end)
            r.person, r.class, r.personIcon, r.known = p.name, p.class, p.icon, p.known
            r.rule:SetShown(i > 1)
            setPlayerIcon(r.icon, p.icon, p.class, p.known)
            r.name:SetValue(p.name or "")
            r.name:SetColor(classToken(p.class))
            r.detail:SetFixedWidth(RIGHT_W - PERSON_X)
            r.detail:SetValue(p.detail or "")
            local h = 4 + lineH("label") + r.detail:GetStringHeight() + 4
            r:SetSize(RIGHT_W, h)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -zy)
            zy = zy + h
        end
        hideFrom(self.personRows, #people + 1)
        zone.empty:SetShown(#people == 0)
        zone:SetSize(RIGHT_W, math.max(zy, 24))
        y = y + zone:GetHeight()
        return y
    end

    function DrawStatus(d: PlannerData)
        local x = 0
        local stats = d.stats or {}
        for i, st in ipairs(stats) do
            local f = pool(self.stats, i, function(): StatItem return StatItem.new(self.status) end)
            f.n:SetValue(tostring(st.n))
            f.n:SetColor(st.warn and "amber" or "ink")
            f.label:SetValue(st.label)
            local w = uiText.measureText("numeric", tostring(st.n)) + S["space-2"] + uiText.measureText("caption", st.label)
            f:SetSize(w, 20)
            f:ClearAllPoints()
            f:SetPoint("LEFT", x, 0)
            x = x + w + 14
        end
        hideFrom(self.stats, #stats + 1)
        self.note:SetValue(d.note or "")
    end

    function Draw()
        local d = self.data or {}
        self:SetTitle("Raid planner", d.meta or "")
        self:DrawStatus(d)
        local contentW = WIDTH - S["space-5"] * 2
        local midW = contentW - LEFT_W - RIGHT_W - COL_GAP * 2
        self.mid:SetWidth(midW)
        local top = 20 + S["space-5"]
        local h = math.max(self:DrawLeft(d), self:DrawGroups(d, midW), self:DrawRight(d))
        self.content:SetHeight(top + h + S["space-4"])
        -- the footer: the hint, then Fill, Inspect, Arrange groups
        self.hint:SetValue(d.hint or "")
        local function button(b: controls.SuuButton, given: PlannerButton?, label: string?)
            local def = given or {}
            b:SetShown(def.shown ~= false)
            if label then b:SetLabel(label) end
            b:SetEnabledState(def.enabled == true)
            local reason = def.reason
            b.tooltip = (not def.enabled and reason) and { title = b.label:GetText(), description = reason } or nil
        end
        button(self.arrange, d.arrange)
        button(self.inspect, d.inspect, d.inspect and d.inspect.label)
        button(self.fill, d.fill)
        local prev = self.arrange
        for _, b in ipairs({ self.inspect, self.fill }) do
            b:ClearAllPoints()
            if b:IsShown() then
                b:SetPoint("RIGHT", prev, "LEFT", -S["space-4"], 0)
                prev = b
            end
        end
        self.hint:SetPoint("RIGHT", prev, "LEFT", -S["space-5"], 0)
    end

    function SetData(d: PlannerData)
        self.data = d
        if self:IsShown() then self:Draw() else self.dirty = true end
    end

    -- Renaming setup `id` in its row (nil: done).
    function Rename(id: PlannerId?)
        self.renaming = id
        self:Draw()
    end

    -- def: what the slot asks for and the choices; the editor sits beside `card`.
    function EditSlot(def: SlotEditorDef, card: Frame?)
        local p = self.editor
        if not p then
            p = SlotEditor.new(self)
            self.editor = p
        end
        p.def = def
        p:SetTitle(def.title or "Slot", def.meta or "")
        local y = 0
        local function place(region: Region, h: number, gap: number?)
            region:ClearAllPoints()
            region:SetPoint("TOPLEFT", 0, -y)
            y = y + h + (gap or S["space-2"])
        end
        place(p.classLabel, lineH("caption"))
        p.classSelect:SetOptions(def.classes or {})
        p.classSelect:SetValue(def.class or "any")
        place(p.classSelect, 30, S["space-5"])
        place(p.specLabel, lineH("caption"))
        local spec = p:SpecSwitch(def.class, def.specs or { { value = "any", label = "Any" } })
        spec:SetValue(def.spec or "any")
        spec:SetDisabled(def.class == nil)
        place(spec, 30, S["space-5"])
        place(p.roleLabel, lineH("caption"))
        p.role:SetValue(def.role or "any")
        place(p.role, 30, S["space-5"])
        place(p.labelLabel, lineH("caption"))
        if not p.labelField.edit:HasFocus() then p.labelField:SetValue(def.label or "") end
        place(p.labelField, 30, S["space-5"])
        place(p.whoLabel, lineH("caption"))
        p.whoSelect:SetOptions(def.whoOptions or { { value = "any", label = "Anyone who fits" } })
        p.whoSelect:SetValue(def.who or "any")
        place(p.whoSelect, 30, S["space-5"])
        p.done:ClearAllPoints()
        p.done:SetPoint("TOPRIGHT", p.body, "TOPRIGHT", 0, -y)
        p.remove:ClearAllPoints()
        p.remove:SetPoint("RIGHT", p.done, "LEFT", -S["space-4"], 0)
        y = y + 30
        p.body:SetHeight(y)
        p:Fit()
        if card then
            -- beside the card, on whichever side has room
            p:ClearAllPoints()
            local cardRight, right = card:GetRight(), self:GetRight()
            if cardRight and right and right - cardRight > EDITOR_W + 20 then
                p:SetPoint("TOPLEFT", card, "TOPRIGHT", 12, 0)
            else
                p:SetPoint("TOPRIGHT", card, "TOPLEFT", -12, 0)
            end
            p:SetClampedToScreen(true)
        elseif not p:GetPoint() then
            p:SetPoint("CENTER", self, "CENTER")
        end
        p:Show()
    end

    -- The card showing slot `id`, if it's drawn.
    function CardFor(id: PlannerId): SlotCard?
        for _, g in ipairs(self.groupFrames) do
            for _, c in ipairs(g.cards) do
                local s = c.slot
                if c:IsShown() and s and s.id == id then return c end
            end
        end
        return nil
    end

    function CloseEditor()
        local editor = self.editor
        if editor then editor:Hide() end
    end

    -- The slot being edited, if the editor is open.
    function EditingSlot(): PlannerId?
        local editor = self.editor
        local def = editor and editor:IsShown() and editor.def
        return def and def.id or nil
    end

    function ShowMoves(def: PlannerMoves, onConfirm: (() -> ())?)
        local p = self.movesPanel
        if not p then
            p = MovesPanel.new(self)
            self.movesPanel = p
        end
        p.onConfirm = onConfirm
        local moves = def.moves or {}
        p:SetTitle("Arrange groups", def.meta or (#moves == 1 and "1 move" or (#moves .. " moves")))
        local inner = MOVES_W - S["space-5"] * 2
        local y = 0
        local body = p.body
        for i, m in ipairs(moves) do
            local r = pool(p.rows, i, function(): MoveRow return MoveRow.new(body) end)
            r:SetWidth(inner)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -y)
            setPlayerIcon(r.icon, m.icon, m.class, m.known)
            r.name:SetValue(m.name or "")
            r.name:SetColor(classToken(m.class))
            r.name:SetWidth(inner - PERSON_X - 90)
            r.from:SetValue(("group %d → %d"):format(m.from or 0, m.to or 0))
            y = y + 20 + S["space-1"]
        end
        hideFrom(p.rows, #moves + 1)
        y = y + S["space-4"]
        p.note:SetFixedWidth(inner)
        p.note:SetValue(def.note or "")
        p.note:ClearAllPoints()
        p.note:SetPoint("TOPLEFT", 0, -y)
        y = y + p.note:GetStringHeight() + S["space-5"]
        p.go:SetLabel(#moves == 1 and "Move 1 player" or ("Move " .. #moves .. " players"))
        p.go:ClearAllPoints()
        p.go:SetPoint("TOPRIGHT", p.body, "TOPRIGHT", 0, -y)
        p.cancel:ClearAllPoints()
        p.cancel:SetPoint("RIGHT", p.go, "LEFT", -S["space-4"], 0)
        p.body:SetHeight(y + 30)
        p:Fit()
        p:ClearAllPoints()
        p:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", -S["space-5"], 30 + S["space-4"] * 2 + S["space-4"])
        p:Show()
    end
end

export function raidPlanner(parent: Frame): RaidPlanner
    return RaidPlanner.new(parent)
end
