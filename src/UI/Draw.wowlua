-- UI/Draw.wowlua
-- Drawing helpers every component is built from: token fills, 1px borders that
-- stay one physical pixel at any scale, fading hairlines, the gilt diamond,
-- and soft glows and shadows.

import tokens as T, Color, ShadowLayer from "/Core/Tokens"
import * as pixel from "/Core/Pixel"
import * as events from "/Core/Events"
import * as combat from "/Core/Combat"

local colors = T.color :: { [string]: Color }

local WHITE = "Interface\\Buttons\\WHITE8X8"
local SOFT = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Soft.tga"

-- A token colour's hex ("3fd0ff"; an unknown token is an error, as for rgba).
export function hex(name: string): string
    local c = colors[name] or error("SuuUI: unknown colour token " .. tostring(name), 2)
    return c.hex
end

-- Whether `name` is a colour token.
export function isColor(name: string): boolean
    return colors[name] ~= nil
end

-- A class's colour token ("class-mage"), or `fallback` for no class or one
-- without a colour.
export function classColor(class: string?, fallback: string): string
    if not class then
        return fallback
    end
    local token = "class-" .. class:lower()
    return colors[token] and token or fallback
end

-- A token colour as r, g, b, a; `alpha` multiplies the token's own alpha.
export function rgba(name: string, alpha: number?): (number, number, number, number)
    local c = colors[name] or error("SuuUI: unknown colour token " .. tostring(name), 2)
    return c[1], c[2], c[3], c[4] * (alpha or 1)
end

-- The marks text shows inline, from SuuUI's own art (64 px): the fonts have
-- no ▲ ▼ ✓ ●, and the game draws a missing character as an empty box. Each
-- is a glyph's name (or, for the dot, a texture token's): a theme's own.
export const MARKS = {
    up = "chevronUp",
    down = "chevronDown",
    check = "check",
    dot = "circle-fill",
}

-- A mark for a line of text (`|T…|t`) in a colour token, as tall as the line;
-- the colour and the file are the theme's when the text is made (no repaint).
export function inlineMark(name: "up" | "down" | "check" | "dot", token: string): string
    local r, g, b = rgba(token)
    local file = name == "dot" and (T.texture :: { [string]: string })[MARKS.dot] or
        (T.glyph :: { [string]: string })[MARKS[name]]
    return ("|T%s:0:0:0:0:64:64:0:64:0:64:%d:%d:%d|t"):format(
        file,
        math.floor(r * 255 + 0.5),
        math.floor(g * 255 + 0.5),
        math.floor(b * 255 + 0.5)
    )
end

--------------------------------------------------------------------------------
-- Paint: colours that follow the theme (asked 2026-10-19: themes and colour
-- vision change without a reload). A colour set by its token is kept with
-- the region it was set on; when the theme or colour vision changes,
-- repaint sets every kept one again. Setting the region's colour any
-- other way (a class colour, a raw value, a texture instead) lets it go,
-- so a repaint never undoes what the code set since.
--   paint(region, token[, alpha])          a FontString's or EditBox's text
--                                          colour, a StatusBar's bar colour,
--                                          or a texture's vertex colour
--   paintFill(texture, token[, alpha])     a solid colour texture
--   paintGradient(texture, orientation, fromToken, toToken[, fromAlpha, toAlpha])
--   bind(region, fn)                       fn(region) now and after each
--                                          change, for anything else
-- `alpha` multiplies the token's own, as with rgba. What can't be kept
-- this way (colour codes in text, colours worked out from a token) is set
-- again on the message SUUUI_THEME_CHANGED.
--------------------------------------------------------------------------------

-- How a kept colour is set again: a texture's fill or vertex colour, a
-- text's colour, a bar's, a gradient, or a function of the region's.
-- What a colour can be kept on: a region, or a font object (its text colour).
type Paintable = Region | Font
type PaintKind = "fill" | "vertex" | "text" | "bar" | "gradient" | "fn"
type Paint = {
    kind?: PaintKind,
    token?: string,
    alpha?: number,
    fn?: (region: Paintable) -> (),
    token2?: string,
    alpha2?: number,
    orientation?: Orientation,
}

local paints: { [Paintable]: Paint } = setmetatable({}, { __mode = "k" }) -- region -> { kind, token, alpha, ... }
local watched: { [Paintable]: { [string]: boolean } } = setmetatable({}, { __mode = "k" }) -- region -> { [setter] = true }
local painting = false

-- the setters that take a colour away from each kind of paint (a font
-- object brings its own colour; a bar's new texture may come without one)
local LETS_GO: { [PaintKind]: string[] } = {
    fill = { "SetColorTexture", "SetTexture", "SetAtlas", "SetGradient" },
    vertex = { "SetVertexColor", "SetGradient" },
    text = { "SetTextColor", "SetFontObject" },
    bar = { "SetStatusBarColor", "SetStatusBarTexture" },
    gradient = { "SetColorTexture", "SetVertexColor", "SetGradient", "SetTexture", "SetAtlas" },
    fn = { "SetColorTexture", "SetVertexColor", "SetGradient", "SetTextColor", "SetStatusBarColor" },
}

local function letGo(region: Paintable)
    if not painting then
        paints[region] = nil
    end
end

-- Whether the widget has that method (not every region has every setter).
local function has(widget: unknown, method: string): boolean
    return type(widget) == "table" and (widget :: { [string]: unknown })[method] ~= nil
end

local function watch(region: Paintable, kind: PaintKind)
    local w = watched[region]
    if not w then
        local made: { [string]: boolean } = {}
        watched[region] = made
        w = made
    end
    for _, setter in ipairs(LETS_GO[kind] or {}) do
        if not w[setter] and has(region, setter) then
            w[setter] = true
            hooksecurefunc(region, setter, letGo)
        end
    end
end

-- (the kind says what the region is: paint chose it from the object type)
local function draw(region: Paintable, p: Paint)
    local kind = p.kind
    local token = p.token or "ink"
    if kind == "fill" then
        (region :: TextureBase):SetColorTexture(rgba(token, p.alpha))
    elseif kind == "vertex" then
        (region :: Texture):SetVertexColor(rgba(token, p.alpha))
    elseif kind == "text" then
        (region :: FontString | Font):SetTextColor(rgba(token, p.alpha))
    elseif kind == "bar" then
        (region :: StatusBar):SetStatusBarColor(rgba(token, p.alpha))
    elseif kind == "gradient" then
        local r1, g1, b1, a1 = rgba(token, p.alpha)
        local r2, g2, b2, a2 = rgba(p.token2 or token, p.alpha2)
        local texture = region :: Texture
        texture:SetGradient(p.orientation or "HORIZONTAL", CreateColor(r1, g1, b1, a1), CreateColor(r2, g2, b2, a2))
    else
        local fn = p.fn
        if fn then
            fn(region)
        end
    end
end

-- A colour kept and set. The same kind, token and alpha as kept already
-- set nothing: the region shows them still (anything that set its colour
-- since let the paint go, and a theme's repaint set the token's new value).
-- Painting is done on every draw of a button or a slot: most change nothing.
local function keep(region: Paintable, kind: PaintKind, token: string, alpha: number?): Paint
    local p = paints[region]
    if p and kind ~= "gradient" and p.kind == kind and p.token == token and p.alpha == alpha then
        return p
    end
    if not p then
        p = {}
        paints[region] = p
    end
    p.kind, p.token, p.alpha, p.fn = kind, token, alpha, nil
    -- (a hook may paint while repaint runs: keep its flag)
    local was = painting
    painting = true
    local ok: boolean, err: unknown = pcall(draw, region, p)
    painting = was
    if not ok then
        paints[region] = nil
        error(err, 3)
    end
    watch(region, kind)
    return p
end

local KIND: { [string]: PaintKind } = { FontString = "text", EditBox = "text", StatusBar = "bar" }

-- A FontString, EditBox, StatusBar or texture (see above).
export function paint(region: Region, token: string, alpha: number?)
    keep(region, KIND[region:GetObjectType()] or "vertex", token, alpha)
end

-- (a texture or a line)
export function paintFill(texture: TextureBase, token: string, alpha: number?)
    keep(texture, "fill", token, alpha)
end

export function paintGradient(
    texture: Texture,
    orientation: Orientation,
    from: string,
    to: string,
    fromAlpha: number?,
    toAlpha: number?
)
    local p: Paint = paints[texture] or {}
    if p.kind == "gradient" and p.token == from and p.alpha == fromAlpha and p.token2 == to and p.alpha2 == toAlpha and
        p.orientation == orientation then
        return
    end
    paints[texture] = p
    p.token2, p.alpha2, p.orientation = to, toAlpha, orientation
    keep(texture, "gradient", from, fromAlpha)
end

export function bind<R extends Paintable>(region: R, fn: (region: R) -> ())
    local p = paints[region]
    if not p then
        p = {}
        paints[region] = p
    end
    -- (called with this region only)
    p.kind, p.fn = "fn", fn :: (region: Paintable) -> ()
    local was = painting
    painting = true
    local ok: boolean, err: unknown = pcall(fn, region)
    painting = was
    if not ok then
        paints[region] = nil
        error(err, 2)
    end
    watch(region, "fn")
end

-- Every kept colour again (Themes.wowlua, after the theme or colour vision
-- changed the tokens).
export function repaint()
    painting = true
    -- (a hook painting another region mid-loop adds to the table: walk a copy)
    local list: { region: Paintable, paint: Paint }[] = {}
    for region, p in pairs(paints) do
        list[#list + 1] = { region = region, paint = p }
    end
    for _, e in ipairs(list) do
        local ok: boolean, err: unknown = pcall(draw, e.region, e.paint)
        if not ok then
            geterrorhandler()(err)
        end
    end
    painting = false
end

--------------------------------------------------------------------------------
-- Skins: textures that follow the theme (asked 2026-11-12: every texture the
-- unit frames and nameplates draw, a theme can replace). A texture set from
-- a texture token (T.texture: the bars' fill, the hatches, the glows…) is
-- kept with the region, as a colour is; when a theme changes the token,
-- reskin sets the new file on every kept one (live frames and pooled
-- plates alike). Colours stay with paint: set a skin first, then its colour.
--   skin(texture, token[, tile])   a texture's file; tile: repeated at its
--                                  own size (the hatches) instead of stretched
--   skinBar(bar, token)            a StatusBar's fill
--------------------------------------------------------------------------------

-- what each skinned region shows: its token, the file set, whether tiled
-- (three weak maps, no table per region: every plate skins a dozen)
local skinToken: { [Texture | StatusBar]: string } = setmetatable({}, { __mode = "k" })
local skinFile: { [Texture | StatusBar]: string } = setmetatable({}, { __mode = "k" })
local skinTiled: { [Texture | StatusBar]: boolean } = setmetatable({}, { __mode = "k" })
local files = T.texture :: { [string]: string }
-- soft edges from a texture token, by their parts (nine textures each, set
-- together: one entry an edge, not nine skins)
local edgeToken: { [Texture[]]: string } = setmetatable({}, { __mode = "k" })
local edgeFile: { [Texture[]]: string } = setmetatable({}, { __mode = "k" })

-- A texture token's file now (an unknown token is an error).
export function textureFile(token: string): string
    return files[token] or error("SuuUI: unknown texture token " .. tostring(token), 2)
end

-- Whether `name` is a texture token.
export function isTexture(name: string): boolean
    return files[name] ~= nil
end

local function setSkin(region: Texture | StatusBar, file: string, tile: boolean)
    if region:GetObjectType() == "StatusBar" then
        -- (the bar keeps its texture object: SetStatusBarTexture with a file
        -- sets it on the texture the bar has)
        (region :: StatusBar):SetStatusBarTexture(file)
        return
    end
    local t = region :: Texture
    if tile then
        -- (tiles only with the texture set to repeat: without it the game
        -- stretched the hatch's edge across the shield, seen 2026-11-08)
        t:SetTexture(file, "REPEAT", "REPEAT")
        t:SetHorizTile(true)
        t:SetVertTile(true)
    else
        t:SetTexture(file)
    end
end

-- (a kept colour stays while a skin is set: a skin is set before its colour)
local function keepSkin(region: Texture | StatusBar, token: string, tile: boolean)
    local file = files[token] or error("SuuUI: unknown texture token " .. tostring(token), 3)
    if skinToken[region] == token and skinFile[region] == file and (skinTiled[region] == true) == tile then
        return
    end
    skinToken[region], skinFile[region] = token, file
    skinTiled[region] = tile or nil
    -- (nothing kept on it yet, as when a frame is built: set at once)
    if paints[region] == nil then
        setSkin(region, file, tile)
        return
    end
    local was = painting
    painting = true
    local ok: boolean, err: unknown = pcall(setSkin, region, file, tile)
    painting = was
    if not ok then
        error(err, 3)
    end
end

-- A texture's file from a texture token; `tile` repeats it at its own size.
export function skin(tex: Texture, token: string, tile: boolean?)
    keepSkin(tex, token, tile == true)
end

-- A StatusBar's fill from a texture token, stretched along the bar.
export function skinBar(bar: StatusBar, token: string)
    keepSkin(bar, token, false)
end

-- A texture or bar let go of its skin: something else shows there now (a
-- class icon where a role was), which a theme change must leave alone.
export function unskin(region: Texture | StatusBar)
    skinToken[region], skinFile[region], skinTiled[region] = nil, nil, nil
end

-- The texture token a texture or bar was skinned with (nil: none).
export function skinOf(region: Texture | StatusBar): string?
    return skinToken[region]
end

--------------------------------------------------------------------------------
-- Glyphs: SuuUI's icons by name (asked 2026-11-12: a theme replaces any of
-- them, T.glyph). A texture given a glyph is kept, as a skin is; when a
-- theme changes the glyph's file, reskin sets it again (keeping the
-- texture's colour, size and tex coords). Setting the texture any other way
-- (another file, an atlas, a colour) lets it go.
--   glyph(texture, name)   a texture's file from a glyph's name
--   glyphFile(name)        a glyph's file now (for |T…|t text, art paths)
--------------------------------------------------------------------------------

local glyphFiles = T.glyph :: { [string]: string }
-- what each glyph texture shows: its glyph's name and the file set
local glyphName: { [Texture]: string } = setmetatable({}, { __mode = "k" })
local glyphSet: { [Texture]: string } = setmetatable({}, { __mode = "k" })
local glyphWatched: { [Texture]: boolean } = setmetatable({}, { __mode = "k" })
local glyphing = false

local function letGlyphGo(tex: Texture)
    if not glyphing then
        glyphName[tex] = nil
        glyphSet[tex] = nil
    end
end

-- where a name that isn't a glyph points (Media/Textures/Glyphs/<name>.tga,
-- as before glyphs had names: no file, so nothing shows)
local GLYPH_DIR = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"

-- A glyph's file now (a name that isn't one: where it would be, as before).
export function glyphFile(name: string): string
    return glyphFiles[name] or (GLYPH_DIR .. tostring(name) .. ".tga")
end

-- Whether `name` is a glyph.
export function isGlyph(name: string): boolean
    return glyphFiles[name] ~= nil
end

-- A texture's file from a glyph's name, kept: a theme's glyph replaces it.
-- (A name that isn't a glyph is set as before, not kept: nothing shows.)
export function glyph(tex: Texture, name: string)
    local file = glyphFiles[name]
    if not file then
        tex:SetTexture(GLYPH_DIR .. tostring(name) .. ".tga")
        return
    end
    if glyphName[tex] == name and glyphSet[tex] == file then
        return
    end
    glyphing = true
    local ok: boolean, err: unknown = pcall(tex.SetTexture, tex, file)
    glyphing = false
    if not ok then
        error(err, 2)
    end
    glyphName[tex], glyphSet[tex] = name, file
    -- (a glyph where a skin was: the skin lets go)
    skinToken[tex], skinFile[tex], skinTiled[tex] = nil, nil, nil
    if not glyphWatched[tex] then
        glyphWatched[tex] = true
        for _, setter in ipairs({ "SetTexture", "SetAtlas", "SetColorTexture" }) do
            if has(tex, setter) then
                hooksecurefunc(tex, setter, letGlyphGo)
            end
        end
    end
end

-- The glyph a texture shows (nil: none, or set another way since).
export function glyphOf(tex: Texture): string?
    return glyphName[tex]
end

-- Every kept skin and glyph whose file changed, set again (Themes.wowlua,
-- before the colours are repainted: a bar's new file may take the bar's own
-- colour, and repaint then sets the kept ones). A texture keeps the part of
-- its file it showed (a raid marker's cell, a glow's slice).
export function reskin()
    local list: (Texture | StatusBar)[] = {}
    for region, token in pairs(skinToken) do
        if files[token] ~= skinFile[region] then
            list[#list + 1] = region
        end
    end
    for parts, token in pairs(edgeToken) do
        local file = files[token]
        if file and file ~= edgeFile[parts] then
            edgeFile[parts] = file
            for _, t in ipairs(parts) do
                local okCoords, a, b, c, d, e, f, g, h = pcall(t.GetTexCoord, t)
                t:SetTexture(file)
                if okCoords then
                    pcall(t.SetTexCoord, t, a, b, c, d, e, f, g, h)
                end
            end
        end
    end
    painting = true
    for _, region in ipairs(list) do
        local file = files[skinToken[region] or ""] or skinFile[region] or ""
        local tile = skinTiled[region] == true
        skinFile[region] = file
        local ok: boolean, err: unknown
        if region:GetObjectType() == "StatusBar" then
            ok, err = pcall(setSkin, region, file, tile)
        else
            local t = region :: Texture
            -- (a secret marker cell can't be read back: its next update sets it)
            local okCoords, a, b, c, d, e, f, g, h = pcall(t.GetTexCoord, t)
            ok, err = pcall(setSkin, region, file, tile)
            if ok and okCoords then
                pcall(t.SetTexCoord, t, a, b, c, d, e, f, g, h)
            end
        end
        if not ok then
            geterrorhandler()(err)
        end
    end
    painting = false
    local changed: Texture[] = {}
    for tex, name in pairs(glyphName) do
        if glyphFiles[name] ~= glyphSet[tex] then
            changed[#changed + 1] = tex
        end
    end
    glyphing = true
    for _, tex in ipairs(changed) do
        local file = glyphFiles[glyphName[tex] or ""] or glyphSet[tex] or ""
        glyphSet[tex] = file
        local okCoords, a, b, c, d, e, f, g, h = pcall(tex.GetTexCoord, tex)
        local ok: boolean, err: unknown = pcall(tex.SetTexture, tex, file)
        if ok and okCoords then
            pcall(tex.SetTexCoord, tex, a, b, c, d, e, f, g, h)
        end
        if not ok then
            geterrorhandler()(err)
        end
    end
    glyphing = false
end

-- A size token in px, or a number passed through.
export function size(v: number | string): number
    if type(v) == "number" then
        return v
    end
    return (T.size :: { [string]: number })[v] or (T.space :: { [string]: number })[v] or
        error("SuuUI: unknown size token " .. tostring(v), 2)
end

--------------------------------------------------------------------------------
-- Layout that follows the theme (asked 2026-11-12: a theme may change the
-- spacing and sizes, T.space and T.size, for a denser or roomier UI).
--   layout(frame, fn)   fn(frame) now, and again whenever a theme moves the
--                       spacing or sizes (relayout, from Themes.apply):
--                       fn reads the tokens it lays the frame out by
--   onLayout(frame, fn) the same, only not now (a frame its build already
--                       laid out)
-- A protected frame (a secure button, or one a secure frame hangs on) isn't
-- laid out in combat: its turn waits for the end of the fight (once, with
-- the tokens then). Frames are never collected in the game: the list is
-- weak only for the tests' frames.
--------------------------------------------------------------------------------

local layouts: { [Frame]: ((frame: Frame) -> ())[] } = setmetatable({}, { __mode = "k" })

local function layOut(frame: Frame)
    for _, fn in ipairs(layouts[frame] or {}) do
        local ok: boolean, err: unknown = pcall(fn, frame)
        if not ok then
            geterrorhandler()(err)
        end
    end
end

export function onLayout<F extends Frame>(frame: F, fn: (frame: F) -> ())
    local list = layouts[frame]
    if not list then
        list = {}
        layouts[frame] = list
    end
    list[#list + 1] = fn :: (frame: Frame) -> ()
end

export function layout<F extends Frame>(frame: F, fn: (frame: F) -> ())
    onLayout(frame, fn)
    fn(frame)
end

-- Whether a frame keeps a layout (tests).
export function laysOut(frame: Frame): boolean
    return layouts[frame] ~= nil
end

local function relayoutOne(frame: Frame)
    if InCombatLockdown() and frame:IsProtected() then
        combat.run("draw.layout:" .. tostring(frame), function()
            layOut(frame)
        end, "Draw")
        return
    end
    layOut(frame)
end

-- Every kept layout again, outermost frames first (a frame's size may come
-- from what its parent's layout set).
export function relayout()
    local list: { frame: Frame, depth: number }[] = {}
    for frame in pairs(layouts) do
        -- (a parent the game made forbidden can't be asked: as deep as reached)
        local d = 0
        pcall(function()
            local p = frame:GetParent()
            while p do
                d += 1
                p = p:GetParent()
            end
        end)
        list[#list + 1] = { frame = frame, depth = d }
    end
    table.sort(list, function(a: { frame: Frame, depth: number }, b: { frame: Frame, depth: number }): boolean
        return a.depth < b.depth
    end)
    for _, e in ipairs(list) do
        relayoutOne(e.frame)
    end
end

local function crisp(tex: Texture): Texture
    tex:SetSnapToPixelGrid(false)
    tex:SetTexelSnappingBias(0)
    return tex
end

-- A solid texture in a token colour.
export function fill(parent: Frame, color: string, layer: DrawLayer?, sublevel: number?): Texture
    local t = parent:CreateTexture(nil, layer or "BACKGROUND", nil, sublevel)
    paintFill(t, color)
    return t
end

-- A bar's fill drawn as a texture (sized by its owner): the texture token
-- "bar" in a token colour, both kept (a theme's file and colour).
export function barFill(parent: Frame, color: string, layer: DrawLayer?, sublevel: number?): Texture
    local t = parent:CreateTexture(nil, layer or "ARTWORK", nil, sublevel)
    skin(t, "bar")
    paint(t, color)
    return t
end

--------------------------------------------------------------------------------
-- Borders: four textures, `width` physical pixels thick, `inset` pixels in
-- from the frame's edge. Re-laid out when the root rescales.
--------------------------------------------------------------------------------

-- A colour for setColor: a token name (plus an alpha multiplier as `g`),
-- { r, g, b, a }, or r, g, b, a.
export type ColorArg = string | number[] | number

export type BorderOptions = { width?: number, inset?: number, layer?: DrawLayer, sublevel?: number }

-- One physical pixel in a line's frame units, when a line keeps one fixed
-- size rather than its frame's scale (see withPixelUnit).
export type PixelUnit = () -> number

-- The unit lines made now take (nil: their frame's scale).
local scoped: PixelUnit? = nil

-- Every line made inside `body` (borders, hairlines) is laid with `unit` as
-- its one pixel instead of its frame's scale at the time, and keeps it in
-- every relayout. A nameplate's: the game's plates are at a scale of their
-- own (not WorldFrame's), and the debuff icons' lines can't be laid again
-- once the game has made the icon forbidden; made at another scale they
-- came out under one pixel and vanished (a player's report, 0.8.0:
-- "missing most borders").
export function withPixelUnit(unit: PixelUnit?, body: () -> ())
    local prev = scoped
    scoped = unit
    local ok, err = pcall(body)
    scoped = prev
    if not ok then
        error(err, 0)
    end
end

-- The unit lines made now take (to hand on to what's built later, an aura
-- button the engine makes).
export function pixelUnit(): PixelUnit?
    return scoped
end

local borders: { [Border]: boolean } = setmetatable({}, { __mode = "k" })
-- each frame's borders (relayoutPixels walks a frame's own tree down)
local bordersOf: { [Frame]: Border[] } = setmetatable({}, { __mode = "k" })

-- Four textures `width` physical pixels thick, `inset` in from the edge.
export class Border
    readonly top: Texture
    readonly bottom: Texture
    readonly left: Texture
    readonly right: Texture
    readonly parts: Texture[]
    -- its one pixel when fixed (made inside withPixelUnit)
    unit: PixelUnit? = nil

    constructor(
        readonly frame: Frame,
        color: ColorArg,
        opts: BorderOptions = {},
        public width: number = opts.width or 1,
        public inset: number = opts.inset or 0
    )
        local layer: DrawLayer, sub = opts.layer or "BORDER", opts.sublevel
        self.top, self.bottom = crisp(frame:CreateTexture(nil, layer, nil, sub)),
            crisp(frame:CreateTexture(nil, layer, nil, sub))
        self.left, self.right = crisp(frame:CreateTexture(nil, layer, nil, sub)),
            crisp(frame:CreateTexture(nil, layer, nil, sub))
        self.parts = { self.top, self.bottom, self.left, self.right }
        self.unit = scoped
        self:SetColor(color)
        self:Layout()
        borders[self] = true
        local list = bordersOf[frame] or {}
        bordersOf[frame] = list
        list[#list + 1] = self
    end

    function Layout()
        local unit = self.unit
        local px = unit and unit() or pixel.size(self.frame)
        local w, i = px * self.width, px * self.inset
        local top, bottom, left, right = self.top, self.bottom, self.left, self.right
        top:ClearAllPoints()
        top:SetPoint("TOPLEFT", i, -i)
        top:SetPoint("TOPRIGHT", -i, -i)
        top:SetHeight(w)
        bottom:ClearAllPoints()
        bottom:SetPoint("BOTTOMLEFT", i, i)
        bottom:SetPoint("BOTTOMRIGHT", -i, i)
        bottom:SetHeight(w)
        left:ClearAllPoints()
        left:SetPoint("TOPLEFT", i, -i - w)
        left:SetPoint("BOTTOMLEFT", i, i + w)
        left:SetWidth(w)
        right:ClearAllPoints()
        right:SetPoint("TOPRIGHT", -i, -i - w)
        right:SetPoint("BOTTOMRIGHT", -i, i + w)
        right:SetWidth(w)
    end

    -- A token name (plus an optional alpha multiplier), { r, g, b, a }, or r, g, b, a.
    function SetColor(r: ColorArg, g: number?, b: number?, a: number?)
        if type(r) == "string" then
            for _, t in ipairs(self.parts) do
                paintFill(t, r, g)
            end
            return
        end
        local cr, cg, cb, ca = r, g, b, a
        if type(r) == "table" then
            cr, cg, cb, ca = r[1], r[2], r[3], r[4]
        end
        for _, t in ipairs(self.parts) do
            t:SetColorTexture(cr :: number, cg :: number, cb :: number, ca)
        end
    end

    function SetShown(shown: boolean)
        for _, t in ipairs(self.parts) do
            t:SetShown(shown)
        end
    end
end

export function border(frame: Frame, color: ColorArg, opts: BorderOptions?): Border
    return Border.new(frame, color, opts or {})
end

-- The anchor frame's inset-anchor (the player frame, the action bar dock,
-- anchor panels): a dark ring `spread` px wide inside the 1px border, then a
-- faint gilt line. The shadow token gives the widths and the alphas; the
-- colours are surface's and gilt's, kept, so a theme recolours them.
export function anchorRings(frame: Frame): (Border, Border)
    local rings: ShadowLayer[] = T.shadow["inset-anchor"]
    local dark, line = rings[1], rings[2]
    local ring = border(frame, "surface", { width = dark.spread, inset = 1 })
    ring:SetColor("surface", dark.color[4])
    local ring2 = border(frame, "gilt", { width = 1, inset = 1 + dark.spread })
    ring2:SetColor("gilt", line.color[4])
    return ring, ring2
end

--------------------------------------------------------------------------------
-- Hairlines: a 1px horizontal line. fade = "out" (solid, then fading to the
-- right), "both" (fading in from the left and out to the right) or nil (solid).
--------------------------------------------------------------------------------

-- each hairline, with its fixed unit (or true: its frame's scale)
local hairlines: { [Frame]: PixelUnit | boolean } = setmetatable({}, { __mode = "k" })

-- A hairline's height: one pixel.
local function lineSize(line: Frame): number
    local unit = hairlines[line]
    if type(unit) == "function" then
        return unit()
    end
    return pixel.size(line)
end

local function gradient(tex: Texture, color: string, fromAlpha: number, toAlpha: number)
    tex:SetColorTexture(1, 1, 1, 1)
    paintGradient(tex, "HORIZONTAL", color, color, fromAlpha, toAlpha)
end

export function hairline(parent: Frame, color: string, fade: string?): Frame
    local line = CreateFrame("Frame", nil, parent)
    if fade == "both" then
        local left, right = crisp(line:CreateTexture(nil, "ARTWORK")), crisp(line:CreateTexture(nil, "ARTWORK"))
        left:SetPoint("TOPLEFT")
        left:SetPoint("BOTTOMRIGHT", line, "BOTTOM")
        right:SetPoint("TOPLEFT", line, "TOP")
        right:SetPoint("BOTTOMRIGHT")
        gradient(left, color, 0, 1)
        gradient(right, color, 1, 0)
    else
        local t = crisp(line:CreateTexture(nil, "ARTWORK"))
        t:SetAllPoints()
        if fade == "out" then
            gradient(t, color, 1, 0)
        else
            paintFill(t, color)
        end
    end
    hairlines[line] = scoped or true
    line:SetHeight(lineSize(line))
    return line
end

--------------------------------------------------------------------------------
-- The gilt diamond: a square turned 45 degrees (ornaments, the divider jewel,
-- active tabs, class diamonds).
--------------------------------------------------------------------------------

export function diamond(parent: Frame, px: number, color: string?, layer: DrawLayer?, sublevel: number?): Texture
    local t = parent:CreateTexture(nil, layer or "OVERLAY", nil, sublevel or 7)
    t:SetTexture(WHITE)
    paint(t, color or "gilt")
    t:SetSize(px, px)
    t:SetRotation(math.rad(45))
    return t
end

--------------------------------------------------------------------------------
-- Soft edges: the design's box shadows (glow-arcane, glow-ember, glow-ward,
-- shadow-panel), drawn behind `frame` from Soft.tga as a 3x3 slice. The
-- glows take their file from the texture token "glow" (a theme's own).
--------------------------------------------------------------------------------

-- the four corners: their point, the holder's point, the texture's u1, u2, v1, v2
type Slice = { point: FramePoint, rel: FramePoint, u1: number, u2: number, v1: number, v2: number }
local SLICES: Slice[] = {
    { point = "TOPLEFT", rel = "TOPLEFT", u1 = 0, u2 = 0.25, v1 = 0, v2 = 0.25 },
    { point = "TOPRIGHT", rel = "TOPRIGHT", u1 = 0.75, u2 = 1, v1 = 0, v2 = 0.25 },
    { point = "BOTTOMLEFT", rel = "BOTTOMLEFT", u1 = 0, u2 = 0.25, v1 = 0.75, v2 = 1 },
    { point = "BOTTOMRIGHT", rel = "BOTTOMRIGHT", u1 = 0.75, u2 = 1, v1 = 0.75, v2 = 1 },
}

export class SoftEdge
    readonly holder: Frame
    readonly corners: Texture[] = {}
    readonly parts: Texture[] = {}

    -- token: the texture token its file comes from (nil: Soft.tga, fixed)
    constructor(readonly frame: Frame, readonly token: string?)
        local h = CreateFrame("Frame", nil, frame)
        h:SetFrameLevel(math.max(0, frame:GetFrameLevel() - 1))
        self.holder = h
        for i, s in ipairs(SLICES) do
            local t = self:Part(s.u1, s.u2, s.v1, s.v2)
            t:SetPoint(s.point, h, s.rel)
            self.corners[i] = t
        end
        local tl, tr, bl, br = self.corners[1], self.corners[2], self.corners[3], self.corners[4]
        local top = self:Part(0.25, 0.75, 0, 0.25)
        top:SetPoint("TOPLEFT", tl, "TOPRIGHT")
        top:SetPoint("BOTTOMRIGHT", tr, "BOTTOMLEFT")
        local bottom = self:Part(0.25, 0.75, 0.75, 1)
        bottom:SetPoint("TOPLEFT", bl, "TOPRIGHT")
        bottom:SetPoint("BOTTOMRIGHT", br, "BOTTOMLEFT")
        local left = self:Part(0, 0.25, 0.25, 0.75)
        left:SetPoint("TOPLEFT", tl, "BOTTOMLEFT")
        left:SetPoint("BOTTOMRIGHT", bl, "TOPRIGHT")
        local right = self:Part(0.75, 1, 0.25, 0.75)
        right:SetPoint("TOPLEFT", tr, "BOTTOMLEFT")
        right:SetPoint("BOTTOMRIGHT", br, "TOPRIGHT")
        local center = self:Part(0.25, 0.75, 0.25, 0.75)
        center:SetPoint("TOPLEFT", tl, "BOTTOMRIGHT")
        center:SetPoint("BOTTOMRIGHT", br, "TOPLEFT")
        self:SetBlur(8)
        self:SetColor(1, 1, 1, 1)
    end

    private function Part(u1: number, u2: number, v1: number, v2: number): Texture
        local t = self.holder:CreateTexture(nil, "BACKGROUND", nil, -8)
        local token = self.token
        if token then
            local file = textureFile(token)
            t:SetTexture(file)
            edgeToken[self.parts], edgeFile[self.parts] = token, file
        else
            t:SetTexture(SOFT)
        end
        t:SetTexCoord(u1, u2, v1, v2)
        self.parts[#self.parts + 1] = t
        return t
    end

    -- CSS blur radius B has a Gaussian sigma of B/2; Soft.tga's falloff is a
    -- third of its margin, so the margin is drawn 1.5 * B wide.
    function SetBlur(blur: number, x: number?, y: number?)
        local s = math.max(1, blur * 1.5)
        local dx, dy = x or 0, y or 0
        local h, f = self.holder, self.frame
        h:ClearAllPoints()
        h:SetPoint("TOPLEFT", f, "TOPLEFT", -s + dx, s + dy)
        h:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", s + dx, -s + dy)
        for i = 1, 4 do
            self.corners[i]:SetSize(s, s)
        end
    end

    -- A token name (and alpha), a colour table (a shadow layer's, which colour
    -- vision and themes change in place: kept), or r, g, b, a.
    function SetColor(r: ColorArg, g: number?, b: number?, a: number?)
        if type(r) == "string" then
            for _, t in ipairs(self.parts) do
                paint(t, r, g)
            end
            return
        end
        if type(r) == "table" then
            local c = r
            for _, t in ipairs(self.parts) do
                bind(t, function(tex: Texture)
                    tex:SetVertexColor(c[1], c[2], c[3], c[4])
                end)
            end
            return
        end
        for _, t in ipairs(self.parts) do
            t:SetVertexColor(r, g :: number, b :: number, a)
        end
    end

    function SetShown(shown: boolean)
        self.holder:SetShown(shown)
    end
end

-- 0.35: `texture`, a texture token its file comes from (a theme's own)
export function softEdge(frame: Frame, texture: string?): SoftEdge
    if texture then
        textureFile(texture)
    end
    return SoftEdge.new(frame, texture)
end

-- A soft edge from a shadow token's first outer layer, e.g. "glow-arcane".
export function shadow(frame: Frame, token: string): SoftEdge
    local found: ShadowLayer? = nil
    for _, l in ipairs(
        (T.shadow :: { [string]: ShadowLayer[] })[token] or error("SuuUI: unknown shadow token " .. tostring(token), 2)
    ) do
        if not l.inset then
            found = l
            break
        end
    end
    -- (a token with inset layers only: indexing nil errors, as before)
    local layer = found :: ShadowLayer
    -- (the glows from the theme's "glow"; the panels' shadow stays Soft.tga)
    local e = softEdge(frame, token:find("^glow%-") and "glow" or nil)
    e:SetBlur(layer.blur, layer.x, -layer.y)
    e:SetColor(layer.color)
    return e
end

--------------------------------------------------------------------------------
-- The close glyph: two crossed strokes in a square.
--------------------------------------------------------------------------------

export interface Cross extends Frame
    strokes: Texture[]
    function SetColor(name: string)
end

export function cross(parent: Frame, px: number, color: string?): Cross
    local holder = CreateFrame("Frame", nil, parent) :: Cross
    holder:SetSize(px, px)
    holder.strokes = {}
    for i, angle in ipairs({ 45, -45 }) do
        local t = holder:CreateTexture(nil, "OVERLAY")
        t:SetTexture(WHITE)
        t:SetSize(px * 1.15, 1.5)
        t:SetPoint("CENTER")
        t:SetRotation(math.rad(angle))
        holder.strokes[i] = t
    end
    function holder:SetColor(name: string)
        for _, t in ipairs(self.strokes) do
            paint(t, name)
        end
    end
    holder:SetColor(color or "ink-muted")
    return holder
end

--------------------------------------------------------------------------------
-- Keep every pixel-thick line one physical pixel after a rescale.
--------------------------------------------------------------------------------

-- Every pixel-thick line inside `root` (its borders and hairlines, its own
-- and its descendants') laid out again for the scale it shows at now. A
-- frame moved under a parent of another scale keeps the pixel size of where
-- its lines were made otherwise: a nameplate's borders made under UIParent
-- came out under one physical pixel on the game's plates at some UI scales,
-- and vanished at some positions (found in game, 0.6.32).
-- (Down from `root` through its children, never up: climbing each line's
-- parents reached a forbidden frame of the game's, "calling 'GetParent' on
-- bad self", found in game 2026-11-11; a forbidden frame is skipped.
-- The game's aura buttons refuse addon code in a fight while answering
-- IsForbidden false (probed 2026-11-12): a frame whose children can't be
-- read is skipped too, and a line that can't be laid stays as it is.)
local function childrenOf(fr: Frame): Frame[]
    return { fr:GetChildren() }
end

export function relayoutPixels(root: Frame)
    local function visit(fr: Frame)
        if fr:IsForbidden() then
            return
        end
        local ok, kids = pcall(childrenOf, fr)
        if not ok then
            return
        end
        for _, b in ipairs(bordersOf[fr] or {}) do
            pcall(b.Layout, b)
        end
        if hairlines[fr] then
            pcall(fr.SetHeight, fr, lineSize(fr))
        end
        for _, c in ipairs(kids) do
            visit(c)
        end
    end
    visit(root)
end

events.on(
    "SUUUI_ROOT_SCALED",
    function()
        -- (a line with a unit of its own doesn't follow UIParent; one inside a
        -- frame the game made forbidden after (an aura button) can't be
        -- touched any more: left as it is)
        for b in pairs(borders) do
            if not b.unit then
                pcall(b.Layout, b)
            end
        end
        for line, unit in pairs(hairlines) do
            if unit == true then
                pcall(line.SetHeight, line, pixel.size(line))
            end
        end
    end,
    "Draw"
)
