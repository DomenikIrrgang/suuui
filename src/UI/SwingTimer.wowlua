-- UI/SwingTimer.wowlua
-- Your auto-attack: when the next swing or shot lands, drawn from Forever's
-- own swing timer (PLAYER_SWING; the combat log is closed to addons).
--
--   local t = swingTimer(parent, { width = 340 })
--   t:Activate(); t:Deactivate()
--
-- One row per weapon in use: main hand (swing, 8px), off hand (swing-oh, 5px)
-- under it, space-2 apart; while you shoot, the ranged row takes the main
-- hand's place. The fill is the player cast bar's (a ghost gradient with an
-- ink edge) and runs from a duration object, so the engine animates it. The
-- seconds hang off the bar's right end, with the queued on-next-swing spell
-- (Heroic Strike, Cleave, Maul, Raptor Strike) before them. A landed swing
-- flashes an ink sliver at the bar's end. An idle row rests at opacity-oor
-- with "–". If the client hides a swing's length, that swing isn't drawn:
-- never a number SuuUI can't read.
--
-- Auto Shot (the ranged row): the last half second of a shot is a cast you
-- must stand still for, drawn as a hatched window at the bar's end. Moving
-- inside it turns the edge, the window and the digits amber ("Moving"), and
-- the shot waits until you stop. Whether Forever's client has that cast is
-- learned: if shots keep firing on time while you run through the window,
-- the window goes away (t:SetAutoShotWindow(on), opts.onNoAutoShotCast).
--   t:SetAutoShotWindow(on)
--   t:SetBarWidth(px)    -- 0.9: live (it follows your cast bar's width)

import isSecret from "wowlua:secret"
import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as motion from "/Core/Motion"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"

const S = T.space

const WHITE = "Interface\\Buttons\\WHITE8X8"
const SWING = Enum.PlayerSwingType
const DIR = Enum.StatusBarTimerDirection
const IMMEDIATE = Enum.StatusBarInterpolation and Enum.StatusBarInterpolation.Immediate -- wowlua: coverage ignore (a client without the enum)

-- On-next-swing attacks by class.
local NEXT_SWING: { [string]: number[] } = {
    WARRIOR = { 78, 284, 285, 1608, 11564, 11565, 11566, 11567, 845, 7369, 11608, 11609 }, -- Heroic Strike, Cleave
    DRUID = { 6807, 6808, 6809, 8972, 9745, 9880, 9881 }, -- Maul
    HUNTER = { 2973, 14260, 14261, 14262, 14263, 14264, 14265, 14266 }, -- Raptor Strike
}

const DIGITS_W = 40
const QUEUE = 16
const HATCH = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Hatch.tga"
const CAST = 0.5 -- Auto Shot's stand-still cast, seconds
const GRACE = 0.35 -- a shot this late still counts as on time

-- The queued on-next-swing attack's icon.
export class SwingQueued extends Frame
    readonly art: Texture

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(QUEUE, QUEUE)
        self.art = self:CreateTexture(nil, "ARTWORK")
        self.art:SetPoint("TOPLEFT", 1, -1)
        self.art:SetPoint("BOTTOMRIGHT", -1, 1)
        self.art:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        draw.border(self, "ink")
        self:Hide()
    end
end

-- The timer swingTimer makes.

--------------------------------------------------------------------------------
-- Rows
--------------------------------------------------------------------------------

-- The stand-still window at the end of the ranged bar: a hatch with a 1px
-- left edge, ink at rest, amber while you move inside it.
-- The ranged row's stand-still window.
export class SwingWindow extends Frame
    hatch: Texture
    edge: Texture

    constructor(r: SwingRow)
        super(nil, r)
        self:SetPoint("TOPRIGHT", -1, -1)
        self:SetPoint("BOTTOMRIGHT", -1, 1)
        self:SetFrameLevel(r.bar:GetFrameLevel() + 1)
        self.hatch = self:CreateTexture(nil, "ARTWORK")
        self.hatch:SetAllPoints()
        self.hatch:SetTexture(HATCH, "REPEAT", "REPEAT")
        self.hatch:SetHorizTile(true)
        self.hatch:SetVertTile(true)
        self.edge = self:CreateTexture(nil, "OVERLAY")
        self.edge:SetPoint("TOPLEFT")
        self.edge:SetPoint("BOTTOMLEFT")
        self.edge:SetWidth(1)
        self:Hide()
        r.window = self
    end
end

local function buildWindow(r: SwingRow): SwingWindow
    return SwingWindow.new(r)
end

-- One row: a weapon's swing.
export class SwingRow extends Frame
    bar: StatusBar
    spark: Texture
    border: draw.Border
    flash: Texture
    digits: Text
    duration: LuaDurationObject
    window?: SwingWindow
    canSwing?: boolean
    live?: boolean
    endsAt?: number
    length?: number
    flashAt?: number
    delayed?: boolean

    constructor(t: SwingTimer, height: number)
        super(nil, t)
        self:SetSize(t.barW, height)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        local inner = CreateFrame("Frame", nil, self)
        inner:SetPoint("TOPLEFT", 1, -1)
        inner:SetPoint("BOTTOMRIGHT", -1, 1)
        inner:SetClipsChildren(true)
        local bar = CreateFrame("StatusBar", nil, inner)
        bar:SetAllPoints()
        bar:SetStatusBarTexture(WHITE)
        local tex = bar:GetStatusBarTexture()
        tex:SetSnapToPixelGrid(false)
        draw.paintGradient(tex, "HORIZONTAL", "ghost", "ghost", 0)
        bar:SetMinMaxValues(0, 1)
        bar:SetValue(0)
        self.spark = bar:CreateTexture(nil, "OVERLAY")
        draw.paintFill(self.spark, "ink")
        self.spark:SetPoint("TOPRIGHT", tex, "TOPRIGHT")
        self.spark:SetPoint("BOTTOMRIGHT", tex, "BOTTOMRIGHT")
        self.spark:SetWidth(2)
        self.bar = bar
        self.border = draw.border(self, "gilt-hairline", { layer = "OVERLAY" })
        -- the landed flash: an ink sliver at the end that fades over dur-fast
        self.flash = self:CreateTexture(nil, "OVERLAY", nil, 2)
        draw.paintFill(self.flash, "ink")
        self.flash:SetPoint("TOPRIGHT")
        self.flash:SetPoint("BOTTOMRIGHT")
        self.flash:SetWidth(3)
        self.flash:SetAlpha(0)
        self.digits = text(t, "micro", "ink")
        self.digits:SetShadowed(true)
        -- the digits hang directly off the bar's end; the main hand's move past
        -- the queued spell's icon while one waits (ST:UpdateQueued)
        self.digits:SetJustifyH("LEFT")
        self.digits:SetWidth(DIGITS_W)
        self.digits:SetPoint("LEFT", self, "RIGHT", S["space-2"], 0)
        self.duration = C_DurationUtil.CreateDuration()
        self:SetAlpha(T.opacity["opacity-oor"])
        self.digits:SetValue("–")
    end
end

local function buildRow(t: SwingTimer, height: number): SwingRow
    return SwingRow.new(t, height)
end

--------------------------------------------------------------------------------
-- Drawing
--------------------------------------------------------------------------------

-- Whether a slot has a weapon that swings; nil when the client won't say.
-- Only the off hand can lack one (the ranged row shows while you shoot).
local function canSwing(kind: PlayerSwingType): boolean?
    if kind ~= SWING.OffHand then
        return true
    end
    local _, oh = UnitAttackSpeed("player")
    if isSecret(oh) then
        return nil
    end
    return type(oh) == "number" and oh > 0
end

--------------------------------------------------------------------------------
-- Events
--------------------------------------------------------------------------------

-- The frame's name, the bars' width (px or a size token), whether the
-- Auto Shot window shows, and what to call when Auto Shot proves to fire
-- while moving.
export type SwingTimerOptions = {
    name?: string,
    width?: number | string,
    autoShotWindow?: boolean,
    onNoAutoShotCast?: () -> (),
}

export class SwingTimer extends Frame
    barW: number
    mainHand: SwingRow
    offHand: SwingRow
    ranged: SwingRow
    rows: { [PlayerSwingType]: SwingRow }
    window: SwingWindow
    autoShotWindow: boolean
    onNoAutoShotCast: (() -> ())? = nil
    queued: SwingQueued
    onTimeWhileMoving: number? = nil
    active: boolean? = nil
    nextSwing: number[]? = nil
    moving: boolean? = nil
    movingSince: number? = nil
    stoppedAt: number? = nil
    shooting: boolean? = nil

    constructor(parent: Frame, options: SwingTimerOptions?)
        local opts = options or {}
        super(opts.name, parent)
        self.barW = draw.size(opts.width or 340)
        local mh, oh, gap = draw.size("swing"), draw.size("swing-oh"), S["space-2"]
        self:SetSize(self.barW, mh + gap + oh)
        self.mainHand, self.offHand, self.ranged = buildRow(self, mh), buildRow(self, oh), buildRow(self, mh)
        self.rows = { [SWING.MainHand] = self.mainHand, [SWING.OffHand] = self.offHand, [SWING.Ranged] = self.ranged }
        self.window = buildWindow(self.ranged)
        self.autoShotWindow = opts.autoShotWindow ~= false
        self.onNoAutoShotCast = opts.onNoAutoShotCast
        self.mainHand:SetPoint("TOPLEFT")
        self.ranged:SetPoint("TOPLEFT")
        self.offHand:SetPoint("TOPLEFT", 0, -(mh + gap))

        -- the queued attack, hanging off the main hand's right end
        self.queued = SwingQueued.new(self)
        self.queued:SetPoint("LEFT", self.mainHand, "RIGHT", S["space-2"], 0)

        self:SetScript("OnUpdate", function()
            self:Tick()
        end)
    end

    function UpdateRows()
        for kind, r in pairs(self.rows) do
            local can = canSwing(kind)
            if can ~= nil then
                r.canSwing = can
            end
        end
        local shooting = self.ranged.live
        self.mainHand:SetShown(not shooting)
        self.ranged:SetShown(shooting and true or false)
        self.offHand:SetShown(self.offHand.canSwing and not shooting and true or false)
        self.mainHand.digits:SetShown(not shooting)
        self.ranged.digits:SetShown(shooting and true or false)
        self.offHand.digits:SetShown(self.offHand:IsShown())
    end

    -- Delayed (moving inside the window) or at rest: colours of the ranged row.
    function SetDelayed(r: SwingRow, delayed: boolean)
        if r.delayed == delayed then
            return
        end
        r.delayed = delayed
        local token = delayed and "amber" or "ink-muted"
        local w = r.window :: SwingWindow -- (only the ranged row is ever delayed)
        draw.paint(w.hatch, token, delayed and 0.6 or 0.2)
        draw.paintFill(w.edge, token)
        r.border:SetColor(delayed and "amber" or "gilt-hairline")
        draw.paintFill(r.spark, delayed and "amber" or "ink")
        r.digits:SetColor(delayed and "amber" or "ink")
    end

    function SetBarWidth(w: number)
        self.barW = draw.size(w)
        self:SetWidth(self.barW)
        for kind, r in pairs(self.rows) do
            r:SetWidth(self.barW)
            -- a shot in flight keeps its window's share of the new width
            local length = r.length
            if kind == SWING.Ranged and self.window:IsShown() and r.endsAt and length then
                self.window:SetWidth(math.max(2, (self.barW - 2) * math.min(1, CAST / length)))
            end
        end
    end

    function SetAutoShotWindow(on: unknown)
        self.autoShotWindow = on ~= nil and on ~= false
        if not self.autoShotWindow then
            self.window:Hide()
            self:SetDelayed(self.ranged, false)
        end
    end

    -- A shot just landed: did it come on time although you ran through the whole
    -- window? Twice in a row means this client has no stand-still cast.
    function LearnAutoShot(r: SwingRow, now: number)
        if not (self.autoShotWindow and r.live and r.endsAt) then
            return
        end
        local ranThrough = self.movingSince and self.movingSince <= r.endsAt - CAST
        if not ranThrough then
            return
        end
        if now <= r.endsAt + GRACE then
            self.onTimeWhileMoving = (self.onTimeWhileMoving or 0) + 1
            if self.onTimeWhileMoving >= 2 then
                self:SetAutoShotWindow(false)
                if self.onNoAutoShotCast then
                    self.onNoAutoShotCast()
                end
            end
        else
            self.onTimeWhileMoving = 0 -- the shot waited: the cast is real
        end
    end

    function Swing(length: number | Secret<number>, kind: PlayerSwingType | Secret<PlayerSwingType>)
        if isSecret(length) or isSecret(kind) then
            return
        end
        local r = self.rows[kind]
        if not r or type(length) ~= "number" or length <= 0 then
            return
        end
        local now = GetTime()
        if kind == SWING.Ranged then
            self:LearnAutoShot(r, now)
            if self.autoShotWindow then
                self.window:SetWidth(math.max(2, (self.barW - 2) * math.min(1, CAST / length)))
                self.window:Show()
            end
            self:SetDelayed(r, false)
        end
        if r.live then
            -- the previous swing landed: the ink sliver flashes at the end
            r.flash:SetAlpha(1)
            r.flashAt = now
        end
        r.live, r.endsAt, r.length = true, now + length, length
        r:SetAlpha(1)
        r.duration:SetTimeFromStart(now, length)
        r.bar:SetTimerDuration(r.duration, IMMEDIATE, DIR.ElapsedTime)
        -- Forever links the timers: a melee swing restarts Auto Shot too.
        self:UpdateRows()
        self:UpdateQueued()
    end

    function Tick()
        local now = GetTime()
        for kind, r in pairs(self.rows) do
            if r.live and kind == SWING.Ranged and self.autoShotWindow and self.shooting then
                -- Auto Shot: moving inside the window holds the shot.
                local endsAt = r.endsAt :: number -- (a live row has its end)
                local left = endsAt - now
                local delayed = (self.moving and left <= CAST) and true or false
                self:SetDelayed(r, delayed)
                if delayed then
                    r.digits:SetValue("Moving")
                elseif left > 0 then
                    r.digits:SetValue(("%.1f"):format(left))
                elseif not self.moving and now - math.max(endsAt, (self.stoppedAt or 0) + CAST) > GRACE then
                    -- standing still past the cast and still no shot: Auto Shot ended
                    r.live = false
                    self.window:Hide()
                    r:SetAlpha(T.opacity["opacity-oor"])
                    r.digits:SetValue("–")
                    r.bar:SetValue(0)
                    self:UpdateRows()
                end
            elseif r.live then
                local left = (r.endsAt :: number) - now
                if left <= 0 then
                    r.live = false
                    local w = r.window
                    if w then
                        w:Hide()
                        self:SetDelayed(r, false)
                    end
                    r:SetAlpha(T.opacity["opacity-oor"])
                    r.digits:SetValue("–")
                    r.bar:SetValue(0)
                    self:UpdateRows()
                else
                    r.digits:SetValue(("%.1f"):format(left))
                end
            end
            if r.flashAt then
                local a = 1 - (now - r.flashAt) / T.duration["dur-fast"]
                if a <= 0 then
                    r.flashAt = nil
                    a = 0
                end
                r.flash:SetAlpha(a)
            end
        end
    end

    function UpdateQueued()
        local ids = self.nextSwing
        local found
        if ids and C_Spell.IsCurrentSpell then
            for _, id in ipairs(ids) do
                local on = C_Spell.IsCurrentSpell(id)
                if not isSecret(on) and on then
                    found = id
                    break
                end
            end
        end
        if found then
            self.queued.art:SetTexture((C_Spell.GetSpellTexture(found)))
            if not self.queued:IsShown() then
                motion.pop(self.queued)
            end
        end
        self.queued:SetShown(found ~= nil)
        local digits = self.mainHand.digits
        digits:ClearAllPoints()
        digits:SetPoint("LEFT", self.mainHand, "RIGHT", S["space-2"] + (found and (QUEUE + S["space-2"]) or 0), 0)
    end

    function Activate()
        if self.active then
            return
        end
        self.active = true
        local _, class = UnitClass("player")
        self.nextSwing = nil
        if not issecretvalue(class) and class then
            self.nextSwing = NEXT_SWING[class]
        end
        events.onGame(
            "PLAYER_SWING",
            function(_, length, kind)
                self:Swing(length, kind)
            end,
            self
        )
        events.onGame(
            "WEAPON_SLOT_CHANGED",
            function()
                self:UpdateRows()
            end,
            self
        )
        -- Auto Shot: whether you shoot, and whether you move.
        events.onGame(
            "START_AUTOREPEAT_SPELL",
            function()
                self.shooting = true
            end,
            self
        )
        events.onGame(
            "STOP_AUTOREPEAT_SPELL",
            function()
                self.shooting = false
            end,
            self
        )
        events.onGame(
            "PLAYER_STARTED_MOVING",
            function()
                self.moving = true
                self.movingSince = GetTime()
            end,
            self
        )
        events.onGame(
            "PLAYER_STOPPED_MOVING",
            function()
                self.moving, self.movingSince, self.stoppedAt = false, nil, GetTime()
            end,
            self
        )
        events.onGame(
            "PLAYER_ENTERING_WORLD",
            function()
                self:UpdateRows()
            end,
            self
        )
        events.onUnit(
            "UNIT_ATTACK_SPEED",
            "player",
            function()
                self:UpdateRows()
            end,
            self
        )
        if self.nextSwing then
            events.onGame(
                "ACTIONBAR_UPDATE_STATE",
                function()
                    self:UpdateQueued()
                end,
                self
            )
        end
        self:UpdateRows()
    end

    function Deactivate()
        if not self.active then
            return
        end
        self.active = false
        events.offAll(self)
    end
end

export function swingTimer(parent: Frame, options: SwingTimerOptions?): SwingTimer
    return SwingTimer.new(parent, options)
end
