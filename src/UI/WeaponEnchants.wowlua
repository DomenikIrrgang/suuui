-- UI/WeaponEnchants.wowlua
-- Temporary weapon enchants: a shaman's imbues, a rogue's poisons, stones and
-- oils. They aren't auras, and unlike auras they stay readable in combat
-- (/suu probe weaponenchants: C_Item.GetWeaponEnchantInfo is secret.readable), so SuuUI
-- reads them itself and draws them as its own icons, with the buffs' look.
--
--   weaponEnchant(slot)           -- 0.17: "main" | "off" | "ranged": the
--                                 -- enchant on that weapon, or nil:
--                                 -- { slot, icon, expires (GetTime), duration
--                                 -- (s: what it had when first seen), charges,
--                                 -- name, weapon, spellID }
--   weaponEnchantable(slot)    -- 0.17: whether a weapon is in that slot
--                                 -- (a shield or a totem isn't one)
--   weaponEnchantSpell(slot)   -- 0.17: the spell seen putting the last
--                                 -- enchant on that weapon (this session), or nil
--   weaponEnchantIcon(parent, size)   -- 0.17: an icon for one weapon:
--       icon:SetSlot(slot)
--       icon:SetMissing(mode)     -- with no enchant: nil (nothing drawn),
--                                 -- "grey", or "warn" (the ember edge, pulsing)
--       icon:SetTag(shown)        -- MH / OH / R on the top-left corner
--       icon:Refresh()            -- -> true while the weapon has an enchant
--       icon:SetPreview(texture)  -- a made-up enchant (edit mode); nil ends it
-- SUUUI_WEAPON_ENCHANTS_CHANGED: one came, went, or changed (charges, weapon).
--
-- An enchant's name is the spell cast just before it appeared (the imbue or
-- poison: the cast comes a moment before the change), else the weapon
-- tooltip's line ("Rockbiter 2 (60 min)" reads "Rockbiter"). Removing one is
-- forbidden to addons, so a click does nothing and the tooltip says so.
-- Probed 2026-10-20: C_Spell.CancelItemTempEnchantment is refused; the secure
-- "cancelaura" action with "target-slot" breaks (CANCELABLE_ITEMS is nil on
-- Forever); an aura container's AddItemEnchantment button never fills, as
-- C_PaperDollInfo.GetTemporaryEnchantmentInfo reads nothing for an imbue.
-- The game's buff frame cancels from its own trusted code.

import * as secret from "wowlua:secret"
import after, every from "wowlua:timer"
import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as fonts from "/Core/Fonts"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import type Text from "/UI/Text"
import * as tooltip from "/UI/Tooltip"

-- wowlua:secret's secret.isSecret as a local predicate: an imported one doesn't
-- narrow in wowlua 0.9.1 while the project has an import cycle (port notes)
local WHITE = "Interface\\Buttons\\WHITE8X8"
local CROP = 0.08
local AMBER = 60 -- seconds: the digits turn amber and blink below this

type Slot = { ws: number, inv: number, tag: string, label: string }
local SLOTS: { [string]: Slot } = {
    main = { ws = 0, inv = 16, tag = "MH", label = "Main hand" },
    off = { ws = 1, inv = 17, tag = "OH", label = "Off hand" },
    ranged = { ws = 2, inv = 18, tag = "R", label = "Ranged" },
}
local ORDER: string[] = { "main", "off", "ranged" }

--------------------------------------------------------------------------------
-- Reading
--------------------------------------------------------------------------------

export type Info = {
    slot: string,
    enchantID: number,
    weaponID: number?,
    icon: string | number,
    expires: number,
    duration: number,
    charges: number,
    name: string?,
    weapon: string?,
    spellID: number?,
}

local state: { [string]: Info | false } = {} -- slot -> info, or false
type Seen = { id: number, duration: number }
local seen: { [string]: Seen } = {} -- slot -> { id, duration } of the enchant on it
local spellFor: { [string]: number } = {} -- slot -> the spell that put its enchant on
local tipNames: { [string]: string | false } = {} -- "slot:enchantID" -> the tooltip's name
local lastArt: { [string]: string | number } = {} -- slot -> the art of the enchant it had last (grey while missing)
local weapons: { [string]: number? } = {} -- slot -> the item in it, at the last look
local lastCast: { id: number, at: number }? -- { id, at }: the player's last successful cast

-- Where the game's functions are read from: the game's (a table, so tests
-- can stand in for one).
type Game = {
    C_Item?: {
        GetWeaponEnchantInfo?: typeof(C_Item.GetWeaponEnchantInfo),
        GetItemInfoInstant: typeof(C_Item.GetItemInfoInstant),
    },
    C_TooltipInfo?: { GetInventoryItem?: typeof(C_TooltipInfo.GetInventoryItem) },
    C_Spell: { GetSpellName: typeof(C_Spell.GetSpellName) },
    GetInventoryItemID: typeof(GetInventoryItemID),
    GetInventoryItemLink: typeof(GetInventoryItemLink),
    GetInventoryItemTexture: typeof(GetInventoryItemTexture),
}
local G = setmetatable({}, {
    __index = function(_: unknown, k: string): unknown
        return _G[k]
    end,
}) :: Game

-- The temporary enchant in a weapon slot's list: the entry with time left
-- (a permanent enchant has none).
local function read(ws: number): WeaponEnchantInfo?
    local items = G.C_Item
    local get = items and items.GetWeaponEnchantInfo
    if not get then
        return nil
    end
    local ok, list = pcall(get, ws)
    if not ok or secret.isSecret(list) or type(list) ~= "table" then
        return nil
    end
    for _, e in pairs(list) do
        if type(e) == "table" and not secret.isSecret(e) and secret.readable(e.hasEnchant) and e.hasEnchant and
            secret.readable(e.timeLeft) and
            e.timeLeft > 0 then
            return e
        end
    end
end

-- "Rockbiter 2 (60 min)" -> "Rockbiter": the weapon tooltip's timed line.
local function tooltipName(inv: number): string?
    local tips = G.C_TooltipInfo
    local get = tips and tips.GetInventoryItem
    if not get then
        return nil
    end
    local ok, data = pcall(get, "player", inv)
    if not ok or secret.isSecret(data) or type(data) ~= "table" or type(data.lines) ~= "table" then
        return nil
    end
    for _, l in ipairs(data.lines) do
        local text = l.leftText
        if secret.readable(text) and type(text) == "string" and text:find("%(%d+ [%a ]+%)") then
            local name = text:gsub("%s*%(.*%)%s*$", ""):gsub("%s+%d+$", "")
            if name ~= "" then
                return name
            end
        end
    end
end

local function itemName(inv: number): string?
    local link = G.GetInventoryItemLink("player", inv)
    return secret.readable(link) and link and link:match("%[(.-)%]") or nil
end

export function weaponEnchantable(slot: string): boolean
    local s = SLOTS[slot]
    if not s then
        return false
    end
    if state[slot] then
        return true
    end
    local id = G.GetInventoryItemID("player", s.inv)
    if not secret.readable(id) or not id then
        return false
    end
    local items = G.C_Item
    if not items then
        return false
    end
    local classID = select(6, items.GetItemInfoInstant(id))
    return classID == (Enum.ItemClass and Enum.ItemClass.Weapon or 2)
end

export function weaponEnchant(slot: string): Info?
    return state[slot] or nil
end
export function weaponEnchantSpell(slot: string): number?
    return spellFor[slot]
end

local ticker: TickerHandle?
local scan: () -> ()

-- Forgets everything seen (tests: each starts from a session's beginning).
local function reset()
    wipe(state)
    wipe(seen)
    wipe(spellFor)
    wipe(tipNames)
    wipe(lastArt)
    wipe(weapons)
    lastCast = nil
    if ticker then
        ticker:Cancel()
        ticker = nil
    end
end

-- Every weapon again; a change (an enchant on or off, another enchant, its
-- charges, another weapon) is announced once.
scan = function()
    local now, changed, any = GetTime(), false, false
    for _, slot in ipairs(ORDER) do
        local s = SLOTS[slot] :: Slot
        local e = read(s.ws)
        local old = state[slot]
        local weapon = G.GetInventoryItemID("player", s.inv)
        weapon = secret.readable(weapon) and weapon or nil
        if e then
            any = true
            local id = secret.readable(e.enchantID) and e.enchantID or 0
            local left = e.timeLeft / 1000
            local prev = seen[slot]
            -- new: none before, another enchant, or put on again (more time
            -- than expected)
            local fresh = not old or not prev or prev.id ~= id or left > old.expires - now + 2
            if fresh then
                seen[slot] = { id = id, duration = left }
                if lastCast and now - lastCast.at < 1.5 then
                    spellFor[slot] = lastCast.id
                    lastCast = nil
                end
            end
            local key = slot .. ":" .. id
            if tipNames[key] == nil then
                tipNames[key] = tooltipName(s.inv) or false
            end
            local spell = spellFor[slot]
            local spellName = spell and G.C_Spell.GetSpellName(spell)
            local info = {
                slot = slot,
                enchantID = id,
                weaponID = weapon,
                icon = secret.readable(e.enchantIconID) and e.enchantIconID ~= 0 and e.enchantIconID or
                    G.GetInventoryItemTexture("player", s.inv),
                expires = now + left,
                duration = math.max((seen[slot] :: Seen).duration, left),
                charges = secret.readable(e.charges) and e.charges or 0,
                name = (secret.readable(spellName) and spellName) or tipNames[key] or nil,
                weapon = itemName(s.inv),
                spellID = spell,
            }
            if not old or old.enchantID ~= id or old.charges ~= info.charges or fresh then
                changed = true
            end
            state[slot] = info
            lastArt[slot] = info.icon
        else
            if old then
                changed = true
            end
            state[slot] = false
        end
        if weapons[slot] ~= weapon then
            changed = true
        end
        weapons[slot] = weapon
    end
    -- while one is up, a look each second (its charges, the end)
    if any and not ticker then
        ticker = every(1, function()
            scan()
        end)
    elseif not any and ticker then
        ticker:Cancel()
        ticker = nil
    end
    if changed then
        events.emit("SUUUI_WEAPON_ENCHANTS_CHANGED")
    end
end

local function later()
    after(0, scan)
end
local gameEvents: EventName[] = { "WEAPON_ENCHANT_CHANGED", "PLAYER_EQUIPMENT_CHANGED", "PLAYER_ENTERING_WORLD" }
for _, e in ipairs(gameEvents) do
    events.onGame(e, later, "WeaponEnchants")
end
events.onUnit("UNIT_INVENTORY_CHANGED", "player", later, "WeaponEnchants")
events.onUnit(
    "UNIT_SPELLCAST_SUCCEEDED",
    "player",
    function(_, _, _, spellID)
        if secret.readable(spellID) and spellID then
            lastCast = { id = spellID, at = GetTime() }
        end
    end,
    "WeaponEnchants"
)

--------------------------------------------------------------------------------
-- The icon: the buff icon's look (well, art, hairline, digits over a dark
-- fade, charges in the stack corner, the draining bar), and a weapon tag.
--------------------------------------------------------------------------------

-- 42, 1:30, 5m, 1h: the buff digits' format
local function digits(left: number): string
    if left < 60 then
        return ("%d"):format(math.ceil(left))
    end
    if left < 600 then
        local s = math.ceil(left)
        return ("%d:%02d"):format(math.floor(s / 60), s % 60)
    end
    if left < 3600 then
        return ("%dm"):format(math.floor(left / 60))
    end
    return ("%dh"):format(math.floor(left / 3600))
end

-- 52 min, 1 h 5 min, 40 sec: the tooltip's
local function longTime(left: number): string
    if left >= 3600 then
        return ("%d h %d min"):format(math.floor(left / 3600), math.floor(left % 3600 / 60))
    end
    if left >= 60 then
        return ("%d min"):format(math.floor(left / 60))
    end
    return ("%d sec"):format(math.ceil(left))
end

local function setWarn(self: WeaponEnchantIcon, on: boolean)
    self.warnEdge:SetShown(on)
    if on and not self.warnPulse:IsPlaying() then
        self.warnPulse:Play()
    elseif not on and self.warnPulse:IsPlaying() then
        self.warnPulse:Stop()
    end
end

local function showTip(self: WeaponEnchantIcon)
    local slot = self.slot
    local s = SLOTS[slot]
    if not s or self.preview then
        return
    end
    local info = state[slot]
    local weapon = itemName(s.inv)
    local sub = weapon and (s.label .. " · " .. weapon) or s.label
    if info then
        local lines = { { "Time left", longTime(math.max(0, info.expires - GetTime())) } }
        if info.charges > 0 then
            lines[#lines + 1] = { "Charges", tostring(info.charges) }
        end
        tooltip.showTooltip(self, {
            title = info.name or (s.label .. " enchant"),
            subtitle = sub,
            lines = lines,
            meta = "Can't be removed from SuuUI: the game only lets you replace it.",
        })
    else
        local spell = spellFor[slot]
        local spellName = spell and G.C_Spell.GetSpellName(spell)
        spellName = secret.readable(spellName) and spellName or nil
        tooltip.showTooltip(self, {
            title = spellName or (s.label .. " enchant"),
            subtitle = sub,
            lines = { { "Not on the weapon" } },
            meta = spellName and ("Cast " .. spellName .. " to put it back.") or nil,
        })
    end
end

-- The weapon's tag on an icon's corner (M, O, R).
class SlotTag extends Frame
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        draw.fill(self, "surface", "BACKGROUND"):SetAllPoints()
        draw.border(self, "gilt-line")
        self.text = uiText.text(self, "micro", "gilt-text")
        self.text:SetPoint("CENTER", 0, 0)
        self:SetSize(16, 11)
    end
end

export class WeaponEnchantIcon extends Frame
    size: number
    body: Frame
    art: Texture
    warnEdge: draw.Border
    warnPulse: AnimationGroup
    drain: StatusBar
    text: Frame
    scrim: Texture
    duration: FontString
    stacks: FontString
    blink: AnimationGroup
    tag: SlotTag
    showTag: boolean
    slot: string? = nil
    info: Info? = nil
    amber: boolean? = nil
    preview: boolean? = nil
    -- seconds since the last tick
    acc: number = 0
    -- what shows while it's missing (Cooldown Manager's setting)
    missing: string? = nil

    constructor(parent: Frame, given: number | string | nil)
        local size = draw.size(given or "icon-lg")
        super(nil, parent)
        self:SetSize(size, size)
        self.size = size
        -- the icon itself (body), so a missing one can fade without its tag
        local body = CreateFrame("Frame", nil, self)
        body:SetAllPoints()
        self.body = body
        draw.fill(body, "surface-sunk", "BACKGROUND"):SetAllPoints()
        self.art = body:CreateTexture(nil, "ARTWORK")
        self.art:SetPoint("TOPLEFT", 1, -1)
        self.art:SetPoint("BOTTOMRIGHT", -1, 1)
        self.art:SetTexCoord(CROP, 1 - CROP, CROP, 1 - CROP)
        local over = CreateFrame("Frame", nil, body)
        over:SetAllPoints()
        over:SetFrameLevel(body:GetFrameLevel() + 2)
        draw.border(over, "gilt-hairline")
        -- Warn: an ember edge inside the square that pulses slowly (the
        -- Cooldown Manager's missing aura)
        self.warnEdge = draw.border(over, "ember", { inset = 1, layer = "OVERLAY" })
        self.warnEdge:SetShown(false)
        self.warnPulse = body:CreateAnimationGroup()
        self.warnPulse:SetLooping("BOUNCE")
        local p = self.warnPulse:CreateAnimation("Alpha")
        p:SetFromAlpha(1)
        p:SetToAlpha(0.45)
        p:SetDuration(0.9)

        -- the duration bar inside the bottom edge, as on a buff
        local barH = size >= 30 and 3 or 2
        self.drain = CreateFrame("StatusBar", nil, body)
        self.drain:SetPoint("BOTTOMLEFT", 1, 1)
        self.drain:SetPoint("BOTTOMRIGHT", -1, 1)
        self.drain:SetHeight(barH)
        self.drain:SetStatusBarTexture(WHITE)
        self.drain:SetMinMaxValues(0, 1)
        draw.paint(self.drain, "ink")
        self.drain:SetFrameLevel(body:GetFrameLevel() + 6)

        self.text = CreateFrame("Frame", nil, body)
        self.text:SetAllPoints()
        self.text:SetFrameLevel(body:GetFrameLevel() + 5)
        local scrim = self.text:CreateTexture(nil, "BACKGROUND")
        scrim:SetPoint("BOTTOMLEFT", 1, 1)
        scrim:SetPoint("BOTTOMRIGHT", -1, 1)
        scrim:SetHeight(math.floor(size * 0.6))
        scrim:SetColorTexture(1, 1, 1, 1)
        scrim:SetGradient("VERTICAL", CreateColor(0, 0, 0, 0.8), CreateColor(0, 0, 0, 0))
        self.scrim = scrim
        self.duration = self.text:CreateFontString(nil, "OVERLAY")
        fonts.apply(self.duration, size >= 30 and "numeric" or "micro")
        self.duration:SetPoint("BOTTOM", 0, 1 + barH + (size >= 30 and 1 or 0))
        self.stacks = self.text:CreateFontString(nil, "OVERLAY")
        fonts.apply(self.stacks, "micro")
        self.stacks:SetPoint("TOPRIGHT", -2, -1)
        for _, fs in ipairs({ self.duration, self.stacks }) do
            fs:SetShadowColor(0, 0, 0, 1)
            fs:SetShadowOffset(0, -1)
            local path, height = fs:GetFont()
            if path then
                fs:SetFont(path, height, "OUTLINE")
            end
        end
        draw.paint(self.duration, "ink")
        draw.paint(self.stacks, "ink")
        -- under a minute the digits blink
        self.blink = self.text:CreateAnimationGroup()
        self.blink:SetLooping("BOUNCE")
        local b = self.blink:CreateAnimation("Alpha")
        b:SetFromAlpha(1)
        b:SetToAlpha(0.35)
        b:SetDuration(0.5)

        -- the weapon's tag on the top-left corner, over the edge
        local tag = SlotTag.new(self)
        tag:SetFrameLevel(body:GetFrameLevel() + 8)
        tag:SetPoint("TOPLEFT", self, "TOPLEFT", -2, 3)
        self.tag = tag
        self.showTag = true

        -- a tooltip, no clicks: removing an enchant is forbidden
        if not pcall(self.SetMouseMotionEnabled, self, true) then
            self:EnableMouse(true)
        end
        pcall(self.SetMouseClickEnabled, self, false)
        self:SetScript("OnEnter", showTip)
        self:SetScript("OnLeave", function()
            tooltip.hideTooltip()
        end)
    end

    function SetSlot(slot: string)
        self.slot = slot
        local s = SLOTS[slot]
        local text = s and s.tag or ""
        self.tag.text:SetValue(text)
        self.tag:SetSize(math.ceil(uiText.measureText("micro", text)) + 6, 11)
    end

    function SetMissing(mode: string?)
        self.missing = mode
    end

    function SetTag(shown: unknown)
        self.showTag = shown ~= nil and shown ~= false
        self.tag:SetShown(self.showTag and self.body:IsShown())
    end

    -- Another size: the bar, the fade and the digits follow (numeric digits from
    -- 30 px, as on a buff).
    function Resize(given: number | string)
        local size = draw.size(given)
        if size == self.size then
            return
        end
        self.size = size
        self:SetSize(size, size)
        local barH = size >= 30 and 3 or 2
        self.drain:SetHeight(barH)
        self.scrim:SetHeight(math.floor(size * 0.6))
        fonts.apply(self.duration, size >= 30 and "numeric" or "micro")
        local path, height = self.duration:GetFont()
        if path then
            self.duration:SetFont(path, height, "OUTLINE")
        end
        self.duration:ClearAllPoints()
        self.duration:SetPoint("BOTTOM", 0, 1 + barH + (size >= 30 and 1 or 0))
    end

    -- The digits, the bar and the amber blink, from the time left.
    function Tick()
        local info = self.info
        if not info then
            return
        end
        local left = info.expires - GetTime()
        if left <= 0 then
            -- ended: look again (the game's event may come a moment later)
            self.info = nil
            scan()
            return
        end
        self.duration:SetText(digits(left))
        local amber = left < AMBER
        if amber ~= self.amber then
            self.amber = amber
            draw.paint(self.duration, amber and "amber" or "ink")
            if amber then
                self.blink:Play()
            else
                self.blink:Stop()
                self.text:SetAlpha(1)
            end
        end
        self.drain:SetValue(info.duration > 0 and math.min(1, left / info.duration) or 0)
    end

    -- Whether the slot shows an enchant (or a preview).
    function Refresh(): boolean
        if self.preview then
            return true
        end
        local info = self.slot and state[self.slot] or nil
        self.info = info
        if info then
            self.art:SetTexture(info.icon)
            self.art:SetDesaturated(false)
            self.art:SetVertexColor(1, 1, 1)
            self.body:SetAlpha(1)
            self.text:Show()
            self.drain:Show()
            self.stacks:SetText(info.charges > 0 and tostring(info.charges) or "")
            setWarn(self, false)
            self.amber = nil
            self:Tick()
            self:SetScript("OnUpdate", function(_: Frame, elapsed: number)
                self.acc = self.acc + elapsed
                if self.acc >= 0.1 then
                    self.acc = 0
                    self:Tick()
                end
            end)
            self.body:Show()
            self.tag:SetShown(self.showTag)
            return true
        end
        self:SetScript("OnUpdate", nil)
        self.blink:Stop()
        self.text:Hide()
        self.drain:Hide()
        if self.missing then
            -- the enchant it had (this session), else the weapon, in grey
            local s = SLOTS[self.slot]
            self.art:SetTexture(lastArt[self.slot] or (s and G.GetInventoryItemTexture("player", s.inv)) or 134400)
            self.art:SetDesaturated(true)
            self.body:SetAlpha(self.missing == "warn" and 0.85 or T.opacity["opacity-oor"])
            setWarn(self, self.missing == "warn")
            self.body:Show()
        else
            setWarn(self, false)
            self.body:Hide()
        end
        self.tag:SetShown(self.showTag and self.body:IsShown())
        return false
    end

    -- A made-up enchant for edit mode's preview: its art, 52m, three-quarters
    -- left. Nil goes back to the real one.
    function SetPreview(texture: string | number | nil): boolean
        self.preview = texture ~= nil or nil
        if not texture then
            return self:Refresh()
        end
        self:SetScript("OnUpdate", nil)
        self.info = nil
        self.art:SetTexture(texture)
        self.art:SetDesaturated(false)
        self.art:SetVertexColor(1, 1, 1)
        self.body:SetAlpha(1)
        self.body:Show()
        self.text:Show()
        self.text:SetAlpha(1)
        self.blink:Stop()
        self.duration:SetText("52m")
        draw.paint(self.duration, "ink")
        self.amber = nil
        self.stacks:SetText("")
        self.drain:Show()
        self.drain:SetValue(0.87)
        setWarn(self, false)
        self.tag:SetShown(self.showTag)
        return true
    end
end

export function weaponEnchantIcon(parent: Frame, size: number | string | nil): WeaponEnchantIcon
    return WeaponEnchantIcon.new(parent, size)
end

scan()
