-- UI/GroupFinderListed.wowlua
-- The Group Finder's My listing page (design component GroupFinder,
-- "My listing"; GroupAdComposer): while you're listed, the second tab shows
-- your listing and an ad for chat side by side.
--   Your listing: a sunk card: "Listed", how long and how long it has left,
--   the category and activities, your roles (icons and words), play style,
--   details, voice chat; Delist and Update (primary: the game's panel).
--   Advertise in chat: the channel (180 wide), the ad in a sunk field you
--   can edit, From my listing (writes it again) and the count ("92 / 255";
--   over the limit the edge is ember and Post is off), "Last posted 6m ago"
--   and Post to <channel> (primary). Posting is always your click.
--
--   local p = groupFinderListed(parent)  (SuuUI.UI.GroupFinderListed)
--   p:SetData({
--       listing = { listedFor = "12m", left = "18m", category = "Dungeons",
--                   activities = { "Shadowfang Keep", ... }, roles = { "healer", "tank" },
--                   playstyle = "Relaxed", comment = "…", voice = "None" },
--       ad = { text = "…", channel = "LookingForGroup", channels = { { value, label } },
--              lastPost = "6m" | nil, max = 255 },
--   })
--   p.onDelist(), p.onUpdate(), p.onChannel(value), p.onText(text),
--   p.onRewrite(), p.onPost(channel, text)

import tokens as T from "/Core/Tokens"
import * as fonts from "/Core/Fonts"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as controls from "/UI/Controls"
import * as uiSelect from "/UI/Select"
import Text from "/UI/Text"
import SuuButton from "/UI/Controls"
import Select, SelectOption from "/UI/Select"

export type ListedFacts = {
    listedFor?: string,
    left?: string,
    category?: string,
    activities?: string[],
    roles?: string[],
    playstyle?: string,
    comment?: string,
    voice?: string,
}

export type ListedAd = {
    text?: string,
    channel?: string,
    channels?: SelectOption<string>[],
    lastPost?: string,
    max?: number,
}

export type ListedData = { listing?: ListedFacts, ad?: ListedAd }

-- One fact: its term and its text.
export type ListedFact = { dt: Text, dd: Text }

-- a role in your listing: a small framed glyph
export class ListedRoleIcon extends Frame
    readonly glyph: Texture

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(18, 18)
        draw.fill(self, "surface-raised"):SetAllPoints()
        draw.border(self, "gilt-line")
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetSize(12, 12)
        self.glyph:SetPoint("CENTER")
        draw.paint(self.glyph, "ink")
        self:Hide()
    end
end

export interface ListedCard extends Frame
    dot: Texture
    title: Text
    time: Text
    facts: ListedFact[]
    roleIcons: ListedRoleIcon[]
    rule: Texture
    update: SuuButton
    delist: SuuButton
end

export interface AdCard extends Frame
    glyph: Texture
    title: Text
    intro: Text
    channelLabel: Text
    channel: Select<string>
    field: Frame
    fieldEdge: draw.Border
    edit: EditBox
    rewrite: SuuButton
    count: Text
    rule: Texture
    last: Text
    post: SuuButton
end

local S = T.space

local TEX = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local GLYPHS = TEX .. "Glyphs\\"
local ROLE_TEX: { [string]: string } = {
    tank = TEX .. "RoleTank.tga",
    healer = TEX .. "RoleHealer.tga",
    damage = TEX .. "RoleDamage.tga",
}
local ROLE_WORD: { [string]: string } = { tank = "Tank", healer = "Healer", damage = "Damage" }

local PAD = S["space-5"]
local GAP = S["space-4"]
local DT_W = 96
local BTN_H = 26
local FIELD_LINES = 5
local LINE_H = 18

-- the live pages, placed and drawn again when the theme changes
local pages: { [GroupFinderListed]: boolean } = setmetatable({}, { __mode = "k" })

-- A sunk card: surface-sunk in a gilt-faint edge.
local function card(parent: Frame): Frame
    local c = CreateFrame("Frame", nil, parent)
    draw.fill(c, "surface-sunk"):SetAllPoints()
    draw.border(c, "gilt-faint")
    return c
end

local function rule(parent: Frame): Texture
    local t = draw.fill(parent, "gilt-faint", "ARTWORK")
    t:SetHeight(1)
    return t
end

-- One fact: the term at the left (96), its text beside it.
local function fact(c: Frame): ListedFact
    local f: ListedFact = { dt = uiText.text(c, "caption", "ink-muted"), dd = uiText.text(c, "body", "ink") }
    f.dt:SetJustifyH("LEFT")
    f.dd:SetJustifyH("LEFT")
    f.dd:SetWordWrap(true)
    return f
end

export class GroupFinderListed extends Frame
    listing: ListedCard
    ad: AdCard
    data: ListedData? = nil
    listingH: number = 0
    adH: number? = nil
    onDelist: (() -> ())? = nil
    onUpdate: (() -> ())? = nil
    onChannel: ((value: string) -> ())? = nil
    onText: ((text: string) -> ())? = nil
    onRewrite: (() -> ())? = nil
    onPost: ((channel: string?, text: string) -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)

        -- your listing
        local c = card(self) :: ListedCard
        c:SetPoint("TOPLEFT")
        c:SetPoint("RIGHT", self, "CENTER", -S["space-6"] / 2, 0)
        c.dot = draw.diamond(c, 6, "arcane")
        c.title = uiText.text(c, "header", "gilt-text")
        c.title:SetValue("Listed")
        c.time = uiText.text(c, "caption", "ink-muted")
        c.facts = {}
        for i = 1, 5 do
            c.facts[i] = fact(c)
        end
        c.roleIcons = {}
        for i = 1, 3 do
            c.roleIcons[i] = ListedRoleIcon.new(c)
        end
        c.rule = rule(c)
        c.update = controls.button(c, {
            text = "Update",
            variant = "primary",
            icon = "scroll",
            tooltip = { title = "Update", description = "Change your listing in the game’s panel" },
            onClick = function()
                if self.onUpdate then
                    self.onUpdate()
                end
            end,
        })
        c.update:SetHeight(BTN_H)
        c.delist = controls.button(c, {
            text = "Delist",
            icon = "close",
            tooltip = { title = "Delist", description = "Take your listing down" },
            onClick = function()
                if self.onDelist then
                    self.onDelist()
                end
            end,
        })
        c.delist:SetHeight(BTN_H)
        self.listing = c

        -- the ad
        local a = card(self) :: AdCard
        a:SetPoint("TOPRIGHT")
        a:SetPoint("LEFT", self, "CENTER", S["space-6"] / 2, 0)
        a.glyph = a:CreateTexture(nil, "ARTWORK")
        a.glyph:SetTexture(GLYPHS .. "chat.tga")
        a.glyph:SetSize(14, 14)
        draw.paint(a.glyph, "gilt-text")
        a.title = uiText.text(a, "header", "gilt-text")
        a.title:SetPoint("LEFT", a.glyph, "RIGHT", S["space-3"], 0)
        a.title:SetValue("Advertise in chat")
        a.intro = uiText.text(a, "caption", "ink-muted")
        a.intro:SetPoint("RIGHT", a, "RIGHT", -PAD, 0)
        a.intro:SetJustifyH("LEFT")
        a.intro:SetWordWrap(true)
        a.intro:SetValue("Your listing as one chat line. Edit it if you like; it goes only when you click Post.")
        a.channelLabel = uiText.text(a, "caption", "ink-muted")
        a.channelLabel:SetValue("Channel")
        a.channel = uiSelect.select(a, {
            width = 180,
            onChange = function(v: string)
                if self.onChannel then
                    self.onChannel(v)
                end
            end,
        })
        a.field = CreateFrame("Frame", nil, a)
        a.field:SetPoint("RIGHT", a, "RIGHT", -PAD, 0)
        a.field:SetHeight(FIELD_LINES * LINE_H + S["space-3"] * 2)
        draw.fill(a.field, "surface-sunk"):SetAllPoints()
        a.fieldEdge = draw.border(a.field, "gilt-line")
        local e = CreateFrame("EditBox", nil, a.field)
        e:SetMultiLine(true)
        e:SetAutoFocus(false)
        -- room past the 255 a post may have (the count turns ember there);
        -- 0 cut every text to nothing (found in game)
        e:SetMaxLetters(1000)
        e:SetFontObject(fonts.get("body"))
        draw.paint(e, "ink")
        e:SetPoint("TOPLEFT", S["space-4"], -S["space-3"])
        e:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-3"])
        e:SetScript("OnEscapePressed", function(obj)
            obj:ClearFocus()
        end)
        e:SetScript("OnEditFocusGained", function()
            self:Count()
        end)
        e:SetScript("OnEditFocusLost", function()
            self:Count()
        end)
        e:SetScript("OnTextChanged", function(obj, user)
            self:Count()
            if user and self.onText then
                self.onText(obj:GetText())
            end
        end)
        a.field:EnableMouse(true)
        a.field:SetScript("OnMouseDown", function()
            e:SetFocus()
        end)
        a.edit = e
        a.rewrite = controls.button(a, {
            text = "From my listing",
            icon = "reset",
            tooltip = { title = "From my listing", description = "Write it again from your listing" },
            onClick = function()
                if self.onRewrite then
                    self.onRewrite()
                end
            end,
        })
        a.rewrite:SetHeight(22)
        a.count = uiText.text(a, "caption", "ink-faint")
        -- the foot, at the card's foot
        a.rule = rule(a)
        a.rule:SetPoint("BOTTOMLEFT", a, "BOTTOMLEFT", PAD, PAD + BTN_H + GAP)
        a.rule:SetPoint("BOTTOMRIGHT", a, "BOTTOMRIGHT", -PAD, PAD + BTN_H + GAP)
        a.last = uiText.text(a, "caption", "ink-muted")
        a.last:SetPoint("LEFT", a, "BOTTOMLEFT", PAD, PAD + BTN_H / 2)
        a.post = controls.button(a, {
            text = "Post",
            variant = "primary",
            icon = "chat",
            onClick = function()
                local d = self.data and self.data.ad
                if self.onPost and d then
                    self.onPost(d.channel, e:GetText())
                end
            end,
        })
        a.post:SetHeight(BTN_H)
        a.post:SetPoint("BOTTOMRIGHT", a, "BOTTOMRIGHT", -PAD, PAD)
        self.ad = a
        self:Place()
        self:HookScript("OnSizeChanged", function()
            if self.data then
                self:SetData(self.data)
            end
        end)
        pages[self] = true
    end

    function SetData(d: ListedData)
        self.data = d
        local L: ListedFacts = d.listing or {}
        local c = self.listing
        c.time:SetValue("for " .. (L.listedFor or "a moment") .. (L.left and (" · runs out in " .. L.left) or ""))
        local width = c:GetWidth() - PAD * 2 - DT_W - GAP
        local y = PAD + T.type.header.lineHeight + GAP
        -- each fact: its term, its text (none: left out), shown always
        local rows: { term: string, text?: string, always?: boolean }[] = {
            { term = L.category or "Activities", text = table.concat(L.activities or {}, " · ") },
            { term = "Your roles", text = "", always = true },
            { term = "Playstyle", text = L.playstyle },
            { term = "Details", text = L.comment ~= "" and L.comment or nil },
            { term = "Voice Chat", text = L.voice },
        }
        for i, r in ipairs(rows) do
            local f = c.facts[i]
            local show = r.always or (r.text and r.text ~= "")
            f.dt:SetShown(show and true or false)
            f.dd:SetShown(show and true or false)
            if show then
                f.dt:SetValue(r.term)
                f.dt:ClearAllPoints()
                f.dt:SetPoint("TOPLEFT", c, "TOPLEFT", PAD, -y - 2)
                f.dd:ClearAllPoints()
                f.dd:SetPoint("TOPLEFT", c, "TOPLEFT", PAD + DT_W + GAP, -y)
                f.dd:SetWidth(math.max(40, width))
                local h
                if r.always then
                    -- the roles: icons, then their words
                    local x = PAD + DT_W + GAP
                    for k in ipairs({ "tank", "healer", "damage" }) do
                        c.roleIcons[k]:Hide()
                    end
                    local words = {}
                    for k, role in ipairs(L.roles or {}) do
                        local ic = c.roleIcons[k]
                        ic.glyph:SetTexture(ROLE_TEX[role])
                        ic:ClearAllPoints()
                        ic:SetPoint("TOPLEFT", c, "TOPLEFT", x, -y)
                        ic:Show()
                        x = x + 18 + S["space-2"]
                        words[#words + 1] = ROLE_WORD[role]
                    end
                    f.dd:ClearAllPoints()
                    f.dd:SetPoint("TOPLEFT", c, "TOPLEFT", x + S["space-2"], -y)
                    f.dd:SetValue(#words > 0 and table.concat(words, ", ") or "None chosen")
                    h = 18
                else
                    f.dd:SetValue(r.text)
                    h = math.max(T.type.body.lineHeight, math.ceil(f.dd:GetStringHeight()))
                end
                y = y + h + GAP
            end
        end
        -- the buttons under a rule, at the foot; both cards as tall as the
        -- taller one (asked for in game), their feet level
        self.listingH = y + GAP + BTN_H + PAD
        c.rule:ClearAllPoints()
        c.rule:SetPoint("BOTTOMLEFT", c, "BOTTOMLEFT", PAD, PAD + BTN_H + GAP)
        c.rule:SetPoint("BOTTOMRIGHT", c, "BOTTOMRIGHT", -PAD, PAD + BTN_H + GAP)
        c.update:ClearAllPoints()
        c.update:SetPoint("BOTTOMRIGHT", c, "BOTTOMRIGHT", -PAD, PAD)
        c.delist:ClearAllPoints()
        c.delist:SetPoint("RIGHT", c.update, "LEFT", -S["space-3"], 0)
        local h = math.max(self.listingH, self.adH or 0)
        c:SetHeight(h)
        self.ad:SetHeight(h)

        -- the ad
        local A: ListedAd = d.ad or {}
        local a = self.ad
        a.channel:SetOptions(A.channels or {})
        a.channel:SetValue(A.channel)
        if not a.edit:HasFocus() and a.edit:GetText() ~= (A.text or "") then
            a.edit:SetText(A.text or "")
            a.edit:SetCursorPosition(0)
        end
        a.post:SetLabel("Post to " .. (A.channel or "chat"))
        a.last:SetValue(A.lastPost and ("Last posted " .. A.lastPost .. " ago") or "Not posted yet")
        self:Count()
    end

    -- The count, and what being over the limit turns off.
    function Count()
        local a = self.ad
        local max = (self.data and self.data.ad and self.data.ad.max) or 255
        local text = a.edit:GetText() or ""
        local n = strlenutf8 and strlenutf8(text) or #text
        local over = n > max
        a.count:SetValue(n .. " / " .. max)
        a.count:SetColor(over and "ember-text" or "ink-faint")
        a.fieldEdge:SetColor(over and "ember" or (a.edit:HasFocus() and "arcane" or "gilt-line"))
        a.post:SetEnabledState(not over and text:match("%S") ~= nil)
    end

    -- Where the parts by the titles and in the ad sit: from the text styles'
    -- line heights, which a theme can change.
    function Place()
        local c, a = self.listing, self.ad
        local mid = -(PAD + T.type.header.lineHeight / 2)
        c.dot:SetPoint("CENTER", c, "TOPLEFT", PAD + 3, mid)
        c.title:SetPoint("LEFT", c, "TOPLEFT", PAD + 6 + S["space-3"], mid)
        c.time:SetPoint("RIGHT", c, "TOPRIGHT", -PAD, mid)
        a.glyph:SetPoint("CENTER", a, "TOPLEFT", PAD + 7, mid)
        local y = PAD + T.type.header.lineHeight + GAP
        a.intro:SetPoint("TOPLEFT", a, "TOPLEFT", PAD, -y)
        y = y + T.type.caption.lineHeight * 2 + GAP
        a.channelLabel:SetPoint("LEFT", a, "TOPLEFT", PAD, -(y + 15))
        a.channel:SetPoint("TOPLEFT", a, "TOPLEFT", PAD + 56, -y)
        y = y + 30 + GAP
        -- the ad's field: several lines
        a.field:SetPoint("TOPLEFT", a, "TOPLEFT", PAD, -y)
        y = y + a.field:GetHeight() + S["space-2"]
        a.rewrite:SetPoint("TOPLEFT", a, "TOPLEFT", PAD, -y)
        a.count:SetPoint("RIGHT", a, "TOPRIGHT", -PAD, -(y + 11))
        y = y + 22 + GAP + GAP
        self.adH = y + BTN_H + PAD
        a:SetHeight(self.adH)
    end
end

export function groupFinderListed(parent: Frame): GroupFinderListed
    return GroupFinderListed.new(parent)
end

events.on(
    "SUUUI_THEME_CHANGED",
    function()
        for p in pairs(pages) do
            p:Place()
            if p.data then
                p:SetData(p.data)
            end
        end
    end,
    "GroupFinderListed"
)
