-- UI/Layout.wowlua
-- Stacks and grids. A layout positions the children of one container and can
-- size the container to fit them. Changes only mark a layout dirty; all dirty
-- layouts are applied once, on the next frame, deepest container first, so a
-- build that adds fifty rows lays out once.
--
--   local stack = layout.stack(container, {
--       direction = "vertical",      -- or "horizontal"
--       gap = 4, padding = 12,       -- px; padding is a number or { left, right, top, bottom }
--       align = "start",             -- cross axis: start, center, end, stretch
--       autoSize = true,             -- true, "width", "height" or false
--   })
--   stack:Add(child[, { gapBefore = 8 }]); stack:Remove(child); stack:Invalidate()
--
--   local grid = layout.grid(container, { columns = 4, cellWidth = 36, cellHeight = 36, gap = 4, padding = 0 })
--
-- A child reports a changed size by itself: frames through OnSizeChanged and
-- OnShow/OnHide, SuuUI texts through SetValue and SetVisible. A container
-- holding protected frames is laid out after combat.

import isSecret from "wowlua:secret"
import isInstance from "wowlua:reflect"
import * as combat from "/Core/Combat"
import Text from "./Text"

export type Padding = { left: number, right: number, top: number, bottom: number }

-- the cross axis: where a child sits across the stack
export type Align = "start" | "center" | "end" | "stretch"
-- what the container takes its size from
export type AutoSize = boolean | "width" | "height"

export type LayoutOptions = {
    direction?: "vertical" | "horizontal",
    gap?: number,
    -- a number, { left, right, top, bottom } or { left = , right = , top = , bottom = }
    padding?: number | { [number]: number } | { left?: number, right?: number, top?: number, bottom?: number },
    align?: Align,
    autoSize?: AutoSize,
    -- grids
    columns?: number,
    cellWidth?: number,
    cellHeight?: number,
}

export type AddOptions = { gapBefore?: number }

-- Where a layout put a child: the layout, the options it was added with, and
-- the size it was laid out at.
export type Placement = { layout: Layout, opts?: AddOptions, w?: number, h?: number }

-- A child with a size of its own (a list measured by its rows).
export interface Sized
    function GetLayoutSize(): (number, number)
end

local placements: { [Region]: Placement } = setmetatable({}, { __mode = "k" })
local hooked: { [Region]: boolean } = setmetatable({}, { __mode = "k" })

-- Where a layout put this child, if one did.
export function placementOf(child: Region): Placement?
    return placements[child]
end

-- Whether the child's frame scripts are hooked by a layout (once per child).
export function isHooked(child: Region): boolean
    return hooked[child] == true
end

local pending: { [Layout]: boolean } = {}
local flusher = CreateFrame("Frame")
flusher:Hide()

local function depth(frame: Region): number
    local d: number, p: Frame? = 0, frame:GetParent()
    while p do
        d = d + 1
        p = p:GetParent()
    end
    return d
end

local function padding(
    p: number | { [number]: number } | { left?: number, right?: number, top?: number, bottom?: number } | nil
): Padding
    if type(p) == "table" then
        local list = p :: { [number]: number }
        local named = p :: { left?: number, right?: number, top?: number, bottom?: number }
        return {
            left = list[1] or named.left or 0,
            right = list[2] or named.right or 0,
            top = list[3] or named.top or 0,
            bottom = list[4] or named.bottom or 0,
        }
    end
    local n = p or 0
    return { left = n, right = n, top = n, bottom = n }
end

local function number(v: uiUnit | Secret<number> | nil, fallback: number?): number
    if isSecret(v) or v == nil then
        return fallback or 0
    end
    return v
end

local function sized(child: Region): Sized?
    local fn = (child :: { [string]: unknown }).GetLayoutSize
    return type(fn) == "function" and (child :: Region & Sized) or nil
end

-- A child's size: its own GetLayoutSize, a text's natural size, or its frame size.
local function measure(child: Region): (number, number)
    local own = sized(child)
    if own then
        return own:GetLayoutSize()
    end
    if child:GetObjectType() == "FontString" then
        local fs = child :: FontString
        local w = isInstance(child, Text) and child.fixedWidth or number(fs:GetUnboundedStringWidth())
        return w, number(fs:GetStringHeight())
    end
    return number(child:GetWidth()), number(child:GetHeight())
end

local function onChildChanged(child: Region, w: number?, h: number?)
    local placed = placements[child]
    local l = placed and placed.layout
    if not placed or not l or l.applying then
        return
    end
    if w ~= nil then
        -- Ignore the echo of a size this layout itself caused.
        if isSecret(w) or isSecret(h) then
            return
        end
        local lw, lh = placed.w, placed.h
        if l.stretches then
            if l.direction == "vertical" and lh == h then
                return
            end
            if l.direction == "horizontal" and lw == w then
                return
            end
        elseif lw == w and lh == h then
            return
        end
    end
    l:Invalidate()
end

--------------------------------------------------------------------------------
-- Shared behaviour
--------------------------------------------------------------------------------

-- A stack or a grid. Children are frames or regions; a child may carry
-- GetLayoutSize() for a size of its own; a SuuUI text gets `layout` set.
export abstract class Layout
    readonly children: Region[] = {}
    readonly gap: number
    readonly padding: Padding
    readonly autoSize: AutoSize
    readonly depth: number
    applying?: boolean
    -- stacks
    direction?: "vertical" | "horizontal"
    align?: Align
    stretches?: boolean
    -- grids
    columns?: number
    cellWidth?: number
    cellHeight?: number

    constructor(readonly container: Region, opts: LayoutOptions)
        self.gap = opts.gap or 0
        self.padding = padding(opts.padding)
        local a = opts.autoSize
        if a == nil then
            a = true
        end
        self.autoSize = a
        self.depth = depth(container)
    end

    abstract function Arrange(): (number, number)

    function Invalidate()
        pending[self] = true
        flusher:Show()
    end

    function Add<C extends Region>(child: C, opts: AddOptions?): C
        placements[child] = { layout = self, opts = opts }
        if isInstance(child, Text) then
            child.layout = self
        end
        self.children[#self.children + 1] = child
        -- Texts and textures have HookScript too, but no size scripts: only frames are hooked.
        if child:IsObjectType("Frame") and not hooked[child] then
            hooked[child] = true
            local region: Region = child
            local f = region :: Frame
            f:HookScript("OnSizeChanged", function(c: Frame, w: number, h: number)
                onChildChanged(c, w, h)
            end)
            f:HookScript("OnShow", function(c: Frame)
                onChildChanged(c)
            end)
            f:HookScript("OnHide", function(c: Frame)
                onChildChanged(c)
            end)
        end
        self:Invalidate()
        return child
    end

    private function Release(child: Region)
        placements[child] = nil
        if isInstance(child, Text) then
            child.layout = nil
        end
    end

    function Remove(child: Region)
        for i, c in ipairs(self.children) do
            if c == child then
                table.remove(self.children, i)
                self:Release(child)
                self:Invalidate()
                return
            end
        end
    end

    function Clear()
        for _, c in ipairs(self.children) do
            self:Release(c)
        end
        wipe(self.children)
        self:Invalidate()
    end

    function ApplyNow()
        local c = self.container
        if InCombatLockdown() and c:IsProtected() then
            combat.run(
                "layout:" .. tostring(self),
                function()
                    self:ApplyNow()
                end,
                "Layout"
            )
            return
        end
        self.applying = true
        local w, h = self:Arrange()
        self.applying = false
        local a = self.autoSize
        local changed = false
        if (a == true or a == "width") and number(c:GetWidth()) ~= w then
            c:SetWidth(w)
            changed = true
        end
        if (a == true or a == "height") and number(c:GetHeight()) ~= h then
            c:SetHeight(h)
            changed = true
        end
        -- A container that changed size tells the layout it sits in.
        local outer = placements[c]
        if changed and outer then
            outer.layout:Invalidate()
        end
    end

    -- the size it was laid out at, kept to ignore its echo
    protected function Placed(child: Region, w: number, h: number)
        local placed = placements[child]
        if placed then
            placed.w, placed.h = w, h
        end
    end
end

flusher:SetScript("OnUpdate", function(self)
    self:Hide()
    -- A container that grows dirties the layout it sits in; settle in a few passes.
    for _ = 1, 8 do
        if not next(pending) then
            return
        end
        local list: Layout[] = {}
        for l in pairs(pending) do
            list[#list + 1] = l
        end
        pending = {}
        table.sort(list, function(a: Layout, b: Layout): boolean
            return a.depth > b.depth
        end)
        for _, l in ipairs(list) do
            l:ApplyNow()
        end
    end
end)

--------------------------------------------------------------------------------
-- Stack
--------------------------------------------------------------------------------

export class Stack extends Layout
    constructor(container: Region, opts: LayoutOptions)
        super(container, opts)
        self.direction = opts.direction or "vertical"
        self.align = opts.align or "start"
        self.stretches = self.align == "stretch"
    end

    override function Arrange(): (number, number)
        local c, p, vertical = self.container, self.padding, self.direction == "vertical"
        local items: { child: Region, w: number, h: number }[], cross = {}, 0
        for _, child in ipairs(self.children) do
            if child:IsShown() then
                local w, h = measure(child)
                items[#items + 1] = { child = child, w = w, h = h }
                cross = math.max(cross, vertical and w or h)
            end
        end
        -- With a fixed cross size, align against it rather than the widest child.
        local a = self.autoSize
        if vertical and not (a == true or a == "width") then
            cross = number(c:GetWidth()) - p.left - p.right
        elseif not vertical and not (a == true or a == "height") then
            cross = number(c:GetHeight()) - p.top - p.bottom
        end

        local pos = 0
        for i, it in ipairs(items) do
            local child, w, h = it.child, it.w, it.h
            if i > 1 then
                local placed = placements[child]
                local o = placed and placed.opts
                pos = pos + (o and o.gapBefore or self.gap)
            end
            local size = vertical and w or h
            local offset = 0
            if self.align == "center" then
                offset = (cross - size) / 2
            elseif self.align == "end" then
                offset = cross - size
            end
            child:ClearAllPoints()
            if vertical then
                child:SetPoint("TOPLEFT", c, "TOPLEFT", p.left + offset, -(p.top + pos))
                if self.align == "stretch" then
                    child:SetPoint("TOPRIGHT", c, "TOPRIGHT", -p.right, -(p.top + pos))
                end
                pos = pos + h
            else
                child:SetPoint("TOPLEFT", c, "TOPLEFT", p.left + pos, -(p.top + offset))
                if self.align == "stretch" then
                    child:SetPoint("BOTTOMLEFT", c, "BOTTOMLEFT", p.left + pos, p.bottom)
                end
                pos = pos + w
            end
            self:Placed(child, w, h)
        end

        if vertical then
            return cross + p.left + p.right, pos + p.top + p.bottom
        end
        return pos + p.left + p.right, cross + p.top + p.bottom
    end
end

export function stack(container: Region, opts: LayoutOptions?): Stack
    return Stack.new(container, opts or {})
end

--------------------------------------------------------------------------------
-- Grid: fixed cells filled row by row.
--------------------------------------------------------------------------------

export class Grid extends Layout
    constructor(container: Region, opts: LayoutOptions)
        super(container, opts)
        local cw = opts.cellWidth or 32
        self.columns = opts.columns or 1
        self.cellWidth = cw
        self.cellHeight = opts.cellHeight or cw
    end

    override function Arrange(): (number, number)
        local c, p = self.container, self.padding
        local cw, ch, cols = self.cellWidth or 32, self.cellHeight or 32, self.columns or 1
        local n = 0
        for _, child in ipairs(self.children) do
            if child:IsShown() then
                local col, row = n % cols, math.floor(n / cols)
                child:ClearAllPoints()
                child:SetPoint(
                    "TOPLEFT",
                    c,
                    "TOPLEFT",
                    p.left + col * (cw + self.gap),
                    -(p.top + row * (ch + self.gap))
                )
                local w, h = measure(child)
                self:Placed(child, w, h)
                n = n + 1
            end
        end
        local usedCols = math.min(n, cols)
        local rows = math.ceil(n / cols)
        local w = usedCols * cw + math.max(0, usedCols - 1) * self.gap
        local h = rows * ch + math.max(0, rows - 1) * self.gap
        return w + p.left + p.right, h + p.top + p.bottom
    end
end

export function grid(container: Region, opts: LayoutOptions?): Grid
    return Grid.new(container, opts or {})
end
