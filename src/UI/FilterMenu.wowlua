-- UI/FilterMenu.wowlua
-- A grouped filter menu (design component FilterMenu, board "Professions ·
-- Filters"): a field like Select's, the filter glyph, "Filters", a chevron;
-- "Filters · 3" (the glyph in arcane) while choices other than the defaults
-- are on. It opens a panel of groups under it (surface, gilt-line edge,
-- 292 px, space-5 padding, the groups space-4 apart, each labelled in
-- caption ink-muted):
--   one      a single choice, a Segmented row ("Show: All · Learned ·
--            Unlearned"): for filters that exclude each other
--   many     chips, several at once, none chosen = no filter; a chip carries
--            its colour as a 6 px diamond; chosen: arcane edge on arcane-soft
--   toggles  independent checkboxes ("Have materials")
-- and a foot over a gilt-faint rule: "3 filters on" (or "Defaults") and
-- Reset. Choices apply at once; a click outside or Esc closes the panel.
-- 0.14: a group with `column = true` starts a new column (space-6 apart,
-- each at least 180 px; the foot spans them), `style = "button"` makes the
-- field a quiet button (the filter glyph, the placeholder, an ink diamond
-- after it while the filters differ from their defaults; the world map's
-- "Map filters"), and `done = true` adds Done to the foot.
--
--   local menu = filterMenu(parent, {
--       groups = { { key, label, kind = "one" | "many" | "toggles",
--                    options = { { value, label, color = token } } } },
--       defaults = { show = "learned", difficulty = {}, other = {} },
--       value = { ... }, placeholder = "Filters", width = 122,
--       onChange = fn(value),   -- value by group key: one → a value,
--   })                          -- many and toggles → a list of values
--   menu:SetValue(value), menu:GetValue(), menu:Count(), menu:Close()
--   menu:SetGroups(groups)   -- 0.17: other groups (built again when it next opens)

import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import button, SuuButton from "/UI/Controls"
import checkbox, segmented, Checkbox, Segmented from "/UI/Inputs"

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local PANEL_W = 292
local COLUMN_W = 180
local CHIP_H = 24

-- What a filter chooses between.
export type FilterValue = string | number | boolean
-- A group's choice: one value ("one"), or the values on ("many", "toggles").
export type FilterChoice = FilterValue | FilterValue[]
-- The choices by group key.
export type FilterValues = { [string]: FilterChoice }
export type FilterOption = { value: FilterValue, label: string, color?: string }
export type FilterGroup = {
    key: string,
    label: string,
    kind: "one" | "many" | "toggles",
    options: FilterOption[],
    -- starts the next column
    column?: boolean,
}
export type FilterMenuOptions = {
    groups?: FilterGroup[],
    defaults?: FilterValues,
    value?: FilterValues,
    placeholder?: string,
    width?: number,
    height?: number,
    -- "button": a quiet button with the glyph and a diamond while changed
    style?: string,
    -- Done in the foot
    done?: boolean,
    onChange?: (value: FilterValues) -> (),
}

-- A list choice's values (a one-value choice: none).
export function filterList(c: FilterChoice?): FilterValue[]
    if type(c) == "table" then return c end
    return {}
end

-- One panel open at a time, and a screen-wide catcher under it that closes it.
local openMenu: FilterMenu? = nil
local catcher = CreateFrame("Button", nil, UIParent)
catcher:SetAllPoints(UIParent)
catcher:SetFrameStrata("FULLSCREEN_DIALOG")
catcher:Hide()
catcher:RegisterForClicks("AnyDown")
catcher:SetScript("OnClick", function() if openMenu then openMenu:Close() end end)

local menus: { [FilterMenu]: boolean } = setmetatable({}, { __mode = "k" })

local function copyList(list: FilterValue[]): FilterValue[]
    local out: FilterValue[] = {}
    for i, v in ipairs(list) do out[i] = v end
    return out
end

local function has(list: FilterValue[], v: FilterValue): boolean
    for _, x in ipairs(list) do if x == v then return true end end
    return false
end

-- A "many" option: a chip that's on or off.
class FilterChip extends Button
    readonly bg: Texture
    readonly edgeOn: Frame
    readonly label: Text
    dot?: Texture

    constructor(menu: FilterMenu, parent: Frame, group: FilterGroup, readonly option: FilterOption)
        super(nil, parent)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-line")
        self.bg = draw.fill(self, "arcane-soft", "BACKGROUND", 1)
        self.bg:SetAllPoints()
        self.edgeOn = CreateFrame("Frame", nil, self)
        self.edgeOn:SetAllPoints()
        draw.border(self.edgeOn, "arcane")
        local left = S["space-4"]
        if option.color then
            local dot = draw.diamond(self, 6, option.color)
            dot:SetPoint("LEFT", S["space-4"] + 3, 0)
            self.dot = dot
            left = S["space-4"] + 6 + S["space-3"]
        end
        self.label = text(self, "label", "ink-muted")
        self.label:SetPoint("LEFT", left, 0)
        self.label:SetValue(option.label)
        self:SetSize(math.ceil(left + self.label:GetUnboundedStringWidth() + S["space-4"]), CHIP_H)
        self:SetScript("OnClick", function()
            local list = filterList(menu.value[group.key])
            if has(list, option.value) then
                local kept: FilterValue[] = {}
                for _, x in ipairs(list) do if x ~= option.value then kept[#kept + 1] = x end end
                menu.value[group.key] = kept
            else
                list[#list + 1] = option.value
                menu.value[group.key] = list
            end
            menu:Changed()
        end)
    end
end

-- A group's row in the panel: its control (one), chips (many) or boxes
-- (toggles).
type FilterRow = {
    group: FilterGroup,
    control?: Segmented<FilterValue>,
    chips?: FilterChip[],
    boxes?: { box: Checkbox, option: FilterOption }[],
}

-- A column of the panel: its frame, width and height.
type Column = { frame: Frame, width: number, y: number }

-- The open panel: its rows and the foot.
class FilterPanel extends Frame
    readonly rows: FilterRow[] = {}
    reset: SuuButton? = nil
    done: SuuButton? = nil
    count: Text? = nil
end

-- The button style's width: its glyph, placeholder and diamond.
local function buttonWidth(f: FilterMenu): number
    return math.ceil(S["space-4"] + 12 + S["space-3"] + f.text:GetUnboundedStringWidth() + S["space-3"] + 5 + S["space-4"])
end

-- A theme can change the text styles the panel and the button are measured
-- in: the panel is built again when it next opens, the button measured again.
events.on("SUUUI_THEME_CHANGED", function()
    for m in pairs(menus) do
        if m.panel then
            m:Close()
            m.panel = nil
        end
        if m.autoWidth then m:SetWidth(buttonWidth(m)) end
    end
end, "UI.FilterMenu")

export class FilterMenu extends Button
    groups: FilterGroup[]
    onChange: ((value: FilterValues) -> ())? = nil
    placeholder: string? = nil
    defaults: FilterValues
    style: string? = nil
    done: boolean? = nil
    glyph: Texture
    edge: draw.Border
    text: Text
    changed: Texture? = nil
    autoWidth: boolean? = nil
    chevron: Texture? = nil
    value: FilterValues
    panel: FilterPanel? = nil

    constructor(parent: Frame, opts: FilterMenuOptions)
        super(nil, parent)
        self.groups, self.onChange, self.placeholder = opts.groups or {}, opts.onChange, opts.placeholder
        self.defaults, self.style, self.done = opts.defaults or {}, opts.style, opts.done
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. "filter.tga")
        self.glyph:SetSize(14, 14)
        self.glyph:SetPoint("LEFT", S["space-4"], 0)
        if self.style == "button" then
            -- a quiet button: the glyph, the placeholder, a diamond while changed
            draw.fill(self, "surface-raised"):SetAllPoints()
            self.edge = draw.border(self, "gilt-line")
            self.glyph:SetSize(12, 12)
            self.glyph:SetPoint("LEFT", S["space-4"], 0)
            draw.paint(self.glyph, "ink-muted")
            self.text = text(self, "label", "ink")
            self.text:SetPoint("LEFT", self.glyph, "RIGHT", S["space-3"], 0)
            self.text:SetValue(opts.placeholder or "Filters")
            self.changed = draw.diamond(self, 5, "ink")
            self.changed:SetPoint("LEFT", self.text, "RIGHT", S["space-3"], 0)
            self.autoWidth = not opts.width
            self:SetSize(opts.width or buttonWidth(self), opts.height or 30)
        else
            self:SetSize(opts.width or 140, opts.height or 30)
            draw.fill(self, "surface-sunk"):SetAllPoints()
            self.edge = draw.border(self, "gilt-line")
            self.chevron = self:CreateTexture(nil, "ARTWORK")
            self.chevron:SetTexture(GLYPHS .. "chevronDown.tga")
            self.chevron:SetSize(12, 12)
            self.chevron:SetPoint("RIGHT", -S["space-4"], 0)
            draw.paint(self.chevron, "ink-muted")
            self.text = text(self, "body", "ink")
            self.text:SetPoint("LEFT", self.glyph, "RIGHT", S["space-3"], 0)
            self.text:SetPoint("RIGHT", self.chevron, "LEFT", -S["space-3"], 0)
            self.text:SetJustifyH("LEFT")
        end
        self:SetScript("OnClick", function()
            if openMenu == self then self:Close() else self:Open() end
        end)
        self:SetScript("OnEnter", function() if openMenu ~= self then self.edge:SetColor("gilt") end end)
        self:SetScript("OnLeave", function() if openMenu ~= self then self.edge:SetColor("gilt-line") end end)
        self:HookScript("OnHide", function() self:Close() end)
        self.value = self:Full(opts.value)
        self:Draw()
        menus[self] = true
    end

    -- The value with every group filled in from the defaults.
    function Full(value: FilterValues?): FilterValues
        local out: FilterValues = {}
        for _, g in ipairs(self.groups) do
            local v = value and value[g.key]
            if v == nil then v = self.defaults[g.key] end
            if g.kind == "one" then out[g.key] = v else out[g.key] = copyList(filterList(v)) end
        end
        return out
    end

    -- How many choices differ from the defaults.
    function Count(): number
        local n = 0
        for _, g in ipairs(self.groups) do
            local v, d = self.value[g.key], self.defaults[g.key]
            if g.kind == "one" then
                if v ~= d then n = n + 1 end
            else
                local vs, ds = filterList(v), filterList(d)
                for _, x in ipairs(vs) do if not has(ds, x) then n = n + 1 end end
                for _, x in ipairs(ds) do if not has(vs, x) then n = n + 1 end end
            end
        end
        return n
    end

    function GetValue() return self:Full(self.value) end

    function SetValue(value: FilterValues?)
        self.value = self:Full(value)
        self:Draw()
    end

    function SetGroups(groups: FilterGroup[]?)
        self:Close()
        self.panel = nil
        self.groups = groups or {}
        self.value = self:Full(self.value)
        self:Draw()
    end

    function Changed()
        self:Draw()
        if self.onChange then self.onChange(self:GetValue()) end
    end

    -- The field and, when built, the panel's controls, from the value.
    function Draw()
        local n = self:Count()
        if self.style == "button" then
            self.text:SetValue(self.placeholder or "Filters")
            if self.changed then self.changed:SetShown(n > 0) end
        else
            self.text:SetValue((self.placeholder or "Filters") .. (n > 0 and (" · " .. n) or ""))
            draw.paint(self.glyph, n > 0 and "arcane" or "ink-muted")
        end
        local p = self.panel
        if not p then return end
        for _, row in ipairs(p.rows) do
            local v = self.value[row.group.key]
            local control = row.control
            if control then
                control:SetValue(type(v) ~= "table" and v or nil)
            end
            for _, chip in ipairs(row.chips or {}) do
                local on = has(filterList(v), chip.option.value)
                chip.bg:SetShown(on)
                chip.edgeOn:SetShown(on)
                chip.label:SetColor(on and "ink" or "ink-muted")
            end
            for _, b in ipairs(row.boxes or {}) do b.box:SetValue(has(filterList(v), b.option.value)) end
        end
        if p.count then p.count:SetValue(n > 0 and (n .. (n == 1 and " filter on" or " filters on")) or "Defaults") end
        if p.reset then p.reset:SetEnabledState(n > 0) end
    end

    function Build()
        local menu = self
        local p = FilterPanel.new(nil, UIParent)
        self.panel = p
        p:SetFrameStrata("FULLSCREEN_DIALOG")
        p:SetFrameLevel(catcher:GetFrameLevel() + 10)
        p:EnableMouse(true)
        p:SetClampedToScreen(true)
        draw.fill(p, "surface"):SetAllPoints()
        draw.border(p, "gilt-line")
        draw.shadow(p, "shadow-panel")
        local pad = S["space-5"]
        -- the columns: a group with `column` starts the next one
        local multi = false
        for gi, g in ipairs(self.groups) do if gi > 1 and g.column then multi = true end end
        local inner = multi and COLUMN_W or PANEL_W - pad * 2
        local columns: Column[] = {}
        local function newColumn(): Column
            local f = CreateFrame("Frame", nil, p)
            f:SetSize(1, 1)
            local c: Column = { frame = f, width = inner, y = 0 }
            columns[#columns + 1] = c
            return c
        end
        local col = newColumn()
        local y = 0
        for gi, g in ipairs(self.groups) do
            if gi > 1 and g.column then
                col.y = y
                col = newColumn()
                y = 0
            elseif gi > 1 then
                y = y + S["space-4"]
            end
            local row: FilterRow = { group = g }
            local label = text(p, "caption", "ink-muted")
            label:SetPoint("TOPLEFT", col.frame, "TOPLEFT", 0, -y)
            label:SetValue(g.label)
            y = y + T.type.caption.lineHeight + S["space-2"]
            if g.kind == "one" then
                local control = segmented(p, { options = g.options, onChange = function(v: FilterValue)
                    menu.value[g.key] = v
                    menu:Changed()
                end })
                row.control = control
                control:SetPoint("TOPLEFT", col.frame, "TOPLEFT", 0, -y)
                col.width = math.max(col.width, control:GetWidth())
                y = y + control:GetHeight()
            elseif g.kind == "many" then
                -- chips, wrapping onto the next line
                local chips: FilterChip[] = {}
                row.chips = chips
                local x = 0
                for _, o in ipairs(g.options) do
                    local chip = FilterChip.new(menu, p, g, o)
                    if x > 0 and x + chip:GetWidth() > inner then
                        x = 0
                        y = y + CHIP_H + S["space-2"]
                    end
                    chip:SetPoint("TOPLEFT", col.frame, "TOPLEFT", x, -y)
                    x = x + chip:GetWidth() + S["space-2"]
                    chips[#chips + 1] = chip
                end
                y = y + CHIP_H
            else
                local boxes: { box: Checkbox, option: FilterOption }[] = {}
                row.boxes = boxes
                for i, o in ipairs(g.options) do
                    if i > 1 then y = y + S["space-2"] end
                    local box = checkbox(p, { label = o.label, onChange = function(on: boolean)
                        local list = filterList(menu.value[g.key])
                        if on then
                            if not has(list, o.value) then list[#list + 1] = o.value end
                            menu.value[g.key] = list
                        else
                            local kept: FilterValue[] = {}
                            for _, x in ipairs(list) do if x ~= o.value then kept[#kept + 1] = x end end
                            menu.value[g.key] = kept
                        end
                        menu:Changed()
                    end })
                    box:SetPoint("TOPLEFT", col.frame, "TOPLEFT", 0, -y)
                    col.width = math.max(col.width, box:GetWidth())
                    y = y + box:GetHeight()
                    boxes[#boxes + 1] = { box = box, option = o }
                end
            end
            p.rows[#p.rows + 1] = row
        end
        -- the columns side by side, the panel around them
        col.y = y
        local x, tallest = pad, 0
        for i, c in ipairs(columns) do
            if i > 1 then x = x + S["space-6"] end
            c.frame:SetPoint("TOPLEFT", p, "TOPLEFT", x, -pad)
            x = x + c.width
            tallest = math.max(tallest, c.y)
        end
        p:SetWidth(multi and (x + pad) or PANEL_W)
        y = pad + tallest
        -- the foot: how many are on, Reset (and Done)
        y = y + S["space-5"]
        local rule = draw.fill(p, "gilt-faint", "ARTWORK")
        rule:SetHeight(1)
        rule:SetPoint("TOPLEFT", pad, -y)
        rule:SetPoint("TOPRIGHT", -pad, -y)
        y = y + 1 + S["space-4"]
        local reset = button(p, { text = "Reset", variant = "quiet", onClick = function()
            menu.value = menu:Full(nil)
            menu:Changed()
        end })
        p.reset = reset
        if self.done then
            local done = button(p, { text = "Done", onClick = function() menu:Close() end })
            p.done = done
            done:SetPoint("TOPRIGHT", -pad, -y)
            reset:SetPoint("RIGHT", done, "LEFT", -S["space-3"], 0)
        else
            reset:SetPoint("TOPRIGHT", -pad, -y)
        end
        local count = text(p, "caption", "ink-muted")
        p.count = count
        count:SetPoint("LEFT", p, "TOPLEFT", pad, -(y + reset:GetHeight() / 2))
        y = y + reset:GetHeight() + pad
        p:SetHeight(y)
        -- Esc closes it (out of combat: the key can't be held back in one)
        p:EnableKeyboard(true)
        p:SetScript("OnKeyDown", function(panel, key: string)
            if InCombatLockdown() then return end
            if key == "ESCAPE" then
                panel:SetPropagateKeyboardInput(false)
                menu:Close()
            else
                panel:SetPropagateKeyboardInput(true)
            end
        end)
        p:Hide()
    end

    function Open()
        if openMenu and openMenu ~= self then openMenu:Close() end
        if not self.panel then self:Build() end
        local p = self.panel :: FilterPanel
        p:ClearAllPoints()
        p:SetPoint("TOPLEFT", self, "BOTTOMLEFT", 0, -S["space-2"])
        self:Draw()
        openMenu = self
        catcher:Show()
        p:Show()
        self.edge:SetColor("arcane")
    end

    function Close()
        if self.panel then self.panel:Hide() end
        if openMenu == self then
            openMenu = nil
            catcher:Hide()
        end
        self.edge:SetColor("gilt-line")
    end
end

export function filterMenu(parent: Frame, opts: FilterMenuOptions): FilterMenu
    return FilterMenu.new(parent, opts)
end
