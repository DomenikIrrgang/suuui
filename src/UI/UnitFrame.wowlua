-- UI/UnitFrame.wowlua
-- The unit frame: the bar is the frame. One bar with the unit's name, meta,
-- state badge and health % inside it, its power as a line along the bottom.
--
--   local f = unitFrame(parent, "target", {
--       size = "lg",        -- lg (player, target), md (party, focus, boss, pet), sm (raid, target of target)
--       width = nil,        -- default: the size's bar token
--       anchor = false,     -- the player frame's double gilt frame and two diamonds
--       you = false,        -- the "you" badge
--       meta = false,       -- after the name: true for level and classification, "family" for a pet's family
--       crest = false,      -- 0.17: the rare and elite crest (target, focus)
--       dragon = false,     -- 0.17: with crest, the game's elite dragon in its place
--       poll = nil,         -- seconds: redraw on a timer, for units with no events (targettarget)
--       power = true,       -- the power line
--       healthText = "percent", -- "value" (12.3k), "both" (12.3k · 64%) or "none"
--       nameColor = "game", -- class colour (players) or reaction colour (NPCs); "ink" for plain names
--       secure = true,      -- a SecureUnitButtonTemplate button: left click targets, right click opens the menu
--       name = "SuuUIPlayerFrame",
--       height = nil,       -- px or token; default: the size's height
--       lowHealth = true,   -- the low-health fill (false: never)
--       lowTint = false,    -- the low-health tint: the empty part of the bar warms
--                           -- to ember from 70% down to 10% (the healer layout)
--       incoming = true,    -- incoming heals and absorbs (false: never)
--       powerFor = nil,     -- fn(unit, api) -> bool: which units get the power line
--       frame = nil,        -- style this button instead of making one (a group
--                           -- header's child; the header sets its unit)
--       reserveRight = 0,   -- px kept free at the bar's right end (inline auras)
--       textOnSmall = false, -- health text on an sm frame too (raid frames)
--       raidMarker = true,  -- the raid target marker (skull, cross…) over the top edge
--       api = nil,          -- a stand-in for the game's Unit* functions (previews);
--                           -- such a frame isn't activated, call :Refresh()
--   })
--   f:SetUnit(unit)          -- another unit (out of combat: it's a secure button)
--   f:SetDispelBadges(mode)  -- "all", "removable" or "off": debuff-type border
--                            -- and badge, in combat too (out of combat to set)
--   f:Resize(width, height)  -- out of combat
--   f:Activate()   -- starts listening to the unit's events and draws it
--   f:Deactivate()
--   f:SetState(tone, word)   -- a state border and badge ("danger", "Aggro"); nil clears it
--   f:UpdateRaidMarker()     -- redraws the marker (after opts.raidMarker changes)
--   f:Refresh()
--   f.onTooltip = fn(f, tooltip)  -- 0.17: adds lines to the frame's tooltip after the unit's
--
-- A disconnected player shows "Offline" where the health text goes, the bar
-- empty and the name faint, as a dead unit does.
--
-- Secret values: health, max health, power, incoming heals and absorbs go
-- straight to StatusBars, which take them as they are. The health % text is
-- UnitHealthPercent through CurveConstants.ScaleTo100, which the engine
-- evaluates and returns as a clean 0-100. The low-health fill and low-mana
-- amber are second bars whose alpha comes from a step curve evaluated by the
-- engine, so no Lua code ever compares a value that might be secret.

import * as secret from "wowlua:secret"
import * as timer from "wowlua:timer"
import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as events from "/Core/Events"
import * as extend from "/Core/Extend"
import debug from "/Core/Settings"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as controls from "/UI/Controls"
import * as iconModule from "/UI/Icon"
import * as crest from "/UI/Crest"
import auraContainer, UnitAuras, AuraGroup, AuraOptions, AuraButton from "/UI/Auras"

const S = T.space

local WHITE = "Interface\\Buttons\\WHITE8X8"
local HATCH = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Hatch.tga"
local ROLE_ICON: { [string]: string } = {
    TANK = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleTank.tga",
    HEALER = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleHealer.tga",
    DAMAGER = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleDamage.tga",
}

-- marker: the raid target marker's size; rise: how far it stands over the
-- top edge (less on sm, whose frames sit a few px apart in a raid grid)
type Size = { height: string, width: string, name: string, role: number, pad: number, gap: number, marker: number, rise: number }
local SIZES: { [string]: Size } = {
    lg = { height = "unit-lg", width = "bar-lg", name = "unit-name-lg", role = 14, pad = S["space-4"], gap = S["space-3"], marker = 18, rise = 8 },
    md = { height = "unit-md", width = "bar-md", name = "unit-name", role = 12, pad = S["space-4"], gap = S["space-3"], marker = 16, rise = 7 },
    sm = { height = "unit-sm", width = "bar-sm", name = "unit-name-sm", role = 10, pad = S["space-3"], gap = S["space-2"], marker = 14, rise = 4 },
}

-- The game's raid target markers: eight 64px cells, four to a row.
local MARKERS = "Interface\\TargetingFrame\\UI-RaidTargetingIcons"

local LOW_HEALTH = 0.35 -- the design's lowAt
local LOW_MANA = 0.25
local GHOST_HOLD = 0.15
local INTERPOLATE = Enum.StatusBarInterpolation and Enum.StatusBarInterpolation.ExponentialEaseOut

local POWER_TOKEN: { [string]: string } = { MANA = "mana", RAGE = "rage", ENERGY = "energy", FOCUS = "focus" }

-- wowlua:secret's isSecret as a local predicate: an imported one doesn't
-- narrow in wowlua 0.9.1 while the project has an import cycle (port notes)
local function isSecret(v: unknown): v is Secret<unknown> return secret.isSecret(v) end

-- nil becomes 0; a secret value passes through untouched (never `v or 0`,
-- which would test a secret value's truth).
const amount = secret.amount

--------------------------------------------------------------------------------
-- Where a frame reads its unit from
--------------------------------------------------------------------------------

-- The Unit* functions a frame reads: the game's, or (opts.api) stand-ins with
-- the same signatures, for previews with made-up people (unitStandIn). The
-- optional ones are checked before use (not every client, or stand-in, has
-- them).
export type UnitApi = {
    UnitExists: typeof(UnitExists),
    UnitIsDeadOrGhost: typeof(UnitIsDeadOrGhost),
    UnitIsGhost: typeof(UnitIsGhost),
    UnitHealthMax: typeof(UnitHealthMax),
    UnitHealth: typeof(UnitHealth),
    UnitHealthPercent?: typeof(UnitHealthPercent),
    UnitGetIncomingHeals: typeof(UnitGetIncomingHeals),
    UnitGetTotalAbsorbs: typeof(UnitGetTotalAbsorbs),
    UnitPowerType: typeof(UnitPowerType),
    UnitPowerMax: typeof(UnitPowerMax),
    UnitPower: typeof(UnitPower),
    UnitPowerPercent: typeof(UnitPowerPercent),
    UnitLevel: typeof(UnitLevel),
    UnitClassification?: typeof(UnitClassification),
    UnitGroupRolesAssigned: typeof(UnitGroupRolesAssigned),
    UnitIsPlayer: typeof(UnitIsPlayer),
    UnitClass: typeof(UnitClass),
    UnitName: typeof(UnitName),
    UnitReaction: typeof(UnitReaction),
    UnitCreatureFamily: typeof(UnitCreatureFamily),
    UnitIsUnit: typeof(UnitIsUnit),
    UnitIsConnected?: typeof(UnitIsConnected),
    GetRaidTargetIndex?: typeof(GetRaidTargetIndex),
    UnitIsBossMob?: typeof(UnitIsBossMob),
}

-- Where the group is read from (the game's functions; stand-ins in tests).
export type GroupApi = {
    IsInRaid: typeof(IsInRaid),
    GetRaidRosterInfo: typeof(GetRaidRosterInfo),
    GetNumGroupMembers?: typeof(GetNumGroupMembers),
    UnitIsUnit: typeof(UnitIsUnit),
}

-- The game's functions, looked up when called (so a function replaced later,
-- as tests do, is the one used).
local gameProxy: unknown = setmetatable({}, { __index = function(_: unknown, k: string): unknown return _G[k] end })
local GAME = gameProxy :: UnitApi
local GROUP = gameProxy :: GroupApi

-- CurveConstants.ScaleTo100 (declared as a plain table), nil where the
-- client has none.
local function scaleTo100(): CurveObjectBase?
    local constants = CurveConstants and CurveConstants :: { ScaleTo100?: CurveObjectBase }
    return constants and constants.ScaleTo100 or nil
end

--------------------------------------------------------------------------------
-- Curves: built once, evaluated by the engine with the unit's health or power.
--------------------------------------------------------------------------------

local curves: { [number]: CurveObject } = {}

-- A step curve that is 1 below `at` (a 0-1 fraction) and 0 from it up.
local function belowCurve(at: number): CurveObject
    local c = curves[at]
    if not c then
        c = C_CurveUtil.CreateCurve()
        c:SetType(Enum.LuaCurveType.Step)
        c:AddPoint(0, 1)
        c:AddPoint(at, 0)
        curves[at] = c
    end
    return c
end

-- The low-health tint's strength: none above TINT_FROM, rising to TINT_MAX
-- at TINT_FULL and below (the design: from 70% down to 10%). Linear between.
local TINT_FROM, TINT_FULL, TINT_MAX = 0.7, 0.1, 0.55
local TINT_POINTS: number[][] = { { 0, TINT_MAX }, { TINT_FULL, TINT_MAX }, { TINT_FROM, 0 }, { 1, 0 } }
-- nil: not made yet; false: this client can't make it
local tintCurve: CurveObject | false | nil = nil
local function lowTintCurve(): CurveObject?
    if tintCurve == nil then
        tintCurve = false
        local linear = Enum.LuaCurveType and Enum.LuaCurveType.Linear
        if C_CurveUtil and linear then
            local c = C_CurveUtil.CreateCurve()
            c:SetType(linear)
            for _, pt in ipairs(TINT_POINTS) do c:AddPoint(pt[1], pt[2]) end
            tintCurve = c
        end
    end
    return tintCurve or nil
end

-- A curve's answer as an amount: a number (the curves here give numbers),
-- or the secret it is. A colour (never, with these curves) is 0.
type CurveResult = LuaCurveEvaluatedResult | Secret<LuaCurveEvaluatedResult> | nil
local function curveAmount(r: CurveResult): number | Secret<number>
    if isSecret(r) then return r :: Secret<number> end
    return type(r) == "number" and r or 0
end

-- Health as a short number: 412, 8.5k, 12k, 1.2m. A secret value goes to
-- the game's AbbreviateNumbers, which returns a secret string the text can
-- still show (or the value itself, shown with %d).
-- (abbreviate: the game's AbbreviateNumbers, a parameter for tests)
type Abbreviate = (n: Secret<number>) -> (string | Secret<string>)
export type ShortNumber = string | Secret<string> | Secret<number>
local function shortNumber(v: number | Secret<number> | nil, abbreviate: Abbreviate = AbbreviateNumbers): ShortNumber?
    if isSecret(v) then
        -- the answer is secret too: never tested, only returned
        local ok, text = pcall(abbreviate, v)
        if ok then return text end
        local ok2, plain = pcall(string.format, "%d", v)
        if ok2 then return plain end
        return v
    end
    if v == nil then return nil end
    if v >= 1e6 then return ("%.1fm"):format(v / 1e6) end
    if v >= 1e5 then return ("%dk"):format(v / 1e3 + 0.5) end
    if v >= 1e4 then return ("%.0fk"):format(v / 1e3) end
    if v >= 1e3 then return ("%.1fk"):format(v / 1e3) end
    return ("%d"):format(v + 0.5)
end

-- A player who has left the game. The answer is never secret for group
-- members; a secret one counts as connected.
local function isOffline(A: UnitApi, unit: string): boolean
    local connectedFn = A.UnitIsConnected
    if not connectedFn or not uiText.flag(A.UnitIsPlayer(unit)) then return false end
    local connected = connectedFn(unit)
    return not isSecret(connected) and connected == false
end

-- The health % (0-100) the engine works out, nil where the client can't.
local function healthPercent(A: UnitApi, unit: string): number | Secret<number> | nil
    local percent, scale = A.UnitHealthPercent, scaleTo100()
    if percent and scale then
        return curveAmount(percent(unit, true, scale))
    end
    return nil
end

-- What one of the unit frame's curves gives for a 0-1 fraction, for
-- stand-ins (previews) that evaluate curves themselves.
export function unitFrameCurveValue(curve: unknown, x: number): number?
    for at, c in pairs(curves) do
        if c == curve then return x < at and 1 or 0 end
    end
    if curve and curve == tintCurve then
        for i = 2, #TINT_POINTS do
            local a, b = TINT_POINTS[i - 1], TINT_POINTS[i]
            if x <= b[1] then return a[2] + (b[2] - a[2]) * (x - a[1]) / (b[1] - a[1]) end
        end
        return 0
    end
    return nil
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

local function bar(f: UnitFrame, level: number, color: string?): StatusBar
    local b = CreateFrame("StatusBar", nil, f.inner)
    b:SetStatusBarTexture(WHITE)
    b:GetStatusBarTexture():SetSnapToPixelGrid(false)
    b:SetFrameLevel(f:GetFrameLevel() + level)
    b:SetMinMaxValues(0, 1)
    b:SetValue(0)
    if color then draw.paint(b, color) end
    return b
end

local function gradient(b: StatusBar, deep: string, fill: string)
    draw.paintGradient(b:GetStatusBarTexture(), "HORIZONTAL", deep, fill)
end

--------------------------------------------------------------------------------
-- Drawing
--------------------------------------------------------------------------------

local CLASSIFICATION: { [string]: string } = { worldboss = "Boss", elite = "Elite", rareelite = "Rare Elite", rare = "Rare" }

-- 0.17: a level's colour token by how hard it is for you (asked 2026-10-18:
-- green, yellow, orange, red, grey as the game rates it): the game's own
-- difficulty (its colour's font names it), drawn in the design's quest
-- colours. A level unknown (secret, "??") is impossible.
local DIFFICULTY_FONTS: string[][] = {
    { "VeryDifficult", "quest-very-difficult" }, { "Impossible", "quest-impossible" },
    { "Difficult", "quest-difficult" }, { "Standard", "quest-standard" }, { "Trivial", "quest-trivial" },
}
-- getColor: the game's GetQuestDifficultyColor (a parameter for tests; nil
-- where the client has none). Its fonts are named "QuestDifficulty_<word>",
-- so the word is matched at the end (the prefix holds "Difficult" too).
type DifficultyColor = (level: number) -> unknown
local function difficultyColor(level: unknown, getColor: DifficultyColor?): string
    if level == nil or isSecret(level) or type(level) ~= "number" or level <= 0 then return "quest-impossible" end
    if not getColor then return "quest-standard" end
    local ok, c = pcall(getColor, level)
    local font = ok and type(c) == "table" and (c :: { font?: unknown }).font
    if type(font) ~= "string" then return "quest-standard" end
    for _, d in ipairs(DIFFICULTY_FONTS) do
        if font:sub(-#d[1]) == d[1] then return d[2] end
    end
    return "quest-standard"
end

export function levelColor(level: unknown): string
    return difficultyColor(level, GetQuestDifficultyColor)
end

local function metaText(A: UnitApi, u: string): string
    local level = A.UnitLevel(u)
    local classify = A.UnitClassification
    local c = classify and classify(u)
    if isSecret(level) or isSecret(c) then return "" end
    local lv = (level and level > 0) and tostring(level) or "??"
    if c == "worldboss" then return "?? Boss" end
    local word = c and CLASSIFICATION[c]
    return word and (lv .. " " .. word) or lv
end

-- The raid target marker. GetRaidTargetIndex may be secret in combat: the
-- game's SetRaidTargetIconTexture works out the cell with Lua arithmetic,
-- which a secret refuses, so a secret index goes to the texture's sprite
-- sheet cell, which the engine works out itself.
-- 0.9, public: raidMarker(parent, size) makes the texture (hidden), and
-- showRaidMarker(texture, unit[, api]) shows that unit's marker on it, or
-- hides it (no marker, no unit, or `api` without GetRaidTargetIndex).
export function raidMarker(parent: Frame, size: number, layer: DrawLayer?): Texture
    local t = parent:CreateTexture(nil, layer or "OVERLAY")
    t:SetTexture(MARKERS)
    t:SetSize(size, size)
    t:Hide()
    return t
end

export function showRaidMarker(t: Texture, u: string?, api: UnitApi?)
    local A = api or GAME
    local markerOf = A.GetRaidTargetIndex
    if not u or not markerOf or not A.UnitExists(u) then
        t:Hide()
        return
    end
    local index = markerOf(u)
    if isSecret(index) then
        local ok = t.SetSpriteSheetCell ~= nil and pcall(t.SetSpriteSheetCell, t, index, 4, 4, 64, 64)
        t:SetShown(ok)
    elseif index and index >= 1 and index <= 8 then
        local col, row = (index - 1) % 4, math.floor((index - 1) / 4)
        t:SetTexCoord(col * 0.25, (col + 1) * 0.25, row * 0.25, (row + 1) * 0.25)
        t:Show()
    else
        t:Hide()
    end
end

-- A state border and its badge: "danger", "warning", "magic", "curse",
-- "poison", "disease", "ward" or nil.
local STATE_BORDER: { [string]: string } = {
    danger = "ember", warning = "amber", ward = "ward",
    magic = "dispel-magic", curse = "dispel-curse", poison = "dispel-poison", disease = "dispel-disease",
}

-- The row (name, badges) stops where the health text begins; how much room
-- that text needs depends on what it shows.
local TEXT_W: { [string]: number } = { percent = 34, value = 40, both = 84, none = 0 }

--------------------------------------------------------------------------------
-- Buff indicators (healers' HoTs and shields). Each indicator watches some spells (every rank) on the unit:
--   { name, ids = { ... }, kind = "icon" | "square" | "border" | "fill",
--     point = "TOPRIGHT", size = 12, color = "fel", source = "mine" | "any",
--     show = "up" | "missing" | "both", missingColor = "ember",
--     on = "all" | "group" }  -- on everyone, or only on your own raid group
--                             -- (older lists: missingOn)
-- show: "up" while the aura is up (the engine, in combat too); "missing"
-- while it isn't, out of combat only (addon code can't read auras in combat,
-- so it hides then); "both" a missing look (grey icon, or the missing colour)
-- under the live one, which covers it while the aura is up (in combat too;
-- not for "fill", whose two tints would blend).
-- Live, each is an engine aura container filtered to its spells (so it works
-- in combat); its one button carries the look, built when the engine makes
-- it, by anchors alone: an aura icon with its time, a coloured square at a
-- corner, a coloured border, or a tint over the health fill. In a preview
-- (static) the same looks are drawn directly, as if the aura were up.
--------------------------------------------------------------------------------

-- One buff indicator (saved settings: the Buff indicators module's list).
export type Indicator = {
    name?: string,
    ids?: number[],
    kind?: string,
    point?: FramePoint,
    size?: number,
    color?: string,
    source?: string,
    show?: string,
    missingColor?: string,
    on?: string,
    missingOn?: string,
    -- the group sizes it shows at ("5", "10", "20", "40"; none: every size)
    sizes?: { [string]: boolean },
}

export const INDICATOR_POINTS: FramePoint[] = { "TOPLEFT", "TOP", "TOPRIGHT", "LEFT", "CENTER", "RIGHT", "BOTTOMLEFT", "BOTTOM", "BOTTOMRIGHT" }

-- the indicator each live indicator container shows
local indicatorOf: { [UnitAuras]: Indicator } = setmetatable({}, { __mode = "k" })

local function pointOffset(point: string): (number, number)
    local x = point:find("LEFT") and 2 or (point:find("RIGHT") and -2 or 0)
    local y = point:find("TOP") and -2 or (point:find("BOTTOM") and 2 or 0)
    return x, y
end

-- The look of indicator `ind` over frame `f`, on `parent`; `previewArt` is the
-- texture to show for kind "icon" in a preview (live, the engine draws it).
-- missing: the "aura is missing" look (missing colour, or a grey icon),
-- one level under the live look so the live one covers it.
local function indicatorLook(f: UnitFrame, parent: Frame, ind: Indicator, previewArt: number?, missing: boolean?): Frame
    local look = CreateFrame("Frame", nil, parent)
    look:EnableMouse(false)
    local color = missing and (ind.missingColor or "ember") or (ind.color or "fel")
    local bias = missing and 0 or 1
    if ind.kind == "border" then
        look:SetAllPoints(f)
        draw.border(look, color, { width = 2 })
        look:SetFrameLevel(f.over:GetFrameLevel() + 1 + bias)
    elseif ind.kind == "fill" then
        look:SetAllPoints(f.health:GetStatusBarTexture())
        local tex = look:CreateTexture(nil, "ARTWORK")
        tex:SetAllPoints()
        draw.bind(tex, function(t: Texture)
            local r, g, b = draw.rgba(color)
            t:SetColorTexture(r, g, b, 0.45)
        end)
        look:SetFrameLevel(f.health:GetFrameLevel() + 1)
    else
        local size = ind.size or 10
        local point: FramePoint = ind.point or "TOPRIGHT"
        local x, y = pointOffset(point)
        look:SetSize(size, size)
        look:SetPoint(point, f, point, x, y)
        if ind.kind == "square" then
            draw.fill(look, color):SetAllPoints()
            draw.border(look, "surface-sunk")
        elseif previewArt then
            local icon = iconModule.icon(look, size)
            icon:SetAllPoints()
            icon:SetArt(previewArt)
            if missing then icon:SetState("dim") end
        end
        look:SetFrameLevel(f.over:GetFrameLevel() + 7 + bias)
    end
    return look
end

-- One indicator's identity: everything its container and look are built from.
local function indicatorKey(ind: Indicator): string
    return table.concat({ ind.kind or "icon", ind.point or "", ind.size or 10, ind.color or "", ind.source or "mine",
                          table.concat(ind.ids or {}, ",") }, "|")
end

-- An indicator's first spell's art (a preview's icon), if it has one.
local function indicatorArt(ind: Indicator): number?
    local first = ind.ids and ind.ids[1]
    return first and (C_Spell.GetSpellTexture(first)) or nil
end

-- Whether a group member is in your own raid group (in a party, or for a
-- party token in a raid: yes). Read out of combat; an unreadable answer is yes.
-- (A: where the group is read from, the game's functions; a parameter for tests)
local function inYourGroup(unit: string, A: GroupApi = GROUP): boolean
    if not A.IsInRaid() then return true end
    local idx = tonumber(unit:match("^raid(%d+)$"))
    if not idx then return true end
    local _, _, sub = A.GetRaidRosterInfo(idx)
    local count = A.GetNumGroupMembers and A.GetNumGroupMembers() or 0
    for i = 1, count do
        local me = A.UnitIsUnit("raid" .. i, "player")
        if isSecret(me) then return true end
        if me then
            local _, _, mine = A.GetRaidRosterInfo(i)
            return sub == nil or mine == nil or sub == mine
        end
    end
    return true
end

-- Group sizes an indicator can be limited to (ind.sizes = { ["10"] = true,
-- … }; nil: every size). A party (or no group) is "5"; a raid the smallest
-- of 10, 20, 40 it fits in.
export const GROUP_TIERS: string[] = { "5", "10", "20", "40" }
-- (A: where the group is read from, the game's functions; a parameter for tests)
local function groupTierIn(count: number?, A: GroupApi): string
    if not count and not A.IsInRaid() then return "5" end
    local n = count or (A.GetNumGroupMembers and A.GetNumGroupMembers() or 0)
    if n <= 5 and not A.IsInRaid() then return "5" end
    if n <= 10 then return "10" end
    if n <= 20 then return "20" end
    return "40"
end
export function groupTier(count: number?): string
    return groupTierIn(count, GROUP)
end

-- The indicators of `list` active at group size `tier`.
export function indicatorsFor(list: Indicator[]?, tier: string): Indicator[]
    local out: Indicator[] = {}
    for _, ind in ipairs(list or {}) do
        local sizes = ind.sizes
        if not sizes or next(sizes) == nil or sizes[tier] then out[#out + 1] = ind end
    end
    return out
end

-- The indicators SuuUI shows on group frames (set by the Buff indicators
-- module; empty while it is off), and a counter that changes with them.
local indicators: Indicator[], indicatorsVersion = {}, 0
export function groupIndicators(): (Indicator[], number) return indicators, indicatorsVersion end
export function setGroupIndicators(list: Indicator[]?)
    indicators = list or {}
    indicatorsVersion = indicatorsVersion + 1
    events.emit("SUUUI_INDICATORS_CHANGED")
end

-- The Defensives list for group frames (set by the Defensives module; empty
-- while it is off): spell IDs by what they drive, and a counter that changes
-- with them. { external = { ids }, defensive = { ids }, warded = { ids },
-- all = { ids } }
local EMPTY_DEFENSIVES: { [string]: number[] } = { external = {}, defensive = {}, warded = {}, all = {} }
local defensives, defensivesVersion = EMPTY_DEFENSIVES, 0
export function groupDefensives(): ({ [string]: number[] }, number) return defensives, defensivesVersion end
export function setGroupDefensives(d: { [string]: number[] }?)
    defensives = d or EMPTY_DEFENSIVES
    defensivesVersion = defensivesVersion + 1
    events.emit("SUUUI_DEFENSIVES_CHANGED")
end

--------------------------------------------------------------------------------
-- Stand-ins for previews: made-up people with the Unit* functions a frame
-- reads.
--------------------------------------------------------------------------------

-- A made-up person for a preview unit token: health and power are 0-1
-- fractions (max: the health they are of), incoming and absorb fractions of
-- max, marker a raid target marker (1-8), you: the player.
export type StandInPerson = {
    name?: string,
    class?: string,
    role?: string,
    health: number,
    max?: number,
    power?: number,
    incoming?: number,
    absorb?: number,
    dead?: boolean,
    offline?: boolean,
    marker?: number,
    you?: boolean,
}

local STAND_IN_POWER: { [string]: { kind: number, token: string } } = {
    WARRIOR = { kind = 1, token = "RAGE" }, ROGUE = { kind = 3, token = "ENERGY" },
}
local MANA = { kind = 0, token = "MANA" }

export function unitStandIn(person: (unit: string) -> StandInPerson): UnitApi
    local function curveValue(curve: CurveObjectBase?, fraction: number): number
        if curve ~= nil and curve == scaleTo100() then return fraction * 100 end
        return unitFrameCurveValue(curve, fraction) or 0
    end
    local function healthOf(u: string, part: number): number
        return part * (person(u).max or 4200)
    end
    return {
        UnitExists = function(_: string?): boolean return true end,
        UnitIsDeadOrGhost = function(u: string): boolean return person(u).dead == true end,
        UnitIsGhost = function(_: string): boolean return false end,
        UnitHealthMax = function(u: string): number return person(u).max or 4200 end,
        UnitHealth = function(u: string, _: boolean?): number return healthOf(u, person(u).health) end,
        UnitHealthPercent = function(u: string, _: boolean?, curve: CurveObjectBase?): number
            return curveValue(curve, person(u).health)
        end,
        UnitGetIncomingHeals = function(u: string, _: string?): number? return healthOf(u, person(u).incoming or 0) end,
        UnitGetTotalAbsorbs = function(u: string): number return healthOf(u, person(u).absorb or 0) end,
        UnitPowerType = function(u: string, _: number?): (number?, string?)
            local class = person(u).class
            local p = class and STAND_IN_POWER[class] or MANA
            return p.kind, p.token
        end,
        UnitPowerMax = function(_: string, _: number?, _: boolean?): number return 100 end,
        UnitPower = function(u: string, _: number?, _: boolean?): number return (person(u).power or 0.6) * 100 end,
        UnitPowerPercent = function(u: string, _: number?, _: boolean?, curve: CurveObjectBase?): number
            return curveValue(curve, person(u).power or 0.6)
        end,
        UnitLevel = function(_: string): number return 60 end,
        UnitClassification = function(_: string): string return "normal" end,
        UnitGroupRolesAssigned = function(u: string?): string return u and person(u).role or "NONE" end,
        UnitIsPlayer = function(_: string?, _: number?): boolean return true end,
        UnitClass = function(u: string): (string?, string?)
            local c = person(u).class
            return c, c
        end,
        UnitName = function(u: string | Secret<string>): (string?, string?)
            if isSecret(u) then return nil, nil end
            return person(u).name, nil
        end,
        UnitReaction = function(_: string, _: string): number? return 5 end,
        -- (no family: shown as none)
        UnitCreatureFamily = function(_: string): (string, number) return "", 0 end,
        UnitIsUnit = function(u: string, other: string): boolean return other == "player" and person(u).you == true end,
        UnitIsConnected = function(u: string): boolean return not person(u).offline end,
        GetRaidTargetIndex = function(u: string): number? return person(u).marker end,
    }
end

--------------------------------------------------------------------------------
-- Debuff-type badges, in combat too. Per type, an
-- engine aura container that holds at most one debuff of that type. Its
-- button draws nothing itself; the decoration hung on it when the engine
-- creates it (writes to these buttons are refused once auras are secret)
-- covers the whole frame by anchors alone: the type's border, and its badge
-- where the health text begins. The engine shows the button while such a
-- debuff is up, and the decoration with it. Two sets: every type, and only
-- what you can remove; one shows.
--------------------------------------------------------------------------------

export const DEBUFF_TYPES: string[] = { "Magic", "Curse", "Poison", "Disease" } -- drawn top first

-- An engine button that only carries a decoration: 1px, no mouse.
local function quietButton(button: AuraButton)
    pcall(button.SetSize, button, 1, 1)
    pcall(button.SetMouseClickEnabled, button, false)
    pcall(button.SetMouseMotionEnabled, button, false)
end

local function buildDispelSet(f: UnitFrame, set: string): UnitAuras[]
    local filter = set == "removable" and { "HARMFUL", "RAID_PLAYER_DISPELLABLE" } or { "HARMFUL" }
    local list: UnitAuras[] = {}
    for _, kind in ipairs(DEBUFF_TYPES) do
        local init = function(button: AuraButton)
            quietButton(button)
            f:DispelDecoration(button, kind)
        end
        local c = auraContainer(f, f.unit or "none", { size = 1, anchor = "TOPLEFT",
            groups = { { key = kind, filter = filter, max = 1, dispelTypes = { kind }, initialize = init } } })
        if c then
            c.container:SetPoint("TOPLEFT", f, "TOPLEFT")
            c.container:SetFrameLevel(f.over:GetFrameLevel() + 1)
            list[#list + 1] = c
        end
    end
    return list
end

--------------------------------------------------------------------------------
-- Warded, in combat too: one engine aura container filtered to the
-- Defensives list's spells with Warded on (max 1). Its button carries the
-- ward border, the "Warded" badge and the ward glow, as the debuff-type
-- slots carry theirs. The order: a debuff type covers Warded (its slots sit
-- above), Warded covers Aggro (the state layer sits below), and Aggro's ember
-- glow draws over the ward's.
--------------------------------------------------------------------------------

-- The ward border, badge and glow over a frame, on `parent` (the slot's
-- button, or the frame itself in a preview, which shows and hides it with
-- SetWarded).
export class WardDecoration extends Frame
    readonly glow: Frame

    constructor(parent: Frame, owner: UnitFrame)
        super(nil, parent)
        self:SetAllPoints(owner)
        self:EnableMouse(false)
        draw.border(self, "ward")
        local badge = controls.stateBadge(self, "ward", "Warded")
        badge:SetPoint("RIGHT", owner.row, "RIGHT", 0, 0)
        -- at least as wide as the Aggro badge it covers
        badge:SetWidth(math.max(badge.knownWidth, uiText.measureText("badge", "Aggro") + 10))
        self:SetFrameLevel(owner.over:GetFrameLevel() + 2)
        -- the glow on its own layer under the frame's, so Aggro's ember glow wins
        local glow = CreateFrame("Frame", nil, parent)
        glow:SetAllPoints(owner)
        glow:EnableMouse(false)
        glow:SetFrameLevel(math.max(0, owner:GetFrameLevel() - 1))
        draw.shadow(glow, "glow-ward")
        self.glow = glow
    end

    -- (a preview's) on a slot's button both follow the button
    function SetWarded(on: boolean)
        self:SetShown(on)
        self.glow:SetShown(on)
    end
end

--------------------------------------------------------------------------------
-- Events
--------------------------------------------------------------------------------

local HEALTH_EVENTS: EventName[] = { "UNIT_HEALTH", "UNIT_MAXHEALTH", "UNIT_HEAL_PREDICTION", "UNIT_ABSORB_AMOUNT_CHANGED" }
local POWER_EVENTS: EventName[] = { "UNIT_POWER_UPDATE", "UNIT_MAXPOWER", "UNIT_DISPLAYPOWER" }
local IDENTITY_EVENTS: EventName[] = { "UNIT_NAME_UPDATE", "UNIT_LEVEL", "UNIT_FACTION", "UNIT_CLASSIFICATION_CHANGED" }

-- Registers a unit event if this client has it (a few retail events may not).
local function onUnit(f: UnitFrame, unit: string, event: EventName, fn: () -> ())
    local ok = pcall(events.onUnit, event, unit, fn, f)
    if not ok then debug("UnitFrame: no event", event) end
end

-- What unitFrame takes (see the header).
export type UnitFrameOptions = {
    size?: string,
    width?: number | string,
    height?: number | string,
    anchor?: boolean,
    you?: boolean,
    youWhenPlayer?: boolean,
    meta?: boolean | string,
    crest?: boolean,
    dragon?: boolean,
    poll?: number,
    power?: boolean,
    healthText?: string,
    nameColor?: string,
    secure?: boolean,
    name?: string,
    lowHealth?: boolean,
    lowTint?: boolean,
    incoming?: boolean,
    powerFor?: (unit: string, api: UnitApi) -> boolean,
    frame?: Button,
    reserveRight?: number,
    textOnSmall?: boolean,
    raidMarker?: boolean,
    api?: UnitApi,
}

-- A missing look shown now, and what decides it.
type MissingLook = { look: Frame, mode: string, ind: Indicator }

export class UnitFrame extends Button
    unit: string? = nil
    opts: UnitFrameOptions
    size: Size
    api: UnitApi
    ground: Texture
    inner: Frame
    ghost: StatusBar
    health: StatusBar
    crest: crest.Crest? = nil
    dragonHost: Frame? = nil
    dragon: Texture? = nil
    healthLow: StatusBar
    tint: Texture
    incoming: StatusBar
    absorb: StatusBar
    power: StatusBar
    powerLow: StatusBar
    over: Frame
    border: draw.Border
    glow: draw.SoftEdge
    row: Frame
    role: Texture
    classDot: Texture
    name: uiText.Text
    meta: uiText.Text
    stateLayer: Frame
    badge: controls.StateBadge
    you: controls.StateBadge
    right: uiText.Text
    markerLayer: Frame
    marker: Texture
    rightW: number = 0
    ghostValue: number | Secret<number> = 0
    ghostTimer: TimerHandle? = nil
    dead: boolean? = nil
    offline: boolean? = nil
    stateTone: string? = nil
    stateWord: string? = nil
    -- live indicators' containers by identity, and those in use
    indicatorCache: { [string]: UnitAuras } = {}
    indicatorContainers: UnitAuras[] = {}
    -- missing looks by identity, and those in use
    missingCache: { [string]: Frame } = {}
    missingLooks: MissingLook[] = {}
    previewCache: { [string]: Frame } = {}
    previewLooks: Frame[] = {}
    -- the debuff-type slots per set ("all", "removable")
    dispelSets: { [string]: UnitAuras[] } = {}
    wardSlot: UnitAuras? = nil
    -- a preview's ward look (the group frames' previews)
    wardDeco: WardDecoration? = nil
    active: boolean? = nil
    ticker: TickerHandle? = nil
    -- 0.17: adds lines to the frame's tooltip after the unit's
    onTooltip: ((f: UnitFrame, tooltip: GameTooltip) -> ())? = nil
    -- after each health update
    onHealth: ((f: UnitFrame) -> ())? = nil

    constructor(parent: Frame?, unit: string?, given: UnitFrameOptions?)
        local opts: UnitFrameOptions = given or {}
        local size = SIZES[opts.size or "md"] :: Size
        -- opts.frame: a button a group header made (SecureUnitButtonTemplate);
        -- the header owns its unit, its attributes are set when it is made
        super(opts.name, parent, opts.secure ~= false and "SecureUnitButtonTemplate" or nil)
        self.unit, self.opts, self.size = unit, opts, size
        self.api = opts.api or GAME
        local w, h = draw.size(opts.width or size.width), draw.size(opts.height or size.height)
        if not (opts.frame and InCombatLockdown()) then self:SetSize(w, h) end

        if opts.secure ~= false and not opts.frame then
            self:SetAttribute("unit", unit)
            self:SetAttribute("*type1", "target")
            self:SetAttribute("*type2", "togglemenu")
            self:RegisterForClicks("AnyUp")
        end
        self:SetScript("OnEnter", function()
            local shown = self.unit
            if not shown then return end
            GameTooltip_SetDefaultAnchor(GameTooltip, self)
            GameTooltip:SetUnit(shown)
            -- 0.17: a module's own lines after the unit's (the player frame's rested lines)
            local more = self.onTooltip
            if more then more(self, GameTooltip) end
            GameTooltip:Show()
        end)
        self:SetScript("OnLeave", function() GameTooltip:Hide() end)

        -- The ground and, clipped inside the 1px border, the bars.
        self.ground = draw.fill(self, "surface-sunk")
        self.ground:SetAllPoints()
        self.inner = CreateFrame("Frame", nil, self)
        self.inner:SetPoint("TOPLEFT", 1, -1)
        self.inner:SetPoint("BOTTOMRIGHT", -1, 1)
        self.inner:SetClipsChildren(true)

        self.ghost = bar(self, 1, "ghost")
        self.ghost:SetAllPoints(self.inner)
        self.health = bar(self, 2)
        self.health:SetAllPoints(self.inner)
        -- opts.crest (0.17): the rare and elite crest on the top edge over the
        -- right end (design "Rare and elite units" B)
        if opts.crest then
            local c = crest.crest(self, "frame")
            self.crest = c
            c:SetPoint("CENTER", self, "TOPRIGHT", -64, -0.5)
            -- opts.dragon (0.17): the game's own dragon instead, over the bars
            -- (as Blizzard draws it over its frame) and under the name and
            -- numbers; under the bar its head was hidden (seen in game)
            local host = CreateFrame("Frame", nil, self)
            self.dragonHost = host
            host:SetAllPoints()
            host:SetFrameLevel(self:GetFrameLevel() + 7)
            local dragon = host:CreateTexture(nil, "ARTWORK")
            dragon:Hide()
            self.dragon = dragon
        end
        gradient(self.health, "unit-fill-deep", "unit-fill")
        self.healthLow = bar(self, 3)
        self.healthLow:SetAllPoints(self.inner)
        gradient(self.healthLow, "unit-fill-low-deep", "unit-fill-low")
        self.healthLow:SetAlpha(0)

        -- The low-health tint: ember over the empty part of the bar, from the
        -- fill's edge to the bar's end; the engine sets its strength (a curve).
        self.tint = self.health:CreateTexture(nil, "BACKGROUND")
        self.tint:SetPoint("TOPLEFT", self.health:GetStatusBarTexture(), "TOPRIGHT")
        self.tint:SetPoint("BOTTOMRIGHT", self.inner, "BOTTOMRIGHT")
        draw.paintFill(self.tint, "ember")
        self.tint:SetAlpha(0)

        -- Incoming heals, then absorbs, each starting where the one before ends.
        self.incoming = bar(self, 4, "fel-incoming")
        self.incoming:SetPoint("TOPLEFT", self.health:GetStatusBarTexture(), "TOPRIGHT")
        self.incoming:SetPoint("BOTTOMLEFT", self.health:GetStatusBarTexture(), "BOTTOMRIGHT")
        self.incoming:SetWidth(w - 2)
        self.absorb = bar(self, 5)
        self.absorb:SetStatusBarTexture(HATCH)
        local hatch = self.absorb:GetStatusBarTexture()
        hatch:SetHorizTile(true)
        hatch:SetVertTile(true)
        draw.paint(self.absorb, "ward-absorb")
        self.absorb:SetPoint("TOPLEFT", self.incoming:GetStatusBarTexture(), "TOPRIGHT")
        self.absorb:SetPoint("BOTTOMLEFT", self.incoming:GetStatusBarTexture(), "BOTTOMRIGHT")
        self.absorb:SetWidth(w - 2)

        -- The power line: along the bottom; inside the anchor frame on the player.
        self.power = bar(self, 6, "mana")
        self.powerLow = bar(self, 7, "amber")
        self.powerLow:SetAlpha(0)
        local inset = opts.anchor and 3 or 0
        for _, b in ipairs({ self.power, self.powerLow }) do
            b:ClearAllPoints()
            b:SetPoint("BOTTOMLEFT", self.inner, "BOTTOMLEFT", inset, inset)
            b:SetPoint("BOTTOMRIGHT", self.inner, "BOTTOMRIGHT", -inset, inset)
            b:SetHeight(S["space-1"])
        end

        -- Everything drawn over the bars: border, anchor frame, text, badges.
        local o = CreateFrame("Frame", nil, self)
        o:SetAllPoints()
        o:SetFrameLevel(self:GetFrameLevel() + 9)
        self.over = o
        self.border = draw.border(o, opts.anchor and "gilt-line" or "gilt-hairline")
        if opts.anchor then
            local rings = T.shadow["inset-anchor"]
            draw.border(o, rings[1].color, { width = rings[1].spread, inset = 1 })
            draw.border(o, rings[2].color, { width = 1, inset = 1 + rings[1].spread })
            draw.diamond(o, 7, "gilt"):SetPoint("CENTER", self, "TOPLEFT", 0, 0)
            draw.diamond(o, 7, "gilt"):SetPoint("CENTER", self, "BOTTOMRIGHT", 0, 0)
        end
        self.glow = draw.shadow(self, "glow-ember")
        self.glow:SetShown(false)

        -- The row (marker, name, meta, badges) is clipped where the health % slot
        -- begins, so a long name never runs into it, even when it is secret.
        self.row = CreateFrame("Frame", nil, o)
        self.row:SetPoint("TOPLEFT", size.pad, 0)
        self.row:SetClipsChildren(true)
        self.role = o:CreateTexture(nil, "OVERLAY")
        self.role:SetSize(size.role, size.role)
        self.classDot = draw.diamond(o, opts.size == "sm" and 4 or 5, "ink")
        self.name = uiText.text(self.row, size.name, "ink")
        self.name:SetShadowed(true)
        self.name:SetWordWrap(false)
        self.meta = uiText.text(self.row, "caption", "ink")
        self.meta:SetShadowed(true)
        -- The state badge (Aggro…) at the row's end, where a debuff type's badge
        -- shows too: one spot, one badge. Its layer sits under the debuff-type
        -- slots (SetDispelBadges), so a debuff you may need to remove covers
        -- Aggro while both are up (a healer must see the curse on the tank); the
        -- ember glow still says aggro.
        self.stateLayer = CreateFrame("Frame", nil, o)
        self.stateLayer:SetAllPoints(self)
        self.stateLayer:SetFrameLevel(o:GetFrameLevel() + 1)
        self.badge = controls.stateBadge(self.stateLayer, "danger", "")
        self.badge:SetPoint("RIGHT", self.row, "RIGHT", 0, 0)
        self.badge:Hide()
        self.you = controls.stateBadge(self.row, "neutral", "you")
        self.you:SetShown(opts.you == true or opts.youWhenPlayer == true)
        self.right = uiText.text(o, "numeric", "ink")
        self.right:SetShadowed(true)
        self.right:SetPoint("RIGHT", -size.pad, 0)

        -- The raid target marker: centred on the top edge, standing over it, on
        -- its own layer above the borders, badges and the selection.
        self.markerLayer = CreateFrame("Frame", nil, self)
        self.markerLayer:SetAllPoints()
        self.markerLayer:SetFrameLevel(o:GetFrameLevel() + 10)
        self.markerLayer:EnableMouse(false)
        self.marker = raidMarker(self.markerLayer, size.marker)
        self.marker:SetPoint("TOP", self, "TOP", 0, size.rise)
        self:FitRow() -- the row ends where the health text (and reserved room) begins
        extend.add(extend.Kind.UnitFrame, self, { unit = unit, name = self:GetName(), preview = opts.api ~= nil or nil })
    end

    function UpdateHealth(instant: boolean?)
        local A = self.api
        local u = self.unit
        if not u then return end
        local dead = uiText.flag(A.UnitIsDeadOrGhost(u))
        local offline = isOffline(A, u)
        -- dead or offline: an empty bar
        local gone = dead or offline
        local max = A.UnitHealthMax(u)
        for _, b in ipairs({ self.health, self.healthLow, self.ghost, self.incoming, self.absorb }) do
            b:SetMinMaxValues(0, amount(max))
        end
        local cur = gone and 0 or amount(A.UnitHealth(u))
        self.health:SetValue(cur)
        self.healthLow:SetValue(cur)
        local percent = A.UnitHealthPercent
        if self.opts.lowHealth == false or not percent then
            self.healthLow:SetAlpha(0)
        else
            self.healthLow:SetAlpha(gone and 0 or curveAmount(percent(u, true, belowCurve(LOW_HEALTH))))
        end
        local tint = self.opts.lowTint and not gone and lowTintCurve()
        -- (plain ifs: `x and secret or 0` would test the secret)
        local tintAlpha: number | Secret<number> = 0
        if tint and percent then tintAlpha = curveAmount(percent(u, true, tint)) end
        self.tint:SetAlpha(tintAlpha)

        -- The ghost trails the fill: after a hold, the engine eases it down.
        if instant or not INTERPOLATE then
            local held = self.ghostTimer
            if held then held:Cancel(); self.ghostTimer = nil end
            self.ghost:SetValue(cur)
        else
            self.ghostValue = cur
            if not self.ghostTimer then
                self.ghostTimer = timer.after(GHOST_HOLD, function()
                    self.ghostTimer = nil
                    self.ghost:SetValue(self.ghostValue, INTERPOLATE)
                end)
            end
        end

        local noIncoming = gone or self.opts.incoming == false
        local heals: (number | Secret<number>)?, absorbs: (number | Secret<number>)? = nil, nil
        if not noIncoming and UnitGetIncomingHeals then heals = A.UnitGetIncomingHeals(u) end
        if not noIncoming and UnitGetTotalAbsorbs then absorbs = A.UnitGetTotalAbsorbs(u) end
        self.incoming:SetValue(amount(heals))
        self.absorb:SetValue(amount(absorbs))

        if gone then
            self.right:SetStyle("caption")
            self.right:SetColor("ink-muted")
            self.right:SetValue(offline and "Offline" or (uiText.flag(A.UnitIsGhost(u)) and "Ghost" or "Dead"))
        elseif self.opts.healthText ~= "none" and (self.opts.size ~= "sm" or self.opts.textOnSmall) then
            self.right:SetStyle("numeric")
            self.right:SetColor("ink")
            local mode = self.opts.healthText or "percent"
            -- plain ifs: `x and secret or nil` would test the secret
            local pct: number | Secret<number> | nil = nil
            local value: ShortNumber? = nil
            if mode ~= "value" then pct = healthPercent(A, u) end
            if mode ~= "percent" then value = shortNumber(cur) end
            -- secret parts go to the engine's own formatting, never through Lua
            if isSecret(pct) or isSecret(value) then
                -- (a part that is missing: empty, 0)
                local shownValue: ShortNumber = ""
                if isSecret(value) then shownValue = value elseif value then shownValue = value end
                local shownPct: number | Secret<number> = 0
                if isSecret(pct) then shownPct = pct elseif pct then shownPct = pct end
                if mode == "value" then
                    self.right:SetFormattedText("%s", shownValue)
                elseif mode == "both" then
                    self.right:SetFormattedText("%s · %d%%", shownValue, shownPct)
                else
                    self.right:SetFormattedText("%d%%", shownPct)
                end
                self.right.value = nil
            elseif mode == "value" then
                self.right:SetValue(value or "")
            elseif mode == "both" then
                self.right:SetValue(pct and ("%s · %d%%"):format(value or "", pct + 0.5) or (value or ""))
            else
                self.right:SetValue(pct and ("%d%%"):format(pct + 0.5) or "")
            end
        else
            self.right:SetValue("")
        end
        if self.dead ~= dead or self.offline ~= offline then
            local power = self.offline ~= offline
            self.dead, self.offline = dead, offline
            self:UpdateIdentity()
            if power then self:UpdatePower() end -- an offline unit has none
        end
        local after = self.onHealth
        if after then after(self) end
    end

    function UpdatePower()
        local A = self.api
        local u = self.unit
        local powerFor = self.opts.powerFor
        if not u or self.offline or self.opts.power == false or (powerFor and not powerFor(u, A)) then
            self.power:Hide()
            self.powerLow:Hide()
            return
        end
        local pType, token = A.UnitPowerType(u)
        local max = A.UnitPowerMax(u, pType)
        local shown = isSecret(max) or (max or 0) > 0
        self.power:SetShown(shown)
        self.powerLow:SetShown(shown and token == "MANA")
        if not shown then return end
        draw.paint(self.power, token and POWER_TOKEN[token] or "mana")
        self.power:SetMinMaxValues(0, amount(max))
        self.power:SetValue(amount(A.UnitPower(u, pType)))
        if token == "MANA" then
            self.powerLow:SetMinMaxValues(0, amount(max))
            self.powerLow:SetValue(amount(A.UnitPower(u, pType)))
            self.powerLow:SetAlpha(curveAmount(A.UnitPowerPercent(u, pType, true, belowCurve(LOW_MANA))))
        end
    end

    function ShowDragon(art: crest.DragonArt | false | nil)
        local dragon = self.dragon
        if dragon then crest.placeDragon(dragon, art, self, self:GetHeight()) end
    end

    function UpdateIdentity()
        local A = self.api
        local u = self.unit
        if not u or not A.UnitExists(u) then return end

        -- The marker before the name: a role icon, else the class diamond.
        local role = UnitGroupRolesAssigned and A.UnitGroupRolesAssigned(u)
        local isPlayer = uiText.flag(A.UnitIsPlayer(u))
        local _, class = A.UnitClass(u)
        local classColor: string? = nil
        if isPlayer and not isSecret(class) and class then
            classColor = "class-" .. class:lower()
            local colors: { [string]: unknown } = T.color
            if not colors[classColor] then classColor = nil end
        end
        self.role:Hide()
        self.classDot:Hide()
        local marker: Texture? = nil
        if not isSecret(role) and role and ROLE_ICON[role] then
            self.role:SetTexture(ROLE_ICON[role])
            draw.paint(self.role, role == "DAMAGER" and "ink-muted" or "ink")
            self.role:Show()
            marker = self.role
        elseif classColor then
            draw.paint(self.classDot, classColor)
            self.classDot:Show()
            marker = self.classDot
        end

        -- The name: class colour for players, reaction colour for hostile and
        -- neutral NPCs, ink for friendly ones; ink-faint when dead or offline.
        self.name:SetValue((A.UnitName(u)))
        if self.dead or self.offline then
            self.name:SetColor("ink-faint")
        elseif self.opts.nameColor == "ink" then
            self.name:SetColor("ink")
        elseif classColor then
            self.name:SetColor(classColor)
        else
            local r = A.UnitReaction(u, "player")
            if isSecret(r) or not r then
                self.name:SetColor("ink")
            elseif r <= 3 then
                self.name:SetColor("reaction-hostile")
            elseif r == 4 then
                self.name:SetColor("reaction-neutral")
            else
                self.name:SetColor("ink")
            end
        end
        local shield = self.crest
        if shield then
            local classify, boss = A.UnitClassification, A.UnitIsBossMob
            local c = not isPlayer and classify and classify(u) or nil
            local dragon = self.opts.dragon and crest.dragonArt(c, boss and boss(u) or nil)
            shield:SetClassification(not dragon and c or nil)
            self:ShowDragon(dragon)
        end
        local meta = self.opts.meta
        if meta == "family" then
            local family = A.UnitCreatureFamily(u)
            self.meta:SetValue((not isSecret(family) and family) or "")
        else
            self.meta:SetValue(meta and metaText(A, u) or "")
            -- the level in its difficulty's colour (a secret one: as it is)
            if meta then
                local level = A.UnitLevel(u)
                if not isSecret(level) then self.meta:SetColor(levelColor(level)) end
            end
        end
        if self.opts.youWhenPlayer then
            -- "Is it you?" is a secret boolean in combat: the engine sets the
            -- badge's alpha from it. The badge keeps its place either way.
            local isYou = A.UnitIsUnit(u, "player")
            if isSecret(isYou) then
                self.you:SetAlphaFromBoolean(isYou, 1, 0)
            else
                self.you:SetAlpha(isYou and 1 or 0)
            end
        end
        self:LayoutRow(marker)
    end

    function UpdateRaidMarker()
        if self.opts.raidMarker == false then
            self.marker:Hide()
            return
        end
        showRaidMarker(self.marker, self.unit, self.api)
    end

    -- marker, name, meta, badges ... health %, in one row; the name gives way.
    function LayoutRow(marker: Texture?)
        local size = self.size
        local x = 0
        for _, m in ipairs({ self.role, self.classDot }) do m:ClearAllPoints() end
        if marker then
            marker:SetPoint("LEFT", self.row, "LEFT", marker == self.classDot and 2 or 0, 0)
            x = (marker == self.role and size.role or 5) + size.gap
        end

        -- the state badge has its own spot at the row's end (the name leaves
        -- room for it); "you" follows the name
        local badges: controls.StateBadge[] = {}
        if self.you:IsShown() then badges[#badges + 1] = self.you end
        local endW = self.badge:IsShown() and (self.badge.knownWidth + size.gap) or 0
        -- Never read sizes back from the meta or the badges: they are anchored
        -- after the name, and a secret name makes their geometry secret too.
        local metaValue = tostring(self.meta.value or "")
        local tailW = 0
        if metaValue ~= "" then tailW = tailW + size.gap + uiText.measureText("caption", metaValue) end
        for _, b in ipairs(badges) do tailW = tailW + size.gap + b.knownWidth end

        -- A readable name sizes itself to its text and the meta and badges follow
        -- it, as the design draws it; a name that would crowd them out gets a
        -- width, which adds the ellipsis. A secret name (an enemy in combat)
        -- can't be measured: it gets the room the meta and badges leave, the
        -- engine adds the ellipsis, and they sit at the row's right end instead.
        local natural = self.name:GetUnboundedStringWidth()
        local room = self.row:GetWidth() - x - tailW - endW
        self.name:ClearAllPoints()
        self.name:SetPoint("LEFT", self.row, "LEFT", x, 0)
        local secretName = isSecret(natural)
        if isSecret(natural) then
            self.name:SetWidth(math.max(1, room))
        elseif natural > room and room > 20 then
            self.name:SetWidth(room)
        else
            self.name:SetWidth(0)
        end

        if self.opts.size == "sm" or secretName then
            -- right to left from the row's end (after the state badge's spot, if
            -- it shows): the badges, then the meta
            local after: Region? = self.badge:IsShown() and self.badge or nil
            local function place(region: Region)
                region:ClearAllPoints()
                if after then region:SetPoint("RIGHT", after, "LEFT", -size.gap, 0)
                else region:SetPoint("RIGHT", self.row, "RIGHT", 0, 0) end
                after = region
            end
            for i = #badges, 1, -1 do place(badges[i]) end
            if metaValue ~= "" and self.opts.size ~= "sm" then place(self.meta) end
            if self.opts.size == "sm" then
                self.meta:ClearAllPoints()
                if metaValue ~= "" then self.meta:SetPoint("LEFT", self.name, "RIGHT", size.gap, 0) end
            end
            return
        end

        local prev: Region = self.name
        if metaValue ~= "" then
            self.meta:ClearAllPoints()
            self.meta:SetPoint("LEFT", prev, "RIGHT", size.gap, 0)
            prev = self.meta
        end
        for _, b in ipairs(badges) do
            b:ClearAllPoints()
            b:SetPoint("LEFT", prev, "RIGHT", size.gap, 0)
            prev = b
        end
    end

    -- The marker the row starts with: the role icon or the class diamond.
    function RowMarker(): Texture?
        if self.role:IsShown() then return self.role end
        if self.classDot:IsShown() then return self.classDot end
        return nil
    end

    function SetState(tone: string?, word: string?)
        if tone == self.stateTone and word == self.stateWord then return end
        self.stateTone, self.stateWord = tone, word
        self.border:SetColor(tone and STATE_BORDER[tone] or (self.opts.anchor and "gilt-line" or "gilt-hairline"))
        self.glow:SetShown(tone == "danger")
        if tone and word then
            self.badge:SetState(tone, word)
            self.badge:Show()
        else
            self.badge:Hide()
        end
        self:LayoutRow(self:RowMarker())
    end

    function FitRow()
        local size, opts = self.size, self.opts
        local textW = (opts.size == "sm" and not opts.textOnSmall) and 0 or (TEXT_W[opts.healthText or "percent"] or 34)
        local extra = opts.reserveRight or 0
        self.row:SetPoint("BOTTOMRIGHT", -(size.pad + (textW > 0 and textW + size.gap or 0) + extra), 0)
        self.right:ClearAllPoints()
        self.right:SetPoint("RIGHT", -(size.pad + extra), 0)
    end

    function Resize(w: number, h: number)
        self:SetSize(w, h)
        self.incoming:SetWidth(w - 2)
        self.absorb:SetWidth(w - 2)
        if self.active then self:Refresh() end
    end

    -- Live indicators: out of combat (containers are made here). The engine
    -- never frees a container, so each frame keeps its containers by identity
    -- and reuses them: changing one indicator builds one new container, and
    -- going back to an earlier look reuses the old one. Unused ones are unbound
    -- and hidden.
    function SetIndicators(list: Indicator[]?)
        for _, c in ipairs(self.indicatorContainers) do
            c.container:Hide()
            c:SetUnit("none")
        end
        self.indicatorContainers = {}
        -- the missing looks: plain frames, kept by identity too
        for _, m in ipairs(self.missingLooks) do m.look:Hide() end
        self.missingLooks = {}
        for _, ind in ipairs(list or {}) do
            local show = ind.show or "up"
            if ind.kind == "fill" and show == "both" then show = "up" end
            if show ~= "up" then
                local mkey = indicatorKey(ind) .. "|" .. show .. "|" .. (ind.missingColor or "ember")
                local look = self.missingCache[mkey]
                if not look then
                    look = indicatorLook(self, self, ind, indicatorArt(ind), true)
                    self.missingCache[mkey] = look
                end
                self.missingLooks[#self.missingLooks + 1] = { look = look, mode = show, ind = ind }
            end
        end
        for i, ind in ipairs(list or {}) do
            local key = indicatorKey(ind)
            local cached = self.indicatorCache[key]
            local ids = ind.ids
            if ind.show == "missing" then
                -- only the missing look: no live container
            elseif cached then
                cached.container:Show()
                cached:SetUnit(self.unit or "none")
                indicatorOf[cached] = ind
                self.indicatorContainers[#self.indicatorContainers + 1] = cached
            elseif ids and #ids > 0 then
                local filter = ind.source == "any" and { "HELPFUL" } or { "HELPFUL", "PLAYER" }
                local group: AuraGroup = { key = "i" .. i, filter = filter, max = 1, include = ids }
                local opts: AuraOptions = { size = ind.size or 10, anchor = "TOPLEFT", groups = { group } }
                if ind.kind == "icon" then
                    group.stacks, group.digits = false, (ind.size or 10) >= 16
                else
                    group.initialize = function(button: AuraButton)
                        quietButton(button)
                        indicatorLook(self, button, ind)
                    end
                end
                local c = auraContainer(self, self.unit or "none", opts)
                if c then
                    if ind.kind == "icon" then
                        -- the engine lays its one icon from the container's top
                        -- left; place that corner so the icon sits at the point
                        local point: FramePoint = ind.point or "TOPRIGHT"
                        local size = ind.size or 10
                        local x, y = pointOffset(point)
                        local dx = point:find("RIGHT") and size or ((point:find("LEFT")) and 0 or size / 2)
                        local dy = point:find("BOTTOM") and size or ((point:find("TOP")) and 0 or size / 2)
                        c.container:SetPoint("TOPLEFT", self, point, x - dx, y + dy)
                        c.container:SetFrameLevel(self.over:GetFrameLevel() + 8)
                    else
                        c.container:SetPoint("TOPLEFT", self, "TOPLEFT")
                        c.container:SetFrameLevel(self.over:GetFrameLevel() + 2)
                    end
                    self.indicatorCache[key] = c
                    indicatorOf[c] = ind
                    self.indicatorContainers[#self.indicatorContainers + 1] = c
                end
            end
        end
        self:UpdateIndicatorPresence()
    end

    -- The missing looks: "both" shows whenever the unit is there (the live look
    -- covers it); "missing" only out of combat, while none of its spells is up.
    -- "on = group" limits them, and the live looks, to your own raid group: the
    -- live containers of everyone else are hidden, out of combat (who is in
    -- your group is known before a fight; the engine still shows the aura).
    function UpdateIndicatorPresence()
        local u = self.unit
        local exists = u ~= nil and UnitExists(u)
        local fight = InCombatLockdown()
        local mine: boolean? = nil
        -- whether an indicator shows here: everywhere, or in your own group
        local function inScope(ind: Indicator): boolean
            if not (u and exists) or (ind.on or ind.missingOn) ~= "group" then return true end
            if mine == nil then mine = inYourGroup(u) end
            return mine == true
        end
        for _, m in ipairs(self.missingLooks) do
            local show = false
            if not inScope(m.ind) then
                show = false
            elseif exists and m.mode == "both" then
                show = true
            elseif u and exists and m.mode == "missing" and not fight then
                local ind = m.ind
                local set: { [number]: boolean } = {}
                for _, id in ipairs(ind.ids or {}) do set[id] = true end
                local filter = ind.source == "any" and "HELPFUL" or "HELPFUL|PLAYER"
                local up = false
                for i = 1, 40 do
                    local ok, a = pcall(C_UnitAuras.GetAuraDataByIndex, u, i, filter)
                    if not ok or isSecret(a) or not a then break end
                    local id = a.spellId
                    if not isSecret(id) and id and set[id] then up = true break end
                end
                show = not up
            end
            m.look:SetShown(show)
        end
        -- live looks limited to your group: everyone else's container is hidden
        -- (out of combat; in combat the last answer stays)
        if not fight then
            for _, c in ipairs(self.indicatorContainers) do
                local ind = indicatorOf[c]
                c.container:SetShown(not ind or inScope(ind))
            end
        end
    end

    -- Preview indicators: the looks drawn directly, as if every aura were up
    -- (a "missing" one as missing, so its look can be judged). Frames are never
    -- freed either, so the looks are kept by identity, as the missing looks are.
    function SetPreviewIndicators(list: Indicator[]?)
        for _, look in ipairs(self.previewLooks) do look:Hide() end
        self.previewLooks = {}
        for _, ind in ipairs(list or {}) do
            local missing = ind.show == "missing"
            local key = indicatorKey(ind) .. "|" .. (missing and ("missing|" .. (ind.missingColor or "ember")) or "up")
            local look = self.previewCache[key]
            if not look then
                look = indicatorLook(self, self, ind, indicatorArt(ind), missing)
                self.previewCache[key] = look
            end
            look:Show()
            self.previewLooks[#self.previewLooks + 1] = look
        end
    end

    -- keepAttribute: the unit attribute is already set (a group header did it)
    function SetUnit(unit: string?, keepAttribute: boolean?)
        if unit == self.unit then return end
        local wasActive = self.active
        if wasActive then self:Deactivate() end
        self.unit = unit
        if self.opts.secure ~= false and not keepAttribute then self:SetAttribute("unit", unit) end
        for _, list in pairs(self.dispelSets) do
            for _, c in ipairs(list) do c:SetUnit(unit or "none") end
        end
        for _, c in ipairs(self.indicatorContainers) do c:SetUnit(unit or "none") end
        local ward = self.wardSlot
        if ward then ward:SetUnit(unit or "none") end
        self:UpdateIndicatorPresence()
        if wasActive and unit then self:Activate() end
    end

    -- The type's border and badge over this frame, on `parent` (a slot's button,
    -- or the frame itself in a preview).
    function DispelDecoration(parent: Frame, kind: string): Frame
        local tone = kind:lower()
        local deco = CreateFrame("Frame", nil, parent)
        deco:SetAllPoints(self)
        deco:EnableMouse(false)
        draw.border(deco, "dispel-" .. tone)
        local badge = controls.stateBadge(deco, tone, kind)
        badge:SetPoint("RIGHT", self.row, "RIGHT", 0, 0)
        -- at least as wide as the Aggro badge it covers, so none of it peeks out
        badge:SetWidth(math.max(badge.knownWidth, uiText.measureText("badge", "Aggro") + 10))
        -- over the frame's own border and text and over Warded; Magic on top,
        -- then down the list
        local rank = 1
        for i, k in ipairs(DEBUFF_TYPES) do if k == kind then rank = i end end
        deco:SetFrameLevel(self.over:GetFrameLevel() + 3 + (#DEBUFF_TYPES - rank))
        return deco
    end

    -- "all" (every type), "removable" (only what you can remove) or "off". Out of
    -- combat: the first use of a set creates its containers.
    function SetDispelBadges(mode: string)
        if (mode == "all" or mode == "removable") and not self.dispelSets[mode] then
            self.dispelSets[mode] = buildDispelSet(self, mode)
        end
        for set, list in pairs(self.dispelSets) do
            for _, c in ipairs(list) do c.container:SetShown(set == mode) end
        end
    end

    -- The ward border, badge and glow over this frame, on `parent` (the slot's
    -- button, or the frame itself in a preview).
    function WardDecoration(parent: Frame): WardDecoration
        return WardDecoration.new(parent, self)
    end

    -- The spells that ward this frame (nil or empty: none). Out of combat: the
    -- first call creates the slot.
    function SetWardSpells(given: number[]?)
        local ids = given or {}
        local slot = self.wardSlot
        if slot then
            slot:SetGroupSpells("ward", ids)
            return
        end
        if #ids == 0 then return end
        local init = function(button: AuraButton)
            quietButton(button)
            self:WardDecoration(button)
        end
        local c = auraContainer(self, self.unit or "none", { size = 1, anchor = "TOPLEFT",
            groups = { { key = "ward", filter = { "HELPFUL" }, max = 1, include = ids, initialize = init } } })
        if c then
            c.container:SetPoint("TOPLEFT", self, "TOPLEFT")
            c.container:SetFrameLevel(self.over:GetFrameLevel() + 1)
            self.wardSlot = c
        end
    end

    function Refresh()
        local A = self.api
        local u = self.unit
        self:FitRow()
        if not u or not A.UnitExists(u) then return end
        self.dead = uiText.flag(A.UnitIsDeadOrGhost(u))
        self.offline = isOffline(A, u)
        self:UpdateIdentity()
        self:UpdateHealth(true)
        self:UpdatePower()
        self:UpdateRaidMarker()
    end

    function Activate()
        local u = self.unit
        if self.active or not u then return end
        self.active = true
        for _, e in ipairs(HEALTH_EVENTS) do onUnit(self, u, e, function() self:UpdateHealth() end) end
        for _, e in ipairs(POWER_EVENTS) do onUnit(self, u, e, function() self:UpdatePower() end) end
        for _, e in ipairs(IDENTITY_EVENTS) do onUnit(self, u, e, function() self:UpdateIdentity() end) end
        -- going offline or coming back: the bar, the text, the name and the power line
        onUnit(self, u, "UNIT_CONNECTION", function() self:Refresh() end)
        events.onGame("RAID_TARGET_UPDATE", function() self:UpdateRaidMarker() end, self)
        events.onGame("PLAYER_ENTERING_WORLD", function() self:Refresh() end, self)
        -- a group unit can become another person: redraw everything
        local grouped = u:find("^party") or u:find("^raid")
        -- a role change moves the marker and may turn the power line on or off
        -- (powerFor: tanks and healers)
        events.onGame("GROUP_ROSTER_UPDATE", function()
            if grouped then self:Refresh() else self:UpdateIdentity(); self:UpdatePower() end
        end, self)
        events.onGame("PLAYER_ROLES_ASSIGNED", function() self:UpdateIdentity(); self:UpdatePower() end, self)
        if u == "target" then
            events.onGame("PLAYER_TARGET_CHANGED", function() self:Refresh() end, self)
        elseif u == "focus" then
            events.onGame("PLAYER_FOCUS_CHANGED", function() self:Refresh() end, self)
        elseif u == "targettarget" then
            events.onGame("PLAYER_TARGET_CHANGED", function() self:Refresh() end, self)
            -- your target picks another target: UNIT_TARGET fires for "target"
            -- (never for "targettarget"), and the poll only redraws health
            events.onUnit("UNIT_TARGET", "target", function() self:Refresh() end, self)
        elseif u == "pet" then
            events.onUnit("UNIT_PET", "player", function() self:Refresh() end, self)
        elseif u:find("^boss") then
            events.onGame("INSTANCE_ENCOUNTER_ENGAGE_UNIT", function() self:Refresh() end, self)
        end
        local poll = self.opts.poll
        if poll then
            -- A unit with no events of its own: redraw while shown.
            self.ticker = timer.every(poll, function()
                local now = self.unit
                if self:IsVisible() and now and UnitExists(now) then
                    self:UpdateHealth(true)
                    self:UpdatePower()
                end
            end)
        end
        self:Refresh()
    end

    function Deactivate()
        if not self.active then return end
        self.active = false
        events.offAll(self)
        local ticker = self.ticker
        if ticker then ticker:Cancel(); self.ticker = nil end
    end
end
mixins.UnitFrame = UnitFrame

-- A unit frame (Raw.Mixins.UnitFrame is the class). opts.frame: a button a
-- group header made (SecureUnitButtonTemplate), which becomes the frame.
export function unitFrame(parent: Frame?, unit: string?, opts: UnitFrameOptions?): UnitFrame
    local o: UnitFrameOptions = opts or {}
    local frame = o.frame
    if frame then return UnitFrame.adopt(frame, parent, unit, o) end
    return UnitFrame.new(parent, unit, o)
end
