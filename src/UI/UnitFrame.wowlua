-- UI/UnitFrame.wowlua
-- The unit frame: the bar is the frame. One bar with the unit's name, meta,
-- state badge and health % inside it, its power as a line along the bottom.
--
--   local f = unitFrame(parent, "target", {
--       size = "lg",        -- lg (player, target), md (party, focus, boss, pet), sm (raid, target of target)
--       width = nil,        -- default: the size's bar token
--       anchor = false,     -- the player frame's double gilt frame and two diamonds
--       you = false,        -- the "you" badge
--       meta = false,       -- after the name: true for level and classification, "family" for a pet's family
--       crest = false,      -- 0.17: the rare and elite crest (target, focus)
--       dragon = false,     -- 0.17: with crest, the game's elite dragon in its place
--       poll = nil,         -- seconds: redraw on a timer, for units with no events (targettarget)
--       power = true,       -- the power line
--       healthText = "percent", -- "value" (12.3k), "both" (12.3k · 64%) or "none"
--       nameColor = "game", -- class colour (players) or reaction colour (NPCs); "ink" for plain names
--       secure = true,      -- a SecureUnitButtonTemplate button: left click targets, right click opens the menu
--       name = "SuuUIPlayerFrame",
--       height = nil,       -- px or token; default: the size's height
--       lowHealth = true,   -- the low-health fill (false: never)
--       lowTint = false,    -- the low-health tint: the empty part of the bar warms
--                           -- to ember from 70% down to 10% (the healer layout)
--       tapped = false,     -- 0.24: a mob tagged by someone else slate and striped (target, ToT, focus)
--       incoming = true,    -- incoming heals and absorbs (false: never)
--       powerFor = nil,     -- fn(unit, api) -> bool: which units get the power line
--       powerCost = true,   -- 0.34: the player's frame: your cast's cost faded
--                           -- at the power line's end (UI/PowerCost)
--       frame = nil,        -- style this button instead of making one (a group
--                           -- header's child; the header sets its unit)
--       reserveRight = 0,   -- px kept free at the bar's right end (inline auras)
--       textOnSmall = false, -- health text on an sm frame too (raid frames)
--       raidMarker = true,  -- the raid target marker (skull, cross…) over the top edge
--       badgeTop = false,   -- the state badges (Aggro, Warded, the debuff types)
--                           -- on the top edge at the right, a little smaller,
--                           -- instead of at the row's end (the healer frames:
--                           -- design "Healer frame badges" 2, 2026-11-08);
--                           -- f:PlaceBadges() after it changes
--       nameUnderIcons = false, -- with no health text: the row (the name) runs
--                           -- to the right end, under reserveRight's icons,
--                           -- which cover its end when they show (the healer
--                           -- frames, asked 2026-11-08); f:FitRow() after
--       api = nil,          -- a stand-in for the game's Unit* functions (previews);
--                           -- such a frame isn't activated, call :Refresh()
--       rosterRefresh = true, -- false: a group module's frame, which redraws
--                           -- nothing itself on a roster or role change: its
--                           -- module calls f:RosterUpdate() once per burst
--   })
--   f:SetUnit(unit)          -- another unit (out of combat: it's a secure button)
--   f:SetUnit(unit, true, true) -- a header's new token: only the events follow
--                            -- now; the owner's next f:RosterUpdate() draws it
--   f:RosterUpdate()         -- after a roster change (the owner's pass): someone
--                            -- else on the token is drawn anew and their auras
--                            -- re-scanned; the same person only gets what a
--                            -- roster change can change (role, raid group)
--   f:SetDispelBadges(mode)  -- "all", "removable" or "off": debuff-type border
--                            -- and badge, in combat too (out of combat to set)
--   f:Resize(width, height)  -- out of combat
--   f:Activate()   -- starts listening to the unit's events and draws it
--   f:Deactivate()
--   f:SetState(tone, word)   -- a state border and badge ("danger", "Aggro"); nil clears it
--   f:UpdateRaidMarker()     -- redraws the marker (after opts.raidMarker changes)
--   f:Refresh()
--   f.onTooltip = fn(f, tooltip)  -- 0.17: adds lines to the frame's tooltip after the unit's
--
-- A disconnected player shows "Offline" where the health text goes, the bar
-- empty and the name faint, as a dead unit does.
--
-- Events mark, one driver draws: a health event only notes what it changed
-- (the values, the range, or the heals and shields on the way), and the
-- driver's next frame draws each frame once (a heal raises three events).
-- A hidden frame keeps what it missed and draws it when it shows. Roster,
-- role, raid marker, world and theme changes are one listener each for all
-- the active frames; the roster's is drawn once a frame too.
--
-- Secret values: health, max health, power, incoming heals and absorbs go
-- straight to StatusBars, which take them as they are. The health % text is
-- UnitHealthPercent through CurveConstants.ScaleTo100, which the engine
-- evaluates and returns as a clean 0-100. The low-health fill and low-mana
-- amber are second bars whose alpha comes from a step curve evaluated by the
-- engine, so no Lua code ever compares a value that might be secret.

import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as timer from "wowlua:timer"
import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as dress from "./Dress"
import watchUnit from "wowlua:events"
import type UnitWatch from "wowlua:events"
import * as events from "/Core/Events"
import * as fault from "/Core/Fault"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as controls from "/UI/Controls"
import * as iconModule from "/UI/Icon"
import * as crest from "/UI/Crest"
import * as healthFill from "/UI/HealthFill"
import * as powerCost from "/UI/PowerCost"
import type CastCost, CostApi from "/UI/PowerCost"
import auraContainer, UnitAuras, AuraGroup, AuraOptions, AuraButton from "/UI/Auras"

const S = T.space

-- each role's icon: its texture token (a theme's own)
local ROLE_ICON: { [string]: string } = { TANK = "role-tank", HEALER = "role-healer", DAMAGER = "role-damage" }

-- marker: the raid target marker's size; rise: how far it stands over the
-- top edge (less on sm, whose frames sit a few px apart in a raid grid)
type Size = {
    height: string,
    width: string,
    name: string,
    role: number,
    -- the inner padding and the gap between the row's parts: spacing tokens,
    -- worked out into px (pad, gap) by resolveSizes
    padToken: string,
    gapToken: string,
    pad: number,
    gap: number,
    marker: number,
    rise: number,
}
local SIZES: { [string]: Size } = {
    lg = {
        height = "unit-lg",
        width = "bar-lg",
        name = "unit-name-lg",
        role = 14,
        padToken = "space-4",
        gapToken = "space-3",
        pad = 0,
        gap = 0,
        marker = 18,
        rise = 8,
    },
    md = {
        height = "unit-md",
        width = "bar-md",
        name = "unit-name",
        role = 12,
        padToken = "space-4",
        gapToken = "space-3",
        pad = 0,
        gap = 0,
        marker = 16,
        rise = 7,
    },
    sm = {
        height = "unit-sm",
        width = "bar-sm",
        name = "unit-name-sm",
        role = 10,
        padToken = "space-3",
        gapToken = "space-2",
        pad = 0,
        gap = 0,
        marker = 14,
        rise = 4,
    },
}

-- Each size's padding and gap from the spacing now (at load, and when a
-- theme changes it: UnitFrame:PlaceByTheme).
local function resolveSizes()
    for _, size in pairs(SIZES) do
        size.pad, size.gap = S[size.padToken], S[size.gapToken]
    end
end
resolveSizes()

local LOW_HEALTH = 0.35 -- the design's lowAt
local LOW_MANA = 0.25

local POWER_TOKEN: { [string]: string } = { MANA = "mana", RAGE = "rage", ENERGY = "energy", FOCUS = "focus" }

-- wowlua:secret's secret.isSecret as a local predicate: an imported one doesn't
-- narrow in wowlua 0.9.1 while the project has an import cycle (port notes)

-- nil becomes 0; a secret value passes through untouched (never `v or 0`,
-- which would test a secret value's truth).
const amount = secret.amount

--------------------------------------------------------------------------------
-- Where a frame reads its unit from
--------------------------------------------------------------------------------

-- The Unit* functions a frame reads: the game's, or (opts.api) stand-ins with
-- the same signatures, for previews with made-up people (unitStandIn). The
-- optional ones are checked before use (not every client, or stand-in, has
-- them).
export type UnitApi = {
    UnitExists: typeof(UnitExists),
    UnitIsDeadOrGhost: typeof(UnitIsDeadOrGhost),
    UnitIsGhost: typeof(UnitIsGhost),
    UnitHealthMax: typeof(UnitHealthMax),
    UnitHealth: typeof(UnitHealth),
    UnitHealthPercent?: typeof(UnitHealthPercent),
    UnitGetIncomingHeals: typeof(UnitGetIncomingHeals),
    UnitGetTotalAbsorbs: typeof(UnitGetTotalAbsorbs),
    UnitPowerType: typeof(UnitPowerType),
    UnitPowerMax: typeof(UnitPowerMax),
    UnitPower: typeof(UnitPower),
    UnitPowerPercent: typeof(UnitPowerPercent),
    UnitLevel: typeof(UnitLevel),
    UnitClassification?: typeof(UnitClassification),
    UnitGroupRolesAssigned: typeof(UnitGroupRolesAssigned),
    UnitIsPlayer: typeof(UnitIsPlayer),
    UnitClass: typeof(UnitClass),
    UnitName: typeof(UnitName),
    UnitReaction: typeof(UnitReaction),
    UnitCreatureFamily: typeof(UnitCreatureFamily),
    UnitIsUnit: typeof(UnitIsUnit),
    UnitIsConnected?: typeof(UnitIsConnected),
    GetRaidTargetIndex?: typeof(GetRaidTargetIndex),
    UnitIsBossMob?: typeof(UnitIsBossMob),
    UnitThreatSituation?: typeof(UnitThreatSituation),
    UnitIsTapDenied?: typeof(UnitIsTapDenied),
    UnitPlayerControlled?: typeof(UnitPlayerControlled),
    -- your cast's cost on the player's power line (UI/PowerCost)
    C_Spell?: { GetSpellPowerCost: typeof(C_Spell.GetSpellPowerCost) },
    UnitChannelInfo?: typeof(UnitChannelInfo),
    GetTime?: typeof(GetTime),
}

-- Where the group is read from (the game's functions; stand-ins in tests).
export type GroupApi = {
    IsInRaid: typeof(IsInRaid),
    GetRaidRosterInfo: typeof(GetRaidRosterInfo),
    GetNumGroupMembers?: typeof(GetNumGroupMembers),
    UnitIsUnit: typeof(UnitIsUnit),
}

-- The game's functions, looked up when called (so a function replaced later,
-- as tests do, is the one used).
local gameProxy: unknown = setmetatable({}, {
    __index = function(_: unknown, k: string): unknown
        return _G[k]
    end,
})
local GAME = gameProxy :: UnitApi
local GROUP = gameProxy :: GroupApi

-- The game's unit functions as a UnitApi (looked up when called).
export function gameUnits(): UnitApi
    return GAME
end

-- CurveConstants.ScaleTo100 (declared as a plain table), nil where the
-- client has none.
local function scaleTo100(): CurveObjectBase?
    local constants = CurveConstants and CurveConstants :: { ScaleTo100?: CurveObjectBase }
    return constants and constants.ScaleTo100 or nil
end

--------------------------------------------------------------------------------
-- Curves: built once, evaluated by the engine with the unit's health or power.
--------------------------------------------------------------------------------

local curves: { [number]: CurveObject } = {}

-- A step curve that is 1 below `at` (a 0-1 fraction) and 0 from it up.
local function belowCurve(at: number): CurveObject
    local c = curves[at]
    if not c then
        c = C_CurveUtil.CreateCurve()
        c:SetType(Enum.LuaCurveType.Step)
        c:AddPoint(0, 1)
        c:AddPoint(at, 0)
        curves[at] = c
    end
    return c
end

-- The low-health tint's strength: none above TINT_FROM, rising to TINT_MAX
-- at TINT_FULL and below (the design: from 70% down to 10%). Linear between.
local TINT_FROM, TINT_FULL, TINT_MAX = 0.7, 0.1, 0.55
local TINT_POINTS: number[][] = { { 0, TINT_MAX }, { TINT_FULL, TINT_MAX }, { TINT_FROM, 0 }, { 1, 0 } }
-- nil: not made yet; false: this client can't make it
local tintCurve: CurveObject | false | nil = nil
local function lowTintCurve(): CurveObject?
    if tintCurve == nil then
        tintCurve = false
        local linear = Enum.LuaCurveType and Enum.LuaCurveType.Linear
        if C_CurveUtil and linear then
            local c = C_CurveUtil.CreateCurve()
            c:SetType(linear)
            for _, pt in ipairs(TINT_POINTS) do
                c:AddPoint(pt[1], pt[2])
            end
            tintCurve = c
        end
    end
    return tintCurve or nil
end

-- A curve's answer as an amount: a number (the curves here give numbers),
-- or the secret it is. A colour (never, with these curves) is 0.
type CurveResult = LuaCurveEvaluatedResult | Secret<LuaCurveEvaluatedResult> | nil
export function curveAmount(r: CurveResult): number | Secret<number>
    if secret.isSecret(r) then
        return r :: Secret<number>
    end
    return type(r) == "number" and r or 0
end

-- Health as a short number: 412, 8.5k, 12k, 1.2m. A secret value goes to
-- the game's AbbreviateNumbers, which returns a secret string the text can
-- still show (or the value itself, shown with %d).
-- (abbreviate: the game's AbbreviateNumbers, a parameter for tests)
type Abbreviate = (n: Secret<number>) -> (string | Secret<string>)
export type ShortNumber = string | Secret<string> | Secret<number>
local function shortNumber(v: number | Secret<number> | nil, abbreviate: Abbreviate = AbbreviateNumbers): ShortNumber?
    if secret.isSecret(v) then
        -- the answer is secret too: never tested, only returned
        local ok, text = pcall(abbreviate, v)
        if ok then
            return text
        end
        local ok2, plain = pcall(string.format, "%d", v)
        if ok2 then
            return plain
        end
        return v
    end
    if v == nil then
        return nil
    end
    if v >= 1e6 then
        return ("%.1fm"):format(v / 1e6)
    end
    if v >= 1e5 then
        return ("%dk"):format(v / 1e3 + 0.5)
    end
    if v >= 1e4 then
        return ("%.0fk"):format(v / 1e3)
    end
    if v >= 1e3 then
        return ("%.1fk"):format(v / 1e3)
    end
    return ("%d"):format(v + 0.5)
end

-- A player who has left the game. The answer is never secret for group
-- members; a secret one counts as connected.
local function isOffline(A: UnitApi, unit: string): boolean
    local connectedFn = A.UnitIsConnected
    if not connectedFn or not uiText.flag(A.UnitIsPlayer(unit)) then
        return false
    end
    local connected = connectedFn(unit)
    return not secret.isSecret(connected) and connected == false
end

-- The health % (0-100) the engine works out, nil where the client can't.
local function healthPercent(A: UnitApi, unit: string): number | Secret<number> | nil
    local percent, scale = A.UnitHealthPercent, scaleTo100()
    if percent and scale then
        return curveAmount(percent(unit, true, scale))
    end
    return nil
end

-- What one of the unit frame's curves gives for a 0-1 fraction, for
-- stand-ins (previews) that evaluate curves themselves.
export function unitFrameCurveValue(curve: unknown, x: number): number?
    for at, c in pairs(curves) do
        if c == curve then
            return x < at and 1 or 0
        end
    end
    if curve and curve == tintCurve then
        for i = 2, #TINT_POINTS do
            local a, b = TINT_POINTS[i - 1], TINT_POINTS[i]
            if x <= b[1] then
                return a[2] + (b[2] - a[2]) * (x - a[1]) / (b[1] - a[1])
            end
        end
        return 0
    end
    return nil
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

-- texture: its fill's texture token ("health-bar" by default, stretched);
-- tiled: a token whose texture repeats instead (the absorb hatch)
local function bar(f: UnitFrame, level: number, color: string?, texture: string?, tiled: string?): StatusBar
    local b = CreateFrame("StatusBar", nil, f.inner)
    if tiled then
        -- (the fill's own texture keeps the skin: the bar's would set the
        -- file again without the repeat)
        b:SetStatusBarTexture(draw.textureFile(tiled))
        draw.skin(b:GetStatusBarTexture(), tiled, true)
    else
        draw.skinBar(b, texture or "health-bar")
    end
    b:GetStatusBarTexture():SetSnapToPixelGrid(false)
    b:SetFrameLevel(f:GetFrameLevel() + level)
    b:SetMinMaxValues(0, 1)
    b:SetValue(0)
    if color then
        draw.paint(b, color)
    end
    return b
end

-- An unseen bar filled from the right, only for where its fill ends (the
-- shield past full health: anchors instead of sums on secret values).
local function geometryBar(parent: Frame): StatusBar
    local b = CreateFrame("StatusBar", nil, parent)
    b:SetStatusBarTexture("Interface\\Buttons\\WHITE8X8")
    b:GetStatusBarTexture():SetAlpha(0)
    b:GetStatusBarTexture():SetSnapToPixelGrid(false)
    b:SetReverseFill(true)
    b:SetMinMaxValues(0, 1)
    b:SetValue(0)
    b:EnableMouse(false)
    return b
end

local function gradient(b: StatusBar, deep: string, fill: string)
    draw.paintGradient(b:GetStatusBarTexture(), "HORIZONTAL", deep, fill)
end

--------------------------------------------------------------------------------
-- Drawing
--------------------------------------------------------------------------------

local CLASSIFICATION: { [string]: string } = {
    worldboss = "Boss",
    elite = "Elite",
    rareelite = "Rare Elite",
    rare = "Rare",
}

-- 0.17: a level's colour token by how hard it is for you (asked 2026-10-18:
-- green, yellow, orange, red, grey as the game rates it): the game's own
-- difficulty (its colour's font names it), drawn in the design's quest
-- colours. A level unknown (secret, "??") is impossible.
local DIFFICULTY_FONTS: string[][] = {
    { "VeryDifficult", "quest-very-difficult" },
    { "Impossible", "quest-impossible" },
    { "Difficult", "quest-difficult" },
    { "Standard", "quest-standard" },
    { "Trivial", "quest-trivial" },
}
-- getColor: the game's GetQuestDifficultyColor (a parameter for tests; nil
-- where the client has none). Its fonts are named "QuestDifficulty_<word>",
-- so the word is matched at the end (the prefix holds "Difficult" too).
type DifficultyColor = (level: number) -> unknown
local function difficultyColor(level: unknown, getColor: DifficultyColor?): string
    if level == nil or secret.isSecret(level) or type(level) ~= "number" or level <= 0 then
        return "quest-impossible"
    end
    if not getColor then
        return "quest-standard"
    end
    local ok, c = pcall(getColor, level)
    local font = ok and type(c) == "table" and (c :: { font?: unknown }).font
    if type(font) ~= "string" then
        return "quest-standard"
    end
    for _, d in ipairs(DIFFICULTY_FONTS) do
        if font:sub(-#d[1]) == d[1] then
            return d[2]
        end
    end
    return "quest-standard"
end

-- The highest level that gives a character of `level` no experience: the
-- classic rule (Forever's experience follows it). The game's colours grey a
-- level more than 5 below yours (UnitQuestTrivialLevelRange answers 5), a
-- quest's rule: at 44, mobs of 36 to 38 showed grey yet gave experience (a
-- player's report, 0.8.0).
local function greyLevel(level: number): number
    if level <= 5 then
        return 0
    elseif level <= 39 then
        return level - math.floor(level / 10) - 5
    elseif level <= 59 then
        return level - math.floor(level / 5) - 1
    end
    return level - 9
end

-- A unit's level in the game's colours, grey only when it gives you no
-- experience (green above that).
export function levelColor(level: unknown): string
    local color = difficultyColor(level, GetQuestDifficultyColor)
    local mine = UnitLevel("player")
    if color == "quest-trivial" and type(level) == "number" and type(mine) == "number" and level > greyLevel(mine) then
        return "quest-standard"
    end
    return color
end

local function metaText(A: UnitApi, u: string): string
    local level = A.UnitLevel(u)
    local classify = A.UnitClassification
    local c = classify and classify(u)
    if secret.isSecret(level) or secret.isSecret(c) then
        return ""
    end
    local lv = (level and level > 0) and tostring(level) or "??"
    if c == "worldboss" then
        return "?? Boss"
    end
    local word = c and CLASSIFICATION[c]
    return word and (lv .. " " .. word) or lv
end

-- The raid target marker. GetRaidTargetIndex may be secret in combat: the
-- game's SetRaidTargetIconTexture works out the cell with Lua arithmetic,
-- which a secret refuses, so a secret index goes to the texture's sprite
-- sheet cell, which the engine works out itself.
-- 0.9, public: raidMarker(parent, size) makes the texture (hidden), and
-- showRaidMarker(texture, unit[, api]) shows that unit's marker on it, or
-- hides it (no marker, no unit, or `api` without GetRaidTargetIndex).
-- The sheet is the texture token "raid-markers" (the game's: eight 64px
-- cells, four to a row; a theme's own in the same cells).
export function raidMarker(parent: Frame, size: number, layer: DrawLayer?): Texture
    local t = parent:CreateTexture(nil, layer or "OVERLAY")
    draw.skin(t, "raid-markers")
    t:SetSize(size, size)
    t:Hide()
    return t
end

export function showRaidMarker(t: Texture, u: string?, api: UnitApi?)
    local A = api or GAME
    local markerOf = A.GetRaidTargetIndex
    if not u or not markerOf or not A.UnitExists(u) then
        t:Hide()
        return
    end
    local index = markerOf(u)
    if secret.isSecret(index) then
        local ok = t.SetSpriteSheetCell ~= nil and pcall(t.SetSpriteSheetCell, t, index, 4, 4, 64, 64)
        t:SetShown(ok)
    elseif index and index >= 1 and index <= 8 then
        local col, row = (index - 1) % 4, math.floor((index - 1) / 4)
        t:SetTexCoord(col * 0.25, (col + 1) * 0.25, row * 0.25, (row + 1) * 0.25)
        t:Show()
    else
        t:Hide()
    end
end

-- A state border and its badge: "danger", "warning", "magic", "curse",
-- "poison", "disease", "ward" or nil.
local STATE_BORDER: { [string]: string } = {
    danger = "ember",
    warning = "amber",
    ward = "ward",
    magic = "dispel-magic",
    curse = "dispel-curse",
    poison = "dispel-poison",
    disease = "dispel-disease",
}

-- The row (name, badges) stops where the health text begins; how much room
-- that text needs depends on what it shows.
local TEXT_W: { [string]: number } = { percent = 34, value = 40, both = 84, none = 0 }

--------------------------------------------------------------------------------
-- Buff indicators (healers' HoTs and shields). Each indicator watches some spells (every rank) on the unit:
--   { name, ids = { ... }, kind = "icon" | "square" | "border" | "fill",
--     point = "TOPRIGHT", size = 12, color = "fel", source = "mine" | "any",
--     show = "up" | "missing" | "both", missingColor = "ember",
--     on = "all" | "group" }  -- on everyone, or only on your own raid group
--                             -- (older lists: missingOn)
-- show: "up" while the aura is up (the engine, in combat too); "missing"
-- while it isn't, out of combat only (addon code can't read auras in combat,
-- so it hides then); "both" a missing look (grey icon, or the missing colour)
-- under the live one, which covers it while the aura is up (in combat too;
-- not for "fill", whose two tints would blend).
-- Live, each is an engine aura container filtered to its spells (so it works
-- in combat); its one button carries the look, built when the engine makes
-- it, by anchors alone: an aura icon with its time, a coloured square at a
-- corner, a coloured border, or a tint over the health fill. In a preview
-- (static) the same looks are drawn directly, as if the aura were up.
--------------------------------------------------------------------------------

-- One buff indicator (saved settings: the Buff indicators module's list).
export type Indicator = {
    name?: string,
    ids?: number[],
    kind?: string,
    point?: FramePoint,
    size?: number,
    color?: string,
    source?: string,
    show?: string,
    missingColor?: string,
    on?: string,
    missingOn?: string,
    -- the group sizes it shows at ("5", "10", "20", "40"; none: every size)
    sizes?: { [string]: boolean },
    -- 0.30: the roles it shows on ("TANK", "HEALER", "DAMAGER"; none, or
    -- all three: every role). Someone without a role counts as Damage.
    roles?: { [string]: boolean },
    -- 0.21: whom it shows on: players (nil), "pets" or "both" (asked
    -- 2026-11-17: Forever's pets can't take buffs, so a missing Mark of the
    -- Wild showed on every pet)
    units?: string,
}

export const INDICATOR_POINTS: FramePoint[] = {
    "TOPLEFT",
    "TOP",
    "TOPRIGHT",
    "LEFT",
    "CENTER",
    "RIGHT",
    "BOTTOMLEFT",
    "BOTTOM",
    "BOTTOMRIGHT",
}

-- the indicator each live indicator container shows
local indicatorOf: { [UnitAuras]: Indicator } = setmetatable({}, { __mode = "k" })

local function pointOffset(point: string): (number, number)
    local x = point:find("LEFT") and 2 or (point:find("RIGHT") and -2 or 0)
    local y = point:find("TOP") and -2 or (point:find("BOTTOM") and 2 or 0)
    return x, y
end

-- The look of indicator `ind` over frame `f`, on `parent`; `previewArt` is the
-- texture to show for kind "icon" in a preview (live, the engine draws it).
-- missing: the "aura is missing" look (missing colour, or a grey icon),
-- one level under the live look so the live one covers it.
local function indicatorLook(f: UnitFrame, parent: Frame, ind: Indicator, previewArt: number?, missing: boolean?): Frame
    local look = CreateFrame("Frame", nil, parent)
    look:EnableMouse(false)
    local color = missing and (ind.missingColor or "ember") or (ind.color or "fel")
    local bias = missing and 0 or 1
    if ind.kind == "border" then
        look:SetAllPoints(f)
        draw.border(look, color, { width = 2 })
        look:SetFrameLevel(f.over:GetFrameLevel() + 1 + bias)
    elseif ind.kind == "fill" then
        look:SetAllPoints(f.health:GetStatusBarTexture())
        local tex = look:CreateTexture(nil, "ARTWORK")
        tex:SetAllPoints()
        draw.bind(tex, function(t: Texture)
            local r, g, b = draw.rgba(color)
            t:SetColorTexture(r, g, b, 0.45)
        end)
        look:SetFrameLevel(f.health:GetFrameLevel() + 1)
    else
        local size = ind.size or 10
        local point: FramePoint = ind.point or "TOPRIGHT"
        local x, y = pointOffset(point)
        look:SetSize(size, size)
        look:SetPoint(point, f, point, x, y)
        if ind.kind == "square" then
            draw.fill(look, color):SetAllPoints()
            draw.border(look, "surface-sunk")
        elseif previewArt then
            local icon = iconModule.icon(look, size)
            icon:SetAllPoints()
            icon:SetArt(previewArt)
            if missing then
                icon:SetState("dim")
            end
        end
        look:SetFrameLevel(f.over:GetFrameLevel() + 7 + bias)
    end
    return look
end

-- One indicator's identity: everything its container and look are built from.
local function indicatorKey(ind: Indicator): string
    return table.concat(
        {
            ind.kind or "icon",
            ind.point or "",
            ind.size or 10,
            ind.color or "",
            ind.source or "mine",
            table.concat(ind.ids or {}, ","),
        },
        "|"
    )
end

-- An indicator's first spell's art (a preview's icon), if it has one.
local function indicatorArt(ind: Indicator): number?
    local first = ind.ids and ind.ids[1]
    return first and (C_Spell.GetSpellTexture(first)) or nil
end

-- Your own raid subgroup from the game's roster, kept until the roster
-- changes (a walk over the raid for each frame was 40 by 40 checks on a
-- roster change): whether it was read, and what it was (nil: unreadable or
-- none). An unsure answer (a secret one) is not kept.
local subgroupRead = false
local subgroupKept: number? = nil
local function yourSubgroup(A: GroupApi): number?
    if A == GROUP and subgroupRead then
        return subgroupKept
    end
    local mine: number? = nil
    local sure = true
    local count = A.GetNumGroupMembers and A.GetNumGroupMembers() or 0
    for i = 1, count do
        local me = A.UnitIsUnit("raid" .. i, "player")
        if secret.isSecret(me) then
            sure = false
            break
        end
        if me then
            local _, _, s = A.GetRaidRosterInfo(i)
            mine = s
            break
        end
    end
    if A == GROUP and sure then
        subgroupRead, subgroupKept = true, mine
    end
    return mine
end

-- Whether a group member is in your own raid group (in a party, or for a
-- party token in a raid: yes). Read out of combat; an unreadable answer is yes.
-- (A: where the group is read from, the game's functions; a parameter for tests)
local function inYourGroup(unit: string, A: GroupApi = GROUP): boolean
    if not A.IsInRaid() then
        return true
    end
    local idx = tonumber(unit:match("^raid(%d+)$"))
    if not idx then
        return true
    end
    local _, _, sub = A.GetRaidRosterInfo(idx)
    local mine = yourSubgroup(A)
    return sub == nil or mine == nil or sub == mine
end

-- Group sizes an indicator can be limited to (ind.sizes = { ["10"] = true,
-- … }; nil: every size). A party (or no group) is "5"; a raid the smallest
-- of 10, 20, 40 it fits in.
export const GROUP_TIERS: string[] = { "5", "10", "20", "40" }
-- (A: where the group is read from, the game's functions; a parameter for tests)
local function groupTierIn(count: number?, A: GroupApi): string
    if not count and not A.IsInRaid() then
        return "5"
    end
    local n = count or (A.GetNumGroupMembers and A.GetNumGroupMembers() or 0)
    if n <= 5 and not A.IsInRaid() then
        return "5"
    end
    if n <= 10 then
        return "10"
    end
    if n <= 20 then
        return "20"
    end
    return "40"
end
export function groupTier(count: number?): string
    return groupTierIn(count, GROUP)
end

-- The indicators of `list` active at group size `tier`.
export function indicatorsFor(list: Indicator[]?, tier: string): Indicator[]
    local out: Indicator[] = {}
    for _, ind in ipairs(list or {}) do
        local sizes = ind.sizes
        if not sizes or next(sizes) == nil or sizes[tier] then
            out[#out + 1] = ind
        end
    end
    return out
end

-- Roles an indicator can be limited to (ind.roles = { TANK = true, … };
-- nil, empty or all three: every role). Everyone has one: no role ("NONE")
-- or any other answer counts as Damage.
export const INDICATOR_ROLES: string[] = { "TANK", "HEALER", "DAMAGER" }

-- The role indicators go by for a UnitGroupRolesAssigned answer (not a
-- secret one): TANK, HEALER, else DAMAGER.
export function indicatorRole(answer: string?): string
    if answer == "TANK" or answer == "HEALER" then
        return answer
    end
    return "DAMAGER"
end

-- Whether indicator `ind` shows on someone of `role` (an indicatorRole).
export function indicatorShowsOn(ind: Indicator, role: string): boolean
    local roles = ind.roles
    return not roles or next(roles) == nil or roles[role] == true
end

-- Whom an indicator can show on (ind.units; nil: players).
export const INDICATOR_UNITS: string[] = { "players", "pets", "both" }

-- Whether unit token `unit` is a pet's ("pet", "partypet2", "raidpet7").
export function isPetUnit(unit: string): boolean
    return unit:find("pet", 1, true) ~= nil
end

-- Whether indicator `ind` shows on unit `unit` (a pet's or a player's).
export function indicatorShowsOnUnit(ind: Indicator, unit: string): boolean
    local units = ind.units or "players"
    return units == "both" or (units == "pets") == isPetUnit(unit)
end

-- Whether any indicator of `list` is limited to some roles.
local function anyRoleLimited(list: Indicator[]?): boolean
    for _, ind in ipairs(list or {}) do
        local roles = ind.roles
        if roles and next(roles) ~= nil then
            return true
        end
    end
    return false
end

-- Whether any indicator of `list` (or its missing look) is limited to your
-- own raid group.
local function anyGroupScoped(list: Indicator[]?): boolean
    for _, ind in ipairs(list or {}) do
        if (ind.on or ind.missingOn) == "group" then
            return true
        end
    end
    return false
end

-- The indicators of `list` that show on someone of `role` (previews: a live
-- frame goes by its own unit's role).
export function indicatorsForRole(list: Indicator[]?, role: string?): Indicator[]
    local out: Indicator[] = {}
    local r = indicatorRole(role)
    for _, ind in ipairs(list or {}) do
        if indicatorShowsOn(ind, r) then
            out[#out + 1] = ind
        end
    end
    return out
end

-- The indicators SuuUI shows on group frames (set by the Buff indicators
-- module; empty while it is off), and a counter that changes with them.
local indicators: Indicator[], indicatorsVersion = {}, 0
export function groupIndicators(): (Indicator[], number)
    return indicators, indicatorsVersion
end
export function setGroupIndicators(list: Indicator[]?)
    indicators = list or {}
    indicatorsVersion = indicatorsVersion + 1
    events.emit("SUUUI_INDICATORS_CHANGED")
end

-- The Defensives list for group frames (set by the Defensives module; empty
-- while it is off): spell IDs by what they drive, and a counter that changes
-- with them. { external = { ids }, defensive = { ids }, warded = { ids },
-- all = { ids } }
export type GroupDefensives = { external: number[], defensive: number[], warded: number[], all: number[] }
local EMPTY_DEFENSIVES: GroupDefensives = { external = {}, defensive = {}, warded = {}, all = {} }
local defensives, defensivesVersion = EMPTY_DEFENSIVES, 0
export function groupDefensives(): (GroupDefensives, number)
    return defensives, defensivesVersion
end
export function setGroupDefensives(d: GroupDefensives?)
    defensives = d or EMPTY_DEFENSIVES
    defensivesVersion = defensivesVersion + 1
    events.emit("SUUUI_DEFENSIVES_CHANGED")
end

--------------------------------------------------------------------------------
-- Stand-ins for previews: made-up people with the Unit* functions a frame
-- reads.
--------------------------------------------------------------------------------

-- A made-up person for a preview unit token: health and power are 0-1
-- fractions (max: the health they are of), incoming and absorb fractions of
-- max, marker a raid target marker (1-8), you: the player.
export type StandInPerson = {
    name?: string,
    class?: string,
    role?: string,
    health: number,
    max?: number,
    power?: number,
    incoming?: number,
    absorb?: number,
    dead?: boolean,
    offline?: boolean,
    marker?: number,
    you?: boolean,
}

local STAND_IN_POWER: { [string]: { kind: number, token: string } } = {
    WARRIOR = { kind = 1, token = "RAGE" },
    ROGUE = { kind = 3, token = "ENERGY" },
}
local MANA = { kind = 0, token = "MANA" }

export function unitStandIn(person: (unit: string) -> StandInPerson): UnitApi
    local function curveValue(curve: CurveObjectBase?, fraction: number): number
        if curve ~= nil and curve == scaleTo100() then
            return fraction * 100
        end
        return unitFrameCurveValue(curve, fraction) or 0
    end
    local function healthOf(u: string, part: number): number
        return part * (person(u).max or 4200)
    end
    return {
        UnitExists = function(_: string?): boolean
            return true
        end,
        UnitIsDeadOrGhost = function(u: string): boolean
            return person(u).dead == true
        end,
        UnitIsGhost = function(_: string): boolean
            return false
        end,
        UnitHealthMax = function(u: string): number
            return person(u).max or 4200
        end,
        UnitHealth = function(u: string, _: boolean?): number
            return healthOf(u, person(u).health)
        end,
        UnitHealthPercent = function(u: string, _: boolean?, curve: CurveObjectBase?): number
            return curveValue(curve, person(u).health)
        end,
        UnitGetIncomingHeals = function(u: string, _: string?): number?
            return healthOf(u, person(u).incoming or 0)
        end,
        UnitGetTotalAbsorbs = function(u: string): number
            return healthOf(u, person(u).absorb or 0)
        end,
        UnitPowerType = function(u: string, _: number?): (number?, string?)
            local class = person(u).class
            local p = class and STAND_IN_POWER[class] or MANA
            return p.kind, p.token
        end,
        UnitPowerMax = function(_: string, _: number?, _: boolean?): number
            return 100
        end,
        UnitPower = function(u: string, _: number?, _: boolean?): number
            return (person(u).power or 0.6) * 100
        end,
        UnitPowerPercent = function(u: string, _: number?, _: boolean?, curve: CurveObjectBase?): number
            return curveValue(curve, person(u).power or 0.6)
        end,
        UnitLevel = function(_: string): number
            return 60
        end,
        UnitClassification = function(_: string): string
            return "normal"
        end,
        UnitGroupRolesAssigned = function(u: string?): string
            return u and person(u).role or "NONE"
        end,
        UnitIsPlayer = function(_: string?, _: number?): boolean
            return true
        end,
        UnitClass = function(u: string): (string?, string?)
            local c = person(u).class
            return c, c
        end,
        UnitName = function(u: string | Secret<string>): (string?, string?)
            if secret.isSecret(u) then
                return nil, nil
            end
            return person(u).name, nil
        end,
        UnitReaction = function(_: string, _: string): number?
            return 5
        end,
        -- (no family: shown as none)
        UnitCreatureFamily = function(_: string): (string, number)
            return "", 0
        end,
        UnitIsUnit = function(u: string, other: string): boolean
            return other == "player" and person(u).you == true
        end,
        UnitIsConnected = function(u: string): boolean
            return not person(u).offline
        end,
        GetRaidTargetIndex = function(u: string): number?
            return person(u).marker
        end,
    }
end

--------------------------------------------------------------------------------
-- Debuff-type badges, in combat too. Per type, an
-- engine aura container that holds at most one debuff of that type. Its
-- button draws nothing itself; the decoration hung on it when the engine
-- creates it (writes to these buttons are refused once auras are secret)
-- covers the whole frame by anchors alone: the type's border, and its badge
-- where the health text begins. The engine shows the button while such a
-- debuff is up, and the decoration with it. Two sets: every type, and only
-- what you can remove; one shows.
--------------------------------------------------------------------------------

export const DEBUFF_TYPES: string[] = { "Magic", "Curse", "Poison", "Disease" } -- drawn top first

-- An engine button that only carries a decoration: 1px, no mouse.
local function quietButton(button: AuraButton)
    pcall(button.SetSize, button, 1, 1)
    pcall(button.SetMouseClickEnabled, button, false)
    pcall(button.SetMouseMotionEnabled, button, false)
end

local function buildDispelSet(f: UnitFrame, set: string): UnitAuras[]
    local filter = set == "removable" and { "HARMFUL", "RAID_PLAYER_DISPELLABLE" } or { "HARMFUL" }
    local list: UnitAuras[] = {}
    for _, kind in ipairs(DEBUFF_TYPES) do
        local init = function(button: AuraButton)
            quietButton(button)
            f:DispelDecoration(button, kind)
        end
        local c = auraContainer(f, f.unit or "none", {
            size = 1,
            anchor = "TOPLEFT",
            roster = f.opts.rosterRefresh ~= false,
            groups = { { key = kind, filter = filter, max = 1, dispelTypes = { kind }, initialize = init } },
        })
        if c then
            c.container:SetPoint("TOPLEFT", f, "TOPLEFT")
            c.container:SetFrameLevel(f.over:GetFrameLevel() + 1)
            list[#list + 1] = c
        end
    end
    return list
end

--------------------------------------------------------------------------------
-- Warded, in combat too: one engine aura container filtered to the
-- Defensives list's spells with Warded on (max 1). Its button carries the
-- ward border, the "Warded" badge and the ward glow, as the debuff-type
-- slots carry theirs. The order: a debuff type covers Warded (its slots sit
-- above), Warded covers Aggro (the state layer sits below), and Aggro's ember
-- glow draws over the ward's.
--------------------------------------------------------------------------------

-- A state badge's place: at the row's end, or (opts.badgeTop, the healer
-- frames) on the top edge at the right, a little smaller: in a 120 px frame
-- with three icon slots inside, the row's end left the name a letter (seen in
-- game, 2026-11-08).
local BADGE_TOP_SCALE = 0.85
local function placeBadge(owner: UnitFrame, badge: Frame)
    badge:ClearAllPoints()
    if owner.opts.badgeTop then
        badge:SetScale(BADGE_TOP_SCALE)
        -- (a scaled frame's offsets are in its own scale)
        badge:SetPoint("RIGHT", owner, "TOPRIGHT", -owner.size.pad / BADGE_TOP_SCALE, 0)
    else
        badge:SetScale(1)
        badge:SetPoint("RIGHT", owner.row, "RIGHT", 0, 0)
    end
end

-- The ward border, badge and glow over a frame, on `parent` (the slot's
-- button, or the frame itself in a preview, which shows and hides it with
-- SetWarded).
export class WardDecoration extends Frame
    readonly glow: Frame

    constructor(parent: Frame, owner: UnitFrame)
        super(nil, parent)
        self:SetAllPoints(owner)
        self:EnableMouse(false)
        draw.border(self, "ward")
        local badge = controls.stateBadge(self, "ward", "Warded")
        owner.edgeBadges[#owner.edgeBadges + 1] = badge
        placeBadge(owner, badge)
        -- at least as wide as the Aggro badge it covers
        badge:SetWidth(math.max(badge.knownWidth, uiText.measureText("badge", "Aggro") + 10))
        self:SetFrameLevel(owner.over:GetFrameLevel() + 2)
        -- the glow on its own layer under the frame's, so Aggro's ember glow wins
        local glow = CreateFrame("Frame", nil, parent)
        glow:SetAllPoints(owner)
        glow:EnableMouse(false)
        glow:SetFrameLevel(math.max(0, owner:GetFrameLevel() - 1))
        draw.shadow(glow, "glow-ward")
        self.glow = glow
    end

    -- (a preview's) on a slot's button both follow the button
    function SetWarded(on: boolean)
        self:SetShown(on)
        self.glow:SetShown(on)
    end
end

--------------------------------------------------------------------------------
-- Events
--------------------------------------------------------------------------------

-- What a health event changes, kept per frame until the driver draws it
-- (below): the values, the text and dead or alive (UNIT_HEALTH); the bars'
-- range as well (UNIT_MAXHEALTH); only the heals on the way and the
-- shields (the other two). PART_ALL: everything (any other caller).
const PART_HEALTH = 1
const PART_MAX = 2
const PART_INCOMING = 4
const PART_ALL = 7

local function hasPart(parts: number, part: number): boolean
    return parts % (part * 2) >= part
end

-- The parts of both.
local function joinParts(a: number, b: number): number
    local out = a
    if hasPart(b, PART_HEALTH) and not hasPart(out, PART_HEALTH) then
        out = out + PART_HEALTH
    end
    if hasPart(b, PART_MAX) and not hasPart(out, PART_MAX) then
        out = out + PART_MAX
    end
    if hasPart(b, PART_INCOMING) and not hasPart(out, PART_INCOMING) then
        out = out + PART_INCOMING
    end
    return out
end

-- The unit's own events, on one watch per frame (wowlua:events'
-- watchUnit: its own event frame, re-pointed to another token without
-- subscribing again; a client without one of them never sends it): what
-- each health event changes, and the power and identity events.
local HEALTH_PART: { [string]: number } = {
    UNIT_HEALTH = PART_HEALTH,
    UNIT_MAXHEALTH = PART_MAX,
    UNIT_HEAL_PREDICTION = PART_INCOMING,
    UNIT_ABSORB_AMOUNT_CHANGED = PART_INCOMING,
}
local POWER_EVENT: { [string]: boolean } = { UNIT_POWER_UPDATE = true, UNIT_MAXPOWER = true, UNIT_DISPLAYPOWER = true }
local IDENTITY_EVENT: { [string]: boolean } = {
    UNIT_NAME_UPDATE = true,
    UNIT_LEVEL = true,
    UNIT_FACTION = true,
    UNIT_CLASSIFICATION_CHANGED = true,
}
local UNIT_EVENTS: string[] = {
    "UNIT_HEALTH",
    "UNIT_MAXHEALTH",
    "UNIT_HEAL_PREDICTION",
    "UNIT_ABSORB_AMOUNT_CHANGED",
    "UNIT_POWER_UPDATE",
    "UNIT_MAXPOWER",
    "UNIT_DISPLAYPOWER",
    "UNIT_NAME_UPDATE",
    "UNIT_LEVEL",
    "UNIT_FACTION",
    "UNIT_CLASSIFICATION_CHANGED",
    -- going offline or coming back: the bar, the text, the name and the power line
    "UNIT_CONNECTION",
    -- a reaction the client didn't know yet (seen in game: a party pet's
    -- frame kept the theme's bar until a /reload, no UNIT_FACTION telling
    -- when it was known): asked again on the unit's UNIT_FLAGS, which comes
    -- often (probed on a party member), only while unknown
    "UNIT_FLAGS",
}

--------------------------------------------------------------------------------
-- The driver: one hidden frame whose OnUpdate draws, once a frame, what the
-- events marked (the health of each frame, a roster change for the frames
-- that redraw themselves on one) and moves the ghosts whose hold is over.
-- It shows only while something waits. Nothing is made per event: the
-- marks go into tables kept for good (two, swapped on each draw).
--------------------------------------------------------------------------------

const SOURCE = "Unit frames"

-- The ghost's hold before it follows the fill, and the engine's easing
-- (as UI/Bar's trail; none on a client without it: the ghost then jumps).
const GHOST_HOLD = 0.15
local GHOST_EASE = Enum.StatusBarInterpolation and Enum.StatusBarInterpolation.ExponentialEaseOut

-- frames whose health waits, with the parts it waits for
local due: { [UnitFrame]: number } = {}
local drawing: { [UnitFrame]: number } = {}
-- frames whose ghost waits out its hold
local trails: { [UnitFrame]: boolean } = {}
-- the active frames, for the listeners shared by all of them
local live: { [UnitFrame]: boolean } = {}
-- a roster change waits for the frames that redraw themselves on one
local rosterDue = false
local driver = CreateFrame("Frame")
driver:Hide()

local function updateHealthOf(f: UnitFrame)
    f:UpdateHealth()
end

-- The parts of a frame's health that changed, drawn now (the driver, or
-- the frame showing). A hidden frame keeps them until it shows.
local function drawHealth(f: UnitFrame, parts: number)
    if not f.active or not f.unit then
        return
    end
    if not f:IsVisible() then
        f.healthStale = joinParts(f.healthStale, parts)
        return
    end
    f.healthParts = parts
    fault.log:run(SOURCE, updateHealthOf, f)
    f.healthParts = PART_ALL
end

-- A health event: what it changed, drawn on the driver's next frame.
local function markHealth(f: UnitFrame, part: number)
    local parts = due[f]
    if parts == nil then
        due[f] = part
        driver:Show()
    elseif not hasPart(parts, part) then
        due[f] = parts + part
    end
end

-- The ghost after the fill took `v`: it holds GHOST_HOLD (later values
-- inside the hold move its target, never restart it), then the engine eases
-- it to the latest value. `instant` (a new unit) moves it at once and drops
-- a waiting hold. Only SetValue touches `v`: it may be secret.
local function trailGhost(f: UnitFrame, v: number | Secret<number>, instant: boolean?)
    if instant or not GHOST_EASE then
        if f.ghostDue then
            f.ghostDue = nil
            trails[f] = nil
        end
        f.ghost:SetValue(v)
        return
    end
    f.ghostValue = v
    if not f.ghostDue then
        f.ghostDue = GetTime() + GHOST_HOLD
        trails[f] = true
        driver:Show()
    end
end

-- A roster change for a frame that redraws itself on one (not a group
-- module's): a group token can be someone else, so everything; any other
-- unit's role marker and power line.
local function rosterRedraw(f: UnitFrame)
    local u = f.unit
    if u and (u:find("^party") or u:find("^raid")) then
        f:Refresh()
    else
        f:UpdateIdentity()
        f:UpdatePower()
    end
end

driver:SetScript("OnUpdate", function()
    if next(due) ~= nil then
        local list = due
        due, drawing = drawing, list
        for f, parts in pairs(list) do
            list[f] = nil
            drawHealth(f, parts)
        end
    end
    if rosterDue then
        rosterDue = false
        for f in pairs(live) do
            if f.opts.rosterRefresh ~= false then
                fault.log:run(SOURCE, rosterRedraw, f)
            end
        end
    end
    if next(trails) ~= nil then
        local now = GetTime()
        for f in pairs(trails) do
            local at = f.ghostDue
            if not at or now >= at then
                trails[f] = nil
                f.ghostDue = nil
                if at then
                    f.ghost:SetValue(f.ghostValue, GHOST_EASE)
                end
            end
        end
    end
    if next(due) == nil and next(trails) == nil and not rosterDue then
        driver:Hide()
    end
end)

-- Who a token shows, as far as it can be read: the unit's GUID, or false
-- (nobody, or a secret GUID).
local function occupantOf(unit: string): string | false
    return secret.asString(UnitGUID(unit)) or false
end

-- A role as the frame keeps it to compare: the answer, or false for a
-- secret one.
local function roleKey(role: unknown): string | false
    if secret.isSecret(role) or type(role) ~= "string" then
        return false
    end
    return role
end

-- What unitFrame takes (see the header).
export type UnitFrameOptions = {
    size?: string,
    width?: number | string,
    height?: number | string,
    anchor?: boolean,
    you?: boolean,
    youWhenPlayer?: boolean,
    meta?: boolean | string,
    crest?: boolean,
    dragon?: boolean,
    poll?: number,
    power?: boolean,
    healthText?: string,
    nameColor?: string,
    secure?: boolean,
    name?: string,
    lowHealth?: boolean,
    lowTint?: boolean,
    incoming?: boolean,
    powerFor?: (unit: string, api: UnitApi) -> boolean,
    frame?: Button,
    reserveRight?: number,
    textOnSmall?: boolean,
    badgeTop?: boolean,
    nameUnderIcons?: boolean,
    raidMarker?: boolean,
    api?: UnitApi,
    tapped?: boolean,
    powerCost?: boolean,
    rosterRefresh?: boolean,
}

-- A missing look shown now, and what decides it.
type MissingLook = { look: Frame, mode: string, ind: Indicator }

-- SuuUI's secure unit frames (SecureUnitButtonTemplate, made or adopted),
-- in the order they came: what the mouse bindings set their clicks on,
-- without walking every frame of the game (EnumerateFrames took up to 39 ms
-- at a fight's end, the dev profiler, 2026-11-10).
local secureFrames: UnitFrame[] = {}
local secureSeen: { [UnitFrame]: boolean } = {}

export class UnitFrame extends Button
    unit: string? = nil
    -- the health drawn grey: a mob tagged by someone else (opts.tapped)
    tappedLook: boolean = false
    -- a player's class token, for class-coloured health (UI/HealthFill)
    fillClass: string? = nil
    -- an NPC's reaction token, for reaction-coloured health (UI/HealthFill)
    fillReaction: string? = nil
    -- what the health fill was painted as: "tapped", a class or reaction
    -- token, or false
    fillLook: string | false = false
    opts: UnitFrameOptions
    size: Size
    api: UnitApi
    ground: Texture
    inner: Frame
    ghost: StatusBar
    health: StatusBar
    crest: crest.Crest? = nil
    dragonHost: Frame? = nil
    dragon: Texture? = nil
    healthLow: StatusBar
    tint: Texture
    incoming: StatusBar
    absorb: StatusBar
    -- the shield past full health (design A2): two unseen bars for its
    -- place, and its brighter hatch
    absorbReach: StatusBar
    absorbOver: StatusBar
    overAbsorb: Texture
    -- under the power line while your cast's cost shows: your power now, faded
    powerSpend: StatusBar
    power: StatusBar
    powerLow: StatusBar
    -- your casts' costs (the player's frame, opts.powerCost)
    cast: CastCost? = nil
    over: Frame
    border: draw.Border
    -- the anchor frame's rings (opts.anchor: the player frame)
    ring?: draw.Border
    ring2?: draw.Border
    glow: draw.SoftEdge
    row: Frame
    role: Texture
    classDot: Texture
    name: uiText.Text
    meta: uiText.Text
    stateLayer: Frame
    badge: controls.StateBadge
    you: controls.StateBadge
    right: uiText.Text
    markerLayer: Frame
    marker: Texture
    rightW: number = 0
    -- where the ghost follows to, and when its hold ends (GetTime; nil: none waits)
    ghostValue: number | Secret<number> = 0
    ghostDue: number? = nil
    -- the bars that take the health's range
    rangeBars: StatusBar[] = {}
    -- what the next UpdateHealth draws (PART_*: all of it, unless the driver
    -- says what changed), and what changed while the frame was hidden
    healthParts: number = PART_ALL
    healthStale: number = 0
    -- the health text as last set: its look ("gone" or "numeric"), what it
    -- shows ("percent", "value", "both", "none", or the word: "Dead"...;
    -- nil: a secret text, or none yet) and, for readable values, what it was
    -- made from (the rounded percent, the health)
    rightLook: string? = nil
    textMode: string? = nil
    textPct: number | false = false
    textCur: number | false = false
    -- the role the marker was drawn for (false: a secret one or none; nil:
    -- not drawn yet)
    roleShown: string | false | nil = nil
    -- whether an indicator in use is limited to your own raid group
    groupScoped: boolean = false
    -- whom the token showed when the frame was last drawn for its owner's
    -- roster pass: the unit's GUID, false when unreadable, nil when unknown
    -- (inactive since: the owner's next pass draws it anew)
    occupant: string | false | nil = nil
    -- its token changed since that pass (SetUnit's `later`)
    unitMoved: boolean = false
    -- the unit's events (made on the first Activate, kept)
    watch: UnitWatch? = nil
    dead: boolean? = nil
    offline: boolean? = nil
    stateTone: string? = nil
    stateWord: string? = nil
    -- live indicators' containers by identity, and those in use
    indicatorCache: { [string]: UnitAuras } = {}
    indicatorContainers: UnitAuras[] = {}
    -- missing looks by identity, and those in use
    missingCache: { [string]: Frame } = {}
    missingLooks: MissingLook[] = {}
    -- whether an indicator in use is limited to some roles, and the unit's
    -- role they went by last (nil: not read since the unit came)
    roleLimited: boolean = false
    indicatorRole: string? = nil
    previewCache: { [string]: Frame } = {}
    previewLooks: Frame[] = {}
    -- the debuff-type slots per set ("all", "removable")
    dispelSets: { [string]: UnitAuras[] } = {}
    wardSlot: UnitAuras? = nil
    -- a preview's ward look (the group frames' previews)
    wardDeco: WardDecoration? = nil
    -- every state badge over this frame (its own, Warded's, the debuff
    -- types'), placed together (placeBadge)
    edgeBadges: Frame[] = {}
    active: boolean? = nil
    ticker: TickerHandle? = nil
    -- the client didn't know the unit's reaction yet: asked again on its
    -- next UNIT_FLAGS
    reactionUnknown: boolean = false
    -- 0.17: adds lines to the frame's tooltip after the unit's
    onTooltip: ((f: UnitFrame, tooltip: GameTooltip) -> ())? = nil
    -- after each health update
    onHealth: ((f: UnitFrame) -> ())? = nil
    -- its size comes from its tokens (a theme's sizes reach it)
    tokenSize: boolean = false

    constructor(parent: Frame?, unit: string?, given: UnitFrameOptions?)
        local opts: UnitFrameOptions = given or {}
        local size = SIZES[opts.size or "md"] :: Size
        -- opts.frame: a button a group header made (SecureUnitButtonTemplate);
        -- the header owns its unit, its attributes are set when it is made.
        -- PingableUnitFrameTemplate, as the game's unit frames: a ping over
        -- the frame pings its unit (the "ping-receiver" attribute, and
        -- GetTargetInfo reads self.unit) instead of the world behind it
        super(opts.name, parent, opts.secure ~= false and "SecureUnitButtonTemplate, PingableUnitFrameTemplate" or nil)
        self.unit, self.opts, self.size = unit, opts, size
        -- a theme's dress for the big unit frames (0.40: the player and the
        -- target; the party's and the raid's stay plain)
        if opts.size == "lg" then
            dress.register(self, "unit")
        end
        if opts.secure ~= false and not secureSeen[self] then
            secureSeen[self] = true
            secureFrames[#secureFrames + 1] = self
        end
        self.api = opts.api or GAME
        local w, h = draw.size(opts.width or size.width), draw.size(opts.height or size.height)
        if not (opts.frame and InCombatLockdown()) then
            self:SetSize(w, h)
        end

        if opts.secure ~= false and not opts.frame then
            self:SetAttribute("unit", unit)
            self:SetAttribute("*type1", "target")
            self:SetAttribute("*type2", "togglemenu")
            self:RegisterForClicks("AnyUp")
        end
        self:SetScript("OnEnter", function()
            local shown = self.unit
            if not shown then
                return
            end
            GameTooltip_SetDefaultAnchor(GameTooltip, self)
            GameTooltip:SetUnit(shown)
            -- 0.17: a module's own lines after the unit's (the player frame's rested lines)
            local more = self.onTooltip
            if more then
                more(self, GameTooltip)
            end
            GameTooltip:Show()
        end)
        self:SetScript("OnLeave", function()
            GameTooltip:Hide()
        end)

        -- The ground and, clipped inside the 1px border, the bars.
        self.ground = draw.fill(self, "surface-sunk")
        self.ground:SetAllPoints()
        draw.pattern(self.ground, "track-pattern")
        self.inner = CreateFrame("Frame", nil, self)
        self.inner:SetPoint("TOPLEFT", 1, -1)
        self.inner:SetPoint("BOTTOMRIGHT", -1, 1)
        self.inner:SetClipsChildren(true)

        self.ghost = bar(self, 1, "ghost")
        self.ghost:SetAllPoints(self.inner)
        self.health = bar(self, 2)
        self.health:SetAllPoints(self.inner)
        -- opts.crest (0.17): the rare and elite crest on the top edge over the
        -- right end (design "Rare and elite units" B)
        if opts.crest then
            local c = crest.crest(self, "frame")
            self.crest = c
            c:SetPoint("CENTER", self, "TOPRIGHT", -64, -0.5)
            -- opts.dragon (0.17): the game's own dragon instead, over the bars
            -- (as Blizzard draws it over its frame) and under the name and
            -- numbers; under the bar its head was hidden (seen in game)
            local host = CreateFrame("Frame", nil, self)
            self.dragonHost = host
            host:SetAllPoints()
            host:SetFrameLevel(self:GetFrameLevel() + 8)
            local dragon = host:CreateTexture(nil, "ARTWORK")
            dragon:Hide()
            self.dragon = dragon
        end
        healthFill.paint(self.health, nil)
        self.healthLow = bar(self, 3)
        self.healthLow:SetAllPoints(self.inner)
        gradient(self.healthLow, "unit-fill-low-deep", "unit-fill-low")
        self.healthLow:SetAlpha(0)

        -- The low-health tint: ember over the empty part of the bar, from the
        -- fill's edge to the bar's end; the engine sets its strength (a curve).
        self.tint = self.health:CreateTexture(nil, "BACKGROUND")
        self.tint:SetPoint("TOPLEFT", self.health:GetStatusBarTexture(), "TOPRIGHT")
        self.tint:SetPoint("BOTTOMRIGHT", self.inner, "BOTTOMRIGHT")
        draw.paintFill(self.tint, "ember")
        self.tint:SetAlpha(0)

        -- Incoming heals, then absorbs, each starting where the one before ends.
        self.incoming = bar(self, 4, "fel-incoming")
        self.incoming:SetPoint("TOPLEFT", self.health:GetStatusBarTexture(), "TOPRIGHT")
        self.incoming:SetPoint("BOTTOMLEFT", self.health:GetStatusBarTexture(), "BOTTOMRIGHT")
        self.incoming:SetWidth(w - 2)
        -- (the hatch tiled: draw.skin sets it to repeat)
        self.absorb = bar(self, 5, nil, nil, "absorb")
        draw.paint(self.absorb, "ward-absorb")
        self.absorb:SetPoint("TOPLEFT", self.incoming:GetStatusBarTexture(), "TOPRIGHT")
        self.absorb:SetPoint("BOTTOMLEFT", self.incoming:GetStatusBarTexture(), "BOTTOMRIGHT")
        self.absorb:SetWidth(w - 2)

        -- The shield past full health, back in from the bar's right end
        -- (asked 2026-11-14, design A2): the hatch brighter, with a ward
        -- line where it starts, over [2max - health - shield, max]. Anchors
        -- only, the values may be secret: absorbReach, filled from the right
        -- with the shield (unseen), puts its fill's left edge at max -
        -- shield; absorbOver, filled from the right with the health and
        -- laid from there, starts its fill at 2max - health - shield. The
        -- bar clips the rest: a shield that fits leaves it past the end.
        -- Drawn on the shield bar's own frame, over its hatch.
        self.absorbReach = geometryBar(self.inner)
        self.absorbReach:SetAllPoints(self.inner)
        self.absorbOver = geometryBar(self.inner)
        self.absorbOver:SetPoint("TOPLEFT", self.absorbReach:GetStatusBarTexture(), "TOPLEFT")
        self.absorbOver:SetPoint("BOTTOMLEFT", self.absorbReach:GetStatusBarTexture(), "BOTTOMLEFT")
        self.absorbOver:SetWidth(w - 2)
        local over = self.absorbOver:GetStatusBarTexture()
        local overTint = self.absorb:CreateTexture(nil, "OVERLAY", nil, 0)
        overTint:SetAllPoints(over)
        draw.paintFill(overTint, "ward", 0.18)
        local overHatch = self.absorb:CreateTexture(nil, "OVERLAY", nil, 1)
        overHatch:SetAllPoints(over)
        draw.skin(overHatch, "absorb", true)
        draw.paint(overHatch, "ward-absorb", 1.6)
        local overEdge = self.absorb:CreateTexture(nil, "OVERLAY", nil, 2)
        overEdge:SetPoint("TOPLEFT", over, "TOPLEFT")
        overEdge:SetPoint("BOTTOMLEFT", over, "BOTTOMLEFT")
        overEdge:SetWidth(2)
        draw.paintFill(overEdge, "ward")
        self.overAbsorb = overHatch
        self.rangeBars = {
            self.health,
            self.healthLow,
            self.ghost,
            self.incoming,
            self.absorb,
            self.absorbReach,
            self.absorbOver,
        }
        -- shown again: the health it missed while hidden
        self:HookScript("OnShow", function()
            local stale = self.healthStale
            if stale ~= 0 then
                self.healthStale = 0
                drawHealth(self, stale)
            end
        end)

        -- The power line: along the bottom; inside the anchor frame on the player.
        -- Under it, while your cast's cost shows (the player's frame), your
        -- power now, faded: the line itself then shows what stays.
        self.powerSpend = bar(self, 6, "mana", "power-bar")
        self.powerSpend:Hide()
        self.power = bar(self, 7, "mana", "power-bar")
        self.powerLow = bar(self, 8, "amber", "power-bar")
        self.powerLow:SetAlpha(0)
        local inset = opts.anchor and 3 or 0
        for _, b in ipairs({ self.powerSpend, self.power, self.powerLow }) do
            b:ClearAllPoints()
            b:SetPoint("BOTTOMLEFT", self.inner, "BOTTOMLEFT", inset, inset)
            b:SetPoint("BOTTOMRIGHT", self.inner, "BOTTOMRIGHT", -inset, inset)
            b:SetHeight(S["space-1"])
        end
        self.tokenSize = not opts.frame

        -- Everything drawn over the bars: border, anchor frame, text, badges.
        local o = CreateFrame("Frame", nil, self)
        o:SetAllPoints()
        o:SetFrameLevel(self:GetFrameLevel() + 9)
        self.over = o
        self.border = draw.border(o, opts.anchor and "gilt-line" or "gilt-hairline")
        if opts.anchor then
            self.ring, self.ring2 = draw.anchorRings(o)
            draw.ornament(o, 7, "corner", "gilt"):SetPoint("CENTER", self, "TOPLEFT", 0, 0)
            draw.ornament(o, 7, "corner", "gilt"):SetPoint("CENTER", self, "BOTTOMRIGHT", 0, 0)
        end
        self.glow = draw.shadow(self, "glow-ember")
        self.glow:SetShown(false)

        -- The row (marker, name, meta, badges) is clipped where the health % slot
        -- begins, so a long name never runs into it, even when it is secret.
        self.row = CreateFrame("Frame", nil, o)
        self.row:SetPoint("TOPLEFT", size.pad, 0)
        self.row:SetClipsChildren(true)
        self.role = o:CreateTexture(nil, "OVERLAY")
        self.role:SetSize(size.role, size.role)
        self.classDot = draw.ornament(o, opts.size == "sm" and 4 or 5, "mark", "ink")
        self.name = uiText.text(self.row, size.name, "ink")
        self.name:SetShadowed(true)
        self.name:SetWordWrap(false)
        self.meta = uiText.text(self.row, "caption", "ink")
        self.meta:SetShadowed(true)
        -- The state badge (Aggro…) at the row's end, where a debuff type's badge
        -- shows too: one spot, one badge. Its layer sits under the debuff-type
        -- slots (SetDispelBadges), so a debuff you may need to remove covers
        -- Aggro while both are up (a healer must see the curse on the tank); the
        -- ember glow still says aggro.
        self.stateLayer = CreateFrame("Frame", nil, o)
        self.stateLayer:SetAllPoints(self)
        self.stateLayer:SetFrameLevel(o:GetFrameLevel() + 1)
        self.badge = controls.stateBadge(self.stateLayer, "danger", "")
        self.edgeBadges[#self.edgeBadges + 1] = self.badge
        placeBadge(self, self.badge)
        self.badge:Hide()
        self.you = controls.stateBadge(self.row, "neutral", "you")
        self.you:SetShown(opts.you == true or opts.youWhenPlayer == true)
        self.right = uiText.text(o, "numeric", "ink")
        self.right:SetShadowed(true)
        self.right:SetPoint("RIGHT", -size.pad, 0)

        -- The raid target marker: centred on the top edge, standing over it, on
        -- its own layer above the borders, badges and the selection.
        self.markerLayer = CreateFrame("Frame", nil, self)
        self.markerLayer:SetAllPoints()
        self.markerLayer:SetFrameLevel(o:GetFrameLevel() + 10)
        self.markerLayer:EnableMouse(false)
        self.marker = raidMarker(self.markerLayer, size.marker)
        self.marker:SetPoint("TOP", self, "TOP", 0, size.rise)
        self:FitRow() -- the row ends where the health text (and reserved room) begins
        -- a theme's spacing and sizes: laid out again (out of combat: a
        -- secure button)
        draw.onLayout(self, function()
            self:PlaceByTheme()
        end)
        extend.add(extend.Kind.UnitFrame, self, {
            unit = unit,
            name = self:GetName(),
            preview = opts.api ~= nil or nil,
        })
    end

    -- 0.24: a mob tagged by someone else (you get nothing from it, asked
    -- 2026-11-06): its health slate and striped (grey until 2026-11-12; name
    -- and level keep their colours), the low-health colour away (opts.tapped;
    -- as ElvUI's oUF: not a player's or a pet's, UnitIsTapDenied; the tag
    -- changes with UNIT_FACTION, a tagger's death too). Whether it is.
    function Tapped(): boolean
        local A, u = self.api, self.unit
        local tapped = false
        if self.opts.tapped and u then
            local denied, controlled = A.UnitIsTapDenied, A.UnitPlayerControlled
            tapped = denied ~= nil and uiText.flag(errors.tryValue(denied, u)) == true and
                not (controlled ~= nil and uiText.flag(errors.tryValue(controlled, u)) == true)
        end
        if tapped ~= self.tappedLook then
            self.tappedLook = tapped
            self:PaintHealth()
        end
        return tapped
    end

    -- The health fill: tapped, a player's class colour (when class
    -- colours are on: UI/HealthFill decides at paint time), else the fill.
    function PaintHealth()
        -- (an NPC's reaction colour when reaction colours are on, as well)
        local look: string | false = self.tappedLook and "tapped" or self.fillClass or self.fillReaction or false
        if look ~= self.fillLook then
            self.fillLook = look
            healthFill.paint(self.health, look)
        end
    end

    -- The health: the bars, the ghost, the heals and shields on the way, the
    -- text. From the driver only the parts its events changed (healthParts:
    -- a heal or a shield alone redraws those bars, the range only follows
    -- UNIT_MAXHEALTH); from anyone else all of it. Nothing is made here, and
    -- the text, its font and its colour are set only when they change.
    function UpdateHealth(instant: boolean?)
        local parts = self.healthParts
        self.healthParts = PART_ALL
        if not self.unit then
            return
        end
        if parts == PART_ALL then
            -- (all of it now: what the events marked is drawn too)
            due[self] = nil
        end
        if parts == PART_INCOMING then
            self:DrawIncoming((self.dead or self.offline) == true)
        else
            self:DrawHealth(parts, instant)
        end
        local after = self.onHealth
        if after then
            after(self)
        end
    end

    -- The heals on the way and the shield (none while dead or offline, or
    -- with incoming = false), each starting where the one before ends.
    private function DrawIncoming(gone: boolean)
        local A, u = self.api, self.unit
        if not u then
            return
        end
        local heals: (number | Secret<number>)?, absorbs: (number | Secret<number>)? = nil, nil
        if not gone and self.opts.incoming ~= false then
            if UnitGetIncomingHeals then
                heals = A.UnitGetIncomingHeals(u)
            end
            if UnitGetTotalAbsorbs then
                absorbs = A.UnitGetTotalAbsorbs(u)
            end
        end
        self.incoming:SetValue(amount(heals))
        local shield = amount(absorbs)
        self.absorb:SetValue(shield)
        -- (the shield past full health: where it starts, from the right end)
        self.absorbReach:SetValue(shield)
    end

    private function DrawHealth(parts: number, instant: boolean?)
        local A = self.api
        local u = self.unit
        if not u then
            return
        end
        local dead = uiText.flag(A.UnitIsDeadOrGhost(u))
        local offline = isOffline(A, u)
        -- dead or offline: an empty bar
        local gone = dead or offline
        if hasPart(parts, PART_MAX) then
            local max = amount(A.UnitHealthMax(u))
            for _, b in ipairs(self.rangeBars) do
                b:SetMinMaxValues(0, max)
            end
        end
        local cur = gone and 0 or amount(A.UnitHealth(u))
        self.health:SetValue(cur)
        self.healthLow:SetValue(cur)
        local tapped = self:Tapped()
        local percent = A.UnitHealthPercent
        if tapped or self.opts.lowHealth == false or not percent then
            self.healthLow:SetAlpha(0)
        else
            self.healthLow:SetAlpha(gone and 0 or curveAmount(percent(u, true, belowCurve(LOW_HEALTH))))
        end
        local tint = self.opts.lowTint and not gone and lowTintCurve()
        -- (plain ifs: `x and secret or 0` would test the secret)
        local tintAlpha: number | Secret<number> = 0
        if tint and percent then
            tintAlpha = curveAmount(percent(u, true, tint))
        end
        self.tint:SetAlpha(tintAlpha)

        -- The ghost trails the fill: after a hold, the engine eases it down.
        trailGhost(self, cur, instant)

        -- (the heals and shield with their own events; again when the unit
        -- dies, goes offline or comes back: none while gone)
        if hasPart(parts, PART_INCOMING) or gone ~= ((self.dead or self.offline) == true) then
            self:DrawIncoming(gone)
        end
        self.absorbOver:SetValue(cur)
        self:DrawHealthText(gone, offline, cur)

        if self.dead ~= dead or self.offline ~= offline then
            local power = self.offline ~= offline
            self.dead, self.offline = dead, offline
            self:UpdateIdentity()
            if power then
                self:UpdatePower()
            end -- an offline unit has none
        end
    end

    -- The health text: the word when dead or offline, else the percent,
    -- the value or both. Readable values are compared with what the text
    -- was made from, so an unchanged one sets nothing; secret parts go to
    -- the engine's own formatting each time (nothing can be compared).
    private function DrawHealthText(gone: boolean, offline: boolean, cur: number | Secret<number>)
        local A, u, right = self.api, self.unit, self.right
        if not u then
            return
        end
        if gone then
            if self.rightLook ~= "gone" then
                self.rightLook = "gone"
                right:SetStyle("caption")
                right:SetColor("ink-muted")
            end
            local word = offline and "Offline" or (uiText.flag(A.UnitIsGhost(u)) and "Ghost" or "Dead")
            if self.textMode ~= word then
                self.textMode = word
                right:SetValue(word)
            end
            return
        end
        local mode = self.opts.healthText or "percent"
        if mode == "none" or (self.opts.size == "sm" and not self.opts.textOnSmall) then
            if self.textMode ~= "none" then
                self.textMode = "none"
                right:SetValue("")
            end
            return
        end
        if self.rightLook ~= "numeric" then
            self.rightLook = "numeric"
            right:SetStyle("numeric")
            right:SetColor("ink")
        end
        -- plain ifs: `x and secret or nil` would test the secret
        local pct: number | Secret<number> | nil = nil
        if mode ~= "value" then
            pct = healthPercent(A, u)
        end
        local withValue = mode ~= "percent"
        -- secret parts go to the engine's own formatting, never through Lua
        if secret.isSecret(pct) or (withValue and secret.isSecret(cur)) then
            self.textMode = nil
            local value: ShortNumber? = nil
            if withValue then
                value = shortNumber(cur)
            end
            -- (a part that is missing: empty, 0)
            local shownValue: ShortNumber = ""
            if secret.isSecret(value) then
                shownValue = value
            elseif value then
                shownValue = value
            end
            local shownPct: number | Secret<number> = 0
            if secret.isSecret(pct) then
                shownPct = pct
            elseif pct then
                shownPct = pct
            end
            if mode == "value" then
                right:SetFormattedText("%s", shownValue)
            elseif mode == "both" then
                right:SetFormattedText("%s · %d%%", shownValue, shownPct)
            else
                right:SetFormattedText("%d%%", shownPct)
            end
            right.value = nil
            return
        end
        -- what the text is made from: the same as last time, nothing to set
        local pctKey: number | false = false
        if pct and not secret.isSecret(pct) then
            pctKey = math.floor(pct + 0.5)
        end
        local curKey: number | false = false
        if withValue and not secret.isSecret(cur) then
            curKey = cur
        end
        if self.textMode == mode and self.textPct == pctKey and self.textCur == curKey then
            return
        end
        self.textMode, self.textPct, self.textCur = mode, pctKey, curKey
        local value: string? = nil
        if withValue then
            value = secret.asString(shortNumber(cur))
        end
        if mode == "value" then
            right:SetValue(value or "")
        elseif mode == "both" then
            right:SetValue(pct and ("%s · %d%%"):format(value or "", pct + 0.5) or (value or ""))
        else
            right:SetValue(pct and ("%d%%"):format(pct + 0.5) or "")
        end
    end

    function UpdatePower()
        local A = self.api
        local u = self.unit
        local powerFor = self.opts.powerFor
        if not u or self.offline or self.opts.power == false or (powerFor and not powerFor(u, A)) then
            self.power:Hide()
            self.powerLow:Hide()
            self.powerSpend:Hide()
            return
        end
        local pType, token = A.UnitPowerType(u)
        local max = A.UnitPowerMax(u, pType)
        local shown = secret.isSecret(max) or (max or 0) > 0
        self.power:SetShown(shown)
        self.powerLow:SetShown(shown and token == "MANA")
        -- your cast's cost (the player's frame): the line and its amber show
        -- what stays, the faded bar under them your power now; the engine
        -- subtracts (UI/PowerCost), Lua never touches the secret amount
        local cast = self.cast
        local cost = shown and cast and cast:Amount(pType, max) or nil
        self.powerSpend:SetShown(cost ~= nil)
        if not shown then
            return
        end
        local cur = amount(A.UnitPower(u, pType))
        local color = token and POWER_TOKEN[token] or "mana"
        draw.paint(self.power, color)
        local lo, hi = 0, amount(max)
        if cost and not secret.isSecret(max) and max then
            lo, hi = powerCost.costRange(max, cost)
            draw.paint(self.powerSpend, color, powerCost.SPEND_ALPHA)
            self.powerSpend:SetMinMaxValues(0, max)
            self.powerSpend:SetValue(cur)
        end
        self.power:SetMinMaxValues(lo, hi)
        self.power:SetValue(cur)
        if token == "MANA" then
            self.powerLow:SetMinMaxValues(lo, hi)
            self.powerLow:SetValue(cur)
            self.powerLow:SetAlpha(curveAmount(A.UnitPowerPercent(u, pType, true, belowCurve(LOW_MANA))))
        end
    end

    function ShowDragon(art: crest.DragonArt | false | nil)
        local dragon = self.dragon
        if dragon then
            crest.placeDragon(dragon, art, self, self:GetHeight())
        end
    end

    function UpdateIdentity()
        local A = self.api
        local u = self.unit
        if not u or not A.UnitExists(u) then
            return
        end

        -- The marker before the name: a role icon, else the class diamond.
        local role = UnitGroupRolesAssigned and A.UnitGroupRolesAssigned(u)
        self.roleShown = roleKey(role)
        local isPlayer = uiText.flag(A.UnitIsPlayer(u))
        local _, class = A.UnitClass(u)
        local classColor: string? = nil
        if isPlayer and not secret.isSecret(class) and class then
            classColor = "class-" .. class:lower()
            local colors: { [string]: unknown } = T.color
            if not colors[classColor] then
                classColor = nil
            end
        end
        -- (the health in it too, with class colours on; an NPC's in its
        -- reaction's colour, with reaction colours on: UNIT_FACTION and a new
        -- unit come through here)
        self.fillClass = classColor
        local reaction: string? = nil
        local unknown = false
        if not isPlayer then
            local r = A.UnitReaction(u, "player")
            reaction = healthFill.reactionToken(r)
            -- (none yet, not a secret one)
            unknown = r == nil
        end
        self.fillReaction = reaction
        self.reactionUnknown = unknown
        self:PaintHealth()
        self.role:Hide()
        self.classDot:Hide()
        local marker: Texture? = nil
        local roleIcon = not secret.isSecret(role) and role and ROLE_ICON[role] or nil
        if roleIcon then
            draw.skin(self.role, roleIcon)
            draw.paint(self.role, roleIcon == "role-damage" and "ink-muted" or "ink")
            self.role:Show()
            marker = self.role
        elseif classColor then
            draw.paint(self.classDot, classColor)
            self.classDot:Show()
            marker = self.classDot
        end

        -- The name: class colour for players, reaction colour for hostile and
        -- neutral NPCs, ink for friendly ones; ink-faint when dead or offline.
        self.name:SetValue((A.UnitName(u)))
        if self.dead or self.offline then
            self.name:SetColor("ink-faint")
        elseif self.opts.nameColor == "ink" then
            self.name:SetColor("ink")
        elseif classColor then
            -- (on a class-coloured bar the class name can't be read: ink)
            self.name:SetColor(healthFill.byClass() and "ink" or classColor)
        elseif reaction and healthFill.byReaction() then
            -- (on a reaction-coloured bar the reaction's name can't be read: ink)
            self.name:SetColor("ink")
        else
            local r = A.UnitReaction(u, "player")
            if secret.isSecret(r) or not r then
                self.name:SetColor("ink")
            elseif r <= 3 then
                self.name:SetColor("reaction-hostile")
            elseif r == 4 then
                self.name:SetColor("reaction-neutral")
            else
                self.name:SetColor("ink")
            end
        end
        local shield = self.crest
        if shield then
            local classify, boss = A.UnitClassification, A.UnitIsBossMob
            local c = not isPlayer and classify and classify(u) or nil
            local dragon = self.opts.dragon and crest.dragonArt(c, boss and boss(u) or nil)
            shield:SetClassification(not dragon and c or nil)
            self:ShowDragon(dragon)
        end
        local meta = self.opts.meta
        if meta == "family" then
            local family = A.UnitCreatureFamily(u)
            self.meta:SetValue((not secret.isSecret(family) and family) or "")
        else
            self.meta:SetValue(meta and metaText(A, u) or "")
            -- the level in its difficulty's colour (a secret one: as it is)
            if meta then
                local level = A.UnitLevel(u)
                if not secret.isSecret(level) then
                    self.meta:SetColor(levelColor(level))
                end
            end
        end
        if self.opts.youWhenPlayer then
            -- "Is it you?" is a secret boolean in combat: the engine sets the
            -- badge's alpha from it. The badge keeps its place either way.
            local isYou = A.UnitIsUnit(u, "player")
            if secret.isSecret(isYou) then
                self.you:SetAlphaFromBoolean(isYou, 1, 0)
            else
                self.you:SetAlpha(isYou and 1 or 0)
            end
        end
        self:LayoutRow(marker)
    end

    function UpdateRaidMarker()
        if self.opts.raidMarker == false then
            self.marker:Hide()
            return
        end
        showRaidMarker(self.marker, self.unit, self.api)
    end

    -- marker, name, meta, badges ... health %, in one row; the name gives way.
    function LayoutRow(marker: Texture?)
        local size = self.size
        local x = 0
        for _, m in ipairs({ self.role, self.classDot }) do
            m:ClearAllPoints()
        end
        if marker then
            marker:SetPoint("LEFT", self.row, "LEFT", marker == self.classDot and 2 or 0, 0)
            x = (marker == self.role and size.role or 5) + size.gap
        end

        -- the state badge has its own spot at the row's end (the name leaves
        -- room for it); "you" follows the name
        local badges: controls.StateBadge[] = {}
        if self.you:IsShown() then
            badges[#badges + 1] = self.you
        end
        -- (on the top edge it takes none of the row)
        local badgeInRow = self.badge:IsShown() and not self.opts.badgeTop
        local endW = badgeInRow and (self.badge.knownWidth + size.gap) or 0
        -- Never read sizes back from the meta or the badges: they are anchored
        -- after the name, and a secret name makes their geometry secret too.
        local metaValue = tostring(self.meta.value or "")
        local tailW = 0
        if metaValue ~= "" then
            tailW = tailW + size.gap + uiText.measureText("caption", metaValue)
        end
        for _, b in ipairs(badges) do
            tailW = tailW + size.gap + b.knownWidth
        end

        -- A readable name sizes itself to its text and the meta and badges follow
        -- it, as the design draws it; a name that would crowd them out gets a
        -- width, which adds the ellipsis. A secret name (an enemy in combat)
        -- can't be measured: it gets the room the meta and badges leave, the
        -- engine adds the ellipsis, and they sit at the row's right end instead.
        local natural = self.name:GetUnboundedStringWidth()
        local room = self.row:GetWidth() - x - tailW - endW
        self.name:ClearAllPoints()
        self.name:SetPoint("LEFT", self.row, "LEFT", x, 0)
        local secretName = secret.isSecret(natural)
        if secret.isSecret(natural) then
            self.name:SetWidth(math.max(1, room))
        elseif natural > room and room > 20 then
            self.name:SetWidth(room)
        else
            self.name:SetWidth(0)
        end

        if self.opts.size == "sm" or secretName then
            -- right to left from the row's end (after the state badge's spot, if
            -- it shows): the badges, then the meta
            local after: Region? = badgeInRow and self.badge or nil
            local function place(region: Region)
                region:ClearAllPoints()
                if after then
                    region:SetPoint("RIGHT", after, "LEFT", -size.gap, 0)
                else
                    region:SetPoint("RIGHT", self.row, "RIGHT", 0, 0)
                end
                after = region
            end
            for i = #badges, 1, -1 do
                place(badges[i])
            end
            if metaValue ~= "" and self.opts.size ~= "sm" then
                place(self.meta)
            end
            if self.opts.size == "sm" then
                self.meta:ClearAllPoints()
                if metaValue ~= "" then
                    self.meta:SetPoint("LEFT", self.name, "RIGHT", size.gap, 0)
                end
            end
            return
        end

        local prev: Region = self.name
        if metaValue ~= "" then
            self.meta:ClearAllPoints()
            self.meta:SetPoint("LEFT", prev, "RIGHT", size.gap, 0)
            prev = self.meta
        end
        for _, b in ipairs(badges) do
            b:ClearAllPoints()
            b:SetPoint("LEFT", prev, "RIGHT", size.gap, 0)
            prev = b
        end
    end

    -- Every state badge again, after opts.badgeTop changed; the row with them.
    function PlaceBadges()
        for _, b in ipairs(self.edgeBadges) do
            placeBadge(self, b)
        end
        self:LayoutRow(self:RowMarker())
    end

    -- The marker the row starts with: the role icon or the class diamond.
    function RowMarker(): Texture?
        if self.role:IsShown() then
            return self.role
        end
        if self.classDot:IsShown() then
            return self.classDot
        end
        return nil
    end

    function SetState(tone: string?, word: string?)
        if tone == self.stateTone and word == self.stateWord then
            return
        end
        self.stateTone, self.stateWord = tone, word
        self.border:SetColor(tone and STATE_BORDER[tone] or (self.opts.anchor and "gilt-line" or "gilt-hairline"))
        self.glow:SetShown(tone == "danger")
        if tone and word then
            self.badge:SetState(tone, word)
            self.badge:Show()
        else
            self.badge:Hide()
        end
        self:LayoutRow(self:RowMarker())
    end

    function FitRow()
        local size, opts = self.size, self.opts
        local textW = (opts.size == "sm" and not opts.textOnSmall) and 0 or (TEXT_W[opts.healthText or "percent"] or 34)
        local extra = opts.reserveRight or 0
        -- (the healer frames: the name runs under the icons, which cover its
        -- end when they show; a health text keeps the row before it)
        local rowExtra = (opts.nameUnderIcons and textW == 0) and 0 or extra
        self.row:SetPoint("BOTTOMRIGHT", -(size.pad + (textW > 0 and textW + size.gap or 0) + rowExtra), 0)
        self.right:ClearAllPoints()
        self.right:SetPoint("RIGHT", -(size.pad + extra), 0)
        -- the name's room follows the row's
        if self.unit then
            self:LayoutRow(self:RowMarker())
        end
    end

    -- What the spacing and size tokens set, again (a theme changed them): the
    -- size where it comes from its tokens (not a header's button, nor one
    -- given a size by Resize), the power line, the row and its padding.
    function PlaceByTheme()
        resolveSizes()
        local size, opts = self.size, self.opts
        if self.tokenSize then
            local w, h = draw.size(opts.width or size.width), draw.size(opts.height or size.height)
            self:SetSize(w, h)
            self.incoming:SetWidth(w - 2)
            self.absorb:SetWidth(w - 2)
            self.absorbOver:SetWidth(w - 2)
        end
        for _, b in ipairs({ self.powerSpend, self.power, self.powerLow }) do
            b:SetHeight(S["space-1"])
        end
        self.row:SetPoint("TOPLEFT", size.pad, 0)
        if opts.badgeTop then
            for _, b in ipairs(self.edgeBadges) do
                pcall(placeBadge, self, b)
            end
        end
        self:FitRow()
    end

    function Resize(w: number, h: number)
        self.tokenSize = false
        self:SetSize(w, h)
        self.incoming:SetWidth(w - 2)
        self.absorb:SetWidth(w - 2)
        self.absorbOver:SetWidth(w - 2)
        if self.active then
            self:Refresh()
        end
    end

    -- Live indicators: out of combat (containers are made here). The engine
    -- never frees a container, so each frame keeps its containers by identity
    -- and reuses them: changing one indicator builds one new container, and
    -- going back to an earlier look reuses the old one. Unused ones are unbound
    -- and hidden.
    function SetIndicators(list: Indicator[]?)
        self.roleLimited = anyRoleLimited(list)
        self.groupScoped = anyGroupScoped(list)
        for _, c in ipairs(self.indicatorContainers) do
            c.container:Hide()
            c:SetUnit("none")
        end
        self.indicatorContainers = {}
        -- the missing looks: plain frames, kept by identity too
        for _, m in ipairs(self.missingLooks) do
            m.look:Hide()
        end
        self.missingLooks = {}
        for _, ind in ipairs(list or {}) do
            local show = ind.show or "up"
            if ind.kind == "fill" and show == "both" then
                show = "up"
            end
            if show ~= "up" then
                local mkey = indicatorKey(ind) .. "|" .. show .. "|" .. (ind.missingColor or "ember")
                local look = self.missingCache[mkey]
                if not look then
                    look = indicatorLook(self, self, ind, indicatorArt(ind), true)
                    self.missingCache[mkey] = look
                end
                self.missingLooks[#self.missingLooks + 1] = { look = look, mode = show, ind = ind }
            end
        end
        for i, ind in ipairs(list or {}) do
            local key = indicatorKey(ind)
            local cached = self.indicatorCache[key]
            local ids = ind.ids
            if ind.show == "missing" then
                -- only the missing look: no live container
            elseif cached then
                cached.container:Show()
                cached:SetUnit(self.unit or "none")
                indicatorOf[cached] = ind
                self.indicatorContainers[#self.indicatorContainers + 1] = cached
            elseif ids and #ids > 0 then
                local filter = ind.source == "any" and { "HELPFUL" } or { "HELPFUL", "PLAYER" }
                local group: AuraGroup = { key = "i" .. i, filter = filter, max = 1, include = ids }
                local opts: AuraOptions = {
                    size = ind.size or 10,
                    anchor = "TOPLEFT",
                    roster = self.opts.rosterRefresh ~= false,
                    groups = { group },
                }
                if ind.kind == "icon" then
                    group.stacks, group.digits = false, (ind.size or 10) >= 16
                else
                    group.initialize = function(button: AuraButton)
                        quietButton(button)
                        indicatorLook(self, button, ind)
                    end
                end
                local c = auraContainer(self, self.unit or "none", opts)
                if c then
                    if ind.kind == "icon" then
                        -- the engine lays its one icon from the container's top
                        -- left; place that corner so the icon sits at the point
                        local point: FramePoint = ind.point or "TOPRIGHT"
                        local size = ind.size or 10
                        local x, y = pointOffset(point)
                        local dx = point:find("RIGHT") and size or ((point:find("LEFT")) and 0 or size / 2)
                        local dy = point:find("BOTTOM") and size or ((point:find("TOP")) and 0 or size / 2)
                        c.container:SetPoint("TOPLEFT", self, point, x - dx, y + dy)
                        c.container:SetFrameLevel(self.over:GetFrameLevel() + 8)
                    else
                        c.container:SetPoint("TOPLEFT", self, "TOPLEFT")
                        c.container:SetFrameLevel(self.over:GetFrameLevel() + 2)
                    end
                    self.indicatorCache[key] = c
                    indicatorOf[c] = ind
                    self.indicatorContainers[#self.indicatorContainers + 1] = c
                end
            end
        end
        self:UpdateIndicatorPresence()
    end

    -- The role role-limited indicators go by for this frame's unit, read now
    -- (and kept): TANK, HEALER, else DAMAGER. A secret answer keeps the last
    -- one read for this unit (Damage if none).
    function ReadIndicatorRole(): string
        local u = self.unit
        local answer = u and UnitGroupRolesAssigned and self.api.UnitGroupRolesAssigned(u)
        local role: string
        if secret.isSecret(answer) then
            role = self.indicatorRole or "DAMAGER"
        else
            role = indicatorRole(answer or nil)
        end
        self.indicatorRole = role
        return role
    end

    -- A role may have changed (PLAYER_ROLES_ASSIGNED, ROLE_CHANGED_INFORM):
    -- with indicators limited to roles, their presence again, and only when
    -- this frame's unit's role did change.
    function UpdateIndicatorRole()
        if not self.roleLimited or not self.unit then
            return
        end
        local before = self.indicatorRole
        if self:ReadIndicatorRole() ~= before then
            self:UpdateIndicatorPresence()
        end
    end

    -- The missing looks: "both" shows whenever the unit is there (the live look
    -- covers it); "missing" only out of combat, while none of its spells is up.
    -- "on = group" limits them, and the live looks, to your own raid group, and
    -- "roles" to some roles: the live containers of everyone else are hidden,
    -- out of combat (who is in your group and their roles are known before a
    -- fight; the engine still shows the aura).
    function UpdateIndicatorPresence()
        local u = self.unit
        local exists = u ~= nil and UnitExists(u)
        local fight = InCombatLockdown()
        local mine: boolean? = nil
        local role: string? = nil
        -- whether an indicator shows here: everywhere, or in your own group,
        -- on the roles it is limited to
        local function inScope(ind: Indicator): boolean
            if not (u and exists) then
                return true
            end
            if not indicatorShowsOnUnit(ind, u) then
                return false
            end
            local roles = ind.roles
            if roles and next(roles) ~= nil then
                local r = role or self:ReadIndicatorRole()
                role = r
                if not indicatorShowsOn(ind, r) then
                    return false
                end
            end
            if (ind.on or ind.missingOn) ~= "group" then
                return true
            end
            if mine == nil then
                mine = inYourGroup(u)
            end
            return mine == true
        end
        for _, m in ipairs(self.missingLooks) do
            local show = false
            if not inScope(m.ind) then
                show = false
            elseif exists and m.mode == "both" then
                show = true
            elseif u and exists and m.mode == "missing" and not fight then
                local ind = m.ind
                local set: { [number]: boolean } = {}
                for _, id in ipairs(ind.ids or {}) do
                    set[id] = true
                end
                local filter = ind.source == "any" and "HELPFUL" or "HELPFUL|PLAYER"
                local up = false
                for i = 1, 40 do
                    local ok, a = pcall(C_UnitAuras.GetAuraDataByIndex, u, i, filter)
                    if not ok or secret.isSecret(a) or not a then
                        break
                    end
                    local id = a.spellId
                    if not secret.isSecret(id) and id and set[id] then
                        up = true
                        break
                    end
                end
                show = not up
            end
            m.look:SetShown(show)
        end
        -- live looks limited to your group: everyone else's container is hidden
        -- (out of combat; in combat the last answer stays)
        if not fight then
            for _, c in ipairs(self.indicatorContainers) do
                local ind = indicatorOf[c]
                c.container:SetShown(not ind or inScope(ind))
            end
        end
    end

    -- Preview indicators: the looks drawn directly, as if every aura were up
    -- (a "missing" one as missing, so its look can be judged). Frames are never
    -- freed either, so the looks are kept by identity, as the missing looks are.
    function SetPreviewIndicators(list: Indicator[]?)
        for _, look in ipairs(self.previewLooks) do
            look:Hide()
        end
        self.previewLooks = {}
        for _, ind in ipairs(list or {}) do
            local missing = ind.show == "missing"
            local key = indicatorKey(ind) .. "|" .. (missing and ("missing|" .. (ind.missingColor or "ember")) or "up")
            local look = self.previewCache[key]
            if not look then
                look = indicatorLook(self, self, ind, indicatorArt(ind), missing)
                self.previewCache[key] = look
            end
            look:Show()
            self.previewLooks[#self.previewLooks + 1] = look
        end
    end

    -- keepAttribute: the unit attribute is already set (a group header did it).
    -- later (a group module's frame, rosterRefresh = false): only its events
    -- follow the token now; its aura containers, indicators and drawing wait
    -- for the owner's next RosterUpdate, once per burst of reassignments
    -- (the same person on another token then needs no drawing at all).
    function SetUnit(unit: string?, keepAttribute: boolean?, later: boolean?)
        if unit == self.unit then
            return
        end
        local defer = later == true and unit ~= nil
        local wasActive = self.active
        local occupant = self.occupant
        if wasActive then
            self:Deactivate()
        end
        self.unit = unit
        if self.opts.secure ~= false and not keepAttribute then
            self:SetAttribute("unit", unit)
        end
        if defer then
            -- (whether it is someone else, the pass reads)
            self.unitMoved = true
            self.occupant = occupant
        else
            -- another person: their role is read anew
            self.indicatorRole = nil
            self.unitMoved = false
            self:SyncContainers(unit or "none", unit ~= nil)
            self:UpdateIndicatorPresence()
            -- (drawn now, when it listens: in step with whoever it shows)
            self.occupant = unit and occupantOf(unit) or nil
        end
        if wasActive and unit then
            self:Activate(defer)
        end
    end

    -- The aura containers this frame made (the debuff types', the
    -- indicators', Warded's) on `unit`: re-pointed where they show another
    -- token (which re-scans them), the others re-scanned with `rescan`
    -- (someone else on the same token: a container doesn't notice).
    private function SyncContainers(unit: string, rescan: boolean)
        for _, list in pairs(self.dispelSets) do
            for _, c in ipairs(list) do
                if c.unit ~= unit then
                    c:SetUnit(unit)
                elseif rescan then
                    c:Refresh()
                end
            end
        end
        for _, c in ipairs(self.indicatorContainers) do
            if c.unit ~= unit then
                c:SetUnit(unit)
            elseif rescan then
                c:Refresh()
            end
        end
        local ward = self.wardSlot
        if ward then
            if ward.unit ~= unit then
                ward:SetUnit(unit)
            elseif rescan then
                ward:Refresh()
            end
        end
    end

    -- After a roster change, from the frame's owner (a group module's pass,
    -- once per burst). Someone else on the token (or unknown: a secret GUID,
    -- or not drawn for its owner since it was activated): drawn anew, the
    -- containers re-scanned, the indicators read again; true. The same
    -- person, on the same token or another: only what a roster change can
    -- change for them, their role (the marker, the power line,
    -- role-limited indicators) and their raid group (indicators limited to
    -- yours); false.
    function RosterUpdate(): boolean
        local u = self.unit
        self.unitMoved = false
        if not u then
            return false
        end
        local now = occupantOf(u)
        local same = now ~= false and now == self.occupant
        self:SyncContainers(u, not same)
        if same then
            local A = self.api
            local role: unknown = nil
            if UnitGroupRolesAssigned then
                role = A.UnitGroupRolesAssigned(u)
            end
            if roleKey(role) ~= self.roleShown then
                self:UpdateIdentity()
                self:UpdatePower()
            end
            self:UpdateIndicatorRole()
            if self.groupScoped then
                self:UpdateIndicatorPresence()
            end
            return false
        end
        self.occupant = now
        self.indicatorRole = nil
        self:UpdateIndicatorPresence()
        self:Refresh()
        return true
    end

    -- The type's border and badge over this frame, on `parent` (a slot's button,
    -- or the frame itself in a preview).
    function DispelDecoration(parent: Frame, kind: string): Frame
        local tone = kind:lower()
        local deco = CreateFrame("Frame", nil, parent)
        deco:SetAllPoints(self)
        deco:EnableMouse(false)
        draw.border(deco, "dispel-" .. tone)
        local badge = controls.stateBadge(deco, tone, kind)
        self.edgeBadges[#self.edgeBadges + 1] = badge
        placeBadge(self, badge)
        -- at least as wide as the Aggro badge it covers, so none of it peeks out
        badge:SetWidth(math.max(badge.knownWidth, uiText.measureText("badge", "Aggro") + 10))
        -- over the frame's own border and text and over Warded; Magic on top,
        -- then down the list
        local rank = 1
        for i, k in ipairs(DEBUFF_TYPES) do
            if k == kind then
                rank = i
            end
        end
        deco:SetFrameLevel(self.over:GetFrameLevel() + 3 + (#DEBUFF_TYPES - rank))
        return deco
    end

    -- "all" (every type), "removable" (only what you can remove) or "off". Out of
    -- combat: the first use of a set creates its containers.
    function SetDispelBadges(mode: string)
        if (mode == "all" or mode == "removable") and not self.dispelSets[mode] then
            self.dispelSets[mode] = buildDispelSet(self, mode)
        end
        for set, list in pairs(self.dispelSets) do
            for _, c in ipairs(list) do
                c.container:SetShown(set == mode)
            end
        end
    end

    -- The ward border, badge and glow over this frame, on `parent` (the slot's
    -- button, or the frame itself in a preview).
    function WardDecoration(parent: Frame): WardDecoration
        return WardDecoration.new(parent, self)
    end

    -- The spells that ward this frame (nil or empty: none). Out of combat: the
    -- first call creates the slot.
    function SetWardSpells(given: number[]?)
        local ids = given or {}
        local slot = self.wardSlot
        if slot then
            slot:SetGroupSpells("ward", ids)
            return
        end
        if #ids == 0 then
            return
        end
        local init = function(button: AuraButton)
            quietButton(button)
            self:WardDecoration(button)
        end
        local c = auraContainer(self, self.unit or "none", {
            size = 1,
            anchor = "TOPLEFT",
            roster = self.opts.rosterRefresh ~= false,
            groups = { { key = "ward", filter = { "HELPFUL" }, max = 1, include = ids, initialize = init } },
        })
        if c then
            c.container:SetPoint("TOPLEFT", self, "TOPLEFT")
            c.container:SetFrameLevel(self.over:GetFrameLevel() + 1)
            self.wardSlot = c
        end
    end

    function Refresh()
        local A = self.api
        local u = self.unit
        self:FitRow()
        if not u or not A.UnitExists(u) then
            return
        end
        self.dead = uiText.flag(A.UnitIsDeadOrGhost(u))
        self.offline = isOffline(A, u)
        self:UpdateIdentity()
        self:UpdateHealth(true)
        self:UpdatePower()
        self:UpdateRaidMarker()
    end

    -- One of the unit's events (UNIT_EVENTS): a health event marks what it
    -- changed for the driver; power and identity redraw at once.
    private function OnUnitEvent(name: string)
        local part = HEALTH_PART[name]
        if part then
            markHealth(self, part)
        elseif POWER_EVENT[name] then
            self:UpdatePower()
        elseif IDENTITY_EVENT[name] then
            self:UpdateIdentity()
            -- (a tag changed: the health's colour)
            if name == "UNIT_FACTION" then
                self:UpdateHealth(true)
            end
        elseif name == "UNIT_CONNECTION" then
            self:Refresh()
        elseif name == "UNIT_FLAGS" then
            if self.reactionUnknown then
                self:UpdateIdentity()
            end
        end
    end

    -- later: listening only, drawn by the owner's next RosterUpdate (a
    -- header's new token: SetUnit's `later`)
    function Activate(later: boolean?)
        local u = self.unit
        if self.active or not u then
            return
        end
        self.active = true
        live[self] = true
        -- (class colours on or off, the raid marker, the world, roles and the
        -- roster: one listener each for every active frame, below)
        -- the unit's events: one watch for the frame's life, pointed at
        -- the token (another token later: re-pointed, nothing made)
        local watch = self.watch
        if not watch then
            watch = watchUnit(
                UNIT_EVENTS,
                function(name: string)
                    self:OnUnitEvent(name)
                end,
                self
            )
            self.watch = watch
        end
        watch:setUnit(u)
        -- the player's frame: your cast's cost faded at the power line's end
        if u == "player" and self.opts.powerCost ~= false then
            local cast = self.cast or powerCost.castCost(self.api :: CostApi)
            self.cast = cast
            cast:Listen(self, function()
                self:UpdatePower()
            end)
        end
        if u == "target" then
            events.onGame(
                "PLAYER_TARGET_CHANGED",
                function()
                    self:Refresh()
                end,
                self
            )
        elseif u == "focus" then
            events.onGame(
                "PLAYER_FOCUS_CHANGED",
                function()
                    self:Refresh()
                end,
                self
            )
        elseif u == "targettarget" then
            events.onGame(
                "PLAYER_TARGET_CHANGED",
                function()
                    self:Refresh()
                end,
                self
            )
            -- your target picks another target: UNIT_TARGET fires for "target"
            -- (never for "targettarget"), and the poll only redraws health
            events.onUnit(
                "UNIT_TARGET",
                "target",
                function()
                    self:Refresh()
                end,
                self
            )
        elseif u == "pet" then
            events.onUnit(
                "UNIT_PET",
                "player",
                function()
                    self:Refresh()
                end,
                self
            )
        elseif u:find("^boss") then
            events.onGame(
                "INSTANCE_ENCOUNTER_ENGAGE_UNIT",
                function()
                    self:Refresh()
                end,
                self
            )
        end
        local poll = self.opts.poll
        if poll then
            -- A unit with no events of its own: redraw while shown.
            self.ticker = timer.every(poll, function()
                local now = self.unit
                if self:IsVisible() and now and UnitExists(now) then
                    self:UpdateHealth(true)
                    self:UpdatePower()
                end
            end)
        end
        if not later then
            self:Refresh()
        end
    end

    function Deactivate()
        if not self.active then
            return
        end
        self.active = false
        live[self] = nil
        -- (what it waited for is moot; who it shows is unknown from now on)
        due[self] = nil
        self.healthStale = 0
        self.occupant = nil
        local watch = self.watch
        if watch then
            watch:setUnit(nil)
        end
        events.offAll(self)
        local ticker = self.ticker
        if ticker then
            ticker:Cancel()
            self.ticker = nil
        end
        -- (a cost shown stays no longer than its events)
        local cast = self.cast
        if cast then
            cast:Clear()
            if self.powerSpend:IsShown() then
                self:UpdatePower()
            end
        end
    end
end
mixins.UnitFrame = UnitFrame

--------------------------------------------------------------------------------
-- The listeners every active frame shares: one each, walking the active
-- frames (each frame's own, 4 to 5 per frame, were a dispatch per frame on
-- every one of these events: some 400 in a raid with its pets)
--------------------------------------------------------------------------------

local function eachLive(fn: (f: UnitFrame) -> ())
    for f in pairs(live) do
        fault.log:run(SOURCE, fn, f)
    end
end

local function redrawIdentity(f: UnitFrame)
    f:UpdateIdentity()
end
local function redrawMarker(f: UnitFrame)
    f:UpdateRaidMarker()
end
local function redrawAll(f: UnitFrame)
    f:Refresh()
end
-- A role chosen or changed: the marker and the power line (powerFor: tanks
-- and healers). A group module's frames: their module's roster pass reads it.
local function redrawRole(f: UnitFrame)
    if f.opts.rosterRefresh ~= false then
        f:UpdateIdentity()
        f:UpdatePower()
    end
end

-- class colours on or off (the setting or the theme): the name's colour with
-- it (the fill repaints itself)
events.on(
    "SUUUI_THEME_CHANGED",
    function()
        eachLive(redrawIdentity)
    end,
    SOURCE
)
events.onGame(
    "RAID_TARGET_UPDATE",
    function()
        eachLive(redrawMarker)
    end,
    SOURCE
)
events.onGame(
    "PLAYER_ENTERING_WORLD",
    function()
        eachLive(redrawAll)
    end,
    SOURCE
)
events.onGame(
    "PLAYER_ROLES_ASSIGNED",
    function()
        eachLive(redrawRole)
    end,
    SOURCE
)
-- A roster change: once a frame (the game sends them in bursts), for the
-- frames that redraw themselves on one (rosterRedraw); a group module's
-- frames are its module's (RosterUpdate). Your raid group is read anew.
events.onGame(
    "GROUP_ROSTER_UPDATE",
    function()
        subgroupRead = false
        if next(live) ~= nil then
            rosterDue = true
            driver:Show()
        end
    end,
    SOURCE
)

-- 0.29: SuuUI's secure unit frames (a copy of the list), in the order they
-- were made: the frames a secure click binding goes on.
export function secureUnitFrames(): UnitFrame[]
    local out: UnitFrame[] = {}
    for i, f in ipairs(secureFrames) do
        out[i] = f
    end
    return out
end

-- A unit frame (Raw.Mixins.UnitFrame is the class). opts.frame: a button a
-- group header made (SecureUnitButtonTemplate), which becomes the frame.
export function unitFrame(parent: Frame?, unit: string?, opts: UnitFrameOptions?): UnitFrame
    local o: UnitFrameOptions = opts or {}
    local frame = o.frame
    if frame then
        return UnitFrame.adopt(frame, parent, unit, o)
    end
    return UnitFrame.new(parent, unit, o)
end
