-- UI/ObjectiveTracker.wowlua
-- The objective tracker (design board "Objective tracker"): on the world,
-- no panel. A head (an 18px toggle with a plus or minus, "Quests" in the
-- header face, a gilt rule fading out, the meta caption), then the quests
-- space-4 apart: the title (label, the quest's difficulty colour), its
-- objectives indented space-4 (a 4px ink-muted diamond, or a check once
-- done in ink-muted; the count right-aligned in tabular figures), or an
-- arcane check and "Ready to turn in" once every objective is done.
--
--   local t = objectiveTracker(parent, { width = 260, maxHeight = 440 })
--   t:SetQuests(quests, freeze)   -- { questID, zone, title, difficulty, complete,
--                                 --   failed, turnIn, objectives = { { text,
--                                 --   progress, done } }, item }; 0.13: color (a
--                                 --   token for the title), icon (16px before
--                                 --   it), count ("×3", arcane, after it): the
--                                 --   Recipes tracker draws recipes this way
--   t:SetCollapsed(on)            -- only the head
--   t:SetQuestsCollapsed(on)      -- 0.13: the quests folded, the Recipes
--                                 -- section still shown (then SetQuests)
--   t:QuestTop(questID)           -- where a quest's title starts (px down
--                                 -- from the tracker's top), for its item;
--                                 -- nil while scrolled out of sight
--   t:ScrollBy(px), t:SetScrollLocked(on), t.onScroll() -- the wheel scrolls
--                                 -- the quests within maxHeight
--   t.onToggle, t.onQuestClick(questID, button) -- set by the owner
--   t:SetRecipes(list, collapsed, meta) -- 0.13: a Recipes section after the
--                                 -- quests, its own head in the list (they
--                                 -- scroll together); entries like quests
--                                 -- (questID = the recipe ID); then SetQuests
--   t.onRecipeClick(recipeID, button, row), t.onSectionToggle("recipes"),
--   t.onRowEnter(row)             -- the mouse onto an entry (row.quest)
--   opts.toggle: the owner's own (secure) toggle button, drawn here, placed
--   by the owner over the head's left end (HEAD_H square at the top left)
--
-- Quests with a `zone` get its heading (caption, gilt-text, a fading rule)
-- wherever the zone changes; give them grouped.
-- `freeze` (in combat, when quest items are beside the titles): the quests
-- keep their places and a quest's height only grows, so a secure item
-- button set beside a title before combat stays beside it. New quests go
-- at the end; a quest gone leaves its space. The next SetQuests without
-- freeze lays everything out again.
-- `item.preview` draws a plain icon beside the title (the settings
-- preview); the real, secure item buttons belong to the owner.

import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import * as uiIcon from "/UI/Icon"
import * as inputs from "/UI/Inputs"
import * as uiText from "/UI/Text"
import * as tooltip from "/UI/Tooltip"

local S = T.space

local HEAD_H = 18
-- a title's and a line's height: the label's and caption's (read each
-- layout: a theme can change them)
local function titleH(): number return T.type.label.lineHeight end
local function lineH(): number return T.type.caption.lineHeight end
local INDENT = S["space-4"]
local ICON = 16

local DIFFICULTY: { [string]: string } = {
    impossible = "quest-impossible", ["very-difficult"] = "quest-very-difficult",
    difficult = "quest-difficult", standard = "quest-standard", trivial = "quest-trivial",
}

export const TRACKER_HEAD_H = HEAD_H

-- A diamond bullet: 4px, turned 45°, 3px either side.
local function bullet(parent: any): any
    local d = draw.diamond(parent, 4, "ink-muted", "ARTWORK")
    return d
end

local function objectiveLine(row: any): any
    local l = CreateFrame("Frame", nil, row)
    l.bullet = bullet(l)
    l.check = inputs.check(l, 11, "ink-muted")
    l.text = uiText.text(l, "caption", "ink")
    l.text:SetShadowed(true)
    l.text:SetWordWrap(true)
    l.text:SetJustifyH("LEFT")
    l.text:SetPoint("TOPLEFT", 10 + S["space-3"], 0)
    l.count = uiText.text(l, "numeric", "ink")
    l.count:SetShadowed(true)
    l.count:SetPoint("TOPRIGHT", 0, 1)
    return l
end

local function questRow(t: any): any
    local r = CreateFrame("Button", nil, t.list)
    r:RegisterForClicks("LeftButtonUp", "RightButtonUp")
    r.title = uiText.text(r, "label", "quest-standard")
    r.title:SetShadowed(true)
    r.title:SetJustifyH("LEFT")
    -- 0.13: an entry's own icon before the title (a tracked recipe's
    -- product) and a count after it ("×3")
    r.icon = uiIcon.icon(r, ICON)
    r.icon:Hide()
    r.count = uiText.text(r, "numeric", "arcane")
    r.count:SetShadowed(true)
    r.count:SetPoint("TOPRIGHT", 0, 0)
    r.lines = {}
    r.done = CreateFrame("Frame", nil, r)
    r.done.check = inputs.check(r.done, 12, "arcane")
    r.done.check:SetPoint("LEFT", INDENT, 0)
    r.done.text = uiText.text(r.done, "caption", "arcane")
    r.done.text:SetShadowed(true)
    r.done.text:SetPoint("LEFT", r.done.check, "RIGHT", S["space-2"], 0)
    -- the settings preview's item: a plain icon left of the title
    r.preview = uiIcon.icon(r, "icon-md")
    r.preview:SetPoint("TOPRIGHT", r, "TOPLEFT", -S["space-3"], 2)
    r.preview:Hide()
    r:SetScript("OnEnter", function(self)
        if self.quest and self.quest.tooltip then tooltip.showTooltip(self, self.quest.tooltip) end
        if t.onRowEnter and self.quest then t.onRowEnter(self) end
    end)
    r:SetScript("OnLeave", function() tooltip.hideTooltip() end)
    r:SetScript("OnClick", function(self, button)
        if not self.quest then return end
        if self.quest.recipe then
            if t.onRecipeClick then t.onRecipeClick(self.quest.questID, button, self) end
        elseif t.onQuestClick then
            t.onQuestClick(self.quest.questID, button, self)
        end
    end)
    return r
end

-- A zone's heading over its quests: caption in gilt-text, a gilt-line
-- hairline fading out after it.
local function zoneRow(t: any): any
    local z = CreateFrame("Frame", nil, t.list)
    z.text = uiText.text(z, "caption", "gilt-text")
    z.text:SetShadowed(true)
    z.text:SetPoint("LEFT")
    z.rule = draw.hairline(z, "gilt-line", "out")
    z.rule:SetPoint("LEFT", z.text, "RIGHT", S["space-3"], 0)
    z.rule:SetPoint("RIGHT")
    return z
end

-- A section's head inside the list (0.13: Recipes, under the quests): like
-- the tracker's own head, its own toggle, title, rule and meta; it scrolls
-- with the list, so quests and recipes share the tracker's height.
local function sectionRow(t: any): any
    local h = CreateFrame("Frame", nil, t.list)
    h:SetHeight(HEAD_H)
    h.toggle = CreateFrame("Button", nil, h)
    h.toggle:SetSize(HEAD_H, HEAD_H)
    h.toggle:SetPoint("LEFT")
    draw.fill(h.toggle, "surface-glass", "BACKGROUND"):SetAllPoints()
    h.toggle.edge = draw.border(h.toggle, "gilt-line")
    h.toggle:SetScript("OnEnter", function(self) self.edge:SetColor("gilt") end)
    h.toggle:SetScript("OnLeave", function(self) self.edge:SetColor("gilt-line") end)
    h.toggle:SetScript("OnClick", function() if t.onSectionToggle and h.key then t.onSectionToggle(h.key) end end)
    h.plus = inputs.plus(h.toggle, "gilt-text")
    h.plus:SetPoint("CENTER")
    h.minus = inputs.minus(h.toggle, "gilt-text")
    h.minus:SetPoint("CENTER")
    h.label = uiText.text(h, "header", "gilt-text")
    h.label:SetShadowed(true)
    h.label:SetPoint("LEFT", HEAD_H + S["space-3"], 0)
    h.meta = uiText.text(h, "caption", "ink-muted")
    h.meta:SetShadowed(true)
    h.meta:SetPoint("RIGHT")
    h.rule = draw.hairline(h, "gilt-line", "out")
    h.rule:SetPoint("LEFT", h.label, "RIGHT", S["space-3"], 0)
    h.rule:SetPoint("RIGHT", h.meta, "LEFT", -S["space-3"], 0)
    return h
end

type Entry = { zone?: string, id?: any, section?: string, recipe?: any }

-- The list's entries: a zone heading wherever the zone changes (quests
-- carry `zone`; none: no headings), then its quests.
local function entriesOf(quests: any[]): Entry[]
    local entries: Entry[], last: string? = {}, nil
    for _, q in ipairs(quests) do
        if q.zone and q.zone ~= last then
            entries[#entries + 1] = { zone = q.zone }
            last = q.zone
        end
        entries[#entries + 1] = { id = q.questID, zone = q.zone }
    end
    return entries
end

-- While the quests scroll they make room for the thumb at the right edge.
local GUTTER = S["space-5"] + 1

-- The toggle's look (the toggle itself may be a secure button the owner
-- made: t.toggle).
local function toggleArt(b: any)
    draw.fill(b, "surface-glass", "BACKGROUND"):SetAllPoints()
    b.edge = draw.border(b, "gilt-line")
    b:HookScript("OnEnter", function(self) self.edge:SetColor("gilt") end)
    b:HookScript("OnLeave", function(self) self.edge:SetColor("gilt-line") end)
end

export class ObjectiveTracker extends Frame
    width: any
    maxHeight: any
    rows: any
    zoneRows: any
    sectionRows: any
    heights: any
    head: Frame
    toggle: any
    plus: any
    minus: any
    label: any
    meta: any
    rule: any
    clip: Frame
    list: Frame
    thumb: Texture
    scroll: number
    recipes: any = nil
    recipesCollapsed: any = nil
    recipesMeta: any = nil
    contentWidth: any = nil
    entries: any = nil
    tops: any = nil
    listHeight: any = nil
    scrollLocked: any = nil
    collapsed: any = nil
    questsCollapsed: any = nil

    constructor(parent: any, opts: { [string]: any }?)
        opts = opts or {}
        super(opts.name, parent)
        self.width = opts.width or 260
        self.maxHeight = opts.maxHeight
        self:SetSize(self.width, HEAD_H)
        self.rows = {}
        self.zoneRows = {}
        self.sectionRows = {}
        self.heights = {}

        self.head = CreateFrame("Frame", nil, self)
        self.head:SetPoint("TOPLEFT")
        self.head:SetPoint("TOPRIGHT")
        self.head:SetHeight(HEAD_H)
        -- the toggle: a plain button, or the owner's (a secure one, placed by
        -- the owner over the head's left end: anchored into the tracker, which
        -- changes height in combat, it would lock the tracker's layout)
        local toggle = opts.toggle
        if not toggle then
            toggle = CreateFrame("Button", nil, self.head)
            toggle:SetPoint("LEFT")
            toggle:SetScript("OnClick", function() if self.onToggle then self.onToggle() end end)
        end
        toggle:SetSize(HEAD_H, HEAD_H)
        toggleArt(toggle)
        self.toggle = toggle
        self.plus = inputs.plus(toggle, "gilt-text")
        self.plus:SetPoint("CENTER")
        self.minus = inputs.minus(toggle, "gilt-text")
        self.minus:SetPoint("CENTER")
        self.plus:Hide()
        self.label = uiText.text(self.head, "header", "gilt-text")
        self.label:SetShadowed(true)
        self.label:SetPoint("LEFT", self.head, "LEFT", HEAD_H + S["space-3"], 0)
        self.meta = uiText.text(self.head, "caption", "ink-muted")
        self.meta:SetShadowed(true)
        self.meta:SetPoint("RIGHT")
        self.rule = draw.hairline(self.head, "gilt-line", "out")

        -- the quests' window: clips them (wide enough on the left for the
        -- preview's item icons beside the titles)
        local itemRoom = draw.size("icon-md") + S["space-3"] + 2
        self.clip = CreateFrame("Frame", nil, self)
        self.clip:SetPoint("TOPLEFT", -itemRoom, -(HEAD_H + S["space-4"]))
        self.clip:SetPoint("TOPRIGHT", S["space-3"], -(HEAD_H + S["space-4"]))
        self.clip:SetHeight(1)
        self.clip:SetClipsChildren(true)
        self.list = CreateFrame("Frame", nil, self.clip)
        self.list:SetPoint("TOPLEFT", itemRoom, 0)
        self.list:SetWidth(self.width)
        self.list:SetHeight(1)
        -- where the window is in the list: a gilt-line thumb, 1px, right of the quests
        self.thumb = self.clip:CreateTexture(nil, "OVERLAY")
        draw.paintFill(self.thumb, "gilt-line")
        self.thumb:SetWidth(1)
        self.thumb:Hide()
        self.scroll = 0
        self:SetTitle(opts.title)
        self:SetMeta(opts.meta)
        self:EnableMouseWheel(true)
        self:SetScript("OnMouseWheel", function(_: Frame, delta: number) self:ScrollBy(-delta * (titleH() + lineH() * 2)) end)
        self:SetCollapsed(false)
        extend.add(extend.Kind.Tracker, self, {})
    end

    -- One quest drawn into its row; the row's natural height.
    function DrawQuest(r: any, q: any): number
        r.quest = q
        r.title:SetValue(q.title or "")
        r.title:SetColor(q.color or DIFFICULTY[q.difficulty or "standard"] or "quest-standard")
        local titleHeight, lineHeight = titleH(), lineH()
        r.icon:SetShown(q.icon ~= nil)
        if q.icon then
            r.icon:SetArt(q.icon)
            r.icon:SetPoint("TOPLEFT", 0, -(titleHeight - ICON) / 2)
        end
        r.count:SetValue(q.count or "")
        r.title:ClearAllPoints()
        r.title:SetPoint("TOPLEFT", q.icon and (ICON + S["space-3"]) or 0, 0)
        if q.count and q.count ~= "" then
            r.title:SetPoint("TOPRIGHT", r.count, "TOPLEFT", -S["space-3"], 0)
        else
            r.title:SetPoint("TOPRIGHT")
        end
        local w = self.contentWidth or self.width
        local y = titleHeight + S["space-1"]
        for _, l in ipairs(r.lines) do l:Hide() end
        if q.complete or q.failed then
            r.done:ClearAllPoints()
            r.done:SetPoint("TOPLEFT", 0, -y)
            r.done:SetPoint("TOPRIGHT", 0, -y)
            r.done:SetHeight(lineHeight)
            r.done.check:SetShown(not q.failed)
            r.done.text:SetColor(q.failed and "ember-text" or "arcane")
            r.done.text:ClearAllPoints()
            if q.failed then r.done.text:SetPoint("LEFT", INDENT, 0)
            else r.done.text:SetPoint("LEFT", r.done.check, "RIGHT", S["space-2"], 0) end
            r.done.text:SetValue(q.failed and "Failed" or (q.turnIn or "Ready to turn in"))
            r.done:Show()
            y = y + lineHeight
        else
            r.done:Hide()
            for i, o in ipairs(q.objectives or {}) do
                local l = r.lines[i] or objectiveLine(r)
                r.lines[i] = l
                l.bullet:SetShown(not o.done)
                l.bullet:SetPoint("TOPLEFT", 3, -(lineHeight - 4) / 2)
                l.check:SetShown(o.done and true or false)
                l.check:SetPoint("TOPLEFT", -1, -(lineHeight - 11) / 2)
                l.text:SetColor(o.done and "ink-muted" or "ink")
                l.count:SetColor(o.done and "ink-muted" or "ink")
                l.count:SetValue(o.progress or "")
                local countW = (o.progress and o.progress ~= "") and (l.count:GetUnboundedStringWidth() + S["space-3"]) or 0
                local textW = w - INDENT - 10 - S["space-3"] - countW
                l.text:SetWidth(textW)
                l.text:SetValue(o.text or "")
                local h = math.max(lineHeight, math.ceil(l.text:GetStringHeight()))
                l:ClearAllPoints()
                l:SetPoint("TOPLEFT", INDENT, -y)
                l:SetSize(w - INDENT, h)
                l:Show()
                y = y + h + 1
            end
        end
        r.preview:SetShown(q.item and q.item.preview and true or false)
        if q.item and q.item.preview then r.preview:SetArt(q.item.icon) end
        return y
    end

    -- The recipes section (shown after the quests): t:SetRecipes(list, collapsed, meta)
    function SetRecipes(list: any, collapsed: any, meta: string?)
        self.recipes = list or {}
        self.recipesCollapsed = collapsed and true or false
        self.recipesMeta = meta
    end

    function SetQuests(quests: any, freeze: any)
        if freeze and self.contentWidth then
            -- frozen: the width stays too
            self:LayOut(quests, freeze)
        else
            self.contentWidth = self.width
            self:LayOut(quests, freeze)
            if self.maxHeight and (self.listHeight or 0) > self:ViewHeight() then
                self.contentWidth = self.width - GUTTER
                self:LayOut(quests, freeze)
            end
        end
        self.list:SetWidth(self.contentWidth)
        self:Fit()
        self:ApplyScroll()
    end

    function LayOut(quests: any, freeze: any)
        quests = quests or {}
        local byID: { [any]: any } = {}
        for _, q in ipairs(quests) do byID[q.questID] = q end
        -- the entries: as given, or (frozen) the last ones with new quests after
        local entries: Entry[]
        if freeze and self.entries then
            entries = {}
            local seen: { [any]: boolean }, last: string? = {}, nil
            for _, e in ipairs(self.entries) do
                entries[#entries + 1] = e
                if e.id then seen[e.id] = true end
                last = e.zone
            end
            for _, q in ipairs(quests) do
                if not seen[q.questID] then
                    if q.zone and q.zone ~= last then entries[#entries + 1] = { zone = q.zone }; last = q.zone end
                    entries[#entries + 1] = { id = q.questID, zone = q.zone }
                end
            end
        else
            entries = entriesOf(quests)
            self.heights = {}
        end
        -- the recipes after the quests (frozen too: they sit below every quest);
        -- the quests folded away: only the recipes
        local kept: Entry[] = {}
        for _, e in ipairs(entries) do
            if not (e.section or e.recipe) and not self.questsCollapsed then kept[#kept + 1] = e end
        end
        entries = kept
        local byRecipe: { [any]: any } = {}
        if self.recipes and #self.recipes > 0 then
            entries[#entries + 1] = { section = "recipes" }
            if not self.recipesCollapsed then
                for _, rcp in ipairs(self.recipes) do
                    byRecipe[rcp.questID] = rcp
                    entries[#entries + 1] = { recipe = rcp.questID }
                end
            end
        end
        self.entries = entries
        for _, r in ipairs(self.rows) do r.inUse = false end
        for _, z in ipairs(self.zoneRows) do z.inUse = false end
        for _, h in ipairs(self.sectionRows) do h.inUse = false end
        self.tops = {}
        local y: number, prev: string? = 0, nil
        local nQuest, nZone, nSection = 0, 0, 0
        for _, e in ipairs(entries) do
            if e.section then
                nSection = nSection + 1
                local h = self.sectionRows[nSection] or sectionRow(self)
                self.sectionRows[nSection] = h
                -- space-6 over a section after the quests
                if prev then y = y + S["space-6"] end
                h.key = e.section
                h.label:SetValue("Recipes")
                h.meta:SetValue(self.recipesMeta or "")
                h.plus:SetShown(self.recipesCollapsed)
                h.minus:SetShown(not self.recipesCollapsed)
                h:SetWidth(self.contentWidth)
                h.top, h.height, h.inUse = y, HEAD_H, true
                y = y + HEAD_H
                prev = "section"
            elseif e.recipe then
                nQuest = nQuest + 1
                local r = self.rows[nQuest] or questRow(self)
                self.rows[nQuest] = r
                local rcp = byRecipe[e.recipe]
                rcp.recipe = true
                local h = self:DrawQuest(r, rcp)
                if prev == "quest" then y = y + S["space-4"] elseif prev == "section" then y = y + S["space-4"] end
                r.top, r.height, r.inUse = y, h, true
                r:SetSize(self.contentWidth, math.max(1, h))
                y = y + h
                prev = "quest"
            elseif e.id then
                nQuest = nQuest + 1
                local r = self.rows[nQuest] or questRow(self)
                self.rows[nQuest] = r
                local q = byID[e.id]
                local h = q and self:DrawQuest(r, q) or 0
                if freeze then h = math.max(h, self.heights[e.id] or 0) end
                -- space-4 between quests, space-2 under a zone's heading
                if prev == "quest" then y = y + S["space-4"] elseif prev == "zone" then y = y + S["space-2"] end
                self.heights[e.id] = h
                self.tops[e.id] = y
                r.top, r.height, r.inUse = y, h, q ~= nil
                r:SetSize(self.contentWidth, math.max(1, h))
                y = y + h
                prev = "quest"
            else
                nZone = nZone + 1
                local z = self.zoneRows[nZone] or zoneRow(self)
                self.zoneRows[nZone] = z
                -- space-5 over a zone's heading after the one before
                if prev then y = y + S["space-5"] end
                z.text:SetValue(e.zone)
                z:SetSize(self.contentWidth, lineH())
                z.top, z.height, z.inUse = y, lineH(), true
                y = y + lineH()
                prev = "zone"
            end
        end
        self.listHeight = y
        self.list:SetHeight(math.max(1, y))
    end

    -- The quests' window: maxHeight less the head (all of them without one).
    function ViewHeight()
        if not self.maxHeight then return self.listHeight or 0 end
        return math.max(lineH(), self.maxHeight - HEAD_H - S["space-4"])
    end

    function ScrollBy(px: number)
        if self.scrollLocked then return end
        self:SetScroll((self.scroll or 0) + px)
    end

    function SetScroll(v: number)
        local max = math.max(0, (self.listHeight or 0) - self:ViewHeight())
        v = math.max(0, math.min(max, math.floor(v + 0.5)))
        if v == self.scroll then return end
        self.scroll = v
        self:ApplyScroll()
        if self.onScroll then self.onScroll() end
    end

    -- In combat with secure item buttons beside the titles: the list stays put.
    function SetScrollLocked(on: any)
        self.scrollLocked = on and true or false
    end

    -- The rows in the window shown, the rest hidden (so nothing out of sight
    -- takes a click); the thumb at the right edge while there's more.
    function ApplyScroll()
        local view = self:ViewHeight()
        local max = math.max(0, (self.listHeight or 0) - view)
        self.scroll = math.max(0, math.min(max, self.scroll or 0))
        local scroll = self.scroll
        for _, pool in ipairs({ self.rows, self.zoneRows, self.sectionRows }) do
            for _, r in ipairs(pool) do
                local visible = r.inUse and (r.top + r.height > scroll) and (r.top < scroll + view)
                if visible then
                    r:ClearAllPoints()
                    r:SetPoint("TOPLEFT", self.list, "TOPLEFT", 0, -(r.top - scroll))
                    r:Show()
                else
                    r:Hide()
                end
            end
        end
        if max > 0 then
            local trackH = view
            local thumbH = math.max(16, trackH * view / (self.listHeight or 1))
            self.thumb:ClearAllPoints()
            -- at the tracker's right edge, the quests GUTTER clear of it
            self.thumb:SetPoint("TOPRIGHT", self.list, "TOPLEFT", self.width, -((trackH - thumbH) * scroll / max))
            self.thumb:SetHeight(thumbH)
            self.thumb:Show()
        else
            self.thumb:Hide()
        end
    end

    -- Where a quest's title starts, down from the tracker's top (nil: not shown).
    function QuestTop(questID: any): number?
        local top = self.tops and self.tops[questID]
        if not top then return nil end
        top = top - (self.scroll or 0)
        -- the title scrolled out of the window (its item, 24px from 2px over the
        -- title, would hang past the window's bottom)
        if top < 0 or top - 2 + 24 > self:ViewHeight() then return nil end
        return HEAD_H + S["space-4"] + top
    end

    function SetMeta(text: string?)
        self.meta:SetValue(text or "")
        self.rule:ClearAllPoints()
        self.rule:SetPoint("LEFT", self.label, "RIGHT", S["space-3"], 0)
        if text and text ~= "" then
            self.rule:SetPoint("RIGHT", self.meta, "LEFT", -S["space-3"], 0)
        else
            self.rule:SetPoint("RIGHT", self.head, "RIGHT")
        end
    end

    function SetTitle(text: string?)
        self.label:SetValue(text or "Quests")
    end

    function SetCollapsed(on: any)
        self.collapsed = on and true or false
        self.list:SetShown(not self.collapsed)
        self:DrawToggle()
        self:Fit()
    end

    -- 0.13: only the quests folded away; the sections after them (Recipes)
    -- stay (asked for in game). Takes effect with the next SetQuests.
    function SetQuestsCollapsed(on: any)
        self.questsCollapsed = on and true or false
        self:DrawToggle()
    end

    function DrawToggle()
        local folded = self.collapsed or self.questsCollapsed
        self.plus:SetShown(folded and true or false)
        self.minus:SetShown(not folded)
    end

    function Fit()
        local h = HEAD_H
        local list = math.min(self.listHeight or 0, self:ViewHeight())
        if not self.collapsed and list > 0 then h = h + S["space-4"] + list end
        self.clip:SetHeight(math.max(1, list))
        self:SetHeight(h)
    end

    function SetMaxHeight(h: number?)
        self.maxHeight = h
        self:Fit()
        self:ApplyScroll()
    end
end
mixins.ObjectiveTracker = ObjectiveTracker

export function objectiveTracker(parent: any, opts: { [string]: any }?): ObjectiveTracker
    return ObjectiveTracker.new(parent, opts)
end
