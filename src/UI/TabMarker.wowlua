-- UI/TabMarker.wowlua
-- The chosen tab's underline and jewel for a row of tabs, moved as the
-- website's nav marker moves (asked 2026-10-19, first on the chat tabs,
-- then for every tab row): the jewel glides to the tab under the pointer
-- and back to the chosen one when the pointer leaves, and both glide to a
-- newly chosen tab, the underline taking its width; dur-base, ease-in-out.
-- A vertical list (the settings nav, the professions rail) has the jewel
-- only, gliding up and down beside its entries. With reduced motion, while
-- the row is hidden, and the first time: there at once.
--
--   local marker = tabMarker(row, { y = 0 })   -- a frame the tabs sit on
--   marker:Track(button)       -- its hover moves the jewel (once per button)
--   marker:SetChosen(button)   -- after the tabs are laid out or one is chosen;
--                              -- nil: hidden. Cheap when nothing moved.
--   marker:Aim()               -- again after the tabs moved
--
-- The marks sit on the row's frame and are placed by each button's own
-- rectangle, so the buttons may be anyone's (Blizzard's tabs in a skinned
-- window too); button.markLeft / button.markWidth override the left and
-- width when the caller lays the row out by offsets.
-- opts:
--   y       the line's and the jewel's centre above the tab's bottom (px; 0)
--   rule    a token (default "gilt-line"), or false: the jewel only
--   jewel   its size (5)
--   level   frame levels above the row (2)
--   vertical  true: entries above each other, the jewel beside them at
--           `side` ("LEFT" or "RIGHT" of the entry) + `x` px; no line
--   box     { fill = token, border = token }: a segmented control's chosen
--           look instead (asked 2026-10-19): one fill and edge the size of
--           the chosen option, gliding to the next; no line or jewel, and
--           hover doesn't move it. Give it level 1 and the buttons a level
--           above it, so their labels sit on top.

import after from "wowlua:timer"
import tokens as T from "/Core/Tokens"
import * as motion from "/Core/Motion"
import * as draw from "./Draw"

export type TabMarkerOptions = {
    y?: number,
    rule?: string | false,
    jewel?: number,
    level?: number,
    vertical?: boolean,
    side?: string,
    x?: number,
    box?: { fill: string, border: string },
}

-- A place and size: where a mark is, was or goes.
type Spot = { p?: number, s?: number }
type Mark = { at: Spot, from: Spot, to: Spot, placed?: boolean, start?: number }

export interface TabMarker
    row: Frame
    y: number
    vertical?: boolean
    side: string
    x: number
    base: number
    jewelX: number
    boxH?: number
    ruleMark: Mark
    jewelMark: Mark
    holder: Frame
    box?: Frame
    rule?: Frame
    jewel: Texture
    chosen?: Region
    hovered?: Region
    waiting?: boolean
    function Place(b: any): (number?, any, any, any)
    function Draw(): boolean
    function Aim()
    function SetChosen(button: Region?)
    function Track(button: Frame)
end

local GLIDE = T.duration["dur-base"]
local EASE = T.easing["ease-in-out"].bezier :: number[]

-- cubic-bezier(x1, y1, x2, y2) at time t: x solved for t by halving, then y
local function ease(t: number): number
    local x1, y1, x2, y2 = EASE[1], EASE[2], EASE[3], EASE[4]
    local function at(a: number, b: number, u: number): number return 3 * a * u * (1 - u) ^ 2 + 3 * b * u ^ 2 * (1 - u) + u ^ 3 end
    local lo, hi = 0, 1
    for _ = 1, 14 do
        local mid = (lo + hi) / 2
        if at(x1, x2, mid) < t then lo = mid else hi = mid end
    end
    return at(y1, y2, (lo + hi) / 2)
end

-- A moving place `p` with its size `s` (nil for the jewel): where it is
-- (at), was (from) and goes (to).
local function newMark(): Mark return { at = {}, from = {}, to = {} } end

local function aim(mark: Mark, p: number, s: number?, now: boolean)
    local to = mark.to
    if mark.placed and to.p == p and to.s == s then return end
    if now or not mark.placed then
        mark.at.p, mark.at.s, mark.start = p, s, nil
    else
        mark.from.p, mark.from.s, mark.start = mark.at.p, mark.at.s, GetTime()
    end
    to.p, to.s, mark.placed = p, s, true
end

local function step(mark: Mark): boolean
    local start = mark.start
    if not start then return false end
    local t = (GetTime() - start) / GLIDE
    if t >= 1 then
        mark.at.p, mark.at.s, mark.start = mark.to.p, mark.to.s, nil
        return false
    end
    local e = ease(t)
    local from, to = mark.from, mark.to
    mark.at.p = (from.p :: number) + ((to.p :: number) - (from.p :: number)) * e
    if to.s and from.s then mark.at.s = from.s + (to.s - from.s) * e end
    return true
end

local Marker: TabMarker = {} :: any
(Marker :: any).__index = Marker

-- A button's left, bottom, width and height from the row's bottom left, in
-- the row's units (nil while it isn't laid out).
function Marker:Place(b: any): (number?, any, any, any)
    local row = self.row
    local l, bt, rl, rb = b:GetLeft(), b:GetBottom(), row:GetLeft(), row:GetBottom()
    if not (l and bt and rl and rb) then return nil end
    local k = b:GetEffectiveScale() / row:GetEffectiveScale()
    local left, width = l * k - rl, b:GetWidth() * k
    if b.markLeft then left, width = b.markLeft, b.markWidth or width end
    return left, bt * k - rb, width, b:GetHeight() * k
end

function Marker:Draw()
    local row = self.row
    local moving = step(self.ruleMark)
    moving = step(self.jewelMark) or moving
    local box = self.box
    if box then
        local r = self.ruleMark.at
        box:ClearAllPoints()
        box:SetPoint("BOTTOMLEFT", self.row, "BOTTOMLEFT", r.p :: number, self.base)
        box:SetSize(math.max(1, r.s :: number), self.boxH :: number)
        return moving
    end
    local j = self.jewelMark.at
    self.jewel:ClearAllPoints()
    if self.vertical then
        self.jewel:SetPoint("CENTER", row, "BOTTOMLEFT", self.jewelX, j.p :: number)
    else
        local y = self.base + self.y
        local rule = self.rule
        if rule then
            local r = self.ruleMark.at
            rule:ClearAllPoints()
            rule:SetPoint("BOTTOMLEFT", row, "BOTTOMLEFT", r.p :: number, y)
            rule:SetWidth(math.max(1, r.s :: number))
        end
        self.jewel:SetPoint("CENTER", row, "BOTTOMLEFT", j.p :: number, y)
    end
    return moving
end

function Marker:Aim()
    local chosen = self.chosen
    local shown = chosen ~= nil and chosen:IsShown()
    local rule, box = self.rule, self.box
    if rule then rule:SetShown(shown) end
    if box then box:SetShown(shown) else self.jewel:SetShown(shown) end
    if not shown or not chosen then return end
    local left, bottom, width, height = self:Place(chosen)
    if not left then
        -- not laid out yet: next frame
        if not self.waiting then
            self.waiting = true
            after(0, function() self.waiting = false; self:Aim() end)
        end
        return
    end
    local now = motion.reduced() or not self.row:IsVisible()
    local over = self.hovered
    local ol, ob, ow, oh = left, bottom, width, height
    if over and over ~= chosen and over:IsShown() then
        local pl, pb, pw, ph = self:Place(over)
        if pl then ol, ob, ow, oh = pl, pb, pw, ph end
    end
    if self.box then
        self.base, self.boxH = bottom, height
        aim(self.ruleMark, left, width, now)
    elseif self.vertical then
        self.jewelX = left + (self.side == "RIGHT" and width or 0) + self.x
        aim(self.jewelMark, ob + oh / 2, nil, now)
    else
        self.base = bottom
        aim(self.ruleMark, left, width, now)
        aim(self.jewelMark, ol + ow / 2, nil, now)
    end
    if self:Draw() then
        self.holder:SetScript("OnUpdate", function()
            if not self:Draw() then self.holder:SetScript("OnUpdate", nil) end
        end)
    end
end

function Marker:SetChosen(button: Region?)
    self.chosen = button
    self:Aim()
end

function Marker:Track(button: Frame)
    if button.suuMarkTracked == self then return end
    button.suuMarkTracked = self
    button:HookScript("OnEnter", function(b) self.hovered = b; self:Aim() end)
    button:HookScript("OnLeave", function(b)
        if self.hovered == b then self.hovered = nil end
        self:Aim()
    end)
end

export function tabMarker(row: Frame, opts: TabMarkerOptions?): TabMarker
    opts = opts or {}
    local m = setmetatable({
        row = row, y = opts.y or 0, vertical = opts.vertical, side = opts.side or "LEFT", x = opts.x or 0,
        base = 0, jewelX = 0, ruleMark = newMark(), jewelMark = newMark(),
    }, Marker :: any) :: TabMarker
    -- one holder above the row's buttons: the line, then the jewel over it
    local holder = CreateFrame("Frame", nil, row)
    m.holder = holder
    holder:SetAllPoints()
    holder:SetFrameLevel(row:GetFrameLevel() + (opts.level or 2))
    local boxOpts = opts.box
    if boxOpts then
        local box = CreateFrame("Frame", nil, holder)
        m.box = box
        draw.fill(box, boxOpts.fill):SetAllPoints()
        draw.border(box, boxOpts.border)
        box:Hide()
        row:HookScript("OnShow", function() m:Aim() end)
        return m
    end
    if opts.rule ~= false and not opts.vertical then
        local rule = draw.hairline(holder, opts.rule or "gilt-line", "both")
        m.rule = rule
        rule:Hide()
    end
    local top = CreateFrame("Frame", nil, holder)
    top:SetAllPoints()
    top:SetFrameLevel(holder:GetFrameLevel() + 2)
    m.jewel = draw.diamond(top, opts.jewel or 5, "gilt")
    m.jewel:Hide()
    -- shown again after a change while hidden: placed at once
    row:HookScript("OnShow", function() m:Aim() end)
    return m
end
