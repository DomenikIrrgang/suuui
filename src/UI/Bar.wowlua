-- UI/Bar.wowlua
-- The status bar unit frames, casts and progress are built on. Values go
-- straight to the engine, so secret health and power display fine.
--
--   local bar = statusBar(parent, { width = 300, height = 32,
--       fill = "unit-fill", deep = "unit-fill-deep",   -- a gradient deep -> fill, left to right
--       track = "surface-sunk", border = "gilt-hairline",
--       ghost = true })                                  -- the damage ghost
--   bar:SetMinMax(0, max); bar:SetValue(v); bar:SetFill("unit-fill-low", "unit-fill-low-deep")
--
-- The ghost is a second bar behind the fill. It follows the value after a
-- 150ms hold and drains with the engine's own interpolation, so it works on
-- secret values too, where no Lua code may do the maths.
--
--   trail(host, ghost, v[, instant])   -- the same ghost for any bar: the unit
--                                      -- frames' health and the resource bar
--                                      -- keep theirs with it

import after from "wowlua:timer"
import * as draw from "./Draw"

export type StatusBarOptions = {
    width?: number | string,
    height?: number | string,
    fill?: string,
    deep?: string,
    track?: string,
    border?: string | false,
    ghost?: boolean,
}

local HOLD = 0.15
local INTERPOLATE = Enum.StatusBarInterpolation and Enum.StatusBarInterpolation.ExponentialEaseOut

-- Where a ghost bar follows to and its hold (a bar with a ghost carries both).
export type Trail = { ghostValue: number | Secret<number>, ghostTimer: TimerHandle? }

-- The ghost after its fill took `v`: it holds 150 ms (later values inside
-- the hold move its target, never restart it), then the engine eases it to
-- the latest value. A gain trails the same way, unseen under the fill.
-- `instant` (a new unit or power, reduced motion) moves it at once and drops
-- a waiting hold. Only SetValue touches `v`: it may be secret.
export function trail(host: Trail, ghost: StatusBar, v: number | Secret<number>, instant: boolean?)
    if instant or not INTERPOLATE then
        local held = host.ghostTimer
        if held then
            held:Cancel()
            host.ghostTimer = nil
        end
        ghost:SetValue(v)
        return
    end
    host.ghostValue = v
    if not host.ghostTimer then
        host.ghostTimer = after(HOLD, function()
            host.ghostTimer = nil
            ghost:SetValue(host.ghostValue, INTERPOLATE)
        end)
    end
end

local function makeBar(parent: Frame, color: string?): StatusBar
    local b = CreateFrame("StatusBar", nil, parent)
    draw.skinBar(b, "bar")
    b:GetStatusBarTexture():SetSnapToPixelGrid(false)
    b:SetMinMaxValues(0, 1)
    b:SetValue(0)
    if color then
        draw.paint(b, color)
    end
    return b
end

-- (a widget class: its methods are on each bar; Raw.Mixins.Bar is the class)
export class Bar extends Frame
    track: Texture
    border?: draw.Border
    bar: StatusBar
    ghost?: StatusBar
    -- where the ghost follows to (set before its timer starts)
    ghostValue: number | Secret<number> = 0
    ghostTimer?: TimerHandle

    constructor(parent: Frame, opts: StatusBarOptions?)
        super(nil, parent)
        local o: StatusBarOptions = opts or {}
        self:SetSize(draw.size(o.width or "bar-lg"), draw.size(o.height or "unit-lg"))
        self.track = draw.fill(self, o.track or "surface-sunk")
        self.track:SetAllPoints()
        draw.pattern(self.track, "track-pattern")
        if o.border ~= false then
            self.border = draw.border(self, o.border or "gilt-hairline", { layer = "OVERLAY" })
        end
        local inset = o.border ~= false and 1 or 0
        local ghost: StatusBar? = nil
        if o.ghost then
            ghost = makeBar(self, "ghost")
            ghost:SetPoint("TOPLEFT", inset, -inset)
            ghost:SetPoint("BOTTOMRIGHT", -inset, inset)
            self.ghost = ghost
        end
        self.bar = makeBar(self)
        self.bar:SetPoint("TOPLEFT", inset, -inset)
        self.bar:SetPoint("BOTTOMRIGHT", -inset, inset)
        self.bar:SetFrameLevel(self:GetFrameLevel() + 2)
        if ghost then
            ghost:SetFrameLevel(self:GetFrameLevel() + 1)
        end
        self:SetFill(o.fill or "unit-fill", o.deep or (o.fill == nil and "unit-fill-deep") or nil)
    end

    function SetFill(fill: string, deep: string?)
        draw.paintGradient(self.bar:GetStatusBarTexture(), "HORIZONTAL", deep or fill, fill)
    end

    function SetMinMax(min: number | Secret<number>, max: number | Secret<number>)
        self.bar:SetMinMaxValues(min, max)
        if self.ghost then
            self.ghost:SetMinMaxValues(min, max)
        end
    end

    function SetValue(v: number | Secret<number>)
        self.bar:SetValue(v)
        local ghost = self.ghost
        if ghost then
            trail(self, ghost, v)
        end
    end

    -- Sets the value with no ghost, e.g. when the bar switches unit.
    function SetValueNow(v: number | Secret<number>)
        self.bar:SetValue(v)
        local ghost = self.ghost
        if ghost then
            trail(self, ghost, v, true)
        end
    end
end

export function statusBar(parent: Frame, opts: StatusBarOptions?): Bar
    return Bar.new(parent, opts)
end
