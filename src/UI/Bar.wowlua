-- UI/Bar.wowlua
-- The status bar unit frames, casts and progress are built on. Values go
-- straight to the engine, so secret health and power display fine.
--
--   local bar = statusBar(parent, { width = 300, height = 32,
--       fill = "unit-fill", deep = "unit-fill-deep",   -- a gradient deep -> fill, left to right
--       track = "surface-sunk", border = "gilt-hairline",
--       ghost = true })                                  -- the damage ghost
--   bar:SetMinMax(0, max); bar:SetValue(v); bar:SetFill("unit-fill-low", "unit-fill-low-deep")
--
-- The ghost is a second bar behind the fill. It follows the value after a
-- 150ms hold and drains with the engine's own interpolation, so it works on
-- secret values too, where no Lua code may do the maths.

import after from "wowlua:timer"
import * as draw from "./Draw"

export type StatusBarOptions = {
    width?: number | string,
    height?: number | string,
    fill?: string,
    deep?: string,
    track?: string,
    border?: string | false,
    ghost?: boolean,
}

export interface Bar extends Frame
    track: Texture
    border?: draw.Border
    bar: StatusBar
    ghost?: StatusBar
    ghostTarget: any
    ghostTimer?: TimerHandle
    function SetFill(fill: string, deep: string?)
    function SetMinMax(min: any, max: any)
    function SetValue(v: any)
    function SetValueNow(v: any)
end

local WHITE = "Interface\\Buttons\\WHITE8X8"
local HOLD = 0.15
local INTERPOLATE = Enum.StatusBarInterpolation and Enum.StatusBarInterpolation.ExponentialEaseOut

local Bar = {} :: Bar

function Bar:SetFill(fill: string, deep: string?)
    draw.paintGradient(self.bar:GetStatusBarTexture(), "HORIZONTAL", deep or fill, fill)
end

function Bar:SetMinMax(min: any, max: any)
    self.bar:SetMinMaxValues(min, max)
    if self.ghost then self.ghost:SetMinMaxValues(min, max) end
end

function Bar:SetValue(v: any)
    self.bar:SetValue(v)
    local ghost = self.ghost
    if not ghost then return end
    self.ghostTarget = v
    if not self.ghostTimer then
        self.ghostTimer = after(HOLD, function()
            self.ghostTimer = nil
            ghost:SetValue(self.ghostTarget, INTERPOLATE)
        end)
    end
end

-- Sets the value with no ghost, e.g. when the bar switches unit.
function Bar:SetValueNow(v: any)
    self.bar:SetValue(v)
    local ghost = self.ghost
    if ghost then
        local timer = self.ghostTimer
        if timer then timer:Cancel() self.ghostTimer = nil end
        ghost:SetValue(v)
    end
end

local function makeBar(parent: Frame, color: string?): StatusBar
    local b = CreateFrame("StatusBar", nil, parent)
    b:SetStatusBarTexture(WHITE)
    b:GetStatusBarTexture():SetSnapToPixelGrid(false)
    b:SetMinMaxValues(0, 1)
    b:SetValue(0)
    if color then draw.paint(b, color) end
    return b
end

export function statusBar(parent: Frame, opts: StatusBarOptions?): Bar
    opts = opts or {}
    local f = CreateFrame("Frame", nil, parent) :: Bar
    Mixin(f, Bar)
    f:SetSize(draw.size(opts.width or "bar-lg"), draw.size(opts.height or "unit-lg"))
    f.track = draw.fill(f, opts.track or "surface-sunk")
    f.track:SetAllPoints()
    if opts.border ~= false then f.border = draw.border(f, opts.border or "gilt-hairline", { layer = "OVERLAY" }) end
    local inset = opts.border ~= false and 1 or 0
    local ghost: StatusBar? = nil
    if opts.ghost then
        ghost = makeBar(f, "ghost")
        ghost:SetPoint("TOPLEFT", inset, -inset)
        ghost:SetPoint("BOTTOMRIGHT", -inset, inset)
        f.ghost = ghost
    end
    f.bar = makeBar(f)
    f.bar:SetPoint("TOPLEFT", inset, -inset)
    f.bar:SetPoint("BOTTOMRIGHT", -inset, inset)
    f.bar:SetFrameLevel(f:GetFrameLevel() + 2)
    if ghost then ghost:SetFrameLevel(f:GetFrameLevel() + 1) end
    f:SetFill(opts.fill or "unit-fill", opts.deep or (opts.fill == nil and "unit-fill-deep") or nil)
    return f
end
