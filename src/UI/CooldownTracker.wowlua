-- UI/CooldownTracker.wowlua
-- SuuUI's own Cooldown Manager (step 1.7b): tracked procs, buffs and your
-- debuffs on the target as icons on top, then Essential and Utility
-- cooldowns. Blizzard's CooldownViewer isn't used.
--
--   local t = cooldownTracker(parent, { name = "SuuUICooldownManager" })
--   t:SetLists(lists)     -- { essential, utility, buffs, debuffs, procs }:
--                         -- entries { name, ids = { ... }, mine }
--   t:SetOptions(opts)    -- { essentialSize, utilityInline, readyPop,
--                         -- procHighlight }; "when missing" is each aura
--                         -- entry's own (entry.missing: buffs "grey",
--                         -- debuffs "target" unless set)
--   t:Stop(), t:Start()   -- 0.9: off (no events, aura sounds or containers in
--                         -- use) and on again; a new tracker starts running
--   t:SetFooter(frame)    -- 0.17: a frame under the rows (the resource bar);
--                         -- t:Layout() when it resizes
--
-- Cooldowns are SuuUI's own icons: whether a cooldown runs stays readable in
-- combat, and its sweep comes from the engine's duration object. Each entry
-- uses the highest rank you know; an entry you don't know isn't drawn.
--   ready      full colour, arcane edge (no glow); coming off cooldown it
--              pops with the arcane flash
--   cooldown   desaturated, sweep, digits in micro
--   unusable   opacity-disabled
--   use now    reactive abilities (Overpower, Revenge, Riposte, Mongoose
--              Bite, Counterattack, Hammer of Wrath, Victory Rush): arcane
--              ring and glow, while the game says they're usable (if it says
--              so in combat)
--   effect     (per entry, opt-in) while the spell's effect runs, its aura
--              covers the icon: a one-icon engine container over the cell,
--              gilt edge and ward glow, with the aura's own time and drain.
--              entry.effect = "you" (a buff on you) or "target" (your debuff
--              on the target); entry.effectIDs, else the spell's own IDs.
--
-- Auras are engine containers with spell lists (verified in dungeon combat).
-- Addon code can't read, count or measure them, so:
--   grey     each entry gets a fixed slot with a grey placeholder under the
--            live icon (never empty, so never a gap)
--   hide     the list packs into one container, a group per entry in list
--            order, and the engine closes the gaps itself
--   remind   shown grey only while the aura is NOT up, out of combat (the
--            only time SuuUI can read auras); hidden in combat
-- A group entry ({ group = true, name, members, ids = all members' IDs,
-- source = "mine"|"others"|"any", max = 1..4, icon, fixedIcon }) is one slot
-- for several spells: the engine shows whichever members are up (up to max),
-- each with its own icon and time; with none up the slot's icon follows "when
-- missing". That icon is `icon` when fixedIcon is set; otherwise automatic:
-- the first member (in order, those its conditions leave in) that you know,
-- else the first whose `when` is met now (none: met), else `icon`; a
-- member's art is its own `icon`, else its first ID. Picked at each build
-- (a learned rank or a static condition's change rebuilds). Source maps to
-- the filter: PLAYER, !PLAYER (verified valid), or none. A member may have
-- its own source ({ name, ids, icon, source, when }): members of different
-- sources become one engine group per source in the same slot, each with the
-- slot's max.
-- In a cooldown list a group is one cell: the LAST member you know (members
-- in order of preference: Divine Protection, then Divine Shield once
-- learned), with the group's behaviour; its effect is effectIDs, else that
-- member's IDs. None known: not drawn.
-- A collection ({ collection = true, uid, name, when, hidden, entries },
-- aura lists only) is its entries in its place, in order, each with its own
-- behaviour; its `hidden` and `when` apply to all of them. Its fixed slots
-- (grey, remind) sit apart from their neighbours: a hairline in a wider gap.
-- Conditions (`when` on any entry: a cooldown, a single aura, a group, a
-- group's member, a collection):
--   when = { match = "all"|"any" (default "all"), conditions = {
--     { type = "group", value = "solo"|"group"|"raid" },  -- a raid is a group
--     { type = "classes", classes = { "DRUID", ... }, others = true? },
--                                   -- someone in your group, you too; with
--                                   -- others, only the others
--     { type = "talent", talents = { spellID, ... } },  -- you've learned any
--                                   -- of them (any class's: another's is
--                                   -- never learned)
--     { type = "role", roles = { "TANK"|"HEALER"|"DAMAGER", ... } },  -- SuuUI's
--     { type = "stance", stances = { "battle"|"defensive"|"berserker"|"caster"|
--       "bear"|"cat"|"moonkin"|"travel"|"aquatic"|"stealth"|"shadowform", ... } },
--     { type = "combat" },
--     { type = "instance", kinds = { "none"|"party"|"raid"|"pvp", ... } },
--                                   -- an arena is pvp
--     { type = "target", kinds = { "boss"|"elite"|"player"|"normal", ... } },
--                                   -- one kind each: a player, else a
--                                   -- boss (worldboss, level ??, or the
--                                   -- game says so), else elite (rare
--                                   -- elite too), else normal; no target:
--                                   -- none
--   } }
-- ["not"] = true turns one around. No conditions: always. A condition with
-- nothing chosen (an empty list) counts as absent. A collection's `when`
-- applies to its entries (with each one's own: both must hold); a member's
-- only to that member. Not met: left out (no grey slot, no reminder; a
-- member: out of its slot).
--   static   group, classes, role, instance, talent: checked when the tracker
--            builds; a roster, role, zone or talent change that changes them
--            rebuilds, after combat. An entry they rule out isn't built.
--            Talents learned are read from the active talent config (a node
--            with a rank, its entry's spell), kept until the talents or the
--            spellbook change; a spell you know (IsPlayerSpell) counts too.
--   live     stance, combat, target: an entry that turns on them is built
--            and shown or hidden in place, in combat too, and its row closes
--            up. Cells, fixed slots and reminders are SuuUI's frames. A
--            packed entry ("hide" when missing, procs), a slot's member with
--            a live condition (an engine group of its own in the slot) and a
--            cell's effect are engine groups: their max goes to 0 and back.
--            The engine takes that change in combat too (confirmed in game:
--            a "hide" buff with a stance condition follows stance switches
--            mid-fight); a refused change would still apply when combat
--            ends. Aura sounds stay registered
--            for an entry hidden by a live condition.
--   In a cooldown list a group's member's `when` rules it out (the cell
--   shows the last one you know of the rest); a live one hides the cell.
--   cooldownConditionMet(when)   -- whether a `when` is met now
-- The timers row centres on its divider, since a packed list's width can't
-- be known: buffs and procs grow left of it, your debuffs right. Order from
-- the divider outward: grey slots, reminders, then the packed ones.
-- A weapon enchant entry ({ enchant = "main"|"off"|"ranged", name }, buffs
-- only) is a fixed slot of SuuUI's own (weaponEnchantIcon: enchants stay
-- readable in combat): whatever is on that weapon, with its MH/OH tag; with
-- nothing on it, its "when missing": hide, grey, or warn (the default; the
-- ember edge, only out of combat unless entry.warnCombat). No weapon in the
-- slot (a shield in the off hand): not shown.

import after from "wowlua:timer"
import * as secret from "wowlua:secret"
import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as events from "/Core/Events"
import * as motion from "/Core/Motion"
import * as fault from "/Core/Fault"
import * as extend from "/Core/Extend"
import * as roles from "/Core/Roles"
import * as draw from "/UI/Draw"
import flag from "/UI/Text"
import icon, Icon from "/UI/Icon"
import auraContainer, AuraOptions, AuraGroup, UnitAuras from "/UI/Auras"
import weaponEnchantable, WeaponEnchantIcon from "/UI/WeaponEnchants"
import * as tbl from "wowlua:table"

const S = T.space

-- A value addon code can read, or the fallback when it is secret or missing.
local known = secret.known

-- A cooldown read's isActive and isOnGCD, false while unknown. (The read is
-- typed as possibly secret as a whole: such a table counts as unknown.)
local function cooldownFlags(
    info: SpellCooldownInfoSecret | SpellCooldownInfo | Secret<SpellCooldownInfo> | nil
): (boolean, boolean)
    if issecretvalue(info) or not info then
        return false, false
    end
    return known(info.isActive, false), known(info.isOnGCD, false)
end

const CROP = 0.08
const AURA = "icon-lg"

local REACTIVE: { [string]: boolean } = {
    ["Overpower"] = true,
    ["Revenge"] = true,
    ["Riposte"] = true,
    ["Mongoose Bite"] = true,
    ["Counterattack"] = true,
    ["Hammer of Wrath"] = true,
    ["Execute"] = true,
    ["Victory Rush"] = true,
}

--------------------------------------------------------------------------------
-- The lists (see the header): saved settings, so read with care
--------------------------------------------------------------------------------

-- A condition of a `when`.
export type TrackerCondition = {
    type?: string,
    ["not"]?: boolean,
    value?: string,
    classes?: string[],
    others?: boolean,
    talents?: unknown[],
    roles?: string[],
    stances?: string[],
    kinds?: string[],
}

-- "Show only when": all (or any) of its conditions.
export type TrackerWhen = { match?: string, conditions?: TrackerCondition[] }

-- An entry of a list: a spell (ids, its ranks), a group of members sharing a
-- slot, a collection of entries, or a weapon enchant; and its behaviour.
export type TrackerEntry = {
    name?: string,
    ids?: number[],
    mine?: boolean,
    icon?: number,
    -- a group
    group?: boolean,
    members?: TrackerEntry[],
    source?: string,
    max?: number,
    fixedIcon?: boolean,
    -- a collection
    collection?: boolean,
    uid?: string | number,
    entries?: TrackerEntry[],
    hidden?: boolean,
    when?: TrackerWhen,
    -- (a group's member shown in a cooldown list: its own `when`)
    memberWhen?: TrackerWhen,
    -- a weapon enchant
    enchant?: string,
    warnCombat?: boolean,
    -- behaviour
    missing?: string,
    effect?: string,
    effectIDs?: number[],
    pop?: boolean,
    sound?: string,
    show?: string,
    onCooldown?: string,
    unusable?: string,
    ready?: string,
    border?: string,
    glow?: boolean,
    digits?: boolean,
    stacks?: boolean,
    expiring?: number,
    size?: string,
    soundAppear?: string,
    soundStack?: string,
    soundDrop?: string,
    -- (the editor's: the effect's name, as the Behaviour panel shows it)
    effectName?: string,
    -- (a setting the editor's Behaviour panel reads and writes by its key)
    [string]: unknown,
}

-- The lists by name: essential, utility, buffs, debuffs, procs.
export type TrackerLists = { [string]: TrackerEntry[] }

export type TrackerOptions = {
    essentialSize?: number,
    utilityInline?: boolean,
    readyPop?: boolean,
    procHighlight?: boolean,
}

export type CooldownTrackerOptions = { name?: string }

-- What a pass over many conditions looks up once (lookUp), and `combat`:
-- the tracker's own idea of combat (it knows the moment combat starts and
-- ends).
export type CondContext = { [string]: unknown }

-- An aura entry's engine group: its filter, its spells, and a live member's
-- `when`.
export type AuraPart = { filter: string[], ids: number[], when?: TrackerWhen }

-- An aura entry's looks for its engine groups.
export type AuraLook = {
    border?: string,
    glow?: string,
    drain?: string,
    digits?: boolean,
    stacks?: boolean,
    expiring?: number,
}

--------------------------------------------------------------------------------
-- Cooldown cells
--------------------------------------------------------------------------------

-- The rank of an entry you know (highest ID first), or nil.
local function knownRank(entry: TrackerEntry): number?
    local ids = entry.ids or {}
    for i = #ids, 1, -1 do
        local id = ids[i]
        if IsPlayerSpell and IsPlayerSpell(id) then
            return id
        end
    end
    return nil
end

-- Whether you know an entry's spell: a rank of it, or (a group) of any of
-- its members. Auras cast by something else than your spell (totem buffs,
-- Demonic Sacrifice's) read as unknown: they only show while up.
local function knowsEntry(entry: TrackerEntry): boolean
    if not entry.group then
        return knownRank(entry) ~= nil
    end
    for _, m in ipairs(entry.members or {}) do
        if knownRank(m) then
            return true
        end
    end
    return false
end

-- A shallow copy of an entry.
local function copyEntry(entry: TrackerEntry): TrackerEntry
    local from: { [string]: unknown } = entry
    local out: { [string]: unknown } = {}
    for k, v in pairs(from) do
        out[k] = v
    end
    return out :: TrackerEntry
end

-- A group in a cooldown list is one cell: the last member you know (members
-- are in order of preference), as an entry with the group's behaviour and
-- that member's name and spells. Nil when you know none.
local function cooldownMember(entry: TrackerEntry): TrackerEntry?
    local members = entry.members or {}
    for i = #members, 1, -1 do
        local m = members[i]
        if m.ids and #m.ids > 0 and knownRank(m) then
            local e = copyEntry(entry)
            e.group, e.members, e.icon = nil, nil, nil
            e.name, e.ids, e.memberWhen = m.name, m.ids, m.when
            return e
        end
    end
    return nil
end

-- An entry's art: the rank you know, else its lowest ID (Rank 1, the
-- player's spell; the highest IDs are often NPC versions with other art).
local function iconFor(entry: TrackerEntry): number?
    local id = entry.icon or knownRank(entry) or (entry.ids or {})[1]
    return id and (C_Spell.GetSpellTexture(id)) or nil
end

-- px nil: the micro style's own size. A theme can change the style's face
-- and size, so each font is kept and set again then.
type DigitFont = { name: string, font: Font, px: number? }
local digitFonts: { [string | number]: DigitFont } = {} -- key -> { name, font, px }
local function setDigitFont(d: DigitFont)
    local micro = T.type["micro"]
    d.font:SetFont(micro.file, d.px or micro.size, "OUTLINE")
end
local function digitFont(px: number?): string
    local key: string | number = px and math.floor(px) or "Micro"
    local d = digitFonts[key]
    if not d then
        local fontName = "SuuUITrackerDigits" .. key
        d = { name = fontName, font = CreateFont(fontName), px = px }
        setDigitFont(d)
        digitFonts[key] = d
    end
    return d.name
end
events.on(
    "SUUUI_THEME_CHANGED",
    function()
        for _, d in pairs(digitFonts) do
            setDigitFont(d)
        end
    end,
    "CooldownTracker"
)

-- Per-entry looks (the Behaviour panel): edge colours and sounds.
local EDGE: { [string]: string } = { ink = "ink", gilt = "gilt", muted = "ink-muted" }
-- Interface sounds every client has. The engine's aura sounds take files only
-- (C_UnitAuras.AddAuraSound: unitToken, spellID, soundFileID), and Forever
-- resolves no file paths, so they are file IDs; the sound kit is the fallback
-- for cooldowns and previews when a file won't play.
export type Sound = { file: number, kit: string }
local SOUNDS: { [string]: Sound } = {
    chime = { file = 567409, kit = "READY_CHECK" },
    ping = { file = 567416, kit = "MAP_PING" },
    proc = { file = 567458, kit = "ALARM_CLOCK_WARNING_2" },
    warning = { file = 567397, kit = "RAID_WARNING" },
}

export function trackerSound(key: string)
    local s = SOUNDS[key]
    if not s then
        return
    end
    local ok, willPlay = pcall(PlaySoundFile, s.file, "Master")
    -- (SOUNDKIT is declared as a plain table: kit names to sound kit IDs)
    local kits = SOUNDKIT and SOUNDKIT :: { [string]: number? }
    local kit = kits and kits[s.kit]
    if not (ok and willPlay) and kit then
        pcall(PlaySound, kit, "Master")
    end
end

-- Aura sounds: registered with the engine, which plays them itself when the
-- aura appears, stacks up or drops (in combat too). Any caster's aura of
-- those spells counts: the engine takes no filter here.
local soundIDs: number[] = {}
local soundWhat: { [number | string]: string } = {}

-- For "/suu probe sound play": the files, and what is registered.
export function trackerSoundFiles(): { [string]: Sound }
    return SOUNDS
end
export function trackerAuraSounds(): (number[], { [number | string]: string })
    return soundIDs, soundWhat
end

local function clearAuraSounds()
    for _, id in ipairs(soundIDs) do
        pcall(C_UnitAuras.RemoveAuraSound, id)
    end
    soundIDs, soundWhat = {}, {}
end

local function addAuraSounds(entry: TrackerEntry, unit: string)
    if not (C_UnitAuras and C_UnitAuras.AddAuraSound and Enum.UnitAuraSoundTrigger) then
        return
    end
    local TRIGGER = Enum.UnitAuraSoundTrigger
    local fields: { field: string, sound: string?, trigger: UnitAuraSoundTrigger? }[] = {
        { field = "soundAppear", sound = entry.soundAppear, trigger = TRIGGER.Added },
        { field = "soundStack", sound = entry.soundStack, trigger = TRIGGER.ApplicationsIncreased },
        { field = "soundDrop", sound = entry.soundDrop, trigger = TRIGGER.Removed },
    }
    for _, f in ipairs(fields) do
        local sound = f.sound and SOUNDS[f.sound]
        local file = sound and sound.file
        local trigger = f.trigger
        if file and trigger then
            for _, spellID in ipairs(entry.ids or {}) do
                local ok, id = pcall(C_UnitAuras.AddAuraSound, trigger, {
                    unitToken = unit,
                    spellID = spellID,
                    soundFileID = file,
                    outputChannel = "Master",
                })
                if ok and id then
                    soundIDs[#soundIDs + 1] = id
                    soundWhat[#soundIDs] = ("%s %s %d (%s)"):format(entry.name or "?", f.field, spellID, unit)
                elseif not ok then
                    soundWhat.error = tostring(id)
                end
            end
        end
    end
end

-- A cell of one size, not yet holding a spell (TR:Cell fills it).
export class TrackerCell extends Frame
    icon: Icon
    cooldown: Cooldown
    ring: draw.Border
    flash: Texture
    pulse: AnimationGroup
    onCooldown: boolean? = nil
    wantShown: boolean? = nil
    -- what it shows, set by the tracker's Cell()
    entry: TrackerEntry = {}
    spellID: number = 0
    reactive: boolean = false
    -- the effect's aura container (UI/Auras)
    container: UnitAuras? = nil
    dirty: boolean? = nil
    whens: TrackerWhen[]? = nil
    condOK: boolean? = nil

    constructor(parent: Frame, size: number)
        super(nil, parent)
        self:SetSize(size, size)
        self.icon = icon(self, size)
        self.icon:SetAllPoints()
        self.cooldown = CreateFrame("Cooldown", nil, self.icon, "CooldownFrameTemplate")
        self.cooldown:SetPoint("TOPLEFT", 1, -1)
        self.cooldown:SetPoint("BOTTOMRIGHT", -1, 1)
        self.cooldown:SetDrawEdge(false)
        self.cooldown:SetDrawBling(false)
        self.cooldown:SetSwipeColor(0, 0, 0, 0.7)
        self.cooldown:SetHideCountdownNumbers(false)
        if self.cooldown.SetCountdownFont then
            pcall(self.cooldown.SetCountdownFont, self.cooldown, digitFont(size >= 30 and 12 or nil))
        end
        self.cooldown:HookScript("OnCooldownDone", function()
            self.dirty = true
        end)
        local over = CreateFrame("Frame", nil, self)
        over:SetAllPoints()
        over:SetFrameLevel(self.cooldown:GetFrameLevel() + 2)
        self.ring = draw.border(over, "arcane", { inset = 3, layer = "OVERLAY" })
        self.ring:SetShown(false)
        self.flash = over:CreateTexture(nil, "OVERLAY", nil, 3)
        self.flash:SetAllPoints()
        draw.paintFill(self.flash, "arcane", 0.35)
        self.flash:SetAlpha(0)
        -- "Pulse" when ready: the icon breathes
        self.pulse = self.icon:CreateAnimationGroup()
        self.pulse:SetLooping("BOUNCE")
        local a = self.pulse:CreateAnimation("Alpha")
        a:SetFromAlpha(1)
        a:SetToAlpha(0.55)
        a:SetDuration(0.6)
        self:EnableMouse(false)
    end

    function Update(opts: TrackerOptions)
        local id, e = self.spellID, self.entry
        local info = C_Spell.GetSpellCooldown(id)
        local active, gcd = cooldownFlags(info or nil)
        if active then
            local d = C_Spell.GetSpellCooldownDuration and C_Spell.GetSpellCooldownDuration(id)
            if d then
                self.cooldown:SetCooldownFromDurationObject(d)
            end
            self.cooldown:SetHideCountdownNumbers(gcd)
        else
            self.cooldown:Clear()
        end
        local onCooldown = active and not gcd
        if self.onCooldown and not onCooldown then
            -- came ready: the pop (per entry, else the global setting) and its sound
            local pop = e.pop
            if pop == nil then
                pop = opts.readyPop ~= false
            end
            if pop then
                self.icon:Pop()
                self.flash:SetAlpha(1)
                motion.alphaTo(self.flash, 0, T.duration["dur-slow"])
            end
            if e.sound then
                trackerSound(e.sound)
            end
        end
        self.onCooldown = onCooldown

        local usable, noMana = C_Spell.IsSpellUsable(id)
        local canUse = known(usable, true) and not known(noMana, false)
        -- A reactive ability lights up only while the game says it's usable. In
        -- combat that answer can be secret: then it looks neither ready nor
        -- "use now", just neutral.
        local unsure = self.reactive and not onCooldown and secret.isSecret(usable)
        local useNow = self.reactive and not onCooldown and not secret.isSecret(usable) and usable == true

        -- whether it shows at all: only when ready / only on cooldown, and hide
        -- on cooldown or while unusable
        local show, want = e.show or "always", true
        if (show == "ready" and onCooldown) or (show == "cooldown" and not onCooldown) then
            want = false
        end
        if onCooldown and e.onCooldown == "hide" then
            want = false
        end
        if not onCooldown and not canUse and e.unusable == "hide" then
            want = false
        end
        -- and its live conditions (stance, combat, target), when it has any
        self.wantShown = want and self.condOK ~= false

        local ready = e.ready or "normal"
        local pulse = false
        if onCooldown then
            self.icon:SetBorder(nil)
            -- grey (desaturated) or dim (full colour, faded)
            self.icon:SetState(e.onCooldown == "dim" and "rest" or "dim")
            self.icon:SetGlow(nil)
        elseif useNow then
            self.icon:SetBorder(nil)
            self.icon:SetState("ready")
        elseif unsure then
            self.icon:SetState("rest")
            self.icon:SetBorder(nil)
            self.icon:SetGlow(nil)
        else
            self.icon:SetState("rest")
            self.icon:SetBorder(e.border and EDGE[e.border] or "arcane")
            self.icon:SetGlow((ready == "glow" or ready == "pulse") and "glow-arcane" or nil)
            pulse = ready == "pulse"
        end
        -- "Pulse" keeps breathing across updates (they come many times a
        -- second): it starts once and stops only when the cell leaves it
        if pulse and not self.pulse:IsPlaying() then
            self.pulse:Play()
        elseif not pulse and self.pulse:IsPlaying() then
            self.pulse:Stop()
            self.icon:SetAlpha(1)
        end
        self.ring:SetShown(useNow)
        local alpha = 1
        if onCooldown and e.onCooldown == "dim" then
            alpha = T.opacity["opacity-oor"]
        elseif not onCooldown and not canUse then
            alpha = T.opacity["opacity-disabled"]
        end
        self:SetAlpha(alpha)
    end
end

--------------------------------------------------------------------------------
-- Conditions ("Show only when")
--------------------------------------------------------------------------------

local AURA_LISTS: { [string]: boolean } = { buffs = true, debuffs = true, procs = true }

-- Static types are checked when the tracker builds (and again when the
-- group, role, zone or talents change); live ones in place, in combat too.
local LIVE: { [string]: boolean } = { stance = true, combat = true, target = true }

-- The list a condition chooses from; with nothing chosen it counts as absent.
local CHOICES: { [string]: string } = {
    classes = "classes",
    role = "roles",
    stance = "stances",
    instance = "kinds",
    target = "kinds",
    talent = "talents",
}

-- Shapeshift forms by spell (checked against Forever's spell scan); the
-- names of these spells, in the client's language, catch other IDs.
local FORMS: { [number]: string } = {
    [2457] = "battle",
    [71] = "defensive",
    [2458] = "berserker",
    [5487] = "bear",
    [9634] = "bear",
    [768] = "cat",
    [24858] = "moonkin",
    [783] = "travel",
    [1066] = "aquatic",
    [1784] = "stealth",
    [15473] = "shadowform",
}
local formNames: { [string]: string }? = nil
local function formByName(name: string): string?
    local names = formNames
    if not names then
        local made: { [string]: string } = {}
        for id, key in pairs(FORMS) do
            local n = C_Spell.GetSpellName(id)
            if not issecretvalue(n) and n then
                made[n] = key
            end
        end
        formNames = made
        names = made
    end
    return names[name]
end

-- Your stance or form as a key: "caster" in none; a rogue in any form is in
-- Stealth (every rank).
local function currentStance(): string?
    local index = GetShapeshiftForm and GetShapeshiftForm()
    if index == nil or secret.isSecret(index) then
        return nil
    end
    if index == 0 then
        return "caster"
    end
    local _, class = UnitClass("player")
    if not issecretvalue(class) and class == "ROGUE" then
        return "stealth"
    end
    local _, _, _, spellID = GetShapeshiftFormInfo(index)
    if spellID == nil or secret.isSecret(spellID) then
        return nil
    end
    local form = FORMS[spellID]
    if form then
        return form
    end
    local name = C_Spell.GetSpellName(spellID)
    if not issecretvalue(name) and name then
        return formByName(name)
    end
    return nil
end

-- Your target as one kind: player, boss, elite or normal (nil: none).
-- Anything the game keeps secret reads as not that.
local function targetKind(): string?
    if not known(UnitExists("target"), false) then
        return nil
    end
    if known(UnitIsPlayer("target"), false) then
        return "player"
    end
    local class = known(UnitClassification("target"), nil)
    if class == "worldboss" or known(UnitLevel("target"), 0) == -1 or
        (UnitIsBossMob and known(UnitIsBossMob("target"), false)) then
        return "boss"
    end
    if class == "elite" or class == "rareelite" then
        return "elite"
    end
    return "normal"
end

-- IsInInstance's type as a kind (an arena is pvp, a scenario a dungeon);
-- the design's names are taken too.
local INSTANCE: { [string]: string } = {
    none = "none",
    party = "party",
    raid = "raid",
    pvp = "pvp",
    arena = "pvp",
    scenario = "party",
}
local INSTANCE_ALIAS: { [string]: string } = { world = "none", dungeon = "party", battleground = "pvp" }
local function instanceKind(): string
    local inside, kind = IsInInstance()
    if not known(inside, false) then
        return "none"
    end
    return INSTANCE[known(kind, "none")] or "none"
end

-- The classes in your group as a set: you included, or (others) only the
-- others. A class the game keeps secret counts as nobody's.
local function rosterClasses(others: boolean): { [string]: boolean }
    local set: { [string]: boolean } = {}
    local function add(unit: string)
        if others and known(UnitIsUnit(unit, "player"), false) then
            return
        end
        local _, class = UnitClass(unit)
        if not issecretvalue(class) and class then
            set[class] = true
        end
    end
    if not others then
        add("player")
    end
    if known(IsInRaid and IsInRaid(), false) then
        for i = 1, 40 do
            add("raid" .. i)
        end
    else
        for i = 1, 4 do
            add("party" .. i)
        end
    end
    return set
end

-- The talents you've learned, as a set of spell IDs: every node of the
-- active talent config with a rank (Forever lays the three trees out in one),
-- its chosen entry's spell (else every entry's). Read once and kept until
-- the talents or the spellbook change (forgetTalents); nil while there's no
-- config to read (right after login), so it's read again next time.
local talentCache: { [number]: boolean }? = nil

-- A node's ranks, as the game (or a test) gives them.
type NodeRanks = { ranksPurchased?: unknown, activeRank?: unknown, currentRank?: unknown }

local function ranked(r: unknown): boolean
    return not secret.isSecret(r) and type(r) == "number" and r > 0
end

local function hasRank(ni: NodeRanks): boolean
    return ranked(ni.ranksPurchased) or ranked(ni.activeRank) or ranked(ni.currentRank)
end

local function readTalents(): { [number]: boolean }?
    local cfg = C_ClassTalents and C_ClassTalents.GetActiveConfigID and C_ClassTalents.GetActiveConfigID()
    if cfg == nil or secret.isSecret(cfg) or not C_Traits then
        return nil
    end
    local info = C_Traits.GetConfigInfo(cfg)
    if not (info and info.treeIDs) then
        return nil
    end
    local set: { [number]: boolean } = {}
    local function addEntry(entryID: unknown)
        if entryID == nil or secret.isSecret(entryID) or type(entryID) ~= "number" then
            return
        end
        local ei = C_Traits.GetEntryInfo(cfg, entryID)
        local def = ei and ei.definitionID
        if not def or secret.isSecret(def) then
            return
        end
        local di = C_Traits.GetDefinitionInfo(def)
        if not di then
            return
        end
        local spellID, overridden = di.spellID, di.overriddenSpellID
        if not issecretvalue(spellID) and spellID then
            set[spellID] = true
        end
        if not issecretvalue(overridden) and overridden then
            set[overridden] = true
        end
    end
    for _, treeID in ipairs(info.treeIDs) do
        for _, nodeID in ipairs(C_Traits.GetTreeNodes(treeID) or {}) do
            local ni = C_Traits.GetNodeInfo(cfg, nodeID)
            if ni and hasRank(ni) then
                local activeEntry = ni.activeEntry
                local active = activeEntry and activeEntry.entryID
                if active ~= nil and not secret.isSecret(active) then
                    addEntry(active)
                else
                    for _, entryID in ipairs(ni.entryIDs or {}) do
                        addEntry(entryID)
                    end
                end
            end
        end
    end
    return set
end

local function learnedTalents(): { [number]: boolean }
    if not talentCache then
        local ok, set = pcall(readTalents)
        talentCache = ok and set or nil
    end
    return talentCache or {}
end

local function forgetTalents()
    talentCache = nil
end

-- What a pass over many conditions looks up once (ctx[key], from fn; none:
-- false, so it isn't looked up again).
local function lookUp<V>(ctx: CondContext, key: string, fn: () -> V?): V | false
    local v = ctx[key]
    if v == nil then
        local read = fn()
        if read == nil then
            ctx[key] = false
            return false
        end
        ctx[key] = read
        return read
    end
    return v :: V | false
end

local function listHas(list: string[]?, value: string | false, alias: { [string]: string }?): boolean
    for _, v in ipairs(list or {}) do
        if v == value or (alias and alias[v] == value) then
            return true
        end
    end
    return false
end

-- Each type's test, before "not". ctx.combat, when set, is the tracker's
-- own idea of combat (it knows the moment combat starts and ends).
local TEST: { [string]: (c: TrackerCondition, ctx: CondContext) -> boolean } = {
    group = function(c: TrackerCondition, _: CondContext): boolean
        local raid = known(IsInRaid and IsInRaid(), false)
        if c.value == "raid" then
            return raid
        end
        local group = raid or known(IsInGroup and IsInGroup(), false)
        if c.value == "solo" then
            return not group
        end
        return group
    end,
    classes = function(c: TrackerCondition, ctx: CondContext): boolean
        local others = c.others == true
        local roster = lookUp(ctx, others and "rosterOthers" or "roster", function(): { [string]: boolean }
            return rosterClasses(others)
        end)
        for _, class in ipairs(c.classes or {}) do
            if roster and roster[class] then
                return true
            end
        end
        return false
    end,
    role = function(c: TrackerCondition, ctx: CondContext): boolean
        return listHas(
            c.roles,
            lookUp(ctx, "role", function(): string
                return (roles.current())
            end)
        )
    end,
    instance = function(c: TrackerCondition, ctx: CondContext): boolean
        return listHas(c.kinds, lookUp(ctx, "instance", instanceKind), INSTANCE_ALIAS)
    end,
    stance = function(c: TrackerCondition, ctx: CondContext): boolean
        return listHas(c.stances, lookUp(ctx, "stance", currentStance))
    end,
    combat = function(_: TrackerCondition, ctx: CondContext): boolean
        local fight = ctx.combat
        if fight ~= nil then
            return fight == true
        end
        return InCombatLockdown() or known(UnitAffectingCombat("player"), false)
    end,
    target = function(c: TrackerCondition, ctx: CondContext): boolean
        return listHas(c.kinds, lookUp(ctx, "target", targetKind))
    end,
    -- any of them learned: in the talent config, else a spell you know
    talent = function(c: TrackerCondition, ctx: CondContext): boolean
        local learned = lookUp(ctx, "talents", learnedTalents)
        for _, id in ipairs(c.talents or {}) do
            if type(id) == "number" then
                if learned and learned[id] then
                    return true
                end
                if IsPlayerSpell and known(IsPlayerSpell(id), false) then
                    return true
                end
            end
        end
        return false
    end,
}

-- A condition that counts: a known type, and something chosen. (Saved
-- settings: anything may be there.)
local function counts(c: unknown): c is TrackerCondition
    if type(c) ~= "table" then
        return false
    end
    local fields = c :: { [string]: unknown }
    local kind = fields.type
    if type(kind) ~= "string" or not TEST[kind] then
        return false
    end
    local field = CHOICES[kind]
    if not field then
        return true
    end
    local chosen = fields[field]
    return #tbl.list(chosen) > 0
end

local function test(c: TrackerCondition, ctx: CondContext): boolean
    -- (counts(c) has checked that TEST has c.type)
    local r = (TEST[c.type :: string] :: (c: TrackerCondition, ctx: CondContext) -> boolean)(c, ctx)
    if c["not"] then
        return not r
    end
    return r
end

-- The conditions of a `when` (saved settings: none, or not a list).
local function conditionsOf(when: unknown): unknown[]?
    if type(when) ~= "table" then
        return nil
    end
    local list = (when :: { [string]: unknown }).conditions
    if type(list) ~= "table" then
        return nil
    end
    return tbl.list(list)
end

-- Whether a `when` is met now (no conditions: always).
local function conditionMet(when: TrackerWhen?, context: CondContext?): boolean
    local list = conditionsOf(when)
    if not when or not list then
        return true
    end
    local ctx = context or {}
    local any, counted = when.match == "any", false
    for _, c in ipairs(list) do
        if counts(c) then
            counted = true
            local r = test(c, ctx)
            if any and r then
                return true
            end
            if not any and not r then
                return false
            end
        end
    end
    return not (any and counted)
end

export function cooldownConditionMet(when: TrackerWhen?): boolean
    return conditionMet(when, {})
end

-- A `when` as the build sees it, from its static conditions alone: "met",
-- "unmet", or "live" (it turns on stance, combat or the target: built, and
-- shown or hidden in place). With "any", one static condition met is enough;
-- otherwise it is live while a live one could still make it true.
local function staticState(when: TrackerWhen?, ctx: CondContext): string
    local list = conditionsOf(when)
    if not when or not list then
        return "met"
    end
    local any, counted, live = when.match == "any", false, false
    for _, c in ipairs(list) do
        if counts(c) then
            if LIVE[c.type :: string] then
                live = true
            else
                counted = true
                local r = test(c, ctx)
                if any and r then
                    return "met"
                end
                if not any and not r then
                    return "unmet"
                end
            end
        end
    end
    if live then
        return "live"
    end
    return (any and counted) and "unmet" or "met"
end

-- Several `when`s that must all hold (a collection's and its entry's, a
-- slot's and its member's): their list with `when` added (nil ones left out).
local function chain(whens: TrackerWhen[]?, when: TrackerWhen?): TrackerWhen[]
    local out: TrackerWhen[] = {}
    for _, w in ipairs(whens or {}) do
        out[#out + 1] = w
    end
    if when then
        out[#out + 1] = when
    end
    return out
end

local function stateOf(whens: TrackerWhen[], ctx: CondContext): string
    local live = false
    for _, w in ipairs(whens) do
        local s = staticState(w, ctx)
        if s == "unmet" then
            return "unmet"
        end
        if s == "live" then
            live = true
        end
    end
    return live and "live" or "met"
end

local function allMet(whens: TrackerWhen[]?, ctx: CondContext): boolean
    for _, w in ipairs(whens or {}) do
        if not conditionMet(w, ctx) then
            return false
        end
    end
    return true
end

-- A group without the members whose condition can't be met now: a copy,
-- its IDs their union. Anything else as it is. (Members with a live
-- condition stay: auraParts gives each its own engine group.)
local function withMetMembers(entry: TrackerEntry, ctx: CondContext): TrackerEntry
    if not entry.group then
        return entry
    end
    local conditional = false
    for _, m in ipairs(entry.members or {}) do
        if m.when then
            conditional = true
            break
        end
    end
    if not conditional then
        return entry
    end
    local e = copyEntry(entry)
    local members: TrackerEntry[], ids: number[], seen: { [number]: boolean } = {}, {}, {}
    for _, m in ipairs(entry.members or {}) do
        if staticState(m.when, ctx) ~= "unmet" then
            members[#members + 1] = m
            for _, id in ipairs(m.ids or {}) do
                if not seen[id] then
                    seen[id] = true
                    ids[#ids + 1] = id
                end
            end
        end
    end
    table.sort(ids)
    e.members, e.ids = members, ids
    return e
end

--------------------------------------------------------------------------------
-- Aura slots
--------------------------------------------------------------------------------

-- An aura entry's size and looks (the Behaviour panel).
local AURA_SIZE: { [string]: string } = { small = "icon-md", normal = "icon-lg", large = "cdm-essential" }
local function auraSize(entry: TrackerEntry): number
    return draw.size(AURA_SIZE[entry.size or "normal"] or "icon-lg")
end
local function auraLook(entry: TrackerEntry, base: AuraLook?): AuraLook
    local look: AuraLook = {}
    if base then
        look.border, look.glow, look.drain = base.border, base.glow, base.drain
        look.digits, look.stacks, look.expiring = base.digits, base.stacks, base.expiring
    end
    local border = entry.border
    if border and EDGE[border] then
        look.border = EDGE[border]
    end
    if entry.glow then
        look.glow = "glow-arcane"
    end
    look.digits, look.stacks = entry.digits, entry.stacks
    look.expiring = entry.expiring
    return look
end

-- The art of a fixed slot or reminder while nothing is up: a single aura's
-- (iconFor); a shared slot's `icon` when fixedIcon is set, else automatic:
-- the first member (of those its conditions leave in) that you know, else
-- the first whose `when` is met now (none: met), else `icon`. A member's art
-- is its own `icon`, else its first ID; a member you know shows the rank you
-- know (a spell's IDs can carry two arts: Lightning Shield's majority is
-- another one than the one shamans cast).
local function slotArt(entry: TrackerEntry, ctx: CondContext): number?
    if not entry.group or entry.fixedIcon then
        return iconFor(entry)
    end
    local members = entry.members or {}
    for _, m in ipairs(members) do
        local rank = m.ids and #m.ids > 0 and knownRank(m)
        if rank then
            return (C_Spell.GetSpellTexture(rank))
        end
    end
    for _, m in ipairs(members) do
        local ids = m.ids
        if ids and #ids > 0 and conditionMet(m.when, ctx) then
            return (C_Spell.GetSpellTexture(m.icon or ids[1]))
        end
    end
    return iconFor(entry)
end

-- A fixed slot: the grey placeholder, and over it a one-icon container that
-- shows the entry's aura while it's up (`copts`, its options). TR:Slot sets
-- the placeholder's art.
export class TrackerSlot extends Frame
    readonly placeholder: Frame
    readonly art: Texture
    readonly container: UnitAuras?
    readonly enchant: boolean = false
    -- (debuffs) grey only while you have a hostile target
    withTarget: boolean? = nil
    -- the collection it came from
    coll: TrackerEntry? = nil
    whens: TrackerWhen[]? = nil
    condOK: boolean? = nil
    wantShown: boolean? = nil

    constructor(parent: Frame, warn: boolean, max: number, size: number, unit: string, copts: AuraOptions)
        super(nil, parent)
        self:SetSize(max * size + (max - 1) * S["space-2"], size)
        -- the placeholder sits under the first place (where the first member lands)
        local placeholder = CreateFrame("Frame", nil, self)
        self.placeholder = placeholder
        placeholder:SetPoint("TOPLEFT")
        placeholder:SetSize(size, size)
        local art = placeholder:CreateTexture(nil, "ARTWORK")
        art:SetPoint("TOPLEFT", 1, -1)
        art:SetPoint("BOTTOMRIGHT", -1, 1)
        art:SetTexCoord(CROP, 1 - CROP, CROP, 1 - CROP)
        art:SetDesaturated(true)
        self.art = art
        draw.fill(placeholder, "surface-sunk", "BACKGROUND"):SetAllPoints()
        draw.border(placeholder, "gilt-hairline", { layer = "OVERLAY" })
        placeholder:SetAlpha(T.opacity["opacity-oor"])
        -- Warn: an ember edge inside the square that pulses slowly
        if warn then
            draw.border(placeholder, "ember", { inset = 1, layer = "OVERLAY" })
            local pulse = placeholder:CreateAnimationGroup()
            pulse:SetLooping("BOUNCE")
            local a = pulse:CreateAnimation("Alpha")
            a:SetFromAlpha(1)
            a:SetToAlpha(0.45)
            a:SetDuration(0.9)
            placeholder:SetAlpha(0.85)
            pulse:Play()
        end
        local container = auraContainer(self, unit, copts)
        self.container = container
        if container then
            container.container:SetPoint("TOPLEFT", self, "TOPLEFT")
            container.container:SetFrameLevel(placeholder:GetFrameLevel() + 2)
        end
    end
end

-- A reminder's look-up: a filter and the spells under it.
export type ReminderCheck = { filter: string, ids: { [number]: boolean }, when?: TrackerWhen }

-- A reminder: the grey icon alone, no live aura. Shown while the aura isn't
-- up, out of combat. TR:Reminder sets what it reminds of.
export class TrackerReminder extends Frame
    readonly art: Texture
    unit: string = "player"
    checks: ReminderCheck[] = {}
    coll: TrackerEntry? = nil
    whens: TrackerWhen[]? = nil
    condOK: boolean? = nil

    constructor(parent: Frame, size: number)
        super(nil, parent)
        self:SetSize(size, size)
        local art = self:CreateTexture(nil, "ARTWORK")
        art:SetPoint("TOPLEFT", 1, -1)
        art:SetPoint("BOTTOMRIGHT", -1, 1)
        art:SetTexCoord(CROP, 1 - CROP, CROP, 1 - CROP)
        art:SetDesaturated(true)
        self.art = art
        draw.fill(self, "surface-sunk", "BACKGROUND"):SetAllPoints()
        draw.border(self, "gilt-hairline", { layer = "OVERLAY" })
        self:SetAlpha(T.opacity["opacity-oor"])
    end
end

-- A weapon enchant slot of the tracker's.
export class TrackerEnchant extends WeaponEnchantIcon
    readonly enchant: boolean = true
    entry: TrackerEntry = {}
    withTarget: boolean? = nil
    coll: TrackerEntry? = nil
    whens: TrackerWhen[]? = nil
    condOK: boolean? = nil
    wantShown: boolean? = nil

    constructor(parent: Frame, size: number)
        super(parent, size)
    end
end

-- What shows in the timers row's fixed places: a slot or a weapon enchant.
export type TrackerFixed = TrackerSlot | TrackerEnchant
-- Anything a live condition shows or hides.
type Watched = TrackerCell | TrackerSlot | TrackerReminder | TrackerEnchant

-- Whether any of a reminder's IDs is on its unit (out of combat only), each
-- source's under its own filter; a member whose live condition isn't met
-- doesn't count.
local function auraUp(r: TrackerReminder, ctx: CondContext): boolean
    for _, check in ipairs(r.checks) do
        local counted = not check.when or conditionMet(check.when, ctx)
        for i = 1, counted and 40 or 0 do
            local ok, a = pcall(C_UnitAuras.GetAuraDataByIndex, r.unit, i, check.filter)
            if not ok or issecretvalue(a) or not a then
                break
            end
            local id = a.spellId
            if not secret.isSecret(id) and check.ids[id] then
                return true
            end
        end
    end
    return false
end

-- The filter for an entry: kind ("HELPFUL"/"HARMFUL") plus its source.
-- An entry's own source (the Behaviour panel, or a group's), else the list's
-- default (a preset's "mine" on a buff counts as its own).
local function sourceFilter(kind: string, entry: TrackerEntry, default: string): string[]
    local source = entry.source or (entry.group and "mine") or (entry.mine and "mine") or default
    if source == "mine" then
        return { kind, "PLAYER" }
    end
    if source == "others" then
        return { kind, "!PLAYER" }
    end
    return { kind }
end

-- An engine group as auraParts gathers it.
type Building = { filter: string[], ids: number[], seen: { [number]: boolean }, when?: TrackerWhen }

-- An aura entry's engine groups, { filter, ids, when } each: one for a
-- single aura or a group whose members share a source; else one per source
-- its members use (a member's own, else the group's), in member order. A
-- member with a live condition gets a group of its own, carrying its `when`
-- (the group's max is how it's shown or hidden).
local function auraParts(kind: string, entry: TrackerEntry, default: string, ctx: CondContext?): AuraPart[]
    local single: AuraPart[] = { { filter = sourceFilter(kind, entry, default), ids = entry.ids or {} } }
    if not entry.group then
        return single
    end
    local own = entry.source or "mine"
    local parts: Building[], bySource: { [string]: Building } = {}, {}
    for i, m in ipairs(entry.members or {}) do
        local source = m.source or own
        local live = m.when ~= nil and staticState(m.when, ctx or {}) == "live"
        local key = live and (source .. "#" .. i) or source
        local p = bySource[key]
        if not p then
            p = {
                filter = sourceFilter(kind, { source = source }, default),
                ids = {},
                seen = {},
                when = live and m.when or nil,
            }
            bySource[key] = p
            parts[#parts + 1] = p
        end
        for _, id in ipairs(m.ids or {}) do
            if not p.seen[id] then
                p.seen[id] = true
                p.ids[#p.ids + 1] = id
            end
        end
    end
    local out: AuraPart[] = {}
    for _, p in ipairs(parts) do
        if #p.ids > 0 then
            out[#out + 1] = { filter = p.filter, ids = p.ids, when = p.when }
        end
    end
    local first = out[1]
    return (#out > 1 or (first and first.when)) and out or single
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

-- Rebuilds reuse what earlier builds made: an engine aura container can
-- never be freed, and cells and slots would pile up too. Each is kept under a
-- key of everything fixed when it was made (for a container: its unit, size,
-- flow and every group setting); a build takes a spare with the same key, or
-- makes one. Clear hands everything back (containers released: no unit,
-- hidden, deaf).

-- Everything about a container that is fixed at creation, as one string.
local function containerKey(unit: string, opts: AuraOptions): string
    local parts: string[] = { unit, tostring(opts.size), tostring(opts.anchor), table.concat(opts.growth or {}, ",") }
    for _, g in ipairs(opts.groups) do
        parts[#parts + 1] = table.concat(
            {
                g.key,
                table.concat(g.filter, ","),
                tostring(g.max),
                table.concat(g.include or {}, ","),
                table.concat(g.dispelTypes or {}, ","),
                tostring(g.border),
                tostring(g.glow),
                tostring(g.drain),
                tostring(g.digits),
                tostring(g.stacks),
                tostring(g.expiring),
                tostring(g.size),
            },
            "/"
        )
    end
    return table.concat(parts, ";")
end

-- A spare container's groups back at their own max (a live condition may
-- have set one to 0).
local function resetMax(ac: UnitAuras, groups: AuraGroup[])
    for _, g in ipairs(groups) do
        ac:SetGroupMax(g.key, g.max or 16)
    end
end

-- Things of one kind a build takes and Clear hands back, by the key of
-- everything fixed when they were made.
class Pool<X>
    readonly spare: { [string]: X[] } = {}
    taken: { key: string, thing: X }[] = {}

    -- A spare made under `key`, else a new one from make() (nil if it makes
    -- none); the second value is true for a new one.
    function Take(key: string, make: () -> X?): (X?, boolean)
        local spare = self.spare[key]
        local thing = spare and table.remove(spare)
        local fresh = thing == nil
        if not thing then
            thing = make()
        end
        if not thing then
            return nil, false
        end
        self.taken[#self.taken + 1] = { key = key, thing = thing }
        return thing, fresh
    end

    -- Everything taken back (`back` readies each: hidden, released).
    function Clear(back: (thing: X, key: string) -> ())
        for _, t in ipairs(self.taken) do
            back(t.thing, t.key)
            local spares = self.spare[t.key] or {}
            self.spare[t.key] = spares
            table.insert(spares, t.thing)
        end
        self.taken = {}
    end
end

-- A layer of the collections' hairlines.
export class TrackerSeparators extends Frame
    readonly lines: Texture[] = {}
    used: number = 0
    withTarget: boolean? = nil

    constructor(owner: Frame)
        super(nil, owner)
        self:SetAllPoints()
    end
end

-- What a build made, by row (cells; fixed slots, weapon enchants and
-- reminders).
export type TrackerBuilt = {
    essential: TrackerCell[],
    utility: TrackerCell[],
    buffs: TrackerFixed[],
    debuffs: TrackerSlot[],
    remindBuffs: TrackerReminder[],
    remindDebuffs: TrackerReminder[],
}

-- An engine group a live condition sets the max of.
export type LiveGroup = { ac: UnitAuras, key: string, max: number, applied: number, whens: TrackerWhen[] }

local function emptyBuilt(): TrackerBuilt
    return { essential = {}, utility = {}, buffs = {}, debuffs = {}, remindBuffs = {}, remindDebuffs = {} }
end

-- A frame in the timers row, and the collection it came from.
type Placed = { frame: Frame, coll: TrackerEntry? }

-- The tracker (Raw.Mixins.CooldownTracker is the class).
export class CooldownTracker extends Frame
    divider: Texture
    auraDivider: Texture
    cellPool: Pool<TrackerCell> = Pool.new()
    slotPool: Pool<TrackerSlot> = Pool.new()
    reminderPool: Pool<TrackerReminder> = Pool.new()
    enchantPool: Pool<TrackerEnchant> = Pool.new()
    auraPool: Pool<UnitAuras> = Pool.new()
    driver: Frame
    rebuild: boolean? = nil
    everBuilt: boolean? = nil
    dirty: boolean? = nil
    built: TrackerBuilt = emptyBuilt()
    cells: TrackerCell[] = {}
    liveFrames: Watched[] = {}
    liveGroups: LiveGroup[] = {}
    leftFlow: UnitAuras? = nil
    rightFlow: UnitAuras? = nil
    rowH: number? = nil
    hasLeft: boolean? = nil
    hasRight: boolean? = nil
    knownSig: string? = nil
    condSig: string? = nil
    lists: TrackerLists? = nil
    footer: Frame? = nil
    opts: TrackerOptions? = nil
    running: boolean? = nil
    sepLeft: TrackerSeparators
    sepRight: TrackerSeparators
    inFight: boolean? = nil
    condPending: boolean? = nil

    constructor(parent: Frame, opts: CooldownTrackerOptions?)
        super(opts and opts.name, parent)
        self:SetSize(1, 1)
        self.divider = draw.fill(self, "gilt-line", "ARTWORK")
        self.divider:Hide()
        self.auraDivider = draw.fill(self, "gilt-line", "ARTWORK")
        self.auraDivider:Hide()
        -- the collections' hairlines, a layer per side (the debuff side's fades
        -- with its slots)
        self.sepLeft = TrackerSeparators.new(self)
        self.sepRight = TrackerSeparators.new(self)

        -- One light pass per frame at most: rebuilds wait for the end of combat.
        -- The driver is its own frame, so it runs while the tracker is hidden
        -- (shown only in combat, or faded out on mouseover).
        self.driver = CreateFrame("Frame")
        self.driver:Hide()
        self.driver:SetScript("OnUpdate", function()
            -- (the first build doesn't wait: after a reload in combat there was
            -- nothing until the fight ended, found in game)
            if self.rebuild and (not InCombatLockdown() or not self.everBuilt) then
                self.rebuild = false
                self.everBuilt = true
                fault.call("Cooldown Manager", self.Build, self)
                self.dirty = false
                return
            end
            local again = self.dirty
            for _, cell in ipairs(self.cells) do
                if cell.dirty then
                    cell.dirty = false
                    again = true
                end
            end
            if again then
                self.dirty = false
                fault.call("Cooldown Manager", self.UpdateCooldowns, self)
            end
        end)
        self:Clear()
        self:Start()
        extend.add(extend.Kind.Cooldowns, self, { name = opts and opts.name })
    end

    -- An aura container on the tracker.
    function Aura(unit: string, opts: AuraOptions): UnitAuras?
        local ac, fresh = self.auraPool:Take("aura|" .. containerKey(unit, opts), function(): UnitAuras?
            return auraContainer(self, unit, opts)
        end)
        if ac and not fresh then
            resetMax(ac, opts.groups)
            ac:SetUnit(unit)
        end
        return ac
    end

    -- Live conditions (stance, combat, target): a cell, slot or reminder that
    -- shows only while its `whens` all hold (nil: always; UpdateLive decides).
    function Watch(thing: Watched, whens: TrackerWhen[]?)
        thing.whens, thing.condOK = whens, nil
        if whens then
            self.liveFrames[#self.liveFrames + 1] = thing
        end
    end

    -- The engine groups of a container that carry `whens` (a packed entry's, a
    -- live member's, an effect's): UpdateLive sets each one's max to 0 or back.
    function WatchGroups(ac: UnitAuras?, groups: AuraGroup[], whensOf: { [string]: TrackerWhen[] })
        if not ac then
            return
        end
        for _, g in ipairs(groups) do
            local whens = whensOf[g.key]
            if whens then
                self.liveGroups[#self.liveGroups + 1] = {
                    ac = ac,
                    key = g.key,
                    max = g.max or 16,
                    applied = g.max or 16,
                    whens = whens,
                }
            end
        end
    end

    -- A cooldown cell for an entry: a clean state (a reused cell must not pop
    -- as "ready"), and its effect.
    function Cell(entry: TrackerEntry, spellID: number, size: number): TrackerCell
        local f = self.cellPool:Take("cell|" .. size, function(): TrackerCell
            return TrackerCell.new(self, size)
        end) :: TrackerCell
        f.entry, f.spellID = entry, spellID
        f.reactive = entry.name ~= nil and REACTIVE[entry.name] or false
        f.icon:SetArt((C_Spell.GetSpellTexture(spellID)))
        f.onCooldown, f.dirty, f.wantShown = nil, nil, nil
        f.whens, f.condOK = nil, nil
        if f.pulse:IsPlaying() then
            f.pulse:Stop()
        end
        f.icon:SetAlpha(1)
        motion.alphaTo(f.flash, 0, 0)
        f.cooldown:Clear()
        f:SetAlpha(1)
        f:Show()
        -- "Effect running": the effect's aura over the icon, above the sweep and
        -- below the ready ring and flash. It hangs on the tracker, not the cell,
        -- so a cell hidden or dimmed on cooldown leaves the effect full.
        f.container = nil
        local fx: string? = entry.effect == "you" and "player" or (entry.effect == "target" and "target" or nil)
        local effectIDs = entry.effectIDs
        local fxIDs = effectIDs and #effectIDs > 0 and effectIDs or entry.ids
        if fx and fxIDs and #fxIDs > 0 then
            local container = self:Aura(fx, {
                size = size,
                anchor = "TOPLEFT",
                growth = { "RIGHT", "DOWN" },
                groups = {
                    {
                        key = "fx",
                        filter = { fx == "player" and "HELPFUL" or "HARMFUL", "PLAYER" },
                        max = 1,
                        include = fxIDs,
                        border = "gilt",
                        glow = "glow-ward",
                    },
                },
            })
            f.container = container
            if container then
                local c = container.container
                c:ClearAllPoints()
                c:SetPoint("TOPLEFT", f, "TOPLEFT")
                c:SetFrameLevel(f.cooldown:GetFrameLevel() + 1)
            end
        end
        return f
    end

    -- A fixed slot for an aura entry: an engine group per part (auraParts); a
    -- part with a live member's condition is watched.
    function Slot(entry: TrackerEntry, unit: string, parts: AuraPart[], size: number, base: AuraLook?): TrackerSlot
        local look: AuraLook = base or {}
        local max = entry.group and math.max(1, math.min(4, entry.max or 1)) or 1
        local groups: AuraGroup[], whensOf: { [string]: TrackerWhen[] } = {}, {}
        for i, p in ipairs(parts) do
            local key = i == 1 and "e" or ("e" .. i)
            groups[i] = {
                key = key,
                filter = p.filter,
                max = max,
                include = p.ids,
                border = look.border,
                glow = look.glow,
                drain = look.drain,
                digits = look.digits,
                stacks = look.stacks,
                expiring = look.expiring,
            }
            if p.when then
                whensOf[key] = { p.when }
            end
        end
        local copts: AuraOptions = { size = size, anchor = "TOPLEFT", growth = { "RIGHT", "DOWN" }, groups = groups }
        local warn = entry.missing == "warn"
        local f, fresh = self.slotPool:Take(("slot|%s|%s"):format(
            tostring(warn),
            containerKey(unit, copts)
        ), function(): TrackerSlot
            return TrackerSlot.new(self, warn, max, size, unit, copts)
        end)
        local slot = f :: TrackerSlot
        if not fresh then
            slot:Show()
            local container = slot.container
            if container then
                resetMax(container, groups)
                container:SetUnit(unit)
            end
        end
        self:WatchGroups(slot.container, groups, whensOf)
        slot.art:SetTexture(slotArt(entry, {}))
        slot.withTarget, slot.coll, slot.whens, slot.condOK = nil, nil, nil, nil
        return slot
    end

    -- A reminder for an aura entry (hidden until UpdateReminders shows it): its
    -- parts' IDs, each under its filter.
    function Reminder(entry: TrackerEntry, unit: string, parts: AuraPart[], size: number): TrackerReminder
        local f = self.reminderPool:Take("remind|" .. size, function(): TrackerReminder
            return TrackerReminder.new(self, size)
        end) :: TrackerReminder
        f.art:SetTexture(slotArt(entry, {}))
        f.unit, f.checks, f.coll, f.whens, f.condOK = unit, {}, nil, nil, nil
        for _, p in ipairs(parts) do
            local ids: { [number]: boolean } = {}
            for _, id in ipairs(p.ids) do
                ids[id] = true
            end
            f.checks[#f.checks + 1] = { filter = table.concat(p.filter, "|"), ids = ids, when = p.when }
        end
        f:Hide()
        return f
    end

    -- A weapon enchant slot for an entry (UpdateEnchants fills it).
    function Enchant(entry: TrackerEntry, size: number): TrackerEnchant
        local f = self.enchantPool:Take("ench|" .. size, function(): TrackerEnchant
            return TrackerEnchant.new(self, size)
        end) :: TrackerEnchant
        f.entry = entry
        f:SetSlot(entry.enchant or "main")
        f:SetTag(true)
        f.wantShown, f.withTarget, f.coll, f.whens, f.condOK = nil, nil, nil, nil, nil
        f:Show()
        return f
    end

    -- Hands back everything built (kept for the next build).
    function Clear()
        self.auraPool:Clear(function(ac: UnitAuras)
            ac:Release()
        end)
        self.cellPool:Clear(function(c: TrackerCell)
            c:Hide()
        end)
        -- a slot's own container goes with it
        self.slotPool:Clear(function(s: TrackerSlot)
            s:Hide()
            if s.container then
                s.container:Release()
            end
        end)
        self.reminderPool:Clear(function(r: TrackerReminder)
            r:Hide()
        end)
        self.enchantPool:Clear(function(e: TrackerEnchant)
            e:Hide()
        end)
        self.built = emptyBuilt()
        self.cells = {}
        self.liveFrames, self.liveGroups = {}, {}
        self.leftFlow, self.rightFlow = nil, nil
    end

    -- Builds the rows from the lists. Out of combat (it creates engine containers,
    -- or takes spare ones).
    function Build()
        self:Clear()
        local opts = self.opts or {}
        -- Entries without spells (a group just made) are skipped: an empty spell
        -- list would let the engine show every aura.
        -- Aura lists: a collection's entries take its place (unless it's
        -- hidden), and a hidden entry is left out. Every list: an entry whose
        -- conditions can't be met now (its own, or its collection's) is left
        -- out, as is a group's member whose condition can't; one that turns on a
        -- live condition is built and watched (whensOf: the `when`s it waits
        -- for). collOf: the collection an entry came from.
        local lists: TrackerLists, collOf: { [TrackerEntry]: TrackerEntry }, whensOf: {
            [TrackerEntry]: TrackerWhen[],
        } = {}, {}, {}
        local ctx: CondContext = {}
        for key, list in pairs(self.lists or {}) do
            local into: TrackerEntry[] = {}
            lists[key] = into
            local aurasList = AURA_LISTS[key]
            local function add(entry: TrackerEntry, coll: TrackerEntry?)
                -- turned off in the lists (presets ship some auras off)
                if aurasList and entry.hidden then
                    return
                end
                local whens = chain(coll and coll.when and { coll.when }, entry.when)
                local state = stateOf(whens, ctx)
                if state == "unmet" then
                    return
                end
                local e = withMetMembers(entry, ctx)
                local ids = e.ids
                if (ids and #ids > 0) or e.enchant then
                    into[#into + 1] = e
                    if coll then
                        collOf[e] = coll
                    end
                    if state == "live" then
                        whensOf[e] = whens
                    end
                end
            end
            for _, e in ipairs(list) do
                if not e.collection then
                    add(e)
                elseif aurasList and not e.hidden and staticState(e.when, ctx) ~= "unmet" then
                    for _, sub in ipairs(e.entries or {}) do
                        if not sub.collection then
                            add(sub, e)
                        end
                    end
                end
            end
        end
        local aura = draw.size(AURA)
        local essential = opts.essentialSize or draw.size("cdm-essential")
        local utility = opts.utilityInline and essential or draw.size("icon-lg")

        for _, key in ipairs({ "essential", "utility" }) do
            local row = key == "essential" and self.built.essential or self.built.utility
            for _, listed in ipairs(lists[key] or {}) do
                -- a group: the cell of the last member you know
                local entry = listed.group and cooldownMember(listed) or (not listed.group and listed or nil)
                local id = entry and not entry.hidden and knownRank(entry)
                if entry and id then
                    local cell = self:Cell(entry, id, key == "essential" and essential or utility)
                    -- its conditions, and the shown member's if live
                    local whens = whensOf[listed]
                    local memberWhen = entry.memberWhen
                    if memberWhen and staticState(memberWhen, ctx) == "live" then
                        whens = chain(whens, memberWhen)
                    end
                    self:Watch(cell, whens)
                    -- its effect hides with it
                    local container = cell.container
                    if whens and container then
                        self.liveGroups[#self.liveGroups + 1] = {
                            ac = container,
                            key = "fx",
                            max = 1,
                            applied = 1,
                            whens = whens,
                        }
                    end
                    row[#row + 1] = cell
                    self.cells[#self.cells + 1] = cell
                end
            end
        end

        local proc: AuraLook? = opts.procHighlight ~= false and { border = "arcane", glow = "glow-arcane" } or nil
        -- an entry's engine groups in a packed container, one per part; with a
        -- live condition (the entry's, or a member's) each carries its `whens`
        local function auraGroups(
            out: AuraGroup[],
            whensByKey: { [string]: TrackerWhen[] },
            key: string,
            entry: TrackerEntry,
            parts: AuraPart[],
            base: AuraLook?
        )
            local look = auraLook(entry, base)
            for i, p in ipairs(parts) do
                local whens = whensOf[entry]
                if p.when then
                    whens = chain(whens, p.when)
                end
                local groupKey = i == 1 and key or (key .. "s" .. i)
                out[#out + 1] = {
                    key = groupKey,
                    filter = p.filter,
                    max = entry.group and (entry.max or 1) or 1,
                    include = p.ids,
                    border = look.border,
                    glow = look.glow,
                    digits = look.digits,
                    stacks = look.stacks,
                    expiring = look.expiring,
                    size = auraSize(entry),
                }
                if whens then
                    whensByKey[groupKey] = whens
                end
            end
        end

        -- Buffs: grey keeps a fixed slot per entry (never empty: the placeholder
        -- shows); hide packs them into one container the engine closes up. The
        -- left side grows away from the divider, procs after the buffs.
        -- Each entry's "when missing" (its own, else the list's): grey keeps a
        -- fixed slot, hide joins the packed container beyond the fixed ones.
        local leftGroups: AuraGroup[], leftWhens: { [string]: TrackerWhen[] } = {}, {}
        -- A buff you don't know gets no grey slot or reminder (a level 12 priest
        -- isn't reminded of Shadow Protection); it packs with the hidden ones.
        for i, entry in ipairs(lists.buffs or {}) do
            local mode = entry.missing or "grey"
            if entry.enchant then
                local slot = self:Enchant(entry, auraSize(entry))
                slot.coll = collOf[entry]
                self:Watch(slot, whensOf[entry])
                table.insert(self.built.buffs, slot)
            else
                local parts = auraParts("HELPFUL", entry, "any", ctx)
                if mode == "hide" or not knowsEntry(entry) then
                    auraGroups(leftGroups, leftWhens, "b" .. i, entry, parts)
                elseif mode == "remind" then
                    local r = self:Reminder(entry, "player", parts, auraSize(entry))
                    r.coll = collOf[entry]
                    self:Watch(r, whensOf[entry])
                    table.insert(self.built.remindBuffs, r)
                else
                    local slot = self:Slot(entry, "player", parts, auraSize(entry), auraLook(entry))
                    slot.coll = collOf[entry]
                    self:Watch(slot, whensOf[entry])
                    table.insert(self.built.buffs, slot)
                end
            end
        end
        for i, entry in ipairs(lists.procs or {}) do
            auraGroups(leftGroups, leftWhens, "p" .. i, entry, auraParts("HELPFUL", entry, "mine", ctx), proc)
        end
        if #leftGroups > 0 then
            self.leftFlow = self:Aura("player", {
                size = aura,
                anchor = "BOTTOMRIGHT",
                growth = { "LEFT", "UP" },
                groups = leftGroups,
            })
            self:WatchGroups(self.leftFlow, leftGroups, leftWhens)
        end

        -- Your debuffs on the target: hide packs them, growing right of the
        -- divider; grey and "with a target" keep fixed slots.
        -- A debuff from a spell you know no rank of gets no grey slot (it would
        -- remind you of something you can't cast); it packs with the hidden ones.
        local groups: AuraGroup[], rightWhens: { [string]: TrackerWhen[] } = {}, {}
        for i, entry in ipairs(lists.debuffs or {}) do
            local mode = entry.missing or "target"
            local parts = auraParts("HARMFUL", entry, "mine", ctx)
            -- a single debuff you know no rank of gets no grey slot; groups always
            -- do (their members are often auras you don't cast directly, such as
            -- the judgements that "Judgement" puts on the target)
            if mode == "hide" or (not entry.group and not knownRank(entry)) then
                auraGroups(groups, rightWhens, "d" .. i, entry, parts)
            elseif mode == "remind" then
                local r = self:Reminder(entry, "target", parts, auraSize(entry))
                r.coll = collOf[entry]
                self:Watch(r, whensOf[entry])
                table.insert(self.built.remindDebuffs, r)
            else
                local slot = self:Slot(entry, "target", parts, auraSize(entry), auraLook(entry))
                -- grey (and a warning's pulse) only while you have a hostile target:
                -- a debuff can't be missing from nothing
                slot.withTarget = mode == "target" or mode == "warn"
                slot.coll = collOf[entry]
                self:Watch(slot, whensOf[entry])
                table.insert(self.built.debuffs, slot)
            end
        end
        if #groups > 0 then
            self.rightFlow = self:Aura("target", {
                size = aura,
                anchor = "BOTTOMLEFT",
                growth = { "RIGHT", "UP" },
                groups = groups,
            })
            self:WatchGroups(self.rightFlow, groups, rightWhens)
        end
        -- the timers row is as tall as its largest icon
        local rowH = aura
        for _, key in ipairs({ "buffs", "debuffs", "procs" }) do
            for _, entry in ipairs(lists[key] or {}) do
                rowH = math.max(rowH, auraSize(entry))
            end
        end
        self.rowH = rowH
        self.hasLeft = #(lists.buffs or {}) + #(lists.procs or {}) > 0
        self.hasRight = #(lists.debuffs or {}) > 0

        -- the aura sounds of every aura entry
        clearAuraSounds()
        for _, entry in ipairs(lists.buffs or {}) do
            addAuraSounds(entry, "player")
        end
        for _, entry in ipairs(lists.procs or {}) do
            addAuraSounds(entry, "player")
        end
        for _, entry in ipairs(lists.debuffs or {}) do
            addAuraSounds(entry, "target")
        end

        self.knownSig = self:KnownSignature()
        self.condSig = self:ConditionSignature()
        self:UpdateLive(true)
        self:UpdateReminders(true)
        self:UpdateEnchants(true)
        self:Layout()
        self:UpdateMissing()
        self:UpdateCooldowns()
    end

    -- Centred rows, top to bottom: timers, Essential, Utility (or Utility after
    -- Essential with a gilt divider).
    function Layout()
        local opts = self.opts or {}
        local aura = draw.size(AURA)
        local gapRow = S["space-3"]

        -- a cell hidden on cooldown keeps its place while it has an effect to
        -- show there (the effect hangs on the tracker, over the cell's spot);
        -- one whose live conditions aren't met doesn't
        local function cells(list: TrackerCell[]): TrackerCell[]
            local out: TrackerCell[] = {}
            for _, f in ipairs(list) do
                if f.condOK ~= false and (f:IsShown() or (f.container ~= nil and f.onCooldown == true)) then
                    out[#out + 1] = f
                end
            end
            return out
        end
        local ess, util = cells(self.built.essential), cells(self.built.utility)
        local function rowWidth(row: TrackerCell[], spacing: number): number
            local w = 0
            for i, c in ipairs(row) do
                w = w + c:GetWidth() + (i > 1 and spacing or 0)
            end
            return w
        end
        local essW = rowWidth(ess, S["space-3"])
        local utilW = rowWidth(util, S["space-2"])
        local inline = opts.utilityInline == true and #util > 0
        local bottomW = inline and (essW + (essW > 0 and S["space-4"] * 2 + 1 or 0) + utilW) or essW

        -- the timers row centres on its divider: buffs and procs to its left,
        -- your debuffs to its right (packed lists grow away from it)
        -- outward from the divider: grey slots, then reminders (then the packed)
        local left: Placed[], right: Placed[] = {}, {}
        -- fixed slots whose live conditions are met (the rest close up; a
        -- weapon enchant's too while it has nothing to show)
        for _, c in ipairs(self.built.buffs) do
            if c.condOK ~= false and c.wantShown ~= false then
                left[#left + 1] = { frame = c, coll = c.coll }
            end
        end
        for _, c in ipairs(self.built.remindBuffs) do
            if c:IsShown() then
                left[#left + 1] = { frame = c, coll = c.coll }
            end
        end
        for _, c in ipairs(self.built.debuffs) do
            if c.condOK ~= false and c.wantShown ~= false then
                right[#right + 1] = { frame = c, coll = c.coll }
            end
        end
        for _, c in ipairs(self.built.remindDebuffs) do
            if c:IsShown() then
                right[#right + 1] = { frame = c, coll = c.coll }
            end
        end
        -- a collection's fixed slots sit apart from their neighbours: a hairline
        -- with space-2 plus space-1 either side of it
        local SIDE = S["space-2"] + S["space-1"]
        local function apart(a: Placed, b: Placed): boolean
            return (a.coll ~= nil or b.coll ~= nil) and a.coll ~= b.coll
        end
        local function gap(a: Placed, b: Placed): number
            return apart(a, b) and (SIDE * 2 + 1) or S["space-2"]
        end
        -- slots can be wider than one icon (a group showing several members)
        local function span(list: Placed[]): number
            local w = 0
            for i, c in ipairs(list) do
                w = w + c.frame:GetWidth() + (i > 1 and gap(list[i - 1], c) or 0)
            end
            return w
        end
        local leftW = span(left)
        local rightW = span(right)
        local half = math.max(leftW, rightW) + S["space-4"]
        local timersW = (self.hasLeft or self.hasRight) and (half * 2 + 1) or 0

        -- the footer (the resource bar) at the bottom, the rows space-4 over it
        local footer = self.footer
        local footW, footH = 0, 0
        if footer and footer:IsShown() then
            footW, footH = footer:GetWidth(), footer:GetHeight()
        end
        local width = math.max(timersW, bottomW, inline and 0 or utilW, aura, footW)
        local y = footH > 0 and (footH + S["space-4"]) or 0
        local function place(
            row: TrackerCell[],
            spacing: number,
            rowW: number,
            bottomY: number,
            startX: number?
        ): number
            local x = startX or (width - rowW) / 2
            for _, c in ipairs(row) do
                c:ClearAllPoints()
                c:SetPoint("BOTTOMLEFT", self, "BOTTOMLEFT", math.floor(x + 0.5), bottomY)
                x = x + c:GetWidth() + spacing
            end
            return x
        end

        -- Utility row (own row) at the bottom
        if not inline and #util > 0 then
            place(util, S["space-2"], utilW, y)
            y = y + draw.size("icon-lg") + gapRow
        end
        -- Essential (and inline Utility)
        self.divider:Hide()
        if #ess > 0 or inline then
            local x = place(ess, S["space-3"], bottomW, y)
            if inline then
                self.divider:ClearAllPoints()
                local h = (opts.essentialSize or draw.size("cdm-essential"))
                self.divider:SetSize(1, h)
                self.divider:SetPoint(
                    "BOTTOMLEFT",
                    self,
                    "BOTTOMLEFT",
                    math.floor(x - S["space-3"] + S["space-4"] + 0.5),
                    y
                )
                self.divider:Show()
                place(util, S["space-2"], utilW, y, x - S["space-3"] + S["space-4"] * 2 + 1)
            end
            y = y + (opts.essentialSize or draw.size("cdm-essential")) + gapRow
        end
        -- Timers
        self.auraDivider:Hide()
        for _, side in ipairs({ self.sepLeft, self.sepRight }) do
            for _, h in ipairs(side.lines) do
                h:Hide()
            end
            side.used = 0
        end
        -- a hairline on a side's layer, its left edge at x
        local function hairline(side: TrackerSeparators, x: number, atY: number)
            side.used = side.used + 1
            local h = side.lines[side.used]
            if not h then
                h = draw.fill(side, "gilt-hairline", "ARTWORK")
                side.lines[side.used] = h
            end
            h:ClearAllPoints()
            h:SetSize(1, aura - S["space-2"] * 2)
            h:SetPoint("BOTTOMLEFT", self, "BOTTOMLEFT", math.floor(x + 0.5), atY + S["space-2"])
            h:Show()
        end
        if self.hasLeft or self.hasRight then
            local mid = math.floor(width / 2)
            if self.hasLeft and self.hasRight then
                self.auraDivider:ClearAllPoints()
                self.auraDivider:SetSize(1, self.rowH or aura)
                self.auraDivider:SetPoint("BOTTOMLEFT", self, "BOTTOMLEFT", mid, y)
                self.auraDivider:Show()
            end
            -- left side: fixed buff slots end space-4 left of the divider, the
            -- packed buffs and procs continue left of them
            local leftEnd = mid - S["space-4"]
            -- outward from the divider: grey slots, then reminders, then packed
            local x = leftEnd
            for i, c in ipairs(left) do
                if i > 1 then
                    if apart(left[i - 1], c) then
                        hairline(self.sepLeft, x - SIDE - 1, y)
                    end
                    x = x - gap(left[i - 1], c)
                end
                x = x - c.frame:GetWidth()
                c.frame:ClearAllPoints()
                c.frame:SetPoint("BOTTOMLEFT", self, "BOTTOMLEFT", x, y)
            end
            local leftFlow = self.leftFlow
            if leftFlow then
                local edge = #left > 0 and (x - S["space-2"]) or leftEnd
                leftFlow.container:ClearAllPoints()
                leftFlow.container:SetPoint("BOTTOMRIGHT", self, "BOTTOMLEFT", edge, y)
            end
            -- right side: debuffs start space-4 right of the divider
            local rightStart = mid + 1 + S["space-4"]
            local rx = rightStart
            for i, c in ipairs(right) do
                if i > 1 then
                    if apart(right[i - 1], c) then
                        hairline(self.sepRight, rx + SIDE, y)
                    end
                    rx = rx + gap(right[i - 1], c)
                end
                c.frame:ClearAllPoints()
                c.frame:SetPoint("BOTTOMLEFT", self, "BOTTOMLEFT", math.floor(rx + 0.5), y)
                rx = rx + c.frame:GetWidth()
            end
            local rightFlow = self.rightFlow
            if rightFlow then
                local edge = #right > 0 and (rx + S["space-2"]) or rightStart
                rightFlow.container:ClearAllPoints()
                rightFlow.container:SetPoint("BOTTOMLEFT", self, "BOTTOMLEFT", edge, y)
            end
            y = y + (self.rowH or aura)
        end

        self:SetSize(math.max(width, 1), math.max(y, 1))
    end

    -- The grey placeholders: per list, hidden or shown (debuffs optionally only
    -- while you have a hostile target; that test may be secret, so the engine
    -- applies it as an alpha).
    function UpdateMissing()
        -- fixed slots are the grey ones: their placeholder always shows; a
        -- "with a target" list shows its debuff slots only on a hostile target
        for _, slot in ipairs(self.built.buffs) do
            if not slot.enchant then
                (slot :: TrackerSlot).placeholder:Show()
            end
        end
        -- the hairline goes with them when every debuff slot waits for a target
        local allTarget = #self.built.debuffs > 0
        for _, slot in ipairs(self.built.debuffs) do
            if not slot.withTarget then
                allTarget = false
            end
        end
        self.sepRight.withTarget = allTarget
        -- the debuff side's collection hairlines too: they'd stand alone between
        -- hidden slots
        local hostile = UnitExists("target") and UnitCanAttack("player", "target")
        local function fade(f: Frame, withTarget: boolean?)
            if withTarget then
                if f.SetAlphaFromBoolean and (secret.isSecret(hostile) or hostile ~= nil) then
                    f:SetAlphaFromBoolean(hostile, 1, 0)
                else
                    f:SetAlpha(flag(hostile) and 1 or 0)
                end
            else
                f:SetAlpha(1)
            end
        end
        fade(self.sepRight, self.sepRight.withTarget)
        for _, slot in ipairs(self.built.debuffs) do
            slot.placeholder:Show()
            fade(slot, slot.withTarget)
        end
    end

    -- Reminders show while their aura isn't up, out of combat; in combat SuuUI
    -- can't read auras, so they hide. A change of what shows relays the row.
    -- Debuff reminders need a hostile target.
    function UpdateReminders(noLayout: boolean?)
        local changed = false
        local fight = self.inFight or InCombatLockdown()
        local hostile = UnitExists("target") and flag(UnitCanAttack("player", "target"))
        local ctx: CondContext = { combat = fight and true or false }
        local function update(list: TrackerReminder[], needTarget: boolean)
            for _, r in ipairs(list) do
                local show = not fight and r.condOK ~= false and (not needTarget or hostile) and not auraUp(r, ctx)
                if show ~= r:IsShown() then
                    r:SetShown(show)
                    changed = true
                end
            end
        end
        update(self.built.remindBuffs, false)
        update(self.built.remindDebuffs, true)
        if changed and not noLayout then
            self:Layout()
        end
    end

    -- Weapon enchant slots: what is on each weapon now, or its "when missing"
    -- (warn only out of combat unless the entry warns in combat too). A slot
    -- that comes or goes (hide, no weapon) relays the row.
    function UpdateEnchants(noLayout: boolean?)
        local fight = self.inFight or InCombatLockdown()
        local changed = false
        for _, f in ipairs(self.built.buffs) do
            if f.enchant then
                local slot = f :: TrackerEnchant
                local e = slot.entry
                local mode = e.missing or "warn"
                if mode ~= "hide" and mode ~= "warn" then
                    mode = "grey"
                end
                if mode == "warn" and fight and not e.warnCombat then
                    mode = "grey"
                end
                slot:SetMissing(mode ~= "hide" and mode or nil)
                local has = slot:Refresh()
                local want = weaponEnchantable(e.enchant or "main") and (has or mode ~= "hide")
                if want ~= slot.wantShown then
                    slot.wantShown = want
                    changed = true
                end
                slot:SetShown(want and slot.condOK ~= false)
            end
        end
        if changed and not noLayout then
            self:Layout()
        end
    end

    function UpdateCooldowns(noLayout: boolean?): boolean
        local changed = false
        for _, cell in ipairs(self.cells) do
            cell:Update(self.opts or {})
            if cell.wantShown ~= cell:IsShown() then
                cell:SetShown(cell.wantShown == true)
                changed = true
            end
        end
        if changed and not noLayout then
            self:Layout()
        end
        return changed
    end

    -- Live conditions (stance or form, combat, the target), in combat too.
    -- SuuUI's own cells, slots and reminders show or hide and the rows close
    -- up. A packed entry (and a slot's live member, and an effect) is an engine
    -- group: its max goes to 0 and back. If the engine refuses that call (in
    -- combat), it's tried again when combat ends: `applied` is what took.
    function UpdateLive(noLayout: boolean?)
        if #self.liveFrames == 0 and #self.liveGroups == 0 then
            return
        end
        local ctx: CondContext = { combat = (self.inFight or InCombatLockdown()) and true or false }
        local changed = false
        for _, f in ipairs(self.liveFrames) do
            local ok = allMet(f.whens, ctx)
            if ok ~= f.condOK then
                f.condOK = ok
                changed = true
            end
        end
        for _, g in ipairs(self.liveGroups) do
            local n = allMet(g.whens, ctx) and g.max or 0
            if n ~= g.applied then
                local c = g.ac.container
                if pcall(c.SetAuraGroupMaxFrameCount, c, g.key, n) then
                    g.applied = n
                    g.ac:Refresh()
                end
            end
        end
        -- fixed slots show or hide here; cells and reminders by their updates
        for _, slot in ipairs(self.built.buffs) do
            if slot.condOK ~= nil then
                slot:SetShown(slot.condOK and slot.wantShown ~= false)
            end
        end
        for _, slot in ipairs(self.built.debuffs) do
            if slot.condOK ~= nil then
                slot:SetShown(slot.condOK and slot.wantShown ~= false)
            end
        end
        if changed and not noLayout then
            self:UpdateReminders(true)
            self:UpdateCooldowns(true)
            self:Layout()
        end
    end

    -- Which ranks of the listed cooldowns, buffs and debuffs you know, as one
    -- string (a group's per member: in a cooldown list the member shown can
    -- change; collections' entries too).
    function KnownSignature(): string
        local parts: string[] = {}
        local function walk(entry: TrackerEntry)
            if entry.collection then
                for _, e in ipairs(entry.entries or {}) do
                    walk(e)
                end
            elseif entry.group then
                for _, m in ipairs(entry.members or {}) do
                    parts[#parts + 1] = tostring(m.ids and knownRank(m) or 0)
                end
            elseif entry.ids then
                parts[#parts + 1] = tostring(knownRank(entry) or 0)
            end
        end
        local lists = self.lists or {}
        for _, key in ipairs({ "essential", "utility", "buffs", "debuffs" }) do
            for _, entry in ipairs(lists[key] or {}) do
                walk(entry)
            end
        end
        return table.concat(parts, ",")
    end

    -- What the static conditions in every list say now (met, unmet or live:
    -- staticState), as one string (collections, entries, groups' members, in
    -- list order). A change rebuilds.
    function ConditionSignature(): string
        local parts: string[], ctx: CondContext = {}, {}
        local function mark(when: TrackerWhen?)
            if when then
                parts[#parts + 1] = staticState(when, ctx):sub(1, 1)
            end
        end
        local function walk(entry: TrackerEntry)
            mark(entry.when)
            for _, m in ipairs(entry.members or {}) do
                mark(m.when)
            end
            if entry.collection then
                for _, e in ipairs(entry.entries or {}) do
                    walk(e)
                end
            end
        end
        local lists = self.lists or {}
        for _, key in ipairs({ "essential", "utility", "buffs", "debuffs", "procs" }) do
            for _, entry in ipairs(lists[key] or {}) do
                walk(entry)
            end
        end
        return table.concat(parts)
    end

    function SetLists(lists: TrackerLists?)
        self.lists = lists
        self.rebuild = true
    end

    -- 0.17: a frame under the rows, part of the block (the resource bar): it sits
    -- centred at the bottom, the rows space-4 over it, the block at least as
    -- wide. Lay out again when it resizes or hides (t:Layout()); nil takes it away.
    function SetFooter(frame: Frame?)
        local old = self.footer
        if old and old ~= frame then
            old:Hide()
        end
        self.footer = frame
        if frame then
            frame:SetParent(self)
            frame:ClearAllPoints()
            frame:SetPoint("BOTTOM", self, "BOTTOM", 0, 0)
        end
        self:Layout()
    end

    function SetOptions(opts: TrackerOptions?)
        self.opts = opts
        self.rebuild = true
    end

    -- Running: the driver and the game's events. Start rebuilds from the lists
    -- (if it has any); Stop takes the aura sounds back and hands back everything
    -- built, so a stopped tracker costs nothing. Out of combat.
    function Start()
        if self.running then
            return
        end
        self.running = true
        self.dirty = true
        if self.lists then
            self.rebuild = true
        end
        self.driver:Show()
        local t = self
        local function mark()
            t.dirty = true
        end
        -- (events this client lacks, Forever renamed or dropped some, are
        -- never registered: wowlua:events)
        local gameEvents: EventName[] = {
            "SPELL_UPDATE_COOLDOWN",
            "SPELL_UPDATE_USABLE",
            "SPELL_UPDATE_CHARGES",
            "ACTIONBAR_UPDATE_USABLE",
            "UPDATE_SHAPESHIFT_FORM",
            "PLAYER_ENTERING_WORLD",
        }
        for _, e in ipairs(gameEvents) do
            events.onGame(e, mark, t)
        end
        events.onUnit("UNIT_POWER_FREQUENT", "player", mark, t)
        events.onGame(
            "PLAYER_TARGET_CHANGED",
            function()
                t:UpdateLive()
                t:UpdateMissing()
                t:UpdateReminders()
                mark()
            end,
            t
        )
        events.onUnit(
            "UNIT_AURA",
            { "player", "target" },
            function()
                if not (t.inFight or InCombatLockdown()) then
                    t:UpdateReminders()
                end
            end,
            t
        )
        events.onGame(
            "PLAYER_REGEN_DISABLED",
            function()
                t.inFight = true
                t:UpdateLive()
                t:UpdateReminders()
                t:UpdateEnchants()
            end,
            t
        )
        events.on(
            "SUUUI_WEAPON_ENCHANTS_CHANGED",
            function()
                t:UpdateEnchants()
            end,
            t
        )
        events.onGame(
            "PLAYER_REGEN_ENABLED",
            function()
                t.inFight = false
                t:UpdateEnchants()
                -- live conditions, and engine maxes refused in combat
                t:UpdateLive()
                after(0, function()
                    t:UpdateReminders()
                end)
            end,
            t
        )
        -- live conditions: stance or form (combat and target above)
        local formEvents: EventName[] = { "UPDATE_SHAPESHIFT_FORM", "UPDATE_SHAPESHIFT_FORMS" }
        for _, e in ipairs(formEvents) do
            events.onGame(
                e,
                function()
                    t:UpdateLive()
                end,
                t
            )
        end
        -- Learning a rank rebuilds; the spellbook "changing" with a shapeshift
        -- (same ranks known) doesn't.
        local spellEvents: EventName[] = { "SPELLS_CHANGED", "LEARNED_SPELL_IN_SKILL_LINE" }
        for _, e in ipairs(spellEvents) do
            events.onGame(
                e,
                function()
                    local sig = t:KnownSignature()
                    if sig ~= t.knownSig then
                        t.rebuild = true
                    end
                end,
                t
            )
        end
        -- Static conditions: a group, role, zone or talent change that changes
        -- what they say rebuilds (after combat, like any rebuild). These come in
        -- bursts: one look half a second after the first.
        local function static()
            if t.condPending then
                return
            end
            t.condPending = true
            after(0.5, function()
                t.condPending = false
                if t.running and t.condSig and t:ConditionSignature() ~= t.condSig then
                    t.rebuild = true
                end
            end)
        end
        local staticEvents: EventName[] = { "GROUP_ROSTER_UPDATE", "PLAYER_ENTERING_WORLD", "ZONE_CHANGED_NEW_AREA" }
        for _, e in ipairs(staticEvents) do
            events.onGame(e, static, t)
        end
        events.on("SUUUI_ROLE_CHANGED", static, t)
        -- talents learned or unlearned: read them again, then the same look
        local talentEvents: EventName[] = {
            "TRAIT_CONFIG_UPDATED",
            "TRAIT_NODE_CHANGED",
            "PLAYER_TALENT_UPDATE",
            "CHARACTER_POINTS_CHANGED",
            "SPELLS_CHANGED",
        }
        for _, e in ipairs(talentEvents) do
            events.onGame(
                e,
                function()
                    forgetTalents()
                    static()
                end,
                t
            )
        end
    end

    function Stop()
        if not self.running then
            return
        end
        self.running = false
        self.driver:Hide()
        events.offAll(self)
        clearAuraSounds()
        self:Clear()
        self.knownSig, self.condSig = nil, nil
    end
end
mixins.CooldownTracker = CooldownTracker

export function cooldownTracker(parent: Frame, opts: CooldownTrackerOptions?): CooldownTracker
    return CooldownTracker.new(parent, opts)
end
