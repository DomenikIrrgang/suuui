-- UI/Timeline.wowlua
-- The encounter timeline (design board "Encounter timeline").
--
--   local t = encounterTimeline(parent, { variant = "track" | "list", window = 30, soonAt = 5 })
--   t:SetEvents(list)   -- { { id, label, endsAt (GetTime() it happens), paused (seconds
--                       --   left, frozen), icon, badge = { tone, text } }, ... }
--   t:SetVariant(v)
--
-- track: no panel, a thin gilt line `timeline-w` wide over the world, now at
-- its left end (an ink mark), ticks every 5 seconds, "30s" over the right
-- end. Each ability rides toward now: its icon (icon-md, a dark ring; amber
-- under `soonAt` seconds) on the line, its time and name centred under it,
-- a badge under those. What comes after the window is named right of the line
-- ("then Inferno in 52s · +1 more").
-- list: the older glass panel, soonest first, each row with a draining line.
-- The positions move every frame while something is on it.

import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import icon, Icon from "/UI/Icon"
import * as controls from "/UI/Controls"

local S = T.space

--- One ability on the timeline.
export type TimelineEvent = { id: any, label?: string, endsAt?: number, paused?: number, icon?: any, badge?: { tone: string, text: string } }
type Event = TimelineEvent
-- an event and the seconds left until it
type Timed = { e: Event, r: number }

--- One ability on the track: its icon, time, name and badge.
export interface TrackEvent extends Frame
    icon: Icon
    ring: draw.Border
    time: Text
    name: Text
    badge: controls.StateBadge
    align: string?
    id: any
end

--- One row of the list.
export interface ListRow extends Frame
    icon: Icon
    name: Text
    time: Text
    badge: controls.StateBadge
    track: Texture
    drain: Texture
end

--- The list's glass panel.
export interface TimelineList extends Frame
    title: Text
    meta: Text
    rule: Texture
end

--- What encounterTimeline makes.
export interface EncounterTimeline extends Frame
    window: number
    soonAt: number
    variant: string
    events: TimelineEvent[]
    -- the track
    track: Frame?
    ticks: Texture[]
    endLabel: Text
    later: Text
    evs: TrackEvent[]
    -- the list
    list: TimelineList?
    rows: ListRow[]
    listTop: number
    function Layout()
    function SetEvents(list: TimelineEvent[]?)
    function SetMeta(meta: string?)
    function SetVariant(variant: string?)
end

local EV_W = 92
local TRACK_H = 70
local LINE_Y = 11

local function fmtTime(left: number): string
    local s = math.max(0, left)
    if s >= 60 then return ("%d:%02d"):format(math.floor(s / 60), math.floor(s % 60)) end
    if s < 10 then return ("%.1fs"):format(s) end
    return ("%ds"):format(math.floor(s))
end

local function remainingOf(e: Event, now: number): number
    if e.paused then return e.paused end
    return math.max(0, (e.endsAt or now) - now)
end

--------------------------------------------------------------------------------
-- Track
--------------------------------------------------------------------------------

local function trackEvent(t: EncounterTimeline): TrackEvent
    local f: TrackEvent = CreateFrame("Frame", nil, t.track) :: any
    f:SetSize(EV_W, TRACK_H)
    f.icon = icon(f, "icon-md")
    f.ring = draw.border(f.icon, { 0, 0, 0, 0.7 }, { width = 2, inset = -2 })
    f.time = text(f, "numeric", "ink")
    f.time:SetShadowed(true)
    f.name = text(f, "caption", "ink-muted")
    f.name:SetShadowed(true)
    f.name:SetWordWrap(false)
    f.name:SetWidth(EV_W)
    f.badge = controls.stateBadge(f, "warning", "Tank")
    return f
end

-- start / mid / end: centred under its icon, or held inside the line's ends
type Align = { point: FramePoint, below: FramePoint, justify: "LEFT" | "RIGHT" | "CENTER" }
local ALIGN: { [string]: Align } = {
    start = { point = "TOPLEFT", below = "BOTTOMLEFT", justify = "LEFT" },
    ["end"] = { point = "TOPRIGHT", below = "BOTTOMRIGHT", justify = "RIGHT" },
    mid = { point = "TOP", below = "BOTTOM", justify = "CENTER" },
}
local function alignEvent(f: TrackEvent, align: string)
    f.icon:ClearAllPoints()
    f.time:ClearAllPoints()
    f.name:ClearAllPoints()
    f.badge:ClearAllPoints()
    local a = ALIGN[align] or ALIGN.mid :: Align
    local point, below = a.point, a.below
    f.icon:SetPoint(point, 0, -(LINE_Y + 1 - draw.size("icon-md") / 2))
    f.time:SetPoint(point, f.icon, below, 0, -2)
    f.time:SetJustifyH(a.justify)
    f.name:SetPoint(point, f.time, below, 0, -1)
    f.name:SetJustifyH(a.justify)
    f.badge:SetPoint(point, f.name, below, 0, -2)
end

local function layoutTrack(t: EncounterTimeline, now: number)
    local win, soonAt = t.window, t.soonAt
    local w = (t.track :: Frame):GetWidth()
    local inWin: Timed[], later: Timed[] = {}, {}
    for _, e in ipairs(t.events) do
        local r = remainingOf(e, now)
        if r <= win then inWin[#inWin + 1] = { e = e, r = r } else later[#later + 1] = { e = e, r = r } end
    end
    table.sort(inWin, function(a: Timed, b: Timed): boolean return a.r < b.r end)
    table.sort(later, function(a: Timed, b: Timed): boolean return a.r < b.r end)
    for i, x in ipairs(inWin) do
        local f = t.evs[i] or trackEvent(t)
        t.evs[i] = f
        local frac = x.r / win
        -- always centred under its icon (near now too: held inside the line,
        -- the label looked pushed aside)
        local align = "mid"
        if f.align ~= align then alignEvent(f, align); f.align = align end
        local px = math.floor(frac * w + 0.5)
        f:ClearAllPoints()
        f:SetPoint("TOP", t.track, "TOPLEFT", px, 0)
        if f.id ~= x.e.id then
            f.id = x.e.id
            f.icon:SetArt(x.e.icon or 134400)
            f.name:SetValue(x.e.label or "")
            f.badge:SetShown(x.e.badge ~= nil)
            if x.e.badge then f.badge:SetState(x.e.badge.tone, x.e.badge.text) end
        end
        local soon = x.r <= soonAt
        f.time:SetValue(fmtTime(x.r))
        f.time:SetColor(soon and "amber" or "ink")
        f.name:SetColor(soon and "ink" or "ink-muted")
        if soon then f.ring:SetColor("amber") else f.ring:SetColor(0, 0, 0, 0.7) end
        f:Show()
    end
    for i = #inWin + 1, #t.evs do t.evs[i]:Hide(); t.evs[i].id = nil end
    if #later > 0 then
        local first = later[1]
        local more = #later > 1 and (" · +%d more"):format(#later - 1) or ""
        t.later:SetValue(("then %s in %s%s"):format(first.e.label or "?", fmtTime(first.r), more))
        t.later:SetVisible(true)
    else
        t.later:SetVisible(false)
    end
end

local function buildTrack(t: EncounterTimeline)
    local track = CreateFrame("Frame", nil, t)
    track:SetPoint("TOPLEFT")
    track:SetSize(draw.size("timeline-w"), TRACK_H)
    t.track = track
    local line = track:CreateTexture(nil, "ARTWORK")
    draw.paintFill(line, "gilt-line")
    line:SetPoint("TOPLEFT", 0, -LINE_Y)
    line:SetPoint("TOPRIGHT", 0, -LINE_Y)
    line:SetHeight(2)
    local now = track:CreateTexture(nil, "OVERLAY")
    draw.paintFill(now, "ink")
    now:SetSize(2, 18)
    now:SetPoint("TOPLEFT", -1, -3)
    t.ticks = {}
    for s = 5, t.window - 1, 5 do
        local tick = track:CreateTexture(nil, "ARTWORK")
        draw.paintFill(tick, "gilt-line")
        tick:SetSize(1, 8)
        tick:SetPoint("TOPLEFT", math.floor(s / t.window * track:GetWidth() + 0.5), -8)
        t.ticks[#t.ticks + 1] = tick
    end
    t.endLabel = text(track, "micro", "ink-faint")
    t.endLabel:SetShadowed(true)
    t.endLabel:SetPoint("BOTTOM", track, "TOPRIGHT", 0, -10)
    t.endLabel:SetValue(("%ds"):format(t.window))
    t.later = text(track, "caption", "ink-muted")
    t.later:SetShadowed(true)
    t.later:SetPoint("TOPLEFT", track, "TOPRIGHT", S["space-4"], -4)
    t.later:SetVisible(false)
    t.evs = {}
end

--------------------------------------------------------------------------------
-- List
--------------------------------------------------------------------------------

local LIST_W, ROW_H = 280, 30

local function listRow(t: EncounterTimeline, i: number): ListRow
    local r: ListRow = CreateFrame("Frame", nil, t.list) :: any
    r:SetSize(LIST_W - S["space-5"] * 2, ROW_H)
    r.icon = icon(r, "icon-md")
    r.icon:SetPoint("LEFT", 0, 2)
    r.name = text(r, "label", "ink")
    r.name:SetPoint("LEFT", r.icon, "RIGHT", S["space-4"], 0)
    r.name:SetWordWrap(false)
    r.time = text(r, "numeric", "ink")
    r.time:SetPoint("RIGHT", 0, 2)
    r.badge = controls.stateBadge(r, "warning", "Tank")
    r.badge:SetPoint("RIGHT", r.time, "LEFT", -S["space-4"], 0)
    r.track = r:CreateTexture(nil, "BACKGROUND")
    draw.paintFill(r.track, "track")
    r.track:SetPoint("BOTTOMLEFT")
    r.track:SetPoint("BOTTOMRIGHT")
    r.track:SetHeight(2)
    r.drain = r:CreateTexture(nil, "ARTWORK")
    r.drain:SetPoint("BOTTOMLEFT")
    r.drain:SetHeight(2)
    t.rows[i] = r
    return r
end

local function layoutList(t: EncounterTimeline, now: number)
    local list: Timed[] = {}
    for _, e in ipairs(t.events) do list[#list + 1] = { e = e, r = remainingOf(e, now) } end
    table.sort(list, function(a: Timed, b: Timed): boolean return a.r < b.r end)
    local y = t.listTop
    local innerW = LIST_W - S["space-5"] * 2
    for i, x in ipairs(list) do
        local r = t.rows[i] or listRow(t, i)
        r:ClearAllPoints()
        r:SetPoint("TOPLEFT", S["space-5"], -y)
        r.icon:SetArt(x.e.icon or 134400)
        r.name:SetValue(x.e.label or "")
        r.badge:SetShown(x.e.badge ~= nil)
        if x.e.badge then r.badge:SetState(x.e.badge.tone, x.e.badge.text) end
        r.name:SetPoint("RIGHT", x.e.badge and r.badge or r.time, "LEFT", -S["space-4"], 0)
        local soon = x.r <= t.soonAt
        r.time:SetValue(fmtTime(x.r))
        r.time:SetColor(soon and "amber" or "ink")
        draw.paintFill(r.drain, soon and "amber" or "ink-muted")
        r.drain:SetWidth(math.max(1, math.min(1, x.r / t.window) * innerW))
        r:Show()
        y = y + ROW_H + S["space-3"]
    end
    for i = #list + 1, #t.rows do t.rows[i]:Hide() end
    local panel = t.list :: TimelineList
    panel:SetHeight(math.max(t.listTop + S["space-5"], y - S["space-3"] + S["space-5"]))
    t:SetHeight(panel:GetHeight())
end

-- the rule under the title, and the rows under it, by the header's line
-- height (again when a theme changes it)
local lists: { [EncounterTimeline]: boolean } = setmetatable({}, { __mode = "k" })
local function placeRule(t: EncounterTimeline)
    local y = S["space-4"] * 2 + T.type.header.lineHeight
    local rule = (t.list :: TimelineList).rule
    rule:ClearAllPoints()
    rule:SetPoint("TOPLEFT", 1, -y)
    rule:SetPoint("TOPRIGHT", -1, -y)
    t.listTop = y + 1 + S["space-4"]
end

events.on("SUUUI_THEME_CHANGED", function()
    for t in pairs(lists) do
        placeRule(t)
        if t.variant == "list" then t:Layout() end
    end
end, "Timeline")

local function buildList(t: EncounterTimeline)
    local p: TimelineList = CreateFrame("Frame", nil, t) :: any
    p:SetPoint("TOPLEFT")
    p:SetWidth(LIST_W)
    draw.fill(p, "surface-glass", "BACKGROUND"):SetAllPoints()
    draw.border(p, "gilt-line")
    draw.shadow(p, "shadow-panel")
    p.title = text(p, "header", "gilt-text")
    p.title:SetPoint("TOPLEFT", S["space-5"], -S["space-4"])
    p.title:SetValue("Timeline")
    p.meta = text(p, "caption", "ink-muted")
    p.meta:SetPoint("LEFT", p.title, "RIGHT", S["space-3"], 0)
    p.meta:SetPoint("RIGHT", -S["space-5"], 0)
    p.meta:SetWordWrap(false)
    p.rule = p:CreateTexture(nil, "BORDER")
    draw.paintFill(p.rule, "gilt-faint")
    p.rule:SetHeight(1)
    t.list = p
    t.rows = {}
    placeRule(t)
    lists[t] = true
end

--------------------------------------------------------------------------------
-- The timeline
--------------------------------------------------------------------------------

local Timeline: EncounterTimeline = {} :: any

function Timeline:Layout()
    local now = GetTime()
    if self.variant == "list" then layoutList(self, now) else layoutTrack(self, now) end
end

function Timeline:SetEvents(list: TimelineEvent[]?)
    self.events = list or {}
    self:Layout()
    self:SetScript("OnUpdate", #self.events > 0 and function() self:Layout() end or nil)
end

function Timeline:SetMeta(meta: string?)
    if self.list then self.list.meta:SetValue(meta or "") end
end

function Timeline:SetVariant(variant: string?)
    self.variant = variant == "list" and "list" or "track"
    if self.variant == "list" and not self.list then buildList(self) end
    if self.variant == "track" and not self.track then buildTrack(self) end
    if self.track then self.track:SetShown(self.variant == "track") end
    if self.list then self.list:SetShown(self.variant == "list") end
    if self.variant == "track" then
        self:SetSize(draw.size("timeline-w"), TRACK_H)
    else
        self:SetWidth(LIST_W)
    end
    self:Layout()
end

export function encounterTimeline(parent: Frame, options: { variant?: string, window?: number, soonAt?: number }?): EncounterTimeline
    local opts = options or {}
    local t: EncounterTimeline = CreateFrame("Frame", nil, parent) :: any
    Mixin(t, Timeline)
    t.window, t.soonAt = opts.window or 30, opts.soonAt or 5
    t.events = {}
    t:SetVariant(opts.variant or "track")
    return t
end
