-- UI/Timeline.wowlua
-- The encounter timeline (design board "Encounter timeline").
--
--   local t = encounterTimeline(parent, { variant = "track" | "list", window = 30, soonAt = 5 })
--   t:SetEvents(list)   -- { { id, label, endsAt (GetTime() it happens), paused (seconds
--                       --   left, frozen), icon, badge = { tone, text } }, ... }
--   t:SetVariant(v)
--
-- track: no panel, a thin gilt line `timeline-w` wide over the world, now at
-- its left end (an ink mark), ticks every 5 seconds, "30s" over the right
-- end. Each ability rides toward now: its icon (icon-md, a dark ring; amber
-- under `soonAt` seconds) on the line, its time and name centred under it,
-- a badge under those. What comes after the window is named right of the line
-- ("then Inferno in 52s · +1 more").
-- list: the older glass panel, soonest first, each row with a draining line.
-- The positions move every frame while something is on it.
--
-- What changes per event and what per frame (X-2.1): `Layout` (SetEvents,
-- a variant switch, a theme change, a resize) sorts the events once: the
-- running ones by when they end, the paused ones by their frozen time, and
-- (list) places the rows and the panel. Per frame only what moves: the two
-- sorted lists merged by the time left into arrays kept on the timeline (so
-- one passing a paused one changes places on the frame it does), and per
-- shown event its pixel, its time text and its colours, each set only when
-- it changed (the text when its second, or its tenth under ten seconds,
-- changes). No tables, closures or strings per frame. The OnUpdate runs
-- while something still runs toward now; paused or ended ones don't move.

import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import text, Text from "/UI/Text"
import icon, Icon from "/UI/Icon"
import * as controls from "/UI/Controls"

local S = T.space

--- One ability on the timeline.
export type TimelineEvent = {
    id: number | string,
    label?: string,
    endsAt?: number,
    paused?: number,
    icon?: number | string,
    badge?: { tone: string, text: string },
}
type Event = TimelineEvent

--- What encounterTimeline makes.

local EV_W = 92
local TRACK_H = 70
local LINE_Y = 11

local function fmtTime(left: number): string
    local s = math.max(0, left)
    if s >= 60 then
        return ("%d:%02d"):format(math.floor(s / 60), math.floor(s % 60))
    end
    if s < 10 then
        return ("%.1fs"):format(s)
    end
    return ("%ds"):format(math.floor(s))
end

-- What fmtTime shows, as a number that changes when the text does: whole
-- seconds from 10 s up (m:ss is made of them too), tenths below (negative,
-- so the two never meet). Compared per frame; the text is made only when it
-- changes.
local function timeKey(left: number): number
    local s = math.max(0, left)
    if s >= 10 then
        return math.floor(s)
    end
    return -1 - math.floor(s * 10 + 0.5)
end

local function remainingOf(e: Event, now: number): number
    if e.paused then
        return e.paused
    end
    return math.max(0, (e.endsAt or now) - now)
end

--------------------------------------------------------------------------------
-- The order: per event, the running ones by their end and the paused ones (or
-- any without an end: 0 left) by their time left, ties in the order given;
-- per frame, the two merged by the time left.
--------------------------------------------------------------------------------

-- each event's place in the list given (for ties), while sorting
local given: { [Event]: number } = setmetatable({}, { __mode = "k" })

local function byEnd(a: Event, b: Event): boolean
    local x, y = a.endsAt or 0, b.endsAt or 0
    if x ~= y then
        return x < y
    end
    return (given[a] or 0) < (given[b] or 0)
end

local function byHeld(a: Event, b: Event): boolean
    local x, y = a.paused or 0, b.paused or 0
    if x ~= y then
        return x < y
    end
    return (given[a] or 0) < (given[b] or 0)
end

--------------------------------------------------------------------------------
-- Track
--------------------------------------------------------------------------------

--- One ability on the track: its icon, time, name and badge.
export class TrackEvent extends Frame
    icon: Icon
    ring: draw.Border
    time: Text
    name: Text
    badge: controls.StateBadge
    align: string?
    id: (number | string)? = nil
    -- what was last set (per frame only what changed): shown, the pixel
    -- along the line, the time text's key (timeKey), amber or not
    on: boolean = false
    px: number? = nil
    timeKey: number? = nil
    soon: boolean? = nil

    constructor(t: EncounterTimeline)
        super(nil, t.track)
        self:SetSize(EV_W, TRACK_H)
        self.icon = icon(self, "icon-md")
        self.ring = draw.border(self.icon, { 0, 0, 0, 0.7 }, { width = 2, inset = -2 })
        self.time = text(self, "numeric", "ink")
        self.time:SetShadowed(true)
        self.name = text(self, "caption", "ink-muted")
        self.name:SetShadowed(true)
        self.name:SetWordWrap(false)
        self.name:SetWidth(EV_W)
        self.badge = controls.stateBadge(self, "warning", "Tank")
    end
end

local function trackEvent(t: EncounterTimeline): TrackEvent
    return TrackEvent.new(t)
end

-- start / mid / end: centred under its icon, or held inside the line's ends
type Align = { point: FramePoint, below: FramePoint, justify: "LEFT" | "RIGHT" | "CENTER" }
local ALIGN: { [string]: Align } = {
    start = { point = "TOPLEFT", below = "BOTTOMLEFT", justify = "LEFT" },
    ["end"] = { point = "TOPRIGHT", below = "BOTTOMRIGHT", justify = "RIGHT" },
    mid = { point = "TOP", below = "BOTTOM", justify = "CENTER" },
}
local function alignEvent(f: TrackEvent, align: string)
    f.icon:ClearAllPoints()
    f.time:ClearAllPoints()
    f.name:ClearAllPoints()
    f.badge:ClearAllPoints()
    local a = ALIGN[align] or ALIGN.mid :: Align
    local point, below = a.point, a.below
    f.icon:SetPoint(point, 0, -(LINE_Y + 1 - draw.size("icon-md") / 2))
    f.time:SetPoint(point, f.icon, below, 0, -2)
    f.time:SetJustifyH(a.justify)
    f.name:SetPoint(point, f.time, below, 0, -1)
    f.name:SetJustifyH(a.justify)
    f.badge:SetPoint(point, f.name, below, 0, -2)
end

-- the frame for the i-th soonest, made once and kept
local function poolEvent(t: EncounterTimeline, i: number): TrackEvent
    local f = trackEvent(t)
    -- always centred under its icon (near now too: held inside the line,
    -- the label looked pushed aside)
    alignEvent(f, "mid")
    f.align = "mid"
    t.evs[i] = f
    return f
end

-- Per frame: each event in the window at its share of the line, the rest
-- named right of it. Only what changed is set.
local function tickTrack(t: EncounterTimeline)
    local order, left, n = t.order, t.left, t.count
    local win, soonAt, w = t.window, t.soonAt, t.trackW
    local evs = t.evs
    local k = 0
    for i = 1, n do
        local r = left[i]
        if r > win then
            break
        end
        k = i
        local e = order[i]
        local f = evs[i] or poolEvent(t, i)
        if not f.on then
            f.on = true
            f:Show()
        end
        local px = math.floor(r / win * w + 0.5)
        if f.px ~= px then
            f.px = px
            f:ClearAllPoints()
            f:SetPoint("TOP", t.track, "TOPLEFT", px, 0)
        end
        if f.id ~= e.id then
            f.id = e.id
            f.icon:SetArt(e.icon or 134400)
            f.name:SetValue(e.label or "")
            f.badge:SetShown(e.badge ~= nil)
            local badge = e.badge
            if badge then
                f.badge:SetState(badge.tone, badge.text)
            end
        end
        local key = timeKey(r)
        if f.timeKey ~= key then
            f.timeKey = key
            f.time:SetValue(fmtTime(r))
        end
        local soon = r <= soonAt
        if f.soon ~= soon then
            f.soon = soon
            f.time:SetColor(soon and "amber" or "ink")
            f.name:SetColor(soon and "ink" or "ink-muted")
            if soon then
                f.ring:SetColor("amber")
            else
                f.ring:SetColor(0, 0, 0, 0.7)
            end
        end
    end
    for i = k + 1, t.shownEvs do
        local f = evs[i]
        f:Hide()
        f.on = false
        f.id = nil
    end
    t.shownEvs = k
    local laterText = t.later
    if not laterText then
        return
    end
    local more = n - k
    if more > 0 then
        local first, r = order[k + 1], left[k + 1]
        local key = timeKey(r)
        if first ~= t.laterEv or key ~= t.laterKey or more ~= t.laterCount then
            if t.laterCount <= 0 then
                laterText:SetVisible(true)
            end
            t.laterEv, t.laterKey, t.laterCount = first, key, more
            local extra = more > 1 and (" · +%d more"):format(more - 1) or ""
            laterText:SetValue(("then %s in %s%s"):format(first.label or "?", fmtTime(r), extra))
        end
    elseif t.laterCount ~= 0 then
        laterText:SetVisible(false)
        t.laterEv, t.laterKey, t.laterCount = nil, nil, 0
    end
end

-- Per event: the frames' last values forgotten, so the next tick sets them.
local function layoutTrack(t: EncounterTimeline)
    for _, f in ipairs(t.evs) do
        f.px, f.timeKey, f.soon = nil, nil, nil
    end
    t.laterEv, t.laterKey, t.laterCount = nil, nil, -1
end

local function buildTrack(t: EncounterTimeline)
    local track = CreateFrame("Frame", nil, t)
    track:SetPoint("TOPLEFT")
    track:SetSize(draw.size("timeline-w"), TRACK_H)
    t.track = track
    local line = track:CreateTexture(nil, "ARTWORK")
    draw.paintFill(line, "gilt-line")
    line:SetPoint("TOPLEFT", 0, -LINE_Y)
    line:SetPoint("TOPRIGHT", 0, -LINE_Y)
    line:SetHeight(2)
    local now = track:CreateTexture(nil, "OVERLAY")
    draw.paintFill(now, "ink")
    now:SetSize(2, 18)
    now:SetPoint("TOPLEFT", -1, -3)
    t.ticks = {}
    for s = 5, t.window - 1, 5 do
        local tick = track:CreateTexture(nil, "ARTWORK")
        draw.paintFill(tick, "gilt-line")
        tick:SetSize(1, 8)
        tick:SetPoint("TOPLEFT", math.floor(s / t.window * track:GetWidth() + 0.5), -8)
        t.ticks[#t.ticks + 1] = tick
    end
    t.endLabel = text(track, "micro", "ink-faint")
    t.endLabel:SetShadowed(true)
    t.endLabel:SetPoint("BOTTOM", track, "TOPRIGHT", 0, -10)
    t.endLabel:SetValue(("%ds"):format(t.window))
    t.later = text(track, "caption", "ink-muted")
    t.later:SetShadowed(true)
    t.later:SetPoint("TOPLEFT", track, "TOPRIGHT", S["space-4"], -4)
    t.later:SetVisible(false)
    t.evs = {}
    t.trackW = track:GetWidth()
    -- (resized: the places along it again)
    track:SetScript("OnSizeChanged", function(_: Frame, width: number)
        if width ~= t.trackW then
            t.trackW = width
            if t.variant == "track" then
                t:Layout()
            end
        end
    end)
end

--------------------------------------------------------------------------------
-- List
--------------------------------------------------------------------------------

local LIST_W, ROW_H = 280, 30

--- One row of the list.
export class ListRow extends Frame
    icon: Icon
    name: Text
    time: Text
    badge: controls.StateBadge
    track: Texture
    drain: Texture
    -- what was last set: the event shown, the time text's key, amber or
    -- not, the drain's pixel
    ev: TimelineEvent? = nil
    timeKey: number? = nil
    soon: boolean? = nil
    drainPx: number? = nil

    constructor(t: EncounterTimeline, i: number)
        super(nil, t.list)
        draw.layout(self, function()
            self:SetSize(LIST_W - S["space-5"] * 2, ROW_H)
        end)
        self.icon = icon(self, "icon-md")
        self.icon:SetPoint("LEFT", 0, 2)
        self.name = text(self, "label", "ink")
        draw.layout(self, function()
            self.name:SetPoint("LEFT", self.icon, "RIGHT", S["space-4"], 0)
        end)
        self.name:SetWordWrap(false)
        self.time = text(self, "numeric", "ink")
        self.time:SetPoint("RIGHT", 0, 2)
        self.badge = controls.stateBadge(self, "warning", "Tank")
        draw.layout(self, function()
            self.badge:SetPoint("RIGHT", self.time, "LEFT", -S["space-4"], 0)
        end)
        self.track = self:CreateTexture(nil, "BACKGROUND")
        draw.paintFill(self.track, "track")
        self.track:SetPoint("BOTTOMLEFT")
        self.track:SetPoint("BOTTOMRIGHT")
        self.track:SetHeight(2)
        self.drain = self:CreateTexture(nil, "ARTWORK")
        self.drain:SetPoint("BOTTOMLEFT")
        self.drain:SetHeight(2)
        t.rows[i] = self
    end
end

local function listRow(t: EncounterTimeline, i: number): ListRow
    return ListRow.new(t, i)
end

local INNER_W = LIST_W - S["space-5"] * 2

-- Per frame: each row's event (when the order changed), time and drain.
local function tickList(t: EncounterTimeline)
    local order, left, rows = t.order, t.left, t.rows
    local win, soonAt = t.window, t.soonAt
    for i = 1, t.count do
        local row = rows[i]
        local e, r = order[i], left[i]
        if row.ev ~= e then
            row.ev = e
            row.icon:SetArt(e.icon or 134400)
            row.name:SetValue(e.label or "")
            local badge = e.badge
            row.badge:SetShown(badge ~= nil)
            if badge then
                row.badge:SetState(badge.tone, badge.text)
            end
            row.name:SetPoint("RIGHT", badge and row.badge or row.time, "LEFT", -S["space-4"], 0)
        end
        local key = timeKey(r)
        if row.timeKey ~= key then
            row.timeKey = key
            row.time:SetValue(fmtTime(r))
        end
        local soon = r <= soonAt
        if row.soon ~= soon then
            row.soon = soon
            row.time:SetColor(soon and "amber" or "ink")
            draw.paintFill(row.drain, soon and "amber" or "ink-muted")
        end
        -- (set again when it crosses a pixel: within one of the exact width)
        local width = math.max(1, math.min(1, r / win) * INNER_W)
        local px = math.floor(width + 0.5)
        if row.drainPx ~= px then
            row.drainPx = px
            row.drain:SetWidth(width)
        end
    end
end

-- Per event: a row per event, one under another, the panel's height; the
-- rows' last values forgotten, so the next tick sets them.
local function layoutList(t: EncounterTimeline)
    local y = t.listTop
    local n = t.count
    for i = 1, n do
        local r = t.rows[i] or listRow(t, i)
        r.ev, r.timeKey, r.soon, r.drainPx = nil, nil, nil, nil
        r:ClearAllPoints()
        r:SetPoint("TOPLEFT", S["space-5"], -y)
        r:Show()
        y = y + ROW_H + S["space-3"]
    end
    for i = n + 1, #t.rows do
        local r = t.rows[i]
        r.ev = nil
        r:Hide()
    end
    local panel = t.list :: TimelineList
    panel:SetHeight(math.max(t.listTop + S["space-5"], y - S["space-3"] + S["space-5"]))
    t:SetHeight(panel:GetHeight())
end

-- the rule under the title, and the rows under it, by the header's line
-- height (again when a theme changes it)
local timelines: { [EncounterTimeline]: boolean } = setmetatable({}, { __mode = "k" })
local function placeRule(t: EncounterTimeline)
    local y = S["space-4"] * 2 + T.type.header.lineHeight
    local rule = (t.list :: TimelineList).rule
    rule:ClearAllPoints()
    rule:SetPoint("TOPLEFT", 1, -y)
    rule:SetPoint("TOPRIGHT", -1, -y)
    t.listTop = y + 1 + S["space-4"]
end

events.on(
    "SUUUI_THEME_CHANGED",
    function()
        for t in pairs(timelines) do
            if t.list then
                placeRule(t)
            end
            t:Layout()
        end
    end,
    "Timeline"
)

--- The list's glass panel.
export class TimelineList extends Frame
    readonly title: Text
    readonly meta: Text
    readonly rule: Texture

    constructor(parent: Frame)
        super(nil, parent)
        self:SetPoint("TOPLEFT")
        self:SetWidth(LIST_W)
        local ground = draw.fill(self, "surface-glass", "BACKGROUND")
        ground:SetAllPoints()
        draw.pattern(ground, "surface-pattern")
        draw.border(self, "gilt-line", { texture = "border" })
        draw.shadow(self, "shadow-panel")
        self.title = text(self, "header", "gilt-text")
        draw.layout(self, function()
            self.title:SetPoint("TOPLEFT", S["space-5"], -S["space-4"])
        end)
        self.title:SetValue("Timeline")
        self.meta = text(self, "caption", "ink-muted")
        draw.layout(self, function()
            self.meta:SetPoint("LEFT", self.title, "RIGHT", S["space-3"], 0)
            self.meta:SetPoint("RIGHT", -S["space-5"], 0)
        end)
        self.meta:SetWordWrap(false)
        self.rule = self:CreateTexture(nil, "BORDER")
        draw.paintFill(self.rule, "gilt-faint")
        self.rule:SetHeight(1)
    end
end

local function buildList(t: EncounterTimeline)
    t.list = TimelineList.new(t)
    t.rows = {}
    placeRule(t)
end

--------------------------------------------------------------------------------
-- The timeline
--------------------------------------------------------------------------------

export class EncounterTimeline extends Frame
    window: number
    soonAt: number
    events: TimelineEvent[]
    variant: string = "track"
    -- the track's parts (the "track" variant)
    track: Frame?
    trackW: number = 0
    ticks: Texture[] = {}
    endLabel: Text? = nil
    later: Text? = nil
    evs: TrackEvent[] = {}
    -- (the frames shown, the "later" line's event, text key and count last set)
    shownEvs: number = 0
    laterEv: TimelineEvent? = nil
    laterKey: number? = nil
    laterCount: number = -1
    -- the list's (the "list" variant)
    list: TimelineList?
    rows: ListRow[] = {}
    listTop: number = 0
    -- per event (Layout): the running ones by their end, the paused ones by
    -- their time left
    running: TimelineEvent[] = {}
    held: TimelineEvent[] = {}
    -- per frame (reused): the events soonest first and their seconds left
    order: TimelineEvent[] = {}
    left: number[] = {}
    count: number = 0
    -- something still runs toward now (the OnUpdate runs while it does)
    moving: boolean = false
    ticking: boolean = false
    -- how often it was laid out (per event, not per frame: the tests count it)
    layouts: number = 0
    step: (frame: Frame, elapsed: number) -> ()

    constructor(parent: Frame, options: { variant?: string, window?: number, soonAt?: number }?)
        local opts = options or {}
        super(nil, parent)
        self.window, self.soonAt = opts.window or 30, opts.soonAt or 5
        self.events = {}
        self.step = function()
            self:Tick()
        end
        timelines[self] = true
        self:SetVariant(opts.variant or "track")
    end

    -- What changes per event: the order's two sorted lists, the list's rows
    -- and panel; then a tick. (SetEvents, a variant switch, a theme change,
    -- a resize.)
    function Layout()
        self.layouts += 1
        local running, held = self.running, self.held
        local nRun, nHeld = 0, 0
        for i, e in ipairs(self.events) do
            given[e] = i
            if not e.paused and e.endsAt then
                nRun += 1
                running[nRun] = e
            else
                nHeld += 1
                held[nHeld] = e
            end
        end
        while #running > nRun do
            table.remove(running)
        end
        while #held > nHeld do
            table.remove(held)
        end
        table.sort(running, byEnd)
        table.sort(held, byHeld)
        local n = nRun + nHeld
        local order, left = self.order, self.left
        for i = 1, n do
            order[i], left[i] = (running[i] or held[i - nRun]), 0
        end
        while #order > n do
            table.remove(order)
            table.remove(left)
        end
        self.count = n
        if self.variant == "list" then
            layoutList(self)
        else
            layoutTrack(self)
        end
        self:Tick()
    end

    -- What changes per frame: the order by the time left now, then what
    -- moved. Stops the OnUpdate once nothing runs toward now.
    function Tick()
        local now = GetTime()
        local running, held, order, left = self.running, self.held, self.order, self.left
        -- (the two sorted lists merged: a running one passes a paused one on
        -- the frame its time left drops below the paused one's)
        local i, j = 1, 1
        local a: TimelineEvent? = running[1]
        local h: TimelineEvent? = held[1]
        local ra = a and math.max(0, (a.endsAt or now) - now) or 0
        local rh = h and (h.paused or 0) or 0
        for n = 1, self.count do
            if a and (not h or ra <= rh) then
                order[n], left[n] = a, ra
                i += 1
                a = running[i]
                ra = a and math.max(0, (a.endsAt or now) - now) or 0
            elseif h then
                order[n], left[n] = h, rh
                j += 1
                h = held[j]
                rh = h and (h.paused or 0) or 0
            end
        end
        if self.variant == "list" then
            tickList(self)
        else
            tickTrack(self)
        end
        local last = running[#running]
        local moving = last ~= nil and (last.endsAt or 0) > now
        self.moving = moving
        if moving ~= self.ticking then
            self.ticking = moving
            self:SetScript("OnUpdate", moving and self.step or nil)
        end
    end

    function SetEvents(list: TimelineEvent[]?)
        self.events = list or {}
        self:Layout()
    end

    function SetMeta(meta: string?)
        if self.list then
            self.list.meta:SetValue(meta or "")
        end
    end

    function SetVariant(variant: string?)
        local v = variant == "list" and "list" or "track"
        -- (laid out again only when it changes or is new: the module sets
        -- its variant at every refresh)
        local changed = v ~= self.variant or (v == "list" and not self.list) or (v == "track" and not self.track)
        self.variant = v
        if v == "list" and not self.list then
            buildList(self)
        end
        if v == "track" and not self.track then
            buildTrack(self)
        end
        if self.track then
            self.track:SetShown(v == "track")
        end
        if self.list then
            self.list:SetShown(v == "list")
        end
        if v == "track" then
            self:SetSize(draw.size("timeline-w"), TRACK_H)
        else
            self:SetWidth(LIST_W)
        end
        if changed then
            self:Layout()
        end
    end
end

export function encounterTimeline(
    parent: Frame,
    options: { variant?: string, window?: number, soonAt?: number }?
): EncounterTimeline
    return EncounterTimeline.new(parent, options)
end
