-- UI/DamageMeter.wowlua
-- One damage meter window (design board "Damage meter"): Blizzard's own meter
-- data (C_DamageMeter) in SuuUI's look. A glass panel `meter-w` wide: a head
-- with the meter type and the fight (bare selects), the fight's time and a
-- menu; then `rows` rows `meter-row` tall, the bar being the row.
--
--   local w = damageMeter(parent, { rows = 8, onView = fn(type, session),
--       onNewWindow = fn, onClose = fn (extra windows), onReset = fn, onSettings = fn,
--       api = C_DamageMeter stand-in, recapApi = C_DeathRecap stand-in })  -- 0.10: previews
--   w:SetView(type, session)   -- "damage" … "deaths"; "current" | "overall" | a sessionID
--   w:SetOptions({ numbers, barColor, marker, nameColor, pinYou })
--   w:SetCanAddWindow(on)
--   w:SetMaxRows(n)            -- the height in rows, live
--   w:Refresh()                -- read the data again (the module drives it)
--
-- Secret values (combat): names, amounts and GUIDs are secret, the class,
-- spec icon and "is it you" are not. Rows keep the engine's order (it ranks
-- them), fills and numbers go to the engine untested (StatusBar values,
-- AbbreviateNumbers into SetText), your own name comes from UnitName. A row
-- opens its spell breakdown when its GUID is readable (yours always, through
-- UnitGUID; the others' after combat): the breakdown call refuses a secret
-- GUID. Shares need a division, so they arrive when combat ends. Deaths open
-- their recap (C_DeathRecap).

import isSecret from "wowlua:secret"
import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import text, flag, Text from "/UI/Text"
import select as uiSelect, Select, SelectOption from "/UI/Select"
import showTooltip, hideTooltip from "/UI/Tooltip"

const S = T.space

const WHITE = "Interface\\Buttons\\WHITE8X8"
local function readable(v: unknown): v is number return not isSecret(v) and type(v) == "number" end
local function plainString(v: unknown): v is string return not isSecret(v) and type(v) == "string" and v ~= "" end

-- One option of the type select: a heading, or a type (its value, label and
-- Enum.DamageMeterType key).
export type MeterType = { heading?: string, value?: string, label?: string, enum?: string }

-- The design's types, in Blizzard's order (Absorbs left out, as Forever's menu does)
local TYPES: MeterType[] = {
    { heading = "Damage" },
    { value = "damage", label = "Damage done", enum = "DamageDone" },
    { value = "dps", label = "DPS", enum = "Dps" },
    { value = "damageTaken", label = "Damage taken", enum = "DamageTaken" },
    { value = "avoidable", label = "Avoidable damage taken", enum = "AvoidableDamageTaken" },
    { value = "enemyDamageTaken", label = "Enemy damage taken", enum = "EnemyDamageTaken" },
    { heading = "Healing" },
    { value = "healing", label = "Healing done", enum = "HealingDone" },
    { value = "hps", label = "HPS", enum = "Hps" },
    { heading = "Actions" },
    { value = "interrupts", label = "Interrupts", enum = "Interrupts" },
    { value = "dispels", label = "Dispels", enum = "Dispels" },
    { value = "deaths", label = "Deaths", enum = "Deaths" },
}
local BY_VALUE: { [string]: MeterType } = {}
for _, t in ipairs(TYPES) do if t.value then BY_VALUE[t.value] = t end end
local PER_SECOND: { [string]: boolean } = { dps = true, hps = true } -- per second leads, the total in brackets
local COUNTS: { [string]: boolean } = { interrupts = true, dispels = true }
local NO_PIN: { [string]: boolean } = { deaths = true, enemyDamageTaken = true }
local ENEMIES: { [string]: boolean } = { enemyDamageTaken = true }

-- A type's Enum.DamageMeterType value (nil on a client without the meter).
local function meterTypeOf(key: string?): DamageMeterType?
    local E = Enum.DamageMeterType
    if not (E and key) then return nil end
    local byKey: { [string]: DamageMeterType } = {
        DamageDone = E.DamageDone, Dps = E.Dps, DamageTaken = E.DamageTaken,
        AvoidableDamageTaken = E.AvoidableDamageTaken, EnemyDamageTaken = E.EnemyDamageTaken,
        HealingDone = E.HealingDone, Hps = E.Hps, Interrupts = E.Interrupts, Dispels = E.Dispels, Deaths = E.Deaths,
    }
    return byKey[key]
end

-- The fight a window shows: "current", "overall" or a past fight's ID.
export type MeterSession = string | number

-- The game's meter (C_DamageMeter) and death recaps (C_DeathRecap), or a
-- stand-in (the previews, tests).
export type MeterApi = {
    GetAvailableCombatSessions: typeof(C_DamageMeter.GetAvailableCombatSessions),
    GetCombatSessionFromID: typeof(C_DamageMeter.GetCombatSessionFromID),
    GetCombatSessionFromType: typeof(C_DamageMeter.GetCombatSessionFromType),
    GetCombatSessionSourceFromID: typeof(C_DamageMeter.GetCombatSessionSourceFromID),
    GetCombatSessionSourceFromType: typeof(C_DamageMeter.GetCombatSessionSourceFromType),
    GetSessionDurationSeconds: typeof(C_DamageMeter.GetSessionDurationSeconds),
}

-- A death recap's event: what the window reads of it (the game's
-- declarations leave the structure empty).
export interface RecapEvent
    event?: string | Secret<string>
    spellId?: number | Secret<number>
    spellName?: string | Secret<string>
    amount?: number | Secret<number>
    timestamp?: number | Secret<number>
    currentHP?: number | Secret<number>
    overkill?: number | Secret<number>
end

export type RecapApi = {
    GetRecapEvents: (recapID: number?) -> unknown,
    GetRecapMaxHealth: (recapID: number?) -> (number | Secret<number>)?,
}

-- What a row shows (setRow).
export type MeterRowData = {
    rank?: string | number,
    rankWide?: boolean,
    mark?: string,
    class?: string,
    spellID?: number | Secret<number>,
    name?: string | Secret<string>,
    nameColor?: string,
    textName?: boolean,
    sub?: string | Secret<string>,
    main?: string,
    paren?: string,
    share?: string,
    fill?: number | Secret<number>,
    fillMax?: number | Secret<number>,
    fillLow?: boolean,
    fillClass?: string,
    you?: boolean,
    danger?: boolean,
    plain?: boolean,
    heal?: boolean,
    open?: () -> (),
    tip?: string,
}

-- Where the window is drilled into: a source's spells, or a death's recap.
export type MeterDrill = { kind: string, row: MeterRowData, guid?: string | Secret<string>, creature?: number,
    src?: DamageMeterCombatSourceSecret }

-- The window's options (SetOptions).
export type MeterView = { numbers: string, barColor: string, marker: string, nameColor: string, pinYou: boolean }
export type MeterViewChange = { numbers?: string, barColor?: string, marker?: string, nameColor?: string, pinYou?: boolean }

-- What damageMeter takes.
export type DamageMeterOptions = {
    rows?: number,
    onView?: (type: string, session: MeterSession) -> (),
    onNewWindow?: () -> (),
    onClose?: () -> (),
    onReset?: () -> (),
    onSettings?: () -> (),
    api?: MeterApi,
    recapApi?: RecapApi,
}

const MAIN_W = 40
const PAREN_W = 48
const SHARE_W = 30
const HEAD = 32

--------------------------------------------------------------------------------
-- Numbers
--------------------------------------------------------------------------------

local function group3(n: number): string
    if BreakUpLargeNumbers then return BreakUpLargeNumbers(n) end
    return tostring(n)
end

-- 8,412 · 48.2k · 482k · 1.21M · 12.4M; a secret number through the engine.
local function abbr(value: number | string | Secret<number> | nil): string
    if isSecret(value) then return AbbreviateNumbers(value) end
    local v = tonumber(value) or 0
    local a = math.abs(v)
    if a < 10000 then return group3(math.floor(v + 0.5)) end
    if a < 1e6 then
        return (a < 1e5 and ("%.1fk"):format(v / 1e3) or ("%dk"):format(math.floor(v / 1e3 + 0.5)))
    end
    return (a < 1e7 and ("%.2fM"):format(v / 1e6) or ("%.1fM"):format(v / 1e6))
end

local function count(v: number | string | Secret<number> | nil): string
    if isSecret(v) then return AbbreviateNumbers(v) end
    return group3(math.floor((tonumber(v) or 0) + 0.5))
end

local function clock(given: unknown): string
    if not readable(given) then return "" end
    local s = math.max(0, math.floor(given + 0.5))
    return ("%d:%02d"):format(math.floor(s / 60), s % 60)
end

local function since(given: unknown): string
    if not readable(given) then return "" end
    local s = math.max(0, math.floor(given + 0.5))
    local m = math.floor(s / 60)
    return m > 0 and ("%dm %ds"):format(m, s % 60) or ("%ds"):format(s)
end

-- A name without its realm; a secret one as it is.
local function shortName(name: unknown): string | Secret<string>
    if issecretvalue(name) then
        local secretName = name :: Secret<string>
        local ok, short = pcall(Ambiguate, secretName, "short")
        return ok and short or secretName
    end
    if type(name) ~= "string" then return "" end
    return Ambiguate and Ambiguate(name, "short") or name:match("^[^%-]+") or name
end

--------------------------------------------------------------------------------
-- Small art: the "more" dots and the back arrow
--------------------------------------------------------------------------------

local function dots(parent: Frame, color: string): Frame
    local f = CreateFrame("Frame", nil, parent)
    f:SetSize(13, 13)
    for i = -1, 1 do
        local t = f:CreateTexture(nil, "ARTWORK")
        draw.paintFill(t, color)
        t:SetSize(2, 2)
        t:SetPoint("CENTER", i * 4, 0)
    end
    return f
end

local function backArrow(parent: Frame, color: string): Frame
    local f = CreateFrame("Frame", nil, parent)
    f:SetSize(13, 13)
    for _, a in ipairs({ 45, -45 }) do
        local t = f:CreateTexture(nil, "ARTWORK")
        t:SetTexture(WHITE)
        draw.paint(t, color)
        t:SetSize(6, 1.5)
        t:SetRotation(math.rad(a))
        t:SetPoint("CENTER", -1, a > 0 and 2 or -2)
    end
    return f
end

-- A 24px square header button: transparent, a gilt-line edge on hover.
export class MeterHeadButton extends Button
    readonly edge: draw.Border
    readonly hover: Texture
    readonly art: Frame

    constructor(parent: Frame, art: (parent: Frame, color: string) -> Frame, onClick: () -> (), tip: string?)
        super(nil, parent)
        self:SetSize(24, 24)
        self.edge = draw.border(self, "gilt-line")
        self.edge:SetShown(false)
        self.hover = draw.fill(self, "surface-raised", "BACKGROUND")
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.art = art(self, "ink-muted")
        self.art:SetPoint("CENTER")
        self:SetScript("OnEnter", function()
            self.edge:SetShown(true); self.hover:Show()
            if tip then showTooltip(self, { title = tip }) end
        end)
        self:SetScript("OnLeave", function()
            self.edge:SetShown(false); self.hover:Hide()
            hideTooltip()
        end)
        self:SetScript("OnClick", onClick)
    end
end

--------------------------------------------------------------------------------
-- The menu behind "more"
--------------------------------------------------------------------------------

-- An item of the "more" menu.
export class MeterMenuItem extends Button
    readonly hover: Texture
    readonly label: Text
    readonly line: Texture
    enabled: boolean = false
    action?: () -> ()

    constructor(m: MeterMenu)
        super(nil, m)
        self:SetHeight(26)
        self.hover = draw.fill(self, "surface-raised", "BACKGROUND")
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.label = text(self, "body", "ink")
        self.label:SetPoint("LEFT", S["space-4"], 0)
        self.line = self:CreateTexture(nil, "ARTWORK")
        draw.paintFill(self.line, "gilt-faint")
        self.line:SetHeight(1)
        self.line:SetPoint("LEFT", S["space-2"], 0)
        self.line:SetPoint("RIGHT", -S["space-2"], 0)
        self:SetScript("OnEnter", function() if self.enabled then self.hover:Show() end end)
        self:SetScript("OnLeave", function() self.hover:Hide() end)
        self:SetScript("OnClick", function()
            if not self.enabled then return end
            m:Hide()
            local action = self.action
            if action then action() end
        end)
    end
end

-- The menu behind "more", and the catcher a click elsewhere closes it on.
export class MeterMenu extends Frame
    readonly items: MeterMenuItem[] = {}
    readonly catcher: Button

    constructor(w: DamageMeter)
        super(nil, w)
        self:SetFrameStrata("DIALOG")
        self:SetWidth(200)
        draw.fill(self, "surface", "BACKGROUND"):SetAllPoints()
        draw.border(self, "gilt-line")
        draw.shadow(self, "shadow-panel")
        self:Hide()
        local catcher = CreateFrame("Button", nil, UIParent)
        self.catcher = catcher
        self:SetScript("OnHide", function() catcher:Hide() end)
        catcher:SetAllPoints(UIParent)
        catcher:SetFrameStrata("DIALOG")
        catcher:SetFrameLevel(1)
        catcher:Hide()
        catcher:RegisterForClicks("AnyDown")
        catcher:SetScript("OnClick", function() self:Hide() end)
        self:SetFrameLevel(catcher:GetFrameLevel() + 5)
    end
end

-- An entry of the menu: a label and what it does, or a divider.
type MenuEntry = { label?: string, disabled?: boolean, divider?: boolean, onClick?: () -> () }

local function openMenu(w: DamageMeter)
    local m = w.menu
    for _, it in ipairs(m.items) do it:Hide() end
    local o = w.opts
    local list: MenuEntry[] = {
        { label = "New window", disabled = not w.canAdd, onClick = o.onNewWindow },
        { label = "Reset all fights", onClick = o.onReset },
    }
    if o.onClose then list[#list + 1] = { label = "Close this window", onClick = o.onClose } end
    list[#list + 1] = { divider = true }
    list[#list + 1] = { label = "Settings", onClick = o.onSettings }
    local y = S["space-2"]
    for i, e in ipairs(list) do
        local it = m.items[i]
        if not it then
            it = MeterMenuItem.new(m)
            m.items[i] = it
        end
        it:ClearAllPoints()
        it:SetPoint("TOPLEFT", 1, -y)
        it:SetPoint("TOPRIGHT", -1, -y)
        it.line:SetShown(e.divider == true)
        it.label:SetVisible(not e.divider)
        it:SetHeight(e.divider and (S["space-2"] * 2 + 1) or 26)
        it.label:SetValue(e.label or "")
        it.label:SetColor(e.disabled and "ink-faint" or "ink")
        it.enabled = not (e.divider or e.disabled)
        it.action = e.onClick
        it:Show()
        y = y + it:GetHeight()
    end
    m:SetHeight(y + S["space-2"])
    m:ClearAllPoints()
    m:SetPoint("TOPRIGHT", w.more, "BOTTOMRIGHT", 0, -S["space-1"])
    m.catcher:Show()
    m:Show()
end

--------------------------------------------------------------------------------
-- Rows
--------------------------------------------------------------------------------

local function mix(token: string, share: number): (number, number, number)
    local r, g, b = draw.rgba(token)
    local sr, sg, sb = draw.rgba("surface-sunk")
    return r * share + sr * (1 - share), g * share + sg * (1 - share), b * share + sb * (1 - share)
end

-- the fill each bar texture last asked for: a class token, "low", or nil
-- (false) for unit-fill
local fills: { [Texture]: string | false } = setmetatable({}, { __mode = "k" })

-- The bar's fill, from the tokens each time (draw.bind: again after a
-- theme change).
local function drawFill(tex: Texture)
    local r1: number, g1: number, b1: number, r2: number, g2: number, b2: number
    local kind = fills[tex]
    if kind == "low" then
        r1, g1, b1 = draw.rgba("unit-fill-low-deep")
        r2, g2, b2 = draw.rgba("unit-fill-low")
    elseif kind then
        r2, g2, b2 = mix(kind, 0.55)
        r1, g1, b1 = r2 * 0.75, g2 * 0.75, b2 * 0.75
    else
        r1, g1, b1 = mix("unit-fill-deep", 0.7)
        r2, g2, b2 = mix("unit-fill", 0.7)
    end
    tex:SetGradient("HORIZONTAL", CreateColor(r1, g1, b1, 1), CreateColor(r2, g2, b2, 1))
end

-- A row of the window (the bar is the row).
export class DamageRow extends Button
    readonly bar: StatusBar
    readonly edge: draw.Border
    readonly glow: draw.SoftEdge
    readonly rank: Text
    readonly icon: Texture
    readonly diamond: Texture
    readonly name: Text
    readonly sub: Text
    readonly share: Text
    readonly paren: Text
    readonly main: Text
    readonly hover: Texture
    edgeColor?: string
    open?: () -> ()
    tip?: string

    constructor(w: DamageMeter)
        super(nil, w.body)
        local h = draw.size("meter-row")
        self:SetSize(w.innerW, h)
        self:RegisterForClicks("LeftButtonUp")
        draw.fill(self, "surface-sunk", "BACKGROUND"):SetAllPoints()
        self.bar = CreateFrame("StatusBar", nil, self)
        self.bar:SetAllPoints()
        self.bar:SetStatusBarTexture(WHITE)
        self.bar:SetMinMaxValues(0, 1)
        self.edge = draw.border(self.bar, "gilt-hairline", { layer = "OVERLAY" })
        self.glow = draw.shadow(self, "glow-ember")
        self.glow:SetShown(false)
        local o = CreateFrame("Frame", nil, self)
        o:SetAllPoints()
        o:SetFrameLevel(self.bar:GetFrameLevel() + 2)
        self.rank = text(o, "micro", "ink")
        self.rank:SetJustifyH("RIGHT")
        self.icon = o:CreateTexture(nil, "OVERLAY")
        self.diamond = draw.diamond(o, 5, "gilt")
        self.name = text(o, "unit-name-sm", "ink")
        self.name:SetShadowed(true)
        self.name:SetWordWrap(false)
        self.name:SetJustifyH("LEFT")
        self.sub = text(o, "caption", "ink")
        self.sub:SetShadowed(true)
        self.sub:SetWordWrap(false)
        self.sub:SetJustifyH("LEFT")
        self.share = text(o, "caption", "ink")
        self.share:SetShadowed(true)
        self.share:SetFixedWidth(SHARE_W)
        self.share:SetJustifyH("RIGHT")
        self.paren = text(o, "caption", "ink")
        self.paren:SetShadowed(true)
        self.paren:SetFixedWidth(PAREN_W)
        self.paren:SetJustifyH("RIGHT")
        self.main = text(o, "numeric", "ink")
        self.main:SetShadowed(true)
        self.main:SetFixedWidth(MAIN_W)
        self.main:SetJustifyH("RIGHT")
        self.hover = self:CreateTexture(nil, "HIGHLIGHT")
        self.hover:SetAllPoints()
        self.hover:SetColorTexture(1, 1, 1, 0.04)
        self:SetScript("OnClick", function()
            local open = self.open
            if open then open() end
        end)
        self:SetScript("OnEnter", function()
            if self.open then self.edge:SetColor("gilt") end
            local tip = self.tip
            if tip then showTooltip(self, { description = tip }) end
        end)
        self:SetScript("OnLeave", function()
            self.edge:SetColor(self.edgeColor or "gilt-hairline")
            hideTooltip()
        end)
        self:SetFill(nil)
    end

    function SetFill(kind: string?)
        local tex = self.bar:GetStatusBarTexture()
        fills[tex] = kind or false
        draw.bind(tex, drawFill)
    end

    -- What the row shows (see MeterRowData).
    function Set(d: MeterRowData)
        local x = S["space-2"]
        local rank = d.rank
        self.rank:SetVisible(rank ~= nil)
        if rank ~= nil then
            self.rank:SetValue(rank)
            self.rank:SetColor(d.plain and "ink-muted" or "ink")
            self.rank:SetWidth(d.rankWide and 30 or 12)
            self.rank:ClearAllPoints()
            self.rank:SetPoint("LEFT", x, 0)
            x = x + (d.rankWide and 30 or 12) + S["space-3"]
        end
        self.icon:Hide()
        self.diamond:Hide()
        local class = d.class
        if d.mark == "class" and class then
            local atlas: string? = GetClassAtlas and GetClassAtlas(class)
            local coords: number[]? = CLASS_ICON_TCOORDS and CLASS_ICON_TCOORDS[class]
            if atlas then
                self.icon:SetAtlas(atlas)
            elseif coords then
                self.icon:SetTexture("Interface\\TargetingFrame\\UI-Classes-Circles")
                self.icon:SetTexCoord(coords[1], coords[2], coords[3], coords[4])
            end
            self.icon:SetSize(16, 16)
            self.icon:ClearAllPoints()
            self.icon:SetPoint("LEFT", x - 2, 0)
            self.icon:Show()
            x = x + 14 + S["space-3"] - S["space-1"]
        elseif d.mark == "diamond" and class and draw.isColor("class-" .. class:lower()) then
            draw.paint(self.diamond, "class-" .. class:lower())
            self.diamond:ClearAllPoints()
            self.diamond:SetPoint("CENTER", self, "LEFT", x + 3, 0)
            self.diamond:Show()
            x = x + 7 + S["space-3"] - S["space-1"]
        elseif d.mark == "spell" then
            local ok, tex = pcall(C_Spell.GetSpellTexture, d.spellID or 0)
            self.icon:SetTexture(ok and tex or 134400)
            self.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
            self.icon:SetSize(14, 14)
            self.icon:ClearAllPoints()
            self.icon:SetPoint("LEFT", x, 0)
            self.icon:Show()
            x = x + 14 + S["space-3"]
        end
        -- the right end (fixed widths: secret numbers can't be measured): share,
        -- paren, main, from the right edge in
        local right: Text? = nil
        local function place(t: Text, show: boolean)
            t:SetVisible(show)
            if not show then return end
            t:ClearAllPoints()
            if right then t:SetPoint("RIGHT", right, "LEFT", -S["space-2"], 0) else t:SetPoint("RIGHT", -S["space-3"], 0) end
            right = t
        end
        local share, paren, main = d.share, d.paren, d.main
        place(self.share, share ~= nil)
        if share ~= nil then self.share:SetValue(share) end
        place(self.paren, paren ~= nil)
        if paren ~= nil then
            self.paren:SetFormattedText("(%s)", paren)
            self.paren.value = nil
        end
        place(self.main, main ~= nil)
        if main ~= nil then
            self.main:SetText(main)
            self.main.value = nil
            self.main:SetColor(d.heal and "fel" or "ink")
        end
        -- the name, then the sub line (a killing blow, a pet) filling the gap
        self.name:SetStyle(d.textName and "label" or "unit-name-sm")
        self.name:SetText(d.name or "")
        self.name.value = nil
        self.name:SetColor(d.nameColor or "ink")
        self.name:ClearAllPoints()
        self.name:SetPoint("LEFT", x, 0)
        local sub = d.sub
        local hasSub = issecretvalue(sub) or (sub ~= nil and sub ~= "")
        if sub and hasSub then
            self.name:SetWidth(math.floor((self:GetWidth() - x) * 0.4))
            self.sub:SetText(sub)
            self.sub.value = nil
            self.sub:ClearAllPoints()
            self.sub:SetPoint("LEFT", self.name, "RIGHT", S["space-3"], 0)
            if right then self.sub:SetPoint("RIGHT", right, "LEFT", -S["space-3"], 0) else self.sub:SetPoint("RIGHT", -S["space-3"], 0) end
            self.sub:Show()
        else
            self.sub:Hide()
            if right then self.name:SetPoint("RIGHT", right, "LEFT", -S["space-3"], 0) else self.name:SetPoint("RIGHT", -S["space-3"], 0) end
        end
        -- the bar
        local fill = d.fill
        if issecretvalue(fill) or fill ~= nil then
            self.bar:SetMinMaxValues(0, d.fillMax or 1)
            self.bar:SetValue(fill)
            self.bar:GetStatusBarTexture():Show()
        else
            self.bar:SetMinMaxValues(0, 1)
            self.bar:SetValue(0)
        end
        local fillClass = d.fillClass
        self:SetFill(fillClass and ("class-" .. fillClass:lower()) or d.fillLow and "low" or nil)
        local edgeColor = d.danger and "ember" or (d.you and "ink") or "gilt-hairline"
        self.edgeColor = edgeColor
        self.edge:SetColor(edgeColor)
        self.glow:SetShown(d.danger == true)
        self.open, self.tip = d.open, d.tip
        self:Show()
    end
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

local function sessionArg(session: MeterSession): (DamageMeterSessionType?, number?)
    local ST = Enum.DamageMeterSessionType
    if type(session) == "number" then return nil, session end
    return session == "overall" and ST.Overall or ST.Current, nil
end

local function fetch(DM: MeterApi?, session: MeterSession, typeValue: string): DamageMeterCombatSessionSecret?
    local t = BY_VALUE[typeValue]
    local meterType = t and meterTypeOf(t.enum)
    if not (DM and meterType) then return nil end
    local st, id = sessionArg(session)
    local ok: boolean, s: DamageMeterCombatSessionSecret?
    if id then ok, s = pcall(DM.GetCombatSessionFromID, id, meterType)
    else ok, s = pcall(DM.GetCombatSessionFromType, st :: DamageMeterSessionType, meterType) end
    return ok and s or nil
end

local function fetchSource(DM: MeterApi, session: MeterSession, typeValue: string, guid: (string | Secret<string>)?,
                           creatureID: number?): DamageMeterCombatSessionSourceSecret?
    local t = BY_VALUE[typeValue] :: MeterType
    local meterType = meterTypeOf(t.enum) :: DamageMeterType
    local st, id = sessionArg(session)
    local ok: boolean, s: DamageMeterCombatSessionSourceSecret?
    if id then ok, s = pcall(DM.GetCombatSessionSourceFromID, id, meterType, guid :: string?, creatureID)
    else ok, s = pcall(DM.GetCombatSessionSourceFromType, st :: DamageMeterSessionType, meterType, guid :: string?, creatureID) end
    return ok and s or nil
end

local function inCombat(): boolean return InCombatLockdown() or flag(UnitAffectingCombat("player")) end

export class DamageMeter extends Frame
    opts: DamageMeterOptions
    api: MeterApi?      -- C_DamageMeter or a stand-in
    recapApi: RecapApi? -- C_DeathRecap or a stand-in
    view: MeterView
    maxRows: number
    type: string
    session: MeterSession
    innerW: number
    head: Frame
    typeSelect: Select<string>
    drill: MeterDrill? = nil
    sessionSelect: Select<string | number>
    menu: MeterMenu
    more: MeterHeadButton
    time: Text
    back: MeterHeadButton
    who: Text
    what: Text
    total: Text
    body: Frame
    rows: DamageRow[] = {}
    pinLine: Texture
    note: Text
    empty: Text
    sessionSig: string? = nil
    canAdd: boolean? = nil
    -- the menu's catcher (made with the menu)
    catcher: Button

    constructor(parent: Frame, options: DamageMeterOptions?)
        local opts = options or {}
        super(nil, parent)
        self.opts = opts
        local game = _G :: { C_DamageMeter: MeterApi?, C_DeathRecap: RecapApi? }
        self.api, self.recapApi = opts.api or game.C_DamageMeter, opts.recapApi or game.C_DeathRecap
        self.view = { numbers = "compact", barColor = "neutral", marker = "icon", nameColor = "class", pinYou = true }
        self.maxRows = math.max(4, opts.rows or 8)
        self.type, self.session = "damage", "current"
        local width = draw.size("meter-w")
        local h, gap = draw.size("meter-row"), S["space-1"]
        local bodyH = S["space-3"] * 2 + self.maxRows * h + (self.maxRows - 1) * gap
        self:SetSize(width, HEAD + 1 + bodyH)
        self.innerW = width - S["space-3"] * 2
        draw.fill(self, "surface-glass", "BACKGROUND"):SetAllPoints()
        draw.border(self, "gilt-line")
        draw.shadow(self, "shadow-panel")
        -- head
        local head = CreateFrame("Frame", nil, self)
        head:SetPoint("TOPLEFT")
        head:SetPoint("TOPRIGHT")
        head:SetHeight(HEAD)
        self.head = head
        self.typeSelect = uiSelect(head, { bare = true, width = math.floor(width * 0.55), textStyle = "header", textColor = "gilt-text",
            options = TYPES, value = "damage", minListWidth = 220, maxRows = 14, search = false,
            onChange = function(v: string)
                self.type = v
                self.drill = nil
                self:Refresh()
                if opts.onView then opts.onView(self.type, self.session) end
            end })
        self.typeSelect:SetPoint("LEFT", S["space-2"], 0)
        self.sessionSelect = uiSelect(head, { bare = true, width = 96, textStyle = "caption", textColor = "ink",
            options = {}, value = "current", minListWidth = 220, maxRows = 12, search = false,
            onChange = function(v: string | number)
                self.session = v
                self.drill = nil
                self:Refresh()
                if opts.onView then opts.onView(self.type, self.session) end
            end })
        self.sessionSelect:SetPoint("LEFT", self.typeSelect, "RIGHT", 0, 0)
        self.menu = MeterMenu.new(self)
        self.catcher = self.menu.catcher
        self.more = MeterHeadButton.new(head, dots, function() if self.menu:IsShown() then self.menu:Hide() else openMenu(self) end end, "Meter options")
        self.more:SetPoint("RIGHT", -S["space-2"], 0)
        self.time = text(head, "numeric", "ink-muted")
        self.time:SetPoint("RIGHT", self.more, "LEFT", -S["space-2"], 0)
        -- the drill head: back, who, what, total
        self.back = MeterHeadButton.new(head, backArrow, function() self.drill = nil; self:Refresh() end, "Back")
        self.back:SetPoint("LEFT", S["space-2"], 0)
        self.who = text(head, "unit-name-sm", "ink")
        self.who:SetShadowed(true)
        self.who:SetPoint("LEFT", self.back, "RIGHT", S["space-2"], 0)
        self.who:SetWidth(90)
        self.who:SetWordWrap(false)
        self.who:SetJustifyH("LEFT")
        self.what = text(head, "caption", "ink-muted")
        self.what:SetPoint("LEFT", self.who, "RIGHT", S["space-2"], 0)
        self.total = text(head, "numeric", "ink")
        self.total:SetFixedWidth(MAIN_W + 10)
        self.total:SetJustifyH("RIGHT")
        self.total:SetPoint("RIGHT", -S["space-3"], 0)
        local rule = self:CreateTexture(nil, "BORDER")
        draw.paintFill(rule, "gilt-faint")
        rule:SetPoint("TOPLEFT", 1, -HEAD)
        rule:SetPoint("TOPRIGHT", -1, -HEAD)
        rule:SetHeight(1)
        -- body
        self.body = CreateFrame("Frame", nil, self)
        self.body:SetPoint("TOPLEFT", 0, -HEAD - 1)
        self.body:SetPoint("BOTTOMRIGHT")
        self.pinLine = self.body:CreateTexture(nil, "ARTWORK")
        draw.paintFill(self.pinLine, "gilt-line")
        self.pinLine:SetHeight(1)
        self.pinLine:Hide()
        self.note = text(self.body, "caption", "ink-muted")
        self.note:SetPoint("BOTTOMLEFT", S["space-3"], S["space-3"])
        self.note:SetPoint("BOTTOMRIGHT", -S["space-3"], S["space-3"])
        self.note:SetJustifyH("LEFT")
        self.note:SetWordWrap(false)
        self.note:SetVisible(false)
        self.empty = text(self.body, "caption", "ink-muted")
        self.empty:SetPoint("LEFT", S["space-5"], 0)
        self.empty:SetPoint("RIGHT", -S["space-5"], 0)
        self.empty:SetJustifyH("CENTER")
        self.empty:SetWordWrap(true)
        self.empty:SetVisible(false)
        self:SetScript("OnHide", function() self.menu:Hide() end)
        extend.add(extend.Kind.Meter, self, { meter = "damage" })
    end

    -- The row `i` (made the first time).
    private function row(i: number): DamageRow
        local r = self.rows[i]
        if not r then
            r = DamageRow.new(self)
            self.rows[i] = r
        end
        return r
    end

    -- The fight select's options: Current (its time), Overall, the past fights
    -- newest first.
    function SessionOptions(): SelectOption<string | number>[]
        local api = self.api :: MeterApi
        local opts: SelectOption<string | number>[] = {
            { value = "current", label = "Current", note = clock(api.GetSessionDurationSeconds(Enum.DamageMeterSessionType.Current)) },
            { value = "overall", label = "Overall" },
        }
        local ok, list = pcall(api.GetAvailableCombatSessions)
        if ok and type(list) == "table" and #list > 0 then
            opts[#opts + 1] = { heading = "Past fights" }
            for i = #list, math.max(1, #list - 19), -1 do
                local s = list[i]
                local name = plainString(s.name) and s.name or "Combat"
                opts[#opts + 1] = { value = s.sessionID, label = name, note = clock(s.durationSeconds) }
            end
        end
        return opts
    end

    function SetView(typeValue: string?, session: MeterSession?)
        self.type = typeValue and BY_VALUE[typeValue] and typeValue or "damage"
        self.session = session or "current"
        self.drill = nil
        self.typeSelect:SetValue(self.type)
        self:Refresh()
    end

    function SetOptions(o: MeterViewChange)
        local v = self.view
        if o.numbers ~= nil then v.numbers = o.numbers end
        if o.barColor ~= nil then v.barColor = o.barColor end
        if o.marker ~= nil then v.marker = o.marker end
        if o.nameColor ~= nil then v.nameColor = o.nameColor end
        if o.pinYou ~= nil then v.pinYou = o.pinYou end
        self:Refresh()
    end

    function SetCanAddWindow(on: unknown) self.canAdd = on ~= nil and on ~= false end

    -- The rows the window keeps its height for (the Rows setting), live.
    function SetMaxRows(n: number?)
        self.maxRows = math.max(4, n or 8)
        local h, gap = draw.size("meter-row"), S["space-1"]
        self:SetHeight(HEAD + 1 + S["space-3"] * 2 + self.maxRows * h + (self.maxRows - 1) * gap)
        self:Refresh()
    end

    -- The row data of one source in the list.
    function SourceRow(src: DamageMeterCombatSourceSecret, i: number, top: number | Secret<number>,
                       total: (number | Secret<number>)?, fight: boolean): MeterRowData
        local v = self.view
        local typeValue = self.type
        local enemies, deaths = ENEMIES[typeValue], typeValue == "deaths"
        local you = not isSecret(src.isLocalPlayer) and src.isLocalPlayer == true
        local class: string? = plainString(src.classFilename) and src.classFilename or nil
        local d: MeterRowData = { rank = i, you = you and not enemies, plain = deaths }
        d.name = you and UnitName("player") or shortName(src.name)
        if enemies or not class then
            d.nameColor = "reaction-hostile"
        elseif v.nameColor ~= "ink" and v.barColor ~= "class" then
            d.nameColor = "class-" .. class:lower()
        end
        if not enemies then
            d.class = class
            d.mark = v.marker == "icon" and "class" or (v.marker == "diamond" and "diamond") or nil
        end
        if deaths then
            d.main = since(src.deathTimeSeconds)
            local recap = src.deathRecapID
            if readable(recap) and recap > 0 and self.recapApi then
                d.open = function() self.drill = { kind = "recap", src = src, row = d }; self:Refresh() end
            end
            return d
        end
        local ps = PER_SECOND[typeValue]
        local main = ps and src.amountPerSecond or src.totalAmount
        d.fill, d.fillMax = main, top
        d.fillClass = v.barColor == "class" and not enemies and class or nil
        if COUNTS[typeValue] then
            d.main = count(main)
        else
            d.main = abbr(main)
            if v.numbers ~= "minimal" then d.paren = abbr(ps and src.totalAmount or src.amountPerSecond) end
        end
        local amount = src.totalAmount
        if v.numbers == "complete" and not fight and readable(amount) and readable(total) and total > 0 then
            d.share = ("%d%%"):format(math.floor(amount / total * 100 + 0.5))
        end
        -- its breakdown: yours always, others' while their GUID is readable
        local guid = you and UnitGUID("player") or src.sourceGUID
        local creature = src.sourceCreatureID
        local openable = (you or plainString(guid)) and (enemies and readable(creature) or not enemies)
        if openable then
            d.open = function()
                self.drill = { kind = "spells", guid = guid, creature = (not isSecret(creature)) and creature or nil, row = d }
                self:Refresh()
            end
        else
            d.tip = "Details of other players are secret in combat."
        end
        return d
    end

    function ShowEmpty(line: string)
        for _, r in ipairs(self.rows) do r:Hide() end
        self.pinLine:Hide()
        self.note:SetVisible(false)
        self.empty:SetValue(line)
        self.empty:SetVisible(true)
    end

    function RefreshList()
        local v = self.view
        local typeValue = self.type
        local s = fetch(self.api, self.session, typeValue)
        local sources = s and s.combatSources
        local deaths = typeValue == "deaths"
        -- a list the game hides as a whole can't be read (its length errors)
        if isSecret(sources) then
            self:ShowEmpty("The list is secret until combat ends.")
            return
        end
        if not s or not sources or #sources == 0 then
            self:ShowEmpty(typeValue == "avoidable" and "No avoidable damage taken." or deaths and "No deaths. Well played."
                or "Nothing yet. The meter fills as the fight goes on.")
            return
        end
        self.empty:SetVisible(false)
        self.note:SetVisible(false)
        local list: DamageMeterCombatSourceSecret[] = {}
        for i = 1, #sources do list[i] = sources[i] end
        -- deaths come newest first: in the order they happened instead
        if deaths then
            local rev: DamageMeterCombatSourceSecret[] = {}
            for i = #list, 1, -1 do rev[#rev + 1] = list[i] end
            list = rev
        end
        local ps = PER_SECOND[typeValue]
        local top: number | Secret<number> = deaths and 1 or (ps and list[1].amountPerSecond or list[1].totalAmount)
        if readable(top) and top <= 0 then top = 1 end
        local fight = inCombat()
        local max = self.maxRows
        local youAt: number? = nil
        for i, src in ipairs(list) do
            if not isSecret(src.isLocalPlayer) and src.isLocalPlayer == true then youAt = i end
        end
        local pin = youAt ~= nil and youAt > max and v.pinYou ~= false and not NO_PIN[typeValue]
        local h, gap = draw.size("meter-row"), S["space-1"]
        for i = 1, max do
            local index = (pin and i == max) and (youAt :: number) or i
            local src = list[index]
            local r = self:row(i)
            if src then
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", self.body, "TOPLEFT", S["space-3"], -S["space-3"] - (i - 1) * (h + gap))
                r:Set(self:SourceRow(src, index, top, s.totalAmount, fight))
            else
                r:Hide()
            end
        end
        for i = max + 1, #self.rows do self.rows[i]:Hide() end
        self.pinLine:SetShown(pin)
        if pin then
            self.pinLine:ClearAllPoints()
            self.pinLine:SetPoint("BOTTOMLEFT", self.rows[max], "TOPLEFT", 0, gap / 2)
            self.pinLine:SetPoint("BOTTOMRIGHT", self.rows[max], "TOPRIGHT", 0, gap / 2)
        end
    end

    -- A source's spells.
    function RefreshSpells()
        local drill = self.drill :: MeterDrill -- (only drilled in)
        local typeValue = self.type
        local data = fetchSource(self.api :: MeterApi, self.session, typeValue, drill.guid, drill.creature)
        local spells = data and data.combatSpells
        self.pinLine:Hide()
        self.note:SetVisible(false)
        if not data or not spells or (not isSecret(spells) and #spells == 0) then
            self:ShowEmpty("No spells to show.")
            return
        end
        self.empty:SetVisible(false)
        local ps = PER_SECOND[typeValue]
        local top: number | Secret<number> = ps and spells[1].amountPerSecond or spells[1].totalAmount
        if readable(top) and top <= 0 then top = 1 end
        local total = data.totalAmount
        local fight = inCombat()
        local h, gap = draw.size("meter-row"), S["space-1"]
        for i = 1, self.maxRows do
            local sp = spells[i]
            local r = self:row(i)
            if sp then
                local main = ps and sp.amountPerSecond or sp.totalAmount
                local d: MeterRowData = { rank = i, mark = "spell", spellID = sp.spellID, textName = true, fill = main, fillMax = top }
                local okName, name = pcall(C_Spell.GetSpellName, sp.spellID)
                d.name = okName and name or "Unknown"
                if not isSecret(sp.spellID) and sp.spellID == 6603 then d.name = "Melee" end
                if plainString(sp.creatureName) then d.sub = sp.creatureName end
                if COUNTS[typeValue] then
                    d.main = count(main)
                else
                    d.main = abbr(main)
                    if self.view.numbers ~= "minimal" then d.paren = abbr(ps and sp.totalAmount or sp.amountPerSecond) end
                end
                local amount = sp.totalAmount
                if self.view.numbers == "complete" and not fight and readable(amount) and readable(total) and total > 0 then
                    d.share = ("%d%%"):format(math.floor(amount / total * 100 + 0.5))
                end
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", self.body, "TOPLEFT", S["space-3"], -S["space-3"] - (i - 1) * (h + gap))
                r:Set(d)
            else
                r:Hide()
            end
        end
        -- the head's total: the row's own value
        self.total:SetText(drill.row.main or "")
        self.total.value = nil
    end

    -- A death's last moments: oldest first, health after each hit as the bar.
    function RefreshRecap()
        local src = (self.drill :: MeterDrill).src :: DamageMeterCombatSourceSecret -- (only drilled in)
        local recapApi = self.recapApi :: RecapApi
        local id = src.deathRecapID
        local ok, given = pcall(recapApi.GetRecapEvents, id)
        self.pinLine:Hide()
        if ok and issecrettable and issecrettable(given) then
            self:ShowEmpty("The recap is secret until combat ends.")
            return
        end
        if not ok or type(given) ~= "table" or #given == 0 then
            self:ShowEmpty("No recap for this death.")
            return
        end
        local events = given :: RecapEvent[]
        self.empty:SetVisible(false)
        local okMax, max = pcall(recapApi.GetRecapMaxHealth, id)
        local maxHP = okMax and max or nil
        -- newest first: the last rows, oldest first
        local list: RecapEvent[] = {}
        for i = #events, 1, -1 do list[#list + 1] = events[i] end
        local slots = self.maxRows - 1
        local first = math.max(1, #list - slots + 1)
        local last = list[#list]
        local deathAt = last and last.timestamp
        local h, gap = draw.size("meter-row"), S["space-1"]
        local n = 0
        for i = first, #list do
            n = n + 1
            local ev = list[i]
            local r = self:row(n)
            local kind = plainString(ev.event) and ev.event or ""
            local heal = kind == "SPELL_HEAL" or kind == "SPELL_PERIODIC_HEAL"
            -- a heal: its name and amount in the healing colour
            local d: MeterRowData = { rankWide = true, mark = "spell", spellID = ev.spellId, textName = true, heal = heal,
                        nameColor = heal and "fel" or nil }
            local at = ev.timestamp
            if readable(deathAt) and readable(at) then
                local ago = deathAt - at
                d.rank = ago < 0.05 and "0s" or ("-%.1fs"):format(ago)
            end
            local spellName = ev.spellName
            if kind == "SWING_DAMAGE" then
                d.name = "Melee"
            elseif isSecret(spellName) or plainString(spellName) then
                d.name = spellName
            else
                d.name = "Unknown"
            end
            local amount = ev.amount
            if readable(amount) then
                d.main = (heal and "+" or "-") .. group3(math.floor(amount + 0.5))
            elseif isSecret(amount) then
                d.main = AbbreviateNumbers(amount)
            end
            local hp = ev.currentHP
            if maxHP and (issecretvalue(hp) or hp ~= nil) then
                d.fill, d.fillMax = hp, maxHP
                if readable(hp) and readable(maxHP) and maxHP > 0 then d.fillLow = hp / maxHP < 0.35 end
            end
            d.danger = i == #list
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", self.body, "TOPLEFT", S["space-3"], -S["space-3"] - (n - 1) * (h + gap))
            r:Set(d)
        end
        for i = n + 1, #self.rows do self.rows[i]:Hide() end
        -- the note in the last slot: the killing blow and when
        local noteText = "Bars show health after each hit."
        local overkill = last and last.overkill
        if last and readable(overkill) and overkill > 0 then
            local lastName = last.spellName
            local by = (plainString(last.event) and last.event == "SWING_DAMAGE") and "Melee"
                or (plainString(lastName) and lastName) or "?"
            noteText = ("Killed by %s, %s overkill."):format(by, group3(overkill))
        end
        self.note:SetValue(noteText)
        self.note:SetVisible(true)
    end

    function RefreshHead()
        local drill = self.drill
        self.typeSelect:SetShown(not drill)
        self.sessionSelect:SetShown(not drill)
        self.time:SetShown(not drill)
        self.back:SetShown(drill ~= nil)
        self.who:SetShown(drill ~= nil)
        self.what:SetShown(drill ~= nil)
        self.total:SetShown(drill ~= nil and drill.kind == "spells")
        if drill then
            local row = drill.row
            self.who:SetText(row.name or "")
            self.who.value = nil
            self.who:SetColor(row.nameColor or "ink")
            self.what:SetValue(drill.kind == "recap" and "Death recap" or (BY_VALUE[self.type] :: MeterType).label)
            return
        end
        -- the fight select (past fights change) and the time
        local opts = self:SessionOptions()
        -- only when the fights changed: this runs every second in combat, and
        -- rebuilding an open list dropped the hover on its rows
        local parts: string[] = {}
        for _, o in ipairs(opts) do parts[#parts + 1] = tostring(o.value) .. "=" .. tostring(o.label) end
        local sig = table.concat(parts, "|")
        local list = self.sessionSelect.list
        if sig ~= self.sessionSig or not (list and list:IsShown()) then
            self.sessionSig = sig
            self.sessionSelect:SetOptions(opts)
            self.sessionSelect:SetValue(self.session)
        end
        local time = ""
        if self.session == "current" then
            time = opts[1].note or ""
        elseif type(self.session) == "number" then
            for _, o in ipairs(opts) do if o.value == self.session then time = o.note or "" end end
        end
        self.time:SetValue(time)
    end

    function Refresh()
        local api = self.api
        if not api then return end
        -- a past fight that's gone: back to Current
        if type(self.session) == "number" then
            local found = false
            local ok, list = pcall(api.GetAvailableCombatSessions)
            if ok and type(list) == "table" then
                for _, s in ipairs(list) do if s.sessionID == self.session then found = true end end
            end
            if not found then self.session = "current" end
        end
        self:RefreshHead()
        local drill = self.drill
        if drill and drill.kind == "spells" then
            self:RefreshSpells()
        elseif drill and drill.kind == "recap" then
            self:RefreshRecap()
        else
            self:RefreshList()
        end
    end
end
mixins.DamageMeter = DamageMeter

export function damageMeter(parent: Frame, options: DamageMeterOptions?): DamageMeter
    return DamageMeter.new(parent, options)
end

export const DAMAGE_METER_TYPES: MeterType[] = TYPES
