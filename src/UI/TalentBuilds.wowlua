-- UI/TalentBuilds.wowlua
-- Talent builds' pieces that draw nothing (step 3.2e): whether an order of
-- points is one the game allows, SuuUI's share text and the game's own
-- talent string. They take a tree as the Talents module reads it:
--
--   tree = { treeID,
--       order = { nodeID, … },     -- C_Traits.GetTreeNodes' order (the game's string)
--       byID = { [nodeID] = { id, max, row, col, treeIndex, name, treeName,
--                             requires = { nodeID, … },   -- the arrows into it
--                             requiresAll = false,        -- every one (else any one)
--                             choice = false, entryIDs } } }
--   steps = { { node = nodeID, entry = entryID? }, … }    -- one rank each, in order
--
--   talentOrderCheck(steps, tree) -> true, or false, the step, why
--   talentNextProblem(steps, tree, nodeID) -> nil, or why one more rank
--       of it can't come next
--   talentStepProblem(tree, node, count, spent) -> nil, or why one more
--       rank can't come with `count` ranks ({ [nodeID] = n }) and `spent` points
--   talentStepsFromRanks(ranks, tree) -> steps, allPlaced
--       ranks = { [nodeID] = n }: the game's string has no order, so the
--       points go top to bottom, left to right, as the rows and arrows allow
--   encodeTalentBuild({ name, classID, treeID, steps }, entryIndex) -> "SuuUI:T1:…"
--   decodeTalentBuild(text) -> { name, classID, treeID, steps = { { node, entryIndex } } }
--       or nil and why
--   readGameTalentHeader(text) -> version, specID, hash (16 bytes), or nil
--   readGameTalentString(text, tree) -> { version, specID, hash,
--       ranks = { [nodeID] = n }, entries = { [nodeID] = index } }, or nil and why
--   writeGameTalentString(version, specID, hash, tree, ranks, entries) -> text
--
-- Forever's rows open by points spent in the whole tree: 5 a row
-- (TALENT_ROW_POINTS; /suu probe talentbuilds, every class), and a talent an
-- arrow points to needs the talent it starts from at full rank.

import * as serialize from "/Core/Serialize"

--- A talent as the Talents module reads it (more fields may come along).
export type TalentNode = {
    id: number,
    max?: number,
    row?: number,
    col?: number,
    treeIndex?: number,
    name?: string,
    treeName?: string,
    requires?: number[],
    requiresAll?: boolean,
    choice?: boolean,
    entryIDs?: number[],
    -- its icon, and its entry (a choice's chosen one)
    icon?: number | string,
    entryID?: number,
    [string]: unknown,
}
--- A class's tree: its nodes by ID, in the game's order.
export type TalentTreeData = { treeID?: number, order?: number[], byID: { [number]: TalentNode }, [string]: unknown }
--- One rank of a talent in a build's order.
export type TalentStep = { node: number, entry?: number, [string]: unknown }
--- A build to share: its name, class, tree and steps.
export type TalentBuildShare = { name?: string, classID?: number, treeID?: number, steps?: TalentStep[] }
--- A decoded share text's step: the node and its entry's index (a choice).
export type DecodedStep = { node: number, entryIndex?: number }
export type DecodedBuild = { name: string, classID: number, treeID: number, steps: DecodedStep[] }
export type GameTalents = {
    version: number,
    specID: number,
    hash: number[],
    ranks: { [number]: number },
    entries: { [number]: number },
}

export const TALENT_ROW_POINTS = 5
export const TALENT_MAX_POINTS = 51 -- at level 60 (the game's currency, every class)

local function plural(n: number, one: string, many: string): string
    return n == 1 and one or many
end

--------------------------------------------------------------------------------
-- The order check
--------------------------------------------------------------------------------

-- Whether one more rank of `n` can come after `count` (ranks so far) with
-- `spent` points before it. Nil, or why not (the step number in the text).
local function stepProblem(
    tree: TalentTreeData,
    n: TalentNode,
    count: { [number]: number },
    spent: number,
    step: number
): string?
    local have = count[n.id] or 0
    if have >= (n.max or 1) then
        return ("%s has only %d %s; step %d would be rank %d."):format(
            n.name or "?",
            n.max or 1,
            plural(n.max or 1, "rank", "ranks"),
            step,
            have + 1
        )
    end
    local need = (n.row or 0) * TALENT_ROW_POINTS
    if spent < need then
        return ("%s needs %d points spent before it; at step %d only %d %s."):format(
            n.name or "?",
            need,
            step,
            spent,
            plural(spent, "is", "are")
        )
    end
    local requires = n.requires
    if requires and #requires > 0 then
        local met, missing = n.requiresAll, nil :: TalentNode?
        for _, id in ipairs(requires) do
            local p = tree.byID[id]
            local full = p and (count[id] or 0) >= (p.max or 1)
            if n.requiresAll then
                if not full then
                    met = false
                    missing = missing or p
                end
            elseif full then
                met = true
            else
                missing = missing or p
            end
        end
        if not met and missing then
            return ("%s needs %s at %d/%d before it; at step %d it has %d."):format(
                n.name or "?",
                missing.name or "?",
                missing.max or 1,
                missing.max or 1,
                step,
                count[missing.id] or 0
            )
        end
    end
    return nil
end

-- One more rank of node `n` with `count` ranks so far ({ [nodeID] = n })
-- and `spent` points before it: nil, or why not.
export function talentStepProblem(
    tree: TalentTreeData,
    n: TalentNode,
    count: { [number]: number },
    spent: number
): string?
    return stepProblem(tree, n, count, spent, spent + 1)
end

export function talentOrderCheck(steps: TalentStep[], tree: TalentTreeData): (boolean, number?, string?)
    if #steps > TALENT_MAX_POINTS then
        return false, TALENT_MAX_POINTS + 1, ("A build holds %d points at most."):format(TALENT_MAX_POINTS)
    end
    local count: { [number]: number } = {}
    for i, s in ipairs(steps) do
        local n = tree.byID[s.node]
        if not n then
            return false, i, ("Step %d isn't a talent of this tree any more."):format(i)
        end
        local why = stepProblem(tree, n, count, i - 1, i)
        if why then
            return false, i, why
        end
        count[n.id] = (count[n.id] or 0) + 1
    end
    return true
end

-- Why one more rank of a node can't come next (nil: it can).
export function talentNextProblem(steps: TalentStep[], tree: TalentTreeData, nodeID: number): string?
    if #steps >= TALENT_MAX_POINTS then
        return ("A build holds %d points at most."):format(TALENT_MAX_POINTS)
    end
    local n = tree.byID[nodeID]
    if not n then
        return "Not a talent of this tree."
    end
    local count: { [number]: number } = {}
    for _, s in ipairs(steps) do
        count[s.node] = (count[s.node] or 0) + 1
    end
    return stepProblem(tree, n, count, #steps, #steps + 1)
end

-- Ranks without an order: placed top to bottom, left to right, as the
-- rows and arrows allow; a talent's ranks one after another.
export function talentStepsFromRanks(
    ranks: { [number]: number },
    tree: TalentTreeData,
    entries: { [number]: number }?
): (TalentStep[], boolean)
    local left: { [number]: number } = {}
    local list: TalentNode[] = {}
    for id, r in pairs(ranks) do
        local n = tree.byID[id]
        if n and r > 0 then
            left[id] = math.min(r, n.max or r)
            list[#list + 1] = n
        end
    end
    table.sort(list, function(a: TalentNode, b: TalentNode): boolean
        if (a.row or 0) ~= (b.row or 0) then
            return (a.row or 0) < (b.row or 0)
        end
        if (a.treeIndex or 0) ~= (b.treeIndex or 0) then
            return (a.treeIndex or 0) < (b.treeIndex or 0)
        end
        if (a.col or 0) ~= (b.col or 0) then
            return (a.col or 0) < (b.col or 0)
        end
        return a.id < b.id
    end)
    local steps: TalentStep[] = {}
    local count: { [number]: number } = {}
    local all = true
    local function place(n: TalentNode)
        while (left[n.id] or 0) > 0 and #steps < TALENT_MAX_POINTS do
            steps[#steps + 1] = { node = n.id, entry = entries and entries[n.id] or nil }
            count[n.id] = (count[n.id] or 0) + 1
            left[n.id] = (left[n.id] or 0) - 1
        end
    end
    local progress = true
    -- (a full build ends it: a talent that could take a point but had ranks
    -- over the cap left was otherwise "placed" again and again, for ever)
    while progress and #steps < TALENT_MAX_POINTS do
        progress = false
        for _, n in ipairs(list) do
            if (left[n.id] or 0) > 0 and not stepProblem(tree, n, count, #steps, #steps + 1) then
                place(n)
                progress = true
                break
            end
        end
    end
    -- what the rows and arrows never allowed: after the rest, as it came
    for _, n in ipairs(list) do
        if (left[n.id] or 0) > 0 then
            all = false
            place(n)
        end
    end
    return steps, all
end

--------------------------------------------------------------------------------
-- SuuUI's share text: "SuuUI:T1:" and base64 of the class (1 byte), the
-- tree (2), the name's length (1) and its UTF-8 (48 at most), the steps'
-- count (1), the lowest node ID among them (3), each step as its node's
-- offset from that (2; the high bit: a choice, its entry's index follows in
-- 1 byte), then a Fletcher-16 of all that (2).
--------------------------------------------------------------------------------

local PREFIX = "SuuUI:T1:"
local NAME_MAX = 48

local function u16(n: number): string
    return string.char(math.floor(n / 256) % 256, n % 256)
end
local function u24(n: number): string
    return string.char(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
end

-- Cut to `max` bytes without splitting a character.
local function cutUTF8(s: string, max: number): string
    if #s <= max then
        return s
    end
    local i = max
    -- back off continuation bytes (10xxxxxx) and the lead byte they follow
    while i > 0 do
        local c = s:byte(i + 1)
        if not (c and c >= 128 and c < 192) then
            break
        end
        i = i - 1
    end
    return s:sub(1, i)
end

export function encodeTalentBuild(b: TalentBuildShare, entryIndex: ((s: TalentStep) -> number?)?): (string?, string?)
    local name = cutUTF8(b.name or "", NAME_MAX)
    local steps: TalentStep[] = b.steps or {}
    local base: number? = nil
    for _, s in ipairs(steps) do
        base = math.min(base or s.node, s.node)
    end
    local low = base or 0
    local out: string[] = {
        string.char((b.classID or 0) % 256),
        u16(b.treeID or 0),
        string.char(#name),
        name,
        string.char(#steps),
        u24(low),
    }
    for _, s in ipairs(steps) do
        local index = entryIndex and s.entry and entryIndex(s)
        local offset = s.node - low
        if offset >= 32768 then
            return nil, "These talents are too far apart to share."
        end
        if index then
            out[#out + 1] = u16(offset + 32768) .. string.char(index % 256)
        else
            out[#out + 1] = u16(offset)
        end
    end
    local payload = table.concat(out)
    return PREFIX .. serialize.base64(payload .. u16(serialize.fletcher16(payload)))
end

export function decodeTalentBuild(input: string?): (DecodedBuild?, string?)
    local text = (input or ""):gsub("%s", "")
    if text:sub(1, #PREFIX) ~= PREFIX then
        return nil, "This isn't a SuuUI talent build."
    end
    local raw = serialize.fromBase64(text:sub(#PREFIX + 1))
    if not raw or #raw < 10 then
        return nil, "The text is incomplete; copy all of it."
    end
    local payload, sum = raw:sub(1, -3), raw:sub(-2)
    if u16(serialize.fletcher16(payload)) ~= sum then
        return nil, "The text is damaged or incomplete; copy all of it."
    end
    local pos = 1
    local function byte(): number?
        local v = payload:byte(pos)
        pos = pos + 1
        return v
    end
    local classID = byte()
    local hi, lo = byte(), byte()
    local treeID = hi and lo and hi * 256 + lo
    local len = byte()
    if not (classID and treeID and len) then
        return nil, "The text is damaged."
    end
    local name = payload:sub(pos, pos + len - 1)
    pos = pos + len
    local count = byte()
    local b1, b2, b3 = byte(), byte(), byte()
    if not (count and b1 and b2 and b3) then
        return nil, "The text is damaged."
    end
    local base = b1 * 65536 + b2 * 256 + b3
    local steps: DecodedStep[] = {}
    for i = 1, count do
        local h, l = byte(), byte()
        if not (h and l) then
            return nil, "The text is damaged."
        end
        local v = h * 256 + l
        local entryIndex: number? = nil
        if v >= 32768 then
            v = v - 32768
            entryIndex = byte()
            if not entryIndex then
                return nil, "The text is damaged."
            end
        end
        steps[i] = { entryIndex = entryIndex, node = base + v }
    end
    if pos ~= #payload + 1 then
        return nil, "The text has extra data at the end."
    end
    return { name = name, classID = classID, treeID = treeID, steps = steps }
end

--------------------------------------------------------------------------------
-- The game's talent string (its published format, serialization 2): base64
-- with 6 bits a character, each value's low bits first. A header (version 8
-- bits, spec 16, the tree's hash 16 × 8), then each node of the tree in
-- C_Traits.GetTreeNodes' order: selected (1); if so purchased (1); if so
-- partly ranked (1) and then its ranks (6), and a choice (1) and then the
-- entry's index (2, from 0).
--------------------------------------------------------------------------------

local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local INDEX: { [string]: number } = {}
for i = 1, 64 do
    INDEX[CHARS:sub(i, i)] = i - 1
end

-- Reads a share text's bits, 6 to a character, lowest first.
class Reader
    -- the bits read
    at: number = 0

    constructor(private readonly values: number[]) end

    -- the bits left
    function bits(): number
        return #self.values * 6 - self.at
    end

    function take(width: number): number?
        local value, shift = 0, 1
        for _ = 1, width do
            local c = self.values[math.floor(self.at / 6) + 1]
            if not c then
                return nil
            end
            local b = math.floor(c / 2 ^ (self.at % 6)) % 2
            value = value + b * shift
            shift = shift * 2
            self.at = self.at + 1
        end
        return value
    end
end

local function reader(text: string): Reader?
    local values: number[] = {}
    for i = 1, #text do
        local v = INDEX[text:sub(i, i)]
        if not v then
            return nil
        end
        values[i] = v
    end
    return Reader.new(values)
end

-- Writes a share text's bits, 6 to a character, lowest first.
class Writer
    out: string[] = {}
    cur: number = 0
    used: number = 0

    function put(width: number, value: number)
        for _ = 1, width do
            local b = value % 2
            value = math.floor(value / 2)
            self.cur = self.cur + b * 2 ^ self.used
            self.used = self.used + 1
            if self.used == 6 then
                self.out[#self.out + 1] = CHARS:sub(self.cur + 1, self.cur + 1)
                self.cur, self.used = 0, 0
            end
        end
    end

    function text(): string
        if self.used > 0 then
            return table.concat(self.out) .. CHARS:sub(self.cur + 1, self.cur + 1)
        end
        return table.concat(self.out)
    end
end

local function writer(): Writer
    return Writer.new()
end

local function header(r: Reader?): (number?, number?, number[]?)
    if not r or r:bits() < 8 + 16 + 128 then
        return nil, nil, nil
    end
    local version, specID = r:take(8), r:take(16)
    local hash: number[] = {}
    for i = 1, 16 do
        hash[i] = r:take(8) :: number
    end
    return version, specID, hash
end

export function readGameTalentHeader(text: string?): (number?, number?, number[]?)
    return header(reader(((text or ""):gsub("%s", ""))))
end

export function readGameTalentString(input: string?, tree: TalentTreeData): (GameTalents?, string?)
    local text = (input or ""):gsub("%s", "")
    local r = reader(text)
    local version, specID, hash = header(r)
    if not (version and specID and hash and r) then
        return nil, "This isn't a talent string."
    end
    local ranks: { [number]: number } = {}
    local entries: { [number]: number } = {}
    for _, id in ipairs(tree.order or {}) do
        local selected = r:take(1)
        if selected == nil then
            return nil, "The string is incomplete; copy all of it."
        end
        if selected == 1 then
            local purchased = r:take(1)
            if purchased == 1 then
                local partial = r:take(1)
                local n: number? = nil
                if partial == 1 then
                    n = r:take(6)
                end
                local choice = r:take(1)
                local index: number? = nil
                if choice == 1 then
                    index = r:take(2)
                end
                if partial == nil or choice == nil or (partial == 1 and n == nil) or (choice == 1 and index == nil) then
                    return nil, "The string is incomplete; copy all of it."
                end
                local node = tree.byID[id]
                if not n then
                    if not node then
                        return nil, "The string doesn't match this class's talents."
                    end
                    n = node.max or 1
                end
                ranks[id] = n
                if index then
                    entries[id] = index + 1
                end
            elseif purchased == nil then
                return nil, "The string is incomplete; copy all of it."
            end
        end
    end
    return { version = version, specID = specID, hash = hash, ranks = ranks, entries = entries }
end

export function writeGameTalentString(
    version: number?,
    specID: number?,
    hash: number[]?,
    tree: TalentTreeData,
    ranks: { [number]: number },
    entries: { [number]: number }?
): string
    local w = writer()
    w:put(8, version or 0)
    w:put(16, specID or 0)
    for i = 1, 16 do
        w:put(8, hash and hash[i] or 0)
    end
    for _, id in ipairs(tree.order or {}) do
        local r = ranks[id] or 0
        local node = tree.byID[id]
        if r > 0 and node then
            w:put(1, 1)
            w:put(1, 1)
            local partial = r ~= (node.max or 1)
            w:put(1, partial and 1 or 0)
            if partial then
                w:put(6, r)
            end
            local index: number? = nil
            if node.choice and entries then
                index = entries[id]
            end
            w:put(1, index and 1 or 0)
            if index then
                w:put(2, index - 1)
            end
        else
            w:put(1, 0)
        end
    end
    return w:text()
end
