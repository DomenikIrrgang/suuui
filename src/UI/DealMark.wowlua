-- UI/DealMark.wowlua
-- A deal's mark (design board "Ledger": .suu-led__deal): a word or two on
-- something you can act on, so arcane: micro text in arcane on arcane-soft,
-- a 1px arcane edge, space-2 either side. "26% under", "Under vendor".
--
--   local mark = dealMark(parent, "26% under")
--   mark:SetValue("Under vendor")   -- sized to its text again
--
-- Sized to its text (again when a theme changes the micro style or the
-- spacing); place it by a point.

import tokens as T from "/Core/Tokens"
import * as draw from "./Draw"
import text, Text from "./Text"

local S = T.space

export class DealMark extends Frame
    readonly label: Text
    readonly bg: Texture
    readonly edge: draw.Border
    value: string = ""

    constructor(parent: Frame, value: string?)
        super(nil, parent)
        self.bg = draw.fill(self, "arcane-soft")
        self.bg:SetAllPoints()
        self.edge = draw.border(self, "arcane")
        self.label = text(self, "micro", "arcane")
        self.label:SetPoint("CENTER", 0, 0)
        self.label:SetWordWrap(false)
        self:SetValue(value or "")
        draw.layout(self, function()
            self:Fit()
        end)
    end

    function SetValue(value: string)
        self.value = value
        self.label:SetValue(value)
        self:Fit()
    end

    -- its size from the text: the micro line and a pixel's edge above and
    -- below, space-2 either side
    function Fit()
        local w = self.label:GetUnboundedStringWidth()
        self:SetSize(math.max(1, math.ceil(w) + S["space-2"] * 2 + 2), T.type.micro.lineHeight + 4)
    end
end

export function dealMark(parent: Frame, value: string?): DealMark
    return DealMark.new(parent, value)
end
