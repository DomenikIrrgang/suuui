-- UI/WindowSkin.wowlua
-- One of Blizzard's windows in SuuUI's WindowFrame look (design board
-- "Window frame"), restyled in place: its clicks, tabs and panes stay
-- Blizzard's. The header grows above the window: the gilt diamond at the top
-- left, the icon and title in `header` gilt-text, the key chip, the close
-- button (Blizzard's own, with SuuUI's cross), then the tab row: the window's
-- own tab buttons as text tabs (ink-muted, gilt-text with a gilt hairline and
-- diamond when selected), over a gilt-faint rule. surface-glass under a
-- gilt-line edge behind it all.
--
--   local chrome = skinWindow(frame, {
--       title = "Character", icon = "person", binding = "TOGGLECHARACTER0",
--       close = CharacterFrameCloseButton,
--       hide = { frame.NineSlice, frame.PortraitContainer, … },  -- alpha 0
--       topInset = 20,   -- the window's own strip above its content, kept
--       headExtra = 0,   -- px more for the header's second row (the world
--                        -- map's search row); the header grows down
--       under = "microMenu", -- an anchor name: the window opens lined up
--                            -- under it (its left edge, space-5 below), and
--                            -- goes back there when Blizzard places it
--   })
--   chrome:SetTabs({ { button = tab, label = "Character", short = "Char",
--                      selected = function() … end,
--                      disabled = function() … end, reason = "…" }, … })   -- in order
--   (a disabled tab: ink-faint at opacity-disabled, a cover takes its click
--   and its tooltip says the reason; 0.17)
--   (`hidden = function() … end`: while it returns true the tab is out of
--   the row, its button hidden, and the others close up; chrome:LayoutTabs()
--   after what it depends on changed)
--   chrome:UpdateTabs()   -- after the window switched tab
--
-- Where it lives: the chrome (art, header, tabs) in UI/WindowSkin/Chrome;
-- the window row under an anchor and the middle of the screen
-- (centerWindow) in UI/WindowSkin/Row; the secure placement of protected
-- windows (securePlacement, 0.18) in UI/WindowSkin/SecurePlacement. This
-- file is what the rest of SuuUI imports: it re-exports all three.

import * as chrome from "/UI/WindowSkin/Chrome"
import * as row from "/UI/WindowSkin/Row"
import * as placement from "/UI/WindowSkin/SecurePlacement"

export type WindowSkinOptions = chrome.WindowSkinOptions
export type SkinTab = chrome.SkinTab
export const chromeOf = chrome.chromeOf
export const isCoveredByWindow = chrome.isCoveredByWindow
export const WindowChrome = chrome.WindowChrome
export type WindowChrome = chrome.WindowChrome
export const skinWindow = chrome.skinWindow
export const WINDOW_HEAD_H = chrome.WINDOW_HEAD_H

export const windowRow = row.windowRow
export const layout = row.layout
export const queue = row.queue
export const centerWindow = row.centerWindow
export const add = row.add

export type PlacementOptions = placement.PlacementOptions
export const SecurePlacer = placement.SecurePlacer
export type SecurePlacer = placement.SecurePlacer
export const securePlacement = placement.securePlacement
