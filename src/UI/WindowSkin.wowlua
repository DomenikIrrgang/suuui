-- UI/WindowSkin.wowlua
-- One of Blizzard's windows in SuuUI's WindowFrame look (design board
-- "Window frame"), restyled in place: its clicks, tabs and panes stay
-- Blizzard's. The header grows above the window: the gilt diamond at the top
-- left, the icon and title in `header` gilt-text, the key chip, the close
-- button (Blizzard's own, with SuuUI's cross), then the tab row: the window's
-- own tab buttons as text tabs (ink-muted, gilt-text with a gilt hairline and
-- diamond when selected), over a gilt-faint rule. surface-glass under a
-- gilt-line edge behind it all.
--
--   local chrome = skinWindow(frame, {
--       title = "Character", icon = "person", binding = "TOGGLECHARACTER0",
--       close = CharacterFrameCloseButton,
--       hide = { frame.NineSlice, frame.PortraitContainer, … },  -- alpha 0
--       topInset = 20,   -- the window's own strip above its content, kept
--       headExtra = 0,   -- px more for the header's second row (the world
--                        -- map's search row); the header grows down
--       under = "microMenu", -- an anchor name: the window opens lined up
--                            -- under it (its left edge, space-5 below), and
--                            -- goes back there when Blizzard places it
--   })
--   chrome:SetTabs({ { button = tab, label = "Character", short = "Char",
--                      selected = function() … end,
--                      disabled = function() … end, reason = "…" }, … })   -- in order
--   (a disabled tab: ink-faint at opacity-disabled, a cover takes its click
--   and its tooltip says the reason; 0.17)
--   chrome:UpdateTabs()   -- after the window switched tab

import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as anchors from "/Core/Anchors"
import * as events from "/Core/Events"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import text, measureText, Text from "/UI/Text"
import keyChip, KeyChip from "/UI/Panel"
import tabMarker, TabMarker from "/UI/TabMarker"
import markOwn, asRegion from "/UI/Reskin"
import showTooltip, hideTooltip from "/UI/Tooltip"

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
-- From the header style's line height, which a theme can change: worked
-- out when used (Chrome:PlaceHead lays a header out again then).
local function tabH(): number
    return S["space-2"] + T.type.header.lineHeight + S["space-3"]
end
local function headH(): number
    return S["space-5"] + T.type.header.lineHeight + S["space-3"] + tabH() -- the title line, then the tabs
end
local HEAD_H = headH() -- (WINDOW_HEAD_H: the design's)

-- What skinWindow takes (see the header).
export type WindowSkinOptions = {
    title?: string,
    icon?: string,
    binding?: string,
    close?: Button,
    hide?: { [number]: unknown },
    topInset?: number,
    headExtra?: number,
    under?: string,
}

-- A tab of the window's (chrome:SetTabs).
export type SkinTab = {
    button: Button,
    label: string,
    short?: string,
    selected?: () -> unknown,
    disabled?: () -> unknown,
    reason?: string,
    selectedTexture?: Region,
}

local function hideRegions(f: Frame)
    for _, r in ipairs({ f:GetRegions() }) do r:SetAlpha(0) end
end

-- A Blizzard tab button as a SuuUI text tab: its label, hover and the cover
-- that takes its click while it's disabled.
class TabSkin
    readonly label: Text
    readonly cover: Frame
    hover: boolean = false
    def: SkinTab? = nil

    constructor(chrome: WindowChrome, def: SkinTab)
        local b = def.button
        hideRegions(b)
        self.label = text(b, "header", "ink-muted")
        self.label:SetPoint("CENTER", 0, (S["space-3"] - S["space-2"]) / 2)
        self.label:SetShadowColor(0, 0, 0, 0.9)
        self.label:SetShadowOffset(0, -1)
        hookScript(b, "OnEnter", function() self.hover = true; chrome:UpdateTabs() end)
        hookScript(b, "OnLeave", function() self.hover = false; chrome:UpdateTabs() end)
        -- while disabled: a cover of SuuUI's takes the click and says why
        local cover = CreateFrame("Frame", nil, b)
        self.cover = cover
        cover:SetAllPoints()
        cover:SetFrameLevel(b:GetFrameLevel() + 5)
        cover:EnableMouse(true)
        cover:SetScript("OnEnter", function()
            local d = self.def
            showTooltip(cover, { title = d and d.label, description = d and d.reason })
        end)
        cover:SetScript("OnLeave", function() hideTooltip() end)
        cover:Hide()
        -- Blizzard lays its tabs out again now and then: back in the row
        hook(b, "SetPoint", function()
            if chrome.placing then return end
            after(0, function() chrome:LayoutTabs() end)
        end)
        -- the selected look follows Blizzard's own selected texture (or the
        -- texture the def names: a tab system's LeftActive)
        local sel = def.selectedTexture or asRegion((b :: { [string]: unknown }).SelectedTexture)
            or asRegion((b :: { [string]: unknown }).LeftActive)
        if sel then
            for _, m in ipairs({ "Show", "Hide", "SetShown" }) do
                hook(sel, m, function() chrome:UpdateTabs() end)
            end
        end
    end
end

-- the tab buttons skinned, by button
local tabSkins: { [Button]: TabSkin } = setmetatable({}, { __mode = "k" })

local function skinTab(chrome: WindowChrome, def: SkinTab): TabSkin
    local made = tabSkins[def.button]
    if made then return made end
    local t = TabSkin.new(chrome, def)
    tabSkins[def.button] = t
    return t
end

-- Whether the row takes the short labels, and the gap between the tabs, for
-- `room` px: the full labels space-5 apart, else space-4 apart, else the
-- short ones (space-4 apart).
local function fitTabs<D extends { label: string, short?: string }>(tabs: D[], room: number): (boolean, number)
    local function width(short: boolean, gap: number): number
        local w = 0
        for i, def in ipairs(tabs) do
            local label = (short and def.short) or def.label
            w = w + measureText("header", label) + (i > 1 and gap or 0)
        end
        return w
    end
    local short, gap = false, S["space-5"]
    if width(false, gap) > room then
        gap = S["space-4"]
        if width(false, gap) > room then short = true end
    end
    return short, gap
end

local allChromes: WindowChrome[] = {}
-- the chrome of each skinned window
local chromes: { [Frame]: WindowChrome } = setmetatable({}, { __mode = "k" })

-- A skinned window's chrome (nil: not skinned).
export function chromeOf(frame: Frame?): WindowChrome?
    return frame and chromes[frame] or nil
end

local function plain(v: unknown): v is number return v ~= nil and not (issecretvalue and issecretvalue(v)) end

-- Whether an open window (one in SuuUI's look, its header included) covers
-- part of `frame`: notes under it hide (asked for in game: the windows'
-- glass let them show through). Edges secret in combat count as not.
export function isCoveredByWindow(frame: Region): boolean
    local l, r, t, b = frame:GetLeft(), frame:GetRight(), frame:GetTop(), frame:GetBottom()
    if not (plain(l) and plain(r) and plain(t) and plain(b)) then return false end
    local fs = frame:GetEffectiveScale()
    l, r, t, b = l * fs, r * fs, t * fs, b * fs
    for _, c in ipairs(allChromes) do
        local w = c.frame
        if w:IsVisible() then
            local wl, wr, wt, wb = w:GetLeft(), w:GetRight(), w:GetTop(), w:GetBottom()
            if plain(wl) and plain(wr) and plain(wt) and plain(wb) then
                local ws = w:GetEffectiveScale()
                wl, wr, wb = wl * ws, wr * ws, wb * ws
                wt = (wt + (c.riseH or 0)) * ws
                if l < wr and r > wl and b < wt and t > wb then return true end
            end
        end
    end
    return false
end

export class WindowChrome
    frame: Frame
    protected: boolean
    inset: number
    headExtra: number
    rowMid: number
    bg: Texture
    edgeHolder: Frame
    edge: draw.Border
    head: Frame
    jewel: Texture
    icon: Texture? = nil
    titleX: number
    title: Text
    close: Button? = nil
    key: KeyChip? = nil
    keyRight: number = 0
    rule: Texture
    headAfterCombat: boolean? = nil
    layoutAfterCombat: boolean? = nil
    under: string? = nil
    tabs: SkinTab[]? = nil
    tabMarker: TabMarker? = nil
    placing: boolean? = nil
    riseH: number? = nil
    rise: number = 0
    -- when it opened, for the row of windows under an anchor
    openedAt: number? = nil
    -- in the middle of the screen (centerWindow), out of the row
    centered: boolean? = nil
    -- a protected one to place once the fight ends
    placeAfterCombat: boolean? = nil
    -- its secure placer (securePlacement)
    placer: SecurePlacer? = nil
    -- what a module adds to a window it skins (Units/Windows): the guild
    -- window's own tabs, the group finder's settings gear, the map's status
    logTab: Button? = nil
    settingsTab: Button? = nil
    gear: Button? = nil
    status: Frame? = nil

    constructor(frame: Frame, opts: WindowSkinOptions?)
        local o = opts or {}
        self.frame = frame
        chromes[frame] = self
        allChromes[#allChromes + 1] = self
        self.protected = frame:IsProtected() == true
        -- above the HUD (unit frames, bars): a window in the middle of the
        -- screen sat under the player frame (found in game); the bags and the
        -- loot window are on HIGH too. Skinned out of combat (protected ones).
        if not (self.protected and InCombatLockdown()) and frame:GetFrameStrata() ~= "HIGH" then
            frame:SetFrameStrata("HIGH")
        end
        -- in front when it opens or is clicked, as SuuUI's own windows: the
        -- character window came up behind the merchant's, its gear out of the
        -- repair cursor's reach (found in game, 2026-10-19)
        if not (self.protected and InCombatLockdown()) then frame:SetToplevel(true) end
        hookScript(frame, "OnShow", function()
            if not (self.protected and InCombatLockdown()) then frame:Raise() end
        end)
        for _, f in pairs(o.hide or {}) do
            local r = asRegion(f)
            if r then r:SetAlpha(0) end
        end
        self.inset, self.headExtra = o.topInset or 0, o.headExtra or 0
        -- the line the second row's 22px controls sit centred on, up from the
        -- header's bottom (in the middle of headExtra)
        self.rowMid = S["space-1"] + 11 + self.headExtra / 2

        -- the art, on the window itself (behind every pane)
        local bg = frame:CreateTexture(nil, "BACKGROUND", nil, -8)
        draw.paintFill(bg, "surface-glass")
        bg:SetPoint("BOTTOMRIGHT")
        self.bg = bg
        local edgeHolder = CreateFrame("Frame", nil, frame)
        edgeHolder:SetPoint("BOTTOMRIGHT")
        edgeHolder:SetFrameLevel(frame:GetFrameLevel() + 499)
        edgeHolder:EnableMouse(false)
        markOwn(edgeHolder)
        self.edgeHolder = edgeHolder
        self.edge = draw.border(edgeHolder, "gilt-line")

        -- the header: diamond, icon, title, key, close; the tab row under it
        -- (placed by PlaceHead)
        local head = CreateFrame("Frame", nil, frame)
        head:SetFrameLevel(frame:GetFrameLevel() + 500)
        markOwn(head)
        self.head = head
        self.jewel = draw.diamond(head, 7, "gilt")
        self.jewel:SetPoint("CENTER", head, "TOPLEFT", 0, 0)
        local x = S["space-5"]
        if o.icon then
            local icon = head:CreateTexture(nil, "ARTWORK")
            icon:SetTexture(GLYPHS .. o.icon .. ".tga")
            icon:SetSize(15, 15)
            draw.paint(icon, "gilt-text")
            self.icon = icon
            x = x + 15 + S["space-4"]
        end
        self.titleX = x
        self.title = text(head, "header", "gilt-text")
        self.title:SetValue(o.title or "")
        -- close: Blizzard's button (its click closes the window as always), SuuUI's cross
        local close = o.close
        local right = S["space-5"]
        if close then
            hideRegions(close)
            close:SetSize(22, 22)
            close:ClearAllPoints()
            close:SetFrameLevel(head:GetFrameLevel() + 3)
            local border = draw.border(close, "gilt-line")
            border:SetShown(false)
            local cross = draw.cross(close, 10, "ink-muted")
            cross:SetPoint("CENTER")
            hookScript(close, "OnEnter", function() border:SetShown(true); cross:SetColor("ink") end)
            hookScript(close, "OnLeave", function() border:SetShown(false); cross:SetColor("ink-muted") end)
            self.close = close
            right = right + 22 + S["space-4"]
        end
        -- the key chip: the binding's first key
        local key = o.binding and GetBindingKey(o.binding)
        if key then
            self.key = keyChip(head, GetBindingText and GetBindingText(key, "KEY_") or key)
            self.keyRight = right
        end
        -- the tab row's rule
        self.rule = head:CreateTexture(nil, "ARTWORK")
        draw.paintFill(self.rule, "gilt-faint")
        self.rule:SetHeight(1)
        self.rule:SetPoint("BOTTOMLEFT", S["space-5"], 0)
        self.rule:SetPoint("BOTTOMRIGHT", -S["space-5"], 0)
        self:PlaceHead(true)

        hookScript(frame, "OnSizeChanged", function() self:LayoutTabs() end)
        if self.protected then
            events.onGame("PLAYER_REGEN_ENABLED", function()
                if self.headAfterCombat then
                    self.headAfterCombat = false
                    self:PlaceHead()
                    self:LayoutTabs()
                end
                if self.layoutAfterCombat then
                    self.layoutAfterCombat = false
                    self:LayoutTabs()
                end
            end, "UI.SkinWindow")
        end

        -- the panel-position rule: in a row under an anchor (the micro menu)
        if o.under then
            self.under = o.under
            add(self)
        end
        extend.add(extend.Kind.Window, self, { name = frame:GetName(), skinned = frame })
    end

    function SetTabs(list: SkinTab[])
        self.tabs = list
        -- the chosen tab's underline and jewel, gliding (tabMarker), on the
        -- head: SuuUI's own frame, the tabs being Blizzard's
        local marker = self.tabMarker or tabMarker(self.head, { level = 3 })
        self.tabMarker = marker
        for _, def in ipairs(list) do
            local skin = skinTab(self, def)
            skin.def = def
            marker:Track(def.button)
        end
        self:LayoutTabs()
    end

    -- The row, left to right; short labels and a smaller gap when the window is
    -- too narrow for the full ones.
    function LayoutTabs()
        local tabs = self.tabs
        if not tabs then return end
        -- a protected window (the spells window): its parts move only out of combat
        if self.protected and InCombatLockdown() then
            self.layoutAfterCombat = true
            return
        end
        local short, gap = fitTabs(tabs, self.frame:GetWidth() - S["space-5"] * 2)
        self.placing = true
        local prev: Button? = nil
        for _, def in ipairs(tabs) do
            local b = def.button
            local label = (short and def.short) or def.label
            skinTab(self, def).label:SetValue(label)
            b:SetSize(math.ceil(measureText("header", label)), tabH())
            b:ClearAllPoints()
            if prev then
                b:SetPoint("BOTTOMLEFT", prev, "BOTTOMRIGHT", gap, 0)
            else
                b:SetPoint("BOTTOMLEFT", self.head, "BOTTOMLEFT", S["space-5"], 0)
            end
            b:SetFrameLevel(self.head:GetFrameLevel() + 2)
            prev = b
        end
        self.placing = false
        self:UpdateTabs()
    end

    function UpdateTabs()
        local chosen: Button? = nil
        for _, def in ipairs(self.tabs or {}) do
            local t = skinTab(self, def)
            local disabled, selected = def.disabled, def.selected
            local off = disabled ~= nil and (disabled() or false) ~= false
            local on = not off and selected ~= nil and (selected() or false) ~= false
            t.label:SetColor(off and "ink-faint" or on and "gilt-text" or (t.hover and "ink" or "ink-muted"))
            t.label:SetAlpha(off and T.opacity["opacity-disabled"] or 1)
            t.cover:SetShown(off)
            if on then chosen = def.button end
        end
        if self.tabMarker then self.tabMarker:SetChosen(chosen) end
    end

    -- The header's height and its title line, from the header style: when
    -- skinned (`now`), and again when a theme changes it (a protected window's
    -- close button and tabs move out of combat only).
    function PlaceHead(now: boolean?)
        if not now and self.protected and InCombatLockdown() then
            self.headAfterCombat = true
            return
        end
        local h = headH() + self.headExtra
        local rise = h - self.inset -- the header's height above the window's top
        self.riseH, self.rise = rise, rise
        local head = self.head
        self.bg:SetPoint("TOPLEFT", 0, rise)
        self.edgeHolder:SetPoint("TOPLEFT", 0, rise)
        head:SetPoint("TOPLEFT", 0, rise)
        head:SetPoint("TOPRIGHT", 0, rise)
        head:SetHeight(h)
        local lineY = -(S["space-5"] + T.type.header.lineHeight / 2)
        if self.icon then self.icon:SetPoint("LEFT", head, "TOPLEFT", S["space-5"], lineY) end
        self.title:SetPoint("LEFT", head, "TOPLEFT", self.titleX, lineY)
        if self.close then self.close:SetPoint("RIGHT", head, "TOPRIGHT", -S["space-5"], lineY) end
        if self.key then self.key:SetPoint("RIGHT", head, "TOPRIGHT", -self.keyRight, lineY) end
    end

    -- The title, and the key chip for another binding (a window whose tabs
    -- open with different keys).
    function SetTitle(title: string?)
        self.title:SetValue(title or "")
    end

    function SetBinding(binding: string?)
        local key = binding and GetBindingKey(binding)
        if self.key then
            if key then self.key:SetKey(GetBindingText and GetBindingText(key, "KEY_") or key) end
            self.key:SetShown(key ~= nil)
        end
    end
end
mixins.WindowChrome = WindowChrome

export function skinWindow(frame: Frame, opts: WindowSkinOptions?): WindowChrome
    return chromes[frame] or WindowChrome.new(frame, opts)
end

--------------------------------------------------------------------------------
-- The window row: SuuUI-headed windows open in a row under the micro menu,
-- in the order they opened, space-5 apart (the Character window, then the
-- spells window beside it, …). Opening, closing or resizing one lays the
-- row out again. A protected window moves only out of combat; the row goes
-- on from where it stands.
--------------------------------------------------------------------------------

type RowState = { list: WindowChrome[], seq: number, placing?: boolean, queued?: boolean }

local Row: RowState = { list = {}, seq = 0 }
export const windowRow = Row

local function byOpening(a: WindowChrome, b: WindowChrome): boolean return (a.openedAt or 0) < (b.openedAt or 0) end

-- The windows asked to sit in the middle of the screen (their headers
-- included), out of the row; opening one there closes the other (see
-- add), so normally one: in the middle. Should two be open at once (a
-- protected one can't be closed from here), side by side, the group
-- centred. A protected one moves out of combat only.
local function centerAll(list: WindowChrome[])
    if #list == 0 then return end
    table.sort(list, byOpening)
    local us = UIParent:GetEffectiveScale()
    local gap = S["space-5"] * us
    local total = 0
    for i, c in ipairs(list) do total = total + c.frame:GetWidth() * c.frame:GetEffectiveScale() + (i > 1 and gap or 0) end
    local x = -total / 2
    for _, c in ipairs(list) do
        local f = c.frame
        local es = f:GetEffectiveScale()
        local w = f:GetWidth() * es
        if InCombatLockdown() and c.protected then
            c.placeAfterCombat = true
        else
            f:ClearAllPoints()
            f:SetPoint("CENTER", UIParent, "CENTER", (x + w / 2) / es, -c.rise / 2)
        end
        x = x + w + gap
    end
end

local updatePlacers: () -> ()

export function layout()
    if Row.placing then return end
    updatePlacers()
    local open: WindowChrome[], middle: WindowChrome[] = {}, {}
    for _, c in ipairs(Row.list) do
        if c.frame:IsShown() then
            if c.centered then middle[#middle + 1] = c else open[#open + 1] = c end
        end
    end
    Row.placing = true
    centerAll(middle)
    Row.placing = false
    if #open == 0 then return end
    table.sort(open, byOpening)
    local under = open[1].under
    local anchor = under and anchors.get(under)
    if not anchor or not anchor:IsVisible() then return end
    local as = anchor:GetEffectiveScale()
    local left, bottom = anchor:GetLeft(), anchor:GetBottom()
    if not (left and bottom) then return end
    -- in screen units (coordinates times effective scale)
    local x = left * as
    local top = bottom * as - S["space-5"] * as
    local gap = S["space-5"] * as
    Row.placing = true
    for _, c in ipairs(open) do
        local f = c.frame
        local es = f:GetEffectiveScale()
        if InCombatLockdown() and c.protected then
            c.placeAfterCombat = true
            local r = f:GetRight()
            if r then x = r * es + gap end
        else
            f:ClearAllPoints()
            f:SetPoint("TOPLEFT", UIParent, "BOTTOMLEFT", x / es, top / es - c.rise)
            x = x + f:GetWidth() * es + gap
        end
    end
    Row.placing = false
end

export function queue()
    if Row.queued then return end
    Row.queued = true
    after(0, function()
        Row.queued = false
        layout()
    end)
end

-- In the middle of the screen (on) or back in the row (off): SuuUI's Talents
-- tab centres the spells window while it shows (asked for in game).
export function centerWindow(frame: Frame?, center: unknown)
    local chrome = chromeOf(frame)
    if not chrome or not chrome.under then return end
    local on = center ~= nil and center ~= false
    if chrome.centered == on then return end
    chrome.centered = on
    layout()
    queue()
end

export function add(chrome: WindowChrome)
    Row.list[#Row.list + 1] = chrome
    local f = chrome.frame
    hookScript(f, "OnShow", function()
        Row.seq = Row.seq + 1
        chrome.openedAt = Row.seq
        -- the middle holds one window: opening one there closes the other
        -- (Talents and Legacy: asked for in game); protected ones aren't
        -- closed from here
        if chrome.centered then
            for _, other in ipairs(Row.list) do
                if other ~= chrome and other.centered and not other.protected and other.frame:IsShown() then
                    other.frame:Hide()
                end
            end
        end
        layout()
        queue()
    end)
    hookScript(f, "OnHide", queue)
    hookScript(f, "OnSizeChanged", queue)
    -- Blizzard places its panels again now and then (right after showing
    -- one too): back in the row at once, so no frame is drawn elsewhere
    -- (a flicker, found in game); and again a frame later
    hook(f, "SetPoint", function()
        if Row.placing then return end
        layout()
        queue()
    end)
    if f:IsShown() then
        Row.seq = Row.seq + 1
        chrome.openedAt = Row.seq
        queue()
    end
end

events.on("SUUUI_THEME_CHANGED", function()
    for _, c in ipairs(allChromes) do
        c:PlaceHead()
        c:LayoutTabs()
    end
    queue()
end, "UI.SkinWindow")

events.onGame("PLAYER_REGEN_ENABLED", function() queue() end, "UI.WindowRow")

--------------------------------------------------------------------------------
-- Secure placement (0.18): a protected window opened in combat lands where
-- SuuUI puts it, at the size its tab wants. SuuUI can't move or size a
-- protected window in combat; the game's own code can. So what each tab
-- wants (its size, the row or the middle) is handed out of combat to a
-- secure handler inside the window, which applies it whenever the window
-- shows: a child of the window made after Blizzard's tabs, so its OnShow
-- runs after theirs (children before their parent, in the order they were
-- made: recorded in the client), after the tab sized the window and after
-- Blizzard's panel manager placed it.
--------------------------------------------------------------------------------

local PLACE = [=[
    local win = self:GetFrameRef("window")
    local screen = self:GetFrameRef("screen")
    local n = self:GetAttribute("count") or 0
    local pick
    for i = 1, n do
        local mark = self:GetFrameRef("tab" .. i)
        if mark and mark:IsVisible() then pick = i break end
    end
    if not pick then return end
    local w, h = self:GetAttribute("w" .. pick), self:GetAttribute("h" .. pick)
    if w and h then
        win:SetWidth(w)
        win:SetHeight(h)
    end
    if self:GetAttribute("centered" .. pick) then
        local y = self:GetAttribute("centerY")
        if y then
            win:ClearAllPoints()
            win:SetPoint("CENTER", screen, "CENTER", 0, y)
        end
    else
        local x, y = self:GetAttribute("rowX"), self:GetAttribute("rowY")
        if x and y then
            win:ClearAllPoints()
            win:SetPoint("TOPLEFT", screen, "BOTTOMLEFT", x, y)
        end
    end
]=]

local placers: SecurePlacer[] = {}

-- A placer's tab options: `centered` the middle instead of the row.
export type PlacementOptions = { centered?: boolean }

-- The secure handler inside a protected window that places it as it shows.
export class SecurePlacer extends Frame
    readonly chrome: WindowChrome
    readonly keys: { [string]: number } = {}

    constructor(chrome: WindowChrome)
        local frame = chrome.frame
        super(nil, frame, "SecureHandlerShowHideTemplate")
        self.chrome = chrome
        self:SetSize(1, 1)
        self:SetPoint("TOPLEFT")
        self:SetFrameRef("window", frame)
        self:SetFrameRef("screen", UIParent)
        self:SetAttribute("count", 0)
        self:SetAttribute("_onshow", PLACE)
    end

    -- Where the window goes: the row's first place under its anchor, or the
    -- middle (out of combat).
    function Place()
        if InCombatLockdown() then return end
        local chrome = self.chrome
        local f = chrome.frame
        local es = f:GetEffectiveScale()
        local under = chrome.under
        local anchor = under and anchors.get(under)
        local left, bottom = anchor and anchor:GetLeft(), anchor and anchor:GetBottom()
        if anchor and left and bottom then
            local as = anchor:GetEffectiveScale()
            self:SetAttribute("rowX", left * as / es)
            self:SetAttribute("rowY", (bottom * as - S["space-5"] * as) / es - chrome.rise)
        end
        self:SetAttribute("centerY", -chrome.rise / 2)
    end

    -- What a tab wants: `tab` its frame (the first shown one decides),
    -- `centered` the middle instead of the row. Out of combat.
    function Track(key: string, tab: Frame, opts: PlacementOptions?)
        if InCombatLockdown() or self.keys[key] then return end
        local count = self:GetAttribute("count")
        local i = (type(count) == "number" and count or 0) + 1
        self.keys[key] = i
        self:SetAttribute("count", i)
        -- (a protected mark inside the tab: secure code reads only a
        -- protected frame's visibility in combat, and Blizzard's tab may
        -- not be one)
        local mark = CreateFrame("Frame", nil, tab, "SecureFrameTemplate")
        mark:SetSize(1, 1)
        mark:SetPoint("TOPLEFT")
        self:SetFrameRef("tab" .. i, mark)
        self:SetAttribute("centered" .. i, opts and opts.centered or nil)
    end

    -- The size the tab gives the window. Out of combat.
    function SetTabSize(key: string, w: number, h: number)
        local i = self.keys[key]
        if not i or InCombatLockdown() then return end
        self:SetAttribute("w" .. i, w)
        self:SetAttribute("h" .. i, h)
    end
end

updatePlacers = function()
    for _, p in ipairs(placers) do p:Place() end
end

-- Placed again as a fight starts (the moment before the lockdown): the
-- anchors may not have been laid out when a placer was made at login, and
-- a window first opened in that fight would take Blizzard's place (found
-- in game: against the top of the screen).
local placerEvents = CreateFrame("Frame")
placerEvents:RegisterEvent("PLAYER_REGEN_DISABLED")
placerEvents:SetScript("OnEvent", function() updatePlacers() end)

-- The placer of a skinned protected window (one per window).
export function securePlacement(frame: Frame?): SecurePlacer?
    local chrome = chromeOf(frame)
    if not chrome then return nil end
    if chrome.placer then return chrome.placer end
    if InCombatLockdown() then return nil end
    local p = SecurePlacer.new(chrome)
    chrome.placer = p
    placers[#placers + 1] = p
    p:Place()
    return p
end

export const WINDOW_HEAD_H = HEAD_H
