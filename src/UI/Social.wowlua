-- UI/Social.wowlua
-- The Social window's Contacts page (design component SocialWindow,
-- "Friends"): Friends / Ignored as a Segmented, "5 of 8 online", your own
-- status on the right; the list, online first then offline, each under a
-- caption heading with its count; a Battle.net friend shows the Battle.net
-- glyph and their Battle.net name, then the character they play in its
-- class colour; a character friend the class diamond and the name in class
-- colour. Under it: level, class and zone, "Playing Hearthstone", or "Last
-- online 2 days ago", then the note in quotes. Away and Busy are neutral
-- badges. Select a friend, then Whisper or Invite (disabled ones say why);
-- Add friend bottom left. Ignored: a row per name with Unignore; "Ignore a
-- player" instead of Add friend.
--
--   local c = contacts(parent)  (SuuUI.UI.Contacts)
--   c:SetData({ view = "friends" | "ignored", status = "available" | "away" |
--       "busy", me = "Suu#2397" (your BattleTag, shown at the top with the
--       status: the game's Battle.net bar's job), online, total,
--       friends = { row }, ignored = { name }, selected = key })
--     row = { key, bnet, name, character, color (class token), online,
--       detail, note, away, busy, whisper = bool, invite = bool, why (invite) }
--   c.onView(view), c.onStatus(status), c.onSelect(key), c.onWhisper(row),
--   c.onInvite(row), c.onAdd(), c.onIgnore(), c.onUnignore(name),
--   c.onMenu(row, owner)   -- a right click on a friend

import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import * as uiText from "/UI/Text"
import * as controls from "/UI/Controls"
import * as inputs from "/UI/Inputs"
import * as uiSelect from "/UI/Select"
import * as panel from "/UI/Panel"
import * as tooltip from "/UI/Tooltip"
import Text from "/UI/Text"
import SuuButton from "/UI/Controls"
import Segmented from "/UI/Inputs"
import Select from "/UI/Select"
import ScrollArea from "/UI/Panel"

export type Friend = {
    key?: string,
    bnet?: boolean,
    name?: string,
    character?: string,
    color?: string,      -- a class colour token ("class-mage")
    online?: boolean,
    detail?: string,
    note?: string,
    away?: boolean,
    busy?: boolean,
    whisper?: boolean,
    invite?: boolean,
    why?: string,
}

export type ContactsData = {
    view?: string,       -- "friends" or "ignored"
    status?: string,     -- "available", "away" or "busy"
    me?: string,
    online?: number,
    total?: number,
    friends?: Friend[],
    ignored?: string[],
    selected?: string,
}

-- A foot or head button: why it's off, for its tooltip.
export class ReasonButton extends SuuButton
    reason?: string
    readonly text: string

    constructor(parent: Frame, label: string, variant: string, onClick: () -> ())
        super(parent, { text = label, variant = variant, onClick = onClick })
        self.text = label
        self:HookScript("OnEnter", function()
            if self.reason and not self:IsEnabled() then tooltip.showTooltip(self, { title = label, description = self.reason }) end
        end)
        self:HookScript("OnLeave", function() tooltip.hideTooltip() end)
    end
end

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local ROW_H = 40
-- read when used: a theme can change the text styles
local function headH() return T.type.caption.lineHeight + S["space-3"] end
local TOP_H = 30
local FOOT_H = 26

-- the live pages, drawn again when the theme changes (colour codes in
-- their text, sizes from the text styles)
local contactPages: { [Contacts]: boolean } = setmetatable({}, { __mode = "k" })
local peopleLists: { [PeopleList]: boolean } = setmetatable({}, { __mode = "k" })
local raidPages: { [RaidGroups]: boolean } = setmetatable({}, { __mode = "k" })

-- the diamond at the name's middle
local function placeDiamond(r: ContactRow | PeopleRow)
    r.diamond:SetPoint("CENTER", r, "TOPLEFT", S["space-5"], -(S["space-3"] + T.type.label.lineHeight / 2))
end

export class StatusBadge extends Frame
    text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(16)
        draw.fill(self, "surface-raised"):SetAllPoints()
        draw.border(self, "gilt-line")
        self.text = uiText.text(self, "micro", "ink-muted")
        self.text:SetPoint("CENTER")
    end
end

local function badge(parent: Frame): StatusBadge
    return StatusBadge.new(parent)
end

export class ContactRow extends Button
    row?: Friend
    ignoredName?: string
    sel: Texture
    edge: Texture
    hover: Texture
    diamond: Texture
    glyph: Texture
    name: Text
    detail: Text
    away: StatusBadge
    unignore: SuuButton

    constructor(c: Contacts)
        super(nil, c.list.child)
        self:SetHeight(ROW_H)
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.sel = draw.fill(self, "arcane-soft", "BACKGROUND")
        self.sel:SetAllPoints()
        self.edge = draw.fill(self, "arcane", "ARTWORK")
        self.edge:SetWidth(2)
        self.edge:SetPoint("TOPLEFT")
        self.edge:SetPoint("BOTTOMLEFT")
        self.hover = draw.fill(self, "gilt-faint", "BACKGROUND", 1)
        self.hover:SetAllPoints()
        self.hover:Hide()
        -- the head: a diamond (character) or the Battle.net glyph
        self.diamond = draw.diamond(self, 7, "ink")
        placeDiamond(self)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. "people.tga")
        self.glyph:SetSize(14, 14)
        self.glyph:SetPoint("CENTER", self.diamond, "CENTER")
        self.name = uiText.text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", S["space-5"] + S["space-4"] + 2, -S["space-3"])
        self.name:SetJustifyH("LEFT")
        self.detail = uiText.text(self, "caption", "ink-muted")
        self.detail:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -1)
        self.detail:SetPoint("RIGHT", self, "RIGHT", -S["space-4"], 0)
        self.detail:SetJustifyH("LEFT")
        self.away = badge(self)
        self.away:SetPoint("TOPRIGHT", -S["space-4"], -S["space-3"])
        -- ignored: Unignore on the row
        self.unignore = controls.button(self, { text = "Unignore", variant = "quiet", onClick = function()
            local name = self.ignoredName
            if name and c.onUnignore then c.onUnignore(name) end
        end })
        self.unignore:SetPoint("RIGHT", -S["space-4"], 0)
        self:SetScript("OnEnter", function() self.hover:Show() end)
        self:SetScript("OnLeave", function() self.hover:Hide() end)
        self:SetScript("OnClick", function(_: ContactRow, button: string)
            local row = self.row
            if not row then return end
            if c.onSelect then c.onSelect(row.key) end
            if button == "RightButton" and c.onMenu then c.onMenu(row, self) end
        end)
        self:SetScript("OnDoubleClick", function()
            local row = self.row
            if row and row.whisper and c.onWhisper then c.onWhisper(row) end
        end)
    end
end

local function makeRow(c: Contacts): ContactRow
    return ContactRow.new(c)
end

export class ListHead extends Frame
    text: Text
    rule: Frame

    constructor(c: Contacts | PeopleList)
        super(nil, c.list.child)
        self:SetHeight(headH())
        self.text = uiText.text(self, "caption", "gilt-text")
        self.text:SetPoint("BOTTOMLEFT", S["space-4"], S["space-1"])
        self.rule = draw.hairline(self, "gilt-line", "out")
        self.rule:SetPoint("LEFT", self.text, "RIGHT", S["space-3"], 0)
        self.rule:SetPoint("RIGHT", -S["space-4"], 0)
    end
end

local function makeHead(c: Contacts | PeopleList): ListHead
    return ListHead.new(c)
end

local STATUS_COLOR: { [string]: string } = { available = "arcane", away = "amber", busy = "ember" }

local function footButton(parent: Frame, text: string, variant: string, onClick: () -> ()): ReasonButton
    return ReasonButton.new(parent, text, variant, onClick)
end

export class Contacts extends Frame
    rows: ContactRow[]
    heads: ListHead[]
    meDot: Texture
    me: Text
    views: Segmented<string>
    count: Text
    status: Select<string>
    add: ReasonButton
    invite: ReasonButton
    whisper: ReasonButton
    box: Frame
    list: ScrollArea
    empty: Text
    selectedRow: Friend? = nil
    data: ContactsData? = nil
    onView: ((view: string) -> ())? = nil
    onStatus: ((status: string) -> ())? = nil
    onSelect: ((key: string?) -> ())? = nil
    onWhisper: ((row: Friend) -> ())? = nil
    onInvite: ((row: Friend) -> ())? = nil
    onAdd: (() -> ())? = nil
    onIgnore: (() -> ())? = nil
    onUnignore: ((name: string) -> ())? = nil
    onMenu: ((row: Friend, owner: ContactRow) -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.rows, self.heads = {}, {}
        -- the top: Friends / Ignored, how many are online, your status
        -- you: status diamond and BattleTag, the status menu on the right
        self.meDot = draw.diamond(self, 9, "arcane")
        self.meDot:SetPoint("CENTER", self, "TOPLEFT", 6, -TOP_H / 2)
        self.me = uiText.text(self, "unit-name-lg", "ink")
        self.me:SetPoint("LEFT", self, "TOPLEFT", 6 + S["space-4"] + 2, -TOP_H / 2)
        self.views = inputs.segmented(self, { options = { { value = "friends", label = "Friends" }, { value = "ignored", label = "Ignored" } },
            onChange = function(v: string) if self.onView then self.onView(v) end end })
        self.views:SetPoint("TOPLEFT", 0, -(TOP_H + S["space-4"]))
        self.count = uiText.text(self, "caption", "ink-muted")
        self.count:SetPoint("LEFT", self.views, "RIGHT", S["space-5"], 0)
        self.status = uiSelect.select(self, { width = 120, value = "available", options = {
            { value = "available", label = "Available" }, { value = "away", label = "Away" }, { value = "busy", label = "Busy" } },
            onChange = function(v: string) if self.onStatus then self.onStatus(v) end end })
        self.status:SetPoint("TOPRIGHT")
        -- the foot
        self.add = footButton(self, "Add friend", "quiet", function()
            local view = self.data and self.data.view or "friends"
            if view == "friends" then if self.onAdd then self.onAdd() end elseif self.onIgnore then self.onIgnore() end
        end)
        self.add:SetPoint("BOTTOMLEFT")
        self.invite = footButton(self, "Invite", "primary", function()
            if self.selectedRow and self.onInvite then self.onInvite(self.selectedRow) end
        end)
        self.invite:SetPoint("BOTTOMRIGHT")
        self.whisper = footButton(self, "Whisper", "quiet", function()
            if self.selectedRow and self.onWhisper then self.onWhisper(self.selectedRow) end
        end)
        self.whisper:SetPoint("RIGHT", self.invite, "LEFT", -S["space-3"], 0)
        -- the list
        self.box = CreateFrame("Frame", nil, self)
        self.box:SetPoint("TOPLEFT", self, "TOPLEFT", 0, -(TOP_H * 2 + S["space-4"] * 2))
        self.box:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", 0, FOOT_H + S["space-4"])
        draw.fill(self.box, "surface-sunk"):SetAllPoints()
        draw.border(self.box, "gilt-faint")
        self.list = panel.scrollArea(self.box, 2)
        self.list:SetPoint("TOPLEFT", 1, -S["space-2"])
        self.list:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-2"])
        self.list:HookScript("OnSizeChanged", function() if self.data then self:Draw() end end)
        self.empty = uiText.text(self.box, "caption", "ink-muted")
        self.empty:SetPoint("CENTER")
        contactPages[self] = true
    end

    function Draw()
        local d: ContactsData = self.data or {}
        local view = d.view or "friends"
        local child = self.list.child
        child:SetWidth(math.max(1, self.list:GetWidth()))
        local y, nRow, nHead = 0, 0, 0
        local function head(text: string)
            nHead = nHead + 1
            local h = self.heads[nHead] or makeHead(self)
            self.heads[nHead] = h
            h.text:SetValue(text)
            h:SetHeight(headH())
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -y)
            h:SetPoint("RIGHT", child, "RIGHT")
            h:Show()
            y = y + headH() + S["space-1"]
        end
        local function row(): ContactRow
            nRow = nRow + 1
            local r = self.rows[nRow] or makeRow(self)
            self.rows[nRow] = r
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -y)
            r:SetPoint("RIGHT", child, "RIGHT")
            placeDiamond(r)
            r:Show()
            y = y + ROW_H
            return r
        end
        local selected: Friend? = nil
        if view == "friends" then
            local online: Friend[], offline: Friend[] = {}, {}
            for _, f in ipairs(d.friends or {}) do
                if f.online then online[#online + 1] = f else offline[#offline + 1] = f end
            end
            for gi, group in ipairs({ { label = "Online", list = online }, { label = "Offline", list = offline } }) do
                if #group.list > 0 then
                    if gi == 2 and #online > 0 then y = y + S["space-3"] end
                    head(group.label .. " · " .. #group.list)
                    for _, f in ipairs(group.list) do
                        local r = row()
                        r.row, r.ignoredName = f, nil
                        r.unignore:Hide()
                        r.diamond:SetShown(not f.bnet)
                        r.glyph:SetShown(f.bnet and true or false)
                        draw.paint(r.diamond, f.online and (f.color or "ink") or "ink-faint")
                        draw.paint(r.glyph, f.online and "arcane" or "ink-faint")
                        -- Battle.net: their name, then the character in its class colour
                        local name = f.name or ""
                        if f.bnet and f.character and f.character ~= "" then
                            name = name .. "  |cff" .. draw.hex(f.color or "ink") .. f.character .. "|r"
                        end
                        r.name:SetValue(name)
                        r.name:SetColor(f.online and (f.bnet and "ink" or (f.color or "ink")) or "ink-muted")
                        local detail = f.detail or ""
                        if f.note and f.note ~= "" then
                            detail = detail .. (detail ~= "" and "  " or "") .. "|cff" .. T.color["ink-faint"].hex .. "\"" .. f.note .. "\"|r"
                        end
                        r.detail:SetValue(detail)
                        r.detail:Show()
                        local status = f.busy and "Busy" or (f.away and "Away") or nil
                        r.away:SetShown(status ~= nil)
                        if status then
                            r.away.text:SetValue(status)
                            r.away:SetWidth(math.ceil(r.away.text:GetUnboundedStringWidth()) + S["space-4"] * 2)
                        end
                        r.name:SetPoint("RIGHT", status and r.away or r, status and "LEFT" or "RIGHT", -S["space-4"], 0)
                        local on = f.key == d.selected
                        r.sel:SetShown(on); r.edge:SetShown(on)
                        if on then selected = f end
                    end
                end
            end
            self.empty:SetValue("No friends yet: Add friend, bottom left.")
        else
            local ignored = d.ignored or {}
            if #ignored > 0 then head("Ignored · " .. #ignored) end
            for _, name in ipairs(ignored) do
                local r = row()
                r.row, r.ignoredName = nil, name
                r.diamond:Show()
                draw.paint(r.diamond, "ink-faint")
                r.glyph:Hide()
                r.away:Hide()
                r.name:SetValue(name)
                r.name:SetColor("ink-muted")
                r.name:SetPoint("RIGHT", r.unignore, "LEFT", -S["space-4"], 0)
                r.detail:Hide()
                r.unignore:Show()
                r.sel:Hide(); r.edge:Hide()
            end
            self.empty:SetValue("You aren't ignoring anyone.")
        end
        for i = nRow + 1, #self.rows do self.rows[i]:Hide() end
        for i = nHead + 1, #self.heads do self.heads[i]:Hide() end
        self.empty:SetShown(nRow == 0)
        child:SetHeight(math.max(1, y))
        -- the foot
        local friends = view == "friends"
        self.add:SetLabel(friends and "Add friend" or "Ignore a player")
        self.whisper:SetShown(friends)
        self.invite:SetShown(friends)
        if friends then
            if selected then
                self.whisper:SetEnabledState(selected.whisper and true or false)
                self.whisper.reason = (not selected.whisper) and "They're offline." or nil
                self.invite:SetEnabledState(selected.invite and true or false)
                self.invite.reason = (not selected.invite) and (selected.why or "They can't be invited.") or nil
            else
                self.whisper:SetEnabledState(false)
                self.whisper.reason = "Choose a friend first."
                self.invite:SetEnabledState(false)
                self.invite.reason = "Choose a friend first."
            end
        end
        self.selectedRow = selected
    end

    function SetData(d: ContactsData)
        self.data = d
        -- you: your BattleTag (its number faint) and your status
        local me = d.me or ""
        local name, number = me:match("^(.-)(#%d+)$")
        self.me:SetValue((name and number) and (name .. "|cff" .. T.color["ink-faint"].hex .. number .. "|r") or me)
        draw.paint(self.meDot, STATUS_COLOR[d.status or "available"] or "arcane")
        self.views:SetValue(d.view or "friends")
        self.count:SetValue((d.online or 0) .. " of " .. (d.total or 0) .. " online")
        self.count:SetShown((d.view or "friends") == "friends")
        self.status:SetValue(d.status or "available")
        self:Draw()
    end
end

export function contacts(parent: Frame): Contacts
    return Contacts.new(parent)
end

--------------------------------------------------------------------------------
-- The Raid page (design component SocialWindow, "Raid"): "17 of 40", then
-- Ready check, Role check (leader or assistant; disabled with the reason
-- otherwise) and Raid Info; eight groups of five as surface-sunk wells,
-- each player a row with their role icon, the name in class colour, a
-- crown for the leader and a star for assistants; you in an ink border;
-- offline players at opacity-oor; empty slots in a faint edge. The leader
-- (and assistants) drag players between groups: onto an empty slot moves
-- them, onto a player swaps the two. Not in a raid: the explanation, and
-- "Convert to raid" in a party. With `plan` (0.17), a Plan button opens the
-- raid planner.
--
--   local r = raidGroups(parent)  (SuuUI.UI.RaidGroups)
--   r:SetData({ inRaid, inParty, canLead, reason, size, plan, members = { { index,
--       name, class, role, group, leader, assistant, online, dead, you } } })
--   r.onReadyCheck(), r.onRoleCheck(), r.onRaidInfo(), r.onConvert(), r.onPlan(),
--   r.onMove(index, group), r.onSwap(index, otherIndex), r.onMember(member, button, owner)
--------------------------------------------------------------------------------

local ROLE_ICON: { [string]: string } = {
    TANK = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleTank.tga",
    HEALER = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleHealer.tga",
    DAMAGER = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleDamage.tga",
}
local SLOT_H = 22
local function groupLabelH() return T.type.caption.lineHeight + S["space-2"] end

export type RaidMember = {
    index: number,       -- the raid roster index
    name?: string,
    class?: string,
    className?: string,
    level?: number,
    zone?: string,
    role?: string,       -- "TANK", "HEALER" or "DAMAGER"
    group: number,       -- 1 to 8
    leader?: boolean,
    assistant?: boolean,
    online?: boolean,
    dead?: boolean,
    you?: boolean,
}

export type RaidData = {
    inRaid?: boolean,
    inParty?: boolean,
    canLead?: boolean,
    reason?: string,
    size?: number,
    plan?: boolean,
    members?: RaidMember[],
}

-- The member you drag, following the cursor.
export class RaidGhost extends Frame
    readonly role: Texture
    readonly name: Text

    constructor()
        super(nil, UIParent)
        self:SetFrameStrata("TOOLTIP")
        self:SetSize(160, SLOT_H)
        draw.fill(self, "surface-raised"):SetAllPoints()
        draw.border(self, "arcane")
        self.role = self:CreateTexture(nil, "ARTWORK")
        self.role:SetSize(12, 12)
        self.role:SetPoint("LEFT", S["space-3"], 0)
        self.name = uiText.text(self, "label", "ink")
        self.name:SetPoint("LEFT", self.role, "RIGHT", S["space-3"], 0)
    end
end

-- A raid group's box, its label at the top.
export class RaidGroupFrame extends Frame
    readonly label: Text

    constructor(parent: Frame, g: number)
        super(nil, parent)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        self.label = uiText.text(self, "caption", "gilt-text")
        self.label:SetPoint("TOPLEFT", S["space-3"], -S["space-1"])
        self.label:SetValue("Group " .. g)
    end
end

export class RaidSlot extends Button
    group: number
    pos: number
    member?: RaidMember
    fill: Texture
    edge: draw.Border
    role: Texture
    name: Text
    rank: Texture

    constructor(r: RaidGroups, g: number, i: number)
        super(nil, r.groups[g])
        self:SetHeight(SLOT_H)
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self:RegisterForDrag("LeftButton")
        self.group, self.pos = g, i
        self.fill = draw.fill(self, "surface-raised")
        self.fill:SetAllPoints()
        self.edge = draw.border(self, "gilt-faint")
        self.role = self:CreateTexture(nil, "ARTWORK")
        self.role:SetSize(12, 12)
        self.role:SetPoint("LEFT", S["space-3"], 0)
        self.name = uiText.text(self, "label", "ink")
        self.name:SetPoint("LEFT", self.role, "RIGHT", S["space-3"], 0)
        self.name:SetPoint("RIGHT", self, "RIGHT", -22, 0)
        self.name:SetJustifyH("LEFT")
        self.rank = self:CreateTexture(nil, "ARTWORK")
        self.rank:SetSize(12, 12)
        self.rank:SetPoint("RIGHT", -S["space-3"], 0)
        self:SetScript("OnEnter", function()
            if r.dragging and r.dragging ~= self then self.edge:SetColor("arcane") end
            local m = self.member
            if m then
                GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
                GameTooltip_SetTitle(GameTooltip, m.name or "")
                local line = (m.level and m.level > 0 and ("Level " .. m.level .. " ") or "") .. (m.className or "")
                if line ~= "" then GameTooltip_AddNormalLine(GameTooltip, line) end
                if m.zone and m.zone ~= "" then GameTooltip_AddNormalLine(GameTooltip, m.zone) end
                if not m.online then GameTooltip_AddNormalLine(GameTooltip, "Offline") end
                GameTooltip:Show()
            end
        end)
        self:SetScript("OnLeave", function()
            local m = self.member
            self.edge:SetColor(m and (m.you and "ink" or "gilt-hairline") or "gilt-faint")
            GameTooltip:Hide()
        end)
        self:SetScript("OnClick", function(_: RaidSlot, button: string)
            local m = self.member
            if m and r.onMember then r.onMember(m, button, self) end
        end)
        -- dragging: the member kept from the start (a roster update can redraw
        -- the slots meanwhile: their member was gone at the drop, found in
        -- game), a card following the cursor, the slot under it in arcane
        self:SetScript("OnDragStart", function()
            local m, data = self.member, r.data
            if not (m and data and data.canLead) or InCombatLockdown() then return end
            r.dragging, r.dragMember = self, m
            self:SetAlpha(0.5)
            r:StartGhost(m)
        end)
        self:SetScript("OnDragStop", function()
            self:SetAlpha(1)
            local member = r.dragMember
            local to = r:StopGhost()
            r.dragging, r.dragMember = nil, nil
            if not member then return end
            if not (to and to.group and to.pos) or to.member == member then r:Draw() return end
            local other = to.member
            if other then
                if r.onSwap then r.onSwap(member.index, other.index) end
            elseif r.onMove then
                r.onMove(member.index, to.group)
            end
        end)
    end
end

local function slot(r: RaidGroups, g: number, i: number): RaidSlot
    return RaidSlot.new(r, g, i)
end

local function headButton(parent: Frame, text: string, variant: string, onClick: () -> ()): ReasonButton
    return ReasonButton.new(parent, text, variant, onClick)
end

export class RaidGroups extends Frame
    count: Text
    info: ReasonButton
    roles: ReasonButton
    ready: ReasonButton
    plan: ReasonButton
    groups: RaidGroupFrame[]
    slots: RaidSlot[][]
    notIn: Text
    convert: SuuButton
    overSlot: RaidSlot? = nil
    ghost: RaidGhost? = nil
    data: RaidData? = nil
    headH: number? = nil
    dragging: RaidSlot? = nil
    dragMember: RaidMember? = nil
    onReadyCheck: (() -> ())? = nil
    onRoleCheck: (() -> ())? = nil
    onRaidInfo: (() -> ())? = nil
    onConvert: (() -> ())? = nil
    onPlan: (() -> ())? = nil
    onMove: ((index: number, group: number) -> ())? = nil
    onSwap: ((index: number, otherIndex: number) -> ())? = nil
    onMember: ((member: RaidMember, button: string, owner: RaidSlot) -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.count = uiText.text(self, "header", "gilt-text")
        self.count:SetPoint("TOPLEFT", 0, -6)
        -- (placed by LayoutHead)
        self.info = headButton(self, "Raid Info", "quiet", function() if self.onRaidInfo then self.onRaidInfo() end end)
        self.roles = headButton(self, "Role check", "quiet", function() if self.onRoleCheck then self.onRoleCheck() end end)
        self.ready = headButton(self, "Ready check", "quiet", function() if self.onReadyCheck then self.onReadyCheck() end end)
        self.plan = headButton(self, "Plan", "quiet", function() if self.onPlan then self.onPlan() end end)
        self.plan:Hide()
        self.groups, self.slots = {}, {}
        for g = 1, 8 do
            local f = RaidGroupFrame.new(self, g)
            self.groups[g] = f
            self.slots[g] = {}
            for i = 1, 5 do
                local b = slot(self, g, i)
                b:SetPoint("RIGHT", f, "RIGHT", -S["space-2"], 0)
                self.slots[g][i] = b
            end
        end
        -- not in a raid
        self.notIn = uiText.text(self, "body", "ink-muted")
        self.notIn:SetPoint("TOPLEFT", 0, -(30 + S["space-6"]))
        self.notIn:SetPoint("RIGHT", self, "RIGHT")
        self.notIn:SetWordWrap(true)
        self.notIn:SetJustifyH("LEFT")
        self.notIn:SetValue("You aren't in a raid. Raids are groups of more than five, for the biggest dungeons and fights. A party's leader can turn it into one.")
        self.convert = controls.button(self, { text = "Convert to raid", variant = "primary",
            onClick = function() if self.onConvert then self.onConvert() end end })
        self.convert:SetPoint("TOPLEFT", self.notIn, "BOTTOMLEFT", 0, -S["space-5"])
        self:PlaceSlots()
        self:SetScript("OnSizeChanged", function() self:LayoutHead(); self:Layout() end)
        self:LayoutHead()
        raidPages[self] = true
    end

    -- The slot of this page under the cursor, if any.
    function SlotUnderCursor(): RaidSlot?
        for g = 1, 8 do
            for i = 1, 5 do
                local b = self.slots[g][i]
                if b:IsVisible() and b:IsMouseOver() then return b end
            end
        end
    end

    function StartGhost(m: RaidMember)
        local gh = self.ghost
        if not gh then
            gh = RaidGhost.new()
            gh:SetScript("OnUpdate", function(f: RaidGhost)
                local scale = f:GetEffectiveScale()
                local x, y = GetCursorPosition()
                f:ClearAllPoints()
                f:SetPoint("LEFT", UIParent, "BOTTOMLEFT", x / scale + 12, y / scale)
                -- where they'd go
                local over = self:SlotUnderCursor()
                local was = self.overSlot
                if over ~= was then
                    if was then
                        local wm = was.member
                        was.edge:SetColor(wm and (wm.you and "ink" or "gilt-hairline") or "gilt-faint")
                    end
                    if over and over ~= self.dragging then over.edge:SetColor("arcane") end
                    self.overSlot = over
                end
            end)
            self.ghost = gh
        end
        local icon = ROLE_ICON[m.role or ""]
        gh.role:SetShown(icon ~= nil)
        if icon then gh.role:SetTexture(icon) end
        gh.name:SetValue(m.name or "")
        gh.name:SetColor(draw.classColor(m.class, "ink"))
        gh:SetWidth(math.max(120, math.ceil(gh.name:GetUnboundedStringWidth()) + 12 + S["space-3"] * 3))
        gh:Show()
    end

    -- The ghost away; the slot it was over (the drop's target).
    function StopGhost(): RaidSlot?
        local over = self:SlotUnderCursor()
        local gh = self.ghost
        if gh then gh:Hide() end
        local was = self.overSlot
        if was then
            local wm = was.member
            was.edge:SetColor(wm and (wm.you and "ink" or "gilt-hairline") or "gilt-faint")
            self.overSlot = nil
        end
        return over
    end

    function Draw()
        local d: RaidData = self.data or {}
        local inRaid = d.inRaid
        self.notIn:SetShown(not inRaid)
        self.convert:SetShown(not inRaid and d.inParty and true or false)
        self.convert:SetEnabledState(d.canLead and true or false)
        for _, g in ipairs(self.groups) do g:SetShown(inRaid and true or false) end
        self.count:SetShown(inRaid and true or false)
        for _, b in ipairs({ self.ready, self.roles }) do
            b:SetShown(inRaid and true or false)
            b:SetEnabledState(d.canLead and true or false)
            b.reason = not d.canLead and (d.reason or "Only the leader or an assistant can.") or nil
        end
        self.info:Show()
        self.plan:SetShown(d.plan and true or false)
        local n = 0
        local byGroup: { [number]: RaidMember[] } = {}
        for _, m in ipairs(d.members or {}) do
            local list = byGroup[m.group] or {}
            byGroup[m.group] = list
            table.insert(list, m)
            n = n + 1
        end
        self.count:SetValue(n .. " of " .. (d.size or 40))
        self:LayoutHead()
        if not inRaid then return end
        for g = 1, 8 do
            local list = byGroup[g] or {}
            for i = 1, 5 do
                local b = self.slots[g][i]
                local m = list[i]
                b.member = m
                if m then
                    b.fill:Show()
                    local icon = ROLE_ICON[m.role or ""]
                    b.role:SetShown(icon ~= nil)
                    if icon then
                        b.role:SetTexture(icon)
                        draw.paint(b.role, m.role == "DAMAGER" and "ink-muted" or "ink")
                    end
                    b.name:SetValue(m.name or "")
                    b.name:SetColor(draw.classColor(m.class, "ink"))
                    b.rank:SetShown(m.leader or m.assistant or false)
                    if m.leader then b.rank:SetTexture("Interface\\GroupFrame\\UI-Group-LeaderIcon")
                    elseif m.assistant then b.rank:SetTexture("Interface\\GroupFrame\\UI-Group-AssistantIcon") end
                    b.edge:SetColor(m.you and "ink" or "gilt-hairline")
                    b:SetAlpha(m.online and 1 or T.opacity["opacity-oor"])
                else
                    b.fill:Hide()
                    b.role:Hide()
                    b.rank:Hide()
                    b.name:SetValue("")
                    b.edge:SetColor("gilt-faint")
                    b:SetAlpha(1)
                end
            end
        end
    end

    function SetData(d: RaidData)
        self.data = d
        self:Draw()
    end

    -- Each group's slots under its label.
    function PlaceSlots()
        for g = 1, 8 do
            for i = 1, 5 do
                self.slots[g][i]:SetPoint("TOPLEFT", self.groups[g], "TOPLEFT", S["space-2"], -(groupLabelH() + (i - 1) * (SLOT_H + S["space-1"])))
            end
        end
    end

    -- The head: the count at the left; right to left Raid Info, in a raid Role
    -- check and Ready check, then Plan. The page is as wide as the game's
    -- Social window, so when the count and every button don't fit in one row
    -- (Plan covered the count, found in game) the buttons tighten their
    -- padding and gaps; still too wide, the count goes under them, on a row of
    -- its own, and the groups move down.
    function LayoutHead()
        local inRaid = self.data and self.data.inRaid
        local list: ReasonButton[] = { self.info }
        if inRaid then list[#list + 1] = self.roles; list[#list + 1] = self.ready end
        if self.plan:IsShown() then list[#list + 1] = self.plan end
        local countW = inRaid and math.ceil(uiText.measureText("header", self.count:GetText() or "")) + S["space-5"] or 0
        local function width(pad: number, gap: number): number
            local sum = gap * (#list - 1)
            for _, b in ipairs(list) do sum = sum + math.ceil(uiText.measureText("label", b.text)) + pad * 2 end
            return sum
        end
        local w = self:GetWidth() or 0
        local pad, gap = S["space-5"], S["space-3"]
        if w > 0 and countW + width(pad, gap) > w then pad, gap = S["space-3"], S["space-2"] end
        local below = inRaid and w > 0 and countW + width(pad, gap) > w
        local prev: ReasonButton? = nil
        for _, b in ipairs(list) do
            -- kept as the button's own width (it measures itself again on show)
            b.fixedWidth = math.ceil(uiText.measureText("label", b.text)) + pad * 2
            b:SetWidth(b.fixedWidth)
            b:ClearAllPoints()
            if prev then b:SetPoint("RIGHT", prev, "LEFT", -gap, 0) else b:SetPoint("TOPRIGHT") end
            prev = b
        end
        self.count:ClearAllPoints()
        self.count:SetPoint("TOPLEFT", 0, below and -(30 + S["space-3"]) or -6)
        local h = below and (30 + S["space-3"] + T.type.header.lineHeight) or 30
        if h ~= self.headH then
            self.headH = h
            self:Layout()
        end
    end

    -- The groups laid out: two columns of four, filling the page's width.
    function Layout()
        local w = self:GetWidth()
        if not w or w <= 0 then return end
        local gap = S["space-5"]
        local colW = math.floor((w - gap) / 2)
        local top = (self.headH or 30) + S["space-5"]
        local groupH = groupLabelH() + 5 * SLOT_H + 4 * S["space-1"]
        for g = 1, 8 do
            local col, row = (g - 1) % 2, math.floor((g - 1) / 2)
            local f = self.groups[g]
            f:ClearAllPoints()
            f:SetPoint("TOPLEFT", self, "TOPLEFT", col * (colW + gap), -(top + row * (groupH + S["space-5"])))
            f:SetSize(colW, groupH)
        end
    end
end

export function raidGroups(parent: Frame): RaidGroups
    return RaidGroups.new(parent)
end

--------------------------------------------------------------------------------
-- A list of people (the Social window's Recent allies and Requests): a
-- caption heading with its count, then a row each like the friends list's
-- (class diamond, the name in class colour, a detail caption, a note in
-- quotes, a pin), with its own buttons at the right; a right click asks
-- the owner for a menu.
--
--   local l = peopleList(parent)  (SuuUI.UI.PeopleList)
--   l:SetData({ title, empty, rows = { { key, name, color, glyph, online,
--       detail, note, pinned, actions = { { label, variant, onClick } } } } })
--   l.onMenu(row, owner)
--------------------------------------------------------------------------------

export type PeopleAction = { label: string, variant?: string, disabled?: boolean, onClick?: (row: PeopleRowData) -> () }

export type PeopleRowData = {
    key?: string,
    name?: string,
    color?: string,
    glyph?: boolean,
    online?: boolean,
    detail?: string,
    note?: string,
    pinned?: boolean,
    actions?: PeopleAction[],
}

export type PeopleData = { title?: string, empty?: string, rows?: PeopleRowData[] }

export class PeopleRow extends Button
    row?: PeopleRowData
    hover: Texture
    diamond: Texture
    glyph: Texture
    pin: Texture
    name: Text
    detail: Text
    buttons: { [string]: SuuButton[] }

    constructor(l: PeopleList)
        super(nil, l.list.child)
        self:SetHeight(ROW_H)
        self:RegisterForClicks("RightButtonUp")
        self.hover = draw.fill(self, "gilt-faint", "BACKGROUND")
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.diamond = draw.diamond(self, 7, "ink")
        placeDiamond(self)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. "people.tga")
        self.glyph:SetSize(14, 14)
        self.glyph:SetPoint("CENTER", self.diamond, "CENTER")
        self.pin = self:CreateTexture(nil, "ARTWORK")
        self.pin:SetTexture(GLYPHS .. "flag.tga")
        self.pin:SetSize(11, 11)
        draw.paint(self.pin, "gilt-text")
        self.name = uiText.text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", S["space-5"] + S["space-4"] + 2, -S["space-3"])
        self.name:SetJustifyH("LEFT")
        self.pin:SetPoint("LEFT", self.name, "RIGHT", S["space-3"], 0)
        self.detail = uiText.text(self, "caption", "ink-muted")
        self.detail:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -1)
        self.detail:SetJustifyH("LEFT")
        self.buttons = {}
        self:SetScript("OnEnter", function() self.hover:Show() end)
        self:SetScript("OnLeave", function() self.hover:Hide() end)
        self:SetScript("OnClick", function()
            local row = self.row
            if row and l.onMenu then l.onMenu(row, self) end
        end)
    end
end

local function plRow(l: PeopleList): PeopleRow
    return PeopleRow.new(l)
end

local function plButton(r: PeopleRow, i: number, variant: string): SuuButton
    local pool = r.buttons[variant] or {}
    r.buttons[variant] = pool
    local b = pool[i]
    if not b then
        b = controls.button(r, { text = "", variant = variant })
        pool[i] = b
    end
    return b
end

export class PeopleList extends Frame
    rows: PeopleRow[]
    list: ScrollArea
    head: ListHead
    empty: Text
    data: PeopleData? = nil
    onMenu: ((row: PeopleRowData, owner: PeopleRow) -> ())? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.rows = {}
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-faint")
        self.list = panel.scrollArea(self, 2)
        self.list:SetPoint("TOPLEFT", 1, -S["space-2"])
        self.list:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-2"])
        self.list:HookScript("OnSizeChanged", function() if self.data then self:Draw() end end)
        self.head = makeHead(self)
        self.head:SetPoint("TOPLEFT", self.list.child, "TOPLEFT")
        self.head:SetPoint("RIGHT", self.list.child, "RIGHT")
        self.empty = uiText.text(self, "caption", "ink-muted")
        self.empty:SetPoint("CENTER")
        peopleLists[self] = true
    end

    function Draw()
        local d: PeopleData = self.data or {}
        local child = self.list.child
        child:SetWidth(math.max(1, self.list:GetWidth()))
        local rows = d.rows or {}
        self.head.text:SetValue((d.title or "") .. " · " .. #rows)
        self.head:SetShown(#rows > 0)
        self.head:SetHeight(headH())
        local y = #rows > 0 and (headH() + S["space-1"]) or 0
        for i, row in ipairs(rows) do
            local r = self.rows[i] or plRow(self)
            self.rows[i] = r
            r.row = row
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -y)
            r:SetPoint("RIGHT", child, "RIGHT")
            placeDiamond(r)
            r.diamond:SetShown(not row.glyph)
            r.glyph:SetShown(row.glyph and true or false)
            draw.paint(r.diamond, row.online and (row.color or "ink") or "ink-faint")
            draw.paint(r.glyph, row.online and "arcane" or "ink-muted")
            r.name:SetValue(row.name or "")
            r.name:SetColor(row.online ~= false and (row.color or "ink") or "ink-muted")
            r.pin:SetShown(row.pinned and true or false)
            local detail = row.detail or ""
            if row.note and row.note ~= "" then
                detail = detail .. (detail ~= "" and "  " or "") .. "|cff" .. T.color["ink-faint"].hex .. "\"" .. row.note .. "\"|r"
            end
            r.detail:SetValue(detail)
            -- its buttons, right-aligned
            for _, pool in pairs(r.buttons) do for _, b in ipairs(pool) do b:Hide() end end
            local x: number, used: { [string]: number } = 0, {}
            local actions = row.actions or {}
            for k = #actions, 1, -1 do
                local a = actions[k]
                local variant = a.variant or "quiet"
                used[variant] = (used[variant] or 0) + 1
                local b = plButton(r, used[variant] :: number, variant)
                b:SetLabel(a.label)
                b:SetEnabledState(not a.disabled)
                b:SetScript("OnClick", function()
                    local onClick = a.onClick
                    if onClick and not a.disabled then onClick(row) end
                end)
                b:ClearAllPoints()
                b:SetPoint("RIGHT", r, "RIGHT", -(S["space-4"] + x), 0)
                b:Show()
                x = x + b:GetWidth() + S["space-3"]
            end
            r.name:SetPoint("RIGHT", r, "RIGHT", -(S["space-4"] + x + 14), 0)
            r.detail:SetPoint("RIGHT", r, "RIGHT", -(S["space-4"] + x), 0)
            r:Show()
            y = y + ROW_H
        end
        for i = #rows + 1, #self.rows do self.rows[i]:Hide() end
        self.empty:SetValue(d.empty or "")
        self.empty:SetShown(#rows == 0)
        child:SetHeight(math.max(1, y))
    end

    function SetData(d: PeopleData)
        self.data = d
        self:Draw()
    end
end

export function peopleList(parent: Frame): PeopleList
    return PeopleList.new(parent)
end

events.on("SUUUI_THEME_CHANGED", function()
    for c in pairs(contactPages) do if c.data then c:SetData(c.data) end end
    for l in pairs(peopleLists) do if l.data then l:Draw() end end
    for r in pairs(raidPages) do r:PlaceSlots(); r:LayoutHead(); r:Layout() end
end, "Social")
