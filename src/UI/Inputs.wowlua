-- UI/Inputs.wowlua
-- The settings controls: Toggle, Checkbox, Segmented, Slider, Stepper,
-- TextField and NumberField (Select has its own file). Every control shares
-- one shape:
--
--   ctl:SetValue(v)            shows v; never calls onChange
--   ctl.onChange = fn(v)       called when the player changes it
--   ctl:SetDisabled(disabled)  dims it to opacity-disabled and stops input
--
-- Arcane marks the value you chose, as it marks what you can act on in the HUD.

import tokens as T from "/Core/Tokens"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import * as fonts from "/Core/Fonts"
import * as draw from "./Draw"
import text, Text from "./Text"
import tabMarker, TabMarker from "./TabMarker"
import showTooltip, hideTooltip from "./Tooltip"

local S = T.space

local WHITE = "Interface\\Buttons\\WHITE8X8"
local CHECK = "Interface\\Buttons\\UI-CheckBox-Check"

local function reduced(): boolean
    return settings.ready() and settings.get("ui", "reducedMotion") == true
end

--------------------------------------------------------------------------------
-- Glyphs: strokes drawn from a white texture, so they take any token colour.
--------------------------------------------------------------------------------

local function stroke(parent: Frame, length: number, angle: number?, thickness: number?): Texture
    local t = parent:CreateTexture(nil, "OVERLAY")
    t:SetTexture(WHITE)
    t:SetSize(length, thickness or 1.5)
    t:SetRotation(math.rad(angle or 0))
    return t
end

-- A glyph: SetColor(token) colours every stroke. A stroke is its length,
-- angle, x, y and thickness.
export class Glyph extends Frame
    readonly parts: Texture[] = {}

    constructor(parent: Frame, size: number, color: string?, strokes: number[][])
        super(nil, parent)
        self:SetSize(size, size)
        for _, s in ipairs(strokes) do
            local t = stroke(self, s[1], s[2], s[5])
            t:SetPoint("CENTER", s[3] or 0, s[4] or 0)
            self.parts[#self.parts + 1] = t
        end
        self:SetColor(color or "ink-muted")
    end

    function SetColor(name: string)
        for _, t in ipairs(self.parts) do draw.paint(t, name) end
    end
end

local function glyph(parent: Frame, size: number, color: string?, strokes: number[][]): Glyph
    return Glyph.new(parent, size, color, strokes)
end

-- A downward chevron, a minus and a plus.
export function chevron(parent: Frame, color: string?): Glyph
    return glyph(parent, 12, color, { { 6, -45, -2, 0 }, { 6, 45, 2, 0 } })
end

export function minus(parent: Frame, color: string?): Glyph
    return glyph(parent, 12, color, { { 9, 0 } })
end

export function plus(parent: Frame, color: string?): Glyph
    return glyph(parent, 12, color, { { 9, 0 }, { 9, 90 } })
end

-- A check mark in a token colour.
export function check(parent: Frame, size: number, color: string?): Texture
    local t = parent:CreateTexture(nil, "OVERLAY")
    t:SetTexture(CHECK)
    t:SetDesaturated(true)
    t:SetSize(size, size)
    draw.paint(t, color or "on-signal")
    return t
end

-- Shared disabled behaviour for controls built on one frame: dimmed and
-- deaf to the mouse while disabled; says whether it is.
local function setDisabled(control: Frame, disabled: unknown): boolean
    local off = disabled ~= nil and disabled ~= false
    control:SetAlpha(off and T.opacity["opacity-disabled"] or 1)
    control:EnableMouse(not off)
    return off
end

-- An EditBox given its text while hidden can open with that text scrolled
-- out of view, or not drawn, until it changes: show it from the start and
-- draw it again each time the box is shown.
local function showText(e: EditBox, value: string)
    e:SetText(value)
    e:SetCursorPosition(0)
end

local function redrawOnShow(e: EditBox)
    e:HookScript("OnShow", function(self)
        if self:HasFocus() then return end
        local value = self:GetText()
        self:SetText("")
        showText(self, value)
    end)
end

--------------------------------------------------------------------------------
-- Toggle: a 34x18 track with the Jewel's diamond as its knob.
--------------------------------------------------------------------------------

export type ToggleOptions = { value?: unknown, onChange?: (value: boolean) -> () }

local KNOB_OFF, KNOB_ON = 9, 25

export class Toggle extends Button
    bg: Texture
    border: draw.Border
    knob: Texture
    onChange: ((value: boolean) -> ())? = nil
    value: boolean? = nil
    disabled: boolean? = nil

    constructor(parent: Frame, opts: ToggleOptions?)
        opts = opts or {}
        super(nil, parent)
        self:SetSize(34, 18)
        self.bg = draw.fill(self, "surface-sunk")
        self.bg:SetAllPoints()
        self.border = draw.border(self, "gilt-line")
        self.knob = draw.diamond(self, 8, "ink-muted")
        self.onChange = opts.onChange
        self:SetScript("OnClick", function()
            if self.disabled then return end
            self:SetValue(not self.value, true)
            if self.onChange then self.onChange(self.value :: boolean) end
        end)
        self:SetScript("OnEnter", function() if not self.value then self.border:SetColor("gilt") end end)
        self:SetScript("OnLeave", function() if not self.value then self.border:SetColor("gilt-line") end end)
        self:SetValue(opts.value)
    end

    function SetValue(given: unknown, animate: boolean?)
        local on = given ~= nil and given ~= false
        local was = self.value
        self.value = on
        draw.paintFill(self.bg, on and "arcane-soft" or "surface-sunk")
        self.border:SetColor(on and "arcane" or (self:IsMouseOver() and "gilt" or "gilt-line"))
        draw.paint(self.knob, on and "arcane" or "ink-muted")
        local to = on and KNOB_ON or KNOB_OFF
        self:SetScript("OnUpdate", nil)
        self.knob:ClearAllPoints()
        if animate and was ~= nil and was ~= on and not reduced() then
            -- Slide over dur-fast with an ease-out (a cubic).
            local from, start, dur = on and KNOB_OFF or KNOB_ON, GetTime(), T.duration["dur-fast"]
            self.knob:SetPoint("CENTER", self, "TOPLEFT", from, -9)
            self:SetScript("OnUpdate", function(b: Toggle)
                local t = math.min(1, (GetTime() - start) / dur)
                local e = 1 - (1 - t) ^ 3
                b.knob:SetPoint("CENTER", b, "TOPLEFT", from + (to - from) * e, -9)
                if t >= 1 then b:SetScript("OnUpdate", nil) end
            end)
        else
            self.knob:SetPoint("CENTER", self, "TOPLEFT", to, -9)
        end
    end

    function SetDisabled(disabled: unknown) self.disabled = setDisabled(self, disabled) end
end

export function toggle(parent: Frame, opts: ToggleOptions?): Toggle
    return Toggle.new(parent, opts)
end

--------------------------------------------------------------------------------
-- Checkbox: a 16px box and a body label; the whole row is the hit area.
--------------------------------------------------------------------------------

export type CheckboxOptions = {
    size?: number,
    label?: string,
    width?: number,
    value?: unknown,
    onChange?: (value: boolean) -> (),
}

export class Checkbox extends Button
    boxFrame: Frame
    box: Texture
    boxBorder: draw.Border
    check: Texture
    label: Text? = nil
    onChange: ((value: boolean) -> ())? = nil
    value: boolean = false
    disabled: boolean? = nil

    constructor(parent: Frame, opts: CheckboxOptions?)
        opts = opts or {}
        local size = opts.size or 16
        super(nil, parent)
        self.boxFrame = CreateFrame("Frame", nil, self)
        self.boxFrame:SetSize(size, size)
        self.boxFrame:SetPoint("LEFT")
        self.box = draw.fill(self.boxFrame, "surface-sunk")
        self.box:SetAllPoints()
        self.boxBorder = draw.border(self.boxFrame, "gilt-line")
        self.check = check(self.boxFrame, size - 2, "on-signal")
        self.check:SetPoint("CENTER")
        local w = size
        if opts.label then
            local label = text(self, "body", "ink")
            self.label = label
            label:SetPoint("LEFT", self.boxFrame, "RIGHT", S["space-4"], 0)
            label:SetValue(opts.label)
            w = w + S["space-4"] + label:GetUnboundedStringWidth()
        end
        self:SetSize(opts.width or w, math.max(22, size))
        self.onChange = opts.onChange
        self:SetScript("OnClick", function()
            if self.disabled then return end
            self:SetValue(not self.value)
            if self.onChange then self.onChange(self.value) end
        end)
        self:SetScript("OnEnter", function() if not self.value then self.boxBorder:SetColor("gilt") end end)
        self:SetScript("OnLeave", function() if not self.value then self.boxBorder:SetColor("gilt-line") end end)
        self:SetValue(opts.value)
    end

    function SetValue(on: unknown)
        self.value = on ~= nil and on ~= false
        draw.paintFill(self.box, self.value and "arcane" or "surface-sunk")
        self.boxBorder:SetColor(self.value and "arcane" or "gilt-line")
        self.check:SetShown(self.value)
    end

    function SetDisabled(disabled: unknown) self.disabled = setDisabled(self, disabled) end
end

export function checkbox(parent: Frame, opts: CheckboxOptions?): Checkbox
    return Checkbox.new(parent, opts)
end

--------------------------------------------------------------------------------
-- Segmented: two to five named options in one frame.
--   options = { { value = 1, label = "Bar 1" }, { value = 2, label = "Bars 1 and 2", disabled = true, reason = "…" } }
--------------------------------------------------------------------------------

-- what a segmented control chooses between
export type SegmentValue = string | number | boolean
export type SegmentedOption<V extends SegmentValue> = { value: V, label: string, disabled?: boolean, reason?: string }
export type SegmentedOptions<V extends SegmentValue> = { options: SegmentedOption<V>[], value?: V, onChange?: (value: V) -> () }

-- an option of a segmented control: its button and label
class Segment<V extends SegmentValue> extends Button
    readonly label: Text

    constructor(parent: Frame, readonly option: SegmentedOption<V>)
        super(nil, parent)
        self.label = text(self, "label", "ink-muted")
        self.label:SetPoint("CENTER")
        self.label:SetValue(option.label)
    end
end

export class Segmented<V extends SegmentValue> extends Frame
    buttons: Segment<V>[]
    onChange: ((value: V) -> ())? = nil
    marker: TabMarker
    value: V? = nil
    disabled: boolean? = nil

    constructor(parent: Frame, opts: SegmentedOptions<V>)
        super(nil, parent)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-line")
        self.buttons = {}
        self.onChange = opts.onChange
        -- the chosen option's fill and edge, gliding to the next (TabMarker)
        self.marker = tabMarker(self, { box = { fill = "arcane-soft", border = "arcane" }, level = 1 })
        local x = 3
        for _, option in ipairs(opts.options) do
            local b = Segment.new(self, option)
            b:SetFrameLevel(self:GetFrameLevel() + 3)
            b:SetSize(b.label:GetUnboundedStringWidth() + S["space-5"] * 2, 24)
            b:SetPoint("TOPLEFT", x, -3)
            x = x + b:GetWidth() + 2
            b:SetScript("OnClick", function(obj)
                if self.disabled or obj.option.disabled then return end
                self:SetValue(obj.option.value)
                if self.onChange then self.onChange(obj.option.value) end
            end)
            b:SetScript("OnEnter", function(obj)
                if obj.option.value ~= self.value and not obj.option.disabled and not self.disabled then
                    obj.label:SetColor("ink")
                end
                if obj.option.disabled and obj.option.reason then
                    showTooltip(obj, { title = obj.option.label, description = obj.option.reason })
                end
            end)
            b:SetScript("OnLeave", function()
                self:SetValue(self.value)
                hideTooltip()
            end)
            self.buttons[#self.buttons + 1] = b
        end
        self:SetSize(x + 1, 30)
        self:SetValue(opts.value)
    end

    function SetValue(v: V?)
        self.value = v
        local chosen: Button? = nil
        for _, o in ipairs(self.buttons) do
            local on = o.option.value == v
            if on then chosen = o end
            o.label:SetColor(on and "arcane" or (o.option.disabled and "ink-faint" or "ink-muted"))
        end
        self.marker:SetChosen(chosen)
    end

    function SetDisabled(disabled: unknown) self.disabled = setDisabled(self, disabled) end
end

export function segmented<V extends SegmentValue>(parent: Frame, opts: SegmentedOptions<V>): Segmented<V>
    return Segmented.new(parent, opts)
end

--------------------------------------------------------------------------------
-- Slider: the value in numeric on top, a 4px track filled arcane up to the
-- value, and an 11px ink diamond thumb with an arcane edge. Live while dragging.
--   { min, max, step, value, width = 200, unit = "px", format = fn(v) -> text,
--     live = true }   -- false: onChange only when the drag ends (for settings that
--                     -- move the very window being dragged in, like the scale)
--------------------------------------------------------------------------------

export type SliderOptions = {
    min?: number,
    max?: number,
    step?: number,
    value?: number,
    width?: number,
    unit?: string,
    format?: (v: number) -> string,
    live?: boolean,
    label?: string,
    onChange?: (v: number) -> (),
}

local function snap(v: number, min: number, step: number?): number
    if not step or step <= 0 then return v end
    return min + math.floor((v - min) / step + 0.5) * step
end

-- the value line's height comes from the numeric style, which a theme can change
local sliders: { [SliderInput]: boolean } = setmetatable({}, { __mode = "k" })
local function sliderHeight(): number
    return T.type.numeric.lineHeight + S["space-2"] + 18
end
events.on("SUUUI_THEME_CHANGED", function()
    for f in pairs(sliders) do f:SetHeight(sliderHeight()) end
end, "UI.Slider")

export class SliderInput extends Frame
    min: number
    max: number
    step: number? = nil
    unit: string? = nil
    format: (((v: number) -> string))? = nil
    onChange: ((v: number) -> ())? = nil
    live: boolean
    valueText: Text
    label: Text? = nil
    committed: number = 0
    pending: number? = nil
    value: number = 0
    slider: Slider
    updating: boolean? = nil
    disabled: boolean? = nil

    constructor(parent: Frame, opts: SliderOptions)
        super(nil, parent)
        local width = opts.width or 200
        self:SetSize(width, sliderHeight())
        sliders[self] = true
        self.min, self.max, self.step = opts.min or 0, opts.max or 1, opts.step
        self.unit, self.format, self.onChange = opts.unit, opts.format, opts.onChange
        self.live = opts.live ~= false

        self.valueText = text(self, "numeric", "ink")
        self.valueText:SetPoint("TOPRIGHT")
        if opts.label then
            local label = text(self, "label", "ink")
            self.label = label
            label:SetPoint("TOPLEFT")
            label:SetValue(opts.label)
        end

        local s = CreateFrame("Slider", nil, self)
        s:SetOrientation("HORIZONTAL")
        s:SetPoint("BOTTOMLEFT")
        s:SetPoint("BOTTOMRIGHT")
        s:SetHeight(18)
        s:SetMinMaxValues(self.min, self.max)
        if self.step then
            s:SetValueStep(self.step)
            s:SetObeyStepOnDrag(true)
        end
        local thumb = s:CreateTexture(nil, "OVERLAY")
        thumb:SetSize(13, 13)
        thumb:SetColorTexture(0, 0, 0, 0)
        s:SetThumbTexture(thumb)
        local track = draw.fill(s, "track", "BACKGROUND")
        track:SetHeight(4)
        track:SetPoint("LEFT", 6, 0)
        track:SetPoint("RIGHT", -6, 0)
        local fill = draw.fill(s, "arcane", "ARTWORK")
        fill:SetHeight(4)
        fill:SetPoint("LEFT", track, "LEFT")
        fill:SetPoint("RIGHT", thumb, "CENTER")
        -- The thumb: an ink diamond with a 1px surface border and a 1px arcane edge.
        local rings: { size: number, color: string }[] = { { size = 13, color = "arcane" }, { size = 11, color = "surface" }, { size = 9, color = "ink" } }
        for i, d in ipairs(rings) do
            local dia = draw.diamond(s, d.size, d.color, "OVERLAY", 4 + i)
            dia:SetPoint("CENTER", thumb, "CENTER")
        end
        -- No mouse wheel: it belongs to the page the slider sits on, which scrolls.
        local function commit()
            local pending = self.pending
            if pending ~= nil and pending ~= self.committed then
                self.committed = pending
                if self.onChange then self.onChange(pending) end
            end
            self.pending = nil
        end
        s:SetScript("OnMouseUp", commit)
        s:SetScript("OnValueChanged", function(_, v: number)
            if self.updating or self.disabled then return end
            v = snap(v, self.min, self.step)
            if v == self.value then return end
            self.value = v
            self:ShowValue(v)
            self.pending = v
            if self.live then commit() end
        end)
        self.slider = s
        self:SetValue(opts.value or self.min)
    end

    function ShowValue(v: number)
        local value = self.format and self.format(v) or (self.unit and (v .. self.unit) or tostring(v))
        self.valueText:SetValue(value)
    end

    function SetValue(v: number)
        self.value, self.committed = v, v
        self.updating = true
        self.slider:SetValue(v)
        self.updating = false
        self:ShowValue(v)
    end

    function SetDisabled(disabled: unknown)
        self.disabled = setDisabled(self, disabled)
        self.slider:SetEnabled(not self.disabled)
        self.slider:EnableMouse(not self.disabled)
    end
end

export function slider(parent: Frame, opts: SliderOptions): SliderInput
    return SliderInput.new(parent, opts)
end

--------------------------------------------------------------------------------
-- Stepper: minus, the number (typed or nudged, clamped to min..max and to a
-- whole number of steps from min), the unit, plus.
--   { min, max, step = 1, value, unit = "px" }
--------------------------------------------------------------------------------

export type StepperOptions = {
    min?: number,
    max?: number,
    step?: number,
    value?: number,
    unit?: string,
    onChange?: (v: number) -> (),
}

-- a Stepper's minus or plus
export class StepButton extends Button
    readonly hover: Texture
    readonly glyph: Glyph

    constructor(parent: Frame, make: (parent: Frame, color: string?) -> Glyph)
        super(nil, parent)
        self:SetSize(26, 28)
        self.hover = draw.fill(self, "surface-raised")
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.glyph = make(self, "ink-muted")
        self.glyph:SetPoint("CENTER")
        self:SetScript("OnEnter", function() self.hover:Show(); self.glyph:SetColor("ink") end)
        self:SetScript("OnLeave", function() self.hover:Hide(); self.glyph:SetColor("ink-muted") end)
    end
end

local function stepButton(parent: Frame, make: (parent: Frame, color: string?) -> Glyph): StepButton
    return StepButton.new(parent, make)
end

export class Stepper extends Frame
    min: number? = nil
    max: number? = nil
    step: number
    onChange: ((v: number) -> ())? = nil
    minus: StepButton
    edit: EditBox
    unitText: Text? = nil
    plus: StepButton
    value: number? = nil
    disabled: boolean? = nil

    constructor(parent: Frame, opts: StepperOptions)
        super(nil, parent)
        self.min, self.max, self.step, self.onChange = opts.min, opts.max, opts.step or 1, opts.onChange
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-line")

        self.minus = stepButton(self, minus)
        self.minus:SetPoint("LEFT", 1, 0)
        self.minus:SetScript("OnClick", function() if not self.disabled then self:Commit((self.value or 0) - self.step) end end)

        local e = CreateFrame("EditBox", nil, self)
        e:SetAutoFocus(false)
        e:SetFontObject(fonts.get("numeric"))
        e:SetJustifyH("CENTER")
        e:SetSize(44, 28)
        e:SetPoint("LEFT", self.minus, "RIGHT")
        e:SetScript("OnEnterPressed", function(obj) self:Commit(obj:GetText()); obj:ClearFocus() end)
        e:SetScript("OnEscapePressed", function(obj) self:SetValue(self.value); obj:ClearFocus() end)
        e:SetScript("OnEditFocusLost", function(obj) self:Commit(obj:GetText()) end)
        redrawOnShow(e)
        self.edit = e

        local right: Region = e
        if opts.unit then
            local unitText = text(self, "caption", "ink-muted")
            self.unitText = unitText
            unitText:SetValue(opts.unit)
            unitText:SetPoint("LEFT", e, "RIGHT", 0, 0)
            right = unitText
        end
        self.plus = stepButton(self, plus)
        self.plus:SetPoint("LEFT", right, "RIGHT", opts.unit and S["space-2"] or 0, 0)
        self.plus:SetScript("OnClick", function() if not self.disabled then self:Commit((self.value or 0) + self.step) end end)

        local unitText = self.unitText
        local w = 26 + 44 + 26 + 2 + (opts.unit and unitText and (unitText:GetUnboundedStringWidth() + S["space-2"]) or 0)
        self:SetSize(w, 30)
        self:SetValue(opts.value)
    end

    function Clamp(v: string | number | nil): number
        local n: number = tonumber(v) or self.value or 0
        local step = self.step
        if step and step > 0 then
            local base = self.min or 0
            n = base + math.floor((n - base) / step + 0.5) * step
            n = tonumber(("%.4f"):format(n)) :: number -- no float noise (0.1 steps make 0.30000000000000004)
        end
        if self.min then n = math.max(self.min, n) end
        if self.max then n = math.min(self.max, n) end
        return n
    end

    function SetValue(v: number?)
        self.value = v
        showText(self.edit, tostring(v or ""))
    end

    function Commit(given: string | number | nil)
        if self.disabled then
            self:SetValue(self.value) -- drop what was typed
            return
        end
        local v = self:Clamp(given)
        local changed = v ~= self.value
        self:SetValue(v)
        if changed and self.onChange then self.onChange(v) end
    end

    function SetDisabled(disabled: unknown)
        self.disabled = setDisabled(self, disabled)
        self.edit:EnableMouse(not self.disabled)
        self.minus:EnableMouse(not self.disabled)
        self.plus:EnableMouse(not self.disabled)
        if self.disabled then self.edit:ClearFocus() end
    end
end

export function stepper(parent: Frame, opts: StepperOptions): Stepper
    return Stepper.new(parent, opts)
end

--------------------------------------------------------------------------------
-- TextField: a 30px field on surface-sunk with a placeholder.
--   { width, placeholder, value, onChange = fn(text) on Enter or focus lost,
--     onTextChanged = fn(text) on every keystroke }
--------------------------------------------------------------------------------

export type TextFieldOptions = {
    width?: number,
    placeholder?: string,
    value?: string,
    onChange?: (text: string) -> (),
    onTextChanged?: (text: string) -> (),
}

export class TextField extends Frame
    border: draw.Border
    onChange: ((text: string) -> ())? = nil
    onTextChanged: ((text: string) -> ())? = nil
    edit: EditBox
    placeholder: Text
    value: string = ""
    lastTyped: string? = nil
    disabled: boolean? = nil

    constructor(parent: Frame, opts: TextFieldOptions?)
        opts = opts or {}
        super(nil, parent)
        self:SetSize(opts.width or 200, 30)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        self.border = draw.border(self, "gilt-line")
        self.onChange, self.onTextChanged = opts.onChange, opts.onTextChanged

        local e = CreateFrame("EditBox", nil, self)
        e:SetAutoFocus(false)
        e:SetFontObject(fonts.get("body"))
        e:SetPoint("TOPLEFT", S["space-4"], 0)
        e:SetPoint("BOTTOMRIGHT", -S["space-4"], 0)
        e:SetTextInsets(0, 0, 0, 0)
        redrawOnShow(e)
        self.edit = e

        self.placeholder = text(self, "body", "ink-muted")
        self.placeholder:SetPoint("LEFT", S["space-4"], 0)
        self.placeholder:SetValue(opts.placeholder or "")

        local function commit(obj: EditBox)
            local value = obj:GetText()
            if value ~= self.value then
                self.value = value
                if self.onChange then self.onChange(value) end
            end
        end
        e:SetScript("OnEditFocusGained", function() self.placeholder:Hide(); self.border:SetColor("arcane") end)
        e:SetScript("OnEditFocusLost", function(obj)
            self.border:SetColor("gilt-line")
            self.placeholder:SetShown(obj:GetText() == "")
            commit(obj)
        end)
        e:SetScript("OnEnterPressed", function(obj) commit(obj); obj:ClearFocus() end)
        e:SetScript("OnEscapePressed", function(obj) obj:ClearFocus() end)
        -- what's typed, live: any change while the field has focus (the game
        -- doesn't always flag typing as user input on Forever)
        e:SetScript("OnTextChanged", function(obj)
            local value = obj:GetText()
            if obj:HasFocus() and value ~= self.lastTyped then
                self.lastTyped = value
                if self.onTextChanged then self.onTextChanged(value) end
            end
            if obj:HasFocus() then self.placeholder:Hide() end
        end)
        self:SetValue(opts.value or "")
    end

    function SetValue(value: string?)
        self.value = value or ""
        self.lastTyped = self.value -- set from code: not typing
        showText(self.edit, self.value)
        self.placeholder:SetShown(self.value == "" and not self.edit:HasFocus())
    end

    function GetValue(): string
        return self.edit:GetText()
    end

    function SetDisabled(disabled: unknown)
        self.disabled = setDisabled(self, disabled)
        self.edit:EnableMouse(not self.disabled)
        if self.disabled then self.edit:ClearFocus() end
    end
end

export function textField(parent: Frame, opts: TextFieldOptions?): TextField
    return TextField.new(parent, opts)
end

--------------------------------------------------------------------------------
-- NumberField (0.17): a compact whole-number field with a letter in front
-- (X, Y), where a Stepper's − and + would take too much room.
--   { letter = "X", value, min, max, width = 44, onChange = fn(v),
--     onFocus = fn(focused), onTab = fn(shift), onTyping = fn(n or nil) }
-- Only digits and a leading minus go in. Enter and focus lost apply (clamped
-- to min..max), Escape puts the value back, Up and Down step 1 (Shift: 10)
-- and apply. While what's typed is out of range the edge turns amber.
-- :SetRange(min, max), :Focus(), :Cancel() (drops what's typed), :HasFocus().
--------------------------------------------------------------------------------

export type NumberFieldOptions = {
    letter?: string,
    value?: number,
    min?: number,
    max?: number,
    width?: number,
    onChange?: (v: number) -> (),
    onFocus?: (focused: boolean) -> (),
    onTab?: (shift: boolean) -> (),
    onTyping?: (n: number?) -> (),
}

export class NumberField extends Frame
    border: draw.Border
    min: number? = nil
    max: number? = nil
    onChange: ((v: number) -> ())? = nil
    onFocus: ((focused: boolean) -> ())? = nil
    onTab: ((shift: boolean) -> ())? = nil
    onTyping: ((n: number?) -> ())? = nil
    letter: Text
    edit: EditBox
    lastTyped: string = ""
    value: number? = nil
    cancelling: boolean? = nil
    disabled: boolean? = nil

    constructor(parent: Frame, opts: NumberFieldOptions?)
        opts = opts or {}
        super(nil, parent)
        local width = opts.width or 44
        self:SetSize(S["space-4"] + 10 + 5 + width + S["space-4"], 30)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        self.border = draw.border(self, "gilt-line")
        self.min, self.max = opts.min, opts.max
        self.onChange, self.onFocus, self.onTab, self.onTyping = opts.onChange, opts.onFocus, opts.onTab, opts.onTyping

        self.letter = text(self, "caption", "ink-faint")
        self.letter:SetPoint("LEFT", S["space-4"], 0)
        self.letter:SetValue(opts.letter or "")

        local e = CreateFrame("EditBox", nil, self)
        e:SetAutoFocus(false)
        e:SetFontObject(fonts.get("numeric"))
        e:SetJustifyH("RIGHT")
        e:SetMaxLetters(6)
        e:SetSize(width, 28)
        e:SetPoint("RIGHT", -S["space-4"], 0)
        redrawOnShow(e)
        self.edit = e
        -- the letter's side takes clicks too
        self:EnableMouse(true)
        self:SetScript("OnMouseDown", function() self:Focus() end)

        e:SetScript("OnEditFocusGained", function(obj)
            obj:HighlightText()
            self:Tone()
            if self.onFocus then self.onFocus(true) end
        end)
        e:SetScript("OnEditFocusLost", function(obj)
            obj:HighlightText(0, 0)
            if self.cancelling then self.cancelling = nil else self:Commit(obj:GetText()) end
            self:Tone()
            if self.onFocus then self.onFocus(false) end
        end)
        e:SetScript("OnEnterPressed", function(obj) obj:ClearFocus() end)
        e:SetScript("OnEscapePressed", function() self:Cancel() end)
        e:SetScript("OnTabPressed", function() if self.onTab then self.onTab(IsShiftKeyDown()) end end)
        e:SetScript("OnArrowPressed", function(obj, key)
            local dir: number | false = (key == "UP" and 1) or (key == "DOWN" and -1)
            if not dir then return end
            self:Commit((tonumber(obj:GetText()) or self.value or 0) + dir * (IsShiftKeyDown() and 10 or 1))
            obj:SetCursorPosition(#obj:GetText())
        end)
        -- letters dropped as they're typed (compared, not gated on userInput:
        -- the game doesn't always flag typing as user input on Forever)
        e:SetScript("OnTextChanged", function(obj)
            local typed = obj:GetText()
            local digits = typed:gsub("[^%d]", "")
            local clean = (typed:sub(1, 1) == "-" and "-" or "") .. digits
            if clean ~= typed then
                local cursor = obj:GetCursorPosition() - (#typed - #clean)
                obj:SetText(clean)
                obj:SetCursorPosition(math.max(0, cursor))
                return
            end
            self:Tone()
            if obj:HasFocus() and typed ~= self.lastTyped then
                self.lastTyped = typed
                if self.onTyping then self.onTyping(tonumber(typed)) end
            end
        end)
        self:SetValue(opts.value)
    end

    function SetValue(v: number?)
        self.value = v
        self.lastTyped = v and tostring(v) or ""
        showText(self.edit, self.lastTyped)
        self:Tone()
    end

    function SetRange(min: number?, max: number?)
        self.min, self.max = min, max
    end

    function Clamp(v: number): number
        v = math.floor(v + 0.5)
        if self.min then v = math.max(self.min, v) end
        if self.max then v = math.min(self.max, v) end
        return v
    end

    -- The edge: arcane with focus, amber while what's typed is out of range.
    function Tone()
        local e = self.edit
        local n = tonumber(e:GetText())
        local focus = e:HasFocus()
        self.border:SetColor((focus and n and n ~= self:Clamp(n) and "amber") or (focus and "arcane") or "gilt-line")
    end

    function Commit(value: string | number | nil)
        local n = tonumber(value)
        if self.disabled or not n then return self:SetValue(self.value) end
        n = self:Clamp(n)
        local changed = n ~= self.value
        self:SetValue(n)
        if changed and self.onChange then self.onChange(n) end
    end

    function Focus()
        if not self.disabled then self.edit:SetFocus() end
    end

    function HasFocus(): boolean
        return self.edit:HasFocus()
    end

    function Cancel()
        if self.edit:HasFocus() then
            self.cancelling = true
            self.edit:ClearFocus()
        end
        self:SetValue(self.value)
    end

    function SetDisabled(disabled: unknown)
        if disabled then self:Cancel() end
        self.disabled = setDisabled(self, disabled)
        self.edit:EnableMouse(not self.disabled)
    end
end

export function numberField(parent: Frame, opts: NumberFieldOptions?): NumberField
    return NumberField.new(parent, opts)
end

--------------------------------------------------------------------------------
-- MoneyInput (0.16): an amount as three fields, gold, silver and copper, each
-- followed by its coin letter in the coin colour.
--
--   local m = moneyInput(parent, { value = copper, onChange = fn(copper) })
--   m:GetCopper(), m:SetCopper(copper), m:Clear(), m:SetDisabled(disabled)
--------------------------------------------------------------------------------

export type MoneyInputOptions = { value?: number, onChange?: (copper: number) -> () }

-- the three fields: the coin letter, its colour, the field's width and
-- how many digits it takes
local COINS: { letter: string, color: string, width: number, digits: number }[] = {
    { letter = "g", color = "coin-gold", width = 70, digits = 6 },
    { letter = "s", color = "coin-silver", width = 44, digits = 2 },
    { letter = "c", color = "coin-copper", width = 44, digits = 2 },
}

export class MoneyInput extends Frame
    readonly fields: TextField[] = {}

    constructor(parent: Frame, opts: MoneyInputOptions)
        super(nil, parent)
        self:SetSize(200, 30)
        local x = 0
        local function changed()
            if opts.onChange then opts.onChange(self:GetCopper()) end
        end
        for _, d in ipairs(COINS) do
            local t = textField(self, { width = d.width, onTextChanged = changed })
            t.edit:SetNumeric(true)
            t.edit:SetMaxLetters(d.digits)
            t:SetPoint("LEFT", x, 0)
            local unit = text(self, "label", d.color)
            unit:SetValue(d.letter)
            unit:SetPoint("LEFT", t, "RIGHT", 3, 0)
            x = x + d.width + 14
            self.fields[#self.fields + 1] = t
        end
        self:SetWidth(x)
        if opts.value then self:SetCopper(opts.value) end
    end

    function GetCopper(): number
        local fields = self.fields
        local g = tonumber(fields[1].edit:GetText()) or 0
        local s = tonumber(fields[2].edit:GetText()) or 0
        local c = tonumber(fields[3].edit:GetText()) or 0
        return g * 10000 + math.min(99, s) * 100 + math.min(99, c)
    end

    function SetCopper(amount: number?)
        local fields = self.fields
        local copper = math.max(0, math.floor(amount or 0))
        local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
        fields[1]:SetValue(g > 0 and tostring(g) or "")
        fields[2]:SetValue((s > 0 or g > 0) and tostring(s) or "")
        fields[3]:SetValue(tostring(c))
    end

    function Clear() for _, t in ipairs(self.fields) do t:SetValue("") end end

    function SetDisabled(disabled: unknown) for _, t in ipairs(self.fields) do t:SetDisabled(disabled) end end
end

export function moneyInput(parent: Frame, opts: MoneyInputOptions = {}): MoneyInput
    return MoneyInput.new(parent, opts)
end
