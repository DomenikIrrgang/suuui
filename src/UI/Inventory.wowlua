-- UI/Inventory.wowlua
-- Bags (design boards "Bags", "Item slot", "Money"): the item slot, money,
-- and the inventory panel (title, "18 free of 80", search and sort, a grid
-- of slots `slot` (36px) square, space-2 apart, money in the foot).
--
--   local skin = skinItemSlot(button)   -- SuuUI's look on any button
--   skin:SetItem({ icon, count, quality, dim, locked }) or skin:SetItem(nil) (empty)
--   itemSlot(parent)                     -- a plain slot (previews, saved bags)
--   local m = money(parent); m:SetCopper(n)
--   local inv = inventory(parent, { title = "Bags", columns = 10 })
--   inv:LayoutSlots(buttons)                -- in order, row by row
--   inv:SetMeta(text), inv:SetMoney(copper) (none shown until then), inv:SetNote(text)
--   inv:SetAction({ text, onClick, tooltip }) or nil: a quiet button in the foot, before the note
--   inv:SetCurrencies({ { icon, count, tooltip, onClick } }) or nil: currencies by the money (0.33)
--   inv.search (a TextField), inv.sort (a button), inv.onClose
--   inv.sort.tip = { title, description }: its tooltip, changed any time (0.17)
--
-- With opts.characters (design board "Bags window"): a character picker in
-- the header (inv.who, a bare Select, in place of the title), a row with
-- Bags/Bank (inv.view, a Segmented) and "All characters" (inv.all, a
-- Toggle), a line over the grid (inv:SetBanner(text): an eye and "… read
-- only"), and a list of found items in place of the grid
-- (inv:SetResults(list): { icon, quality, label, count, places }).
--
-- The live slots are Blizzard's own bag slot buttons (their clicks, drags
-- and tooltips are Blizzard's: using an item stays allowed in combat); the
-- skin hides their art and draws SuuUI's, keeping its own state in a table
-- of its own (nothing written on the button).

import colorize from "wowlua:color"
import hook from "wowlua:hooks"
import after from "wowlua:timer"
import tokens as T, Color from "/Core/Tokens"
import mixins from "/Core/Init"
import * as extend from "/Core/Extend"
import * as events from "/Core/Events"
import * as fonts from "/Core/Fonts"
import * as controls from "/UI/Controls"
import * as draw from "/UI/Draw"
import * as inputs from "/UI/Inputs"
import * as selectModule from "/UI/Select"
import * as uiText from "/UI/Text"
import * as tooltip from "/UI/Tooltip"
import Text from "/UI/Text"
import SuuButton from "/UI/Controls"
import Segmented, TextField, Toggle from "/UI/Inputs"
import Panel from "/UI/Panel"
import Select from "/UI/Select"

local S = T.space

-- an item slot's size and the gap between slots: a theme's, read when laid
-- out
local function slotPx(): number
    return T.size["slot"]
end
local function slotGap(): number
    return S["space-2"]
end
local CROP = 0.08
local COLORS = T.color :: { [string]: Color }
local live: { [Frame]: string } = setmetatable({}, { __mode = "k" }) -- money and inventory panels, for a theme change

--------------------------------------------------------------------------------
-- The item slot
--------------------------------------------------------------------------------

-- What a slot shows: quality "poor" … "legendary" ("common": no edge).
export type SlotItem = {
    icon?: string | number,
    count?: number,
    quality?: string,
    dim?: boolean,
    locked?: boolean,
    -- the item starts a quest (the quest-start mark in the corner)
    questStart?: boolean,
}

-- The template's own art, out of sight (alpha, so its code showing a part
-- again shows nothing).
local TEMPLATE_PARTS: string[] = {
    "IconBorder",
    "IconOverlay",
    "IconOverlay2",
    "NewItemTexture",
    "BattlepayItemTexture",
    "flash",
    "searchOverlay",
    "ItemContextOverlay",
    "Count",
    "Stock",
    "JunkIcon",
    "UpgradeIcon",
    "ExtendedSlot",
    "ExtendedOverlay",
    "ExtendedOverlay2",
    "IconQuestTexture",
    "ProfessionQualityOverlay",
    "LevelLinkLockTexture",
    "BagIndicator",
}

-- A region of the game's, if `v` is one (a template's part, read by name).
local function region(v: unknown): Region?
    if type(v) ~= "table" or type((v :: { [string]: unknown }).SetAlpha) ~= "function" then
        return nil
    end
    return v :: Region
end

-- A template's part of the button by its key (`b.IconBorder`).
local function templatePart(b: Frame, key: string): Region?
    return region((b :: { [string]: unknown })[key])
end

local function hideTemplateArt(b: Frame) -- (Blizzard's templates' parts by name)
    for _, key in ipairs(TEMPLATE_PARTS) do
        local r = templatePart(b, key)
        if r then
            r:SetAlpha(0)
        end
    end
    local name = b:GetName()
    if name then
        for _, suffix in ipairs({ "Count", "Stock", "IconQuestTexture", "NormalTexture" }) do
            local r = region(_G[name .. suffix])
            if r then
                r:SetAlpha(0)
            end
        end
    end
    if b:IsObjectType("Button") then
        local btn = b :: Button
        -- (each may be missing)
        local normal, pushed, highlight = btn:GetNormalTexture(), btn:GetPushedTexture(), btn:GetHighlightTexture()
        if normal then
            normal:SetAlpha(0)
        end
        if pushed then
            pushed:SetAlpha(0)
        end
        if highlight then
            highlight:SetAlpha(0)
        end
    end
end

-- The template's icon texture (`icon` or `Icon`), if it has one.
local function templateIcon(b: Frame): Texture?
    local r = templatePart(b, "icon") or templatePart(b, "Icon")
    if r and r:IsObjectType("Texture") then
        return r :: Texture
    end
    return nil
end

-- SuuUI's look on a slot button (its state kept here, nothing on the button).
export class ItemSlotSkin
    readonly well: Texture
    readonly icon: Texture
    readonly border: draw.Border
    readonly count: FontString
    -- the quest-start mark, made when a slot first needs it
    questMark?: Texture
    hover?: boolean
    item?: SlotItem

    constructor(readonly button: Frame)
        local b = button
        hideTemplateArt(b)
        self.well = b:CreateTexture(nil, "BACKGROUND", nil, -7)
        self.well:SetAllPoints()
        local icon = templateIcon(b) or b:CreateTexture(nil, "ARTWORK")
        self.icon = icon
        icon:ClearAllPoints()
        icon:SetPoint("TOPLEFT", 1, -1)
        icon:SetPoint("BOTTOMRIGHT", -1, 1)
        icon:SetTexCoord(CROP, 1 - CROP, CROP, 1 - CROP)
        self.border = draw.border(b, "gilt-hairline", { layer = "OVERLAY" })
        self.count = b:CreateFontString(nil, "OVERLAY")
        fonts.apply(self.count, "micro")
        self.count:SetShadowColor(0, 0, 0, 1)
        self.count:SetShadowOffset(0, -1)
        self.count:SetPoint("BOTTOMRIGHT", -2, 1)
        self.count:SetJustifyH("RIGHT")
        b:HookScript("OnEnter", function()
            self.hover = true
            self:Draw()
        end)
        b:HookScript("OnLeave", function()
            self.hover = false
            self:Draw()
        end)
        self:SetItem(nil)
    end

    -- item: { icon, count, quality ("poor" … "legendary"), dim, locked } or nil.
    function SetItem(item: SlotItem?): Frame
        self.item = item
        local b = self.button
        if item then
            self.icon:SetTexture(item.icon)
            self.icon:Show()
            self.count:SetText((item.count and item.count > 1) and tostring(item.count) or "")
        else
            self.icon:SetTexture(nil)
            self.count:SetText("")
        end
        self:Draw()
        return b
    end

    -- The quest-start mark: shown for an item that starts a quest, in the
    -- bottom-left corner (the count is at the right), 60% of the slot
    -- (asked: lower and bigger than the first 45% at the top).
    function ShowQuestStart(on: boolean)
        local mark = self.questMark
        if not on then
            if mark then
                mark:Hide()
            end
            return
        end
        if not mark then
            local b = self.button
            mark = b:CreateTexture(nil, "OVERLAY", nil, 2)
            draw.skin(mark, "quest-start")
            local px = math.max(12, math.floor((b:GetWidth() :: number) * 0.6 + 0.5))
            mark:SetSize(px, px)
            -- (the game's "!" has room on its sides but reaches its art's
            -- bottom: raised a little off the edge; a quarter was too high,
            -- asked)
            mark:SetPoint("BOTTOMLEFT", -1, math.floor(px * 0.12 + 0.5))
            self.questMark = mark
        end
        mark:Show()
    end

    function Draw()
        local item = self.item
        self:ShowQuestStart(item ~= nil and item.questStart == true)
        if not item then
            draw.paintFill(self.well, "surface-sunk")
            self.border:SetColor(self.hover and "gilt" or "gilt-faint")
            self.button:SetAlpha(1)
            return
        end
        draw.paintFill(self.well, "surface-raised")
        local q = item.quality
        local edge = (q and q ~= "common" and ("quality-" .. q)) or "gilt-hairline"
        self.border:SetColor(self.hover and "gilt" or edge)
        local grey = item.dim or item.locked
        self.icon:SetDesaturated(grey and true or false)
        self.icon:SetVertexColor(grey and 0.55 or 1, grey and 0.55 or 1, grey and 0.55 or 1)
        self.button:SetAlpha(item.dim and T.opacity["opacity-disabled"] or 1)
    end
end

export function skinItemSlot(b: Frame): ItemSlotSkin
    return ItemSlotSkin.new(b)
end

-- A plain slot (itemSlot).
export class ItemSlot extends Button
    skin: ItemSlotSkin

    constructor(parent: Frame, size: number?)
        super(nil, parent)
        self:SetSize(size or slotPx(), size or slotPx())
        self.skin = skinItemSlot(self)
    end
end

-- A plain slot: for previews and for bags SuuUI only remembers.
export function itemSlot(parent: Frame, size: number?): ItemSlot
    return ItemSlot.new(parent, size)
end

--------------------------------------------------------------------------------
-- Money: 1,204g 37s 9c (tabular figures, the units in coin colours); zero
-- coins at the end left out ("38g 50s", "1g"), "0c" for none
--------------------------------------------------------------------------------

local function thousands(n: number): string
    local s = tostring(n)
    while true do
        local k: number
        s, k = s:gsub("^(%d+)(%d%d%d)", "%1,%2")
        if k == 0 then
            break
        end
    end
    return s
end

-- The text for an amount (anything not a number: 0; below 0: 0; fractions
-- dropped), the units in the coin colours: "1,204g 37s 9c".
export function moneyText(given: unknown): string
    local total = math.max(0, math.floor(tonumber(given) or 0))
    local g, s, c = math.floor(total / 10000), math.floor(total / 100) % 100, total % 100
    local parts: string[] = {}
    local function part(v: number | string, unit: string, token: string)
        local color = COLORS[token]
        parts[#parts + 1] = v .. colorize(color and color.hex or "ffffff", unit)
    end
    if g > 0 then
        part(thousands(g), "g", "coin-gold")
    end
    if s > 0 or (g > 0 and c > 0) then
        part(s, "s", "coin-silver")
    end
    if c > 0 or #parts == 0 then
        part(c, "c", "coin-copper")
    end
    return table.concat(parts, "  ")
end

export class Money extends Frame
    text: Text
    copper: number? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.text = uiText.text(self, "numeric", "ink")
        self.text:SetPoint("RIGHT")
        self:SetCopper(0)
        live[self] = "money"
    end

    function SetCopper(given: unknown)
        local total = math.max(0, math.floor(tonumber(given) or 0))
        self.copper = total
        self.text:SetText(moneyText(total))
        self:SetSize(math.max(1, self.text:GetUnboundedStringWidth()), T.type.numeric.lineHeight)
    end
end

export function money(parent: Frame): Money
    return Money.new(parent)
end

--------------------------------------------------------------------------------
-- The inventory panel
--------------------------------------------------------------------------------

-- A section in the grid (LayoutSlots): its head before the button at `at`.
export type SlotSection = { at: number, label?: string, meta?: string, note?: string }
-- A found item (SetResults); its link and tooltip lines for its row's hover.
export type FoundItem = {
    icon?: string | number,
    quality?: string,
    label?: string,
    count?: number,
    places?: string,
    link?: string,
    lines?: string[],
}
-- The foot's button (SetAction).
export type InventoryAction = { text: string, onClick?: () -> (), tooltip?: tooltip.TooltipSource }

-- A currency in the foot (0.33): its icon and amount left of the money, a
-- tooltip on hover (`tooltip(owner)` shows one), a click.
export type InventoryCurrency = {
    icon: number | string,
    count: number,
    tooltip?: (owner: Frame) -> (),
    onClick?: () -> (),
}

export class SectionHead extends Frame
    readonly rule: Texture
    readonly label: Text
    readonly meta: Text

    constructor(parent: Frame)
        super(nil, parent)
        self.rule = self:CreateTexture(nil, "ARTWORK")
        draw.paintFill(self.rule, "gilt-faint")
        self.rule:SetHeight(1)
        self.label = uiText.text(self, "caption", "gilt-text")
        self.meta = uiText.text(self, "caption", "ink-muted")
        draw.layout(self, function()
            self.rule:SetPoint("TOPLEFT", 0, -S["space-4"])
            self.rule:SetPoint("TOPRIGHT", 0, -S["space-4"])
            self.label:SetPoint("TOPLEFT", self.rule, "BOTTOMLEFT", 0, -S["space-3"])
            self.meta:SetPoint("LEFT", self.label, "RIGHT", S["space-3"], 0)
        end)
    end
end

-- A found item's row: its slot, the count, the label and where it is.
export class ResultRow extends Frame
    readonly slot: ItemSlot
    readonly total: Text
    readonly label: Text
    readonly places: Text
    item: FoundItem = {}
    onEnter?: (row: ResultRow) -> ()
    onLeave?: (row: ResultRow) -> ()

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(slotPx())
        self.slot = itemSlot(self)
        self.slot:SetPoint("LEFT")
        self.slot:EnableMouse(false)
        self.total = uiText.text(self, "numeric", "ink")
        self.total:SetPoint("RIGHT")
        self.total:SetJustifyH("RIGHT")
        self.label = uiText.text(self, "label", "ink")
        self.label:SetJustifyH("LEFT")
        self.label:SetWordWrap(false)
        self.places = uiText.text(self, "caption", "ink-muted")
        draw.layout(self, function()
            self:SetHeight(slotPx())
            self.slot:SetSize(slotPx(), slotPx())
            self.label:SetPoint("TOPLEFT", self.slot, "TOPRIGHT", S["space-4"], -1)
            self.label:SetPoint("RIGHT", self.total, "LEFT", -S["space-4"], 0)
            self.places:SetPoint("BOTTOMLEFT", self.slot, "BOTTOMRIGHT", S["space-4"], 1)
            self.places:SetPoint("RIGHT", self.total, "LEFT", -S["space-4"], 0)
        end)
        self.places:SetJustifyH("LEFT")
        self.places:SetWordWrap(false)
        self:SetScript("OnEnter", function()
            if self.onEnter then
                self.onEnter(self)
            end
        end)
        self:SetScript("OnLeave", function()
            if self.onLeave then
                self.onLeave(self)
            end
        end)
    end
end

-- A small square button with a glyph (sort).
export class GlyphButton extends Button
    readonly edge: draw.Border
    readonly glyph: Texture
    tip: tooltip.TooltipSource? = nil

    constructor(parent: Frame, glyph: string, tip: tooltip.TooltipSource?)
        super(nil, parent)
        self:SetSize(30, 30)
        draw.fill(self, "surface-raised", "BACKGROUND"):SetAllPoints()
        self.edge = draw.border(self, "gilt-line")
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        draw.glyph(self.glyph, glyph)
        self.glyph:SetSize(16, 16)
        self.glyph:SetPoint("CENTER")
        draw.paint(self.glyph, "ink")
        self.tip = tip
        self:SetScript("OnEnter", function()
            if self:IsEnabled() then
                self.edge:SetColor("gilt")
            end
            local t = self.tip
            if t then
                tooltip.showTooltip(self, t)
            end
        end)
        self:SetScript("OnLeave", function()
            self.edge:SetColor("gilt-line")
            tooltip.hideTooltip()
        end)
        hook(self, "SetEnabled", function(b: Button, on: unknown)
            b:SetAlpha((on ~= nil and on ~= false) and 1 or T.opacity["opacity-disabled"])
        end)
    end
end

-- The line over the grid: an eye and a caption.
export class Banner extends Frame
    readonly eye: Texture
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self.eye = self:CreateTexture(nil, "ARTWORK")
        draw.glyph(self.eye, "eye")
        self.eye:SetSize(12, 12)
        self.eye:SetPoint("LEFT")
        draw.paint(self.eye, "ink-muted")
        self.text = uiText.text(self, "caption", "ink-muted")
        draw.layout(self, function()
            self.text:SetPoint("LEFT", self.eye, "RIGHT", S["space-3"], 0)
        end)
    end
end

local ROW = 30 -- the tool rows: search and sort; Bags/Bank and All characters
local MAX_RESULTS = 10

-- A section's head in the grid: a gilt-faint hairline, then its label in
-- gilt-text with the meta after it (or a quiet note alone).
local function headHeight(): number
    return S["space-4"] + 1 + S["space-3"] + T.type.caption.lineHeight + S["space-3"]
end

-- A section head's label and meta (LayoutSlots).
local function headText(h: SectionHead, sct: SlotSection)
    if sct.note and not sct.label then
        h.label:SetValue(sct.note)
        h.label:SetColor("ink-muted")
        h.meta:SetValue("")
    else
        h.label:SetValue(sct.label or "")
        h.label:SetColor("gilt-text")
        h.meta:SetValue(sct.meta or sct.note or "")
    end
end

local function sectionHead(inv: Inventory, i: number): SectionHead
    local heads: SectionHead[] = inv.heads or {}
    inv.heads = heads
    local old = heads[i]
    if old then
        return old
    end
    local h = SectionHead.new(inv.grid)
    heads[i] = h
    return h
end

local function glyphButton(parent: Frame, glyph: string, tip: tooltip.TooltipSource?): GlyphButton
    return GlyphButton.new(parent, glyph, tip)
end

-- The header's character picker, the Bags/Bank and All characters row, the
-- banner and the found items.
local function buildCharacters(inv: Inventory, body: Frame)
    local title = inv.title :: Text
    title:Hide()
    local who = selectModule.select(inv, {
        bare = true,
        width = 220,
        textStyle = "header",
        textColor = "gilt-text",
        options = {},
    })
    inv.who = who
    draw.layout(inv, function()
        who:SetPoint(
            "LEFT",
            inv,
            "TOPLEFT",
            S["space-5"] - S["space-2"],
            -(S["space-5"] + T.type.header.lineHeight / 2)
        )
    end)
    local pickRow = CreateFrame("Frame", nil, body)
    inv.pickRow = pickRow
    pickRow:SetSize(1, ROW)
    local view = inputs.segmented(pickRow, {
        value = "bags",
        options = { { value = "bags", label = "Bags" }, { value = "bank", label = "Bank" } },
    })
    inv.view = view
    view:SetPoint("LEFT")
    local allLabel = uiText.text(body, "label", "ink-muted")
    inv.allLabel = allLabel
    allLabel:SetValue("All characters")
    local all = inputs.toggle(body, { value = false })
    inv.all = all
    all:SetPoint("RIGHT", pickRow, "LEFT", inv:GridWidth(), 0)
    draw.layout(inv, function()
        allLabel:SetPoint("RIGHT", all, "LEFT", -S["space-4"], 0)
    end)
    local banner = Banner.new(body)
    inv.banner = banner
    banner:SetSize(inv:GridWidth(), T.type.caption.lineHeight)
    banner:Hide()
    local results = CreateFrame("Frame", nil, body)
    inv.results = results
    results:SetSize(inv:GridWidth(), slotPx())
    results:Hide()
    inv.resultRows = {}
end

-- opts: { title, columns, name, sortTip, characters }
export type InventoryOptions = {
    title?: string,
    columns?: number,
    name?: string,
    sortTip?: string,
    characters?: boolean,
}

export class Inventory extends Panel
    columns: number
    sort: GlyphButton
    search: TextField
    grid: Frame
    rule: Texture
    note: Text
    money: Money
    actionDef: InventoryAction? = nil
    action: SuuButton? = nil
    -- the currencies by the money, and their parts (made as needed, reused)
    currencyDefs: InventoryCurrency[] = {}
    currencies: Button[] = {}
    currencyIcons: Texture[] = {}
    currencyTexts: Text[] = {}
    showResults: boolean? = nil
    heads: SectionHead[]? = nil
    -- the buttons LayoutSlots last laid out (whoever laid them out knows
    -- whether its layout still shows)
    laidOut: Region[]? = nil
    onClose: (() -> ())? = nil
    who: Select<string>? = nil
    pickRow: Frame? = nil
    view: Segmented<string>? = nil
    allLabel: Text? = nil
    all: Toggle? = nil
    banner: Banner? = nil
    results: Frame? = nil
    resultRows: ResultRow[]? = nil
    resultsMin: number? = nil
    -- the bags module's: its sort cover, the bag slots switch, the preview
    sortCover: Frame? = nil
    slotsToggle: Toggle? = nil
    slotsLabel: Text? = nil
    previewSlots: ItemSlot[]? = nil

    constructor(parent: Frame, opts: InventoryOptions?)
        local o: InventoryOptions = opts or {}
        local columns = o.columns or 10
        super(parent, {
            name = o.name,
            -- (no theme pattern behind the slots: asked 2026-11-12)
            plain = true,
            title = o.title or "Bags",
            meta = "",
            closable = true,
            -- (made before `super`: the panel it gets is this inventory)
            onClose = function(p: Panel)
                local inv = p :: Inventory
                if inv.onClose then
                    inv.onClose()
                else
                    inv:Hide()
                end
            end,
        })
        self.columns = columns
        local body = self.body
        -- search and sort
        self.sort = glyphButton(body, "sort", {
            title = "Sort",
            description = o.sortTip or "Blizzard's own sort: stacks and orders your items.",
        })
        self.sort:SetPoint("TOPRIGHT")
        self.search = inputs.textField(body, { width = self:GridWidth() - 30 - S["space-3"], placeholder = "Search" })
        self.search:SetPoint("TOPLEFT")
        -- the grid
        self.grid = CreateFrame("Frame", nil, body)
        self.grid:SetWidth(self:GridWidth())
        self.grid:SetHeight(slotPx())
        if o.characters then
            buildCharacters(self, body)
            -- laid out again a frame after it opens: the first time, before
            -- the window had its place, the row's parts were never placed
            -- (shown, no position, not drawn) until it opened again (found
            -- in game)
            self:HookScript("OnShow", function()
                after(0, function()
                    if self:IsShown() then
                        self:FitBody()
                    end
                end)
            end)
        end
        -- the foot: a note and the money, over a gilt-faint rule
        self.rule = body:CreateTexture(nil, "ARTWORK")
        draw.paintFill(self.rule, "gilt-faint")
        self.rule:SetHeight(1)
        self.note = uiText.text(body, "caption", "ink-muted")
        self.money = money(body)
        self.money:Hide() -- until SetMoney: a bank holds no money
        self:FitBody()
        extend.add(extend.Kind.Inventory, self, { name = o.name })
        live[self] = "inventory"
    end

    function GridWidth(): number
        return self.columns * slotPx() + (self.columns - 1) * slotGap()
    end

    -- The body's width: the grid's, or the picker row's where that is wider
    -- (a dense theme's grid can be narrower than Bags/Bank and the switches
    -- beside it; they never overlap).
    function BodyWidth(): number
        local w = self:GridWidth()
        local view, all, allLabel = self.view, self.all, self.allLabel
        if view and all and allLabel then
            local row = view:GetWidth() + S["space-6"] + allLabel:GetUnboundedStringWidth() + S["space-4"] +
                all:GetWidth()
            local toggle, label = self.slotsToggle, self.slotsLabel
            if toggle and label then
                row = row + label:GetUnboundedStringWidth() + S["space-4"] + toggle:GetWidth() + S["space-6"]
            end
            w = math.max(w, math.ceil(row))
        end
        return w
    end

    -- buttons laid out row by row; sections (0.17): { { at = index, label,
    -- meta, note } }, each starting a new row under its head before the button
    -- at `at` (#buttons + 1: after them all); `note` alone is a quiet line (an
    -- empty section).
    function LayoutSlots<B extends Region>(buttons: B[], sections: SlotSection[]?)
        local cols = self.columns
        local starts: { [number]: SlotSection[] } = {}
        for _, sct in ipairs(sections or {}) do
            local at: SlotSection[] = starts[sct.at] or {}
            starts[sct.at] = at
            table.insert(at, sct)
        end
        local w = self:GridWidth()
        local headH = headHeight()
        local y, col, used = 0, 0, 0
        for i = 1, #buttons + 1 do
            for _, sct in ipairs(starts[i] or {}) do
                if col > 0 then
                    y, col = y + slotPx() + slotGap(), 0
                end
                used = used + 1
                local h = sectionHead(self, used)
                h:ClearAllPoints()
                h:SetPoint("TOPLEFT", self.grid, "TOPLEFT", 0, -y)
                h:SetSize(w, headH)
                headText(h, sct)
                h:Show()
                y = y + headH
            end
            local b = buttons[i]
            if b then
                b:ClearAllPoints()
                b:SetPoint("TOPLEFT", self.grid, "TOPLEFT", col * (slotPx() + slotGap()), -y)
                b:SetSize(slotPx(), slotPx())
                b:Show()
                col = col + 1
                if col == cols then
                    y, col = y + slotPx() + slotGap(), 0
                end
            end
        end
        local heads: SectionHead[] = self.heads or {}
        for i = used + 1, #heads do
            heads[i]:Hide()
        end
        local h = col > 0 and (y + slotPx()) or (y - slotGap())
        self.grid:SetHeight(math.max(slotPx(), h))
        self:FitBody()
        self.laidOut = buttons :: Region[]
    end

    -- The buttons the last LayoutSlots laid out (nil: none yet).
    function LaidOut(): Region[]?
        return self.laidOut
    end

    -- The section heads' words again, for sections in the places the last
    -- LayoutSlots gave them (the same sections, new counts): nothing moves.
    function SetSectionMetas(sections: SlotSection[]?)
        local heads = self.heads or {}
        for i, sct in ipairs(sections or {}) do
            local h = heads[i]
            if h then
                headText(h, sct)
            end
        end
    end

    function SetMeta(text: string?)
        if self.meta then
            self.meta:SetValue(text or "")
        end
    end

    function SetMoney(copper: number?)
        if copper then
            self.money:SetCopper(copper)
        end
        self.money:SetShown(copper ~= nil)
    end

    function SetNote(text: string?)
        self.note:SetValue(text or "")
    end

    -- Currencies left of the money, in order (the game's "Show on Backpack"
    -- ones on your own bags), or none.
    function SetCurrencies(list: InventoryCurrency[]?)
        local defs = list or {}
        self.currencyDefs = defs
        for i, def in ipairs(defs) do
            local b = self.currencies[i]
            if not b then
                local made = CreateFrame("Button", nil, self.body)
                made:SetHeight(T.type.numeric.lineHeight)
                local icon = made:CreateTexture(nil, "ARTWORK")
                icon:SetSize(14, 14)
                icon:SetPoint("LEFT")
                icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
                local text = uiText.text(made, "numeric", "ink")
                local index = i
                made:SetScript("OnEnter", function(btn: Button)
                    local d = self.currencyDefs[index]
                    if d and d.tooltip then
                        d.tooltip(btn)
                    end
                end)
                made:SetScript("OnLeave", function()
                    GameTooltip:Hide()
                end)
                made:SetScript("OnClick", function()
                    local d = self.currencyDefs[index]
                    if d and d.onClick then
                        d.onClick()
                    end
                end)
                self.currencies[i], self.currencyIcons[i], self.currencyTexts[i] = made, icon, text
                b = made
            end
            local text = self.currencyTexts[i]
            text:SetPoint("LEFT", self.currencyIcons[i], "RIGHT", S["space-1"], 0)
            self.currencyIcons[i]:SetTexture(def.icon)
            text:SetText(BreakUpLargeNumbers and BreakUpLargeNumbers(def.count) or tostring(def.count))
            b:SetWidth(14 + S["space-1"] + text:GetUnboundedStringWidth())
            b:Show()
        end
        for i = #defs + 1, #self.currencies do
            self.currencies[i]:Hide()
        end
        self:FitBody()
    end

    -- A quiet button at the start of the foot (Sell junk), the note after it.
    function SetAction(action: InventoryAction?)
        self.actionDef = action
        if action then
            local b = self.action
            if not b then
                b = controls.button(self.body, {
                    text = action.text,
                    onClick = function()
                        local def = self.actionDef
                        if def and def.onClick then
                            def.onClick()
                        end
                    end,
                })
                b:HookScript("OnEnter", function(btn)
                    local def = self.actionDef
                    if def and def.tooltip then
                        tooltip.showTooltip(btn, def.tooltip)
                    end
                end)
                b:HookScript("OnLeave", function()
                    tooltip.hideTooltip()
                end)
                self.action = b
            end
            b:SetLabel(action.text)
            b:Show()
        elseif self.action then
            self.action:Hide()
        end
        self:FitBody()
    end

    -- The line over the grid ("Thessaly's bags as of 2 days ago · read only").
    function SetBanner(text: string?)
        local banner = self.banner
        if not banner then
            return
        end
        banner.text:SetValue(text or "")
        banner:SetShown(text ~= nil and text ~= "")
        self:FitBody()
    end

    -- Found items in place of the grid (nil: the grid again). At most
    -- MAX_RESULTS rows; returns how many were left out.
    function SetResults(list: FoundItem[]?): number
        local results = self.results
        if not results then
            return 0
        end
        local rows = self.resultRows :: ResultRow[]
        local n = list and math.min(#list, MAX_RESULTS) or 0
        for i = 1, n do
            local r = rows[i]
            if not r then
                r = ResultRow.new(results)
                rows[i] = r
            end
            local item = (list :: FoundItem[])[i]
            r.item = item
            r.slot.skin:SetItem({ icon = item.icon, quality = item.quality })
            r.label:SetValue(item.label or "")
            r.label:SetColor((item.quality and item.quality ~= "common") and ("quality-" .. item.quality) or "ink")
            r.places:SetValue(item.places or "")
            r.total:SetValue(item.count and ("×" .. item.count) or "")
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -(i - 1) * (slotPx() + slotGap()))
            r:SetWidth(self:GridWidth())
            r:Show()
        end
        for i = n + 1, #rows do
            rows[i]:Hide()
        end
        -- never shorter than the grid it stands in for: the window keeps its size
        if not self.showResults or not self.resultsMin then
            self.resultsMin = self.grid:GetHeight()
        end
        results:SetHeight(math.max(slotPx(), self.resultsMin or 0, n * slotPx() + math.max(0, n - 1) * slotGap()))
        self.showResults = list ~= nil
        self:FitBody()
        return list and (#list - n) or 0
    end

    -- Rows from the top: tools, the picker row, the banner, then the grid (or
    -- the found items), a rule and the foot. The panel follows the body.
    function FitBody()
        local y = ROW + S["space-4"]
        if self.view then
            -- (anchored afresh, and what hangs off it: see the OnShow above)
            local pickRow = self.pickRow :: Frame
            pickRow:ClearAllPoints()
            pickRow:SetPoint("TOPLEFT", 0, -y)
            local all = self.all
            if all then
                all:ClearAllPoints()
                all:SetPoint("RIGHT", pickRow, "LEFT", self:BodyWidth(), 0)
            end
            y = y + ROW + S["space-4"]
        end
        local banner = self.banner
        if banner and banner:IsShown() then
            banner:SetPoint("TOPLEFT", 0, -y)
            banner:SetHeight(T.type.caption.lineHeight)
            y = y + T.type.caption.lineHeight + S["space-4"]
        end
        local content = self.grid
        local results = self.results
        if results then
            results:SetShown(self.showResults)
            self.grid:SetShown(not self.showResults)
            if self.showResults then
                content = results
            end
        end
        content:ClearAllPoints()
        content:SetPoint("TOPLEFT", 0, -y)
        content:SetWidth(self:GridWidth())
        self.rule:ClearAllPoints()
        self.rule:SetPoint("TOPLEFT", content, "BOTTOMLEFT", 0, -S["space-4"])
        self.rule:SetPoint("TOPRIGHT", content, "BOTTOMRIGHT", 0, -S["space-4"])
        -- the foot's line: the note and the money, or a button with them centred on it
        local foot = T.type.numeric.lineHeight
        self.note:ClearAllPoints()
        self.money:ClearAllPoints()
        local action = self.action
        if action and action:IsShown() then
            foot = action:GetHeight()
            action:ClearAllPoints()
            action:SetPoint("TOPLEFT", self.rule, "BOTTOMLEFT", 0, -S["space-4"])
            self.note:SetPoint("LEFT", action, "RIGHT", S["space-4"], 0)
            self.money:SetPoint("RIGHT", self.rule, "BOTTOMRIGHT", 0, -(S["space-4"] + foot / 2))
        else
            self.note:SetPoint("TOPLEFT", self.rule, "BOTTOMLEFT", 0, -S["space-4"])
            self.money:SetPoint("TOPRIGHT", self.rule, "BOTTOMRIGHT", 0, -S["space-4"])
        end
        -- the currencies: right to left from the money (where it would be
        -- when there's none), the first one leftmost
        local beside: Region? = nil
        for i = #self.currencyDefs, 1, -1 do
            local b = self.currencies[i]
            b:ClearAllPoints()
            if beside then
                b:SetPoint("RIGHT", beside, "LEFT", -S["space-4"], 0)
            elseif self.money:IsShown() then
                b:SetPoint("RIGHT", self.money, "LEFT", -S["space-4"], 0)
            else
                b:SetPoint("RIGHT", self.money, "RIGHT")
            end
            beside = b
        end
        local h = y + content:GetHeight() + S["space-4"] + 1 + S["space-4"] + foot
        self.body:SetSize(self:BodyWidth(), h)
    end

    -- After `columns` changed: the widths that follow it.
    function SetColumns(columns: number)
        self.columns = columns
        local w = self:GridWidth()
        self.search:SetWidth(self:BodyWidth() - 30 - S["space-3"])
        self.grid:SetWidth(w)
        local all = self.all
        if all then
            local banner = self.banner :: Banner
            all:SetPoint("RIGHT", self.pickRow :: Frame, "LEFT", self:BodyWidth(), 0)
            banner:SetWidth(w)
        end
        self:FitBody()
    end
end
mixins.Inventory = Inventory

export function inventory(parent: Frame, opts: InventoryOptions?): Inventory
    return Inventory.new(parent, opts)
end

-- A theme can change the coin colours and the caption style the rows are
-- measured in. (The section heads follow when the owner lays the slots out
-- again: Bags does on the same message.)
events.on(
    "SUUUI_THEME_CHANGED",
    function()
        for f, kind in pairs(live) do
            if kind == "money" then
                local m = f :: Money
                m:SetCopper(m.copper)
            else
                -- (the widths from the slot size and gap, then the body)
                local inv = f :: Inventory
                inv:SetColumns(inv.columns)
            end
        end
    end,
    "UI.Inventory"
)
