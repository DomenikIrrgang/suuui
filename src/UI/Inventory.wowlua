-- UI/Inventory.wowlua
-- Bags (design boards "Bags", "Item slot", "Money"): the item slot, money,
-- and the inventory panel (title, "18 free of 80", search and sort, a grid
-- of slots `slot` (36px) square, space-2 apart, money in the foot).
--
--   local skin = skinItemSlot(button)   -- SuuUI's look on any button
--   skin:SetItem({ icon, count, quality, dim, locked }) or skin:SetItem(nil) (empty)
--   itemSlot(parent)                     -- a plain slot (previews, saved bags)
--   local m = money(parent); m:SetCopper(n)
--   local inv = inventory(parent, { title = "Bags", columns = 10 })
--   inv:LayoutSlots(buttons)                -- in order, row by row
--   inv:SetMeta(text), inv:SetMoney(copper) (none shown until then), inv:SetNote(text)
--   inv:SetAction({ text, onClick, tooltip }) or nil: a quiet button in the foot, before the note
--   inv.search (a TextField), inv.sort (a button), inv.onClose
--   inv.sort.tip = { title, description }: its tooltip, changed any time (0.17)
--
-- With opts.characters (design board "Bags window"): a character picker in
-- the header (inv.who, a bare Select, in place of the title), a row with
-- Bags/Bank (inv.view, a Segmented) and "All characters" (inv.all, a
-- Toggle), a line over the grid (inv:SetBanner(text): an eye and "… read
-- only"), and a list of found items in place of the grid
-- (inv:SetResults(list): { icon, quality, label, count, places }).
--
-- The live slots are Blizzard's own bag slot buttons (their clicks, drags
-- and tooltips are Blizzard's: using an item stays allowed in combat); the
-- skin hides their art and draws SuuUI's, keeping its own state in a table
-- of its own (nothing written on the button).

import colorize from "wowlua:color"
import hook from "wowlua:hooks"
import tokens as T from "/Core/Tokens"
import mixins from "/Core/Init"
import * as extend from "/Core/Extend"
import * as events from "/Core/Events"
import * as fonts from "/Core/Fonts"
import * as controls from "/UI/Controls"
import * as draw from "/UI/Draw"
import * as inputs from "/UI/Inputs"
import * as panel from "/UI/Panel"
import * as selectModule from "/UI/Select"
import * as uiText from "/UI/Text"
import * as tooltip from "/UI/Tooltip"
import Text from "/UI/Text"
import SuuButton from "/UI/Controls"
import Segmented, TextField, Toggle from "/UI/Inputs"
import Panel from "/UI/Panel"
import Select from "/UI/Select"

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local SLOT = T.size["slot"]
local GAP = S["space-2"]
local CROP = 0.08
local live: { [any]: string } = setmetatable({}, { __mode = "k" }) -- money and inventory panels, for a theme change

--------------------------------------------------------------------------------
-- The item slot
--------------------------------------------------------------------------------

-- What a slot shows: quality "poor" … "legendary" ("common": no edge).
export type SlotItem = { icon?: any, count?: number, quality?: string, dim?: boolean, locked?: boolean }

-- SuuUI's look on a slot button (its state kept here, nothing on the button).
export interface ItemSlotSkin
    button: Button
    well: Texture
    icon: Texture
    border: draw.Border
    count: FontString
    hover?: boolean
    item?: SlotItem
    function SetItem(item: SlotItem?): Button
    function Draw()
end

-- A plain slot (itemSlot).
export interface ItemSlot extends Button
    skin: ItemSlotSkin
end

local Skin: ItemSlotSkin = {} :: any
(Skin :: any).__index = Skin

-- The template's own art, out of sight (alpha, so its code showing a part
-- again shows nothing).
local TEMPLATE_PARTS: string[] = { "IconBorder", "IconOverlay", "IconOverlay2", "NewItemTexture", "BattlepayItemTexture",
                         "flash", "searchOverlay", "ItemContextOverlay", "Count", "Stock", "JunkIcon",
                         "UpgradeIcon", "ExtendedSlot", "ExtendedOverlay", "ExtendedOverlay2", "IconQuestTexture",
                         "ProfessionQualityOverlay", "LevelLinkLockTexture", "BagIndicator" }

local function hideTemplateArt(b: any) -- (any button: Blizzard's templates' parts by name)
    for _, key in ipairs(TEMPLATE_PARTS) do
        local r = b[key]
        if type(r) == "table" and r.SetAlpha then r:SetAlpha(0) end
    end
    local name = b:GetName()
    if name then
        for _, suffix in ipairs({ "Count", "Stock", "IconQuestTexture", "NormalTexture" }) do
            local r = _G[name .. suffix]
            if r and r.SetAlpha then r:SetAlpha(0) end
        end
    end
    for _, get in ipairs({ "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture" }) do
        local t = b[get] and b[get](b)
        if t then t:SetAlpha(0) end
    end
end

export function skinItemSlot(b: any): ItemSlotSkin
    local s: ItemSlotSkin = setmetatable({ button = b }, Skin :: any) :: any
    hideTemplateArt(b)
    s.well = b:CreateTexture(nil, "BACKGROUND", nil, -7)
    s.well:SetAllPoints()
    s.icon = b.icon or b.Icon
    if not s.icon then
        s.icon = b:CreateTexture(nil, "ARTWORK")
    end
    s.icon:ClearAllPoints()
    s.icon:SetPoint("TOPLEFT", 1, -1)
    s.icon:SetPoint("BOTTOMRIGHT", -1, 1)
    s.icon:SetTexCoord(CROP, 1 - CROP, CROP, 1 - CROP)
    s.border = draw.border(b, "gilt-hairline", { layer = "OVERLAY" })
    s.count = b:CreateFontString(nil, "OVERLAY")
    fonts.apply(s.count, "micro")
    s.count:SetShadowColor(0, 0, 0, 1)
    s.count:SetShadowOffset(0, -1)
    s.count:SetPoint("BOTTOMRIGHT", -2, 1)
    s.count:SetJustifyH("RIGHT")
    b:HookScript("OnEnter", function() s.hover = true; s:Draw() end)
    b:HookScript("OnLeave", function() s.hover = false; s:Draw() end)
    s:SetItem(nil)
    return s
end

-- item: { icon, count, quality ("poor" … "legendary"), dim, locked } or nil.
function Skin:SetItem(item: SlotItem?): Button
    self.item = item
    local b = self.button
    if item then
        self.icon:SetTexture(item.icon)
        self.icon:Show()
        self.count:SetText((item.count and item.count > 1) and tostring(item.count) or "")
    else
        self.icon:SetTexture(nil)
        self.count:SetText("")
    end
    self:Draw()
    return b
end

function Skin:Draw()
    local item = self.item
    if not item then
        draw.paintFill(self.well, "surface-sunk")
        self.border:SetColor(self.hover and "gilt" or "gilt-faint")
        self.button:SetAlpha(1)
        return
    end
    draw.paintFill(self.well, "surface-raised")
    local q = item.quality
    local edge = (q and q ~= "common" and ("quality-" .. q)) or "gilt-hairline"
    self.border:SetColor(self.hover and "gilt" or edge)
    local grey = item.dim or item.locked
    self.icon:SetDesaturated(grey and true or false)
    self.icon:SetVertexColor(grey and 0.55 or 1, grey and 0.55 or 1, grey and 0.55 or 1)
    self.button:SetAlpha(item.dim and T.opacity["opacity-disabled"] or 1)
end

-- A plain slot: for previews and for bags SuuUI only remembers.
export function itemSlot(parent: Frame, size: number?): ItemSlot
    local b: ItemSlot = CreateFrame("Button", nil, parent) :: any
    b:SetSize(size or SLOT, size or SLOT)
    b.skin = skinItemSlot(b)
    return b
end

--------------------------------------------------------------------------------
-- Money: 1,204g 37s 9c (tabular figures, the units in coin colours); zero
-- coins at the end left out ("38g 50s", "1g"), "0c" for none
--------------------------------------------------------------------------------

export interface Money extends Frame
    copper: number
    text: Text
    function SetCopper(total: any)
end

local Money: Money = {} :: any

local function thousands(n: number): string
    local s = tostring(n)
    while true do
        local k: number
        s, k = s:gsub("^(%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return s
end

-- The text for an amount (anything not a number: 0; below 0: 0; fractions
-- dropped), the units in the coin colours: "1,204g 37s 9c".
export function moneyText(total: any): string
    total = math.max(0, math.floor(tonumber(total) or 0))
    local g, s, c = math.floor(total / 10000), math.floor(total / 100) % 100, total % 100
    local parts: string[] = {}
    local function part(v: number | string, unit: string, token: string)
        parts[#parts + 1] = v .. colorize((T.color :: { [string]: any })[token].hex, unit)
    end
    if g > 0 then part(thousands(g), "g", "coin-gold") end
    if s > 0 or (g > 0 and c > 0) then part(s, "s", "coin-silver") end
    if c > 0 or #parts == 0 then part(c, "c", "coin-copper") end
    return table.concat(parts, "  ")
end

function Money:SetCopper(total: any)
    total = math.max(0, math.floor(tonumber(total) or 0))
    self.copper = total
    self.text:SetText(moneyText(total))
    self:SetSize(math.max(1, self.text:GetUnboundedStringWidth()), T.type.numeric.lineHeight)
end

export function money(parent: Frame): Money
    local m: Money = CreateFrame("Frame", nil, parent) :: any
    Mixin(m, Money)
    m.text = uiText.text(m, "numeric", "ink")
    m.text:SetPoint("RIGHT")
    m:SetCopper(0)
    live[m] = "money"
    return m
end

--------------------------------------------------------------------------------
-- The inventory panel
--------------------------------------------------------------------------------

-- A section in the grid (LayoutSlots): its head before the button at `at`.
export type SlotSection = { at: number, label?: string, meta?: string, note?: string }
-- A found item (SetResults).
export type FoundItem = { icon?: any, quality?: string, label?: string, count?: number, places?: string }
-- The foot's button (SetAction).
export type InventoryAction = { text: string, onClick?: () -> (), tooltip?: any }

export interface SectionHead extends Frame
    rule: Texture
    label: Text
    meta: Text
end

export interface ResultRow extends Frame
    slot: ItemSlot
    total: Text
    label: Text
    places: Text
    item: FoundItem
    onEnter?: (row: ResultRow) -> ()
    onLeave?: (row: ResultRow) -> ()
end

export interface GlyphButton extends Button
    edge: draw.Border
    glyph: Texture
    tip: any
end

export interface Banner extends Frame
    eye: Texture
    text: Text
end

export interface Inventory extends Panel
    columns: number
    sort: GlyphButton
    search: TextField
    grid: Frame
    rule: Texture
    note: Text
    money: Money
    heads?: SectionHead[]
    action?: SuuButton
    actionDef?: InventoryAction
    onClose?: () -> ()
    -- with opts.characters
    who?: Select
    pickRow?: Frame
    view?: Segmented
    allLabel?: Text
    all?: Toggle
    banner?: Banner
    results?: Frame
    resultRows?: ResultRow[]
    showResults?: boolean
    resultsMin?: number
    -- the owner's (Units/Bags)
    sortCover?: any
    slotsToggle?: any
    slotsLabel?: any
    previewSlots?: any
    suuManagedShow?: boolean
    function GridWidth(): number
    function LayoutSlots(buttons: any[], sections: SlotSection[]?)
    function SetMeta(text: string?)
    function SetMoney(copper: number?)
    function SetNote(text: string?)
    function SetAction(action: InventoryAction?)
    function SetBanner(text: string?)
    function SetResults(list: FoundItem[]?): number
    function FitBody()
    function SetColumns(columns: number)
end

local Inv: Inventory = {} :: any
mixins.Inventory = Inv
local ROW = 30 -- the tool rows: search and sort; Bags/Bank and All characters
local MAX_RESULTS = 10

function Inv:GridWidth()
    return self.columns * SLOT + (self.columns - 1) * GAP
end

-- A section's head in the grid: a gilt-faint hairline, then its label in
-- gilt-text with the meta after it (or a quiet note alone).
local function headHeight(): number return S["space-4"] + 1 + S["space-3"] + T.type.caption.lineHeight + S["space-3"] end

local function sectionHead(inv: Inventory, i: number): SectionHead
    local heads: SectionHead[] = inv.heads or {}
    inv.heads = heads
    local old = heads[i]
    if old then return old end
    local h: SectionHead = CreateFrame("Frame", nil, inv.grid) :: any
    h.rule = h:CreateTexture(nil, "ARTWORK")
    draw.paintFill(h.rule, "gilt-faint")
    h.rule:SetHeight(1)
    h.rule:SetPoint("TOPLEFT", 0, -S["space-4"])
    h.rule:SetPoint("TOPRIGHT", 0, -S["space-4"])
    h.label = uiText.text(h, "caption", "gilt-text")
    h.label:SetPoint("TOPLEFT", h.rule, "BOTTOMLEFT", 0, -S["space-3"])
    h.meta = uiText.text(h, "caption", "ink-muted")
    h.meta:SetPoint("LEFT", h.label, "RIGHT", S["space-3"], 0)
    heads[i] = h
    return h
end

-- buttons laid out row by row; sections (0.17): { { at = index, label,
-- meta, note } }, each starting a new row under its head before the button
-- at `at` (#buttons + 1: after them all); `note` alone is a quiet line (an
-- empty section).
function Inv:LayoutSlots(buttons: any[], sections: SlotSection[]?)
    local cols = self.columns
    local starts: { [number]: SlotSection[] } = {}
    for _, sct in ipairs(sections or {}) do
        local at: SlotSection[] = starts[sct.at] or {}
        starts[sct.at] = at
        table.insert(at, sct)
    end
    local w = self:GridWidth()
    local headH = headHeight()
    local y, col, used = 0, 0, 0
    for i = 1, #buttons + 1 do
        for _, sct in ipairs(starts[i] or {}) do
            if col > 0 then y, col = y + SLOT + GAP, 0 end
            used = used + 1
            local h = sectionHead(self, used)
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", self.grid, "TOPLEFT", 0, -y)
            h:SetSize(w, headH)
            if sct.note and not sct.label then
                h.label:SetValue(sct.note)
                h.label:SetColor("ink-muted")
                h.meta:SetValue("")
            else
                h.label:SetValue(sct.label or "")
                h.label:SetColor("gilt-text")
                h.meta:SetValue(sct.meta or sct.note or "")
            end
            h:Show()
            y = y + headH
        end
        local b = buttons[i]
        if b then
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", self.grid, "TOPLEFT", col * (SLOT + GAP), -y)
            b:SetSize(SLOT, SLOT)
            b:Show()
            col = col + 1
            if col == cols then y, col = y + SLOT + GAP, 0 end
        end
    end
    local heads: SectionHead[] = self.heads or {}
    for i = used + 1, #heads do heads[i]:Hide() end
    local h = col > 0 and (y + SLOT) or (y - GAP)
    self.grid:SetHeight(math.max(SLOT, h))
    self:FitBody()
end

function Inv:SetMeta(text: string?)
    if self.meta then self.meta:SetValue(text or "") end
end

function Inv:SetMoney(copper: number?)
    if copper then self.money:SetCopper(copper) end
    self.money:SetShown(copper ~= nil)
end

function Inv:SetNote(text: string?)
    self.note:SetValue(text or "")
end

-- A quiet button at the start of the foot (Sell junk), the note after it.
function Inv:SetAction(action: InventoryAction?)
    self.actionDef = action
    if action then
        local b = self.action
        if not b then
            b = controls.button(self.body, { text = action.text, onClick = function()
                local def = self.actionDef
                if def and def.onClick then def.onClick() end
            end })
            b:HookScript("OnEnter", function(btn)
                local def = self.actionDef
                if def and def.tooltip then tooltip.showTooltip(btn, def.tooltip) end
            end)
            b:HookScript("OnLeave", function() tooltip.hideTooltip() end)
            self.action = b
        end
        b:SetLabel(action.text)
        b:Show()
    elseif self.action then
        self.action:Hide()
    end
    self:FitBody()
end

-- The line over the grid ("Thessaly's bags as of 2 days ago · read only").
function Inv:SetBanner(text: string?)
    local banner = self.banner
    if not banner then return end
    banner.text:SetValue(text or "")
    banner:SetShown(text ~= nil and text ~= "")
    self:FitBody()
end

-- Found items in place of the grid (nil: the grid again). At most
-- MAX_RESULTS rows; returns how many were left out.
function Inv:SetResults(list: FoundItem[]?): number
    local results = self.results
    if not results then return 0 end
    local rows = self.resultRows :: ResultRow[]
    local n = list and math.min(#list, MAX_RESULTS) or 0
    for i = 1, n do
        local r = rows[i]
        if not r then
            r = CreateFrame("Frame", nil, results) :: any
            r:SetHeight(SLOT)
            r.slot = itemSlot(r)
            r.slot:SetPoint("LEFT")
            r.slot:EnableMouse(false)
            r.total = uiText.text(r, "numeric", "ink")
            r.total:SetPoint("RIGHT")
            r.total:SetJustifyH("RIGHT")
            r.label = uiText.text(r, "label", "ink")
            r.label:SetPoint("TOPLEFT", r.slot, "TOPRIGHT", S["space-4"], -1)
            r.label:SetPoint("RIGHT", r.total, "LEFT", -S["space-4"], 0)
            r.label:SetJustifyH("LEFT")
            r.label:SetWordWrap(false)
            r.places = uiText.text(r, "caption", "ink-muted")
            r.places:SetPoint("BOTTOMLEFT", r.slot, "BOTTOMRIGHT", S["space-4"], 1)
            r.places:SetPoint("RIGHT", r.total, "LEFT", -S["space-4"], 0)
            r.places:SetJustifyH("LEFT")
            r.places:SetWordWrap(false)
            r:SetScript("OnEnter", function(self: ResultRow) if self.onEnter then self.onEnter(self) end end)
            r:SetScript("OnLeave", function(self: ResultRow) if self.onLeave then self.onLeave(self) end end)
            rows[i] = r
        end
        local item = (list :: FoundItem[])[i]
        r.item = item
        r.slot.skin:SetItem({ icon = item.icon, quality = item.quality })
        r.label:SetValue(item.label or "")
        r.label:SetColor((item.quality and item.quality ~= "common") and ("quality-" .. item.quality) or "ink")
        r.places:SetValue(item.places or "")
        r.total:SetValue(item.count and ("×" .. item.count) or "")
        r:ClearAllPoints()
        r:SetPoint("TOPLEFT", 0, -(i - 1) * (SLOT + GAP))
        r:SetWidth(self:GridWidth())
        r:Show()
    end
    for i = n + 1, #rows do rows[i]:Hide() end
    -- never shorter than the grid it stands in for: the window keeps its size
    if not self.showResults or not self.resultsMin then self.resultsMin = self.grid:GetHeight() end
    results:SetHeight(math.max(SLOT, self.resultsMin or 0, n * SLOT + math.max(0, n - 1) * GAP))
    self.showResults = list ~= nil
    self:FitBody()
    return list and (#list - n) or 0
end

-- Rows from the top: tools, the picker row, the banner, then the grid (or
-- the found items), a rule and the foot. The panel follows the body.
function Inv:FitBody()
    local y = ROW + S["space-4"]
    if self.view then
        local pickRow = self.pickRow :: Frame
        pickRow:SetPoint("TOPLEFT", 0, -y)
        y = y + ROW + S["space-4"]
    end
    local banner = self.banner
    if banner and banner:IsShown() then
        banner:SetPoint("TOPLEFT", 0, -y)
        banner:SetHeight(T.type.caption.lineHeight)
        y = y + T.type.caption.lineHeight + S["space-4"]
    end
    local content = self.grid
    local results = self.results
    if results then
        results:SetShown(self.showResults)
        self.grid:SetShown(not self.showResults)
        if self.showResults then content = results end
    end
    content:ClearAllPoints()
    content:SetPoint("TOPLEFT", 0, -y)
    content:SetWidth(self:GridWidth())
    self.rule:ClearAllPoints()
    self.rule:SetPoint("TOPLEFT", content, "BOTTOMLEFT", 0, -S["space-4"])
    self.rule:SetPoint("TOPRIGHT", content, "BOTTOMRIGHT", 0, -S["space-4"])
    -- the foot's line: the note and the money, or a button with them centred on it
    local foot = T.type.numeric.lineHeight
    self.note:ClearAllPoints()
    self.money:ClearAllPoints()
    local action = self.action
    if action and action:IsShown() then
        foot = action:GetHeight()
        action:ClearAllPoints()
        action:SetPoint("TOPLEFT", self.rule, "BOTTOMLEFT", 0, -S["space-4"])
        self.note:SetPoint("LEFT", action, "RIGHT", S["space-4"], 0)
        self.money:SetPoint("RIGHT", self.rule, "BOTTOMRIGHT", 0, -(S["space-4"] + foot / 2))
    else
        self.note:SetPoint("TOPLEFT", self.rule, "BOTTOMLEFT", 0, -S["space-4"])
        self.money:SetPoint("TOPRIGHT", self.rule, "BOTTOMRIGHT", 0, -S["space-4"])
    end
    local h = y + content:GetHeight() + S["space-4"] + 1 + S["space-4"] + foot
    self.body:SetSize(self:GridWidth(), h)
end

-- A small square button with a glyph (sort).
local function glyphButton(parent: Frame, glyph: string, tip: any): GlyphButton
    local b: GlyphButton = CreateFrame("Button", nil, parent) :: any
    b:SetSize(30, 30)
    draw.fill(b, "surface-raised", "BACKGROUND"):SetAllPoints()
    b.edge = draw.border(b, "gilt-line")
    b.glyph = b:CreateTexture(nil, "ARTWORK")
    b.glyph:SetTexture(GLYPHS .. glyph .. ".tga")
    b.glyph:SetSize(16, 16)
    b.glyph:SetPoint("CENTER")
    draw.paint(b.glyph, "ink")
    b.tip = tip
    b:SetScript("OnEnter", function(self: GlyphButton)
        if self:IsEnabled() then self.edge:SetColor("gilt") end
        if self.tip then tooltip.showTooltip(self, self.tip) end
    end)
    b:SetScript("OnLeave", function(self: GlyphButton) self.edge:SetColor("gilt-line"); tooltip.hideTooltip() end)
    hook(b, "SetEnabled", function(self: any, on: any) self:SetAlpha(on and 1 or T.opacity["opacity-disabled"]) end)
    return b
end

-- The header's character picker, the Bags/Bank and All characters row, the
-- banner and the found items.
local function buildCharacters(inv: Inventory, body: Frame)
    local title = inv.title :: Text
    title:Hide()
    local who = selectModule.select(inv, { bare = true, width = 220, textStyle = "header", textColor = "gilt-text", options = {} })
    inv.who = who
    who:SetPoint("LEFT", inv, "TOPLEFT", S["space-5"] - S["space-2"], -(S["space-5"] + T.type.header.lineHeight / 2))
    local pickRow = CreateFrame("Frame", nil, body)
    inv.pickRow = pickRow
    pickRow:SetSize(1, ROW)
    local view = inputs.segmented(pickRow, { value = "bags", options = { { value = "bags", label = "Bags" }, { value = "bank", label = "Bank" } } })
    inv.view = view
    view:SetPoint("LEFT")
    local allLabel = uiText.text(body, "label", "ink-muted")
    inv.allLabel = allLabel
    allLabel:SetValue("All characters")
    local all = inputs.toggle(body, { value = false })
    inv.all = all
    all:SetPoint("RIGHT", pickRow, "LEFT", inv:GridWidth(), 0)
    allLabel:SetPoint("RIGHT", all, "LEFT", -S["space-4"], 0)
    local banner: Banner = CreateFrame("Frame", nil, body) :: any
    inv.banner = banner
    banner:SetSize(inv:GridWidth(), T.type.caption.lineHeight)
    banner.eye = banner:CreateTexture(nil, "ARTWORK")
    banner.eye:SetTexture(GLYPHS .. "eye.tga")
    banner.eye:SetSize(12, 12)
    banner.eye:SetPoint("LEFT")
    draw.paint(banner.eye, "ink-muted")
    banner.text = uiText.text(banner, "caption", "ink-muted")
    banner.text:SetPoint("LEFT", banner.eye, "RIGHT", S["space-3"], 0)
    banner:Hide()
    local results = CreateFrame("Frame", nil, body)
    inv.results = results
    results:SetSize(inv:GridWidth(), SLOT)
    results:Hide()
    inv.resultRows = {}
end

-- opts: { title, columns, name, sortTip, characters }
export type InventoryOptions = { title?: string, columns?: number, name?: string, sortTip?: string, characters?: boolean }

export function inventory(parent: Frame, opts: InventoryOptions?): Inventory
    local o: InventoryOptions = opts or {}
    local columns = o.columns or 10
    local inv: Inventory = panel.panel(parent, { name = o.name, title = o.title or "Bags", meta = "", closable = true,
        onClose = function(p: any) if p.onClose then p.onClose() else p:Hide() end end }) :: any
    Mixin(inv, Inv)
    inv.columns = columns
    local body = inv.body
    -- search and sort
    inv.sort = glyphButton(body, "sort", { title = "Sort", description = o.sortTip or "Blizzard's own sort: stacks and orders your items." })
    inv.sort:SetPoint("TOPRIGHT")
    inv.search = inputs.textField(body, { width = inv:GridWidth() - 30 - S["space-3"], placeholder = "Search" })
    inv.search:SetPoint("TOPLEFT")
    -- the grid
    inv.grid = CreateFrame("Frame", nil, body)
    inv.grid:SetWidth(inv:GridWidth())
    inv.grid:SetHeight(SLOT)
    if o.characters then buildCharacters(inv, body) end
    -- the foot: a note and the money, over a gilt-faint rule
    inv.rule = body:CreateTexture(nil, "ARTWORK")
    draw.paintFill(inv.rule, "gilt-faint")
    inv.rule:SetHeight(1)
    inv.note = uiText.text(body, "caption", "ink-muted")
    inv.money = money(body)
    inv.money:Hide() -- until SetMoney: a bank holds no money
    inv:FitBody()
    extend.add(extend.Kind.Inventory, inv, { name = o.name })
    live[inv] = "inventory"
    return inv
end

-- A theme can change the coin colours and the caption style the rows are
-- measured in. (The section heads follow when the owner lays the slots out
-- again: Bags does on the same message.)
events.on("SUUUI_THEME_CHANGED", function()
    for f, kind in pairs(live) do
        if kind == "money" then
            local m = f :: Money
            m:SetCopper(m.copper)
        else
            local inv = f :: Inventory
            inv:FitBody()
        end
    end
end, "UI.Inventory")

-- After `columns` changed: the widths that follow it.
function Inv:SetColumns(columns: number)
    self.columns = columns
    local w = self:GridWidth()
    self.search:SetWidth(w - 30 - S["space-3"])
    self.grid:SetWidth(w)
    local all = self.all
    if all then
        local banner = self.banner :: Banner
        all:SetPoint("RIGHT", self.pickRow :: Frame, "LEFT", w, 0)
        banner:SetWidth(w)
    end
    self:FitBody()
end
