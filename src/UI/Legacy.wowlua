-- UI/Legacy.wowlua
-- The Legacy window's pages (design boards "Legacy · Tree / Challenges /
-- Reward track"): Forever's account progression.
--
--   legacyPoints(parent):SetPoints({ earned, total, spent, cap, pending, character })
--     "Legacy points · account  16 of 81 earned", "Spent on Veyra  9 of 16"
--     (the design's pips left out: the numbers say it, asked for in game)
--   legacyChallenges(parent):SetCategories(list)
--     list = { { name, done, total, items = { item }, groups = { { name, items } } } }
--     item = { name, done, progress ("45/150"), points, onEnter(owner), onLeave() }
--     six cards, three to a row: a category's done/total, its bar and the
--     challenges you're closest to (up to five); a card opens its full list
--     (scrolling, by sub-category), "All challenges" goes back
--   legacyTrack(parent):SetTrack({ earned, total, max, next, stops = { stop } })
--     stop = { at, icon, quality, collected, onEnter(owner), onLeave() }
--       (its name goes in the tooltip onEnter shows)
--     a strip for the window's foot: the account's points and the rewards

import colorize from "wowlua:color"
import tokens as T from "/Core/Tokens"
import * as events from "/Core/Events"
import SuuUI from "/Core/API"
import * as controls from "/UI/Controls"
import SuuButton from "/UI/Controls"
import * as draw from "/UI/Draw"
import * as inventory from "/UI/Inventory"
import ItemSlot from "/UI/Inventory"
import * as panel from "/UI/Panel"
import ScrollArea from "/UI/Panel"
import * as uiText from "/UI/Text"
import Text from "/UI/Text"

local S = T.space

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local function hex(token: string): string return T.color[token].hex end

--------------------------------------------------------------------------------
-- The data (see the header)
--------------------------------------------------------------------------------

export type LegacyPointsData = { earned?: number, total?: number, spent?: number, cap?: number, pending?: number,
    character?: string }

-- A challenge: its name, done, its progress ("45/150", or a count { done,
-- of }), its Legacy points; one with steps (achievement criteria) opens to
-- show them (`steps()` gives them when it does).
export type Challenge = {
    id?: number | string,
    name?: string,
    done?: boolean,
    progress?: string,
    points?: number,
    count?: number[],
    stepsN?: number,
    stepsDone?: number,
    steps?: () -> ChallengeStep[],
    onEnter?: (owner: Frame) -> (),
    onLeave?: () -> (),
}

-- A step of a challenge: a text done or to do, or an achievement with steps
-- of its own.
export type ChallengeStep = {
    id?: number | string,
    text?: string,
    done?: boolean,
    count?: number[],
    stepsN?: number,
    stepsDone?: number,
    steps?: () -> ChallengeStep[],
}

export type ChallengeGroup = { name: string, done: number, items: Challenge[] }

export type ChallengeCategory = { name?: string, done?: number, total?: number, items?: Challenge[], groups?: ChallengeGroup[] }

-- A reward on the track (its name goes in the tooltip onEnter shows).
export type TrackStop = { at?: number, icon?: number | string, quality?: string, collected?: boolean,
    onEnter?: (owner: Frame) -> (), onLeave?: () -> () }

export type TrackData = { earned?: number, total?: number, max?: number, next?: string, stops?: TrackStop[] }

-- built pages, drawn again on a theme change
local livePoints: { [LegacyPoints]: boolean } = setmetatable({}, { __mode = "k" })
local liveChallenges: { [LegacyChallenges]: boolean } = setmetatable({}, { __mode = "k" })
local liveTracks: { [LegacyTrack]: boolean } = setmetatable({}, { __mode = "k" })

-- Big tabular figures (the design's 20px numbers).
local function bigNumber(parent: Frame): Text
    local fs = uiText.text(parent, "numeric", "ink")
    local spec = T.type.numeric
    fs:SetFont(spec.file, 20, "")
    return fs
end

--------------------------------------------------------------------------------
-- The points
--------------------------------------------------------------------------------

local function blockHeight(): number return T.type.caption.lineHeight + 1 + 24 end

-- A caption over a big number and what follows it.
class PointsBlock extends Frame
    readonly caption: Text
    readonly big: Text
    readonly rest: Text

    constructor(f: Frame, caption: string)
        super(nil, f)
        self.caption = uiText.text(self, "caption", "ink-muted")
        self.caption:SetPoint("TOPLEFT")
        self.caption:SetValue(caption)
        self.big = bigNumber(self)
        self.big:SetPoint("TOPLEFT", self.caption, "BOTTOMLEFT", 0, -1)
        self.rest = uiText.text(self, "caption", "ink-muted")
        self.rest:SetPoint("BOTTOMLEFT", self.big, "BOTTOMRIGHT", 0, 3)
        self:SetHeight(blockHeight())
    end

    -- after a theme change: the caption's height and the numbers' face
    function Restyle()
        self:SetHeight(blockHeight())
        self.big:SetFont(T.type.numeric.file, 20, "")
    end
end

-- opts.account = false: this character's points only (the account's are
-- on the track at the window's foot)
export type LegacyPointsOptions = { account?: boolean }

export class LegacyPoints extends Frame
    account: PointsBlock
    char: PointsBlock
    data: LegacyPointsData? = nil

    constructor(parent: Frame, opts: LegacyPointsOptions?)
        super(nil, parent)
        self.account = PointsBlock.new(self, "Legacy points · account")
        self.account:SetPoint("TOPLEFT")
        self.char = PointsBlock.new(self, "Spent on this character")
        if opts and opts.account == false then
            self.account:Hide()
            self.char:SetPoint("TOPLEFT")
        else
            self.char:SetPoint("TOPLEFT", self.account, "TOPRIGHT", S["space-6"], 0)
        end
        self.char:SetWidth(200)
        self:SetHeight(self.account:GetHeight())
        livePoints[self] = true
    end

    function SetPoints(data: LegacyPointsData?)
        local d = data or {}
        self.data = d
        local earned, total = d.earned or 0, d.total or 0
        local spent, cap, pending = d.spent or 0, d.cap or 0, d.pending or 0
        self.account.big:SetText(tostring(earned))
        self.account.rest:SetText(" of " .. total .. " earned")
        self.char.caption:SetValue("Spent on " .. (d.character or "this character"))
        self.char.big:SetText(tostring(spent))
        self.char.rest:SetText(" of " .. cap .. (pending > 0 and colorize(hex("arcane"), " · " .. pending .. " not applied") or ""))
        local w = math.max(self.account.caption:GetUnboundedStringWidth(),
            self.account.big:GetUnboundedStringWidth() + self.account.rest:GetUnboundedStringWidth())
        self.account:SetWidth(math.ceil(w) + 2)
    end
end

export function legacyPoints(parent: Frame, opts: LegacyPointsOptions?): LegacyPoints
    return LegacyPoints.new(parent, opts)
end

--------------------------------------------------------------------------------
-- A challenge row: a check (done) or a bullet, the name, its progress, its
-- Legacy points
--------------------------------------------------------------------------------

local ROW_H = T.type.body.lineHeight + 2

class ChallengeRow extends Frame
    readonly check: Texture
    readonly bullet: Texture
    readonly worth: Text
    readonly progress: Text
    readonly name: Text
    item: Challenge? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(ROW_H)
        self:EnableMouse(true)
        self.check = self:CreateTexture(nil, "ARTWORK")
        self.check:SetTexture(GLYPHS .. "check.tga")
        self.check:SetSize(11, 11)
        self.check:SetPoint("LEFT", 0, 0)
        draw.paint(self.check, "ink-muted")
        self.bullet = draw.diamond(self, 4, "ink-muted", "ARTWORK", 1)
        self.bullet:SetPoint("CENTER", self, "LEFT", 5, 0)
        self.worth = uiText.text(self, "caption", "ink-muted")
        self.worth:SetPoint("RIGHT", self, "RIGHT", 0, 0)
        self.progress = uiText.text(self, "numeric", "ink")
        self.progress:SetPoint("RIGHT", self.worth, "LEFT", -S["space-3"], 0)
        self.name = uiText.text(self, "body", "ink")
        self.name:SetPoint("LEFT", self, "LEFT", 12 + S["space-3"], 0)
        self.name:SetPoint("RIGHT", self.progress, "LEFT", -S["space-3"], 0)
        self.name:SetJustifyH("LEFT")
        self:SetScript("OnEnter", function()
            local enter = self.item and self.item.onEnter
            if enter then enter(self) end
        end)
        self:SetScript("OnLeave", function()
            local leave = self.item and self.item.onLeave
            if leave then leave() end
        end)
    end

    function Fill(item: Challenge)
        self.item = item
        self.check:SetShown(item.done == true)
        self.bullet:SetShown(not item.done)
        self.name:SetValue(item.name or "")
        self.name:SetColor(item.done and "ink-muted" or "ink")
        self.progress:SetValue(item.progress or "")
        self.worth:SetValue(item.points and ("+" .. item.points) or "")
    end
end

--------------------------------------------------------------------------------
-- Challenges
--------------------------------------------------------------------------------

local CARD_ROWS = 5
local COLS = 3

local function cardHeight(): number
    return S["space-4"] * 2 + T.type.header.lineHeight + S["space-3"] + 6 + S["space-3"]
        + CARD_ROWS * (ROW_H + S["space-2"]) + T.type.caption.lineHeight
end
-- (the heights at load; a theme change updates the public copies, SuuUI.UI's)
export const LEGACY_CARD_H: number = cardHeight()

-- A category's card: its done/total, its bar and the challenges you're
-- closest to; a click opens its full list.
class CategoryCard extends Button
    readonly border: draw.Border
    readonly name: Text
    readonly count: Text
    readonly track: Texture
    readonly fill: Texture
    readonly rows: ChallengeRow[] = {}
    readonly all: Text
    index: number = 0
    data: ChallengeCategory? = nil

    constructor(view: LegacyChallenges)
        super(nil, view.grid)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        self.border = draw.border(self, "gilt-faint")
        self.name = uiText.text(self, "header", "gilt-text")
        self.name:SetPoint("TOPLEFT", S["space-4"], -S["space-4"])
        self.count = uiText.text(self, "caption", "ink-muted")
        self.count:SetPoint("TOPRIGHT", -S["space-4"], -S["space-4"] - 2)
        self.track = draw.fill(self, "track", "ARTWORK")
        self.track:SetHeight(6)
        self.track:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -S["space-3"])
        self.track:SetPoint("RIGHT", self, "RIGHT", -S["space-4"], 0)
        self.fill = draw.fill(self, "progress-fill", "ARTWORK", 1)
        self.fill:SetHeight(6)
        self.fill:SetPoint("TOPLEFT", self.track, "TOPLEFT")
        self.all = uiText.text(self, "caption", "gilt-text")
        self.all:SetPoint("BOTTOMLEFT", S["space-4"], S["space-4"])
        self:SetScript("OnEnter", function() self.border:SetColor("gilt-line") end)
        self:SetScript("OnLeave", function() self.border:SetColor("gilt-faint") end)
        self:SetScript("OnClick", function() view:Open(self.index) end)
    end
end

--------------------------------------------------------------------------------
-- One category's full list (asked for in game: groups you can't miss, real
-- progress, a back button you can't miss): a bar with "All challenges", the
-- category and its progress; each sub-category its own panel (small ones two
-- to a row); a challenge with steps opens to show each step done or to do.
--------------------------------------------------------------------------------

local BAR_W = 64      -- a challenge's progress bar
local STEP_W = 168    -- a step's column
local STEP_H = T.type.body.lineHeight
local INDENT = 12 + S["space-3"]

-- a thin bar: track and fill
class ThinBar extends Frame
    readonly track: Texture
    readonly fill: Texture
    fraction: number? = nil

    constructor(parent: Frame, h: number?)
        super(nil, parent)
        self:SetHeight(h or 3)
        self.track = draw.fill(self, "track", "ARTWORK")
        self.track:SetAllPoints()
        self.fill = draw.fill(self, "progress-fill", "ARTWORK", 1)
        self.fill:SetPoint("TOPLEFT")
        self.fill:SetPoint("BOTTOMLEFT")
        self:SetScript("OnSizeChanged", function()
            local f = self.fraction
            if f then self:SetFraction(f) end
        end)
    end

    function SetFraction(given: number?)
        local f = math.max(0, math.min(1, given or 0))
        local w = self:GetWidth()
        self.fill:SetShown(f > 0 and w ~= nil and w > 0)
        if w and w > 0 then self.fill:SetWidth(math.max(0.01, w * f)) end
        self.fraction = f
    end
end

-- a step: a check (done, muted) or a hollow diamond (to do, bright), its text
class StepCell extends Frame
    readonly check: Texture
    readonly ring: Texture
    readonly hole: Texture
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(STEP_W, STEP_H)
        self.check = self:CreateTexture(nil, "ARTWORK")
        self.check:SetTexture(GLYPHS .. "check.tga")
        self.check:SetSize(10, 10)
        self.check:SetPoint("LEFT", 0, 0)
        draw.paint(self.check, "ink-muted")
        self.ring = draw.diamond(self, 7, "gilt-line", "ARTWORK", 1)
        self.ring:SetPoint("CENTER", self, "LEFT", 5, 0)
        self.hole = draw.diamond(self, 4, "surface-sunk", "ARTWORK", 2)
        self.hole:SetPoint("CENTER", self.ring, "CENTER")
        self.text = uiText.text(self, "body", "ink")
        self.text:SetPoint("LEFT", self, "LEFT", 16, 0)
        self.text:SetPoint("RIGHT", self, "RIGHT", -S["space-3"], 0)
        self.text:SetJustifyH("LEFT")
    end
end

-- a challenge in a panel: open/closed chevron (with steps), check or bullet,
-- the name, its progress with a bar, its Legacy points
class DetailRow extends Button
    readonly hover: Texture
    readonly chevron: Texture
    readonly check: Texture
    readonly bullet: Texture
    readonly worth: Text
    readonly bar: ThinBar
    readonly progress: Text
    readonly name: Text
    item: Challenge? = nil

    constructor(view: LegacyChallenges, parent: Frame)
        super(nil, parent)
        self:SetHeight(ROW_H + 2)
        self.hover = draw.fill(self, "gilt-faint", "BACKGROUND", 1)
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.chevron = self:CreateTexture(nil, "ARTWORK")
        self.chevron:SetSize(10, 10)
        self.chevron:SetPoint("LEFT", 0, 0)
        draw.paint(self.chevron, "gilt-text")
        self.check = self:CreateTexture(nil, "ARTWORK")
        self.check:SetTexture(GLYPHS .. "check.tga")
        self.check:SetSize(11, 11)
        self.check:SetPoint("LEFT", 0, 0)
        draw.paint(self.check, "ink-muted")
        self.bullet = draw.diamond(self, 4, "ink-muted", "ARTWORK", 1)
        self.bullet:SetPoint("CENTER", self, "LEFT", 5, 0)
        self.worth = uiText.text(self, "caption", "gilt-text")
        self.worth:SetPoint("RIGHT", self, "RIGHT", -S["space-2"], 0)
        self.bar = ThinBar.new(self, 3)
        self.bar:SetWidth(BAR_W)
        self.bar:SetPoint("RIGHT", self.worth, "LEFT", -S["space-5"], 0)
        self.progress = uiText.text(self, "numeric", "ink")
        self.progress:SetPoint("RIGHT", self.bar, "LEFT", -S["space-4"], 0)
        self.name = uiText.text(self, "body", "ink")
        self.name:SetPoint("LEFT", self, "LEFT", INDENT, 0)
        self.name:SetPoint("RIGHT", self.progress, "LEFT", -S["space-4"], 0)
        self.name:SetJustifyH("LEFT")
        self:SetScript("OnEnter", function()
            local item = self.item
            if item and item.stepsN then self.hover:Show() end
            local enter = item and item.onEnter
            if enter then enter(self) end
        end)
        self:SetScript("OnLeave", function()
            self.hover:Hide()
            local leave = self.item and self.item.onLeave
            if leave then leave() end
        end)
        self:SetScript("OnClick", function()
            local item = self.item
            local id = item and item.stepsN and item.id
            if not id then return end
            view.expanded[id] = not view.expanded[id]
            view:Open(view.openIndex or 0, true)
        end)
    end

    function Fill(view: LegacyChallenges, item: Challenge)
        self.item = item
        local stepsN = item.stepsN
        local steps = stepsN ~= nil and stepsN > 1
        local id = item.id
        local open = steps and id ~= nil and view.expanded[id] == true
        self.chevron:SetShown(steps and not item.done)
        self.chevron:SetTexture(GLYPHS .. (open and "chevronDown" or "chevronRight") .. ".tga")
        self.check:SetShown(item.done == true)
        self.bullet:SetShown(not item.done and not steps)
        self.name:SetValue(item.name or "")
        self.name:SetColor(item.done and "ink-muted" or "ink")
        -- progress: steps done, or the count
        local frac: number?
        local count = item.count
        if item.done then
            self.progress:SetValue("")
        elseif stepsN and steps then
            self.progress:SetValue((item.stepsDone or 0) .. "/" .. stepsN)
            frac = (item.stepsDone or 0) / stepsN
        elseif count then
            self.progress:SetValue(count[1] .. "/" .. count[2])
            frac = count[1] / count[2]
        else
            self.progress:SetValue("")
        end
        self.bar:SetShown(frac ~= nil)
        if frac then self.bar:SetFraction(frac) end
        self.worth:SetValue(item.points and ("+" .. item.points) or "")
        self.worth:SetColor(item.done and "ink-muted" or "gilt-text")
    end
end

local PANEL_PAD = S["space-5"]
local PANEL_HEAD = T.type.header.lineHeight + S["space-3"] + 3 + S["space-4"]

-- A sub-category's panel: its name, count and bar, its challenges and the
-- open ones' steps.
class GroupPanel extends Frame
    readonly name: Text
    readonly count: Text
    readonly bar: ThinBar
    readonly rows: DetailRow[] = {}
    readonly steps: StepCell[] = {}
    readonly subrows: DetailRow[] = {}
    stepIndex: number = 0
    subIndex: number = 0

    constructor(parent: Frame)
        super(nil, parent)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        draw.border(self, "gilt-faint")
        self.name = uiText.text(self, "header", "gilt-text")
        self.name:SetPoint("TOPLEFT", PANEL_PAD, -PANEL_PAD)
        self.count = uiText.text(self, "caption", "ink-muted")
        self.count:SetPoint("TOPRIGHT", -PANEL_PAD, -PANEL_PAD - 2)
        self.bar = ThinBar.new(self, 3)
        self.bar:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -S["space-3"])
        self.bar:SetPoint("RIGHT", self, "RIGHT", -PANEL_PAD, 0)
    end

    -- Its rows and open steps; returns its height.
    function Fill(view: LegacyChallenges, g: ChallengeGroup, width: number, category: string): number
        self:SetWidth(width)
        self.name:SetValue(g.name ~= "" and g.name or category)
        self.count:SetValue(g.done .. "/" .. #g.items)
        self.bar:SetFraction(#g.items > 0 and g.done / #g.items or 0)
        local y = PANEL_PAD + PANEL_HEAD
        local inner = width - PANEL_PAD * 2
        self.stepIndex, self.subIndex = 0, 0
        for k, item in ipairs(g.items) do
            local r = self.rows[k] or DetailRow.new(view, self)
            self.rows[k] = r
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", self, "TOPLEFT", PANEL_PAD, -y)
            r:SetWidth(inner)
            r:Fill(view, item)
            r:Show()
            y = y + ROW_H + 2 + S["space-1"]
            local id, steps = item.id, item.steps
            if item.stepsN and id and view.expanded[id] and steps then
                y = view:LayoutSteps(self, steps(), PANEL_PAD + INDENT, y, inner - INDENT)
            end
        end
        for k = #g.items + 1, #self.rows do self.rows[k]:Hide() end
        for k = self.stepIndex + 1, #self.steps do self.steps[k]:Hide() end
        for k = self.subIndex + 1, #self.subrows do self.subrows[k]:Hide() end
        local h = y + PANEL_PAD - S["space-1"]
        self:SetHeight(h)
        return h
    end
end

export class LegacyChallenges extends Frame
    cards: CategoryCard[] = {}
    grid: Frame
    expanded: { [number | string]: boolean } = {}
    panels: GroupPanel[] = {}
    detail: Frame
    back: SuuButton
    backChevron: Texture
    detailTitle: Text
    detailCount: Text
    detailBar: ThinBar
    scroll: ScrollArea
    list: ChallengeCategory[] = {}
    openIndex: number? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.grid = CreateFrame("Frame", nil, self)
        self.grid:SetAllPoints()
        -- the full list of one category: a bar with the way back, the panels
        self.detail = CreateFrame("Frame", nil, self)
        self.detail:SetAllPoints()
        self.detail:Hide()
        local back = controls.button(self.detail, { text = "All challenges", variant = "quiet", onClick = function() self:Close() end })
        self.back = back
        local backW = back.label:GetUnboundedStringWidth() + S["space-5"] * 2 + 14
        back.fixedWidth = backW
        back:SetWidth(backW)
        back.label:ClearAllPoints()
        back.label:SetPoint("CENTER", 7, 0)
        -- the press moves the label 1px down: keep it beside the chevron
        back:HookScript("OnMouseDown", function() if back:IsEnabled() then back.label:SetPoint("CENTER", 7, -1) end end)
        back:HookScript("OnMouseUp", function() back.label:SetPoint("CENTER", 7, 0) end)
        local chevron = back:CreateTexture(nil, "OVERLAY")
        chevron:SetTexture(GLYPHS .. "chevronLeft.tga")
        chevron:SetSize(10, 10)
        chevron:SetPoint("LEFT", S["space-5"], 0)
        draw.paint(chevron, "gilt-text")
        self.backChevron = chevron
        back:SetPoint("TOPLEFT")
        self.detailTitle = uiText.text(self.detail, "header", "gilt-text")
        self.detailTitle:SetPoint("LEFT", back, "RIGHT", S["space-6"], 0)
        self.detailCount = uiText.text(self.detail, "caption", "ink-muted")
        self.detailCount:SetPoint("LEFT", self.detailTitle, "RIGHT", S["space-4"], 0)
        self.detailBar = ThinBar.new(self.detail, 4)
        self.detailBar:SetPoint("LEFT", self.detailCount, "RIGHT", S["space-5"], 0)
        self.detailBar:SetPoint("RIGHT", self.detail, "RIGHT", 0, 0)
        self.scroll = panel.scrollArea(self.detail, 6)
        self.scroll:SetPoint("TOPLEFT", back, "BOTTOMLEFT", 0, -S["space-5"])
        self.scroll:SetPoint("BOTTOMRIGHT", self.detail, "BOTTOMRIGHT", -10, 0)
        self:SetScript("OnSizeChanged", function() self:Layout() end)
        liveChallenges[self] = true
    end

    function Layout()
        local w = self:GetWidth()
        if not w or w <= 0 then return end
        local gap = S["space-5"]
        local cw = math.floor((w - gap * (COLS - 1)) / COLS)
        local ch = cardHeight()
        for i, c in ipairs(self.cards) do
            local col, row = (i - 1) % COLS, math.floor((i - 1) / COLS)
            c:ClearAllPoints()
            c:SetPoint("TOPLEFT", self.grid, "TOPLEFT", col * (cw + gap), -row * (ch + gap))
            c:SetSize(cw, ch)
            -- the bar as far as done of total
            local d = c.data
            local total = d and d.total
            local frac = (d and total and total > 0) and ((d.done or 0) / total) or 0
            local trackW = cw - S["space-4"] * 2
            c.fill:SetWidth(math.max(0.01, trackW * math.min(1, frac)))
            c.fill:SetShown(frac > 0)
        end
    end

    function SetCategories(list: ChallengeCategory[]?)
        local categories = list or {}
        self.list = categories
        for i, d in ipairs(categories) do
            local c = self.cards[i] or CategoryCard.new(self)
            self.cards[i] = c
            c.index, c.data = i, d
            c.name:SetValue(d.name or "")
            c.count:SetValue((d.done or 0) .. "/" .. (d.total or 0))
            for k = 1, CARD_ROWS do
                local item = d.items and d.items[k]
                local r = c.rows[k]
                if item then
                    if not r then
                        r = ChallengeRow.new(c)
                        c.rows[k] = r
                        r:SetPoint("TOPLEFT", c.track, "BOTTOMLEFT", 0, -S["space-3"] - (k - 1) * (ROW_H + S["space-2"]))
                        r:SetPoint("RIGHT", c, "RIGHT", -S["space-4"], 0)
                    end
                    r:Fill(item)
                    r:Show()
                elseif r then
                    r:Hide()
                end
            end
            local more = (d.total or 0) - math.min(CARD_ROWS, #(d.items or {}))
            c.all:SetValue(more > 0 and ("All " .. (d.total or 0) .. " challenges") or "")
            c:Show()
        end
        for i = #categories + 1, #self.cards do self.cards[i]:Hide() end
        self:Layout()
        -- a refresh (progress changed) keeps the open list where it was scrolled
        if self.openIndex then self:Open(self.openIndex, true) end
    end

    -- Open steps from x, y: steps that are achievements as rows (they open in
    -- turn, one step further in), the others in columns; returns the new y.
    function LayoutSteps(p: GroupPanel, list: ChallengeStep[], x: number, y: number, width: number): number
        local plainSteps: ChallengeStep[] = {}
        local function grid()
            if #plainSteps == 0 then return end
            local cols = math.max(1, math.floor(width / STEP_W))
            for n, step in ipairs(plainSteps) do
                p.stepIndex = p.stepIndex + 1
                local c = p.steps[p.stepIndex] or StepCell.new(p)
                p.steps[p.stepIndex] = c
                local col, row = (n - 1) % cols, math.floor((n - 1) / cols)
                c:ClearAllPoints()
                c:SetPoint("TOPLEFT", p, "TOPLEFT", x + col * STEP_W, -(y + S["space-1"] + row * STEP_H))
                c.check:SetShown(step.done == true)
                c.ring:SetShown(not step.done)
                c.hole:SetShown(not step.done)
                local label = step.text or ""
                local count = step.count
                if count then label = label .. "  " .. colorize(hex("ink-muted"), count[1] .. "/" .. count[2]) end
                c.text:SetValue(label)
                c.text:SetColor(step.done and "ink-muted" or "ink")
                c:Show()
            end
            y = y + S["space-1"] + math.ceil(#plainSteps / cols) * STEP_H + S["space-3"]
            plainSteps = {}
        end
        for _, step in ipairs(list) do
            local steps = step.steps
            if steps then
                grid()
                p.subIndex = p.subIndex + 1
                local r = p.subrows[p.subIndex] or DetailRow.new(self, p)
                p.subrows[p.subIndex] = r
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", p, "TOPLEFT", x, -y)
                r:SetWidth(width)
                r:Fill(self, { id = step.id, name = step.text, done = step.done,
                    stepsN = step.stepsN, stepsDone = step.stepsDone, steps = steps })
                r:Show()
                y = y + ROW_H + 2 + S["space-1"]
                local id = step.id
                if id and self.expanded[id] and not step.done then
                    y = self:LayoutSteps(p, steps(), x + INDENT, y, width - INDENT)
                end
            else
                plainSteps[#plainSteps + 1] = step
            end
        end
        grid()
        return y
    end

    function Open(i: number, keep: boolean?)
        local d = self.list[i]
        if not d then return self:Close() end
        self.openIndex = i
        self.grid:Hide()
        self.detail:Show()
        self.detailTitle:SetValue(d.name or "")
        self.detailCount:SetValue((d.done or 0) .. "/" .. (d.total or 0))
        local total = d.total or 0
        self.detailBar:SetFraction(total > 0 and (d.done or 0) / total or 0)
        local scroll = self.scroll
        local offset = keep and scroll:GetVerticalScroll() or 0
        local child = scroll.child
        local W = math.max(1, scroll:GetWidth() - S["space-5"])
        child:SetWidth(W)
        local gap = S["space-5"]
        local half = math.floor((W - gap) / 2)
        local category = d.name or ""
        -- small groups two to a row, the rest the full width
        local y: number, k: number, pending: number? = 0, 0, nil
        local function flush()
            if pending then y = y + pending + gap; pending = nil end
        end
        for _, g in ipairs(d.groups or {}) do
            k = k + 1
            local p = self.panels[k] or GroupPanel.new(child)
            self.panels[k] = p
            local wide = #g.items > 4
            for _, item in ipairs(g.items) do if item.stepsN and item.stepsN > 1 then wide = true end end
            p:ClearAllPoints()
            if wide then
                flush()
                local h = p:Fill(self, g, W, category)
                p:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -y)
                y = y + h + gap
            elseif pending then
                local h = p:Fill(self, g, half, category)
                p:SetPoint("TOPLEFT", child, "TOPLEFT", half + gap, -y)
                pending = math.max(pending, h)
                flush()
            else
                local h = p:Fill(self, g, half, category)
                p:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -y)
                pending = h
            end
            p:Show()
        end
        flush()
        for n = k + 1, #self.panels do self.panels[n]:Hide() end
        child:SetHeight(math.max(1, y - gap))
        scroll:SetVerticalScroll(keep and math.min(offset, math.max(0, y - scroll:GetHeight())) or 0)
    end

    function Close()
        self.openIndex = nil
        self.detail:Hide()
        self.grid:Show()
    end
end

export function legacyChallenges(parent: Frame): LegacyChallenges
    return LegacyChallenges.new(parent)
end

--------------------------------------------------------------------------------
-- The reward track: a strip along the window's foot (asked for in game, in
-- place of its own tab): the account's points on the left, then the bar
-- with a diamond at each reward's level, the reward's icon above it (dim
-- until reached, a check once collected) and the level under it; the next
-- reward under the bar. Names are in the icons' tooltips.
--------------------------------------------------------------------------------

local ICON = 24
local LEFT_W = 150
local TRACK_TOP = ICON + S["space-3"]
local function trackHeight(): number
    return TRACK_TOP + 6 + S["space-3"] + T.type.numeric.lineHeight + S["space-2"] + T.type.caption.lineHeight
end
local trackH = trackHeight()
export const LEGACY_TRACK_H: number = trackH

-- A reward on the track: its icon, a check once collected, the diamond on
-- the bar and its level under it.
class StopMark extends Frame
    readonly slot: ItemSlot
    readonly over: Frame
    readonly check: Texture
    readonly mark: Texture
    readonly at: Text
    stop: TrackStop? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(ICON, trackH)
        local slot = inventory.itemSlot(self, ICON)
        self.slot = slot
        slot:SetPoint("TOP", self, "TOP", 0, 0)
        slot:SetScript("OnEnter", function()
            local enter = self.stop and self.stop.onEnter
            if enter then enter(slot) end
        end)
        slot:SetScript("OnLeave", function()
            local leave = self.stop and self.stop.onLeave
            if leave then leave() end
        end)
        self.over = CreateFrame("Frame", nil, slot)
        self.over:SetAllPoints()
        self.over:SetFrameLevel(slot:GetFrameLevel() + 5)
        self.check = self.over:CreateTexture(nil, "OVERLAY", nil, 7)
        self.check:SetTexture(GLYPHS .. "check.tga")
        self.check:SetSize(10, 10)
        self.check:SetPoint("TOPRIGHT", slot, "TOPRIGHT", 3, 3)
        draw.paint(self.check, "fel")
        self.mark = draw.diamond(self, 9, "gilt-line", "OVERLAY", 3)
        self.mark:SetPoint("CENTER", self, "TOP", 0, -(TRACK_TOP + 3))
        self.at = uiText.text(self, "numeric", "ink-muted")
        self.at:SetPoint("TOP", self, "TOP", 0, -(TRACK_TOP + 6 + S["space-3"]))
    end
end

export class LegacyTrack extends Frame
    stops: StopMark[] = {}
    points: PointsBlock
    bar: Texture
    fill: Texture
    next: Text
    data: TrackData? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(trackH)
        -- the account's points
        self.points = PointsBlock.new(self, "Legacy · account")
        self.points:SetPoint("TOPLEFT", self, "TOPLEFT", 0, -(TRACK_TOP - 18))
        self.points:SetWidth(LEFT_W - 8)
        self.bar = draw.fill(self, "track", "ARTWORK")
        self.bar:SetHeight(6)
        self.fill = draw.fill(self, "progress-fill", "ARTWORK", 1)
        self.fill:SetHeight(6)
        self.fill:SetPoint("TOPLEFT", self.bar, "TOPLEFT")
        self.next = uiText.text(self, "caption", "ink-muted")
        self.next:SetPoint("BOTTOM", self, "BOTTOM", LEFT_W / 2, 0)
        self:SetScript("OnSizeChanged", function() if self.data then self:SetTrack(self.data) end end)
        liveTracks[self] = true
    end

    function SetTrack(data: TrackData?)
        local d = data or {}
        self.data = d
        local stops = d.stops or {}
        local max = (d.max and d.max > 0) and d.max or 1
        local earned = d.earned or 0
        self.points.big:SetText(tostring(earned))
        self.points.rest:SetText(" of " .. (d.total or 0) .. " earned")
        local w = self:GetWidth()
        if not w or w <= 0 then w = 800 end
        local left = LEFT_W + ICON / 2
        local inner = math.max(10, w - left - ICON / 2 - 4)
        self.bar:ClearAllPoints()
        self.bar:SetPoint("TOPLEFT", self, "TOPLEFT", left, -TRACK_TOP)
        self.bar:SetWidth(inner)
        self.fill:SetWidth(math.max(0.01, inner * math.min(1, earned / max)))
        self.fill:SetShown(earned > 0)
        for i, s in ipairs(stops) do
            local st = self.stops[i]
            if not st then
                st = StopMark.new(self)
                self.stops[i] = st
            end
            local got = earned >= (s.at or 0)
            st.stop = s
            st.slot.skin:SetItem({ icon = s.icon, quality = s.quality, dim = not got })
            draw.paint(st.mark, got and "gilt" or "gilt-line")
            st.at:SetValue(tostring(s.at or 0))
            st.at:SetColor(got and "gilt-text" or "ink-muted")
            st.check:SetShown(s.collected == true)
            st:ClearAllPoints()
            st:SetPoint("TOP", self, "TOPLEFT", left + inner * math.min(1, (s.at or 0) / max), 0)
            st:Show()
        end
        for i = #stops + 1, #self.stops do self.stops[i]:Hide() end
        self.next:SetValue(d.next or "")
    end
end

export function legacyTrack(parent: Frame): LegacyTrack
    return LegacyTrack.new(parent)
end

-- A theme can change the caption style (the heights above) and the colours
-- in the texts: measured and drawn again. (The public copies of the two
-- heights too: the Legacy window sizes itself from them.)
events.on("SUUUI_THEME_CHANGED", function()
    trackH = trackHeight()
    local public = SuuUI and SuuUI.UI
    if public then public.LEGACY_CARD_H, public.LEGACY_TRACK_H = cardHeight(), trackH end
    for f in pairs(livePoints) do
        f.account:Restyle()
        f.char:Restyle()
        f:SetHeight(f.account:GetHeight())
        if f.data then f:SetPoints(f.data) end
    end
    for f in pairs(liveChallenges) do
        f:Layout()
        if f.openIndex then f:Open(f.openIndex, true) end
    end
    for f in pairs(liveTracks) do
        f.points:Restyle()
        f:SetHeight(trackH)
        for _, st in ipairs(f.stops) do st:SetHeight(trackH) end
    end
end, "UI.Legacy")
