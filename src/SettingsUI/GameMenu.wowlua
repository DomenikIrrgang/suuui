-- SettingsUI/GameMenu.wowlua
-- A "SuuUI settings" button under the game menu (Esc). It hangs below the menu
-- rather than among Blizzard's buttons, so the menu's own layout and its
-- protected buttons are never touched. Hidden in combat.

import hookScript from "wowlua:hooks"
import * as controls from "/UI/Controls"
import * as settingsWindow from "/SettingsUI/Window"

local button = nil

local function ensure()
    if button or not GameMenuFrame then
        return
    end
    button = controls.button(GameMenuFrame, {
        text = "SuuUI settings",
        width = 200,
        onClick = function()
            HideUIPanel(GameMenuFrame)
            settingsWindow.open()
        end,
    })
    button:SetPoint("TOP", GameMenuFrame, "BOTTOM", 0, -8)
end

if GameMenuFrame then
    hookScript(GameMenuFrame, "OnShow", function()
        ensure()
        button:SetShown(not InCombatLockdown())
    end)
end
