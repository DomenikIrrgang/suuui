--------------------------------------------------------------------------------
-- Modules
--------------------------------------------------------------------------------

local STATE: { [modules.ModuleState]: string } = {
    [modules.ModuleState.Enabled] = "On",
    [modules.ModuleState.Disabled] = "Off",
    [modules.ModuleState.Errored] = "Errored",
    [modules.ModuleState.Incompatible] = "Can't load",
    [modules.ModuleState.Registered] = "Waiting for login",
}

local function moduleRow(m: modules.AnyModule): RowDef
    return {
        label = m.name,
        control = "toggle",
        namespace = m.id,
        key = "enabled",
        description = function(): string
            -- (no description: it starts the list without a hole, which made
            -- ipairs below stop before "Built in" and the state)
            local parts: string[] = {}
            if m.description then
                parts[1] = m.description
            end
            parts[#parts + 1] = m.builtIn and "Built in" or ("From " .. m.source)
            local state = STATE[m.state] or m.state
            -- 0.17: a plugin stands in for it this session
            if m.replacedBy then
                state = "Replaced by " .. m.replacedBy
            end
            if m.replaces then
                local other = modules.get(m.replaces)
                parts[#parts + 1] = "Replaces " .. (other and other.name or m.replaces :: string) .. " (after a reload)"
            end
            local retry = m.state == modules.ModuleState.Errored and m.reloadToToggle and settings.get(m.id, "enabled")
            if m.pendingReload and not retry then
                state = state .. ", " .. (m.enabledAtLoad and "off" or "on") .. " after a reload"
            end
            if retry then
                state = state .. ": " .. (m.error or "") .. ". It tries again after a reload"
            elseif m.state == modules.ModuleState.Errored then
                state = state .. ": " .. (m.error or "") .. ". Turn it off and on to try again"
            end
            parts[#parts + 1] = state
            local out: string[] = {}
            for _, p in ipairs(parts) do
                if p ~= "" then
                    out[#out + 1] = p
                end
            end
            return table.concat(out, " · ")
        end,
        disabled = function(): (boolean, string?)
            if m.state == modules.ModuleState.Incompatible then
                return true, m.name .. " " .. (m.error or "can't load") .. "."
            end
            if m.replacedBy then
                return true, m.replacedBy .. " stands in for " .. m.name .. ": turn that off to use this again."
            end
            return false, nil
        end,
    }
end

-- (said once: a module without a proper id)
local badModuleSaid = false

local function buildModules(page: registry.Page)
    page:Clear()
    local builtIn: RowDef[], plugins: RowDef[] = {}, {}
    for _, m in ipairs(modules.all()) do
        if type(m.id) == "string" then
            table.insert(m.builtIn and builtIn or plugins, moduleRow(m))
        elseif not badModuleSaid then
            -- found in game: one module's id wasn't a name, and the whole
            -- page failed to build (the settings search with it); left out,
            -- and said once so it can be traced
            badModuleSaid = true
            print(
                ("Settings › Modules: left out a module without a proper id (%s, from %s)."):format(
                    tostring(m.name),
                    tostring(m.source)
                )
            )
        end
    end
    page:AddGroup({
        title = "Built in",
        description = "A module that is off is never loaded: no frames, no events, and Blizzard's own frame stays.",
        rows = builtIn,
    })
    if #plugins > 0 then
        page:AddGroup({
            title = "Plugins",
            description = "Addons that extend SuuUI. Each one can be turned off here without touching the others.",
            rows = plugins,
        })
    end
    page:AddGroup({
        title = "Developer",
        rows = {
            {
                label = "Debug lines in chat",
                control = "toggle",
                namespace = "core",
                key = "debug",
                description = "SuuUI's own debug output. Leave it off unless you are tracking a problem down.",
            },
        },
    })
    page:Refresh()
end

registry.register({
    id = "modules",
    label = "Modules",
    category = "General",
    order = 50,
    build = function(page: registry.Page)
        buildModules(page)
        events.on(
            "SUUUI_MODULE_REGISTERED",
            function()
                buildModules(page)
            end,
            page
        )
    end,
})
