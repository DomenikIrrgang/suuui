        },
        {
            title = "Blizzard",
            rows = {
                {
                    key = "hideIssueReporter",
                    label = "Hide the issue reporter",
                    control = "toggle",
                    description = "The beta's bug report button. Off: it shows as the game places it.",
                },
            },
        },
        {
            title = "Layout",
            rows = {
                {
                    label = "Move frames",
                    control = "button",
                    text = "Edit layout",
                    description = "Drag SuuUI's frames on a snap grid. Closes by itself when combat starts.",
                    onClick = function()
                        if editMode.enter() then
                            settingsWindow.toggle()
                        end
                    end,
                },
            },
        },
        -- the first-run welcome (the welcome module), for another look
        {
            title = "Welcome",
            rows = {
                {
