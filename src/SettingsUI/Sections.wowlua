                        for _, mode in ipairs(vision.MODES) do
                            if not vision.available(mode) then
                                text = text ..
                                    " " .. (vision.LABEL[mode] :: string) .. " comes with the design's colours for it."
                            end
                        end
                        return text
                    end,
