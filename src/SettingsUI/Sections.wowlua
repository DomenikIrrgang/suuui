--------------------------------------------------------------------------------
-- Profiles
--------------------------------------------------------------------------------

local function otherProfiles(): uiSelect.SelectOption<string>[]
    local options: uiSelect.SelectOption<string>[] = {}
    for _, name in ipairs(profiles.list()) do
        if name ~= profiles.current() then
            options[#options + 1] = { value = name, label = name }
        end
    end
    return options
end

local function allProfiles(): Option[]
    local options: Option[] = {}
    for _, name in ipairs(profiles.list()) do
        options[#options + 1] = { value = name, label = name }
    end
    return options
end

-- A screen size as the player reads it: "1920x1080" -> "1920 × 1080".
local function sizeLabel(size: string): string
    return (size:gsub("x", " × "))
end

-- This profile's layouts other than the one in use.
local function otherLayouts(): uiSelect.SelectOption<string>[]
    local options: uiSelect.SelectOption<string>[] = {}
    local inUse = settings.layoutSizeInUse()
    for _, size in ipairs(settings.layoutNames()) do
        if size ~= inUse then
            options[#options + 1] = { value = size, label = sizeLabel(size) }
        end
    end
    return options
end

-- A Select of other profiles (or what `optionsOf` lists) and a button that
-- acts on the chosen one. With `confirm`, the first click arms the button
-- for a few seconds.
class PickAndAct extends Frame
    readonly select: uiSelect.Select<string>
    readonly button: controls.SuuButton
    choice: string? = nil
    timer: TimerHandle? = nil
    private optionsOf: () -> uiSelect.SelectOption<string>[]

    constructor(
        parent: Frame,
        private label: string,
        act: (name: string) -> (boolean, string?),
        confirm: boolean?,
        options: (() -> uiSelect.SelectOption<string>[])?,
        placeholder: string?
    )
        super(nil, parent)
        self.optionsOf = options or otherProfiles
        self.select = uiSelect.select(self, {
            width = 190,
            placeholder = placeholder or "Choose a profile",
            options = self.optionsOf(),
            onChange = function(v: string?)
                self.choice = v
            end,
        })
        self.select:SetPoint("LEFT")
        self.button = controls.button(self, {
            text = label,
            onClick = function(b: controls.SuuButton)
                local chosen = self.choice
                if not chosen then
                    return
                end
                if confirm and not self.timer then
                    b:SetLabel("Click again")
                    self.timer = after(3, function()
                        self.timer = nil
                        self:Disarm()
                    end)
                    return
                end
                self:Disarm()
                local ok, err = act(chosen)
                if not ok then
                    print(err)
                end
                self.choice = nil
                self.select:SetValue(nil)
                self:Refresh()
            end,
        })
        draw.layout(self, function()
            self.button:SetPoint("LEFT", self.select, "RIGHT", S["space-3"], 0)
            self:SetSize(190 + S["space-3"] + self.button:GetWidth(), 30)
        end)
        -- the list follows profiles switched, created and deleted elsewhere
        events.on(
            "SUUUI_PROFILE_CHANGED",
            function()
                self:Refresh()
            end,
            self
        )
        events.on(
            "SUUUI_PROFILES_CHANGED",
            function()
                self:Refresh()
            end,
            self
        )
        events.on(
            "SUUUI_LAYOUT_CHANGED",
            function()
                self:Refresh()
            end,
            self
        )
    end

    function Disarm()
        local timer = self.timer
        if timer then
            timer:Cancel()
            self.timer = nil
        end
        self.button:SetLabel(self.label)
    end

    function Refresh()
        local options = self.optionsOf()
        self.select:SetOptions(options)
        local still = false
        for _, o in ipairs(options) do
            if o.value == self.choice then
                still = true
            end
        end
        if not still then
            self.choice = nil
            self.select:SetValue(nil)
            self:Disarm()
        end
    end
end

-- The screen size whose layout is in use, and the others this profile keeps.
class LayoutInUse extends Frame
    readonly line: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(380, 30)
        self.line = textLine(self, "body", "ink")
        self.line:SetPoint("LEFT")
        self.line:SetWidth(380)
        self.line:SetJustifyH("LEFT")
        events.on(
            "SUUUI_LAYOUT_CHANGED",
            function()
                self:Refresh()
            end,
            self
        )
        events.on(
            "SUUUI_PROFILE_CHANGED",
            function()
                self:Refresh()
            end,
            self
        )
        self:Refresh()
    end

    function Refresh()
        local inUse = settings.layoutSizeInUse()
        local others: string[] = {}
        for _, size in ipairs(settings.layoutNames()) do
            if size ~= inUse then
                others[#others + 1] = sizeLabel(size)
            end
        end
        local now = inUse and sizeLabel(inUse) or "none"
        self.line:SetValue(#others > 0 and ("%s (also kept: %s)"):format(now, table.concat(others, ", ")) or now)
    end
end

-- A name and Create.
class NewProfile extends Frame
    readonly name: inputs.TextField
    readonly button: controls.SuuButton

    constructor(parent: Frame)
        super(nil, parent)
        self.name = inputs.textField(self, { width = 190, placeholder = "Name" })
        self.name:SetPoint("LEFT")
        -- Enter in the name field creates it too
        self.name.edit:SetScript("OnEnterPressed", function(e: EditBox)
            self:Create()
            e:ClearFocus()
        end)
        self.button = controls.button(self, {
            text = "Create",
            onClick = function()
                self:Create()
            end,
        })
        draw.layout(self, function()
            self.button:SetPoint("LEFT", self.name, "RIGHT", S["space-3"], 0)
            self:SetSize(190 + S["space-3"] + self.button:GetWidth(), 30)
        end)
    end

    function Create()
        local name = strtrim(self.name:GetValue() or "")
        local ok, err = profiles.create(name)
        if ok then
            ok, err = profiles.use(name)
        end
        if not ok then
            print(err)
        else
            self.name:SetValue("")
        end
    end
end

-- One role's profile: "Don't switch" or a profile.
local function roleRow(role: string, label: string): RowDef
    return {
        label = label,
        control = "select",
        width = 220,
        options = function(): Option[]
            local options: Option[] = { { value = "none", label = "Don't switch" } }
            for _, o in ipairs(allProfiles()) do
                options[#options + 1] = o
            end
            return options
        end,
        description = ("When you're a %s, use this profile."):format(roles.LABEL[role]),
        get = function(): unknown
            return profiles.roleProfile(role) or "none"
        end,
        set = function(v: unknown): (boolean, string?)
            return profiles.setRoleProfile(role, type(v) == "string" and v ~= "none" and v or nil)
        end,
    }
end

-- A role preset's button: Create (none yet), or Reset its layout (a second
-- click within three seconds), then the page shows the new state.
local function presetButton(role: string): (parent: Frame) -> Frame
    return function(parent: Frame): Frame
        local name = rolePresets.NAME[role] :: string
        local timer: TimerHandle? = nil
        local function label(): string
            return rolePresets.exists(role) and ("Reset " .. name .. "'s layout") or ("Create " .. name)
        end
        local b = controls.button(parent, {
            text = label(),
            onClick = function(self: controls.SuuButton)
                if rolePresets.exists(role) and not timer then
                    self:SetLabel("Click again to reset")
                    timer = after(3, function()
                        timer = nil
                        self:SetLabel(label())
                    end)
                    return
                end
                local armed = timer
                if armed then
                    armed:Cancel()
                    timer = nil
                end
                local ok, err = rolePresets.apply(role)
                if ok then
                    print(
                        ("%s is ready: the %s layout, used when you're a %s (Profiles › By role)."):format(
                            name,
                            roles.LABEL[role],
                            roles.LABEL[role]
                        )
                    )
                else
                    print(name .. ": " .. tostring(err))
                end
                self:SetLabel(label())
            end,
        })
        b:HookScript("OnShow", function()
            if not timer then
                b:SetLabel(label())
            end
        end)
        return b
    end
end

local function resetAll(parent: Frame): Frame
    local timer: TimerHandle? = nil
    local b = controls.button(parent, {
        text = "Reset everything",
        onClick = function(self: controls.SuuButton)
            local armed = timer
            if not armed then
                self:SetLabel("Click again to reset")
                timer = after(3, function()
                    timer = nil
                    self:SetLabel("Reset everything")
                end)
                return
            end
            armed:Cancel()
            timer = nil
            self:SetLabel("Reset everything")
            settings.reset()
            print("Every setting in " .. (profiles.current() :: string) .. " is back to its default.")
        end,
    })
    return b
end

