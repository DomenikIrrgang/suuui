        },
        {
            title = "Role presets",
            description = "Ready-made layouts from SuuUI's designs, for dungeons and raids alike. Tank and DPS: your group above the chat, you and your target either side of the centre. Healer: your group in the middle between your frame and your target's, the party as one row and the raid's groups as rows. Each is its own profile, copied from the one you use now with the layout set, and takes its role's place below.",
            rows = {
                {
                    label = "Tank",
                    control = "custom",
                    build = presetButton("TANK"),
                    description = "SuuTank: the threat meter beside the damage meter, the swing timer under your cast bar.",
                },
                {
                    label = "Healer",
                    control = "custom",
                    build = presetButton("HEALER"),
                    description = "SuuHeal: the group between you and your target, its icons inside the bars; no threat meter or swing timer.",
                },
                {
                    label = "DPS",
                    control = "custom",
                    build = presetButton("DAMAGER"),
                    description = "SuuDps: the default layout.",
                },
            },
        },
        {
            title = "By role",
            description = "SuuUI can switch profiles with your role: set up a profile for each, and everything follows when you change spec or get a role in a group, out of combat.",
            rows = {
                {
                    label = "Your role",
