                    -- before as an option (unset is class colours, "theme"
                    -- the theme's)
                    label = "Cast bar colour",
                    control = "segmented",
                    options = {
                        { value = "theme", label = "The theme's" },
                        { value = "class", label = "Class colours" },
                    },
                    description = "Your cast bar and swing timer: your class colour, toned (the default), or the theme's colour (SuuUI's own: the pale bar from before). Class colours win over the theme.",
                    get = function(): unknown
                        return settings.accountString("castColor") == "theme" and "theme" or "class"
                    end,
                    set = function(v: unknown): boolean
                        settings.setAccount("castColor", v == "theme" and "theme" or nil)
                        themes.apply()
                        return true
                    end,
                    isDefault = function(): boolean
                        return settings.accountString("castColor") ~= "theme"
                    end,
                    reset = function()
                        settings.setAccount("castColor", nil)
                        themes.apply()
                    end,
                },
            },
        },
        {
            title = "Colour vision",
            description = "SuuUI's signal colours (danger, low health, healing, warnings, the dispel types, friend and foe) for your eyes. Shapes, badges and labels stay as they are. For every character.",
            rows = {
                {
                    label = "Colours",
                    control = "select",
                    width = 220,
                    options = function(): Option[]
