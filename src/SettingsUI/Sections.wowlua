-- SettingsUI/Sections.wowlua
-- The General sections SuuUI owns itself: Appearance, Motion, Profiles and
-- Modules. Module sections are registered by their modules.

import after from "wowlua:timer"
import print from "/Core/Init"
import tokens as T from "/Core/Tokens"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import * as modules from "/Core/Modules"
import * as themes from "/Core/Themes"
import * as vision from "/Core/Vision"
import * as roles from "/Core/Roles"
import * as rolePresets from "/Core/RolePresets"
import * as services from "/Core/Services"
import userScale from "/Core/Root"
import SuuUI from "/Core/API"
import * as draw from "/UI/Draw"
import text as textLine from "/UI/Text"
import type Text from "/UI/Text"
import * as inputs from "/UI/Inputs"
import * as controls from "/UI/Controls"
import * as uiSelect from "/UI/Select"
import * as editMode from "/EditMode/EditMode"
import * as registry from "./Registry"
import * as settingsWindow from "./Window"

local S = T.space
local profiles = settings.profiles

type Option = uiSelect.SelectOption<string>
type RowDef = registry.RowDef

--------------------------------------------------------------------------------
-- Appearance
--------------------------------------------------------------------------------

local function scaleIsAuto(): boolean
    return settings.get("ui", "scale") == 0
end

registry.register({
    id = "appearance",
    label = "Appearance",
    category = "General",
    order = 10,
    namespace = "ui",
    groups = {
        {
            title = "Scale",
            description = "SuuUI draws one design pixel as one pixel of your screen, so frames keep their size on every resolution and only the space between them changes.",
            rows = {
                {
                    label = "Automatic scale",
                    control = "toggle",
                    combat = true,
                    description = "100% up to 1440p, larger on taller screens.",
                    get = scaleIsAuto,
                    set = function(on: unknown): (boolean, string?)
                        return settings.set("ui", "scale", on and 0 or userScale())
                    end,
                    isDefault = scaleIsAuto,
                    reset = function()
                        settings.reset("ui", "scale")
                    end,
                },
                {
                    label = "Scale",
                    control = "slider",
                    min = 0.5,
                    max = 2,
                    step = 0.05,
                    live = false,
                    combat = true,
                    description = "Every SuuUI frame at once, when you let go of the slider.",
                    format = function(v: number): string
                        return ("%d%%"):format(v * 100 + 0.5)
                    end,
                    get = function(): number
                        return userScale()
                    end,
                    set = function(v: unknown): (boolean, string?)
                        return settings.set("ui", "scale", type(v) == "number" and v or userScale())
                    end,
                    isDefault = scaleIsAuto,
                    reset = function()
                        settings.reset("ui", "scale")
                    end,
                    disabled = function(): (boolean, string)
                        return scaleIsAuto(), "Turn automatic scale off first."
                    end,
                },
            },
        },
        {
            title = "Theme",
            description = "SuuUI's colours and type, one of its themes (High contrast, Class accent, Darker…), or a theme a plugin brings. For every character. Colour vision applies on top of it.",
            rows = {
                {
                    label = "Theme",
                    control = "select",
                    width = 220,
                    options = function(): Option[]
                        local out: Option[] = {}
                        for _, t in ipairs(themes.all()) do
                            out[#out + 1] = { value = t.id, label = t.name }
                        end
                        return out
                    end,
                    description = function(): string
                        local chosen = settings.accountString("theme") or themes.DEFAULT
                        local t = themes.get(chosen)
                        return t and t.description or "Its plugin isn't loaded: SuuUI's own applies."
                    end,
                    get = function(): unknown
                        return settings.accountString("theme") or themes.DEFAULT
                    end,
                    set = function(v: unknown): boolean
                        settings.setAccount("theme", v ~= themes.DEFAULT and v or nil)
                        themes.apply()
                        return true
                    end,
                    isDefault = function(): boolean
                        return (settings.accountString("theme") or themes.DEFAULT) == themes.DEFAULT
                    end,
                    reset = function()
                        settings.setAccount("theme", nil)
                        themes.apply()
                    end,
                },
                {
                    -- design "Health colours" option 1 (2026-11-07)
                    label = "Health colour",
                    control = "segmented",
                    options = {
                        { value = "theme", label = "The theme's" },
                        { value = "class", label = "Class colours" },
                    },
                    description = "Health on every unit frame and nameplate: each player's class colour, toned (the default), or the theme's colour (NPCs keep the theme's, unless NPC reaction colours is on). Class colours win over the theme.",
                    -- (class colours the default since 2026-11-14, asked: unset or
                    -- "class" is class colours, "theme" the theme's)
                    get = function(): unknown
                        return settings.accountString("healthColor") == "theme" and "theme" or "class"
                    end,
                    set = function(v: unknown): boolean
                        settings.setAccount("healthColor", v == "theme" and "theme" or nil)
                        themes.apply()
                        return true
                    end,
                    isDefault = function(): boolean
                        return settings.accountString("healthColor") ~= "theme"
                    end,
                    reset = function()
                        settings.setAccount("healthColor", nil)
                        themes.apply()
                    end,
                },
                {
                    -- asked 2026-11-12; on by default since 2026-11-14 (asked):
                    -- unset or "reaction" is on, "off" off
                    label = "NPC reaction colours",
                    control = "toggle",
                    description = "NPCs' health on every unit frame and nameplate in their reaction's colour, toned: hostile red, neutral yellow, friendly green (on by default). It wins over the theme and follows the reaction as it changes. Players keep the Health colour above; a mob tagged by someone else keeps its tagged look.",
                    get = function(): unknown
                        return themes.reactionHealth()
                    end,
                    set = function(on: unknown): boolean
                        settings.setAccount("npcHealthColor", (not on) and "off" or nil)
                        themes.apply()
                        return true
                    end,
                    isDefault = function(): boolean
                        return settings.accountString("npcHealthColor") ~= "off"
                    end,
                    reset = function()
                        settings.setAccount("npcHealthColor", nil)
                        themes.apply()
                    end,
                },
                {
