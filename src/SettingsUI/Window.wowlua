-- SettingsUI/Window.wowlua
-- SuuUI's settings window: every section, searchable, live, with profiles.
--
-- Header: the lockup, "Settings", search, the profile picker, close.
-- Body: the section list, the open section's groups, and the live preview
-- column. Footer: Import, Export, Reset section, a note, Done.
-- Every change applies as it is made; there is no Apply button.

import after from "wowlua:timer"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as secret from "wowlua:secret"
import print from "/Core/Init"
import tokens as T from "/Core/Tokens"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import * as fault from "/Core/Fault"
import * as fonts from "/Core/Fonts"
import * as motion from "/Core/Motion"
import * as pixel from "/Core/Pixel"
import * as serialize from "/Core/Serialize"
import * as modules from "/Core/Modules"
import root from "/Core/Root"
import * as draw from "/UI/Draw"
import text from "/UI/Text"
import type Text from "/UI/Text"
import * as panel from "/UI/Panel"
import Panel from "/UI/Panel"
import type ScrollArea, SectionHeader from "/UI/Panel"
import * as inputs from "/UI/Inputs"
import type TextField, SegmentedOption from "/UI/Inputs"
import * as controls from "/UI/Controls"
import type SuuButton from "/UI/Controls"
import * as uiSelect from "/UI/Select"
import type Select, SelectOption, SelectValue from "/UI/Select"
import SettingRow, SettingsGroup from "/UI/SettingRow"
import tabMarker from "/UI/TabMarker"
import type TabMarker from "/UI/TabMarker"
import * as layout from "/UI/Layout"
import type Stack from "/UI/Layout"
import * as registry from "./Registry"

type RowDef = registry.RowDef
type GroupDef = registry.GroupDef
type Section = registry.Section

local S = T.space
local profiles = settings.profiles

local WIDTH, HEIGHT = 1160, 740
local NAV_W = T.size["settings-nav"]
local PREVIEW_W = 320
local HEAD_H = S["space-5"] + 30 + S["space-5"]
local FOOT_H = S["space-4"] * 2 + 30
-- The content column: narrower beside a live preview, otherwise wider, but
-- capped so a row's label and its control stay within one glance.
local CONTENT_W = WIDTH - NAV_W - PREVIEW_W - S["space-6"] * 2
local WIDE_W = math.min(WIDTH - NAV_W - S["space-6"] * 2, 720)

local frame: SettingsWindow? = nil
export local pages: { [string]: SettingsPage } = {}      -- section id -> page
local current: string? = nil         -- the open section's id
local query = ""      -- the search text, lower case

-- The window, once built.
local function win(): SettingsWindow return (assert(frame, "the settings window isn't built")) end

--------------------------------------------------------------------------------
-- Rows bound to settings
--------------------------------------------------------------------------------

-- A description given as text or a function.
local function describe(d: (string | () -> string)?): string?
    if type(d) == "function" then return d() end
    return d
end

-- A row's choices, given as a list or a function.
local function optionsOf(o: (registry.Options | () -> registry.Options)?): SelectOption<SelectValue>[]
    local list: registry.Options? = nil
    if type(o) == "function" then list = o() else list = o end
    local out: SelectOption<SelectValue>[] = {}
    if not list then return out end
    for i = 1, #list do out[#out + 1] = list[i] end
    return out
end

-- Choices as a segmented control's.
local function segmentsOf(options: SelectOption<SelectValue>[]): SegmentedOption<SelectValue>[]
    local out: SegmentedOption<SelectValue>[] = {}
    for _, o in ipairs(options) do
        local value = o.value
        if value ~= nil then out[#out + 1] = { value = value, label = o.label or "", disabled = o.disabled, reason = o.reason } end
    end
    return out
end

-- A row's description; a row with `combat = true` (a change that waits for
-- the end of combat) says so in the same words everywhere.
local COMBAT_NOTE = "Waits for the end of combat."

local function rowDescription(def: RowDef): string?
    local d = describe(def.description)
    if not def.combat then return d end
    if d == nil or d == "" then return COMBAT_NOTE end
    return d .. " " .. COMBAT_NOTE
end

-- A row's control, and how the row shows a value in it and its choices.
type Control = { frame?: Frame, show: (value: unknown) -> (), options: (o: SelectOption<SelectValue>[]) -> () }

local function nothing(_: unknown) end

-- A custom control shows a value through its SetValue (when it has one).
local function customShow(f: Frame): (value: unknown) -> ()
    return function(value: unknown) errors.tryMethod(f, "SetValue", value) end
end

local function buildControl(parent: Frame, def: RowDef, onChange: (v: unknown) -> ()): Control
    local c = def.control
    if c == "toggle" then
        local t = inputs.toggle(parent, { onChange = onChange })
        return { frame = t, show = function(v: unknown) t:SetValue(v) end, options = nothing }
    end
    if c == "checkbox" then
        local b = inputs.checkbox(parent, { label = def.checkLabel, onChange = onChange })
        return { frame = b, show = function(v: unknown) b:SetValue(v) end, options = nothing }
    end
    if c == "segmented" then
        local seg = inputs.segmented(parent, { options = segmentsOf(optionsOf(def.options)), onChange = onChange })
        return { frame = seg, show = function(v: unknown) seg:SetValue(v :: SelectValue?) end,
                 options = nothing }
    end
    if c == "select" then
        -- (a multiple select gives its list)
        local sel = uiSelect.select(parent, { options = optionsOf(def.options), multiple = def.multiple, width = def.width,
            placeholder = def.placeholder, maxShown = def.maxShown,
            onChange = not def.multiple and onChange or nil, onChangeAll = def.multiple and onChange or nil })
        return { frame = sel, show = function(v: unknown) sel:SetValue(v :: SelectValue?) end,
                 options = function(o: SelectOption<SelectValue>[]) sel:SetOptions(o) end }
    end
    if c == "slider" then
        local s = inputs.slider(parent, { min = def.min, max = def.max, step = def.step, unit = def.unit,
            format = def.format, width = def.width, live = def.live, onChange = onChange })
        return { frame = s, show = function(v: unknown) s:SetValue(secret.asNumber(v) or 0) end, options = nothing }
    end
    if c == "stepper" then
        local s = inputs.stepper(parent, { min = def.min, max = def.max, step = def.step, unit = def.unit, onChange = onChange })
        return { frame = s, show = function(v: unknown) s:SetValue(secret.asNumber(v)) end, options = nothing }
    end
    if c == "text" then
        local f = inputs.textField(parent, { width = def.width or 220, placeholder = def.placeholder, onChange = onChange })
        return { frame = f, show = function(v: unknown) f:SetValue(secret.asString(v)) end, options = nothing }
    end
    if c == "button" then
        local onClick = def.onClick
        local b = controls.button(parent, { text = def.text, variant = def.variant,
            onClick = onClick and function() onClick() end or nil })
        return { frame = b, show = nothing, options = nothing }
    end
    -- a custom control: build(parent, onChange, def); with a key (or get) it is
    -- bound like the others (onChange writes, SetValue shows the setting)
    local build = def.build
    if c == "custom" and build then
        local f = build(parent, onChange, def)
        return { frame = f, show = customShow(f),
                 options = function(o: SelectOption<SelectValue>[]) errors.tryMethod(f, "SetOptions", o) end }
    end
    return { show = nothing, options = nothing }
end

-- A SettingRow whose control reads and writes one setting (or def.get/def.set),
-- in the namespace of the section the row comes from (a merged section's own).
class BoundRow extends SettingRow
    readonly def: RowDef
    readonly namespace: string?
    private ctl: Control = { show = nothing, options = nothing }
    private valued: boolean = false
    private get: (() -> unknown)? = nil
    private set: ((value: unknown) -> (boolean?, string?))? = nil
    private isDefault: (() -> boolean)? = nil
    private resetter: (() -> ())? = nil

    constructor(page: SettingsPage, def: RowDef, section: Section)
        -- (the control comes first: the row holds it from its start)
        local made: { row: BoundRow? } = {}
        local ctl = buildControl(page.frame, def, function(v: unknown)
            local row = made.row
            if row then row:Change(v) end
        end)
        super(page.frame, { label = def.label, description = rowDescription(def), stacked = def.stacked,
                            width = page.width, control = ctl.frame, onReset = function()
                                local row = made.row
                                if row then row:DoReset() end
                            end })
        made.row = self
        self.ctl = ctl
        self.def = def
        local namespace = def.namespace or section.namespace
        self.namespace = namespace
        local key = def.key
        self.valued = def.control ~= nil and def.control ~= "button"
            and (def.control ~= "custom" or key ~= nil or def.get ~= nil)
        if namespace and key then
            self.get = def.get or function(): unknown return settings.get(namespace, key) end
            self.set = def.set or function(v: unknown): (boolean, string?) return settings.set(namespace, key, v) end
            self.isDefault = def.isDefault or function(): boolean return settings.isDefault(namespace, key) end
            self.resetter = def.reset or function() settings.reset(namespace, key) end
        else
            self.get, self.set, self.isDefault, self.resetter = def.get, def.set, def.isDefault, def.reset
        end
        self:Refresh()
    end

    -- The player changed the control: written, then shown as it is now (a
    -- refused value goes back, and rows whose get/set bypass Settings hear no
    -- SUUUI_SETTING_CHANGED).
    function Change(v: unknown)
        local set = self.set
        if not set then return end
        local ok, reason = set(v)
        if ok == false then
            print(("%s wasn't changed: %s"):format(self.def.label or "?", reason or "refused"))
        end
        self:Refresh()
    end

    -- Whether the row can be reset (it has a reset).
    function CanReset(): boolean return self.resetter ~= nil end

    function DoReset()
        local reset = self.resetter
        if not reset then return end
        reset()
        self:Refresh()
    end

    function IsModified(): boolean
        local isDefault = self.isDefault
        return isDefault ~= nil and not isDefault()
    end

    function Refresh()
        local def = self.def
        local get = self.get
        if self.valued and get then self.ctl.show(get()) end
        if type(def.options) == "function" then self.ctl.options(optionsOf(def.options)) end
        if type(def.description) == "function" then self:SetDescription(rowDescription(def)) end
        local disabled: boolean?, reason: string? = false, nil
        local isDisabled = def.disabled
        if isDisabled then disabled, reason = isDisabled() end
        self:SetDisabled(disabled, reason)
        self:SetModified(self.resetter ~= nil and self:IsModified())
    end
end

-- A group of a page, with the definition and section it came from.
class BoundGroup extends SettingsGroup
    readonly def: GroupDef
    readonly section: Section
    -- not rows: that is the group's own row frame
    readonly boundRows: BoundRow[] = {}

    constructor(page: SettingsPage, def: GroupDef, section: Section)
        super(page.frame, { title = def.title, description = describe(def.description), width = page.width })
        self.def, self.section = def, section
    end
end

--------------------------------------------------------------------------------
-- Pages
--------------------------------------------------------------------------------

export class SettingsPage implements registry.Page
    readonly section: Section
    readonly frame: Frame
    readonly groups: BoundGroup[] = {}
    readonly rows: BoundRow[] = {}
    readonly width: number
    readonly stack: Stack
    readonly title: SectionHeader
    merged: string = ""
    changed: number = 0

    constructor(section: Section)
        local width = section.preview and CONTENT_W or WIDE_W
        local f = CreateFrame("Frame", nil, win().content.child)
        f:SetWidth(width)
        self.section = section
        self.frame = f
        self.width = width
        self.stack = layout.stack(f, { gap = S["space-7"], autoSize = "height" })
        self.title = panel.sectionHeader(f, section.label, nil, width)
        self.title:Hide()
        self.stack:Add(self.title)
        for _, g in ipairs(section.groups or {}) do self:AddGroup(g) end
        local build = section.build
        if build then build(self) end
        -- then the groups of the sections merged into this one
        local merged: string[] = {}
        for _, m in ipairs(registry.merged(section.id)) do
            merged[#merged + 1] = m.id
            for _, g in ipairs(m.groups or {}) do self:AddGroup(g, m) end
        end
        self.merged = table.concat(merged, ",")
        self:Refresh()
        f:Hide()
        win().pagesStack:Add(f)
    end

    -- `section`: the section the group comes from, when it was merged in from
    -- another (its rows use that section's namespace).
    function AddGroup(def: GroupDef, section: Section?): Frame
        local g = BoundGroup.new(self, def, section or self.section)
        for _, rdef in ipairs(def.rows) do
            local row = BoundRow.new(self, rdef, g.section)
            g:AddRow(row)
            g.boundRows[#g.boundRows + 1] = row
            self.rows[#self.rows + 1] = row
        end
        self.groups[#self.groups + 1] = g
        self.stack:Add(g)
        return g
    end

    -- Drops every group, for sections that rebuild themselves (the module list).
    function Clear()
        for _, g in ipairs(self.groups) do
            self.stack:Remove(g)
            g:Hide()
        end
        wipe(self.groups)
        wipe(self.rows)
    end

    function Refresh()
        local changed = 0
        for _, g in ipairs(self.groups) do
            local n = 0
            for _, row in ipairs(g.boundRows) do
                row:Refresh()
                if row:IsModified() then n = n + 1 end
            end
            g:SetMeta(n > 0 and (n == 1 and "1 changed" or n .. " changed") or "")
            changed = changed + n
        end
        self.changed = changed
    end

    -- Shows the rows matching `q` (everything when q is empty); returns the count.
    -- A match on the section's label (or a merged group's own section's label) or
    -- a group's title or description shows all the rows under it.
    function Filter(q: string): number
        local total = 0
        local sectionHit = q == "" or self.section.label:lower():find(q, 1, true) ~= nil
        for _, g in ipairs(self.groups) do
            local groupHit = sectionHit or g.section.label:lower():find(q, 1, true) ~= nil
                or (g.def.title or ""):lower():find(q, 1, true) ~= nil
                or (describe(g.def.description) or ""):lower():find(q, 1, true) ~= nil
            local shown = 0
            for _, row in ipairs(g.boundRows) do
                local d = row.def
                local hit = groupHit or (d.label or ""):lower():find(q, 1, true) ~= nil
                    or (rowDescription(d) or ""):lower():find(q, 1, true) ~= nil
                row:SetShown(hit)
                if hit then shown = shown + 1 end
            end
            g:SetShown(shown > 0)
            total = total + shown
        end
        return total
    end
end

local function getPage(section: Section): SettingsPage
    local page = pages[section.id] or SettingsPage.new(section)
    pages[section.id] = page
    return page
end

--------------------------------------------------------------------------------
-- Navigation
--------------------------------------------------------------------------------

-- A section's entry in the nav (or a category's heading).
class NavButton extends Button
    readonly bg: Texture
    readonly dot: Texture
    readonly label: Text
    readonly heading: Text
    section: Section? = nil

    constructor(nav: Frame)
        super(nil, nav)
        self:SetSize(NAV_W - S["space-4"] * 2, 30)
        self.bg = draw.fill(self, "surface-raised")
        self.bg:SetAllPoints()
        self.dot = draw.diamond(self, 5, "ink")
        self.dot:SetPoint("CENTER", self, "RIGHT", -S["space-4"] - 2.5, 0)
        self.label = text(self, "label", "ink-muted")
        self.label:SetPoint("LEFT", S["space-5"] + 4, 0)
        self.heading = text(self, "caption", "ink-muted")
        self.heading:SetPoint("BOTTOMLEFT", S["space-4"], S["space-2"])
        self:SetScript("OnEnter", function()
            local section = self.section
            if section and section.id ~= current then self.label:SetColor("ink"); self.bg:Show() end
        end)
        self:SetScript("OnLeave", function() refreshNav() end)
        self:SetScript("OnClick", function()
            local section = self.section
            if section then show(section.id) end
        end)
    end
end

-- The live preview column: its title, the section's view, its note.
class PreviewColumn extends Frame
    readonly title: Text
    readonly note: Text
    readonly area: Frame
    view: Frame? = nil
    section: Section? = nil
    -- views whose size changes move the preview along
    readonly hooked: { [Frame]: boolean } = tbl.weakKeys()

    constructor(parent: Frame, top: number, bottom: number)
        super(nil, parent)
        self:SetPoint("TOPRIGHT", -1, -top)
        self:SetPoint("BOTTOMRIGHT", -1, bottom)
        self:SetWidth(PREVIEW_W)
        draw.fill(self, "surface-sunk"):SetAllPoints()
        local rule = draw.fill(self, "gilt-faint", "ARTWORK")
        rule:SetPoint("TOPLEFT")
        rule:SetPoint("BOTTOMLEFT")
        rule:SetWidth(pixel.size(parent))
        self.title = text(self, "caption", "ink-muted")
        self.title:SetPoint("TOPLEFT", S["space-5"], -S["space-5"])
        self.note = text(self, "caption", "ink-muted")
        self.note:SetPoint("BOTTOMLEFT", S["space-5"], S["space-5"])
        -- where a section's view sits: under the title, above the note, clipped
        self.area = CreateFrame("Frame", nil, self)
        self.area:SetPoint("TOPLEFT", self.title, "BOTTOMLEFT", 0, -S["space-4"])
        self.area:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", -S["space-5"], S["space-5"] * 2 + 12)
        self.area:SetClipsChildren(true)
    end
end

local function profileOptions(): SelectOption<string>[]
    local options: SelectOption<string>[] = {}
    for _, name in ipairs(profiles.list()) do options[#options + 1] = { value = name, label = name } end
    return options
end

-- Reset section's arming.
local resetTimer: TimerHandle? = nil

local function disarmReset()
    local timer = resetTimer
    if timer then timer:Cancel(); resetTimer = nil end
    local f = frame
    if f then f.resetSection:SetLabel("Reset section") end
end

-- The settings window: header, nav, pages, preview, footer.
class SettingsWindow extends Panel
    readonly close: Button
    readonly profile: Select<string>
    readonly search: TextField
    readonly nav: ScrollArea
    readonly navButtons: NavButton[] = {}
    readonly navMarker: TabMarker
    readonly preview: PreviewColumn
    readonly content: ScrollArea
    readonly pagesStack: Stack
    readonly empty: Text
    readonly resetSection: SuuButton

    constructor()
        super(root, { name = "SuuUISettings", width = WIDTH, height = HEIGHT, ornament = true })
        self.body:Hide()
        self:SetFrameStrata("HIGH")
        self:SetToplevel(true)
        self:SetClampedToScreen(true)
        self:EnableMouse(true)
        self:SetMovable(true)
        self:RegisterForDrag("LeftButton")
        self:SetScript("OnDragStart", function() self:StartMoving() end)
        self:SetScript("OnDragStop", function() self:StopMovingOrSizing() end)
        self:SetPoint("CENTER")
        self:Hide()
        tinsert(UISpecialFrames, "SuuUISettings")

        -- Header: the jewel and wordmark, "Settings", search, profile, close.
        local jewel = draw.diamond(self, 14, "gilt")
        jewel:SetPoint("CENTER", self, "TOPLEFT", S["space-5"] + 10, -(S["space-5"] + 15))
        local gem = draw.diamond(self, 7, "arcane")
        gem:SetPoint("CENTER", jewel, "CENTER")
        local word = text(self, "unit-name-lg", "ink")
        word:SetValue("SuuUI")
        word:SetPoint("LEFT", jewel, "CENTER", 16, 0)
        local title = text(self, "header", "ink-muted")
        title:SetValue("Settings")
        title:SetPoint("LEFT", word, "RIGHT", S["space-5"], 0)

        self.close = panel.closeButton(self, function() self:Hide() end)
        self.close:SetPoint("TOPRIGHT", -S["space-5"], -(S["space-5"] + 4))
        self.profile = uiSelect.select(self, { width = 190, options = profileOptions(), value = profiles.current(),
            onChange = function(name: string?)
                local ok, err = profiles.use(name or "")
                if not ok then
                    print(err)
                    self.profile:SetValue(profiles.current())
                end
            end })
        self.profile:SetPoint("RIGHT", self.close, "LEFT", -S["space-5"], 0)
        -- through the error catcher: an error here was silent before
        self.search = inputs.textField(self, { width = 280, placeholder = "Search settings",
            onTextChanged = function(typed: string) fault.call("Settings search", search, typed) end })
        self.search:SetPoint("RIGHT", self.profile, "LEFT", -S["space-5"], 0)

        -- Body: nav | content | preview
        local top, bottom = HEAD_H, FOOT_H
        self.nav = panel.scrollArea(self)
        self.nav:SetPoint("TOPLEFT", 0, -top)
        self.nav:SetPoint("BOTTOMLEFT", 0, bottom)
        self.nav:SetWidth(NAV_W)
        -- the chosen section's jewel, gliding up and down the list (tabMarker)
        self.navMarker = tabMarker(self.nav.child, { vertical = true, side = "LEFT", x = 7 })
        local navRule = draw.fill(self, "gilt-faint", "ARTWORK")
        navRule:SetPoint("TOPLEFT", NAV_W, -top)
        navRule:SetPoint("BOTTOMLEFT", NAV_W, bottom)
        navRule:SetWidth(pixel.size(self))

        self.preview = PreviewColumn.new(self, top, bottom)

        self.content = panel.scrollArea(self, S["space-3"])
        self.content:SetPoint("TOPLEFT", NAV_W + S["space-6"], -(top + S["space-5"]))
        self.content:SetPoint("BOTTOMRIGHT", -(PREVIEW_W + S["space-6"]), bottom)
        self.content.child:SetWidth(WIDE_W)
        self.pagesStack = layout.stack(self.content.child, { gap = S["space-7"], autoSize = "height", padding = { 0, 0, 0, S["space-6"] } })
        self.empty = text(self.content.child, "body", "ink-muted")
        self.empty:SetValue("No setting matches that search.")
        self.empty:SetPoint("TOPLEFT")
        self.empty:Hide()

        -- Footer
        local foot = CreateFrame("Frame", nil, self)
        foot:SetPoint("BOTTOMLEFT", S["space-5"], 0)
        foot:SetPoint("BOTTOMRIGHT", -S["space-5"], 0)
        foot:SetHeight(FOOT_H)
        local footRule = draw.hairline(self, "gilt-faint")
        footRule:SetPoint("BOTTOMLEFT", 0, FOOT_H)
        footRule:SetPoint("BOTTOMRIGHT", 0, FOOT_H)
        local importButton = controls.button(foot, { text = "Import", onClick = function() import() end })
        importButton:SetPoint("LEFT")
        local exportButton = controls.button(foot, { text = "Export", onClick = function() export() end })
        exportButton:SetPoint("LEFT", importButton, "RIGHT", S["space-3"], 0)
        self.resetSection = controls.button(foot, { text = "Reset section", onClick = function() self:ResetSection() end })
        self.resetSection:SetPoint("LEFT", exportButton, "RIGHT", S["space-3"], 0)
        local done = controls.button(foot, { text = "Done", variant = "primary", onClick = function() self:Hide() end })
        done:SetPoint("RIGHT")
        local note = text(foot, "caption", "ink-muted")
        note:SetValue("Changes apply as you make them.")
        note:SetPoint("RIGHT", done, "LEFT", -S["space-5"], 0)
    end

    -- Reset section asks twice: the first click arms it for a few seconds.
    function ResetSection()
        local page = pages[current or ""]
        if not page or query ~= "" then return end
        if not resetTimer then
            self.resetSection:SetLabel("Click again to reset")
            resetTimer = after(3, function() resetTimer = nil; disarmReset() end)
            return
        end
        disarmReset()
        for _, row in ipairs(page.rows) do
            -- turning modules on and off is not a setting to reset
            local moduleToggle = row.def.key == "enabled" and modules.get(row.namespace or "")
            if row:CanReset() and row:IsModified() and not moduleToggle then row:DoReset() end
        end
    end
end

local function navButton(i: number): NavButton
    local f = win()
    local b = f.navButtons[i]
    if b then return b end
    b = NavButton.new(f.nav.child)
    f.navMarker:Track(b)
    f.navButtons[i] = b
    return b
end

export function refreshNav()
    local f = frame
    if not f then return end
    local chosen: NavButton? = nil
    for _, b in ipairs(f.navButtons) do
        local section = b.section
        if section then
            local on = section.id == current and query == ""
            b.bg:SetShown(on)
            b.label:SetColor(on and "gilt-text" or "ink-muted")
            local page = pages[section.id]
            b.dot:SetShown(page ~= nil and page.changed > 0)
            if on and b:IsShown() then chosen = b end
        end
    end
    f.navMarker:SetChosen(chosen)
end

local function buildNav()
    local f = win()
    for _, b in ipairs(f.navButtons) do b:Hide() end
    local y, i = S["space-5"], 0
    local lastCategory: string? = nil
    for _, section in ipairs(registry.list()) do
        if section.category ~= lastCategory then
            i = i + 1
            local h = navButton(i)
            h.section = nil
            h:SetHeight(lastCategory and 38 or 22)
            h.bg:Hide(); h.dot:Hide(); h.label:SetValue("")
            h.heading:SetValue(section.category)
            h:EnableMouse(false)
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", S["space-4"], -y)
            h:Show()
            y = y + h:GetHeight()
            lastCategory = section.category
        end
        i = i + 1
        local b = navButton(i)
        b.section = section
        b:SetHeight(30)
        b.heading:SetValue("")
        b.label:SetValue(section.label)
        b:EnableMouse(true)
        b:ClearAllPoints()
        b:SetPoint("TOPLEFT", S["space-4"], -y)
        b:Show()
        y = y + 31
    end
    f.nav.child:SetSize(NAV_W, y + S["space-5"])
    refreshNav()
end

--------------------------------------------------------------------------------
-- Showing sections, searching, the preview
--------------------------------------------------------------------------------

-- The view at its real size: centred in the column, or (wider or taller than
-- the column) from its left or top edge, so its start shows and only its far
-- end clips.
export function placePreview()
    local p = win().preview
    local view = p.view
    if not view then return end
    view:ClearAllPoints()
    local wide = view:GetWidth() > p.area:GetWidth()
    local tall = view:GetHeight() > p.area:GetHeight()
    local point = (tall and "TOP" or "") .. (wide and "LEFT" or "")
    if point == "" then point = "CENTER" end
    view:SetPoint(point :: FramePoint, p.area, point :: FramePoint)
end

-- The section's note under its preview (previewNote, a string or function).
export function previewNote()
    local p = win().preview
    local section = p.section
    local note = section and describe(section.previewNote)
    p.note:SetValue(note or "")
end

-- The preview column shows only for a section that has a preview; otherwise
-- the content takes its space.
local function showPreview(section: Section?)
    local f = win()
    local p = f.preview
    local old = p.view
    if old then old:Hide(); p.view = nil end
    local preview = section and section.preview
    local has = preview ~= nil and query == ""
    p:SetShown(has)
    f.content:SetPoint("BOTTOMRIGHT", -((has and PREVIEW_W or 0) + S["space-6"]), FOOT_H)
    p.title:SetValue(section and section.previewTitle or "Live preview")
    if has and preview then
        local view = preview(p.area)
        view:SetScale(1)
        view:Show()
        p.view, p.section = view, section
        if not p.hooked[view] then
            p.hooked[view] = true
            view:HookScript("OnSizeChanged", function()
                if p.view == view then placePreview(); previewNote() end
            end)
        end
        placePreview()
        previewNote()
    end
end

local function applyView()
    local f = win()
    local anyHit = false
    if query ~= "" then
        -- results in the nav's order, not the order the pages were built in
        for _, section in ipairs(registry.list()) do
            local page = pages[section.id]
            if page then
                f.pagesStack:Remove(page.frame)
                f.pagesStack:Add(page.frame)
            end
        end
    end
    for id, page in pairs(pages) do
        if query == "" then
            page:Filter("")
            page.title:Hide()
            page.frame:SetShown(id == current)
        else
            local hits = page:Filter(query)
            page.title:SetShown(hits > 0)
            page.frame:SetShown(hits > 0)
            anyHit = anyHit or hits > 0
        end
    end
    f.empty:SetShown(query ~= "" and not anyHit)
    f.content:SetVerticalScroll(0)
    -- it resets the open section, which a search doesn't show on its own
    disarmReset()
    f.resetSection:SetEnabledState(query == "")
    refreshNav()
end

export function show(id: string?)
    local f = win()
    local found = registry.get(id or "")
    -- a merged section opens the page it shows on
    local section: Section? = found and (registry.mergedInto(found) or found) or registry.list()[1]
    if not section then return end
    current = section.id
    getPage(section)
    f.search.edit:ClearFocus()
    if query ~= "" then
        query = ""
        f.search:SetValue("")
    end
    showPreview(section)
    applyView()
end

export function search(typed: string?)
    query = strtrim(typed or ""):lower()
    if query ~= "" then
        -- every page, to search it; one that fails to build is reported and
        -- left out instead of stopping the search
        for _, section in ipairs(registry.list()) do
            if not pages[section.id] then fault.call("Settings: " .. section.label, getPage, section) end
        end
    end
    showPreview(registry.get(current or ""))
    applyView()
end

-- Refreshes come in bursts (a profile switch changes many settings, and
-- runtime writes happen in combat): mark the pages dirty and refresh once,
-- on the next frame, and only while the window is shown (OnShow catches up).
local dirty, queued = false, false

local function refreshNow()
    dirty = false
    for _, page in pairs(pages) do page:Refresh() end
    refreshNav()
end

export function refreshAll()
    local f = frame
    if not f then return end
    dirty = true
    if queued or not f:IsShown() then return end
    queued = true
    after(0, function()
        queued = false
        if dirty and f:IsShown() then refreshNow() end
    end)
end

--------------------------------------------------------------------------------
-- Import and export
--------------------------------------------------------------------------------

class ProfileDialog extends Panel
    readonly hint: Text
    readonly edit: EditBox
    readonly name: TextField
    readonly action: SuuButton
    readonly status: Text

    constructor()
        super(root, { name = "SuuUIProfileDialog", title = "Export profile", closable = true,
            width = 560, height = 330, solid = true })
        self:SetFrameStrata("DIALOG")
        self:SetToplevel(true)
        self:SetPoint("CENTER")
        self:EnableMouse(true)
        tinsert(UISpecialFrames, "SuuUIProfileDialog")

        self.hint = text(self.body, "caption", "ink-muted")
        self.hint:SetPoint("TOPLEFT")

        local box = CreateFrame("Frame", nil, self.body)
        box:SetPoint("TOPLEFT", 0, -20)
        box:SetPoint("RIGHT")
        box:SetHeight(170)
        draw.fill(box, "surface-sunk"):SetAllPoints()
        draw.border(box, "gilt-line")
        local scroll = CreateFrame("ScrollFrame", nil, box, "UIPanelScrollFrameTemplate")
        scroll:SetPoint("TOPLEFT", S["space-4"], -S["space-3"])
        scroll:SetPoint("BOTTOMRIGHT", -26, S["space-3"])
        local edit = CreateFrame("EditBox", nil, scroll)
        edit:SetMultiLine(true)
        edit:SetAutoFocus(false)
        edit:SetFontObject(fonts.get("caption"))
        edit:SetWidth(490)
        edit:SetScript("OnEscapePressed", function() self:Hide() end)
        scroll:SetScrollChild(edit)
        self.edit = edit

        self.name = inputs.textField(self.body, { width = 260, placeholder = "Name for the new profile" })
        self.name:SetPoint("TOPLEFT", box, "BOTTOMLEFT", 0, -S["space-4"])
        self.action = controls.button(self.body, { text = "Import", variant = "primary", onClick = function() doImport() end })
        self.action:SetPoint("TOPRIGHT", box, "BOTTOMRIGHT", 0, -S["space-4"])
        self.status = text(self.body, "caption", "ember-text")
        self.status:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -S["space-3"])
    end
end

local dialog: ProfileDialog? = nil

local function theDialog(): ProfileDialog
    local d = dialog or ProfileDialog.new()
    dialog = d
    return d
end

export function export()
    local d = theDialog()
    -- (the current profile always exists)
    local data = profiles.export() :: settings.Exported
    d:SetTitle("Export profile", data.name)
    d.hint:SetValue("Ctrl+A, Ctrl+C copies it. Paste it into Import on another character.")
    d.edit:SetText(serialize.encode({ v = 1, name = data.name, data = data.data }))
    d.name:Hide()
    d.action:Hide()
    d.status:SetValue("")
    d:Show()
    d.edit:SetFocus()
    d.edit:HighlightText()
end

export function import()
    local d = theDialog()
    d:SetTitle("Import profile", "")
    d.hint:SetValue("Paste a profile string. It becomes a new profile and this character switches to it.")
    d.edit:SetText("")
    d.name:SetValue("")
    d.name:Show()
    d.action:Show()
    d.status:SetValue("")
    d:Show()
    d.edit:SetFocus()
end

export function doImport()
    local d = theDialog()
    local value, err = serialize.decode(d.edit:GetText())
    local data = tbl.field(value, "data")
    if type(data) ~= "table" then
        d.status:SetValue(err or "This isn't a SuuUI profile string.")
        return
    end
    local name = strtrim(d.name:GetValue() or "")
    if name == "" then name = (secret.asString(tbl.field(value, "name")) or "Imported") .. " (imported)" end
    local ok, why = profiles.import(name, data)
    if not ok then
        d.status:SetValue(why or "That didn't work.")
        return
    end
    d:Hide()
    print(("Imported %s and switched to it."):format(name))
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

local function build(): SettingsWindow
    local f = SettingsWindow.new()
    frame = f
    f:SetScript("OnShow", function()
        motion.enter(f, T.duration["dur-fast"])
        if dirty then refreshNow() end
    end)

    -- Live: every settings change refreshes the rows and the nav.
    events.on("SUUUI_SETTING_CHANGED", function() refreshAll() end, "SettingsWindow")
    -- Profiles switched, created, deleted or mapped to roles: the header's
    -- picker and the Profiles page's lists follow.
    local function profilesChanged()
        f.profile:SetOptions(profileOptions())
        f.profile:SetValue(profiles.current())
        refreshAll()
    end
    local profileMessages: MessageName[] = { "SUUUI_PROFILE_CHANGED", "SUUUI_PROFILES_CHANGED",
                                             "SUUUI_ROLE_PROFILES_CHANGED", "SUUUI_ROLE_CHANGED" }
    for _, e in ipairs(profileMessages) do
        events.on(e, profilesChanged, "SettingsWindow")
    end
    -- A page goes when its section does, when its section is merged into
    -- another now, and when the sections merged into it changed (it's built
    -- again, with them).
    local function listed(id: string): boolean
        local s = registry.get(id)
        return s ~= nil and registry.mergedInto(s) == nil
    end
    local function mergedIds(id: string): string
        local ids: string[] = {}
        for _, m in ipairs(registry.merged(id)) do ids[#ids + 1] = m.id end
        return table.concat(ids, ",")
    end
    events.on("SUUUI_SETTINGS_SECTIONS_CHANGED", function()
        for id, page in pairs(pages) do
            if not listed(id) or page.section ~= registry.get(id) or page.merged ~= mergedIds(id) then
                f.pagesStack:Remove(page.frame)
                page.frame:Hide()
                pages[id] = nil
            end
        end
        buildNav()
        local opened = registry.get(current or "")
        if not listed(current or "") or not opened then
            -- (a merged section opens the page it now shows on)
            show(current)
        else
            getPage(opened)
            if query ~= "" then
                for _, section in ipairs(registry.list()) do getPage(section) end
            end
            applyView()
        end
    end, "SettingsWindow")
    local moduleMessages: MessageName[] = { "SUUUI_MODULE_ENABLED", "SUUUI_MODULE_DISABLED", "SUUUI_MODULE_ERRORED" }
    for _, e in ipairs(moduleMessages) do
        events.on(e, function() refreshAll() end, "SettingsWindow")
    end

    buildNav()
    return f
end

export function open(id: string?)
    local f = frame or build()
    f.profile:SetOptions(profileOptions())
    f.profile:SetValue(profiles.current())
    f:Show()
    show(id or current)
end

export function toggle()
    local f = frame
    if f and f:IsShown() then f:Hide() else open() end
end

export function close()
    local f = frame
    if f then f:Hide() end
end

