-- Diagnostics/CollectionsOwnProbe.wowlua
-- "/suu probe collown": can SuuUI build its own collections window (asked
-- 2026-10-16: an own window instead of the restyle)? Recorded at once:
--   mounts       how many, how many yours, three samples with their extra
--                info (the model's display ID, source)
--   pets, toys, heirlooms   counts and a sample each
--   appearances  every category: its name, how many appearances, how many
--                yours, a sample with its sources; what you wear per slot
-- and a panel of SuuUI's own buttons for what needs a click or your eyes:
--   Summon       your first usable mount through C_MountJournal.SummonByID
--                (again: Dismiss), from SuuUI's button
--   Toy          your first toy through a secure button of SuuUI's (type toy)
--   two models   a mount's model in a PlayerModel (Next: the next mount) and
--                you in a DressUpModel trying on an appearance (Next too)
-- What the game answers (a blocked action, the cast) is printed and saved.
-- Saved in SuuUIProbe.collectionsOwn on /reload.

import isSecret from "wowlua:secret"
import * as secret from "wowlua:secret"
import * as DB from "/Core/DB"
import * as tbl from "wowlua:table"
import print from "/Core/Init"
import panel, closeButton, Panel from "/UI/Panel"
import text as uiText from "/UI/Text"
import button from "/UI/Controls"
import fill, border from "/UI/Draw"

interface OwnPanel extends Panel
    toy: Button
    mountModel: PlayerModel
    dress: DressUpModel
    nextMount: () -> ()
    tryOn: () -> ()
end

-- what the data steps found, for the panel's buttons
local mountIDs: unknown[]? = nil
local usableMount: unknown = nil
local firstToy: number? = nil
local firstSource: unknown = nil
local probePanel: OwnPanel? = nil
local listening = false

local function show(v: unknown, depth: number?): string
    depth = depth or 0
    if isSecret(v) then
        return "secret"
    end
    if type(v) == "table" then
        if depth > 1 then
            return "{…}"
        end
        local parts = {}
        for k, x in pairs(v) do
            if type(x) ~= "function" then
                parts[#parts + 1] = tostring(k) .. "=" .. show(x, depth + 1)
            end
            if #parts > 30 then
                break
            end
        end
        table.sort(parts)
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

-- every result of a call, or why it failed
local function call(fn: unknown, ...: unknown): string
    if type(fn) ~= "function" then
        return "missing"
    end
    local res = { pcall(fn, ...) }
    if not res[1] then
        return "error: " .. tostring(res[2]):sub(1, 160)
    end
    local parts = {}
    for i = 2, select("#", unpack(res)) do
        parts[#parts + 1] = show(res[i])
    end
    return table.concat(parts, " | ")
end

local function raw(fn: unknown, ...: unknown): ...unknown
    if type(fn) ~= "function" then
        return nil
    end
    local ok, a, b, c, d, e, f, g, h, i, j, k, l, m, n = pcall(fn, ...)
    if ok then
        return a, b, c, d, e, f, g, h, i, j, k, l, m, n
    end
end

local out: { [string]: unknown } = {}
local function line(section: string, text: string)
    table.insert(tbl.listAt(out, section), text)
end

local function note(text: string)
    line("clicks", date("%H:%M:%S") .. " " .. text)
    print("Collections probe: " .. text)
end

--------------------------------------------------------------------------------
-- The data
--------------------------------------------------------------------------------

local function mounts()
    local MJ = C_MountJournal
    if not MJ then
        line("mounts", "C_MountJournal missing")
        return
    end
    local ids = tbl.list(raw(MJ.GetMountIDs))
    local yours: number, usable: unknown = 0, nil
    for _, id in ipairs(ids) do
        local _name, _spellID, _icon, _active, isUsable, _sourceType, _fav, _faction, _factionID, _hide, collected = raw(
            MJ.GetMountInfoByID,
            id
        )
        if collected then
            yours = yours + 1
            if isUsable and not usable then
                usable = id
            end
        end
    end
    line(
        "mounts",
        ("%d mounts, %d yours, first usable %s; GetNumMounts %s"):format(
            #ids,
            yours,
            tostring(usable),
            call(MJ.GetNumMounts)
        )
    )
    for i = 1, math.min(3, #ids) do
        line("mounts", "info " .. call(MJ.GetMountInfoByID, ids[i]))
        line("mounts", "extra " .. call(MJ.GetMountInfoExtraByID, ids[i]))
    end
    mountIDs, usableMount = ids, usable
end

local function pets()
    local PJ = C_PetJournal
    if not PJ then
        line("pets", "C_PetJournal missing")
        return
    end
    line("pets", "GetNumPets " .. call(PJ.GetNumPets))
    line("pets", "first " .. call(PJ.GetPetInfoByIndex, 1))
    line("pets", "summoned " .. call(PJ.GetSummonedPetGUID))
end

local function toys()
    local TB = C_ToyBox
    if not TB then
        line("toys", "C_ToyBox missing")
        return
    end
    line(
        "toys",
        ("GetNumToys %s, filtered %s, learned displayed %s"):format(
            call(TB.GetNumToys),
            call(TB.GetNumFilteredToys),
            call(TB.GetNumLearnedDisplayedToys)
        )
    )
    local first: number? = nil
    for i = 1, (secret.asNumber(raw(TB.GetNumFilteredToys)) or 0) do
        local itemID = raw(TB.GetToyFromIndex, i)
        if secret.isNumber(itemID) and raw(PlayerHasToy, itemID) and not first then
            first = itemID
        end
        if i <= 3 then
            line(
                "toys",
                ("%d: %s info %s has %s"):format(
                    i,
                    show(itemID),
                    call(TB.GetToyInfo, itemID),
                    call(PlayerHasToy, itemID)
                )
            )
        end
    end
    line("toys", "first of yours " .. tostring(first))
    firstToy = first
end

local function heirlooms()
    local H = C_Heirloom
    if not H then
        line("heirlooms", "C_Heirloom missing")
        return
    end
    line("heirlooms", ("GetNumHeirlooms %s, known %s"):format(call(H.GetNumHeirlooms), call(H.GetNumKnownHeirlooms)))
end

local SLOTS = {
    "HEADSLOT",
    "SHOULDERSLOT",
    "BACKSLOT",
    "CHESTSLOT",
    "SHIRTSLOT",
    "TABARDSLOT",
    "WRISTSLOT",
    "HANDSSLOT",
    "WAISTSLOT",
    "LEGSSLOT",
    "FEETSLOT",
    "MAINHANDSLOT",
    "SECONDARYHANDSLOT",
    "RANGEDSLOT",
}

local function appearances()
    local TC = C_TransmogCollection
    if not TC then
        line("appearances", "C_TransmogCollection missing")
        return
    end
    line(
        "appearances",
        ("class filter %s, collected shown %s, uncollected shown %s"):format(
            call(TC.GetClassFilter),
            call(TC.GetCollectedShown),
            call(TC.GetUncollectedShown)
        )
    )
    local sample: unknown = nil
    for cat = 1, 40 do
        local name = raw(TC.GetCategoryInfo, cat)
        if name then
            local list = tbl.list(raw(TC.GetCategoryAppearances, cat))
            local yours = 0
            for _, a in ipairs(list) do
                if tbl.field(a, "isCollected") then
                    yours = yours + 1
                end
            end
            line(
                "appearances",
                ("%d %s: %d appearances, %d yours, total %s collected %s"):format(
                    cat,
                    tostring(name),
                    #list,
                    yours,
                    call(TC.GetCategoryTotal, cat),
                    call(TC.GetCategoryCollectedCount, cat)
                )
            )
            if not sample and list[1] then
                sample = list[1]
                line("appearances", "  sample " .. show(sample))
                local sources = tbl.list(raw(TC.GetAppearanceSources, tbl.field(sample, "visualID")))
                line("appearances", ("  %d sources, first %s"):format(#sources, show(sources[1])))
                local sourceID = tbl.field(sources[1], "sourceID")
                if sourceID then
                    line("appearances", "  source info " .. call(TC.GetSourceInfo, sourceID))
                    firstSource = sourceID
                end
            end
        end
    end
    -- every category ID, asked plainly and with a slot (the game's wardrobe
    -- asks for armor with the slot's transmog location)
    local function location(slot: unknown): unknown
        local get = tbl.field(_G, "TransmogUtil", "GetTransmogLocation")
        if not (type(get) == "function" and Enum.TransmogType) then
            return nil
        end
        local ok, loc = pcall(get, slot, Enum.TransmogType.Appearance, false)
        local data = ok and tbl.field(loc, "GetData")
        return type(data) == "function" and raw(data, loc) or nil
    end
    for cat = 1, 30 do
        local plain = tbl.list(raw(TC.GetCategoryAppearances, cat))
        local slotName = raw(tbl.field(_G, "CollectionWardrobeUtil", "GetSlotFromCategoryID"), cat)
        local withSlot = slotName and tbl.list(raw(TC.GetCategoryAppearances, cat, location(slotName))) or {}
        local yours = 0
        for _, a in ipairs(withSlot) do
            if tbl.field(a, "isCollected") then
                yours = yours + 1
            end
        end
        line(
            "categories",
            ("%d info %s | slot %s | plain %d | with slot %d (yours %d)"):format(
                cat,
                call(TC.GetCategoryInfo, cat),
                tostring(slotName),
                #plain,
                #withSlot,
                yours
            )
        )
    end
    -- what you wear: each slot's item and its appearance
    for _, slot in ipairs(SLOTS) do
        local id = raw(GetInventorySlotInfo, slot)
        local itemID = id and raw(GetInventoryItemID, "player", id)
        if itemID then
            line("worn", ("%s item %s appearance %s"):format(slot, tostring(itemID), call(TC.GetItemInfo, itemID)))
        end
    end
end

--------------------------------------------------------------------------------
-- The panel: SuuUI's own buttons and two models
--------------------------------------------------------------------------------

local function build(): OwnPanel
    local p = panel(UIParent, { title = "Collections probe", width = 470, height = 330, solid = true })
    p:SetFrameStrata("DIALOG")
    p:SetPoint("CENTER", 0, 60)
    p:EnableMouse(true)
    p:SetMovable(true)
    p:RegisterForDrag("LeftButton")
    p:SetScript("OnDragStart", p.StartMoving)
    p:SetScript("OnDragStop", p.StopMovingOrSizing)
    do
        local c = closeButton(p, function()
            p:Hide()
        end)
        if c then
            c:SetPoint("TOPRIGHT", -8, -8)
        end
    end
    -- a mount's model
    local m = CreateFrame("PlayerModel", nil, p.body)
    m:SetSize(200, 200)
    m:SetPoint("TOPLEFT")
    local mi = 0
    local mountName = uiText(p.body, "caption", "ink-muted")
    mountName:SetPoint("TOP", m, "BOTTOM", 0, -4)
    local function nextMount()
        local ids: unknown[] = mountIDs or {}
        if #ids == 0 then
            mountName:SetValue("no mounts")
            return
        end
        mi = mi % #ids + 1
        local name = raw(C_MountJournal.GetMountInfoByID, ids[mi])
        local display = raw(C_MountJournal.GetMountInfoExtraByID, ids[mi])
        local ok, err = pcall(m.SetDisplayInfo, m, secret.asNumber(display) or 0)
        mountName:SetValue(
            ("%s (display %s)%s"):format(tostring(name), tostring(display), ok and "" or (" error " .. tostring(err)))
        )
    end
    local nm = button(p.body, { text = "Next mount", width = 110, onClick = nextMount })
    nm:SetPoint("TOP", mountName, "BOTTOM", 0, -6)
    -- you, trying on an appearance
    local d = CreateFrame("DressUpModel", nil, p.body)
    d:SetSize(200, 200)
    d:SetPoint("TOPRIGHT")
    local tryText = uiText(p.body, "caption", "ink-muted")
    tryText:SetPoint("TOP", d, "BOTTOM", 0, -4)
    local function tryOn()
        local ok = pcall(d.SetUnit, d, "player")
        local src = firstSource
        local ok2, err = true, nil
        if src then
            ok2, err = pcall(d.TryOn, d, src :: number | string)
        end
        tryText:SetValue(
            ("you %s, try on source %s %s"):format(
                ok and "shown" or "error",
                tostring(src),
                ok2 and "ok" or ("error " .. tostring(err))
            )
        )
    end
    local tb = button(p.body, { text = "Try on", width = 110, onClick = tryOn })
    tb:SetPoint("TOP", tryText, "BOTTOM", 0, -6)
    -- Summon / Dismiss from SuuUI's own button
    local sum = button(p.body, {
        text = "Summon test",
        width = 130,
        onClick = function()
            local id = usableMount
            if not id then
                note("no usable mount of yours on this character")
                return
            end
            if IsMounted and IsMounted() then
                note("Dismiss: " .. call(C_MountJournal.Dismiss))
            else
                note("SummonByID(" .. tostring(id) .. "): " .. call(C_MountJournal.SummonByID, id))
            end
        end,
    })
    sum:SetPoint("BOTTOMLEFT")
    -- a toy through SuuUI's own secure button
    local toy = CreateFrame("Button", "SuuUICollectionsProbeToy", p.body, "SecureActionButtonTemplate")
    toy:SetSize(130, 30)
    toy:SetPoint("BOTTOMRIGHT")
    toy:RegisterForClicks("AnyUp", "AnyDown")
    fill(toy, "surface-raised"):SetAllPoints()
    border(toy, "gilt-line")
    local tt = uiText(toy, "label", "ink")
    tt:SetPoint("CENTER")
    tt:SetValue("Toy test")
    local own = p :: OwnPanel
    own.toy, own.mountModel, own.dress, own.nextMount, own.tryOn = toy, m, d, nextMount, tryOn
    return own
end

export function command()
    -- the game's slot helpers live with its collections window
    if C_AddOns and C_AddOns.LoadAddOn then
        pcall(C_AddOns.LoadAddOn, "Blizzard_Collections")
    end
    out = { at = date("%Y-%m-%d %H:%M:%S") }
    DB.probe.collectionsOwn = out
    for _, step in ipairs({ mounts, pets, toys, heirlooms, appearances }) do
        local ok, err = pcall(step)
        if not ok then
            line("errors", tostring(err))
        end
    end
    local p = probePanel or build()
    probePanel = p
    p:Show()
    p.nextMount()
    p.tryOn()
    -- the toy button: set up out of combat
    if firstToy and not InCombatLockdown() then
        p.toy:SetAttribute("type", "toy")
        p.toy:SetAttribute("toy", firstToy)
        note("toy button ready for item " .. firstToy)
    elseif not firstToy then
        note("no toy of yours on this character: the toy test can't run here")
    end
    if not listening then
        listening = true
        local f = CreateFrame("Frame")
        for _, e in ipairs({
            "ADDON_ACTION_BLOCKED",
            "ADDON_ACTION_FORBIDDEN",
            "UNIT_SPELLCAST_SUCCEEDED",
            "UI_ERROR_MESSAGE",
            "COMPANION_UPDATE",
            "NEW_MOUNT_ADDED",
        }) do
            pcall(f.RegisterEvent, f, e)
        end
        f:SetScript("OnEvent", function(_, e: string, a: unknown, b: unknown, c: unknown)
            if e == "UNIT_SPELLCAST_SUCCEEDED" and a ~= "player" then
                return
            end
            note(("%s %s %s %s"):format(e, show(a), show(b), show(c)))
        end)
    end
    print(
        "Collections probe: data recorded. Try Summon test and Toy test if you can, look at both models (Next mount, Try on), then /reload."
    )
end
