-- Diagnostics/ChatProbe.wowlua
-- "/suu probe chat": where this client keeps its chat window functions
-- (adding and removing channels and message groups, opening and naming
-- windows). Globals, ChatFrameUtil, ChatFrame1's own methods and C_ChatInfo
-- whose names mention channels, message groups or chat windows, plus what
-- each chat window holds. Saved in SuuUIProbe.chat on /reload.
-- Also the input field's history: how many lines it keeps, its arrow key
-- mode, which key scripts it has, and every global, mixin method or field
-- whose name mentions history (send a couple of lines before probing).

import * as DB from "/Core/DB"
import print from "/Core/Init"
import isSecret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"

local WORDS = { "channel", "messagegroup", "chatwindow", "fcf_", "chatframe_" }

local function matches(name: string): boolean
    local low = name:lower()
    for _, w in ipairs(WORDS) do
        if low:find(w, 1, true) then
            return true
        end
    end
    return false
end

local function functionsIn(t: unknown, filter: boolean?): string[]
    local out: string[] = {}
    if type(t) ~= "table" then
        return out
    end
    for k, v in pairs(t) do
        if type(k) == "string" and type(v) == "function" and (not filter or matches(k)) then
            out[#out + 1] = k
        end
    end
    table.sort(out)
    return out
end

export function command()
    local out = { at = date("%H:%M:%S") }
    local globals = {}
    for k, v in pairs(_G) do
        if type(k) == "string" and type(v) == "function" and matches(k) then
            globals[#globals + 1] = k
        end
    end
    table.sort(globals)
    out.globals = globals
    out.ChatFrameUtil = functionsIn(_G.ChatFrameUtil)
    out.ChatFrame1 = functionsIn(ChatFrame1, true)
    local mt = getmetatable(ChatFrame1)
    out.ChatFrame1Meta = mt and type(mt.__index) == "table" and functionsIn(mt.__index, true) or "none"
    out.C_ChatInfo = functionsIn(C_ChatInfo, true)
    -- the windows and what they hold
    out.windows = {}
    for i = 1, (NUM_CHAT_WINDOWS or 10) do
        local name, _size, _, _, _, _, shown, _locked, docked = GetChatWindowInfo(i)
        local w = {
            name = isSecret(name) and "secret" or tostring(name),
            shown = tostring(shown),
            docked = tostring(docked),
        }
        local ok, channels = pcall(function()
            return { GetChatWindowChannels(i) }
        end)
        w.channels = ok and
            table.concat(
                (function()
                    local t = {}
                    for _, v in ipairs(channels) do
                        t[#t + 1] = tostring(v)
                    end
                    return t
                end)(),
                ", "
            ) or
            "error"
        local okG, groups = pcall(function()
            return { GetChatWindowMessages(i) }
        end)
        w.groups = okG and
            table.concat(
                (function()
                    local t = {}
                    for _, v in ipairs(groups) do
                        t[#t + 1] = tostring(v)
                    end
                    return t
                end)(),
                ", "
            ) or
            "error"
        out.windows[i] = w
    end
    local list = { GetChannelList() }
    local chans = {}
    for i = 1, #list, 3 do
        chans[#chans + 1] = tostring(list[i]) .. ":" .. tostring(list[i + 1])
    end
    out.channelList = table.concat(chans, ", ")
    -- the input field and its history
    local eb = frames.asEditBox(tbl.field(_G, "ChatFrame1EditBox"))
    local edit: { [string]: unknown } = {}
    if eb then
        local function try(m: string): string
            local fn = tbl.field(eb, m)
            if type(fn) ~= "function" then
                return "missing"
            end
            local ok, v = pcall(fn, eb)
            return ok and (isSecret(v) and "secret" or tostring(v)) or "error"
        end
        edit.historyLines = try("GetHistoryLines")
        edit.altArrowKeyMode = try("GetAltArrowKeyMode")
        edit.multiLine = try("IsMultiLine")
        edit.focused = try("HasFocus")
        local scripts: { [string]: string } = {}
        edit.scripts = scripts
        for _, sc in ipairs({
            "OnArrowPressed",
            "OnKeyDown",
            "OnKeyUp",
            "OnChar",
            "OnEnterPressed",
            "OnTabPressed",
            "OnEditFocusGained",
        }) do
            local ok, has = pcall(eb.HasScript, eb, sc)
            local fn = ok and has and eb:GetScript(sc)
            scripts[sc] = fn and "set" or (ok and has and "none" or "unsupported")
        end
        local fields: string[] = {}
        edit.fields = fields
        for k, v in pairs(eb :: { [unknown]: unknown }) do
            if type(k) == "string" and (k:lower():find("history") or k:lower():find("arrow")) then
                fields[#fields + 1] = k ..
                    " = " ..
                        type(v) ..
                            (type(v) == "table" and (" #" .. #v) or
                                (type(v) ~= "function" and (" " .. tostring(v)) or ""))
            end
        end
        table.sort(fields)
        local index = tbl.field(getmetatable(eb), "__index")
        local methods: string[] = {}
        if type(index) == "table" then
            for k in pairs(index) do
                if type(k) == "string" and (k:find("History") or k:find("Arrow")) then
                    methods[#methods + 1] = k
                end
            end
        end
        table.sort(methods)
        edit.methods = methods
    end
    local hist = {}
    for k, v in pairs(_G) do
        if type(k) == "string" and
            (k:find("History") and (k:find("Chat") or k:find("Edit")) or k:find("^ChatEdit_")) then
            hist[#hist + 1] = k .. " (" .. type(v) .. ")"
        end
    end
    table.sort(hist)
    edit.globals = hist
    local lastActive = frames.asFrame(ChatEdit_GetActiveWindow and ChatEdit_GetActiveWindow())
    edit.activeWindow = lastActive and lastActive:GetName() or "none"
    local lastUsed = frames.asFrame(ChatEdit_GetLastActiveWindow and ChatEdit_GetLastActiveWindow())
    edit.lastActiveWindow = lastUsed and lastUsed:GetName() or "none"
    out.editBox = edit
    DB.probe.chat = out
    print(("Chat probe: %d global functions found. /reload to save."):format(#globals))
end
