-- Diagnostics/CollectionsArtProbe.wowlua
-- "/suu probe collart" (with Collections open): what the collections window
-- draws, for its restyle (3.6; asked 2026-10-16 after the first try showed
-- the game's stone, corners and one side tab). It records now, then for two
-- minutes each pane as you switch to it:
--   tabs   each side tab: shown, size, place, checked, enabled
--   <pane> every texture under the shown pane (and the window itself): its
--          path of keys, layer, atlas or file, size, alpha, shown
-- Saved in SuuUIProbe.collectionsArt on /reload.

import after from "wowlua:timer"
import hook from "wowlua:hooks"
import isSecret from "wowlua:secret"
import * as DB from "/Core/DB"
import print from "/Core/Init"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"

-- whether the tab switch is hooked, and until when it records
local hooked = false
local untilTime: number? = nil

local function show(v: unknown): string
    if isSecret(v) then
        return "secret"
    end
    return tostring(v)
end
-- a size or offset, rounded; geometry can be secret on Forever
local function num(v: unknown): string
    if isSecret(v) then
        return "secret"
    end
    if type(v) ~= "number" then
        return tostring(v)
    end
    return tostring(math.floor(v + 0.5))
end

local function out(): { [string]: unknown }
    return tbl.recordAt(DB.probe, "collectionsArt")
end

-- The key a child sits under in its parent (MountJournal.LeftInset), else its name.
local function keyOf(parent: unknown, child: Region): string
    for k, v in pairs(wf.keyed(parent)) do
        if v == child then
            return k
        end
    end
    return child:GetName() or ("<" .. child:GetObjectType() .. ">")
end

-- a method's first result, protected (nil when it is missing or errors)
local function ask(obj: unknown, method: string): unknown
    local fn = tbl.field(obj, method)
    if type(fn) ~= "function" then
        return nil
    end
    local ok, v = pcall(fn, obj)
    return ok and v or nil
end

local function pointOf(r: Region): string
    local ok, p, rel, rp, x, y = pcall(r.GetPoint, r, 1)
    if not ok or not p then
        return "-"
    end
    local relName = rel and (ask(rel, "GetName") or "?") or "nil"
    return ("%s>%s.%s %s,%s"):format(show(p), show(relName), show(rp), num(x), num(y))
end

local function textures(frame: Frame, path: string, lines: string[], depth: number)
    if depth > 7 or #lines > 600 then
        return
    end
    for _, r in ipairs(wf.textures(frame)) do
        do
            -- each on its own: one that can't be read is a line saying why
            local ok, line = pcall(function()
                local atlas = r:GetAtlas()
                local file = r:GetTexture()
                local w, h = r:GetSize()
                local layer, sub = r:GetDrawLayer()
                return ("%s.%s [%s %s] %s %sx%s a=%s %s %s"):format(
                    path,
                    keyOf(frame, r),
                    show(layer),
                    show(sub),
                    atlas and ("atlas " .. show(atlas)) or ("file " .. show(file)),
                    num(w),
                    num(h),
                    show(r:GetAlpha()),
                    r:IsShown() and "shown" or "hidden",
                    pointOf(r)
                )
            end)
            lines[#lines + 1] = ok and line or (path .. ".? error " .. tostring(line))
        end
    end
    for _, c in ipairs(wf.children(frame)) do
        if c:IsShown() then
            textures(c, path .. "." .. keyOf(frame, c), lines, depth + 1)
        end
    end
end

local PANES = { "MountJournal", "PetJournal", "ToyBox", "HeirloomsJournal", "WardrobeCollectionFrame" }

export function record()
    local f = wf.find("CollectionsJournal")
    if not (f and f:IsShown()) then
        return
    end
    local o = out()
    o.at = date("%Y-%m-%d %H:%M:%S")
    local tabs: string[] = {}
    for i, tab in ipairs(tbl.list(tbl.field(f, "TabContainer", "Tabs"))) do
        local t = wf.asFrame(tab)
        local ok, line = pcall(function(): string
            local tf = assert(t, "not a frame")
            local w, h = tf:GetSize()
            return ("%d id=%s %s %sx%s %s checked=%s enabled=%s skinned=%s type=%s"):format(
                i,
                show(tf:GetID()),
                tf:IsShown() and "shown" or "hidden",
                num(w),
                num(h),
                pointOf(tf),
                show(ask(tf, "GetChecked")),
                show(ask(tf, "IsEnabled")),
                show(tbl.field(tf, "suuSkin") ~= nil),
                tf:GetObjectType()
            )
        end)
        tabs[#tabs + 1] = ok and line or (i .. " error " .. tostring(line))
    end
    o.tabs = tabs
    local own: string[] = {}
    for _, r in ipairs(wf.textures(f)) do
        if r:IsShown() and (r:GetAlpha() or 0) > 0 then
            local ok, line = pcall(function()
                return ("%s %s %s"):format(keyOf(f, r), show(r:GetAtlas() or r:GetTexture()), pointOf(r))
            end)
            own[#own + 1] = ok and line or ("error " .. tostring(line))
        end
    end
    o.window = own
    for _, name in ipairs(PANES) do
        local p = wf.find(name)
        if p and p:IsShown() then
            local lines: string[] = {}
            local ok, err = pcall(textures, p, name, lines, 0)
            if not ok then
                lines[#lines + 1] = "stopped: " .. tostring(err)
            end
            o[name] = lines
            print(("Collections art probe: %s, %d textures."):format(name, #lines))
        end
    end
end

export function command()
    local f = wf.find("CollectionsJournal")
    if not (f and f:IsShown()) then
        print("Collections art probe: open Collections first.")
        return
    end
    DB.probe.collectionsArt = {}
    record()
    if not hooked and tbl.field(_G, "CollectionsJournal_UpdateSelectedTab") then
        hooked = true
        -- loaded already (checked above), so this hooks it now
        hook(_G, "CollectionsJournal_UpdateSelectedTab", function()
            local t = untilTime
            if t and GetTime() < t then
                after(0.2, record)
            end
        end, { addon = "Blizzard_Collections" })
    end
    untilTime = GetTime() + 120
    print("Collections art probe: recorded; click through every tab within two minutes, then /reload.")
end
