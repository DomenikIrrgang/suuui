-- Diagnostics/SupportProbe.wowlua
-- "/suu probe support": can the Support window be SuuUI's own entirely
-- (asked 2026-10-17: a window SuuUI can redo, it redoes)? The game's is a
-- web page in a Browser frame (HelpBrowser:NavigateHome("KnowledgeBase")).
-- This opens a SuuUI panel the size of the game's and tries, in turn:
--   1. "Own browser": a Browser frame SuuUI creates, sent home;
--   2. "Game's browser": HelpBrowser moved into the panel (back on close).
-- Back, Forward, Reload and Home drive whichever shows. It records what
-- each call returned and the browser events. Screenshots show whether the
-- page loads and takes clicks and typing. Saved in SuuUIProbe.support on
-- /reload.

import * as DB from "/Core/DB"
import print from "/Core/Init"
import button from "/UI/Controls"
import panel as makePanel, Panel from "/UI/Panel"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"

-- the probe's panel and what it keeps
type SupportPanel = Panel & { area?: Frame, own?: Browser, borrowed?: () -> (), buttons?: boolean }
type Anchor = { point: FramePoint, rel: ScriptRegion?, relPoint: FramePoint?, x: number?, y: number? }

local panel: SupportPanel? = nil

local EVENTS = { "SIMPLE_BROWSER_WEB_PROXY_FAILED", "SIMPLE_BROWSER_WEB_ERROR" }

export function command()
    local out = { at = date("%Y-%m-%d %H:%M:%S"), calls = {}, events = {} }
    DB.probe.support = out
    local function note(text: string)
        table.insert(tbl.listAt(out, "calls"), date("%H:%M:%S ") .. text)
        print("Support probe: " .. text)
    end
    local function try(label: string, fn: unknown, ...: unknown): boolean
        if type(fn) ~= "function" then
            note(label .. ": missing")
            return false
        end
        local ok, err = pcall(fn, ...)
        note(("%s: %s"):format(label, ok and "ok" or ("error " .. tostring(err))))
        return ok
    end
    local p = panel or makePanel(UIParent, { title = "Support probe", width = 1000, height = 700, solid = true }) :: SupportPanel
    panel = p
    p:SetFrameStrata("HIGH")
    p:ClearAllPoints()
    p:SetPoint("CENTER")
    local area = p.area or CreateFrame("Frame", nil, p.body)
    p.area = area
    area:SetPoint("TOPLEFT", 0, -36)
    area:SetPoint("BOTTOMRIGHT")

    local current: Browser? = nil
    -- 1: SuuUI's own Browser frame
    local function own()
        local back = p.borrowed
        if back then back() end
        if not p.own then
            local ok, b = pcall(CreateFrame, "Browser", nil, area)
            note("CreateFrame(\"Browser\"): " .. (ok and (b and "ok" or "nil") or ("error " .. tostring(b))))
            if not ok or not b then return end
            p.own = b
            b:SetAllPoints(area)
            local methods: string[] = {}
            local index = tbl.field(getmetatable(b), "__index")
            if type(index) == "table" then
                for k in pairs(index) do
                    if type(k) == "string" and (k:find("Navigate") or k:find("Zoom") or k:find("Focus") or k:find("Link") or k:find("Ticket")) then
                        methods[#methods + 1] = k
                    end
                end
            end
            table.sort(methods)
            out.ownMethods = table.concat(methods, " ")
        end
        local browser = assert(p.own)
        browser:Show()
        current = browser
        try("own NavigateHome(\"KnowledgeBase\")", browser.NavigateHome, browser, "KnowledgeBase")
    end
    -- 2: the game's HelpBrowser, moved in for as long as the panel shows
    local function borrow()
        local mine = p.own
        if mine then mine:Hide() end
        local b = frames.find("HelpBrowser") :: Browser?
        if not b then note("HelpBrowser missing") return end
        if not p.borrowed then
            local parent: Frame?, points: Anchor[] = b:GetParent(), {}
            for i = 1, b:GetNumPoints() do
                local point, rel, relPoint, x, y = b:GetPoint(i)
                if point then points[#points + 1] = { point = point, rel = rel, relPoint = relPoint, x = x, y = y } end
            end
            p.borrowed = function()
                b:ClearAllPoints()
                b:SetParent(parent)
                for _, pt in ipairs(points) do b:SetPoint(pt.point, pt.rel, pt.relPoint, pt.x, pt.y) end
                p.borrowed = nil
            end
            try("HelpBrowser into the panel", function()
                b:SetParent(area)
                b:ClearAllPoints()
                b:SetAllPoints(area)
                b:Show()
            end)
        end
        current = b
        try("HelpBrowser NavigateHome(\"KnowledgeBase\")", b.NavigateHome, b, "KnowledgeBase")
    end

    if not p.buttons then
        p.buttons = true
        local defs: { label: string, fn: () -> () }[] = {
            { label = "Own browser", fn = own },
            { label = "Game's browser", fn = borrow },
            { label = "Back", fn = function() if current then try("NavigateBack", current.NavigateBack, current) end end },
            { label = "Forward", fn = function() if current then try("NavigateForward", current.NavigateForward, current) end end },
            { label = "Reload", fn = function() if current then try("NavigateReload", current.NavigateReload, current) end end },
            { label = "Home", fn = function() if current then try("NavigateHome", current.NavigateHome, current, "KnowledgeBase") end end },
        }
        local prev: Button? = nil
        for _, d in ipairs(defs) do
            local b = button(p.body, { text = d.label, width = 120, onClick = d.fn })
            b:SetPoint("TOPLEFT", prev or p.body, prev and "TOPRIGHT" or "TOPLEFT", prev and 8 or 0, 0)
            prev = b
        end
        local ev = CreateFrame("Frame", nil, p)
        for _, e in ipairs(EVENTS) do pcall(ev.RegisterEvent, ev, e) end
        ev:SetScript("OnEvent", function(_, event, ...)
            table.insert(tbl.listAt(out, "events"), date("%H:%M:%S ") .. event .. " " .. tostring((...)))
        end)
        p:HookScript("OnHide", function()
            local back = p.borrowed
            if back then back() end
        end)
    end
    p:Show()
    own()
    print("Support probe: SuuUI's own browser first. Screenshot it, click a link and type in the search;"
        .. " then \"Game's browser\" and the same. Close and /reload.")
end
