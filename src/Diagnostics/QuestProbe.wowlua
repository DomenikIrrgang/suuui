-- Diagnostics/QuestProbe.wowlua
-- "/suu probe quest": what Forever offers for SuuUI's objective tracker
-- (step 2.3). Saved in SuuUIProbe.quest on /reload.
--   * which quest functions exist (C_QuestLog, the older globals, quest
--     items, difficulty colours, super tracking) and which events are valid
--   * Blizzard's tracker frames (ObjectiveTrackerFrame and its modules)
--   * your quest log as the client gives it: each quest's info fields,
--     watched or not, objectives, finished / ready to turn in, its quest item,
--     the difficulty colour, and whether any value is secret
--   * whether the quest item template exists and is protected
--
--   /suu probe quest          sample (with some quests in your log, a quest
--                             item among them if you have one)
--   /suu probe quest item     a test button for your first quest item: click it
--                             out of combat and in combat, then /reload
--   /suu probe quest item off hide it

import isSecret from "wowlua:secret"
import * as DB from "/Core/DB"
import print from "/Core/Init"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"
import * as secret from "wowlua:secret"

-- The quest item test's record (SuuUIProbe.questItem).
type ItemTest = { item: string, logIndex: number, clicks: string[], blocked: string[], casts: string[] }


local function show(v: unknown): string
    if isSecret(v) then return "secret" end
    if v == nil then return "nil" end
    if type(v) == "table" then
        local parts: string[] = {}
        for k, x in pairs(v) do parts[#parts + 1] = tostring(k) .. "=" .. (isSecret(x) and "secret" or tostring(x)) end
        table.sort(parts)
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function call(fn: unknown, ...: unknown): string
    if type(fn) ~= "function" then return "missing" end
    local res = { pcall(fn, ...) }
    if not res[1] then return "error: " .. tostring(res[2]):sub(1, 160) end
    local parts: string[] = {}
    for i = 2, math.max(2, select("#", unpack(res))) do parts[#parts + 1] = show(res[i]) end
    return table.concat(parts, " | ")
end

local function namesIn(t: unknown): string[]
    local out: string[] = {}
    if type(t) ~= "table" then return { "missing" } end
    for k, v in pairs(t) do if type(k) == "string" and type(v) == "function" then out[#out + 1] = k end end
    table.sort(out)
    return out
end

local GLOBALS = {
    "GetNumQuestLogEntries", "GetQuestLogTitle", "GetQuestLogLeaderBoard", "GetNumQuestLeaderBoards",
    "GetNumQuestWatches", "GetQuestIndexForWatch", "AddQuestWatch", "RemoveQuestWatch", "IsQuestWatched",
    "GetQuestLogSpecialItemInfo", "GetQuestLogSpecialItemCooldown", "UseQuestLogSpecialItem",
    "IsQuestLogSpecialItemInRange", "GetQuestDifficultyColor", "GetDifficultyColor", "GetQuestGreenRange",
    "UnitQuestTrivialLevelRange", "GetQuestLogIndexByID", "IsQuestComplete", "GetQuestTimers",
    "GetQuestLogCompletionText", "QuestUtils_GetQuestName", "QuestUtil", "QuestMapFrame_OpenToQuestDetails",
    "ShowQuestLog", "ToggleQuestLog", "QuestLogFrame", "QuestMapFrame", "WorldMapFrame", "QuestFrame",
    "ObjectiveTrackerFrame", "ObjectiveTrackerManager", "QuestObjectiveTracker", "CampaignQuestObjectiveTracker",
    "ScenarioObjectiveTracker", "AchievementObjectiveTracker", "BonusObjectiveTracker", "WorldQuestObjectiveTracker",
    "ProfessionsRecipeTracker", "MonthlyActivitiesObjectiveTracker", "QuestWatchFrame", "WatchFrame",
    "ObjectiveTracker_Collapse", "ObjectiveTracker_Expand", "QuestObjectiveItemButtonMixin",
}

local EVENTS = {
    "QUEST_LOG_UPDATE", "QUEST_WATCH_LIST_CHANGED", "QUEST_WATCH_UPDATE", "QUEST_ACCEPTED", "QUEST_REMOVED",
    "QUEST_TURNED_IN", "QUEST_POI_UPDATE", "UNIT_QUEST_LOG_CHANGED", "SUPER_TRACKING_CHANGED",
    "QUEST_AUTOCOMPLETE", "QUEST_LOG_CRITERIA_UPDATE", "ENCOUNTER_START", "ENCOUNTER_END",
    "BAG_UPDATE_COOLDOWN", "QUEST_ITEM_UPDATE", "ZONE_CHANGED_NEW_AREA",
}

-- One quest log entry, every field and what goes with it.
local function quest(index: number): { [string]: unknown }
    local q: { [string]: unknown } = { index = index }
    local info: unknown = nil
    local getInfo = tbl.field(C_QuestLog, "GetInfo")
    if type(getInfo) == "function" then
        local ok, r = pcall(getInfo, index)
        if ok then info = r end
        q.info = ok and show(r) or ("error: " .. tostring(r))
    else
        q.title = call(tbl.field(_G, "GetQuestLogTitle"), index)
    end
    if type(info) ~= "table" then return q end
    if tbl.field(info, "isHeader") then q.header = true return q end
    local rawID = tbl.field(info, "questID")
    q.questID = show(rawID)
    local id = secret.asNumber(rawID)
    if not id then return q end
    local QL = C_QuestLog
    q.watchType = call(QL.GetQuestWatchType, id)
    q.isComplete = call(QL.IsComplete, id)
    q.readyForTurnIn = call(QL.ReadyForTurnIn, id)
    q.isFailed = call(QL.IsFailed, id)
    q.difficultyLevel = call(QL.GetQuestDifficultyLevel, id)
    q.title = call(QL.GetTitleForQuestID, id)
    q.logIndexForID = call(QL.GetLogIndexForQuestID, id)
    q.tagInfo = call(QL.GetQuestTagInfo, id)
    q.timeLeft = call(QL.GetTimeAllowed, id)
    q.requiredMoney = call(QL.GetRequiredMoney, id)
    q.distance = call(QL.GetDistanceSqToQuest, id)
    q.isOnMap = call(QL.IsOnMap, id)
    local objectives: string[] = {}
    local getObjectives = tbl.field(QL, "GetQuestObjectives")
    if type(getObjectives) == "function" then
        local ok, list = pcall(getObjectives, id)
        if ok and type(list) == "table" then
            for i, o in ipairs(tbl.list(list)) do objectives[i] = show(o) end
        else
            objectives[1] = ok and show(list) or ("error: " .. tostring(list))
        end
    end
    q.objectives = objectives
    if tbl.field(_G, "GetQuestLogLeaderBoard") then
        local board: string[] = {}
        for i = 1, 5 do
            local r = call(GetQuestLogLeaderBoard, i, index)
            if r == "nil | nil | nil" or r == "nil" then break end
            board[i] = r
        end
        q.leaderBoard = board
    end
    q.completionText = call(GetQuestLogCompletionText, index)
    q.specialItem = call(GetQuestLogSpecialItemInfo, index)
    q.specialItemCooldown = call(GetQuestLogSpecialItemCooldown, index)
    q.specialItemInRange = call(IsQuestLogSpecialItemInRange, index)
    local level = secret.asNumber(tbl.field(info, "difficultyLevel") or tbl.field(info, "level"))
    if level then
        q.difficultyColor = call(GetQuestDifficultyColor, level)
        q.difficultyColorByLevel = call(GetDifficultyColor, level)
    end
    return q
end

local function frameInfo(value: unknown): unknown
    local f = wf.asRegion(value)
    if not f then return "missing" end
    local out: { [string]: unknown } = { name = f:GetName() or "?", shown = show(f:IsShown()), protected = show((f:IsProtected())) }
    out.children = tbl.keys(wf.keyed(f))
    out.point = call(f.GetPoint, f, 1)
    return out
end

export function sample(): { [string]: unknown }
    local store: { [string]: unknown } = { at = date("%H:%M:%S") }
    DB.probe.quest = store
    store.context = {
        level = show(UnitLevel("player")),
        instance = select(2, IsInInstance()) or "none",
        combat = InCombatLockdown() and "in combat" or "out of combat",
        trivialRange = call(UnitQuestTrivialLevelRange, "player"),
        greenRange = call(tbl.field(_G, "GetQuestGreenRange")),
    }
    store.C_QuestLog = namesIn(C_QuestLog)
    store.C_SuperTrack = namesIn(C_SuperTrack)
    store.C_QuestInfoSystem = namesIn(C_QuestInfoSystem)
    local globals: { [string]: string } = {}
    for _, name in ipairs(GLOBALS) do
        local v = tbl.field(_G, name)
        globals[name] = v ~= nil and type(v) or "missing"
    end
    store.globals = globals
    local events: { [string]: string } = {}
    for _, e in ipairs(EVENTS) do events[e] = show(C_EventUtils.IsEventValid(e)) end
    store.events = events
    store.cvars = {
        autoQuestWatch = show(GetCVar("autoQuestWatch")),
        autoQuestProgress = show(GetCVar("autoQuestProgress")),
        trackQuestSorting = show(GetCVar("trackQuestSorting")),
    }
    -- Blizzard's tracker
    store.tracker = frameInfo(tbl.field(_G, "ObjectiveTrackerFrame"))
    store.questTracker = frameInfo(tbl.field(_G, "QuestObjectiveTracker"))
    -- the quest item template: does it exist, is it protected
    local ok, made = pcall(CreateFrame, "Button", nil, UIParent, "QuestObjectiveItemButtonTemplate")
    local b = ok and wf.asButton(made) or nil
    if b then
        store.itemTemplate = { exists = true, protected = show((b:IsProtected())), type = show(b:GetAttribute("type")) }
        b:Hide()
    else
        store.itemTemplate = { exists = false, error = tostring(made):sub(1, 160) }
    end
    -- the log
    local n = (select(1, C_QuestLog.GetNumQuestLogEntries()))
    store.entries = show(n)
    local quests: { [string]: unknown }[] = {}
    store.quests = quests
    for i = 1, math.min(secret.asNumber(n) or 0, 40) do quests[#quests + 1] = quest(i) end
    -- watches
    local watchList: string[] = {}
    local watches: { [string]: unknown } = { list = watchList }
    local count = C_QuestLog.GetNumQuestWatches()
    watches.count = show(count)
    for i = 1, secret.asNumber(count) or 0 do watchList[#watchList + 1] = call(C_QuestLog.GetQuestIDForQuestWatchIndex, i) end
    store.watches = watches
    store.watchCount = #watchList
    store.superTracked = call(C_SuperTrack.GetSuperTrackedQuestID)
    return store
end

-- A test button for your first quest item: a plain secure "item" button,
-- the way SuuUI's tracker would make it. Counts clicks, notes blocked
-- actions and the spell casts that follow.
local testButton: Button? = nil
local testIcon: Texture? = nil
local function firstQuestItem(): (string?, unknown, number?)
    local n = secret.asNumber((C_QuestLog.GetNumQuestLogEntries())) or 0
    for i = 1, n do
        local ok, link, icon = pcall(GetQuestLogSpecialItemInfo, i)
        local text = ok and secret.asString(link)
        if text then return text, icon, i end
    end
    return nil, nil, nil
end

-- The test's record, while there is one.
local function itemLog(): ItemTest?
    local l = DB.probe.questItem
    if type(l) ~= "table" then return nil end
    local log = DB.probeData("questItem", function(): ItemTest return { item = "", logIndex = 0, clicks = {}, blocked = {}, casts = {} } end)
    return log
end

local function itemTest(off: boolean)
    if off then
        if testButton then testButton:Hide() end
        print("Quest probe: test button hidden.")
        return
    end
    if InCombatLockdown() then print("Quest probe: make the button out of combat.") return end
    local link, icon, index = firstQuestItem()
    if not (link and index) then print("Quest probe: no quest item in your log (a quest that gives a usable item).") return end
    local log: ItemTest = { item = link, logIndex = index, clicks = {}, blocked = {}, casts = {} }
    DB.probe.questItem = log
    local tb, tex = testButton, testIcon
    if not (tb and tex) then
        tb = CreateFrame("Button", "SuuUIQuestProbeItem", UIParent, "SecureActionButtonTemplate")
        testButton = tb
        tb:SetSize(36, 36)
        tb:SetPoint("CENTER", 0, 120)
        tb:RegisterForClicks("AnyDown", "AnyUp")
        tex = tb:CreateTexture(nil, "ARTWORK")
        testIcon = tex
        tex:SetAllPoints()
        tb:HookScript("PostClick", function(_, _button, down)
            local l = itemLog()
            if l then table.insert(l.clicks, date("%H:%M:%S") .. (InCombatLockdown() and " in combat" or " out of combat") .. (down and " down" or " up")) end
        end)
        local ev = CreateFrame("Frame")
        ev:RegisterEvent("ADDON_ACTION_BLOCKED")
        ev:RegisterEvent("ADDON_ACTION_FORBIDDEN")
        ev:RegisterUnitEvent("UNIT_SPELLCAST_SUCCEEDED", "player")
        ev:RegisterUnitEvent("UNIT_SPELLCAST_FAILED", "player")
        ev:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown, c: unknown)
            local l = itemLog()
            if not l then return end
            if event == "UNIT_SPELLCAST_SUCCEEDED" or event == "UNIT_SPELLCAST_FAILED" then
                table.insert(l.casts, event .. " spell " .. show(c) .. (InCombatLockdown() and " in combat" or ""))
            else
                table.insert(l.blocked, event .. " " .. show(a) .. " " .. show(b))
            end
        end)
    end
    tb:SetAttribute("type", "item")
    tb:SetAttribute("item", link)
    local file = secret.asNumber(icon) or secret.asString(icon)
    if file then tex:SetTexture(file) end
    tb:Show()
    print("Quest probe: a test button for " .. link .. " above the middle of the screen. Use it out of combat and in combat (where the item works), then /reload.")
end

export function command(arg: string?)
    if arg == "item" then return itemTest(false) end
    if arg == "item off" then return itemTest(true) end
    local s = sample()
    print(("Quest probe: %d log entries, %d watched. /reload to save it."):format(
        tonumber(s.entries) or 0, secret.asNumber(s.watchCount) or 0))
end
