-- Diagnostics/ClassData.wowlua
-- "/suu probe class": what this class really gets on Forever, for the
-- Cooldown Manager presets (plan step 1.7c). Works at level 1:
--   talents   every node of the class's talent trees, learned or not, with
--             its spell ID (through C_Traits, as Forever's talents are built),
--             its description and base cooldown (read a moment later: the
--             client loads spell text on demand)
--   trainer   when a class trainer's window opens: every spell it lists,
--             unavailable ones included, with rank, required level,
--             description and training cost (copper)
-- Saved per class in SuuUIProbe.classData[CLASS] on /reload.
--
--   /suu probe class    read the talents now; then talk to the class trainer

import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as events from "/Core/Events"
import after from "wowlua:timer"
import asNumber, asString from "wowlua:secret"
import * as tbl from "wowlua:table"

-- the owner of this file's event handlers
const OWNER = "ClassData"

local listening = false
local field = tbl.field

-- One class's data (SuuUIProbe.classData[class]).
type ClassRecord = { [string]: unknown }

local function store(): (ClassRecord, string)
    local all = DB.probeData("classData", function(): { [string]: ClassRecord } return {} end)
    local _, playerClass = UnitClass("player")
    local class = asString(playerClass) or "?"
    local d = all[class] or {}
    d.character = UnitName("player")
    d.level = UnitLevel("player")
    d.race = select(2, UnitRace("player"))
    all[class] = d
    return d, class
end

local function call(fn: unknown, ...: unknown): (unknown, unknown, unknown, unknown)
    if type(fn) ~= "function" then return nil, nil, nil, nil end
    local ok, a, b, c, d = pcall(fn, ...)
    if ok then return a, b, c, d end
    return nil, nil, nil, nil
end

--------------------------------------------------------------------------------
-- Talents
--------------------------------------------------------------------------------

local CT: unknown, TR: unknown, SI: unknown = field(_G, "C_ClassTalents"), field(_G, "C_Traits"), field(_G, "C_SpecializationInfo")

-- The config to read the trees from: the active one, else the spec's.
local function configID(): unknown
    local id = call(field(CT, "GetActiveConfigID"))
    if id then return id end
    local spec = call(field(SI, "GetSpecialization")) or 1
    local specID = call(field(SI, "GetSpecializationInfo"), spec)
    if specID then
        local first = tbl.list((call(field(CT, "GetConfigIDsBySpecID"), specID)))[1]
        if first then return first end
        local treeID = call(field(CT, "GetTraitTreeForSpec"), specID)
        if treeID then return (call(field(TR, "GetConfigIDByTreeID"), treeID)) end
    end
    return nil
end

-- A talent as the probe saves it (spell, tree position, ranks; described later).
export type Talent = { spellID: number, name?: string, tree: unknown, node: unknown, subTree?: unknown, x?: unknown, y?: unknown,
                       maxRanks?: unknown, passive?: unknown, description?: string, cooldown?: number }

export function readTalents(): number
    local d = store()
    local talents: Talent[] = {}
    local cfg = configID()
    local info = cfg and call(field(TR, "GetConfigInfo"), cfg)
    local treeIDs = field(info, "treeIDs")
    if not treeIDs then
        d.talentsError = "no talent config (C_ClassTalents/C_Traits gave nothing)"
        return 0
    end
    for _, treeID in ipairs(tbl.list(treeIDs)) do
        for _, nodeID in ipairs(tbl.list((call(field(TR, "GetTreeNodes"), treeID)))) do
            local ni = call(field(TR, "GetNodeInfo"), cfg, nodeID)
            for _, entryID in ipairs(tbl.list(field(ni, "entryIDs"))) do
                local ei = call(field(TR, "GetEntryInfo"), cfg, entryID)
                local defID = field(ei, "definitionID")
                local di = defID and call(field(TR, "GetDefinitionInfo"), defID)
                local spellID = asNumber(field(di, "spellID") or field(di, "overriddenSpellID"))
                if spellID then
                    talents[#talents + 1] = {
                        spellID = spellID,
                        name = C_Spell.GetSpellName(spellID),
                        tree = treeID, node = nodeID,
                        subTree = field(ni, "subTreeID"), x = field(ni, "posX"), y = field(ni, "posY"),
                        maxRanks = field(ni, "maxRanks"), passive = (call(field(C_Spell, "IsSpellPassive"), spellID)),
                    }
                end
            end
        end
    end
    d.talents, d.talentsAt, d.talentsError = talents, date("%Y-%m-%d %H:%M"), nil
    describe(talents)
    return #talents
end

-- What each talent does and its base cooldown: Forever's own talents have no
-- other source. The client loads spell text on demand, so ask for all of it
-- first and read it a moment later.
export function describe(talents: Talent[])
    for _, t in ipairs(talents) do
        call(field(C_Spell, "RequestLoadSpellData"), t.spellID)
    end
    after(2, function()
        local n = 0
        for _, t in ipairs(talents) do
            local desc = asString((call(C_Spell.GetSpellDescription, t.spellID)))
            if desc and desc ~= "" then
                t.description = desc
                n = n + 1
            end
            local cd = asNumber((call(field(_G, "GetSpellBaseCooldown"), t.spellID)))
            if cd and cd > 0 then t.cooldown = cd end
        end
        print(("Class data: %d of %d talent descriptions read. /reload to save."):format(n, #talents))
    end)
end

--------------------------------------------------------------------------------
-- Trainer
--------------------------------------------------------------------------------

-- A trainer service as the probe saves it.
type TrainerSpell = { index: number, name: unknown, rank?: unknown, kind: unknown, icon?: unknown, level?: number, link?: unknown,
                      skill?: unknown, description?: string, cost?: number, spellID?: number, levelFrom?: string,
                      descriptionFrom?: string }

-- A trainer function by name (nil on a client without it).
local function trainerFn(name: string): unknown
    return field(_G, name)
end

export function readTrainer(): (number, number)
    local d = store()
    if not trainerFn("GetNumTrainerServices") then
        d.trainerError = "no trainer API"
        return 0, 0
    end
    -- every service, not only what you can learn now (onTrainer switched
    -- the filters on and waited for the game to apply them)
    call(trainerFn("ExpandTrainerSkillLine"), 0)
    local spells: TrainerSpell[], maxLevel = {}, 0
    local n = asNumber((call(trainerFn("GetNumTrainerServices")))) or 0
    for i = 1, n do
        -- this client answers name, availability, icon (no rank); older ones
        -- name, rank, availability
        local name, a, b = call(trainerFn("GetTrainerServiceInfo"), i)
        local rank: unknown, kind: unknown, icon: unknown = nil, nil, nil
        if a == "available" or a == "unavailable" or a == "used" or a == "header" then
            kind, icon = a, b
        else
            rank, kind = a, b
        end
        if name and kind ~= "header" then
            local level = asNumber((call(trainerFn("GetTrainerServiceLevelReq"), i)))
            if level and level > maxLevel then maxLevel = level end
            local link = call(trainerFn("GetTrainerServiceItemLink"), i)
            local desc = asString((call(trainerFn("GetTrainerServiceDescription"), i)))
            local cost = asNumber((call(trainerFn("GetTrainerServiceCost"), i)))
            spells[#spells + 1] = { index = i, name = name, rank = rank ~= "" and rank or nil, kind = kind, icon = icon, level = level, link = link,
                skill = (call(trainerFn("GetTrainerServiceSkillLine"), i)),
                description = desc ~= "" and desc or nil,
                cost = cost }
        end
    end
    -- C_Trainer, if this client has it (names only, for later)
    local api: string[] = {}
    local trainerApi = field(_G, "C_Trainer")
    if type(trainerApi) == "table" then
        for k in pairs(trainerApi) do api[#api + 1] = tostring(k) end
    end
    table.sort(api)
    d.trainer, d.trainerAt, d.trainerMaxLevel, d.trainerAPI, d.trainerError = spells, date("%Y-%m-%d %H:%M"), maxLevel, api, nil
    -- the game loads a description on demand: the ones still missing once
    -- more, a moment later (a spell new today came back without one); and
    -- each service's spell ID, from its tooltip (a new spell has none in
    -- SuuUI's ID scans yet)
    local tooltipOf = field(C_TooltipInfo, "GetTrainerService")
    after(1.5, function()
        for _, sp in ipairs(spells) do
            if tooltipOf then
                local data = call(tooltipOf, sp.index)
                local id = asNumber(field(data, "id"))
                if id then sp.spellID = id end
                -- a spell you know comes with no level from the trainer: the
                -- game knows it from the spell
                local spellID = sp.spellID
                if spellID and (sp.level or 0) == 0 then
                    local lvl = asNumber((call(field(C_Spell, "GetSpellLevelLearned"), spellID)))
                    if lvl and lvl > 0 then
                        sp.level = lvl
                        sp.levelFrom = "spell"
                    end
                end
            end
            if not sp.description then
                local desc = asString((call(trainerFn("GetTrainerServiceDescription"), sp.index)))
                if desc and desc ~= "" then sp.description = desc end
            end
            -- some have none in the trainer's data (Salvation, new on
            -- 2026-10-16) but show one in their tooltip: its last long line
            if not sp.description and tooltipOf then
                local data = call(tooltipOf, sp.index)
                local lines = tbl.list(field(data, "lines"))
                for k = #lines, 2, -1 do
                    local text = asString(field(lines[k], "leftText"))
                    if text and #text > 30 and not text:find("^Requires") then
                        sp.description = text
                        sp.descriptionFrom = "tooltip"
                        break
                    end
                end
            end
        end
        local ids, noLevel = 0, 0
        for _, sp in ipairs(spells) do
            if sp.spellID then ids = ids + 1 end
            if (sp.level or 0) == 0 then noLevel = noLevel + 1 end
        end
        print(("Class data: done, %d of %d with their spell ID, %d without a level. /reload to save."):format(ids, #spells, noLevel))
    end)
    d.trainerNPC = UnitName("npc")
    return #spells, maxLevel
end

-- Every service shows only once the game applied the filters: switch them
-- all on, then read on its next TRAINER_UPDATE (or after two seconds). Read
-- at once, the list lacked what you already know (Used was off a moment ago).
local function allFilters(): boolean
    local changed = false
    local set, get = trainerFn("SetTrainerServiceTypeFilter"), trainerFn("GetTrainerServiceTypeFilter")
    if set then
        for _, kind in ipairs({ "available", "unavailable", "used" }) do
            if get and not call(get, kind) then changed = true end
            call(set, kind, true)
        end
    end
    return changed
end

local function onTrainer()
    if not listening then return end
    local waited = false
    local function read()
        if waited then return end
        waited = true
        local count, maxLevel = readTrainer()
        print(("Class data: the trainer lists %d spells, up to level %d. Reading their IDs and descriptions…"):format(count, maxLevel))
        if count > 0 and maxLevel < 50 then
            print("Class data: this trainer stops early; a city trainer may list the rest.")
        end
    end
    after(0.2, function()
        if allFilters() then
            events.onGame("TRAINER_UPDATE", function() after(0.2, read) end, OWNER)
            after(2, read)
        else
            read()
        end
    end)
end

export function command()
    local count = readTalents()
    local _, class = store()
    print(("Class data (%s): %d talents read. Now talk to your class trainer."):format(class, count))
    if not listening then
        listening = true
        events.onGame("TRAINER_SHOW", onTrainer, OWNER)
    end
end
