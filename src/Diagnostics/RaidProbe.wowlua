-- Diagnostics/RaidProbe.wowlua
-- "/suu probe raid" (asked 2026-10-19: a raid planner that arranges the real
-- raid into saved groups; the build waits on it): what Forever lets an addon
-- read and change about a raid's groups.
--   now:     whether you lead or assist, the roster (every GetRaidRosterInfo
--            return and how many there are, each member's role), which
--            group functions exist, and the client's documentation for them
--            with what it says of their restrictions
--   move:    one member (the last one that isn't you, in a group that isn't
--            full) to another group with room (SetRaidSubgroup): first from
--            the chat command, then once more from a button's click
--   swap:    two members of different groups traded (SwapRaidSubgroup), the
--            same two ways
--   burst:   three SetRaidSubgroup moves in one frame: how many land
--   inspect: an inspect of your target: what it gives for talents, how long
--            INSPECT_READY takes, and whether it works out of range
-- Each test records whether the call errored, whether the game blocked it
-- (ADDON_ACTION_BLOCKED or _FORBIDDEN), when GROUP_ROSTER_UPDATE came and
-- whether the groups really changed (at the first update and after 2 s).
-- Nothing is moved in combat. Saved in SuuUIProbe.raid on /reload. Values
-- the game hides read SECRET.
--
--   /suu probe raid           the roster and the documentation
--   /suu probe raid move      move one member
--   /suu probe raid swap      swap two members
--   /suu probe raid burst     three moves at once
--   /suu probe raid inspect   inspect your target

import * as DB from "/Core/DB"
import name as addonName, print from "/Core/Init"
import * as apiDocs from "/Diagnostics/ApiDocs"
import isSecret from "wowlua:secret"
import after from "wowlua:timer"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"

-- a raid member as the roster reads them, a move a test makes, a call it runs
type Entry = { index: number, name: string, group: number, me: boolean }
type Member = { name: string, from: number, to: number }
type Call = { label: string, fn: (a: number, b: number) -> (), args: number[] }
type Record = { [string]: unknown }
-- A move test: what it moved, its calls, and what the game answered.
type Test = { kind: string, via: string, at: string, leader: string, assistant: string, members: Member[],
              calls: string[], blocked: string[], uiErrors: string[], rosterUpdates: string[], started: number,
              after2s?: string[], landed?: string, atFirstUpdate?: string[] }
-- An inspect of your target, and what it gave.
type Inspect = { at: string, unit: string, name: string, inRaid: string, canInspect: string, visible: string,
                 connected: string, inRange: string, interact: string, inCombat: boolean, started: number,
                 notify?: string, ready?: string, talents?: Record, otherReady?: number }
type Snapshot = { at: string, inRaid: string, inGroup: string, leader: string, assistant: string, everyoneAssistant: string,
                  members: string, inCombat: boolean, api: { [string]: string }, roster: string[] }
-- What the probe saves in SuuUIProbe.raid.
type Out = { now?: Snapshot, docs?: unknown, docFlags?: unknown, tests?: Test[], inspects?: Inspect[] }

local function show(v: unknown): string
    if isSecret(v) then return "SECRET" end
    return tostring(v)
end

-- A function that may not exist, may error or may answer secret.
local function call(fn: unknown, ...: unknown): (unknown, unknown, unknown, unknown)
    if type(fn) ~= "function" then return "missing", nil, nil, nil end
    local ok, a, b, c, d = pcall(fn, ...)
    if not ok then return "error: " .. tostring(a):sub(1, 120), nil, nil, nil end
    return a, b, c, d
end

-- Every return of a call, shown, and how many there were.
local function pack(ok: boolean, ...: unknown): (boolean, number, unknown[]) return ok, select("#", ...), { ... } end
local function every(fn: unknown, ...: unknown): (string, number)
    if type(fn) ~= "function" then return "missing", 0 end
    local ok, n, res = pack(pcall(fn, ...))
    if not ok then return "error: " .. tostring(res[1]):sub(1, 120), 0 end
    local parts: string[] = {}
    for i = 1, n do parts[i] = show(res[i]) end
    return table.concat(parts, ", "), n
end


local function out(): Out
    return DB.probeData("raid", function(): Out return {} end)
end

local GROUPS = secret.asNumber(tbl.field(_G, "NUM_RAID_GROUPS")) or 8
local FUNCTIONS = { "SetRaidSubgroup", "SwapRaidSubgroup", "ConvertToRaid", "ConvertToParty", "GetRaidRosterInfo",
    "PromoteToAssistant", "DemoteAssistant", "SetEveryoneIsAssistant", "IsEveryoneAssistant", "NotifyInspect",
    "ClearInspectPlayer", "CanInspect", "GetInspectSpecialization", "GetTalentTabInfo", "GetNumTalentTabs" }

--------------------------------------------------------------------------------
-- The roster
--------------------------------------------------------------------------------

-- The roster as secret.readable values (members whose name or group is secret are
-- left out), and how many are in each group.
local function roster(): (Entry[], number[])
    local list: Entry[], counts: number[] = {}, {}
    for g = 1, GROUPS do counts[g] = 0 end
    local n = call(GetNumGroupMembers)
    if not (type(n) == "number" and secret.readable(n)) then return list, counts end
    for i = 1, n do
        local name, _, group = call(GetRaidRosterInfo, i)
        if type(name) == "string" and secret.readable(name) and type(group) == "number" and secret.readable(group) then
            local okMe, me = pcall(UnitIsUnit, "raid" .. i, "player")
            list[#list + 1] = { index = i, name = name, group = group, me = okMe and secret.flag(me) }
            counts[group] = (counts[group] or 0) + 1
        end
    end
    return list, counts
end

-- Each named member's group now (by name: the indexes may change with the roster).
local function groupsOf(members: Member[]): (string[], { [string]: number })
    local list = roster()
    local at: { [string]: number } = {}
    for _, m in ipairs(list) do at[m.name] = m.group end
    local now: string[] = {}
    for i, m in ipairs(members) do now[i] = m.name .. " in " .. show(at[m.name]) end
    return now, at
end

local function snapshot(): Snapshot
    local o = out()
    local s: Snapshot = { at = date("%H:%M:%S"), inRaid = show(call(IsInRaid)), inGroup = show(call(IsInGroup)),
        leader = show(call(UnitIsGroupLeader, "player")), assistant = show(call(UnitIsGroupAssistant, "player")),
        everyoneAssistant = show(call(IsEveryoneAssistant)), members = show(call(GetNumGroupMembers)),
        inCombat = InCombatLockdown() and true or false, api = {}, roster = {} }
    for _, name in ipairs(FUNCTIONS) do s.api[name] = type(tbl.field(_G, name)) == "function" and "yes" or "missing" end
    for _, name in ipairs({ "ConvertToRaid", "ConvertToParty", "SetRaidSubgroup", "SwapRaidSubgroup" }) do
        s.api["C_PartyInfo." .. name] = type(tbl.field(C_PartyInfo, name)) == "function" and "yes" or "missing"
    end
    -- every return of GetRaidRosterInfo, so the planner knows what it has
    local n = call(GetNumGroupMembers)
    if type(n) == "number" and secret.readable(n) and call(IsInRaid) == true then
        for i = 1, n do
            local text, count = every(GetRaidRosterInfo, i)
            s.roster[i] = ("raid%d: %d returns: %s; role %s"):format(i, count, text,
                show(call(UnitGroupRolesAssigned, "raid" .. i)))
        end
    end
    o.now = s
    -- the documentation, and what it says beyond the types
    do
        local lines, err = apiDocs.dump({ "subgroup", "raidroster", "rosterinfo", "converttoraid", "converttoparty", "assistant" })
        o.docs = lines or err
        local flags, ferr = apiDocs.flags(FUNCTIONS)
        o.docFlags = flags or ferr
    end
    return s
end

--------------------------------------------------------------------------------
-- Moving members
--------------------------------------------------------------------------------

-- The first group other than `except` with room, from group 1.
local function roomIn(counts: number[], except: number?): number?
    for g = 1, GROUPS do
        if g ~= except and (counts[g] or 0) < 5 then return g end
    end
    return nil
end

-- The last member who isn't you (or in `skip`), in a group that isn't full,
-- and a group they can go to.
local function pickMove(list: Entry[], counts: number[], skip: { [string]: boolean }?): (Entry?, number?)
    for i = #list, 1, -1 do
        local m = list[i]
        if not m.me and not (skip and skip[m.name]) and counts[m.group] < 5 then
            local to = roomIn(counts, m.group)
            if to then return m, to end
        end
    end
    return nil, nil
end

local test: Test? = nil -- the test waiting for its answer
local listener: Frame? = nil
local again: Button? = nil
local inspectReady: (guid: unknown) -> ()

local function finish(t: Test)
    if test ~= t then return end
    test = nil
    local o = out()
    local now, at = groupsOf(t.members)
    t.after2s = now
    local landed = 0
    for _, m in ipairs(t.members) do
        if at[m.name] == m.to then landed = landed + 1 end
    end
    local result = ("%d of %d"):format(landed, #t.members)
    t.landed = result
    local tests = o.tests or {}
    o.tests = tests
    tests[#tests + 1] = t
    print(("Raid probe: %s (%s): %s landed, %d blocked, %d roster updates."):format(t.kind, t.via, result,
        #t.blocked, #t.rosterUpdates))
end

local function listen()
    if listener then return end
    local f = CreateFrame("Frame")
    listener = f
    for _, e in ipairs({ "GROUP_ROSTER_UPDATE", "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN", "UI_ERROR_MESSAGE", "INSPECT_READY" }) do
        pcall(f.RegisterEvent, f, e)
    end
    f:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown)
        if event == "INSPECT_READY" then return inspectReady(a) end
        local t = test
        if not t then return end
        local dt = ("%.2f s"):format(GetTime() - t.started)
        if event == "GROUP_ROSTER_UPDATE" then
            table.insert(t.rosterUpdates, dt)
            if not t.atFirstUpdate then t.atFirstUpdate = (groupsOf(t.members)) end
        elseif event == "UI_ERROR_MESSAGE" then
            table.insert(t.uiErrors, dt .. " " .. show(a) .. " " .. show(b))
        else
            -- anyone's, marked when it is SuuUI's
            table.insert(t.blocked, ("%s %s %s %s%s"):format(dt, event, show(a), show(b), a == addonName and " (SuuUI)" or ""))
        end
    end)
end

-- One test: which members, to where, and the calls that move them.
local function plan(kind: string, list: Entry[], counts: number[]): (Member[], Call[])
    local members: Member[], calls: Call[] = {}, {}
    if kind == "move" then
        local m, to = pickMove(list, counts)
        if m and to then
            members[1] = { name = m.name, from = m.group, to = to }
            calls[1] = { label = ("SetRaidSubgroup(%d, %d)"):format(m.index, to), fn = SetRaidSubgroup, args = { m.index, to } }
        end
    elseif kind == "swap" then
        -- two others if there are; else you and another (a raid of two)
        local a, b
        for _, withMe in ipairs({ false, true }) do
            a, b = nil, nil
            for i = #list, 1, -1 do
                local m = list[i]
                if withMe or not m.me then
                    if not a then a = m elseif m.group ~= a.group then b = m break end
                end
            end
            if b then break end
        end
        if a and b then
            members[1] = { name = a.name, from = a.group, to = b.group }
            members[2] = { name = b.name, from = b.group, to = a.group }
            calls[1] = { label = ("SwapRaidSubgroup(%d, %d)"):format(a.index, b.index), fn = SwapRaidSubgroup, args = { a.index, b.index } }
        end
    elseif kind == "burst" then
        local skip: { [string]: boolean } = {}
        for _ = 1, 3 do
            local m, to = pickMove(list, counts, skip)
            if not (m and to) then break end
            skip[m.name] = true
            counts[m.group] = counts[m.group] - 1
            counts[to] = counts[to] + 1
            members[#members + 1] = { name = m.name, from = m.group, to = to }
            calls[#calls + 1] = { label = ("SetRaidSubgroup(%d, %d)"):format(m.index, to), fn = SetRaidSubgroup, args = { m.index, to } }
        end
        -- fewer than three to move (a small raid): the last one on again, group
        -- after group, in the same frame; landed means it reached the last
        local last = members[#members]
        while last and #calls < 3 do
            local to
            for g = last.to + 1, GROUPS do
                if (counts[g] or 0) < 5 then to = g break end
            end
            if not to then break end
            counts[last.to] = counts[last.to] - 1
            counts[to] = counts[to] + 1
            local index = calls[#calls].args[1]
            calls[#calls + 1] = { label = ("SetRaidSubgroup(%d, %d) again"):format(index, to), fn = SetRaidSubgroup, args = { index, to } }
            last.to = to
        end
    end
    return members, calls
end

local function run(kind: string, via: string): Test?
    if InCombatLockdown() then
        print("Raid probe: not in combat. Moving raid members waits until the fight is over; try again then.")
        return nil
    end
    if call(IsInRaid) ~= true then
        print("Raid probe: you're not in a raid. Make one (you as leader or assistant, a few members) and try again.")
        return nil
    end
    if test then
        print("Raid probe: the last test is still waiting for its answer (2 s).")
        return nil
    end
    local list, counts = roster()
    local members, calls = plan(kind, list, counts)
    if #calls == 0 then
        print(kind == "swap"
            and "Raid probe: no two members (other than you) in different groups to swap."
            or "Raid probe: no member (other than you) with a group that has room to go to.")
        return nil
    end
    local t: Test = { kind = kind, via = via, at = date("%H:%M:%S"),
        leader = show((call(UnitIsGroupLeader, "player"))), assistant = show((call(UnitIsGroupAssistant, "player"))),
        members = members, calls = {}, blocked = {}, uiErrors = {}, rosterUpdates = {}, started = GetTime() }
    for _, m in ipairs(members) do table.insert(t.calls, ("%s: group %d to %d"):format(m.name, m.from, m.to)) end
    listen()
    test = t
    -- all in this frame (the burst's point)
    for _, c in ipairs(calls) do
        local ok, err = pcall(c.fn, c.args[1], c.args[2])
        table.insert(t.calls, c.label .. ": " .. (ok and "ran" or ("error: " .. tostring(err):sub(1, 120))))
    end
    after(2, function() finish(t) end)
    if t.leader ~= "true" and t.assistant ~= "true" then
        print("Raid probe: you're neither leader nor assistant; tried anyway, to record what the game says.")
    end
    return t
end

-- The same test once more, from a button's click (a hardware event).
local function offerClick(kind: string)
    local b = again or CreateFrame("Button", nil, UIParent, "UIPanelButtonTemplate")
    again = b
    b:SetSize(320, 30)
    b:ClearAllPoints()
    b:SetPoint("CENTER", UIParent, "CENTER", 0, 160)
    b:SetFrameStrata("DIALOG")
    b:SetText(("Raid probe: click to %s again"):format(kind))
    b:SetScript("OnClick", function(self)
        if run(kind, "button click") then self:Hide() end
    end)
    b:Show()
end

--------------------------------------------------------------------------------
-- Inspecting a raid member
--------------------------------------------------------------------------------

-- Constants.TraitConsts.INSPECT_TRAIT_CONFIG_ID: the inspected player's
-- talents, as SuuUI's Talents window reads them (after INSPECT_READY).
local INSPECT_CONFIG = secret.asNumber(tbl.field(_G, "Constants", "TraitConsts", "INSPECT_TRAIT_CONFIG_ID")) or -1
local inspecting: Inspect? = nil

-- What the inspect gives for talents and spec, read as the Talents window does.
local function talentsOf(unit: string): Record
    local s: Record = { hasValidData = show((call(tbl.field(C_Traits, "HasValidInspectData")))),
        spec = show((call(GetInspectSpecialization, unit))), itemLevel = show((call(tbl.field(C_PaperDollInfo, "GetInspectItemLevel"), unit))),
        tabs = show((call(tbl.field(_G, "GetNumTalentTabs"), true))) }
    -- the old talent tabs, for the inspected player
    local talentTabs: string[] = {}
    s.talentTabs = talentTabs
    for i = 1, 3 do talentTabs[i] = (every(GetTalentTabInfo, i, true)) end
    -- the trait tree: its groups' points and how many nodes have ranks
    local info = call(tbl.field(C_Traits, "GetConfigInfo"), INSPECT_CONFIG)
    local treeID = tbl.list(tbl.field(info, "treeIDs"))[1]
    s.configType = type(info) == "table" and show(tbl.field(info, "type")) or show(info)
    s.treeID = show(treeID)
    if type(treeID) == "number" then
        local displays = call(tbl.field(C_Traits, "GetGroupDisplayInfoByTreeID"), treeID)
        local ids: number[], names: { [number]: string } = {}, {}
        for _, d in ipairs(tbl.list(displays)) do
            local id = secret.asNumber(tbl.field(d, "groupID"))
            if id then ids[#ids + 1] = id; names[id] = show(tbl.field(d, "displayName")) end
        end
        local groups = #ids > 0 and call(tbl.field(C_Traits, "GetGroupCurrencyInfo"), INSPECT_CONFIG, ids)
        if type(groups) == "table" then
            local lines: string[] = {}
            s.groups = lines
            for _, g in ipairs(tbl.list(groups)) do
                local c = tbl.list(tbl.field(g, "currencyInfos"))[1]
                local groupID = tbl.field(g, "traitNodeGroupID")
                lines[#lines + 1] = ("%s: spent %s"):format(names[secret.asNumber(groupID) or -1] or show(groupID), c ~= nil and show(tbl.field(c, "spent")) or "?")
            end
        else
            s.groups = show(groups)
        end
        local nodes = call(tbl.field(C_Traits, "GetTreeNodes"), treeID)
        local ranked, total, secrets = 0, 0, 0
        if type(nodes) == "table" then
            for _, nodeID in ipairs(tbl.list(nodes)) do
                local ni = call(tbl.field(C_Traits, "GetNodeInfo"), INSPECT_CONFIG, nodeID)
                if type(ni) == "table" then
                    total = total + 1
                    local r = tbl.field(ni, "activeRank") or tbl.field(ni, "currentRank")
                    if isSecret(r) then secrets = secrets + 1 elseif type(r) == "number" and r > 0 then ranked = ranked + 1 end
                end
            end
        end
        s.nodes = ("%d nodes, %d with ranks, %d secret"):format(total, ranked, secrets)
    end
    return s
end

inspectReady = function(guid: unknown)
    local t = inspecting
    if not t then return end
    local okG, target = pcall(UnitGUID, t.unit)
    if not (okG and secret.readable(target) and secret.readable(guid) and target == guid) then
        t.otherReady = (t.otherReady or 0) + 1
        return
    end
    inspecting = nil
    local ready = ("%.2f s"):format(GetTime() - t.started)
    t.ready = ready
    t.talents = talentsOf(t.unit)
    -- the game's inspect window keeps its player; this one is let go
    local inspectFrame = wf.find("InspectFrame")
    if not (inspectFrame and inspectFrame:IsShown()) then call(ClearInspectPlayer) end
    print(("Raid probe: INSPECT_READY after %s; what it gave is recorded. /reload to save it."):format(ready))
end

local function inspect()
    local unit = "target"
    if not UnitExists(unit) or not UnitIsPlayer(unit) then
        print("Raid probe: target a player first (a raid member; one near you, then one far away).")
        return
    end
    local o = out()
    local inspects = o.inspects or {}
    o.inspects = inspects
    local okN, name = pcall(GetUnitName, unit, true)
    local t: Inspect = { at = date("%H:%M:%S"), unit = unit, name = okN and show(name) or "?",
        inRaid = show((call(UnitInRaid, unit))), canInspect = show((call(CanInspect, unit))),
        visible = show((call(UnitIsVisible, unit))), connected = show((call(UnitIsConnected, unit))),
        inRange = (every(UnitInRange, unit)), interact = show((call(CheckInteractDistance, unit, 1))),
        inCombat = InCombatLockdown() and true or false, started = GetTime() }
    listen()
    inspecting = t
    local ok, err = pcall(NotifyInspect, unit)
    t.notify = ok and "called" or ("error: " .. tostring(err):sub(1, 120))
    inspects[#inspects + 1] = t
    after(10, function()
        if inspecting == t then
            inspecting = nil
            t.ready = "no INSPECT_READY in 10 s"
            t.talents = talentsOf(unit)
            print("Raid probe: no INSPECT_READY for your target in 10 s; recorded. /reload to save it.")
        end
    end)
    print(("Raid probe: inspecting %s (in range: %s); waiting for INSPECT_READY."):format(t.name, t.inRange))
end

export function command(arg: string?)
    if arg == "inspect" then return inspect() end
    if arg == "move" or arg == "swap" or arg == "burst" then
        snapshot()
        local t = run(arg, "chat command (no button click)")
        if not t then return end
        if arg == "burst" then
            print(("Raid probe: %d moves sent in one frame; the answer in 2 s."):format(#t.members))
        else
            offerClick(arg)
            print(("Raid probe: %s sent from this chat command; the answer in 2 s. Then click the button above the middle to %s again from a click; then /reload."):format(arg, arg))
        end
        return
    end
    local s = snapshot()
    print(("Raid probe: %s members recorded (leader %s, assistant %s). In a raid you lead, try /suu probe raid move, swap and burst, and /suu probe raid inspect on a member; then /reload to save it."):format(
        s.members, s.leader, s.assistant))
end
