-- Diagnostics/ToyModelProbe.wowlua
-- "/suu probe toymodels": which of Forever's toys have a 3D model the
-- collections stage could show instead of their icon (asked 2026-10-17:
-- toys only showed an icon). Each toy goes into a model frame the stage's
-- size by its item (SetItem), one after another, Next and Previous to look
-- at them; for each it records whether a model loaded and its file.
-- Saved in SuuUIProbe.toyModels on /reload.

import print from "/Core/Init"
import * as DB from "/Core/DB"
import SuuUI from "/Core/API"
import panel, Panel from "/UI/Panel"
import text as uiText, Text from "/UI/Text"
import type SuuButton from "/UI/Controls"
import button from "/UI/Controls"
import after, every from "wowlua:timer"

-- the probe's window, made once
type ToyWindow = Panel & { model?: PlayerModel, label?: Text, prev?: SuuButton, next?: SuuButton }
local window: ToyWindow? = nil

export function command()
    local list: number[] = {}
    for _, itemID in ipairs(SuuUI.CollectionSources().toys) do
        list[#list + 1] = itemID
    end
    local toys: { [number]: string } = {}
    local out: { [string]: unknown } = { at = date("%Y-%m-%d %H:%M:%S"), toys = toys }
    DB.probe.toyModels = out
    local p = window or panel(UIParent, { title = "Toy models", width = 800, height = 600, solid = true }) :: ToyWindow
    window = p
    p:SetFrameStrata("DIALOG")
    p:SetPoint("CENTER")
    local m = p.model or CreateFrame("PlayerModel", nil, p.body)
    p.model = m
    m:SetSize(760, 470)
    m:SetPoint("TOP")
    local label = p.label or uiText(p.body, "label", "ink")
    p.label = label
    label:SetPoint("BOTTOM", 0, 44)
    local i = 0
    local function show(step: number)
        i = (i + step - 1) % #list + 1
        local itemID = list[i]
        local name = C_Item.GetItemNameByID(itemID) or ("item " .. itemID)
        local loaded = false
        m:SetScript("OnModelLoaded", function()
            loaded = true
        end)
        pcall(m.ClearModel, m)
        local ok, err = pcall(m.SetItem, m, itemID)
        after(1, function()
            local file = m:GetModelFileID()
            local text = ("%d/%d %s (%d): SetItem %s, loaded %s, model file %s"):format(
                i,
                #list,
                name,
                itemID,
                ok and "ok" or ("error " .. tostring(err)),
                tostring(loaded),
                tostring(file)
            )
            label:SetValue(text)
            toys[itemID] = text
        end)
    end
    if not p.next then
        local prev = button(p.body, {
            text = "Previous",
            width = 110,
            onClick = function()
                show(-1)
            end,
        })
        p.prev = prev
        prev:SetPoint("BOTTOMLEFT")
        local nextButton = button(p.body, {
            text = "Next",
            width = 110,
            onClick = function()
                show(1)
            end,
        })
        p.next = nextButton
        nextButton:SetPoint("BOTTOMRIGHT")
    end
    p:Show()
    show(1)
    -- every toy once on its own, for the record
    local n = 0
    local ticker: TickerHandle
    ticker = every(1.3, function()
        n = n + 1
        if n >= #list then
            ticker:Cancel()
            print("Toy models: all " .. #list .. " recorded; /reload to save.")
            return
        end
        show(1)
    end)
    print(
        "Toy models: showing all " .. #list .. " toys in turn (about 25 s); screenshots of any that look good or wrong."
    )
end
