-- Diagnostics/MicroProbe.wowlua
-- "/suu probe micro": what SuuUI's own micro menu and minimap (step 2.1) take
-- over. The micro menu's buttons in Blizzard's order (name, shown, tooltip,
-- art, whether it's flashing or has an alert), MICRO_BUTTONS, and the
-- minimap cluster's and the minimap's children by name; a few APIs the
-- minimap uses. Saved in SuuUIProbe.micro on /reload.

import * as DB from "/Core/DB"
import print from "/Core/Init"
import isSecret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import field from "wowlua:table"

local function str(v: unknown): string?
    if isSecret(v) then
        return "secret"
    end
    if v == nil then
        return nil
    end
    return tostring(v):sub(1, 120)
end

local function children(frame: unknown): string[]
    local out: string[] = {}
    local f = frames.asFrame(frame)
    if not f then
        return out
    end
    for i, c in ipairs(frames.children(f)) do
        local ok, name = pcall(c.GetName, c)
        local okT, ot = pcall(c.GetObjectType, c)
        local okS, shown = pcall(c.IsShown, c)
        out[i] = ("%s (%s%s)"):format(
            ok and tostring(name) or "?",
            okT and ot or "?",
            okS and (shown and ", shown" or ", hidden") or ""
        )
    end
    return out
end

local function texInfo(tex: unknown): string?
    local t = frames.asTexture(tex)
    if not t then
        return nil
    end
    local okA, atlas = pcall(t.GetAtlas, t)
    if okA and atlas then
        return "atlas " .. tostring(atlas)
    end
    local okT, file = pcall(t.GetTexture, t)
    return okT and ("file " .. tostring(file)) or nil
end

-- a method's result, protected (nil when it is missing or errors)
local function ask(obj: unknown, method: string, ...: unknown): unknown
    local fn = field(obj, method)
    if type(fn) ~= "function" then
        return nil
    end
    local ok, v = pcall(fn, obj, ...)
    return ok and v or nil
end

export function command()
    local buttons: { [string]: unknown }[] = {}
    local out: { [string]: unknown } = { at = date("%H:%M:%S"), buttons = buttons }
    -- the micro menu, in its layout order
    local menu = frames.find("MicroMenu")
    out.microMenu = menu and "present" or "missing"
    local list: unknown[] = {}
    local layout = ask(menu, "GetLayoutChildren")
    if type(layout) == "table" then
        list = tbl.list(layout)
    end
    if #list == 0 and menu then
        for _, c in ipairs(frames.children(menu)) do
            list[#list + 1] = c
        end
    end
    for i, b in ipairs(list) do
        local e: { [string]: unknown } = { name = str(ask(b, "GetName")) or "?" }
        e.shown = ask(b, "IsShown") or false
        e.tooltip = str(field(b, "tooltipText"))
        e.newbie = str(field(b, "newbieText"))
        e.normal = texInfo(ask(b, "GetNormalTexture"))
        e.flash = ask(field(b, "Flash"), "IsShown")
        e.flashing = ask(field(b, "FlashBorder"), "IsShown")
        e.onClick = field(b, "GetScript") and (ask(b, "GetScript", "OnClick") and "script" or "none") or nil
        e.protected = ask(b, "IsProtected")
        buttons[i] = e
    end
    local microButtons = field(_G, "MICRO_BUTTONS")
    out.MICRO_BUTTONS = type(microButtons) == "table" and microButtons or "missing"
    -- the minimap's surroundings
    local cluster = children(field(_G, "MinimapCluster"))
    out.minimapCluster = cluster
    out.minimap = children(Minimap)
    local minimapParent = Minimap and Minimap:GetParent()
    out.minimapParent = minimapParent and minimapParent:GetName() or "?"
    out.minimapSize = Minimap and ("%.0fx%.0f"):format(Minimap:GetSize()) or "?"
    local apis: { [string]: string } = {}
    out.apis = apis
    for _, n in ipairs({
        "GetMinimapZoneText",
        "GetZonePVPInfo",
        "HasNewMail",
        "GetGameTime",
        "ToggleWorldMap",
        "ToggleAllBags",
        "ToggleCharacter",
        "ToggleFriendsFrame",
        "ToggleQuestLog",
        "PlayerSpellsUtil",
        "C_Minimap",
        "MiniMapTracking",
        "MinimapZoomIn",
        "TimeManagerClockButton",
        "GameTimeFrame",
        "MiniMapMailFrame",
        "QueueStatusButton",
        "C_ClassTalents",
        "UnitCharacterPoints",
    }) do
        local v = field(_G, n)
        apis[n] = v ~= nil and type(v) or "missing"
    end
    if C_Minimap then
        local fns: string[] = {}
        for k in pairs(C_Minimap) do
            if type(k) == "string" then
                fns[#fns + 1] = k
            end
        end
        table.sort(fns)
        out.C_Minimap = fns
    end
    if C_ClassTalents and C_ClassTalents.HasUnspentTalentPoints then
        local ok, v = pcall(C_ClassTalents.HasUnspentTalentPoints)
        out.unspentTalents = ok and str(v) or "error"
    end
    if UnitCharacterPoints then
        out.characterPoints = str(UnitCharacterPoints("player"))
    end
    DB.probe.micro = out
    print(("Micro probe: %d micro buttons, %d minimap cluster children. /reload to save."):format(#buttons, #cluster))
end
