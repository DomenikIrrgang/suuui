-- Diagnostics/MapProbe.wowlua
-- "/suu probe map": what Forever's world map is made of and what an addon
-- can read for SuuUI's world map (step 3.5). Saved in SuuUIProbe.map on
-- /reload. Open the map once first (M), ideally in a zone with quests in
-- your log, and in a group if you can.
--   * WorldMapFrame: its parts, size, whether it's protected, its quest
--     panel, the pin kinds the game draws (its pin pools) and its data
--     providers
--   * where you are: the map, its parents and children, your position
--     (secret or not), group members' positions
--   * quests: the log's entries (fields), quests on this map with their
--     positions (C_QuestLog.GetQuestsOnMap), quest lines to pick up
--     (C_QuestLine), the next waypoint
--   * places: flight masters (C_TaxiMap), dungeon entrances
--     (C_EncounterJournal), user waypoints (C_Map), map areas
--   * the map's own filters (its tracking menu's CVars)

import isSecret, asNumber from "wowlua:secret"
import * as reflect from "wowlua:reflect"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import * as DB from "/Core/DB"
import print from "/Core/Init"
import SuuUI from "/Core/API"
import WorldMapModule from "/Units/WorldMap"

-- the zones test's triangles, by key ("tri1", "tri2")
local triangles: { [string]: Texture } = {}

-- A value as text: secrets marked, tables two levels deep.
local function show(v: unknown, depth: number?): string
    depth = depth or 0
    if isSecret(v) then return "<secret>" end
    if type(v) ~= "table" then return tostring(v) end
    if depth > 1 then return "{…}" end
    local parts: string[] = {}
    for k, x in pairs(v) do
        parts[#parts + 1] = tostring(k) .. "=" .. (isSecret(x) and "<secret>" or (type(x) == "table" and show(x, depth + 1) or tostring(x)))
    end
    table.sort(parts)
    return "{" .. table.concat(parts, ", ") .. "}"
end

-- `t[name](...)`: its results, "missing" or "error: …".
local function call(t: unknown, name: string, ...: unknown): (unknown, unknown, unknown)
    local fn = tbl.field(t, name)
    if type(fn) ~= "function" then return "missing", nil, nil end
    local ok, a, b, c = pcall(fn, ...)
    if not ok then return "error: " .. tostring(a), nil, nil end
    return a, b, c
end

-- A list the game gave: how many and the first; anything else as text.
local function counted(v: unknown): unknown
    if type(v) ~= "table" then return show(v) end
    local list = tbl.list(v)
    return { count = #list, first = list[1] ~= nil and show(list[1]) or "none" }
end

-- A position the game gave as a vector: its x and y.
local function xy(pos: unknown): string
    if type(pos) ~= "table" then return show(pos) end
    return show({ call(pos, "GetXY", pos) })
end

-- A frame's parts that have a key on it (`frame.ScrollContainer`): its
-- child frames, textures and font strings.
local function keyedParts(frame: Frame): { [string]: Region }
    return frames.keyed(frame)
end

local function sorted(list: string[]): string[]
    table.sort(list)
    return list
end

export function snapshot()
    local s: { [string]: unknown } = { at = date("%Y-%m-%d %H:%M:%S") }
    DB.probe.map = s

    -- the window
    local f = WorldMapFrame
    local w: { [string]: unknown } = { exists = f ~= nil }
    s.frame = w
    local pinPools: string[] = {}
    if f then
        w.protected = f:IsProtected() and true or false
        w.shown = f:IsShown()
        w.size = math.floor(f:GetWidth()) .. "x" .. math.floor(f:GetHeight())
        local keys: string[] = {}
        for key, part in pairs(keyedParts(f)) do keys[#keys + 1] = key .. " (" .. part:GetObjectType() .. ")" end
        w.keys = sorted(keys)
        local pools = tbl.field(f, "pinPools")
        if type(pools) == "table" then
            for template in pairs(pools) do pinPools[#pinPools + 1] = tostring(template) end
        end
        w.pinPools = sorted(pinPools)
        local providers = tbl.field(f, "dataProviders")
        w.providers = type(providers) == "table" and tbl.count(providers) or 0
        w.mapID = call(f, "GetMapID", f)
        w.quest = { QuestMapFrame = frames.find("QuestMapFrame") ~= nil, QuestLogFrame = frames.find("QuestLogFrame") ~= nil,
                    QuestScrollFrame = frames.find("QuestScrollFrame") ~= nil }
        local overlays: string[] = {}
        for _, v in ipairs(tbl.list(tbl.field(f, "overlayFrames"))) do
            local frame = frames.asFrame(v)
            if frame then overlays[#overlays + 1] = frame:GetName() or frame:GetObjectType() end
        end
        w.overlays = overlays
    end

    -- where you are
    local cm = C_Map
    local map = call(cm, "GetBestMapForUnit", "player")
    s.mapID = show(map)
    if type(map) == "number" and not isSecret(map) then
        s.mapInfo = show((call(cm, "GetMapInfo", map)))
        s.position = xy((call(cm, "GetPlayerMapPosition", map, "player")))
        local kids = call(cm, "GetMapChildrenInfo", map)
        s.children = type(kids) == "table" and #tbl.list(kids) or show(kids)
        s.mapGroup = show((call(cm, "GetMapGroupID", map)))
        local party: string[] = {}
        s.party = party
        for i = 1, 4 do
            if UnitExists("party" .. i) then
                party[#party + 1] = "party" .. i .. " " .. xy((call(cm, "GetPlayerMapPosition", map, "party" .. i)))
            end
        end
        -- quests on this map
        s.questsOnMap = counted((call(C_QuestLog, "GetQuestsOnMap", map)))
        s.questLines = counted((call(C_QuestLine, "GetAvailableQuestLines", map)))
        s.questLineFn = call(C_QuestLine, "GetQuestLineQuests") ~= "missing"
        -- places
        s.taxi = counted((call(C_TaxiMap, "GetTaxiNodesForMap", map)))
        s.dungeons = counted((call(C_EncounterJournal, "GetDungeonEntrancesForMap", map)))
        s.userWaypoint = { can = show((call(cm, "CanSetUserWaypointOnMap", map))), has = show((call(cm, "HasUserWaypoint"))) }
        s.exploration = show((call(C_MapExplorationInfo, "GetExploredAreaIDsAtPosition", map, CreateVector2D(0.5, 0.5))))
    end

    -- the quest log
    local ql = C_QuestLog
    local n = call(ql, "GetNumQuestLogEntries")
    local sample: { [string]: string }[] = {}
    s.questLog = { entries = show(n), sample = sample }
    if type(n) == "number" and not isSecret(n) then
        for i = 1, math.min(n, 12) do
            local info = call(ql, "GetInfo", i)
            if type(info) == "table" and not tbl.field(info, "isHeader") then
                local id = tbl.field(info, "questID")
                sample[#sample + 1] = {
                    info = show(info),
                    difficultyLevel = show(tbl.field(info, "difficultyLevel")),
                    objectives = show((call(ql, "GetQuestObjectives", id))),
                    complete = show((call(ql, "IsComplete", id))),
                    waypoint = show({ call(ql, "GetNextWaypoint", id) }),
                    uiMap = show((call(_G, "GetQuestUiMapID", id))),
                }
                if #sample >= 4 then break end
            end
        end
    end

    -- the map's filters (its tracking menu)
    local cvars: { [string]: string } = {}
    s.cvars = cvars
    for _, cv in ipairs({ "questPOI", "showQuestObjectivesOnMap", "trivialQuests", "showDungeonEntrancesOnMap",
                          "questHelper", "mapFade", "showTamers", "primaryProfessionsFilter", "worldQuestFilterResources" }) do
        local ok, v = pcall(GetCVar, cv)
        cvars[cv] = ok and show(v) or "error"
    end
    print(("Map probe: %s pin kinds, %s quests on this map, %s flight masters; /reload."):format(
        tostring(#pinPools), show(tbl.field(s.questsOnMap, "count") or s.questsOnMap),
        show(tbl.field(s.taxi, "count") or s.taxi)))
end

-- An area pin of the game's: what it shows and for which quest.
type AreaPin = { shown: boolean, visible: boolean, alpha: number, level: number, size: string, questID: string,
                 focused: string, highlighted: string, mapAllowsBlobs: string, map: string }

-- "/suu probe map areas": why the game draws no quest objective area (it
-- draws the followed quest's and the one hovered in the log).
export function areas()
    local s: { [string]: unknown } = { at = date("%Y-%m-%d %H:%M:%S") }
    DB.probe.mapAreas = s
    local f = WorldMapFrame
    s.mapID = f and show((call(f, "GetMapID", f)))
    local questPOI = show((call(_G, "GetCVar", "questPOI")))
    local superTracked = show((call(C_SuperTrack, "GetSuperTrackedQuestID")))
    s.questPOI, s.superTracked = questPOI, superTracked
    s.superTrackingWaypoint = show((call(C_SuperTrack, "IsSuperTrackingUserWaypoint")))
    s.highestType = show((call(C_SuperTrack, "GetHighestPrioritySuperTrackingType")))
    local pins: AreaPin[] = {}
    s.pins = pins
    if f then
        for _, pin in ipairs(frames.mapPins(f, "QuestBlobPinTemplate")) do
            pins[#pins + 1] = {
                shown = pin:IsShown(), visible = pin:IsVisible(), alpha = pin:GetAlpha(), level = pin:GetFrameLevel(),
                size = math.floor(pin:GetWidth()) .. "x" .. math.floor(pin:GetHeight()),
                questID = show(tbl.field(pin, "questID")), focused = show(tbl.field(pin, "focusedQuestID")),
                highlighted = show(tbl.field(pin, "highlightedQuestID")),
                mapAllowsBlobs = show(tbl.field(pin, "mapAllowsBlobs")), map = show((call(pin, "GetMapID", pin))),
            }
        end
    end
    -- the quests on this map: do they have an area here?
    local map = f and asNumber(f:GetMapID())
    local on = map and call(C_QuestLog, "GetQuestsOnMap", map)
    local onMap: string[] = {}
    s.questsOnMap = onMap
    for _, q in ipairs(tbl.list(on)) do
        onMap[#onMap + 1] = show(q)
        if #onMap >= 8 then break end
    end
    local worldMap = SuuUI.GetModule("worldmap")
    local layer = worldMap and reflect.isInstance(worldMap, WorldMapModule) and worldMap.layer
    s.ourLayer = layer and layer:GetFrameLevel() or "none"
    local first = pins[1]
    print(("Areas: questPOI %s, followed quest %s, %d area pins (%s); /reload saves it."):format(
        questPOI, superTracked, #pins, first and ((first.visible and "visible" or "hidden") .. ", allowed " .. first.mapAllowsBlobs) or "none"))
end

-- Where one of the log's parts sits: its left and right from the panel's
-- left (the map's right edge), its width, whether it shows, its anchors.
type Where = { shown: boolean, kind: string, left?: number, right?: number, width?: number, points: string }

-- "/suu probe map log": where the quest log's parts sit, to line them up
-- (the list centred, the search box with it).
local function where(obj: unknown, x0: number): Where?
    local r = frames.asRegion(obj)
    if not r then return nil end
    local out: Where = { shown = r:IsShown(), kind = r:GetObjectType(), points = "" }
    local l, rt = r:GetLeft(), r:GetRight()
    if l and rt then
        out.left, out.right, out.width = math.floor(l - x0 + 0.5), math.floor(rt - x0 + 0.5), math.floor(rt - l + 0.5)
    end
    local points: string[] = {}
    for i = 1, r:GetNumPoints() do
        local pt, rel, relPt, x, y = r:GetPoint(i)
        local name = rel and rel:GetName() or nil
        local parent = rel and rel:GetParent()
        if not name and parent then
            for k, part in pairs(frames.keyed(parent)) do if part == rel then name = "$parent." .. k end end
        end
        points[#points + 1] = ("%s>%s %s %s,%s"):format(tostring(pt), tostring(relPt), tostring(name or rel), tostring(x and math.floor(x + 0.5)), tostring(y and math.floor(y + 0.5)))
    end
    out.points = table.concat(points, "; ")
    return out
end

export function log()
    local f, q = WorldMapFrame, frames.find("QuestMapFrame")
    local s: { [string]: unknown } = { at = date("%Y-%m-%d %H:%M:%S") }
    DB.probe.mapLog = s
    local scroll = frames.asFrame(tbl.field(f, "ScrollContainer"))
    local x0 = scroll and scroll:GetRight() or 0
    local window = where(f, x0)
    s.window = window
    s.mapArea = where(scroll, x0)
    local windows = SuuUI.GetModule("windows")
    s.enlarged = windows and windows:Get("mapEnlarged")
    if not q then print("Map log: no quest log.") return end
    s.questMapFrame = where(q, x0)
    -- each part one level down, by its key, in the log, its quests frame and its list
    local function walk(label: string, t: unknown)
        local frame = frames.asFrame(t)
        if not frame then return end
        local parts: { [string]: Where? } = {}
        s[label] = parts
        for key, part in pairs(keyedParts(frame)) do parts[key] = where(part, x0) end
    end
    walk("log", q)
    walk("quests", tbl.field(q, "QuestsFrame"))
    walk("list", tbl.field(q, "QuestsFrame", "ScrollFrame") or frames.find("QuestScrollFrame"))
    local list = frames.find("QuestScrollFrame")
    walk("contents", tbl.field(list, "Contents"))
    -- the first rows of each kind
    local rows: { [string]: Where? } = {}
    s.rows = rows
    for _, key in ipairs({ "headerFramePool", "campaignHeaderMinimalFramePool", "titleFramePool", "objectiveFramePool" }) do
        local first = frames.rows(tbl.field(list, key))[1]
        if first then rows[key] = where(first, x0) end
    end
    local header = rows.headerFramePool
    local sb = where(tbl.field(list, "SearchBox"), x0)
    print(("Map log: panel %s px wide; list %s..%s; search box %s..%s; /reload saves it."):format(
        tostring(window and window.right), tostring(header and header.left), tostring(header and header.right),
        tostring(sb and sb.left), tostring(sb and sb.right)))
end

-- What the zones probe notes for a quest in your log.
type QuestMarkers = { title: string, hasLocalPOI: string, isOnMap: string, onThisMap: string, logMarker: string,
                      poiIcon: string, waypoint: string, waypointHere: string, complete: string }

-- "/suu probe map zones": for SuuUI's objective zones where the game shows
-- no marker. Open the map on a zone with your quests first.
--   * each quest in your log: what the game reports about its markers (the
--     log's fields, the quests on this map, its marker in the log, its POI
--     icon, its next waypoint)
--   * can a texture be drawn as a triangle (SetVertexOffset)? Draws a
--     test: a blue triangle and a skewed one in the map's middle, until
--     /reload. A screenshot of the map shows how they came out.
export function zones()
    local s: { [string]: unknown } = { at = date("%Y-%m-%d %H:%M:%S") }
    DB.probe.mapZones = s
    local f = WorldMapFrame
    local map = asNumber(f:GetMapID())
    s.mapID = show(map)
    local onMap: { [unknown]: unknown } = {}
    for _, q in ipairs(tbl.list(map and call(C_QuestLog, "GetQuestsOnMap", map))) do
        local id = tbl.field(q, "questID")
        if id ~= nil then onMap[id] = q end
    end
    local logPins: { [unknown]: boolean } = {}
    for _, pin in ipairs(frames.rows(tbl.field(frames.find("QuestScrollFrame"), "Contents", "buttonPool"))) do
        local id = tbl.field(pin, "questID")
        if id ~= nil then logPins[id] = true end
    end
    local quests: { [unknown]: QuestMarkers } = {}
    s.quests = quests
    local n = call(C_QuestLog, "GetNumQuestLogEntries")
    for i = 1, type(n) == "number" and n or 0 do
        local info = call(C_QuestLog, "GetInfo", i)
        local id = tbl.field(info, "questID")
        if type(info) == "table" and not tbl.field(info, "isHeader") and id ~= nil then
            quests[id] = {
                title = show(tbl.field(info, "title")), hasLocalPOI = show(tbl.field(info, "hasLocalPOI")),
                isOnMap = show(tbl.field(info, "isOnMap")),
                onThisMap = onMap[id] ~= nil and show(onMap[id]) or "no", logMarker = logPins[id] and "yes" or "no",
                poiIcon = show({ call(_G, "QuestPOIGetIconInfo", id) }),
                waypoint = show({ call(C_QuestLog, "GetNextWaypoint", id) }),
                waypointHere = show({ call(C_QuestLog, "GetNextWaypointForMap", id, map) }),
                complete = show((call(C_QuestLog, "IsComplete", id))),
            }
        end
    end
    -- the triangle test, on the map's canvas
    local canvas = frames.asFrame(tbl.field(f, "ScrollContainer", "Child"))
    local hasVertexOffset = canvas ~= nil and type(tbl.field(UIParent:CreateTexture(), "SetVertexOffset")) == "function"
    s.hasVertexOffset = hasVertexOffset
    local triangle: string? = nil
    if canvas and hasVertexOffset then
        local w, h = canvas:GetWidth(), canvas:GetHeight()
        local function tri(key: string, x: number, y: number, size: number, skew: boolean, r: number, g: number, b: number): string
            local t = triangles[key] or canvas:CreateTexture(nil, "OVERLAY", nil, 7)
            triangles[key] = t
            t:SetColorTexture(r, g, b, 0.55)
            t:ClearAllPoints()
            t:SetPoint("TOPLEFT", canvas, "TOPLEFT", w * x, -h * y)
            t:SetSize(w * size, w * size)
            -- the lower right corner onto the upper right one: a triangle;
            -- skewed, the upper right moved left too
            local ok1, e1 = pcall(t.SetVertexOffset, t, 4, 0, w * size)
            local ok2: boolean, e2: unknown = true, nil
            if skew then ok2, e2 = pcall(t.SetVertexOffset, t, 3, -w * size * 0.5, 0) end
            t:Show()
            return ok1 and ok2 and "ok" or ("error: " .. tostring(e1 or e2))
        end
        triangle = tri("tri1", 0.40, 0.40, 0.08, false, 0.25, 0.8, 1)
        s.triangle = triangle
        s.skewed = tri("tri2", 0.52, 0.40, 0.08, true, 0.9, 0.8, 0.5)
    end
    local none, total = 0, 0
    for _, q in pairs(quests) do
        total = total + 1
        if q.logMarker == "no" then none = none + 1 end
    end
    print(("Map zones: %d quests in your log, %d without a marker in the log; triangles %s; take a screenshot of the map, then /reload."):format(
        total, none, triangle or "not possible"))
end

export function command(rest: string?)
    local f = WorldMapFrame
    if rest == "log" then
        if not (f and f:IsShown()) then print("Map probe: open the map with its quest log, then run it again.") return end
        log()
        return
    end
    if rest == "zones" then
        if not (f and f:IsShown()) then print("Map probe: open the map with its quest log, then run it again.") return end
        zones()
        return
    end
    if rest == "areas" then
        if not f then print("Map probe: open the map once (M), then run it again.") return end
        areas()
        return
    end
    if not f then
        print("Map probe: open the map once (M), then run it again.")
        return
    end
    snapshot()
end
