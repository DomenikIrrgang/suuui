-- Diagnostics/SpellData.wowlua
-- "/suu probe spells": verified spell and aura IDs from this client, for the
-- Cooldown Manager presets (plan step 1.7c).
--
-- Collects, per character, into SuuUIProbe.spells["Name-Realm"]:
--   spellbook   every spell in your (and your pet's) spellbook: name, rank,
--               spell ID, tab (Balance, Feral Combat, ...), passive, not yet
--               learned, base cooldown; a pet's spells with the pet's family
--               (Imp, Voidwalker, Wolf, ...). While recording, every pet you
--               summon or tame is read too, so they add up
--   casts       every spell you cast, with the exact rank ID
--   auras       every aura seen on you, your target and your pet: name, ID,
--               buff or debuff, whether it was yours, its duration
-- Auras can't be read in any combat, so they are read out of combat and in
-- the seconds right after a fight (procs such as Clearcasting often outlast
-- it). Recording keeps running across reloads until "/suu probe spells off".
--
-- The scan needs no max-level character: the client answers C_Spell queries
-- for any spell ID, learned or not, so walking the IDs finds every rank of
-- every spell, and the proc auras, with this client's own IDs. It runs in
-- small chunks (out of combat) into SuuUIProbe.spellScan.
--
--   /suu probe spells        dump the spellbook now and start recording
--   /suu probe spells scan   walk every spell ID the client knows
--   /suu probe spells scan forever   save every spell in Forever's own range
--                            (1.2 to 1.33 million) with its name and rank, to
--                            find Forever's new class spells
--   /suu probe spells scan high   count (not save) spells from 1.4 to 3 million,
--                            to check nothing lies beyond the main scan
--   /suu probe spells off    stop recording
--   /suu probe spells find <name>[; <name>…]   every spell ID with exactly that
--                            name (any range), several names in one pass,
--                            saved in SuuUIProbe.spellFind[name]
--   /suu probe spells clear  drop all spell data from the save file (it is
--                            copied into tools/data once Claude has read it)

import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as events from "/Core/Events"
import after, every from "wowlua:timer"
import onLogin from "wowlua:lifecycle"
import isSecret from "wowlua:secret"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"

-- the owner of the recording's event handlers
const OWNER = "SpellData"
local AFTER_COMBAT = 15 -- seconds of sweeps after a fight

local recording = false

-- A spellbook entry, a cast spell and an aura seen, as the probe keeps them.
type SpellEntry = { name?: string, rank?: unknown, tab?: string, owner: string, passive?: boolean, kind: unknown,
                    known?: boolean, cooldownMS?: number, family?: unknown }
type CastEntry = { name?: string, count: number, last?: string }
type AuraEntry = { name: string, seen: number, on: { [string]: boolean }, kind?: string, icon?: unknown, duration?: number,
                   mine?: boolean, source?: string, dispel?: string, last?: string }
-- One character's data (SuuUIProbe.spells["Name-Realm"]).
type CharData = { spellbook: { [number]: SpellEntry }, casts: { [number]: CastEntry }, auras: { [number]: AuraEntry },
                  class?: unknown, level?: number, spellbookAt?: string }

local function charKey(): string
    local name, realm = UnitFullName("player")
    return (secret.asString(name) or "?") .. "-" .. (secret.asString(realm) or GetRealmName() or "?")
end

local function store(): CharData
    local all = DB.probeData("spells", function(): { [string]: CharData } return {} end)
    local key = charKey()
    local d = all[key] or { spellbook = {}, casts = {}, auras = {} }
    local _, class = UnitClass("player")
    d.class, d.level = class, UnitLevel("player")
    all[key] = d
    return d
end


--------------------------------------------------------------------------------
-- Spellbook
--------------------------------------------------------------------------------

local ITEM_TYPE: { [unknown]: string } = {}
for name, value in pairs(Enum.SpellBookItemType) do ITEM_TYPE[value] = name end

local function baseCooldown(id: number): number?
    local ok, ms = pcall(GetSpellBaseCooldown, id)
    local n = ok and secret.asNumber(ms)
    return n and n > 0 and n or nil
end

local function dumpBank(d: CharData, bank: number, owner: string): number
    local count = 0
    local lines = C_SpellBook.GetNumSpellBookSkillLines()
    local function add(index: number, tab: string?)
        local ok, it = pcall(C_SpellBook.GetSpellBookItemInfo, index, bank)
        local id = ok and it and secret.asNumber(it.spellID)
        if not (it and id) then return end
        local subName = secret.asString(it.subName)
        d.spellbook[id] = {
            name = secret.asString(it.name) or C_Spell.GetSpellName(id),
            rank = subName ~= "" and subName or C_Spell.GetSpellSubtext(id) or nil,
            tab = tab,
            owner = owner,
            passive = it.isPassive or nil,
            kind = ITEM_TYPE[it.itemType] or it.itemType,
            known = IsPlayerSpell(id) or nil,
            cooldownMS = baseCooldown(id),
            family = owner == "pet" and UnitCreatureFamily("pet") or nil,
        }
        count = count + 1
    end
    if owner == "pet" then
        local n = secret.asNumber(C_SpellBook.HasPetSpells()) or 0
        for i = 1, n do add(i, "Pet") end
    else
        for line = 1, lines do
            local li = C_SpellBook.GetSpellBookSkillLineInfo(line)
            local offset, items = li and secret.asNumber(li.itemIndexOffset), li and secret.asNumber(li.numSpellBookItems)
            if li and offset and items then
                for i = offset + 1, offset + items do add(i, secret.asString(li.name)) end
            end
        end
    end
    return count
end

export function dumpSpellbook(): (number, number)
    if InCombatLockdown() then
        print("Spell data: the spellbook is read out of combat.")
        return 0, 0
    end
    local d = store()
    local mine = dumpBank(d, Enum.SpellBookSpellBank.Player, "player")
    local pet = dumpBank(d, Enum.SpellBookSpellBank.Pet, "pet")
    d.spellbookAt = date("%Y-%m-%d %H:%M")
    return mine, pet
end

--------------------------------------------------------------------------------
-- Casts and auras
--------------------------------------------------------------------------------

local function noteAura(d: CharData, unit: string, a: AuraData, filter: string)
    local id, name = secret.asNumber(a.spellId), secret.asString(a.name)
    if not (id and name) then return end
    local e = d.auras[id] or { name = name, seen = 0, on = {} }
    e.seen = e.seen + 1
    e.on[unit] = true
    e.kind = filter
    e.icon = secret.readable(a.icon) and a.icon or e.icon
    local duration = secret.asNumber(a.duration)
    if duration and duration > 0 then e.duration = duration end
    if secret.flag(a.isFromPlayerOrPlayerPet) then e.mine = true end
    local source = secret.asString(a.sourceUnit)
    if source then e.source = source end
    local dispel = secret.asString(a.dispelName)
    if dispel then e.dispel = dispel end
    e.last = date("%Y-%m-%d %H:%M")
    d.auras[id] = e
end

local function sweep(unit: string)
    if not recording or not UnitExists(unit) then return end
    local d = store()
    for _, filter in ipairs({ "HELPFUL", "HARMFUL" }) do
        for i = 1, 40 do
            local ok, a = pcall(C_UnitAuras.GetAuraDataByIndex, unit, i, filter)
            if not ok or not a or isSecret(a) then break end
            noteAura(d, unit, a, filter)
        end
    end
end

local function sweepAll()
    if InCombatLockdown() then return end
    sweep("player"); sweep("target"); sweep("pet")
end

-- After a fight: sweep every second for a while, to catch procs and buffs
-- that outlast it.
local function afterCombat()
    for s = 0, AFTER_COMBAT do
        after(s, function() if recording then sweepAll() end end)
    end
end

local function noteCast(_: string, _: unknown, _: unknown, spellValue: unknown)
    local spellID = secret.asNumber(spellValue)
    if not recording or not spellID then return end
    local d = store()
    local e = d.casts[spellID] or { name = C_Spell.GetSpellName(spellID), count = 0 }
    e.count = e.count + 1
    e.last = date("%Y-%m-%d %H:%M")
    d.casts[spellID] = e
end

local function start()
    if recording then return end
    recording = true
    events.onUnit("UNIT_AURA", { "player", "target", "pet" }, function(_, unit)
        if not InCombatLockdown() then sweep(unit) end
    end, OWNER)
    events.onGame("PLAYER_TARGET_CHANGED", sweepAll, OWNER)
    events.onGame("PLAYER_REGEN_ENABLED", afterCombat, OWNER)
    events.onUnit("UNIT_SPELLCAST_SUCCEEDED", "player", noteCast, OWNER)
    -- each new pet: its spellbook (once it has loaded), out of combat
    events.onUnit("UNIT_PET", "player", function()
        after(1, function()
            if recording and UnitExists("pet") and not InCombatLockdown() then
                local _, pet = dumpSpellbook()
                print(("Spell data: %s's %d spells read."):format(secret.asString(UnitCreatureFamily("pet")) or secret.asString(UnitName("pet")) or "pet", pet))
            end
        end)
    end, OWNER)
    sweepAll()
end

local function stop()
    recording = false
    events.offAll(OWNER)
end

--------------------------------------------------------------------------------
-- The client's whole spell table
--------------------------------------------------------------------------------

-- Vanilla's IDs end near 30000, but Forever adds its own above a million
-- (Plainsrunning is 1259918). Below VANILLA everything is kept; above it only
-- ranked spells and names vanilla already has, plus a count and a few sample
-- names per 100k, so the client's other spells can't bloat the save.
local VANILLA = 120000
local SCAN_TO = 1400000
local BUDGET = 8 -- ms per frame
local SAMPLES = 25
local scanning = false
-- Spells above vanilla's range per 100k IDs: how many, how many kept, a few names.
type Bucket = { count: number, kept: number, samples: string[] }

export function scan()
    if scanning then return end
    if InCombatLockdown() then
        print("Spell data: the scan runs out of combat.")
        return
    end
    scanning = true
    local byName: { [string]: (number | string)[][] }, buckets: { [number]: Bucket } = {}, {}
    local total, kept, highest = 0, 0, 0
    local nextID = 1
    local subtext = C_Spell.GetSpellSubtext
    print("Spell data: scanning the client's spells (about a minute; it pauses in combat)…")
    local ticker: TickerHandle
    ticker = every(0, function()
        if InCombatLockdown() then return end
        local stopAt = debugprofilestop() + BUDGET
        while nextID <= SCAN_TO and debugprofilestop() < stopAt do
            local id = nextID
            nextID = id + 1
            local name = C_Spell.GetSpellName(id)
            if name and not isSecret(name) and name ~= "" then
                total = total + 1
                highest = id
                local rank = secret.asString(subtext(id))
                if rank == "" then rank = nil end
                local keep = id < VANILLA or rank ~= nil or byName[name] ~= nil
                if id >= VANILLA then
                    local b = math.floor(id / 100000) * 100000
                    local bucket = buckets[b] or { count = 0, kept = 0, samples = {} }
                    bucket.count = bucket.count + 1
                    if keep then bucket.kept = bucket.kept + 1
                    elseif #bucket.samples < SAMPLES then table.insert(bucket.samples, id .. " " .. name) end
                    buckets[b] = bucket
                end
                if keep then
                    local list = byName[name]
                    if not list then list = {}; byName[name] = list end
                    list[#list + 1] = rank and { id, rank } or { id }
                    kept = kept + 1
                end
            end
        end
        if nextID > SCAN_TO then
            ticker:Cancel()
            scanning = false
            DB.probe.spellScan = { at = date("%Y-%m-%d %H:%M"), scannedTo = SCAN_TO, highest = highest,
                count = total, kept = kept, buckets = buckets, byName = byName }
            print(("Spell data: %d spells found, %d kept (highest ID %d). /reload to save them."):format(total, kept, highest))
        end
    end)
end

--------------------------------------------------------------------------------
-- The command
--------------------------------------------------------------------------------

local function count(t: table): number
    return tbl.count(t)
end

-- Forever's own spells, unfiltered: everything from 1.2 to 1.33 million.
export function scanForever()
    if scanning then return end
    if InCombatLockdown() then
        print("Spell data: the scan runs out of combat.")
        return
    end
    scanning = true
    local from, to = 1200000, 1330000
    local nextID: number, rows: (number | string)[][] = from, {}
    local subtext = C_Spell.GetSpellSubtext
    print("Spell data: saving Forever's own spells…")
    local ticker: TickerHandle
    ticker = every(0, function()
        if InCombatLockdown() then return end
        local stopAt = debugprofilestop() + BUDGET
        while nextID <= to and debugprofilestop() < stopAt do
            local name = C_Spell.GetSpellName(nextID)
            if name and not isSecret(name) and name ~= "" then
                local rank = secret.asString(subtext(nextID))
                if rank == "" then rank = nil end
                rows[#rows + 1] = rank and { nextID, name, rank } or { nextID, name }
            end
            nextID = nextID + 1
        end
        if nextID > to then
            ticker:Cancel()
            scanning = false
            DB.probe.spellScanForever = { at = date("%Y-%m-%d %H:%M"), from = from, to = to, rows = rows }
            print(("Spell data: %d of Forever's own spells saved. /reload to save them."):format(#rows))
        end
    end)
end

-- Only counts: is there anything above the main scan's range?
export function scanHigh()
    if scanning then return end
    if InCombatLockdown() then
        print("Spell data: the scan runs out of combat.")
        return
    end
    scanning = true
    local from, to = SCAN_TO + 1, 3000000
    local nextID, total, first: number?, last: number?, samples: string[] = from, 0, nil, nil, {}
    print(("Spell data: counting spells from %d to %d…"):format(from, to))
    local ticker: TickerHandle
    ticker = every(0, function()
        if InCombatLockdown() then return end
        local stopAt = debugprofilestop() + BUDGET
        while nextID <= to and debugprofilestop() < stopAt do
            local name = C_Spell.GetSpellName(nextID)
            if name and not isSecret(name) and name ~= "" then
                total = total + 1
                first = first or nextID
                last = nextID
                if #samples < SAMPLES then samples[#samples + 1] = nextID .. " " .. name end
            end
            nextID = nextID + 1
        end
        if nextID > to then
            ticker:Cancel()
            scanning = false
            DB.probe.spellScanHigh = { at = date("%Y-%m-%d %H:%M"), from = from, to = to, count = total,
                first = first, last = last, samples = samples }
            print(total == 0 and ("Spell data: nothing above %d. The main scan covered everything."):format(SCAN_TO)
                or ("Spell data: %d more spells between %d and %d. /reload to save, and tell Claude."):format(total, first or 0, last or 0))
        end
    end)
end

-- Every ID with exactly this name, 1 to 1.4 million.
-- Several names in one pass: "find Heating Up; Fingers of Frost".
export function find(text: string?)
    if scanning then return end
    if not text or text == "" then print("Spell data: /suu probe spells find <spell name>[; <another>…]") return end
    if InCombatLockdown() then print("Spell data: the scan runs out of combat.") return end
    local names: string[], byLower: { [string]: { name: string, ids: number[] } } = {}, {}
    for part in text:gmatch("[^;]+") do
        local name = part:match("^%s*(.-)%s*$") or ""
        if name ~= "" then
            names[#names + 1] = name
            byLower[name:lower()] = { name = name, ids = {} }
        end
    end
    if #names == 0 then return end
    scanning = true
    local nextID = 1
    print(("Spell data: looking for %s…"):format(table.concat(names, ", ")))
    local ticker: TickerHandle
    ticker = every(0, function()
        if InCombatLockdown() then return end
        local stopAt = debugprofilestop() + BUDGET
        while nextID <= SCAN_TO and debugprofilestop() < stopAt do
            local n = C_Spell.GetSpellName(nextID)
            local hit: { name: string, ids: number[] }? = nil
            if n and not isSecret(n) then hit = byLower[n:lower()] end
            if hit then table.insert(hit.ids, nextID) end
            nextID = nextID + 1
        end
        if nextID > SCAN_TO then
            ticker:Cancel()
            scanning = false
            local saved = tbl.recordAt(DB.probe, "spellFind")
            for _, name in ipairs(names) do
                local found = assert(byLower[name:lower()]).ids
                saved[name] = found
                print(("Spell data: %q has %d IDs: %s."):format(name, #found, table.concat(found, ", ")))
            end
            print("Spell data: /reload to save.")
        end
    end)
end

export function command(arg: string?)
    local findName = arg and arg:match("^find%s+(.+)$")
    if findName then
        find(findName)
        return
    end
    if arg == "scan forever" then
        scanForever()
        return
    end
    if arg == "clear" then
        stop()
        local probe = DB.probe
        probe.spellScan, probe.spellScanHigh, probe.spells, probe.spellsRecording = nil, nil, nil, nil
        probe.spellScanForever = nil
        print("Spell data: cleared. /reload to shrink the save file.")
        return
    end
    if arg == "scan high" then
        scanHigh()
        return
    end
    if arg == "scan" then
        scan()
        return
    end
    if arg == "off" then
        stop()
        DB.probe.spellsRecording = nil
        print("Spell data: recording stopped. /reload to save.")
        return
    end
    local mine, pet = dumpSpellbook()
    DB.probe.spellsRecording = true
    start()
    local d = store()
    print(("Spell data: %d spells in your spellbook, %d pet spells. Recording casts and auras (%d casts, %d auras so far) until /suu probe spells off."):format(
        mine, pet, count(d.casts), count(d.auras)))
    print("Play normally: cast your spells and use your cooldowns, pick up procs. /reload now and then to save.")
end

-- Recording survives reloads.
@onLogin
local function resumeRecording()
    if DB.probe.spellsRecording then
        start()
        after(3, function() if not InCombatLockdown() then dumpSpellbook() end end)
    end
end
