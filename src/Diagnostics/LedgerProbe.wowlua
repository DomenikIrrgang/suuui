-- Diagnostics/LedgerProbe.wowlua
-- "/suu probe ledger" (asked 2026-11-18, for the Ledger: SuuUI's money
-- window with price history per ruleset, every copper in and out per
-- character, and gold over time): what Forever tells about money.
--   now:   the ruleset (which names and keys the client gives for it), what
--          a vendor pays for some items (and whether the first ask comes
--          back empty until GET_ITEM_INFO_RECEIVED / ITEM_DATA_LOAD_RESULT),
--          the clocks (local, server, calendar, game time and their
--          offsets), the global strings of auction and money messages, the
--          events and the client's API documentation of all of it
--   then (until /reload or "/suu probe ledger stop"): every PLAYER_MONEY
--          with its change, the windows open and the events and calls
--          around it (GetTime stamps, 3 s before and after: does the money
--          come before or after the event that explains it?), the
--          mailbox's letters with their invoices (GetInboxHeaderInfo,
--          GetInboxInvoiceInfo: a sale, a purchase, an expired or cancelled
--          auction, outbid), auction and money system lines, the trade
--          window's money as it changes (GetPlayerTradeMoney,
--          GetTargetTradeMoney: readable before the trade completes?), and
--          what SuuUI-free post-hooks see of repairs, purchases, buybacks,
--          sales at a vendor, flights, training, quest rewards, mail money,
--          sending mail and the auction house's posts, bids and buys
--
--   /suu probe ledger          snapshot and listen (again: a new snapshot,
--                              the lists go on)
--   /suu probe ledger stop     stop listening (hooks stay installed, doing
--                              nothing, until a /reload)
--   /suu probe ledger status   what it has so far
--   /suu probe ledger reset    forget everything recorded
--
-- Saved in SuuUIProbe.ledger on /reload. Values the game hides read
-- "secret"; every call is under pcall ("error: …", "missing"). No player's
-- name is kept: invoices' buyers and sellers, letters from players, trade
-- partners and system lines that aren't about money read as placeholders.
--
-- From Blizzard's UI source for Forever (Gethe/wow-ui-source, branch
-- forever), read 2026-11-18:
--   * Ruleset: no API names it in game. ConnectionDocumentation.lua has
--     GetRealmName, GetRealmID, GetNativeRealmID, SelectedRealmName and
--     IsOnTournamentRealm; PlayerScriptDocumentation.lua GetNormalizedRealmName
--     and GetPlayerInfoByGUID (its realmName); BattleNetDocumentation.lua's
--     game account info realmName, realmDisplayName, realmID. The PvP and RP
--     flags exist only in the realm list before login (C_RealmList, in
--     Blizzard_GlueXML/Mainline/RealmList.lua: realmInfo.isPvP / isRP,
--     shown as PVP_PARENTHESES, RP_PARENTHESES, RPPVP_PARENTHESES,
--     GAMETYPE_NORMAL). GameRulesDocumentation.lua (C_GameRules:
--     GetActiveGameMode, IsGameRuleActive over Enum.GameRule,
--     GetForeverExperiencePreset …) is read here too, in case a rule tells
--     the ruleset apart; the player's GUID's server ID is a candidate key.
--   * Mail: GetInboxHeaderInfo and GetInboxInvoiceInfo aren't in the
--     generated docs; Blizzard_MailFrame/MailFrame.lua reads the header as
--     packageIcon, stationeryIcon, sender, subject, money, CODAmount,
--     daysLeft, itemCount, wasRead, wasReturned, textCreated, canReply,
--     isGM, firstItemQuantity, firstItemLink, and the invoice as
--     invoiceType ("buyer", "seller", "seller_temp_invoice"), itemName,
--     playerName (nil: several), bid, buyout, deposit, consignment,
--     moneyDelay, etaHour, etaMin, count, commerceAuction. A seller's
--     takings are bid + deposit - consignment. MailInfoDocumentation.lua
--     (C_Mail): HasInboxMoney, MAIL_INBOX_UPDATE, MAIL_SUCCESS, …
--   * Auction notices: ChatFrameUtil.GetAuctionHouseNotificationText
--     (Blizzard_ChatFrameUtil) maps Enum.AuctionHouseNotification (BidPlaced,
--     AuctionRemoved, AuctionWon, AuctionOutbid, AuctionSold,
--     AuctionExpired) to ERR_AUCTION_BID_PLACED, ERR_AUCTION_REMOVED,
--     ERR_AUCTION_WON_S, ERR_AUCTION_OUTBID_S, ERR_AUCTION_SOLD_S,
--     ERR_AUCTION_EXPIRED_S; Blizzard_Game's EventRouting sends
--     AUCTION_HOUSE_SHOW_NOTIFICATION and _FORMATTED_NOTIFICATION to
--     GameEvent.HandleAuctionHouseNotification, which prints that line to
--     the chat wherever you are (AuctionSold = 4, the item's name as its
--     text; CHAT_MSG_SYSTEM is secret on Forever). Both events are
--     recorded with their arguments, here and away from the house (the
--     Ledger's Sold note is built on the formatted one). The house's own frame prints
--     ERR_AUCTION_COMMODITY_WON_S on AUCTION_HOUSE_SHOW_COMMODITY_WON_NOTIFICATION.
--   * Restricted: SendMail and AcceptTrade are HasRestrictions in
--     SecureTransferDocumentation.lua (C_SecureTransfer); nothing here calls
--     them, the hooks only watch. C_Item.GetItemInfo and GetCoinText take
--     secret arguments only untainted; GetItemInfo's sellPrice isn't marked
--     secret. TradeInfoDocumentation.lua has the trade money events
--     (PLAYER_TRADE_MONEY, TRADE_MONEY_CHANGED, TRADE_ACCEPT_UPDATE).

import after from "wowlua:timer"
import isSecret from "wowlua:secret"
import hook from "wowlua:hooks"
import * as tbl from "wowlua:table"
import * as DB from "/Core/DB"
import print, version from "/Core/Init"
import * as apiDocs from "/Diagnostics/ApiDocs"
import pattern from "/Diagnostics/Watch/Kit"

local field = tbl.field

type Record = { [string]: unknown }
-- A money change: when (seconds since arming, and the clock), the money
-- and the change, the windows open, the group, and the log lines of the
-- 3 s before and after it.
export type MoneyEntry = {
    t: number,
    at: string,
    money: unknown,
    delta: unknown,
    open: string,
    group: string,
    onTaxi: string,
    before: string[],
    after: string[],
}
-- A letter as the mailbox showed it (the latest look), its invoice once
-- one came back, and how often it was read.
export type Letter = { firstSeen: string, reads: number, header: Record, invoice?: Record, noInvoice?: string }
-- What the probe saves in SuuUIProbe.ledger.
export type Ledger = {
    layout: number,
    at: string,
    suuui: string,
    build: string,
    sessions: string[],
    armed: boolean,
    ruleset: Record,
    clock: Record,
    prices: { [string]: Record },
    priceApis: { [string]: string[] },
    globals: { [string]: string },
    events: { [string]: string },
    hooks: { [string]: string },
    docs: unknown,
    docFlags: unknown,
    mail: { reads: number, count: string, letters: Letter[] },
    money: MoneyEntry[],
    log: string[],
    system: Record[],
    systemOther: number,
    trade: Record[],
}

const LAYOUT = 1
const LOG_CAP = 400
const MONEY_CAP = 200
const LETTER_CAP = 40
const SYSTEM_CAP = 80
const TRADE_CAP = 40
-- how far around a money change its log lines are kept (seconds)
const AROUND = 3

