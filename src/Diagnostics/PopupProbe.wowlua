local function lookup(path: string): unknown
    local v: unknown = _G
    for part in path:gmatch("[^%.]+") do
        if type(v) ~= "table" then
            return nil
        end
        v = tbl.field(v, part)
    end
    return v
end

-- A function's entry in the client's API documentation: every key that
-- isn't its name, arguments, returns or prose (its flags).
-- (built on first use; false: the client has no documentation)
local docIndex: { [string]: unknown } | false | nil = nil
local function docFlags(path: string): string
    if docIndex == nil then
        docIndex = false
        for _, name in ipairs({
            "Blizzard_APIDocumentationBasic",
            "Blizzard_APIDocumentation",
            "Blizzard_APIDocumentationGenerated",
        }) do
            if C_AddOns.DoesAddOnExist(name) and not C_AddOns.IsAddOnLoaded(name) then
                pcall(C_AddOns.LoadAddOn, name)
            end
        end
        local systems = tbl.field(_G, "APIDocumentation", "systems")
        if type(systems) == "table" then
            local index: { [string]: unknown } = {}
            for _, sys in ipairs(tbl.list(systems)) do
                local ns = tbl.field(sys, "Namespace")
                for _, f in ipairs(tbl.list(tbl.field(sys, "Functions"))) do
                    local key = (ns and (tostring(ns) .. ".") or "") .. tostring(tbl.field(f, "Name"))
                    index[key] = f
                end
            end
            docIndex = index
        end
    end
    local index = docIndex
    if not index then
        return "no docs"
    end
    local f = index[path]
    if type(f) ~= "table" then
        return "not documented"
    end
    local parts: string[] = {}
    for k, v in pairs(f) do
        if k ~= "Name" and k ~= "Arguments" and k ~= "Returns" and k ~= "Documentation" and k ~= "System" and
            type(v) ~= "function" then
            parts[#parts + 1] = tostring(k) .. "=" .. (type(v) == "table" and "{…}" or tostring(v))
        end
    end
    table.sort(parts)
    return #parts > 0 and table.concat(parts, ", ") or "no flags"
end

-- A frame's keyed parts, each marked when protected.
local function keyedLine(f: unknown): string[]
    local kids: string[] = {}
    for k, v in pairs(wf.keyed(f)) do
        local okP, prot = pcall(v.IsProtected, v)
        kids[#kids + 1] = k .. ((okP and prot) and "(protected)" or "")
    end
    table.sort(kids)
    return kids
end

local function frameInfo(name: string): string
    local f = wf.asRegion(tbl.field(_G, name))
    if not f then
        return "missing"
    end
    local out: string[] = {}
    local ok, p = pcall(f.IsProtected, f)
    out[#out + 1] = "protected=" .. (ok and show(p) or "?")
    out[#out + 1] = "forbidden=" .. show(f:IsForbidden())
    out[#out + 1] = f:GetObjectType()
    local kids = keyedLine(f)
    if #kids > 0 then
        out[#out + 1] = "children: " .. table.concat(kids, " ")
    end
    return table.concat(out, ", ")
end

local function args(...: unknown): string
    local parts: string[] = {}
    for i = 1, select("#", ...) do
        parts[#parts + 1] = show((select(i, ...)))
    end
    return table.concat(parts, " | ")
end

-- the log, from the first sample until /reload
local logging = false
local function startLog(store: Popups)
    if logging then
        return
    end
    logging = true
    store.log = store.log or {}
    local function note(s: string)
        local log = popups().log
        log[#log + 1] = date("%H:%M:%S") .. (InCombatLockdown() and " [combat] " or " ") .. s
        while #log > 200 do
            table.remove(log, 1)
        end
    end
    if StaticPopup_Show then
        hook("StaticPopup_Show", function(which: unknown, text1: unknown, text2: unknown, data: unknown)
            note(
                "StaticPopup_Show " ..
                    show(which) .. " | " .. show(text1) .. " | " .. show(text2) .. " | data " .. show(data)
            )
        end)
    end
    if StaticPopup_Hide then
        hook("StaticPopup_Hide", function(which: unknown)
            note("StaticPopup_Hide " .. show(which))
        end)
    end
    local f = CreateFrame("Frame")
    for _, e in ipairs(EVENTS) do
        if C_EventUtils.IsEventValid(e) then
            f:RegisterEvent(e)
        end
    end
    f:SetScript("OnEvent", function(_, event: string, ...: unknown)
        note(event .. " " .. args(...))
    end)
end

export function sample(): Popups
    local store = popups()
    store.at = date("%H:%M:%S")
    store.dialogs = {}
    local dialogs = tbl.field(_G, "StaticPopupDialogs")
    store.dialogCount = type(dialogs) == "table" and tbl.count(dialogs) or 0
    for _, which in ipairs(DIALOGS) do
        local d = tbl.field(dialogs, which)
        if d ~= nil then
            local function f(key: string): string
                return show(tbl.field(d, key))
            end
            store.dialogs[which] = ("button1=%s button2=%s button3=%s timeout=%s whileDead=%s hideOnEscape=%s exclusive=%s editBox=%s OnAccept=%s OnCancel=%s OnShow=%s"):format(
                f("button1"),
                f("button2"),
                f("button3"),
                f("timeout"),
                f("whileDead"),
                f("hideOnEscape"),
                f("exclusive"),
                f("hasEditBox"),
                f("OnAccept"),
                f("OnCancel"),
                f("OnShow")
            )
        else
            store.dialogs[which] = "missing"
        end
    end
    store.frames = {}
    for _, name in ipairs(FRAMES) do
        store.frames[name] = frameInfo(name)
    end
    local bc = tbl.field(_G, "StaticPopup1", "ButtonContainer")
    if bc ~= nil then
        store.frames["StaticPopup1.ButtonContainer"] = "children: " .. table.concat(keyedLine(bc), " ")
    end
    store.answers = {}
    for _, path in ipairs(ANSWERS) do
        local fn = lookup(path)
        store.answers[path] = (type(fn) == "function" and "function" or "missing") .. " · " .. docFlags(path)
    end
    store.events = {}
    for _, e in ipairs(EVENTS) do
        store.events[e] = show(C_EventUtils.IsEventValid(e))
    end
    store.cvars = { autoAcceptQuickJoinRequests = show(GetCVar("autoAcceptQuickJoinRequests")) }
    startLog(store)
    return store
end

-- Calls the answers that do nothing without a request, one per half second,
-- noting which the game blocks.
-- a function to try (its path), its arguments and when to skip it
type Try = {
    [number]: string,
    args?: (number | boolean | string)[],
    needsEmptyCursor?: boolean,
    needsAlive?: boolean,
    needsNoTrade?: boolean,
    needsNoQueue?: boolean,
}
local TRIES: Try[] = {
    { "AcceptGroup" },
    { "DeclineGroup" },
    { "AcceptResurrect" },
    { "DeclineResurrect" },
    { "C_SummonInfo.ConfirmSummon" },
    { "C_SummonInfo.CancelSummon" },
    { "AcceptDuel" },
    { "CancelDuel" },
    { "DeleteCursorItem", needsEmptyCursor = true },
    { "ConfirmReadyCheck", args = { true } },
    { "AcceptAreaSpiritHeal" },
    { "CancelAreaSpiritHeal" },
    { "RetrieveCorpse", needsAlive = true },
    { "RepopMe", needsAlive = true },
    { "CancelLogout" },
    { "AcceptTrade", needsNoTrade = true },
    { "CancelTrade", needsNoTrade = true },
    { "AcceptProposal" },
    { "RejectProposal" },
    { "AcceptBattlefieldPort", args = { 1, false }, needsNoQueue = true },
}

export function try()
    if InCombatLockdown() then
        print("Popup probe: out of combat, please.")
        return
    end
    local store = sample()
    store.tries = {}
    local current: string? = nil
    local watch = CreateFrame("Frame")
    watch:RegisterEvent("ADDON_ACTION_BLOCKED")
    watch:RegisterEvent("ADDON_ACTION_FORBIDDEN")
    watch:SetScript("OnEvent", function(_, event: string, addon: unknown, fn: unknown)
        local now = current
        if now then
            store.tries[now] = (store.tries[now] or "") .. " " .. event .. "(" .. show(fn) .. ")"
        end
    end)
    local i = 0
    local function step()
        i = i + 1
        local t = TRIES[i]
        if not t then
            current = nil
            watch:UnregisterAllEvents()
            print("Popup probe: tried them all. /reload to save.")
            return
        end
        local path = t[1] or "?"
        current = path
        local fn = lookup(path)
        if type(fn) ~= "function" then
            store.tries[path] = "missing"
        elseif t.needsEmptyCursor and GetCursorInfo() then
            store.tries[path] = "skipped: something on the cursor"
        elseif t.needsAlive and UnitIsDeadOrGhost("player") then
            store.tries[path] = "skipped: dead"
        elseif t.needsNoTrade and TradeFrame:IsShown() then
            store.tries[path] = "skipped: trading"
        elseif t.needsNoQueue and GetBattlefieldStatus(1) ~= "none" then
            store.tries[path] = "skipped: queued"
        else
            store.tries[path] = ""
            local ok, err = pcall(fn, unpack(t.args or {}))
            -- a block noted while it ran stays (it comes inside the call)
            store.tries[path] = (ok and "called" or ("error: " .. tostring(err):sub(1, 160))) ..
                (store.tries[path] or "")
        end
        after(0.5, step)
    end
    print("Popup probe: trying the answers (a Blizzard \"blocked\" message for some is expected)…")
    step()
end

-- Hosting: Blizzard's popup moved over SuuUI's panel, only its buttons
-- showing (its texts, art and other parts at alpha 0). Nothing written on
-- Blizzard's frames but points and alpha.
local HOSTED: { [string]: boolean } = {
    CAMP = true,
    QUIT = true,
    DELETE_ITEM = true,
    DELETE_GOOD_ITEM = true,
    DELETE_QUEST_ITEM = true,
    DELETE_GOOD_QUEST_ITEM = true,
}
local hostPanel: (Frame
    & BackdropTemplateMixin)?, hostText: FontString?, hostArmed: boolean?, hostHooked: boolean? = nil, nil, nil, nil

local function hostNote(s: string)
    local p = popups()
    p.host = p.host or {}
    table.insert(p.host, date("%H:%M:%S") .. " " .. s)
end

local function host(which: string)
    local findVisible = tbl.field(_G, "StaticPopup_FindVisible")
    local dialog = type(findVisible) == "function" and wf.asFrame(findVisible(which)) or nil
    if not dialog then
        hostNote("no visible dialog for " .. tostring(which))
        return
    end
    local panel, text = hostPanel, hostText
    if not (panel and text) then
        panel = CreateFrame("Frame", nil, UIParent, "BackdropTemplate") :: Frame & BackdropTemplateMixin
        hostPanel = panel
        panel:SetSize(340, 110)
        panel:SetPoint("LEFT", 60, 80)
        panel:SetBackdrop({
            bgFile = "Interface\\Buttons\\WHITE8X8",
            edgeFile = "Interface\\Buttons\\WHITE8X8",
            edgeSize = 1,
        })
        panel:SetBackdropColor(0.05, 0.05, 0.07, 0.92)
        panel:SetBackdropBorderColor(0.6, 0.5, 0.3, 0.8)
        text = panel:CreateFontString(nil, "OVERLAY", "GameFontHighlight")
        hostText = text
        text:SetPoint("TOPLEFT", 12, -12)
        text:SetPoint("TOPRIGHT", -12, -12)
        text:SetJustifyH("LEFT")
    end
    text:SetText("SuuUI hosting test (" .. which .. "): Blizzard's buttons below are its own. Click Cancel or No.")
    panel:Show()
    -- everything but the buttons invisible
    for _, region in ipairs(wf.textures(dialog)) do
        region:SetAlpha(0)
    end
    for _, region in ipairs(wf.fontStrings(dialog)) do
        region:SetAlpha(0)
    end
    local buttons = tbl.field(dialog, "ButtonContainer")
    for _, child in ipairs(wf.children(dialog)) do
        if child ~= buttons then
            child:SetAlpha(0)
        end
    end
    dialog:ClearAllPoints()
    dialog:SetPoint("BOTTOM", panel, "BOTTOM", 0, -10)
    hostNote("hosted " .. which .. " on " .. tostring(dialog:GetName()))
end

local function hostTest()
    local store = sample()
    store.host = {}
    hostArmed = true
    if not hostHooked then
        hostHooked = true
        hook("StaticPopup_Show", function(value: unknown)
            local which = secret.asString(value)
            if hostArmed and which and HOSTED[which] then
                hostArmed = false
                after(0, function()
                    host(which)
                end)
            end
        end)
        if StaticPopup_Hide then
            hook("StaticPopup_Hide", function(value: unknown)
                local which = secret.asString(value)
                if which and HOSTED[which] then
                    hostNote("hidden " .. tostring(which))
                    if hostPanel then
                        hostPanel:Hide()
                    end
                end
            end)
        end
        local f = CreateFrame("Frame")
        for _, e in ipairs({
            "PLAYER_CAMPING",
            "LOGOUT_CANCEL",
            "ADDON_ACTION_BLOCKED",
            "ADDON_ACTION_FORBIDDEN",
            "DELETE_ITEM_CONFIRM",
        }) do
            f:RegisterEvent(e)
        end
        f:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown)
            hostNote(event .. " " .. show(a) .. " " .. show(b))
        end)
    end
    print(
        "Popup probe: hosting armed. Type /camp (or start deleting an item), then click Cancel / No on the moved popup. /reload after."
    )
end

export function command(arg: string?)
    if arg == "try" then
        return try()
    end
    if arg == "host" then
        return hostTest()
    end
    local s = sample()
    print(("Popup probe: %d popup kinds. Logging popups and request events until /reload."):format(s.dialogCount or 0))
end
