-- Diagnostics/Gallery.wowlua
-- /suu gallery: every primitive and component SuuUI has so far, in game, to
-- compare against the design system's component pages. Built only from the
-- public API, as a plugin would be.

import SuuUI from "/Core/API"
import after from "wowlua:timer"

local UI, Layout, Motion, T = SuuUI.UI, SuuUI.Layout, SuuUI.Motion, SuuUI.Tokens
local S = T.space

local COL_W = 440

local ART = {
    heal = "Interface\\Icons\\Spell_Nature_HealingWaveGreater",
    wall = "Interface\\Icons\\Ability_Warrior_ShieldWall",
    shield = "Interface\\Icons\\Spell_Holy_PowerWordShield",
    rejuv = "Interface\\Icons\\Spell_Nature_Rejuvenation",
    nova = "Interface\\Icons\\Spell_Frost_FrostNova",
    kick = "Interface\\Icons\\Ability_Kick",
    herb = "Interface\\Icons\\INV_Misc_Herb_DreamFoil",
}

local function hrow(parent: Frame, gap: number?): (Frame, any)
    local f = CreateFrame("Frame", nil, parent)
    local stack = Layout.Stack(f, { direction = "horizontal", gap = gap or S["space-4"], align = "center" })
    return f, stack
end

local function para(parent: Frame, text: string, width: number): any
    local t = UI.Text(parent, "body", "ink")
    t:SetWordWrap(true)
    t:SetJustifyH("LEFT")
    t:SetFixedWidth(width)
    t:SetValue(text)
    return t
end

-- A muted note; with a width it wraps.
local function caption(parent: Frame, text: string, width: number?): any
    local t = UI.Text(parent, "caption", "ink-muted")
    if width then
        t:SetWordWrap(true)
        t:SetJustifyH("LEFT")
        t:SetFixedWidth(width)
    end
    t:SetValue(text)
    return t
end

-- A panel whose body is a vertical stack; returns the panel and the stack.
local function panel(parent: Frame, opts: { [string]: any }): (any, any)
    local p = UI.Panel(parent, opts)
    local stack = Layout.Stack(p.body, { gap = S["space-4"], autoSize = opts.width and "height" or true })
    return p, stack
end

--------------------------------------------------------------------------------
-- Column A: panels, buttons, badges
--------------------------------------------------------------------------------

local function columnA(col: Frame, stack: any)
    stack:Add(UI.SectionHeader(col, "Panels", "plain, closable, anchor", COL_W))

    local plain, ps = panel(col, { title = "Readiness", meta = "before pull", width = COL_W })
    ps:Add(para(plain.body, "Plain panels hold insights, windows, settings and menus. The title sits over a gilt divider with its jewel.", COL_W - S["space-5"] * 2))
    stack:Add(plain)

    local loot, ls
    loot, ls = panel(col, { title = "Loot", meta = "Ember Hound", closable = true, width = 260,
        onClose = function(p)
            p:Hide()
            after(1.5, function() p:Show() end)
        end })
    ls:Add(para(loot.body, "Windows carry a close button after the meta.", 260 - S["space-5"] * 2))
    stack:Add(loot)

    local dock = UI.Panel(col, { anchor = true })
    local bar, bs = hrow(dock.body, S["space-2"])
    for _, key in ipairs({ "heal", "rejuv", "shield", "nova", "kick", "wall" }) do
        local icon = UI.Icon(bar, "action")
        icon:SetArt(ART[key])
        bs:Add(icon)
    end
    Layout.Stack(dock.body):Add(bar)
    stack:Add(dock)
    stack:Add(caption(col, "The anchor frame (inset-anchor and two diamonds) belongs to the player frame, minimap and dock only.", COL_W))

    stack:Add(UI.SectionHeader(col, "Buttons", "hover them", COL_W), { gapBefore = S["space-6"] })
    local buttons, b = hrow(col)
    b:Add(UI.Button(buttons, { text = "Ready check", variant = "primary",
        tooltip = { title = "Ready check", description = "Primary: the one action a view exists for, at most once per view." } }))
    b:Add(UI.Button(buttons, { text = "Edit layout",
        tooltip = { title = "Shield Wall", subtitle = "Warrior · Protection",
            lines = { { "Instant", "30 min cooldown" }, { "Requires a shield" } },
            description = "Reduces all damage taken by 75% for 10 sec.", meta = "Ready in 21m" } }))
    b:Add(UI.Button(buttons, { text = "Reset", disabled = true }))
    stack:Add(buttons)

    stack:Add(UI.SectionHeader(col, "State badges", "colour always comes with a word", COL_W), { gapBefore = S["space-6"] })
    local tones = {
        { "danger", "Aggro" }, { "warning", "23% mana" }, { "magic", "Magic" }, { "curse", "Curse" }, { "poison", "Poison" },
        { "disease", "Disease" }, { "ward", "Warded" }, { "info", "Soulstone" }, { "neutral", "you" },
    }
    local row1, r1 = hrow(col, S["space-4"])
    local row2, r2 = hrow(col, S["space-4"])
    for i, t in ipairs(tones) do
        local row, rs = row1, r1
        if i > 5 then row, rs = row2, r2 end
        rs:Add(UI.StateBadge(row, t[1], t[2]))
    end
    stack:Add(row1)
    stack:Add(row2, { gapBefore = S["space-3"] })
end

--------------------------------------------------------------------------------
-- Column B: icons, bars, glows, motion, tooltip
--------------------------------------------------------------------------------

local function columnB(col: Frame, stack: any)
    stack:Add(UI.SectionHeader(col, "Icons", "sizes and states", COL_W))
    local sizes, ss = hrow(col)
    for _, size in ipairs({ "icon-sm", "icon-md", "icon-lg", "action", "action-sm", "slot", "cdm-essential" }) do
        local icon = UI.Icon(sizes, size)
        icon:SetArt(ART.heal)
        ss:Add(icon)
    end
    stack:Add(sizes)
    stack:Add(caption(col, "icon-sm 16 · icon-md 24 · icon-lg 30 · action 20 · action-sm 18 · slot 36 · cdm-essential 40", COL_W))

    local states, st = hrow(col, S["space-5"])
    local ready
    for _, s in ipairs({ { "rest", ART.wall }, { "ready", ART.kick }, { "dim", ART.nova }, { "active", ART.rejuv } }) do
        local icon = UI.Icon(states, "icon-lg")
        icon:SetArt(s[2])
        icon:SetState(s[1])
        if s[1] == "ready" then ready = icon end
        st:Add(icon)
    end
    local magic = UI.Icon(states, "icon-lg")
    magic:SetArt(ART.shield)
    magic:SetBorder("dispel-magic")
    st:Add(magic)
    local poison = UI.Icon(states, "icon-lg")
    poison:SetArt(ART.herb)
    poison:SetBorder("dispel-poison")
    poison:SetCount(3)
    st:Add(poison)
    st:Add(UI.Button(states, { text = "Pop", onClick = function() ready:Pop() end }))
    stack:Add(states, { gapBefore = S["space-5"] })
    stack:Add(caption(col, "rest · ready (arcane, glow) · dim (on cooldown) · active · magic · poison with a stack count", COL_W))

    stack:Add(UI.SectionHeader(col, "Bars", "hit it: the ghost drains after 150ms", COL_W), { gapBefore = S["space-6"] })
    local hp = 88
    local health = UI.StatusBar(col, { width = "bar-lg", height = "unit-lg", ghost = true })
    health:SetMinMax(0, 100)
    health:SetValueNow(hp)
    local name = UI.Text(health.bar, "unit-name-lg", "ink")
    name:SetPoint("LEFT", S["space-4"], 0)
    name:SetValue("Veyra")
    local pct = UI.Text(health.bar, "numeric", "ink")
    pct:SetPoint("RIGHT", -S["space-4"], 0)
    local function show()
        health:SetValue(hp)
        pct:SetValue(hp .. "%")
        if hp < 35 then health:SetFill("unit-fill-low", "unit-fill-low-deep") else health:SetFill("unit-fill", "unit-fill-deep") end
    end
    show()
    stack:Add(health)
    local controls, cs = hrow(col)
    cs:Add(UI.Button(controls, { text = "Hit", onClick = function() hp = math.max(0, hp - 17) show() end }))
    cs:Add(UI.Button(controls, { text = "Heal", onClick = function() hp = math.min(100, hp + 23) show() end }))
    cs:Add(caption(controls, "below 35% the fill turns unit-fill-low"))
    stack:Add(controls)

    local cast = UI.StatusBar(col, { width = "bar-lg", height = "cast", fill = "arcane" })
    cast:SetMinMax(0, 1)
    cast:SetValueNow(0.6)
    local spell = UI.Text(cast.bar, "label", "on-signal")
    spell:SetPoint("LEFT", S["space-4"], 0)
    spell:SetValue("Shadow Volley")
    stack:Add(cast)
    local xp = UI.StatusBar(col, { width = "bar-lg", height = "progress", fill = "progress-fill", track = "track", border = false })
    xp:SetMinMax(0, 100)
    xp:SetValueNow(61)
    stack:Add(xp)
    stack:Add(caption(col, "cast (arcane: interruptible) · progress (XP, reputation)", COL_W))

    stack:Add(UI.SectionHeader(col, "Glows and motion", nil, COL_W), { gapBefore = S["space-6"] })
    local glows, gs = hrow(col, S["space-6"])
    for _, g in ipairs({ { "glow-arcane", ART.kick }, { "glow-ember", ART.nova }, { "glow-ward", ART.wall } }) do
        local icon = UI.Icon(glows, "icon-lg")
        icon:SetArt(g[2])
        icon:SetGlow(g[1])
        gs:Add(icon)
    end
    local target = UI.Panel(glows, { title = "Alert", width = 120 })
    target.body:SetHeight(1)
    gs:Add(UI.Button(glows, { text = "Enter", onClick = function() Motion.Enter(target) end }))
    gs:Add(UI.Button(glows, { text = "Fade", onClick = function() Motion.FadeIn(target) end }))
    gs:Add(target)
    stack:Add(glows, { gapBefore = S["space-5"] })
    stack:Add(caption(col, "glow-arcane · glow-ember · glow-ward; motion respects ui.reducedMotion", COL_W))

    stack:Add(UI.SectionHeader(col, "Tooltip", "hover Edit layout for the live one", COL_W), { gapBefore = S["space-6"] })
    local tip = UI.TooltipFrame(col)
    tip:SetContent({
        title = "Wardplate of the Gilded Vigil", titleColor = "quality-epic", subtitle = "Binds when picked up",
        lines = { { "Chest", "Plate" }, { "864 Armor" }, { "+21 Stamina" } },
        description = "Equip: Increases your chance to block attacks by 2%.", meta = "Requires level 60",
    })
    stack:Add(tip)
end

--------------------------------------------------------------------------------
-- Window
--------------------------------------------------------------------------------

local window: Frame?

local function build(): Frame
    local w = UI.WindowFrame(SuuUI.Root, {
        name = "SuuUIGallery", title = "Component gallery",
        meta = ("design tokens v%d · API %s"):format(T.version, SuuUI.API_VERSION),
        width = COL_W * 2 + S["space-6"] + S["space-5"] * 2 + 4, height = 700,
    })
    -- Hidden until fully built, so a failed build leaves nothing on screen.
    w:Hide()
    w:SetPoint("CENTER")
    local columns = Layout.Stack(w.content, { direction = "horizontal", gap = S["space-6"], autoSize = "height" })
    for _, fill in ipairs({ columnA, columnB }) do
        local col = CreateFrame("Frame", nil, w.content)
        local stack = Layout.Stack(col, { gap = S["space-4"] })
        fill(col, stack)
        columns:Add(col)
    end
    return w
end

export function toggle()
    local w = window or build()
    window = w
    w:SetShown(not w:IsShown())
end

export function hide()
    if window then window:Hide() end
end
