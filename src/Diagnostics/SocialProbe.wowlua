-- Diagnostics/SocialProbe.wowlua
-- "/suu probe social": what Forever's social APIs give an addon, for
-- SuuUI's Social, Guild and Group Finder windows and the friends' online
-- notifications (step 3.4). Saved in SuuUIProbe.social on /reload.
--   * friends (C_FriendList), Battle.net friends (C_BattleNet), the guild
--     (roster, ranks, notes and what you may edit, the message of the day),
--     the raid
--   * the group finder: C_LFGList's functions, categories, activities
--   * Blizzard's frames for all of it (FriendsFrame, CommunitiesFrame,
--     LFGListFrame...) and their tabs
--   * how the game announces people coming online and going offline: the
--     global strings, the chat filter API, which events exist; and for ten
--     minutes after the command, every such event as it comes (with its
--     text), so log in a friend or wait for a guild member
--
--   /suu probe social    then play a while, then /reload

import SuuUI from "/Core/API"
import * as DB from "/Core/DB"
import print from "/Core/Init"
import * as modules from "/Core/Modules"
import hook from "wowlua:hooks"
import isSecret, asString, asNumber from "wowlua:secret"
import after from "wowlua:timer"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"

type Record = { [string]: unknown }

-- set by the friend system probe: SuuUI's social pages step aside until
-- /reload, so the game's own lists can be used (Core/API asks)
local socialBlizzard = false

-- the secure buttons of the notes probes (made once a session)
local notesButton: Button? = nil
local noteListButton: Button? = nil

-- Whether the friend system probe has made SuuUI's social pages step aside.
export function showsBlizzardSocial(): boolean
    return socialBlizzard
end

local function show(v: unknown, depth: number?): string
    depth = depth or 0
    if isSecret(v) then return "secret" end
    if v == nil then return "nil" end
    if type(v) == "table" then
        if depth > 2 then return "{…}" end
        local parts: string[] = {}
        for k, x in pairs(v) do
            parts[#parts + 1] = tostring(k) .. "=" .. show(x, depth + 1)
            if #parts > 40 then break end
        end
        table.sort(parts)
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

-- `fn(...)`'s results as text, "missing" or "error: …".
local function call(fn: unknown, ...: unknown): string
    if type(fn) ~= "function" then return "missing" end
    local res = { pcall(fn, ...) }
    if not res[1] then return "error: " .. tostring(res[2]):sub(1, 160) end
    local parts: string[] = {}
    for i = 2, math.max(2, select("#", unpack(res))) do parts[#parts + 1] = show(res[i]) end
    return table.concat(parts, " | ")
end

-- `fn(...)`'s results as they are (nothing when it's missing or raises).
local function raw(fn: unknown, ...: unknown): (unknown, unknown)
    if type(fn) ~= "function" then return nil, nil end
    local ok, a, b = pcall(fn, ...)
    if ok then return a, b end
    return nil, nil
end

-- A number the game gave (0 when it isn't one).
local function count(v: unknown): number
    return asNumber(v) or 0
end

local function namesIn(t: unknown): string[]
    local out: string[] = {}
    if type(t) ~= "table" then return { "missing" } end
    for k, v in pairs(t) do if type(k) == "string" and type(v) == "function" then out[#out + 1] = k end end
    table.sort(out)
    return out
end

-- The fields of a table the game made (a frame's own, a row's), by name and type.
local function fieldsOf(t: unknown, values: boolean?): string[]
    local out: string[] = {}
    if type(t) ~= "table" then return out end
    for k, v in pairs(t) do
        if type(k) == "string" then
            if not values then
                out[#out + 1] = k
            elseif type(v) ~= "table" and type(v) ~= "function" then
                out[#out + 1] = k .. "=" .. tostring(v)
            end
        end
    end
    table.sort(out)
    return out
end

-- A frame's label: its `Text` or `text` font string, or a button's own.
local function labelOf(f: Frame): FontString?
    local fs = wf.asFontString(tbl.field(f, "Text")) or wf.asFontString(tbl.field(f, "text"))
    if fs then return fs end
    local b = wf.asButton(f)
    return b and b:GetFontString()
end

local PRESENCE_EVENTS = { "FRIENDLIST_UPDATE", "BN_FRIEND_ACCOUNT_ONLINE", "BN_FRIEND_ACCOUNT_OFFLINE",
    "BN_FRIEND_INFO_CHANGED", "BN_CONNECTED", "GUILD_ROSTER_UPDATE", "CHAT_MSG_SYSTEM",
    "CHAT_MSG_BN_INLINE_TOAST_ALERT", "CHAT_MSG_GUILD_ACHIEVEMENT", "CLUB_MEMBER_PRESENCE_UPDATED",
    "GUILD_MOTD", "PLAYER_GUILD_UPDATE" }

local function frameInfo(name: string): string
    local f = wf.find(name)
    if not f then return "missing" end
    local tabs: string[] = {}
    for i = 1, 8 do
        local t = wf.find(name .. "Tab" .. i)
        if t then
            local fs = labelOf(t)
            tabs[#tabs + 1] = i .. ":" .. show(fs and fs:GetText())
        end
    end
    return ("shown=%s protected=%s w=%s h=%s tabs=%s"):format(show(f:IsShown()), show((f:IsProtected())),
        show(f:GetWidth()), show(f:GetHeight()), table.concat(tabs, " "))
end

-- What the main probe saves (SuuUIProbe.social): the friends, Battle.net,
-- the guild, the raid, the group finder, the frames, and the presence
-- events heard since.
type Social = {
    at: string, friends: { count: string, [string]: unknown }, bnet: { count: string, [string]: unknown },
    guild: { members: string, [string]: unknown },
    events?: string[], eventCounts?: { [string]: number }, lfgSearch?: Record, [string]: unknown,
}

export function sample(): Social
    local fl = C_FriendList
    local friendsFirst: string[] = {}
    local friends = {
        count = call(fl.GetNumFriends), online = call(fl.GetNumOnlineFriends),
        api = namesIn(fl), first = friendsFirst,
    }
    for i = 1, math.min(4, count((raw(fl.GetNumFriends)))) do
        friendsFirst[i] = call(fl.GetFriendInfoByIndex, i)
    end
    -- Battle.net
    local bnFirst: string[], bnGames: Record[] = {}, {}
    local bnet = { count = call(BNGetNumFriends), api = namesIn(C_BattleNet), first = bnFirst,
                   connected = call(BNConnected), myInfo = call(BNGetInfo), games = bnGames }
    for i = 1, math.min(4, count((raw(BNGetNumFriends)))) do
        bnFirst[i] = call(C_BattleNet.GetFriendAccountInfo, i)
        -- what they're playing: each game account (character, zone, client)
        local n = (raw(C_BattleNet.GetFriendNumGameAccounts, i))
        local games: Record = { count = show(n) }
        bnGames[i] = games
        for j = 1, math.min(3, count(n)) do
            games[tostring(j)] = call(C_BattleNet.GetFriendGameAccountInfo, i, j)
        end
    end
    -- the guild
    local guildFirst: string[], rankNames: string[] = {}, {}
    local guild = {
        inGuild = call(IsInGuild), info = call(GetGuildInfo, "player"), members = call(GetNumGuildMembers),
        motd = call(GetGuildRosterMOTD), ranks = call(GuildControlGetNumRanks),
        canEditPublic = call(CanEditPublicNote), canEditOfficer = call(tbl.field(_G, "CanEditOfficerNote")),
        canViewOfficer = call(tbl.field(C_GuildInfo, "CanViewOfficerNote")), canInvite = call(CanGuildInvite),
        canRemove = call(CanGuildRemove), canPromote = call(CanGuildPromote), isLeader = call(IsGuildLeader),
        guildInfoApi = namesIn(C_GuildInfo), clubApi = namesIn(C_Club), first = guildFirst, rankNames = rankNames,
    } :: { members: string, [string]: unknown }
    for i = 1, math.min(5, count((raw(GetNumGuildMembers)))) do
        guildFirst[i] = call(GetGuildRosterInfo, i)
    end
    for i = 1, math.min(10, count((raw(GuildControlGetNumRanks)))) do
        rankNames[i] = call(GuildControlGetRankName, i)
    end
    -- the guild's community: its chat streams (the Guild window's Chat)
    local clubID = (raw(C_Club.GetGuildClubId))
    guild.club = show(clubID)
    if clubID ~= nil then
        guild.clubInfo = call(C_Club.GetClubInfo, clubID)
        guild.streams = call(C_Club.GetStreams, clubID)
        guild.memberCount = show(#tbl.list((raw(C_Club.GetClubMembers, clubID))))
        guild.self = show((raw(C_Club.GetMemberInfoForSelf, clubID)))
    end
    guild.news = call(tbl.field(C_GuildInfo, "GetGuildNewsInfo"), 1)
    guild.events = call(GetNumGuildEvents)
    local store = DB.probeData("social", function(): Social
        return { at = "", friends = friends, bnet = bnet, guild = guild }
    end)
    store.at = date("%Y-%m-%d %H:%M:%S")
    store.level, store.class = UnitLevel("player"), select(2, UnitClass("player"))
    store.friends, store.bnet, store.guild = friends, bnet, guild
    store.ignores = call(fl.GetNumIgnores)
    -- the raid
    store.raid = { inRaid = call(IsInRaid), members = call(GetNumGroupMembers), first = call(GetRaidRosterInfo, 1) }
    -- the group finder
    local lfg = C_LFGList
    local categories: Record[] = {}
    local lfgRecord: Record = { api = namesIn(lfg), categories = categories, active = call(tbl.field(lfg, "HasActiveEntryInfo")) }
    store.lfg = lfgRecord
    for i, cat in ipairs(tbl.list((raw(tbl.field(lfg, "GetAvailableCategories"))))) do
        if i > 12 then break end
        local activities: string[] = {}
        local acts = tbl.list((raw(tbl.field(lfg, "GetAvailableActivities"), cat)))
        local c: Record = { id = cat, activities = activities, activityCount = #acts,
            info = call(tbl.field(lfg, "GetLfgCategoryInfo") or tbl.field(lfg, "GetCategoryInfo"), cat) }
        for j, a in ipairs(acts) do
            if j > 6 then break end
            activities[j] = show(a) .. " " .. call(tbl.field(lfg, "GetActivityInfoTable"), a)
        end
        categories[#categories + 1] = c
    end
    store.lfgBrowse = namesIn(tbl.field(_G, "C_LFGBrowse"))
    lfgRecord.activeEntry = call(tbl.field(lfg, "GetActiveEntryInfo"))
    lfgRecord.filters = call(tbl.field(lfg, "GetAvailableLanguageSearchFilter"))
    -- Blizzard's frames
    local framesInfo: { [string]: string } = {}
    store.frames = framesInfo
    for _, name in ipairs({ "FriendsFrame", "CommunitiesFrame", "GuildFrame", "LFGListFrame", "PVEFrame",
                            "LFGParentFrame", "LFGBrowseFrame", "GroupFinderFrame", "RaidFrame", "WhoFrame",
                            "ChannelFrame", "BNToastFrame", "GuildMicroButton", "LFDMicroButton",
                            "SocialsMicroButton", "FriendsMicroButton", "QuickJoinToastButton" }) do
        framesInfo[name] = frameInfo(name)
    end
    -- how online and offline are announced
    store.strings = {
        ERR_FRIEND_ONLINE_SS = show(ERR_FRIEND_ONLINE_SS), ERR_FRIEND_OFFLINE_S = show(ERR_FRIEND_OFFLINE_S),
        BN_INLINE_TOAST_FRIEND_ONLINE = show(BN_INLINE_TOAST_FRIEND_ONLINE),
        BN_INLINE_TOAST_FRIEND_OFFLINE = show(BN_INLINE_TOAST_FRIEND_OFFLINE),
        GUILD_MEMBER_ONLINE = show(tbl.field(_G, "GUILD_MEMBER_ONLINE")), GUILD_MEMBER_OFFLINE = show(tbl.field(_G, "GUILD_MEMBER_OFFLINE")),
    }
    store.chatFilter = {
        util = tbl.field(ChatFrameUtil, "AddMessageEventFilter") and "ChatFrameUtil.AddMessageEventFilter" or "missing",
        global = tbl.field(_G, "ChatFrame_AddMessageEventFilter") and "ChatFrame_AddMessageEventFilter" or "missing",
    }
    local valid = C_EventUtils.IsEventValid
    local eventsValid: { [string]: string } = {}
    store.eventsValid = eventsValid
    for _, e in ipairs(PRESENCE_EVENTS) do eventsValid[e] = tostring(valid(e)) end
    return store
end

-- Ten minutes of presence events, as they come.
local presenceListener: Frame? = nil
export function listen(store: Social)
    local events = store.events or {}
    store.events = events
    local counts = store.eventCounts or {}
    store.eventCounts = counts
    if not presenceListener then presenceListener = CreateFrame("Frame") end
    local listener = presenceListener
    listener:UnregisterAllEvents()
    for _, e in ipairs(PRESENCE_EVENTS) do
        if C_EventUtils.IsEventValid(e) then listener:RegisterEvent(e) end
    end
    local untilTime = GetTime() + 600
    listener:SetScript("OnEvent", function(_, event: string, ...: unknown)
        if GetTime() > untilTime then listener:UnregisterAllEvents() return end
        -- the roster's own updates come in floods: a count, not each
        if event == "GUILD_ROSTER_UPDATE" or event == "FRIENDLIST_UPDATE" or event == "BN_FRIEND_INFO_CHANGED" then
            counts[event] = (counts[event] or 0) + 1
            return
        end
        if #events >= 60 then return end
        local args: string[] = {}
        for i = 1, math.min(14, select("#", ...)) do args[i] = show((select(i, ...))) end
        events[#events + 1] = date("%H:%M:%S") .. " " .. event .. ": " .. table.concat(args, " | "):sub(1, 400)
    end)
end

-- One group finder search in the first category: whether an addon may
-- search, and what a result looks like.
export function search(store: Social)
    local lfg = C_LFGList
    local cat = tbl.list((raw(tbl.field(lfg, "GetAvailableCategories"))))[1]
    local s: Record = { category = show(cat) }
    store.lfgSearch = s
    if cat == nil then return end
    local f = CreateFrame("Frame")
    f:RegisterEvent("LFG_LIST_SEARCH_RESULTS_RECEIVED")
    f:RegisterEvent("LFG_LIST_SEARCH_FAILED")
    f:SetScript("OnEvent", function(self, event)
        self:UnregisterAllEvents()
        s.event = event
        local n, list = raw(tbl.field(lfg, "GetSearchResults"))
        s.count = show(n)
        local results: string[] = {}
        s.results = results
        for i, id in ipairs(tbl.list(list)) do
            if i > 4 then break end
            results[i] = call(tbl.field(lfg, "GetSearchResultInfo"), id)
            s["members" .. i] = call(tbl.field(lfg, "GetSearchResultMemberCounts"), id)
            s["leader" .. i] = call(tbl.field(lfg, "GetSearchResultMemberInfo"), id, 1)
        end
    end)
    s.call = call(tbl.field(lfg, "Search"), cat)
end

-- Forever's two-part names ("Suther Stargazer"): what each API gives for
-- your own character, and the C_PlayerInfo functions there are.
export function names(): Record
    local n: Record = { at = date("%Y-%m-%d %H:%M:%S") }
    DB.probe.names = n
    n.UnitName = call(UnitName, "player")
    n.UnitFullName = call(UnitFullName, "player")
    n.GetUnitName = call(GetUnitName, "player", true)
    n.UnitNameUnmodified = call(UnitNameUnmodified, "player")
    n.UnitNameFull = call(tbl.field(_G, "UnitNameFull"), "player")
    n.UnitNameWithSurname = call(tbl.field(_G, "UnitNameWithSurname"), "player")
    n.realm = call(GetNormalizedRealmName)
    n.guid = call(UnitGUID, "player")
    n.byGUID = call(GetPlayerInfoByGUID, UnitGUID("player"))
    n.playerInfoApi = namesIn(C_PlayerInfo)
    local surname: string[] = {}
    for k, v in pairs(_G) do
        if type(k) == "string" and type(v) == "function" and (k:lower():find("surname") or k:lower():find("fullname")) then
            surname[#surname + 1] = k .. " = " .. call(v, "player")
        end
    end
    table.sort(surname)
    n.globals = surname
    local club = (raw(C_Club.GetGuildClubId))
    n.clubSelf = club ~= nil and call(C_Club.GetMemberInfoForSelf, club) or "no guild"
    n.target = call(UnitName, "target")
    n.targetFull = call(UnitFullName, "target")
    print("Names probe: saved; /reload. (Target another player first if you can.)")
    return n
end

-- A frame's parts by their key on it (`frame.ScrollBox`), for parts
-- without a global name.
local function keysOf(f: Frame): { [Region]: string }
    local keys: { [Region]: string } = {}
    for key, r in pairs(wf.keyed(f)) do keys[r] = key end
    return keys
end

-- What the windows are made of: each child (its key on the parent, or its
-- global name), shown, protected, size, and its own children two levels
-- down. Open each window once before (they load on first use).
local function children(f: Frame, depth: number, out: string[], prefix: string)
    if depth > 3 then return end
    local keys = keysOf(f)
    for _, c in ipairs(wf.children(f)) do
        if #out >= 400 then return end
        local name = c:GetName() or keys[c] or "?"
        local fs = labelOf(c)
        local text = fs and (" \"" .. show(fs:GetText()) .. "\"") or ""
        out[#out + 1] = ("%s%s [%s] shown=%s prot=%s %dx%d%s"):format(prefix, name, c:GetObjectType(), show(c:IsShown()),
            show((c:IsProtected())), math.floor(c:GetWidth() or 0), math.floor(c:GetHeight() or 0), text)
        children(c, depth + 1, out, prefix .. "  ")
    end
end

export function frames()
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S") }
    DB.probe.socialFrames = store
    for _, addon in ipairs({ "Blizzard_Communities", "Blizzard_GuildUI", "Blizzard_RaidUI", "Blizzard_LookingForGroupUI" }) do
        pcall(C_AddOns.LoadAddOn, addon)
    end
    for _, name in ipairs({ "FriendsFrame", "RaidFrame", "CommunitiesFrame", "LFGParentFrame", "LFGBrowseFrame",
                            "LFGListingFrame", "WhoFrame" }) do
        local f = wf.find(name)
        local out: string[] = {}
        if f then children(f, 1, out, "") end
        store[name] = f and out or "missing"
    end
    -- the functions that open them
    local openers: { [string]: string } = {}
    store.openers = openers
    for _, fn in ipairs({ "ToggleFriendsFrame", "ToggleGuildFrame", "ToggleCommunitiesFrame", "ToggleLFGParentFrame",
                          "ToggleRaidFrame", "FriendsFrame_ShowSubFrame", "ToggleLFDParentFrame", "PVEFrame_ToggleFrame" }) do
        openers[fn] = type(tbl.field(_G, fn))
    end
    print("Social frames probe: saved; /reload.")
end

-- Every shown frame whose global name has one of `words`: "Name [Type]".
local function shownNamed(match: (name: string) -> boolean): string[]
    local named: string[] = {}
    for k, v in pairs(_G) do
        local f = type(k) == "string" and match(k) and wf.asRegion(v)
        if type(k) == "string" and f then
            local ok, shown = pcall(f.IsShown, f)
            if ok and shown then named[#named + 1] = k .. " [" .. f:GetObjectType() .. "]" end
        end
    end
    table.sort(named)
    return named
end

-- What's under the mouse, and every shown frame named like a social one:
-- for windows that aren't the ones probed before (Forever's own friends
-- window). Hover the window, then run it.
export function mouse()
    local chain: string[], tree: string[] = {}, {}
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S"), chain = chain, tree = tree }
    DB.probe.socialMouse = store
    local top: Frame? = nil
    local f = wf.asRegion(GetMouseFoci()[1])
    local guard = 0
    while f and guard < 20 do
        local name = f:GetName() or "?"
        chain[#chain + 1] = ("%s [%s] prot=%s %dx%d"):format(name, f:GetObjectType(),
            show((f:IsProtected())), math.floor(f:GetWidth() or 0), math.floor(f:GetHeight() or 0))
        local frame = wf.asFrame(f)
        if frame and frame:GetName() then top = frame end
        local parent = f:GetParent()
        f = parent
        if parent == UIParent then break end
        guard = guard + 1
    end
    store.named = shownNamed(function(k: string): boolean
        return (k:find("Friend") or k:find("Social") or k:find("Contact")) ~= nil
    end)
    -- the topmost named frame under the mouse: what it's made of
    local topName = top and top:GetName()
    if top then
        store.top = topName
        children(top, 1, tree, "")
    end
    print(("Mouse probe: %s under the mouse; /reload."):format(tostring(topName)))
end

-- Recent Allies and Friend Requests: what their APIs give.
export function lists()
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S") }
    DB.probe.socialLists = store
    local ra = tbl.field(_G, "C_RecentAllies")
    store.recentApi = namesIn(ra)
    store.recentEnabled = call(tbl.field(ra, "IsSystemEnabled"))
    store.recentReady = call(tbl.field(ra, "IsRecentAllyDataReady"))
    -- (TryRequestRecentAlliesData is protected: an addon's call is blocked)
    local list = tbl.list((raw(tbl.field(ra, "GetRecentAllies"))))
    local recentCount = #list
    store.recentCount = recentCount
    local recent: string[] = {}
    store.recent = recent
    for i, a in ipairs(list) do
        if i > 4 then break end
        recent[i] = show(a, 0)
        store["interactions" .. i] = show(tbl.field(a, "interactionData", "interactions"), -2)
    end
    local invites = call(BNGetNumFriendInvites)
    store.invites = { count = invites, first = call(BNGetFriendInviteInfo, 1),
                      accept = type(BNAcceptFriendInvite), decline = type(BNDeclineFriendInvite),
                      cbn = call(tbl.field(C_BattleNet, "GetFriendInviteInfo"), 1) }
    -- the lists' own frames: what their rows hold (the first row's keys)
    local f = wf.find("SocialUIFrame")
    for _, key in ipairs({ "RecentAlliesList", "FriendRequestsList" }) do
        local lst = wf.asFrame(tbl.field(f, key))
        local target = wf.asFrame(tbl.field(lst, "ScrollBox", "ScrollTarget"))
        local first = target and wf.children(target)[1]
        store[key] = { shown = show(lst and lst:IsShown()), rowKeys = fieldsOf(first) }
    end
    -- the side buttons: their fields (which page each opens)
    local side: string[] = {}
    store.sideButtons = side
    if f then
        for _, c in ipairs(wf.children(f)) do
            if c:GetObjectType() == "Button" and not c:GetName() and math.abs((c:GetWidth() or 0) - 54) < 3 then
                side[#side + 1] = ("top=%d %s"):format(math.floor(c:GetTop() or 0), table.concat(fieldsOf(c, true), " "))
            end
        end
    end
    print(("Lists probe: %d recent allies, %s friend requests; /reload."):format(recentCount, invites))
end

-- How Forever adds a friend: which systems are on, and which function the
-- game's own windows call when you add one (watched until /reload). SuuUI's
-- social pages step aside meanwhile, so the game's own lists can be used.
local watching = false
export function friendSystem()
    local calls: string[] = {}
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S"), calls = calls }
    DB.probe.friendSystem = store
    local legacy = call(tbl.field(C_FriendList, "IsLegacyFriendSystemEnabled"))
    local titleFriends = call(tbl.field(C_BattleNet, "AreTitleFriendsEnabled"))
    store.legacy, store.titleFriends = legacy, titleFriends
    store.bnetList = call(tbl.field(C_BattleNet, "IsBattleNetFriendsListEnabled"))
    store.bnetSupported = call(tbl.field(C_BattleNet, "IsBattleNetFriendsListSupported"))
    store.customNames = call(tbl.field(C_BattleNet, "AreTitleFriendCustomNamesEnabled"))
    if not watching then
        watching = true
        local function watch(owner: unknown, tname: string, fname: string)
            if type(owner) == "table" and type(tbl.field(owner, fname)) == "function" then
                hook(owner, fname, function(...)
                    local args: string[] = {}
                    for i = 1, math.min(6, select("#", ...)) do args[i] = show((select(i, ...))) end
                    local saved = tbl.listAt(tbl.recordAt(DB.probe, "friendSystem"), "calls")
                    if #saved < 30 then saved[#saved + 1] = date("%H:%M:%S") .. " " .. tname .. "." .. fname .. "(" .. table.concat(args, ", ") .. ")" end
                end)
            end
        end
        for _, fn in ipairs({ "AddFriend", "AddOrRemoveFriend", "SetFriendNotes" }) do watch(C_FriendList, "C_FriendList", fn) end
        for _, fn in ipairs({ "SendTitleFriendInviteByName", "SendVerifiedBattleNetFriendInvite", "BNCheckTitleFriendInviteToUnit",
                              "BNCheckBattleTagInviteToRecentAlly", "InviteFriend", "SetCustomTitleFriendName" }) do
            watch(C_BattleNet, "C_BattleNet", fn)
        end
        for _, fn in ipairs({ "SendTitleFriendRequest", "SendBattleTagFriendRequest" }) do watch(C_Club, "C_Club", fn) end
        for _, fn in ipairs({ "BNSendFriendInvite", "BNSendFriendInviteByID", "BNSendVerifiedBattleNetFriendInvite" }) do watch(_G, "_G", fn) end
    end
    socialBlizzard = true
    local social = modules.get("social")
    local follow = tbl.field(social, "Follow")
    if type(follow) == "function" then follow(social) end
    print(("Friend system: legacy friends %s, title friends %s. SuuUI's social pages step aside until /reload: add a friend with the game's own window (your alt is a safe test), then /reload."):format(
        legacy, titleFriends))
end

-- Guild control: the ranks and their permissions, and whether an addon may
-- change them. Every write puts back what's already there (nothing
-- changes); blocked or forbidden calls are caught by their events.
export function guildControl()
    local ranks: Record[], blocked: string[], writes: string[] = {}, {}, {}
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S"), ranks = ranks, blocked = blocked, writes = writes }
    DB.probe.guildControl = store
    if not IsInGuild() then print("Guild control probe: not in a guild.") return end
    pcall(C_AddOns.LoadAddOn, "Blizzard_GuildControlUI")
    store.leader = call(IsGuildLeader)
    -- the functions there are
    local fns: string[] = {}
    for k, v in pairs(_G) do
        if type(k) == "string" and type(v) == "function" and (k:find("^GuildControl") or k:find("^GuildSet") or k:find("Rank") and k:find("Guild")) then
            fns[#fns + 1] = k
        end
    end
    table.sort(fns)
    store.globals = fns
    store.guildInfoApi = namesIn(C_GuildInfo)
    -- the flags' labels
    local labels: string[] = {}
    store.labels = labels
    for i = 1, 25 do
        local label = tbl.field(_G, "GUILDCONTROL_OPTION" .. i)
        if label then labels[#labels + 1] = i .. "=" .. tostring(label) end
    end
    -- the ranks and their flags
    local n = count((raw(GuildControlGetNumRanks)))
    store.numRanks = n
    local setRank = tbl.field(_G, "GuildControlSetRank")
    local rankFlags = tbl.field(_G, "GuildControlGetRankFlags")
    for i = 1, n do
        local name = (raw(GuildControlGetRankName, i))
        raw(setRank, i)
        ranks[i] = { name = show(name), flags = call(rankFlags),
                     byOrder = call(tbl.field(C_GuildInfo, "GuildControlGetRankFlags"), i) }
    end
    -- the writes, each putting back what's there; the game's verdict comes
    -- as an event
    local listener = CreateFrame("Frame")
    listener:RegisterEvent("ADDON_ACTION_FORBIDDEN")
    listener:RegisterEvent("ADDON_ACTION_BLOCKED")
    local current: string? = nil
    listener:SetScript("OnEvent", function(_, event, addon: unknown, fn: unknown)
        blocked[#blocked + 1] = event .. " " .. tostring(fn) .. " during " .. tostring(current)
    end)
    local function try(label: string, fn: unknown, ...: unknown)
        current = label
        if type(fn) ~= "function" then return end
        local ok, err = pcall(fn, ...)
        writes[#writes + 1] = label .. ": " .. (ok and "called" or ("error " .. tostring(err):sub(1, 120)))
    end
    if n > 1 and type(setRank) == "function" then
        local lowest = n
        local name = (raw(GuildControlGetRankName, lowest))
        try("GuildControlSetRank", setRank, lowest)
        local flag = (raw(rankFlags))
        local setFlag = tbl.field(_G, "GuildControlSetRankFlag")
        if setFlag and flag ~= nil then
            try("GuildControlSetRankFlag(1, same)", setFlag, 1, flag and true or false)
        end
        local saveRank = tbl.field(_G, "GuildControlSaveRank")
        if saveRank and name then try("GuildControlSaveRank(same name)", saveRank, name) end
    end
    local motd = (raw(GetGuildRosterMOTD))
    if motd then try("C_GuildInfo.SetMOTD(same)", tbl.field(C_GuildInfo, "SetMOTD"), motd) end
    local info = (raw(GetGuildInfoText))
    if info then try("C_GuildInfo.SetInfoText(same)", tbl.field(C_GuildInfo, "SetInfoText"), info) end
    after(2, function() listener:UnregisterAllEvents() end)
    print(("Guild control probe: %d ranks; writes tried, blocked ones recorded. /reload in a few seconds."):format(n))
end

-- Blizzard's guild control window: every frame and text in it, with its
-- anchor, so the parts that run into each other can be moved apart. Open
-- the Settings tab on the page to look at (Rank Permissions) first.
-- (each part's key on its parent, for anchors to parts without a name)
local probeKeys: { [Region]: string } = tbl.weakKeys()

local function anchorOf(r: Region): string
    local ok, point, rel, relPoint, x, y = pcall(r.GetPoint, r, 1)
    if not ok or not point then return "" end
    local relName = rel and (rel:GetName() or probeKeys[rel] or "?") or "nil"
    return (" @%s>%s.%s %d,%d"):format(tostring(point), tostring(relName), tostring(relPoint), math.floor(x or 0), math.floor(y or 0))
end

local function tree(f: Frame, depth: number, out: string[], prefix: string, textures: boolean?)
    if depth > 6 or #out >= 600 then return end
    local keys = keysOf(f)
    if textures then
        for _, r in ipairs(wf.textures(f)) do
            local okA, atlas = pcall(r.GetAtlas, r)
            local okT, file = pcall(r.GetTexture, r)
            out[#out + 1] = ("%s. %s [Tex] shown=%s a=%.2f %dx%d%s atlas=%s file=%s"):format(prefix, r:GetName() or keys[r] or "?",
                show(r:IsShown()), r:GetAlpha() or 0, math.floor(r:GetWidth() or 0), math.floor(r:GetHeight() or 0), anchorOf(r),
                tostring(okA and atlas or nil), tostring(okT and file or nil))
        end
    end
    for _, r in ipairs(wf.fontStrings(f)) do
        probeKeys[r] = keys[r]
        out[#out + 1] = ("%s. %s [FS] shown=%s %dx%d%s \"%s\""):format(prefix, r:GetName() or keys[r] or "?", show(r:IsShown()),
            math.floor(r:GetWidth() or 0), math.floor(r:GetHeight() or 0), anchorOf(r), show(r:GetText()))
    end
    for _, c in ipairs(wf.children(f)) do
        probeKeys[c] = keys[c]
        local fs = labelOf(c)
        local text = fs and (" \"" .. show(fs:GetText()) .. "\"") or ""
        out[#out + 1] = ("%s%s [%s] shown=%s %dx%d%s%s"):format(prefix, c:GetName() or keys[c] or "?", c:GetObjectType(),
            show(c:IsShown()), math.floor(c:GetWidth() or 0), math.floor(c:GetHeight() or 0), anchorOf(c), text)
        tree(c, depth + 1, out, prefix .. "  ", textures)
    end
end

-- One page of the guild control window: when, its tree, the frames it shows outside itself.
type GuildPage = { at: string, tree: string[], shownNamed: string[] }

export function guildUI()
    pcall(C_AddOns.LoadAddOn, "Blizzard_GuildControlUI")
    local ui = wf.find("GuildControlUI")
    if not ui then print("Guild UI probe: no GuildControlUI.") return end
    -- one dump per page, kept across runs: open each page and run it again
    local store = DB.probeData("guildUI", function(): { at: string, pages: { [string]: GuildPage } } return { at = "", pages = {} } end)
    local at = date("%Y-%m-%d %H:%M:%S")
    store.at = at
    local cur = wf.asFrame(tbl.field(ui, "currFrame"))
    local key = cur and cur:GetName() or "?"
    local out: string[] = {}
    -- frames the page shows outside itself (a purchase prompt, a popup)
    local named = shownNamed(function(k: string): boolean
        return (k:find("^GuildControl") or k:find("^GuildBank")) ~= nil
    end)
    if cur then tree(cur, 1, out, "", true) end
    store.pages[key] = { at = at, tree = out, shownNamed = named }
    print(("Guild UI probe: %s, %d lines saved; /reload."):format(key, #out))
end

-- The menu a Blizzard dropdown opens (the guild control's Page and Rank):
-- what it's made of, to restyle it. Run it, then open one of them.
export function menu()
    local eventRegistry: string[] = {}
    local opened: Record[] = {}
    local api: Record = { eventRegistry = eventRegistry }
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S"), api = api, opened = opened }
    DB.probe.blizzMenu = store
    api.Menu = Menu and namesIn(Menu) or "missing"
    local manager = (raw(tbl.field(Menu, "GetManager")))
    api.manager = manager ~= nil and namesIn(manager) or "missing"
    local dropdownEvents = tbl.field(_G, "DropdownButtonMixin", "Event")
    api.events = dropdownEvents ~= nil and namesIn(dropdownEvents) or "missing"
    local function dump(label: string, value: unknown)
        local m = wf.asFrame(value)
        if not m then return end
        local out: string[] = {}
        out[#out + 1] = ("%s [%s] %dx%d strata=%s"):format(m:GetName() or "?", m:GetObjectType(),
            math.floor(m:GetWidth() or 0), math.floor(m:GetHeight() or 0), tostring(m:GetFrameStrata()))
        local keys: string[] = {}
        if type(value) == "table" then
            for k, v in pairs(value) do keys[#keys + 1] = tostring(k) .. "=" .. type(v) end
        end
        table.sort(keys)
        opened[#opened + 1] = { label = label, tree = out, keys = keys }
        tree(m, 1, out, "  ", true)
    end
    local n = 0
    local event = tbl.field(dropdownEvents, "OnMenuOpen")
    for _, name in ipairs({ "GuildControlUINavigationDropdown", "GuildControlUIRankSettingsFrameRankDropdown",
                            "GuildControlUIRankBankFrameRankDropdown" }) do
        local dd = wf.find(name)
        local register = tbl.field(dd, "RegisterCallback")
        if dd and type(register) == "function" and event ~= nil then
            n = n + 1
            register(dd, event, function(_: unknown, ...: unknown)
                local args = { ... }
                for i, a in ipairs(args) do
                    local r = wf.asRegion(a)
                    eventRegistry[#eventRegistry + 1] = ("%s arg%d %s"):format(name, i,
                        r and r:GetObjectType() or type(a))
                end
                after(0.1, function()
                    for i, a in ipairs(args) do
                        if a ~= dd then dump(name .. " arg" .. i, a) end
                    end
                    local open = (raw(tbl.field(manager, "GetOpenMenu"), manager))
                    if open ~= nil then dump(name .. " GetOpenMenu", open) end
                    print("Menu probe: saved; /reload.")
                end)
            end, store)
        end
    end
    print(("Menu probe: armed on %d dropdowns. Open the Settings tab's Page or Rank dropdown."):format(n))
end

-- Your own name as the roster shows it ("Name", without the realm).
local function myShortName(): string
    return Ambiguate(asString(SuuUI.FullName("player")) or "", "short")
end

-- Guild notes: C_GuildInfo.SetNote is restricted (HasRestrictions in the
-- game's API docs). Can a secure button's macro save one through /run?
-- The probe puts a button in the middle of the screen; a click saves your
-- own public note unchanged, and the game's verdict (blocked or not) is
-- recorded. The old note functions are looked up too.
export function notes()
    local blocked: string[] = {}
    local legacy: { [string]: string } = {}
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S"), blocked = blocked, legacy = legacy }
    DB.probe.guildNotes = store
    for _, fn in ipairs({ "GuildRosterSetPublicNote", "GuildRosterSetOfficerNote", "SetGuildRosterSelection", "GetGuildRosterSelection" }) do
        legacy[fn] = type(tbl.field(_G, fn))
    end
    if InCombatLockdown() then print("Notes probe: out of combat, please.") return end
    -- you in the roster, by name (as the roster finds you); every step caught
    local guid: unknown, note: unknown = nil, nil
    local ok, err = pcall(function()
        local me = myShortName()
        -- the game's values as they are (this file's call() formats them as text)
        for i = 1, (GetNumGuildMembers()) or 0 do
            local r = { GetGuildRosterInfo(i) }
            local name = asString(r[1])
            if name and Ambiguate(name, "short") == me then
                note, guid = r[7], r[17]
                break
            end
        end
    end)
    store.find = ok and "ok" or tostring(err)
    local guidSecret = guid ~= nil and isSecret(guid)
    local noteSecret = note ~= nil and isSecret(note)
    store.guidSecret, store.noteSecret = guidSecret, noteSecret
    if type(guid) ~= "string" or guidSecret then
        print("Notes probe: couldn't read your guild GUID (saved); /reload.")
        return
    end
    -- an unreadable note is never overwritten: stop instead
    if noteSecret then print("Notes probe: your note is a secret value (saved); /reload.") return end
    local text = type(note) == "string" and note or ""
    store.note = text
    text = text:gsub("\\", "\\\\"):gsub("\"", "\\\"")
    local b = notesButton or CreateFrame("Button", nil, UIParent, "SecureActionButtonTemplate, UIPanelButtonTemplate")
    notesButton = b
    b:SetSize(260, 30)
    b:ClearAllPoints()
    b:SetPoint("CENTER", UIParent, "CENTER", 0, 120)
    b:SetFrameStrata("DIALOG")
    b:SetText("Notes probe: click to save your note")
    b:RegisterForClicks("LeftButtonUp", "LeftButtonDown")
    b:SetAttribute("type1", "macro")
    b:SetAttribute("macrotext1", ('/run C_GuildInfo.SetNote("%s", "%s", true)'):format(guid, text))
    store.macro = b:GetAttribute("macrotext1")
    local listener = CreateFrame("Frame")
    listener:RegisterEvent("ADDON_ACTION_BLOCKED")
    listener:RegisterEvent("ADDON_ACTION_FORBIDDEN")
    listener:RegisterEvent("MACRO_ACTION_BLOCKED")
    listener:RegisterEvent("MACRO_ACTION_FORBIDDEN")
    listener:SetScript("OnEvent", function(_, event, a1: unknown, a2: unknown)
        blocked[#blocked + 1] = event .. " " .. tostring(a1) .. " " .. tostring(a2)
    end)
    b:SetScript("PostClick", function(self)
        store.clicked = date("%H:%M:%S")
        after(1, function()
            listener:UnregisterAllEvents()
            self:Hide()
            print(("Notes probe: %s; /reload."):format(#blocked > 0 and "blocked" or "not blocked"))
        end)
    end)
    b:Show()
    print("Notes probe: click the button in the middle of the screen once.")
end

-- Guild notes through the game's own member list (asked for: try it): the
-- list made tall enough for everyone (under SuuUI's roster), its rows' data
-- checked for taint, a secure button that clicks your row, then the game's
-- member panel brought forward: click your Note there and Accept it
-- unchanged. Every step's verdict is saved. Open Guild > Roster first.
local function secure(t: unknown, key: string): string
    if type(t) ~= "table" then return "?" end
    local ok, by = issecurevariable(t, key)
    return ok and "secure" or ("tainted by " .. tostring(by))
end

export function noteList()
    local rowsSeen: string[], blocked: string[], steps: string[] = {}, {}, {}
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S"), rows = rowsSeen, blocked = blocked, steps = steps }
    DB.probe.guildNoteList = store
    local f = wf.find("CommunitiesFrame")
    local list = wf.asFrame(tbl.field(f, "MemberList"))
    local box = tbl.field(list, "ScrollBox")
    if not (f and f:IsShown() and list and box) then print("Note list probe: open Guild > Roster first.") return end
    if InCombatLockdown() then print("Note list probe: out of combat, please.") return end
    store.selectedClubId = secure(f, "selectedClubId")
    store.mode = tostring((raw(tbl.field(f, "GetDisplayMode"), f)))
    -- tall enough for everyone, where it is
    local n = (GetNumGuildMembers()) or 0
    local listTop, frameTop = list:GetTop(), f:GetTop()
    local top = listTop and frameTop and (listTop - frameTop) or -60
    list:ClearAllPoints()
    list:SetPoint("TOPLEFT", f, "TOPLEFT", 20, top)
    list:SetSize(math.max(300, list:GetWidth() or 300), n * 22 + 60)
    steps[#steps + 1] = "list made " .. (n * 22 + 60) .. "px tall for " .. n
    local listener = CreateFrame("Frame")
    for _, e in ipairs({ "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN" }) do listener:RegisterEvent(e) end
    listener:SetScript("OnEvent", function(_, event, a1: unknown, a2: unknown)
        blocked[#blocked + 1] = date("%H:%M:%S ") .. event .. " " .. tostring(a1) .. " " .. tostring(a2)
    end)
    after(1, function()
        local me = myShortName()
        local mine: Frame? = nil
        for _, row in ipairs(wf.rows(box)) do
            local name = asString(tbl.field(row, "memberInfo", "name"))
            rowsSeen[#rowsSeen + 1] = ("%s memberInfo=%s"):format(tostring(name), secure(row, "memberInfo"))
            if name and Ambiguate(name, "short") == me then mine = row end
        end
        steps[#steps + 1] = #rowsSeen .. " rows exist"
        if not mine then print("Note list probe: your row isn't there (saved); /reload.") return end
        local b = noteListButton or CreateFrame("Button", nil, UIParent, "SecureActionButtonTemplate, UIPanelButtonTemplate")
        noteListButton = b
        b:SetSize(300, 30)
        b:ClearAllPoints()
        b:SetPoint("CENTER", UIParent, "CENTER", 0, 160)
        b:SetFrameStrata("FULLSCREEN_DIALOG")
        b:SetText("Note list probe: click to pick yourself")
        b:RegisterForClicks("LeftButtonUp", "LeftButtonDown")
        b:SetAttribute("type1", "click")
        b:SetAttribute("clickbutton1", mine)
        b:SetScript("PostClick", function(self)
            after(0.3, function()
                self:Hide()
                local d = wf.asFrame(tbl.field(f, "GuildMemberDetailFrame"))
                local nameText = wf.asFontString(tbl.field(d, "Name"))
                steps[#steps + 1] = ("detail shown=%s name=%s clubId=%s memberId=%s"):format(
                    tostring(d and d:IsShown()), tostring(nameText and nameText:GetText()),
                    secure(d, "clubId"), secure(d, "memberId"))
                if not (d and d:IsShown()) then print("Note list probe: the game's panel didn't open (saved); /reload.") return end
                -- the game's own panel in front of everything
                d:SetFrameStrata("FULLSCREEN_DIALOG")
                d:SetAlpha(1)
                d:ClearAllPoints()
                d:SetPoint("CENTER", UIParent, "CENTER", 0, 0)
                print("Note list probe: now click your Note in the game's panel and press Accept without changing it; then /reload.")
            end)
        end)
        b:Show()
        print("Note list probe: click the button at the top of the screen.")
    end)
end

-- The game's member list as SuuUI's notes use it: where it is, how big,
-- shown or not, its offline setting, how many members its data has and how
-- many rows it made, and the game's member panel. Select a member in the
-- roster first.
export function rows()
    local rowsSeen: string[] = {}
    local store: Record = { at = date("%Y-%m-%d %H:%M:%S"), rows = rowsSeen }
    DB.probe.guildRows = store
    local f = wf.find("CommunitiesFrame")
    local list = wf.asFrame(tbl.field(f, "MemberList"))
    if not list then print("Rows probe: open the Guild window first.") return end
    local p1, rel, p2, x, y = list:GetPoint(1)
    store.list = ("shown=%s visible=%s alpha=%.2f %dx%d at %s>%s.%s %d,%d"):format(tostring(list:IsShown()), tostring(list:IsVisible()),
        list:GetAlpha() or 0, math.floor(list:GetWidth() or 0), math.floor(list:GetHeight() or 0), tostring(p1),
        tostring(rel and (rel:GetName() or "?")), tostring(p2), math.floor(x or 0), math.floor(y or 0))
    local box = wf.asFrame(tbl.field(list, "ScrollBox"))
    store.box = box and ("shown=%s visible=%s %dx%d"):format(tostring(box:IsShown()), tostring(box:IsVisible()),
        math.floor(box:GetWidth() or 0), math.floor(box:GetHeight() or 0)) or "none"
    store.cvar = tostring(GetCVar("communitiesShowOffline"))
    store.showOffline = tostring(tbl.field(list, "showOfflinePlayers"))
    store.expanded = tostring(tbl.field(list, "expandedDisplay"))
    store.mode = tostring((raw(tbl.field(f, "GetDisplayMode"), f)))
    local dp = (raw(tbl.field(box, "GetDataProvider"), box))
    local data = (raw(tbl.field(dp, "GetSize"), dp)) or "none"
    store.data = data
    for _, row in ipairs(wf.rows(box)) do
        rowsSeen[#rowsSeen + 1] = tostring(tbl.field(row, "memberInfo", "name")) .. (row:IsShown() and "" or " (hidden)")
    end
    local d = wf.asFrame(tbl.field(f, "GuildMemberDetailFrame"))
    local info = (raw(tbl.field(d, "GetMemberInfo"), d))
    store.detail = d and ("shown=%s member=%s"):format(tostring(d:IsShown()), tostring(tbl.field(info, "name"))) or "none"
    local members = (GetNumGuildMembers())
    store.members = members
    print(("Rows probe: %s rows of %s in the data, %s members; /reload."):format(#rowsSeen, tostring(data), tostring(members)))
end

export function command(rest: string?)
    if rest == "names" then names() return end
    if rest == "guildcontrol" then guildControl() return end
    if rest == "guildui" then guildUI() return end
    if rest == "menu" then menu() return end
    if rest == "notes" then notes() return end
    if rest == "notelist" then noteList() return end
    if rest == "rows" then rows() return end
    if rest == "friends" then friendSystem() return end
    if rest == "lists" then lists() return end
    if rest == "mouse" then mouse() return end
    if rest == "frames" then frames() return end
    -- the roster asked for first: it's often empty until then
    local roster = tbl.field(C_GuildInfo, "GuildRoster") or tbl.field(_G, "GuildRoster")
    raw(roster)
    local store = sample()
    listen(store)
    search(store)
    -- again once the roster has come in
    after(3, function() sample() end)
    print(("Social probe: %s friends, %s Battle.net friends, guild members %s. Listening for online/offline for ten minutes; /reload after."):format(
        store.friends.count, store.bnet.count, store.guild.members))
end
