-- Diagnostics/PowerProbe.wowlua
-- "/suu probe power" (asked 2026-10-19: the Cooldown Manager's resource bar
-- with combo points over the cast bar, design B): what the game tells about
-- your power, in and out of combat.
--   now, 2 s into each fight (up to 6) and at the first combo point change
--   of each fight: UnitPowerType (both returns), UnitPower, UnitPowerMax and
--          UnitPowerPercent, secret.readable and for Mana, Rage, Energy and Combo
--          points; GetComboPoints("player", "target"); and whether a
--          StatusBar takes the combo points (five hidden bars, bar i at
--          SetMinMaxValues(i - 1, i), as pips would be; SetValue in a pcall,
--          GetValue read back) and the energy (0 to UnitPowerMax)
--   then (this session, by itself): UNIT_POWER_FREQUENT and
--          UNIT_POWER_UPDATE for you (how many, the most in one second, by
--          power token, their arguments), UNIT_MAXPOWER, UNIT_DISPLAYPOWER,
--          PLAYER_TARGET_CHANGED; the time between power events per token
--          (energy ticks every ~2 s: a rhythm may show from the timing
--          alone, without reading the amount), with the amount when it reads
--          secret.readable; your casts (UNIT_SPELLCAST_SUCCEEDED) with
--          C_Spell.GetSpellPowerCost, and for mana the seconds since your
--          last cast at each power event (the five-second rule); form changes
--          (UPDATE_SHAPESHIFT_FORM): whether UnitPowerType reads in combat
-- Saved in SuuUIProbe.power on /reload. Values the game hides read SECRET.

import after from "wowlua:timer"
import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"

-- Every value at one moment, and the StatusBar test.
type Snapshot = { at: string, what: string, combat: string, powerType: string, form: string, plain: string,
                  types: string[], comboPoints: string, bars: string[] }
-- A power token's timing: the gaps between its events, and how often each gap came.
type Timing = { intervals: string[], histogram: { [string]: number } }
type Events = { counts: { [string]: number }, byToken: { [string]: number }, args: { [string]: string[] },
                maxPerSecond: { [string]: number }, seconds?: string }
type Fight = { started: string, ended?: string, twoSeconds?: Snapshot, comboSeen?: boolean, combo?: Snapshot }
-- What the probe saves in SuuUIProbe.power.
type Out = { now?: Snapshot, session?: string, events: Events, timing: { [string]: Timing }, forms: string[],
             casts: string[], fights: Fight[] }

local function show(v: unknown): string
    if secret.isSecret(v) then return "SECRET" end
    if type(v) == "number" and v ~= math.floor(v) then return ("%.3f"):format(v) end
    return tostring(v)
end

-- A function that may not exist, may error or may answer secret.
local function call(fn: unknown, ...: unknown): (unknown, unknown, unknown, unknown)
    if type(fn) ~= "function" then return "missing", nil, nil, nil end
    local ok, a, b, c, d = pcall(fn, ...)
    if not ok then return "error: " .. tostring(a):sub(1, 120), nil, nil, nil end
    return a, b, c, d
end

-- `fn(...)` protected, with values as the game gave them (secret ones too).
local function attempt(fn: unknown, ...: unknown): (boolean, unknown)
    if type(fn) ~= "function" then return false, "missing" end
    return pcall(fn, ...)
end

local function fresh(): Out
    return { events = { counts = {}, byToken = {}, args = {}, maxPerSecond = {} }, timing = {}, forms = {}, casts = {}, fights = {} }
end

local function out(): Out
    return DB.probeData("power", fresh)
end

local function push<T>(list: T[], line: T, cap: number?)
    if #list < (cap or 60) then list[#list + 1] = line end
end

local PT = Enum.PowerType
local TYPES = {
    { name = "Mana", id = PT.Mana },
    { name = "Rage", id = PT.Rage },
    { name = "Energy", id = PT.Energy },
    { name = "ComboPoints", id = PT.ComboPoints },
}
local COMBO = PT.ComboPoints
local ENERGY = PT.Energy

--------------------------------------------------------------------------------
-- A snapshot of every value, and the StatusBar test
--------------------------------------------------------------------------------

local bars: StatusBar[] = {}
local function testBars(): string[]
    if #bars == 0 then
        for i = 1, 6 do
            local b = CreateFrame("StatusBar", nil, UIParent)
            b:SetSize(10, 10)
            b:Hide()
            bars[i] = b
        end
    end
    local res: string[] = {}
    -- the combo points as five pips: bar i is full from i points on
    local sources: { label: string, value: unknown }[] = {
        { label = "UnitPower(ComboPoints)", value = (call(UnitPower, "player", COMBO)) },
        { label = "GetComboPoints", value = (call(GetComboPoints, "player", "target")) },
    }
    for _, src in ipairs(sources) do
        local value = src.value
        local pips: string[] = {}
        for i = 1, 5 do
            local b = bars[i]
            b:SetMinMaxValues(i - 1, i)
            local ok, err = attempt(b.SetValue, b, value)
            local back = b:GetValue()
            pips[i] = ok and ("ok, reads %s"):format(show(back)) or ("error: " .. tostring(err):sub(1, 80))
        end
        res[#res + 1] = ("%s = %s → pips: %s"):format(src.label, show(value), table.concat(pips, " | "))
    end
    -- the energy bar: 0 to its max, both as the game gives them
    local b = bars[6]
    local max, now = (call(UnitPowerMax, "player", ENERGY)), (call(UnitPower, "player", ENERGY))
    local okMax, errMax = attempt(b.SetMinMaxValues, b, 0, max)
    local okValue, errValue = attempt(b.SetValue, b, now)
    res[#res + 1] = ("energy bar: SetMinMaxValues(0, %s) %s, SetValue(%s) %s, reads %s"):format(show(max),
        okMax and "ok" or ("error: " .. tostring(errMax):sub(1, 80)), show(now),
        okValue and "ok" or ("error: " .. tostring(errValue):sub(1, 80)), show(b:GetValue()))
    return res
end

local function snapshot(label: string): Snapshot
    local pType, pToken = call(UnitPowerType, "player")
    local types: string[] = {}
    for _, t in ipairs(TYPES) do
        types[#types + 1] = ("%s (%d): UnitPower %s, UnitPowerMax %s, UnitPowerPercent %s"):format(t.name, t.id,
            show((call(UnitPower, "player", t.id))), show((call(UnitPowerMax, "player", t.id))),
            show((call(UnitPowerPercent, "player", t.id))))
    end
    return {
        at = date("%H:%M:%S"), what = label, combat = tostring(InCombatLockdown()),
        powerType = ("%s, %s"):format(show(pType), show(pToken)),
        form = show((call(GetShapeshiftForm))),
        plain = ("UnitPower %s, UnitPowerMax %s, UnitPowerPercent %s"):format(show((call(UnitPower, "player"))),
            show((call(UnitPowerMax, "player"))), show((call(UnitPowerPercent, "player")))),
        types = types,
        comboPoints = ("GetComboPoints(player, target) %s; target %s"):format(show((call(GetComboPoints, "player", "target"))),
            show((call(UnitExists, "target")))),
        bars = testBars(),
    }
end

--------------------------------------------------------------------------------
-- The session's events
--------------------------------------------------------------------------------

local start: number = 0
local lastCast: number? = nil
local fight: Fight? = nil
local seconds: { [string]: { second: number, count: number } } = {}      -- [event] = { second = n, count = n }
local lastAt: { [string]: number } = {}       -- [token] = GetTime() of its last power event
local lastAmount: { [string]: number } = {}   -- [token] = the last readable amount

local function rate(e: Events, event: string)
    local now = math.floor(GetTime())
    local s = seconds[event]
    if not s or s.second ~= now then
        s = { second = now, count = 0 }
        seconds[event] = s
    end
    s.count = s.count + 1
    if s.count > (e.maxPerSecond[event] or 0) then e.maxPerSecond[event] = s.count end
end

local TOKEN_TYPE: { [string]: number } = { MANA = PT.Mana, RAGE = PT.Rage, ENERGY = PT.Energy, COMBO_POINTS = COMBO }

local function onPower(o: Out, event: string, token: unknown)
    local e = o.events
    local key = secret.readable(token) and tostring(token) or "SECRET"
    e.byToken[event .. " " .. key] = (e.byToken[event .. " " .. key] or 0) + 1
    -- the timing per token (UNIT_POWER_FREQUENT only, so one event per change)
    if event ~= "UNIT_POWER_FREQUENT" then return end
    local now = GetTime()
    local amount: unknown = nil
    local id = TOKEN_TYPE[key]
    if id then amount = call(UnitPower, "player", id) end
    local amountText = show(amount)
    local delta = ""
    if secret.isNumber(amount) then
        local last = lastAmount[key]
        if last then delta = (" (%+d)"):format(amount - last) end
        lastAmount[key] = amount
    end
    local t: Timing = o.timing[key] or { intervals = {}, histogram = {} }
    o.timing[key] = t
    local lastTime = lastAt[key]
    if lastTime then
        local gap = now - lastTime
        local line = ("%.2f s, amount %s%s, combat %s"):format(gap, amountText, delta, tostring(InCombatLockdown()))
        if key == "MANA" and lastCast then line = line .. (", %.1f s since your last cast"):format(now - lastCast) end
        push(t.intervals, line, 80)
        local bucket = ("%.1f"):format(math.floor(gap * 10 + 0.5) / 10)
        t.histogram[bucket] = (t.histogram[bucket] or 0) + 1
    end
    lastAt[key] = now
    -- the first combo point change of a fight: a full snapshot
    local f = fight
    if key == "COMBO_POINTS" and f and not f.comboSeen then
        f.comboSeen = true
        f.combo = snapshot("the fight's first combo point change")
    end
end

local function costText(spellID: unknown): string
    local costs = call(tbl.field(C_Spell, "GetSpellPowerCost"), spellID)
    if secret.isSecret(costs) then return "SECRET" end
    if type(costs) ~= "table" then return show(costs) end
    local list: string[] = {}
    for _, c in ipairs(tbl.list(costs)) do
        if secret.isSecret(c) then list[#list + 1] = "SECRET" else
            local function f(name: string): string return show(tbl.field(c, name)) end
            list[#list + 1] = ("type %s %s: cost %s, min %s, percent %s, per sec %s"):format(f("type"), f("name"),
                f("cost"), f("minCost"), f("costPercent"), f("costPerSec"))
        end
    end
    return #list > 0 and table.concat(list, " | ") or "no cost"
end

local listening: Frame? = nil
local function listen()
    if listening then return end
    local f = CreateFrame("Frame")
    listening = f
    for _, event in ipairs({ "UNIT_POWER_FREQUENT", "UNIT_POWER_UPDATE", "UNIT_MAXPOWER", "UNIT_DISPLAYPOWER",
                             "UNIT_SPELLCAST_SUCCEEDED" }) do
        pcall(f.RegisterUnitEvent, f, event, "player")
    end
    for _, event in ipairs({ "PLAYER_TARGET_CHANGED", "UPDATE_SHAPESHIFT_FORM", "PLAYER_REGEN_DISABLED",
                             "PLAYER_REGEN_ENABLED" }) do
        pcall(f.RegisterEvent, f, event)
    end
    f:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown, c: unknown)
        local o = out()
        local e = o.events
        e.counts[event] = (e.counts[event] or 0) + 1
        e.seconds = ("%.0f s since the probe began"):format(GetTime() - start)
        rate(e, event)
        local args = e.args[event] or {}
        e.args[event] = args
        if event ~= "UNIT_SPELLCAST_SUCCEEDED" then
            push(args, ("%.1fs %s %s %s"):format(GetTime() - start, show(a), show(b), show(c)), 20)
        end
        if event == "UNIT_POWER_FREQUENT" or event == "UNIT_POWER_UPDATE" then
            onPower(o, event, b)
        elseif event == "UNIT_DISPLAYPOWER" or event == "UPDATE_SHAPESHIFT_FORM" then
            local pType, pToken = call(UnitPowerType, "player")
            push(o.forms, ("%s %s: form %s, UnitPowerType %s, %s, UnitPower %s / %s, combat %s"):format(date("%H:%M:%S"), event,
                show((call(GetShapeshiftForm))), show(pType), show(pToken), show((call(UnitPower, "player"))),
                show((call(UnitPowerMax, "player"))), tostring(InCombatLockdown())), 40)
        elseif event == "UNIT_SPELLCAST_SUCCEEDED" then
            lastCast = GetTime()
            push(o.casts, ("%s %s (spell %s): %s; combat %s"):format(date("%H:%M:%S"), show((call(C_Spell.GetSpellName, c))),
                show(c), costText(c), tostring(InCombatLockdown())), 40)
        elseif event == "PLAYER_REGEN_DISABLED" then
            if #o.fights >= 6 then fight = nil return end
            local mine: Fight = { started = date("%H:%M:%S") }
            fight = mine
            o.fights[#o.fights + 1] = mine
            after(2, function()
                mine.twoSeconds = snapshot("2 s into the fight")
                if #o.fights == 1 then
                    print("Power probe: first fight recorded. A few more (up to 6), then /reload to save it.")
                end
            end)
        elseif event == "PLAYER_REGEN_ENABLED" then
            local f2 = fight
            if f2 then f2.ended = date("%H:%M:%S") end
            fight = nil
        end
    end)
end

export function command(_rest: string?)
    local o = out()
    if not listening then
        -- a new session's records (the last session's go)
        local new = fresh()
        o.events, o.timing, o.forms, o.casts, o.fights = new.events, new.timing, new.forms, new.casts, new.fights
        start = GetTime()
        o.session = date("%Y-%m-%d %H:%M:%S")
    end
    o.now = snapshot("now")
    listen()
    local _, classToken = UnitClass("player")
    local class = secret.asString(classToken)
    local hint: string
    if class == "DRUID" then
        hint = "Fight in cat form (energy, combo points), in bear form (rage) and in caster form (mana), and change forms during a fight."
    elseif class == "ROGUE" then
        hint = "Fight a few mobs with combo point builders and a finisher."
    elseif class == "PALADIN" then
        hint = "Fight a few mobs and cast between them (mana, the five-second rule); combo points stay 0 here, so a druid in cat form shows those."
    else
        hint = "Fight a few mobs."
    end
    print(("Power probe: recorded your power now. %s Up to 6 fights are recorded; then /reload to save it."):format(hint))
end
