-- Diagnostics/ApiDocs.wowlua
-- "/suu probe api [words]": reads the client's own API documentation (what
-- the in-game /api command shows) and saves every system, function, event,
-- table and field whose name matches, with argument and field types, into
-- SuuUIProbe.apiDocs. Default words: aura, candidate, container, filter.
-- Use: find out what the engine really offers (e.g. aura container filter
-- options) instead of guessing from other addons.

import print from "/Core/Init"
import * as DB from "/Core/DB"
import trackerSoundFiles, trackerAuraSounds from "/UI/CooldownTracker"
import after from "wowlua:timer"
import * as tbl from "wowlua:table"
import * as secret from "wowlua:secret"

-- A field of the documentation's tables (nil through anything else).
local field = tbl.field

local DOC_ADDONS = { "Blizzard_APIDocumentationBasic", "Blizzard_APIDocumentation", "Blizzard_APIDocumentationGenerated" }

-- The documentation's systems (nil when it didn't load).
local function load(): unknown[]?
    for _, name in ipairs(DOC_ADDONS) do
        if C_AddOns.DoesAddOnExist(name) and not C_AddOns.IsAddOnLoaded(name) then
            pcall(C_AddOns.LoadAddOn, name)
        end
    end
    local systems = field(_G, "APIDocumentation", "systems")
    if type(systems) ~= "table" then return nil end
    return tbl.list(systems)
end

local function typeText(v: unknown): string
    local t = tostring(field(v, "Type") or "?")
    local inner, mixin = field(v, "InnerType"), field(v, "Mixin")
    if inner then t = t .. "<" .. tostring(inner) .. ">" end
    if mixin then t = t .. "(" .. tostring(mixin) .. ")" end
    if field(v, "Nilable") then t = t .. "?" end
    local default, enumValue = field(v, "Default"), field(v, "EnumValue")
    if default ~= nil then t = t .. " = " .. tostring(default) end
    if enumValue ~= nil then t = t .. " = " .. tostring(enumValue) end
    return t
end

local function fields(list: unknown): string
    local parts: string[] = {}
    for _, v in ipairs(tbl.list(list)) do parts[#parts + 1] = tostring(field(v, "Name")) .. ": " .. typeText(v) end
    return table.concat(parts, ", ")
end

local function matches(name: unknown, words: string[]): boolean
    name = tostring(name or ""):lower()
    for _, w in ipairs(words) do
        if name:find(w, 1, true) then return true end
    end
    return false
end

export function dump(words: string[]): (string[]?, string?)
    local systems = load()
    if not systems then
        return nil, "the client's API documentation didn't load"
    end
    local lines: string[] = {}
    local function add(s: string) lines[#lines + 1] = s end
    for _, sys in ipairs(systems) do
        local name, namespace = field(sys, "Name"), field(sys, "Namespace")
        local sysName = tostring(namespace or name or "?")
        local whole = matches(name, words) or matches(namespace, words)
        local header = false
        local function head()
            if not header then
                header = true
                add(("== %s (%s, %s)"):format(tostring(name), tostring(namespace or "-"), tostring(field(sys, "Type") or "System")))
            end
        end
        for _, f in ipairs(tbl.list(field(sys, "Functions"))) do
            if whole or matches(field(f, "Name"), words) then
                head()
                add(("  fn %s.%s(%s) -> %s"):format(sysName, tostring(field(f, "Name")), fields(field(f, "Arguments")), fields(field(f, "Returns"))))
            end
        end
        for _, e in ipairs(tbl.list(field(sys, "Events"))) do
            local literal = field(e, "LiteralName")
            if whole or matches(field(e, "Name"), words) or matches(literal, words) then
                head()
                add(("  event %s(%s)"):format(tostring(literal or field(e, "Name")), fields(field(e, "Payload"))))
            end
        end
        for _, t in ipairs(tbl.list(field(sys, "Tables"))) do
            if whole or matches(field(t, "Name"), words) then
                head()
                add(("  %s %s { %s }"):format(tostring(field(t, "Type") or "Table"), tostring(field(t, "Name")),
                    fields(field(t, "Fields") or field(t, "Values"))))
            end
        end
    end
    return lines, nil
end

-- What the documentation says of some functions beyond their types: every
-- plain field of each one's entry (HasRestrictions, SecretArguments and the
-- like), keyed by its full name; "not documented" for a name it lacks.
export function flags(names: string[]): ({ [string]: string }?, string?)
    local systems = load()
    if not systems then
        return nil, "the client's API documentation didn't load"
    end
    local found: { [string]: string }, seen: { [string]: boolean } = {}, {}
    for _, sys in ipairs(systems) do
        local namespace = field(sys, "Namespace")
        for _, f in ipairs(tbl.list(field(sys, "Functions"))) do
            for _, want in ipairs(names) do
                if field(f, "Name") == want and type(f) == "table" then
                    local parts: string[] = {}
                    for k, v in pairs(f) do
                        if type(v) ~= "table" and type(v) ~= "function" and k ~= "Name" and k ~= "Type" then
                            parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
                        end
                    end
                    table.sort(parts)
                    found[(namespace and (tostring(namespace) .. ".") or "") .. want] = #parts > 0 and table.concat(parts, "  ") or "no flags"
                    seen[want] = true
                end
            end
        end
    end
    for _, want in ipairs(names) do
        if not seen[want] then found[want] = "not documented" end
    end
    return found, nil
end

--------------------------------------------------------------------------------
-- "/suu probe runtime": what the running client really has, where the
-- documentation is silent: every Enum and global table whose name mentions
-- aura, candidate or filter (with its keys and values), and the methods of a
-- live aura container.
--------------------------------------------------------------------------------

local RUNTIME_WORDS = { "aura", "candidate", "filter" }

local function keysOf(t: table): string
    local out: string[] = {}
    for k, v in pairs(t) do
        out[#out + 1] = tostring(k) .. (type(v) == "function" and "()" or (type(v) == "table" and " {…}" or (" = " .. tostring(v))))
    end
    table.sort(out)
    return table.concat(out, ", ")
end

export function runtime()
    local lines: string[] = {}
    local function add(s: string) lines[#lines + 1] = s end

    -- Enums
    for name, t in pairs(Enum) do
        if type(t) == "table" and matches(name, RUNTIME_WORDS) then add("Enum." .. name .. " { " .. keysOf(t) .. " }") end
    end
    -- global tables and functions (mixins, constants, utilities)
    for name, v in pairs(_G) do
        if type(name) == "string" and matches(name, RUNTIME_WORDS) then
            -- some globals are forbidden objects: reading them errors
            pcall(function()
                if type(v) == "table" and not field(v, "GetObjectType") then
                    add("global table " .. name .. " { " .. keysOf(v) .. " }")
                elseif type(v) == "function" then
                    add("global function " .. name .. "()")
                end
            end)
        end
    end
    -- a live aura container's methods (and its mixin's)
    if not C_AddOns.IsAddOnLoaded("Blizzard_AuraContainer") then pcall(C_AddOns.LoadAddOn, "Blizzard_AuraContainer") end
    local ok, c = pcall(CreateFrame, "AuraContainer", nil, UIParent, "CustomAuraContainerTemplate")
    if ok and c then
        local raw: unknown = c
        local methods: string[] = {}
        if type(raw) == "table" then
            local index = field(getmetatable(raw), "__index")
            if type(index) == "table" then
                for k, v in pairs(index) do if type(v) == "function" then methods[#methods + 1] = tostring(k) end end
            end
            for k, v in pairs(raw) do if type(v) == "function" then methods[#methods + 1] = tostring(k) .. " (mixin)" end end
        end
        table.sort(methods)
        add("AuraContainer methods: " .. table.concat(methods, ", "))
        c:Hide()
    else
        add("AuraContainer: couldn't create one (" .. tostring(c) .. ")")
    end
    -- C_ namespaces with aura in their name: their functions
    for name, v in pairs(_G) do
        if type(name) == "string" and name:find("^C_") and matches(name, { "aura" }) and type(v) == "table" then
            pcall(function() add("namespace " .. name .. " { " .. keysOf(v) .. " }") end)
        end
    end
    table.sort(lines)
    DB.probe.runtime = { at = date("%Y-%m-%d %H:%M"), lines = lines }
    print(("Runtime probe: %d entries saved. /reload to save them."):format(#lines))
end

-- "/suu probe filters": every aura filter word the game knows
-- (AuraUtil.AuraFilters) and whether test filter strings are valid, the
-- negated ones ("!PLAYER": not mine) above all.
local FILTER_TESTS = {
    "HELPFUL", "HARMFUL", "HELPFUL|PLAYER", "HARMFUL|PLAYER",
    "HELPFUL|!PLAYER", "HARMFUL|!PLAYER", "!PLAYER|HARMFUL", "HARMFUL|!RAID",
    "HELPFUL|!CANCELABLE", "HARMFUL|INCLUDE_NAME_PLATE_ONLY", "HELPFUL|EXTERNAL_DEFENSIVE",
    "HARMFUL|CROWD_CONTROL", "HELPFUL|BIG_DEFENSIVE", "HELPFUL|IMPORTANT", "HELPFUL|NOTAFILTER",
}

export function filters()
    local lines: string[] = {}
    local AU = field(_G, "AuraUtil")
    local function dumpTable(name: string, t: unknown, depth: number)
        if type(t) ~= "table" or depth > 2 then return end
        for k, v in pairs(t) do
            if type(v) == "table" then dumpTable(name .. "." .. tostring(k), v, depth + 1)
            elseif type(v) ~= "function" then lines[#lines + 1] = ("%s.%s = %s"):format(name, tostring(k), tostring(v)) end
        end
    end
    dumpTable("AuraUtil.AuraFilters", field(AU, "AuraFilters"), 0)
    lines[#lines + 1] = "AuraUtil.AuraFilterNegationPrefix = " .. tostring(field(AU, "AuraFilterNegationPrefix"))
    local isValid = field(AU, "IsValidFilterString")
    for _, f in ipairs(FILTER_TESTS) do
        local ok, valid = true, "n/a"
        if type(isValid) == "function" then ok, valid = pcall(isValid, f) end
        lines[#lines + 1] = ("valid %-34s %s"):format(f, ok and tostring(valid) or ("error: " .. tostring(valid)))
    end
    -- the same, as the engine sees it: does a container take the group?
    if not C_AddOns.IsAddOnLoaded("Blizzard_AuraContainer") then pcall(C_AddOns.LoadAddOn, "Blizzard_AuraContainer") end
    local ok, c = pcall(CreateFrame, "AuraContainer", nil, UIParent, "CustomAuraContainerTemplate")
    if ok and c then
        for i, f in ipairs({ "HARMFUL|!PLAYER", "HELPFUL|!PLAYER", "HELPFUL|NOTAFILTER" }) do
            local addGroup = field(c, "AddAuraGroup")
            local added, err = false, "no AddAuraGroup"
            if type(addGroup) == "function" then added, err = pcall(addGroup, c, "t" .. i, f, { maxFrameCount = 1 }) end
            lines[#lines + 1] = ("container takes %-24s %s"):format(f, added and "yes" or ("no: " .. tostring(err)))
        end
        c:Hide()
    end
    DB.probe.filters = { at = date("%Y-%m-%d %H:%M"), lines = lines }
    print(("Filter probe: %d lines saved. /reload to save them."):format(#lines))
end

-- "/suu probe sound": what C_UnitAuras.AddAuraSound wants. It isn't
-- documented, so this calls it with growing argument tables and keeps the
-- engine's error messages (they name what is missing), and removes any sound
-- it manages to add.
-- "/suu probe sound play": plays each tracker sound, one every 2 seconds and
-- named in chat: first the sound kit (the sound it should be), then candidate
-- file IDs (what aura sounds need), saying whether the game will play each.
-- Also lists the aura sounds the tracker registered.
local FILE_CANDIDATES = {
    chime = { 567409, 567478 },
    ping = { 567416 },
    proc = { 567458, 567399 },
    warning = { 567397 },
}

type Step = { key: string, kit?: unknown, file?: number }
-- One call of AddAuraSound: what it tries, and the table it passes.
type SoundTry = { label: string, args: { [string]: unknown } }

export function soundPlay()
    local lines: string[] = {}
    local steps: Step[] = {}
    local files = trackerSoundFiles()
    local record = { at = date("%Y-%m-%d %H:%M"), lines = lines }
    for _, key in ipairs({ "chime", "ping", "proc", "warning" }) do
        local s = files[key]
        if s then
            steps[#steps + 1] = { key = key, kit = s.kit }
            for _, id in ipairs(FILE_CANDIDATES[key] or { s.file }) do steps[#steps + 1] = { key = key, file = id } end
        end
    end
    for i, step in ipairs(steps) do
        after((i - 1) * 2, function()
            local ok: boolean, willPlay: unknown, label: string
            local kit, file = step.kit, step.file
            if kit then
                label = ("%s: sound kit %s"):format(step.key, tostring(kit))
                ok, willPlay = pcall(PlaySound, secret.asNumber(field(_G, "SOUNDKIT", tostring(kit))) or 0, "Master")
            else
                label = ("%s: file %d"):format(step.key, file or 0)
                ok, willPlay = pcall(PlaySoundFile, file or 0, "Master")
            end
            local line = ("%d. %s -> %s"):format(i, label, ok and tostring(willPlay) or ("error " .. tostring(willPlay)))
            lines[#lines + 1] = line
            print("Sound check " .. line)
            record.lines = lines
        end)
    end
    local ids, what = trackerAuraSounds()
    lines[#lines + 1] = ("%d aura sounds registered"):format(#ids)
    for i, id in ipairs(ids) do lines[#lines + 1] = ("  #%s %s"):format(tostring(id), tostring(what[i])) end
    local lastError = what.error
    if lastError then lines[#lines + 1] = "last error: " .. lastError end
    DB.probe.auraSoundPlay = record
    print(("Sound check: %d lines saved. /reload to save them."):format(#lines))
end

export function sound()
    local lines: string[] = {}
    local U: unknown = C_UnitAuras
    local trig = secret.asNumber(field(Enum, "UnitAuraSoundTrigger", "Added")) or 0
    local id = 1126 -- Mark of the Wild, rank 1
    -- unitToken is required (round 1); now the sound field's name
    local base = function(extra: { [string]: unknown }): { [string]: unknown }
        local t: { [string]: unknown } = { spellID = id, unitToken = "player" }
        for k, v in pairs(extra) do t[k] = v end
        return t
    end
    local tries: SoundTry[] = {
        { label = "soundKitID", args = base({ soundKitID = 8960 }) },
        { label = "soundKit", args = base({ soundKit = 8960 }) },
        { label = "soundID", args = base({ soundID = 8960 }) },
        { label = "soundFileID", args = base({ soundFileID = 567478 }) },
        { label = "fileID", args = base({ fileID = 567478 }) },
        { label = "soundFileName", args = base({ soundFileName = "Sound\\Interface\\RaidWarning.ogg" }) },
        { label = "soundFile", args = base({ soundFile = "Sound\\Interface\\RaidWarning.ogg" }) },
        { label = "soundKitID outputChannel", args = base({ soundKitID = 8960, outputChannel = "Master" }) },
        { label = "soundFileID outputChannel", args = base({ soundFileID = 567478, outputChannel = "Master" }) },
        { label = "soundFileName outputChannel", args = base({ soundFileName = "Sound\\Interface\\RaidWarning.ogg", outputChannel = "Master" }) },
        { label = "spellID as name", args = { spellID = "Mark of the Wild", unitToken = "player", soundKitID = 8960 } },
    }
    -- `U[name](...)`, protected
    local function try(name: string, ...: unknown): (boolean, unknown)
        local fn = field(U, name)
        if type(fn) ~= "function" then return false, "missing" end
        return pcall(fn, ...)
    end
    for _, t in ipairs(tries) do
        local ok, res = try("AddAuraSound", trig, t.args)
        lines[#lines + 1] = ("AddAuraSound(trigger, {%s}) -> %s"):format(t.label, ok and ("ok, " .. tostring(res)) or ("error: " .. tostring(res)))
        if ok and res then try("RemoveAuraSound", res) end
    end
    local ok, res = try("AddPrivateAuraAppliedSound", {})
    lines[#lines + 1] = "AddPrivateAuraAppliedSound({}) -> " .. (ok and ("ok, " .. tostring(res)) or ("error: " .. tostring(res)))
    DB.probe.auraSound = { at = date("%Y-%m-%d %H:%M"), lines = lines }
    print(("Sound probe: %d tries saved. /reload to save them."):format(#lines))
end

export function command(arg: string?)
    local words: string[] = {}
    for w in tostring(arg or ""):gmatch("%S+") do words[#words + 1] = w:lower() end
    if #words == 0 then words = { "aura", "candidate", "container", "filter" } end
    local lines, err = dump(words)
    if not lines then
        print("API docs: " .. tostring(err))
        return
    end
    DB.probe.apiDocs = { at = date("%Y-%m-%d %H:%M"), words = words, lines = lines }
    print(("API docs: %d lines about %s saved. /reload to save them."):format(#lines, table.concat(words, ", ")))
end
