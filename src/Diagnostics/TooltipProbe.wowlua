-- Diagnostics/TooltipProbe.wowlua
-- "/suu probe tooltips": what Forever offers for restyling Blizzard's
-- tooltips (step 2.7). Saved in SuuUIProbe.tooltips on /reload.
--   * TooltipDataProcessor and C_TooltipInfo, the tooltip data and line
--     types, Blizzard's tooltip frames (GameTooltip, the compare tooltips,
--     ItemRefTooltip, …): their art (NineSlice, layout), status bar, fonts
--   * from now until /reload, a log through TooltipDataProcessor's post
--     call (SuuUI's code only reads): per data type the last few tooltips,
--     their lines and colours, what is secret, in combat or not, the unit
--     tooltips' unit; and any blocked action
--
--   /suu probe tooltips   sample and start the log; then hover things: an
--                         item in your bags, a spell on your bars (out of
--                         combat and in combat), yourself, a friendly and
--                         a hostile player or NPC, a quest item, a buff;
--                         shift-hover an item for the compare tooltip;
--                         click an item link in chat; then /reload

import hook from "wowlua:hooks"
import isSecret from "wowlua:secret"
import * as DB from "/Core/DB"
import print from "/Core/Init"


local function show(v: any): string
    if isSecret(v) then return "secret" end
    if v == nil then return "nil" end
    if type(v) == "table" then
        local parts = {}
        for k, x in pairs(v) do
            parts[#parts + 1] = tostring(k) .. "=" .. (isSecret(x) and "secret" or (type(x) == "table" and "table" or tostring(x)))
        end
        table.sort(parts)
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function namesIn(t: any): string[]
    local out: string[] = {}
    if type(t) ~= "table" then return { "missing" } end
    for k, v in pairs(t) do if type(k) == "string" and type(v) == "function" then out[#out + 1] = k end end
    table.sort(out)
    return out
end

local function enumList(e: any): string[]
    local out: string[] = {}
    if type(e) ~= "table" then return { "missing" } end
    for k, v in pairs(e) do out[#out + 1] = tostring(k) .. "=" .. tostring(v) end
    table.sort(out)
    return out
end

local FRAMES = { "GameTooltip", "ShoppingTooltip1", "ShoppingTooltip2", "ItemRefTooltip", "ItemRefShoppingTooltip1",
                 "EmbeddedItemTooltip", "NamePlateTooltip", "WorldMapTooltip", "GameTooltipStatusBar", "FriendsTooltip",
                 "QuestScrollFrame", "SmallTextTooltip", "LibDBIconTooltip" }

local GLOBALS = { "GameTooltip_SetDefaultAnchor", "GameTooltip_SetBackdropStyle", "SharedTooltip_SetBackdropStyle",
                  "GameTooltip_ShowCompareItem", "GameTooltip_AddQuestRewardsToTooltip", "TooltipUtil",
                  "TOOLTIP_DEFAULT_BACKGROUND_COLOR", "TOOLTIP_DEFAULT_COLOR", "GAME_TOOLTIP_BACKDROP_STYLE_DEFAULT",
                  "TooltipBackdropTemplateMixin", "NineSliceUtil", "GameTooltip_UnitColor", "GameTooltip_OnTooltipSetUnit",
                  "UnitPopupSharedUtil", "C_TooltipComparison", "TooltipComparisonManager" }

local function regionsOf(f: any): string
    local out: string[] = {}
    for _, r in ipairs({ f:GetRegions() }) do
        local name = r:GetDebugName() or "?"
        out[#out + 1] = name:gsub("^.*%.", "") .. "(" .. r:GetObjectType() .. ")"
        if #out >= 12 then break end
    end
    return table.concat(out, " ")
end

local function frameInfo(name: string): any
    local f = _G[name]
    if type(f) ~= "table" or not f.GetObjectType then return "missing" end
    local kids = {}
    for k, v in pairs(f) do if type(k) == "string" and type(v) == "table" and v.GetObjectType then kids[#kids + 1] = k end end
    table.sort(kids)
    local info: { [string]: any } = {
        type = f:GetObjectType(), protected = show(f:IsProtected()), strata = show(f:GetFrameStrata()),
        children = table.concat(kids, " "), regions = regionsOf(f),
        nineSlice = f.NineSlice and ("layout=" .. show(f.NineSlice.layoutType) .. " protected=" .. show(f.NineSlice:IsProtected())) or "none",
        backdrop = f.GetBackdrop and "has SetBackdrop" or "no backdrop API",
        layoutType = show(f.layoutType),
        scale = show(f:GetScale()),
    }
    local left1 = _G[name .. "TextLeft1"]
    if left1 then
        local font, size, flags = left1:GetFont()
        info.textLeft1 = show(font) .. " " .. show(size) .. " " .. show(flags)
    end
    local left2 = _G[name .. "TextLeft2"]
    if left2 then
        local font, size = left2:GetFont()
        info.textLeft2 = show(font) .. " " .. show(size)
    end
    return info
end

local store: { [string]: any }? = nil
local function note(s: string)
    local log = store and store.log
    if not log then return end
    log[#log + 1] = date("%H:%M:%S") .. (InCombatLockdown() and " [combat] " or " ") .. s
    while #log > 200 do table.remove(log, 1) end
end

local TYPE_NAMES: { [any]: string } = {}

-- One tooltip as the post call sees it: its data and its lines.
local function sampleTooltip(tooltip: any, data: any): { [string]: any }
    local s: { [string]: any } = { at = date("%H:%M:%S"), combat = InCombatLockdown() and true or false }
    s.tooltip = tooltip and tooltip.GetName and show(tooltip:GetName()) or "?"
    s.type = show(data and data.type)
    s.id = show(data and data.id)
    s.guid = show(data and data.guid)
    s.dataKeys = show(data)
    if data and type(data.lines) == "table" then
        s.lineCount = #data.lines
        s.lines = {}
        for i, line in ipairs(data.lines) do
            if i > 8 then break end
            local c = line.leftColor
            local color = c and (isSecret(c.r) and "secret" or ("%.2f,%.2f,%.2f"):format(c.r or 0, c.g or 0, c.b or 0)) or "nil"
            s.lines[i] = ("type=%s left=%s right=%s color=%s"):format(show(line.type),
                isSecret(line.leftText) and "secret" or show(line.leftText):sub(1, 60),
                isSecret(line.rightText) and "secret" or show(line.rightText):sub(1, 30), color)
        end
    else
        s.lines = show(data and data.lines)
    end
    -- what the tooltip's own font strings say
    local name = tooltip and tooltip.GetName and tooltip:GetName()
    if name and not isSecret(name) then
        local fs = _G[name .. "TextLeft1"]
        if fs then
            local text = fs:GetText()
            s.textLeft1 = isSecret(text) and "secret" or show(text):sub(1, 60)
            local r, g, b = fs:GetTextColor()
            s.textLeft1Color = isSecret(r) and "secret" or ("%.2f,%.2f,%.2f"):format(r or 0, g or 0, b or 0)
        end
        s.numLines = show(tooltip.NumLines and tooltip:NumLines())
    end
    -- a unit tooltip: which unit, and what of it is readable
    if tooltip and tooltip.GetUnit then
        local ok, uname, unit = pcall(tooltip.GetUnit, tooltip)
        if ok and unit then
            s.unit = show(unit)
            if not isSecret(unit) then
                s.unitName = show(UnitName(unit))
                s.unitClass = show(select(2, UnitClass(unit)))
                s.unitReaction = show(UnitReaction(unit, "player"))
                s.unitIsPlayer = show(UnitIsPlayer(unit))
                s.unitLevel = show(UnitLevel(unit))
                s.unitClassification = show(UnitClassification(unit))
            end
        elseif ok then
            s.unit = "none (" .. show(uname) .. ")"
        else
            s.unit = "error " .. tostring(uname):sub(1, 80)
        end
    end
    if tooltip and tooltip.GetItem then
        local ok, iname, link = pcall(tooltip.GetItem, tooltip)
        if ok then s.item = show(iname) .. " " .. (isSecret(link) and "secret" or show(link)) end
    end
    if tooltip and tooltip.GetSpell then
        local ok, sname, sid = pcall(tooltip.GetSpell, tooltip)
        if ok then s.spell = show(sname) .. " " .. show(sid) end
    end
    if tooltip and tooltip.GetOwner then
        local ok, text = pcall(function()
            local owner = tooltip:GetOwner()
            return owner and (show(owner.GetName and owner:GetName()) .. " protected=" .. show(owner.IsProtected and owner:IsProtected())) or "nil"
        end)
        s.owner = ok and text or ("error " .. tostring(text):sub(1, 80))
    end
    return s
end

local logging = false
local function startLog()
    if logging then return end
    logging = true
    local st = store :: { [string]: any } -- sampled before the log starts
    if not (TooltipDataProcessor and TooltipDataProcessor.AddTooltipPostCall) then
        st.logError = "no TooltipDataProcessor.AddTooltipPostCall"
        return
    end
    local all = TooltipDataProcessor.AllTypes or "ALL"
    local ok, err = pcall(TooltipDataProcessor.AddTooltipPostCall, all, function(tooltip, data)
        local cur = store
        if not cur then return end
        local ok2, s = pcall(sampleTooltip, tooltip, data)
        if not ok2 then
            note("sample error: " .. tostring(s):sub(1, 160))
            return
        end
        local key = (TYPE_NAMES[data and data.type] or s.type) .. (s.combat and " combat" or "")
        cur.byType = cur.byType or {}
        local list = cur.byType[key] or {}
        cur.byType[key] = list
        -- the same thing again: replace, else add (a few per type)
        local same = list[#list] and list[#list].id == s.id and list[#list].tooltip == s.tooltip
        if same then list[#list] = s else list[#list + 1] = s end
        while #list > 3 do table.remove(list, 1) end
    end)
    st.postCall = ok and "added" or ("error: " .. tostring(err))
    local f = CreateFrame("Frame")
    for _, e in ipairs({ "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN" }) do f:RegisterEvent(e) end
    f:SetScript("OnEvent", function(_, event, a, b) note(event .. " " .. show(a) .. " " .. show(b)) end)
    -- which of Blizzard's tooltip functions run when (compare, anchor, style)
    for _, name in ipairs({ "GameTooltip_SetDefaultAnchor", "GameTooltip_ShowCompareItem", "SharedTooltip_SetBackdropStyle",
                            "GameTooltip_SetBackdropStyle" }) do
        if type(_G[name]) == "function" then
            hook(name, function(tt: any)
                local cur = store :: { [string]: any }
                local log = cur.calls or {}
                cur.calls = log
                local key = name .. "(" .. show(tt and tt.GetName and tt:GetName()) .. ")"
                log[key] = (log[key] or 0) + 1
            end)
        end
    end
end

export function sample()
    local s: { [string]: any } = DB.probe.tooltips or {}
    store = s
    DB.probe.tooltips = s
    s.at = date("%Y-%m-%d %H:%M:%S")
    s.TooltipDataProcessor = namesIn(TooltipDataProcessor)
    s.allTypes = show(TooltipDataProcessor and TooltipDataProcessor.AllTypes)
    s.C_TooltipInfo = namesIn(C_TooltipInfo)
    s.C_TooltipComparison = namesIn(C_TooltipComparison)
    s.dataTypes = enumList(Enum.TooltipDataType)
    s.lineTypes = enumList(Enum.TooltipDataLineType)
    for k, v in pairs((Enum.TooltipDataType :: any) or {}) do TYPE_NAMES[v] = k end
    s.globals = {}
    for _, name in ipairs(GLOBALS) do s.globals[name] = type(_G[name]) end
    s.frames = {}
    for _, name in ipairs(FRAMES) do s.frames[name] = frameInfo(name) end
    s.cvars = {}
    for _, c in ipairs({ "showTargetOfTarget", "UberTooltips", "alwaysCompareItems", "showQuestTrackingTooltips",
                         "showNPETutorials", "colorblindMode" }) do
        s.cvars[c] = show(GetCVar(c))
    end
    if GameTooltipStatusBar then
        s.statusBar = { shown = show(GameTooltipStatusBar:IsShown()), texture = show(GameTooltipStatusBar:GetStatusBarTexture() and GameTooltipStatusBar:GetStatusBarTexture():GetTexture()),
                            height = show(GameTooltipStatusBar:GetHeight()), protected = show(GameTooltipStatusBar:IsProtected()) }
    end
    s.log = s.log or {}
    startLog()
end

export function command()
    sample()
    print("Tooltip probe: sampled. Now hover things (bag items, spells on your bars out of combat and in combat, yourself, friendly and hostile players and NPCs, a buff), shift-hover an item to compare, click an item link in chat, then /reload.")
end
