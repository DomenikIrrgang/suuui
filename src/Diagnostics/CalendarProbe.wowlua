-- Diagnostics/CalendarProbe.wowlua
-- "/suu probe calendar": what Forever's calendar tells an addon about
-- holidays, for showing holiday quests on the map only while their holiday
-- is on. Saved in SuuUIProbe.calendar on /reload.
--   * which C_Calendar and C_DateAndTime functions exist
--   * today's date as the calendar has it
--   * every event this month and next (the calendar loads them after
--     OpenCalendar; the probe waits for CALENDAR_UPDATE_EVENT_LIST, at most
--     5 s): title, type, eventID, start and end, and a holiday's own info
--   * today's events on their own

import * as DB from "/Core/DB"
import print from "/Core/Init"
import isSecret from "wowlua:secret"
import after from "wowlua:timer"
import * as tbl from "wowlua:table"
import * as secret from "wowlua:secret"

local function show(v: unknown, depth: number?): string
    depth = depth or 0
    if isSecret(v) then
        return "<secret>"
    end
    if type(v) ~= "table" then
        return tostring(v)
    end
    if depth > 1 then
        return "{…}"
    end
    local parts: string[] = {}
    for k, x in pairs(v) do
        if type(x) ~= "function" then
            parts[#parts + 1] = tostring(k) ..
                "=" .. (isSecret(x) and "<secret>" or (type(x) == "table" and show(x, depth + 1) or tostring(x)))
        end
    end
    table.sort(parts)
    return "{" .. table.concat(parts, ", ") .. "}"
end

local function call(t: unknown, name: string, ...: unknown): (unknown, unknown, unknown)
    local fn = tbl.field(t, name)
    if type(fn) ~= "function" then
        return "missing"
    end
    local ok, a, b, c = pcall(fn, ...)
    if not ok then
        return "error: " .. tostring(a)
    end
    return a, b, c
end

export function snapshot(waited: boolean)
    local functions: string[] = {}
    local s: { [string]: unknown } = { at = date("%Y-%m-%d %H:%M:%S"), waited = waited, functions = functions }
    DB.probe.calendar = s
    local cal = C_Calendar
    s.exists = cal ~= nil
    for k, v in pairs(cal or {}) do
        if type(v) == "function" and type(k) == "string" then
            functions[#functions + 1] = k
        end
    end
    table.sort(functions)
    local now = C_DateAndTime and call(C_DateAndTime, "GetCurrentCalendarTime")
    s.now = show(now)
    if not (cal and type(now) == "table") then
        print("Calendar probe: no calendar (" .. tostring(cal ~= nil) .. "); /reload.")
        return
    end
    -- this month (offset 0) and next (1), as the calendar's month view has them
    s.months = {}
    local holidays = 0
    for offset = 0, 1 do
        local info = call(cal, "GetMonthInfo", offset)
        local events: { [string]: unknown }[] = {}
        local m = { info = show(info), events = events }
        table.insert(tbl.listAt(s, "months"), m)
        local days = secret.asNumber(tbl.field(info, "numDays")) or 31
        for day = 1, days do
            local n = call(cal, "GetNumDayEvents", offset, day)
            for i = 1, (secret.asNumber(n) or 0) do
                local e = call(cal, "GetDayEvent", offset, day, i)
                local entry: { [string]: unknown } = { day = day, event = show(e) }
                if tbl.field(e, "calendarType") == "HOLIDAY" then
                    holidays = holidays + 1
                    entry.holiday = show((call(cal, "GetHolidayInfo", offset, day, i)))
                end
                -- one line per event a day, not one per day it lasts
                if #events < 120 then
                    events[#events + 1] = entry
                end
            end
        end
    end
    -- today's
    local today: string[] = {}
    s.today = today
    local monthDay = tbl.field(now, "monthDay")
    local n = call(cal, "GetNumDayEvents", 0, monthDay)
    for i = 1, (secret.asNumber(n) or 0) do
        today[#today + 1] = show((call(cal, "GetDayEvent", 0, monthDay, i)))
    end
    print(
        ("Calendar probe: %d events today, %d holiday days in two months%s; /reload."):format(
            #today,
            holidays,
            waited and "" or " (the calendar didn't answer in 5 s)"
        )
    )
end

export function command()
    if not C_Calendar then
        snapshot(false)
        return
    end
    -- the calendar loads its events after OpenCalendar
    local f = CreateFrame("Frame")
    local done = false
    local function finish(waited: boolean)
        if done then
            return
        end
        done = true
        f:UnregisterAllEvents()
        snapshot(waited)
    end
    f:RegisterEvent("CALENDAR_UPDATE_EVENT_LIST")
    f:SetScript("OnEvent", function()
        finish(true)
    end)
    local now = C_DateAndTime and C_DateAndTime.GetCurrentCalendarTime and C_DateAndTime.GetCurrentCalendarTime()
    if now and C_Calendar.SetAbsMonth then
        pcall(C_Calendar.SetAbsMonth, now.month, now.year)
    end
    if C_Calendar.OpenCalendar then
        pcall(C_Calendar.OpenCalendar)
    end
    print("Calendar probe: reading the calendar…")
    after(5, function()
        finish(false)
    end)
end
