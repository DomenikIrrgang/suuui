-- Diagnostics/SkysightProbe.wowlua
-- "/suu probe skysight" (asked 2026-10-19: a world map filter for the
-- Convergences of Elements, the tornadoes a Skyborne uses Skysight at; no
-- data names their places but one): what the game tells about them.
--   now:   Skysight in your spellbook (its spell ID, whether it's usable
--          here, its cooldown); vignettes on your map and their places;
--          the map's area POIs; achievements whose criteria name a
--          convergence, Skysight or a tornado (a list of them, if one has it)
--   then (this session, by itself): every Skysight cast (the spell ID,
--          where you stood, your target or mouseover); the vignettes as
--          they come and go (VIGNETTE_MINIMAP_UPDATED), with their places
-- Saved in SuuUIProbe.skysight on /reload. Values the game hides read SECRET.

import isSecret, asNumber from "wowlua:secret"
import after from "wowlua:timer"
import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as tbl from "wowlua:table"

-- What the probe saves in SuuUIProbe.skysight.
type Out = { now?: { [string]: unknown }, casts: string[], vignetteEvents: string[] }

local field = tbl.field

local function show(v: unknown): string
    if isSecret(v) then
        return "SECRET"
    end
    local x, y = field(v, "x"), field(v, "y")
    if type(v) == "table" and x then
        return ("%.4f,%.4f"):format(asNumber(x) or 0, asNumber(y) or 0)
    end
    return tostring(v)
end

local function call(fn: unknown, ...: unknown): (unknown, unknown, unknown, unknown)
    if type(fn) ~= "function" then
        return nil, nil, nil, nil
    end
    local ok, a, b, c, d = pcall(fn, ...)
    if ok then
        return a, b, c, d
    end
    return nil, nil, nil, nil
end

local function out(): Out
    local o = DB.probeData("skysight", function(): Out
        return { casts = {}, vignetteEvents = {} }
    end)
    o.casts, o.vignetteEvents = o.casts or {}, o.vignetteEvents or {}
    return o
end

local NAMES = { "skysight", "convergen", "tornado", "cyclone" }
local function matches(text: unknown): boolean
    if type(text) ~= "string" or isSecret(text) then
        return false
    end
    local low = text:lower()
    for _, n in ipairs(NAMES) do
        if low:find(n, 1, true) then
            return true
        end
    end
    return false
end

local function here(): string
    local map = C_Map.GetBestMapForUnit("player")
    local pos = map and (call(C_Map.GetPlayerMapPosition, map, "player"))
    return ("map %s at %s"):format(show(map), show(pos))
end

-- Skysight in the spellbook, by name
local function findSkysight(): string
    local SB = C_SpellBook
    local bank = Enum.SpellBookSpellBank.Player
    for line = 1, asNumber((call(SB.GetNumSpellBookSkillLines))) or 0 do
        local info = call(SB.GetSpellBookSkillLineInfo, line)
        local offset, count = asNumber(field(info, "itemIndexOffset")), asNumber(field(info, "numSpellBookItems"))
        if offset and count then
            for i = offset + 1, offset + count do
                local item = call(SB.GetSpellBookItemInfo, i, bank)
                if type(item) == "table" and matches(field(item, "name")) then
                    local id = field(item, "spellID") or field(item, "actionID")
                    local usable, noMana = call(C_Spell.IsSpellUsable, id)
                    local cd = call(C_Spell.GetSpellCooldown, id)
                    return ("%s (spell %s, line %s): usable here %s/%s, cooldown %s"):format(
                        show(field(item, "name")),
                        show(id),
                        show(field(info, "name")),
                        show(usable),
                        show(noMana),
                        type(cd) == "table" and
                            ("start %s, duration %s"):format(
                                show(field(cd, "startTime")),
                                show(field(cd, "duration"))
                            ) or
                            show(cd)
                    )
                end
            end
        end
    end
    return "not in the spellbook"
end

local function vignettes(): string[]
    local list: string[] = {}
    local map = C_Map.GetBestMapForUnit("player")
    local VI = C_VignetteInfo
    for _, guid in ipairs(tbl.list((call(VI.GetVignettes)))) do
        local v = call(VI.GetVignetteInfo, guid)
        if type(v) == "table" then
            local pos = map and (call(VI.GetVignettePosition, guid, map))
            list[#list + 1] = ("%s: vignetteID %s, atlas %s, onMinimap %s, onWorldMap %s, at %s"):format(
                show(field(v, "name")),
                show(field(v, "vignetteID")),
                show(field(v, "atlasName")),
                show(field(v, "onMinimap")),
                show(field(v, "onWorldMap")),
                show(pos)
            )
        end
    end
    return list
end

local function areaPOIs(): string[]
    local list: string[] = {}
    local map = C_Map.GetBestMapForUnit("player")
    if not map then
        return list
    end
    for _, id in ipairs(tbl.list((call(C_AreaPoiInfo.GetAreaPOIForMap, map)))) do
        local p = call(C_AreaPoiInfo.GetAreaPOIInfo, map, id)
        if type(p) == "table" then
            list[#list + 1] = ("%s (%s): atlas %s, at %s"):format(
                show(field(p, "name")),
                show(id),
                show(field(p, "atlasName")),
                show(field(p, "position"))
            )
        end
    end
    return list
end

-- achievements with a criterion naming one (the game's own list of them)
local function achievements(): unknown
    local found: { [unknown]: unknown } = {}
    local list: unknown[] = {}
    local catList, count, info = field(_G, "GetCategoryList"),
        field(_G, "GetCategoryNumAchievements"),
        field(_G, "GetAchievementInfo")
    if not (catList and count and info) then
        return "no achievement API"
    end
    for _, cat in ipairs(tbl.list((call(catList)))) do
        for i = 1, asNumber((call(count, cat, true))) or 0 do
            local id, name = call(info, cat, i)
            if id then
                local hit = matches(name)
                local crit: string[] = {}
                for c = 1, asNumber((call(field(_G, "GetAchievementNumCriteria"), id))) or 0 do
                    local text, _, done = call(field(_G, "GetAchievementCriteriaInfo"), id, c)
                    if matches(text) or hit then
                        crit[#crit + 1] = ("%s%s"):format(show(text), done and " (done)" or "")
                    end
                end
                if hit or #crit > 0 then
                    list[#list + 1] = { id = id, name = show(name), criteria = crit }
                end
            end
        end
    end
    for i, v in ipairs(list) do
        found[i] = v
    end
    if field(_G, "C_AchievementInfo") then
        found.api = "C_AchievementInfo present"
    end
    return found
end

local function snapshot()
    local o = out()
    o.now = {
        at = date("%H:%M:%S"),
        where = here(),
        spell = findSkysight(),
        vignettes = vignettes(),
        areaPOIs = areaPOIs(),
        achievements = achievements(),
    }
end

local listening: Frame? = nil
local function listen()
    if listening then
        return
    end
    local f = CreateFrame("Frame")
    listening = f
    pcall(f.RegisterUnitEvent, f, "UNIT_SPELLCAST_SUCCEEDED", "player")
    pcall(f.RegisterEvent, f, "VIGNETTE_MINIMAP_UPDATED")
    pcall(f.RegisterEvent, f, "VIGNETTES_UPDATED")
    f:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown, c: unknown)
        local o = out()
        if event == "UNIT_SPELLCAST_SUCCEEDED" then
            local name = call(C_Spell.GetSpellName, c)
            if not matches(name) then
                return
            end
            local line = ("%s: %s (spell %s) %s; target %s, mouseover %s; vignettes: %s"):format(
                date("%H:%M:%S"),
                show(name),
                show(c),
                here(),
                show((call(UnitName, "target"))),
                show((call(UnitName, "mouseover"))),
                table.concat(vignettes(), " | ")
            )
            local i = #o.casts + 1
            o.casts[i] = line
            -- the buff it gives: longer at a convergence (the user, 2026-10-19),
            -- so its duration tells whether you stood at one
            after(0.5, function()
                local buffs: string[] = {}
                for n = 1, 40 do
                    local aura = call(C_UnitAuras.GetAuraDataByIndex, "player", n, "HELPFUL")
                    if type(aura) ~= "table" then
                        break
                    end
                    -- by its name or spell, or any buff that just began (it may
                    -- be named otherwise)
                    local d, e = asNumber(field(aura, "duration")), asNumber(field(aura, "expirationTime"))
                    local fresh = d and e and d > 0 and math.abs((e - d) - GetTime()) < 2
                    local auraName, spellId = field(aura, "name"), field(aura, "spellId")
                    if matches(auraName) or spellId == c or fresh then
                        buffs[#buffs + 1] = ("%s (spell %s): duration %s, expires %s"):format(
                            show(auraName),
                            show(spellId),
                            show(d),
                            show(e)
                        )
                    end
                end
                o.casts[i] = line .. "; buff: " .. (#buffs > 0 and table.concat(buffs, " | ") or "none found by name")
                print(
                    ("Skysight probe: %s recorded where you stand; buff %s."):format(
                        show(name),
                        #buffs > 0 and buffs[1] or "not found"
                    )
                )
            end)
        else
            if #o.vignetteEvents < 80 then
                table.insert(
                    o.vignetteEvents,
                    ("%s %s %s %s; %s"):format(
                        date("%H:%M:%S"),
                        event,
                        show(a),
                        show(b),
                        table.concat(vignettes(), " | ")
                    )
                )
            end
        end
    end)
end

export function command(_rest: string?)
    snapshot()
    listen()
    print(
        "Skysight probe: recorded what the game gives here. Now go to a Convergence of Elements and use Skysight there (one or two); then /reload to save it."
    )
end
