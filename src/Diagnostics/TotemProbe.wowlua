-- Diagnostics/TotemProbe.wowlua
-- "/suu probe totems" (on a shaman, asked 2026-10-18: a totem bar in the
-- stance bar's place, the design's TotemBar: earth, fire, water, air, each
-- slot its totem with time left and a drain, or empty). What the client
-- gives: each slot's totem (GetTotemInfo, GetTotemTimeLeft, GetTotemDuration,
-- GetTotemCannotDismiss), which of those are secret in combat (run it again
-- in a fight), how often PLAYER_TOTEM_UPDATE fires, the game's own totem
-- frames (TotemFrame, the multi-cast bar) and the stance bar's forms (Ghost
-- Wolf). "/suu probe totems destroy" tries DestroyTotem on the first slot
-- with a totem (a right click to dismiss), "check" saves what happened.
-- Saved in SuuUIProbe.totems on /reload.

import isSecret, asNumber, asString from "wowlua:secret"
import after from "wowlua:timer"
import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"
import panel as uiPanel from "/UI/Panel"
import type Panel from "/UI/Panel"
import text as uiText from "/UI/Text"
import type Text from "/UI/Text"

type Map = { [unknown]: unknown }
-- A test button: its secure action and its label.
type ButtonDef = { kind: string, value: unknown, label: string, action?: unknown }
-- A test button as made: the button, its icon and its label.
type TestButton = { button: Button, icon: Texture, label: Text }

local function show(v: unknown): string
    if isSecret(v) then return "SECRET" end
    if type(v) == "table" or type(v) == "userdata" then return type(v) end
    return tostring(v)
end

local function call(fn: unknown, ...: unknown): string
    if type(fn) ~= "function" then return "missing" end
    local res = { pcall(fn, ...) }
    if not res[1] then return "error " .. tostring(res[2]):sub(1, 120) end
    local parts: string[] = {}
    for i = 2, math.max(2, #res) do parts[#parts + 1] = show(res[i]) end
    return table.concat(parts, ", ")
end

-- `fn(...)`'s results as they are: an empty list when it's missing or raises.
local function results(fn: unknown, ...: unknown): unknown[]
    if type(fn) ~= "function" then return {} end
    local res = { pcall(fn, ...) }
    if not res[1] then return {} end
    table.remove(res, 1)
    return res
end

-- A global list of the game's, joined (or "missing").
local function joined(name: string): string
    local list = tbl.field(_G, name)
    if type(list) ~= "table" then return "missing" end
    local parts: string[] = {}
    for _, v in ipairs(tbl.list(list)) do parts[#parts + 1] = tostring(v) end
    return table.concat(parts, ",")
end

-- The totem spells a slot can hold.
local function slotSpells(slot: number): unknown[]
    return results(tbl.field(_G, "GetMultiCastTotemSpells"), slot)
end

local function frameInfo(name: string): string
    local f = wf.asRegion(tbl.field(_G, name))
    if not f then return "missing" end
    return ("%s shown=%s visible=%s protected=%s"):format(f:GetObjectType(), tostring(f:IsShown()), tostring(f:IsVisible()), tostring((f:IsProtected())))
end

-- The first slot button's action (nil when there is none).
local function firstSlotAction(): unknown
    local b = tbl.field(_G, "MultiCastActionButton1")
    return results(tbl.field(b, "CalculateAction"), b)[1]
end

local events: { count: number, slots: { [string]: number } } = { count = 0, slots = {} }
local listener: Frame? = nil
local started: string? = nil
local probePanel: Panel? = nil
local testButtons: TestButton[] = {}

local function record(): Map
    local out: Map = { at = date("%H:%M:%S"), combat = InCombatLockdown() and true or false }
    local _, class = UnitClass("player")
    out.class, out.level = class, UnitLevel("player")
    out.numSlots = call(GetNumTotemSlots)
    out.maxTotems = tostring(tbl.field(_G, "MAX_TOTEMS"))
    out.slotConstants = ("earth=%s fire=%s water=%s air=%s"):format(tostring(tbl.field(_G, "EARTH_TOTEM_SLOT")),
        tostring(tbl.field(_G, "FIRE_TOTEM_SLOT")), tostring(tbl.field(_G, "WATER_TOTEM_SLOT")), tostring(tbl.field(_G, "AIR_TOTEM_SLOT")))
    out.priorities = joined("SHAMAN_TOTEM_PRIORITIES")
    local slots: Map[] = {}
    out.slots = slots
    for slot = 1, 4 do
        local s: Map = {}
        s.info = call(GetTotemInfo, slot)
        s.timeLeft = call(GetTotemTimeLeft, slot)
        s.cannotDismiss = call(tbl.field(_G, "GetTotemCannotDismiss"), slot)
        local duration = tbl.field(_G, "GetTotemDuration")
        local ok, d = false, "missing" :: unknown
        if type(duration) == "function" then ok, d = pcall(duration, slot) end
        s.duration = ok and (d and (type(d) .. (isSecret(d) and " SECRET" or "")) or "nil") or ("error " .. tostring(d):sub(1, 80))
        if ok and d and not isSecret(d) and (type(d) == "table" or type(d) == "userdata") then
            -- what a duration object answers (the cooldown sweep and the drain take it)
            s.durationRemaining = call(tbl.field(d, "GetRemainingDuration"), d)
            s.durationTotal = call(tbl.field(d, "GetTotalDuration"), d)
        end
        slots[slot] = s
    end
    local frameList: { [string]: string } = {}
    out.frames = frameList
    for _, name in ipairs({ "TotemFrame", "MultiCastActionBarFrame", "MultiCastSlotButton1", "MultiCastSummonSpellButton",
                            "StanceBar", "StanceButton1" }) do
        frameList[name] = frameInfo(name)
    end
    out.hasMultiCastBar = call(tbl.field(_G, "HasMultiCastActionBar"))
    out.multiCastActive = tostring(tbl.field(_G, "MultiCastActionBarFrame", "numActiveSlots"))
    local multiCast: unknown[] = {}
    out.multiCastSpells = multiCast
    for slot = 1, 4 do multiCast[slot] = #slotSpells(slot) end
    out.forms = call(GetNumShapeshiftForms)
    for i = 1, 10 do
        local ok, icon, active, _, spellID = pcall(GetShapeshiftFormInfo, i)
        if not ok or not icon then break end
        local id = asNumber(spellID)
        out["form" .. i] = ("spell=%s active=%s %s"):format(show(spellID), show(active), id and (C_Spell.GetSpellName(id) or "") or "")
    end
    out.tooltipSetTotem = tbl.field(GameTooltip, "SetTotem") and "present" or "missing"
    -- the game's slot buttons: which action slots they cast
    local actions: string[] = {}
    out.actions = actions
    for i = 1, 12 do
        local b = wf.asButton(tbl.field(_G, "MultiCastActionButton" .. i))
        if b then
            local slot = results(tbl.field(b, "CalculateAction"), b)[1]
            actions[i] = ("id=%s action=%s shown=%s has=%s info=%s"):format(tostring(b:GetID()), show(slot), tostring(b:IsShown()),
                slot ~= nil and call(HasAction, slot) or "-", slot ~= nil and call(GetActionInfo, slot) or "-")
        end
    end
    out.summonSpells = joined("TOTEM_MULTI_CAST_SUMMON_SPELLS")
    out.recallSpells = joined("TOTEM_MULTI_CAST_RECALL_SPELLS")
    out.summonKnown = tostring(tbl.field(_G, "MultiCastSummonSpellButton", "spellId") or "missing")
    out.recallKnown = tostring(tbl.field(_G, "MultiCastRecallSpellButton", "spellId") or "missing")
    local spells: string[] = {}
    out.slotSpells = spells
    for slot = 1, 4 do
        local parts: string[] = {}
        for _, id in ipairs(slotSpells(slot)) do parts[#parts + 1] = tostring(id) end
        spells[slot] = table.concat(parts, ",")
    end
    out.events = { count = events.count, slots = events.slots }
    return out
end

export function command(rest: string?)
    local all = tbl.recordAt(DB.probe, "totems")
    started = started or date("%H:%M:%S")
    if not listener then
        local l = CreateFrame("Frame")
        listener = l
        l:RegisterEvent("PLAYER_TOTEM_UPDATE")
        l:SetScript("OnEvent", function(_, _, slot: unknown)
            events.count = events.count + 1
            local key = tostring(isSecret(slot) and "secret" or slot)
            events.slots[key] = (events.slots[key] or 0) + 1
        end)
    end
    if rest == "buttons" then
        buttons()
        return
    end
    if rest == "choose" then
        choose(all)
        return
    end
    if rest == "destroy" then
        local destroy: Map = { at = date("%H:%M:%S"), combat = InCombatLockdown() and true or false }
        all.destroy = destroy
        for slot = 1, 4 do
            local ok, have = pcall(GetTotemInfo, slot)
            if ok and have and not isSecret(have) then
                destroy.slot = slot
                destroy.result = call(tbl.field(_G, "DestroyTotem"), slot)
                break
            end
        end
        destroy.slot = destroy.slot or "no totem down"
        print("Totem probe: tried to dismiss a totem. Did it go? Then /suu probe totems check and /reload.")
        return
    end
    if rest == "check" then
        local check = record()
        all.check = check
        local blocked: string[] = {}
        check.blocked = blocked
        local since = started or "00:00:00"
        for _, e in ipairs(DB.list("blocked")) do
            local time = tbl.field(e, "time")
            if time and tostring(time) >= date("%Y-%m-%d ") .. since then
                blocked[#blocked + 1] = tostring(time) .. " " .. tostring(tbl.field(e, "event")) .. " " .. tostring(tbl.field(e, "func"))
            end
        end
        print("Totem probe: checked. /reload to save it.")
        return
    end
    local out = record()
    all[out.combat and "inCombat" or "outOfCombat"] = out
    print(("Totem probe: recorded %s (%s, %d totem events so far). Drop totems and run it again, once in a fight; /reload to save.")
        :format(out.combat and "in combat" or "out of combat", tostring(out.class), events.count))
end

-- A spell's or action's icon (the question mark when there is none).
local function iconOf(d: ButtonDef): unknown
    local id = asNumber(d.value)
    if not id then return 134400 end
    if d.kind == "action" then return GetActionTexture(id) or 134400 end
    if d.kind == "spell" or d.kind == "multispell" then return C_Spell.GetSpellTexture(id) or 134400 end
    return 134400
end

-- "/suu probe totems buttons": SuuUI's own secure buttons for the game's
-- totem slots (the first page's four action slots) and the summon and recall
-- spells. Click them out of combat and in a fight: does the totem go down?
export function buttons()
    print("Totem probe: placing the test buttons…")
    if InCombatLockdown() then print("Totem probe: out of combat, to place the buttons.") return end
    local p = probePanel or uiPanel(UIParent, { title = "Totem probe", width = 260, height = 120, solid = true })
    probePanel = p
    p:SetFrameStrata("DIALOG")
    p:ClearAllPoints()
    p:SetPoint("LEFT", 40, 0)
    local defs: ButtonDef[] = {}
    local earth = asNumber(tbl.field(_G, "EARTH_TOTEM_SLOT")) or 2
    -- the earth slot (the game's first button): the spell it holds, cast as a
    -- spell, and the slot's action itself (the first try did nothing)
    local action = asNumber(firstSlotAction())
    if action then
        local kind, id = GetActionInfo(action)
        if kind == "spell" and id then defs[#defs + 1] = { kind = "spell", value = id, label = "Spell" } end
        defs[#defs + 1] = { kind = "action", value = action, label = "Act" }
        -- choosing securely: the game's multispell action puts another earth
        -- totem in the slot (watch the game's bar)
        local other: unknown = nil
        for _, sid in ipairs(slotSpells(earth)) do
            if sid ~= id then other = sid break end
        end
        if other ~= nil then defs[#defs + 1] = { kind = "multispell", value = other, action = action, label = "Pick" } end
    end
    local summon = tbl.field(_G, "MultiCastSummonSpellButton", "spellId")
    local recall = tbl.field(_G, "MultiCastRecallSpellButton", "spellId")
    if summon then defs[#defs + 1] = { kind = "spell", value = summon, label = "Call" } end
    if recall then defs[#defs + 1] = { kind = "spell", value = recall, label = "Recall" } end
    -- the game's secure "destroy totem" action on the earth slot (DestroyTotem
    -- itself is forbidden to addon code: seen 2026-10-18)
    defs[#defs + 1] = { kind = "destroytotem", value = earth, label = "X earth" }
    for i, d in ipairs(defs) do
        local t = testButtons[i]
        if not t then
            local b = CreateFrame("Button", nil, p.body, "SecureActionButtonTemplate")
            b:RegisterForClicks("AnyUp", "AnyDown")
            b:SetSize(36, 36)
            local icon = b:CreateTexture(nil, "ARTWORK")
            icon:SetAllPoints()
            local label = uiText(b, "micro", "ink")
            label:SetPoint("TOP", b, "BOTTOM", 0, -2)
            t = { button = b, icon = icon, label = label }
            testButtons[i] = t
        end
        local b = t.button
        b:SetPoint("TOPLEFT", (i - 1) * 40, 0)
        b:SetAttribute("type", d.kind)
        b:SetAttribute("action", nil)
        b:SetAttribute("spell", nil)
        if d.kind == "destroytotem" then
            b:SetAttribute("totem-slot", d.value)
            t.icon:SetColorTexture(0.5, 0.15, 0.1, 1)
        elseif d.kind == "multispell" then
            b:SetAttribute("action", d.action)
            b:SetAttribute("spell", d.value)
            local tex = iconOf(d)
            t.icon:SetTexture(asNumber(tex) or asString(tex) or 134400)
        else
            b:SetAttribute(d.kind, d.value)
            local tex = iconOf(d)
            t.icon:SetTexture(asNumber(tex) or asString(tex) or 134400)
        end
        t.label:SetValue(d.label)
        b:Show()
    end
    p:Show()
    for i = #defs + 1, #testButtons do testButtons[i].button:Hide() end
    print(("Totem probe: %d buttons: Spell casts the earth slot's totem as a spell, Act uses the slot's action, Pick puts another earth totem in the slot, X earth dismisses it. Click each, out of combat and in a fight."):format(#defs))
end

-- "/suu probe totems choose": puts another totem of the same element in the
-- first slot (SetMultiCastSpell, what the game's flyout calls), then puts
-- the old one back a second later. Works out of combat? In a fight?
export function choose(all: { [string]: unknown })
    local action = asNumber(firstSlotAction())
    local c: Map = { at = date("%H:%M:%S"), combat = InCombatLockdown() and true or false }
    all.choose = c
    if not action then c.result = "no slot action" print("Totem probe: no slot to choose for.") return end
    local _, before = GetActionInfo(action)
    c.action, c.before = action, tostring(before)
    -- the slot's element: the action's own totem slot from the game's button
    local slotButton = wf.asButton(tbl.field(_G, "MultiCastActionButton1", "slotButton"))
    local slot = slotButton and slotButton:GetID()
    local spells = slot and slotSpells(slot) or {}
    local other: unknown = nil
    for _, id in ipairs(spells) do if id ~= before then other = id break end end
    c.slot, c.other = tostring(slot), tostring(other)
    if other == nil then c.result = "only one totem known for that element" print("Totem probe: you know one totem of that element; nothing to swap to.") return end
    local setSpell = tbl.field(_G, "SetMultiCastSpell")
    c.set = call(setSpell, action, other)
    local _, now = GetActionInfo(action)
    c.after = tostring(now)
    after(1, function()
        c.restore = call(setSpell, action, before)
        local _, back = GetActionInfo(action)
        c.restored = tostring(back)
    end)
    print("Totem probe: swapped the first slot's totem and puts it back in a second. Watch the game's bar, then /suu probe totems check and /reload.")
end
