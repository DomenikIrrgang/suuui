-- Diagnostics/CampProbe.wowlua
-- "/suu probe camp": what Forever's campfires look like to an addon (step
-- 2.8). Saved in SuuUIProbe.camp on /reload.
--   * now: every global and C_ namespace whose name holds Camp, Fire, Tent
--     or Rest; your spells and bag items with those words (and their
--     cooldowns); your auras; resting and rested XP
--   * from now until /reload, a log: each aura you gain or lose (name,
--     spell, duration, source) with where you stood, resting changes,
--     system and emote chat lines, item and spell cooldown changes of the
--     camp things found, and blocked actions
--
--   /suu probe camp   sample and start the log; then walk up to a campfire,
--                     wait, sit (or kneel, lie down) for a minute until the
--                     benefits come, use any camp item or feature, walk
--                     away; then /reload

import isSecret from "wowlua:secret"
import * as DB from "/Core/DB"
import print from "/Core/Init"
import * as secret from "wowlua:secret"

-- What the probe saves in SuuUIProbe.camp.
type Camp = { log: string[], [string]: unknown }


local function show(v: unknown): string
    if isSecret(v) then return "secret" end
    if v == nil then return "nil" end
    if type(v) == "table" then
        local parts: string[] = {}
        for k, x in pairs(v) do
            parts[#parts + 1] = tostring(k) .. "=" .. (isSecret(x) and "secret" or (type(x) == "table" and "table" or tostring(x)))
        end
        table.sort(parts)
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local WORDS = { "camp", "fire", "tent", "rest", "cozy", "bonfire", "hearth" }

local function interesting(name: unknown): boolean
    if type(name) ~= "string" then return false end
    local l = name:lower()
    for _, w in ipairs(WORDS) do if l:find(w, 1, true) then return true end end
    return false
end

local store: Camp? = nil
local function note(s: string)
    local log = store and store.log
    if not log then return end
    log[#log + 1] = date("%H:%M:%S") .. (InCombatLockdown() and " [combat] " or " ") .. s
    while #log > 400 do table.remove(log, 1) end
end

local function where(): string
    local map = C_Map.GetBestMapForUnit("player")
    local pos = map and C_Map.GetPlayerMapPosition(map, "player")
    local x, y = nil, nil
    if pos then x, y = pos:GetXY() end
    return ("map %s %s,%s %s"):format(show(map), x and ("%.4f"):format(x) or "?", y and ("%.4f"):format(y) or "?",
        show(GetSubZoneText()) .. "/" .. show(GetZoneText()))
end

-- Your auras now: { [auraInstanceID] = "name (spell) dur src" }.
local function auras(): { [number]: string }
    local out: { [number]: string } = {}
    for _, filter in ipairs({ "HELPFUL", "HARMFUL" }) do
        for i = 1, 60 do
            local ok, a = pcall(C_UnitAuras.GetAuraDataByIndex, "player", i, filter)
            if not ok or not a or isSecret(a) then break end
            local id = secret.asNumber(a.auraInstanceID)
            if id then
                local expires = secret.asNumber(a.expirationTime)
                out[id] = ("%s %s (%s) dur=%s left=%s src=%s icon=%s stacks=%s"):format(filter, show(a.name), show(a.spellId),
                    show(a.duration), (expires and expires > 0) and ("%.0f"):format(expires - GetTime()) or "-",
                    show(a.sourceUnit), show(a.icon), show(a.applications))
            end
        end
    end
    return out
end

local function scanGlobals(): (string[], string[])
    local found: string[] = {}
    for k, v in pairs(_G) do
        if type(k) == "string" and interesting(k) and (type(v) == "function" or (type(v) == "table" and k:match("^C_"))) then
            found[#found + 1] = k .. " (" .. type(v) .. ")"
        end
    end
    table.sort(found)
    -- C_ namespaces with such functions
    local inner: string[] = {}
    for k, v in pairs(_G) do
        if type(k) == "string" and k:match("^C_") and type(v) == "table" then
            for fk, fv in pairs(v) do
                if type(fk) == "string" and type(fv) == "function" and interesting(fk) then inner[#inner + 1] = k .. "." .. fk end
            end
        end
    end
    table.sort(inner)
    return found, inner
end

local function scanSpells(): string[]
    local out: string[] = {}
    for line = 1, C_SpellBook.GetNumSpellBookSkillLines() do
        local info = C_SpellBook.GetSpellBookSkillLineInfo(line)
        local offset, count = info and secret.asNumber(info.itemIndexOffset), info and secret.asNumber(info.numSpellBookItems)
        if offset and count then
            for i = offset + 1, offset + count do
                local item = C_SpellBook.GetSpellBookItemInfo(i, Enum.SpellBookSpellBank.Player)
                if item and interesting(item.name) then
                    out[#out + 1] = ("%s (%s) %s"):format(show(item.name), show(item.spellID), show(item.itemType))
                end
            end
        end
    end
    return out
end

local campItems: { [number]: string } = {}
local function scanItems(): string[]
    local out: string[] = {}
    for bag = 0, 5 do
        for slot = 1, C_Container.GetContainerNumSlots(bag) do
            local info = C_Container.GetContainerItemInfo(bag, slot)
            local itemName, itemID = info and secret.asString(info.itemName), info and secret.asNumber(info.itemID)
            if info and itemName and itemID and interesting(itemName) then
                campItems[itemID] = itemName
                local s, d, e = C_Container.GetContainerItemCooldown(bag, slot)
                out[#out + 1] = ("%s (%s) bag %d slot %d cd=%s/%s/%s link=%s"):format(show(info.itemName), show(info.itemID), bag, slot,
                    show(s), show(d), show(e), show(info.hyperlink))
            end
        end
    end
    return out
end

local logging = false
local known: { [number]: string } = {}
local function startLog()
    if logging then return end
    logging = true
    known = auras()
    local f = CreateFrame("Frame")
    local valid = C_EventUtils.IsEventValid
    for _, e in ipairs({ "UNIT_AURA", "PLAYER_UPDATE_RESTING", "UPDATE_EXHAUSTION", "CHAT_MSG_SYSTEM", "CHAT_MSG_TEXT_EMOTE",
                         "CHAT_MSG_EMOTE", "BAG_UPDATE_COOLDOWN", "SPELL_UPDATE_COOLDOWN", "ADDON_ACTION_BLOCKED",
                         "ADDON_ACTION_FORBIDDEN", "UNIT_SPELLCAST_SUCCEEDED", "PLAYER_INTERACTION_MANAGER_FRAME_SHOW",
                         "ZONE_CHANGED", "ZONE_CHANGED_NEW_AREA" }) do
        if valid(e) then
            if e == "UNIT_AURA" or e == "UNIT_SPELLCAST_SUCCEEDED" then f:RegisterUnitEvent(e, "player") else f:RegisterEvent(e) end
        end
    end
    f:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown, c: unknown)
        if event == "UNIT_AURA" then
            local now = auras()
            for id, text in pairs(now) do
                if not known[id] then note("+ " .. text .. " @ " .. where()) end
            end
            for id, text in pairs(known) do
                if not now[id] then note("- " .. text .. " @ " .. where()) end
            end
            known = now
        elseif event == "PLAYER_UPDATE_RESTING" or event == "UPDATE_EXHAUSTION" then
            note(event .. " resting=" .. show(IsResting()) .. " restState=" .. show(GetRestState()) .. " rested=" .. show(GetXPExhaustion()) .. " @ " .. where())
        elseif event == "BAG_UPDATE_COOLDOWN" then
            for id, name in pairs(campItems) do
                local _s, cd = C_Container.GetItemCooldown(id)
                local d = secret.asNumber(cd)
                if d and d > 0 then note("item cooldown " .. name .. " " .. show(d)) end
            end
        elseif event == "SPELL_UPDATE_COOLDOWN" then
            -- quiet: only the camp spells found
        elseif event == "UNIT_SPELLCAST_SUCCEEDED" then
            local spellID = c
            local id = secret.asNumber(spellID)
            local name = id and C_Spell.GetSpellName(id)
            note("cast " .. show(name) .. " (" .. show(spellID) .. ") @ " .. where())
        else
            note(event .. " " .. show(a) .. " " .. show(b))
        end
    end)
end

export function sample()
    local s = DB.probeData("camp", function(): Camp return { log = {} } end)
    store = s
    s.at = date("%Y-%m-%d %H:%M:%S")
    local ok, g, c = pcall(scanGlobals)
    s.globals, s.cFunctions = ok and g or tostring(g), ok and c or nil
    local ok2, sp = pcall(scanSpells)
    s.spells = ok2 and sp or tostring(sp)
    local ok3, it = pcall(scanItems)
    s.items = ok3 and it or tostring(it)
    local now: string[] = {}
    for _, text in pairs(auras()) do now[#now + 1] = text end
    table.sort(now)
    s.aurasNow = now
    s.rest = { resting = show(IsResting()), state = show(GetRestState()), rested = show(GetXPExhaustion()), where = where() }
    s.log = s.log or {}
    startLog()
end

export function command()
    sample()
    print("Camp probe: sampled. Walk up to a campfire, wait, sit for a minute until the benefits come, use any camp item, walk away, then /reload.")
end
