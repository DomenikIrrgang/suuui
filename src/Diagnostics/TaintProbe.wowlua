-- Diagnostics/TaintProbe.wowlua
-- "/suu probe taint": which of the values Blizzard's Escape path reads were
-- last written by addon code (issecurevariable), and by whom. A value an
-- addon wrote taints the Blizzard code that reads it; in combat, Escape then
-- may not close windows ("Interface action failed", found in game with the
-- spells window). Saved in SuuUIProbe.taint; also printed.
-- (2026-10-20) Also what a bag slot's click reads before it uses the item
-- (ContainerFrameItemButton_OnClick: "Forbidden: UseContainerItem()" seen
-- once, not again). The scan is Core/TaintScan's: SuuUI's error log runs it
-- by itself (in every build) when the game refuses or blocks an action.

import print from "/Core/Init"
import * as DB from "/Core/DB"
import scan from "/Core/TaintScan"

export function command()
    local out = { at = date("%H:%M:%S"), combat = InCombatLockdown(), tainted = scan() }
    DB.probe.taint = out
    for i, line in ipairs(out.tainted) do
        if i <= 25 then
            print("Taint: " .. line)
        end
    end
    print(("Taint probe: %d values written by addon code. /reload to save."):format(#out.tainted))
end
