-- Diagnostics/Diagnostics.wowlua
-- The diagnostics module: /suu probe, /suu tokens and /suu gallery. The first built-in
-- module, written against the public API like any plugin.

import SuuUI from "/Core/API"
import * as probe from "/Diagnostics/Probe"
import * as tokenSheet from "/Diagnostics/TokenSheet"
import * as gallery from "/Diagnostics/Gallery"

SuuUI.RegisterModule({
    id = "diagnostics",
    name = "Diagnostics",
    description = "Developer tools: the client API probe, the design token sheet and the component gallery.",
    api = "0.2",
    defaults = {},
    OnEnable = function(self: any)
        self:RegisterCommand("probe", "Check which client APIs SuuUI depends on exist here; \"/suu probe show\" reopens the last report; \"/suu probe track\" tests the tracker.", probe.command, probe.TOPICS)
        self:RegisterCommand("tokens", "Show every design token colour and text style.", tokenSheet.toggle)
        self:RegisterCommand("gallery", "Show every SuuUI component built so far.", gallery.toggle)
    end,
    OnDisable = function()
        probe.hide()
        tokenSheet.hide()
        gallery.hide()
    end,
})
