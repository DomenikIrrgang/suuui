-- Diagnostics/LfgProbe.wowlua
-- "/suu probe lfg": what ForeverLFG (the group finder library: the game's
-- tool and the public chat channels as one list) can rely on.
--   The tool: its categories and activities (Dungeons, Quests & Zones,
--   Custom, ...) and their activities (per activity group, the game's
--   way), its functions, your own listing.
--   "/suu probe lfg timer" also searches from a timer, two seconds later:
--   blocked (ADDON_ACTION_BLOCKED, 2026-10-14), the tool can't refresh by
--   itself.
--   Chat: the channels you're in.
-- "/suu probe lfg click": a button; its click searches and saves your
-- listing again unchanged (is a click enough for both?).
-- "/suu probe lfg who": a button; its click sends a Who search the way
-- SuuUI's Who page would (C_FriendList.SendWho, restricted, with the
-- game's own filters) and records whether the game allowed it, the result
-- count, the first rows' fields (secret or not) and what the page uses.
-- "/suu probe lfg open": the next time the Group Finder opens (press I or
-- the micro menu), its opening searches the tool; records whether the game
-- allowed that (is opening the window a click enough?).
-- "/suu probe lfg join": joins LookingForGroup and takes it off every chat
-- window. "/suu probe lfg delist": a button whose click delists you.
-- "/suu probe lfg live": starts ForeverLFG and reports its events;
-- "/suu probe lfg entries": the merged list; "/suu probe lfg refresh [cat]":
-- a tool search (2 Dungeons, 116 Quests & Zones, 120 Custom).
-- "/suu probe lfg record": the public channels' messages (and say/yell),
-- as they arrive, with the channel, author, zone, whether you were in
-- combat or an instance and whether the text was secret; kept across
-- /reloads until "/suu probe lfg stop" (the parser is tuned on them).
-- Saved in SuuUIProbe.lfg on /reload; only on this computer.

import * as DB from "/Core/DB"
import print from "/Core/Init"
import lfg as foreverLFG from "foreverlfg"
import type ForeverLFG, Entry from "foreverlfg"
import onLogin from "wowlua:lifecycle"
import hookScript from "wowlua:hooks"
import isSecret, asNumber, asString from "wowlua:secret"
import after from "wowlua:timer"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"

type Record = { [string]: unknown }
-- The chat recorder: whether it's on, its lines, what arrived.
type Recorder = { on: boolean, lines: string[], since?: string, seen?: { [string]: number }, secret?: number }
-- What the probe saves in SuuUIProbe.lfg.
type Lfg = { record?: Recorder, live?: string[], categories?: Record[], channels?: string[], [string]: unknown }

-- the probe's buttons, and the open test's state (kept across runs)
local button: Button? = nil
local whoButton: Button? = nil
local delistButton: Button? = nil
local openArmed, openHooked = false, false

local MAX_LINES = 4000
local field = tbl.field

local function show(v: unknown): string
    if isSecret(v) then
        return "<secret>"
    end
    if type(v) ~= "table" then
        return tostring(v)
    end
    local parts: string[] = {}
    for k, x in pairs(v) do
        local s = isSecret(x) and "<secret>" or (type(x) == "table" and "{...}" or tostring(x))
        parts[#parts + 1] = tostring(k) .. "=" .. s
    end
    table.sort(parts)
    return "{" .. table.concat(parts, ", ") .. "}"
end

local function names(t: unknown): string[]
    local out: string[] = {}
    if type(t) ~= "table" then
        return out
    end
    for k, v in pairs(t) do
        if type(v) == "function" then
            out[#out + 1] = tostring(k)
        end
    end
    table.sort(out)
    return out
end

local function store(): Lfg
    return DB.probeData("lfg", function(): Lfg
        return {}
    end)
end

-- `fn(...)`, protected: whether it ran and its first three results.
local function attempt(fn: unknown, ...: unknown): (boolean, unknown, unknown, unknown)
    if type(fn) ~= "function" then
        return false, "missing", nil, nil
    end
    local ok, a, b, c = pcall(fn, ...)
    return ok, a, b, c
end

-- C_LFGList's function `name` (nil on a client without it).
local function L(name: string): unknown
    return field(C_LFGList, name)
end

-- The first category the tool offers.
local function firstCategory(): unknown
    local ok, cats = attempt(L("GetAvailableCategories"))
    return ok and tbl.list(cats)[1] or nil
end

-- what a search result holds (compact), and its member counts
local function result(id: unknown): string
    local ok, info = attempt(L("GetSearchResultInfo"), id)
    if not ok then
        return "error: " .. tostring(info)
    end
    if not info then
        return "nil"
    end
    if isSecret(info) then
        return "<secret table>"
    end
    local acts: string[] = {}
    local ids = field(info, "activityIDs")
    for _, a in ipairs(ids ~= nil and tbl.list(ids) or { field(info, "activityID") }) do
        acts[#acts + 1] = tostring(a)
    end
    local okC, counts = attempt(L("GetSearchResultMemberCounts"), id)
    local need = ""
    if okC and type(counts) == "table" and not isSecret(counts) then
        need = ("need T%s H%s D%s"):format(
            tostring(field(counts, "TANK_REMAINING")),
            tostring(field(counts, "HEALER_REMAINING")),
            tostring(field(counts, "DAMAGER_REMAINING"))
        )
    end
    return ("acts=%s leader=%s members=%s age=%s delisted=%s quest=%s name=%s comment=%s %s"):format(
        table.concat(acts, ","),
        show(field(info, "leaderName")),
        show(field(info, "numMembers")),
        show(field(info, "age")),
        show(field(info, "isDelisted")),
        show(field(info, "questID")),
        show(field(info, "name")),
        show(field(info, "comment")),
        need
    )
end

export function snapshot()
    local s = store()
    s.at = date("%Y-%m-%d %H:%M:%S")
    local lfg = C_LFGList
    s.functions = names(lfg)
    -- categories and their activities
    local categories: Record[] = {}
    s.categories = categories
    local okCats, cats = attempt(L("GetAvailableCategories"))
    for _, cat in ipairs(okCats and tbl.list(cats) or {}) do
        local okI, info = attempt(L("GetLfgCategoryInfo"), cat)
        local activities: string[], groupLines: string[] = {}, {}
        local entry: Record = {
            id = cat,
            info = show(okI and info or nil),
            activities = activities,
            groups = groupLines,
        }
        -- the game's way: per activity group, then the ones in none
        local acts: unknown[], seen: { [unknown]: boolean } = {}, {}
        local okG, groups = attempt(L("GetAvailableActivityGroups"), cat)
        for _, g in ipairs(okG and tbl.list(groups) or {}) do
            local okN, gname = attempt(L("GetActivityGroupInfo"), g)
            local okGA, ga = attempt(L("GetAvailableActivities"), cat, g)
            groupLines[#groupLines + 1] = ("%s %s: %d"):format(
                tostring(g),
                tostring(okN and gname),
                okGA and type(ga) == "table" and #tbl.list(ga) or -1
            )
            for _, a in ipairs(okGA and tbl.list(ga) or {}) do
                if not seen[a] then
                    seen[a] = true
                    acts[#acts + 1] = a
                end
            end
        end
        local okA, all = attempt(L("GetAvailableActivities"), cat, nil)
        entry.ungroupedCall = okA and type(all) == "table" and #tbl.list(all) or ("error: " .. tostring(all))
        for _, a in ipairs(okA and tbl.list(all) or {}) do
            if not seen[a] then
                seen[a] = true
                acts[#acts + 1] = a
            end
        end
        for i, a in ipairs(acts) do
            if i > 120 then
                activities[#activities + 1] = "... " .. #acts .. " in all"
                break
            end
            local okT, t = attempt(L("GetActivityInfoTable"), a)
            if okT and type(t) == "table" then
                activities[#activities + 1] = ("%s %s lvl %s-%s max %s group %s"):format(
                    tostring(a),
                    tostring(field(t, "fullName")),
                    tostring(field(t, "minLevel")),
                    tostring(field(t, "maxLevelSuggestion")),
                    tostring(field(t, "maxNumPlayers")),
                    tostring(field(t, "groupFinderActivityGroupID"))
                )
            else
                activities[#activities + 1] = tostring(a)
            end
        end
        categories[#categories + 1] = entry
    end
    -- your own listing
    local okE, entry = attempt(L("GetActiveEntryInfo"))
    s.ownListing = okE and show(entry) or ("error: " .. tostring(entry))
    local ownIDs = field(entry, "activityIDs")
    if okE and type(entry) == "table" and not isSecret(entry) and ownIDs then
        s.ownActivities = show(ownIDs)
    end
    local okR, a, b, c = attempt(tbl.field(_G, "GetLFGRoles"))
    s.ownRoles = okR and
        ("leader=%s tank=%s healer=%s dps=%s"):format(
            tostring(a),
            tostring(b),
            tostring(c),
            tostring(select(4, GetLFGRoles()))
        ) or
        "no GetLFGRoles"
    -- the chat channels you're in
    local serverChannels: string[] = {}
    s.serverChannels = serverChannels
    local enumerate = tbl.field(_G, "EnumerateServerChannels")
    if type(enumerate) == "function" then
        for _, name in ipairs({ enumerate() }) do
            serverChannels[#serverChannels + 1] = tostring(name)
        end
    end
    local okL, lfgIndex, lfgName = attempt(GetChannelName, "LookingForGroup")
    s.lookingForGroupJoined = okL and (tostring(lfgIndex) .. " " .. tostring(lfgName)) or "error"
    local channels: string[] = {}
    s.channels = channels
    local list = { GetChannelList() }
    for i = 1, #list, 3 do
        channels[#channels + 1] = ("%s %s%s"):format(
            tostring(list[i]),
            tostring(list[i + 1]),
            list[i + 2] and " (disabled)" or ""
        )
    end
end

-- A search from a timer: nothing you pressed behind it.
export function timerSearch()
    local s = store()
    local cat = firstCategory()
    local blocked: string[] = {}
    local t: Record = { category = tostring(cat), blocked = blocked }
    s.timerSearch = t
    if cat == nil then
        return
    end
    local f = CreateFrame("Frame")
    for _, e in ipairs({
        "LFG_LIST_SEARCH_RESULTS_RECEIVED",
        "LFG_LIST_SEARCH_FAILED",
        "ADDON_ACTION_BLOCKED",
        "ADDON_ACTION_FORBIDDEN",
    }) do
        f:RegisterEvent(e)
    end
    f:SetScript("OnEvent", function(self, event: string, a1: unknown, a2: unknown)
        if event == "ADDON_ACTION_BLOCKED" or event == "ADDON_ACTION_FORBIDDEN" then
            blocked[#blocked + 1] = event .. " " .. tostring(a1) .. " " .. tostring(a2)
            return
        end
        self:UnregisterAllEvents()
        t.event = event
        local okR, count, ids = attempt(L("GetSearchResults"))
        local countText = okR and show(count) or ("error: " .. tostring(count))
        t.count = countText
        local results: string[] = {}
        t.results = results
        for i, id in ipairs(okR and tbl.list(ids) or {}) do
            if i > 25 then
                break
            end
            results[i] = result(id)
        end
        print(
            ("LFG probe: the timer's search %s (%s results); /reload."):format(
                event == "LFG_LIST_SEARCH_FAILED" and "failed" or "came back",
                countText
            )
        )
    end)
    after(2, function()
        local ok, err = attempt(L("Search"), cat)
        t.call = ok and "called" or ("error: " .. tostring(err))
        after(10, function()
            if not t.event then
                f:UnregisterAllEvents()
                t.event = "nothing came back in 10 seconds"
                print("LFG probe: the timer's search got no answer (saved); /reload.")
            end
        end)
    end)
end

-- A click: a search, and your listing saved again unchanged (only if you
-- have one), each with the game's verdict.
export function clickTest()
    local s = store()
    local events: string[] = {}
    local t: Record = { blocked = events }
    s.clickTest = t
    local f = CreateFrame("Frame")
    for _, e in ipairs({
        "LFG_LIST_SEARCH_RESULTS_RECEIVED",
        "LFG_LIST_SEARCH_FAILED",
        "LFG_LIST_ACTIVE_ENTRY_UPDATE",
        "ADDON_ACTION_BLOCKED",
        "ADDON_ACTION_FORBIDDEN",
    }) do
        f:RegisterEvent(e)
    end
    f:SetScript("OnEvent", function(_, event: string, a1: unknown, a2: unknown)
        events[#events + 1] = date("%H:%M:%S ") .. event .. " " .. tostring(a1) .. " " .. tostring(a2)
        if event == "LFG_LIST_SEARCH_RESULTS_RECEIVED" then
            local okR, count = attempt(L("GetSearchResults"))
            t.count = okR and show(count) or "error"
        end
    end)
    local b = button or CreateFrame("Button", nil, UIParent, "UIPanelButtonTemplate")
    button = b
    b:SetSize(320, 30)
    b:ClearAllPoints()
    b:SetPoint("CENTER", UIParent, "CENTER", 0, 160)
    b:SetFrameStrata("DIALOG")
    b:SetText("LFG probe: click to search and re-save your listing")
    b:SetScript("OnClick", function(self)
        local ok, err = attempt(L("Search"), firstCategory(), 0, 0, nil, false, nil, nil)
        t.search = ok and "called" or ("error: " .. tostring(err))
        local okE, entry = attempt(L("GetActiveEntryInfo"))
        if okE and type(entry) == "table" and not isSecret(entry) then
            local okU, errU = attempt(L("UpdateListing"), {
                activityIDs = field(entry, "activityIDs"),
                newPlayerFriendly = field(entry, "newPlayerFriendly"),
                voiceMode = field(entry, "voiceMode"),
            })
            t.update = okU and "called" or ("error: " .. tostring(errU))
        else
            t.update = "no listing: skipped"
        end
        self:Hide()
        after(5, function()
            f:UnregisterAllEvents()
            print("LFG probe: click test done; /reload.")
        end)
    end)
    b:Show()
    print("LFG probe: click the button at the top of the screen once.")
end

-- Searching the tool as the Group Finder opens.
local openTestRecord: Record? = nil

export function openTest()
    local s = store()
    local events: string[] = {}
    local t: Record = { armed = date("%H:%M:%S"), events = events }
    s.openTest = t
    openTestRecord = t
    local f = CreateFrame("Frame")
    for _, e in ipairs({
        "LFG_LIST_SEARCH_RESULTS_RECEIVED",
        "LFG_LIST_SEARCH_FAILED",
        "ADDON_ACTION_BLOCKED",
        "ADDON_ACTION_FORBIDDEN",
    }) do
        f:RegisterEvent(e)
    end
    f:SetScript("OnEvent", function(_, event: string, a1: unknown, a2: unknown)
        if not t.opened then
            return
        end
        events[#events + 1] = date("%H:%M:%S ") .. event .. " " .. tostring(a1) .. " " .. tostring(a2)
    end)
    local parent = wf.find("LFGParentFrame")
    if not parent then
        t.result = "no LFGParentFrame (open the Group Finder once, then run this again)"
        print("LFG probe: open the Group Finder once first, then run it again.")
        return
    end
    openArmed = true
    if not openHooked then
        openHooked = true
        hookScript(parent, "OnShow", function()
            if not openArmed then
                return
            end
            openArmed = false
            local tt = openTestRecord
            if not tt then
                return
            end
            tt.opened = date("%H:%M:%S")
            local ok, err = attempt(L("Search"), firstCategory(), 0, 0, nil, false, nil, nil)
            tt.search = ok and "called" or ("error: " .. tostring(err))
            after(4, function()
                print("LFG probe: open test done; /reload.")
            end)
        end)
    end
    print("LFG probe: now open the Group Finder (press I or use the micro menu).")
end

-- The Who search from a click (stage 5).
export function whoTest()
    local s = store()
    local fl: unknown = C_FriendList
    local blocked: string[] = {}
    local t: Record = { blocked = blocked, at = date("%H:%M:%S") }
    s.who = t
    local api: { [string]: boolean } = {}
    t.api = api
    for _, n in ipairs({
        "SendWho",
        "GetNumWhoResults",
        "GetWhoInfo",
        "SetWhoToUi",
        "SortWho",
        "GetWhoRaceFilters",
        "AddFriend",
    }) do
        api[n] = type(field(fl, n)) == "function"
    end
    for _, n in ipairs({
        "LFGWhoListFrame",
        "LFGWhoListFilterUtil",
        "FriendsFrame_ShowDropdown",
        "UnitPopupSharedUtil",
    }) do
        api[n] = field(_G, n) ~= nil
    end
    local filterUtil = field(_G, "LFGWhoListFilterUtil")
    local okF, filters = attempt(field(filterUtil, "GetWhoFilters"))
    if okF and filters then
        t.filters = {
            classIDs = #tbl.list(field(filters, "classIDs")),
            raceIDs = #tbl.list(field(filters, "raceIDs")),
            uiMapIDs = #tbl.list(field(filters, "uiMapIDs")),
        }
    else
        t.filters = "none"
    end
    local f = CreateFrame("Frame")
    for _, e in ipairs({ "WHO_LIST_UPDATE", "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN", "CHAT_MSG_SYSTEM" }) do
        f:RegisterEvent(e)
    end
    local system: string[] = {}
    f:SetScript("OnEvent", function(_, event: string, a1: unknown, a2: unknown)
        if event == "WHO_LIST_UPDATE" then
            local okN, num, total = attempt(field(fl, "GetNumWhoResults"))
            t.count = okN and (show(num) .. " of " .. show(total)) or "error"
            local rows: string[] = {}
            t.rows = rows
            for i = 1, math.min(3, okN and asNumber(num) or 0) do
                local ok, info = attempt(field(fl, "GetWhoInfo"), i)
                rows[i] = ok and show(info) or ("error: " .. tostring(info))
            end
        elseif event == "CHAT_MSG_SYSTEM" then
            t.system = system
            if #system < 5 then
                system[#system + 1] = show(a1)
            end
        else
            blocked[#blocked + 1] = date("%H:%M:%S ") .. event .. " " .. tostring(a1) .. " " .. tostring(a2)
        end
    end)
    local b = whoButton or CreateFrame("Button", nil, UIParent, "UIPanelButtonTemplate")
    whoButton = b
    b:SetSize(320, 30)
    b:ClearAllPoints()
    b:SetPoint("CENTER", UIParent, "CENTER", 0, 160)
    b:SetFrameStrata("DIALOG")
    b:SetText("Who probe: click to search (levels 1-60)")
    b:SetScript("OnClick", function(self)
        -- the results to the UI (as the game's Who page asks), not to chat
        attempt(field(fl, "SetWhoToUi"), true)
        local origin = field(Enum, "SocialWhoOrigin", "Social")
        local ok, err = attempt(field(fl, "SendWho"), "1-60", origin, filters)
        t.send = ok and "called" or ("error: " .. tostring(err))
        self:Hide()
        after(6, function()
            f:UnregisterAllEvents()
            print("Who probe: done; /reload.")
        end)
    end)
    b:Show()
    print("Who probe: click the button at the top of the screen once.")
end

-- Watch for the game's verdict on what follows.
local function verdicts(list: string[], seconds: number?)
    local f = CreateFrame("Frame")
    for _, e in ipairs({
        "ADDON_ACTION_BLOCKED",
        "ADDON_ACTION_FORBIDDEN",
        "CHANNEL_UI_UPDATE",
        "CHAT_MSG_CHANNEL_NOTICE",
        "LFG_LIST_ACTIVE_ENTRY_UPDATE",
    }) do
        f:RegisterEvent(e)
    end
    f:SetScript("OnEvent", function(_, event: string, a1: unknown, a2: unknown)
        list[#list + 1] = date("%H:%M:%S ") .. event .. " " .. tostring(a1) .. " " .. tostring(a2)
    end)
    after(seconds or 5, function()
        f:UnregisterAllEvents()
    end)
end

local function windowsWith(channel: string): number[]
    local out: number[] = {}
    for i = 1, asNumber(field(_G, "NUM_CHAT_WINDOWS")) or 10 do
        local list = { GetChatWindowChannels(i) }
        for j = 1, #list, 2 do
            local name = asString(list[j])
            if name and name:lower() == channel:lower() then
                out[#out + 1] = i
            end
        end
    end
    return out
end

-- Join LookingForGroup (from your command), then take it off every chat
-- window: can the library read it without it showing in chat?
export function join()
    local s = store()
    local events: string[] = {}
    local t: Record = { events = events }
    s.join = t
    verdicts(events, 6)
    local ok, err = attempt(field(_G, "JoinChannelByName"), "LookingForGroup")
    t.call = ok and "called" or ("error: " .. tostring(err))
    after(1.5, function()
        local okN, index, name = attempt(GetChannelName, "LookingForGroup")
        local joined = okN and (tostring(index) .. " " .. tostring(name)) or "error"
        t.joined = joined
        local before = windowsWith("LookingForGroup")
        local windowsBefore = table.concat(before, ",")
        t.windowsBefore = windowsBefore
        for _, i in ipairs(before) do
            local cf = wf.find("ChatFrame" .. i)
            local remove = field(cf, "RemoveChannel")
            if cf and remove then
                local okR, errR = attempt(remove, cf, "LookingForGroup")
                t["remove" .. i] = okR and "called" or ("error: " .. tostring(errR))
            end
        end
        after(1, function()
            local windowsAfter = table.concat(windowsWith("LookingForGroup"), ",")
            t.windowsAfter = windowsAfter
            print(
                ("LFG probe: LookingForGroup %s, on windows %s, after removing: %s; /reload."):format(
                    joined,
                    windowsBefore ~= "" and windowsBefore or "none",
                    windowsAfter ~= "" and windowsAfter or "none"
                )
            )
        end)
    end)
end

-- Leave LookingForGroup, then join it again from a timer (nothing you
-- pressed behind it, as the library would at login).
export function timerJoin()
    local s = store()
    local events: string[] = {}
    local t: Record = { events = events }
    s.timerJoin = t
    verdicts(events, 8)
    attempt(field(_G, "LeaveChannelByName"), "LookingForGroup")
    after(3, function()
        local ok, err = attempt(field(_G, "JoinChannelByName"), "LookingForGroup")
        t.call = ok and "called" or ("error: " .. tostring(err))
        after(2, function()
            local okN, index, name = attempt(GetChannelName, "LookingForGroup")
            local joined = okN and (tostring(index) .. " " .. tostring(name)) or "error"
            local windows = table.concat(windowsWith("LookingForGroup"), ",")
            t.joined, t.windows = joined, windows
            print(
                ("LFG probe: joined from a timer: %s (windows %s); /reload."):format(
                    joined,
                    windows ~= "" and windows or "none"
                )
            )
        end)
    end)
end

-- A button whose click removes your listing (you're delisted).
export function delist()
    local s = store()
    local events: string[] = {}
    local t: Record = { events = events }
    s.delist = t
    local okH, has = attempt(L("HasActiveEntryInfo"))
    local listedBefore = okH and tostring(has) or "error"
    t.listedBefore = listedBefore
    local b = delistButton or CreateFrame("Button", nil, UIParent, "UIPanelButtonTemplate")
    delistButton = b
    b:SetSize(320, 30)
    b:ClearAllPoints()
    b:SetPoint("CENTER", UIParent, "CENTER", 0, 160)
    b:SetFrameStrata("DIALOG")
    b:SetText("LFG probe: click to delist yourself")
    b:SetScript("OnClick", function(self)
        verdicts(events, 4)
        local ok, err = attempt(L("RemoveListing"))
        t.call = ok and "called" or ("error: " .. tostring(err))
        self:Hide()
        after(2, function()
            local okA, listed = attempt(L("HasActiveEntryInfo"))
            local listedAfter = okA and tostring(listed) or "error"
            t.listedAfter = listedAfter
            print(("LFG probe: listed before %s, after %s; /reload."):format(listedBefore, listedAfter))
        end)
    end)
    b:Show()
    print("LFG probe: click the button at the top of the screen to delist yourself.")
end

-- Forever's language preference (its "preferred play settings", which
-- shard players by language): what an addon can read of it, plus the
-- client's own locale and the tool's language filters.
export function lang()
    local s = store()
    local t: Record = {}
    s.lang = t
    t.clientLocale = tostring(GetLocale())
    local acc = field(_G, "C_AccountServices")
    t.api = acc and "C_AccountServices" or "missing"
    local function read(label: string)
        if not acc then
            return
        end
        local settings = { attempt(field(acc, "GetPreferredPlaySettings")) }
        local ok, loaded, localeID, dcID, localeDate, cooldown = settings[1],
            settings[2],
            settings[3],
            settings[4],
            settings[5],
            settings[7]
        t[label] = ok and
            ("loaded=%s locale=%s datacenter=%s localeChanged=%s cooldownDays=%s"):format(
                tostring(loaded),
                tostring(localeID),
                tostring(dcID),
                tostring(localeDate),
                tostring(cooldown)
            ) or
            ("error: " .. tostring(loaded))
    end
    read("before")
    if acc then
        local okL, ids, localeNames = attempt(field(acc, "GetPreferredLocales"))
        local locales: string[] = {}
        t.locales = locales
        if okL and type(ids) == "table" then
            for i, id in ipairs(tbl.list(ids)) do
                locales[#locales + 1] = tostring(id) .. " " .. tostring(tbl.list(localeNames)[i])
            end
        else
            locales[1] = "error: " .. tostring(ids)
        end
        local okD, dids, dnames = attempt(field(acc, "GetPreferredDatacenterLocalities"))
        local datacenters: string[] = {}
        t.datacenters = datacenters
        for i, id in ipairs(okD and tbl.list(dids) or {}) do
            datacenters[#datacenters + 1] = tostring(id) .. " " .. tostring(tbl.list(dnames)[i])
        end
        local okF, canLocale, canDC = attempt(field(acc, "GetPreferredPlaySettingsFeatures"))
        t.features = okF and
            ("canChangeLocale=%s canChangeDatacenter=%s"):format(tostring(canLocale), tostring(canDC)) or
            "error"
    end
    -- the tool's language filters
    for _, fn in ipairs({
        "GetLanguageSearchFilter",
        "GetDefaultLanguageSearchFilter",
        "GetAvailableLanguageSearchFilter",
    }) do
        local ok, v = attempt(L(fn))
        t[fn] = ok and show(v) or ("error: " .. tostring(v))
    end
    -- ask for it, and read again when it comes
    local f = CreateFrame("Frame")
    f:RegisterEvent("PREFERRED_PLAY_SETTINGS_UPDATED")
    f:SetScript("OnEvent", function(self)
        self:UnregisterAllEvents()
        t.event = "PREFERRED_PLAY_SETTINGS_UPDATED"
        read("after")
        print("LFG probe: language preference read; /reload.")
    end)
    local request = field(acc, "RequestPreferredPlaySettings")
    if request then
        local ok, started = attempt(request)
        t.request = ok and tostring(started) or ("error: " .. tostring(started))
    end
    after(6, function()
        if not t.event then
            f:UnregisterAllEvents()
            read("after6s")
            print("LFG probe: language preference: no event in 6 seconds (saved); /reload.")
        end
    end)
end

-- The library live (until the Group Finder module starts it): its events
-- in chat (short) and in SuuUIProbe.lfg.live (all), the merged list on
-- request, a tool search from your command.
local liveHooked = false
export function live()
    local LFG: ForeverLFG = foreverLFG
    local s = store()
    local log = s.live or {}
    s.live = log
    local function note(text: string, loud: boolean)
        log[#log + 1] = date("%H:%M:%S ") .. text
        while #log > 2000 do
            table.remove(log, 1)
        end
        if loud then
            print("LFG: " .. text)
        end
    end
    local function describe(e: Entry): string
        local roles: string[] = {}
        for side, set in pairs(e.roles) do
            if type(set) == "table" then
                for role, v in pairs(set) do
                    roles[#roles + 1] = side:sub(1, 1) .. ":" .. tostring(role) .. (type(v) == "number" and v or "")
                end
            end
        end
        local src: string[] = {}
        for k in pairs(e.sources) do
            src[#src + 1] = k
        end
        table.sort(src)
        return ("%s [%s] %s %s roles %s need %s (%s) conf %.2f \"%s\""):format(
            e.key,
            table.concat(src, "+"),
            e.intent or "?",
            table.concat(e.activities, ","),
            table.concat(roles, " "),
            tostring(e.need),
            e.leader.class or "?",
            e.confidence,
            e.text:sub(1, 60)
        )
    end
    if not liveHooked then
        liveHooked = true
        LFG.On("EntryAdded", function(e)
            note("added " .. describe(e), false)
        end)
        LFG.On("EntryUpdated", function(e)
            note("updated " .. describe(e), false)
        end)
        LFG.On("EntryRemoved", function(e, why)
            note("removed " .. e.key .. " (" .. tostring(why) .. ")", false)
        end)
        LFG.On("Match", function(e, reasons)
            note("MATCH " .. table.concat(reasons, ",") .. ": " .. describe(e), true)
        end)
        LFG.On("ToolSearched", function(cat, n)
            note("tool searched " .. tostring(cat) .. ": " .. tostring(n), true)
        end)
        LFG.On("ToolSearchFailed", function(cat)
            note("tool search failed " .. tostring(cat), true)
        end)
        LFG.On("ToolStale", function(cat, age)
            note("tool stale " .. tostring(cat) .. " age " .. tostring(age and math.floor(age)), true)
        end)
        LFG.On("ListingChanged", function(l)
            note("listing " .. (l and table.concat(l.activities, ",") or "none"), true)
        end)
        LFG.On("ListingExpiring", function(left)
            note("listing runs out in " .. tostring(left), true)
        end)
        LFG.On("Delisted", function()
            note("delisted", true)
        end)
        LFG.On("Contacted", function(e, what)
            note("contacted " .. e.key .. ": " .. what, true)
        end)
    end
    LFG.Start()
    note(("started: languages %s"):format(table.concat(LFG.Languages(), ",")), true)
end

export function entries()
    local LFG: ForeverLFG = foreverLFG
    local list = LFG.Entries()
    local st = LFG.Chat.stats
    local lastError = LFG.Chat.lastError
    print(
        ("LFG: %d entries; chat lines seen %d, secret %d, channel off %d, not group %d, low confidence %d, entries %d, errors %d%s"):format(
            #list,
            st.seen or 0,
            st.secret or 0,
            st.channelOff or 0,
            st.nothing or 0,
            st.lowConfidence or 0,
            st.entries or 0,
            st.errors or 0,
            lastError and (" (" .. lastError .. ")") or ""
        )
    )
    for i, e in ipairs(list) do
        if i > 15 then
            print("...")
            break
        end
        local src: string[] = {}
        for k in pairs(e.sources) do
            src[#src + 1] = k
        end
        print(
            ("  %s [%s] %s %s need %s"):format(
                e.key,
                table.concat(src, "+"),
                e.intent or "?",
                table.concat(e.activities, ","),
                tostring(e.need)
            )
        )
    end
end

-- The recorder: public chat as it arrives.
local recorder: Frame? = nil
local CHAT_EVENTS = { "CHAT_MSG_CHANNEL", "CHAT_MSG_SAY", "CHAT_MSG_YELL" }

local function recordLine(
    event: string,
    text: unknown,
    author: unknown,
    _: unknown,
    channelName: unknown,
    _: unknown,
    _: unknown,
    _: unknown,
    _: unknown,
    channelBase: unknown
)
    local r = store().record
    if not (r and r.on) then
        return
    end
    -- every event that arrives, saved or not
    local seen = r.seen or {}
    r.seen = seen
    seen[event] = (seen[event] or 0) + 1
    local inInstance, kind = IsInInstance()
    local line = {
        date("%H:%M:%S"),
        event == "CHAT_MSG_CHANNEL" and
            (isSecret(channelBase) and "<secret>" or tostring(channelBase or channelName)) or
            event:sub(10):lower(),
        isSecret(author) and "<secret>" or tostring(author),
        isSecret(text) and "<secret>" or tostring(text),
        (InCombatLockdown() and "combat " or "") ..
            (inInstance and (tostring(kind) .. " ") or "") .. tostring(GetZoneText()),
    }
    table.insert(r.lines, table.concat(line, " | "))
    if isSecret(text) then
        r.secret = (r.secret or 0) + 1
    end
    while #r.lines > MAX_LINES do
        table.remove(r.lines, 1)
    end
end

local function arm()
    if recorder then
        return
    end
    local f = CreateFrame("Frame")
    recorder = f
    for _, e in ipairs(CHAT_EVENTS) do
        f:RegisterEvent(e)
    end
    f:SetScript("OnEvent", function(_, event: string, ...: unknown)
        recordLine(event, ...)
    end)
end

export function record(on: boolean)
    local s = store()
    local r = s.record or { on = false, lines = {} }
    s.record = r
    r.on = on and true or false
    if on then
        r.since = r.since or date("%Y-%m-%d %H:%M:%S")
        arm()
        print(
            ("LFG recorder: on (%d lines so far); it keeps recording after /reload until \"/suu probe lfg stop\"."):format(
                #r.lines
            )
        )
    else
        if recorder then
            recorder:UnregisterAllEvents()
        end
        print(("LFG recorder: off, %d lines kept; /reload to save them."):format(#r.lines))
    end
end

-- after a /reload: recording again if it was on
@onLogin
local function resume()
    if tbl.field(DB.probe, "lfg", "record", "on") then
        arm()
    end
end

export function command(arg: string?)
    local rest = (arg or ""):lower()
    if rest == "record" then
        record(true)
        return
    end
    if rest == "stop" then
        record(false)
        return
    end
    if rest == "click" then
        clickTest()
        return
    end
    if rest == "who" then
        whoTest()
        return
    end
    if rest == "open" then
        openTest()
        return
    end
    if rest == "join" then
        join()
        return
    end
    if rest == "timerjoin" then
        timerJoin()
        return
    end
    if rest == "lang" then
        lang()
        return
    end
    if rest == "live" then
        live()
        return
    end
    if rest == "entries" then
        entries()
        return
    end
    local cat = rest:match("^refresh ?(%d*)$")
    if cat then
        local LFG: ForeverLFG = foreverLFG
        local ok = LFG.Refresh(tonumber(cat))
        print("LFG: searching the tool " .. (ok and "" or "(failed) ") .. (cat ~= "" and cat or "2"))
        return
    end
    if rest == "delist" then
        delist()
        return
    end
    if rest == "clear" then
        local s = store()
        local r = s.record
        s.record = { lines = {}, on = r and r.on or false }
        print("LFG recorder: lines cleared.")
        return
    end
    snapshot()
    if rest == "timer" then
        timerSearch()
    end
    local s = store()
    print(("LFG probe: %d categories, %d channels saved; /reload."):format(#(s.categories or {}), #(s.channels or {})))
end
