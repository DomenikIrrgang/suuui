-- Diagnostics/MeterProbe.wowlua
-- "/suu probe meter": what Forever's damage meter API gives an addon (plan
-- step 1.12), before SuuUI builds its own meter on it. Once: the client's
-- documentation of C_DamageMeter and C_DeathRecap (functions, events,
-- tables), the globals named like the Blizzard meter, and the event names
-- found there (registered, counted while armed). Per sample: available
-- sessions, each session type's duration, and for every meter type the
-- session's shape (each field readable, secret or missing; the first sources
-- in full, the list's count), plus one source's spell breakdown and a death
-- recap if there is one. One sample now; while armed, 2 and 6 seconds into
-- each fight and after it. Saved in SuuUIProbe.meter on /reload.
--
--   /suu probe meter        arm and sample now (hit something for a while first)
--   /suu probe meter off    stop sampling

import isSecret from "wowlua:secret"
import after from "wowlua:timer"
import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as Events from "/Core/Events"
import * as apiDocs from "/Diagnostics/ApiDocs"
import * as tbl from "wowlua:table"

type Map = { [unknown]: unknown }

local function isSecretTable(v: unknown): boolean
    return type(v) == "table" and issecrettable(v) == true
end
-- What the probe saves in SuuUIProbe.meter.
type Meter = { samples: Map[], [string]: unknown }
local field = tbl.field

local function store(): Meter
    return DB.probeData("meter", function(): Meter return { samples = {} } end)
end
local MAX_SAMPLES = 10
local armed = false
local eventFrame: Frame? = nil
local eventCounts: { [string]: number }? = nil
local eventPayloads: Map? = nil

-- owns the fight listeners (was the probe's table)
local OWNER = {}

-- A value's shape: "secret", "nil", "<type>: <value>" for plain ones, and
-- tables as tables of shapes (lists: the count and the first two items).
local function shape(v: unknown, depth: number?): unknown
    depth = depth or 0
    if isSecret(v) then return "secret" end
    if v == nil then return "nil" end
    if type(v) ~= "table" then return type(v) .. ": " .. tostring(v):sub(1, 60) end
    if isSecretTable(v) then return "secret table" end
    if depth >= 4 then return "table (deeper)" end
    local out: Map, n = {}, 0
    local count = #v
    if count > 0 then out["#"] = count end
    for k, x in pairs(v) do
        n = n + 1
        if n > 40 then out["…"] = "more fields" break end
        if not (type(k) == "number" and k > 2) then
            out[tostring(k)] = shape(x, depth + 1)
        end
    end
    return out
end

local function call(fn: unknown, ...: unknown): unknown
    if type(fn) ~= "function" then return "missing" end
    local ok, a, b = pcall(fn, ...)
    if not ok then return "error: " .. tostring(a):sub(1, 160) end
    if b ~= nil or isSecret(b) then return { shape(a), shape(b) } end
    return shape(a)
end

-- `fn(...)`'s first result as it is (false and the error when it raises).
local function attempt(fn: unknown, ...: unknown): (boolean, unknown)
    if type(fn) ~= "function" then return false, "missing" end
    return pcall(fn, ...)
end

-- The documentation: functions, events and tables of the meter and death recap.
local function docs(): unknown
    local lines, err = apiDocs.dump({ "damagemeter", "deathrecap" })
    return lines or err
end

-- Event names from the documentation (DAMAGE_METER…, DEATH_RECAP…).
local function eventNames(): string[]
    local names: string[] = {}
    for _, sys in ipairs(tbl.list(field(_G, "APIDocumentation", "systems"))) do
        for _, e in ipairs(tbl.list(field(sys, "Events"))) do
            local n = field(e, "LiteralName")
            if type(n) == "string" and (n:find("DAMAGE_METER") or n:find("DEATH_RECAP") or n:find("COMBAT_SESSION")) then
                names[#names + 1] = n
            end
        end
    end
    return names
end

local function watchEvents(): string[]?
    if eventFrame then return nil end
    local f = CreateFrame("Frame")
    eventFrame = f
    local counts: { [string]: number }, payloads: Map = {}, {}
    eventCounts, eventPayloads = counts, payloads
    local registered: string[] = {}
    for _, n in ipairs(eventNames()) do
        if pcall(f.RegisterEvent, f, n) then registered[#registered + 1] = n end
    end
    f:SetScript("OnEvent", function(_, event: string, ...: unknown)
        counts[event] = (counts[event] or 0) + 1
        if not payloads[event] then payloads[event] = shape({ ... }) end
    end)
    return registered
end

-- Globals named like the Blizzard meter (frames, mixins, tables).
local function globals(): { [string]: string }
    local out: { [string]: string } = {}
    for k, v in pairs(_G) do
        if type(k) == "string" and k:find("DamageMeter") then
            local t = type(v)
            if t == "table" and field(v, "GetObjectType") then
                local ok, ot = attempt(field(v, "GetObjectType"), v)
                t = ok and ("frame " .. tostring(ot)) or "frame?"
                local okShown, shown = attempt(field(v, "IsShown"), v)
                if okShown then t = t .. (shown and ", shown" or ", hidden") end
            end
            out[k] = t
        end
    end
    return out
end

type MeterType = { name: string, value: number }

local function meterTypes(): MeterType[]
    local list: MeterType[] = {}
    for name, value in pairs(Enum.DamageMeterType) do list[#list + 1] = { name = name, value = value } end
    table.sort(list, function(a: MeterType, b: MeterType): boolean return a.value < b.value end)
    return list
end

export function sample(label: string?): Map
    local DM: unknown = field(_G, "C_DamageMeter")
    local ST: unknown = field(Enum, "DamageMeterSessionType")
    local current, overall = field(ST, "Current"), field(ST, "Overall")
    local damageDone, deathsType = Enum.DamageMeterType.DamageDone, Enum.DamageMeterType.Deaths
    local s: Map = {
        at = date("%H:%M:%S"), label = label,
        combat = InCombatLockdown() and "in combat" or "out of combat",
        instance = select(2, IsInInstance()) or "none",
        group = IsInRaid() and "raid" or (IsInGroup() and "party" or "solo"),
    }
    if DM == nil then
        s.error = "no C_DamageMeter"
    else
        s.available = call(field(DM, "IsDamageMeterAvailable"))
        s.sessions = call(field(DM, "GetAvailableCombatSessions"))
        local duration: { [unknown]: unknown } = {}
        s.duration = duration
        if type(ST) == "table" then
            for name, v in pairs(ST) do duration[name] = call(field(DM, "GetSessionDurationSeconds"), v) end
        end
        -- every meter type of the current and the overall session
        local currentTypes: { [string]: unknown }, overallTypes: { [string]: unknown } = {}, {}
        s.current, s.overall = currentTypes, overallTypes
        local fromType = field(DM, "GetCombatSessionFromType")
        for _, mt in ipairs(meterTypes()) do
            if current ~= nil then currentTypes[mt.name] = call(fromType, current, mt.value) end
            if overall ~= nil and (mt.name == "DamageDone" or mt.name == "Deaths") then
                overallTypes[mt.name] = call(fromType, overall, mt.value)
            end
        end
        -- one source's breakdown: the first damage source of the current session
        local sourceFromType = field(DM, "GetCombatSessionSourceFromType")
        local ok, sess = attempt(fromType, current, damageDone)
        local sources = field(sess, "combatSources")
        local src = ok and type(sess) == "table" and not isSecretTable(sess) and type(sources) == "table"
            and not isSecretTable(sources) and tbl.list(sources)[1]
        if src then
            s.sourceBreakdown = call(sourceFromType, current, damageDone, field(src, "sourceGUID"))
            s.sourceBreakdownWithCreature = call(sourceFromType, current, damageDone,
                field(src, "sourceGUID"), field(src, "sourceCreatureID"))
        else
            s.sourceBreakdown = "no first source (" .. (ok and shape(sess) and "session read" or "session error") .. ")"
        end
        -- your own breakdown by your GUID (always readable)
        s.ownBreakdown = call(sourceFromType, current, damageDone, UnitGUID("player"))
        -- the combat restriction (lags combat's end) and Blizzard's meter switch
        local restriction = field(Enum, "AddOnRestrictionType", "Combat")
        if restriction ~= nil then
            s.restricted = call(field(_G, "C_RestrictedActions", "IsAddOnRestrictionActive"), restriction)
        end
        s.cvarDamageMeterEnabled = call(C_CVar.GetCVar, "damageMeterEnabled")
        -- a session by ID: the first available one
        local okList, list = attempt(field(DM, "GetAvailableCombatSessions"))
        local first = okList and type(list) == "table" and not isSecretTable(list) and tbl.list(list)[1]
        local sessionID = field(first, "sessionID")
        if first and sessionID ~= nil then
            s.byID = call(field(DM, "GetCombatSessionFromID"), sessionID, damageDone)
        end
        -- a death recap, if the deaths list names one
        local okD, deaths = attempt(fromType, overall, deathsType)
        local deathSources = field(deaths, "combatSources")
        local d = okD and type(deaths) == "table" and not isSecretTable(deaths) and type(deathSources) == "table"
            and not isSecretTable(deathSources) and tbl.list(deathSources)[1]
        if d then
            for _, fn in ipairs({ "GetRecapEvents", "GetRecapMaxHealth", "GetRecapLink", "HasRecapEvents" }) do
                local recapFn = field(C_DeathRecap, fn)
                if recapFn then s["deathRecap." .. fn] = call(recapFn, field(d, "deathRecapID")) end
            end
        end
    end
    local counts = eventCounts
    s.events = counts and tbl.shallowCopy(counts) or nil
    local samples = store().samples
    table.insert(samples, s)
    while #samples > MAX_SAMPLES do table.remove(samples, 1) end
    return s
end

local function onFight()
    if not armed then return end
    after(2, function() if armed then sample("2s into the fight") end end)
    after(6, function()
        if armed then
            sample("6s into the fight")
            print("Meter probe: fight sampled. Finish it, then /reload.")
        end
    end)
end

local function afterFight()
    if armed then after(1, function() if armed then sample("after the fight") end end) end
end

export function command(arg: string?)
    if arg == "off" then
        armed = false
        print("Meter probe: off.")
        return
    end
    local m = store()
    m.docs = docs()
    m.registeredEvents = watchEvents() or m.registeredEvents
    m.eventPayloads = eventPayloads
    m.globals = globals()
    m.deathRecapAPI = shape(C_DeathRecap)
    if not armed then
        armed = true
        Events.onGame("PLAYER_REGEN_DISABLED", onFight, OWNER)
        Events.onGame("PLAYER_REGEN_ENABLED", afterFight, OWNER)
    end
    sample("on command")
    print("Meter probe: armed. Fight something for 10 seconds or more (die once if you can bear it), then /reload.")
end
