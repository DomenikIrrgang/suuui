-- Diagnostics/SpellbookProbe.wowlua
-- "/suu probe spellbook": what Forever's spellbook data looks like, for
-- SuuUI's own Spellbook page (step 3.2b). Saved in SuuUIProbe.spellbook on
-- /reload.
--   * C_SpellBook's functions, the item and bank enums
--   * every skill line (school) and its items as the game gives them: type,
--     spell, name, rank text, icon, passive, off spec, level learned, known;
--     plus every C_SpellBook / C_Spell function that sounds like training or
--     cost, called on each item
--   * Blizzard's spellbook page, three levels deep (how it shows unlearned
--     and trainable spells)
--
--   /suu probe spellbook          with the spellbook open (run it on a
--                                 couple of schools), then /reload
--   /suu probe spellbook pickup   SuuUI's code picks up your first spell
--                                 (as a drag would) and puts it back: may
--                                 an addon? then /reload
--   /suu probe spellbook cast     from now until /reload, every click on a
--                                 spell in SuuUI's page (down and up, the
--                                 button's attributes, combat, protected,
--                                 what the mouse is on), blocked actions,
--                                 cast events and error messages: click a
--                                 spell out of combat, then in combat, then
--                                 /reload. Saved in SuuUIProbe.castbook

import isSecret from "wowlua:secret"
import after from "wowlua:timer"
import hook from "wowlua:hooks"
import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as modules from "/Core/Modules"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"
import * as reflect from "wowlua:reflect"
import * as secret from "wowlua:secret"
import SpellbookModule from "/Units/Spellbook"

type Map = { [unknown]: unknown }
-- What the probe saves in SuuUIProbe.spellbook.
type Store = { trainingFunctions: string[], trainerGlobals: string[], lines: Map[], [string]: unknown }

-- The click recorder's current note function and whether its hooks are in
-- (were SP.castNote and SP.castHooked).
local castNote: (s: string) -> () = function(_: string) end
local castHooked = false

local function show(v: unknown): string
    if isSecret(v) then return "secret" end
    if v == nil then return "nil" end
    if type(v) == "table" then
        local parts: string[] = {}
        for k, x in pairs(v) do
            parts[#parts + 1] = tostring(k) .. "=" .. (isSecret(x) and "secret" or (type(x) == "table" and "table" or tostring(x)))
        end
        table.sort(parts)
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function call(fn: unknown, ...: unknown): string
    if type(fn) ~= "function" then return "missing" end
    local res = { pcall(fn, ...) }
    if not res[1] then return "error: " .. tostring(res[2]):sub(1, 120) end
    local parts: string[] = {}
    for i = 2, math.max(2, select("#", unpack(res))) do parts[#parts + 1] = show(res[i]) end
    return table.concat(parts, " | ")
end

local function namesIn(t: unknown): string[]
    local out: string[] = {}
    if type(t) ~= "table" then return { "missing" } end
    for k, v in pairs(t) do if type(k) == "string" and type(v) == "function" then out[#out + 1] = k end end
    table.sort(out)
    return out
end

local function enumList(e: unknown): string[]
    local out: string[] = {}
    if type(e) ~= "table" then return { "missing" } end
    for k, v in pairs(e) do out[#out + 1] = tostring(k) .. "=" .. tostring(v) end
    table.sort(out)
    return out
end

-- Functions whose names sound like training, cost or ranks.
local function trainingFunctions(): (string[], string[])
    local out: string[] = {}
    for _, ns2 in ipairs({ "C_SpellBook", "C_Spell", "C_Trainer", "C_SpellTrainer" }) do
        local t = tbl.field(_G, ns2)
        if type(t) == "table" then
            for k, v in pairs(t) do
                local l = type(k) == "string" and k:lower() or ""
                if type(k) ~= "string" then continue end
                -- only what reads (Get/Is/Has/Can/Should): nothing that buys or learns
                local reads = k:match("^Get") or k:match("^Is") or k:match("^Has") or k:match("^Can") or k:match("^Should")
                if type(v) == "function" and reads and (l:find("train") or l:find("cost") or l:find("rank") or l:find("future")
                    or l:find("learn") or l:find("level") or l:find("unlearned") or l:find("available")) then
                    out[#out + 1] = ns2 .. "." .. k
                end
            end
        end
    end
    -- global names only listed (never called)
    local globals: string[] = {}
    for k, v in pairs(_G) do
        if type(k) == "string" and type(v) == "function" and (k:find("Trainer") or k:find("SpellRank")) then globals[#globals + 1] = k end
    end
    table.sort(globals)
    table.sort(out)
    return out, globals
end

local function sampleItems(extra: string[]): Map[]
    local bank = Enum.SpellBookSpellBank.Player
    local lines: Map[] = {}
    local numLines = C_SpellBook.GetNumSpellBookSkillLines()
    for line = 1, numLines do
        local info = C_SpellBook.GetSpellBookSkillLineInfo(line)
        local items: Map[] = {}
        local l: Map = { info = show(info), items = items }
        local offset, count = info and secret.asNumber(info.itemIndexOffset), info and secret.asNumber(info.numSpellBookItems)
        if offset and count then
            for i = offset + 1, math.min(offset + count, offset + 40) do
                local item = C_SpellBook.GetSpellBookItemInfo(i, bank)
                local spellID = item and secret.asNumber(item.spellID)
                local e: Map = { slot = i, info = show(item) }
                e.name = call(C_SpellBook.GetSpellBookItemName, i, bank)
                e.levelLearned = call(C_SpellBook.GetSpellBookItemLevelLearned, i, bank)
                e.passive = call(C_SpellBook.IsSpellBookItemPassive, i, bank)
                e.offSpec = call(C_SpellBook.IsSpellBookItemOffSpec, i, bank)
                e.texture = call(C_SpellBook.GetSpellBookItemTexture, i, bank)
                if spellID then
                    e.subtext = call(C_Spell.GetSpellSubtext, spellID)
                    e.known = call(IsSpellKnown, spellID)
                    e.playerSpell = call(IsPlayerSpell, spellID)
                    e.levelLearnedSpell = call(C_Spell.GetSpellLevelLearned, spellID)
                end
                -- whatever sounds like training: called with (slot, bank) and with the spell
                local tried: string[] = {}
                for _, path in ipairs(extra) do
                    local ns2, fn = path:match("^(.-)%.(.+)$")
                    local f = ns2 and fn and tbl.field(_G, ns2, fn)
                    if f then
                        tried[#tried + 1] = path .. "(slot)=" .. call(f, i, bank):sub(1, 80)
                        if spellID then tried[#tried + 1] = path .. "(spell)=" .. call(f, spellID):sub(1, 80) end
                    end
                end
                e.tried = tried
                items[#items + 1] = e
            end
        end
        lines[#lines + 1] = l
    end
    return lines
end

-- Blizzard's spellbook page, three levels deep: keys, types, sizes, texts.
local function pageTree(f: Frame, depth: number, out: string[], prefix: string)
    if depth > 3 or #out > 400 then return end
    local keys: { [Region]: string } = {}
    for k, part in pairs(wf.keyed(f)) do keys[part] = k end
    for _, c in ipairs(wf.children(f)) do
        local ok, line = pcall(function(): string
            local w, h = c:GetSize()
            return ("%s%s %s %dx%d shown=%s"):format(prefix, c:GetObjectType(), keys[c] or c:GetName() or "-", w or 0, h or 0, tostring(c:IsShown()))
        end)
        if ok and line then out[#out + 1] = line end
        for _, r in ipairs(wf.fontStrings(c)) do
            local t = secret.asString(r:GetText())
            if t and t ~= "" then out[#out + 1] = prefix .. "  text: " .. t:sub(1, 50) end
        end
        pageTree(c, depth + 1, out, prefix .. "  ")
    end
end

local function store(): Store
    return DB.probeData("spellbook", function(): Store return { trainingFunctions = {}, trainerGlobals = {}, lines = {} } end)
end

export function sample(): Store
    local s = store()
    local at = date("%Y-%m-%d %H:%M:%S")
    s.at = at
    s.C_SpellBook = namesIn(C_SpellBook)
    s.itemTypes = enumList(Enum.SpellBookItemType)
    s.banks = enumList(Enum.SpellBookSpellBank)
    s.trainingFunctions, s.trainerGlobals = trainingFunctions()
    s.lines = sampleItems(s.trainingFunctions)
    local f = wf.find("PlayerSpellsFrame")
    local page = wf.asFrame(tbl.field(f, "SpellBookFrame") or tbl.field(f, "SpellbookFrame"))
    if page and page:IsVisible() then
        local out: string[] = {}
        pageTree(page, 0, out, "")
        s.page = out
        s.pageAt = at
    end
    return s
end

-- SuuUI's code picks up the first learned spell and puts it back.
export function pickup()
    if InCombatLockdown() then print("Spellbook probe: out of combat, please.") return end
    local s = store()
    local bank = Enum.SpellBookSpellBank.Player
    local blocked: string[] = {}
    local f = CreateFrame("Frame")
    f:RegisterEvent("ADDON_ACTION_BLOCKED")
    f:RegisterEvent("ADDON_ACTION_FORBIDDEN")
    f:SetScript("OnEvent", function(_, e: string, a: unknown, b: unknown) blocked[#blocked + 1] = e .. " " .. show(a) .. " " .. show(b) end)
    local slot: number? = nil
    local info = C_SpellBook.GetSpellBookSkillLineInfo(2) or C_SpellBook.GetSpellBookSkillLineInfo(1)
    local offset, count = info and secret.asNumber(info.itemIndexOffset), info and secret.asNumber(info.numSpellBookItems)
    if offset and count then
        for i = offset + 1, offset + count do
            local item = C_SpellBook.GetSpellBookItemInfo(i, bank)
            if item and item.itemType == Enum.SpellBookItemType.Spell and not item.isPassive then slot = i break end
        end
    end
    local r: Map = { at = date("%H:%M:%S"), slot = show(slot) }
    if slot then
        r.pickup = call(C_SpellBook.PickupSpellBookItem, slot, bank)
        r.cursor = call(GetCursorInfo)
        ClearCursor()
    end
    after(0.5, function()
        r.blocked = blocked
        f:UnregisterAllEvents()
        print("Spellbook probe: pickup " .. tostring(r.pickup) .. ", cursor " .. tostring(r.cursor) .. (#blocked > 0 and (", BLOCKED: " .. blocked[1]) or ", nothing blocked") .. ". /reload to save.")
    end)
    s.pickupTest = r
end

export function cast()
    local m = modules.get("spellbook")
    local book = m and reflect.isInstance(m, SpellbookModule) and m.book or nil
    if not book then print("Spellbook probe: open the Spellbook once first.") return end
    local log: string[] = {}
    DB.probe.castbook = { at = date("%H:%M:%S"), keyDownCVar = show(GetCVar("ActionButtonUseKeyDown")), log = log }
    local t0 = GetTime()
    local function note(s: string)
        if #log < 300 then log[#log + 1] = ("%.2f %s %s"):format(GetTime() - t0, InCombatLockdown() and "[combat]" or "[calm]", s) end
    end
    castNote = note
    if castHooked then note("re-armed") print("Spellbook probe: recording again. Click spells, then /reload.") return end
    castHooked = true
    local function foci(): string
        local out: string[] = {}
        for _, f in ipairs(GetMouseFoci()) do
            local ok, n = pcall(function() return f:GetDebugName() end)
            out[#out + 1] = ok and n or tostring(f)
        end
        return table.concat(out, ", ")
    end
    local function describe(b: Button): string
        local ok1, prot = pcall(b.IsProtected, b)
        return ("type=%s spell=%s protected=%s shown=%s visible=%s mouse=%s alpha=%.2f foci=[%s]"):format(
            show(b:GetAttribute("type")), show(b:GetAttribute("spell")), ok1 and show(prot) or "?",
            show(b:IsShown()), show(b:IsVisible()), show(b:IsMouseEnabled()), b:GetEffectiveAlpha() or -1, foci())
    end
    local hooked: { [Button]: boolean } = {}
    local function hookCells()
        for i, c in ipairs(book.cells) do
            local b = c.button
            if b and not hooked[b] then
                hooked[b] = true
                b:HookScript("OnMouseDown", function(_, btn) castNote(("cell %d mousedown %s %s"):format(i, tostring(btn), describe(b))) end)
                b:HookScript("PreClick", function(_, btn, down) castNote(("cell %d preclick %s down=%s %s"):format(i, tostring(btn), tostring(down), describe(b))) end)
                b:HookScript("PostClick", function(_, btn, down) castNote(("cell %d postclick %s down=%s"):format(i, tostring(btn), tostring(down))) end)
            end
        end
    end
    hookCells()
    hook(book, "SetSpells", hookCells)
    local f = CreateFrame("Frame")
    for _, e in ipairs({ "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN", "UI_ERROR_MESSAGE", "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED" }) do
        pcall(f.RegisterEvent, f, e)
    end
    for _, e in ipairs({ "UNIT_SPELLCAST_SENT", "UNIT_SPELLCAST_START", "UNIT_SPELLCAST_SUCCEEDED", "UNIT_SPELLCAST_FAILED" }) do
        pcall(f.RegisterUnitEvent, f, e, "player")
    end
    f:SetScript("OnEvent", function(_, e: string, a: unknown, b: unknown, c: unknown, d: unknown)
        castNote(("%s %s %s %s %s"):format(e, show(a), show(b), show(c), show(d)))
    end)
    note("armed " .. #book.cells .. " cells")
    print("Spellbook probe: recording clicks. Click a spell out of combat, then in combat, then /reload.")
end

export function command(arg: string?)
    if arg == "pickup" then return pickup() end
    if arg == "cast" then return cast() end
    local s = sample()
    print(("Spellbook probe: %d schools sampled%s. Run it on another school too, then /reload."):format(#s.lines,
        s.page and ", Blizzard's page read" or " (open the spellbook to read Blizzard's page)"))
end
