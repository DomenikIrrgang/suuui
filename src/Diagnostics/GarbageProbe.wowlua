-- Diagnostics/GarbageProbe.wowlua
-- "/suu probe garbage" (asked 2026-10-18: SuuUI makes about 0.5 MB of
-- garbage a second, most of it outside the module calls /suu perf counts):
-- what each of SuuUI's frequent jobs allocates per call. Each job runs a
-- few times with the garbage collector held, and Lua's memory count before
-- and after gives its allocation exactly; how often each runs comes from a
-- dev build's profiler (/suu perf), so together they give KB a second.
-- Jobs that can't be found (a module off) are skipped. Saved in
-- SuuUIProbe.garbage on /reload.

import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as modules from "/Core/Modules"
import * as settings from "/Core/Settings"
import * as tbl from "wowlua:table"

local RUNS = 10

local field = tbl.field

-- A module of SuuUI's, if it is on.
local function mod(id: string): modules.AnyModule?
    local m = modules.get(id)
    return m and m:IsEnabled() and m or nil
end

-- `obj:name(...)` as a job, when `obj` has the method.
local function bound(obj: unknown, name: string, ...: unknown): (() -> ())?
    local fn = field(obj, name)
    if type(fn) ~= "function" then return nil end
    local args, n = { ... }, select("#", ...)
    return function() fn(obj, unpack(args, 1, n)) end
end

-- The action buttons SuuUI made (bars 1-8).
local function actionButtons(): unknown[]
    local out: unknown[] = {}
    for bar = 1, 8 do
        for i = 1, 12 do
            local b = field(_G, "SuuUIActionBar" .. bar .. "Button" .. i)
            if b then out[#out + 1] = b end
        end
    end
    return out
end

local function eachMethod(list: unknown[], method: string): () -> ()
    return function()
        for _, b in ipairs(list) do
            local fn = field(b, method)
            if type(fn) == "function" then fn(b) end
        end
    end
end

-- name = { fn, what one call is }
type Job = { name: string, fn: () -> (), unit: string }

local function jobs(): Job[]
    local out: Job[] = {}
    local function add(name: string, fn: (() -> ())?, unit: string?) if fn then out[#out + 1] = { name = name, fn = fn, unit = unit or "call" } end end
    local buttons = actionButtons()
    if #buttons > 0 then
        for _, method in ipairs({ "UpdateCooldown", "UpdateUsable", "UpdateActive", "UpdateArt", "UpdateEmpty", "UpdateCount", "UpdateHotkey", "Update" }) do
            add("ActionButton:" .. method, eachMethod(buttons, method), #buttons .. " buttons")
        end
    end
    local stance = tbl.list(field(_G, "SuuUIStanceBar", "buttons"))
    if #stance > 0 then add("Stance button Update", eachMethod(stance, "Update"), #stance .. " buttons") end
    local chat = mod("chat")
    add("Chat:Tick", bound(chat, "Tick"))
    add("Chat:UpdateTabs", bound(chat, "UpdateTabs"))
    add("Threat:Update", bound(mod("threat"), "Update"))
    add("MicroMenu:UpdateActive", bound(mod("micromenu"), "UpdateActive"))
    add("Notifications:Tick", bound(mod("notifications"), "Tick"))
    local tracker = mod("tracker")
    add("ObjectiveTracker:Refresh", bound(tracker, "Refresh"))
    add("ObjectiveTracker:TickItems", bound(tracker, "TickItems"))
    add("Readiness:Update", bound(mod("readiness"), "Update"))
    local cds = mod("cooldowns")
    local cdTracker = field(cds, "tracker")
    if cdTracker then
        add("CooldownTracker:UpdateCooldowns", bound(cdTracker, "UpdateCooldowns", true))
        local editSpec, lists = field(cds, "EditSpec"), field(cds, "Lists")
        if type(editSpec) == "function" and type(lists) == "function" then
            add("CooldownManager:Lists", function() lists(cds, editSpec(cds)) end)
        end
    end
    add("Party:UpdateRange", bound(mod("party"), "UpdateRange"))
    add("Raid:UpdateRange", bound(mod("raid"), "UpdateRange"))
    add("SwingTimer:Tick", bound(field(_G, "SuuUISwingTimer"), "Tick"))
    for _, name in ipairs({ "SuuUIPlayerFrame", "SuuUITargetFrame", "SuuUITargetTargetFrame" }) do
        local f = field(_G, name)
        local health = bound(f, "UpdateHealth", true)
        if health then
            add(name .. ":UpdateHealth", health)
            add(name .. ":UpdatePower", bound(f, "UpdatePower"))
        end
    end
    -- the settings: a position (a table, copied) and a number
    add("Settings.Get (table)", function() settings.get("unitframes", "playerPosition") end)
    add("Settings.Get (number)", function() settings.get("cooldowns", "essentialSize") end)
    return out
end

type Row = { name: string, line: string, kb: number }

export function command()
    local lines: string[] = {}
    local out: { [string]: unknown } = { at = date("%Y-%m-%d %H:%M:%S"), inCombat = InCombatLockdown() and true or false, jobs = lines }
    local rows: Row[] = {}
    collectgarbage("collect")
    collectgarbage("stop")
    for _, job in ipairs(jobs()) do
        -- one run first: a job's first call may build what it then keeps
        local ok, err = pcall(job.fn)
        if not ok then
            rows[#rows + 1] = { name = job.name, line = job.name .. ": error " .. tostring(err):sub(1, 120), kb = -1 }
        else
            local before: number = collectgarbage("count")
            for _ = 1, RUNS do pcall(job.fn) end
            local per = (collectgarbage("count") - before) / RUNS
            rows[#rows + 1] = { name = job.name, kb = per,
                line = ("%s: %.2f KB a call (%s)"):format(job.name, per, job.unit) }
        end
    end
    collectgarbage("restart")
    table.sort(rows, function(a: Row, b: Row): boolean return a.kb > b.kb end)
    for i, r in ipairs(rows) do lines[i] = r.line end
    DB.probe.garbage = out
    print(("Garbage probe: %d jobs measured. /reload to save it."):format(#rows))
    for i = 1, math.min(6, #rows) do print("  " .. rows[i].line) end
end
