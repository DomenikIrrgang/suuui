-- Diagnostics/MinimapProbe.wowlua
-- "/suu probe minimap": what Forever lets an addon change about what the
-- engine draws on the minimap (step 2.1's open parts). Saved in
-- SuuUIProbe.minimap on /reload.
--   * Minimap's methods about textures, blips, the player arrow, icons and
--     POI arrows (to swap the arrow; class diamonds for the group)
--   * whether positions are readable (UnitPosition, C_Map.GetPlayerMapPosition
--     for you and your group) and the view radius per zoom: drawing the
--     group's diamonds ourselves needs them
--   * the instance difficulty frame and GetInstanceInfo
--
--   /suu probe minimap            sample (also inside a dungeon, and in a group)
--   /suu probe minimap arrow      your arrow becomes SuuUI's (look at the map)
--   /suu probe minimap arrow off  Blizzard's arrow back

import * as DB from "/Core/DB"
import print from "/Core/Init"
import isSecret from "wowlua:secret"

local ARROW = "Interface\\AddOns\\SuuUI\\Media\\Textures\\PlayerArrow.tga"

local function show(v: any): string
    if isSecret(v) then return "secret" end
    if v == nil then return "nil" end
    return tostring(v)
end

local function call(fn: any, ...: any): string
    if type(fn) ~= "function" then return "missing" end
    local res = { pcall(fn, ...) }
    if not res[1] then return "error: " .. tostring(res[2]):sub(1, 140) end
    local parts: string[] = {}
    for i = 2, math.max(2, select("#", unpack(res))) do parts[#parts + 1] = show(res[i]) end
    return table.concat(parts, ", ")
end

-- Minimap's methods whose names matter here
local function methods(): string[]
    local out: string[] = {}
    local mt = getmetatable(Minimap)
    local index = mt and mt.__index
    if type(index) ~= "table" then return { "no metatable index" } end
    for k in pairs(index) do
        if type(k) == "string" and (k:find("Texture") or k:find("Blip") or k:find("Player") or k:find("Icon")
            or k:find("Arrow") or k:find("POI") or k:find("Zoom") or k:find("Ping") or k:find("Rotat") or k:find("Mask")) then
            out[#out + 1] = k
        end
    end
    table.sort(out)
    return out
end

export function sample(): { [string]: any }
    local store = DB.probe.minimap or { samples = {} }
    DB.probe.minimap = store
    store.methods = methods()
    local s = {
        at = date("%H:%M:%S"),
        instance = select(2, IsInInstance()) or "none",
        group = IsInRaid() and "raid" or (IsInGroup() and "party" or "solo"),
        combat = InCombatLockdown() and "in combat" or "out of combat",
    } :: { [string]: any }
    s.zoom = call(Minimap.GetZoom, Minimap) .. " of " .. call(Minimap.GetZoomLevels, Minimap)
    s.viewRadius = C_Minimap and call(C_Minimap.GetViewRadius) or "missing"
    s.uiMapID = C_Minimap and call(C_Minimap.GetUiMapID) or "missing"
    s.rotate = show(GetCVar("rotateMinimap"))
    s.facing = call(GetPlayerFacing)
    s.compassRotation = MinimapCompassTexture and call(MinimapCompassTexture.GetRotation, MinimapCompassTexture) or "missing"
    -- positions: you and up to four others
    s.positions = {}
    local mapID = C_Map.GetBestMapForUnit("player")
    s.bestMap = show(mapID)
    local units = { "player" }
    if IsInRaid() then for i = 1, 4 do units[#units + 1] = "raid" .. i end
    else for i = 1, 4 do units[#units + 1] = "party" .. i end end
    for _, u in ipairs(units) do
        if UnitExists(u) then
            s.positions[u] = {
                unitPosition = call(UnitPosition, u),
                mapPosition = mapID and call(function()
                    local p = C_Map.GetPlayerMapPosition(mapID, u)
                    if not p then return nil end
                    return p.x, p.y
                end) or "no map",
            }
        end
    end
    -- the instance difficulty badge
    local diff = MinimapCluster and MinimapCluster.InstanceDifficulty
    s.difficultyFrame = diff and "present" or "missing"
    if diff then
        local kids = {}
        for k, v in pairs(diff) do
            if type(v) == "table" and v.IsShown then
                local ok, shown = pcall(v.IsShown, v)
                kids[#kids + 1] = k .. (ok and (shown and " (shown)" or " (hidden)") or "")
            end
        end
        table.sort(kids)
        s.difficultyParts = kids
        s.difficultyShown = show(diff:IsShown())
    end
    s.instanceInfo = call(GetInstanceInfo)
    table.insert(store.samples, s)
    while #store.samples > 8 do table.remove(store.samples, 1) end
    return s
end

export function command(arg: string?)
    if arg == "arrow" then
        local ok, err = pcall(Minimap.SetPlayerTexture, Minimap, ARROW)
        print(ok and "Minimap probe: your arrow is SuuUI's now. Does it show? (/suu probe minimap arrow off)"
            or ("Minimap probe: SetPlayerTexture failed: " .. tostring(err)))
        DB.probe.minimapArrow = ok and "set" or tostring(err)
        return
    end
    if arg == "arrow off" then
        pcall(Minimap.SetPlayerTexture, Minimap, "Interface\\Minimap\\MinimapArrow")
        print("Minimap probe: Blizzard's arrow back.")
        return
    end
    local s = sample()
    print(("Minimap probe: %d methods, %s, %s. Sample in a dungeon and in a group too, then /reload."):format(
        #DB.probe.minimap.methods, s.instance, s.group))
end
