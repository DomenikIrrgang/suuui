-- Diagnostics/HoverTipProbe.wowlua
-- "/suu probe hovertip": three seconds later (time to hover something),
-- every tooltip-type frame on screen: its name, whether SuuUI skinned it,
-- its NineSlice's alpha and shown state, its scale, parent and owner. Prints
-- in chat and saves to SuuUIProbe.hoverTip.

import print from "/Core/Init"
import * as DB from "/Core/DB"
import isTooltipSkinned from "/UI/Tooltip"
import after from "wowlua:timer"
import isSecret from "wowlua:secret"
import * as wf from "wowlua:frames"
import * as tbl from "wowlua:table"

local function show(v: unknown): string
    if isSecret(v) then
        return "secret"
    end
    return tostring(v)
end

local function describe(f: Frame): string
    local name = f:GetName() or f:GetDebugName() or "?"
    local ns9 = wf.asFrame(tbl.field(f, "NineSlice"))
    local owner = "?"
    pcall(function()
        local getOwner = tbl.field(f, "GetOwner")
        local o = type(getOwner) == "function" and wf.asRegion(getOwner(f)) or nil
        owner = o and (o:GetName() or o:GetDebugName() or "unnamed") or "nil"
    end)
    local parent = f:GetParent()
    return ("%s (%s) skinned=%s nineSlice=%s alpha=%s scale=%.2f parent=%s owner=%s strata=%s"):format(
        name,
        f:GetObjectType(),
        show(isTooltipSkinned(f)),
        ns9 and (ns9:IsShown() and "shown" or "hidden") or "none",
        ns9 and ("%.2f"):format(ns9:GetAlpha()) or "-",
        f:GetScale(),
        parent and (parent:GetName() or parent:GetDebugName() or "unnamed") or "nil",
        owner,
        show(f:GetFrameStrata())
    )
end

export function command()
    print("Hover tooltip probe: hover a buff now; in 3 seconds SuuUI lists the tooltips on screen.")
    after(3, function()
        local out: { [unknown]: unknown } = { at = date("%H:%M:%S") }
        DB.probe.hoverTip = out
        local f = wf.asFrame(EnumerateFrames())
        while f do
            local frame = f
            local ok, text = pcall(function(): string?
                if frame:IsForbidden() then
                    return nil
                end
                if not frame:IsVisible() then
                    return nil
                end
                local t = frame:GetObjectType()
                if t ~= "GameTooltip" and
                    not (tbl.field(frame, "NineSlice") and frame:GetFrameStrata() == "TOOLTIP") then
                    return nil
                end
                return describe(frame)
            end)
            if ok and text then
                out[#out + 1] = text
                print(text)
            end
            f = wf.asFrame(EnumerateFrames(frame))
        end
        if #out == 0 then
            print("Hover tooltip probe: no tooltip SuuUI can see on screen.")
        end
        -- what's under the mouse, and whether it draws its own tooltip
        local foci = GetMouseFoci()
        local forbiddenTips = 0
        local g = wf.asFrame(EnumerateFrames())
        while g do
            if g:IsForbidden() then
                forbiddenTips = forbiddenTips + 1
            end
            g = wf.asFrame(EnumerateFrames(g))
        end
        out.forbiddenFrames = forbiddenTips
        print(("Forbidden frames in the UI: %d"):format(forbiddenTips))
        for _, focus in ipairs(foci) do
            local m = wf.asRegion(focus)
            local ok, text = pcall(function(): string
                if not m then
                    return "under the mouse: something else"
                end
                if m:IsForbidden() then
                    return "under the mouse: a forbidden frame"
                end
                local p = m:GetParent()
                local mf = wf.asFrame(m)
                local onEnter = mf and mf:GetScript("OnEnter") and "yes" or "none"
                return ("under the mouse: %s (%s) protected=%s OnEnter=%s parent=%s (%s) GameTooltip shown=%s owner=%s"):format(
                    m:GetName() or m:GetDebugName() or "?",
                    m:GetObjectType(),
                    show((m:IsProtected())),
                    onEnter,
                    p and (p:GetName() or p:GetDebugName() or "?") or "nil",
                    p and p:GetObjectType() or "-",
                    show(GameTooltip:IsShown()),
                    (function()
                        local o = GameTooltip:GetOwner()
                        return o and (o:GetName() or o:GetDebugName() or "?") or "nil"
                    end)()
                )
            end)
            local line = ok and text or ("under the mouse: error " .. tostring(text))
            out[#out + 1] = line
            print(line)
        end
    end)
end
