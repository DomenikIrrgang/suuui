-- Widget methods whose names match these are listed in full in the saved data.
local METHOD_HINTS = { "boolean", "duration", "secret", "curve", "timer" }
local METHOD_WIDGETS = { "Frame", "StatusBar", "Cooldown", "Texture", "FontString" }

-- Console variables whose names match these are listed in the saved data.
local CVAR_HINTS = { "swing", "timeline", "damagemeter", "cooldownviewer", "encounter", "camp" }

-- Units sampled for secret values, and the spells whose cooldown is sampled:
-- 29515 is Forever's global cooldown reference, 61304 retail's.
local SAMPLE_UNITS = { "player", "target", "focus", "pet", "party1", "raid1", "boss1", "nameplate1" }
local SAMPLE_SPELLS = { 29515, 61304 }

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

-- A value by its dotted path from the globals ("C_Spell.GetSpellInfo").
local function resolve(path: string): unknown
    local v: unknown = _G
    for part in path:gmatch("[^%.]+") do
        if type(v) ~= "table" then return nil end
        v = tbl.field(v, part)
    end
    return v
end

local function sortedKeys(t: unknown, filter: ((k: string, v: unknown) -> boolean)?): string[]
    local out: string[] = {}
    if type(t) ~= "table" then return out end
    for k, v in pairs(t) do
        if type(k) == "string" and (not filter or filter(k, v)) then
            out[#out + 1] = k
        end
    end
    table.sort(out)
    return out
end

local function functionNames(t: unknown): string[]
    return sortedKeys(t, function(_: string, v: unknown): boolean return type(v) == "function" end)
end

local function matchesAny(lower: string, needles: string[]): boolean
    for _, n in ipairs(needles) do
        if lower:find(n, 1, true) then return true end
    end
    return false
end

local function scan(item: Item): string[]
    local function wanted(name: string): boolean
        local lower = name:lower()
        return matchesAny(lower, item.find or {}) and not (item.skip and matchesAny(lower, item.skip))
    end
    local hits: string[] = {}
    local within = item.within
    if within then
        for _, name in ipairs(functionNames(resolve(within))) do
            if wanted(name) then hits[#hits + 1] = within .. "." .. name end
        end
        return hits
    end
    for name, v in pairs(_G) do
        local t = type(v)
        if type(name) == "string" and (t == "function" or t == "table")
            and not name:find("^SuuUI") and wanted(name) then
            hits[#hits + 1] = name
        end
    end
    for _, name in ipairs(sortedKeys(Enum)) do
        if wanted(name) then hits[#hits + 1] = "Enum." .. name end
    end
    table.sort(hits)
    return hits
end

local function addonState(name: string): (boolean, string)
    local ok, exists = pcall(C_AddOns.DoesAddOnExist, name)
    if not ok or not exists then return false, "absent" end
    if C_AddOns.IsAddOnLoaded(name) then return true, "loaded" end
    if C_AddOns.IsAddOnLoadOnDemand(name) then
        return true, "on demand"
    end
    return true, "present, not loaded"
end

local widgets: { [string]: unknown }? = nil
local function widget(kind: string): unknown
    local w = widgets
    if not w then
        local host = CreateFrame("Frame")
        host:Hide()
        w = ({
            Frame = host,
            StatusBar = CreateFrame("StatusBar", nil, host),
            Cooldown = CreateFrame("Cooldown", nil, host),
            Texture = host:CreateTexture(),
            FontString = host:CreateFontString(),
        }) :: { [string]: unknown }
        widgets = w
    end
    return w[kind]
end

-- A widget kind's methods (its metatable's __index).
local function methodsOf(kind: string): unknown
    local w = widget(kind)
    local mt = type(w) == "table" and getmetatable(w)
    local index = tbl.field(mt, "__index")
    return type(index) == "table" and index or {}
end

local function preview(list: string[], limit: number): string
    if #list <= limit then return table.concat(list, ", ") end
    local head: string[] = {}
    for i = 1, limit do head[i] = list[i] end
    return table.concat(head, ", ") .. (", +%d more"):format(#list - limit)
end

--------------------------------------------------------------------------------
-- Checks
--------------------------------------------------------------------------------

-- Returns ok, label, detail for one item; `saved` collects the full lists.
local function check(item: Item, saved: Saved): (boolean, string, string?)
    local api, ns, frame, addon, enum, method, scanName = item.api, item.ns, item.frame, item.addon, item.enum, item.method, item.scan
    if api then
        return type(resolve(api)) == "function", api, nil
    elseif ns then
        local t = resolve(ns)
        if type(t) ~= "table" then return false, ns, nil end
        local names = functionNames(t)
        saved.namespaces[ns] = names
        return true, ns, ("%d functions"):format(#names)
    elseif frame then
        return type(tbl.field(_G, frame)) == "table", frame, nil
    elseif addon then
        local ok, state = addonState(addon)
        return ok, addon, state
    elseif enum then
        local label = "Enum." .. enum
        local t = tbl.field(Enum, enum)
        if type(t) ~= "table" then return false, label, nil end
        local copy: { [unknown]: unknown }, n = {}, 0
        for k, v in pairs(t) do copy[k] = v; n = n + 1 end
        saved.enums[enum] = copy
        return true, label, ("%d values"):format(n)
    elseif method then
        local kind, name = method[1], method[2]
        return type(tbl.field(methodsOf(kind), name)) == "function", kind .. ":" .. name, nil
    elseif scanName then
        local hits = scan(item)
        saved.scans[scanName] = hits
        if #hits == 0 then return false, scanName, "nothing found" end
        return true, scanName, preview(hits, 6)
    end
    -- (every item is one of the kinds above)
    return false, "?", nil
end

local function collectMethods(): { [string]: string[] }
    local out: { [string]: string[] } = {}
    for _, kind in ipairs(METHOD_WIDGETS) do
        out[kind] = sortedKeys(methodsOf(kind), function(k: string, v: unknown): boolean
            return type(v) == "function" and matchesAny(k:lower(), METHOD_HINTS)
        end)
    end
    return out
end

local function collectCVars(): string[]?
    local getAll = tbl.field(_G, "C_Console", "GetAllCommands")
    if type(getAll) ~= "function" then return nil end
    local ok, all = pcall(getAll)
    if not ok or type(all) ~= "table" then return nil end
    local out: string[] = {}
    for _, info in ipairs(tbl.list(all)) do
        local name = tbl.field(info, "command")
        if type(name) == "string" and matchesAny(name:lower(), CVAR_HINTS) then
            out[#out + 1] = name
        end
    end
    table.sort(out)
    return out
end

--------------------------------------------------------------------------------
-- Secret-value samples for the current context
--------------------------------------------------------------------------------

local function isSecretTable(t: unknown): boolean
    return type(t) == "table" and issecrettable(t) == true
end

local function errText(msg: unknown): string
    return (tostring(msg):gsub("^Interface\\[^:]*:%d+: ", "")):sub(1, 160)
end

-- "secret", "readable" or "none" for one value; never keeps the value.
local function state(v: unknown): string
    if isSecret(v) then return "secret" end
    if v == nil then return "none" end
    return "readable"
end

-- The state of every string-keyed field of a table the client returned
-- (a table of states), or the state of a non-table value (text).
local function describe(t: unknown): unknown
    if isSecret(t) or type(t) ~= "table" then return state(t) end
    if isSecretTable(t) then return "secret table" end
    local out: { [string]: string } = {}
    local ok, err = pcall(function()
        for k, v in pairs(t) do
            if type(k) == "string" then
                if isSecret(v) then out[k] = "secret" else out[k] = v == nil and "none" or "readable" end
            end
        end
    end)
    if not ok then return "error: " .. errText(err) end
    return out
end

-- Calls fn and describes its first result; errors become "error: <message>".
local function call(fn: unknown, ...: unknown): unknown
    if type(fn) ~= "function" then return "missing" end
    local ok, v = pcall(fn, ...)
    if not ok then return "error: " .. errText(v) end
    return describe(v)
end

type UnitField = { name: string, read: (u: string) -> unknown }
local UNIT_FIELDS: UnitField[] = {
    { name = "name", read = function(u: string): unknown return (UnitName(u)) end },
    { name = "class", read = function(u: string): unknown return (select(2, UnitClass(u))) end },
    { name = "level", read = function(u: string): unknown return UnitLevel(u) end },
    { name = "classification", read = function(u: string): unknown return UnitClassification(u) end },
    { name = "reaction", read = function(u: string): unknown return (UnitReaction(u, "player")) end },
    { name = "dead", read = function(u: string): unknown return UnitIsDeadOrGhost(u) end },
    { name = "role", read = function(u: string): unknown return UnitGroupRolesAssigned(u) end },
    { name = "health", read = function(u: string): unknown return UnitHealth(u) end },
    { name = "healthMax", read = function(u: string): unknown return UnitHealthMax(u) end },
    { name = "healthPercent", read = function(u: string): unknown return UnitHealthPercent(u) end },
    { name = "healthPercentScaled", read = function(u: string): unknown return UnitHealthPercent(u, true, CurveConstants.ScaleTo100) end },
    { name = "powerPercentScaled", read = function(u: string): unknown return UnitPowerPercent(u, UnitPowerType(u), true, CurveConstants.ScaleTo100) end },
    { name = "power", read = function(u: string): unknown return UnitPower(u) end },
    { name = "powerType", read = function(u: string): unknown return (UnitPowerType(u)) end },
    { name = "absorbs", read = function(u: string): unknown return UnitGetTotalAbsorbs(u) end },
    { name = "incomingHeals", read = function(u: string): unknown return UnitGetIncomingHeals(u) end },
    { name = "threat", read = function(u: string): unknown return (UnitThreatSituation("player", u)) end },
    { name = "castName", read = function(u: string): unknown return (UnitCastingInfo(u)) end },
    { name = "castNotInterruptible", read = function(u: string): unknown return (select(8, UnitCastingInfo(u))) end },
    { name = "castDuration", read = function(u: string): unknown return UnitCastingDuration(u) end },
}

-- The first aura of each filter, read three ways: by index, through the slot
-- API that Blizzard's AuraUtil uses, and as a list.
local function sampleAuras(unit: string): { [string]: unknown }
    local A = C_UnitAuras
    local out: { [string]: unknown } = {}
    for _, filter in ipairs({ "HELPFUL", "HARMFUL" }) do
        out["byIndex " .. filter] = call(A.GetAuraDataByIndex, unit, 1, filter)
        local slots = tbl.field(A, "GetAuraSlots")
        if type(slots) == "function" then
            local ok, tokenOrError, slot = pcall(slots, unit, filter)
            if not ok then
                out["slots " .. filter] = "error: " .. errText(tokenOrError)
            else
                out["slots " .. filter] = state(slot)
                if slot ~= nil and not isSecret(slot) then
                    out["bySlot " .. filter] = call(tbl.field(A, "GetAuraDataBySlot"), unit, slot)
                end
            end
        end
        local unitAuras = tbl.field(A, "GetUnitAuras")
        if type(unitAuras) == "function" then
            local ok, list = pcall(unitAuras, unit, filter, 1)
            if not ok then
                out["list " .. filter] = "error: " .. errText(list)
            elseif type(list) == "table" and not isSecret(list) and not isSecretTable(list) then
                out["list " .. filter] = describe(tbl.list(list)[1])
            else
                out["list " .. filter] = describe(list)
            end
        end
    end
    return out
end

-- A unit's samples: its fields and its auras, each a describe() result.
type UnitSample = { fields: { [string]: unknown }, auras: { [string]: unknown } }

local function sampleUnits(): { [string]: UnitSample }
    local out: { [string]: UnitSample } = {}
    for _, unit in ipairs(SAMPLE_UNITS) do
        if UnitExists(unit) then
            local fields: { [string]: unknown } = {}
            for _, f in ipairs(UNIT_FIELDS) do
                if not (f.name == "threat" and unit == "player") then
                    fields[f.name] = call(f.read, unit)
                end
            end
            out[unit] = { fields = fields, auras = sampleAuras(unit) }
        end
    end
    return out
end

-- The GCD reference spells, then up to three actions on the current bar 1.
local function sampleCooldowns(): { [string]: unknown }
    local out: { [string]: unknown } = {}
    for _, id in ipairs(SAMPLE_SPELLS) do
        out["spell " .. id] = call(C_Spell.GetSpellCooldown, id)
    end
    local AB = C_ActionBar
    local hasAction = tbl.field(_G, "HasAction") or tbl.field(AB, "HasAction")
    local n = 0
    for slot = 1, 12 do
        if n < 3 and type(hasAction) == "function" and hasAction(slot) then
            n = n + 1
            out["action " .. slot] = call(tbl.field(AB, "GetActionCooldown"), slot)
            out["action " .. slot .. " duration object"] = call(tbl.field(AB, "GetActionCooldownDuration"), slot)
        end
    end
    return out
end

-- Calls the no-argument queries the messaging scan found and keeps their
-- answer when it is readable.
local function sampleMessaging(saved: Saved): { [string]: string }
    local out: { [string]: string } = {}
    for _, path in ipairs(saved.scans["Messaging lockdown APIs"] or {}) do
        local short = path:match("%.(%w+)$")
        local fn = resolve(path)
        if short and type(fn) == "function" and (short:find("^Is") or short:find("^In") or short:find("^Are")) then
            local ok, v = pcall(fn)
            if not ok then out[short] = "error: " .. errText(v)
            elseif isSecret(v) then out[short] = "secret"
            else out[short] = tostring(v) end
        end
    end
    return out
end

-- One report line from a describe() result: fields grouped by state, then
-- each error with its message.
local function summarize(label: string, d: unknown): string[]
    if type(d) ~= "table" then return { ("  %s: %s"):format(label, tostring(d)) } end
    local groups: { [string]: string[] }, errors: string[] = {}, {}
    for _, k in ipairs(sortedKeys(d)) do
        local raw = tbl.field(d, k)
        local v = type(raw) == "table" and "table" or tostring(raw)
        if v:find("^error") then
            errors[#errors + 1] = ("    %s %s"):format(k, v)
        else
            local group = groups[v] or {}
            groups[v] = group
            table.insert(group, k)
        end
    end
    local parts: string[] = {}
    for _, s in ipairs({ "readable", "secret", "secret table", "none", "missing", "table" }) do
        local group = groups[s]
        if group then parts[#parts + 1] = s .. " " .. table.concat(group, ", ") end
    end
    local lines = { ("  %s: %s"):format(label, #parts > 0 and table.concat(parts, " · ") or "nothing") }
    for _, e in ipairs(errors) do lines[#lines + 1] = e end
    return lines
end

type Context = { time: string, combat: boolean, instance: string, group: string, size: number, zone: string,
                 level: number, class: unknown, key: string }

local function context(): Context
    local _, instance = IsInInstance()
    local group = IsInRaid() and "raid" or IsInGroup() and "party" or "solo"
    local combat = InCombatLockdown()
    return {
        time = date("%Y-%m-%d %H:%M:%S"),
        combat = combat,
        instance = instance or "none",
        group = group,
        size = GetNumGroupMembers(),
        zone = GetRealZoneText(),
        level = UnitLevel("player"),
        class = select(2, UnitClass("player")),
        key = ("%s%s · %s"):format(combat and "combat · " or "", instance or "none", group),
    }
end

type Client = { version: string, build: string, date: string, toc: number, locale: string, screen: string,
                uiScale: number, useUiScale: unknown }

local function clientInfo(): Client
    local clientVersion, build, buildDate, toc = GetBuildInfo()
    local w, h = GetPhysicalScreenSize()
    return {
        version = clientVersion, build = build, date = buildDate, toc = toc,
        locale = GetLocale(),
        screen = ("%dx%d"):format(w, h),
        uiScale = UIParent:GetScale(),
        useUiScale = GetCVar("useUiScale"),
    }
end

--------------------------------------------------------------------------------
-- Run and report
--------------------------------------------------------------------------------

local function run(): (string, number, number)
    local saved: Saved = { namespaces = {}, enums = {}, scans = {} }
    local report: string[], found, total = {}, 0, 0
    local client, ctx = clientInfo(), context()

    report[#report + 1] = ("SuuUI probe %s · %s"):format(version, ctx.time)
    report[#report + 1] = ("Client %s build %s (interface %d), %s, screen %s, UI scale %.2f (useUiScale %s)")
        :format(client.version, client.build, client.toc, client.locale, client.screen, client.uiScale, tostring(client.useUiScale))
    report[#report + 1] = ("Context: %s, level %d %s, %s")
        :format(ctx.key, ctx.level, tostring(ctx.class or "?"), ctx.zone or "?")

    local sections: { [string]: unknown }[] = {}
    for _, section in ipairs(SECTIONS) do
        report[#report + 1] = ""
        report[#report + 1] = section.title
        local rows: { [string]: unknown }[] = {}
        for _, item in ipairs(section.items) do
            local ok, label, detail = check(item, saved)
            total = total + 1
            if ok then found = found + 1 end
            rows[#rows + 1] = { label = label, ok = ok, detail = detail }
            report[#report + 1] = ("  [%s] %s%s"):format(ok and "ok" or "--", label, detail and ("  (" .. detail .. ")") or "")
        end
        sections[#sections + 1] = { title = section.title, rows = rows }
    end

    local samples = {
        context = ctx,
        units = sampleUnits(),
        cooldowns = sampleCooldowns(),
        messaging = sampleMessaging(saved),
    }

    report[#report + 1] = ""
    report[#report + 1] = "Secret values right now (" .. ctx.key .. ")"
    local function add(lines: string[])
        for _, line in ipairs(lines) do report[#report + 1] = line end
    end
    for _, unit in ipairs(SAMPLE_UNITS) do
        local u = samples.units[unit]
        if u then
            add(summarize(unit, u.fields))
            for _, k in ipairs(sortedKeys(u.auras)) do
                add(summarize("  " .. unit .. " aura " .. k, u.auras[k]))
            end
        end
    end
    for _, k in ipairs(sortedKeys(samples.cooldowns)) do
        add(summarize(k, samples.cooldowns[k]))
    end
    for _, k in ipairs(sortedKeys(samples.messaging)) do
        report[#report + 1] = ("  %s: %s"):format(k, samples.messaging[k])
    end

    report[#report + 1] = ""
    report[#report + 1] = ("Found %d of %d."):format(found, total)

    local db = DB.probe
    db.version = version
    db.client = client
    db.sections = sections
    db.namespaces = saved.namespaces
    db.enums = saved.enums
    db.scans = saved.scans
    db.methods = collectMethods()
    db.cvars = collectCVars()
    db.allNamespaces = sortedKeys(_G, function(k: string, v: unknown): boolean return type(v) == "table" and k:find("^C_") ~= nil end)
    tbl.recordAt(db, "runs")[ctx.key] = samples
    local text = table.concat(report, "\n")
    db.lastReport = text

    return text, found, total
end

--------------------------------------------------------------------------------
-- Report window: a plain, movable frame holding a read-only edit box, so the
-- text can be selected and copied. It is a diagnostic, not part of the design.
--------------------------------------------------------------------------------

type ReportWindow = { frame: Frame, edit: EditBox, report: string }
local window: ReportWindow? = nil

local function buildWindow(): ReportWindow
    local f = CreateFrame("Frame", "SuuUIProbeFrame", UIParent, "BackdropTemplate") :: Frame & BackdropTemplateMixin
    local w: ReportWindow
    f:SetSize(720, 540)
    f:SetPoint("CENTER")
    f:SetFrameStrata("DIALOG")
    f:SetClampedToScreen(true)
    f:EnableMouse(true)
    f:SetMovable(true)
    f:RegisterForDrag("LeftButton")
    f:SetScript("OnDragStart", f.StartMoving)
    f:SetScript("OnDragStop", f.StopMovingOrSizing)
    f:SetBackdrop({ bgFile = "Interface\\Buttons\\WHITE8X8", edgeFile = "Interface\\Buttons\\WHITE8X8", edgeSize = 1 })
    f:SetBackdropColor(0.06, 0.07, 0.09, 0.96)
    f:SetBackdropBorderColor(0.62, 0.50, 0.28, 1)

    local title = f:CreateFontString(nil, "OVERLAY", "GameFontNormalLarge")
    title:SetPoint("TOPLEFT", 14, -12)
    title:SetText("SuuUI probe")

    local hint = f:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
    hint:SetPoint("TOPLEFT", title, "BOTTOMLEFT", 0, -4)
    hint:SetText("Ctrl+A, Ctrl+C copies the report. /reload also saves it to SavedVariables\\SuuUI.lua.")

    local close = CreateFrame("Button", nil, f, "UIPanelCloseButton")
    close:SetPoint("TOPRIGHT", -2, -2)

    local scroll = CreateFrame("ScrollFrame", nil, f, "UIPanelScrollFrameTemplate")
    scroll:SetPoint("TOPLEFT", 14, -56)
    scroll:SetPoint("BOTTOMRIGHT", -34, 14)

    local edit = CreateFrame("EditBox", nil, scroll)
    edit:SetMultiLine(true)
    edit:SetAutoFocus(false)
    edit:SetFontObject(ChatFontNormal)
    edit:SetWidth(660)
    edit:SetScript("OnEscapePressed", function() f:Hide() end)
    -- Read-only: typing puts the report back.
    edit:SetScript("OnTextChanged", function(self, userInput)
        if userInput then self:SetText(w.report) end
    end)
    scroll:SetScrollChild(edit)

    w = { frame = f, edit = edit, report = "" }
    tinsert(UISpecialFrames, "SuuUIProbeFrame")
    return w
end

local function show(text: string)
    local w = window or buildWindow()
    window = w
    w.report = text
    w.edit:SetText(text)
    w.edit:SetCursorPosition(0)
    w.frame:Show()
    w.edit:SetFocus()
    w.edit:HighlightText()
end

-- Run by the diagnostics module's /suu probe.

-- The topics /suu probe takes (the chat's command palette lists them): a
-- new topic in command below goes here too.
export const TOPICS: string[] = {
    "ahdata", "ahpost", "ahscan", "api", "bags", "bagsort", "bankslots", "calendar", "camp", "casttarget", "character", "chat",
    "chatpalette", "class", "collart", "collown", "colltiles", "deathrecap", "dragon", "durability", "filters",
    "flicker", "gamemenu", "garbage", "givers", "group", "hold", "hovertip", "icons", "legacy", "lfg", "loot", "map",
    "mappins", "marks", "memory", "meter", "micro", "minimap", "mountfeet", "mountframe", "npcportrait", "partyauras",
    "plates", "popups", "power", "professions", "proficons", "quest", "questgroup", "raid", "runtime", "show",
    "skysight", "social", "sound", "spellbook", "spells", "support", "taint", "talentbuilds", "talents", "taxi", "timeline",
    "tooltips", "totems", "toymodels", "track", "tree", "unitmenu", "unlearn", "weaponenchants", "windows",
}

export function hide()
    local w = window
    if w then w.frame:Hide() end
end

-- Each topic's command, called with the words after the topic. (One
-- function testing every topic, as before the port, would hold more than
-- Lua's 60 upvalues: one per probe module.)
local TOPIC_COMMANDS: { [string]: (rest: string) -> () } = {
    track = function(rest: string) trackProbe.command(rest) end,
    spells = function(rest: string) spellData.command(rest) end,
    plates = function(rest: string) plateProbe.command(rest) end,
    meter = function(rest: string) meterProbe.command(rest) end,
    timeline = function(rest: string) timelineProbe.command(rest) end,
