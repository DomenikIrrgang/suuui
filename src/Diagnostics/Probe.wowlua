    calendar = function() calendarProbe.command() end,
    proficons = function() profIconProbe.command() end,
    givers = function(rest: string) giverProbe.command(rest) end,
    marks = function(rest: string) markProbe.command(rest) end,
    windows = function(rest: string) windowsProbe.command(rest) end,
    npcportrait = function() npcPortraitProbe.command() end,
    support = function() supportProbe.command() end,
    gamemenu = function() gameMenuProbe.command() end,
    unitmenu = function() menuProbe.command() end,
    dragon = function() dragonProbe.command() end,
    taxi = function(rest: string) taxiProbe.command(rest) end,
    raid = function(rest: string) raidProbe.command(rest) end,
    skysight = function(rest: string) skysightProbe.command(rest) end,
    weaponenchants = function(rest: string) weaponEnchantProbe.command(rest) end,
    chatpalette = function(rest: string) chatPaletteProbe.command(rest) end,
    power = function(rest: string) powerProbe.command(rest) end,
    mappins = function() mapPinsProbe.command() end,
    durability = function(rest: string) durabilityProbe.command(rest) end,
    deathrecap = function() deathRecapProbe.command() end,
    questgroup = function() questGroupProbe.command() end,
    casttarget = function() castTargetProbe.command() end,
    totems = function(rest: string) totemProbe.command(rest) end,
    garbage = function() garbageProbe.command() end,
    memory = function() memoryProbe.command() end,
    bankslots = function(rest: string) bankSlotsProbe.command(rest) end,
    toymodels = function() toyModelProbe.command() end,
    mountfeet = function() mountFeetProbe.command() end,
    mountframe = function(rest: string) mountFrameProbe.command(rest) end,
    collown = function() collectionsOwnProbe.command() end,
    colltiles = function() collectionsTilesProbe.command() end,
    collart = function() collectionsArtProbe.command() end,
    ahscan = function() ahScanProbe.command() end,
    ahpost = function() ahPostProbe.command() end,
