    legacy = function(rest: string) legacyProbe.command(rest) end,
    taint = function() taintProbe.command() end,
    hold = function() holdProbe.command() end,
    talents = function(rest: string) talentProbe.command(rest) end,
    talentbuilds = function(rest: string) talentBuildProbe.command(rest) end,
    group = function(rest: string) groupProbe.command(rest) end,
    class = function() classData.command() end,
    icons = function() iconProbe.command() end,
    api = function(rest: string) apiDocs.command(rest) end,
    runtime = function() apiDocs.runtime() end,
    filters = function() apiDocs.filters() end,
    sound = function(rest: string)
        if rest == "play" then apiDocs.soundPlay() else apiDocs.sound() end
    end,
}

export function command(arg: string?)
    -- a full stop or comma copied along with the command is dropped
    local sub, rest = (arg or ""):gsub("[%.,;:!]+%s*$", ""):match("^(%S*)%s*(.-)$")
    local topic = TOPIC_COMMANDS[sub or ""]
    if topic then
        topic(rest or "")
        return
    end
    if arg == "show" then
        local last = asString(DB.probe.lastReport)
        if last then
            show(last)
        else
            print("No probe report yet. Run /suu probe.")
        end
        return
    end
    local text, found, total = run()
    show(text)
    print(("Probe found %d of %d. /reload to save it for Claude to read."):format(found, total))
end
