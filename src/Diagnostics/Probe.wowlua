    minimap = function(rest: string) minimapProbe.command(rest) end,
    chat = function() chatProbe.command() end,
    quest = function(rest: string) questProbe.command(rest) end,
    popups = function(rest: string) popupProbe.command(rest) end,
    bags = function(rest: string) bagProbe.command(rest) end,
    bagsort = function(rest: string) bagSortProbe.command(rest) end,
    loot = function(rest: string) lootProbe.command(rest) end,
    tooltips = function() tooltipProbe.command() end,
    camp = function() campProbe.command() end,
    partyauras = function(rest: string) partyAuraProbe.command(rest) end,
