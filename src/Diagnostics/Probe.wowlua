    character = function() characterProbe.command() end,
    tree = function(rest: string) treeProbe.command(rest) end,
    spellbook = function(rest: string) spellbookProbe.command(rest) end,
    flicker = function(rest: string) flickerProbe.command(rest) end,
    professions = function() professionProbe.command() end,
    unlearn = function() unlearnProbe.command() end,
