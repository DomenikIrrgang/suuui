-- Every large window open now (named or by its parent's key), to find the
-- ones the probe doesn't know by name (the inspected player's talents).
export function openWindows(): string[]
    local out: string[] = {}
    for _, f in ipairs(wf.children(UIParent)) do
        local okS, shown = pcall(f.IsShown, f)
        if okS and shown and not f:IsForbidden() then
            local w, h = f:GetWidth() or 0, f:GetHeight() or 0
            if not (isSecret(w) or isSecret(h)) and w >= 250 and h >= 200 then
                local okP, protected = pcall(f.IsProtected, f)
                out[#out + 1] = ("%s [%s] %dx%d%s"):format(
                    f:GetName() or "?",
                    f:GetObjectType(),
                    math.floor(w),
                    math.floor(h),
                    (okP and protected) and " PROTECTED" or ""
                )
            end
        end
    end
    table.sort(out)
    return out
end

local function frameInfo(name: string): string
    -- "Parent.Key" for a child kept by key
    local v = tbl.field(_G, name:match("^[^.]+") or "")
    for key in name:gmatch("%.([^.]+)") do
        v = tbl.field(v, key)
    end
    if v == nil then
        return "missing"
    end
    local f = wf.asRegion(v)
    if not f then
        return "not a frame: " .. type(v)
    end
    local okP, protected = pcall(f.IsProtected, f)
    return ("%s shown=%s protected=%s %dx%d"):format(
        f:GetObjectType(),
        show(f:IsShown()),
        show(okP and protected),
        math.floor(f:GetWidth() or 0),
        math.floor(f:GetHeight() or 0)
    )
end

local function apiInfo(path: string): string
    local v = resolve(path)
    if v == nil then
        return "missing"
    end
    if type(v) == "table" then
        local n: string[] = {}
        for k, x in pairs(v) do
            if type(x) == "function" then
                n[#n + 1] = tostring(k)
            end
        end
        table.sort(n)
        return "namespace: " .. table.concat(n, ", ")
    end
    return type(v)
end

-- The client's API documentation for these functions: every flag on them
-- (restrictions and the like), not their arguments.
local function docFlags(names: string[]): string | { [string]: string }
    for _, a in ipairs({
        "Blizzard_APIDocumentationBasic",
        "Blizzard_APIDocumentation",
        "Blizzard_APIDocumentationGenerated",
    }) do
        if C_AddOns.DoesAddOnExist(a) and not C_AddOns.IsAddOnLoaded(a) then
            pcall(C_AddOns.LoadAddOn, a)
        end
    end
    local systems = tbl.field(_G, "APIDocumentation", "systems")
    if systems == nil then
        return "no APIDocumentation"
    end
    local want: { [string]: boolean } = {}
    for _, n in ipairs(names) do
        want[n] = true
    end
    local out: { [string]: string } = {}
    for _, sys in ipairs(tbl.list(systems)) do
        local namespace = tbl.field(sys, "Namespace")
        for _, fn in ipairs(tbl.list(tbl.field(sys, "Functions"))) do
            local name = tostring(tbl.field(fn, "Name"))
            local full = (namespace and (tostring(namespace) .. ".") or "") .. name
            if type(fn) == "table" and (want[full] or want[name]) then
                local flags: string[] = {}
                for k, v in pairs(fn) do
                    if type(v) ~= "table" and type(v) ~= "function" and k ~= "Name" and k ~= "Type" then
                        flags[#flags + 1] = tostring(k) .. "=" .. tostring(v)
                    end
                end
                table.sort(flags)
                out[full] = #flags > 0 and table.concat(flags, " ") or "(no flags)"
            end
        end
    end
    return out
end

-- What each window's APIs give while it's open.
local SAMPLES: { [string]: (s: Record) -> () } = {
    mail = function(s)
        local n = secret.asNumber(raw(GetInboxNumItems)) or 0
        s.inbox = call(GetInboxNumItems)
        local headers: string[] = {}
        s.headers = headers
        for i = 1, math.min(3, n) do
            headers[i] = call(GetInboxHeaderInfo, i)
        end
        s.sendPrice = call(GetSendMailPrice)
    end,
    merchant = function(s)
        local n = secret.asNumber(raw(GetMerchantNumItems)) or 0
        s.items = call(GetMerchantNumItems)
        local sample: Record[] = {}
        s.sample = sample
        for i = 1, math.min(3, n) do
            sample[i] = {
                info = call(tbl.field(_G, "GetMerchantItemInfo"), i),
                infoC = call(tbl.field(_G, "C_MerchantFrame", "GetItemInfo"), i),
                link = call(GetMerchantItemLink, i),
                cost = call(GetMerchantItemCostInfo, i),
                maxStack = call(GetMerchantItemMaxStack, i),
            }
        end
        s.buyback = call(GetNumBuybackItems)
        s.buyback1 = call(GetBuybackItemInfo, 1)
        s.repair = call(CanMerchantRepair)
        s.repairCost = call(GetRepairAllCost)
        s.guildRepair = call(CanGuildBankRepair)
        s.filter = call(GetMerchantFilter)
    end,
    trainer = function(s)
        local n = secret.asNumber(raw(GetNumTrainerServices)) or 0
        s.services = call(GetNumTrainerServices)
        s.greeting = call(GetTrainerGreetingText)
        s.tradeskill = call(IsTradeskillTrainer)
        local filters: { [string]: string } = {}
        s.filters = filters
        for _, f in ipairs({ "available", "unavailable", "used" }) do
            filters[f] = call(GetTrainerServiceTypeFilter, f)
        end
        local sample: Record[] = {}
        s.sample = sample
        for i = 1, math.min(4, n) do
            sample[i] = {
                info = call(GetTrainerServiceInfo, i),
                cost = call(GetTrainerServiceCost, i),
                level = call(GetTrainerServiceLevelReq, i),
                skill = call(GetTrainerServiceSkillReq, i),
                abilityReqs = call(GetTrainerServiceNumAbilityReq, i),
                desc = call(GetTrainerServiceDescription, i),
            }
        end
    end,
    auction = function(s)
        s.canQuery = call(tbl.field(_G, "CanSendAuctionQuery"))
        s.listed = call(tbl.field(_G, "GetNumAuctionItems"), "list")
        s.owner = call(tbl.field(_G, "GetNumAuctionItems"), "owner")
        local ah = C_AuctionHouse
        s.throttleReady = call(ah.IsThrottledMessageSystemReady)
        s.replicate = call(ah.GetNumReplicateItems)
        s.postCount = call(ah.GetAvailablePostCount)
    end,
    gossip = function(s)
        s.text = call(C_GossipInfo.GetText)
        s.options = call(C_GossipInfo.GetOptions)
        s.available = call(C_GossipInfo.GetAvailableQuests)
        s.active = call(C_GossipInfo.GetActiveQuests)
    end,
    quest = function(s)
        s.title = call(GetTitleText)
        s.text = call(GetQuestText)
        s.objective = call(GetObjectiveText)
        s.progress = call(GetProgressText)
        s.reward = call(GetRewardText)
        s.choices = call(GetNumQuestChoices)
        s.rewards = call(GetNumQuestRewards)
        s.firstChoice = call(GetQuestItemInfo, "choice", 1)
        s.firstReward = call(GetQuestItemInfo, "reward", 1)
        s.money = call(GetRewardMoney)
        s.xp = call(GetRewardXP)
        s.completable = call(IsQuestCompletable)
        s.portrait = call(GetQuestPortraitGiver)
    end,
    dressup = function(_s) end,
    macros = function(s)
        s.counts = call(GetNumMacros)
        s.first = call(GetMacroInfo, 1)
        s.icons = #tbl.list(raw(tbl.field(_G, "GetMacroIcons")))
    end,
    addons = function(s)
        s.count = call(C_AddOns.GetNumAddOns)
        local list: string[] = {}
        for i = 1, math.min(C_AddOns.GetNumAddOns(), 20) do
            list[i] = call(C_AddOns.GetAddOnInfo, i) ..
                " | state " ..
                    call(C_AddOns.GetAddOnEnableState, i, UnitName("player")) ..
                        " | deps " .. call(C_AddOns.GetAddOnDependencies, i)
        end
        s.list = list
        s.disallowed = call(C_AddOns.GetScriptsDisallowedForBeta)
    end,
    help = function(s)
        local f = wf.find("HelpFrame")
        local kinds: string[] = {}
        if f then
            for _, c in ipairs(wf.children(f)) do
                kinds[#kinds + 1] = ("%s %s shown=%s"):format(
                    c:GetObjectType(),
                    c:GetName() or c:GetDebugName() or "?",
                    show(c:IsShown())
                )
            end
        end
        s.children = kinds
    end,
    gamemenu = function(s)
        -- its buttons: each one's text and what it is
        local f = wf.find("GameMenuFrame")
        local buttons: string[] = {}
        for _, child in ipairs(f and wf.children(f) or {}) do
            local c = wf.asButton(child)
            if c and c:IsShown() then
                local okP, protected = pcall(c.IsProtected, c)
                buttons[#buttons + 1] = ("%s \"%s\"%s"):format(
                    c:GetName() or "?",
                    show(c:GetText()),
                    (okP and protected) and " PROTECTED" or ""
                )
            end
        end
        s.buttons = buttons
    end,
    inspect = function(s)
        s.canInspect = call(CanInspect, "target")
        s.itemLevel = call(tbl.field(C_PaperDollInfo, "GetInspectItemLevel"), "target")
        s.head = call(GetInventoryItemLink, "target", 1)
        s.talentTabs = call(tbl.field(_G, "GetNumTalentTabs"), true)
        s.firstTab = call(GetTalentTabInfo, 1, true)
    end,
    collections = function(s)
        s.mounts = call(tbl.field(_G, "C_MountJournal", "GetNumMounts"))
        s.mountsShown = call(tbl.field(_G, "C_MountJournal", "GetNumDisplayedMounts"))
        s.pets = call(tbl.field(_G, "C_PetJournal", "GetNumPets"))
        s.toys = call(tbl.field(_G, "C_ToyBox", "GetNumToys"))
        s.heirlooms = call(tbl.field(_G, "C_Heirloom", "GetNumHeirlooms"))
        local j = wf.find("CollectionsJournal")
        local tabs: string[] = {}
        s.tabs = tabs
        for i = 1, 8 do
            local t = wf.asButton(wf.find("CollectionsJournalTab" .. i))
            if t then
                local fs = wf.asFontString(tbl.field(t, "Text")) or t:GetFontString()
                tabs[i] = ("%s shown=%s"):format(show(fs and fs:GetText()), show(t:IsShown()))
            end
        end
        s.selectedTab = j and show(tbl.field(j, "selectedTab")) or "no journal"
    end,
}

local function store(): Record
    return tbl.recordAt(DB.probe, "windows")
end

-- One window as it shows now.
export function snapshot(key: string)
    local def = WINDOWS[key] :: Window
    local s: Record = { at = date("%Y-%m-%d %H:%M:%S"), combat = InCombatLockdown() }
    local frameList: { [string]: string } = {}
    s.frames = frameList
    for _, name in ipairs(def.frames) do
        frameList[name] = frameInfo(name)
    end
    local sampleFn = SAMPLES[key]
    if sampleFn then
        local ok, err = pcall(sampleFn, s)
        if not ok then
            s.sampleError = tostring(err)
        end
    end
    s.openWindows = openWindows()
    -- the open window's tree: the first of its frames that shows
    local treeLines = 0
    for _, name in ipairs(def.frames) do
        local f = wf.find(name)
        if f and f:IsShown() then
            local out: string[] = {}
            tree(f, 1, out, "")
            s.treeOf, s.tree = name, out
            treeLines = #out
            break
        end
    end
    -- every named frame of its family that shows (popups, side panels)
    local prefix = def.frames[1]:gsub("Frame$", ""):gsub("Journal$", "")
    local named: string[] = {}
    for k, value in pairs(_G) do
        local v = type(k) == "string" and k:find("^" .. prefix) and not k:find("%d$") and wf.asRegion(value)
        if type(k) == "string" and v then
            local okS, shown = pcall(v.IsShown, v)
            if okS and shown then
                named[#named + 1] = k .. " [" .. v:GetObjectType() .. "]"
            end
            if #named > 80 then
                break
            end
        end
    end
    table.sort(named)
    s.shownNamed = named
    store()[key] = s
    print(("Windows probe: %s saved (%s lines of its frames); /reload when you're done."):format(key, treeLines))
end

-- What exists now, before any window opens.
export function static()
    local w = store()
    local found: Record = { at = date("%Y-%m-%d %H:%M:%S") }
    w.static = found
    local names: string[] = {}
    for _, key in ipairs(ORDER) do
        local def = WINDOWS[key] :: Window
        local frameList: { [string]: string }, apis: { [string]: string }, addons: { [string]: string } = {}, {}, {}
        for _, a in ipairs(def.addons or {}) do
            addons[a] = ("exists=%s loaded=%s lod=%s"):format(
                show(C_AddOns.DoesAddOnExist(a)),
                show((C_AddOns.IsAddOnLoaded(a))),
                show(C_AddOns.IsAddOnLoadOnDemand(a))
            )
        end
        for _, name in ipairs(def.frames) do
            frameList[name] = frameInfo(name)
        end
        for _, api in ipairs(def.apis) do
            apis[api] = apiInfo(api)
            names[#names + 1] = api
        end
        found[key] = { frames = frameList, apis = apis, addons = addons }
    end
    found.docs = docFlags(names)
end

-- For 30 minutes: each window as it opens (a moment after, when its
-- lists are filled); Collections when its journal shows.
export function arm()
    local f = frame or CreateFrame("Frame")
    frame = f
    f:UnregisterAllEvents()
    local byEvent: { [string]: string } = {}
    for _, key in ipairs(ORDER) do
        for _, e in ipairs((WINDOWS[key] :: Window).events or {}) do
            byEvent[e] = key
            pcall(f.RegisterEvent, f, e)
        end
    end
    local untilT = GetTime() + 30 * 60
    f:SetScript("OnEvent", function(_, event: string)
        if GetTime() > untilT then
            f:UnregisterAllEvents()
            return
        end
        local key = byEvent[event]
        if key then
            after(0.6, function()
                snapshot(key)
            end)
        end
    end)
    local function hookJournal()
        local j = wf.find("CollectionsJournal")
        if j and not journalHooked then
            journalHooked = true
            hookScript(j, "OnShow", function()
                if GetTime() <= untilT then
                    after(0.6, function()
                        snapshot("collections")
                    end)
                end
            end)
        end
    end
    hookJournal()
    local d = wf.find("DressUpFrame")
    if d and not dressHooked then
        dressHooked = true
        hookScript(d, "OnShow", function()
            if GetTime() <= untilT then
                after(0.6, function()
                    snapshot("dressup")
                end)
            end
        end)
    end
    -- inspect: saved when its window shows (INSPECT_READY came before it did)
    local function hookInspect()
        local i = wf.find("InspectFrame")
        if i and not inspectHooked then
            inspectHooked = true
            hookScript(i, "OnShow", function()
                if GetTime() <= untilT then
                    after(0.8, function()
                        snapshot("inspect")
                    end)
                end
            end)
        end
    end
    hookInspect()
    if not inspectHooked then
        onAddonLoaded("Blizzard_InspectUI", hookInspect)
    end
    local g = wf.find("GameMenuFrame")
    if g and not menuHooked then
        menuHooked = true
        hookScript(g, "OnShow", function()
            if GetTime() <= untilT then
                after(0.3, function()
                    snapshot("gamemenu")
                end)
            end
        end)
    end
    -- the game menu's windows, each when it shows
    local function hookShow(key: string, name: string)
        local w = wf.find(name)
        local hooked = shownHooked or {}
        shownHooked = hooked
        if w and not hooked[key] then
            hooked[key] = true
            hookScript(w, "OnShow", function()
                if GetTime() <= untilT then
                    after(0.6, function()
                        snapshot(key)
                    end)
                end
            end)
        end
    end
    hookShow("addons", "AddonList")
    hookShow("help", "HelpFrame")
    hookShow("macros", "MacroFrame")
    if not (shownHooked and shownHooked.macros) then
        onAddonLoaded("Blizzard_MacroUI", function()
            hookShow("macros", "MacroFrame")
        end)
    end
    if not journalHooked then
        onAddonLoaded("Blizzard_Collections", hookJournal)
    end
end

-- Whatever is open now: every large window and the tree of each.
export function now()
    local s = {
        at = date("%Y-%m-%d %H:%M:%S"),
        combat = InCombatLockdown(),
        openWindows = openWindows(),
        trees = {} :: { [string]: string[] },
    }
    for _, f in ipairs(wf.children(UIParent)) do
        local okS, shown = pcall(f.IsShown, f)
        local w, h = f:GetWidth() or 0, f:GetHeight() or 0
        local name = f:GetName()
        if okS and shown and not f:IsForbidden() and not (isSecret(w) or isSecret(h)) and w >= 250 and h >= 200 and
            name and
            not name:find("^SuuUI") then
            local out: string[] = {}
            tree(f, 1, out, "")
            s.trees[name] = out
        end
    end
    store().now = s
    print(("Windows probe: %d open windows saved; /reload to save them."):format(#s.openWindows))
end

export function command(rest: string?)
    if rest == "now" then
        return now()
    end
    static()
    arm()
    print(
        "Windows probe: the frames and APIs saved. For 30 minutes, each window is saved as it opens: visit a vendor, a mailbox, a class trainer, the auction house and open Collections, then /reload."
    )
end
