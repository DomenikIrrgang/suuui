-- Diagnostics/WindowsProbe.wowlua
-- "/suu probe windows": what the remaining windows (3.6: mail, merchant,
-- trainer, auction house, collections; 3.7, asked 2026-10-17: gossip, the
-- quest dialog, the dressing room, inspect, the inspected player's
-- talents and the game menu) are on Forever, for their designs. "/suu probe windows now"
-- saves whatever is open (a window it doesn't know by name).
-- Saved in SuuUIProbe.windows on /reload; kept across runs, one entry per
-- window, so visit them one by one.
--   * now: which of their frames and APIs exist, and how the client's own
--     API documentation flags the functions behind buying, sending,
--     training and bidding (restrictions)
--   * then, for 30 minutes, each window as it opens: its frame tree (frames
--     and texts, sizes, anchors, protected or not), the frames it shows,
--     and a sample of what its APIs give (three merchant items, mails,
--     trainer services, the auction house's state, collection counts)
--
--   /suu probe windows    then visit a vendor, a mailbox, a class trainer,
--                         the auction house, open Collections; then /reload

import * as DB from "/Core/DB"
import print from "/Core/Init"
import hookScript from "wowlua:hooks"
import onAddonLoaded from "wowlua:lifecycle"
import isSecret from "wowlua:secret"
import after from "wowlua:timer"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"
import * as secret from "wowlua:secret"

-- a window the probe knows: its frames, load-on-demand addons, events, APIs
type Window = { frames: string[], addons?: string[], events?: string[], apis: string[] }
type Record = { [string]: unknown }

-- the event frame and which windows' OnShow are hooked (once a session)
local frame: Frame? = nil
local journalHooked, dressHooked, inspectHooked, menuHooked = false, false, false, false
local shownHooked: { [string]: boolean }? = nil

local function show(v: unknown, depth: number?): string
    depth = depth or 0
    if isSecret(v) then
        return "secret"
    end
    if v == nil then
        return "nil"
    end
    if type(v) == "table" then
        if depth > 2 then
            return "{…}"
        end
        local parts: string[] = {}
        for k, x in pairs(v) do
            if type(x) ~= "function" then
                parts[#parts + 1] = tostring(k) .. "=" .. show(x, depth + 1)
            end
            if #parts > 40 then
                break
            end
        end
        table.sort(parts)
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

-- a call's every result, or why it failed
local function call(fn: unknown, ...: unknown): string
    if type(fn) ~= "function" then
        return "missing"
    end
    local res = { pcall(fn, ...) }
    if not res[1] then
        return "error: " .. tostring(res[2]):sub(1, 160)
    end
    local parts: string[] = {}
    for i = 2, math.max(2, select("#", unpack(res))) do
        parts[#parts + 1] = show(res[i])
    end
    return table.concat(parts, " | ")
end

-- a call's first result as it is (nil when it's missing or raises)
local function raw(fn: unknown, ...: unknown): unknown
    if type(fn) ~= "function" then
        return nil
    end
    local ok, a = pcall(fn, ...)
    if ok then
        return a
    end
    return nil
end

-- "C_MountJournal.GetNumMounts" -> the function, or nil
local function resolve(path: string): unknown
    local t: unknown = _G
    for part in path:gmatch("[^%.]+") do
        if type(t) ~= "table" then
            return nil
        end
        t = tbl.field(t, part)
    end
    return t
end

-- (each part's key on its parent, for anchors to parts without a name)
local probeKeys: { [Region]: string } = tbl.weakKeys()

local function anchorOf(r: Region): string
    local ok, point, rel, relPoint, x, y = pcall(r.GetPoint, r, 1)
    if not ok or not point then
        return ""
    end
    local relName = rel and (rel:GetName() or probeKeys[rel] or "?") or "nil"
    return (" @%s>%s.%s %d,%d"):format(
        tostring(point),
        tostring(relName),
        tostring(relPoint),
        math.floor(x or 0),
        math.floor(y or 0)
    )
end

-- frames and texts (no textures: the trees are long enough), 700 lines at most
local function tree(f: Frame, depth: number, out: string[], prefix: string)
    if depth > 7 or #out >= 700 then
        return
    end
    local keys: { [Region]: string } = {}
    for k, part in pairs(wf.keyed(f)) do
        keys[part] = k
    end
    for _, r in ipairs(wf.fontStrings(f)) do
        if #out < 700 then
            local text = r:GetText()
            if text and text ~= "" then
                out[#out + 1] = ("%s. %s [FS] shown=%s %dx%d \"%s\""):format(
                    prefix,
                    r:GetName() or keys[r] or "?",
                    show(r:IsShown()),
                    math.floor(r:GetWidth() or 0),
                    math.floor(r:GetHeight() or 0),
                    show(text):sub(1, 60)
                )
            end
        end
    end
    for _, c in ipairs(wf.children(f)) do
        if #out >= 700 then
            return
        end
        probeKeys[c] = keys[c]
        local okP, protected = pcall(c.IsProtected, c)
        out[#out + 1] = ("%s%s [%s] shown=%s %dx%d%s%s"):format(
            prefix,
            c:GetName() or keys[c] or "?",
            c:GetObjectType(),
            show(c:IsShown()),
            math.floor(c:GetWidth() or 0),
            math.floor(c:GetHeight() or 0),
            anchorOf(c),
            (okP and protected) and " PROTECTED" or ""
        )
        tree(c, depth + 1, out, prefix .. "  ")
    end
end

