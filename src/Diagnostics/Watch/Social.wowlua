-- Diagnostics/Watch/Social.wowlua
-- The group finder and the people around you:
--   LFG-opens     how the Group Finder was opened and whether its search on
--                 opening was refused (Diagnostics/LfgProbe's "opens"
--                 watcher, armed quietly and without searches of its own;
--                 five openings with a search)
--   GRP-9         whether a /who still prints to chat after a search on
--                 SuuUI's Who page (who-to-UI left on)
--   COMM-senders  how CHAT_MSG_ADDON names its sender compared with
--                 UnitName / GetUnitName of the group's unit: only whether
--                 the forms match and their shape, never a name

import SuuUI from "/Core/API"
import * as DB from "/Core/DB"
import * as lfgProbe from "/Diagnostics/LfgProbe"
import isSecret, asString from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"
import * as kit from "./Kit"

type Item = kit.Item
type Result = kit.Result
type Watch = kit.Watch

--------------------------------------------------------------------------------
-- LFG-opens
--------------------------------------------------------------------------------

local OPENINGS = 5
-- whether "all" armed LfgProbe's watcher (its off is then ours to call)
local lfgArmed = false

local function openings(): unknown[]
    return tbl.list(tbl.field(DB.probe, "lfg", "opens", "openings"))
end

local function searched(list: unknown[]): unknown[]
    local out: unknown[] = {}
    for _, o in ipairs(list) do
        if tbl.field(o, "by") ~= "none" then
            out[#out + 1] = o
        end
    end
    return out
end

local function sumLfg(_r: Result): string
    local list = searched(openings())
    local refused, binding, click, micro = 0, 0, 0, 0
    for _, o in ipairs(list) do
        refused += tbl.field(o, "refused") == true and 1 or 0
        binding += tbl.field(o, "openedBy", "binding") == true and 1 or 0
        click += tbl.field(o, "openedBy", "click") == true and 1 or 0
        micro += tbl.field(o, "openedBy", "microButton") == true and 1 or 0
    end
    return ("%d openings with a search: refused %d, allowed %d; opened by the key binding %d, by a click %d (the micro button %d). Each in SuuUIProbe.lfg.opens"):format(
        #list,
        refused,
        #list - refused,
        binding,
        click,
        micro
    )
end

local function armLfg(w: Watch)
    local function start(): boolean
        if lfgArmed then
            return true
        end
        lfgArmed = lfgProbe.opensTest(true, {
            keep = true,
            quiet = true,
            passive = true,
            onOpening = function(list: { [string]: unknown }[])
                if w.active and #searched(list :: unknown[]) >= OPENINGS then
                    w:finish(nil)
                end
            end,
        })
        return lfgArmed
    end
    if #searched(openings()) >= OPENINGS then
        w:finish(nil)
        return
    end
    if not start() then
        w:on("ADDON_LOADED", function(_, name: unknown)
            if name == "Blizzard_GroupFinder_VanillaStyle" then
                start()
            end
        end)
    end
end

local function stopLfg()
    if lfgArmed then
        lfgArmed = false
        lfgProbe.opensTest(false, { quiet = true })
    end
end

--------------------------------------------------------------------------------
-- GRP-9
--------------------------------------------------------------------------------

local function suuWhoShown(): boolean
    local ok, shown = pcall(function(): boolean
        local m = SuuUI.GetModule("groupfinder")
        local who = wf.asFrame(tbl.field(m, "who"))
        return who ~= nil and who:IsVisible()
    end)
    return ok and shown
end

local function blizzardWhoShown(): boolean
    for _, name in ipairs({ "WhoFrame", "LFGWhoListFrame" }) do
        local f = wf.find(name)
        if f and f:IsVisible() then
            return true
        end
    end
    return false
end

local function armWho(w: Watch)
    local afterSuu = false
    local pending = false
    local printed = false
    local p = kit.pattern(tbl.field(_G, "WHO_NUM_RESULTS"))
    w:on("CHAT_MSG_SYSTEM", function(_, text: unknown)
        if isSecret(text) or type(text) ~= "string" or not p then
            return
        end
        if text:find(p) then
            printed = true
            if afterSuu and not suuWhoShown() then
                w:finish("after a search on SuuUI's Who page, a /who's result still printed to chat", {
                    printedToChat = true,
                })
            end
        end
    end)
    w:on("WHO_LIST_UPDATE", function()
        if suuWhoShown() then
            afterSuu = true
            return
        end
        if not afterSuu or blizzardWhoShown() or pending then
            return
        end
        -- a /who (or another addon's) while no Who page shows: its result
        -- went to the list; did a chat line come too?
        pending = true
        printed = false
        w:after(0.5, function()
            pending = false
            if not printed then
                w:finish(
                    "after a search on SuuUI's Who page, a /who's result went to the who list (WHO_LIST_UPDATE), not to chat: who-to-UI stayed on",
                    { printedToChat = false }
                )
            end
        end)
    end)
end

--------------------------------------------------------------------------------
-- COMM-senders
--------------------------------------------------------------------------------

local GROUP_CHANNELS: { [string]: boolean } = { PARTY = true, RAID = true, INSTANCE_CHAT = true }

local function shape(s: string): string
    local hasDash, hasSpace = s:find("-", 1, true) ~= nil, s:find(" ", 1, true) ~= nil
    if hasDash then
        return hasSpace and "Name Surname-Realm" or "Name-Realm"
    end
    return hasSpace and "Name Surname" or "Name"
end

local function groupUnits(): string[]
    local out: string[] = {}
    if IsInRaid() then
        for i = 1, 40 do
            out[#out + 1] = "raid" .. i
        end
    else
        for i = 1, 4 do
            out[#out + 1] = "party" .. i
        end
    end
    return out
end

-- How the sender matches the group's unit: which form equals it, and
-- whether the unit is of another realm. Nothing of the names is kept.
local function match(sender: string): Result?
    for _, unit in ipairs(groupUnits()) do
        if UnitExists(unit) then
            local name, realm = UnitName(unit)
            local full = GetUnitName(unit, true)
            local n, r, f = asString(name), asString(realm), asString(full)
            if n then
                local other = r ~= nil and r ~= ""
                local forms: { [string]: boolean } = {
                    ["UnitName"] = sender == n,
                    ["UnitName-realm"] = other and sender == (n .. "-" .. (r or "")) or false,
                    ["GetUnitName(unit, true)"] = f ~= nil and sender == f,
                }
                local any = false
                for _, yes in pairs(forms) do
                    any = any or yes
                end
                -- the sender's name part is the unit's: the same person
                local base = sender:match("^([^-]+)") or sender
                if any or base == n then
                    return { unitRealm = other and "other realm" or "same realm", matches = forms, unitNameShape = shape(f or n) }
                end
            end
        end
    end
    return nil
end

local function armSenders(w: Watch)
    -- this session's senders seen (memory only, never saved)
    local seen: { [string]: boolean } = {}
    w:on("CHAT_MSG_ADDON", function(_, _prefix: unknown, _text: unknown, channel: unknown, sender: unknown)
        if isSecret(channel) or isSecret(sender) or type(sender) ~= "string" or type(channel) ~= "string" then
            return
        end
        if not GROUP_CHANNELS[channel] or seen[sender] then
            return
        end
        seen[sender] = true
        local me = asString((UnitName("player")))
        if me and (sender == me or sender:match("^([^-]+)") == me) then
            return
        end
        local m = match(sender)
        local fields: Result = { channel = channel, senderShape = shape(sender) }
        if m then
            for k, v in pairs(m) do
                fields[k] = v
            end
        else
            fields.unitRealm = "no unit of the group matched"
        end
        local key = fields.unitRealm == "other realm" and "a sender of another realm" or "a sender of your realm"
        if not w:has(key) and fields.unitRealm ~= "no unit of the group matched" then
            w:case(key, fields)
            return
        end
        -- more of the same: kept as samples (up to eight)
        local r = w:result()
        local more = tbl.listAt(r, "samples")
        if #more < 8 then
            fields.at = kit.stamp()
            more[#more + 1] = fields
        end
    end)
end

local function sumSenders(r: Result): string
    local cases = r.cases :: { [string]: Result }? or {}
    local parts: string[] = {}
    for _, key in ipairs({ "a sender of your realm", "a sender of another realm" }) do
        local c = cases[key]
        if c then
            local forms: string[] = {}
            for form, yes in pairs(tbl.field(c, "matches") :: { [string]: boolean }? or {}) do
                if yes then
                    forms[#forms + 1] = form
                end
            end
            table.sort(forms)
            parts[#parts + 1] = ("%s: shaped %s, equal to %s"):format(
                key,
                tostring(c.senderShape),
                #forms == 0 and "no form of the unit's name" or table.concat(forms, " and ")
            )
        end
    end
    return table.concat(parts, "; ")
end

export function items(): Item[]
    return {
        {
            id = "LFG-opens",
            kind = kit.Kind.Armed,

            when = "the group finder",
            question = "Opening the Group Finder: is its search on opening refused, and how was it opened (key binding, micro button, click)?",
            todo = ("open the Group Finder %d times (key I or the micro menu), a minute or more apart (it searches at most once a minute)"):format(
                OPENINGS
            ),
            arm = armLfg,
            stop = stopLfg,
            summarize = sumLfg,
        },
        {
            id = "GRP-9",
            kind = kit.Kind.Armed,

            when = "the group finder",
            question = "After a search on SuuUI's Who page, does a typed /who still print to chat? (Blizzard's own Who pages, in the Forever UI source: SetWhoToUi(true) on show, false on hide.)",
            todo = "search on SuuUI's Who page, close it, then type /who with a name in the chat",
            arm = armWho,
        },
        {
            id = "COMM-senders",
            kind = kit.Kind.Armed,

            when = "a group",
            question = "How does CHAT_MSG_ADDON name a group member, compared with UnitName and GetUnitName(unit, true), for your realm and another realm?",
            todo = "be in a group with SuuUI or other addon users (any addon that talks to the group), one of them from another realm",
            cases = { "a sender of your realm", "a sender of another realm" },
            arm = armSenders,
            summarize = sumSenders,
        },
    }
end
