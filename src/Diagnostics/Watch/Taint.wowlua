-- Diagnostics/Watch/Taint.wowlua
-- The "does X taint Y" questions. Each takes the taint scan
-- (Core/TaintScan, through kit.moment: what it newly lists since the
-- previous moment, and the blocked actions around it) at the moment the
-- review names, plus the values that moment is about (issecurevariable),
-- and where the question is about what follows, the blocked actions of the
-- next fight. The moments come from events, Blizzard's EventRegistry (its
-- listeners run through secureexecuterange: their taint stays theirs), secure
-- post-hooks on SuuUI's own module (Chat's OpenChatSettings), on two
-- Blizzard globals the scan doesn't check (PaperDollFrame_SetPet,
-- PaperDollFrame_SetSidebar) and on the game's tell functions and its chat
-- line chooser (ChatFrameUtil.SendTell/SendTellWithMessage,
-- ChooseBoxForSend: hooksecurefunc leaves the
-- field secure, and the game's code after the call runs with its own taint
-- again once the hook returns; the hook only reads the stack and an edit
-- box's chat type), a script hook on SuuUI's own windows
-- (OnHide), and one on the chat edit boxes' OnTabPressed (a key's own
-- handler: nothing of the game's runs after it). Never a hook inside a flow
-- of the game's (an edit box's attribute change, the map's OnShow).

import SuuUI from "/Core/API"
import asString from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"
import * as kit from "./Kit"

type Item = kit.Item
type Result = kit.Result
type Watch = kit.Watch

local function stateOf(path: string, key: string): string
    local t = kit.resolve(path)
    if t == nil then
        return "missing"
    end
    return kit.secureState(t, key)
end

-- The chat windows' edit boxes there are.
local function editBoxes(): Frame[]
    local out: Frame[] = {}
    for i = 1, 10 do
        local box = wf.find(("ChatFrame%dEditBox"):format(i))
        if box then
            out[#out + 1] = box
        end
    end
    return out
end

-- In the next fight (or the one going on), and at its end: fn(blocked
-- actions since it started).
local function afterFight(w: Watch, fn: (blocked: string[]) -> ())
    local started = InCombatLockdown() and GetTime() or nil
    w:on("PLAYER_REGEN_DISABLED", function()
        started = GetTime()
    end)
    w:on("PLAYER_REGEN_ENABLED", function()
        local t = started
        if t then
            started = nil
            fn(kit.blockedSince(t))
        end
    end)
end

local function blockedWords(list: string[]): string
    return #list == 0 and "nothing blocked" or ("blocked: " .. table.concat(list, "; "))
end

local function newlyWords(m: Result): string
    local list = m.newlyWritten
    local n = type(list) == "table" and #(list :: unknown[]) or 0
    return n == 0 and "no new addon-written values" or ("%d new addon-written values"):format(n)
end

--------------------------------------------------------------------------------
-- CHAT-12 and X-6.3: the chat settings opened from a SuuUI tab
--------------------------------------------------------------------------------

local function chatModule(): unknown
    local ok, m = pcall(SuuUI.GetModule, "chat")
    return ok and m or nil
end

local function chatSettingsMoment(): Result
    local config = wf.find("ChatConfigFrame")
    return kit.moment("chat settings opened from a SuuUI tab", {
        CURRENT_CHAT_FRAME_ID = kit.secureState(nil, "CURRENT_CHAT_FRAME_ID"),
        settingsShown = config and config:IsShown() or false,
    }, 0.5)
end

local function armChatSettings(w: Watch)
    local m = chatModule()
    if not m then
        w:finish("the Chat module isn't there: nothing to record", {})
        return
    end
    w:hook(m, "OpenChatSettings", function()
        w:case(InCombatLockdown() and "in a fight" or "out of combat", chatSettingsMoment())
    end)
end

local function sumChatSettings(r: Result): string
    local cases = r.cases :: { [string]: Result }? or {}
    local parts: string[] = {}
    for _, key in ipairs({ "out of combat", "in a fight" }) do
        local c = cases[key]
        if c then
            local checks = c.checks :: Result? or {}
            parts[#parts + 1] = ("%s: settings %s, CURRENT_CHAT_FRAME_ID %s, %s, %s"):format(
                key,
                checks.settingsShown and "shown" or "not shown",
                tostring(checks.CURRENT_CHAT_FRAME_ID),
                newlyWords(c),
                blockedWords(tbl.list(c.blocked) :: string[])
            )
        end
    end
    return table.concat(parts, "; ")
end

local function armChatGlobal(w: Watch)
    local m = chatModule()
    if not m then
        w:finish("the Chat module isn't there: nothing to record", {})
        return
    end
    local opened: Result? = nil
    w:hook(m, "OpenChatSettings", function()
        if not opened and not InCombatLockdown() then
            opened = chatSettingsMoment()
        end
    end)
    afterFight(w, function(blocked: string[])
        local o = opened
        if not o then
            return
        end
        local checks = o.checks :: Result? or {}
        w:finish(
            ("after the chat settings opened from a SuuUI tab, CURRENT_CHAT_FRAME_ID was %s; the next fight: %s"):format(
                tostring(checks.CURRENT_CHAT_FRAME_ID),
                blockedWords(blocked)
            ),
            { opened = o, nextFight = kit.moment("the end of the next fight"), blockedInFight = blocked }
        )
    end)
end

--------------------------------------------------------------------------------
-- X-6.1: Tab in a chat edit box in a fight
--------------------------------------------------------------------------------

local function armTab(w: Watch)
    local pressed: Result? = nil
    for _, box in ipairs(editBoxes()) do
        w:hookScript(box, "OnTabPressed", function()
            if pressed or not InCombatLockdown() then
                return
            end
            pressed = kit.moment("Tab in a chat edit box, in a fight", {
                ChatEdit_CustomTabPressed = kit.secureState(nil, "ChatEdit_CustomTabPressed"),
            }, 0.5)
        end)
    end
    afterFight(w, function(blocked: string[])
        local p = pressed
        if not p then
            return
        end
        w:finish(("Tab in a chat edit box in a fight: %s at the press; the rest of the fight: %s"):format(
            newlyWords(p),
            blockedWords(blocked)
        ), { pressed = p, blockedInFight = blocked })
    end)
end

--------------------------------------------------------------------------------
-- X-6.2: a SuuUI window closed in a fight while a protected Blizzard window
-- is open (Escape walks UISpecialFrames)
--------------------------------------------------------------------------------

const BLIZZARD_WINDOWS: string[] = {
    "PlayerSpellsFrame",
    "SpellBookFrame",
    "PlayerTalentFrame",
    "ClassTalentFrame",
    "CollectionsJournal",
    "CharacterFrame",
    "WorldMapFrame",
    "FriendsFrame",
    "PVEFrame",
    "AchievementFrame",
    "MacroFrame",
    "EncounterJournal",
}

-- The protected Blizzard windows shown now, by name.
local function protectedOpen(): string[]
    local out: string[] = {}
    for _, name in ipairs(BLIZZARD_WINDOWS) do
        local f = wf.find(name)
        if f then
            local ok, shown, prot = pcall(function(): (boolean, unknown)
                local p = f:IsProtected()
                return f:IsShown(), p
            end)
            if ok and shown and prot == true then
                out[#out + 1] = name
            end
        end
    end
    return out
end

local function armEscape(w: Watch)
    local hooked: { [string]: boolean } = {}
    local busy = false
    local function onHide()
        if busy or not InCombatLockdown() then
            return
        end
        local open = protectedOpen()
        if #open == 0 then
            return
        end
        busy = true
        local t = GetTime()
        local m = kit.moment("a SuuUI window closed in a fight with a protected Blizzard window open", nil, 0.5)
        w:after(1, function()
            local still: string[] = {}
            for _, name in ipairs(open) do
                local f = wf.find(name)
                if f and f:IsShown() then
                    still[#still + 1] = name
                end
            end
            local blocked = kit.blockedSince(t - 0.5)
            w:finish(
                ("a SuuUI window closed in a fight with %s open: %s still open a second later; %s; %s"):format(
                    table.concat(open, ", "),
                    #still == 0 and "none" or table.concat(still, ", "),
                    newlyWords(m),
                    blockedWords(blocked)
                ),
                { open = open, stillOpen = still, moment = m, blockedAfter = blocked }
            )
        end)
    end
    -- SuuUI's windows in the list Escape walks (made when first opened:
    -- looked for again at each fight's start)
    local function hookNew()
        local list = tbl.field(_G, "UISpecialFrames")
        if type(list) ~= "table" then
            return
        end
        for _, name in ipairs(list :: unknown[]) do
            local n = asString(name)
            if n and not hooked[n] and n:find("^SuuUI") then
                local f = wf.find(n)
                if f then
                    hooked[n] = true
                    w:hookScript(f, "OnHide", onHide)
                end
            end
        end
    end
    hookNew()
    w:on("PLAYER_REGEN_DISABLED", hookNew)
end

--------------------------------------------------------------------------------
-- UIW-7: a group finder listing posted
--------------------------------------------------------------------------------

local function categoryChecks(): { [string]: string }
    local out: { [string]: string } = {}
    local buttons = kit.resolve("LFGListingFrame.CategoryView.CategoryButtons")
    if type(buttons) == "table" then
        for i, b in ipairs(buttons :: unknown[]) do
            out[("CategoryButtons[%d].fixedWidth"):format(i)] = kit.secureState(b, "fixedWidth")
            out[("CategoryButtons[%d].fixedHeight"):format(i)] = kit.secureState(b, "fixedHeight")
        end
    end
    return out
end

local function armListing(w: Watch)
    w:on("LFG_LIST_ACTIVE_ENTRY_UPDATE", function(_, created: unknown)
        if created ~= true then
            return
        end
        local checks = categoryChecks()
        local written = 0
        for _, s in pairs(checks) do
            if s:find("^written") then
                written += 1
            end
        end
        local m = kit.moment("a group finder listing posted", checks, 2)
        w:finish(("listing posted: %d of the category buttons' fixed sizes written by addon code; %s; %s"):format(
            written,
            newlyWords(m),
            blockedWords(tbl.list(m.blocked) :: string[])
        ), { moment = m })
    end)
    -- a post the game refused never sends the update
    for _, e in ipairs({ "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN" }) do
        w:on(e, function(_, _addon: unknown, func: unknown)
            local f = tostring(func)
            if f:find("LFGList") or f:find("Listing") then
                local m = kit.moment("a group finder listing refused", categoryChecks(), 1)
                w:finish(("posting a listing was refused (%s %s)"):format(e, f), { moment = m })
            end
        end)
    end
end

--------------------------------------------------------------------------------
-- CHAR-28: the Pet tab out of combat, then the side panes in a fight
--------------------------------------------------------------------------------

local function paperDollChecks(): { [string]: string }
    return {
        ["PaperDollFrame.currentSideBar"] = stateOf("PaperDollFrame", "currentSideBar"),
        PaperDollFrame_SetSidebar = kit.secureState(nil, "PaperDollFrame_SetSidebar"),
        PaperDollFrame_SetPet = kit.secureState(nil, "PaperDollFrame_SetPet"),
    }
end

local function armPetTab(w: Watch)
    local hasPet = w:hook("PaperDollFrame_SetPet", nil, function()
        if not InCombatLockdown() then
            w:case("the Pet tab, out of combat", kit.moment("the Pet tab, out of combat", paperDollChecks(), 0.5))
        end
    end)
    local hasSidebar = w:hook("PaperDollFrame_SetSidebar", nil, function()
        if InCombatLockdown() and w:has("the Pet tab, out of combat") then
            w:case("side panes switched in a fight", kit.moment("side panes switched in a fight", paperDollChecks(), 0.5))
        end
    end)
    if not hasPet and not hasSidebar then
        w:finish("this client has no PaperDollFrame_SetPet or PaperDollFrame_SetSidebar", {})
    end
end

local function sumCases(keys: string[]): (r: Result) -> string
    return function(r: Result): string
        local cases = r.cases :: { [string]: Result }? or {}
        local parts: string[] = {}
        for _, key in ipairs(keys) do
            local c = cases[key]
            if c then
                parts[#parts + 1] = ("%s: %s, %s"):format(key, newlyWords(c), blockedWords(tbl.list(c.blocked) :: string[]))
            end
        end
        return table.concat(parts, "; ")
    end
end

--------------------------------------------------------------------------------
-- GRP-5: the world map opened, enlarged and closed, then opened in a fight
--------------------------------------------------------------------------------

local function mapChecks(): { [string]: unknown }
    return {
        maximizeMinimize = kit.writtenFields("MaximizeMinimizeFrame", kit.resolve("WorldMapFrame.BorderFrame.MaximizeMinimizeFrame")),
        questMap = kit.writtenFields("QuestMapFrame", kit.resolve("QuestMapFrame")),
    }
end

local function armMap(w: Watch)
    local openedInFight: Result? = nil
    local enlarged = false
    w:onRegistry("WorldMapMaximized", function()
        enlarged = true
    end)
    w:onRegistry("WorldMapOnHide", function()
        if not InCombatLockdown() then
            local m = kit.moment("the map closed, out of combat", mapChecks(), 0.5)
            m.enlargedWhileOpen = enlarged
            w:case("the map closed, out of combat", m)
        end
        enlarged = false
    end)
    w:onRegistry("WorldMapOnShow", function()
        if InCombatLockdown() and not openedInFight and w:has("the map closed, out of combat") then
            openedInFight = kit.moment("the map opened in a fight", mapChecks(), 0.5)
        end
    end)
    afterFight(w, function(blocked: string[])
        local o = openedInFight
        if o then
            o.blockedInFight = blocked
            openedInFight = nil
            w:case("the map opened in a fight (a quest item used?)", o)
        end
    end)
end

--------------------------------------------------------------------------------
-- WHISPER-taint: a whisper SuuUI starts out of combat, then a line sent in
-- a fight
--------------------------------------------------------------------------------

-- Who asked for a whisper is read from the stack, by file only: a function
-- the game calls from C (pcall, a script handler, a secure hook's wrapper)
-- has no name in it ("in function <file:line>"), so ChatFrameUtil.SendTell,
-- called through the stdlib's pcall, never shows its name. The client's
-- lines: "[Interface/AddOns/SuuUI/src/Units/Chat/Panel.lua]:216: in
-- function <…>", "[C]: in function 'pcall'", "[tail call]: ?"; older forms
-- ("[string \"@Interface/…\"]:12:", "Interface\AddOns\…:12:") read the same.

-- The file of a stack line, with "/" for "\": "C" for the C side, "tail
-- call" for a lost frame, "" when the line names none.
export function lineFile(line: string): string
    local where = line:match("^%[(.-)%]:") or line:match("^(.-):%d+:") or ""
    where = where:match("^string \"@?(.-)\"$") or where
    return (where:gsub("\\", "/"))
end

-- A file's path inside SuuUI's folder ("src/Units/Chat/Panel.lua"), or nil
-- (another addon's, a plugin's "SuuUI_…", Blizzard's, C).
local function suuPath(file: string): string?
    return file:match("^SuuUI/(.*)$") or file:match("/SuuUI/(.*)$")
end

-- SuuUI's files that are never the asker: the probe's own (its listeners
-- and the kit), the hook and error machinery a listener runs under, and
-- the dev build's call wrappers.
const MACHINERY: string[] = {
    "^src/Diagnostics/",
    "^src/Core/Hooks%.",
    "^src/Core/Fault%.",
    "^wowlua/runtime%.",
    "^wowlua/std/hooks%.",
}

local function machinery(rel: string): boolean
    for _, p in ipairs(MACHINERY) do
        if rel:find(p) then
            return true
        end
    end
    return false
end

-- Whether SuuUI's own code (not the probe's) is on the stack: one of its
-- src/ files, or the stdlib's chat module that SuuUI's whispers go through
-- (all that is left of a caller that tail-called it).
export function startedBySuuUI(stack: string): boolean
    for line in stack:gmatch("[^\n]+") do
        local rel = suuPath(lineFile(line))
        if rel and not machinery(rel) and (rel:sub(1, 4) == "src/" or rel == "wowlua/std/chat.lua") then
            return true
        end
    end
    return false
end

-- The stack, short, for the record: the probe's own frames and the
-- machinery left out, the C and error-handling frames above the first
-- real caller too; "Interface/AddOns/" dropped and "<file:123>" as
-- "<:123>" (the line's own file is in front); at most `max` lines.
export function shortStack(stack: string, max: number): string[]
    local out: string[] = {}
    local leading = true
    for line in stack:gmatch("[^\n]+") do
        local file = lineFile(line)
        local rel = suuPath(file)
        local glue = file == "C" or file == "tail call" or rel == "wowlua/std/errors.lua"
        if not (rel and machinery(rel)) and not (leading and glue) then
            leading = false
            local s = line:gsub("Interface[/\\]AddOns[/\\]", "")
            s = s:gsub("<[^>]*:(%d+)>", "<:%1>")
            out[#out + 1] = #s > 100 and s:sub(1, 100) or s
            if #out >= max then
                break
            end
        end
    end
    return out
end

const WHISPER_TYPES: { [string]: boolean } = { WHISPER = true, BN_WHISPER = true }
-- openings kept as evidence (from any source), and their stacks' lines
const EVIDENCE = 5
const STACK_LINES = 10

-- The game's functions that open a whisper line (another addon's whisper,
-- or SuuUI's before wowlua's chat.whisper aimed instead), and the chat line
-- chooser SuuUI's chat.whisper reads before it aims that line at a whisper
-- (its chat type and target, for the player's Enter: `aim`, the type read a
-- moment later); the old globals where they aren't aliases of these.
const TELLS: { owner?: string, name: string, aim?: boolean }[] = {
    { owner = "ChatFrameUtil", name = "SendTellWithMessage" },
    { owner = "ChatFrameUtil", name = "SendTell" },
    { owner = "ChatFrameUtil", name = "ChooseBoxForSend", aim = true },
    { name = "ChatFrame_SendTellWithMessage" },
    { name = "ChatFrame_SendTell" },
    { name = "ChatEdit_ChooseBoxForSend", aim = true },
}

-- The chat type of an edit box ("unreadable" when it can't be read).
local function chatTypeOf(box: unknown): string
    if box == nil then
        return "no edit box"
    end
    local ok, t = pcall(function(): unknown
        return (box :: Frame):GetAttribute("chatType")
    end)
    return ok and asString(t) or "unreadable"
end

-- The edit box the game has active (or had last; else the main chat's,
-- the one its line chooser falls back to).
local function activeBox(): unknown
    return tbl.field(_G, "ACTIVE_CHAT_EDIT_BOX") or tbl.field(_G, "LAST_ACTIVE_CHAT_EDIT_BOX")
        or tbl.field(_G, "DEFAULT_CHAT_FRAME", "editBox")
end

-- Who last wrote what a whisper's opening writes: the edit boxes' fields
-- (OpenChat's text and setText), the active box globals.
local function chatChecks(): Result
    local fields: string[] = {}
    for _, box in ipairs(editBoxes()) do
        for _, f in ipairs(kit.writtenFields(box:GetName() or "edit box", box)) do
            fields[#fields + 1] = f
        end
    end
    return {
        editBoxFields = fields,
        ACTIVE_CHAT_EDIT_BOX = kit.secureState(nil, "ACTIVE_CHAT_EDIT_BOX"),
        LAST_ACTIVE_CHAT_EDIT_BOX = kit.secureState(nil, "LAST_ACTIVE_CHAT_EDIT_BOX"),
    }
end

local function armWhisper(w: Watch)
    local r = w:result()
    -- a whisper of an earlier session: a /reload clears taint, so it no
    -- longer counts (kept to read)
    if r.started ~= nil then
        r.startedBeforeReload = r.started
        r.started = nil
    end
    local started: Result? = nil
    local function markStarted(source: string)
        if started then
            return
        end
        local s = kit.moment("a whisper started by SuuUI, out of combat", chatChecks(), 0.5)
        s.source = source
        started = s
        w:result().started = s
    end

    -- Evidence: the first openings of a whisper line (any source), at
    -- once; the sources of one moment (a hook, the focus event) in one.
    local last: Result? = nil
    local lastAt = -1
    local function note(source: string, bySuuUI: boolean, chatType: string, stack: string): Result?
        local now = GetTime()
        local e = last
        if e and lastAt == now then
            local sources = tbl.listAt(e, "sources")
            if not tbl.contains(sources, source) then
                sources[#sources + 1] = source
            end
            e.bySuuUI = e.bySuuUI == true or bySuuUI
            -- an edit box's event came first: the hook's stack too (it
            -- reaches the caller in fewer lines)
            if source:sub(1, 5) == "hook " and e.hookStack == nil and not tostring(sources[1]):find("^hook ") then
                e.hookStack = shortStack(stack, STACK_LINES)
            end
            return e
        end
        local list = tbl.listAt(w:result(), "openings")
        if #list >= EVIDENCE then
            return nil
        end
        local made: Result = {
            at = kit.stamp(),
            sources = { source },
            bySuuUI = bySuuUI,
            chatType = chatType,
            stack = shortStack(stack, STACK_LINES),
        }
        list[#list + 1] = made
        last = made
        lastAt = now
        return made
    end

    -- A whisper opened out of combat: by one of the game's tell functions
    -- (a whisper by definition), a line aimed at one (the chooser, the type
    -- a moment later), or an edit box shown or focused (one when
    -- its chat type is, now or once the game has set its text: OpenChat
    -- sets it in the box's next OnUpdate, and a name the auto-complete
    -- knows can keep it "SAY" until more is typed).
    local function opened(source: string, box: unknown, isTell: boolean)
        if InCombatLockdown() then
            return
        end
        local stack = debugstack(1, 60, 20) or ""
        local by = startedBySuuUI(stack)
        local typeNow = chatTypeOf(box or activeBox())
        local entry: Result? = nil
        if isTell or by or WHISPER_TYPES[typeNow] then
            entry = note(source, by, typeNow, stack)
        end
        if by and isTell then
            markStarted(source)
        end
        w:after(0.3, function()
            local later = chatTypeOf(box or activeBox())
            local e = entry
            if e == nil and WHISPER_TYPES[later] then
                e = note(source, by, typeNow, stack)
            end
            if e then
                e.chatTypeLater = later
            end
            if by and WHISPER_TYPES[later] then
                markStarted(source)
            end
        end)
    end

    local hooked: string[] = {}
    local seen: { [unknown]: boolean } = {}
    for _, tell in ipairs(TELLS) do
        local owner = tell.owner
        local t: unknown = owner and kit.resolve(owner) or nil
        local fn = owner and tbl.field(t, tell.name) or tbl.field(_G, tell.name)
        if type(fn) == "function" and not seen[fn] then
            seen[fn] = true
            local label = owner and (owner .. "." .. tell.name) or tell.name
            local isTell = not tell.aim
            local body = function()
                opened("hook " .. label, nil, isTell)
            end
            local ok: boolean
            if owner then
                ok = w:hook(t, tell.name, body)
            else
                ok = w:hook(tell.name, nil, body)
            end
            if ok then
                hooked[#hooked + 1] = label
            end
        end
    end
    local registry: string[] = {}
    for _, e in ipairs({ "ChatFrame.OnEditBoxShow", "ChatFrame.OnEditBoxFocusGained" }) do
        if w:onRegistry(e, function(box: unknown)
            opened(e, box, false)
        end) then
            registry[#registry + 1] = e
        end
    end

    -- A line sent in a fight: counted; after a whisper of this session's,
    -- the scan then and the blocked actions half a second later answer.
    local pending = false
    local lastSend = -1
    local function sentInFight(source: string)
        local now = GetTime()
        if lastSend == now then
            return
        end
        lastSend = now
        local rec = w:result()
        rec.sendsInFight = (tonumber(rec.sendsInFight) or 0) + 1
        rec.startedBeforeSend = started ~= nil
        local s = started
        if not s or pending then
            return
        end
        pending = true
        local m = kit.moment("a chat line sent in a fight", chatChecks(), 0)
        m.source = source
        w:after(0.5, function()
            local blocked = kit.blockedSince(now)
            local sendBlocked = false
            for _, b in ipairs(blocked) do
                if b:find("SendChatMessage", 1, true) then
                    sendBlocked = true
                end
            end
            m.blocked = blocked
            w:finish(("after a whisper SuuUI started out of combat, a line sent in a fight: %s, %s"):format(
                sendBlocked and "SendChatMessage was blocked" or "not blocked",
                newlyWords(m)
            ), { started = s, sent = m, sendBlocked = sendBlocked })
        end)
    end
    if w:onRegistry("ChatFrame.OnEditBoxPreSendText", function(box: unknown)
        if InCombatLockdown() then
            sentInFight("ChatFrame.OnEditBoxPreSendText")
            return
        end
        -- a whisper line sent out of combat (typed, or opened by a click)
        local chatType = chatTypeOf(box)
        if WHISPER_TYPES[chatType] then
            local stack = debugstack(1, 60, 20) or ""
            note("sent (ChatFrame.OnEditBoxPreSendText)", startedBySuuUI(stack), chatType, stack)
        end
    end) then
        registry[#registry + 1] = "ChatFrame.OnEditBoxPreSendText"
    end
    -- the send refused without the event (another edit box, a macro)
    for _, e in ipairs({ "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN" }) do
        w:on(e, function(_, _addon: unknown, func: unknown)
            local f = asString(func)
            if InCombatLockdown() and f and f:find("SendChatMessage", 1, true) then
                sentInFight(e)
            end
        end)
    end
    r.listening = { hooks = hooked, registry = registry }
end

-- What is still missing, for the status line.
local function whisperProgress(r: Result): string
    if r.started ~= nil then
        return "a whisper SuuUI started is recorded: now send any chat line in a fight, before a /reload"
    end
    local n = #tbl.list(r.openings)
    return n == 0 and "no whisper seen yet" or ("%d whisper openings seen, none started by SuuUI"):format(n)
end

