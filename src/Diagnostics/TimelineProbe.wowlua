-- Diagnostics/TimelineProbe.wowlua
-- "/suu probe timeline": what Forever's encounter timeline gives an addon
-- (plan step 1.13). Once: the client's documentation of C_EncounterTimeline
-- (functions, events, tables), its enums, whether the feature is available
-- and enabled, the view type, and the timeline's events (registered, counted
-- with their first payloads). Per sample: tracks (info, type, longest
-- event), events (info, state, time left and gone, timer, track, colour,
-- blocked, highlight time), each value readable, secret or missing.
--
--   /suu probe timeline        arm: samples now, 3 and 10 seconds into each
--                              boss (ENCOUNTER_START) and fight, and when
--                              timeline events arrive; /reload to save
--   /suu probe timeline demo   solo: Blizzard's Edit Mode sample events and
--                              one scripted event of SuuUI's own (adds them,
--                              samples 1 and 4 seconds later, removes them),
--                              plus every console variable about the timeline
--   /suu probe timeline off    stop sampling

import isSecret from "wowlua:secret"
import after from "wowlua:timer"
import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as Events from "/Core/Events"
import * as apiDocs from "/Diagnostics/ApiDocs"
import * as tbl from "wowlua:table"

type Map = { [unknown]: unknown }
-- What the probe saves in SuuUIProbe.timeline.
type Timeline = { samples: Map[], [string]: unknown }

local function isSecretTable(v: unknown): boolean
    return type(v) == "table" and issecrettable(v) == true
end

local function store(): Timeline
    return DB.probeData("timeline", function(): Timeline
        return { samples = {} }
    end)
end

-- `fn(...)`, protected (false and "missing" when there is no such function).
local function attempt(fn: unknown, ...: unknown): (boolean, unknown)
    if type(fn) ~= "function" then
        return false, "missing"
    end
    return pcall(fn, ...)
end
local MAX_SAMPLES = 14
local MAX_EVENTS = 8
local armed = false
local eventFrame: Frame? = nil
local eventCounts: { [string]: number }? = nil
local eventPayloads: Map? = nil

-- owns the fight listener (was the probe's table)
local OWNER = {}
local lastEventSample = 0

local function shape(v: unknown, depth: number?): unknown
    depth = depth or 0
    if isSecret(v) then
        return "secret"
    end
    if v == nil then
        return "nil"
    end
    if type(v) ~= "table" then
        return type(v) .. ": " .. tostring(v):sub(1, 80)
    end
    if isSecretTable(v) then
        return "secret table"
    end
    if depth >= 4 then
        return "table (deeper)"
    end
    local out: Map, n = {}, 0
    local count = #v
    if count > 0 then
        out["#"] = count
    end
    for k, x in pairs(v) do
        n = n + 1
        if n > 40 then
            out["…"] = "more fields"
            break
        end
        if not (type(k) == "number" and k > 3) then
            out[tostring(k)] = shape(x, depth + 1)
        end
    end
    return out
end

local function call(fn: unknown, ...: unknown): unknown
    if type(fn) ~= "function" then
        return "missing"
    end
    local ok, a, b, c = pcall(fn, ...)
    if not ok then
        return "error: " .. tostring(a):sub(1, 160)
    end
    if b ~= nil or c ~= nil or isSecret(b) or isSecret(c) then
        return { shape(a), shape(b), shape(c) }
    end
    return shape(a)
end

local function eventNames(): string[]
    local names: string[] = {}
    for _, sys in ipairs(tbl.list(tbl.field(_G, "APIDocumentation", "systems"))) do
        for _, e in ipairs(tbl.list(tbl.field(sys, "Events"))) do
            local n = tbl.field(e, "LiteralName")
            if type(n) == "string" and n:find("ENCOUNTER_TIMELINE") then
                names[#names + 1] = n
            end
        end
    end
    for _, n in ipairs({ "ENCOUNTER_START", "ENCOUNTER_END", "BOSS_KILL" }) do
        names[#names + 1] = n
    end
    return names
end

local function watchEvents(): string[]?
    if eventFrame then
        return nil
    end
    local f = CreateFrame("Frame")
    eventFrame = f
    local counts: { [string]: number }, payloads: Map = {}, {}
    eventCounts, eventPayloads = counts, payloads
    local registered: string[] = {}
    for _, n in ipairs(eventNames()) do
        if pcall(f.RegisterEvent, f, n) then
            registered[#registered + 1] = n
        end
    end
    f:SetScript("OnEvent", function(_, event: string, ...: unknown)
        counts[event] = (counts[event] or 0) + 1
        if not payloads[event] then
            payloads[event] = shape({ ... })
        end
        if not armed then
            return
        end
        if event == "ENCOUNTER_START" then
            after(3, function()
                if armed then
                    sample("3s into the boss")
                end
            end)
            after(10, function()
                if armed then
                    sample("10s into the boss")
                    print("Timeline probe: boss sampled. /reload after the fight to save.")
                end
            end)
        elseif event:find("ENCOUNTER_TIMELINE") and GetTime() - lastEventSample > 5 then
            lastEventSample = GetTime()
            after(0.5, function()
                if armed then
                    sample("after " .. event)
                end
            end)
        end
    end)
    return registered
end

local function enums(): Map
    local out: Map = {}
    for k, v in pairs(Enum) do
        if type(k) == "string" and k:find("^EncounterTimeline") and not k:find("Meta$") then
            out[k] = shape(v)
        end
    end
    return out
end

-- One event in full.
local function describeEvent(id: unknown): Map
    local ET = tbl.field(_G, "C_EncounterTimeline")
    return {
        id = shape(id),
        info = call(tbl.field(ET, "GetEventInfo"), id),
        state = call(tbl.field(ET, "GetEventState"), id),
        remaining = call(tbl.field(ET, "GetEventTimeRemaining"), id),
        elapsed = call(tbl.field(ET, "GetEventTimeElapsed"), id),
        timer = call(tbl.field(ET, "GetEventTimer"), id),
        track = call(tbl.field(ET, "GetEventTrack"), id),
        color = call(tbl.field(ET, "GetEventColor"), id),
        blocked = call(tbl.field(ET, "IsEventBlocked"), id),
        highlight = call(tbl.field(ET, "GetEventHighlightTime"), id),
    }
end

export function sample(label: string?): Map
    local ET = tbl.field(_G, "C_EncounterTimeline")
    local s: Map = {
        at = date("%H:%M:%S"),
        label = label,
        combat = InCombatLockdown() and "in combat" or "out of combat",
        instance = select(2, IsInInstance()) or "none",
        group = IsInRaid() and "raid" or (IsInGroup() and "party" or "solo"),
    }
    if ET == nil then
        s.error = "no C_EncounterTimeline"
    else
        s.available = call(tbl.field(ET, "IsFeatureAvailable"))
        s.enabled = call(tbl.field(ET, "IsFeatureEnabled"))
        s.viewType = call(tbl.field(ET, "GetViewType"))
        s.now = call(tbl.field(ET, "GetCurrentTime"))
        s.hasAny = call(tbl.field(ET, "HasAnyEvents"))
        s.hasActive = call(tbl.field(ET, "HasActiveEvents"))
        s.hasVisible = call(tbl.field(ET, "HasVisibleEvents"))
        s.hasPaused = call(tbl.field(ET, "HasPausedEvents"))
        -- tracks
        local trackList: Map[] = {}
        s.tracks = trackList
        local okT, tracks = attempt(tbl.field(ET, "GetTrackList"))
        s.trackList = okT and shape(tracks) or ("error: " .. tostring(tracks))
        if okT and type(tracks) == "table" and not isSecretTable(tracks) then
            for i, t in ipairs(tbl.list(tracks)) do
                if i > 6 then
                    break
                end
                trackList[i] = {
                    id = shape(t),
                    info = call(tbl.field(ET, "GetTrackInfo"), t),
                    type = call(tbl.field(ET, "GetTrackType"), t),
                    longest = call(tbl.field(ET, "GetTrackMaxEventDuration"), t),
                }
            end
        end
        -- events
        local events: Map[] = {}
        s.events = events
        local okE, list = attempt(tbl.field(ET, "GetEventList"))
        s.eventList = okE and shape(list) or ("error: " .. tostring(list))
        s.sortedList = call(tbl.field(ET, "GetSortedEventList"))
        if okE and type(list) == "table" and not isSecretTable(list) then
            for i, id in ipairs(tbl.list(list)) do
                if i > MAX_EVENTS then
                    break
                end
                events[i] = describeEvent(id)
            end
        end
    end
    local counts = eventCounts
    s.eventCounts = counts and tbl.shallowCopy(counts) or nil
    local samples = store().samples
    table.insert(samples, s)
    while #samples > MAX_SAMPLES do
        table.remove(samples, 1)
    end
    return s
end

-- Console variables whose name mentions the timeline or encounters.
local function cvars(): unknown
    local out: { [string]: string } = {}
    local getAll = tbl.field(_G, "C_Console", "GetAllCommands")
    if type(getAll) ~= "function" then
        return "no C_Console.GetAllCommands"
    end
    local ok, all = pcall(getAll)
    if not ok or type(all) ~= "table" then
        return "error"
    end
    for _, c in ipairs(tbl.list(all)) do
        local name = tbl.field(c, "command")
        if type(name) == "string" then
            local low = name:lower()
            if low:find("timeline") or low:find("encounter") or low:find("bossmod") or low:find("raidwarn") then
                local okV, v = pcall(C_CVar.GetCVar, name)
                out[name] = okV and tostring(v) or "(command)"
            end
        end
    end
    return out
end

local function prepare(): Timeline
    local t = store()
    t.docs = apiDocs.dump({ "encountertimeline" })
    t.enums = enums()
    t.registeredEvents = watchEvents() or t.registeredEvents
    t.eventPayloads = eventPayloads
    t.blizzardAddon = C_AddOns.IsAddOnLoaded("Blizzard_EncounterTimeline") and "loaded" or "not loaded"
    t.cvars = cvars()
    return t
end

export function command(arg: string?)
    if arg == "off" then
        armed = false
        print("Timeline probe: off.")
        return
    end
    local t = prepare()
    local ET = tbl.field(_G, "C_EncounterTimeline")
    if arg == "demo" then
        if ET == nil then
            print("Timeline probe: no C_EncounterTimeline.")
            return
        end
        sample("before the demo")
        t.demoAdd = call(tbl.field(ET, "AddEditModeEvents"))
        -- one event of our own: Shield Wall's spell and art, 10 seconds
        local okS, id = attempt(tbl.field(ET, "AddScriptEvent"), {
            spellID = 871,
            iconFileID = 132362,
            duration = 10,
            overrideName = "SuuUI test",
        })
        t.scriptAdd = okS and shape(id) or ("error: " .. tostring(id))
        local scriptID = okS and not isSecret(id) and id or nil
        after(1, function()
            sample("demo, 1s")
            after(3, function()
                sample("demo, 4s")
                t.demoCancel = call(tbl.field(ET, "CancelEditModeEvents"))
                if scriptID then
                    t.scriptCancel = call(tbl.field(ET, "CancelScriptEvent"), scriptID)
                end
                print("Timeline probe: demo sampled. /reload to save.")
            end)
        end)
        print("Timeline probe: demo events added; sampling for 4 seconds.")
        return
    end
    if not armed then
        armed = true
        Events.onGame(
            "PLAYER_REGEN_DISABLED",
            function()
                if not armed then
                    return
                end
                after(3, function()
                    if armed then
                        sample("3s into the fight")
                    end
                end)
            end,
            OWNER
        )
    end
    sample("on command")
    print("Timeline probe: armed. Fight a dungeon boss, then /reload. (Solo first look: /suu probe timeline demo)")
end
