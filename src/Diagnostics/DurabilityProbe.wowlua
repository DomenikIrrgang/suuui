-- Diagnostics/DurabilityProbe.wowlua
-- "/suu probe durability" (asked 2026-10-19: a durability feature; the
-- build waits on it): what Forever tells about worn gear and repairs.
--   now:   for every equipment slot (1-19) its durability, its alert state
--          and whatever repair cost the game gives for it (the tooltip
--          data, and a hidden tooltip's SetInventoryItem); whether the
--          game's DurabilityFrame exists and shows; the client's
--          documentation for durability and repairs
--   then (this session, by itself): the same 2 s into each of your next
--          fights (is durability readable in combat?); every
--          UPDATE_INVENTORY_DURABILITY and UPDATE_INVENTORY_ALERTS, timed,
--          in combat or not; at each merchant what repairs would cost
--   autorepair: only after "/suu probe durability autorepair" (for this
--          session, once): RepairAllItems() at the next merchant that
--          repairs, with no click, and whether it errored, was blocked or
--          spent the gold. It spends gold, so nothing repairs without it.
-- Saved in SuuUIProbe.durability on /reload. Values the game hides read SECRET.
--
--   /suu probe durability                 snapshot and listen
--   /suu probe durability autorepair      also repair at the next merchant
--   /suu probe durability autorepair off  not after all

import after from "wowlua:timer"
import isSecret from "wowlua:secret"
import * as DB from "/Core/DB"
import print, name as addonName from "/Core/Init"
import * as apiDocs from "/Diagnostics/ApiDocs"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"

local function show(v: unknown): string
    if isSecret(v) then
        return "SECRET"
    end
    return tostring(v)
end

-- A function that may not exist, may error or may answer secret.
local function call(fn: unknown, ...: unknown): (unknown, unknown, unknown, unknown)
    if type(fn) ~= "function" then
        return "missing", nil, nil, nil
    end
    local ok, a, b, c, d = pcall(fn, ...)
    if not ok then
        return "error: " .. tostring(a):sub(1, 120), nil, nil, nil
    end
    return a, b, c, d
end

-- What a merchant offers for repairs (and your money then).
type Merchant = {
    canRepair: string,
    repairAllCost: string,
    repairAllCan: string,
    guildBank: string,
    money: string,
    at?: string,
    costLater?: string,
}
type Sample = {
    at: string,
    why: string,
    inCombat: boolean,
    durabilityFrame: string,
    slots: string[],
    merchantNow?: Merchant,
}
-- The repair test: RepairAllItems at MERCHANT_SHOW, with no click.
type Repair = {
    at: string,
    before: Merchant,
    blocked: string[],
    call?: string,
    after?: Merchant,
    moneyWentDown?: string,
    slotsAfter?: string[],
}
-- What the probe saves in SuuUIProbe.durability.
type Out = {
    now?: Sample,
    api?: { [string]: string },
    docs?: unknown,
    docFlags?: unknown,
    autorepair?: Repair[],
    merchants?: Merchant[],
    inCombat?: Sample[],
    events?: string[],
}

local function out(): Out
    return DB.probeData("durability", function(): Out
        return {}
    end)
end

local MAX_SAMPLES = 6
local MAX_EVENTS = 80

-- A hidden tooltip: GameTooltip:SetInventoryItem returns hasItem,
-- hasCooldown, repairCost on the clients that still do.
local tip: GameTooltip? = nil
local function tipCost(slot: number): string
    local t = tip
    if not t then
        local ok, made = pcall(CreateFrame, "GameTooltip", "SuuUIDurabilityProbeTip", nil, "GameTooltipTemplate")
        if not ok then
            return "no tooltip: " .. tostring(made):sub(1, 80)
        end
        t = made
        tip = made
    end
    pcall(t.SetOwner, t, WorldFrame, "ANCHOR_NONE")
    local ok, hasItem, cooldown, cost = pcall(t.SetInventoryItem, t, "player", slot)
    pcall(t.Hide, t)
    if not ok then
        return "error: " .. tostring(hasItem):sub(1, 80)
    end
    return ("hasItem %s, cooldown %s, repairCost %s"):format(show(hasItem), show(cooldown), show(cost))
end

-- The tooltip data's secret.readable fields, and its lines about repairs or durability.
local function tooltipData(slot: number): string
    local data = call(tbl.field(C_TooltipInfo, "GetInventoryItem"), "player", slot)
    if type(data) ~= "table" then
        return show(data)
    end
    if isSecret(data) then
        return "SECRET"
    end
    local parts: string[] = {}
    for k, v in pairs(data) do
        if type(v) ~= "table" then
            parts[#parts + 1] = tostring(k) .. "=" .. show(v)
        end
    end
    table.sort(parts)
    for _, line in ipairs(tbl.list(tbl.field(data, "lines"))) do
        local text, price = tbl.field(line, "leftText"), tbl.field(line, "price")
        if secret.readable(text) and type(text) == "string" and
            (text:lower():find("repair") or text:lower():find("durab")) then
            parts[#parts + 1] = "line: " .. text .. (price and (" price=" .. show(price)) or "")
        elseif secret.readable(price) and price then
            parts[#parts + 1] = "price line: " .. show(text) .. " " .. show(price)
        end
    end
    return table.concat(parts, "  ")
end

local function slots(withTooltips: boolean): string[]
    local list: string[] = {}
    for slot = 1, 19 do
        local link = call(GetInventoryItemLink, "player", slot)
        local cur, max = call(GetInventoryItemDurability, slot)
        local entry = ("%d %s: durability %s/%s, alert %s"):format(
            slot,
            show(link),
            show(cur),
            show(max),
            show((call(GetInventoryAlertStatus, slot)))
        )
        if withTooltips and link ~= nil then
            entry = entry .. "; tip " .. tipCost(slot) .. "; data " .. tooltipData(slot)
        end
        list[slot] = entry
    end
    return list
end

local function frameState(): string
    local f = wf.find("DurabilityFrame")
    if not f then
        return "missing"
    end
    local okS, shown = pcall(f.IsShown, f)
    local okV, visible = pcall(f.IsVisible, f)
    return ("exists, shown %s, visible %s"):format(okS and show(shown) or "?", okV and show(visible) or "?")
end

local function merchant(): Merchant
    local cost, can = call(GetRepairAllCost)
    return {
        canRepair = show((call(CanMerchantRepair))),
        repairAllCost = show(cost),
        repairAllCan = show(can),
        guildBank = show((call(CanGuildBankRepair))),
        money = show((call(GetMoney))),
    }
end

local function sample(why: string): Sample
    return {
        at = date("%H:%M:%S"),
        why = why,
        inCombat = InCombatLockdown() and true or false,
        durabilityFrame = frameState(),
        slots = slots(true),
    }
end

local function snapshot()
    local o = out()
    local now = sample("asked")
    now.merchantNow = merchant()
    o.now = now
    local api: { [string]: string } = {}
    o.api = api
    for _, name in ipairs({
        "GetInventoryItemDurability",
        "GetInventoryAlertStatus",
        "GetRepairAllCost",
        "CanMerchantRepair",
        "RepairAllItems",
        "CanGuildBankRepair",
        "ShowRepairCursor",
        "HideRepairCursor",
        "InRepairMode",
    }) do
        api[name] = type(tbl.field(_G, name)) == "function" and "yes" or "missing"
    end
    api["C_TooltipInfo.GetInventoryItem"] = type(tbl.field(C_TooltipInfo, "GetInventoryItem")) == "function" and
        "yes" or
        "missing"
    do
        local lines, err = apiDocs.dump({ "durability", "repair", "inventoryalert" })
        o.docs = lines or err
        local flags, ferr = apiDocs.flags({
            "RepairAllItems",
            "GetRepairAllCost",
            "CanMerchantRepair",
            "GetInventoryItemDurability",
            "GetInventoryAlertStatus",
        })
        o.docFlags = flags or ferr
    end
end

--------------------------------------------------------------------------------
-- At a merchant: what repairs cost, and the repair test when it was asked for
--------------------------------------------------------------------------------

local autorepair = false

local function repairTest(o: Out, before: Merchant)
    autorepair = false -- once: it spends gold
    local r: Repair = { at = date("%H:%M:%S"), before = before, blocked = {} }
    local tests = o.autorepair or {}
    o.autorepair = tests
    tests[#tests + 1] = r
    local watch = CreateFrame("Frame")
    watch:RegisterEvent("ADDON_ACTION_BLOCKED")
    watch:RegisterEvent("ADDON_ACTION_FORBIDDEN")
    watch:RegisterEvent("UI_ERROR_MESSAGE")
    watch:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown)
        table.insert(r.blocked, ("%s %s %s%s"):format(event, show(a), show(b), a == addonName and " (SuuUI)" or ""))
    end)
    -- at MERCHANT_SHOW, with no click
    local ok, err = pcall(RepairAllItems)
    local result = ok and "ran" or ("error: " .. tostring(err):sub(1, 120))
    r.call = result
    after(1.5, function()
        watch:UnregisterAllEvents()
        local later = merchant()
        r.after = later
        local n0, n1 = tonumber(before.money), tonumber(later.money)
        r.moneyWentDown = tostring(n1 and n0 and n1 < n0)
        r.slotsAfter = slots(false)
        print(
            ("Durability probe: RepairAllItems at the merchant: %s; cost now %s (was %s); %d blocked or error messages. /reload to save it."):format(
                result,
                later.repairAllCost,
                before.repairAllCost,
                #r.blocked
            )
        )
    end)
end

local function atMerchant()
    local o = out()
    local m = merchant()
    m.at = date("%H:%M:%S")
    local merchants = o.merchants or {}
    o.merchants = merchants
    if #merchants < MAX_SAMPLES then
        table.insert(merchants, m)
    end
    if autorepair and m.canRepair == "true" then
        repairTest(o, m)
    elseif autorepair then
        print("Durability probe: this merchant doesn't repair; the repair test waits for one that does.")
    else
        print(("Durability probe: repairs here cost %s; recorded (nothing repaired)."):format(m.repairAllCost))
    end
end

--------------------------------------------------------------------------------
-- Listening for the session
--------------------------------------------------------------------------------

local listening: Frame? = nil
local function listen()
    if listening then
        return
    end
    local f = CreateFrame("Frame")
    listening = f
    for _, e in ipairs({
        "UPDATE_INVENTORY_DURABILITY",
        "UPDATE_INVENTORY_ALERTS",
        "PLAYER_REGEN_DISABLED",
        "MERCHANT_SHOW",
    }) do
        pcall(f.RegisterEvent, f, e)
    end
    f:SetScript("OnEvent", function(_, event: string)
        local o = out()
        if event == "PLAYER_REGEN_DISABLED" then
            after(2, function()
                local inCombat = o.inCombat or {}
                o.inCombat = inCombat
                if #inCombat < MAX_SAMPLES then
                    table.insert(inCombat, sample("2 s after entering combat"))
                    print("Durability probe: durability read 2 s into the fight.")
                end
            end)
        elseif event == "MERCHANT_SHOW" then
            -- in the event itself (the repair test's point: no click), and
            -- the cost once more a moment later, in case it came late
            atMerchant()
            after(0.5, function()
                local merchants = o.merchants
                local last = merchants and merchants[#merchants]
                if last and not last.costLater then
                    last.costLater = merchant().repairAllCost
                end
            end)
        else
            local events = o.events or {}
            o.events = events
            if #events < MAX_EVENTS then
                table.insert(
                    events,
                    ("%s %s%s"):format(date("%H:%M:%S"), event, InCombatLockdown() and " in combat" or "")
                )
            end
        end
    end)
end

export function command(arg: string?)
    if arg == "autorepair off" then
        autorepair = false
        print("Durability probe: no repair after all.")
        return
    end
    snapshot()
    listen()
    if arg == "autorepair" then
        autorepair = true
        print(
            "Durability probe: armed. The next merchant that repairs will repair all your gear at once, with no click, using your own gold (once; /suu probe durability autorepair off to drop it). Open a repair merchant, then /reload."
        )
        return
    end
    print(
        "Durability probe: your gear recorded. Get into a fight (it reads again 2 s in), open a merchant that repairs (nothing is repaired: that spends gold, only after /suu probe durability autorepair); then /reload to save it."
    )
end
