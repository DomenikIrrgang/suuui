-- Diagnostics/GiverProbe.wowlua
-- "/suu probe givers": while it's on, every NPC whose quests you open (its
-- gossip, its quest greeting, a quest it offers straight away) is checked
-- against the world map's pins: what the NPC offers next to what the map
-- says it should (WorldMap:QuestsFor, the pins' own checks). A difference is
-- printed in chat and kept in SuuUIProbe.givers on /reload, with the quests
-- before and instead of each one, done or not, so the reason shows.
--   /suu probe givers        on or off
--   /suu probe givers clear  forget what was recorded

import after from "wowlua:timer"
import quest from "/Units/WorldMap/Rows"
import * as DB from "/Core/DB"
import print from "/Core/Init"
import SuuUI from "/Core/API"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"

-- the frame hearing the quest events, and whether it's on
local eventFrame: Frame? = nil
local on: boolean? = nil


type Store = { npcs: { [unknown]: unknown }, checked: number, differences: number }

local function store(): Store
    return DB.probeData("givers", function(): Store return { npcs = {}, checked = 0, differences = 0 } end)
end

-- the NPC you're talking to: its ID from its GUID ("Creature-0-…-<id>-…")
local function npc(): (number?, string?)
    local ok, guid = pcall(UnitGUID, "npc")
    if not (ok and secret.readable(guid)) then return nil end
    local kind, id = (guid :: string):match("^(%a+)%-%d+%-%d+%-%d+%-%d+%-(%d+)")
    if kind ~= "Creature" and kind ~= "Vehicle" then return nil end
    local okName, name = pcall(UnitName, "npc")
    return tonumber(id), okName and secret.readable(name) and (name :: string) or "?"
end

-- the quests it offers now: { [questID] = title }
local function offered(event: string): { [number]: string }
    local out: { [number]: string } = {}
    if event == "GOSSIP_SHOW" and C_GossipInfo and C_GossipInfo.GetAvailableQuests then
        local ok, list = pcall(C_GossipInfo.GetAvailableQuests)
        for _, q in ipairs(ok and type(list) == "table" and list or {}) do
            if secret.readable(q.questID) then out[q.questID] = q.title or "?" end
        end
    elseif event == "QUEST_GREETING" then
        local ok, n = pcall(GetNumAvailableQuests)
        for i = 1, ok and secret.readable(n) and n or 0 do
            local okInfo, _a, _b, _c, _d, id = pcall(GetAvailableQuestInfo, i)
            local okTitle, title = pcall(GetAvailableTitle, i)
            -- (the quest ID is GetAvailableQuestInfo's fifth value)
            if okInfo and secret.readable(id) and type(id) == "number" then out[id] = okTitle and title or "?" end
        end
    elseif event == "QUEST_DETAIL" then
        local ok, id = pcall(GetQuestID)
        local okTitle, title = pcall(GetTitleText)
        if ok and secret.readable(id) and id > 0 then out[id] = okTitle and title or "?" end
    end
    return out
end

-- the quests before one and instead of it, done or not ("97246 done")
local function why(id: number, done: unknown[]): string
    local row = SuuUI.QuestStarts().quests[id]
    if not row then return "not in the data" end
    local q = quest(row)
    local parts = {}
    local function list(label: string, ids: number[]?)
        local items = {}
        for _, pre in ipairs(ids or {}) do items[#items + 1] = pre .. (done[pre] and " done" or " not done") end
        if #items > 0 then parts[#parts + 1] = label .. " " .. table.concat(items, ", ") end
    end
    list("after all of", q.preGroup)
    list("after one of", q.preSingle)
    list("not with", q.exclusiveTo)
    parts[#parts + 1] = ("level %s (from %s)"):format(tostring(q.level), tostring(q.minLevel))
    local event = q.event
    if event then parts[#parts + 1] = "event " .. event end
    return table.concat(parts, "; ")
end

export function check(event: string)
    local map: any = SuuUI.GetModule and SuuUI.GetModule("worldmap")
    if not (map and map.QuestsFor) then return end
    local id, name = npc()
    if not id then return end
    local offers = offered(event)
    -- a quest offered straight away is one of several, maybe: only check
    -- that it's expected, not that nothing else is
    local partial = event == "QUEST_DETAIL"
    local expected, done = map:QuestsFor(id)
    local s = store()
    s.checked = s.checked + 1
    local missing, extra = {}, {}
    local shown = {}
    for _, q in ipairs(expected) do
        if q.state then
            shown[q.id] = true
            if not offers[q.id] and not partial then
                missing[#missing + 1] = { id = q.id, name = q.name, why = why(q.id, done) }
            end
        end
    end
    -- (a quest 5 levels or more above you the map hides on purpose: noted, not a difference)
    local red = {}
    local myLevel = UnitLevel("player")
    local data = SuuUI.QuestStarts().quests
    for qid, title in pairs(offers) do
        local row = data[qid]
        local level = row and quest(row).level
        if not shown[qid] and level and secret.readable(myLevel) and level >= myLevel + 5 then
            red[#red + 1] = qid .. " " .. title
        elseif not shown[qid] then
            local known = false
            for _, e in ipairs(expected) do if e.id == qid then known = true end end
            extra[#extra + 1] = { id = qid, name = title, why = known and why(qid, done) or "not given by this NPC in the data" }
        end
    end
    local entry = {
        name = name, at = date("%Y-%m-%d %H:%M"), level = UnitLevel("player"), event = event,
        offered = {} :: string[], missing = missing, extra = extra, red = red,
    }
    for qid, title in pairs(offers) do table.insert(tbl.listAt(entry, "offered"), qid .. " " .. title) end
    s.npcs[id] = entry
    if #missing > 0 or #extra > 0 then
        s.differences = s.differences + 1
        for _, q in ipairs(missing) do
            print(("Givers: %s doesn't offer %s (%d), the map shows it."):format(name, tostring(q.name), q.id))
        end
        for _, q in ipairs(extra) do
            print(("Givers: %s offers %s (%d), the map doesn't show it."):format(name, tostring(q.name), q.id))
        end
    end
end

export function command(rest: string?)
    local s = store()
    if rest == "clear" then
        DB.probe.givers = nil
        print("Givers: forgotten.")
        return
    end
    local f = eventFrame
    if not f then
        f = CreateFrame("Frame")
        f:SetScript("OnEvent", function(_, event)
            -- (the gossip's quests are there a moment after it shows)
            after(0, function() check(event) end)
        end)
        eventFrame = f
    end
    on = not on
    if on then
        for _, e in ipairs({ "GOSSIP_SHOW", "QUEST_GREETING", "QUEST_DETAIL" }) do f:RegisterEvent(e) end
        print(("Givers: on. Talk to quest givers; differences show here. %d checked so far; /suu probe givers again to stop."):format(s.checked))
    else
        f:UnregisterAllEvents()
        print(("Givers: off. %d checked, %d with differences; /reload saves them."):format(s.checked, s.differences))
    end
end
