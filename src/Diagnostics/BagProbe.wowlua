-- Diagnostics/BagProbe.wowlua
-- "/suu probe bags": what Forever offers for SuuUI's bags and bank (step
-- 2.5). Saved in SuuUIProbe.bags on /reload.
--   * C_Container, C_Bank, C_NewItems, the bag numbering (Enum.BagIndex and
--     the old constants), Blizzard's sort and search, CVars, events
--   * every bag as the client gives it (slots, free, its name and family)
--     and each slot's item info fields; at a banker the bank too
--   * Blizzard's bag and bank frames, and the item button templates
--   * from now until /reload: which bag functions Blizzard calls when (the
--     B key, the bank, the mailbox, a vendor)
--
--   /suu probe bags          sample (run it once anywhere, once at a banker)
--   /suu probe bags item     a test item button made from Blizzard's bag
--                            slot template for your backpack's first slot:
--                            right click it out of combat and in combat (put
--                            something harmless there: a piece of gear to
--                            equip and swap back), then /reload
--   /suu probe bags item off hide it

import isSecret from "wowlua:secret"
import * as secret from "wowlua:secret"
import * as DB from "/Core/DB"
import print from "/Core/Init"
import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"

type Record = { [string]: unknown }
-- One look at the bags: when, whether the bank was open, and each bag.
type Snapshot = { at: string, bankOpen: boolean, money: string, bags: Record[] }
-- What the probe saves in SuuUIProbe.bags.
type Bags = { log: string[], samples: Snapshot[], [string]: unknown }
-- The item button test's record (SuuUIProbe.bagItem).
type ItemTest = { clicks: string[], blocked: string[], locks: string[], [string]: unknown }

local function bags(): Bags
    return DB.probeData("bags", function(): Bags return { log = {}, samples = {} } end)
end


local function show(v: unknown): string
    if isSecret(v) then return "secret" end
    if v == nil then return "nil" end
    if type(v) == "table" then
        local parts: string[] = {}
        for k, x in pairs(v) do parts[#parts + 1] = tostring(k) .. "=" .. (isSecret(x) and "secret" or tostring(x)) end
        table.sort(parts)
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function namesIn(t: unknown): string[]
    local out: string[] = {}
    if type(t) ~= "table" then return { "missing" } end
    for k, v in pairs(t) do if type(k) == "string" and type(v) == "function" then out[#out + 1] = k end end
    table.sort(out)
    return out
end

local GLOBALS = {
    "ToggleAllBags", "OpenAllBags", "CloseAllBags", "ToggleBag", "OpenBag", "CloseBag", "ToggleBackpack",
    "OpenBackpack", "CloseBackpack", "IsBagOpen", "ContainerFrame_GenerateFrame", "UpdateContainerFrameAnchors",
    "ContainerFrameCombinedBags", "ContainerFrameContainer", "ContainerFrame1", "ContainerFrame6", "ContainerFrame13",
    "BankFrame", "BankPanel", "AccountBankPanel", "ReagentBankFrame", "BankSlotsFrame", "BankFrameItem1",
    "BankFrame_Open", "BankFrame_ShowPanel", "CloseBankFrame", "OpenBankFrame", "BagsBar", "MainMenuBarBackpackButton",
    "CharacterBag0Slot", "NUM_BAG_SLOTS", "NUM_BANKBAGSLOTS", "NUM_TOTAL_EQUIPPED_BAG_SLOTS", "BANK_CONTAINER",
    "REAGENTBANK_CONTAINER", "KEYRING_CONTAINER", "BACKPACK_CONTAINER", "NUM_CONTAINER_FRAMES",
    "ContainerFrameItemButtonMixin", "BankFrameItemButtonMixin", "ItemButtonMixin", "SetItemButtonTexture",
    "SortBags", "SortBankBags", "GetMoney", "GetCoinTextureString", "C_CurrencyInfo",
}

local TEMPLATES = { "ContainerFrameItemButtonTemplate", "BankItemButtonGenericTemplate", "ItemButtonTemplate",
                    "SecureActionButtonTemplate" }

local EVENTS = {
    "BAG_UPDATE", "BAG_UPDATE_DELAYED", "BAG_NEW_ITEMS_UPDATED", "ITEM_LOCK_CHANGED", "BAG_UPDATE_COOLDOWN",
    "BANKFRAME_OPENED", "BANKFRAME_CLOSED", "PLAYERBANKSLOTS_CHANGED", "PLAYERBANKBAGSLOTS_CHANGED",
    "BAG_CONTAINER_UPDATE", "INVENTORY_SEARCH_UPDATE", "MERCHANT_SHOW", "MERCHANT_CLOSED", "MAIL_SHOW",
    "MAIL_CLOSED", "PLAYER_MONEY", "BAG_OPEN", "BAG_CLOSED", "USE_COMBINED_BAGS_CHANGED", "BANK_TABS_CHANGED",
    "BANK_BAG_SLOT_FLAGS_UPDATED", "BAG_SLOT_FLAGS_UPDATED", "AUCTION_HOUSE_SHOW", "TRADE_SHOW",
    "GUILDBANKFRAME_OPENED", "PLAYER_INTERACTION_MANAGER_FRAME_SHOW", "PLAYER_INTERACTION_MANAGER_FRAME_HIDE",
}

local function call(fn: unknown, ...: unknown): string
    if type(fn) ~= "function" then return "missing" end
    local res = { pcall(fn, ...) }
    if not res[1] then return "error: " .. tostring(res[2]):sub(1, 160) end
    local parts: string[] = {}
    for i = 2, math.max(2, select("#", unpack(res))) do parts[#parts + 1] = show(res[i]) end
    return table.concat(parts, " | ")
end

-- One bag: its size, free slots, name, family and the first few items.
local function bag(index: number): { [string]: unknown }
    local C = C_Container
    local b: { [string]: unknown } = { index = index }
    b.slots = call(C.GetContainerNumSlots, index)
    b.free = call(C.GetContainerNumFreeSlots, index)
    b.name = call(C.GetBagName, index)
    b.inventoryID = call(C.ContainerIDToInventoryID, index)
    local n = secret.asNumber(C.GetContainerNumSlots(index)) or 0
    local items: string[] = {}
    for slot = 1, math.min(n, 40) do
        local ok, info = pcall(C.GetContainerItemInfo, index, slot)
        if ok and info then
            items[#items + 1] = slot .. ": " .. show(info)
                .. (tbl.field(C_NewItems, "IsNewItem") and (" new=" .. call(C_NewItems.IsNewItem, index, slot)) or "")
            if #items >= 4 then break end
        end
    end
    b.items = items
    return b
end

local logging = false
local function startLog(store: Bags)
    if logging then return end
    logging = true
    store.log = store.log or {}
    local function note(s: string)
        local log = bags().log
        log[#log + 1] = date("%H:%M:%S") .. (InCombatLockdown() and " [combat] " or " ") .. s
        while #log > 200 do table.remove(log, 1) end
    end
    for _, name in ipairs({ "ToggleAllBags", "OpenAllBags", "CloseAllBags", "ToggleBag", "OpenBag", "CloseBag",
                            "ToggleBackpack", "OpenBackpack", "CloseBackpack" }) do
        if type(tbl.field(_G, name)) == "function" then
            hooksecurefunc(name, function(...: unknown)
                local parts: string[] = {}
                for i = 1, select("#", ...) do
                    local v = select(i, ...)
                    local r = wf.asRegion(v)
                    parts[#parts + 1] = r and (r:GetName() or "frame") or show(v)
                end
                note(name .. "(" .. table.concat(parts, ", ") .. ")")
            end)
        end
    end
    local f = CreateFrame("Frame")
    local valid = C_EventUtils.IsEventValid
    for _, e in ipairs({ "BANKFRAME_OPENED", "BANKFRAME_CLOSED", "MERCHANT_SHOW", "MAIL_SHOW", "BAG_OPEN", "BAG_CLOSED",
                         "PLAYER_INTERACTION_MANAGER_FRAME_SHOW", "PLAYER_INTERACTION_MANAGER_FRAME_HIDE",
                         "ADDON_ACTION_BLOCKED", "ADDON_ACTION_FORBIDDEN" }) do
        if valid(e) then f:RegisterEvent(e) end
    end
    f:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown) note(event .. " " .. show(a) .. " " .. show(b)) end)
end

export function sample(): (Bags, Snapshot)
    local store = bags()
    local at = date("%H:%M:%S")
    store.C_Container = namesIn(C_Container)
    store.C_Bank = namesIn(C_Bank)
    store.C_NewItems = namesIn(C_NewItems)
    store.C_Item = namesIn(C_Item)
    local globals: { [string]: string } = {}
    for _, name in ipairs(GLOBALS) do
        local v = tbl.field(_G, name)
        globals[name] = (type(v) == "number" or type(v) == "string") and (type(v) .. " " .. tostring(v)) or type(v)
    end
    store.globals = globals
    local enum: string[] = {}
    for k, v in pairs(Enum.BagIndex) do enum[#enum + 1] = tostring(k) .. "=" .. tostring(v) end
    table.sort(enum)
    store.bagIndex = enum
    local events: { [string]: string } = {}
    for _, e in ipairs(EVENTS) do events[e] = show(C_EventUtils.IsEventValid(e)) end
    store.events = events
    local cvars: { [string]: string } = {}
    for _, c in ipairs({ "combinedBags", "sortBagsRightToLeft", "insertItemsLeftToRight", "expandBagBar", "colorblindMode" }) do
        cvars[c] = show(GetCVar(c))
    end
    store.cvars = cvars
    store.sort = {
        sortRightToLeft = call(C_Container.GetSortBagsRightToLeft),
        insertLeftToRight = call(C_Container.GetInsertItemsLeftToRight),
        backpackAutosort = call(C_Container.GetBackpackAutosortDisabled),
    }
    local templates: { [string]: string } = {}
    store.templates = templates
    for _, t in ipairs(TEMPLATES) do
        local parent = CreateFrame("Frame", nil, UIParent)
        parent:SetID(0)
        local ok, made = pcall(CreateFrame, "ItemButton", nil, parent, t)
        if not ok then ok, made = pcall(CreateFrame, "Button", nil, parent, t) end
        local b = ok and wf.asButton(made)
        if b then
            templates[t] = "ok, " .. b:GetObjectType() .. ", protected=" .. show((b:IsProtected()))
            b:Hide()
        else
            templates[t] = "error: " .. tostring(made):sub(1, 160)
        end
        parent:Hide()
    end
    local frameInfo: { [string]: string } = {}
    store.frames = frameInfo
    for _, name in ipairs({ "ContainerFrameCombinedBags", "ContainerFrame1", "BankFrame", "BankPanel", "AccountBankPanel" }) do
        local f = wf.find(name)
        if f then
            local kids = tbl.keys(wf.keyed(f))
            frameInfo[name] = "protected=" .. show((f:IsProtected())) .. " shown=" .. show(f:IsShown()) .. " children: " .. table.concat(kids, " ")
        else
            frameInfo[name] = "missing"
        end
    end
    -- the bags: every index the game names, and 0..12 besides
    local bank = wf.find("BankFrame")
    local list: Record[] = {}
    local snap: Snapshot = { at = at, bankOpen = bank and bank:IsShown() and true or false, money = show(GetMoney()), bags = list }
    local seen: { [number]: boolean } = {}
    local indexes: number[] = {}
    for _, v in pairs(Enum.BagIndex) do indexes[#indexes + 1] = v end
    for i = -3, 12 do indexes[#indexes + 1] = i end
    table.sort(indexes)
    for _, i in ipairs(indexes) do
        if not seen[i] then
            seen[i] = true
            local b = bag(i)
            if b.slots ~= "0" and b.slots ~= "nil" and b.slots ~= "missing" then list[#list + 1] = b end
        end
    end
    store.samples = store.samples or {}
    table.insert(store.samples, snap)
    while #store.samples > 4 do table.remove(store.samples, 1) end
    startLog(store)
    return store, snap
end

-- A test item button for the backpack's first slot, from Blizzard's own
-- template, in a parent whose ID is the bag (the template reads it).
local testParent: Frame? = nil
local testButton: Button? = nil

-- The item test's record, while there is one.
local function itemLog(): ItemTest?
    local l = DB.probe.bagItem
    if type(l) ~= "table" then return nil end
    local log = DB.probeData("bagItem", function(): ItemTest return { clicks = {}, blocked = {}, locks = {} } end)
    return log
end
local function itemTest(off: boolean)
    if off then
        if testParent then testParent:Hide() end
        print("Bag probe: test button hidden.")
        return
    end
    if InCombatLockdown() then print("Bag probe: make it out of combat.") return end
    local log: ItemTest = { clicks = {}, blocked = {}, locks = {} }
    DB.probe.bagItem = log
    local tp = testParent
    local b = testButton
    if not (tp and b) then
        tp = CreateFrame("Frame", "SuuUIBagProbeParent", UIParent)
        testParent = tp
        tp:SetID(0)
        tp:SetSize(40, 40)
        tp:SetPoint("CENTER", 0, 160)
        local ok, made = pcall(CreateFrame, "ItemButton", "SuuUIBagProbeItem", tp, "ContainerFrameItemButtonTemplate")
        b = ok and wf.asButton(made) or nil
        if not b then
            log.error = tostring(made)
            print("Bag probe: the template didn't make a button: " .. tostring(made))
            return
        end
        b:SetID(1)
        b:SetAllPoints()
        b:HookScript("PostClick", function(_, button)
            local l = itemLog()
            if l then table.insert(l.clicks, date("%H:%M:%S") .. " " .. tostring(button) .. (InCombatLockdown() and " in combat" or "")) end
        end)
        testButton = b
        local ev = CreateFrame("Frame")
        ev:RegisterEvent("ADDON_ACTION_BLOCKED")
        ev:RegisterEvent("ADDON_ACTION_FORBIDDEN")
        ev:RegisterEvent("ITEM_LOCK_CHANGED")
        ev:RegisterEvent("PLAYER_EQUIPMENT_CHANGED")
        ev:SetScript("OnEvent", function(_, event: string, a: unknown, b2: unknown)
            local l = itemLog()
            if not l then return end
            local entry = date("%H:%M:%S") .. " " .. event .. " " .. show(a) .. " " .. show(b2) .. (InCombatLockdown() and " in combat" or "")
            if event:find("ADDON_ACTION") then table.insert(l.blocked, entry) else table.insert(l.locks, entry) end
        end)
    end
    local info = C_Container.GetContainerItemInfo(0, 1)
    -- the template starts hidden; its art from the game's own helper
    local setTexture = tbl.field(_G, "SetItemButtonTexture")
    if type(setTexture) == "function" then pcall(setTexture, b, info and info.iconFileID) end
    local icon = wf.asTexture(tbl.field(b, "icon"))
    if icon and info then icon:SetTexture(info.iconFileID) end
    local item = info and secret.asString(info.hyperlink) or "empty"
    log.item = item
    log.protected = show((b:IsProtected()))
    -- which bag and slot the template thinks it is (from the parent's ID)
    local getBagID = tbl.field(b, "GetBagID")
    log.bagID = getBagID and call(getBagID, b) or "no GetBagID"
    log.slotID = call(b.GetID, b)
    local bagID = tbl.field(b, "bagID")
    log.hasBagIDField = bagID ~= nil and show(bagID) or "no field"
    tp:Show()
    b:Show()
    print("Bag probe: a test button for your backpack's first slot (" .. item .. ") above the middle. Right click it out of combat and in combat, then /reload.")
end

export function command(arg: string?)
    if arg == "item" then return itemTest(false) end
    if arg == "item off" then return itemTest(true) end
    local _, snap = sample()
    print(("Bag probe: %d bags%s. Logging bag opens until /reload; at a banker run it again."):format(
        #snap.bags, snap.bankOpen and " (bank open)" or ""))
end
