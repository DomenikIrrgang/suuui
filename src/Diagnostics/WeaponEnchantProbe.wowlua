-- Diagnostics/WeaponEnchantProbe.wowlua
-- "/suu probe weaponenchants" (asked 2026-10-19: temporary weapon enchants,
-- a shaman's imbues, poisons, stones and oils, shown nowhere by SuuUI today,
-- neither in the buff bar nor in the Cooldown Manager): what the client gives.
-- Forever's own buff frame reads them with C_Item.GetWeaponEnchantInfo(slot)
-- (Enum.WeaponSlot 0-2; a list of { hasEnchant, enchantType, timeLeft (ms),
-- charges, enchantID, enchantIconID }) on WEAPON_ENCHANT_CHANGED and
-- WEAPON_SLOT_CHANGED, and cancels with C_Spell.CancelItemTempEnchantment
-- (slot, enchantType), which has restrictions.
--   now:     both getters (the list and the old global) per weapon slot, the
--            weapon's link and icon, its tooltip's enchant lines (the green
--            "(30 min)" text) and colours; the game's buff frame and whether
--            it lists them
--   then (this session): every change with the cast just before it (the
--            imbue, poison or stone's spell: how an enchant maps to a spell),
--            the events with their timing, player auras named like the
--            enchant, samples 1 s and 5 s into each fight and after it
--   cancel:  a button that removes the main hand's enchant (says so first)
--   secure:  (2026-10-20) the same through an aura container's item-enchantment
--            button (the game's buff frame's way), right-click to cancel
-- Saved in SuuUIProbe.weaponenchants on /reload. Values the game hides read
-- SECRET.

import isSecret from "wowlua:secret"
import after, every from "wowlua:timer"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import print from "/Core/Init"
import * as DB from "/Core/DB"

type Map = { [string]: unknown }
-- One weapon slot: the enchant list, the item, the tooltip's enchant lines
-- and the enchant's name from them.
type SlotInfo = { list: string, link: string, icon: string, tooltip: string[], name?: string }
-- Everything about the weapons at one moment.
type Snapshot = { at: string, t: string, what: string, combat: boolean, old: string, slots: { [string]: SlotInfo }, castBefore?: string }
type Cancel = { armedAt: string, before?: Snapshot, after?: Snapshot, enchantType?: string, calls: string[] }
type Secure = { armedAt: string, before?: Snapshot, after?: Snapshot, tempInfo: { [number]: string }, goneAfter?: string,
                button?: string, [string]: unknown }
-- What the probe saves in SuuUIProbe.weaponenchants.
type Out = {
    session?: string, api?: string[], blizzard?: Map, now?: Snapshot, refused?: string,
    changes?: Snapshot[], auras?: string[], fights?: Snapshot[], blocked?: string[],
    events?: { counts: { [string]: number }, log: string[] },
    cancel?: Cancel, secure?: Secure,
}

-- the cancel button and the secure test's aura container (were WP.button
-- and WP.secureFrame)
local cancelButton: Button? = nil
local secureFrame: Frame? = nil

local function show(v: unknown): string
    if isSecret(v) then return "SECRET" end
    return tostring(v)
end

local function out(): Out
    return DB.probeData("weaponenchants", function(): Out return {} end)
end

local function push<T>(list: T[], line: T, cap: number?)
    if #list < (cap or 60) then list[#list + 1] = line end
end

-- `fn(...)` protected: { ok, results… }, or { false, "missing" }.
local function results(fn: unknown, ...: unknown): unknown[]
    if type(fn) ~= "function" then return { false, "missing" } end
    return { pcall(fn, ...) }
end

local t0 = GetTime()
local function stamp(): string return ("%.1fs"):format(GetTime() - t0) end

-- weapon slot (Enum.WeaponSlot), inventory slot
local SLOTS = {
    { name = "MainHand", ws = 0, inv = 16 },
    { name = "OffHand", ws = 1, inv = 17 },
    { name = "Ranged", ws = 2, inv = 18 },
}

local FIELDS = { "hasEnchant", "enchantType", "timeLeft", "charges", "enchantID", "enchantIconID" }

-- C_Item.GetWeaponEnchantInfo(slot): each enchant's fields, or why not;
-- and the first enchant there is
local function listInfo(ws: number): (string, unknown)
    local res = results(tbl.field(C_Item, "GetWeaponEnchantInfo"), ws)
    local ok, list = res[1], res[2]
    if list == "missing" and not ok then return "no C_Item.GetWeaponEnchantInfo", nil end
    if not ok then return "error: " .. tostring(list), nil end
    if isSecret(list) then return "SECRET (the list)", nil end
    if type(list) ~= "table" then return "returned " .. type(list), nil end
    local parts: string[], first: unknown = {}, nil
    for i, e in pairs(list) do
        if isSecret(e) then
            parts[#parts + 1] = ("[%s] SECRET"):format(tostring(i))
        elseif type(e) == "table" then
            local f: string[] = {}
            for _, k in ipairs(FIELDS) do f[#f + 1] = k .. "=" .. show(tbl.field(e, k)) end
            parts[#parts + 1] = ("[%s] %s"):format(tostring(i), table.concat(f, ", "))
            local has = tbl.field(e, "hasEnchant")
            if first == nil and not isSecret(has) and has then first = e end
        else
            parts[#parts + 1] = ("[%s] %s"):format(tostring(i), type(e))
        end
    end
    if #parts == 0 then return "empty list", nil end
    return table.concat(parts, " | "), first
end

-- the old global GetWeaponEnchantInfo(): all its returns
local function oldInfo(): string
    if type(GetWeaponEnchantInfo) ~= "function" then return "no global GetWeaponEnchantInfo" end
    local r = results(GetWeaponEnchantInfo)
    if not r[1] then return "error: " .. tostring(r[2]) end
    local parts: string[] = {}
    for i = 2, math.max(#r, 2) do parts[#parts + 1] = show(r[i]) end
    return table.concat(parts, ", ")
end

local function greenish(c: unknown): boolean
    if type(c) ~= "table" or isSecret(c) then return false end
    local r, g, b = tbl.field(c, "r"), tbl.field(c, "g"), tbl.field(c, "b")
    if type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then return false end
    return g > 0.8 and r < 0.3 and b < 0.3
end

-- the tooltip's enchant lines: green, or with "(N min)" / "(N charges)"
local function tooltipLines(inv: number): string[]
    local res = results(tbl.field(C_TooltipInfo, "GetInventoryItem"), "player", inv)
    local ok, data = res[1], res[2]
    if data == "missing" and not ok then return { "no C_TooltipInfo.GetInventoryItem" } end
    if not ok then return { "error: " .. tostring(data) } end
    if isSecret(data) then return { "SECRET (the data)" } end
    local lines = tbl.field(data, "lines")
    if type(lines) ~= "table" then return { "no lines" } end
    local found: string[] = {}
    local all = tbl.list(lines)
    for i, l in ipairs(all) do
        local text, c = tbl.field(l, "leftText"), tbl.field(l, "leftColor")
        if isSecret(text) then
            found[#found + 1] = ("line %d: SECRET"):format(i)
        elseif type(text) == "string" then
            local timed = text:find("%(%d+ [%a ]+%)") ~= nil
            if timed or greenish(c) then
                local color = "?"
                if type(c) == "table" and not isSecret(c) then
                    color = ("%s,%s,%s"):format(show(tbl.field(c, "r")), show(tbl.field(c, "g")), show(tbl.field(c, "b")))
                end
                found[#found + 1] = ("line %d: %s (colour %s%s)"):format(i, text, color, timed and ", timed" or "")
            end
        end
    end
    if #found == 0 then found[1] = ("%d lines, none green or timed"):format(#all) end
    return found
end

-- "Windfury 1 (30 min)" -> "Windfury"
local function enchantName(lines: string[]): string?
    for _, l in ipairs(lines) do
        local text = l:match("^line %d+: (.-) %(colour")
        if text and text:find("%(%d+ [%a ]+%)") then
            local name = text:gsub("%s*%(.*%)%s*$", ""):gsub("%s+%d+$", "")
            if name ~= "" then return name end
        end
    end
    return nil
end

local function blizzard(): Map
    local b: Map = {}
    local bf = frames.find("BuffFrame")
    if bf then
        local temp = 0
        for _, a in pairs(tbl.list(tbl.field(bf, "auraInfo"))) do
            if tbl.field(a, "auraType") == "TempEnchant" then temp = temp + 1 end
        end
        local parent = bf:GetParent()
        b.buffFrame = ("exists, shown %s, alpha %s, parent %s, TempEnchant entries in auraInfo %d"):format(show(bf:IsShown()),
            show(bf:GetAlpha()), parent and (parent:GetName() or "unnamed") or "none", temp)
    else
        b.buffFrame = "no BuffFrame"
    end
    local tf = frames.find("TemporaryEnchantFrame")
    b.temporaryEnchantFrame = tf and ("exists, shown %s"):format(show(tf:IsShown())) or "no TemporaryEnchantFrame"
    b.displayTemporaryEnchantIcon = show(results(tbl.field(C_CVar, "GetCVar"), "displayTemporaryEnchantIcon")[2])
    return b
end

local function api(): string[]
    local a: string[] = {}
    local function has(label: string, v: unknown) a[#a + 1] = label .. ": " .. type(v) end
    has("C_Item.GetWeaponEnchantInfo", tbl.field(C_Item, "GetWeaponEnchantInfo"))
    has("GetWeaponEnchantInfo (global)", GetWeaponEnchantInfo)
    has("C_Spell.CancelItemTempEnchantment", tbl.field(C_Spell, "CancelItemTempEnchantment"))
    has("CancelItemTempEnchantment (global)", tbl.field(_G, "CancelItemTempEnchantment"))
    has("C_TooltipInfo.GetInventoryItem", tbl.field(C_TooltipInfo, "GetInventoryItem"))
    has("Enum.WeaponSlot", tbl.field(Enum, "WeaponSlot"))
    has("Enum.ItemEnchantType", tbl.field(Enum, "ItemEnchantType"))
    return a
end

-- Everything about the weapons now, and a signature of the enchants.
local function snapshot(what: string): (Snapshot, string)
    local s: Snapshot = { at = date("%H:%M:%S"), t = stamp(), what = what, combat = InCombatLockdown() and true or false,
                old = oldInfo(), slots = {} }
    local sig: string[] = {}
    for _, slot in ipairs(SLOTS) do
        local list, first = listInfo(slot.ws)
        local lines = tooltipLines(slot.inv)
        s.slots[slot.name] = {
            list = list,
            link = show(GetInventoryItemLink("player", slot.inv)),
            icon = show(GetInventoryItemTexture("player", slot.inv)),
            tooltip = lines,
            name = enchantName(lines),
        }
        sig[#sig + 1] = first ~= nil and (show(tbl.field(first, "enchantID")) .. "/" .. show(tbl.field(first, "enchantType"))) or list
    end
    return s, table.concat(sig, ";")
end

-- The main hand's enchant in a snapshot: its name, else its list.
local function mainHand(s: Snapshot?): string
    local mh = s and s.slots.MainHand
    return mh and (mh.name or mh.list) or "?"
end

--------------------------------------------------------------------------------
-- Listening: changes, the cast before each, events, auras, fights
--------------------------------------------------------------------------------

type Cast = { at: number, id: string, name: string, icon: string }
local casts: Cast[] = {}        -- the last few player casts { at, id, name, icon }
local lastSig: string? = nil
local knownNames: { [string]: boolean } = {}   -- enchant names from the tooltip
local seenAura: { [string]: boolean } = {}
local fights = 0

local function recentCasts(within: number): string
    local list: string[] = {}
    for i = #casts, 1, -1 do
        local c = casts[i]
        if GetTime() - c.at <= within then
            list[#list + 1] = ("%s (spell %s, icon %s) %.1fs before"):format(c.name, c.id, c.icon, GetTime() - c.at)
        end
    end
    return #list > 0 and table.concat(list, " | ") or "none in " .. within .. " s"
end

local function learnNames(s: Snapshot)
    for _, slot in pairs(s.slots) do
        local name = slot.name
        if name then knownNames[name:lower()] = true end
    end
end

local function checkChange(event: string)
    local s, sig = snapshot("after " .. event)
    if sig == lastSig then return end
    lastSig = sig
    learnNames(s)
    local castBefore = recentCasts(5)
    s.castBefore = castBefore
    local o = out()
    local changes = o.changes or {}
    o.changes = changes
    push(changes, s, 30)
    print(("Weapon enchant probe: a change (%s). Main hand: %s; cast before: %s."):format(event, mainHand(s), castBefore))
end

local function scanAuras()
    if not next(knownNames) then return end
    for i = 1, 40 do
        local ok, a = pcall(C_UnitAuras.GetAuraDataByIndex, "player", i, "HELPFUL")
        if not ok or type(a) ~= "table" then break end
        local name = tbl.field(a, "name")
        if not isSecret(name) and type(name) == "string" then
            local low = name:lower()
            for n in pairs(knownNames) do
                if (low:find(n, 1, true) or n:find(low, 1, true)) and not seenAura[low] then
                    seenAura[low] = true
                    local o = out()
                    local auras = o.auras or {}
                    o.auras = auras
                    push(auras, ("%s %s: spell %s, duration %s, expires %s (matches the enchant %q)"):format(stamp(), name,
                        show(tbl.field(a, "spellId")), show(tbl.field(a, "duration")), show(tbl.field(a, "expirationTime")), n), 20)
                end
            end
        end
    end
end

local function sample(what: string)
    local o = out()
    local list = o.fights or {}
    o.fights = list
    local s = snapshot(what)
    push(list, s, 20)
end

local listening: Frame? = nil
local function listen()
    if listening then return end
    local f = CreateFrame("Frame")
    listening = f
    for _, e in ipairs({ "WEAPON_ENCHANT_CHANGED", "WEAPON_SLOT_CHANGED", "PLAYER_EQUIPMENT_CHANGED",
                         "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED", "ADDON_ACTION_BLOCKED",
                         "ADDON_ACTION_FORBIDDEN", "UI_ERROR_MESSAGE" }) do
        pcall(f.RegisterEvent, f, e)
    end
    pcall(f.RegisterUnitEvent, f, "UNIT_INVENTORY_CHANGED", "player")
    pcall(f.RegisterUnitEvent, f, "UNIT_AURA", "player")
    pcall(f.RegisterUnitEvent, f, "UNIT_SPELLCAST_SUCCEEDED", "player")
    f:SetScript("OnEvent", function(_, event: string, a: unknown, b: unknown, c: unknown)
        local o = out()
        local ev = o.events or { counts = {}, log = {} }
        o.events = ev
        ev.counts[event] = (ev.counts[event] or 0) + 1
        if event ~= "UNIT_AURA" then
            push(ev.log, ("%s %s %s %s %s"):format(stamp(), event, show(a), show(b), show(c)), 150)
        end
        if event == "UNIT_SPELLCAST_SUCCEEDED" then
            local id = c
            local name = results(tbl.field(C_Spell, "GetSpellName"), id)[2]
            local icon = results(tbl.field(C_Spell, "GetSpellTexture"), id)[2]
            casts[#casts + 1] = { at = GetTime(), id = show(id), name = show(name), icon = show(icon) }
            if #casts > 8 then table.remove(casts, 1) end
        elseif event == "WEAPON_ENCHANT_CHANGED" or event == "WEAPON_SLOT_CHANGED" or event == "UNIT_INVENTORY_CHANGED"
            or event == "PLAYER_EQUIPMENT_CHANGED" then
            -- a moment later as well: the enchant may land after the event
            checkChange(event)
            after(0.5, function() checkChange(event .. " +0.5 s") end)
        elseif event == "UNIT_AURA" then
            scanAuras()
        elseif event == "PLAYER_REGEN_DISABLED" then
            fights = fights + 1
            if fights <= 6 then
                local n = fights
                after(1, function() sample(("fight %d, 1 s in"):format(n)) end)
                after(5, function() sample(("fight %d, 5 s in"):format(n)) end)
            end
        elseif event == "PLAYER_REGEN_ENABLED" then
            if fights <= 6 then
                local n = fights
                after(0.5, function() sample(("fight %d, after it"):format(n)) end)
            end
        elseif event == "ADDON_ACTION_BLOCKED" or event == "ADDON_ACTION_FORBIDDEN" or event == "UI_ERROR_MESSAGE" then
            local blocked = o.blocked or {}
            o.blocked = blocked
            push(blocked, ("%s %s %s %s"):format(stamp(), event, show(a), show(b)), 30)
        end
    end)
end

--------------------------------------------------------------------------------
-- Cancel: a button that removes the main hand's enchant
--------------------------------------------------------------------------------

local function cancel()
    local o = out()
    local r: Cancel = { armedAt = date("%H:%M:%S"), calls = {} }
    o.cancel = r
    local b = cancelButton or CreateFrame("Button", nil, UIParent, "UIPanelButtonTemplate")
    cancelButton = b
    b:SetSize(360, 30)
    b:ClearAllPoints()
    b:SetPoint("CENTER", UIParent, "CENTER", 0, 160)
    b:SetFrameStrata("DIALOG")
    b:SetText("Weapon enchant probe: remove the main hand's enchant")
    b:SetScript("OnClick", function(self)
        r.before = snapshot("before the cancel")
        local _, first = listInfo(0)
        local kindValue = tbl.field(first, "enchantType")
        local kind = type(kindValue) == "number" and not isSecret(kindValue) and kindValue or nil
        r.enchantType = show(kind)
        local cancelFn = tbl.field(C_Spell, "CancelItemTempEnchantment")
        local globalCancel = tbl.field(_G, "CancelItemTempEnchantment")
        if type(cancelFn) == "function" then
            -- the enchant's own type, else Temporary (2) then Imbue (3)
            local tries: number[] = kind and { kind } or { 2, 3 }
            for _, k in ipairs(tries) do
                local res = results(cancelFn, 0, k)
                r.calls[#r.calls + 1] = ("C_Spell.CancelItemTempEnchantment(0, %d): %s"):format(k,
                    res[1] and "ran" or ("error: " .. tostring(res[2])))
            end
        elseif type(globalCancel) == "function" then
            local res = results(globalCancel, 1)
            r.calls = { "CancelItemTempEnchantment(1): " .. (res[1] and "ran" or ("error: " .. tostring(res[2]))) }
        else
            r.calls = { "no cancel function" }
        end
        self:Hide()
        after(1, function()
            local later = snapshot("1 s after the cancel")
            r.after = later
            print(("Weapon enchant probe: cancel %s; main hand now: %s. /reload to save it."):format(
                table.concat(r.calls, "; "), mainHand(later)))
        end)
    end)
    b:Show()
    print("Weapon enchant probe: the button at the top of the screen REMOVES your main hand's temporary enchant (imbue, poison, stone or oil). Click it once if that's fine.")
end

--------------------------------------------------------------------------------
-- Secure: the game's own cancel (2026-10-20: the direct call is refused, and
-- the secure "cancelaura" action breaks on Forever: CANCELABLE_ITEMS is nil).
-- The game's buff frame cancels a weapon's enchant from an aura container's
-- item-enchantment button (AddItemEnchantment, SetCancelAuraButtons): one
-- such container here, with the main hand's enchant, right-click to cancel.
--------------------------------------------------------------------------------

local function secure()
    local o = out()
    local r: Secure = { armedAt = date("%H:%M:%S"), tempInfo = {} }
    o.secure = r
    if not C_AddOns.IsAddOnLoaded("Blizzard_AuraContainer") then pcall(C_AddOns.LoadAddOn, "Blizzard_AuraContainer") end
    local before = snapshot("before the click")
    r.before = before
    -- what the container reads an enchant with (nothing: it never shows one)
    local tempInfo = tbl.field(C_PaperDollInfo, "GetTemporaryEnchantmentInfo")
    for _, inv in ipairs({ 16, 17, 18 }) do
        if type(tempInfo) ~= "function" then r.tempInfo[inv] = "missing" break end
        local res = results(tempInfo, inv)
        local parts: string[] = {}
        for i = 2, math.max(2, #res) do
            local v = res[i]
            if type(v) == "table" and not isSecret(v) then
                local kv: string[] = {}
                for k, x in pairs(v) do kv[#kv + 1] = ("%s=%s"):format(tostring(k), show(x)) end
                table.sort(kv)
                parts[#parts + 1] = "{" .. table.concat(kv, ", ") .. "}"
            else
                parts[#parts + 1] = show(v)
            end
        end
        r.tempInfo[inv] = (res[1] and "" or "error: ") .. table.concat(parts, " | ")
    end
    -- obj:name(...), noted under `key`
    local function try(key: string, obj: unknown, name: string, ...: unknown): boolean
        local res = results(tbl.field(obj, name), obj, ...)
        local ok = res[1] == true
        r[key] = ok and "ran" or (res[2] == "missing" and "missing" or ("error: " .. tostring(res[2])))
        return ok
    end
    local c = secureFrame
    if not c then
        local ok, made = pcall(CreateFrame, "AuraContainer", nil, UIParent, "CustomAuraContainerTemplate")
        r.container = ok and "made" or ("error: " .. tostring(made))
        if not ok then print("Weapon enchant probe: no aura container (" .. tostring(made) .. "). /reload to save it.") return end
        c = made
        secureFrame = made
        made:SetSize(44, 44)
        made:SetPoint("CENTER", UIParent, "CENTER", 0, 160)
        made:SetFrameStrata("DIALOG")
        -- as the buff bar sets its containers up: a unit, a flow layout
        try("setUnit", made, "SetUnit", "player")
        try("anchor", made, "SetFlowLayoutAnchorPoint", "TOPLEFT")
        try("layout", made, "SetItemEnchantmentLayout", { elementWidth = 40, elementHeight = 40 })
        local slotValue = tbl.field(_G, "AuraContainerItemEnchantmentSlot", "MainHand")
        local slot = type(slotValue) == "number" and slotValue or 0
        -- as the buff bar's buttons: the engine only anchors them, their
        -- size is ours (unsized, nothing renders), regions made before
        -- they're registered
        local function init(value: unknown)
            local button = frames.asFrame(value)
            if not button then return end
            try("size", button, "SetSize", 40, 40)
            local icon = button:CreateTexture(nil, "ARTWORK")
            icon:SetAllPoints()
            try("setIcon", button, "SetIcon", icon)
            try("setCancel", button, "SetCancelAuraButtons", "RightButtonUp")
        end
        local res = results(tbl.field(made, "AddItemEnchantment"), made, slot, { hidePermanent = false, initializeFrame = init })
        local button = res[2]
        r.add = res[1] and show(button) or ("error: " .. tostring(button))
        try("enable", made, "SetItemEnchantmentEnabled", slot, true)
        if res[1] and button and not r.size then init(button) end
        local bg = made:CreateTexture(nil, "BACKGROUND")
        bg:SetAllPoints()
        bg:SetColorTexture(1, 0, 1, 0.25)
        local label = made:CreateFontString(nil, "OVERLAY", "GameFontNormal")
        label:SetPoint("BOTTOM", made, "TOP", 0, 6)
        label:SetText("Weapon enchant probe: right-click the icon to remove your main hand's enchant")
    end
    c:Show()
    local container = c
    -- what the button is a few seconds on (size, shown, its icon), and the
    -- main hand each second for a minute: the moment its enchant goes
    after(2, function()
        local value = results(tbl.field(container, "GetItemEnchantmentFrame"), container, 0)[2]
        local button = frames.asFrame(value)
        if button then
            local w, h = button:GetSize()
            r.button = ("shown %s visible %s size %s x %s"):format(show(button:IsShown()), show(button:IsVisible()), show(w), show(h))
        else
            r.button = show(value)
        end
    end)
    -- (the list holds the time left, which ticks: only whether there is one)
    local function has(snap: Snapshot): boolean
        local mh = snap.slots.MainHand
        return (mh and mh.list or ""):find("hasEnchant=true", 1, true) ~= nil
    end
    local first = has(before)
    local n = 0
    every(1, function(ticker: TickerHandle)
        n = n + 1
        local now = snapshot("watching")
        if has(now) ~= first then
            r.after = now
            r.goneAfter = n .. " s"
            ticker:Cancel()
            print("Weapon enchant probe: your main hand's enchant changed (" .. mainHand(now) .. "). /reload to save it.")
        elseif n >= 60 then
            ticker:Cancel()
            r.after = now
            print("Weapon enchant probe: a minute passed, the enchant is still there. /reload to save it.")
        end
    end)
    print("Weapon enchant probe: right-click the icon at the top of the screen (a pink square shows where the container is); it REMOVES your main hand's temporary enchant. Watching for a minute.")
end

export function command(rest: string?)
    local o = out()
    listen()
    if InCombatLockdown() then
        o.refused = ("%s: asked in combat (%s)"):format(date("%H:%M:%S"), tostring(rest))
        print("Weapon enchant probe: not in combat; try again after the fight.")
        return
    end
    if (rest or ""):lower():match("^%s*secure") then
        secure()
        return
    end
    if (rest or ""):lower():match("^%s*cancel") then
        cancel()
        return
    end
    o.session = date("%Y-%m-%d %H:%M:%S")
    o.api = api()
    o.blizzard = blizzard()
    local s, sig = snapshot("now")
    o.now = s
    lastSig = sig
    learnNames(s)
    scanAuras()
    print(("Weapon enchant probe: recorded your weapons (main hand: %s). Now put an enchant on (an imbue, a poison, a stone or an oil), fight a few mobs, then /reload."):format(
        mainHand(s)))
end
