-- Diagnostics/MemoryProbe.wowlua
-- "/suu probe memory" (asked 2026-10-18: SuuUI showed 68 MB): where SuuUI's
-- memory goes. Records SuuUI's memory before and after a full garbage
-- collection (what was only garbage), then an estimate of what each part
-- holds, walked once so nothing counts twice: the saved variables
-- (SuuUIProbe, then SuuUIDB's profiles and each character's data), each
-- module, then the namespace's tables (the bundled data: quest givers,
-- collection sources…): since the wowlua port, each module's export table
-- (the runtime's registry, keyed by module ID) and what is left in the
-- addon table.
-- Estimates use Lua 5.1's sizes (a table's header, array and hash parts; each
-- string once); what no walk reaches (closures, upvalues, the frames' own
-- objects) is the rest. Saved in SuuUIProbe.memory on /reload.

import print from "/Core/Init"
import * as DB from "/Core/DB"
import * as modules from "/Core/Modules"
import * as tbl from "wowlua:table"

local _, addonNs = ...
-- the addon table, walked by hand
local addonTable: unknown = addonNs

local ADDON = "SuuUI"

local function addonKB(): number
    UpdateAddOnMemoryUsage()
    return GetAddOnMemoryUsage(ADDON)
end

-- One of the game's frames (a table holding its userdata at [0]).
local function isFrame(v: unknown): boolean
    return type(v) == "table" and type(rawget(v, 0)) == "userdata"
end

-- A walker with one seen set: a table or string reached again costs nothing.
type Size = (v: unknown) -> number

local function walker(seen: { [unknown]: unknown }): Size
    local function size(v: unknown): number
        if type(v) == "string" then
            if seen[v] then
                return 0
            end
            seen[v] = true
            return 25 + #v
        elseif type(v) == "function" then
            if seen[v] then
                return 0
            end
            seen[v] = true
            return 40
        elseif type(v) ~= "table" then
            return 0
        end
        if seen[v] then
            return 0
        end
        seen[v] = true
        -- a frame: its own fields only, never into the game's frames
        local forbidden = tbl.field(v, "IsForbidden")
        if isFrame(v) and type(forbidden) == "function" and forbidden(v) then
            return 0
        end
        local arr, hash, n = 0, 0, 56
        -- a table the game guards (secret keys) can't be walked: counted empty
        pcall(function()
            arr = #v
            for k, x in pairs(v) do
                if not (type(k) == "number" and k >= 1 and k <= arr and k % 1 == 0) then
                    hash = hash + 1
                end
                n = n + size(k) + size(x)
            end
        end)
        local slots = 0
        if hash > 0 then
            slots = 1
            while slots < hash do
                slots = slots * 2
            end
        end
        return n + 16 * arr + 40 * slots
    end
    return size
end

-- A seen set that counts the game's frames as seen already.
local function seenWith(gameFrames: { [unknown]: boolean }): { [unknown]: unknown }
    local seen: { [unknown]: unknown } = {}
    setmetatable(seen, { __index = gameFrames })
    return seen
end

local function kb(bytes: number): number
    return math.floor(bytes / 1024 + 0.5)
end

-- The largest entries of a table, each its own size (walked in order, so a
-- table shared by two counts for the first).
type Row = { k: string, v: unknown, n: number }

local function biggest(size: Size, t: unknown, limit: number): (string[], number)
    local rows: Row[] = {}
    if type(t) == "table" then
        for k, v in pairs(t) do
            if type(v) == "table" then
                rows[#rows + 1] = { k = tostring(k), v = v, n = 0 }
            end
        end
    end
    table.sort(rows, function(a: Row, b: Row): boolean
        return a.k < b.k
    end)
    local total = 0
    for _, r in ipairs(rows) do
        r.n = size(r.v)
        total = total + r.n
    end
    table.sort(rows, function(a: Row, b: Row): boolean
        return a.n > b.n
    end)
    local out: string[] = {}
    for i = 1, math.min(limit, #rows) do
        if rows[i].n >= 10240 then
            out[#out + 1] = ("%s %d KB"):format(rows[i].k, kb(rows[i].n))
        end
    end
    return out, total
end

-- Down the biggest branch of a table: each level's largest fields, then
-- into the largest, for up to `depth` levels (a list's items count as one
-- field, "[n]", the size of all of them, shown with the first's breakdown).
local function drill(gameFrames: { [unknown]: boolean }, start: unknown, depth: number): string[]
    local out: string[] = {}
    local t = start
    for level = 1, depth do
        if type(t) ~= "table" then
            break
        end
        local seen = seenWith(gameFrames)
        seen[t] = true
        local size = walker(seen)
        local rows: Row[], items, itemN = {}, 0, 0
        local first: unknown = nil
        for k, v in pairs(t) do
            if type(k) == "number" then
                items = items + 1
                itemN = itemN + size(v)
                if first == nil then
                    first = v
                end
            elseif type(v) == "table" or type(v) == "string" then
                rows[#rows + 1] = { k = tostring(k), v = v, n = size(v) }
            end
        end
        if items > 0 then
            rows[#rows + 1] = { k = "[" .. items .. "]", v = first, n = itemN }
        end
        table.sort(rows, function(a: Row, b: Row): boolean
            return a.n > b.n
        end)
        local line: string[] = {}
        for i = 1, math.min(6, #rows) do
            line[#line + 1] = ("%s %d KB"):format(rows[i].k, kb(rows[i].n))
        end
        out[level] = table.concat(line, ", ")
        t = rows[1] and rows[1].v
    end
    return out
end

-- An aura container's buttons: how many the engine made per group (and
-- distinct buttons, in case it initialises one twice), against the maxima.
local function containerInfo(c: unknown): string
    local buttons = tbl.field(c, "buttons")
    if buttons == nil then
        return "none"
    end
    local list = tbl.list(buttons)
    local per: { [unknown]: number }, distinct: { [unknown]: boolean }, n = {}, {}, 0
    for _, b in ipairs(list) do
        local key, button = tbl.field(b, "key"), tbl.field(b, "button")
        if key ~= nil then
            per[key] = (per[key] or 0) + 1
        end
        if button ~= nil and not distinct[button] then
            distinct[button] = true
            n = n + 1
        end
    end
    local maxima: string[] = {}
    local container = tbl.field(c, "container")
    local getMax = tbl.field(container, "GetAuraGroupMaxFrameCount")
    for _, g in ipairs(tbl.list(tbl.field(c, "opts", "groups"))) do
        local key = tbl.field(g, "key")
        local cur: unknown = nil
        if type(getMax) == "function" then
            cur = select(2, pcall(getMax, container, key))
        end
        maxima[#maxima + 1] = ("%s made=%d max=%s now=%s"):format(
            tostring(key),
            key ~= nil and per[key] or 0,
            tostring(tbl.field(g, "max")),
            tostring(cur)
        )
    end
    return ("%d entries, %d buttons: %s"):format(#list, n, table.concat(maxima, "; "))
end

export function command()
    local out: { [string]: unknown } = { at = date("%Y-%m-%d %H:%M:%S") }
    local before = math.floor(addonKB())
    out.before = before
    out.allAddonsBefore = math.floor(collectgarbage("count"))
    collectgarbage("collect")
    local after = math.floor(addonKB())
    out.after = after
    out.allAddonsAfter = math.floor(collectgarbage("count"))
    out.garbage = before - after

    -- the game's named frames are the game's: never walked
    local gameFrames: { [unknown]: boolean } = {}
    for name, v in pairs(_G) do
        if isFrame(v) and not (type(name) == "string" and name:find("^SuuUI")) then
            gameFrames[v] = true
        end
    end
    local size = walker(seenWith(gameFrames))
    local walked = 0

    -- the probe data first, so the rest never counts it
    local probe = DB.probe
    local last = probe.memory
    probe.memory = nil
    local probeBytes: number
    out.probe, probeBytes = biggest(size, probe, 12)
    local probeKB = kb(probeBytes)
    out.probeKB = probeKB
    walked = walked + probeKB
    probe.memory = last

    -- (walked as plain tables: its shape doesn't matter here)
    local db = DB.db
    local dbBytes: number
    out.db, dbBytes = biggest(size, db, 12)
    local dbKB = kb(dbBytes)
    out.dbKB = dbKB
    walked = walked + dbKB
    -- each profile and character on its own (strings they share count in each)
    out.profiles = biggest(walker({}), db.profiles, 12)
    out.chars = biggest(walker({}), db.charData, 12)
    -- inside the biggest profile and character, one level down
    for _, which in ipairs({ "profiles", "charData" }) do
        local best: unknown, bestN: number? = nil, nil
        local all = db[which]
        if type(all) == "table" then
            for k, v in pairs(all) do
                local n = walker({})(v)
                if not bestN or n > bestN then
                    best, bestN = k, n
                end
            end
        end
        if best ~= nil then
            out[which .. "Inside"] = {
                name = tostring(best),
                (biggest(walker({}), tbl.field(all, tostring(best)), 10)),
            }
        end
    end

    -- each module, its frames included
    local mods: { [string]: unknown } = {}
    for _, m in ipairs(modules.all()) do
        mods[tostring(m.id)] = m
    end
    local modBytes: number
    out.modules, modBytes = biggest(size, mods, 25)
    local modulesKB = kb(modBytes)
    out.modulesKB = modulesKB
    walked = walked + modulesKB
    -- the biggest modules, down their biggest branch
    local drilled: { [string]: string[] } = {}
    out.drill = drilled
    for _, id in ipairs({ "raid", "party", "auras", "cooldowns", "actionbars" }) do
        if mods[id] then
            drilled[id] = drill(gameFrames, mods[id], 6)
        end
    end

    -- the namespace: bundled data, shared tables
    local nsTables: { [unknown]: unknown } = {}
    if type(addonTable) == "table" then
        for k, v in pairs(addonTable) do
            if k ~= "__wowlua" and type(v) == "table" and not isFrame(v) then
                nsTables[k] = v
            end
        end
    end
    -- the modules' export tables (ns.X before the port), by module ID
    local exportsByModule = tbl.field(addonTable, "__wowlua", "modules")
    if type(exportsByModule) == "table" then
        for id, exports in pairs(exportsByModule) do
            if type(exports) == "table" and not isFrame(exports) then
                nsTables[id] = exports
            end
        end
    end
    local nsBytes: number
    out.ns, nsBytes = biggest(size, nsTables, 25)
    local nsKB = kb(nsBytes)
    out.nsKB = nsKB
    walked = walked + nsKB

    -- the aura containers that hold the most
    local raid, party, auras = mods.raid, mods.party, mods.auras
    out.containers = {
        raid1 = containerInfo(tbl.field(tbl.list(tbl.field(raid, "buttons"))[1], "auras")),
        raid40 = containerInfo(tbl.field(tbl.list(tbl.field(raid, "buttons"))[40], "auras")),
        party1 = containerInfo(tbl.field(tbl.list(tbl.field(party, "frames"))[1], "auras")),
        targetDebuffs = containerInfo(tbl.field(auras, "attached", "targetDebuffs")),
        player = containerInfo(tbl.field(auras, "attached", "player")),
    }

    out.walkedKB = walked
    out.rest = after - walked
    collectgarbage("collect")

    DB.probe.memory = out
    print(
        ("Memory probe: SuuUI %.1f MB (%.1f MB after collecting garbage); probe data ~%.1f MB, saved settings ~%.1f MB, data ~%.1f MB, modules ~%.1f MB. /reload to save it."):format(
            before / 1024,
            after / 1024,
            probeKB / 1024,
            dbKB / 1024,
            nsKB / 1024,
            modulesKB / 1024
        )
    )
end
