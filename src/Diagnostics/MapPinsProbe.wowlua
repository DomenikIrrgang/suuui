-- Diagnostics/MapPinsProbe.wowlua
-- "/suu probe mappins" (asked 2026-10-19: the little houses the game draws
-- on the world map, to hide them): every pin the game's map shows on the
-- map open now, by template, with what each says it is (its POI's name,
-- atlas and ID, its own textures' atlases).
-- Saved in SuuUIProbe.mapPins on /reload. Values the game hides read SECRET.

import * as DB from "/Core/DB"
import print from "/Core/Init"
import isSecret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"

local function show(v: unknown): string
    if isSecret(v) then
        return "SECRET"
    end
    return tostring(v)
end

-- the atlases (or files) of a pin's own textures
local function art(pin: unknown): string
    local out: string[] = {}
    local f = frames.asFrame(pin)
    for _, r in ipairs(f and frames.textures(f) or {}) do
        if r:IsShown() then
            local a = r:GetAtlas()
            local t = not a and r:GetTexture()
            if a or t then
                out[#out + 1] = show(a or t)
            end
        end
    end
    return table.concat(out, ", ")
end

local function describe(pin: unknown): string
    local parts: string[] = {}
    for _, key in ipairs({ "poiInfo", "areaPoiInfo", "vignetteInfo", "plotInfo", "taxiNodeData" }) do
        local i = tbl.field(pin, key)
        if type(i) == "table" then
            local field = function(k: string): unknown
                return tbl.field(i, k)
            end
            parts[#parts + 1] = ("%s: name %s, atlas %s, id %s"):format(
                key,
                show(field("name")),
                show(field("atlasName")),
                show(
                    field("areaPoiID") or field("poiID") or field("vignetteID") or field("plotDataID") or
                        field("nodeID")
                )
            )
        end
    end
    local x: unknown, y: unknown = nil, nil
    local position = tbl.field(pin, "GetPosition")
    if type(position) == "function" then
        x, y = position(pin)
    end
    parts[#parts + 1] = ("at %s,%s"):format(show(x), show(y))
    parts[#parts + 1] = "art " .. art(pin)
    return table.concat(parts, "; ")
end

export function command()
    local f = WorldMapFrame
    if not (f and f:IsShown()) then
        print("Map pins probe: open the world map on the map with the houses first, then run it again.")
        return
    end
    local o = { at = date("%H:%M:%S"), map = f:GetMapID(), templates = {} }
    local n = 0
    for template, pool in pairs(f.pinPools or {}) do
        local list = {}
        for pin in pool:EnumerateActive() do
            if #list < 6 then
                list[#list + 1] = describe(pin)
            end
            n = n + 1
        end
        if #list > 0 then
            o.templates[template] = list
        end
    end
    table.insert(tbl.listAt(DB.probe, "mapPins"), o)
    print(("Map pins probe: %d of the game's pins on map %s recorded. /reload to save it."):format(n, show(o.map)))
end
