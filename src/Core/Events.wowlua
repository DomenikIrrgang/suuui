-- Core/Events.wowlua
-- One bus for SuuUI's own messages and the game's events, on wowlua:events.
--
--   on(name, fn, owner)                  SuuUI message, delivered by emit
--   onGame(event, fn, owner)             a game event
--   onUnit(event, units, fn, owner)      a unit event for the given unit(s), through
--                                        RegisterUnitEvent so other units never wake it
--   off(name, owner) / offAll(owner)
--
-- Every callback is fn(name, ...) and runs isolated: an error is reported
-- through Fault against its owner and the other listeners still run.
-- wowlua:events does the registering and dispatching; this layer keeps
-- SuuUI's shape of it (the name first, an owner always, removal by name and
-- owner, unit lists longer than two, errors under the owner's name).
--
-- The bus is an EventBus: what registers and dispatches (a Dispatcher) and
-- what reports errors (a Reporter) come in through interfaces, so a test
-- builds a bus over a dispatcher of its own. `bus` is SuuUI's; the module's
-- functions are its methods.

import * as wl from "wowlua:events"
import * as fault from "./Fault"
import ownerName from "./Util"

-- A listener as the bus keeps it: the name, then what the message or event
-- carries. `on`, `onGame` and `onUnit` take one typed by the name
-- (`EventArgs`: Core/Messages.d.wowlua for SuuUI's messages).
export type Listener = (name: string, ...unknown) -> ()

-- What a dispatcher calls: the event's or message's values.
export type Handler = (...unknown) -> ()

-- What hears SuuUI's messages (the bus; a test's own recorder).
export interface Notifier
    function emit<M extends MessageName>(name: M, ...: EventArgs<M>...)
end

-- What registers listeners and dispatches to them. A listener runs later,
-- when its event comes (`@deferred`: the load-order check knows it).
export interface Dispatcher
    function on(name: string, @deferred fn: Handler, owner: unknown): wl.Subscription
    -- one or two units (RegisterUnitEvent's limit)
    function onUnit(event: string, units: UnitToken[], @deferred fn: Handler, owner: unknown): wl.Subscription
    function send(name: string, ...: unknown)
end

-- wowlua:events: the game's events and SuuUI's messages. The bus checked the
-- names and values against their declarations; a plugin's own message is
-- any name, so the names go through as strings here.
export class StdDispatcher implements Dispatcher
    function on(name: string, fn: Handler, owner: unknown): wl.Subscription
        return wl.on(name :: MessageName, fn, owner)
    end

    function onUnit(event: string, units: UnitToken[], fn: Handler, owner: unknown): wl.Subscription
        return wl.onUnit(event :: EventName, units, fn, owner)
    end

    function send(name: string, ...: unknown)
        wl.send(name :: MessageName, ...)
    end
end

type Entry = { name: string, owner: unknown, sub: wl.Subscription? }

local function checked(fn: unknown, owner: unknown)
    assert(type(fn) == "function", "SuuUI Events: callback must be a function")
    assert(owner ~= nil, "SuuUI Events: an owner is required, so the listener can be removed")
end

export class EventBus implements Notifier
    -- every subscription made here, so off(name, owner) finds them
    private entries: Entry[] = {}

    constructor(private dispatcher: Dispatcher = StdDispatcher.new(), private reporter: fault.Reporter = fault.log)
    end

    -- A listener removed during a dispatch is skipped from then on (the
    -- dispatcher may dispatch from a snapshot, which would still call it
    -- this time).
    private function guarded(entry: Entry, source: string, fn: Listener, name: string): Handler
        local reporter = self.reporter
        return function(...: unknown)
            local sub = entry.sub
            if sub and sub.active then reporter:call(source, fn, name, ...) end
        end
    end

    -- Any name: a plugin's own messages (`M:On`), which SuuUI doesn't declare.
    function listen(name: string, fn: Listener, owner: unknown)
        checked(fn, owner)
        local entry: Entry = { name = name, owner = owner, sub = nil }
        entry.sub = self.dispatcher:on(name, self:guarded(entry, ownerName(owner), fn, name), owner)
        self.entries[#self.entries + 1] = entry
    end

    -- A SuuUI message. Names carry a prefix so they never collide with a
    -- game event: SUUUI_* for SuuUI's own, the plugin's own prefix for a
    -- plugin's.
    function on<M extends MessageName>(name: M, fn: (name: M, EventArgs<M>...) -> (), owner: unknown)
        self:listen(name, fn :: Listener, owner)
    end

    function emit<M extends MessageName>(name: M, ...: EventArgs<M>...)
        self.dispatcher:send(name, ...)
    end

    -- Any name: a plugin's own message (`M:Emit`).
    function send(name: string, ...: unknown)
        self.dispatcher:send(name, ...)
    end

    -- A game event.
    function onGame<E extends EventName>(event: E, fn: (name: E, EventArgs<E>...) -> (), owner: unknown)
        self:listen(event, fn :: Listener, owner)
    end

    -- RegisterUnitEvent takes at most two units, so a longer list gets a
    -- registration per pair. An event the client refuses is an error, as
    -- RegisterUnitEvent's own.
    function onUnit<E extends EventName>(event: E, units: UnitToken | UnitToken[], fn: (name: E, EventArgs<E>...) -> (),
                                         owner: unknown)
        checked(fn, owner)
        local list: UnitToken[] = type(units) == "string" and { units } or units :: UnitToken[]
        assert(type(list) == "table" and #list > 0, "SuuUI Events: a unit or a list of units is required")
        local source = ownerName(owner)
        local listener = fn :: Listener
        for i = 1, #list, 2 do
            local pair: UnitToken[] = list[i + 1] and { list[i], list[i + 1] } or { list[i] }
            local entry: Entry = { name = event, owner = owner, sub = nil }
            entry.sub = self.dispatcher:onUnit(event, pair, self:guarded(entry, source, listener, event), owner)
            self.entries[#self.entries + 1] = entry
        end
    end

    function off(name: string, owner: unknown)
        for i = #self.entries, 1, -1 do
            local e = self.entries[i]
            if e.name == name and e.owner == owner then
                if e.sub then e.sub:cancel() end
                table.remove(self.entries, i)
            end
        end
    end

    function offAll(owner: unknown)
        if owner == nil then return end
        for i = #self.entries, 1, -1 do
            local e = self.entries[i]
            if e.owner == owner then
                if e.sub then e.sub:cancel() end
                table.remove(self.entries, i)
            end
        end
    end

    -- How many listeners the bus holds (for an owner, or all).
    function count(owner: unknown?): number
        if owner == nil then return #self.entries end
        local n = 0
        for _, e in ipairs(self.entries) do
            if e.owner == owner then n += 1 end
        end
        return n
    end
end

-- SuuUI's bus, and its methods as the module's functions.
export const bus = EventBus.new()

export function on<M extends MessageName>(name: M, fn: (name: M, EventArgs<M>...) -> (), owner: unknown)
    bus:on(name, fn, owner)
end

export function emit<M extends MessageName>(name: M, ...: EventArgs<M>...)
    bus:emit(name, ...)
end

export function onGame<E extends EventName>(event: E, fn: (name: E, EventArgs<E>...) -> (), owner: unknown)
    bus:onGame(event, fn, owner)
end

export function onUnit<E extends EventName>(event: E, units: UnitToken | UnitToken[], fn: (name: E, EventArgs<E>...) -> (),
                                            owner: unknown)
    bus:onUnit(event, units, fn, owner)
end

export function off(name: string, owner: unknown)
    bus:off(name, owner)
end

export function offAll(owner: unknown)
    bus:offAll(owner)
end
