-- Core/Serialize.wowlua
-- Profile strings for Import and Export.
--
--   encode(value) -> "!SUU:2!…"  wowlua:serialize's export string: compact,
--                                compressed, checksummed, printable
--   decode(text)  -> value, or nil and why not; reads those and the strings
--                    older SuuUI versions wrote ("SUU1:…", below)
--   base64(bytes), fromBase64(text) -> bytes or nil, fletcher16(bytes) ->
--   0..65535: the pieces of the SUU1 format, still used by other share texts
--   (talent builds)
--
-- Reading never runs code: wowlua:serialize's importString doesn't, and the
-- SUU1 parser below only understands that format.

import * as serialize from "wowlua:serialize"

const LEGACY_PREFIX = "SUU1:"
const PREFIX = "SUU"
const VERSION = 2

--------------------------------------------------------------------------------
-- SUU1 (before 0.6): T / F, n<number>; , s<length>:<bytes>, { key value … },
-- checksummed and base64 encoded. Read only.
--------------------------------------------------------------------------------

-- Returns value, next position; errors with a message on malformed input.
local function read(s: string, i: number, depth: number): (unknown, number)
    if depth > 20 then error("too deeply nested") end
    local c = s:sub(i, i)
    if c == "T" then return true, i + 1 end
    if c == "F" then return false, i + 1 end
    if c == "n" then
        local j = s:find(";", i + 1, true)
        local n = j and tonumber(s:sub(i + 1, j - 1))
        if not (j and n) then error("bad number") end
        return n, j + 1
    end
    if c == "s" then
        local colon = s:find(":", i + 1, true)
        local len = colon and tonumber(s:sub(i + 1, colon - 1))
        if not (colon and len) or len < 0 or colon + len > #s then error("bad string") end
        return s:sub(colon + 1, colon + len), colon + len + 1
    end
    if c == "{" then
        local t: { [unknown]: unknown } = {}
        local at = i + 1
        while s:sub(at, at) ~= "}" do
            if at > #s then error("unterminated table") end
            local k: unknown, v: unknown
            k, at = read(s, at, depth + 1)
            if type(k) ~= "string" and type(k) ~= "number" then error("bad key") end
            v, at = read(s, at, depth + 1)
            t[k] = v
        end
        return t, at + 1
    end
    error("unexpected '" .. c .. "'")
end

const B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64INDEX: { [string]: number } = {}
for i = 1, 64 do B64INDEX[B64:sub(i, i)] = i - 1 end

export function base64(s: string): string
    local out: string[] = {}
    for i = 1, #s, 3 do
        local a, b, c = s:byte(i, i + 2)
        local n = (a or 0) * 65536 + (b or 0) * 256 + (c or 0)
        local c1 = math.floor(n / 262144) % 64
        local c2 = math.floor(n / 4096) % 64
        local c3 = math.floor(n / 64) % 64
        local c4 = n % 64
        out[#out + 1] = B64:sub(c1 + 1, c1 + 1) .. B64:sub(c2 + 1, c2 + 1)
            .. (b and B64:sub(c3 + 1, c3 + 1) or "=") .. (c and B64:sub(c4 + 1, c4 + 1) or "=")
    end
    return table.concat(out)
end

export function fromBase64(text: string): string?
    local s = text:gsub("%s", "")
    if #s % 4 ~= 0 then return nil end
    local out: string[] = {}
    for i = 1, #s, 4 do
        local v: (number?)[] = {}
        for j = 1, 4 do
            local ch = s:sub(i + j - 1, i + j - 1)
            if ch == "=" then v[j] = nil else
                local x = B64INDEX[ch]
                if not x then return nil end
                v[j] = x
            end
        end
        local v1, v2, v3, v4 = v[1], v[2], v[3], v[4]
        if not (v1 and v2) or (v4 and not v3) then return nil end
        local n = v1 * 262144 + v2 * 4096 + (v3 or 0) * 64 + (v4 or 0)
        out[#out + 1] = string.char(math.floor(n / 65536) % 256)
        if v3 then out[#out + 1] = string.char(math.floor(n / 256) % 256) end
        if v4 then out[#out + 1] = string.char(n % 256) end
    end
    return table.concat(out)
end

-- Fletcher-16 over the payload; as four hex digits for profile strings.
export function fletcher16(s: string): number
    local a, b = 0, 0
    for i = 1, #s do
        a = (a + (s:byte(i) or 0)) % 255
        b = (b + a) % 255
    end
    return b * 256 + a
end

local function checksum(s: string): string
    return string.format("%04x", fletcher16(s))
end

local function decodeLegacy(text: string): (any, string?)
    local raw = fromBase64(text:sub(#LEGACY_PREFIX + 1))
    if not raw or #raw < 5 then return nil, "The string is incomplete; copy all of it." end
    local sum, payload = raw:sub(1, 4), raw:sub(5)
    if checksum(payload) ~= sum then return nil, "The string is damaged or incomplete; copy all of it." end
    local ok, value, last = pcall(read, payload, 1, 0)
    if not ok then return nil, "The string is damaged: " .. tostring(value) .. "." end
    if last ~= #payload + 1 then return nil, "The string has extra data at the end." end
    return value
end

--------------------------------------------------------------------------------

export function encode(value: any): string
    return serialize.exportString(value, { version = VERSION, prefix = PREFIX })
end

export function decode(input: string?): (any, string?)
    local text = strtrim(input or "")
    if text:sub(1, #LEGACY_PREFIX) == LEGACY_PREFIX then return decodeLegacy(text) end
    if text:sub(1, #PREFIX + 2) ~= "!" .. PREFIX .. ":" then return nil, "This isn't a SuuUI profile string." end
    local ok, value = serialize.importString(text)
    if not ok then return nil, "The string is damaged or incomplete; copy all of it." end
    return value
end
