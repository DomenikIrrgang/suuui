--------------------------------------------------------------------------------
-- Pink Cat (asked 2026-11-12): pink, lilac and cream on deep plum, cute but
-- as readable as SuuUI's own (every text and edge pair at the ratio its
-- token's usage note asks); the 30 most seen icons as cats in SuuUI's line
-- style, and every texture a theme can set that isn't geometry or a game
-- sign: paw prints in the health and cast bars, toe beans in the thin bars,
-- tiny paws for a tagged mob, hearts for absorbs and a ticked box, cat role
-- icons, claw marks for the combat sign; and a little more room. Its
-- windows (asked 2026-11-12, "maximum cute"): paws and hearts in their
-- ground and behind the bars, stitched edges, paw corners, hearts for the
-- jewels and the small marks, a divider of tiny paws, a more opaque glass.
-- The art comes from tools/pinkcat_art.py.
--------------------------------------------------------------------------------

local PINKCAT = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Themes\\PinkCat\\"

-- the glyphs drawn as cats (the others stay SuuUI's)
local PINKCAT_GLYPHS: string[] = {
    "person", -- micro menu: a cat's head and shoulders
    "hammer", -- professions: a ball of yarn and knitting needles
    "book", -- spellbook: an open book with ears
    "tree", -- talents: a sprig of catnip
    "trophy", -- Legacy: a cup with ears and eyes
    "scroll", -- quest log: a scroll with ears
    "people", -- guild: two cats
    "search", -- group finder, every search: a magnifier with ears
    "mount", -- collections: a cat's face, whiskers out
    "coin", -- shop: a cat-eared coin with a paw
    "map", -- the map: a folded map with ears
    "bag", -- bags: a bag with a paw print
    "menu", -- the game menu: a cat peeking over the lines
    "close", -- every window: two crossed whiskers
    "gear", -- settings: a gear with ears
    "filter", -- lists: a funnel with ears
    "sort", -- bags, lists: arrows with curled tails
    "chat", -- a speech bubble with ears and eyes
    "mail", -- an envelope with ears
    "check", -- done: a heart
    "pin", -- map pins: a pin with ears
    "inn", -- the map's inns: a house with ears for a roof
    "bell", -- notifications: a bell with ears
    "trash", -- a bin with a cat peeking out
    "eye", -- a cat's eye, slit pupil
    "lock", -- a padlock with ears and a cat's face (also the cast and settings locks)
    "reset", -- the turning arrow round a cat's face (also the settings' reset)
    "shield", -- the Tank: a shield with ears
    "userPlus", -- invite: a cat and a plus
    "spirit", -- the spirit healer: a ghost with ears
}

local function pinkcatGlyphs(): { [string]: string }
    local out: { [string]: string } = {}
    for _, name in ipairs(PINKCAT_GLYPHS) do
        out[name] = PINKCAT .. "Glyphs\\" .. name .. ".tga"
    end
    return out
end

register({
    id = "pinkcat",
    name = "Pink Cat",
    description = "Pink and lilac on deep plum with cream text; cat icons, paw-print bars, a little more room.",
    colors = colors({
        ["surface"] = "#190D1B",
        -- (more opaque than the raids' glass: the zone's name showed through)
        ["surface-glass"] = "#190D1BFC",
        ["surface-sunk"] = "#140F15",
        ["surface-raised"] = "#231626",
        ["track"] = "#2C1D2F",
        ["gilt"] = "#E48DBA",
        ["gilt-text"] = "#FBCDE3",
        ["gilt-line"] = "#E48DBA63",
        ["gilt-hairline"] = "#E48DBA4F",
        ["gilt-faint"] = "#E48DBA25",
        ["ink"] = "#FFF4E8",
        ["ink-muted"] = "#BFA3BA",
        ["ink-faint"] = "#8A6E84",
        ["unit-fill"] = "#845274",
        ["unit-fill-deep"] = "#59344F",
        ["ghost"] = "#FFF4E880",
        ["mana"] = "#8C8CFF",
        ["rage"] = "#E0506A",
