    },
    sizes = {
        ["icon-sm"] = 18,
        ["icon-md"] = 26,
        ["icon-lg"] = 32,
        ["menu-button"] = 30,
        ["map-pin"] = 24,
        ["slot"] = 38,
        ["meter-row"] = 20,
    },
})

-- Stranglethorn (asked 2026-11-12, the user's pick of three mockups: A and C,
-- as two themes): the jungle over SuuUI's frames. Both dress the windows,
-- the minimap, chat and the big unit frames with vines (0.40, UI/Dress),
-- headers in the game's carved Morpheus face. The art comes from
-- tools/stv_art.py.
local STV = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Themes\\Stranglethorn\\"
local MORPHEUS = "Fonts\\MORPHEUS.TTF"

-- A window's dress: a vine along its top, a leafy clump over its top left
-- corner, a vine down its right side, fireflies.
local function windowDress(prefix: string, motes: string): DressKind
    return {
        pieces = {
            { file = STV .. prefix .. "VineTop.tga", point = "TOP", span = true, x = 10, y = 32, w = 256, h = 48 },
            { file = STV .. prefix .. "Corner.tga", point = "TOPLEFT", x = -22, y = 30, w = 128, h = 112, sway = 1.5 },
            { file = STV .. prefix .. "Side.tga", point = "TOPRIGHT", x = 14, y = 6, w = 40, h = 160, sway = 2.5 },
        },
        motes = { file = STV .. "Firefly.tga", count = 4, color = motes, size = 7 },
    }
end

-- Stranglethorn Ruins (mockup A): mossy troll-ruin stone, vines and berries,
-- ember accents, fireflies.
