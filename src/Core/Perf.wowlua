-- Core/Perf.wowlua
-- "/suu perf" (plan 4.2): how much time each SuuUI module takes. The game
-- measures only whole addons, so SuuUI times its own work: every module's
-- events, setting watchers, timers and commands run through fault.call,
-- which, while measuring, adds each call's own time (nested calls taken
-- out) to its module, and the memory each call allocated (what later
-- becomes garbage, unless kept). Frame scripts a module sets itself
-- (OnUpdate) aren't counted. Memory in use is the whole addon's (the game
-- can't split it); besides, SuuUI's memory at the start and at the report,
-- and how often it was collected in between, show the garbage it makes.
--   /suu perf         start measuring; again: the report so far
--   /suu perf stop    the report, and stop measuring
-- The report goes to the chat and to SuuUIProbe.perf (on /reload).

import every from "wowlua:timer"
import * as tbl from "wowlua:table"
import print, registerCommand, name as ADDON from "./Init"
import * as fault from "./Fault"
import * as DB from "./DB"
import * as secret from "wowlua:secret"

local _, ns = ...

local startedAt: number? = nil
local startKB: number? = nil
const TOP = 12

-- All SuuUI allocates, frame scripts included: its memory once a second,
-- each rise added up (a fall is a collection). Rises within a second that a
-- collection then undoes go unseen, so it reads low too.
local sampler: TickerHandle? = nil
local lastKB: number? = nil
local risenKB: number? = nil
local collections = 0

local function memory(): number?
    if UpdateAddOnMemoryUsage then pcall(UpdateAddOnMemoryUsage) end
    local ok, kb = pcall(GetAddOnMemoryUsage, ADDON)
    return ok and kb or nil
end

-- SuuUI's share of the time the game spends on addons, when its profiler runs.
local function share(): (number?, number?)
    local P = C_AddOnProfiler
    local metric = secret.asNumber(tbl.field(Enum, "AddOnProfilerMetric", "RecentAverageTime"))
    if not (P and metric and P.IsEnabled and P.IsEnabled()) then return nil end
    local ok1, mine = pcall(P.GetAddOnMetric, ADDON, metric)
    local ok2, app = pcall(P.GetApplicationMetric, metric)
    if ok1 and ok2 and mine and app and app > 0 then return mine, mine / app * 100 end
    return nil
end

type Row = { source: string, ms: number, calls: number, peak: number, kb: number }

-- A dev build's busiest: names and how much each did.
type Busy = { name: string, n: number, line: string }

--- What /suu perf reports, also saved to SuuUIProbe.perf.
export type Report = {
    at: string, seconds: number, total: number, modules: string[],
    allocated?: string[], allocatedKB?: number, allocatedAll?: string,
    memory?: string, memoryAtStart?: string, share?: string,
    dev?: { byCalls: string[], bySelf: string[], scripts?: string[], timers?: string[], events?: string[] },
}

export function report(): Report
    local _, spent = fault.timingState()
    local seconds = startedAt and math.max(1, GetTime() - startedAt) or 1
    local rows: Row[] = {}
    local total = 0
    for source, r in pairs(spent) do
        rows[#rows + 1] = { source = source, ms = r.ms, calls = r.calls, peak = r.peak, kb = r.kb or 0 }
        total = total + r.ms
    end
    table.sort(rows, function(a: Row, b: Row): boolean return a.ms > b.ms end)
    local out: Report = { at = date("%Y-%m-%d %H:%M:%S"), seconds = math.floor(seconds), total = total, modules = {} }
    print(("Perf over %d s: %.1f ms in all (%.2f ms a second)."):format(seconds, total, total / seconds))
    for i, r in ipairs(rows) do
        local line = ("%s: %.1f ms (%.3f ms/s), %d calls, slowest %.2f ms, %s allocated"):format(r.source, r.ms, r.ms / seconds,
            r.calls, r.peak, r.kb >= 1024 and ("%.1f MB"):format(r.kb / 1024) or ("%.0f KB"):format(r.kb))
        out.modules[i] = line
        if i <= TOP then print("  " .. line) end
    end
    if #rows > TOP then print(("  … %d more in SuuUIProbe.perf"):format(#rows - TOP)) end
    -- what allocates most: the garbage makers
    table.sort(rows, function(a: Row, b: Row): boolean return a.kb > b.kb end)
    local alloc: string[] = {}
    local allocKB = 0
    for i, r in ipairs(rows) do
        allocKB = allocKB + r.kb
        if i <= TOP and r.kb >= 1 then
            alloc[#alloc + 1] = ("%s %.0f KB (%.1f KB/s)"):format(r.source, r.kb, r.kb / seconds)
        end
    end
    out.allocated = alloc
    out.allocatedKB = math.floor(allocKB)
    print(("Allocated: %.1f MB (%.1f KB a second); most: %s"):format(allocKB / 1024, allocKB / seconds,
        table.concat(alloc, ", ", 1, math.min(5, #alloc))))
    if risenKB then
        local all = ("%.1f MB (%.1f KB a second), %d collections"):format(risenKB / 1024, risenKB / seconds, collections)
        out.allocatedAll = all
        print("Allocated by all of SuuUI (frame scripts too): " .. all)
    end
    local kb = memory()
    if kb then
        local now = ("%.1f MB"):format(kb / 1024)
        local atStart = startKB and ("%.1f MB"):format(startKB / 1024) or nil
        out.memory, out.memoryAtStart = now, atStart
        print("Memory (all of SuuUI): " .. now .. (atStart and (" (" .. atStart .. " at the start)") or ""))
    end
    local ms, pct = share()
    if ms then
        local frameShare = ("%.2f ms a frame, %.1f%% of the frame"):format(ms, pct)
        out.share = frameShare
        print("The game's profiler: " .. frameShare)
    end
    -- a dev build (wowlua dev): its profiler's busiest functions and its
    -- monitor's scripts and timers, where the frequent work (and so the
    -- garbage) is
    local wl = ns.__wowlua
    if wl and wl.prof and wl.prof.stats then
        -- the n busiest of a list, by the number each has
        local function top(list: Busy[], n: number): string[]
            table.sort(list, function(a: Busy, b: Busy): boolean return a.n > b.n end)
            local lines: string[] = {}
            for i = 1, math.min(n, #list) do lines[i] = list[i].line end
            return lines
        end
        local stats = wl.prof.stats
        local function functions(by: "calls" | "self", n: number): string[]
            local list: Busy[] = {}
            for name, st in pairs(stats) do
                list[#list + 1] = { name = name, n = st[by] or 0,
                    line = ("%s: %d calls, self %.1f ms, total %.1f ms%s"):format(name, st.calls or 0, st.self or 0, st.total or 0,
                        st.location and (" (" .. st.location .. ")") or "") }
            end
            return top(list, n)
        end
        local function hits(entries: { [string]: { count: number, total: number, max: number, detail: string } }?, n: number): string[]
            local list: Busy[] = {}
            for name, st in pairs(entries or {}) do
                list[#list + 1] = { name = name, n = st.count or 0,
                    line = ("%s: %d, %.1f ms%s"):format(name, st.count or 0, st.total or 0, st.detail and (" (" .. tostring(st.detail) .. ")") or "") }
            end
            return top(list, n)
        end
        local mon = wl.mon
        out.dev = {
            byCalls = functions("calls", 40),
            bySelf = functions("self", 25),
            scripts = mon and hits(mon.scripts, 25) or nil,
            timers = mon and hits(mon.timers, 15) or nil,
            events = mon and hits(mon.events, 25) or nil,
        }
        print("Dev build: the profiler's and monitor's busiest are in SuuUIProbe.perf.dev.")
    end
    DB.probe.perf = out
    return out
end

registerCommand("perf", "Time each SuuUI module: /suu perf starts, again shows the report, /suu perf stop ends it.", function(arg: string)
    local on = fault.timingState()
    if arg == "stop" then
        if on then report() end
        fault.setTiming(false)
        startedAt, startKB = nil, nil
        if sampler then sampler:Cancel(); sampler = nil end
        lastKB, risenKB = nil, nil
        print("Perf: stopped.")
        return
    end
    if not on then
        fault.setTiming(true)
        startedAt = GetTime()
        -- a dev build's profiler and monitor count from now too
        local wl = ns.__wowlua
        if wl and wl.prof and wl.prof.reset then pcall(wl.prof.reset) end
        if wl and wl.mon and wl.mon.reset then pcall(wl.mon.reset) end
        startKB = memory()
        lastKB, risenKB, collections = startKB, 0, 0
        if sampler then sampler:Cancel() end
        sampler = every(1, function()
            local now = memory()
            if not (now and lastKB) then return end
            if now >= lastKB then risenKB = (risenKB or 0) + (now - lastKB) else collections += 1 end
            lastKB = now
        end)
        print("Perf: measuring. Play a while (a fight, a city), then /suu perf for the report.")
        return
    end
    report()
end)
