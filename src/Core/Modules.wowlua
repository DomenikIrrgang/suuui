-- Core/Modules.wowlua
-- Every SuuUI feature is a module, built in or from a plugin addon, and every
-- module goes through this registry:
--
--   local M = SuuUI.RegisterModule({
--       id = "hello",                 -- lower case; also its settings namespace
--       name = "Hello",
--       description = "One line for the module list.",
--       api = "0.1",                  -- the oldest SuuUI API it works with
--       defaults = { greeting = "Hi" },
--       enabledByDefault = true,
--       reloadToToggle = false,       -- true for modules that replace protected frames
--       combatSafe = false,           -- true when it makes no secure or protected
--                                     -- frames: it starts at once after a reload
--                                     -- in combat instead of when the fight ends
--       OnInitialize = function(self) end,  -- once, before the first enable
--       OnEnable = function(self) end,
--       OnDisable = function(self) end,
--       Refresh = function(self) end,  -- any other field stays on the module
--                                      -- (0.47), unless it takes a name of
--                                      -- SuuUI's (a method, `id`…): an error
--   })
--   M:Migrate("renameFoo", function(values) ... end) -- once per profile, at file load
--
-- SuuUI's own modules are classes extending Module (a module file extends
-- /Core/API's, which adds nothing), added with SuuUI.AddModule(X.new()).
--
-- A module that is off is never initialised: no frames, no events. Its
-- "enabled" setting lives in its own namespace, so it is saved per profile.
-- Everything a module registers through its own methods belongs to it and
-- is taken away when it turns off (or fails): events and messages, setting
-- watchers and vetoes, chat commands, settings sections, movers, Each/Hook/
-- Override, services, menu and list entries, timers (M:After, M:Every; they
-- are cancelled), secure hooks (M:SecureHook, M:HookScript; disarmed, they do
-- nothing until armed again), work waiting for the end of combat
-- (M:RunOutOfCombat; dropped), CVars (M:SetCVar; the player's values given
-- back), addon message handlers (M:OnAddonMessage), and what it handed SuuUI
-- with itself as the owner (UI.SetVisibility, SuuUI.PublishAnchor). Register those in OnEnable. Turning a module on or off
-- waits for the end of combat. A module whose callback errors is marked
-- errored and turned off; SuuUI and the other modules keep running.
--
-- IsEnabled() (0.47) is true from just before OnEnable runs and false from
-- just before OnDisable runs, so the code both call reads the state being
-- reached. A module registered after login starts on the next frame, once
-- the file that registered it has run to its end (its callbacks assigned
-- after the RegisterModule call are there by then). A module that starts off
-- at login is released once, so CVars it set in an earlier session (a
-- reloadToToggle module turned off) are given back.
--
-- The registry is a ModuleRegistry: the settings it keeps "enabled" in,
-- what runs work out of combat and whether combat is on, what reports a
-- module's error, what hears a module's state change, and what takes away
-- everything a module registered all come in through its constructor, so
-- a test drives modules of its own. `registry` is SuuUI's; the module's
-- functions are its methods.

import onLogin from "wowlua:lifecycle"
import print, name as ADDON, registerCommand, unregisterCommands, CommandArgs from "./Init"
import * as events from "./Events"
import * as settings from "./Settings"
import * as fault from "./Fault"
import * as combat from "./Combat"
import * as extend from "./Extend"
import * as services from "./Services"
import * as themes from "./Themes"
import * as timers from "./Timers"
import * as hooks from "./Hooks"
import * as cvars from "./CVars"
import * as anchors from "./Anchors"
import * as comm from "./Comm"
import type Gate from "./Util"
import type SectionDef, Section from "/SettingsUI/Registry"
import type Mover, MoverOptions from "/EditMode/EditMode"
import * as tbl from "wowlua:table"

-- A settings section as a module registers it (SettingsUI/Registry).
export type SettingsSection = SectionDef

export const API_VERSION = "0.47.0"

-- Where a module is in its life.
export enum ModuleState {
    Registered = "registered", -- waiting for login
    Enabled = "enabled",
    Disabled = "disabled",
    Errored = "errored", -- a callback failed; turned off
    Incompatible = "incompatible", -- needs a newer SuuUI API
}

-- The settings a module's "enabled" lives in (SuuUI's SettingsStore).
export interface ModuleSettings
    function register(namespace: string, defs: { [string]: unknown }, layout: string[]?)
    function get(namespace: string, key: string): unknown
    function watch(
        namespace: string,
        key: string,
        @deferred fn: (value: unknown, namespace: string, key: string) -> (),
        owner: unknown
    )
end

-- What runs work now or after combat, keyed (SuuUI's CombatQueue).
export interface Runner
    function run(key: unknown, fn: () -> (), source: string?)
end

local RESERVED: { [string]: boolean } = { core = true, ui = true, layout = true }

-- A module's settings: their defaults' names and types (`defaults` given to
-- the module), so `M:Get(key)` reads the default's type.
export type Settings = { [string]: unknown }

-- A module's settings with SuuUI's own: whether it is on.
export type WithEnabled<D> = D & { enabled: boolean }

-- What a module is made from (see the top of this file).
export type ModuleDef<D> = {
    id: string,
    name?: string,
    description?: string,
    api?: string,
    defaults?: D,
    -- 0.46: the settings besides positions that belong to the screen size's
    -- layout (sizes, how a group is laid out): kept per screen size in each
    -- profile, as positions are
    layout?: string[],
    enabledByDefault?: boolean,
    reloadToToggle?: boolean,
    combatSafe?: boolean,
    replaces?: string,
    -- the addon it comes from (found from the call stack when not given)
    addon?: string,
}

--------------------------------------------------------------------------------
-- API versions
--------------------------------------------------------------------------------

local function parseVersion(v: unknown): (number?, number, number)
    local major, minor, patch = tostring(v):match("^(%d+)%.?(%d*)%.?(%d*)$")
    if not major then
        return nil, 0, 0
    end
    return tonumber(major), tonumber(minor) or 0, tonumber(patch) or 0
end

-- True when this SuuUI's API can serve a module written for `wanted`: the
-- same major version, and at least that minor and patch.
export function apiAtLeast(wanted: unknown): boolean
    local a, b, c = parseVersion(API_VERSION)
    local x, y, z = parseVersion(wanted)
    if not x then
        return false
    end
    if a ~= x then
        return false
    end
    if b ~= y then
        return b > y
    end
    return c >= z
end

--------------------------------------------------------------------------------
-- The module object
--------------------------------------------------------------------------------

-- The addon whose file made the module, from the call stack: the first
-- frame of another addon, else SuuUI itself. SuuUI's own frames are skipped
-- by addon, not by file, so this also holds when wowlua bundles SuuUI into
-- one file.
local function sourceAddon(): string
    local stack = debugstack(1, 12, 0) or ""
    local mine = false
    for addon in stack:gmatch("AddOns[/\\]([^/\\]+)[/\\]") do
        if addon ~= ADDON then
            return addon
        end
        mine = true
    end
    return mine and ADDON or "?"
end

-- SuuUI's own fields of a module: read through the module's properties,
-- set here only (Inspect once set self.id to a frame, and the settings
-- search broke far away, 2026-10-17).
type Own = {
    id: string,
    name: string,
    description?: string,
    api?: string,
    source: string,
    builtIn: boolean,
    state: ModuleState,
    -- on exactly while `state` is Enabled (setState keeps them together):
    -- what its hooks and timers read (Core/Hooks, Core/Timers)
    gate: Gate,
    error?: string,
    pendingReload?: boolean,
    enabledAtLoad?: boolean,
    initialized?: boolean,
    reloadToToggle: boolean,
    combatSafe: boolean,
    replaces?: string,
    replacedBy?: string,
    -- its settings' defaults, SuuUI's "enabled" included
    defaults: Settings,
    layout: string[]?,
}
local owns: { [table]: Own } = setmetatable({}, { __mode = "k" })

-- A module's own fields (a module keeps any name of its own on itself, so
-- the class takes none for this).
local function ownOf(m: table): Own
    return assert(owns[m])
end

-- A module's state, and its gate with it.
local function setState(m: table, state: ModuleState)
    local own = ownOf(m)
    own.state = state
    own.gate.on = state == ModuleState.Enabled
end

-- A module whatever its settings: what the registry, the settings window
-- and plugins handle.
export interface AnyModule
    readonly id: string
    readonly name: string
    readonly description: string?
    readonly api: string?
    readonly source: string
    readonly builtIn: boolean
    readonly state: ModuleState
    readonly error: string?
    readonly pendingReload: boolean?
    readonly enabledAtLoad: boolean?
    readonly initialized: boolean?
    readonly reloadToToggle: boolean
    readonly combatSafe: boolean
    readonly replaces: string?
    readonly replacedBy: string?
    function OnInitialize()
    function OnEnable()
    function OnDisable()
    function IsEnabled(): boolean
    -- one of its settings, from another module: what it is is that
    -- module's business (it may be replaced, or off), so the reader checks
    function Setting(key: string): unknown
end

-- (SET-7) The layers above the core: the settings window and edit mode take
-- a module's sections and movers, and they (and UI/Visibility) let go of
-- what a module gave them when it turns off. Each hands its part over as
-- it loads (SettingsUI/Registry, EditMode/EditMode, UI/Visibility): the
-- core imports none of them.
export type SectionHost = (def: SettingsSection, owner: AnyModule) -> Section
export type MoverHost = (frame: Region, opts: MoverOptions, owner: AnyModule) -> Mover
local hosts: { sections: SectionHost?, movers: MoverHost? } = {}
local releasers: ((m: AnyModule) -> ())[] = {}

-- Where M:RegisterSettings and M:RegisterMover go.
export function hostSections(fn: SectionHost)
    hosts.sections = fn
end
export function hostMovers(fn: MoverHost)
    hosts.movers = fn
end
-- fn(module) when a module is released (turned off, failed, or off at
-- login), with the core's own releases.
export function onRelease(fn: (m: AnyModule) -> ())
    releasers[#releasers + 1] = fn
end

-- What a module may add to a role's preset, and a notification kind.
export type NotificationKind = { [string]: unknown }

--- A SuuUI module: SuuUI's own fields (read only), its settings typed by
--- its defaults (`D`), and what it registers, which goes when it turns off.
--- Built-in modules extend it; a plugin's is a PluginModule.
export class Module<D extends Settings> implements AnyModule
    constructor(def: ModuleDef<D>)
        assert(type(def) == "table", "SuuUI.RegisterModule takes a table")
        local id = def.id
        assert(
            type(id) == "string" and id:find("^%l[%l%d_]*$"),
            "SuuUI.RegisterModule: id must be lower case letters, digits and _, starting with a letter"
        )
        local given: Settings = def.defaults or {}
        local defaults: Settings = tbl.copy(given)
        assert(
            defaults.enabled == nil,
            "SuuUI.RegisterModule: \"enabled\" is SuuUI's own setting; use enabledByDefault"
        )
        assert(
            def.replaces == nil or (type(def.replaces) == "string" and def.replaces ~= id),
            "SuuUI.RegisterModule: replaces names another module's id"
        )
        defaults.enabled = def.enabledByDefault ~= false
        local source = def.addon or sourceAddon()
        owns[self] = {
            id = id,
            name = def.name or id,
            description = def.description,
            api = def.api,
            reloadToToggle = def.reloadToToggle and true or false,
            combatSafe = def.combatSafe and true or false,
            source = source,
            builtIn = source == ADDON,
            state = ModuleState.Registered,
            gate = { on = false },
            replaces = def.replaces,
            defaults = defaults,
            layout = def.layout,
        }
    end

    get id(): string
        return ownOf(self).id
    end
    get name(): string
        return ownOf(self).name
    end
    get description(): string?
        return ownOf(self).description
    end
    get api(): string?
        return ownOf(self).api
    end
    get source(): string
        return ownOf(self).source
    end
    get builtIn(): boolean
        return ownOf(self).builtIn
    end
    get state(): ModuleState
        return ownOf(self).state
    end
    get error(): string?
        return ownOf(self).error
    end
    get pendingReload(): boolean?
        return ownOf(self).pendingReload
    end
    get enabledAtLoad(): boolean?
        return ownOf(self).enabledAtLoad
    end
    get initialized(): boolean?
        return ownOf(self).initialized
    end
    get reloadToToggle(): boolean
        return ownOf(self).reloadToToggle
    end
    get combatSafe(): boolean
        return ownOf(self).combatSafe
    end
    get replaces(): string?
        return ownOf(self).replaces
    end
    get replacedBy(): string?
        return ownOf(self).replacedBy
    end

    -- Its life: once before the first enable, then each time it turns on or
    -- off (a module overrides what it needs).
    function OnInitialize() end
    function OnEnable() end
    function OnDisable() end

    -- Its settings (the defaults' keys and types, and "enabled"). (Get,
    -- Peek and IsEnabled read the module's own fields directly, not through
    -- its properties: they run all the time, and a property is a call more.)
    function Get<K extends keyof WithEnabled<D>>(key: K): WithEnabled<D>[K]
        return settings.get(ownOf(self).id, key) :: WithEnabled<D>[K]
    end
    -- 0.17: the value itself, not a copy, to read only (large tables read often)
    function Peek<K extends keyof WithEnabled<D>>(key: K): WithEnabled<D>[K]
        return settings.peek(ownOf(self).id, key) :: WithEnabled<D>[K]
    end
    function Set<K extends keyof WithEnabled<D>>(key: K, value: WithEnabled<D>[K]): (boolean, string?)
        return settings.set(self.id, key, value)
    end
    -- one key, or the whole namespace
    function Reset<K extends keyof WithEnabled<D>>(key: K?): boolean
        return settings.reset(self.id, key)
    end
    function Watch<K extends keyof WithEnabled<D>>(
        key: K,
        fn: (value: WithEnabled<D>[K], namespace: string, key: string) -> ()
    )
        settings.watch(self.id, key, fn :: settings.Watcher, self)
    end
    function Veto<K extends keyof WithEnabled<D>>(
        key: K,
        fn: (new: WithEnabled<D>[K], old: WithEnabled<D>[K]) -> (boolean?, string?)
    )
        settings.veto(self.id, key, fn :: settings.Veto, self)
    end
    -- 0.19: fn(key) whenever one of `keys` changes; each of `keys` reset
    function WatchAll<K extends keyof WithEnabled<D>>(keys: K[], fn: (key: K) -> ())
        for _, key in ipairs(keys) do
            settings.watch(
                self.id,
                key,
                function()
                    fn(key)
                end,
                self
            )
        end
    end
    function ResetAll<K extends keyof WithEnabled<D>>(keys: K[])
        for _, key in ipairs(keys) do
            settings.reset(self.id, key)
        end
    end
    -- fn(values) reshapes one profile's stored values of this module (a
    -- renamed key, a changed type), once per profile. Call it right after
    -- the module is made, at file load, so it runs before the old values
    -- are judged by type. (0.32: fn(values, profile), the whole profile too)
    function Migrate(id: string, fn: settings.MigrationFn)
        settings.migrate(self.id, id, fn, self)
    end

    -- 0.11: the module's own data for this character (a table it fills;
    -- saved, never part of a profile)
    function CharData(): { [string]: unknown }
        return settings.charData(self.id)
    end
    function AllCharData(): { [string]: { [string]: unknown } }
        return settings.allCharData(self.id)
    end
    function CharKey(): string?
        return settings.getCharKey()
    end
    function ForgetCharData(key: string): boolean
        return settings.forgetCharData(self.id, key)
    end

    -- fn wrapped so an error in it is reported (SuuUIDB.errors, /suu errors)
    -- under the module's name, as errors in its events are: for UI callbacks.
    function Guard<A..., R...>(fn: (A...) -> R...): (A...) -> (boolean, R...)
        return function(...: A...): (boolean, R...)
            return fault.call(self.name, fn, ...)
        end
    end

    -- A message: SuuUI's (Core/Messages.d.wowlua: the listener's arguments
    -- are checked) or a plugin's own (any name; its values unchecked).
    function On<M extends string>(message: M, fn: (name: M, EventArgs<M>...) -> ())
        events.bus:listen(message, fn :: events.Listener, self)
    end
    function Off(message: string)
        events.off(message, self)
    end
    function Emit<M extends string>(message: M, ...: EventArgs<M>...)
        events.bus:send(message, ...)
    end
    function OnGameEvent<E extends EventName>(event: E, fn: (name: E, EventArgs<E>...) -> ())
        events.onGame(event, fn, self)
    end
    function OnUnitEvent<E extends EventName>(
        event: E,
        units: UnitToken | UnitToken[],
        fn: (name: E, EventArgs<E>...) -> ()
    )
        events.onUnit(event, units, fn, self)
    end

    -- Keys get an "m:" prefix so a module's never collide with the core's own.
    -- (0.47: work still waiting when the module turns off is dropped)
    function RunOutOfCombat(key: string | number, fn: () -> ())
        combat.run("m:" .. self.id .. ":" .. tostring(key), fn, self.name)
    end

    -- 0.47: timers the module owns (Core/Timers.wowlua): fn runs under the
    -- module's name in Fault; every one is cancelled when the module turns
    -- off. The handle's Cancel() stops one sooner. Every: fn(ticker) each
    -- `seconds`, `times` times or until cancelled. Asked for while the
    -- module is not enabled (from a hook or callback that outlives it, or
    -- from OnDisable), a timer never starts: the handle is already
    -- cancelled. A timer that must outlive the module uses wowlua:timer.
    function After(seconds: number, fn: () -> ()): TimerHandle
        local own = ownOf(self)
        return timers.after(self, own.name, own.gate, seconds, fn)
    end
    function Every(seconds: number, fn: (ticker: TickerHandle) -> (), times: number?): TickerHandle
        local own = ownOf(self)
        return timers.every(self, own.name, own.gate, seconds, fn, times)
    end

    -- 0.47: secure post-hooks the module owns (Core/Hooks.wowlua), on a
    -- global function (`SecureHook("Name", fn)`) or a table's method
    -- (`SecureHook(table or "GlobalTable", "Method", fn, { addon = "..." })`),
    -- or on a frame's script. One per module and target for the session: a
    -- second call (the module on again) re-arms it with the new function;
    -- while the module is not enabled the hook does nothing.
    function SecureHook(target: unknown, method: string | function, fn: function?, opts: hooks.HookOptions?)
        local own = ownOf(self)
        if type(method) == "function" then
            hooks.secureHook(self, own.name, own.gate, target, nil, method, nil)
            return
        end
        assert(type(method) == "string" and type(fn) == "function", "SecureHook: (name, fn) or (target, method, fn, opts)")
        hooks.secureHook(self, own.name, own.gate, target, method, fn, opts)
    end
    function HookScript(frame: ScriptRegion | string, script: string, fn: function)
        local own = ownOf(self)
        hooks.hookScript(self, own.name, own.gate, frame, script, fn)
    end

    -- 0.47: a game CVar the module changes (Core/CVars.wowlua). The first
    -- SetCVar of a name remembers the player's value for this character
    -- (not per profile); RestoreCVar gives it back and forgets it, and so
    -- does turning the module off, for every CVar it set. In combat the
    -- write waits for its end. True when written now.
    -- `opts.seedDefault`: SuuUI's own modules that set this CVar before 0.47
    -- without remembering the player's value; on a character that played
    -- with SuuUI before, the game's default stands in for it once (see
    -- Core/CVars.wowlua).
    function SetCVar(cvarName: string, value: string | number | boolean, opts: cvars.SetOptions?): boolean
        return cvars.set(self.id, cvarName, value, opts)
    end
    function RestoreCVar(cvarName: string): boolean
        return cvars.restore(self.id, cvarName)
    end

    -- 0.47: SuuUI's addon messages (prefix "SuuUI", Core/Comm.wowlua):
    -- fn(payload, sender, channel) for messages "verb" or "verb\t<payload>"
    -- from other players that pass `opts`' checks (channels, rank, rate,
    -- replyEvery, maxLength); gone when the module turns off. Send: "verb"
    -- (payload nil) or "verb\t<payload>" on a channel; true when the game
    -- took it, else false and why.
    function OnAddonMessage(verb: string, opts: comm.VerbOptions?, fn: comm.Handler)
        comm.on(self, verb, opts, fn)
    end
    function SendAddonMessage(
        verb: string,
        payload: string?,
        channel: string?,
        target: string?,
        opts: comm.SendOptions?
    ): (boolean, string, boolean)
        return comm.send(self, verb, payload, channel, target, opts)
    end

    function RegisterCommand(cmd: string, help: string, fn: (rest: string) -> (), args: CommandArgs?)
        registerCommand(cmd, help, fn, self, args)
    end

    -- A settings section for this module: its rows read and write the
    -- module's own namespace, and the section goes away when the module
    -- turns off.
    function RegisterSettings(def: SettingsSection): Section
        def.namespace = def.namespace or self.id
        return assert(hosts.sections, "SuuUI: no settings window")(def, self)
    end

    -- An edit-mode handle for one of the module's frames. opts.key names a
    -- position setting in the module's defaults (default "position").
    function RegisterMover(frame: Region, opts: MoverOptions?): Mover
        local o: MoverOptions = opts or {}
        o.namespace = self.id
        o.label = o.label or self.name
        return assert(hosts.movers, "SuuUI: no edit mode")(frame, o, self)
    end

    -- 0.17: SuuUI's own UI (Core/Extend.wowlua). fn(object, info) for every
    -- instance of a kind, now and later (undo(object, info) for each when
    -- the module turns off); fn(object, ...) after a method; fn(object,
    -- original, ...) instead of one. All removed when the module turns off.
    function Each<K extends extend.Kinds>(
        kind: K,
        fn: (obj: extend.KindInstances[K], info: extend.Info) -> (),
        undo: ((obj: extend.KindInstances[K], info: extend.Info) -> ())?
    )
        extend.eachOf(kind, fn, undo, self)
    end
    function Hook<K extends extend.Kinds>(
        kind: K,
        method: string,
        fn: (this: extend.KindInstances[K], ...unknown) -> ()
    )
        extend.hookOf(kind, method, fn, self)
    end
    function Override<K extends extend.Kinds>(
        kind: K,
        method: string,
        fn: (this: extend.KindInstances[K], original: extend.Method, ...unknown) -> ...unknown
    )
        extend.overrideOf(kind, method, fn, self)
    end

    -- 0.17: a service other modules reach by name (Core/Services.wowlua);
    -- gone when the module turns off.
    -- (by name: a plugin's own service, a table of functions)
    function Provide(serviceName: string, impl: { [string]: unknown })
        services.provide(serviceName, impl, self)
    end
    -- 0.19: a built-in service by its key (Core/ServiceKeys), typed
    function ProvideService<T>(key: services.ServiceKey<T>, impl: T)
        services.provide(key.name, impl, self)
    end

    -- 0.17: entries in SuuUI's own menus and lists (Core/Extend.wowlua):
    -- before one of SuuUI's right-click menus opens, fn(menu, context); a
    -- micro menu button; a game menu entry; a game popup shown as a
    -- notification card; this module's own settings in a role's preset.
    -- Gone when it turns off. (The micro menu and the game menu check the
    -- items they get.)
    function ExtendMenu(id: string, fn: extend.MenuExtension)
        extend.extendMenu(id, fn, self)
    end
    function AddMicroItem(item: unknown)
        extend.addTo(extend.List.MicroMenu, item, self)
    end
    function AddGameMenuItem(item: unknown)
        extend.addTo(extend.List.GameMenu, item, self)
    end
    function AddNotificationKind(which: string, def: NotificationKind?)
        local d: NotificationKind = def or {}
        d.which = which
        extend.addTo(extend.List.NotificationKinds, d, self)
    end
    function AddToRolePreset(role: string, values: { [string]: unknown })
        local preset: extend.RolePreset = { role = role, namespace = self.id, values = values }
        extend.addTo(extend.List.RolePresets, preset, self)
    end

    function Print(...: unknown)
        print("|cffa39b8b" .. self.name .. ":|r", ...)
    end

    -- 0.47: true while OnEnable runs, false while OnDisable runs (the state
    -- changes just before each)
    function IsEnabled(): boolean
        return ownOf(self).state == ModuleState.Enabled
    end

    function Setting(key: string): unknown
        return settings.get(self.id, key)
    end
end

-- What a plugin's module is made from: a module's definition and its
-- callbacks (see the top of this file). Any other field it has is kept on
-- the module (a function the plugin calls as a method, a value of its own),
-- as long as it doesn't take one of SuuUI's names (API-5, below).
-- (ModuleDef's fields written out: the checker reads `D` from `defaults` in
-- one table type, not through an intersection)
export type PluginDef<D extends Settings> = {
    id: string,
    name?: string,
    description?: string,
    api?: string,
    defaults?: D,
    layout?: string[],
    enabledByDefault?: boolean,
    reloadToToggle?: boolean,
    combatSafe?: boolean,
    replaces?: string,
    addon?: string,
    OnInitialize?: (self: RegisteredModule<D>) -> (),
    OnEnable?: (self: RegisteredModule<D>) -> (),
    OnDisable?: (self: RegisteredModule<D>) -> (),
}

-- What SuuUI.RegisterModule returns: the plugin's module, its settings typed
-- by its defaults, and whatever the plugin keeps on it (loose: its own).
export type RegisteredModule<D extends Settings> = PluginModule<D> & { [string]: unknown }

-- The keys of a module's definition that are SuuUI's (the rest of a
-- plugin's definition is kept on its module).
local DEF_KEYS: { [string]: boolean } = {
    id = true,
    name = true,
    description = true,
    api = true,
    defaults = true,
    layout = true,
    enabledByDefault = true,
    reloadToToggle = true,
    combatSafe = true,
    replaces = true,
    addon = true,
}
local CALLBACKS: { [string]: boolean } = { OnInitialize = true, OnEnable = true, OnDisable = true }

-- (API-5) Why a module may not hold `key` as a field of its own, or nil: a
-- method of every module (Get, Hook, IsEnabled…) or one of SuuUI's own fields
-- (id, state…) would be hidden from the core and the other modules, which
-- call and read them on it. The three callbacks are the module's to set.
local function takenName(key: unknown, value: unknown): string?
    if type(key) ~= "string" then
        return nil
    end
    if CALLBACKS[key] then
        return type(value) ~= "function" and "a callback (a function)" or nil
    end
    local class = Module :: unknown :: { [string]: unknown }
    local getters = rawget(class, "__getters") :: { [string]: unknown }?
    if getters and getters[key] then
        return "one of SuuUI's own fields of a module"
    end
    if class[key] ~= nil then
        return "a method every module has"
    end
    return nil
end

local function refuse(id: string, key: string, why: string, level: number)
    error(
        ("SuuUI: the module %s can't have a field %q: it is %s (use another name)"):format(id, key, why),
        level
    )
end

-- A plugin's module (SuuUI.RegisterModule): its callbacks and the rest of
-- its definition come with the definition, and it keeps what it likes on
-- itself, except SuuUI's names.
export class PluginModule<D extends Settings> extends Module<D>
    constructor(def: PluginDef<D>)
        super(def)
        local id = def.id
        for key, value in pairs(def :: unknown :: { [string]: unknown }) do
            if not DEF_KEYS[key] then
                local why = takenName(key, value)
                if why then
                    refuse(id, key, why, 4)
                end
                -- the instance's own, in front of the class's (the callbacks:
                -- in front of the class's empty ones)
                rawset(self, key, value)
            end
        end
    end
end

-- A plugin's module's fields set after RegisterModule (`function M:OnEnable()`,
-- `M.frame = …`) are checked the same way as it sets each new one (API-5).
-- The class's own __newindex (its read-only properties) still runs after.
do
    local class = PluginModule :: unknown :: { __newindex: (t: table, k: unknown, v: unknown) -> () }
    local base = class.__newindex
    rawset(class :: unknown :: table, "__newindex", function(t: table, k: unknown, v: unknown)
        local why = takenName(k, v)
        if why then
            local own = owns[t]
            refuse(own and own.id or "?", tostring(k), why, 3)
        end
        base(t, k, v)
    end)
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

-- Everything a module registered through its own methods, taken away.
local function releaseAll(m: AnyModule)
    events.offAll(m)
    settings.unwatch(m)
    unregisterCommands(m)
    -- the settings window's sections, edit mode's movers, the visibility
    -- modes (SET-7: what the layers above handed over)
    for _, release in ipairs(releasers) do
        release(m)
    end
    extend.unregister(m)
    services.unregister(m)
    timers.cancelAll(m)
    hooks.release(m)
    combat.cancel("m:" .. m.id .. ":")
    anchors.release(m)
    cvars.restoreAll(m.id)
    comm.release(m)
end

export class ModuleRegistry
    private modules: AnyModule[] = {}
    private byId: { [string]: AnyModule } = {}
    private started: boolean = false

    constructor(
        private store: ModuleSettings = settings.store,
        private runner: Runner = combat.queue,
        private lockdown: combat.CombatState = combat.GameCombat.new(),
        private reporter: fault.Reporter = fault.log,
        private notifier: events.Notifier = events.bus,
        private release: (m: AnyModule) -> () = releaseAll,
        -- what starts a module registered after login: the next frame
        private later: extend.NextFrame = extend.GameNextFrame.new()
    )
    end

    private function fail(m: AnyModule, phase: string)
        setState(m :: table, ModuleState.Errored)
        ownOf(m :: table).error = phase .. " failed"
        -- Undo what a failed OnEnable got as far as building (frames shown,
        -- anchors published). The reporter reports an error here and
        -- carries on.
        if phase == "OnEnable" then
            self.reporter:call(m.name, function()
                m:OnDisable()
            end)
        end
        self.release(m)
        self.notifier:emit("SUUUI_MODULE_ERRORED", m.id)
    end

    private function enable(m: AnyModule)
        if m.state == ModuleState.Enabled or m.state == ModuleState.Incompatible then
            return
        end
        if not m.initialized then
            if not self.reporter:call(m.name, function()
                m:OnInitialize()
            end) then
                return self:fail(m, "OnInitialize")
            end
            ownOf(m :: table).initialized = true
        end
        -- on before OnEnable runs, so what it calls reads the state it is
        -- bringing about (0.47)
        setState(m :: table, ModuleState.Enabled)
        ownOf(m :: table).error = nil
        if not self.reporter:call(m.name, function()
            m:OnEnable()
        end) then
            return self:fail(m, "OnEnable")
        end
        self.notifier:emit("SUUUI_MODULE_ENABLED", m.id)
    end

    private function disable(m: AnyModule)
        if m.state ~= ModuleState.Enabled then
            if m.state ~= ModuleState.Incompatible then
                setState(m :: table, ModuleState.Disabled)
            end
            return
        end
        -- off before OnDisable runs (0.47), as on before OnEnable
        setState(m :: table, ModuleState.Disabled)
        self.reporter:call(m.name, function()
            m:OnDisable()
        end)
        self.release(m)
        self.notifier:emit("SUUUI_MODULE_DISABLED", m.id)
    end

    -- Brings the module in line with its "enabled" setting.
    function sync(m: AnyModule)
        if m.state == ModuleState.Incompatible or m.replacedBy then
            return
        end
        local want = self.store:get(m.id, "enabled")
        if m.reloadToToggle then
            -- an errored module that is still on retries at the next load
            ownOf(m :: table).pendingReload = (want ~= m.enabledAtLoad or (want and m.state == ModuleState.Errored)) or
                nil
            return
        end
        self.runner:run(
            "module:" .. m.id,
            function()
                if self.store:get(m.id, "enabled") then
                    self:enable(m)
                else
                    self:disable(m)
                end
            end,
            m.name
        )
    end

    -- The module standing in for `m` this session (0.17: `replaces`): one
    -- that is on and can load. Decided at login, so a change takes a reload.
    private function replacer(m: AnyModule): AnyModule?
        for _, o in ipairs(self.modules) do
            if o.replaces == m.id and o ~= m and o.state ~= ModuleState.Incompatible and
                self.store:get(o.id, "enabled") then
                return o
            end
        end
        return nil
    end

    private function start(m: AnyModule)
        local by = self:replacer(m)
        if by then
            ownOf(m :: table).replacedBy = by.name
            ownOf(m :: table).enabledAtLoad = false
            setState(m :: table, ModuleState.Disabled)
            self.store:watch(m.id, "enabled", function() end, "Modules")
            self.release(m)
            return
        end
        ownOf(m :: table).enabledAtLoad = self.store:get(m.id, "enabled") and true or false
        self.store:watch(
            m.id,
            "enabled",
            function()
                self:sync(m)
            end,
            "Modules"
        )
        if m.state == ModuleState.Incompatible then
            self.release(m)
            return
        end
        if m.enabledAtLoad then
            -- after a reload in combat a module waits for the fight's end,
            -- unless it makes no secure frames (found in game: buffs and the
            -- Cooldown Manager were missing until the fight ended)
            if m.combatSafe and self.lockdown:inCombat() then
                self.reporter:call(m.name, function()
                    self:enable(m)
                end)
            else
                self.runner:run(
                    "module:" .. m.id,
                    function()
                        self:enable(m)
                    end,
                    m.name
                )
            end
        else
            setState(m :: table, ModuleState.Disabled)
            -- off at login: what an earlier session left (a CVar a
            -- reloadToToggle module set before it was turned off) goes now
            self.release(m)
        end
    end

    -- Login: every module registered so far starts, and each one registered
    -- later starts as it comes.
    function startAll()
        self.started = true
        for _, m in ipairs(self.modules) do
            self:start(m)
        end
    end

    ----------------------------------------------------------------------------
    -- Registration
    ----------------------------------------------------------------------------

    -- A module made (a built-in one's class, or a plugin's PluginModule):
    -- its settings registered. After login it starts on the next frame
    -- (0.47), once the file that registered it has run to its end: a
    -- plugin that assigns `function M:OnEnable()` after RegisterModule (as
    -- the plugin guide does) has its callbacks in place by then.
    function add<M extends AnyModule>(m: M): M
        local id = m.id
        assert(not self.byId[id] and not RESERVED[id], "SuuUI.RegisterModule: the id " .. id .. " is taken")
        -- (API-5) what it set on itself so far (a class's field initializers,
        -- a plugin's definition) takes none of SuuUI's names
        for key, value in pairs(m :: unknown :: { [string]: unknown }) do
            local why = takenName(key, value)
            if why then
                refuse(id, key, why, 3)
            end
        end
        self.store:register(id, ownOf(m :: table).defaults, ownOf(m :: table).layout)
        local api = m.api
        if api and not apiAtLeast(api) then
            setState(m :: table, ModuleState.Incompatible)
            ownOf(m :: table).error = ("needs SuuUI API %s; this SuuUI has %s"):format(tostring(api), API_VERSION)
            print(("%s (%s) can't load: it %s."):format(m.name, m.source, tostring(m.error)))
        end
        self.modules[#self.modules + 1] = m
        self.byId[id] = m
        self.notifier:emit("SUUUI_MODULE_REGISTERED", id)
        if self.started then
            self.later:run(function()
                self:start(m)
            end)
        end
        return m
    end

    -- A plugin's module (SuuUI.RegisterModule).
    function register<D extends Settings>(def: PluginDef<D>): RegisteredModule<D>
        local m = self:add(PluginModule.new(def))
        return (m :: unknown) :: RegisteredModule<D>
    end

    function get(id: string): AnyModule?
        return self.byId[id]
    end

    function all(): AnyModule[]
        return self.modules
    end

    -- The module `text` names: its id or name, in any letter case.
    function find(text: string?): AnyModule?
        local wanted = strtrim(text or ""):lower()
        for _, m in ipairs(self.modules) do
            if m.id == wanted or m.name:lower() == wanted then
                return m
            end
        end
        return nil
    end
end

-- SuuUI's registry, and its methods as the module's functions.
export const registry = ModuleRegistry.new()

export function add<M extends AnyModule>(m: M): M
    return registry:add(m)
end
export function register<D extends Settings>(def: PluginDef<D>): RegisteredModule<D>
    return registry:register(def)
end
export function get(id: string): AnyModule?
    return registry:get(id)
end
export function all(): AnyModule[]
    return registry:all()
end
export function find(text: string?): AnyModule?
    return registry:find(text)
end

@onLogin
local function startAll()
    -- the chosen theme first: plugins' themes are registered by now, and no
    -- module has built a frame yet
    fault.call("Themes", themes.apply)
    -- (0.47) an upgrading character or a fresh one, decided once, before any
    -- module sets a CVar (Core/CVars.wowlua)
    fault.call("CVars", cvars.noteCharacter)
    registry:startAll()
end

--------------------------------------------------------------------------------
-- Chat commands
--------------------------------------------------------------------------------

local STATE_TEXT: { [ModuleState]: string } = {
    [ModuleState.Enabled] = "|cff3fd0ffon|r",
    [ModuleState.Disabled] = "|cffa39b8boff|r",
    [ModuleState.Errored] = "|cffff9a80errored|r",
    [ModuleState.Incompatible] = "|cffff9a80incompatible|r",
    [ModuleState.Registered] = "|cffa39b8bwaiting for login|r",
}

local function describe(m: AnyModule): string
    local state = STATE_TEXT[m.state] or m.state
    if m.replacedBy then
        state = "|cffa39b8breplaced by " .. m.replacedBy .. "|r"
    end
    if m.pendingReload then
        local retry = m.state == ModuleState.Errored and settings.get(m.id, "enabled")
        local afterReload = (retry and "retries") or (m.enabledAtLoad and "off") or "on"
        state = state .. (" |cffffb23f(%s after /reload)|r"):format(afterReload)
    end
    local line = ("  %s  %s  %s  - %s"):format(m.id, m.name, state, m.builtIn and "built in" or m.source)
    if m.error then
        line = line .. "  (" .. m.error .. ")"
    end
    return line
end

registerCommand("modules", "List every module, built in and from plugins, with its state.", function()
    local list = registry:all()
    print(("%d modules, API %s:"):format(#list, API_VERSION))
    for _, m in ipairs(list) do
        _G.print(describe(m))
    end
end)

local function toggle(arg: string, on: boolean)
    local m = registry:find(arg)
    if not m then
        return print(("No module called \"%s\". /suu modules lists them."):format(arg))
    end
    if m.state == ModuleState.Incompatible then
        return print(m.name .. " " .. tostring(m.error) .. ".")
    end
    if on and m.state == ModuleState.Errored then
        -- Turning an errored module on again is a retry; one that replaces
        -- protected frames can only retry from a fresh load.
        if m.reloadToToggle then
            settings.set(m.id, "enabled", true)
            ownOf(m :: table).pendingReload = true
            print(("%s tries again after a /reload."):format(m.name))
            return _G.print(describe(m))
        end
        setState(m :: table, ModuleState.Disabled)
        if settings.get(m.id, "enabled") then
            registry:sync(m)
        end
    end
    settings.set(m.id, "enabled", on)
    if m.reloadToToggle and m.pendingReload then
        print(("%s turns %s after a /reload."):format(m.name, on and "on" or "off"))
    elseif InCombatLockdown() then
        print(("%s turns %s when combat ends."):format(m.name, on and "on" or "off"))
    end
    _G.print(describe(m))
end

registerCommand("enable", "Turn a module on: /suu enable <id>", function(arg: string)
    toggle(arg, true)
end)
registerCommand("disable", "Turn a module off: /suu disable <id>", function(arg: string)
    toggle(arg, false)
end)
