-- Core/Modules.wowlua
-- Every SuuUI feature is a module, built in or from a plugin addon, and every
-- module goes through this registry:
--
--   local M = SuuUI.RegisterModule({
--       id = "hello",                 -- lower case; also its settings namespace
--       name = "Hello",
--       description = "One line for the module list.",
--       api = "0.1",                  -- the oldest SuuUI API it works with
--       defaults = { greeting = "Hi" },
--       enabledByDefault = true,
--       reloadToToggle = false,       -- true for modules that replace protected frames
--       combatSafe = false,           -- true when it makes no secure or protected
--                                     -- frames: it starts at once after a reload
--                                     -- in combat instead of when the fight ends
--       OnInitialize = function(self) end,  -- once, before the first enable
--       OnEnable = function(self) end,
--       OnDisable = function(self) end,
--   })
--   M:Migrate("renameFoo", function(values) ... end) -- once per profile, at file load
--
-- A module that is off is never initialised: no frames, no events. Its
-- "enabled" setting lives in its own namespace, so it is saved per profile.
-- Everything a module registers through its own methods (events, setting
-- watchers, chat commands) belongs to it and is removed when it turns off;
-- register those in OnEnable. Turning a module on or off waits for the end
-- of combat. A module whose callback errors is marked errored and turned off;
-- SuuUI and the other modules keep running.
--
-- The registry is a ModuleRegistry: the settings it keeps "enabled" in,
-- what runs work out of combat and whether combat is on, what reports a
-- module's error, what hears a module's state change, and what takes away
-- everything a module registered all come in through its constructor, so
-- a test drives modules of its own. `registry` is SuuUI's; the module's
-- functions are its methods.

import onLogin from "wowlua:lifecycle"
import print, name as ADDON, registerCommand, unregisterCommands, CommandArgs from "./Init"
import * as events from "./Events"
import * as settings from "./Settings"
import * as fault from "./Fault"
import * as combat from "./Combat"
import * as util from "./Util"
import * as extend from "./Extend"
import * as services from "./Services"
import * as themes from "./Themes"
import * as settingsRegistry from "/SettingsUI/Registry"
import * as editMode from "/EditMode/EditMode"

export const API_VERSION = "0.19.0"

-- Where a module is in its life.
export enum ModuleState {
    Registered = "registered",       -- waiting for login
    Enabled = "enabled",
    Disabled = "disabled",
    Errored = "errored",             -- a callback failed; turned off
    Incompatible = "incompatible",   -- needs a newer SuuUI API
}

-- The settings a module's "enabled" lives in (SuuUI's SettingsStore).
export interface ModuleSettings
    function register(namespace: string, defs: { [string]: any })
    function get(namespace: string, key: string): any
    function watch(namespace: string, key: string, @deferred fn: (value: any, namespace: string, key: string) -> (), owner: unknown)
end

-- What runs work now or after combat, keyed (SuuUI's CombatQueue).
export interface Runner
    function run(key: any, fn: () -> (), source: string?)
end

local RESERVED: { [string]: boolean } = { core = true, ui = true, layout = true }

-- A module's settings: their defaults' names and types (`defaults` given to
-- the module), so `M:Get(key)` reads the default's type.
export type Settings = { [string]: unknown }

-- A module's settings with SuuUI's own: whether it is on.
export type WithEnabled<D> = D & { enabled: boolean }

-- What a module is made from (see the top of this file).
export type ModuleDef<D> = {
    id: string,
    name?: string,
    description?: string,
    api?: string,
    defaults?: D,
    enabledByDefault?: boolean,
    reloadToToggle?: boolean,
    combatSafe?: boolean,
    replaces?: string,
    -- the addon it comes from (found from the call stack when not given)
    addon?: string,
}

--------------------------------------------------------------------------------
-- API versions
--------------------------------------------------------------------------------

local function parseVersion(v: unknown): (number?, number, number)
    local major, minor, patch = tostring(v):match("^(%d+)%.?(%d*)%.?(%d*)$")
    if not major then return nil, 0, 0 end
    return tonumber(major), tonumber(minor) or 0, tonumber(patch) or 0
end

-- True when this SuuUI's API can serve a module written for `wanted`: the
-- same major version, and at least that minor and patch.
export function apiAtLeast(wanted: unknown): boolean
    local a, b, c = parseVersion(API_VERSION)
    local x, y, z = parseVersion(wanted)
    if not x then return false end
    if a ~= x then return false end
    if b ~= y then return b > y end
    return c >= z
end

--------------------------------------------------------------------------------
-- The module object
--------------------------------------------------------------------------------

-- The addon whose file made the module, from the call stack: the first
-- frame of another addon, else SuuUI itself. SuuUI's own frames are skipped
-- by addon, not by file, so this also holds when wowlua bundles SuuUI into
-- one file.
local function sourceAddon(): string
    local stack = debugstack(1, 12, 0) or ""
    local mine = false
    for addon in stack:gmatch("AddOns[/\\]([^/\\]+)[/\\]") do
        if addon ~= ADDON then return addon end
        mine = true
    end
    return mine and ADDON or "?"
end

-- SuuUI's own fields of a module: read through the module's properties,
-- set here only (Inspect once set self.id to a frame, and the settings
-- search broke far away, 2026-10-17).
type Own = {
    id: string, name: string, description?: string, api?: string, source: string, builtIn: boolean,
    state: ModuleState, error?: string, pendingReload?: boolean, enabledAtLoad?: boolean, initialized?: boolean,
    reloadToToggle: boolean, combatSafe: boolean, replaces?: string, replacedBy?: string,
    -- its settings' defaults, SuuUI's "enabled" included
    defaults: Settings,
}
local owns: { [table]: Own } = setmetatable({}, { __mode = "k" })

-- A module's own fields (a module keeps any name of its own on itself, so
-- the class takes none for this).
local function ownOf(m: table): Own return assert(owns[m]) end

-- A module whatever its settings: what the registry, the settings window
-- and plugins handle.
export interface AnyModule
    readonly id: string
    readonly name: string
    readonly description: string?
    readonly api: string?
    readonly source: string
    readonly builtIn: boolean
    readonly state: ModuleState
    readonly error: string?
    readonly pendingReload: boolean?
    readonly enabledAtLoad: boolean?
    readonly initialized: boolean?
    readonly reloadToToggle: boolean
    readonly combatSafe: boolean
    readonly replaces: string?
    readonly replacedBy: string?
    function OnInitialize()
    function OnEnable()
    function OnDisable()
    function IsEnabled(): boolean
end

-- What a module may add to a role's preset, and a notification kind.
export type NotificationKind = { [string]: unknown }

--- A SuuUI module: SuuUI's own fields (read only), its settings typed by
--- its defaults (`D`), and what it registers, which goes when it turns off.
--- Built-in modules extend it; a plugin's is a PluginModule.
export class Module<D extends Settings> implements AnyModule
    constructor(def: ModuleDef<D>)
        assert(type(def) == "table", "SuuUI.RegisterModule takes a table")
        local id = def.id
        assert(type(id) == "string" and id:find("^%l[%l%d_]*$"),
            "SuuUI.RegisterModule: id must be lower case letters, digits and _, starting with a letter")
        local given: Settings = def.defaults or {}
        local defaults: Settings = util.copy(given)
        assert(defaults.enabled == nil, "SuuUI.RegisterModule: \"enabled\" is SuuUI's own setting; use enabledByDefault")
        assert(def.replaces == nil or (type(def.replaces) == "string" and def.replaces ~= id),
            "SuuUI.RegisterModule: replaces names another module's id")
        defaults.enabled = def.enabledByDefault ~= false
        local source = def.addon or sourceAddon()
        owns[self] = {
            id = id,
            name = def.name or id,
            description = def.description,
            api = def.api,
            reloadToToggle = def.reloadToToggle and true or false,
            combatSafe = def.combatSafe and true or false,
            source = source,
            builtIn = source == ADDON,
            state = ModuleState.Registered,
            replaces = def.replaces,
            defaults = defaults,
        }
    end

    get id(): string return ownOf(self).id end
    get name(): string return ownOf(self).name end
    get description(): string? return ownOf(self).description end
    get api(): string? return ownOf(self).api end
    get source(): string return ownOf(self).source end
    get builtIn(): boolean return ownOf(self).builtIn end
    get state(): ModuleState return ownOf(self).state end
    get error(): string? return ownOf(self).error end
    get pendingReload(): boolean? return ownOf(self).pendingReload end
    get enabledAtLoad(): boolean? return ownOf(self).enabledAtLoad end
    get initialized(): boolean? return ownOf(self).initialized end
    get reloadToToggle(): boolean return ownOf(self).reloadToToggle end
    get combatSafe(): boolean return ownOf(self).combatSafe end
    get replaces(): string? return ownOf(self).replaces end
    get replacedBy(): string? return ownOf(self).replacedBy end

    -- Its life: once before the first enable, then each time it turns on or
    -- off (a module overrides what it needs).
    function OnInitialize() end
    function OnEnable() end
    function OnDisable() end

    -- Its settings (the defaults' keys and types, and "enabled").
    function Get<K extends keyof WithEnabled<D>>(key: K): WithEnabled<D>[K]
        return settings.get(self.id, key) :: WithEnabled<D>[K]
    end
    -- 0.17: the value itself, not a copy, to read only (large tables read often)
    function Peek<K extends keyof WithEnabled<D>>(key: K): WithEnabled<D>[K]
        return settings.peek(self.id, key) :: WithEnabled<D>[K]
    end
    function Set<K extends keyof WithEnabled<D>>(key: K, value: WithEnabled<D>[K]): (boolean, string?)
        return settings.set(self.id, key, value)
    end
    -- one key, or the whole namespace
    function Reset<K extends keyof WithEnabled<D>>(key: K?): boolean return settings.reset(self.id, key) end
    function Watch<K extends keyof WithEnabled<D>>(key: K, fn: (value: WithEnabled<D>[K], namespace: string, key: string) -> ())
        settings.watch(self.id, key, fn :: settings.Watcher, self)
    end
    function Veto<K extends keyof WithEnabled<D>>(key: K, fn: (new: WithEnabled<D>[K], old: WithEnabled<D>[K]) -> (boolean?, string?))
        settings.veto(self.id, key, fn :: settings.Veto, self)
    end
    -- 0.19: fn(key) whenever one of `keys` changes; each of `keys` reset
    function WatchAll<K extends keyof WithEnabled<D>>(keys: K[], fn: (key: K) -> ())
        for _, key in ipairs(keys) do settings.watch(self.id, key, function() fn(key) end, self) end
    end
    function ResetAll<K extends keyof WithEnabled<D>>(keys: K[])
        for _, key in ipairs(keys) do settings.reset(self.id, key) end
    end
    -- fn(values) reshapes one profile's stored values of this module (a
    -- renamed key, a changed type), once per profile. Call it right after
    -- the module is made, at file load, so it runs before the old values
    -- are judged by type.
    function Migrate(id: string, fn: (values: settings.Values) -> ()) settings.migrate(self.id, id, fn, self) end

    -- 0.11: the module's own data for this character (a table it fills;
    -- saved, never part of a profile)
    function CharData(): { [string]: unknown } return settings.charData(self.id) end
    function AllCharData(): { [string]: { [string]: unknown } } return settings.allCharData(self.id) end
    function CharKey(): string? return settings.getCharKey() end
    function ForgetCharData(key: string): boolean return settings.forgetCharData(self.id, key) end

    -- fn wrapped so an error in it is reported (SuuUIDB.errors, /suu errors)
    -- under the module's name, as errors in its events are: for UI callbacks.
    function Guard<A..., R...>(fn: (A...) -> R...): (A...) -> (boolean, R...)
        return function(...: A...): (boolean, R...) return fault.call(self.name, fn, ...) end
    end

    -- A message: SuuUI's (Core/Messages.d.wowlua: the listener's arguments
    -- are checked) or a plugin's own (any name; its values unchecked).
    function On<M extends string>(message: M, fn: (name: M, EventArgs<M>...) -> ())
        events.bus:listen(message, fn :: events.Listener, self)
    end
    function Off(message: string) events.off(message, self) end
    function Emit<M extends string>(message: M, ...: EventArgs<M>...) events.bus:send(message, ...) end
    function OnGameEvent<E extends EventName>(event: E, fn: (name: E, EventArgs<E>...) -> ())
        events.onGame(event, fn, self)
    end
    function OnUnitEvent<E extends EventName>(event: E, units: UnitToken | UnitToken[], fn: (name: E, EventArgs<E>...) -> ())
        events.onUnit(event, units, fn, self)
    end

    -- Keys get an "m:" prefix so a module's never collide with the core's own.
    function RunOutOfCombat(key: string | number, fn: () -> ())
        combat.run("m:" .. self.id .. ":" .. tostring(key), fn, self.name)
    end

    function RegisterCommand(cmd: string, help: string, fn: (rest: string) -> (), args: CommandArgs?)
        registerCommand(cmd, help, fn, self, args)
    end

    -- A settings section for this module: its rows read and write the
    -- module's own namespace, and the section goes away when the module
    -- turns off.
    function RegisterSettings(def: { [string]: any }): settingsRegistry.Section
        def.namespace = def.namespace or self.id
        return settingsRegistry.register(def, self)
    end

    -- An edit-mode handle for one of the module's frames. opts.key names a
    -- position setting in the module's defaults (default "position").
    function RegisterMover(frame: Region, opts: { [string]: any }?): editMode.Mover
        local o: { [string]: any } = opts or {}
        o.namespace = self.id
        o.label = o.label or self.name
        return editMode.register(frame, o, self)
    end

    -- 0.17: SuuUI's own UI (Core/Extend.wowlua). fn(object, info) for every
    -- instance of a kind, now and later (undo(object, info) for each when
    -- the module turns off); fn(object, ...) after a method; fn(object,
    -- original, ...) instead of one. All removed when the module turns off.
    function Each(kind: string, fn: extend.Extender, undo: extend.Extender?) extend.each(kind, fn, undo, self) end
    function Hook(kind: string, method: string, fn: extend.Hook) extend.hook(kind, method, fn, self) end
    function Override(kind: string, method: string, fn: extend.Override) extend.override(kind, method, fn, self) end

    -- 0.17: a service other modules reach by name (Core/Services.wowlua);
    -- gone when the module turns off.
    function Provide(serviceName: string, impl: { [string]: any }) services.provide(serviceName, impl, self) end

    -- 0.17: entries in SuuUI's own menus and lists (Core/Extend.wowlua):
    -- before one of SuuUI's right-click menus opens, fn(menu, context); a
    -- micro menu button; a game menu entry; a game popup shown as a
    -- notification card; this module's own settings in a role's preset.
    -- Gone when it turns off. (The micro menu and the game menu check the
    -- items they get.)
    function ExtendMenu(id: string, fn: extend.MenuExtension) extend.extendMenu(id, fn, self) end
    function AddMicroItem(item: unknown) extend.addTo(extend.List.MicroMenu, item, self) end
    function AddGameMenuItem(item: unknown) extend.addTo(extend.List.GameMenu, item, self) end
    function AddNotificationKind(which: string, def: NotificationKind?)
        local d: NotificationKind = def or {}
        d.which = which
        extend.addTo(extend.List.NotificationKinds, d, self)
    end
    function AddToRolePreset(role: string, values: { [string]: unknown })
        local preset: extend.RolePreset = { role = role, namespace = self.id, values = values }
        extend.addTo(extend.List.RolePresets, preset, self)
    end

    function Print(...: unknown)
        print("|cffa39b8b" .. self.name .. ":|r", ...)
    end

    function IsEnabled(): boolean
        return self.state == ModuleState.Enabled
    end
end

-- What a plugin's module is made from: a module's definition and its
-- callbacks (see the top of this file).
export type PluginDef = ModuleDef<Settings> & {
    OnInitialize?: (self: PluginModule) -> (),
    OnEnable?: (self: PluginModule) -> (),
    OnDisable?: (self: PluginModule) -> (),
}

-- A plugin's module (SuuUI.RegisterModule): its callbacks come with its
-- definition, and it keeps what it likes on itself.
export class PluginModule extends Module<Settings>
    constructor(def: PluginDef)
        super(def)
        -- the instance's own, in front of the class's empty ones
        if def.OnInitialize then rawset(self, "OnInitialize", def.OnInitialize) end
        if def.OnEnable then rawset(self, "OnEnable", def.OnEnable) end
        if def.OnDisable then rawset(self, "OnDisable", def.OnDisable) end
    end
end

-- A module not converted to a class yet (TRANSITION: built-in modules move
-- to classes extending Module one by one; this goes when the last one has):
-- a PluginModule seen with its settings typed and whatever it keeps on
-- itself loose.
export type ModuleOf<D> = {
    id: string,
    name: string,
    description: string?,
    api: string?,
    source: string,
    builtIn: boolean,
    state: ModuleState,
    error: string?,
    pendingReload: boolean?,
    enabledAtLoad: boolean?,
    initialized: boolean?,
    reloadToToggle: boolean,
    combatSafe: boolean,
    replaces: string?,
    replacedBy: string?,
    Get: <K extends keyof D>(self: ModuleOf<D>, key: K) -> D[K],
    Peek: <K extends keyof D>(self: ModuleOf<D>, key: K) -> D[K],
    Set: <K extends keyof D>(self: ModuleOf<D>, key: K, value: D[K]) -> (boolean, string?),
    Reset: <K extends keyof D>(self: ModuleOf<D>, key: K?) -> boolean,
    Watch: <K extends keyof D>(self: ModuleOf<D>, key: K, fn: (value: D[K], namespace: string, key: string) -> ()) -> (),
    Veto: <K extends keyof D>(self: ModuleOf<D>, key: K, fn: (new: D[K], old: D[K]) -> (boolean?, string?)) -> (),
    WatchAll: <K extends keyof D>(self: ModuleOf<D>, keys: K[], fn: (key: K) -> ()) -> (),
    ResetAll: <K extends keyof D>(self: ModuleOf<D>, keys: K[]) -> (),
    IsEnabled: (self: ModuleOf<D>) -> boolean,
    On: <M extends string>(self: ModuleOf<D>, message: M, fn: (name: M, EventArgs<M>...) -> ()) -> (),
    Off: (self: ModuleOf<D>, message: string) -> (),
    Emit: <M extends string>(self: ModuleOf<D>, message: M, ...: EventArgs<M>...) -> (),
    OnGameEvent: <E extends EventName>(self: ModuleOf<D>, event: E, fn: (name: E, EventArgs<E>...) -> ()) -> (),
    OnUnitEvent: <E extends EventName>(self: ModuleOf<D>, event: E, units: UnitToken | UnitToken[],
                                       fn: (name: E, EventArgs<E>...) -> ()) -> (),
    [string]: any,
}
-- (TRANSITION) what such a module is made from: its callbacks see it so.
export type LooseDef<D> = {
    id: string, name?: string, description?: string, api?: string, defaults?: D, enabledByDefault?: boolean,
    reloadToToggle?: boolean, combatSafe?: boolean, replaces?: string, addon?: string,
    OnInitialize?: (self: ModuleOf<WithEnabled<D>>) -> (),
    OnEnable?: (self: ModuleOf<WithEnabled<D>>) -> (),
    OnDisable?: (self: ModuleOf<WithEnabled<D>>) -> (),
}


--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

-- Everything a module registered through its own methods, taken away.
local function releaseAll(m: unknown)
    events.offAll(m)
    settings.unwatch(m)
    unregisterCommands(m)
    settingsRegistry.unregister(m)
    editMode.unregister(m)
    extend.unregister(m)
    services.unregister(m)
end

export class ModuleRegistry
    private modules: AnyModule[] = {}
    private byId: { [string]: AnyModule } = {}
    private started: boolean = false

    constructor(
        private store: ModuleSettings = settings.store,
        private runner: Runner = combat.queue,
        private lockdown: combat.CombatState = combat.GameCombat.new(),
        private reporter: fault.Reporter = fault.log,
        private notifier: events.Notifier = events.bus,
        private release: (owner: unknown) -> () = releaseAll
    )
    end

    private function fail(m: AnyModule, phase: string)
        ownOf(m :: table).state = ModuleState.Errored
        ownOf(m :: table).error = phase .. " failed"
        -- Undo what a failed OnEnable got as far as building (frames shown,
        -- anchors published). The reporter reports an error here and
        -- carries on.
        if phase == "OnEnable" then self.reporter:call(m.name, function() m:OnDisable() end) end
        self.release(m)
        self.notifier:emit("SUUUI_MODULE_ERRORED", m.id)
    end

    private function enable(m: AnyModule)
        if m.state == ModuleState.Enabled or m.state == ModuleState.Incompatible then return end
        if not m.initialized then
            if not self.reporter:call(m.name, function() m:OnInitialize() end) then return self:fail(m, "OnInitialize") end
            ownOf(m :: table).initialized = true
        end
        if not self.reporter:call(m.name, function() m:OnEnable() end) then return self:fail(m, "OnEnable") end
        ownOf(m :: table).state = ModuleState.Enabled
        ownOf(m :: table).error = nil
        self.notifier:emit("SUUUI_MODULE_ENABLED", m.id)
    end

    private function disable(m: AnyModule)
        if m.state ~= ModuleState.Enabled then
            if m.state ~= ModuleState.Incompatible then ownOf(m :: table).state = ModuleState.Disabled end
            return
        end
        self.reporter:call(m.name, function() m:OnDisable() end)
        self.release(m)
        ownOf(m :: table).state = ModuleState.Disabled
        self.notifier:emit("SUUUI_MODULE_DISABLED", m.id)
    end

    -- Brings the module in line with its "enabled" setting.
    function sync(m: AnyModule)
        if m.state == ModuleState.Incompatible or m.replacedBy then return end
        local want = self.store:get(m.id, "enabled")
        if m.reloadToToggle then
            -- an errored module that is still on retries at the next load
            ownOf(m :: table).pendingReload = (want ~= m.enabledAtLoad or (want and m.state == ModuleState.Errored)) or nil
            return
        end
        self.runner:run("module:" .. m.id, function()
            if self.store:get(m.id, "enabled") then self:enable(m) else self:disable(m) end
        end, m.name)
    end

    -- The module standing in for `m` this session (0.17: `replaces`): one
    -- that is on and can load. Decided at login, so a change takes a reload.
    private function replacer(m: AnyModule): AnyModule?
        for _, o in ipairs(self.modules) do
            if o.replaces == m.id and o ~= m and o.state ~= ModuleState.Incompatible and self.store:get(o.id, "enabled") then return o end
        end
        return nil
    end

    private function start(m: AnyModule)
        local by = self:replacer(m)
        if by then
            ownOf(m :: table).replacedBy = by.name
            ownOf(m :: table).enabledAtLoad = false
            ownOf(m :: table).state = ModuleState.Disabled
            self.store:watch(m.id, "enabled", function() end, "Modules")
            return
        end
        ownOf(m :: table).enabledAtLoad = self.store:get(m.id, "enabled")
        self.store:watch(m.id, "enabled", function() self:sync(m) end, "Modules")
        if m.state == ModuleState.Incompatible then return end
        if m.enabledAtLoad then
            -- after a reload in combat a module waits for the fight's end,
            -- unless it makes no secure frames (found in game: buffs and the
            -- Cooldown Manager were missing until the fight ended)
            if m.combatSafe and self.lockdown:inCombat() then
                self.reporter:call(m.name, function() self:enable(m) end)
            else
                self.runner:run("module:" .. m.id, function() self:enable(m) end, m.name)
            end
        else
            ownOf(m :: table).state = ModuleState.Disabled
        end
    end

    -- Login: every module registered so far starts, and each one registered
    -- later starts as it comes.
    function startAll()
        self.started = true
        for _, m in ipairs(self.modules) do self:start(m) end
    end

    ----------------------------------------------------------------------------
    -- Registration
    ----------------------------------------------------------------------------

    -- A module made (a built-in one's class, or a plugin's PluginModule):
    -- its settings registered, started at once after login.
    function add<M extends AnyModule>(m: M): M
        local id = m.id
        assert(not self.byId[id] and not RESERVED[id], "SuuUI.RegisterModule: the id " .. id .. " is taken")
        self.store:register(id, ownOf(m :: table).defaults)
        local api = m.api
        if api and not apiAtLeast(api) then
            ownOf(m :: table).state = ModuleState.Incompatible
            ownOf(m :: table).error = ("needs SuuUI API %s; this SuuUI has %s"):format(tostring(api), API_VERSION)
            print(("%s (%s) can't load: it %s."):format(m.name, m.source, tostring(m.error)))
        end
        self.modules[#self.modules + 1] = m
        self.byId[id] = m
        self.notifier:emit("SUUUI_MODULE_REGISTERED", id)
        if self.started then self:start(m) end
        return m
    end

    -- A plugin's module (SuuUI.RegisterModule), and (TRANSITION) a
    -- built-in one not converted to a class yet.
    function register<D extends Settings>(def: LooseDef<D>): ModuleOf<WithEnabled<D>>
        local m = self:add(PluginModule.new((def :: unknown) :: PluginDef))
        return (m :: unknown) :: ModuleOf<WithEnabled<D>>
    end

    function get(id: string): AnyModule?
        return self.byId[id]
    end

    function all(): AnyModule[]
        return self.modules
    end

    -- The module `text` names: its id or name, in any letter case.
    function find(text: string?): AnyModule?
        local wanted = strtrim(text or ""):lower()
        for _, m in ipairs(self.modules) do
            if m.id == wanted or m.name:lower() == wanted then return m end
        end
        return nil
    end
end

-- SuuUI's registry, and its methods as the module's functions.
export const registry = ModuleRegistry.new()

export function add<M extends AnyModule>(m: M): M return registry:add(m) end
export function register<D extends Settings>(def: LooseDef<D>): ModuleOf<WithEnabled<D>> return registry:register(def) end
export function get(id: string): AnyModule? return registry:get(id) end
export function all(): AnyModule[] return registry:all() end
export function find(text: string?): AnyModule? return registry:find(text) end

@onLogin
local function startAll()
    -- the chosen theme first: plugins' themes are registered by now, and no
    -- module has built a frame yet
    fault.call("Themes", themes.apply)
    registry:startAll()
end

--------------------------------------------------------------------------------
-- Chat commands
--------------------------------------------------------------------------------

local STATE_TEXT: { [ModuleState]: string } = {
    [ModuleState.Enabled] = "|cff3fd0ffon|r",
    [ModuleState.Disabled] = "|cffa39b8boff|r",
    [ModuleState.Errored] = "|cffff9a80errored|r",
    [ModuleState.Incompatible] = "|cffff9a80incompatible|r",
    [ModuleState.Registered] = "|cffa39b8bwaiting for login|r",
}

local function describe(m: AnyModule): string
    local state = STATE_TEXT[m.state] or m.state
    if m.replacedBy then state = "|cffa39b8breplaced by " .. m.replacedBy .. "|r" end
    if m.pendingReload then
        local retry = m.state == ModuleState.Errored and settings.get(m.id, "enabled")
        local afterReload = (retry and "retries") or (m.enabledAtLoad and "off") or "on"
        state = state .. (" |cffffb23f(%s after /reload)|r"):format(afterReload)
    end
    local line = ("  %s  %s  %s  - %s"):format(m.id, m.name, state, m.builtIn and "built in" or m.source)
    if m.error then line = line .. "  (" .. m.error .. ")" end
    return line
end

registerCommand("modules", "List every module, built in and from plugins, with its state.", function()
    local list = registry:all()
    print(("%d modules, API %s:"):format(#list, API_VERSION))
    for _, m in ipairs(list) do _G.print(describe(m)) end
end)

local function toggle(arg: string, on: boolean)
    local m = registry:find(arg)
    if not m then return print(("No module called \"%s\". /suu modules lists them."):format(arg)) end
    if m.state == ModuleState.Incompatible then return print(m.name .. " " .. tostring(m.error) .. ".") end
    if on and m.state == ModuleState.Errored then
        -- Turning an errored module on again is a retry; one that replaces
        -- protected frames can only retry from a fresh load.
        if m.reloadToToggle then
            settings.set(m.id, "enabled", true)
            ownOf(m :: table).pendingReload = true
            print(("%s tries again after a /reload."):format(m.name))
            return _G.print(describe(m))
        end
        ownOf(m :: table).state = ModuleState.Disabled
        if settings.get(m.id, "enabled") then registry:sync(m) end
    end
    settings.set(m.id, "enabled", on)
    if m.reloadToToggle and m.pendingReload then
        print(("%s turns %s after a /reload."):format(m.name, on and "on" or "off"))
    elseif InCombatLockdown() then
        print(("%s turns %s when combat ends."):format(m.name, on and "on" or "off"))
    end
    _G.print(describe(m))
end

registerCommand("enable", "Turn a module on: /suu enable <id>", function(arg: string) toggle(arg, true) end)
registerCommand("disable", "Turn a module off: /suu disable <id>", function(arg: string) toggle(arg, false) end)
