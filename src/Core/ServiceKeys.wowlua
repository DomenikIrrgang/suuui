-- Core/ServiceKeys.wowlua
-- The built-in services' keys and what each one offers (Core/Services;
-- Docs/API.md lists them for plugins, which use the names). Every function
-- is optional: a plugin replacing a module may provide some of them only,
-- and a caller treats a missing one as the service being off.

import ServiceKey from "./Services"
import type AlertTone, FormatArg from "/UI/Alert"
import type LevelUpDef from "/UI/LevelUp"
import type MapPinData from "/UI/MapPin"
import type TooltipData from "/UI/Tooltip"

-- One alert at a time, centred, in combat only (the Alerts module).
export type AlertsService = {
    Show?: (key: string, tone: AlertTone, title: string?, detail: string?, ...FormatArg) -> (),
    ShowLevelUp?: (key: string, def: LevelUpDef) -> (),
    Hide?: (key: string?) -> (),
    AllowOutOfCombat?: (key: string) -> (),
}
export const ALERTS: ServiceKey<AlertsService> = ServiceKey.new("alerts")

-- SuuUI's Talents window (the talents module).
export type TalentNext = {
    node: number,
    name: string,
    icon: number | string,
    rank: number,
    max: number,
    treeName: string,
    build: string,
    index: number,
}
export type TalentsService = {
    Toggle?: () -> (),
    ShowInspect?: (unit: string) -> (),
    IsShown?: () -> boolean,
    -- the next talent of the build you follow, or nil
    NextTalent?: () -> TalentNext?,
}
export const TALENTS: ServiceKey<TalentsService> = ServiceKey.new("talents")

-- SuuUI's Professions window.
export type ProfessionsService = {
    OpenRecipe?: (recipeID: number) -> (),
    ExpectRecipe?: (recipeID: number) -> (),
    ShownRecipe?: () -> number?,
}
export const PROFESSIONS: ServiceKey<ProfessionsService> = ServiceKey.new("professions")

-- SuuUI's Collections window (on a tab: "mounts", "toys", "wardrobe").
export type CollectionsService = { Toggle?: (tab: string?) -> (), IsShown?: () -> boolean }
export const COLLECTIONS: ServiceKey<CollectionsService> = ServiceKey.new("collections")

-- SuuUI's bags.
export type BagsService = { Toggle: () -> () }
export const BAGS: ServiceKey<BagsService> = ServiceKey.new("bags")

-- A note in the notification stack (UI/Notification's data; the module
-- checks what it is given, a plugin's too).
export type NotificationsService = { Notify?: (def: { [string]: unknown }) -> string?, Dismiss?: (id: string) -> () }
export const NOTIFICATIONS: ServiceKey<NotificationsService> = ServiceKey.new("notifications")

-- Your gear's durability (the Durability module), read only.
export type DurabilityPiece = {
    slot: number,
    label: string,
    part?: string,
    link?: string,
    name: string,
    quality: string,
    current: number,
    max: number,
    percent: number,
    state: "fine" | "damaged" | "broken",
}
export type DurabilityParts = { figure: boolean, character: boolean, gear: boolean, gearBars: string, note: boolean }
export type DurabilityInfo = {
    line: number,
    pieces: DurabilityPiece[],
    lowest?: DurabilityPiece,
    bySlot: { [number]: DurabilityPiece },
    damaged: number,
    broken: number,
    average?: number,
    state: "fine" | "damaged" | "broken",
    headline: string,
    summary?: string,
    lines: string[][],
    parts: DurabilityParts,
}
export type DurabilityService = { Get: () -> DurabilityInfo? }
export const DURABILITY: ServiceKey<DurabilityService> = ServiceKey.new("durability")

-- The first-run welcome.
export type WelcomeService = { Show: () -> () }
export const WELCOME: ServiceKey<WelcomeService> = ServiceKey.new("welcome")

-- SuuUI's raid planner window.
export type RaidPlannerService = { Toggle: () -> (), Show: () -> (), IsShown: () -> boolean }
export const RAID_PLANNER: ServiceKey<RaidPlannerService> = ServiceKey.new("raidplanner")

-- A mark on the map (the marks module): its map (uiMapID), x and y (0-1),
-- name, symbol, who shared it (nil: yours) and when it was made.
export type MapMark = {
    id: number,
    map: number,
    x: number,
    y: number,
    name: string,
    symbol: string,
    from?: string,
    at: number,
}
-- Your marks for the world map (the marks module), 0.19.
export type MarksService = {
    Marks?: () -> MapMark[],
    -- a mark's place on another map; nil when that map doesn't hold it
    PlaceOn?: (mark: MapMark, mapID: number) -> (number?, number?),
    MapName?: (map: number?) -> string?,
    PinLook?: (mark: MapMark) -> MapPinData,
    OpenCard?: (id: number, anchor: Region?) -> (),
    -- the mark whose card is open, and its card under that mark's pin
    CardMark?: () -> number?,
    AnchorCard?: (anchor: Region?) -> (),
}
export const MARKS: ServiceKey<MarksService> = ServiceKey.new("marks")

-- The world map's Marks filters and pins (the world map module), 0.19.
export type MarkFilters = { yours?: boolean, shared?: boolean }
export type WorldMapService = {
    MarksShown?: () -> MarkFilters,
    -- the pin showing a mark, while the map shows it
    PinForMark?: (id: number) -> Region?,
    -- its pins drawn again (the flight map's, once it closes)
    Refresh?: () -> (),
    -- the map opened with one filter on: OpenWith("services", "repair")
    -- (the Damaged gear note's Show repairers)
    OpenWith?: (group: string, item: string) -> (),
}
export const WORLD_MAP: ServiceKey<WorldMapService> = ServiceKey.new("worldmap")

-- The Convergences of Elements on a map (the convergences module, for
-- Skyborne characters): each one's place, where it is in words, and its
-- tooltip (the blessing's time left), 0.19.
export type ConvergenceOnMap = { x: number, y: number, where: string, tip: () -> TooltipData }
export type ConvergencesService = {
    -- whether this character sees them (Skyborne)
    Shown?: () -> boolean,
    OnMap?: (mapID: number) -> ConvergenceOnMap[],
    PinLook?: () -> MapPinData,
}
export const CONVERGENCES: ServiceKey<ConvergencesService> = ServiceKey.new("convergences")

-- The campfires this character found (the campsite module), 0.19.
-- (`by`: who in your group or guild found it, 0.21; nil: you; `out`: when
-- it goes out, as time() counts, 0.22)
export type FoundFire = { map: number, x: number, y: number, by?: string, out?: number }
export type CampfiresService = { Fires?: () -> FoundFire[] }
export const CAMPFIRES: ServiceKey<CampfiresService> = ServiceKey.new("campfires")

-- Spells on keys, clicks and the wheel that cast on the unit under the mouse
-- (the mousebindings module), 0.23. A binding: the input as bindings spell
-- it ("SHIFT-F", "CTRL-BUTTON1", "MOUSEWHEELUP"), the spell's name, its
-- highest rank or the one chosen (`spellID`), where it works (unit frames,
-- the world, both) and on whom (anyone, friends, enemies).
export type MouseBind = {
    input: string,
    spell: string,
    rank: "highest" | "fixed",
    spellID?: number,
    reach: "both" | "frames" | "world",
    react: "any" | "help" | "harm",
}
-- A spell to bind: its name, the rank's spell ID and number (nil: no
-- ranks), its icon.
export type BindSpell = { name: string, spellID?: number, rank?: number, icon?: number | string }
export type MouseBindingsService = {
    -- a spell's bindings in this spec, and a binding's chip ("Shift-F", "R3")
    ForSpell?: (name: string) -> MouseBind[],
    ChipText?: (b: MouseBind) -> string,
    -- bind mode: an input pressed over a spell, bound as it comes (asked
    -- first when it takes something over); done(title, detail, tone) says
    -- what happened
    Press?: (spell: BindSpell, input: string, done: (title: string, detail: string?, tone: string?) -> ()) -> (),
    -- a spell's bindings gone: how many there were
    ClearSpell?: (name: string) -> number,
    -- the capture box: a new binding for the spell, or `bind` changed
    Edit?: (spell: BindSpell, bind: MouseBind?) -> (),
    -- the spell's right-click menu; allBindings: its "All bindings" entry
    Menu?: (spell: BindSpell, allBindings: (() -> ())?) -> (),
    -- the bindings list, drawn into `parent` (built the first time);
    -- bindSpells: its "Bind spells" button
    List?: (parent: Frame, bindSpells: () -> ()) -> (),
}
export const MOUSE_BINDINGS: ServiceKey<MouseBindingsService> = ServiceKey.new("mousebindings")

-- The flight master's map (the flight map module): whether it is open at a
-- flight master, 0.19.
export type FlightMapService = { AtMaster?: () -> boolean }
export const FLIGHT_MAP: ServiceKey<FlightMapService> = ServiceKey.new("flightmap")

-- SuuUI's auction house window (the auctionhouse module), 0.28: an item (its
-- ID or link) searched on Buy while the window is open and no other edit
-- box is being typed in (what a Shift-click on it does then); false: not
-- searched.
export type AuctionHouseService = { SearchItem?: (item: number | string) -> boolean }
export const AUCTION_HOUSE: ServiceKey<AuctionHouseService> = ServiceKey.new("auctionhouse")
