-- Core/ThemesRaids.wowlua
-- The raid themes (asked 2026-11-13: three for each of Black Temple, Molten
-- Core, Naxxramas, Karazhan and Sunwell, using every capability a theme
-- has; the user took all fifteen concepts): colours, a header font, every
-- icon in the theme's own treatment, bar art, the windows' patterns, edges,
-- corners, jewels, marks and dividers, and the dress on the windows, the
-- minimap, chat and the unit frames. Each keeps its raid's colour mood
-- (the colour-only raid themes in ThemesBuiltin stay as they are); the
-- three of a raid are different directions. The unit frames' art stays
-- small (at most about 12 px over the frame, one or two motifs):
-- Stranglethorn's vines there were too big. Tall art sits on the windows'
-- top right (their top left is often right under the micro menu). Three
-- more each for Icecrown Citadel and Ulduar followed the same day, their
-- corners wrapping round the frames' corners instead of sticking out. The
-- art comes from tools/raid_art.py.

import tokens as T from "./Tokens"
import register from "./Themes"
import type ThemeTextures from "./Themes"
import type DressKind, DressPiece from "/UI/Dress"

local ROOT = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Themes\\Raids\\"
local MORPHEUS = "Fonts\\MORPHEUS.TTF"
local FRIZ = "Fonts\\FRIZQT__.TTF"
local ARIALN = "Fonts\\ARIALN.TTF"
local SKURRI = "Fonts\\SKURRI.TTF"

local function byte(s: string, i: number): number
    return (tonumber(s:sub(i, i + 1), 16) or 0) / 255
end

local function colors(list: { [string]: string }): { [string]: number[] }
    local out: { [string]: number[] } = {}
    for token, value in pairs(list) do
        local c = { byte(value, 2), byte(value, 4), byte(value, 6) }
        if #value >= 9 then
            c[4] = byte(value, 8)
        end
        out[token] = c
    end
    return out
end

-- Every icon in the concept's own treatment (tools/raid_art.py: GLYPH_STYLES).
local function glyphs(dir: string): { [string]: string }
    local out: { [string]: string } = {}
    for name in pairs(T.glyph :: { [string]: string }) do
        out[name] = dir .. "Glyphs\\" .. name .. ".tga"
    end
    return out
end

-- The textures every concept sets from its own files: the bars' art
-- repeating along them, the windows' pattern, ground behind the bars,
-- corners, jewels, marks, divider (and its edge when it has one), the
-- locks, reset and combat sign from its glyphs.
local function textures(dir: string, edge: boolean): ThemeTextures
    local bar = { file = dir .. "Bar.tga", height = 32 }
    local thin = { file = dir .. "BarThin.tga", height = 16 }
    local t: ThemeTextures = {
        ["health-bar"] = bar,
        ["cast-bar"] = thin,
        ["power-bar"] = thin,
        ["bar"] = thin,
        ["aura-drain"] = thin,
        ["plate-health-bar"] = thin,
        ["plate-cast-bar"] = thin,
        ["surface-pattern"] = dir .. "Pattern.tga",
        ["track-pattern"] = dir .. "Track.tga",
        ["corner"] = dir .. "Corner.tga",
        ["jewel"] = dir .. "Jewel.tga",
        ["mark"] = dir .. "Mark.tga",
        ["divider"] = dir .. "Divider.tga",
        ["cast-lock"] = dir .. "Glyphs\\lock.tga",
        ["setting-lock"] = dir .. "Glyphs\\lock.tga",
        ["setting-reset"] = dir .. "Glyphs\\reset.tga",
        ["combat"] = dir .. "Glyphs\\swords.tga",
    }
    if edge then
        t["border"] = dir .. "Edge.tga"
    end
    return t
end

local function piece(dir: string, file: string, point: FramePoint, x: number, y: number, w: number, h: number,
                     more: { [string]: unknown }?): DressPiece
    local p: { [string]: unknown } = { file = dir .. file .. ".tga", point = point, x = x, y = y, w = w, h = h }
    for k, v in pairs(more or {}) do
        p[k] = v
    end
    return p :: DressPiece
end

-- The minimap's ring, `past` px past its disc, behind the minimap's own
-- buttons and lines (in front, it hid the zoom buttons).
local function ring(dir: string, past: number, motes: { [string]: unknown }?, extra: DressPiece?): DressKind
    local pieces: DressPiece[] = {
        { file = dir .. "Ring.tga", point = "CENTER", fill = true, x = past, y = past, layer = "back" },
    }
    if extra then
        pieces[2] = extra
    end
    local kind: { [string]: unknown } = { pieces = pieces }
    if motes then
        kind.motes = motes
    end
    return kind :: DressKind
end

