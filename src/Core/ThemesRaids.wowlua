-- corner with an eye on its bend, a tendril wavering along the windows'
-- top between them, eyes drifting up; two tentacles gripping
-- the minimap with eyes between, a small eye on the unit frames. A
-- tentacle in the bars, whispers in the ground; wavering icons with an eye.
local function ulduarMadness()
    local dir = ROOT .. "UlduarMadness\\"
    register({
        id = "ulduar-madness",
        name = "Ulduar · Madness",
        description = "Yogg-Saron's madness: tentacles curling round the corners, watching eyes and whispers, wavering icons.",
        colors = colors({
            ["surface"] = "#130B18",
            ["surface-glass"] = "#130B18F7",
            ["surface-sunk"] = "#0F0813",
            ["surface-raised"] = "#1D1323",
            ["track"] = "#25192C",
            ["gilt"] = "#A66AD4",
            ["gilt-text"] = "#E8D0FA",
            ["gilt-line"] = "#A66AD488",
            ["gilt-hairline"] = "#A66AD46E",
            ["gilt-faint"] = "#A66AD424",
            ["ink"] = "#F2EBF6",
            ["ink-muted"] = "#AA9EB3",
            ["ink-faint"] = "#7D7186",
            ["unit-fill"] = "#7A5296",
            ["unit-fill-deep"] = "#52376A",
            ["shade"] = "#070309",
        }),
        fonts = { header = { file = SKURRI } },
        glyphs = glyphs(dir),
        textures = textures(dir, false),
        dress = {
            window = {
                header = dir .. "Header.tga",
                pieces = wraps(dir, { piece(dir, "Tendril", "TOP", 40, 4, 64, 8, { span = true }) }),
                motes = { file = dir .. "Mote.tga", count = 3, color = "gilt-text", size = 9 },
            },
            chat = { pieces = wraps(dir) },
            minimap = ring(dir, 12, { file = dir .. "Mote.tga", count = 2, color = "gilt-text", size = 7 }),
            unit = { pieces = { piece(dir, "Unit", "TOPLEFT", 14, 9, 14, 8) } },
        },
    })
end

-- Every raid theme, in the order the theme picker lists them (Themes
-- Builtin calls this right after the raids' colour-only themes).
export function registerRaids()
    blacktempleTemple()
    blacktempleChains()
    blacktempleRunes()
    moltencoreObsidian()
    moltencoreBasalt()
    moltencoreFlames()
    naxxramasNecropolis()
    naxxramasBones()
    naxxramasFrost()
    karazhanLibrary()
    karazhanOpera()
    karazhanNether()
    sunwellSunburst()
    sunwellPhoenix()
    sunwellNaaru()
    icecrownSaronite()
    icecrownPlagueworks()
    icecrownCrimson()
    ulduarTitan()
    ulduarMachinery()
    ulduarMadness()
end
