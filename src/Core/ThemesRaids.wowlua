--------------------------------------------------------------------------------
-- Icecrown Citadel and Ulduar (asked 2026-11-13: three themes each). Their
-- corners wrap round the frames' corners instead of hanging off them (the
-- user: Naxxramas · Bones' web stuck out too far): an L along both edges,
-- at most 4 px past them and 6 inside, on all four corners of the windows
-- and chat. What runs along a window's top sits between the wraps.
--------------------------------------------------------------------------------

-- The wraps on a frame's four corners (drawn for the top right corner;
-- WrapLow is the bottom's), after `more`.
local function wraps(dir: string, more: DressPiece[]?): DressPiece[]
    local out: DressPiece[] = {}
    for _, p in ipairs(more or {}) do
        out[#out + 1] = p
    end
    out[#out + 1] = piece(dir, "Wrap", "TOPLEFT", -4, 4, 48, 48, { flip = true })
    out[#out + 1] = piece(dir, "Wrap", "TOPRIGHT", 4, 4, 48, 48)
    out[#out + 1] = piece(dir, "WrapLow", "BOTTOMLEFT", -4, -4, 48, 48, { flip = true })
    out[#out + 1] = piece(dir, "WrapLow", "BOTTOMRIGHT", 4, -4, 48, 48)
    return out
end

