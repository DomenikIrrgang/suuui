-- Black Temple
--------------------------------------------------------------------------------

-- Temple: the broken temple. Draenei stone behind the titles with carved lenses,
-- a cracked lintel along the windows' top and a broken slab on their
-- corner, fel spores; a broken stone ring round the minimap, a small
-- carved lens on the unit frames. Cracks in the bars, stonework in the
-- ground; cracked icons.
local function blacktempleTemple()
    local dir = ROOT .. "BlackTempleTemple\\"
    register({
        id = "blacktemple-temple",
        name = "Black Temple · Temple",
        description = "The broken temple: draenei stone with carved lenses, fel glowing in its cracks, cracked icons.",
        colors = colors({
            ["surface"] = "#140F1B",
            ["surface-glass"] = "#140F1BF7",
            ["surface-sunk"] = "#131019",
            ["surface-raised"] = "#1B1622",
            ["track"] = "#231E29",
            ["gilt"] = "#7DAF61",
            ["gilt-text"] = "#B7CD9D",
            ["gilt-line"] = "#7DAF616E",
            ["gilt-hairline"] = "#7DAF6157",
            ["gilt-faint"] = "#7DAF6124",
            ["ink"] = "#E8EDE1",
            ["ink-muted"] = "#9BA192",
            ["ink-faint"] = "#72776A",
            ["unit-fill"] = "#466E33",
            ["unit-fill-deep"] = "#2D4A20",
            ["shade"] = "#07050A",
        }),
        fonts = { header = { file = MORPHEUS } },
        glyphs = glyphs(dir),
        textures = textures(dir, true),
        dress = {
            window = {
                header = dir .. "Header.tga",
                pieces = {
                    piece(dir, "Lintel", "TOP", 0, 10, 256, 16, { span = true }),
                    piece(dir, "Slab", "TOPRIGHT", 14, 32, 88, 40, { flip = true }),
                },
                motes = { file = dir .. "Mote.tga", count = 3, color = "gilt", size = 7 },
            },
            chat = { pieces = { piece(dir, "Slab", "TOPRIGHT", 14, 32, 88, 40, { flip = true }) } },
            minimap = ring(dir, 10),
            unit = { pieces = { piece(dir, "Unit", "TOPLEFT", 14, 8, 14, 10) } },
        },
    })
end

