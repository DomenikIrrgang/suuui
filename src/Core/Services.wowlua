-- Core/Services.wowlua
-- What one module does for the others (plan 4.3, 2026-10-18): open the bags,
-- show a player's talents, post a notification… A module provides a service
-- by name with a table of functions; whoever needs it asks for the name, not
-- for the module. A plugin that replaces a module (`replaces`) provides the
-- same services, and every caller reaches it. A module's services go away
-- when it turns off. Built in: bags, talents, collections, professions,
-- notifications, alerts (their functions in Docs/API.md).
--
-- A service locator: the ServiceRegistry, which tells each change through
-- an events.Notifier (SuuUI's event bus: SUUUI_SERVICE_CHANGED). `registry` is
-- SuuUI's; the module's functions are its methods.

import * as events from "./Events"

-- The message a change is told with.
export const SERVICE_CHANGED = "SUUUI_SERVICE_CHANGED"

type Provider = { impl: { [string]: any }, owner: unknown }

export class ServiceRegistry
    private providers: { [string]: Provider } = {}

    constructor(private notifier: events.Notifier = events.bus) end

    function provide(name: string, impl: { [string]: any }, owner: unknown)
        assert(type(name) == "string", "SuuUI Provide: a service name is required")
        assert(type(impl) == "table", "SuuUI Provide: a table of functions is required")
        self.providers[name] = { impl = impl, owner = owner }
        self.notifier:emit(SERVICE_CHANGED, name)
    end

    -- The service's functions, or nil while nothing provides it.
    function get(name: string): { [string]: any }?
        local p = self.providers[name]
        return p and p.impl
    end

    -- Every service `owner` provides gone.
    function unregister(owner: unknown)
        for name, p in pairs(self.providers) do
            if p.owner == owner then
                self.providers[name] = nil
                self.notifier:emit(SERVICE_CHANGED, name)
            end
        end
    end
end

-- SuuUI's registry, and its methods as the module's functions.
export const registry = ServiceRegistry.new()

export function provide(name: string, impl: { [string]: any }, owner: unknown)
    registry:provide(name, impl, owner)
end

export function get(name: string): { [string]: any }?
    return registry:get(name)
end

export function unregister(owner: unknown)
    registry:unregister(owner)
end
