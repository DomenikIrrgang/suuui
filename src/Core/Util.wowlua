-- Core/Util.wowlua
-- Small helpers shared by the core (copies, equality and sorted keys are
-- wowlua:table's): owner names.

import * as tbl from "wowlua:table"
import * as wf from "wowlua:frames"

-- A readable name for an owner passed to the event bus or settings: a
-- module's name, a frame's global name, or the owner itself.
export function ownerName(owner: unknown): string
    if type(owner) == "table" then
        local name, id, label = tbl.field(owner, "name"), tbl.field(owner, "id"), tbl.field(owner, "label")
        if type(name) == "string" then return name end
        if type(id) == "string" then return id end
        -- an edit mode mover (its frame's label)
        if type(label) == "string" then return "Mover: " .. label end
        local region = wf.asRegion(owner)
        local regionName = region and region:GetName()
        if regionName then return regionName end
        return tostring(owner)
    end
    return tostring(owner)
end
