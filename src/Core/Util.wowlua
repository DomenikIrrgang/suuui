-- Core/Util.wowlua
-- Small helpers shared by the core. Deep copies and equality are
-- wowlua:table's; the sort order and owner names are SuuUI's own.

import * as tbl from "wowlua:table"

-- A deep copy of `v`; non-tables are returned as they are.
export function copy<T>(v: T): T
    return tbl.copy(v)
end

-- Deep equality for plain data.
export function equal(a: any, b: any): boolean
    return tbl.equal(a, b)
end

-- The keys of `t`, sorted as strings (wowlua:table's keys sorts only keys
-- of one type; settings listings mix none, but plugin data may).
export function sortedKeys<K>(t: { [K]: any }): K[]
    local out: K[] = {}
    for k in pairs(t) do out[#out + 1] = k end
    table.sort(out, function(a: K, b: K): boolean return tostring(a) < tostring(b) end)
    return out
end

-- A readable name for an owner passed to the event bus or settings: a
-- module's name, a frame's global name, or the owner itself.
export function ownerName(owner: unknown): string
    if type(owner) == "table" then
        if type(owner.name) == "string" then return owner.name end
        if type(owner.id) == "string" then return owner.id end
        -- an edit mode mover (its frame's label)
        if type(owner.label) == "string" then return "Mover: " .. owner.label end
        if owner.GetName and owner:GetName() then return owner:GetName() end
        return tostring(owner)
    end
    return tostring(owner)
end
