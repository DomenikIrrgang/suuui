-- Core/Themes.wowlua
-- Themes (plan 4.3, asked 2026-10-18; after a reload, agreed): a plugin
-- registers one with SuuUI.RegisterTheme, the player picks it in Settings ›
-- General › Appearance (for every character, like colour vision), and it
-- applies at login, just before SuuUI's modules build their frames:
--   colors = { [token] = { r, g, b[, a] } }   a design token's colour (its
--                                             own alpha kept unless given;
--                                             not chat-*: the game's chat
--                                             settings colour chat lines);
--            or function(class) → that table  (worked out at login for your
--                                             class: "MAGE", "DRUID", …)
--   fonts = { [style] = { file, size, lineHeight } }  a text style's face,
--                                             size and line height
--   textures = { [token] = file }             (0.35) a texture token's file
--                                             (the bars' fill, the absorb
--                                             hatch, the tapped stripes, the
--                                             glows, role icons…: T.texture;
--                                             0.39: the windows' patterns,
--                                             edges, corners, jewels, marks,
--                                             divider and the plates' bars)
--   glyphs = { [name] = file }                (0.37) an icon's file, by the
--                                             glyph's name (T.glyph: "bag",
--                                             "search", "chevronDown"…)
--   space = { [token] = px }                  (0.38) a spacing token's px
--                                             ("space-1"…"space-7": T.space)
--   sizes = { [token] = px }                  (0.38) a size token's px
--                                             ("icon-md", "slot", "unit-lg"…:
--                                             T.size)
--   radius = { [token] = px | "N%" }          (0.38) a corner radius token
--                                             (T.radius; SuuUI draws square
--                                             corners: nothing reads them
--                                             yet, kept for themes to come)
--   health = "class"                          (0.26) players' health in
--                                             their class colour ("fill",
--                                             the default: the unit-fill);
--                                             the "Health colour" setting
--                                             on Class colours wins
-- Plugins load after SuuUI's saved settings, so a theme can't apply where
-- colour vision does (Settings' bind); colour vision is applied again after
-- it, so its signal colours always win. A change applies at once (asked
-- 2026-10-19): the tokens go back to the design's, the theme and colour
-- vision go on top, every colour kept by UI.Paint is set again, and
-- SUUUI_THEME_CHANGED tells the rest (colour codes in text, colours worked
-- out from a token, sizes from a text style's line height). Textures set by
-- their token (UI.Skin) or glyph (UI.Glyph) are set again before the
-- colours (draw.reskin). Spacing and sizes (asked 2026-11-12: a denser or
-- roomier UI) are numbers from 0 (spacing) or a quarter (sizes) to four
-- times the design's; when a change moves any, what draw.layout keeps and
-- the stacks and grids with token gaps are laid out again (draw.relayout)
-- before SUUUI_THEME_CHANGED tells the modules, which lay out the rest.
-- Protected frames wait for the end of combat.

import tokens as T, TextStyle, Color from "./Tokens"
import * as settings from "./Settings"
import * as events from "./Events"
import * as vision from "./Vision"
import * as fonts from "./Fonts"
import * as draw from "/UI/Draw"
import * as secret from "wowlua:secret"

export type ThemeColors = { [string]: number[] }
export type ThemeFonts = { [string]: { file?: string, size?: number, lineHeight?: number } }
export type ThemeTextures = { [string]: string }
export type ThemeGlyphs = { [string]: string }
export type ThemeNumbers = { [string]: number }
export type ThemeRadii = { [string]: number | string }
export type Theme = {
    id: string,
    name: string,
    description: string?,
    colors: ThemeColors | ((class: string?) -> ThemeColors),
    fonts: ThemeFonts,
    textures: ThemeTextures,
    glyphs: ThemeGlyphs,
    space: ThemeNumbers,
    sizes: ThemeNumbers,
    radius: ThemeRadii,
    health: "fill" | "class",
}
--- What a plugin passes SuuUI.RegisterTheme.
export type ThemeDef = {
    id: string,
    name?: string,
    description?: string,
    colors?: ThemeColors | ((class: string?) -> ThemeColors),
    fonts?: ThemeFonts,
    textures?: ThemeTextures,
    glyphs?: ThemeGlyphs,
    space?: ThemeNumbers,
    sizes?: ThemeNumbers,
    radius?: ThemeRadii,
    health?: "fill" | "class",
}

local colors: { [string]: Color } = T.color
local styles: { [string]: TextStyle } = T.type
local textures: { [string]: string } = T.texture
local glyphs: { [string]: string } = T.glyph
local spaces: { [string]: number } = T.space
local sizes: { [string]: number } = T.size
local radii: { [string]: number | string } = T.radius

-- the design's own colours, text styles and textures, before any theme or
-- colour vision (this file loads before the saved settings apply either)
local design: {
    color: { [string]: Color },
    type: { [string]: { file: string, size: number, lineHeight: number } },
    texture: { [string]: string },
    glyph: { [string]: string },
    space: { [string]: number },
    size: { [string]: number },
    radius: { [string]: number | string },
} = { color = {}, type = {}, texture = {}, glyph = {}, space = {}, size = {}, radius = {} }
for tokenName, c in pairs(colors) do
    design.color[tokenName] = { c[1], c[2], c[3], c[4], hex = c.hex }
end
for styleName, s in pairs(styles) do
    design.type[styleName] = { file = s.file, size = s.size, lineHeight = s.lineHeight }
end
for tokenName, file in pairs(textures) do
    design.texture[tokenName] = file
end
for name, file in pairs(glyphs) do
    design.glyph[name] = file
end
for tokenName, px in pairs(spaces) do
    design.space[tokenName] = px
end
for tokenName, px in pairs(sizes) do
    design.size[tokenName] = px
end
for tokenName, r in pairs(radii) do
    design.radius[tokenName] = r
end

local function reset()
    for tokenName, d in pairs(design.color) do
        local c = colors[tokenName]
        c[1], c[2], c[3], c[4], c.hex = d[1], d[2], d[3], d[4], d.hex
    end
    for styleName, d in pairs(design.type) do
        local s = styles[styleName]
        s.file, s.size, s.lineHeight = d.file, d.size, d.lineHeight
    end
    for tokenName, file in pairs(design.texture) do
        textures[tokenName] = file
    end
    for name, file in pairs(design.glyph) do
        glyphs[name] = file
    end
    for tokenName, px in pairs(design.space) do
        spaces[tokenName] = px
    end
    for tokenName, px in pairs(design.size) do
        sizes[tokenName] = px
    end
    for tokenName, r in pairs(design.radius) do
        radii[tokenName] = r
    end
end

-- The spacing, sizes and radii in effect, as text (a theme change lays the
-- UI out again only when it moved one).
local function geometry(): string
    local parts: string[] = {}
    for tokenName, px in pairs(spaces) do
        parts[#parts + 1] = tokenName .. "=" .. tostring(px)
    end
    for tokenName, px in pairs(sizes) do
        parts[#parts + 1] = tokenName .. "=" .. tostring(px)
    end
    for tokenName, r in pairs(radii) do
        parts[#parts + 1] = tokenName .. "=" .. tostring(r)
    end
    table.sort(parts)
    return table.concat(parts, ",")
end

export const DEFAULT = "suuui"
local list: Theme[] = {
    {
        id = DEFAULT,
        name = "SuuUI",
        description = "SuuUI's own colours and type.",
        colors = {},
        fonts = {},
        textures = {},
        glyphs = {},
        space = {},
        sizes = {},
        radius = {},
        health = "fill",
    },
}
local byId: { [string]: Theme } = { [DEFAULT] = list[1] }
local applied: string = DEFAULT

-- The chat's line colours are the game's (decided 2026-11-12): players set
-- them in the game's chat settings, so a theme can't change chat-*; it is
-- told so once and the colour is left out.
local function isChat(token: string): boolean
    return token:find("^chat%-") ~= nil
end

local warned: { [string]: boolean } = {}
local function warnChat(id: string, token: string)
    local key = id .. "\0" .. token
    if warned[key] then
        return
    end
    warned[key] = true
    print(
        ("SuuUI.RegisterTheme: %s sets %s, which is left out: chat colours come from the game's chat settings"):format(
            id,
            token
        )
    )
end

-- A theme's spacing or sizes: real tokens, each a number from `least` times
-- the design's to four times it. (Level 3: the error points at the
-- plugin's RegisterTheme call.)
local function numbers(
    id: string,
    key: string,
    value: unknown,
    own: { [string]: number },
    least: number,
    what: string
): ThemeNumbers
    if value == nil then
        return {}
    end
    if type(value) ~= "table" then
        error(("SuuUI.RegisterTheme: %s's %s are a table of %ss"):format(id, key, what), 3)
    end
    local out: ThemeNumbers = {}
    for token, px in pairs(value :: { [unknown]: unknown }) do
        local name = tostring(token)
        local d = type(token) == "string" and own[token] or nil
        if d == nil then
            error(("SuuUI.RegisterTheme: %s has no %s %q"):format(id, what, name), 3)
        end
        if type(px) ~= "number" or px ~= px or px < d * least or px > d * 4 then
            error(
                ("SuuUI.RegisterTheme: %s's %s %s is a number from %s to %s px (the design's is %s), not %s"):format(
                    id,
                    what,
                    name,
                    tostring(d * least),
                    tostring(d * 4),
                    tostring(d),
                    tostring(px)
                ),
                3
            )
        end
        out[name] = px
    end
    return out
end

-- A theme's corner radii: px from 0 to four times the design's; a share of
-- the size where the design's is one ("radius-round": "50%"), from "0%" to
-- "50%".
local function radiusOf(id: string, value: unknown): ThemeRadii
    if value == nil then
        return {}
    end
    if type(value) ~= "table" then
        error(("SuuUI.RegisterTheme: %s's radius is a table of radius tokens"):format(id), 3)
    end
    local out: ThemeRadii = {}
    for token, r in pairs(value :: { [unknown]: unknown }) do
        local name = tostring(token)
        local d = type(token) == "string" and design.radius[token] or nil
        if d == nil then
            error(("SuuUI.RegisterTheme: %s has no radius token %q"):format(id, name), 3)
        end
        local ok = false
        if type(d) == "number" then
            ok = type(r) == "number" and r >= 0 and r <= d * 4
        elseif type(r) == "string" then
            local share = tonumber(r:match("^(%d+%.?%d*)%%$"))
            ok = share ~= nil and share <= 50
        end
        if not ok then
            local range = type(d) == "number" and ("a number from 0 to " .. tostring(d * 4) .. " px") or
                "a share from \"0%\" to \"50%\""
            error(("SuuUI.RegisterTheme: %s's radius %s is %s, not %s"):format(id, name, range, tostring(r)), 3)
        end
        out[name] = r :: number | string
    end
    return out
end

-- (a plugin's Lua passes anything: checked here)
export function register(value: unknown): Theme
    local def = type(value) == "table" and value :: ThemeDef or nil
    assert(def and type(def.id) == "string" and def.id ~= "", "SuuUI.RegisterTheme: a theme needs an id")
    assert(not byId[def.id], "SuuUI.RegisterTheme: the theme " .. def.id .. " is taken")
    if type(def.colors) == "table" then
        for token in pairs(def.colors) do
            if not colors[token] then
                error(("SuuUI.RegisterTheme: %s has no colour token %q"):format(def.id, tostring(token)), 2)
            end
            if isChat(token) then
                warnChat(def.id, token)
            end
        end
    end
    for style in pairs(def.fonts or {}) do
        if not styles[style] then
            error(("SuuUI.RegisterTheme: %s has no text style %q"):format(def.id, tostring(style)), 2)
        end
    end
    local given: unknown = def.textures
    if given ~= nil and type(given) ~= "table" then
        error(("SuuUI.RegisterTheme: %s's textures are a table of texture tokens"):format(def.id), 2)
    end
    for token, file in pairs(def.textures or {}) do
        if not textures[token] then
            error(("SuuUI.RegisterTheme: %s has no texture token %q"):format(def.id, tostring(token)), 2)
        end
        local f: unknown = file
        if type(f) ~= "string" or f == "" then
            error(("SuuUI.RegisterTheme: %s's texture %s needs a file path"):format(def.id, token), 2)
        end
    end
    given = def.glyphs
    if given ~= nil and type(given) ~= "table" then
        error(("SuuUI.RegisterTheme: %s's glyphs are a table of glyph names"):format(def.id), 2)
    end
    for name, file in pairs(def.glyphs or {}) do
        if not glyphs[name] then
            error(("SuuUI.RegisterTheme: %s has no glyph %q"):format(def.id, tostring(name)), 2)
        end
        local f: unknown = file
        if type(f) ~= "string" or f == "" then
            error(("SuuUI.RegisterTheme: %s's glyph %s needs a file path"):format(def.id, name), 2)
        end
    end
    local space = numbers(def.id, "space", def.space, design.space, 0, "spacing token")
    local ownSizes = numbers(def.id, "sizes", def.sizes, design.size, 0.25, "size token")
    local radius = radiusOf(def.id, def.radius)
    given = def.health
    if given ~= nil and given ~= "fill" and given ~= "class" then
        error(("SuuUI.RegisterTheme: %s's health is \"fill\" or \"class\", not %q"):format(def.id, tostring(given)), 2)
    end
    local theme: Theme = {
        id = def.id,
        name = def.name or def.id,
        description = def.description,
        colors = def.colors or {},
        fonts = def.fonts or {},
        textures = def.textures or {},
        glyphs = def.glyphs or {},
        space = space,
        sizes = ownSizes,
        radius = radius,
        health = def.health == "class" and "class" or "fill",
    }
    list[#list + 1] = theme
    byId[def.id] = theme
    return theme
end

export function all(): Theme[]
    return list
end

export function get(id: string): Theme?
    return byId[id]
end

-- The theme in effect this session.
export function appliedTheme(): string
    return applied
end

-- What colours unit health (design "Health colours", 2026-11-07): "class"
-- (players in their class colour) when the "Health colour" setting says so,
-- else the applied theme's choice ("fill": the unit-fill). The setting wins.
export function health(): "fill" | "class"
    if settings.accountString("healthColor") == "class" then
        return "class"
    end
    local theme = byId[applied] or byId[DEFAULT] :: Theme
    return theme.health
end

-- NPCs' health in their reaction's colour (asked 2026-11-12): the "NPC
-- reaction colours" setting, off by default; over the theme's fill.
export function reactionHealth(): boolean
    return settings.accountString("npcHealthColor") == "reaction"
end

local function hex(r: number, g: number, b: number): string
    return ("%02x%02x%02x"):format(math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5))
end

-- The chosen theme (a missing one: SuuUI's), then the chosen colour vision
-- on top: at login, before the modules start, and again whenever either
-- setting changes.
export function apply()
    local before = geometry()
    reset()
    local id = settings.account("theme") or DEFAULT
    local theme = byId[id] or byId[DEFAULT] :: Theme
    applied = theme.id
    local source = theme.colors
    local worked: ThemeColors = {}
    if type(source) == "function" then
        local _, class = UnitClass("player")
        local ok, t = pcall(source, secret.asString(class))
        if ok and type(t) == "table" then
            worked = t
        end
    else
        worked = source
    end
    for tokenName, c in pairs(worked) do
        local token = colors[tokenName]
        -- (a worked-out table may name a token that isn't one: skipped; and
        -- the chat's colours are the game's)
        if token and isChat(tokenName) then
            warnChat(theme.id, tokenName)
        elseif token then
            token[1], token[2], token[3] = c[1], c[2], c[3]
            if c[4] then
                token[4] = c[4]
            end
            token.hex = hex(c[1], c[2], c[3])
        end
    end
    for style, f in pairs(theme.fonts) do
        local s = styles[style]
        if not s then
            continue
        end
        if f.file then
            s.file = f.file
        end
        if f.size then
            s.size = f.size
        end
        if f.lineHeight then
            s.lineHeight = f.lineHeight
        end
    end
    for token, file in pairs(theme.textures) do
        if textures[token] then
            textures[token] = file
        end
    end
    for name, file in pairs(theme.glyphs) do
        if glyphs[name] then
            glyphs[name] = file
        end
    end
    for tokenName, px in pairs(theme.space) do
        if spaces[tokenName] then
            spaces[tokenName] = px
        end
    end
    for tokenName, px in pairs(theme.sizes) do
        if sizes[tokenName] then
            sizes[tokenName] = px
        end
    end
    for tokenName, r in pairs(theme.radius) do
        if radii[tokenName] then
            radii[tokenName] = r
        end
    end
    vision.apply(settings.accountString("colorVision"))
    fonts.refresh()
    -- (files first: a bar's new file may take the bar's colour; repaint
    -- then sets every kept colour)
    draw.reskin()
    draw.repaint()
    -- (spacing or sizes moved: what keeps its layout is laid out again,
    -- then the modules lay out the rest on the message)
    if geometry() ~= before then
        draw.relayout()
    end
    events.emit("SUUUI_THEME_CHANGED", applied)
end
