-- Core/Themes.wowlua
-- Themes (plan 4.3, asked 2026-10-18; after a reload, agreed): a plugin
-- registers one with SuuUI.RegisterTheme, the player picks it in Settings ›
-- General › Appearance (for every character, like colour vision), and it
-- applies at login, just before SuuUI's modules build their frames:
--   colors = { [token] = { r, g, b[, a] } }   a design token's colour (its
--                                             own alpha kept unless given);
--            or function(class) → that table  (worked out at login for your
--                                             class: "MAGE", "DRUID", …)
--   fonts = { [style] = { file, size, lineHeight } }  a text style's face,
--                                             size and line height
-- Plugins load after SuuUI's saved settings, so a theme can't apply where
-- colour vision does (Settings' bind); colour vision is applied again after
-- it, so its signal colours always win. A change applies at once (asked
-- 2026-10-19): the tokens go back to the design's, the theme and colour
-- vision go on top, every colour kept by UI.Paint is set again, and
-- SUUUI_THEME_CHANGED tells the rest (colour codes in text, colours worked
-- out from a token, sizes from a text style's line height).

import tokens as T, TextStyle from "./Tokens"
import * as settings from "./Settings"
import * as events from "./Events"
import * as vision from "./Vision"
import * as fonts from "./Fonts"
import * as draw from "/UI/Draw"

export type ThemeColors = { [string]: number[] }
export type ThemeFonts = { [string]: { file?: string, size?: number, lineHeight?: number } }
export type Theme = {
    id: string,
    name: string,
    description: string?,
    colors: ThemeColors | ((class: string?) -> ThemeColors),
    fonts: ThemeFonts,
}

local colors: { [string]: any } = T.color
local styles: { [string]: TextStyle } = T.type

-- the design's own colours and text styles, before any theme or colour
-- vision (this file loads before the saved settings apply either)
local design: { color: { [string]: any }, type: { [string]: { file: string, size: number, lineHeight: number } } } = { color = {}, type = {} }
for tokenName, c in pairs(colors) do design.color[tokenName] = { c[1], c[2], c[3], c[4], hex = c.hex } end
for styleName, s in pairs(styles) do design.type[styleName] = { file = s.file, size = s.size, lineHeight = s.lineHeight } end

local function reset()
    for tokenName, d in pairs(design.color) do
        local c = colors[tokenName]
        c[1], c[2], c[3], c[4], c.hex = d[1], d[2], d[3], d[4], d.hex
    end
    for styleName, d in pairs(design.type) do
        local s = styles[styleName]
        s.file, s.size, s.lineHeight = d.file, d.size, d.lineHeight
    end
end

export const DEFAULT = "suuui"
local list: Theme[] = { { id = DEFAULT, name = "SuuUI", description = "SuuUI's own colours and type.", colors = {}, fonts = {} } }
local byId: { [string]: Theme } = { [DEFAULT] = list[1] }
local applied: string = DEFAULT

export function register(def: any): Theme
    assert(type(def) == "table" and type(def.id) == "string" and def.id ~= "", "SuuUI.RegisterTheme: a theme needs an id")
    assert(not byId[def.id], "SuuUI.RegisterTheme: the theme " .. def.id .. " is taken")
    if type(def.colors) == "table" then
        for token in pairs(def.colors) do
            if not colors[token] then error(("SuuUI.RegisterTheme: %s has no colour token %q"):format(def.id, tostring(token)), 2) end
        end
    end
    for style in pairs(def.fonts or {}) do
        if not styles[style] then error(("SuuUI.RegisterTheme: %s has no text style %q"):format(def.id, tostring(style)), 2) end
    end
    local theme: Theme = { id = def.id, name = def.name or def.id, description = def.description, colors = def.colors or {}, fonts = def.fonts or {} }
    list[#list + 1] = theme
    byId[def.id] = theme
    return theme
end

export function all(): Theme[]
    return list
end

export function get(id: string): Theme?
    return byId[id]
end

-- The theme in effect this session.
export function appliedTheme(): string
    return applied
end

local function hex(r: number, g: number, b: number): string
    return ("%02x%02x%02x"):format(math.floor(r * 255 + 0.5), math.floor(g * 255 + 0.5), math.floor(b * 255 + 0.5))
end

-- The chosen theme (a missing one: SuuUI's), then the chosen colour vision
-- on top: at login, before the modules start, and again whenever either
-- setting changes.
export function apply()
    reset()
    local id = settings.account("theme") or DEFAULT
    local theme = byId[id] or byId[DEFAULT] :: Theme
    applied = theme.id
    local worked: any = theme.colors
    if type(worked) == "function" then
        local _, class = UnitClass("player")
        local ok, t = pcall(worked, class)
        worked = ok and type(t) == "table" and t or {}
    end
    for tokenName, c in pairs(worked :: ThemeColors) do
        local token = colors[tokenName]
        -- (a worked-out table may name a token that isn't one: skipped)
        if token then
            token[1], token[2], token[3] = c[1], c[2], c[3]
            if c[4] then token[4] = c[4] end
            token.hex = hex(c[1], c[2], c[3])
        end
    end
    for style, f in pairs(theme.fonts) do
        local s = styles[style]
        if not s then continue end
        if f.file then s.file = f.file end
        if f.size then s.size = f.size end
        if f.lineHeight then s.lineHeight = f.lineHeight end
    end
    vision.apply(settings.accountString("colorVision"))
    fonts.refresh()
    draw.repaint()
    events.emit("SUUUI_THEME_CHANGED", applied)
end
