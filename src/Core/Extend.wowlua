-- Core/Extend.wowlua
-- Plugins reach into SuuUI's own UI (plan 4.3, asked 2026-10-18): every
-- instance of a kind (unit frames, nameplates, cast bars, action buttons…)
-- is registered here when it's made, so a module can
--   M:Each(kind, fn[, undo])          run fn(object, info) on every one, now
--                                     and on each one made later
--   M:Hook(kind, method, fn)          fn(object, ...) after the method
--   M:Override(kind, method, fn)      fn(object, original, ...) instead of it
-- and everything a module added here goes away when it turns off (undo runs
-- for each instance). Hooks patch each instance: most components copy their
-- methods onto the frame (Mixin), so a patched method table would miss the
-- frames that exist; their events call self:Method(), so the instance's own
-- method is the one that runs. A hook's error is reported under its module's
-- name and SuuUI's own drawing carries on.
--
-- The registry is an ExtendRegistry: what reports errors (a Reporter), what
-- runs work at the end of the frame (a NextFrame) and what hears that a list
-- changed (a Notifier) come in through interfaces. `registry` is SuuUI's;
-- the module's functions are its methods.

import * as reflect from "wowlua:reflect"
import * as fault from "./Fault"
import * as events from "./Events"

export type Info = { [string]: any }

-- The kinds of SuuUI's UI a plugin reaches (SuuUI.KINDS: their values).
export enum Kind {
    UnitFrame = "unitframe",
    Nameplate = "nameplate",
    CastBar = "castbar",
    AuraContainer = "auracontainer",
    ActionBar = "actionbar",
    ActionButton = "actionbutton",
    Window = "window",
    Inventory = "inventory",
    Tracker = "tracker",
    Cooldowns = "cooldowns",
    Meter = "meter",
    MicroMenu = "micromenu",
    Notification = "notification",
}

export const KINDS: string[] = {}
for _, entry in ipairs(reflect.enumEntries(Kind)) do KINDS[#KINDS + 1] = entry.value end

-- The lists SuuUI's own modules add to (any other name works too).
export enum List {
    MicroMenu = "micromenu",
    GameMenu = "gamemenu",
    NotificationKinds = "notificationkinds",
    RolePresets = "rolepresets",
}

-- What runs work at the end of the frame (`@deferred`: never during the
-- call).
export interface NextFrame
    function run(@deferred fn: () -> ())
end

-- A hidden frame's OnUpdate: the game's next frame.
export class GameNextFrame implements NextFrame
    private readonly frame: Frame
    private due: (() -> ())[] = {}

    constructor()
        self.frame = CreateFrame("Frame")
        self.frame:Hide()
        self.frame:SetScript("OnUpdate", function(f: Frame)
            f:Hide()
            local todo = self.due
            self.due = {}
            for _, fn in ipairs(todo) do fn() end
        end)
    end

    function run(fn: () -> ())
        self.due[#self.due + 1] = fn
        self.frame:Show()
    end
end

type Extender = { fn: (obj: any, info: Info) -> (), undo: ((obj: any, info: Info) -> ())?, owner: any }
type HookEntry = { fn: (...any) -> ...any, owner: any, override: boolean }
type Base = { fn: any, raw: boolean }
-- A kind's instances (object -> info, weak), what runs on them, its hooks
-- (method -> hooks).
type PerKind = { made: { [any]: Info }, extenders: Extender[], hooks: { [string]: HookEntry[] } }
type Queued = { kind: Kind, object: any }
type MenuExtender = { fn: (menu: any, context: any) -> (), owner: any }
type Addition = { item: any, owner: any }

local function ownerName(owner: any): string
    return type(owner) == "table" and owner.name or tostring(owner)
end

export class ExtendRegistry
    private kinds: { [Kind]: PerKind } = {}
    private seq: number = 0 -- the order instances were made in
    -- object -> method -> the method as SuuUI made it
    private bases: { [any]: { [string]: Base } } = setmetatable({}, { __mode = "k" })
    private queue: Queued[] = {}
    private menus: { [string]: MenuExtender[] } = {}
    private lists: { [string]: Addition[] } = {}

    constructor(
        private reporter: fault.Reporter = fault.log,
        private later: NextFrame = GameNextFrame.new(),
        private notifier: events.Notifier = events.bus
    )
        for _, k in ipairs(reflect.enumEntries(Kind)) do
            self.kinds[k.value] = { made = setmetatable({}, { __mode = "k" }), extenders = {}, hooks = {} }
        end
    end

    -- A known kind's tables; an unknown one is the caller's error (level 4:
    -- whoever called the module's function).
    private function per(kind: string): PerKind
        local k = reflect.enumFrom(Kind, kind)
        if k == nil then error(("SuuUI: unknown kind %q (SuuUI.KINDS lists them)"):format(tostring(kind)), 4) end
        return assert(self.kinds[k])
    end

    ----------------------------------------------------------------------------
    -- Hooks: one wrapper per instance and method, rebuilt when hooks change
    ----------------------------------------------------------------------------

    -- The method as SuuUI made it: the instance's own function, or the one
    -- its metatable gives (then restoring means clearing the instance's field).
    private function base(obj: any, method: string): Base
        local mine = self.bases[obj]
        local b = mine and mine[method]
        if b then return b end
        local raw = rawget(obj, method)
        local made: Base = { fn = raw or obj[method], raw = raw ~= nil }
        if not mine then
            mine = {}
            self.bases[obj] = mine
        end
        mine[method] = made
        return made
    end

    private function wrap(obj: any, method: string, chain: HookEntry[])
        local b = self:base(obj, method)
        if type(b.fn) ~= "function" then return end
        if #chain == 0 then
            rawset(obj, method, b.raw and b.fn or nil)
            return
        end
        local reporter = self.reporter
        local fn: (...any) -> ...any = b.fn
        local posts: HookEntry[] = {}
        for _, h in ipairs(chain) do
            if h.override then
                local inner, user, source = fn, h.fn, ownerName(h.owner)
                fn = function(this: any, ...: any): ...any
                    -- an override that fails falls back to what it replaced
                    local res = { reporter:call(source, user, this, inner, ...) }
                    if res[1] then return unpack(res, 2) end
                    return inner(this, ...)
                end
            else
                posts[#posts + 1] = h
            end
        end
        if #posts == 0 then
            rawset(obj, method, fn)
            return
        end
        local inner = fn
        rawset(obj, method, function(this: any, ...: any): (any, any, any, any)
            local a, b2, c, d = inner(this, ...)
            for _, h in ipairs(posts) do reporter:call(ownerName(h.owner), h.fn, this, ...) end
            return a, b2, c, d
        end)
    end

    private function rewrap(p: PerKind, method: string)
        local chain = p.hooks[method] or {}
        for obj in pairs(p.made) do self:wrap(obj, method, chain) end
    end

    ----------------------------------------------------------------------------
    -- Instances
    ----------------------------------------------------------------------------

    -- each's functions for a new instance run at the end of the frame it was
    -- made in, once its module has placed and tagged it.
    private function flush()
        local due = self.queue
        self.queue = {}
        for _, item in ipairs(due) do
            local p = assert(self.kinds[item.kind])
            for _, e in ipairs(p.extenders) do
                self.reporter:call(ownerName(e.owner), e.fn, item.object, p.made[item.object])
            end
        end
    end

    function add(kind: string, object: any, given: Info?): Info?
        local p = self:per(kind)
        if p.made[object] then return nil end
        self.seq += 1
        local i: Info = given or {}
        i.kind, i.seq = kind, self.seq
        p.made[object] = i
        for method, chain in pairs(p.hooks) do self:wrap(object, method, chain) end
        if #p.extenders > 0 then
            if #self.queue == 0 then self.later:run(function() self:flush() end) end
            self.queue[#self.queue + 1] = { kind = kind :: Kind, object = object }
        end
        return i
    end

    -- More about an instance (its module, its role), set by whoever made it.
    function tag(object: any, fields: { [string]: any })
        for _, p in pairs(self.kinds) do
            local i = p.made[object]
            if i then
                for k, v in pairs(fields) do
                    if k ~= "kind" and k ~= "seq" then i[k] = v end
                end
            end
        end
    end

    function info(object: any): Info?
        for _, kind in ipairs(KINDS) do
            local i = assert(self.kinds[kind :: Kind]).made[object]
            if i then return i end
        end
        return nil
    end

    -- The instances of a kind, in the order they were made.
    function list(kind: string): any[]
        local made: { obj: any, seq: number }[] = {}
        for obj, i in pairs(self:per(kind).made) do made[#made + 1] = { obj = obj, seq = i.seq } end
        table.sort(made, function(a: { obj: any, seq: number }, b: { obj: any, seq: number }): boolean return a.seq < b.seq end)
        local out: any[] = {}
        for n, o in ipairs(made) do out[n] = o.obj end
        return out
    end

    ----------------------------------------------------------------------------
    -- What modules add
    ----------------------------------------------------------------------------

    function each(kind: string, fn: (obj: any, info: Info) -> (), undo: ((obj: any, info: Info) -> ())?, owner: any)
        local p = self:per(kind)
        assert(type(fn) == "function", "SuuUI Each: a function is required")
        p.extenders[#p.extenders + 1] = { fn = fn, undo = undo, owner = owner }
        for _, obj in ipairs(self:list(kind)) do
            self.reporter:call(ownerName(owner), fn, obj, p.made[obj])
        end
    end

    private function addHook(kind: string, method: string, fn: (...any) -> ...any, owner: any, replaces: boolean)
        local p = self:per(kind)
        assert(type(method) == "string", "SuuUI Hook: a method name is required")
        assert(type(fn) == "function", "SuuUI Hook: a function is required")
        local entries: HookEntry[] = p.hooks[method] or {}
        p.hooks[method] = entries
        entries[#entries + 1] = { fn = fn, owner = owner, override = replaces }
        self:rewrap(p, method)
    end

    function hook(kind: string, method: string, fn: (...any) -> ...any, owner: any)
        self:addHook(kind, method, fn, owner, false)
    end

    function override(kind: string, method: string, fn: (...any) -> ...any, owner: any)
        self:addHook(kind, method, fn, owner, true)
    end

    ----------------------------------------------------------------------------
    -- Menus and additions
    ----------------------------------------------------------------------------

    -- SuuUI's own right-click menus by id: fn(menu, context) before one
    -- opens, menu = { title, items } (items: { label, onClick, disabled } or
    -- { separator = true }; add, insert or remove).
    function extendMenu(id: string, fn: (menu: any, context: any) -> (), owner: any)
        assert(type(id) == "string" and type(fn) == "function", "SuuUI ExtendMenu: a menu id and a function")
        local entries: MenuExtender[] = self.menus[id] or {}
        self.menus[id] = entries
        entries[#entries + 1] = { fn = fn, owner = owner }
    end

    -- Called by the menu itself as it opens.
    function applyMenu(id: string?, menu: any, context: any?)
        for _, e in ipairs(id and self.menus[id] or {}) do
            self.reporter:call(ownerName(e.owner), e.fn, menu, context or {})
        end
    end

    -- Lists modules add to (List names SuuUI's), told as
    -- SUUUI_ADDITIONS_CHANGED(list) when one changes.
    function addTo(listName: string, item: any, owner: any)
        local entries: Addition[] = self.lists[listName] or {}
        self.lists[listName] = entries
        entries[#entries + 1] = { item = item, owner = owner }
        self.notifier:emit("SUUUI_ADDITIONS_CHANGED", listName)
    end

    function additions(listName: string): any[]
        local out: any[] = {}
        for _, a in ipairs(self.lists[listName] or {}) do out[#out + 1] = a.item end
        return out
    end

    -- Everything an owner added: its hooks come off every instance, its undo
    -- runs for each instance its each reached, its menu extensions and
    -- additions go.
    function unregister(owner: any)
        for _, kind in ipairs(KINDS) do
            local p = assert(self.kinds[kind :: Kind])
            local kept: Extender[] = {}
            for _, e in ipairs(p.extenders) do
                if e.owner == owner then
                    local undo = e.undo
                    if undo then
                        for obj, i in pairs(p.made) do self.reporter:call(ownerName(owner), undo, obj, i) end
                    end
                else
                    kept[#kept + 1] = e
                end
            end
            p.extenders = kept
            for method, entries in pairs(p.hooks) do
                local rest: HookEntry[] = {}
                local changed = false
                for _, h in ipairs(entries) do
                    if h.owner == owner then changed = true else rest[#rest + 1] = h end
                end
                if changed then
                    p.hooks[method] = rest
                    self:rewrap(p, method)
                end
            end
        end
        for id, entries in pairs(self.menus) do
            local kept: MenuExtender[] = {}
            for _, e in ipairs(entries) do if e.owner ~= owner then kept[#kept + 1] = e end end
            self.menus[id] = kept
        end
        for listName, entries in pairs(self.lists) do
            local kept: Addition[] = {}
            for _, a in ipairs(entries) do if a.owner ~= owner then kept[#kept + 1] = a end end
            if #kept ~= #entries then
                self.lists[listName] = kept
                self.notifier:emit("SUUUI_ADDITIONS_CHANGED", listName)
            end
        end
    end
end

-- SuuUI's registry, and its methods as the module's functions.
export const registry = ExtendRegistry.new()

export function add(kind: string, object: any, given: Info?): Info? return registry:add(kind, object, given) end
export function tag(object: any, fields: { [string]: any }) registry:tag(object, fields) end
export function info(object: any): Info? return registry:info(object) end
export function list(kind: string): any[] return registry:list(kind) end
export function each(kind: string, fn: (obj: any, info: Info) -> (), undo: ((obj: any, info: Info) -> ())?, owner: any)
    registry:each(kind, fn, undo, owner)
end
export function hook(kind: string, method: string, fn: (...any) -> ...any, owner: any) registry:hook(kind, method, fn, owner) end
export function override(kind: string, method: string, fn: (...any) -> ...any, owner: any) registry:override(kind, method, fn, owner) end
export function extendMenu(id: string, fn: (menu: any, context: any) -> (), owner: any) registry:extendMenu(id, fn, owner) end
export function applyMenu(id: string?, menu: any, context: any?) registry:applyMenu(id, menu, context) end
export function addTo(listName: string, item: any, owner: any) registry:addTo(listName, item, owner) end
export function additions(listName: string): any[] return registry:additions(listName) end
export function unregister(owner: any) registry:unregister(owner) end
