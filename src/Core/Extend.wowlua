-- Core/Extend.wowlua
-- Plugins reach into SuuUI's own UI (plan 4.3, asked 2026-10-18): every
-- instance of a kind (unit frames, nameplates, cast bars, action buttons…)
-- is registered here when it's made, so a module can
--   M:Each(kind, fn[, undo])          run fn(object, info) on every one, now
--                                     and on each one made later
--   M:Hook(kind, method, fn)          fn(object, ...) after the method
--   M:Override(kind, method, fn)      fn(object, original, ...) instead of it
-- and everything a module added here goes away when it turns off (undo runs
-- for each instance). Hooks patch each instance: most components copy their
-- methods onto the frame (Mixin), so a patched method table would miss the
-- frames that exist; their events call self:Method(), so the instance's own
-- method is the one that runs. A hook's error is reported under its module's
-- name and SuuUI's own drawing carries on.
--
-- The registry is an ExtendRegistry: what reports errors (a Reporter), what
-- runs work at the end of the frame (a NextFrame) and what hears that a list
-- changed (a Notifier) come in through interfaces. `registry` is SuuUI's;
-- the module's functions are its methods.

import * as reflect from "wowlua:reflect"
import * as tbl from "wowlua:table"
import * as fault from "./Fault"
import * as events from "./Events"
import type UnitFrame from "/UI/UnitFrame"
import type CastBar from "/UI/CastBar"
import type UnitAuras from "/UI/Auras"
import type ActionBar from "/UI/ActionBar"
import type TotemBar from "/UI/ClassBars"
import type ActionButton from "/UI/ActionButton"
import type WindowFrame from "/UI/Panel"
import type WindowChrome from "/UI/WindowSkin"
import type Inventory from "/UI/Inventory"
import type ObjectiveTracker from "/UI/ObjectiveTracker"
import type CooldownTracker from "/UI/CooldownTracker"
import type DamageMeter from "/UI/DamageMeter"
import type ThreatMeter from "/UI/ThreatMeter"
import type MicroMenu from "/UI/MicroMenu"
import type Notification from "/UI/Notification"

-- An instance a plugin reaches: one of SuuUI's frames or class instances.
export type Instance = table

-- What its maker and plugins tell about an instance (SuuUI.InstanceInfo,
-- Docs/API.md); a plugin may add fields of its own.
export type Tags = {
    module?: string, role?: string, unit?: string, name?: string, preview?: boolean,
    meter?: string, totems?: boolean, skinned?: Frame,
    [string]: unknown,
}
export type Info = {
    kind: string, seq: number,
    module?: string, role?: string, unit?: string, name?: string, preview?: boolean,
    meter?: string, totems?: boolean, skinned?: Frame,
    [string]: unknown,
}

-- What the instances of each of SuuUI's kinds are, for a plugin's
-- M:Each, M:Hook, M:Override and SuuUI.Instances (a kind of a plugin's
-- own, and nameplates, are an Instance).
export type KindInstances = {
    unitframe: UnitFrame, castbar: CastBar, auracontainer: UnitAuras,
    actionbar: ActionBar | TotemBar, actionbutton: ActionButton,
    window: WindowFrame | WindowChrome, inventory: Inventory, tracker: ObjectiveTracker,
    cooldowns: CooldownTracker, meter: DamageMeter | ThreatMeter, micromenu: MicroMenu,
    notification: Notification,
    [string]: Instance,
}
export type Kinds = keyof KindInstances

-- each's function, and its undo.
export type Extender = (obj: Instance, info: Info) -> ()
-- A method of an instance, and what replaces or follows one: an override
-- gets the original, a hook the method's arguments after it ran.
export type Method = (this: Instance, ...unknown) -> ...unknown
export type Override = (this: Instance, original: Method, ...unknown) -> ...unknown
export type Hook = (this: Instance, ...unknown) -> ()

-- One of SuuUI's right-click menus as it opens (UI/ContextMenu).
export type MenuItem = { label?: string, onClick?: () -> (), disabled?: boolean, separator?: boolean }
export type Menu = { title?: string, items: MenuItem[], [string]: unknown }
-- what the menu is about: a unit, a row, anything its opener says
export type MenuContext = unknown
export type MenuExtension = (menu: Menu, context: MenuContext) -> ()

-- The kinds of SuuUI's UI a plugin reaches (SuuUI.KINDS: their values).
export enum Kind {
    UnitFrame = "unitframe",
    Nameplate = "nameplate",
    CastBar = "castbar",
    AuraContainer = "auracontainer",
    ActionBar = "actionbar",
    ActionButton = "actionbutton",
    Window = "window",
    Inventory = "inventory",
    Tracker = "tracker",
    Cooldowns = "cooldowns",
    Meter = "meter",
    MicroMenu = "micromenu",
    Notification = "notification",
}

export const KINDS: string[] = {}
for _, entry in ipairs(reflect.enumEntries(Kind)) do KINDS[#KINDS + 1] = entry.value end

-- The lists SuuUI's own modules add to (any other name works too).
export enum List {
    MicroMenu = "micromenu",
    GameMenu = "gamemenu",
    NotificationKinds = "notificationkinds",
    RolePresets = "rolepresets",
}

-- A module's settings for a role's preset (M:AddToRolePreset: the only
-- thing added to List.RolePresets).
export type RolePreset = { role: string, namespace: string, values: { [string]: unknown } }

-- What runs work at the end of the frame (`@deferred`: never during the
-- call).
export interface NextFrame
    function run(@deferred fn: () -> ())
end

-- A hidden frame's OnUpdate: the game's next frame.
export class GameNextFrame implements NextFrame
    private readonly frame: Frame
    private due: (() -> ())[] = {}

    constructor()
        self.frame = CreateFrame("Frame")
        self.frame:Hide()
        self.frame:SetScript("OnUpdate", function(f: Frame)
            f:Hide()
            local todo = self.due
            self.due = {}
            for _, fn in ipairs(todo) do fn() end
        end)
    end

    function run(fn: () -> ())
        self.due[#self.due + 1] = fn
        self.frame:Show()
    end
end

type Each = { fn: Extender, undo: Extender?, owner: unknown }
-- a hook (`after`) or an override (`instead`)
type HookEntry = { after: Hook?, instead: Override?, owner: unknown }
type Base = { fn: unknown, raw: boolean }
-- A kind's instances (object -> info, weak), what runs on them, its hooks
-- (method -> hooks).
type PerKind = { made: { [Instance]: Info }, extenders: Each[], hooks: { [string]: HookEntry[] } }
type Queued = { kind: Kind, object: Instance }
type MenuExtender = { fn: MenuExtension, owner: unknown }
type Addition = { item: unknown, owner: unknown }
type Made = { obj: Instance, seq: number }


local function ownerName(owner: unknown): string
    local name = tbl.field(owner, "name")
    return type(name) == "string" and name or tostring(owner)
end

export class ExtendRegistry
    private kinds: { [Kind]: PerKind } = {}
    private seq: number = 0 -- the order instances were made in
    -- object -> method -> the method as SuuUI made it
    private bases: { [Instance]: { [string]: Base } } = setmetatable({}, { __mode = "k" })
    private queue: Queued[] = {}
    private menus: { [string]: MenuExtender[] } = {}
    private lists: { [string]: Addition[] } = {}

    constructor(
        private reporter: fault.Reporter = fault.log,
        private later: NextFrame = GameNextFrame.new(),
        private notifier: events.Notifier = events.bus
    )
        for _, k in ipairs(reflect.enumEntries(Kind)) do
            self.kinds[k.value] = { made = setmetatable({}, { __mode = "k" }), extenders = {}, hooks = {} }
        end
    end

    -- A known kind's tables; an unknown one is the caller's error (level 4:
    -- whoever called the module's function).
    private function per(kind: string): PerKind
        local k = reflect.enumFrom(Kind, kind)
        if k == nil then error(("SuuUI: unknown kind %q (SuuUI.KINDS lists them)"):format(tostring(kind)), 4) end
        return assert(self.kinds[k])
    end

    ----------------------------------------------------------------------------
    -- Hooks: one wrapper per instance and method, rebuilt when hooks change
    ----------------------------------------------------------------------------

    -- The method as SuuUI made it: the instance's own function, or the one
    -- its metatable gives (then restoring means clearing the instance's field).
    private function base(obj: Instance, method: string): Base
        local mine = self.bases[obj]
        local b = mine and mine[method]
        if b then return b end
        local raw: unknown = rawget(obj, method)
        local made: Base = { fn = raw or obj[method], raw = raw ~= nil }
        if not mine then
            mine = {}
            self.bases[obj] = mine
        end
        mine[method] = made
        return made
    end

    private function wrap(obj: Instance, method: string, chain: HookEntry[])
        local b = self:base(obj, method)
        local made = b.fn
        if type(made) ~= "function" then return end
        if #chain == 0 then
            rawset(obj, method, b.raw and made or nil)
            return
        end
        local reporter = self.reporter
        local fn = made :: Method
        local posts: Hook[] = {}
        local postOwners: unknown[] = {}
        for _, h in ipairs(chain) do
            local instead, after = h.instead, h.after
            if instead then
                local inner, source = fn, ownerName(h.owner)
                fn = function(this: Instance, ...: unknown): ...unknown
                    -- an override that fails falls back to what it replaced
                    local res = { reporter:call(source, instead, this, inner, ...) }
                    if res[1] then return unpack(res, 2) end
                    return inner(this, ...)
                end
            elseif after then
                posts[#posts + 1] = after
                postOwners[#posts] = h.owner
            end
        end
        if #posts == 0 then
            rawset(obj, method, fn)
            return
        end
        local inner = fn
        rawset(obj, method, function(this: Instance, ...: unknown): (unknown, unknown, unknown, unknown)
            local a, b2, c, d = inner(this, ...)
            for i, post in ipairs(posts) do reporter:call(ownerName(postOwners[i]), post, this, ...) end
            return a, b2, c, d
        end)
    end

    private function rewrap(p: PerKind, method: string)
        local chain = p.hooks[method] or {}
        for obj in pairs(p.made) do self:wrap(obj, method, chain) end
    end

    ----------------------------------------------------------------------------
    -- Instances
    ----------------------------------------------------------------------------

    -- each's functions for a new instance run at the end of the frame it was
    -- made in, once its module has placed and tagged it.
    private function flush()
        local due = self.queue
        self.queue = {}
        for _, item in ipairs(due) do
            local p = assert(self.kinds[item.kind])
            for _, e in ipairs(p.extenders) do
                local i = p.made[item.object]
                if i then self.reporter:call(ownerName(e.owner), e.fn, item.object, i) end
            end
        end
    end

    function add(kind: string, object: Instance, given: Tags?): Info?
        local p = self:per(kind)
        if p.made[object] then return nil end
        self.seq += 1
        -- the table given becomes the info (its maker may keep it)
        local i = (given or {}) :: Info
        i.kind, i.seq = kind, self.seq
        p.made[object] = i
        for method, chain in pairs(p.hooks) do self:wrap(object, method, chain) end
        if #p.extenders > 0 then
            if #self.queue == 0 then self.later:run(function() self:flush() end) end
            self.queue[#self.queue + 1] = { kind = kind :: Kind, object = object }
        end
        return i
    end

    -- More about an instance (its module, its role), set by whoever made it.
    function tag(object: Instance, fields: Tags)
        for _, p in pairs(self.kinds) do
            local i = p.made[object]
            if i then
                for k, v in pairs(fields) do
                    if k ~= "kind" and k ~= "seq" then rawset(i, k, v) end
                end
            end
        end
    end

    function info(object: Instance): Info?
        for _, kind in ipairs(KINDS) do
            local i = assert(self.kinds[kind :: Kind]).made[object]
            if i then return i end
        end
        return nil
    end

    -- The instances of a kind, in the order they were made.
    function list(kind: string): Instance[]
        local made: Made[] = {}
        for obj, i in pairs(self:per(kind).made) do made[#made + 1] = { obj = obj, seq = i.seq } end
        table.sort(made, function(a: Made, b: Made): boolean return a.seq < b.seq end)
        local out: Instance[] = {}
        for n, o in ipairs(made) do out[n] = o.obj end
        return out
    end

    ----------------------------------------------------------------------------
    -- What modules add
    ----------------------------------------------------------------------------

    function each(kind: string, fn: Extender, undo: Extender?, owner: unknown)
        local p = self:per(kind)
        assert(type(fn) == "function", "SuuUI Each: a function is required")
        p.extenders[#p.extenders + 1] = { fn = fn, undo = undo, owner = owner }
        for _, obj in ipairs(self:list(kind)) do
            local i = p.made[obj]
            if i then self.reporter:call(ownerName(owner), fn, obj, i) end
        end
    end

    private function addHook(kind: string, method: string, entry: HookEntry, fn: unknown)
        local p = self:per(kind)
        assert(type(method) == "string", "SuuUI Hook: a method name is required")
        assert(type(fn) == "function", "SuuUI Hook: a function is required")
        local entries: HookEntry[] = p.hooks[method] or {}
        p.hooks[method] = entries
        entries[#entries + 1] = entry
        self:rewrap(p, method)
    end

    function hook(kind: string, method: string, fn: Hook, owner: unknown)
        self:addHook(kind, method, { after = fn, instead = nil, owner = owner }, fn)
    end

    function override(kind: string, method: string, fn: Override, owner: unknown)
        self:addHook(kind, method, { after = nil, instead = fn, owner = owner }, fn)
    end

    ----------------------------------------------------------------------------
    -- Menus and additions
    ----------------------------------------------------------------------------

    -- SuuUI's own right-click menus by id: fn(menu, context) before one
    -- opens, menu = { title, items } (items: { label, onClick, disabled } or
    -- { separator = true }; add, insert or remove).
    function extendMenu(id: string, fn: MenuExtension, owner: unknown)
        assert(type(id) == "string" and type(fn) == "function", "SuuUI ExtendMenu: a menu id and a function")
        local entries: MenuExtender[] = self.menus[id] or {}
        self.menus[id] = entries
        entries[#entries + 1] = { fn = fn, owner = owner }
    end

    -- Called by the menu itself as it opens.
    function applyMenu(id: string?, menu: Menu, context: MenuContext?)
        for _, e in ipairs(id and self.menus[id] or {}) do
            self.reporter:call(ownerName(e.owner), e.fn, menu, context or {})
        end
    end

    -- Lists modules add to (List names SuuUI's), told as
    -- SUUUI_ADDITIONS_CHANGED(list) when one changes.
    function addTo(listName: string, item: unknown, owner: unknown)
        local entries: Addition[] = self.lists[listName] or {}
        self.lists[listName] = entries
        entries[#entries + 1] = { item = item, owner = owner }
        self.notifier:emit("SUUUI_ADDITIONS_CHANGED", listName)
    end

    -- What was added, as it was given: whoever reads a list checks its items.
    function additions(listName: string): unknown[]
        local out: unknown[] = {}
        for _, a in ipairs(self.lists[listName] or {}) do out[#out + 1] = a.item end
        return out
    end

    -- Everything an owner added: its hooks come off every instance, its undo
    -- runs for each instance its each reached, its menu extensions and
    -- additions go.
    function unregister(owner: unknown)
        for _, kind in ipairs(KINDS) do
            local p = assert(self.kinds[kind :: Kind])
            local kept: Each[] = {}
            for _, e in ipairs(p.extenders) do
                if e.owner == owner then
                    local undo = e.undo
                    if undo then
                        for obj, i in pairs(p.made) do self.reporter:call(ownerName(owner), undo, obj, i) end
                    end
                else
                    kept[#kept + 1] = e
                end
            end
            p.extenders = kept
            for method, entries in pairs(p.hooks) do
                local rest: HookEntry[] = {}
                local changed = false
                for _, h in ipairs(entries) do
                    if h.owner == owner then changed = true else rest[#rest + 1] = h end
                end
                if changed then
                    p.hooks[method] = rest
                    self:rewrap(p, method)
                end
            end
        end
        for id, entries in pairs(self.menus) do
            local kept: MenuExtender[] = {}
            for _, e in ipairs(entries) do if e.owner ~= owner then kept[#kept + 1] = e end end
            self.menus[id] = kept
        end
        for listName, entries in pairs(self.lists) do
            local kept: Addition[] = {}
            for _, a in ipairs(entries) do if a.owner ~= owner then kept[#kept + 1] = a end end
            if #kept ~= #entries then
                self.lists[listName] = kept
                self.notifier:emit("SUUUI_ADDITIONS_CHANGED", listName)
            end
        end
    end
end

-- SuuUI's registry, and its methods as the module's functions.
export const registry = ExtendRegistry.new()

export function add(kind: string, object: Instance, given: Tags?): Info? return registry:add(kind, object, given) end
export function tag(object: Instance, fields: Tags) registry:tag(object, fields) end
export function info(object: Instance): Info? return registry:info(object) end
-- (typed by kind: the registry keeps every kind's instances alike)
export function list<K extends Kinds>(kind: K): KindInstances[K][]
    return registry:list(kind) :: unknown :: KindInstances[K][]
end
export function eachOf<K extends Kinds>(kind: K, fn: (obj: KindInstances[K], info: Info) -> (),
        undo: ((obj: KindInstances[K], info: Info) -> ())?, owner: unknown)
    registry:each(kind, fn :: unknown :: Extender, undo :: unknown :: Extender?, owner)
end
export function hookOf<K extends Kinds>(kind: K, method: string, fn: (this: KindInstances[K], ...unknown) -> (), owner: unknown)
    registry:hook(kind, method, fn :: unknown :: Hook, owner)
end
export function overrideOf<K extends Kinds>(kind: K, method: string,
        fn: (this: KindInstances[K], original: Method, ...unknown) -> ...unknown, owner: unknown)
    registry:override(kind, method, fn :: unknown :: Override, owner)
end
export function each(kind: string, fn: Extender, undo: Extender?, owner: unknown)
    registry:each(kind, fn, undo, owner)
end
export function hook(kind: string, method: string, fn: Hook, owner: unknown) registry:hook(kind, method, fn, owner) end
export function override(kind: string, method: string, fn: Override, owner: unknown) registry:override(kind, method, fn, owner) end
export function extendMenu(id: string, fn: MenuExtension, owner: unknown) registry:extendMenu(id, fn, owner) end
export function applyMenu(id: string?, menu: Menu, context: MenuContext?) registry:applyMenu(id, menu, context) end
export function addTo(listName: string, item: unknown, owner: unknown) registry:addTo(listName, item, owner) end
export function additions(listName: string): unknown[] return registry:additions(listName) end
export function unregister(owner: unknown) registry:unregister(owner) end
