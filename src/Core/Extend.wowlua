-- Core/Extend.wowlua
-- Plugins reach into SuuUI's own UI (plan 4.3, asked 2026-10-18): every
-- instance of a kind (unit frames, nameplates, cast bars, action buttons…)
-- is registered here when it's made, so a module can
--   M:Each(kind, fn[, undo])          run fn(object, info) on every one, now
--                                     and on each one made later
--   M:Hook(kind, method, fn)          fn(object, ...) after the method
--   M:Override(kind, method, fn)      fn(object, original, ...) instead of it
-- and everything a module added here goes away when it turns off (undo runs
-- for each instance). Hooks patch each instance: most components copy their
-- methods onto the frame (Mixin), so a patched method table would miss the
-- frames that exist; their events call self:Method(), so the instance's own
-- method is the one that runs. A hook's error is reported under its module's
-- name and SuuUI's own drawing carries on.

import * as fault from "./Fault"
import * as events from "./Events"

export type Info = { [string]: any }

export const KINDS: string[] = {
    "unitframe", "nameplate", "castbar", "auracontainer", "actionbar", "actionbutton",
    "window", "inventory", "tracker", "cooldowns", "meter", "micromenu", "notification",
}
local known: { [string]: boolean } = {}
for _, k in ipairs(KINDS) do known[k] = true end

type Extender = { fn: (obj: any, info: Info) -> (), undo: ((obj: any, info: Info) -> ())?, owner: any }
type HookEntry = { fn: (...any) -> ...any, owner: any, override: boolean }
type Base = { fn: any, raw: boolean }

local instances: { [string]: { [any]: Info } } = {} -- kind -> { [object] = info } (weak)
local seq = 0        -- the order instances were made in
local extenders: { [string]: Extender[] } = {}
local hooks: { [string]: { [string]: HookEntry[] } } = {} -- kind -> method -> hooks
local bases: { [any]: { [string]: Base } } = setmetatable({}, { __mode = "k" }) -- object -> method -> base

for _, k in ipairs(KINDS) do
    instances[k] = setmetatable({}, { __mode = "k" })
    extenders[k], hooks[k] = {}, {}
end

-- the tables of a known kind (filled above for every kind)
local function inst(kind: string): { [any]: Info } return assert(instances[kind]) end
local function ext(kind: string): Extender[] return assert(extenders[kind]) end
local function hk(kind: string): { [string]: HookEntry[] } return assert(hooks[kind]) end

local function check(kind: string)
    if not known[kind] then error(("SuuUI: unknown kind %q (SuuUI.KINDS lists them)"):format(tostring(kind)), 3) end
end

local function ownerName(owner: any): string
    return type(owner) == "table" and owner.name or tostring(owner)
end

--------------------------------------------------------------------------------
-- Hooks: one wrapper per instance and method, rebuilt when hooks change
--------------------------------------------------------------------------------

-- The method as SuuUI made it: the instance's own function, or the one its
-- metatable gives (then restoring means clearing the instance's field).
local function base(obj: any, method: string): Base
    local mine = bases[obj]
    local b = mine and mine[method]
    if b then return b end
    local raw = rawget(obj, method)
    local made: Base = { fn = raw or obj[method], raw = raw ~= nil }
    if not mine then
        mine = {}
        bases[obj] = mine
    end
    mine[method] = made
    return made
end

local function wrap(obj: any, method: string, list: HookEntry[])
    local b = base(obj, method)
    if type(b.fn) ~= "function" then return end
    if #list == 0 then
        rawset(obj, method, b.raw and b.fn or nil)
        return
    end
    local fn: (...any) -> ...any = b.fn
    local posts: HookEntry[] = {}
    for _, h in ipairs(list) do
        if h.override then
            local inner, user, source = fn, h.fn, ownerName(h.owner)
            fn = function(self: any, ...: any): ...any
                -- an override that fails falls back to what it replaced
                local res = { fault.call(source, user, self, inner, ...) }
                if res[1] then return unpack(res, 2) end
                return inner(self, ...)
            end
        else
            posts[#posts + 1] = h
        end
    end
    if #posts == 0 then
        rawset(obj, method, fn)
        return
    end
    local inner = fn
    rawset(obj, method, function(self: any, ...: any): (any, any, any, any)
        local a, b2, c, d = inner(self, ...)
        for _, h in ipairs(posts) do fault.call(ownerName(h.owner), h.fn, self, ...) end
        return a, b2, c, d
    end)
end

local function rewrap(kind: string, method: string)
    local list = hk(kind)[method] or {}
    for obj in pairs(inst(kind)) do wrap(obj, method, list) end
end

--------------------------------------------------------------------------------
-- Instances
--------------------------------------------------------------------------------

-- each's functions for a new instance run at the end of the frame it was
-- made in, once its module has placed and tagged it.
type Queued = { kind: string, object: any }
local queue: Queued[] = {}
local runner = CreateFrame("Frame")
runner:Hide()
runner:SetScript("OnUpdate", function(self: Frame)
    self:Hide()
    local list = queue
    queue = {}
    for _, item in ipairs(list) do
        for _, e in ipairs(ext(item.kind)) do
            fault.call(ownerName(e.owner), e.fn, item.object, inst(item.kind)[item.object])
        end
    end
end)

export function add(kind: string, object: any, info: Info?): Info?
    check(kind)
    if inst(kind)[object] then return nil end
    seq += 1
    local i: Info = info or {}
    i.kind, i.seq = kind, seq
    inst(kind)[object] = i
    for method, list in pairs(hk(kind)) do wrap(object, method, list) end
    if #ext(kind) > 0 then
        queue[#queue + 1] = { kind = kind, object = object }
        runner:Show()
    end
    return i
end

-- More about an instance (its module, its role), set by whoever made it.
export function tag(object: any, fields: { [string]: any })
    for _, kind in ipairs(KINDS) do
        local i = inst(kind)[object]
        if i then
            for k, v in pairs(fields) do
                if k ~= "kind" and k ~= "seq" then i[k] = v end
            end
        end
    end
end

export function info(object: any): Info?
    for _, kind in ipairs(KINDS) do
        local i = inst(kind)[object]
        if i then return i end
    end
    return nil
end

-- The instances of a kind, in the order they were made.
export function list(kind: string): any[]
    check(kind)
    local made: { obj: any, seq: number }[] = {}
    for obj, i in pairs(inst(kind)) do made[#made + 1] = { obj = obj, seq = i.seq } end
    table.sort(made, function(a: { obj: any, seq: number }, b: { obj: any, seq: number }): boolean return a.seq < b.seq end)
    local out: any[] = {}
    for n, o in ipairs(made) do out[n] = o.obj end
    return out
end

--------------------------------------------------------------------------------
-- What modules add
--------------------------------------------------------------------------------

export function each(kind: string, fn: (obj: any, info: Info) -> (), undo: ((obj: any, info: Info) -> ())?, owner: any)
    check(kind)
    assert(type(fn) == "function", "SuuUI Each: a function is required")
    ext(kind)[#ext(kind) + 1] = { fn = fn, undo = undo, owner = owner }
    for _, obj in ipairs(list(kind)) do
        fault.call(ownerName(owner), fn, obj, inst(kind)[obj])
    end
end

local function addHook(kind: string, method: string, fn: (...any) -> ...any, owner: any, override: boolean)
    check(kind)
    assert(type(method) == "string", "SuuUI Hook: a method name is required")
    assert(type(fn) == "function", "SuuUI Hook: a function is required")
    local entries: HookEntry[] = hk(kind)[method] or {}
    hk(kind)[method] = entries
    entries[#entries + 1] = { fn = fn, owner = owner, override = override }
    rewrap(kind, method)
end

export function hook(kind: string, method: string, fn: (...any) -> ...any, owner: any) addHook(kind, method, fn, owner, false) end
export function override(kind: string, method: string, fn: (...any) -> ...any, owner: any) addHook(kind, method, fn, owner, true) end

--------------------------------------------------------------------------------
-- Menus and additions
--------------------------------------------------------------------------------

-- SuuUI's own right-click menus by id: fn(menu, context) before one opens,
-- menu = { title, items } (items: { label, onClick, disabled } or
-- { separator = true }; add, insert or remove).
type MenuExtender = { fn: (menu: any, context: any) -> (), owner: any }
local menus: { [string]: MenuExtender[] } = {}

export function extendMenu(id: string, fn: (menu: any, context: any) -> (), owner: any)
    assert(type(id) == "string" and type(fn) == "function", "SuuUI ExtendMenu: a menu id and a function")
    local entries: MenuExtender[] = menus[id] or {}
    menus[id] = entries
    entries[#entries + 1] = { fn = fn, owner = owner }
end

-- Called by the menu itself as it opens.
export function applyMenu(id: string?, menu: any, context: any?)
    for _, e in ipairs(id and menus[id] or {}) do
        fault.call(ownerName(e.owner), e.fn, menu, context or {})
    end
end

-- Lists modules add to: "micromenu" (buttons), "gamemenu" (entries),
-- "notificationkinds" (popups as cards), "rolepresets" (a module's own
-- settings per role). SUUUI_ADDITIONS_CHANGED(list) when one changes.
type Addition = { item: any, owner: any }
local additionLists: { [string]: Addition[] } = {}

export function addTo(listName: string, item: any, owner: any)
    local entries: Addition[] = additionLists[listName] or {}
    additionLists[listName] = entries
    entries[#entries + 1] = { item = item, owner = owner }
    events.emit("SUUUI_ADDITIONS_CHANGED", listName)
end

export function additions(listName: string): any[]
    local out: any[] = {}
    for _, a in ipairs(additionLists[listName] or {}) do out[#out + 1] = a.item end
    return out
end

-- Everything an owner added: its hooks come off every instance, its undo
-- runs for each instance its each reached, its menu extensions and
-- additions go.
export function unregister(owner: any)
    for _, kind in ipairs(KINDS) do
        local kept: Extender[] = {}
        for _, e in ipairs(ext(kind)) do
            if e.owner == owner then
                local undo = e.undo
                if undo then
                    for obj, i in pairs(inst(kind)) do fault.call(ownerName(owner), undo, obj, i) end
                end
            else
                kept[#kept + 1] = e
            end
        end
        extenders[kind] = kept
        for method, entries in pairs(hk(kind)) do
            local rest: HookEntry[] = {}
            local changed = false
            for _, h in ipairs(entries) do
                if h.owner == owner then changed = true else rest[#rest + 1] = h end
            end
            if changed then
                hk(kind)[method] = rest
                rewrap(kind, method)
            end
        end
    end
    for id, entries in pairs(menus) do
        local kept: MenuExtender[] = {}
        for _, e in ipairs(entries) do if e.owner ~= owner then kept[#kept + 1] = e end end
        menus[id] = kept
    end
    for listName, entries in pairs(additionLists) do
        local kept: Addition[] = {}
        for _, a in ipairs(entries) do if a.owner ~= owner then kept[#kept + 1] = a end end
        if #kept ~= #entries then
            additionLists[listName] = kept
            events.emit("SUUUI_ADDITIONS_CHANGED", listName)
        end
    end
end
