-- Core/Motion.wowlua
-- The design's motion presets as AnimationGroups. Motion only ever decorates:
-- a value is always set at once, and an animation never delays it. With
-- ui.reducedMotion on, every preset jumps straight to its end state.
--
--   fadeIn(frame[, duration])  alpha 0 -> 1 (default dur-base, ease-out)
--   enter(frame[, duration])   the alert's enter: 6px drop and fade (dur-base)
--   pop(frame)                 a ready cooldown: scale 0.86 -> 1, alpha 0.4 -> 1 (dur-base)
--   stop(frame)

import tokens as T from "./Tokens"
import * as settings from "./Settings"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import type Easings from "./Tokens"

local function isReduced(): boolean
    return settings.ready() and settings.get("ui", "reducedMotion") and true or false
end

-- Whether ui.reducedMotion is on: for motion of a caller's own (0.17).
export function reduced(): boolean
    return isReduced()
end

local function smoothing(easing: keyof Easings): SmoothingType
    return T.easing[easing].smoothing :: SmoothingType
end

type Fade = { from: number, to: number, start: number, duration: number }

-- Running alphaTo fades.
local fades: { [Region]: Fade } = {}

-- A preset's AnimationGroup on a frame, and the animations a later play
-- adjusts (their duration).
export type Preset = { group: AnimationGroup, alpha?: Alpha, down?: Translation }

-- Each frame's presets, built on first use.
local built: { [Region]: { [string]: Preset } } = tbl.weakKeys()

-- The presets built on a frame so far (none: nil).
export function presetsOf(frame: Region): { [string]: Preset }?
    return built[frame]
end

local function preset(frame: Region, name: string, build: (g: AnimationGroup, p: Preset) -> ()): Preset
    local mine = built[frame] or {}
    built[frame] = mine
    local p = mine[name]
    if not p then
        local g = frame:CreateAnimationGroup()
        p = { group = g }
        build(g, p)
        g:SetScript("OnFinished", function()
            frame:SetAlpha(1)
        end)
        mine[name] = p
    end
    return p
end

export function stop(frame: Region)
    for _, p in pairs(built[frame] or {}) do
        p.group:Stop()
    end
    fades[frame] = nil -- a running alphaTo would override the alpha set here
    frame:SetAlpha(1)
end

export function fadeIn(frame: Region, duration: number?)
    stop(frame)
    if isReduced() then
        return
    end
    local p = preset(frame, "fadeIn", function(g: AnimationGroup, kept: Preset)
        local a = g:CreateAnimation("Alpha")
        a:SetFromAlpha(0)
        a:SetToAlpha(1)
        a:SetSmoothing(smoothing("ease-out"))
        kept.alpha = a
    end)
    local a = p.alpha
    if a then
        a:SetDuration(duration or T.duration["dur-base"])
    end
    p.group:Play()
end

export function enter(frame: Region, duration: number?)
    stop(frame)
    if isReduced() then
        return
    end
    local p = preset(frame, "enter", function(g: AnimationGroup, kept: Preset)
        -- Jump 6px up instantly, then move back down while fading in.
        local up = g:CreateAnimation("Translation")
        up:SetOffset(0, 6)
        up:SetDuration(0)
        up:SetOrder(1)
        local down = g:CreateAnimation("Translation")
        down:SetOffset(0, -6)
        down:SetSmoothing(smoothing("ease-out"))
        down:SetOrder(2)
        local a = g:CreateAnimation("Alpha")
        a:SetFromAlpha(0)
        a:SetToAlpha(1)
        a:SetSmoothing(smoothing("ease-out"))
        a:SetOrder(2)
        kept.down, kept.alpha = down, a
    end)
    local d = duration or T.duration["dur-base"]
    local down, a = p.down, p.alpha
    if down then
        down:SetDuration(d)
    end
    if a then
        a:SetDuration(d)
    end
    p.group:Play()
end

-- Fades `frame` from its current alpha to `to` over `duration` (ease-out).
-- One shared driver runs every fade, so it also works on secure frames,
-- whose scripts can't be set in combat (alpha itself is never protected).
local driver = CreateFrame("Frame")
driver:Hide()
driver:SetScript("OnUpdate", function(self: Frame)
    local now, any = GetTime(), false
    for frame, f in pairs(fades) do
        local t = math.min(1, (now - f.start) / f.duration)
        local e = 1 - (1 - t) ^ 3
        frame:SetAlpha(f.from + (f.to - f.from) * e)
        if t >= 1 then
            fades[frame] = nil
        else
            any = true
        end
    end
    if not any then
        self:Hide()
    end
end)

export function alphaTo(frame: Region, to: number, duration: number?)
    local d = duration or T.duration["dur-slow"]
    -- once a frame's alpha was set from a secret (the unit frames' resting
    -- alpha), the game reads it back secret for good (found in game): no
    -- fade can start from it, so the alpha is set at once
    local from = secret.asNumber(frame:GetAlpha())
    if not from or isReduced() or d <= 0 or math.abs(from - to) < 0.01 then
        fades[frame] = nil
        frame:SetAlpha(to)
        return
    end
    local f = fades[frame]
    if f and f.to == to then
        return
    end
    fades[frame] = { from = from, to = to, start = GetTime(), duration = d }
    driver:Show()
end

export function pop(frame: Region)
    stop(frame)
    if isReduced() then
        return
    end
    local p = preset(frame, "pop", function(g: AnimationGroup, _: Preset)
        local s = g:CreateAnimation("Scale")
        s:SetScaleFrom(0.86, 0.86)
        s:SetScaleTo(1, 1)
        s:SetDuration(T.duration["dur-base"])
        s:SetSmoothing(smoothing("ease-out"))
        local a = g:CreateAnimation("Alpha")
        a:SetFromAlpha(0.4)
        a:SetToAlpha(1)
        a:SetDuration(T.duration["dur-base"])
        a:SetSmoothing(smoothing("ease-out"))
    end)
    p.group:Play()
end
