-- Core/DB.wowlua
-- SuuUI's SavedVariables, bound through wowlua:saved: SuuUIDB (settings,
-- profiles, characters' data, the error log) and SuuUIProbe (what the
-- probes and /suu perf record). wowlua:saved loads them before any
-- @onLoad hook runs and points the globals at these tables, so WoW saves
-- them. Their shape is SuuUI's own (Core/Settings.wowlua); saved adds only
-- its `__version` key, and neither defaults nor stripping are used, so the
-- data is written back exactly as SuuUI left it.

import * as saved from "wowlua:saved"

export const db: { [string]: unknown } = saved.bind("SuuUIDB", {
    version = 1,
    defaults = {} :: { [string]: unknown },
    stripDefaults = false,
})

export const probe: { [string]: unknown } = saved.bind("SuuUIProbe", {
    version = 1,
    defaults = {} :: { [string]: unknown },
    stripDefaults = false,
})

-- Whether the SavedVariables have loaded (before that, touching db or
-- probe raises an error).
export function loaded(): boolean
    return saved.handle(db):isLoaded()
end

-- A list kept in SuuUIDB (`key`: "errors", "blocked", …), made when it
-- isn't there yet: the same table each time, to add to.
export function list(key: string): unknown[]
    local t = db[key]
    if type(t) ~= "table" then
        local made: unknown[] = {}
        db[key] = made
        return made
    end
    return t :: unknown[]
end

-- A probe's own record in SuuUIProbe (`key`: "givers", …), typed by the
-- probe: `make` gives it the first time, and the probe's earlier one comes
-- back after that (SuuUI wrote it, so it has the probe's shape).
export function probeData<T extends table>(key: string, make: () -> T): T
    if type(probe[key]) == "table" then return probe[key] :: T end
    local made = make()
    probe[key] = made
    return made
end
