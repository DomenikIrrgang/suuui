-- Karazhan
--------------------------------------------------------------------------------

-- A: Medivh's library. Bookshelves behind the titles, books and a candle on
-- the windows' corner, a silk bookmark, arcane dust; a stone ring and a
-- raven on the minimap, an inkwell on chat, one small candle on the unit
-- frames. Script in the bars, lancet windows in the ground; the icons
-- drawn with a broad nib.
do
    local dir = ROOT .. "KarazhanA\\"
    register({
        id = "concept-karazhan-a",
        name = "Karazhan · A (Medivh's library)",
        description = "Concept: bookshelves, candles and a raven; arcane violet on dark plum, icons drawn with a broad nib.",
        colors = colors({
            ["surface"] = "#1A0D17",
            ["surface-glass"] = "#1A0D17F7",
            ["surface-sunk"] = "#180D17",
            ["surface-raised"] = "#22141E",
            ["track"] = "#281C27",
            ["gilt"] = "#8C6EBD",
            ["gilt-text"] = "#CACAEB",
            ["gilt-line"] = "#8C6EBD8A",
            ["gilt-hairline"] = "#8C6EBD6E",
            ["gilt-faint"] = "#8C6EBD33",
            ["ink"] = "#EBEAF3",
            ["ink-muted"] = "#A09CA8",
            ["ink-faint"] = "#77727D",
            ["unit-fill"] = "#7F4EA1",
            ["unit-fill-deep"] = "#57336E",
            ["shade"] = "#0A0509",
        }),
        fonts = { header = { file = MORPHEUS } },
        glyphs = glyphs(dir),
        textures = textures(dir, true),
        dress = {
            window = {
                header = dir .. "Header.tga",
                pieces = { piece(dir, "Books", "TOPRIGHT", 12, 30, 56, 38) },
                motes = { file = dir .. "Mote.tga", count = 4, color = "gilt", size = 7 },
            },
            chat = { pieces = { piece(dir, "Inkwell", "TOPRIGHT", 6, 34, 40, 40) } },
            minimap = ring(dir, 8, { file = dir .. "Mote.tga", count = 3, color = "gilt", size = 6 },
                piece(dir, "Raven", "TOPRIGHT", -6, 8, 40, 36, { sway = 2, pivot = "BOTTOM" })),
            unit = { pieces = { piece(dir, "Unit", "TOPLEFT", 14, 12, 8, 16) } },
        },
    })
end

