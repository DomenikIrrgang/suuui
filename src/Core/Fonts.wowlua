-- Core/Fonts.wowlua
-- One Font object per text style in the tokens (SuuUIFont_body, SuuUIFont_header, ...),
-- so text everywhere is set by style name and changes with the design.
--
-- Sizes are the design's px values used as UI units for now; step 0.5 decides
-- how the design's 2560x1440 reference maps onto other screens.
-- WoW has no letter spacing, so the styles' letterSpacing is not applied.

import tokens as T, TextStyle from "./Tokens"

local objects: { [string]: Font } = {}

local function build(styleName: string, style: TextStyle): Font
    local font = CreateFont("SuuUIFont_" .. styleName:gsub("%-", "_"))
    font:SetFont(style.file, style.size, "")
    font:SetSpacing(style.lineHeight - style.size)
    font:SetTextColor(unpack(T.color.ink))
    font:SetJustifyH("LEFT")
    return font
end

for styleName, style in pairs(T.type :: { [string]: TextStyle }) do
    objects[styleName] = build(styleName, style)
end

-- The Font object for a text style, e.g. fonts.get("label").
export function get(styleName: string): Font
    return objects[styleName] or error("SuuUI: unknown text style " .. tostring(styleName), 2)
end

-- The styles' faces and sizes again (a theme changed them, Themes.wowlua):
-- every FontString on a style follows.
export function refresh()
    local styles: { [string]: TextStyle } = T.type
    for styleName, font in pairs(objects) do
        local style = styles[styleName]
        if not style then continue end
        font:SetFont(style.file, style.size, "")
        font:SetSpacing(style.lineHeight - style.size)
        font:SetTextColor(unpack(T.color.ink))
    end
end

-- A text style's font file (its face, e.g. for a font of another size).
export function file(styleName: string): string
    local style = (T.type :: { [string]: TextStyle })[styleName]
    return style and style.file or error("SuuUI: unknown text style " .. tostring(styleName), 2)
end

-- Sets a FontString to a text style.
export function apply(fontString: FontString, styleName: string)
    fontString:SetFontObject(get(styleName))
end
