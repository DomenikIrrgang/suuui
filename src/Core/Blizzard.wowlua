-- Core/Blizzard.wowlua
-- Standing Blizzard's own frames down when a SuuUI module replaces them.
--
--   suppress(frame, { children = { "healthbar", "HealthBarsContainer.healthBar" }, keepParent = false })
--
-- The frame (and the named children) stop their events, hide, and move under
-- a hidden parent. Never with an OnShow -> Hide hook: Hide() on a protected
-- frame is refused in combat, while a hidden parent keeps it out of sight
-- whatever Blizzard's code does. The reparent waits for the end of combat for
-- protected frames, and never runs while the game's Edit Mode is open: Edit
-- Mode's layout pass reparents the frames it manages, and reparenting inside
-- it taints code that reads secret values. If the game reparents the frame
-- again, it goes back under the hidden parent on the next frame.
-- keepParent only stops events and hides, for frames whose reparenting itself
-- would taint. noHide skips the Hide: for frames Edit Mode shows and hides
-- through a protected setter (the action bars), where an addon's Hide taints
-- the next combat transition; the hidden parent keeps them out of sight.
-- Only a reload brings a suppressed frame back.

import after from "wowlua:timer"
import hook from "wowlua:hooks"
import * as combat from "./Combat"

export type SuppressOptions = { children?: string[], keepParent?: boolean, noHide?: boolean }

local hiddenParent = CreateFrame("Frame", "SuuUIHiddenParent", UIParent)
hiddenParent:Hide()

local suppressed: { [Frame]: boolean } = {}
local hooked: { [Frame]: boolean } = {}
local pending: { [Frame]: boolean } = {}

-- A frame of the game's (a widget: it has GetObjectType).
export function isFrame(v: unknown): v is Frame
    return type(v) == "table" and type((v :: { GetObjectType: unknown }).GetObjectType) == "function"
end

-- The game's frame of that global name, or nil (a name read at run time
-- can't be typed before: this checks it is a frame).
export function frame(name: string): Frame?
    local v: unknown = _G[name]
    return isFrame(v) and v or nil
end

-- What a dotted path of keys from `from` leads to ("HealthBarsContainer.healthBar").
local function resolve(from: Frame, path: string): unknown
    local v: unknown = from
    for part in path:gmatch("[^%.]+") do
        if type(v) ~= "table" then
            return nil
        end
        v = (v :: { [string]: unknown })[part]
    end
    return v
end

local function reparent(f: Frame)
    pending[f] = nil
    if f:GetParent() == hiddenParent then
        return
    end
    if EditModeManagerFrame and EditModeManagerFrame:IsShown() then
        pending[f] = true
        after(0.25, function()
            reparent(f)
        end)
    elseif InCombatLockdown() and f:IsProtected() then
        pending[f] = true
        combat.run(
            "blizzard:" .. (f:GetName() or tostring(f)),
            function()
                reparent(f)
            end,
            "Hide Blizzard frame"
        )
    else
        f:SetParent(hiddenParent)
    end
end

-- A frame, or its global name.
export type Target = Frame | string

local function frameOf(target: Target?): Frame?
    if type(target) == "string" then
        return frame(target)
    end
    return target
end

export function suppress(target: Target?, opts: SuppressOptions?)
    local f = frameOf(target)
    if not f or suppressed[f] then
        return
    end
    suppressed[f] = true
    local o: SuppressOptions = opts or {}

    f:UnregisterAllEvents()
    for _, path in ipairs(o.children or {}) do
        local child = resolve(f, path)
        if isFrame(child) then
            child:UnregisterAllEvents()
        end
    end
    if not o.noHide and not (InCombatLockdown() and f:IsProtected()) then
        f:Hide()
    end
    if o.keepParent then
        return
    end

    reparent(f)
    if not hooked[f] then
        hooked[f] = true
        hook(f, "SetParent", function(self: Frame, parent: Region?)
            if parent ~= hiddenParent and not pending[self] then
                pending[self] = true
                after(0, function()
                    reparent(self)
                end)
            end
        end)
    end
end

-- Suppressed frames come back only with a reload; this says whether one is.
export function isSuppressed(target: Target?): boolean
    local f = frameOf(target)
    return f ~= nil and suppressed[f] == true
end

-- Kept for the public API: always false for a suppressed frame (reload to restore).
export function restore(target: Target?): boolean
    return not isSuppressed(target)
end
