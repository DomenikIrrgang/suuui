-- (0.18: SuuUI's code is wowlua modules now: Raw.ns is the addon table,
-- which holds the wowlua runtime; the modules are no longer fields of it)
local _, addonTable = ...
API.Raw = { UI = rawUI, Mixins = mixins, ns = addonTable, Module = modules.get }

-- Design tokens (read only: never change them) and text styles
API.Tokens = T
-- 0.37: Size (a size of its own in a style's face, at the theme's size of the style)
API.Fonts = { Get = fonts.get, File = fonts.file, Apply = fonts.apply, Size = fonts.size }

-- Physical pixels
-- (0.33: Relayout(frame), its pixel lines laid again for the scale it shows at)
API.Pixel = { Size = pixel.size, Snap = pixel.snap, PerfectScale = pixel.perfectScale, Relayout = draw.relayoutPixels }

-- 0.9: your role ("TANK", "HEALER", "DAMAGER") and where it came from
-- ("chosen", "assigned", "talents"); your spec (talent tree 1-3, 0 unspecced)
function API.Role()
    return roles.current()
end
function API.Spec()
    return roles.spec()
end
-- Blizzard frames
API.SuppressBlizzard = blizzard.suppress
API.RestoreBlizzard = blizzard.restore
API.IsSuppressed = blizzard.isSuppressed
-- 0.19: the game's frame of a global name, or nil (checked: a name read at run time)
API.BlizzardFrame = blizzard.frame

-- 0.2: the screen root, components, layouts and motion

-- Every SuuUI frame on the screen lives under SuuUI.Root. One unit there is
-- one design pixel (a physical pixel times ui.scale), so design sizes and
-- offsets from the screen's edges or centre are used as they are.
API.Root = root

