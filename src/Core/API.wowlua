local API = {}

API.API_VERSION = API_VERSION
API.version = version

--------------------------------------------------------------------------------
-- The classes a module extends (0.47). wowlua extends only a class declared
-- in a module (not a value, not a type alias, not a field of SuuUI), and
-- has no re-export of a class, so these are SuuUI's own classes under the
-- API's name: subclasses that add nothing. A module file imports them from
-- here (`import SuuUI, Module from "/Core/API"`):
--
--   class Mine extends Module<typeof(DEFAULTS)> … end
--   SuuUI.AddModule(Mine.new({ id = "mine", defaults = DEFAULTS, … }))
--
-- (An addon of its own can't extend them: wowlua 0.13 lets another addon
-- import only types from SuuUI. A plugin uses SuuUI.RegisterModule, whose
-- definition can carry its own methods. SuuUI.Classes has the same classes
-- as values, for .new and .adopt.)
--------------------------------------------------------------------------------

--- A SuuUI module (Core/Modules.wowlua): its settings typed by its defaults.
export class Module<D extends modules.Settings> extends modules.Module<D>
end
--- A titled panel (UI/Panel.wowlua: SuuUI.UI.Panel makes one).
export class PanelClass extends panel.Panel
end
--- An item slot (UI/Inventory.wowlua: SuuUI.UI.ItemSlot makes one).
export class ItemSlotClass extends inventory.ItemSlot
end
--- A unit frame (UI/UnitFrame.wowlua: SuuUI.UI.UnitFrame makes one).
export class UnitFrameClass extends unitFrame.UnitFrame
end
--- A pin on a map (UI/MapPin.wowlua: SuuUI.UI.MapPin makes one).
export class MapPinClass extends mapPin.MapPin
end
--- An action button (UI/ActionButton.wowlua: SuuUI.UI.ActionButton makes one).
export class ActionButtonClass extends actionButton.ActionButton
end

-- Modules
API.RegisterModule = modules.register
API.APIAtLeast = modules.apiAtLeast
-- 0.19: a module as a class, added with SuuUI.AddModule(Mine.new(def));
-- 0.47: SuuUI.Module is the class above (the one module files extend)
API.Module = Module
API.AddModule = modules.add
-- 0.47: the classes above, as values (Module, Panel, ItemSlot, UnitFrame,
-- MapPin, ActionButton)
API.Classes = {
    Module = Module,
    Panel = PanelClass,
    ItemSlot = ItemSlotClass,
    UnitFrame = UnitFrameClass,
    MapPin = MapPinClass,
    ActionButton = ActionButtonClass,
}

-- Another module by id, or nil. 0.47: typed as any module (its state,
-- IsEnabled, Setting); what it offers the others is a service
-- (SuuUI.UseService), not its methods.
function API.GetModule(id: string): modules.AnyModule?
    return modules.get(id)
end

-- 0.17: every /suu subcommand, { { name, help, args } } (Core/Init.lua)
function API.Commands(): CommandInfo[]
    return listCommands()
end

-- A snapshot of every module: { id, name, description, state, source, builtIn, error }.
export type ModuleSummary = {
    id: string,
    name: string,
    description: string?,
    state: modules.ModuleState,
    source: string,
    builtIn: boolean,
    error: string?,
    pendingReload: boolean?,
    replaces: string?,
    replacedBy: string?,
}
function API.ListModules(): ModuleSummary[]
    local out: ModuleSummary[] = {}
    for _, m in ipairs(modules.all()) do
        out[#out + 1] = {
            id = m.id,
            name = m.name,
            description = m.description,
            state = m.state,
            source = m.source,
            builtIn = m.builtIn,
            error = m.error,
            pendingReload = m.pendingReload,
            replaces = m.replaces,
            replacedBy = m.replacedBy,
        }
    end
    return out
end

-- 0.17: SuuUI's own UI for plugins (Core/Extend.lua; a module's Each, Hook
-- and Override are its methods). Instances of a kind, in the order made; one
-- instance's info ({ kind, module, role, unit, preview… }); a component of
-- your own added to a kind (a replacement module's frames), and more info on
-- one.
API.KINDS = extend.KINDS
-- 0.17: a theme (Core/Themes.lua): { id, name, description, colors =
-- { [token] = { r, g, b[, a] } }, fonts = { [style] = { file, size } } };
-- 0.26: health = "class" (players' health in their class colour); 0.35:
-- textures = { [token] = file } (SuuUI.Tokens.texture); 0.37: glyphs =
-- { [name] = file } (SuuUI.Tokens.glyph); 0.38: space = { [token] = px },
-- sizes = { [token] = px }, radius = { [token] = px or "N%" }; 0.46: cast =
-- "class" (your cast bar and swing timer in your class colour)
API.RegisterTheme = function(def: themes.ThemeDef)
    themes.register(def)
end
-- 0.27: an aura filter list (Core/AuraFilters.wowlua): { id, name, kind =
-- "block" | "allow", spells = { id or { ids, name, notFor } }, lists = { id
-- or { id, notFor } }, notFor = { "PRIEST" }, description }; read-only in
-- Settings › Frames › Aura filters, where the player attaches it to frames
API.RegisterAuraFilter = function(def: auraFilters.FilterDef): auraFilters.FilterList
    return tbl.copy(auraFilters.register(def))
end
-- 0.27: every aura filter list (SuuUI's, plugins', the player's), copies
function API.AuraFilters(): auraFilters.FilterList[]
    return tbl.copy(auraFilters.all())
end
-- 0.27: an aura group's spells on a frame kind's buffs or debuffs, with its
-- own spell list (or nil): include, exclude (each nil: none)
API.AuraFilterSpells = auraFilters.groupSpells
-- 0.27: whether a list is another or inside it (adding would make a cycle)
API.AuraFilterContains = auraFilters.contains
-- 0.27: the frame kinds filters apply to ({ id, label, sets })
API.AURA_FILTER_FRAMES = auraFilters.FRAME_KINDS
-- 0.17: what modules added to a list ("micromenu", "gamemenu",
-- "notificationkinds", "rolepresets"), for whoever draws it
API.Additions = extend.additions
-- 0.17: a service by name (Core/Services.wowlua; M:Provide offers one), or nil
API.Service = services.get
-- 0.19: a built-in service by its key (Core/ServiceKeys), typed (wowlua)
API.UseService = services.use
-- 0.47: the built-in services' keys, for SuuUI.UseService and
-- M:ProvideService (Core/ServiceKeys.wowlua; each key's type says what the
-- service offers)
API.Services = {
    ALERTS = serviceKeys.ALERTS,
    AUCTION_HOUSE = serviceKeys.AUCTION_HOUSE,
    AUTO_QUESTS = serviceKeys.AUTO_QUESTS,
    BAGS = serviceKeys.BAGS,
    CAMPFIRES = serviceKeys.CAMPFIRES,
    COLLECTIONS = serviceKeys.COLLECTIONS,
    CONVERGENCES = serviceKeys.CONVERGENCES,
    DURABILITY = serviceKeys.DURABILITY,
    FLIGHT_MAP = serviceKeys.FLIGHT_MAP,
    LEDGER = serviceKeys.LEDGER,
    MARKS = serviceKeys.MARKS,
    MOUSE_BINDINGS = serviceKeys.MOUSE_BINDINGS,
    NOTIFICATIONS = serviceKeys.NOTIFICATIONS,
    PROFESSIONS = serviceKeys.PROFESSIONS,
    RAID_PLANNER = serviceKeys.RAID_PLANNER,
    TALENTS = serviceKeys.TALENTS,
    WELCOME = serviceKeys.WELCOME,
    WORLD_MAP = serviceKeys.WORLD_MAP,
}
-- 0.47: work built ahead (Core/Ahead.wowlua): step() runs once a frame,
-- out of combat, after login, until it returns false; a key already queued
-- is left as it is. What needs the thing sooner builds the rest itself.
API.BuildAhead = ahead.schedule
API.Instances = extend.list
API.InstanceInfo = extend.info
API.AddInstance = extend.add
API.TagInstance = extend.tag

