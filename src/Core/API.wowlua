-- 0.13: a friend request by a character's whole name. Forever's classic
-- friends list is off (IsLegacyFriendSystemEnabled false: C_FriendList.AddFriend
-- does nothing, found in game); its own window sends a title friend invite
-- (C_BattleNet.SendTitleFriendInviteByName). Only from a click. -> true when sent.
function API.AddFriend(name: unknown): boolean
    if type(name) ~= "string" or name == "" then return false end
    local fl, bn = C_FriendList, C_BattleNet
    local okL, legacyOn = pcall(function() return fl and fl.IsLegacyFriendSystemEnabled and fl.IsLegacyFriendSystemEnabled() end)
    if not (okL and legacyOn) and bn and bn.SendTitleFriendInviteByName then
        if pcall(bn.SendTitleFriendInviteByName, name) then return true end
    end
    return fl and fl.AddFriend and pcall(fl.AddFriend, name) or false
end

-- A note in the notification stack (the Notifications module; nothing while
-- it's off): { id?, kind = "timed"|"sticky"|"until", category, title, body,
-- icon = { glyph | texture }, tone, duration, ["until"], actions } -> id
function API.Notify(def: { [string]: unknown }): string?
    local n = services.use(NOTIFICATIONS)
    if n and n.Notify then return n.Notify(def) end
    return nil
end
function API.DismissNotification(id: string)
    local n = services.use(NOTIFICATIONS)
    if n and n.Dismiss then n.Dismiss(id) end
end
-- One alert at a time, centred, in combat only (the Alerts module; nothing
-- while it's off). The same key updates its alert in place; HideAlert(key)
-- takes it away. detail: text, or a format whose arguments may be secret.
function API.ShowAlert(key: string, tone: AlertTone?, title: string?, detail: string?, ...: FormatArg)
    local a = services.use(ALERTS)
    if a and a.Show then a.Show(key, tone or "info", title, detail, ...) end
end
-- A key whose alerts may also show out of combat (a pull countdown). Kept
-- here too, for an alerts service that comes later (turned on, a plugin's).
local anytime: { [string]: boolean } = {}
function API.AllowAlertOutOfCombat(key: string)
    anytime[key] = true
    local a = services.use(ALERTS)
    if a and a.AllowOutOfCombat then a.AllowOutOfCombat(key) end
end
events.on("SUUUI_SERVICE_CHANGED", function(_, name)
    local a = name == ALERTS.name and services.use(ALERTS)
    local allow = a and a.AllowOutOfCombat
    if allow then
        for key in pairs(anytime) do allow(key) end
    end
end, "API")
-- 0.12: the level-up card (levelUp.levelUp) in the alert's place, tone info:
-- def = { title, detail, spells = { { icon, name, rank, isNew, note, text, meta } }, more,
-- cost (copper) }. HideAlert(key) takes it away.
function API.ShowLevelUp(key: string, def: LevelUpDef)
    local a = services.use(ALERTS)
    if a and a.ShowLevelUp then a.ShowLevelUp(key, def) end
end
function API.HideAlert(key: string?)
    local a = services.use(ALERTS)
    if a and a.Hide then a.Hide(key) end
end
-- 0.17: your gear's durability (the Durability module; nil while it's off):
-- { line, state, pieces, lowest, average, damaged, broken, bySlot, headline,
-- summary, lines, parts }, read only (Docs/API.md). SUUUI_DURABILITY_CHANGED
-- when what it says changes.
function API.Durability(): DurabilityInfo?
    local d = services.use(DURABILITY)
    return d and d.Get and d.Get() or nil
end

-- 0.12: what your class trainer teaches (Data/Trainer, from the class
-- probes): { name, level, cost (copper), school, icon, text } for your class.
function API.TrainerSpells(): TrainerSpell[]
    return trainerSpells or {}
end
-- 0.12: every spell ID this client has for each of those names (players'
-- ranks and others alike: { [name] = { id, ... } }); pick a rank by
-- C_Spell.GetSpellLevelLearned.
-- Where a profession recipe is learned (Data/RecipeSources.lua, made by
-- tools/gen_recipe_sources.py): a list of { t = "t" } (trainer), { t = "a" }
-- (automatic) or { t = "i", i = itemID, v, d, dn, o, q, c } (a recipe item:
-- sold by, dropped by and how many, found in, quest rewards, inside), or nil
-- when it isn't known.
-- 0.14: where Forever's quests are picked up and the dungeon entrances
-- (Data/QuestStarts.lua), and the map's other places: town services,
-- mailboxes, rares, treasure chests (Data/MapPlaces.lua); both generated
-- from QuestieDB by tools/update_quest_starts.sh. Their layouts are in
-- their files' headers.
function API.QuestStarts(): typeof(questStarts) return questStarts end
function API.MapPlaces(): typeof(mapPlaces) return mapPlaces end
-- 0.14: every area overlay of Forever's maps by map art (Data/MapOverlays.lua,
-- from the client tables: tools/update_map_overlays.sh), for drawing the
-- areas you haven't explored: { [uiMapArtID] = { { w, h, x, y, fileDataID, ... } } }
function API.MapOverlays(): typeof(mapOverlays) return mapOverlays end
-- 0.14: the recommended levels of dungeons, raids and battlegrounds by
-- their entrances' names (Data/InstanceLevels.lua, the group finder's, from
-- the client tables: tools/update_instance_levels.sh):
-- { [kind] = { [name] = { min, max, { wing, min, max }, ... } } }
function API.InstanceLevels(): typeof(instanceLevels) return instanceLevels end
-- 0.17: how far each of Forever's flight master routes flies, one hop
-- (Data/FlightRoutes.lua, from the client tables: tools/update_flight_routes.sh):
-- { [fromNodeID] = { [toNodeID] = yards } }, nodeIDs as C_TaxiMap gives them;
-- a longer flight is its hops added up
function API.FlightRoutes(): typeof(flightRoutes) return flightRoutes end
-- 0.17: the way each of those routes flies, for drawing it (Data/FlightPaths.lua,
-- the same tool): { [fromNodeID] = { [toNodeID] = { continentID, x1, y1, x2, y2, ... } } },
-- world x, y in yards as C_Map.GetWorldPosFromMapPos gives them
function API.FlightPaths(): typeof(flightPaths) return flightPaths end

function API.RecipeSources(recipeID: number): RecipeSource[]?
    return recipeSources[recipeID]
end

-- 0.17: where Forever's mounts, toys and appearance items come from
-- (Data/CollectionSources.lua, made by tools/gen_collection_sources.py; its
-- layout is in its header): { npc, obj, mount, toy, toys, item }.
function API.CollectionSources(): typeof(collectionSources) return collectionSources end

function API.TrainerSpellIDs(): TrainerSpellIDs
    return trainerSpellIDs or {}
end

--------------------------------------------------------------------------------
-- 0.17: the first-run welcome (Units/Welcome.lua) and what it sets: role
-- presets, colour vision, a module's account-wide data, opening it again.
--------------------------------------------------------------------------------

-- The design's own signal colours, kept before colour vision or a theme
-- replaces them in place at login: what "Normal" looks like, for previews.
local designed: { [string]: number[] } = {}
for name, c in pairs(T.color :: { [string]: Color }) do designed[name] = { c[1], c[2], c[3], c[4] } end

-- A role's preset profile name ("TANK" -> "SuuTank"), or nil.
function API.RolePresetName(role: string): string?
    return rolePresets.NAME[role]
end

-- Creates (or resets) a role's preset profile and puts it in its role's
-- place under Profiles › By role; with `switch`, this character uses it from
-- now on. Out of combat. -> true, or false and why not.
function API.ApplyRolePreset(role: string, switch: boolean?): (boolean, string?)
    local ok, err = rolePresets.apply(role)
    if not ok then return false, err end
    if switch then
        local name = settings.profiles.find(rolePresets.NAME[role])
        if not name then return false, "The preset's profile is missing." end
        return settings.profiles.use(name)
    end
    return true
end

-- The colour vision presets this SuuUI has: { { id, label, hint } } in order.
function API.ColorVisionModes(): { id: string, label: string?, hint: string? }[]
    local out: { id: string, label: string?, hint: string? }[] = {}
    for _, mode in ipairs(vision.MODES) do
        if vision.available(mode) then
            out[#out + 1] = { id = mode, label = vision.LABEL[mode], hint = vision.HINT[mode] }
        end
    end
    return out
end

-- The colour vision chosen for the account, and the one in effect (the
-- same: a change applies at once).
function API.ColorVision(): (string, string)
    return settings.accountString("colorVision") or "normal", vision.appliedMode()
end

-- Chooses the account's colour vision; it applies at once (0.17).
-- -> true, or false and why not.
function API.SetColorVision(mode: string): (boolean, string?)
    if not vision.LABEL[mode] or not vision.available(mode) then return false, "No such colour vision preset." end
    settings.setAccount("colorVision", mode ~= "normal" and mode or nil)
    themes.apply()
    return true
end

-- A colour token as a colour vision preset draws it (for previews of a
-- preset not in effect): r, g, b, a.
function API.ColorVisionColor(mode: string, token: string): (number, number, number, number)
    local presets = T.vision
    local set = mode ~= "normal" and presets and presets[mode] or nil
    local c: number[]? = (set and set[token]) or designed[token]
    if not c then error("SuuUI: unknown colour token " .. tostring(token), 2) end
    local base = designed[token] or c
    return c[1], c[2], c[3], c[4] or base[4] or 1
end

-- A module's own table for the whole account (not per character or
-- profile), saved with SuuUI and made on first use. From OnEnable on.
function API.AccountData(namespace: string): { [string]: unknown }
    assert(type(namespace) == "string", "SuuUI.AccountData: a namespace is required")
    local all = settings.account("data")
    local map: { [unknown]: unknown }
    if type(all) == "table" then
        map = all
    else
        map = {}
        settings.setAccount("data", map)
    end
    return tbl.recordAt(map, namespace)
end

-- Opens the first-run welcome again (the welcome module). False when that
-- module is off.
function API.ShowWelcome()
    local w = services.use(WELCOME)
    if w and w.Show then w.Show(); return true end
    return false
end

@global("SuuUI")
export const SuuUI = API
