-- A settings section that is always there (a module uses module:RegisterSettings,
-- whose section goes away with the module). See SettingsUI/Registry.lua.
function API.RegisterSettings(def: registry.SectionDef): registry.Section
    return registry.register(def)
end

-- Opens the settings window, at a section if given.
function API.OpenSettings(sectionId: string?)
    window.open(sectionId)
end
-- 0.10: opens the settings window, or closes it while it's open
function API.ToggleSettings()
    window.toggle()
end

-- 0.4: edit mode

-- An edit-mode handle for a frame whose position lives in a settings table
-- (opts.namespace, opts.key); modules use module:RegisterMover instead.
function API.RegisterMover(frame: Region, opts: editMode.MoverOptions): editMode.Mover
    return editMode.register(frame, opts)
end

API.EditMode = {
    Enter = editMode.enter,
    Exit = editMode.exit,
    Toggle = editMode.toggle,
    IsActive = editMode.isActive,
    Refresh = editMode.refresh, -- 0.8: re-reads each mover's `enabled`
    Rect = editMode.rect,           -- 0.8: a frame's rectangle in root units
    AnchorFor = editMode.anchorFor, -- 0.8: the screen anchor for a rectangle; 0.17: or the offset from a given point
    GroupPreview = editMode.groupPreview,       -- 0.17: 0, 5, 10, 20 or 40 while edit mode shows a group preview
    SetGroupPreview = editMode.setGroupPreview, -- 0.17
}

