--------------------------------------------------------------------------------
-- 0.17: the first-run welcome (Units/Welcome.lua) and what it sets: role
-- presets, colour vision, a module's account-wide data, opening it again.
--------------------------------------------------------------------------------

-- The design's own signal colours, kept before colour vision or a theme
-- replaces them in place at login: what "Normal" looks like, for previews.
local designed: { [string]: number[] } = {}
for name, c in pairs(T.color :: { [string]: Color }) do
    designed[name] = { c[1], c[2], c[3], c[4] }
end

-- A role's preset profile name ("TANK" -> "SuuTank"), or nil.
function API.RolePresetName(role: string): string?
    return rolePresets.NAME[role]
end

-- Creates (or resets) a role's preset profile and puts it in its role's
-- place under Profiles › By role; with `switch`, this character uses it from
-- now on. Out of combat. -> true, or false and why not.
function API.ApplyRolePreset(role: string, switch: boolean?): (boolean, string?)
    local ok, err = rolePresets.apply(role)
    if not ok then
        return false, err
    end
    if switch then
        local name = settings.profiles.find(rolePresets.NAME[role])
        if not name then
            return false, "The preset's profile is missing."
        end
        return settings.profiles.use(name)
    end
    return true
end

-- The colour vision presets this SuuUI has: { { id, label, hint } } in order.
function API.ColorVisionModes(): { id: string, label: string?, hint: string? }[]
    local out: { id: string, label: string?, hint: string? }[] = {}
    for _, mode in ipairs(vision.MODES) do
        if vision.available(mode) then
            out[#out + 1] = { id = mode, label = vision.LABEL[mode], hint = vision.HINT[mode] }
        end
    end
    return out
end

-- The colour vision chosen for the account, and the one in effect (the
-- same: a change applies at once).
function API.ColorVision(): (string, string)
    return settings.accountString("colorVision") or "normal", vision.appliedMode()
end

-- Chooses the account's colour vision; it applies at once (0.17).
-- -> true, or false and why not.
function API.SetColorVision(mode: string): (boolean, string?)
    if not vision.LABEL[mode] or not vision.available(mode) then
        return false, "No such colour vision preset."
    end
    settings.setAccount("colorVision", mode ~= "normal" and mode or nil)
    themes.apply()
    return true
end

-- A colour token as a colour vision preset draws it (for previews of a
-- preset not in effect): r, g, b, a.
function API.ColorVisionColor(mode: string, token: string): (number, number, number, number)
    local presets = T.vision
    local set = mode ~= "normal" and presets and presets[mode] or nil
    local c: number[]? = (set and set[token]) or designed[token]
    if not c then
        error("SuuUI: unknown colour token " .. tostring(token), 2)
    end
    local base = designed[token] or c
    return c[1], c[2], c[3], c[4] or base[4] or 1
end

-- A module's own table for the whole account (not per character or
-- profile), saved with SuuUI and made on first use. From OnEnable on.
function API.AccountData(namespace: string): { [string]: unknown }
    assert(type(namespace) == "string", "SuuUI.AccountData: a namespace is required")
    local all = settings.account("data")
    local map: { [unknown]: unknown }
    if type(all) == "table" then
        map = all
    else
        map = {}
        settings.setAccount("data", map)
    end
    return tbl.recordAt(map, namespace)
end

--------------------------------------------------------------------------------
-- 0.48: rulesets (Core/Rulesets.wowlua). Forever has no realms, only
-- rulesets, each with its own auction house: what is kept per house is
-- keyed by SuuUI.Ruleset().
--------------------------------------------------------------------------------

-- This character's ruleset, as a key (for now the realm's name).
function API.Ruleset(): string
    return rulesets.current()
end

-- A ruleset's name as SuuUI shows it: "Normal Ruleset" (nil: this one's).
function API.RulesetName(key: string?): string
    return rulesets.displayName(key)
end

-- The ruleset of a character's key ("Name - Realm": M:CharKey(), the keys
-- of M:AllCharData()), for data saved without its ruleset; nil: none told.
function API.RulesetOfCharKey(charKey: string): string?
    return rulesets.ofCharKey(charKey)
end

--------------------------------------------------------------------------------
-- 0.48: the price store (Core/Prices): what the auction house showed, one
-- copy per ruleset, the last 60 days, owned by neither the auction house
-- module nor the Ledger. Anyone reads it; only SuuUI's own modules write
-- (the auction house's looks, the names the Ledger learns).
--------------------------------------------------------------------------------

-- A write's module must be one of SuuUI's own.
local function ownModule(m: unknown, what: string)
    if not (type(m) == "table" and (m :: modules.AnyModule).builtIn == true) then
        error("SuuUI.Prices." .. what .. ": only SuuUI's own modules write prices", 3)
    end
end

API.Prices = {
    -- how many days of looks are kept
    KEEP_DAYS = prices.KEEP_DAYS,
    -- the rulesets with prices, this character's first; the items with
    -- prices on one (nil: this character's), and how many
    Rulesets = function(): string[]
        return prices.rulesetList()
    end,
    Items = function(ruleset: string?): number[]
        return prices.items(ruleset)
    end,
    ItemCount = function(ruleset: string?): number
        return prices.itemCount(ruleset)
    end,
    -- whether an item has prices on any ruleset
    Known = function(itemID: number): boolean
        return prices.known(itemID)
    end,
    -- the newest look { day, period, low, most, qty, n } (nil: none)
    Latest = function(itemID: number, ruleset: string?): PriceLookType?
        return prices.latest(itemID, ruleset)
    end,
    -- the usual price today: the middle of the lowest buyouts of the last
    -- 14 days that have a look (nil: none)
    Usual = function(itemID: number, ruleset: string?): number?
        return prices.usual(itemID, ruleset)
    end,
    -- the daily lows of the last `count` days (index `count` today, 0: no
    -- look), and what most sold it for at each day's lowest look
    DailyLows = function(itemID: number, count: number, ruleset: string?): (number[], number[])
        return prices.dailyLows(itemID, count, ruleset)
    end,
    -- every look of the last `count` days (nil: all kept), newest first
    Looks = function(itemID: number, count: number?, ruleset: string?): PriceLookType[]
        return prices.looks(itemID, count, ruleset)
    end,
    -- an item's name and quality: the kept one, else the client's cache's
    -- (nil: neither); KeptName only the kept one
    Name = function(itemID: number): (string?, number?)
        return prices.nameOf(itemID)
    end,
    KeptName = function(itemID: number): (string?, number?)
        return prices.keptName(itemID)
    end,
    -- when a look was: "this morning", "yesterday", "3 days ago"
    When = function(at: number): string
        return prices.whenText(at)
    end,
    -- (SuuUI's own modules) a look on this character's ruleset, now: the
    -- lowest buyout per unit, what most sell it for, how many offered in
    -- how many auctions (0 or nil: not known), and its name -> whether it
    -- changed what is kept
    Record = function(
        m: modules.AnyModule,
        itemID: number,
        low: number,
        most: number?,
        qty: number?,
        n: number?,
        name: string?,
        quality: number?
    ): boolean
        ownModule(m, "Record")
        return prices.record(itemID, low, most, qty, n, name, quality)
    end,
    -- (SuuUI's own modules) Scan all's looks: five numbers an item
    -- (itemID, low, most, qty, n), how many items, the names the house
    -- told; kept a slice a frame, then SUUUI_PRICES_SCANNED
    RecordScan = function(
        m: modules.AnyModule,
        looks: number[],
        items: number,
        names: { [number]: string }?,
        qualities: { [number]: number }?
    )
        ownModule(m, "RecordScan")
        prices.recordScan(looks, items, names, qualities)
    end,
    -- (SuuUI's own modules) an item's name learned -> whether it changed
    KeepName = function(m: modules.AnyModule, itemID: number, name: string?, quality: number?): boolean
        ownModule(m, "KeepName")
        return prices.keepName(itemID, name, quality)
    end,
}

-- 0.48: the calendar the prices are kept by (Core/Prices/Days): a day as a
-- number (days since 1 January 1970 by the computer's calendar), the time
-- of day as one of four periods by the computer's clock.
API.Calendar = {
    NIGHT = calendar.NIGHT,
    MORNING = calendar.MORNING,
    NOON = calendar.NOON,
    EVENING = calendar.EVENING,
    PERIODS = calendar.PERIODS,
    WEEKDAYS = calendar.WEEKDAYS,
    -- the day and period of a time (nil: now)
    DayOf = function(at: number?): (number, number)
        return calendar.dayOf(at)
    end,
    -- a day's date: year, month, day of the month
    DateOf = function(day: number): (number, number, number)
        return calendar.dateOf(day)
    end,
    DayNumber = function(year: number, month: number, day: number): number
        return calendar.dayNumber(year, month, day)
    end,
    -- 1 Monday … 7 Sunday
    Weekday = function(day: number): number
        return calendar.weekday(day)
    end,
    PeriodOfHour = function(hour: number): number
        return calendar.periodOfHour(hour)
    end,
    -- the time() a period of a day starts at
    TimeOf = function(day: number, period: number): number
        return calendar.timeOf(day, period)
    end,
}

-- 0.48: a whole number as printable characters a SavedVariables file keeps
-- as they are (the price store's format; the Ledger's books use it too),
-- and the number at `i` of such a string with where the next one starts.
API.PackNumber = pack.encodeNumber
API.UnpackNumber = pack.readNumber

-- Opens the first-run welcome again (the welcome module). False when that
-- module is off.
function API.ShowWelcome()
    local w = services.use(WELCOME)
    if w and w.Show then
        w.Show()
        return true
    end
    return false
end

