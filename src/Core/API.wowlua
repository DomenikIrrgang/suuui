local API = {}

API.API_VERSION = API_VERSION
API.version = version

-- Modules
API.RegisterModule = modules.register
API.APIAtLeast = modules.apiAtLeast
-- 0.19: a module as a class (wowlua): `class Mine extends SuuUI.Module<typeof(DEFAULTS)>`,
-- added with SuuUI.AddModule(Mine.new())
API.Module = modules.Module
API.AddModule = modules.add

-- (TRANSITION: the loose view while modules move to classes; each other
-- module's use becomes a typed interface)
function API.GetModule(id: string): modules.ModuleOf<modules.WithEnabled<modules.Settings>>?
    local m = modules.get(id)
    return (m :: unknown) :: modules.ModuleOf<modules.WithEnabled<modules.Settings>>?
end

-- 0.17: every /suu subcommand, { { name, help, args } } (Core/Init.lua)
function API.Commands(): CommandInfo[] return listCommands() end

-- A snapshot of every module: { id, name, description, state, source, builtIn, error }.
export type ModuleSummary = {
    id: string, name: string, description: string?, state: modules.ModuleState, source: string, builtIn: boolean,
    error: string?, pendingReload: boolean?, replaces: string?, replacedBy: string?,
}
function API.ListModules(): ModuleSummary[]
    local out: ModuleSummary[] = {}
    for _, m in ipairs(modules.all()) do
        out[#out + 1] = {
            id = m.id, name = m.name, description = m.description, state = m.state,
            source = m.source, builtIn = m.builtIn, error = m.error, pendingReload = m.pendingReload,
            replaces = m.replaces, replacedBy = m.replacedBy,
        }
    end
    return out
end

-- 0.17: SuuUI's own UI for plugins (Core/Extend.lua; a module's Each, Hook
-- and Override are its methods). Instances of a kind, in the order made; one
-- instance's info ({ kind, module, role, unit, preview… }); a component of
-- your own added to a kind (a replacement module's frames), and more info on
-- one.
API.KINDS = extend.KINDS
-- 0.17: a theme (Core/Themes.lua): { id, name, description, colors =
-- { [token] = { r, g, b[, a] } }, fonts = { [style] = { file, size } } }
API.RegisterTheme = function(def: themes.ThemeDef) themes.register(def) end
-- 0.17: what modules added to a list ("micromenu", "gamemenu",
-- "notificationkinds", "rolepresets"), for whoever draws it
API.Additions = extend.additions
-- 0.17: a service by name (Core/Services.wowlua; M:Provide offers one), or nil
API.Service = services.get
-- 0.19: a built-in service by its key (Core/ServiceKeys), typed (wowlua)
API.UseService = services.use
API.Instances = extend.list
API.InstanceInfo = extend.info
API.AddInstance = extend.add
API.TagInstance = extend.tag

