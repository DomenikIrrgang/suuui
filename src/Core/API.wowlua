-- 0.12: SuuUI's Talents window (the talents module): open or close it, and
-- whether it is open. False when that module is off.
function API.ToggleTalents(): boolean
    local t = services.use(TALENTS)
    if t and t.Toggle then t.Toggle(); return true end
    return false
end
-- 0.17: SuuUI's Talents window showing another player's talents, read only
-- (an inspected unit, after INSPECT_READY). False when that module is off.
function API.ShowTalentsOf(unit: string): boolean
    local t = services.use(TALENTS)
    if t and t.ShowInspect then t.ShowInspect(unit); return true end
    return false
end
-- 0.13: a recipe opened: in SuuUI's Professions window (the professions
-- module, which then selects it), else the game's own window.
function API.OpenRecipe(recipeID: number)
    local p = services.use(PROFESSIONS)
    if p and p.OpenRecipe then return p.OpenRecipe(recipeID) end
    -- C_TradeSkillUI.OpenRecipe is protected (blocked from an addon): the
    -- recipe's profession opened instead
    -- (called on its own line: `a and f()` keeps only f's first value, and
    -- the parent line is its third)
    if not (C_TradeSkillUI and C_TradeSkillUI.GetTradeSkillLineForRecipe) then return end
    local lineValue: unknown, _: unknown, parentValue: unknown = C_TradeSkillUI.GetTradeSkillLineForRecipe(recipeID)
    local line, parent = secret.asNumber(lineValue), secret.asNumber(parentValue)
    local skillLine = (parent and parent ~= 0) and parent or line
    if skillLine and C_TradeSkillUI.OpenTradeSkill then pcall(C_TradeSkillUI.OpenTradeSkill, skillLine) end
end
-- 0.13: the spell that opens a profession's window (Smelting for Mining,
-- Tanning for Skinning's camp recipes), by its skill line; nil if you
-- don't have it. Opening a profession from an addon is protected: cast
-- this from a secure button instead.
function API.ProfessionOpener(skillLine: number): number?
    if not (GetProfessions and C_SpellBook and C_TradeSkillUI) then return nil end
    local bank = Enum.SpellBookSpellBank and Enum.SpellBookSpellBank.Player
    for _, index in pairs({ GetProfessions() }) do
        if not index then continue end
        local _, _, _, _, numSpells, offset, line = GetProfessionInfo(index)
        if line == skillLine then
            for k = 1, (numSpells or 0) do
                local info = C_SpellBook.GetSpellBookItemInfo((offset or 0) + k, bank)
                if info and info.spellID and not info.isPassive
                    and C_TradeSkillUI.CanTradeSkillShowCraftingUI(info.spellID) then
                    return info.spellID
                end
            end
        end
    end
end
-- 0.13: the recipe to choose once its profession's window opens (the
-- professions module; opened by casting ProfessionOpener's spell).
function API.ExpectRecipe(recipeID: number)
    local p = services.use(PROFESSIONS)
    if p and p.ExpectRecipe then p.ExpectRecipe(recipeID) end
end
-- 0.13: the recipe SuuUI's Professions window shows right now, or nil.
function API.ShownRecipe(): number?
    local p = services.use(PROFESSIONS)
    return p and p.ShownRecipe and p.ShownRecipe() or nil
end
-- 0.13: a unit's whole name. Forever's characters have a surname, and
-- its UnitName returns the two parts where other clients give name and
-- realm ("Suther", "Stargazer": probed 2026-10-14); GetUnitName(unit, true)
-- gives "Suther Stargazer" (with "-Realm" for another realm), the form
-- whispers, invites, the roster and chat use.
function API.FullName(unit: string?): (string | Secret<string>)?
    -- (the game's name for the unit, secret in some places)
    local raw = GetUnitName and GetUnitName(unit or "player", true) or nil
    if secret.isSecret(raw) then return raw :: Secret<string> end
    local name = secret.asString(raw)
    if name and name ~= "" then return name end
    return (UnitName(unit or "player"))
end
-- A diagnostic asked the Social window's SuuUI pages to step aside (false
-- in a release: the probes aren't in it).
function API.ProbeShowsBlizzardSocial(): boolean
    if build.debug then return socialProbe.showsBlizzardSocial() end
    return false
end
-- 0.17: SuuUI's Collections window (the collections module): open or
-- close it (on a tab: "mounts", "toys", "wardrobe"), and whether it is
-- open. False when that module is off.
function API.ToggleCollections(tab: string?): boolean
    local c = services.use(COLLECTIONS)
    if c and c.Toggle then c.Toggle(tab); return true end
    return false
end
function API.CollectionsShown(): boolean
    local c = services.use(COLLECTIONS)
    return (c and c.IsShown and c.IsShown()) and true or false
end
function API.TalentsShown(): boolean
    local t = services.use(TALENTS)
    return (t and t.IsShown and t.IsShown()) and true or false
end
-- 0.17: the talent build you follow: its next talent on this character's
-- talent group ({ node, name, icon, rank, max, treeName, build, index }),
-- or nil (no build, all learned, or the talents module off).
-- SUUUI_TALENT_BUILD_CHANGED: a build was followed, changed or learned along.
function API.TalentBuildNext(): TalentNext?
    local t = services.use(TALENTS)
    return t and t.NextTalent and t.NextTalent() or nil
end
-- 0.12: open or close the bags without Blizzard's bag functions (called
-- from an addon they taint Esc in combat): SuuUI's bags when that module is
-- on; else Blizzard's (ToggleAllBags).
function API.ToggleBags()
    local b = services.use(BAGS)
    if b and b.Toggle then return b.Toggle() end
    ToggleAllBags()
end
