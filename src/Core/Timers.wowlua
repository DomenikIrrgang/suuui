-- Core/Timers.wowlua
-- Timers that belong to an owner (a module's M:After and M:Every): each
-- callback runs under the owner's name in Fault, as its events do, and all
-- of an owner's timers are cancelled when it is released (a module turned
-- off, or failed), so none outlives it.
--
--   after(owner, source, live, sec, fn)          once; the handle has Cancel()
--   every(owner, source, live, sec, fn, times?)  fn(ticker) every sec, `times`
--                                                times or until cancelled
--   cancelAll(owner) / count(owner)
--
-- wowlua:timer makes the timers; this keeps the handles per owner. A timer
-- that has run its last time (or was cancelled by its owner) is dropped.
--
-- `live()` says whether the owner is on (a module's IsEnabled(), as with
-- Core/Hooks). A timer asked for while it says no is never started and not
-- kept: the handle returned is already cancelled. That is what a timer
-- scheduled from a permanent hook, a widget's or a library's callback
-- while the module is off gets, so the module needs no IsEnabled() guard
-- of its own around it. One that was started while the owner was on is
-- cancelled by the release (cancelAll), so none comes due after it; the
-- check is made only when a timer is asked for.
--
-- OnDisable runs with the module already off (IsEnabled() is false there),
-- so M:After and M:Every from OnDisable start nothing. A timer that must
-- run after the module is off (one that finishes a fade OnDisable started)
-- is not the module's: it uses wowlua:timer's `after` itself, and nothing
-- cancels it.
--
-- The registry is a TimerOwners: what reports a callback's error comes in
-- through its constructor, so a test builds one of its own. `timers` is
-- SuuUI's; the module's functions are its methods.

import after as timerAfter, every as timerEvery from "wowlua:timer"
import * as fault from "./Fault"

-- A timer as its owner holds it: C_Timer's handle (a ticker's too).
export type Handle = TimerHandle | TickerHandle

export class TimerOwners
    -- each owner's live timers (a set, so cancelling one is a lookup)
    private byOwner: { [unknown]: { [Handle]: boolean } } = {}

    constructor(private reporter: fault.Reporter = fault.log) end

    private function keep(owner: unknown, handle: Handle)
        local set = self.byOwner[owner]
        if not set then
            set = {}
            self.byOwner[owner] = set
        end
        set[handle] = true
    end

    private function drop(owner: unknown, handle: Handle)
        local set = self.byOwner[owner]
        if set then
            set[handle] = nil
            if next(set) == nil then
                self.byOwner[owner] = nil
            end
        end
    end

    function after(owner: unknown, source: string, live: () -> boolean, sec: number, fn: () -> ()): TimerHandle
        assert(owner ~= nil, "SuuUI Timers: an owner is required")
        if not live() then
            local refused = timerAfter(sec, function() end)
            refused:Cancel()
            return refused
        end
        local handle: TimerHandle? = nil
        local made = timerAfter(sec, function()
            if handle then
                self:drop(owner, handle)
            end
            self.reporter:call(source, fn)
        end)
        handle = made
        self:keep(owner, made)
        return made
    end

    function every(
        owner: unknown,
        source: string,
        live: () -> boolean,
        sec: number,
        fn: (ticker: TickerHandle) -> (),
        times: number?
    ): TickerHandle
        assert(owner ~= nil, "SuuUI Timers: an owner is required")
        if not live() then
            local refused = timerEvery(sec, function() end, 1)
            refused:Cancel()
            return refused
        end
        local left = times
        local made = timerEvery(sec, function(ticker: TickerHandle)
            if left then
                left -= 1
                if left <= 0 then
                    self:drop(owner, ticker)
                end
            end
            self.reporter:call(source, fn, ticker)
        end, times)
        self:keep(owner, made)
        return made
    end

    -- Every timer of the owner's, cancelled.
    function cancelAll(owner: unknown)
        local set = self.byOwner[owner]
        if not set then
            return
        end
        self.byOwner[owner] = nil
        for handle in pairs(set) do
            handle:Cancel()
        end
    end

    -- How many of the owner's timers are still to run (one its owner
    -- cancelled itself doesn't count).
    function count(owner: unknown): number
        local set = self.byOwner[owner]
        if not set then
            return 0
        end
        local n = 0
        for handle in pairs(set) do
            if handle:IsCancelled() then
                set[handle] = nil
            else
                n += 1
            end
        end
        if n == 0 then
            self.byOwner[owner] = nil
        end
        return n
    end
end

-- SuuUI's, and its methods as the module's functions.
export const timers = TimerOwners.new()

export function after(owner: unknown, source: string, live: () -> boolean, sec: number, fn: () -> ()): TimerHandle
    return timers:after(owner, source, live, sec, fn)
end

export function every(
    owner: unknown,
    source: string,
    live: () -> boolean,
    sec: number,
    fn: (ticker: TickerHandle) -> (),
    times: number?
): TickerHandle
    return timers:every(owner, source, live, sec, fn, times)
end

export function cancelAll(owner: unknown)
    timers:cancelAll(owner)
end

export function count(owner: unknown): number
    return timers:count(owner)
end
