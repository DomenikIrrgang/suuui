-- Core/Timers.wowlua
-- Timers that belong to an owner (a module's M:After and M:Every): each
-- callback runs under the owner's name in Fault, as its events do, and all
-- of an owner's timers are cancelled when it is released (a module turned
-- off, or failed), so none outlives it.
--
--   after(owner, source, gate, sec, fn)          once; the handle has Cancel()
--   every(owner, source, gate, sec, fn, times?)  fn(ticker) every sec, `times`
--                                                times or until cancelled
--   cancelAll(owner) / count(owner)
--
-- wowlua:timer makes the timers; this keeps the handles per owner. A timer
-- that has run its last time is dropped at once, one its owner cancelled
-- itself at the next look (see `add`); the owner's set stays until
-- cancelAll.
--
-- `gate.on` says whether the owner is on (a module's IsEnabled(), as with
-- Core/Hooks). A timer asked for while it is false is never started and not
-- kept: the handle returned is already cancelled. That is what a timer
-- scheduled from a permanent hook, a widget's or a library's callback
-- while the module is off gets, so the module needs no IsEnabled() guard
-- of its own around it. One that was started while the owner was on is
-- cancelled by the release (cancelAll), so none comes due after it; the
-- check is made only when a timer is asked for.
--
-- OnDisable runs with the module already off (IsEnabled() is false there),
-- so M:After and M:Every from OnDisable start nothing. A timer that must
-- run after the module is off (one that finishes a fade OnDisable started)
-- is not the module's: it uses wowlua:timer's `after` itself, and nothing
-- cancels it.
--
-- The registry is a TimerOwners: what reports a callback's error comes in
-- through its constructor, so a test builds one of its own. `timers` is
-- SuuUI's; the module's functions are its methods.

import after as timerAfter, every as timerEvery from "wowlua:timer"
import * as fault from "./Fault"
import type Gate from "./Util"

-- A timer as its owner holds it: C_Timer's handle (a ticker's too).
export type Handle = TimerHandle | TickerHandle

-- What a refused timer runs (never: it is cancelled at once).
local function noop() end

-- An owner's timers: the handles still to run (a set, so cancelling one is
-- a lookup), and when to look for the ones its owner cancelled itself.
type Owned = { handles: { [Handle]: boolean }, added: number, sweepAt: number }

-- The fewest timers added between two looks for self-cancelled handles.
const SWEEP_MIN = 32

export class TimerOwners
    private byOwner: { [unknown]: Owned } = {}

    constructor(private reporter: fault.Reporter = fault.log) end

    -- The owner's: made with its first timer and kept, empty too, until
    -- cancelAll lets it go (a module's timers come and go all the time: one
    -- table for them, not one for each).
    private function ownedBy(owner: unknown): Owned
        local owned = self.byOwner[owner]
        if not owned then
            owned = { handles = {}, added = 0, sweepAt = SWEEP_MIN }
            self.byOwner[owner] = owned
        end
        return owned
    end

    -- A timer kept. A handle its owner cancels itself (a debounce that
    -- cancels and starts again, a ticker that stops itself) never runs, so
    -- nothing takes it out: once as many timers were added as were kept at
    -- the last look (SWEEP_MIN at least), the cancelled ones go. A set holds
    -- at most about twice what is live, and the look costs about one
    -- IsCancelled per timer added.
    private function add(owned: Owned, handle: Handle)
        local handles = owned.handles
        handles[handle] = true
        local added = owned.added + 1
        if added < owned.sweepAt then
            owned.added = added
            return
        end
        local live = 0
        for h in pairs(handles) do
            if h:IsCancelled() then
                handles[h] = nil
            else
                live += 1
            end
        end
        owned.added = 0
        owned.sweepAt = math.max(SWEEP_MIN, live)
    end

    -- Per timer: wowlua:timer's handle and closure, and this one closure,
    -- which takes the timer out of its owner's set and runs fn guarded
    -- (Fault's `run`) when it comes due.
    function after(owner: unknown, source: string, gate: Gate, sec: number, fn: () -> ()): TimerHandle
        assert(owner ~= nil, "SuuUI Timers: an owner is required")
        if not gate.on then
            local refused = timerAfter(sec, noop)
            refused:Cancel()
            return refused
        end
        local owned = self:ownedBy(owner)
        local handles = owned.handles
        local reporter = self.reporter
        local handle: TimerHandle? = nil
        local made = timerAfter(sec, function()
            if handle then
                handles[handle] = nil
            end
            reporter:run(source, fn)
        end)
        handle = made
        self:add(owned, made)
        return made
    end

    function every(
        owner: unknown,
        source: string,
        gate: Gate,
        sec: number,
        fn: (ticker: TickerHandle) -> (),
        times: number?
    ): TickerHandle
        assert(owner ~= nil, "SuuUI Timers: an owner is required")
        if not gate.on then
            local refused = timerEvery(sec, noop, 1)
            refused:Cancel()
            return refused
        end
        local owned = self:ownedBy(owner)
        local handles = owned.handles
        local reporter = self.reporter
        local left = times
        local made = timerEvery(sec, function(ticker: TickerHandle)
            if left then
                left -= 1
                if left <= 0 then
                    handles[ticker] = nil
                end
            end
            reporter:run(source, fn, ticker)
        end, times)
        self:add(owned, made)
        return made
    end

    -- Every timer of the owner's, cancelled.
    function cancelAll(owner: unknown)
        local owned = self.byOwner[owner]
        if not owned then
            return
        end
        self.byOwner[owner] = nil
        for handle in pairs(owned.handles) do
            handle:Cancel()
        end
    end

    -- How many of the owner's timers are still to run (one its owner
    -- cancelled itself doesn't count).
    function count(owner: unknown): number
        local owned = self.byOwner[owner]
        if not owned then
            return 0
        end
        local set = owned.handles
        local n = 0
        for handle in pairs(set) do
            if handle:IsCancelled() then
                set[handle] = nil
            else
                n += 1
            end
        end
        return n
    end
end

-- SuuUI's, and its methods as the module's functions.
export const timers = TimerOwners.new()

export function after(owner: unknown, source: string, gate: Gate, sec: number, fn: () -> ()): TimerHandle
    return timers:after(owner, source, gate, sec, fn)
end

export function every(
    owner: unknown,
    source: string,
    gate: Gate,
    sec: number,
    fn: (ticker: TickerHandle) -> (),
    times: number?
): TickerHandle
    return timers:every(owner, source, gate, sec, fn, times)
end

export function cancelAll(owner: unknown)
    timers:cancelAll(owner)
end

export function count(owner: unknown): number
    return timers:count(owner)
end
