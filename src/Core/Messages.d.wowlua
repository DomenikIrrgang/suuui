-- Core/Messages.d.wowlua
-- SuuUI's messages and what they carry (Docs/API.md, "SuuUI's messages").
-- `events.on`, `events.emit` and a module's `On`/`Emit` check a listener's
-- arguments and the values sent against these.

declare message SUUUI_SETTINGS_READY()
declare message SUUUI_SETTING_CHANGED(namespace: string, key: string)
declare message SUUUI_PROFILE_CHANGED(profileName: string)
declare message SUUUI_PROFILES_CHANGED()
-- the talent tree with the most points, 1-3; 0 unspecced
declare message SUUUI_SPEC_CHANGED(spec: number)
-- SUUUI_ROLE_CHANGED(role: Role) is declared with Role, in Core/Roles.
declare message SUUUI_MODULE_REGISTERED(moduleId: string)
declare message SUUUI_MODULE_ENABLED(moduleId: string)
declare message SUUUI_MODULE_DISABLED(moduleId: string)
declare message SUUUI_MODULE_ERRORED(moduleId: string)
declare message SUUUI_SETTINGS_SECTIONS_CHANGED()
declare message SUUUI_EDITMODE_CHANGED(active: boolean)
-- the group preview's size (0: off) and whether its players have auras
declare message SUUUI_EDITMODE_GROUP_PREVIEW(size: number, auras: boolean)
declare message SUUUI_ANCHOR_CHANGED(name: string, frame: Frame?)
declare message SUUUI_PIXEL_CHANGED(screenHeight: number, uiParentScale: number)
declare message SUUUI_ROOT_SCALED(effectiveScale: number)
declare message SUUUI_ROLE_PROFILES_CHANGED()
declare message SUUUI_COOLDOWNS_SETUP()
declare message SUUUI_TALENTS_SHOWN(shown: boolean)
declare message SUUUI_ADDITIONS_CHANGED(list: string)
declare message SUUUI_SERVICE_CHANGED(name: string)
declare message SUUUI_WEAPON_ENCHANTS_CHANGED()
declare message SUUUI_TALENT_BUILD_CHANGED()
declare message SUUUI_CONVERGENCES_CHANGED()
declare message SUUUI_DURABILITY_CHANGED()
-- spells to train now, and their cost in copper (nil: the setting is off)
declare message SUUUI_SPELLS_TO_TRAIN(count: number, cost: number?)
declare message SUUUI_THEME_CHANGED(theme: string)
declare message SUUUI_INDICATORS_CHANGED()
declare message SUUUI_DEFENSIVES_CHANGED()
declare message SUUUI_KEYBINDMODE_CHANGED(active: boolean)
declare message SUUUI_FAULT_TEST()
