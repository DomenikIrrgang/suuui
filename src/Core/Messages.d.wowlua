-- Core/Messages.d.wowlua
-- SuuUI's messages and what they carry (Docs/API.md, "SuuUI's messages").
-- `events.on`, `events.emit` and a module's `On`/`Emit` check a listener's
-- arguments and the values sent against these.

declare message SUUUI_SETTINGS_READY()
declare message SUUUI_SETTING_CHANGED(namespace: string, key: string)
declare message SUUUI_PROFILE_CHANGED(profileName: string)
declare message SUUUI_PROFILES_CHANGED()
-- the talent tree with the most points, 1-3; 0 unspecced
declare message SUUUI_SPEC_CHANGED(spec: number)
-- SUUUI_ROLE_CHANGED(role: Role) is declared with Role, in Core/Roles.
declare message SUUUI_MODULE_REGISTERED(moduleId: string)
declare message SUUUI_MODULE_ENABLED(moduleId: string)
declare message SUUUI_MODULE_DISABLED(moduleId: string)
declare message SUUUI_MODULE_ERRORED(moduleId: string)
declare message SUUUI_SETTINGS_SECTIONS_CHANGED()
declare message SUUUI_EDITMODE_CHANGED(active: boolean)
-- the group preview's size (0: off) and whether its players have auras
declare message SUUUI_EDITMODE_GROUP_PREVIEW(size: number, auras: boolean)
declare message SUUUI_ANCHOR_CHANGED(name: string, frame: Frame?)
declare message SUUUI_PIXEL_CHANGED(screenHeight: number, uiParentScale: number)
declare message SUUUI_ROOT_SCALED(effectiveScale: number)
-- the profile's layout for another screen size is in use ("1920x1080")
declare message SUUUI_LAYOUT_CHANGED(size: string)
declare message SUUUI_ROLE_PROFILES_CHANGED()
declare message SUUUI_COOLDOWNS_SETUP()
declare message SUUUI_TALENTS_SHOWN(shown: boolean)
declare message SUUUI_ADDITIONS_CHANGED(list: string)
declare message SUUUI_SERVICE_CHANGED(name: string)
declare message SUUUI_WEAPON_ENCHANTS_CHANGED()
declare message SUUUI_TALENT_BUILD_CHANGED()
declare message SUUUI_CONVERGENCES_CHANGED()
-- the gifts still wrapped in the collections (mounts and toys) (0.21)
declare message SUUUI_GIFTS_CHANGED(count: number)
-- a campfire passed, by you or someone in your group or guild (0.21)
declare message SUUUI_CAMPFIRES_CHANGED()
-- your mouseover bindings changed (added, removed, another spec) (0.23)
declare message SUUUI_MOUSE_BINDINGS_CHANGED()
declare message SUUUI_DURABILITY_CHANGED()
-- spells to train now, and their cost in copper (nil: the setting is off)
declare message SUUUI_SPELLS_TO_TRAIN(count: number, cost: number?)
declare message SUUUI_THEME_CHANGED(theme: string)
declare message SUUUI_INDICATORS_CHANGED()
declare message SUUUI_DEFENSIVES_CHANGED()
-- the aura filter lists or where they apply changed (0.27)
declare message SUUUI_AURA_FILTERS_CHANGED()
declare message SUUUI_KEYBINDMODE_CHANGED(active: boolean)
declare message SUUUI_FAULT_TEST()
-- the auction house showed an item (0.48; the auctionhouse module): a
-- search's or an item's offers. Copper per unit; 0: not known. `source`:
-- "search". Its name and quality when the house told them.
declare message SUUUI_AUCTION_SEEN(
    itemID: number,
    low: number,
    most: number,
    qty: number,
    n: number,
    source: string,
    name: string?,
    quality: number?
)
-- Scan all read the whole house (0.48): every item's look in one flat list,
-- five numbers each (itemID, low, most, qty, n as above), and how many
-- items; the names and qualities the house told, by item (an item the
-- client hadn't cached comes without)
declare message SUUUI_AUCTION_SCANNED(
    looks: number[],
    items: number,
    names: { [number]: string }?,
    qualities: { [number]: number }?
)
-- the Ledger's data changed (0.48): "prices", "scan", "watches" or "gold"
declare message SUUUI_LEDGER_CHANGED(what: string)
-- the price store (0.48, Core/Prices): a look changed what is kept of an
-- item (a search's); a Scan all's looks are all kept (the same flat list
-- as SUUUI_AUCTION_SCANNED, and when it was read); looks older than 60
-- days dropped (`gone`: the items with no look left)
declare message SUUUI_PRICE_CHANGED(ruleset: string, itemID: number)
declare message SUUUI_PRICES_SCANNED(ruleset: string, looks: number[], items: number, at: number)
declare message SUUUI_PRICES_PRUNED(ruleset: string, gone: number[])
-- what a character holds changed (0.48, Core/Holdings): `place` ("bags",
-- "bank", "mail", "auctions") of the character `charKey` read again; ""
-- for every character's (a module began or stopped keeping that place)
declare message SUUUI_HOLDINGS_CHANGED(place: string, charKey: string)
