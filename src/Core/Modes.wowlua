-- Core/Modes.wowlua
-- The modes that take the whole screen (SET-7): edit mode, keybind mode and
-- the settings window. Each hands over how it closes, by name; keybind mode,
-- entering, closes the other two through here. So UI/KeybindMode imports
-- neither edit mode nor the settings window, which sit above it.

local closers: { [string]: () -> () } = {}

-- How the mode `name` closes ("editmode", "settings"): fn does nothing when
-- the mode isn't open.
export function onClose(name: string, fn: () -> ())
    closers[name] = fn
end

-- Closes the mode `name` (nothing when no such mode handed itself over).
export function close(name: string)
    local fn = closers[name]
    if fn then
        fn()
    end
end
