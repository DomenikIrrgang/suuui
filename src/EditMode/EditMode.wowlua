-- EditMode/EditMode.wowlua
-- SuuUI's edit mode: every frame that registers a mover can be dragged on a
-- snap grid, nudged with the arrow keys, placed by number (its anchor, X and
-- Y in the toolbar over it), hidden and reset. It runs beside the game's own
-- Edit Mode and closes itself when combat starts.
--
--   module:RegisterMover(frame, { key = "position", label = "Hello" })
--
-- The position is a setting in the module's namespace (so it is saved per
-- profile), declared with its default in the module's defaults:
--   defaults = { position = { point = "CENTER", x = 0, y = 200 } }
-- `point` is one of the nine screen anchors and x, y the offset of the
-- frame's same point from it, in design pixels. A dropped frame takes the
-- anchor of the screen third its centre is in, so layouts keep their shape
-- on every resolution. An anchor picked in the toolbar stays
-- (position.pinned): a drag then changes only x and y, and Reset brings the
-- automatic anchor back. position.hidden hides the frame.
-- The panel's Group preview (0.17) fills the party or raid frames with
-- made-up players at their real place and size while edit mode is open:
-- groupPreview() is 0 (off), 5, 10, 20 or 40, and
-- SUUUI_EDITMODE_GROUP_PREVIEW(size) tells the group frames when it changes.

import after from "wowlua:timer"
import * as tbl from "wowlua:table"
import * as secret from "wowlua:secret"
import print, registerCommand from "/Core/Init"
import tokens as T from "/Core/Tokens"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import * as combat from "/Core/Combat"
import * as pixel from "/Core/Pixel"
import root from "/Core/Root"
import * as draw from "/UI/Draw"
import text from "/UI/Text"
import type Text from "/UI/Text"
import * as panel from "/UI/Panel"
import Panel from "/UI/Panel"
import type KeyChip from "/UI/Panel"
import * as inputs from "/UI/Inputs"
import type Segmented, Toggle, NumberField, SliderInput from "/UI/Inputs"
import * as controls from "/UI/Controls"
import type SuuButton from "/UI/Controls"
import * as pickers from "/UI/Pickers"
import type AnchorButton from "/UI/Pickers"
import * as layout from "/UI/Layout"
import type Stack from "/UI/Layout"
import * as settingsRegistry from "/SettingsUI/Registry"
import * as settingsWindow from "/SettingsUI/Window"

local S = T.space

-- A frame's place as edit mode saves it: a point of SuuUI's root and an
-- offset from it (`rel`: the frame's own point when it differs), `hidden`
-- hides the frame, `pinned` keeps the point when the frame is dragged.
export type Position = { point: FramePoint, x: number, y: number, rel?: FramePoint, hidden?: boolean, pinned?: boolean }

--- What a module passes RegisterMover: the setting (`key`, in `namespace`),
--- the frame's name in edit mode, whether it's on, and how it places itself.
export type MoverOptions = {
    key?: string,
    label?: string,
    namespace?: string,
    -- it shows in edit mode while this is truthy
    enabled?: () -> unknown,
    -- the frame places itself (a bar attached to the dock)
    place?: () -> (),
    -- a drop it takes over (truthy: it did)
    onDrop?: (l: number, b: number, w: number, h: number) -> unknown,
    -- a button of its own in the toolbar ("Attach to dock")
    action?: { label: () -> string, onClick: () -> () },
    reset?: () -> (),
    -- the frame a drag moves, when another places it
    dragFrame?: () -> Region,
    -- its module shows and hides the frame (it reads position.hidden itself)
    managedShow?: boolean,
}

--- A registered mover (what register returns).
export type Mover = {
    frame: Region,
    namespace: string,
    key: string,
    label: string,
    owner: unknown,
    enabled?: () -> unknown,
    customPlace?: () -> (),
    onDrop?: (l: number, b: number, w: number, h: number) -> unknown,
    action?: { label: () -> string, onClick: () -> () },
    onReset?: () -> (),
    dragFrame?: () -> Region,
    overlay?: MoverOverlay,
    managedShow: boolean,
}

--- What movers() lists for the layout check.
export type MoverInfo = { frame: Region, namespace: string, key: string, label: string, enabled: boolean, custom: boolean }

settings.register("layout", {
    snap = true,
    gridSize = 4,
    -- where the panel was dragged to ({ x, y }: its centre from the
    -- screen's); empty: at the screen's left
    panel = {},
})

-- The grid divides by its size: 0 or less would put frames nowhere.
settings.veto("layout", "gridSize", function(v: unknown): (boolean?, string?)
    local n = secret.asNumber(v)
    if not n or n < 4 or n > 32 then return false, "the grid size is between 4 and 32 px" end
    return nil, nil
end, "EditMode")

local moverList: Mover[] = {}   -- list of mover records
local active = false
local selected: Mover? = nil
local layer: EditLayer? = nil   -- the full-screen edit layer: grid, movers, panel
local toolbar: Toolbar? = nil
local previewSize = 0 -- the group preview chosen this session (0: off)
local previewAuras = false -- every made-up player with buffs and debuffs

--------------------------------------------------------------------------------
-- Positions
--------------------------------------------------------------------------------

-- A mover's saved position.
local function positionOf(m: Mover): Position
    local t = settings.getTable(m.namespace, m.key)
    local rel = secret.asString(t.rel)
    return {
        point = (secret.asString(t.point) or "CENTER") :: FramePoint,
        x = secret.asNumber(t.x) or 0, y = secret.asNumber(t.y) or 0,
        rel = rel and rel :: FramePoint or nil,
        hidden = t.hidden == true or nil, pinned = t.pinned == true or nil,
    }
end

-- Places `frame` at `pos` (after combat if it is protected). A mover with
-- opts.place positions its frame itself (a bar attached to the dock).
local function place(m: Mover)
    local pos = positionOf(m)
    combat.run("mover:" .. m.namespace .. "." .. m.key, function()
        local customPlace = m.customPlace
        if customPlace then
            customPlace()
        else
            m.frame:ClearAllPoints()
            m.frame:SetPoint(pos.point, root, pos.point, pos.x, pos.y)
        end
        -- A frame whose visibility its module manages (a unit frame that shows
        -- only while its unit exists) reads position.hidden itself.
        if not (m.managedShow or tbl.field(m.frame, "suuManagedShow")) then m.frame:SetShown(not pos.hidden) end
    end, m.label)
end

-- The frame's rectangle in root units (nil: it has none yet).
export function rect(frame: Region): (number?, number, number, number)
    local s = frame:GetEffectiveScale() / root:GetEffectiveScale()
    local l, b, w, h = frame:GetRect()
    if not (l and b and w and h) then return nil, 0, 0, 0 end
    return l * s, b * s, w * s, h * s
end

-- Where a point sits across and up a rectangle: 0 left or bottom, 1 right
-- or top, 0.5 the middle.
local function fractions(point: string): (number, number)
    return (point:find("LEFT") and 0) or (point:find("RIGHT") and 1) or 0.5,
        (point:find("BOTTOM") and 0) or (point:find("TOP") and 1) or 0.5
end

-- The anchor for a rectangle: `point` when given (one picked by hand), else
-- the screen third its centre falls in; and the offset of the rectangle's
-- same point from the screen's.
export function anchorFor(l: number, b: number, w: number, h: number, point: FramePoint?): (FramePoint, number, number)
    local W, H = root:GetWidth(), root:GetHeight()
    local at: FramePoint
    if point then
        at = point
    else
        local cx, cy = l + w / 2, b + h / 2
        local horiz = (cx < W / 3 and "LEFT") or (cx > W * 2 / 3 and "RIGHT") or ""
        local vert = (cy < H / 3 and "BOTTOM") or (cy > H * 2 / 3 and "TOP") or ""
        -- a side, a corner, or the centre: each one of the frame's points
        local name = vert .. horiz
        at = (name == "" and "CENTER" or name) :: FramePoint
    end
    local fx, fy = fractions(at)
    return at, l + w * fx - W * fx, b + h * fy - H * fy
end

-- The offsets from `point` that keep a w × h frame on the screen.
local function range(point: string, w: number, h: number): (number, number, number, number)
    local fx, fy = fractions(point)
    local function span(f: number, size: number, full: number): (number, number)
        local lo, hi = f * (size - full), (1 - f) * (full - size)
        if lo > hi then lo, hi = hi, lo end -- a frame larger than the screen
        lo = math.ceil(lo)
        return lo, math.max(lo, math.floor(hi))
    end
    local x0, x1 = span(fx, w, root:GetWidth())
    local y0, y1 = span(fy, h, root:GetHeight())
    return x0, x1, y0, y1
end

local function snap(v: number): number
    if not settings.get("layout", "snap") then return math.floor(v + 0.5) end
    local g = settings.getNumber("layout", "gridSize")
    return math.floor(v / g + 0.5) * g
end

-- `pinned`: the anchor was picked by hand, so drags keep it.
local function save(m: Mover, point: string, x: number, y: number, pinned: boolean?)
    local pos = tbl.copy(settings.getTable(m.namespace, m.key))
    pos.point, pos.x, pos.y = point, x, y
    if pinned then pos.pinned = true end
    settings.set(m.namespace, m.key, pos)
end

--------------------------------------------------------------------------------
-- Mover overlays
--------------------------------------------------------------------------------

-- A mover whose frame is turned off (opts.enabled says so) stays out of edit
-- mode: hiding it there is for frames that are on.
local function enabled(m: Mover): boolean
    local on = m.enabled
    return not on or on() and true or false
end

-- The settings section a frame's right-click opens (nil: none).
local function settingsSection(m: Mover?): settingsRegistry.Section?
    if not (m and m.owner) then return nil end
    return settingsRegistry.forOwner(m.owner, m.namespace)
end

-- A frame placed by another (a bar attached to the dock): a drag moves that
-- one, and its own numbers can't be typed.
local function placedByAnother(m: Mover): boolean
    local dragFrame = m.dragFrame
    return dragFrame ~= nil and dragFrame() ~= m.frame
end

local KEYS_H = 26

-- Over the frame, or under it when there is no room above (a frame at the
-- screen's top edge); the line of keys on the side away from the frame.
local function placeToolbar(bar: Toolbar, o: MoverOverlay, top: number)
    local gap = S["space-5"] + 6
    local below = root:GetHeight() - top < gap + bar:GetHeight() + S["space-2"] + KEYS_H
    local keys = bar.keys
    bar:ClearAllPoints()
    keys:ClearAllPoints()
    if below then
        bar:SetPoint("TOPRIGHT", o, "BOTTOMRIGHT", 0, -gap)
        keys:SetPoint("TOPRIGHT", bar, "BOTTOMRIGHT", 0, -S["space-2"])
    else
        bar:SetPoint("BOTTOMRIGHT", o, "TOPRIGHT", 0, gap)
        keys:SetPoint("BOTTOMRIGHT", bar, "TOPRIGHT", 0, S["space-2"])
    end
end

-- The toolbar's anchor, X and Y: the saved position, or where a frame
-- placed by another is (greyed). A field being typed in keeps its text.
local function showPosition(bar: Toolbar, m: Mover)
    local locked = placedByAnother(m)
    local pos = positionOf(m)
    local point: FramePoint, x: number, y: number = pos.point, pos.x, pos.y
    local l, b, w, h = rect(m.frame)
    if locked and l then point, x, y = anchorFor(l, b, w, h) end
    bar.anchor:SetValue(point)
    bar.anchor:SetDisabled(locked)
    for _, f in ipairs({ bar.x, bar.y }) do f:SetDisabled(locked) end
    if l then
        local x0, x1, y0, y1 = range(point, w, h)
        bar.x:SetRange(x0, x1)
        bar.y:SetRange(y0, y1)
    end
    if not bar.x:HasFocus() then bar.x:SetValue(math.floor(x + 0.5)) end
    if not bar.y:HasFocus() then bar.y:SetValue(math.floor(y + 0.5)) end
end

local function sync(m: Mover)
    local o = m.overlay
    if not o or not enabled(m) then return end
    local l, b, w, h = rect(m.frame)
    if not l then
        -- A frame that was never shown has no rectangle yet: show it to place it.
        m.frame:Show()
        l, b, w, h = rect(m.frame)
        if not l then return end
    end
    o:ClearAllPoints()
    o:SetPoint("BOTTOMLEFT", root, "BOTTOMLEFT", l, b)
    o:SetSize(w, h)
    o.size:SetValue(("%d × %d"):format(w + 0.5, h + 0.5))
    local hidden = positionOf(m).hidden
    o:SetAlpha(hidden and T.opacity["opacity-disabled"] or 1)
    draw.paintFill(o.tagBg, hidden and "ink-faint" or "arcane")
    o.tag:SetValue(m.label .. (hidden and " (hidden)" or ""))
    local on = selected == m
    -- the selected frame's tag says what its right-click does
    o.tagHint:SetShown(on and settingsSection(m) ~= nil)
    o.tagFrame:SetWidth(o.tag:GetUnboundedStringWidth() + 10
        + (o.tagHint:IsShown() and o.tagHint:GetUnboundedStringWidth() or 0))
    o.edge:SetColor("arcane", (on or o:IsMouseOver()) and 1 or 0.6)
    o.glow:SetShown(on)
    local bar = toolbar
    if on and bar then
        showPosition(bar, m)
        placeToolbar(bar, o, b + h)
    end
end

local function select(m: Mover?)
    local was = selected
    local bar = toolbar
    -- what's typed for another frame (or as edit mode closes) is dropped
    if bar and was ~= m then
        bar.x:Cancel()
        bar.y:Cancel()
        bar.anchor:Close()
    end
    selected = m
    if was then sync(was) end
    if not m or not bar then
        if bar then bar:Hide() end
        return
    end
    bar.hide:SetLabel(positionOf(m).hidden and "Show" or "Hide")
    local action = m.action
    if action then
        bar.action:SetLabel(action.label())
        bar.action:Show()
        bar:SetWidth(bar.baseWidth + S["space-2"] + 120)
    else
        bar.action:Hide()
        bar:SetWidth(bar.baseWidth)
    end
    sync(m)
    bar:Show()
end

-- A frame's outline in edit mode: dragged, clicked, right-clicked.
class MoverOverlay extends Button
    readonly wash: Texture
    readonly edge: draw.Border
    readonly glow: draw.SoftEdge
    readonly tagFrame: Frame
    readonly tagBg: Texture
    readonly tag: Text
    readonly tagHint: Text
    readonly size: Text
    mover: Mover

    constructor(parent: Frame, m: Mover)
        super(nil, parent)
        self.mover = m
        self:SetFrameLevel(parent:GetFrameLevel() + 10)
        self:SetMovable(true)
        self:SetClampedToScreen(true)
        self:RegisterForDrag("LeftButton")
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.wash = self:CreateTexture(nil, "BACKGROUND")
        self.wash:SetAllPoints()
        draw.paintFill(self.wash, "arcane", 0.06)
        self.edge = draw.border(self, "arcane")
        self.glow = draw.shadow(self, "glow-arcane")
        self.glow:SetShown(false)

        self.tagFrame = CreateFrame("Frame", nil, self)
        self.tagFrame:SetHeight(T.type.caption.lineHeight + 2)
        self.tagFrame:SetPoint("TOPLEFT", 6, 9)
        self.tagBg = draw.fill(self.tagFrame, "arcane")
        self.tagBg:SetAllPoints()
        self.tag = text(self.tagFrame, "caption", "on-signal")
        self.tag:SetPoint("LEFT", 5, 0)
        self.tagHint = text(self.tagFrame, "caption", "on-signal")
        self.tagHint:SetAlpha(0.72)
        self.tagHint:SetPoint("LEFT", self.tag, "RIGHT")
        self.tagHint:SetValue(" · right-click: settings")
        self.size = text(self, "micro", "ink-muted")
        self.size:SetShadowed(true)
        self.size:SetPoint("TOPRIGHT", self, "BOTTOMRIGHT", 0, -3)

        self:SetScript("OnEnter", function() sync(self.mover) end)
        self:SetScript("OnLeave", function() sync(self.mover) end)
        self:SetScript("OnClick", function(_, button: string)
            if button == "RightButton" then return openSettings(self.mover) end
            select(self.mover)
        end)
        self:SetScript("OnDragStart", function() self:StartDrag() end)
        self:SetScript("OnDragStop", function() self:StopDrag() end)
    end

    function StartDrag()
        local mv = self.mover
        select(mv)
        -- The frame a drag moves: the mover's own, or the one it is part of
        -- (opts.dragFrame: a bar attached to the dock moves the dock).
        local dragFrame = mv.dragFrame
        local lead = dragFrame and dragFrame() or mv.frame
        local sl, sb = rect(lead)
        local ol, ob = self:GetLeft() or 0, self:GetBottom() or 0
        self:StartMoving()
        -- The real frames follow while dragging (edit mode is never open in
        -- combat, so protected frames may move too), and every other mover's
        -- outline keeps up with them.
        self:SetScript("OnUpdate", function()
            if InCombatLockdown() or not sl then return end
            local dx, dy = (self:GetLeft() or 0) - ol, (self:GetBottom() or 0) - ob
            lead:ClearAllPoints()
            lead:SetPoint("BOTTOMLEFT", root, "BOTTOMLEFT", sl + dx, sb + dy)
            for _, other in ipairs(moverList) do
                local o = other.overlay
                if other ~= mv and o and o:IsShown() then sync(other) end
            end
        end)
    end

    function StopDrag()
        local mv = self.mover
        self:SetScript("OnUpdate", nil)
        self:StopMovingOrSizing()
        local l, b, w, h = self:GetLeft() or 0, self:GetBottom() or 0, self:GetWidth(), self:GetHeight()
        -- opts.onDrop can take the drop over (and returns true when it did).
        local onDrop = mv.onDrop
        if onDrop and onDrop(snap(l), snap(b), w, h) then
            after(0, function() if active then sync(mv) end end)
            return
        end
        local pos = positionOf(mv)
        local point, x, y = anchorFor(l, b, w, h, pos.pinned and pos.point or nil)
        save(mv, point, snap(x), snap(y))
        -- A drop that snaps back to the saved position changes no setting, so
        -- nothing else puts the frame and the outlines back on the grid.
        place(mv)
        after(0, function()
            if not active then return end
            for _, other in ipairs(moverList) do
                local o = other.overlay
                if o and o:IsShown() then sync(other) end
            end
        end)
    end

    function Stop()
        self:SetScript("OnUpdate", nil)
        self:StopMovingOrSizing()
    end
end

-- Overlays are kept per frame, so a module turned off and on again gets its
-- old overlay back instead of a new one. o.mover is the frame's current mover.
local overlays: { [Region]: MoverOverlay } = {}

local function buildOverlay(l: EditLayer, m: Mover): MoverOverlay
    local o = overlays[m.frame] or MoverOverlay.new(l, m)
    o.mover = m
    overlays[m.frame] = o
    m.overlay = o
    return o
end

--------------------------------------------------------------------------------
-- The grid and the panel
--------------------------------------------------------------------------------

local gridLines: Texture[] = {}

local function drawGrid(l: EditLayer)
    local g = settings.getNumber("layout", "gridSize")
    local W, H = root:GetWidth(), root:GetHeight()
    for _, t in ipairs(gridLines) do t:Hide() end
    local i = 0
    local function line(vertical: boolean, pos: number, alpha: number)
        i = i + 1
        local t = gridLines[i] or l:CreateTexture(nil, "BACKGROUND", nil, 1)
        gridLines[i] = t
        draw.paintFill(t, "arcane", alpha)
        t:ClearAllPoints()
        local px = pixel.size(l)
        if vertical then
            t:SetPoint("TOPLEFT", l, "TOPLEFT", pos, 0)
            t:SetPoint("BOTTOMLEFT", l, "BOTTOMLEFT", pos, 0)
            t:SetWidth(px)
        else
            t:SetPoint("BOTTOMLEFT", l, "BOTTOMLEFT", 0, pos)
            t:SetPoint("BOTTOMRIGHT", l, "BOTTOMRIGHT", 0, pos)
            t:SetHeight(px)
        end
        t:Show()
    end
    -- Lines run out from the centre, so centred frames sit on the grid.
    for x = W / 2 % g, W, g do line(true, x, 0.07) end
    for y = H / 2 % g, H, g do line(false, y, 0.07) end
    line(true, W / 2, 0.25)
    line(false, H / 2, 0.25)
end

-- the panel's inside: room for its longest row, "Buffs and debuffs on every
-- frame", with air at the edge
local PANEL_BODY = 266

-- A switch with its label, in a row of the panel.
local function switchRow(parent: Frame, label: string, value: boolean, onChange: (v: boolean) -> ()): (Frame, Toggle)
    local row = CreateFrame("Frame", nil, parent)
    row:SetSize(PANEL_BODY, 20)
    local t = inputs.toggle(row, { value = value, onChange = onChange })
    t:SetPoint("LEFT")
    local l = text(row, "label", "ink")
    l:SetValue(label)
    l:SetPoint("LEFT", t, "RIGHT", S["space-4"], 0)
    return row, t
end

class EditPanel extends Panel
    readonly stack: Stack
    readonly previewRow: Frame
    readonly previewPick: Segmented<number>
    readonly previewAuras: Toggle
    readonly snap: Toggle
    readonly gridSize: SliderInput
    readonly resetAll: SuuButton
    readonly done: SuuButton

    constructor(parent: Frame)
        super(parent, { title = "Edit mode", width = PANEL_BODY + S["space-5"] * 2 })
        self:SetFrameStrata("FULLSCREEN_DIALOG")
        self:EnableMouse(true)
        -- dragged out of the way of a frame under it (asked 2026-10-19), by
        -- anything on it that isn't a control; kept for next time, and back at
        -- the left on a double-click
        self:SetMovable(true)
        self:SetClampedToScreen(true)
        self:RegisterForDrag("LeftButton")
        self:SetScript("OnDragStart", function() self:StartMoving() end)
        self:SetScript("OnDragStop", function()
            self:StopMovingOrSizing()
            local x, y = self:GetCenter()
            local rx, ry = root:GetCenter()
            local k = self:GetEffectiveScale() / root:GetEffectiveScale()
            settings.set("layout", "panel", { x = math.floor((x or 0) * k - (rx or 0) + 0.5),
                                              y = math.floor((y or 0) * k - (ry or 0) + 0.5) })
            self:Place()
        end)
        -- (a frame has no OnDoubleClick: two clicks within 0.35 s)
        local last = 0
        self:SetScript("OnMouseUp", function(_, button: string)
            if button ~= "LeftButton" then return end
            local now = GetTime()
            if now - last < 0.35 then
                last = 0
                settings.set("layout", "panel", {})
                self:Place()
            else
                last = now
            end
        end)
        local stack = layout.stack(self.body, { gap = S["space-4"], autoSize = "height" })
        self.stack = stack

        local snapRow, snapToggle = switchRow(self.body, "Snap to grid", settings.get("layout", "snap") == true,
            function(v: boolean) settings.set("layout", "snap", v) end)
        self.snap = snapToggle
        stack:Add(snapRow)

        local size = inputs.slider(self.body, { label = "Grid size", min = 4, max = 32, step = 4, unit = "px", width = PANEL_BODY,
            value = settings.getNumber("layout", "gridSize"),
            onChange = function(v: number) settings.set("layout", "gridSize", v) end })
        self.gridSize = size
        stack:Add(size)

        -- made-up players in the group frames, at their real place and size
        local previewRow = CreateFrame("Frame", nil, self.body)
        previewRow:SetSize(PANEL_BODY, T.type.label.lineHeight + S["space-2"] + 28)
        self.previewRow = previewRow
        local previewLabel = text(previewRow, "label", "ink")
        previewLabel:SetValue("Group preview (players)")
        previewLabel:SetPoint("TOPLEFT")
        self.previewPick = inputs.segmented(previewRow, {
            -- players in the group: 5 the party, more the raid (fits the body)
            options = { { value = 0, label = "Off" }, { value = 5, label = "5" }, { value = 10, label = "10" },
                        { value = 20, label = "20" }, { value = 40, label = "40" } },
            value = previewSize,
            onChange = function(v: number) setGroupPreview(v) end })
        self.previewPick:SetPoint("TOPLEFT", previewLabel, "BOTTOMLEFT", 0, -S["space-2"])
        stack:Add(previewRow)
        -- everyone with defensives and every dispel type, to see the icons fit
        local aurasRow, aurasToggle = switchRow(self.body, "Buffs and debuffs on every frame", previewAuras,
            function(v: boolean) setGroupPreview(previewSize, v) end)
        self.previewAuras = aurasToggle
        stack:Add(aurasRow)

        local buttons = CreateFrame("Frame", nil, self.body)
        local bs = layout.stack(buttons, { direction = "horizontal", gap = S["space-4"] })
        self.resetAll = controls.button(buttons, { text = "Reset all", onClick = function()
            -- each mover's own reset (opts.reset), as the toolbar's Reset does
            for _, m in ipairs(moverList) do
                local onReset = m.onReset
                if onReset then onReset() else settings.reset(m.namespace, m.key) end
            end
        end })
        bs:Add(self.resetAll)
        self.done = controls.button(buttons, { text = "Done", variant = "primary", onClick = function() exit() end })
        bs:Add(self.done)
        stack:Add(buttons)
        self:Place()
    end

    function Place()
        local at = settings.getTable("layout", "panel")
        local x, y = secret.asNumber(at.x), secret.asNumber(at.y)
        self:ClearAllPoints()
        if x and y then
            self:SetPoint("CENTER", root, "CENTER", x, y)
        else
            self:SetPoint("LEFT", root, "LEFT", S["space-7"], 0)
        end
    end
end

-- A key and what it does, in the line of keys.
type KeyPart = { key: string, chip: KeyChip, text: Text }

-- The line of keys beside the toolbar while X or Y has focus, or what Enter
-- does with a value past the screen's edge.
class KeysLine extends Frame
    readonly parts: KeyPart[] = {}
    readonly warning: Text

    constructor(bar: Frame)
        super(nil, bar)
        self:SetHeight(KEYS_H)
        self:SetClampedToScreen(true)
        self:Hide()
        draw.fill(self, "surface"):SetAllPoints()
        draw.border(self, "gilt-line")
        for _, p in ipairs({ { "Enter", "applies" }, { "Tab", "Y" }, { "Esc", "cancels" }, { "↑ ↓", "1 px, Shift 10" } }) do
            local label = text(self, "micro", "ink-muted")
            label:SetValue(p[2])
            self.parts[#self.parts + 1] = { key = p[1], chip = panel.keyChip(self, p[1]), text = label }
        end
        self.warning = text(self, "micro", "amber")
        self.warning:SetPoint("LEFT", S["space-3"], 0)
        self.warning:Hide()
    end

    function Layout()
        local x = S["space-3"]
        for i, p in ipairs(self.parts) do
            p.chip:SetKey(p.key) -- measured again (a theme changes the text size)
            p.chip:SetPoint("LEFT", x, 0)
            x = x + p.chip:GetWidth() + S["space-2"]
            p.text:SetPoint("LEFT", x, 0)
            x = x + p.text:GetUnboundedStringWidth() + (i < #self.parts and S["space-3"] or 0)
        end
        if self.warning:IsShown() then x = S["space-3"] + self.warning:GetUnboundedStringWidth() end
        self:SetWidth(x + S["space-3"])
    end

    -- nil: the keys; text: the warning instead
    function Warn(warning: string?)
        self.warning:SetValue(warning or "")
        self.warning:SetShown(warning ~= nil)
        for _, p in ipairs(self.parts) do
            p.chip:SetShown(warning == nil)
            p.text:SetShown(warning == nil)
        end
        self:Layout()
    end

    -- shown for a field: Tab goes to `nextLetter`
    function For(nextLetter: string)
        self.parts[2].text:SetValue(nextLetter)
        self:Warn(nil)
        self:Show()
    end
end

class Toolbar extends Panel
    readonly keys: KeysLine
    readonly anchor: AnchorButton
    readonly x: NumberField
    readonly y: NumberField
    readonly rule: Texture
    readonly hide: SuuButton
    readonly reset: SuuButton
    readonly action: SuuButton
    readonly baseWidth: number

    constructor(parent: Frame)
        super(parent, { solid = true, shadow = true })
        self.body:SetScript("OnSizeChanged", nil)
        self.body:Hide()
        self:SetFrameStrata("FULLSCREEN_DIALOG")
        self:SetClampedToScreen(true) -- a frame at the screen's left or right edge
        self.keys = KeysLine.new(self)

        -- The anchor: a new one leaves the frame where it is (X and Y converted)
        -- and stays when the frame is dragged.
        self.anchor = pickers.anchorButton(self, {
            note = "The frame stays where it is; X and Y now measure from this point.",
            tooltip = function(): { description: string }
                local m = selected
                if m and placedByAnother(m) then
                    return { description = "It moves with the frame it's attached to. Detach it to place it by number." }
                end
                if m and positionOf(m).pinned then
                    return { description = "The screen point X and Y measure from, picked by you: it stays when you drag the frame. Reset brings the automatic one back." }
                end
                return { description = "The screen point X and Y measure from, the screen third the frame is in. Click to pick one that stays." }
            end,
            onChange = function(point: FramePoint)
                local m = selected
                if not m then return end
                local l, b, w, h = rect(m.frame)
                if not l or placedByAnother(m) then return end
                local _, x, y = anchorFor(l, b, w, h, point)
                save(m, point, math.floor(x + 0.5), math.floor(y + 0.5), true)
            end })
        self.anchor:SetPoint("LEFT", 3, 0)

        -- X and Y: typed values skip the snap grid and keep the frame on screen.
        local fields: { [string]: NumberField } = {}
        local function field(letter: string, other: string): NumberField
            local f = inputs.numberField(self, { letter = letter,
                onChange = function(v: number)
                    local m = selected
                    if not m or placedByAnother(m) then return end
                    local pos = positionOf(m)
                    local x, y = pos.x, pos.y
                    if letter == "X" then x = v else y = v end
                    save(m, pos.point, x, y)
                end,
                onFocus = function(on: boolean)
                    if on then
                        self.anchor:Close()
                        self.keys:For(other)
                    else
                        self.keys:Hide()
                    end
                end,
                onTab = function()
                    local next = fields[other]
                    if next then next:Focus() end
                end,
                onTyping = function(n: number?)
                    local f = fields[letter]
                    local kept = n and f and f:Clamp(n)
                    self.keys:Warn(kept and kept ~= n and ("Off screen past %d: Enter keeps it at %d."):format(kept, kept) or nil)
                end })
            fields[letter] = f
            return f
        end
        self.x = field("X", "Y")
        self.x:SetPoint("LEFT", self.anchor, "RIGHT", S["space-2"], 0)
        self.y = field("Y", "X")
        self.y:SetPoint("LEFT", self.x, "RIGHT", S["space-2"], 0)
        self.rule = draw.fill(self, "gilt-line", "ARTWORK")
        self.rule:SetSize(pixel.size(self), 20)
        self.rule:SetPoint("LEFT", self.y, "RIGHT", S["space-3"], 0)

        self.hide = controls.button(self, { text = "Hide", width = 60, onClick = function()
            local m = selected
            if not m then return end
            local pos = tbl.copy(settings.getTable(m.namespace, m.key))
            pos.hidden = not pos.hidden or nil
            settings.set(m.namespace, m.key, pos)
            select(m)
        end })
        self.hide:SetPoint("LEFT", self.y, "RIGHT", S["space-3"] * 2 + 1, 0)
        self.reset = controls.button(self, { text = "Reset", width = 60, onClick = function()
            local m = selected
            if not m then return end
            local onReset = m.onReset
            if onReset then onReset() else settings.reset(m.namespace, m.key) end
        end })
        self.reset:SetPoint("LEFT", self.hide, "RIGHT", S["space-2"], 0)
        -- A mover's own action (opts.action), e.g. "Attach to dock".
        self.action = controls.button(self, { text = "", width = 120, onClick = function()
            local m = selected
            local action = m and m.action
            if m and action then
                action.onClick()
                after(0, function() if active and selected == m then select(m) end end)
            end
        end })
        self.action:SetPoint("LEFT", self.reset, "RIGHT", S["space-2"], 0)
        self.baseWidth = 3 + 30 + S["space-2"] + self.x:GetWidth() + S["space-2"] + self.y:GetWidth()
            + S["space-3"] * 2 + 1 + 60 + S["space-2"] + 60 + 3
        self:SetSize(self.baseWidth, 36)
    end
end

-- The arrow keys' nudges.
local NUDGE: { [string]: number[] } = { UP = { 0, 1 }, DOWN = { 0, -1 }, LEFT = { -1, 0 }, RIGHT = { 1, 0 } }

-- The full-screen edit layer: a wash, the grid, the movers, the panel.
class EditLayer extends Frame
    readonly wash: Texture
    readonly panel: EditPanel
    readonly toolbar: Toolbar

    constructor()
        super("SuuUIEditMode", root)
        self:SetAllPoints(root)
        self:SetFrameStrata("FULLSCREEN")
        -- The layer itself never takes the mouse, so the camera and the world
        -- stay usable; only the movers, the toolbar and the panel do.
        self:EnableMouse(false)
        self:EnableKeyboard(true)
        self:Hide()
        self.wash = self:CreateTexture(nil, "BACKGROUND")
        self.wash:SetAllPoints()
        self.wash:SetColorTexture(0, 0, 0, 0.25)
        self:SetScript("OnKeyDown", function(_, key: string) self:Key(key) end)
        self.panel = EditPanel.new(self)
        self.toolbar = Toolbar.new(self)
        self.toolbar:Hide()
    end

    function Key(key: string)
        local bar = toolbar
        local nudge = NUDGE[key]
        local m = selected
        if not bar then return end
        if bar.x:HasFocus() or bar.y:HasFocus() then
            self:SetPropagateKeyboardInput(true) -- the field's own keys
        elseif key == "ESCAPE" and bar.anchor:IsOpen() then
            self:SetPropagateKeyboardInput(false)
            bar.anchor:Close()
        elseif key == "ESCAPE" then
            self:SetPropagateKeyboardInput(false)
            exit()
        elseif key == "ENTER" and m and not placedByAnother(m) then
            -- Enter starts typing the selected frame's X (once this key is
            -- done, so the field doesn't take it as its own Enter)
            self:SetPropagateKeyboardInput(false)
            after(0, function() if active and selected then bar.x:Focus() end end)
        elseif nudge and m then
            self:SetPropagateKeyboardInput(false)
            local step = IsShiftKeyDown() and 10 or 1
            local l, b, w, h = rect(m.frame)
            local onDrop = m.onDrop
            if onDrop and l and onDrop(l + nudge[1] * step, b + nudge[2] * step, w, h) then
                after(0, function() if active then sync(m) end end)
            else
                local pos = positionOf(m)
                save(m, pos.point, pos.x + nudge[1] * step, pos.y + nudge[2] * step)
            end
        else
            self:SetPropagateKeyboardInput(true)
        end
    end
end

local function theLayer(): EditLayer
    local l = layer
    if l then return l end
    l = EditLayer.new()
    layer = l
    toolbar = l.toolbar
    return l
end

--------------------------------------------------------------------------------
-- Entering and leaving
--------------------------------------------------------------------------------

export function isActive(): boolean
    return active
end

export function enter(): boolean
    if active then return true end
    if InCombatLockdown() then
        print("Edit mode opens out of combat.")
        return false
    end
    local l = theLayer()
    active = true
    l:Show()
    drawGrid(l)
    for _, m in ipairs(moverList) do
        local o = m.overlay or buildOverlay(l, m)
        o:SetShown(enabled(m))
        sync(m)
    end
    select(nil)
    events.emit("SUUUI_EDITMODE_CHANGED", true)
    if previewSize > 0 or previewAuras then events.emit("SUUUI_EDITMODE_GROUP_PREVIEW", previewSize, previewAuras) end
    return true
end

-- The group preview while edit mode is open: its size, 0 (off), 5, 10, 20
-- or 40, and whether every made-up player carries buffs and debuffs.
export function groupPreview(): (number, boolean)
    return active and previewSize or 0, previewAuras
end

export function setGroupPreview(size: number?, auras: boolean?)
    previewSize = size or 0
    if auras ~= nil then previewAuras = auras and true or false end
    local p = layer and layer.panel
    if p then
        p.previewPick:SetValue(previewSize)
        p.previewAuras:SetValue(previewAuras)
    end
    if active then events.emit("SUUUI_EDITMODE_GROUP_PREVIEW", previewSize, previewAuras) end
end

export function exit()
    if not active then return end
    active = false
    select(nil)
    local l = layer
    if l then l:Hide() end
    for _, m in ipairs(moverList) do
        local o = m.overlay
        if o then o:Stop() end
        place(m)
    end
    events.emit("SUUUI_EDITMODE_CHANGED", false)
    if previewSize > 0 or previewAuras then events.emit("SUUUI_EDITMODE_GROUP_PREVIEW", 0, false) end
end

-- A frame's settings (its right-click): edit mode closes and the Settings
-- window opens at its module's section.
export function openSettings(m: Mover?)
    local section = settingsSection(m)
    if not section then
        print(("%s has no settings of its own."):format(m and m.label or "This frame"))
        return
    end
    exit()
    settingsWindow.open(section.id)
end

export function toggle()
    if active then exit() else enter() end
end

-- Re-reads every mover's `enabled` (a module calls it when one changes).
export function refresh()
    if not active then return end
    for _, m in ipairs(moverList) do
        local o = m.overlay
        if o then
            local on = enabled(m)
            o:SetShown(on)
            if not on and selected == m then select(nil) end
            if on then after(0, function() if active then sync(m) end end) end
        end
    end
end

-- A click anywhere but on a mover, the toolbar or the panel deselects. A
-- click away from a field being typed in applies it first.
events.onGame("GLOBAL_MOUSE_DOWN", function()
    local bar, l = toolbar, layer
    if not (active and selected and bar and l) then return end
    for _, f in ipairs({ bar.x, bar.y }) do
        if f:HasFocus() and not f:IsMouseOver() then f.edit:ClearFocus() end
    end
    if bar:IsMouseOver() or bar.anchor:PopoverHasMouse() or l.panel:IsMouseOver() then return end
    for _, m in ipairs(moverList) do
        local o = m.overlay
        if o and o:IsShown() and o:IsMouseOver() then return end
    end
    select(nil)
end, "EditMode")

events.onGame("PLAYER_REGEN_DISABLED", function()
    if active then
        exit()
        print("Edit mode closed: combat started.")
    end
end, "EditMode")

settings.watch("layout", "gridSize", function()
    local l = layer
    if active and l then drawGrid(l) end
end, "EditMode")
events.on("SUUUI_ROOT_SCALED", function()
    local bar, l = toolbar, layer
    if bar then bar.rule:SetWidth(pixel.size(bar)) end
    if active and l then drawGrid(l) end
end, "EditMode")
-- a theme change: what is sized by a text style's line height (colours
-- follow by themselves)
events.on("SUUUI_THEME_CHANGED", function()
    for _, o in pairs(overlays) do o.tagFrame:SetHeight(T.type.caption.lineHeight + 2) end
    local bar = toolbar
    if bar then bar.keys:Layout() end
    local p = layer and layer.panel
    if p then
        p.previewRow:SetHeight(T.type.label.lineHeight + S["space-2"] + 28)
        p.stack:Invalidate()
    end
    if active then
        for _, m in ipairs(moverList) do
            local o = m.overlay
            if o and o:IsShown() then sync(m) end
        end
    end
end, "EditMode")

--------------------------------------------------------------------------------
-- Registering movers
--------------------------------------------------------------------------------

-- `namespace.key` must be a registered setting holding a position table.
export function register(frame: Region, opts: MoverOptions, owner: unknown?): Mover
    local m: Mover = {
        frame = frame, namespace = opts.namespace or "", key = opts.key or "position",
        label = opts.label or frame:GetName() or "Frame", owner = owner,
        enabled = opts.enabled,
        customPlace = opts.place, onDrop = opts.onDrop, action = opts.action, onReset = opts.reset,
        dragFrame = opts.dragFrame,
        managedShow = opts.managedShow == true,
    }
    assert(type(settings.get(m.namespace, m.key)) == "table",
        "SuuUI RegisterMover: " .. m.namespace .. "." .. m.key .. " must be a position table in the defaults")
    moverList[#moverList + 1] = m
    settings.watch(m.namespace, m.key, function()
        place(m)
        if active then
            -- Let the frame settle at its new place before the overlay follows.
            after(0, function() if active then sync(m) end end)
        end
    end, m)
    place(m)
    local l = layer
    if active and l then
        local o = buildOverlay(l, m)
        o:SetShown(enabled(m))
        after(0, function() sync(m) end)
    end
    return m
end

-- Every registered mover, for the layout check (LayoutCheck.wowlua): its frame,
-- namespace and key, label, enabled() and whether it places itself.
export function movers(): MoverInfo[]
    local out: MoverInfo[] = {}
    for _, m in ipairs(moverList) do
        out[#out + 1] = { frame = m.frame, namespace = m.namespace, key = m.key, label = m.label,
            enabled = enabled(m), custom = m.customPlace ~= nil }
    end
    return out
end

-- For movers that place themselves: a frame's rectangle in root units, and
-- the screen anchor edit mode would save for a rectangle: rect and
-- anchorFor, above.

export function unregister(owner: unknown)
    for i = #moverList, 1, -1 do
        local m = moverList[i]
        if m.owner == owner then
            settings.unwatch(m)
            local o = m.overlay
            if o then
                o:Stop()
                o:Hide()
            end
            if selected == m then select(nil) end
            table.remove(moverList, i)
        end
    end
end

registerCommand("edit", "Move SuuUI's frames: edit mode with a snap grid.", toggle)
