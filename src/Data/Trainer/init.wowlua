-- Data/Trainer/init.wowlua
-- What your class's trainer teaches, and every spell ID of each of its
-- names. Each class's file (Data/Trainer/<CLASS>.wowlua, generated by
-- tools/gen_trainer.lua) builds its own lists; only your class's are built,
-- as only your class's file loaded when they were plain Lua.

import * as secret from "wowlua:secret"
import * as druid from "./DRUID"
import * as hunter from "./HUNTER"
import * as mage from "./MAGE"
import * as paladin from "./PALADIN"
import * as priest from "./PRIEST"
import * as rogue from "./ROGUE"
import * as shaman from "./SHAMAN"
import * as warlock from "./WARLOCK"
import * as warrior from "./WARRIOR"

--- A spell the trainer teaches: required level, cost in copper, school (the
--- trainer's skill line), icon and description (either may be missing)
export type TrainerSpell = { name: string, level: number, cost: number, school: string, icon?: number, text?: string }
--- name -> every spell ID with that name (players' ranks and the rest)
export type TrainerSpellIDs = { [string]: number[] }

type ClassFile = { spells: () -> TrainerSpell[], spellIDs: () -> TrainerSpellIDs }

const FILES: { [string]: ClassFile } = {
    DRUID = druid, HUNTER = hunter, MAGE = mage, PALADIN = paladin, PRIEST = priest,
    ROGUE = rogue, SHAMAN = shaman, WARLOCK = warlock, WARRIOR = warrior,
}

local _, classFile = UnitClass("player")
local file = FILES[secret.known(classFile, "")]

--- Your class's trainer spells; nil for a class without a file
export local trainerSpells: TrainerSpell[]? = file and file.spells() or nil
--- Your class's spell IDs by name; nil for a class without a file
export local trainerSpellIDs: TrainerSpellIDs? = file and file.spellIDs() or nil
