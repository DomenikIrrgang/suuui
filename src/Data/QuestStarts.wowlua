-- Data/QuestStarts.wowlua (generated by tools/gen_quest_starts.lua: do not edit)
-- Where each of Forever's quests is picked up, for the world map.
--   QuestieDB Forever data with its corrections, commit e9a67d1a2753a0e64c4c96bf7864788fac7b765f (github.com/Questie/QuestieDB, no license stated)
--   and its pull requests not merged yet: #103@68c5456
--   fetched 2026-10-19; rebuild: sh tools/update_quest_starts.sh
--   quests[id] = { name, minLevel, level, races (mask), classes (mask), preGroup (all), preSingle (any),
--                  exclusiveTo, nextInChain, specialFlags (1 repeatable, 2 needs an event), parentQuest,
--                  breadcrumbFor, requiredSkill {skillLine, value}, minRep {faction, value}, maxRep {faction, value},
--                  event (shown only while it's on: "darkmoonFaire", "lunarFestival", … a holiday; "warEffort",
--                  "invasion" one-off server events; "seasonal" some holiday) }
--   tags[id] = the quest's tag where the game's is wrong (1 elite, 41 PvP, 62 raid, 81 dungeon, …; the Questie addon's
--              corrections for the original game, github.com/Questie/Questie 2e9175880b1cac2ca3d39ddac374d5f29d8b15b8, no license stated)
--   group[id] = "elite", "dungeon" or "raid": a quest that needs a group, until the game has told (set in a dungeon
--               or raid, or Classic's type: cMaNGOS classic-db ec4f596146be6467ea93c57397858e329e2db852, GPL-3.0); Forever's new quests only by their zone
--   objectives[id] = what the quest asks (its objectives text; $N, $C, $R and $Gmale:female; as the game writes them)
--   maps[uiMapID] = { { x, y, giver, questID, ... }, ... }   (x, y in percent; giver an NPC's ID, an object's negative)
--   drops[uiMapID] = { { x, y, source, itemID, questID, ... }, ... }   (quests started by an item: where a mob
--                    (source: an NPC's ID, an object's negative) that drops it lives)
--   items[itemID] = name; givers[giver or source] = name
--   entrances[uiMapID] = { { x, y, name, kind ("dungeon", "raid", "battleground"), faction ("H", "A" or nil), approx (true: the spot isn't known, only its area) }, ... }
--   routes[npcID] = { [uiMapID] = { { x, y, x, y, ... }, ... } }   (a quest giver who walks: his paths)

--- quests[id] and entrances' rows are mixed lists (see above), so any[]
export type QuestStarts = {
    quests: { [number]: any[] },
    objectives: { [number]: string },
    tags: { [number]: number },
    group: { [number]: string },
    maps: { [number]: number[][] },
    drops: { [number]: number[][] },
    items: { [number]: string },
    givers: { [number]: string },
    entrances: { [number]: any[][] },
    routes: { [number]: { [number]: number[][] } },
}

