    [92457] = "Defeat 8 Seeking Remnants, 8 Saturated Remnants, and 8 Mana Echoes inside the City of Dalaran for Archmage Modera outside of Dalaran.",
    [92458] = "Collect the Arcane Mote for the Image of Archmage Modera near the City of Dalaran.",
    [92459] = "Speak to Archmage Celindra in the City of Dalaran.",
