    [2842] = "Speak with Scooty in Booty Bay.",
    [2843] = "Wait for Scooty to calibrate the Goblin Transponder.",
    [2844] = "Locate the lost night elf girl.",
    [2845] = "Pick up Shay's Bell from the chest. Escort Shay Leafrunner to Rockbiter's camp.",
    [2846] = "Bring the Tiara of the Deep to Tabetha in Dustwallow Marsh.",
    [2847] = "Bring 10 Thick Leather to Pratt McGrubben in Feathermoon Stronghold.",
    [2848] = "Bring 6 Thick Armor Kits and a Wildvine to Pratt McGrubben in Feathermoon Stronghold.",
    [2849] = "Bring 2 Turtle Scale Breastplates, 2 Turtle Scale Gloves, and a Wildvine to Pratt McGrubben in Feathermoon Stronghold.",
    [2850] = "Bring 2 Nightscape Tunics, 2 Nightscape Headbands, and a Wildvine to Pratt McGrubben in Feathermoon Stronghold.",
    [2851] = "Bring 2 Nightscape Pants, 2 Nightscape Boots, and 2 Wildvines to Pratt McGrubben in Feathermoon Stronghold.",
    [2852] = "Bring 2 Turtle Scale Helms, 2 Turtle Scale Bracers, and 2 Wildvines to Pratt McGrubben in Feathermoon Stronghold.",
    [2853] = "Give Pratt's Letter to Telonis, the master leatherworker of Darnassus.",
    [2854] = "Bring 10 Thick Leather to Jangdor Swiftstrider in Camp Mojache.",
    [2855] = "Bring 6 Thick Armor Kits and a Wildvine to Jangdor Swiftstrider in Camp Mojache.",
    [2856] = "Bring 2 Turtle Scale Breastplates, 2 Turtle Scale Gloves, and a Wildvine to Jangdor Swiftstrider in Camp Mojache.",
    [2857] = "Bring 2 Nightscape Tunics, 2 Nightscape Headbands, and a Wildvine to Jangdor Swiftstrider in Camp Mojache.",
    [2858] = "Bring 2 Nightscape Pants, 2 Nightscape Boots, and 2 Wildvines to Jangdor Swiftstrider in Camp Mojache.",
    [2859] = "Bring 2 Turtle Scale Helms, 2 Turtle Scale Bracers, and 2 Wildvines to Jangdor Swiftstrider in Camp Mojache.",
    [2860] = "Give Jangdor's Letter to Una, the master leatherworker of Thunder Bluff.",
    [2861] = "Speak with Tabetha in Dustwallow Marsh.",
    [2862] = "Bring 10 Woodpaw Gnoll Manes to Hadoken Swiftstrider in Camp Mojache.",
    [2863] = "Kill 5 Woodpaw Alphas and return to Hadoken Swiftstrider within one hour.",
    [2864] = "Speak with Tran'rek in Gadgetzan.",
    [2865] = "Bring 5 Uncracked Scarab Shells to Tran'rek in Gadgetzan.",
    [2866] = "Explore the Ruins of Solarsal and investigate the presence of the naga there.",
    [2867] = "Return to Shandris Feathermoon in the Feathermoon Stronghold and report your findings.",
    [2869] = "Bring 10 Hatecrest Naga Scales to Latronicus Moonspear in Feathermoon Stronghold.",
    [2870] = "Eliminate Lord Shalzaru, and then bring the Mysterious Relic he uncovered to Latronicus Moonspear in Feathermoon Stronghold.",
    [2871] = "Deliver the Mysterious Relic to Vestia Moonspear in Feathermoon Stronghold.",
    [2872] = "Speak with Stoley in Steamwheedle Port.",
    [2873] = "Bring Stoley's Shipment to Stoley in Steamwheedle Port.",
    [2874] = "Bring Stoley's Bottle to \"Sea Wolf\" MacKinley in Booty Bay.",
    [2875] = "Bring Andre's Head to Security Chief Bilgewhizzle in Steamwheedle Port.",
    [2877] = "Kill 10 Green Sludges and 10 Jade Oozes, and then report back to Fraggar Thundermantle in Aerie Peak.",
    [2879] = "Energize Troyas' Stave and find the Equinex Monolith.",
    [2880] = "Bring 5 Troll Tribal Necklaces to Fraggar Thundermantle in Aerie Peak.",
    [2902] = "Find the gnoll battle plans somewhere in the gnoll camps to the south of Camp Mojache.",
    [2903] = "Bring the Woodpaw Battle Plans to Hadoken Swiftstrider in Camp Mojache.",
    [2922] = "Bring Techbot's Memory Core to Tinkmaster Overspark in Ironforge.",
    [2923] = "Speak with Tinkmaster Overspark in Ironforge.",
    [2924] = "Bring 12 Essential Artificials to Klockmort Spannerspan in Ironforge.",
    [2925] = "Speak with Klockmort Spannerspan in Ironforge.",
    [2926] = "Use the Empty Leaden Collection Phial on Irradiated Invaders or Irradiated Pillagers to collect radioactive fallout. Once it is full, take it back to Ozzie Togglevolt in Kharanos.",
    [2927] = "Speak with Ozzie Togglevolt in Kharanos.",
    [2928] = "Bring twenty-four Robo-mechanical Guts to Shoni in Stormwind.",
    [2929] = "Venture to Gnomeregan and kill Mekgineer Thermaplugg. Return to High Tinker Mekkatorque when the task is complete.",
    [2930] = "Bring a Prismatic Punch Card to Master Mechanic Castpipe in Ironforge.",
    [2931] = "Speak with Master Mechanic Castpipe in Ironforge.",
    [2932] = "Gather Witherbark Skulls and place on Nimboya's Pike. Place Nimboya's Laden Pike at one of the Witherbark Villages in the Hinterlands, then return to Nimboya in Stranglethorn.",
    [2933] = "Bring a Venom Bottle to an apothecary in Tarren Mill.",
    [2934] = "Bring an Undamaged Venom Sac to Apothecary Lydon in Tarren Mill.",
    [2935] = "Speak with Master Gadrin in Sen'jin Village.",
    [2936] = "Read from the Tablet of Theka to learn the name of the Witherbark spider god, then return to Master Gadrin.",
    [2937] = "Defeat Shadra at the altar of Shadra'Alor, then bring her venom to Apothecary Lydon in Tarren Mill.",
    [2938] = "Bring Faranell's Parcel to Master Apothecary Faranell in the Undercity.",
    [2939] = "Talk to Daryn Lightwind in Rut'theran Village.",
    [2940] = "Ask Daryn Lightwind if you may borrow her book.",
    [2941] = "Take the letter to Curgle Cranklehop in Tanaris.",
    [2942] = "Return the Sparkling Stone and the Stave of Equinex to Troyas Moonbreeze in Feathermoon Stronghold.",
    [2943] = "Deliver the book to Troyas Moonbreeze in Feathermoon Stronghold.",
    [2944] = "Use the Super Snapper FX to take a snapshot of Gammerita, then return to Daryn Lightwind in Rut'theran Village.",
    [2946] = "Bring the miniature platinum discs to the gates of Uldum in Tanaris and look for clues as to the connection between the two.",
    [2948] = "Bring the Brilliant Gold Ring, a Silver Bar, a Moss Agate, and 30 silver coins to Talvash del Kissel in Ironforge.",
    [2950] = "Bring the Brilliant Gold Ring, a Silver Bar, a Moss Agate, and 30 silver coins to Nogg in Orgrimmar.",
    [2954] = "Learn the purpose of the Stone Watcher of Norgannon, and then interact with the Uldum Pedestal in the Tanaris desert.",
    [2962] = "Travel to Gnomeregan and bring back High Potency Radioactive Fallout. Be warned, the fallout is unstable and will collapse rather quickly. Ozzie will also require your Heavy Leaden Collection Phial when the task is complete.",
    [2963] = "Speak with Historian Karnik in the Hall of Explorers within Ironforge.",
    [2964] = "Speak with High Explorer Magellas in Ironforge.",
    [2965] = "Speak with Nara Wildmane on the Elder Rise in Thunder Bluff.",
    [2966] = "Bring the miniature platinum discs to the gates of Uldum in Tanaris and look for clues as to the connection between the two.",
    [2967] = "Speak with Nara Wildmane in Thunder Bluff.",
    [2968] = "Speak with Sage Truthseeker in Thunder Bluff.",
    [2969] = "Using the Bamboo Cage Key, free the Sprite Darters from the pen in the Grimtotem camp. At least 6 Sprite Darters and Kindal Moonweaver must survive. You have 6 minutes before Kindal decides it is time to retreat and you fail the quest.",
    [2970] = "Kill 12 Grimtotem Naturalists, 10 Grimtotem Raiders, and 6 Grimtotem Shamans before returning to Jer'kai Moonweaver in Feralas.",
    [2972] = "Take Jer'kai's Signet Ring to High Priestess Tyrande Whisperwind in Darnassus.",
    [2973] = "Bring 10 Iridescent Sprite Darter Wings to Krueg Skullsplitter in Camp Mojache.",
    [2974] = "Bring 20 Grimtotem Horns to Krueg Skullsplitter in Camp Mojache.",
    [2975] = "Rok Orhan in Camp Mojache wants you to kill 10 Gordunni Ogres, 10 Gordunni Ogre-Magi, and 5 Gordunni Brutes.",
    [2976] = "Bring the Crate of Grimtotem Horns to Belgrom Rockmaul in Orgrimmar.",
    [2977] = "Speak with Historian Karnik in Ironforge.",
    [2978] = "Bring the Gordunni Scroll to Rok Orhan in Camp Mojache.",
    [2979] = "Rok Orhan in Camp Mojache wants you to find a Gordunni Orb.",
    [2980] = "Rok Orhan in Camp Mojache wants you to kill 10 Gordunni Shaman, 10 Gordunni Warlocks, and 5 Gordunni Maulers.",
    [2981] = "Belgrom Rockmaul wants you to speak with Rok Orhan in Camp Mojache.",
    [2982] = "Angelas Moonbreeze wants you to kill 8 Gordunni Warlocks, 8 Gordunni Shaman, and 8 Gordunni Brutes.",
    [2983] = "Find Kranal Fiss in the Barrens.",
    [2984] = "Find Kranal Fiss in the Barrens.",
    [2985] = "Find Islen Waterseer in the Barrens.",
    [2986] = "Find Islen Waterseer in the Barrens.",
    [2987] = "Orwin Gizzmick in Camp Mojache wants 12 samples of Gordunni Cobalt.",
    [2988] = "Check the cages at the two Witherbark villages, then return to Gryphon Master Talonaxe.",
    [2989] = "Check the top of the Altar of Zul, then return to Gryphon Master Talonaxe.",
    [2990] = "Bring Sharpbeak's Feather to Thadius Grimshade in the Blasted Lands.",
    [2991] = "Bring Nekrum's Medallion to Thadius Grimshade in the Blasted Lands.",
    [2992] = "Wait until Grimshade performs the ritual of divination.",
    [2993] = "Speak with Gryphon Master Talonaxe.",
    [2994] = "Fight to the top of Jintha'Alor, kill Vile Priestess Hexx for the key to Sharpbeak's cage, and save Sharpbeak.",
    [2995] = "Oran Snakewrithe in Undercity wants you to travel to the Hinterlands and burn the Highvale Records, Highvale Report, and Highvale Notes.",
    [2996] = "Speak to Strahad Farsan in Ratchet.",
    [2997] = "Speak to Tiza Battleforge in Ironforge.",
