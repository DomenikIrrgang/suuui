    [8945] = "Go into Stratholme and rescue Ysida Harmon from Baron Rivendare.",
    [8947] = "Bring 3 Dark Iron Bars, 20 Enchanted Leather, 3 Mooncloth and 4 Cured Rugged Hides to Anthion Harmon in the Eastern Plaguelands.",
    [8948] = "Take the incomplete Banner of Provocation to Falrin Treeshaper at the library in Dire Maul.",
    [8951] = "Return to Deliana in Ironforge with a set of Wildheart Boots, a Wildheart Kilt and Wildheart Spaulders.",
    [8952] = "Return to Deliana in Ironforge with a set of Beaststalker's Boots, Beaststalker's Pants and Beaststalker's Mantle.",
