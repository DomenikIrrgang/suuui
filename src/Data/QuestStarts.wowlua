    [1844] = "Bring a Galvanized Horn to Orm Stonehoof in Thunder Bluff.",
    [1846] = "Bring 8 Sturdy Dragonmaw Shinbones to Velora Nitely in the Undercity.",
    [1858] = "Steal Tazan's key, then use it to open his Satchel and deliver its contents to Therzok in the Cleft of Shadow in Orgrimmar.",
    [1859] = "Speak with Therzok in the Cleft of Shadow in Orgrimmar.",
    [1860] = "Speak with Jennea Cannon in Stormwind.",
    [1861] = "Bring a Mirror Lake sample to Jennea Cannon in Stormwind.",
