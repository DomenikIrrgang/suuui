    [92465] = "Slay 6 Roiling Winds and 7 Al'Aketh Converts in Thendal Grove.",
    [92466] = "Bring a Signet of Akir to Windshaper Boro.",
    [92467] = "Find the Rise of Spirits and drink the Earth Sapta.",
    [92468] = "Bring the Rough Quartz to Windshaper Boros in Thendal Grove.",
    [92469] = "Bring word of the Al'Aketh to Rorian the Dayseeker in Thendal Grove.",
    [92470] = "Slay 8 Ursera Scavengers and collect the head of the den mother, Urs'anah in Thendal Grove.",
