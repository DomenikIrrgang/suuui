    [9265] = "Collect three Dim Necrotic Stones from the Scourge outside the Undercity and investigate the glowing runic circles near their encampment.",
    [9269] = "Anachronos at the Caverns of Time in Tanaris wants you to take Atiesh, Greatstaff of the Guardian to Stratholme and use it on Consecrated Earth. Defeat the entity that is exorcised from the staff and return to him.",
    [9270] = "Anachronos at the Caverns of Time in Tanaris wants you to take Atiesh, Greatstaff of the Guardian to Stratholme and use it on Consecrated Earth. Defeat the entity that is exorcised from the staff and return to him.",
    [9271] = "Anachronos at the Caverns of Time in Tanaris wants you to take Atiesh, Greatstaff of the Guardian to Stratholme and use it on Consecrated Earth. Defeat the entity that is exorcised from the staff and return to him.",
    [9319] = "Find and touch the bonfires located within Blackrock Spire, Dire Maul, Scholomance, and Stratholme, then return to the Festival Flamekeeper.",
    [9322] = "Visit the Midsummer camps located in Azshara, Silithus, Un'Goro Crater, and Winterspring, then return to the Festival Flamekeeper.",
    [9323] = "Visit the Fire Festival camps located in Blasted Lands, Eastern Plaguelands, the Hinterlands and Searing Gorge, then speak with the Festival Flamekeeper.",
    [9324] = "Return the Flame of Orgrimmar to the Festival Loremaster.",
    [9325] = "Return the Flame of Thunder Bluff to the Festival Loremaster.",
    [9326] = "Return the Flame of the Undercity to the Festival Loremaster.",
    [9330] = "Return the Flame of Stormwind to the Festival Talespinner.",
    [9331] = "Return the Flame of Ironforge to the Festival Talespinner.",
    [9332] = "Return the Flame of Darnassus to the Festival Talespinner.",
    [9362] = "Retrieve the Prismatic Shell for Archmage Xylem. The Archmage resides in a tower atop the cliffs of Azshara.",
    [9364] = "Polymorph the Spitelash of Azshara and kill the clones that appear several seconds later. When you have slain 50 Polymorph Clones, return to Archmage Xylem in Azshara.",
    [9367] = "Touch the bonfires within Stormwind, Ironforge, and Darnassus, then speak to a Festival Loremaster within the capital cities.",
    [9368] = "Touch the bonfires within Orgrimmar, Thunder Bluff, and the Undercity, then speak to a Festival Talespinner within the capital cities.",
    [9386] = "Find and touch the bonfires located within Blackrock Spire, Dire Maul, Scholomance, and Stratholme, then speak with the Festival Flamekeeper.",
    [9388] = "Visit the bonfires within Ashenvale, the Barrens, Darkshore, and Stonetalon Mountains, then speak with the Festival Flamekeeper.",
    [9389] = "Visit the bonfires within Hillsbrad Foothills, Silverpine Forest, Westfall, and the Wetlands, then speak with the Festival Flamekeeper.",
    [9415] = "Speak with Marshal Bluewall at the Alliance encampment near Hive'Zora.",
    [9416] = "Speak with General Kirika at the Horde encampment near Hive'Regal.",
    [9419] = "Find and deliver Silithyst to the Silithyst Extractor, then speak with Marshal Bluewall at the Alliance encampment near Hive'Zora.",
    [9422] = "Find and deliver Silithyst to the Silithyst Extractor then speak with General Kirika at the Horde encampment near Hive'Regal.",
    [9664] = "Capture Crown Guard Tower, Eastwall Tower, Northpass Tower and Plaguewood Tower in the Eastern Plaguelands, then return to Emmisary Whitebeard at Light's Hope Chapel.",
    [9665] = "Capture Crown Guard Tower, Eastwall Tower, Northpass Tower and Plaguewood Tower in the Eastern Plaguelands, then return to Emmisary Gormok at Light's Hope Chapel.",
    [65593] = "Bring the hearts of Avelina Lilly and Isaac Pearson to Carendin Halgar in the Temple of the Damned.",
    [65597] = "Using the Lovers' Hearts, summon and subdue an incubus, then return the Lovers' Hearts to Carendin Halgar in the Magic Quarter of the Undercity.",
    [65601] = "Speak with Magar in Orgrimmar.",
    [65602] = "Retrieve the Wooden Figurine and bring it to Gakin the Darkbinder in the Mage Quarter of Stormwind.",
    [65603] = "Using the Wooden Figurine, summon and subdue an incubus, then return the Wooden Figurine to Gakin the Darkbinder in the Slaughtered Lamb.",
    [65604] = "Using the Withered Scarf, summon and subdue an incubus, then return the Withered Scarf to Gan'rul Bloodeye in Orgrimmar.",
    [65610] = "Investigate Fallen Sky Lake in Ashenvale and report your findings to Gan'rul Bloodeye in Orgrimmar.",
    [76156] = "Sneak into the Venture Company mine southeast of Thunder Bluff and collect 5 Seaforium Mining Charges from carts of blasting supplies, then return them to Boarton Shadetotem in Thunder Bluff.",
    [76160] = "Gather 8 Windfury Cones north of Thunder Bluff, use them with the Mortar and Pestle, then return to Boarton Shadetotem in Thunder Bluff with the result.",
    [76240] = "Buy or catch a Raw Brilliant Smallfish, then use the Knife Set to fillet it in front of Boarton Shadetotem in Thunder Bluff.",
    [78089] = "Bring the Althalaxx Orb to Katherine the Pure in Stormwind.",
    [78090] = "Find the warlock sanctum within Stormwind and seek advice on the orb.",
    [78091] = "Collect 14 Summoner's Salt from Blackrock Summoners in Redridge Mountains, then return to Ursula Deline in Stormwind.",
    [78092] = "Gather 12 Motes of Mannoroth from demons in Ashenvale. Bring them along with the Orb of Althalaxx to the Spear of Mannoroth at Demon Fall Canyon.",
    [78093] = "Return the Orb Shards to Delgren.",
    [78676] = "Find The Eye of Bhossca inside of the Scarlet Monastery. Then, return it to C's dead drop near Pyrewood Village. You must complete the job alone.",
    [79007] = "Charred remains of the note serve as your only guide.",
    [79008] = "Charred remains of the note serve as your only guide.",
    [79192] = "You tear the note from the plank and read the scrawled writing.",
    [79360] = "Defeat Charlga Razorflank in Razorfen Kraul and collect information on the quilboar's plans.",
    [79361] = "Collect 5 Twisted Fire Totems, 5 Twisted Earth Totems, 5 Twisted Air Totems, and 5 Twisted Water Totems for Prate Cloudseer in Thousand Needles.",
    [79362] = "Find Grant's Mace on one of the skeletons in Raven Hill Cemetery then return to Sirra Von'Indie in Darkshire for more information.",
    [79363] = "Defeat 7 Defias Night Blades and 7 Defias Enchanters in Addle's Stead then return to Sirra Von'Indi in Darkshire for more information.",
    [79364] = "Speak with Prate Cloudseer in Thousand Needles.",
    [79366] = "Use the Twisted Totems to put an end to the quilboar ritual.",
    [79442] = "Deliver the Eye of the Tempest to Bath'rah the Windwatcher in Alterac Mountains.",
    [79974] = "Dusting off a messenger bag emerging from the soil, you find a parchment nestled among the supplies.",
    [79975] = "Water spray dampens the air, the view is incredible.",
    [79976] = "Whoever was here, you just missed them.",
    [79980] = "Find what awaits you.",
    [82208] = "You will need to hand in 25 books to complete this quest, however you can hand 1 in at any time.",
    [86574] = "Collect 6 Stonetalon Supplies from Pridewing Wyverns and deliver them to Innkeeper Faralia.",
    [86576] = "Bring 15 Glittering Sunstones to Mor'rogal.",
    [86585] = "Raise the standard of Ironforge, call out the trogg Headsplitter and kill it, then report to Captain Rugelfuss.",
    [86667] = "Deliver a Jar of Snow to Norric Lochthane.",
    [86757] = "Bring 6 Jagged Orc Swords and 4 Curved Orc Daggers to Shandrina.",
    [86758] = "Find and defeat the crocolisk Daggerfang and bring back Marek's knife.",
    [86776] = "Bring 10 Bronze Bars to Morhan Coppertongue.",
    [86784] = "Collect 6 Dry Branches and bring them to Eleanor Shackleton.",
    [87288] = "Bring 6 Soft Nightsaber Pelts to Aldria.",
    [87318] = "Search for Corma's partner Essene.",
    [87491] = "Escort the captive fire elemental out of Dun Modr and to its freedom.",
    [87760] = "Find a Stormscale Beastmistress, slay her, and bring back her Rod of Deep Dominion.",
    [88756] = "Retrieve 3 Stolen Explosives from the Dark Iron Dwarf camps.",
    [88757] = "Bring back Essene's Necklace, Essene's Spellbook, and Essene's Waterskin.",
    [88758] = "Bring Essene's note back to Corma Villard.",
    [90902] = "Heal 5 Injured Deathguard with your Holy Light ability.",
    [91208] = "Find the Frightened Paladin in Deathknell.",
    [91209] = "Follow the road east out of Deathknell to find the town of Brill. Report to Shari Stilwell to continue your training.",
    [91282] = "Find the fortress of Bandarion Keep and report to Breton Samuels there.",
    [91285] = "Slay 8 Vile Fin Attackers and 8 Vile Fin Seers and report back to Breton Samuels when it is done.",
    [91294] = "Speak to the residents of Bandarion Keep.",
    [91316] = "Collect 12 pieces of Sturdy Lumber from Shadowvale in Tirisfal Glades.",
    [91317] = "Slay 8 Tarnished Drudges, 6 Tarnished Zealots, and collect the head of Commander Rudolph Gelhardt in Tirisfal Glades.",
    [91723] = "Kill 8 Kobold Geomancers in Jasperlode Mine, then return to Hamish Bergwort in the Tower of Azora.",
    [91724] = "Kill 6 Defias Rogue Wizards at Stone Cairn Lake, then return to Hamish Bergwort in the Tower of Azora.",
    [91725] = "Collect 5 Stolen Enchanting Supplies from gnoll camps around Stone Cairn Lake, then return to Blixie Fitzwink near the Tower of Azora.",
    [91732] = "Collect 4 Mining Tools from Jasperlode Mine, then return to Hagar Lowe in Eastvale Logging Camp.",
    [91733] = "Collect the Waterlogged Axe, Waterlogged Saw, and Waterlogged Toolbox that have washed downstream from Eastvale Logging Camp, then return to Ormin Pelford.",
    [91740] = "Deliver Croaky's Head to Merell Ross at Ridgepoint Tower.",
    [91741] = "Return the book to Brother Paxton.",
    [91743] = "Retrieve 8 Stolen Books from kobolds in Northshire Valley and return them to Brother Paxton.",
    [91745] = "Talk to Kelsey Fargo outside the Echo Ridge Mine in Northshire Valley.",
    [91746] = "Deliver Elmpaw's Head to Helene Peltskinner near Goldshire.",
    [91751] = "Skin wolves around Elwynn Forest to obtain 7 Rough Wolf Pelts, then deliver them to Helene Peltskinner near Goldshire.",
    [91752] = "Retrieve a Sack of \"Picture\" Books from Shinyfinder Narf. Bring the sack to Marshal McBride just inside Northshire's Abbey.",
    [91753] = "Kitta Firewind in the Tower of Azora wants you to collect 3 Luminous Residue. Luminous Residue can be obtained by disenchanting Crude Wax Effigies dropped by Kobold Geomancers.",
    [91758] = "Speak to Tordrin Sternblade near the stable behind Northshire's Abbey.",
    [91772] = "Follow the kobold tracks and report to Marshal Dughan in Goldshire with your findings and the Kobold Tracking Kit.",
    [91775] = "Find 6 Lost Books and \"Fun with Elementals\" and return them to Marshal Dughan.",
    [91777] = "Recover \"Geomancy for Curious Young Wizards\" and \"Arcane Explainer: Magical Stuff in Simple Words\" and return them to Brother Paxton inside Northshire's Abbey.",
    [91858] = "Travel to The Sepulcher in Silverpine Forest and speak with Trevan Rol about the missing Earthen Ring travelers.",
    [91859] = "Speak with Deathguard Baldren about the mysterious Earthen Ring travelers who recently passed through The Sepulcher.",
    [91860] = "Investigate Fenris Isle to the east and learn the fate of the Earthen Ring traveling party.",
    [91862] = "Retrieve the Fenris Isle Key from the Rot Hide Gnolls and use it to free Lumina Windsinger.",
    [91920] = "Gather 3 murloc eyes and bring them to Apothecary Renferrel at the Sepulcher.",
