}, objectives = {
    [2] = "Bring Sharptalon's Claw to Senani Thunderheart at Splintertree Post, Ashenvale.",
    [5] = "Speak with Chef Grual.",
    [6] = "Kill Garrick Padfoot and bring his head to Deputy Willem at Northshire Abbey.",
    [7] = "Kill 10 Kobold Vermin, then return to Marshal McBride.",
    [8] = "Deliver the Nondescript Letter to Innkeeper Renee in Tirisfal Glades.",
    [9] = "Farmer Saldean wants you to kill 20 Harvest Watchers.",
    [10] = "Discover the fate of Junior Surveyor Scrimshank, and bring either him or his surveying equipment to Senior Surveyor Fizzledowser in Gadgetzan.",
    [11] = "Bring 8 Painted Gnoll Armbands to Deputy Rainer at the Barracks.",
    [12] = "Gryan Stoutmantle wants you to kill 15 Defias Trappers and 15 Defias Smugglers then return to him on Sentinel Hill.",
    [13] = "Gryan Stoutmantle wants you to kill 15 Defias Pillagers and 15 Defias Looters and return to him on Sentinel Hill.",
    [14] = "Gryan Stoutmantle wants you to kill 15 Defias Highwaymen, 5 Defias Pathstalkers and 5 Defias Knuckledusters then return to him on Sentinel Hill.",
    [15] = "Kill 10 Kobold Workers, then report back to Marshal McBride.",
    [17] = "Bring 12 Magenta Fungus Caps to Ghak Healtouch in Thelsamar.",
    [18] = "Bring 12 Red Burlap Bandanas to Deputy Willem outside the Northshire Abbey.",
    [19] = "Bring Tharil'zun's Head to Marshal Marris in Redridge.",
    [20] = "Bring 10 Battleworn Axes to Marshal Marris in Lakeshire.",
    [21] = "Kill 12 Kobold Laborers, then return to Marshal McBride at Northshire Abbey.",
    [22] = "Salma Saldean needs 8 Goretusk livers to make a Goretusk Liver Pie.",
    [23] = "Bring Ursangous's Paw to Senani Thunderheart at Splintertree Post, Ashenvale.",
    [24] = "Bring Shadumbra's Head to Senani Thunderheart at Splintertree Post, Ashenvale.",
    [25] = "Dispatch 12 Befouled Water Elementals at Mystral Lake, due east of the Talondeep Path and southwest of Splintertree Post. Scout the gazebo on Mystral Lake that overlooks the nearby Alliance outpost. Return to Mastok Wrilehiss at Splintertree Post, Ashenvale.",
    [26] = "Speak with Dendrite Starblaze in the village of Nighthaven, Moonglade.",
    [27] = "Speak with Dendrite Starblaze in the village of Nighthaven, Moonglade.",
    [28] = "Find a Shrine Bauble in Lake Elune'ara, and take it to the Shrine of Remulos in northwestern Moonglade. Once there, use the Shrine Bauble. You must speak with Tajarri at the shrine afterwards in order to complete the trial.",
    [29] = "Find a Shrine Bauble in Lake Elune'ara, and take it to the Shrine of Remulos in northwestern Moonglade. Once there, use the Shrine Bauble. You must speak with Tajarri at the shrine afterwards in order to complete the trial.",
    [30] = "Find the Half Pendant of Aquatic Agility and the Half Pendant of Aquatic Endurance. Speak with the residents of Moonglade to learn clues as to where these items may be located. Form the Pendant of the Sea Lion from the two pendant halves. You need to be in proximity of the Shrine of Remulos to do this. Bring the joined pendant to Dendrite Starblaze in the village of Nighthaven, Moonglade.",
    [31] = "Return to Thunder Bluff and show Turak Runetotem the Pendant of the Sea Lion.",
    [32] = "Take the report to Zilzibin Drumlore in Orgrimmar.",
    [33] = "Bring 8 pieces of Tough Wolf Meat to Eagan Peltskinner outside Northshire Abbey.",
    [34] = "Martie Jainrose of Lakeshire wants you to kill Bellygrub. Bring her his tusk as proof.",
    [35] = "Marshal Dughan wants you to speak with Guard Thomas.",
    [36] = "Verna Furlbrow wants you to deliver her recipe for Westfall Stew to Salma Saldean.",
    [37] = "Guard Thomas wants you to travel north up the river and search for the two lost guards, Rolf and Malakai.",
    [38] = "Salma Saldean wants 3 Stringy Vulture Meat, 3 Goretusk Snouts, 3 Murloc Eyes, 3 Okra.",
    [39] = "Report to Marshal Dughan in Goldshire.",
    [40] = "Remy \"Two Times\" wants you to speak with Marshal Dughan in Goldshire.",
    [45] = "Search the murloc village for Rolf, or signs of his death.",
    [46] = "Bring 8 Torn Murloc Fins to Guard Thomas at the east Elwynn bridge.",
    [47] = "Bring 10 Gold Dust to Remy \"Two Times\" in Goldshire. Gold Dust is gathered from Kobolds in Elwynn Forest.",
    [48] = "Bring Holy Spring Water to Grimbooze Thunderbrew.",
    [49] = "Grimbooze Thunderbrew wants a Sack of Barley, a Sack of Rye and a Sack of Corn.",
    [50] = "Grimbooze Thunderbrew wants Truesilver.",
    [51] = "Bring a Sycamore Branch to Grimbooze Thunderbrew.",
    [52] = "Kill 8 Prowlers and 5 Young Forest Bears, and then return to Guard Thomas at the east Elwynn bridge.",
    [53] = "Bring Grimbooze Thunderbrew a bundle of Charred Oak.",
    [54] = "Take Marshal McBride's Documents to Marshal Dughan in Goldshire.",
    [55] = "Use Morbent's Bane on Morbent Fel, kill Morbent Fel, then return Morbent's Bane to Sven at his camp.",
    [56] = "Commander Althea Ebonlocke of Darkshire wants you to kill 8 Skeletal Warriors and 6 Skeletal Mages.",
    [57] = "Commander Althea Ebonlocke of Darkshire wants you to kill 15 Skeletal Fiends and 15 Skeletal Horrors.",
    [58] = "Commander Althea Ebonlocke of Darkshire wants you to kill 20 Plague Spreaders in the eastern Raven Hill mausoleum.",
    [59] = "Give Sara Timberlain the Stormwind Armor Marker.",
    [60] = "Bring 8 Large Candles to William Pestle in Goldshire.",
    [61] = "Bring William's Shipment to Morgan Pestle in the Stormwind Trade District.",
    [62] = "Explore the Fargodeep Mine, then return to Marshal Dughan in Goldshire.",
    [63] = "Defeat the Corrupt Manifestation of Water and place the Corrupted Manifestation's Bracers along with the Remaining Drops of Purest Water on the Brazier of Everfount in Silverpine Forest.",
    [64] = "Farmer Furlbrow wants you to retrieve his pocket watch from the wardrobe in his farmhouse at the pumpkin farm to the West.",
    [65] = "Gryan Stoutmantle wants you to talk to Wiley in Lakeshire.",
    [66] = "Seek out the Clerk Daltry in the Darkshire Town Hall.",
    [67] = "Travel to the Moonbrook Schoolhouse and bring back any updated information about Stalvan to Clerk Daltry.",
    [68] = "Take the Dusty Unsent Letter to Clerk Daltry.",
    [69] = "Go to The Lion's Pride Inn to see if anyone there has heard of the name Stalvan.",
    [70] = "Retrieve Stalvan's Undelivered Letter from the chest and deliver it to the Canal District in Stormwind.",
    [71] = "Deliver Rolf and Malakai's Medallions to Guard Thomas at the eastern Elwynn bridge.",
    [72] = "Search through the packed up possessions for a clue.",
    [74] = "The Torn Journal page you discovered provides your next clue.",
    [75] = "Marshal Haggard wants you to check the chest upstairs for the Faded Journal Page.",
    [76] = "Explore the Jasperlode Mine, then report back to Marshal Dughan in Goldshire.",
    [77] = "Recover 10 bottles of Hinterlands Honey Ripple from the crates located around the abandoned Horde base in Skulk Rock.",
    [78] = "Take the Faded Journal Page to Tavernkeep Smitts.",
    [79] = "Take the muddy page to Commander Ebonlocke.",
    [80] = "Show Clerk Daltry the Bloodstained Journal Page.",
    [81] = "Deliver the barrel to Dran Droffers in Orgrimmar.",
    [82] = "Bring five Centipaar insect parts from the Noxious Lair to Alchemist Pestlezugg in Gadgetzan.",
    [83] = "Bring 6 Red Linen Bandanas to Sara Timberlain at the Eastvale Logging Camp.",
    [84] = "Bring the Pork Belly Pie to Billy Maclure at the Maclure Vineyards.",
    [85] = "Speak with Billy Maclure.",
    [86] = "Bring 4 Chunks of Boar Meat to Auntie Bernice Stonefield at the Stonefield's Farm.",
    [87] = "Bring Bernice's Necklace to \"Auntie\" Bernice Stonefield at the Stonefield Farm.",
    [88] = "Kill Princess, grab her collar, then bring it back to Ma Stonefield at the Stonefield Farm.",
    [89] = "Bring 5 Iron Pikes and 5 Iron Rivets to Foreman Oslow in Lakeshire.",
    [90] = "Gather 10 Lean Wolf Flanks and Stormwind Seasoning Herbs and return to Chef Grual in Darkshire.",
    [91] = "Bring 10 Shadowhide Pendants to Bailiff Conacher in the Lakeshire Town Hall.",
    [92] = "Chef Breanna of Lakeshire wants five pieces of Tough Condor Meat, five Great Goretusk Snouts and five helpings of Crisp Spider Meat.",
    [93] = "Gather 6 Gooey Spider Legs and bring them to Chef Grual in Darkshire.",
    [94] = "Take the Glyph of Azora to the Lion Statue near the Tower of Ilgalar in Redridge.",
    [95] = "Go to Sven's Farm and find what was buried behind the old stump.",
    [96] = "Bring the Shard of Water to Islen Waterseer in the Barrens.",
    [97] = "Report the news to Commander Ebonlocke.",
    [98] = "Kill Stalvan Mistmantle and show Madame Eva his family ring.",
    [99] = "Bring 6 Pyrewood Shackles to Dalar Dawnweaver at the Sepulcher.",
    [100] = "Speak to the Minor Manifestation of Water in Silverpine Forest.",
    [101] = "Bring 10 Ghoul Fangs, 10 Skeleton Fingers and 5 Vials of Spider Venom to Madame Eva in Darkshire.",
    [102] = "Bring 8 Gnoll Paws to Captain Danuvin on Sentinel Hill.",
    [103] = "Bring 5 Flasks of Oil to Captain Grayson at the Westfall Lighthouse.",
    [104] = "Bring a scale of Old Murk-Eye to Captain Grayson at the Westfall Lighthouse.",
    [105] = "Bring Araj's Phylactery Shard to High Executor Derrington at the Bulwark, Western Plaguelands.",
    [106] = "Give Maybell's Love Letter to Tommy Joe Stonefield.",
    [107] = "Take Gramma Stonefield's Note to William Pestle.",
    [109] = "Talk to Gryan Stoutmantle. He usually can be found in the stone tower on Sentinel Hill, just off the road, in the middle of Westfall.",
    [110] = "Check in Gadgetzan for Alchemist Pestlezugg and his analysis of the insect parts.",
    [111] = "Speak with Gramma Stonefield.",
    [112] = "Bring 4 Crystal Kelp Fronds to William Pestle in Goldshire.",
    [113] = "Deliver the report to Senior Surveyor Fizzledowser in Gadgetzan. Be sure he gives you a copy of the report, as Alchemist Pestlezugg has requested.",
    [114] = "Take the Invisibility Liquor to Maybell Maclure.",
    [115] = "Bring 3 Midnight Orbs to Marshal Marris in Lakeshire.",
    [116] = "Barkeep Daniels of Lakeshire needs a keg of Thunderbrew Lager, a cask of Merlot, a bottle of Moonshine and a skin of Sweet Rum.",
    [117] = "Bring Grimbooze Thunderbrew 5 hops to complete his special brew.",
    [118] = "Take Verner's Note to Smith Argus in Goldshire.",
    [119] = "Return to Verner Osgood in Redridge. Give him the Crate of Horseshoes.",
    [120] = "Magistrate Solomon has given you a report which must be delivered to General Marcus Jonathan in Stormwind. The judge wants you to return to him as soon as the delivery has been made.",
    [121] = "Take General Marcus Jonathan's letter of response to Magistrate Solomon in Lakeshire.",
    [122] = "Gather 6 Underbelly Whelp Scales from Black Dragon Whelps, and bring them to Verner Osgood in Redridge.",
    [123] = "Go to Marshal Dughan in Goldshire and give him The Collector's Schedule.",
    [124] = "Kill 10 Redridge Brutes and 8 Redridge Mystics, then return to Verner Osgood.",
    [125] = "Foreman Oslow of Lakeshire wants you to retrieve his toolbox from the bottom of Lake Everstill.",
    [126] = "Bring Yowler's Paw to Verner Osgood in Lakeshire.",
    [127] = "Bring 10 Spotted Sunfish to Dockmaster Baren in Lakeshire.",
    [128] = "Kill 15 Blackrock Champions and Guard Howe in Lakeshire will reward you.",
    [129] = "Bring Parker's lunch to Guard Parker. He patrols the road leading to Darkshire.",
    [130] = "Speak with the Redridge Herbalist, Martie Jainrose.",
    [131] = "Give Darcy the Daffodil Bouquet.",
    [132] = "Take Wiley's Note to Gryan Stoutmantle in Westfall.",
    [133] = "Gather 7 Ghoul Ribs and bring them to Abercrombie at his shack.",
    [134] = "Return Abercrombie's Crate to Abercrombie.",
    [135] = "Take Wiley's Note to Mathias Shaw in Stormwind.",
    [136] = "Find Captain Sanders' footlocker and search it for the next clue.",
    [138] = "Find the old barrel near the ruined chimney and search it for your next clue.",
    [139] = "Search the empty jug next to the windmill for the next clue.",
    [140] = "Locate Captain Sanders' chest and open it for your reward.",
    [141] = "Take Shaw's report to Gryan Stoutmantle in Westfall.",
    [142] = "Track down the Defias Messenger in Westfall and bring his message to Stoutmantle.",
    [143] = "Magistrate Solomon wants you to take his written plea to Gryan Stoutmantle in Westfall.",
    [144] = "Return to Magistrate Solomon with Gryan Stoutmantle's response.",
    [145] = "Magistrate Solomon wants you to take a letter to Lord Ebonlocke in Darkshire.",
    [146] = "Return to Magistrate Solomon with Lord Ebonlocke's letter of response.",
    [147] = "Find and kill \"the Collector\" then return to Marshal Dughan with The Collector's Ring.",
    [148] = "Speak with Madame Eva.",
    [149] = "Bring the Spectral Comb to Blind Mary.",
    [150] = "Bring 8 Murloc Fins to Dockmaster Baren in Lakeshire.",
    [151] = "Verna Furlbrow in Westfall wants you to bring her 8 Handfuls of Oats.",
    [152] = "Kill 7 Tidehunters, 7 Warriors, 7 Oracles and 7 Coastrunners and return to Captain Grayson at the Westfall Lighthouse.",
    [153] = "Bring 15 Red Leather Bandanas to Scout Galiaan at Sentinel Hill.",
    [154] = "Return the Ghost Hair Comb to Madame Eva in Darkshire.",
    [155] = "Escort the Defias Traitor to the secret hideout of the Defias Brotherhood. Once the Defias Traitor shows you where VanCleef and his men are hiding out, return to Gryan Stoutmantle with the information.",
    [156] = "Gather 8 Rot Blossoms and bring them to Tavernkeep Smitts in Darkshire.",
    [157] = "Bring the Ghost Hair Thread to Abercrombie, in his shack north of the Raven Hill Cemetery.",
    [158] = "Speak with Tavernkeep Smitts.",
    [159] = "Bring the Zombie Juice to Abercrombie at his shack.",
    [160] = "Bring Abercrombie's Letter to Ello Ebonlocke, Mayor of Darkshire.",
    [161] = "Chief Engineer Hinderweir wants you to take the strange smelling powder to Ashlan Stonesmirk, the explosives expert in Dun Modr.",
    [162] = "Take the Insect Analysis Report to Gracina Spiritmight in Darnassus.",
    [163] = "Find out what is haunting Raven Hill.",
    [164] = "Deliver the supplies to Sven.",
    [165] = "Check on the old man in the shack near Raven Hill cemetery.",
    [166] = "Kill Edwin VanCleef and bring his head to Gryan Stoutmantle.",
    [167] = "Bring Foreman Thistlenettle's Explorers' League Badge to Wilder Thistlenettle in Stormwind.",
    [168] = "Retrieve 4 Miners' Union Cards and return them to Wilder Thistlenettle in Stormwind.",
    [169] = "Kill Gath'Ilzogg and bring his head to Magistrate Solomon in Lakeshire for the reward.",
    [170] = "Balir Frosthammer wants you to kill 6 Rockjaw Troggs and 6 Burly Rockjaw Troggs.",
    [171] = "Return your ward to the Stormwind orphanage by handing in the Human Orphan Whistle to Orphan Matron Nightingale in the Cathedral District.",
    [172] = "Use the Orcish Orphan Whistle to talk with the child you will be looking after during Children's Week.",
    [173] = "Kill 6 Nightbane Shadow Weaver worgen for Calor in Darkshire.",
    [174] = "Viktori Prism'Antras of Darkshire wants you to bring him a bronze tube.",
    [175] = "Locate Mary and persuade her to give up a reflective surface for Viktori's project.",
    [176] = "Slay the gnoll Hogger and bring his Huge Gnoll Claw to Marshal Dughan.",
    [177] = "Retrieve Blind Mary's Looking Glass from the Insane Ghoul and give it to Viktori in Darkshire.",
    [178] = "Bring the Faded Shadowhide Pendant to Theocritus the Mage.",
    [179] = "Sten Stoutarm would like 8 pieces of Tough Wolf Meat.",
    [180] = "Kill Lieutenant Fangore and return to Magistrate Solomon in Lakeshire with his paw.",
    [181] = "Locate Zzarc'Vul in the southern ogre mound in Duskwood and return his monocle to Viktori in Darkshire.",
    [182] = "Grelin Whitebeard would like you to kill 14 Frostmane Troll Whelps.",
    [183] = "Talin Keeneye would like you to kill 12 Small Crag Boars.",
    [184] = "Bring Furlbrow's Deed to Farmer Furlbrow.",
    [185] = "Ajeck Rouack of Nesingwary's Expedition wants you to kill 10 Young Stranglethorn Tigers.",
    [186] = "Ajeck Rouack of Nesingwary's Expedition wants you to kill 10 Stranglethorn Tigers.",
    [187] = "Ajeck Rouack of Nesingwary's Expedition wants you to kill 10 Elder Stranglethorn Tigers.",
    [188] = "Ajeck Rouack of Nesingwary's Expedition wants you to kill Sin'Dall and return with her paw.",
    [189] = "Acquire 15 Bloodscalp Ears and return them to Kebok in Booty Bay.",
    [190] = "Sir S. J. Erlgadin of Nesingwary's Expedition wants you to kill 10 Young Panthers.",
    [191] = "Sir S. J. Erlgadin of Nesingwary's Expedition wants you to kill 10 Panthers.",
    [192] = "Sir S. J. Erlgadin of Nesingwary's Expedition wants you to kill 10 Shadowmaw Panthers.",
    [193] = "Sir S. J. Erlgadin of Nesingwary's Expedition wants you to bring him the Fang of Bhag'thera.",
    [194] = "Hemet Nesingwary wants you to kill 10 Stranglethorn Raptors.",
    [195] = "Hemet Nesingwary wants you to kill 10 Lashtail Raptors.",
    [196] = "Hemet Nesingwary wants you to kill 10 Jungle Stalkers.",
    [197] = "Hemet Nesingwary wants you to kill Tethis, an elusive, dangerous raptor in Stranglethorn.",
    [198] = "Deliver the Miscellaneous Goblin Supplies to Private Thorsen.",
    [199] = "Return to Chief Engineer Hinderweir and show him the clue that you discovered.",
    [200] = "Find Bookie Herod's Records.",
    [201] = "Find the hunters' camp and report its location to Krazek in Booty Bay.",
    [202] = "Kill 6 Kurzen Elite, 4 Kurzen Subchiefs, and bring Kurzen's Head to Lieutenant Doren at the Rebel Camp.",
    [203] = "Kill 15 Kurzen Jungle Fighters. Return to Sergeant Yohwa at the Rebel Camp.",
    [204] = "Bring 7 Jungle Remedies and 1 Venom Fern Extract to Sergeant Yohwa at the Rebel Camp.",
    [205] = "Bring 4 Skullsplitter Fetishes to Brother Nimetz at the Rebel Camp.",
    [206] = "Bring the Mind's Eye to Brother Nimetz at the Rebel Camp.",
    [207] = "Find the 4 tablets and bring their legends back to Brother Nimetz.",
    [208] = "Hemet Nesingwary wants you to bring him the head of King Bangalash, the great white tiger.",
    [209] = "Acquire 18 Skullsplitter Tusks and return them to Kebok.",
    [210] = "Bring Krazek's Crock Pot to Krazek the goblin.",
    [211] = "Bring Araj's Phylactery Shard to Commander Ashlam Valorfist at Chillwind Camp, Western Plaguelands.",
    [212] = "Kill a Cold Eye Basilisk, get a Chilled Basilisk Haunch, and return it to Angus Stern in the Blue Recluse.",
    [213] = "Retrieve 8 Tumbled Crystals and return them to Kebok in Booty Bay.",
    [214] = "Scout Riell at the Sentinel Hill Tower wants you to bring her 10 Red Silk Bandanas.",
    [215] = "Speak with Lieutenant Doren at the Rebel Camp.",
    [216] = "Take down 8 Thistlefur Avengers and 8 Thistlefur Shaman; most are located east of Zoram Strand in Thistlefur Village. Once completed, return to Karang Amakkar at Zoram'gar Outpost, Ashenvale.",
    [217] = "Kill the Trogg leader, Grawmug, and his two guards, Gnasher and Brawler then report back to Captain Rugelfuss in the southern guard tower.",
    [218] = "Grelin Whitebeard wants you to kill Grik'nir the Cold, and retrieve his journal.",
    [219] = "Protect Corporal Keeshan on the journey back to Redridge.",
    [220] = "Bring the Vial of Purest Water to Islen Waterseer in the Barrens.",
    [221] = "Kill 12 Nightbane Dark Runner worgen for Calor in Darkshire.",
    [222] = "Kill 8 Nightbane Vile Fang and 8 Nightbane Tainted One worgen for Calor in Darkshire.",
    [223] = "Bring Calor's note to Jonathan Carevin.",
    [224] = "Mountaineer Cobbleflint of the southern guard tower wants you to kill 10 Stonesplinter Troggs and 10 Stonesplinter Scouts.",
    [225] = "Speak with Sirra Von'Indi in Darkshire.",
    [226] = "Kill 12 Starving Dire Wolves and 8 Rabid Dire Wolves, then return to Lars at Sven's Camp on the western border of Duskwood.",
    [227] = "Speak with Commander Althea Ebonlocke in Darkshire.",
    [228] = "Kill Mor'Ladim, then return his skull to Commander Althea Ebonlocke in Darkshire.",
    [229] = "Speak with Watcher Sarah Ladimore in Darkshire.",
    [230] = "Bring the Book from Sven's Farm to Sven.",
    [231] = "Take Sarah Ladimore's ring to Morgan Ladimore's grave.",
