    [92472] = "Report to Constable Aonda in Shen'dar Village.",
    [92473] = "Collect 6 Scrawny Ursera Claws from Scrawny Ursera in Thendal Grove.",
    [92474] = "Jump from the top of the watchtower in Thendal Grove and use your Walk on Air ability to slow your fall.",
