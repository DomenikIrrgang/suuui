    [97005] = "Bring Chol'aruk's Head to Bainham in the Barrens.",
    [97222] = "Carry the Gatehouse Shipment up the stairs in Trias' shop and leave it outside the door.",
    [97223] = "Bring Eggs of the Bloodtalon Matriarch to Xar'Ti in Sen'jin Village.",
    [97225] = "Collect 8 Forgotten Loa Idols from the Echo Isles. Bring them to Master Gadrin in Sen'jin Village.",
    [97236] = "Deliver the Fang of Githyiss to someone interested in the study of spiders in Aldrassil.",
    [97237] = "Find each of the reading materials located somewhere in the library and then return to Roy Lewells in Stormwind's Park.",
    [97242] = "Take some cuttings from the Cattails and Speargrass growing around the water flows in the Valley of Honor and return to Kor'geld in Yelmak's Alchemy and Potions",
    [97243] = "Bring the Torch of Dormant Flame to Olariaan Swiftburn at the Shrine of Flames in the Gustberry Lowlands.",
    [97244] = "Slay Skypriest Faladiel in the Gustberry Lowlands and collect Faladiel's Heart.",
    [97245] = "Find the home of Kuramaa in the Shen'dar Highlands, and defeat the spirit in combat. Bring Kuramaa's Mask to Olariaan Swiftburn in the Gustberry Lowlands when you are victorious.",
    [97246] = "Visit Borstan's Firepit and tell him Thatog wants you to deliver Migi's lunch to him personally.",
    [97249] = "Bring Migi's Lunch to him behind Grommash Hold",
    [97250] = "Slay Alliance soldiers encroaching into the Barrens at the border to Dustwallow Marsh, then return to Grunt Logmar at Camp Taurajo.",
    [97253] = "Collect 5 Handfuls of Complicated Parts from the upper pirate camp south of Ratchet, then return to Wrenix the Wretched in Ratchet.",
    [97257] = "Wait for Olariaan to begin the ritual at the Brazier of Offering and follow his instructions. You must deliver the Eternal Flame to Valanaar before the timer runs out.",
    [97263] = "Deliver Eldrun's misplaced package.",
    [97275] = "Give Yelmak's Potion to Whuut.",
    [97277] = "Find Grund and Gozwin's camp in the hills to the northwest. Recover Gozwin's Mechanic's Log and kill the Snow Leopard Prowler.",
    [97279] = "Collect 6 Abandoned Training Weapons, then return to Kzan Thornslash in the Den.",
    [97281] = "Bring the Dull Stormy Orb to Rezlak near Drygulch Ravine.",
    [97282] = "Bring 5 Charged Thunder Lizard Organs to Rezlak near Drygulch Ravine.",
    [97287] = "Speak with Archmage Celindra in the City of Dalaran.",
    [97289] = "Bring the Head of the Baron to the body of Othmar in the Undercity.",
    [97290] = "Report your findings to Master Apothecary Faranell in Undercity.",
    [97291] = "Collect a Toxic Skullcap from Tawny Grisette in the Trade Quarter, Blisterweed near the Herbalism Trainer, and Essence of Agony from the poison vendor in the Rogues' Quarter for Master Apothecary Faranell in Undercity.",
    [97292] = "Inject the Hissing Serum into the system above Othmar's body for Master Apothecary Faranell.",
    [97326] = "Return 8 Smooth Boulders to Thra behind Grommash Hold.",
    [97485] = "Purchase a Bundle of Herbs from Nida the herbalist, a Bundle of Cedar Twigs from Nata the enchanting supplier, and Sinew Thread from Mahu the leatherworking supplier and Ceremonial Flint and Tinder from Naal the cooking supplier. Combine the items and sprinkle the incense off of Hunter's Rise.",
    [97538] = "Tah Winterhoof in Thunder Bluff wants 30 Mirkweed Pods from Mirkfallon Lake.",
    [97539] = "Return 12 Surgical Spidersilk to Doctor Gregory Victor in Hammerfall, Arathi Highlands.",
    [97558] = "Bring Shelene Rhobart 8 Duskbat Wing Membranes, 6 Darkhound Hides and 3 Vile Fin Murloc Skin.",
    [97891] = "Bring the Unstable Potion to Doctor Martin Felben in the Apothecarium within the time limit.",
    [97894] = "Check on Gorbold Steelhand in Auberdine in Darkshore. Borgus mentioned a boat on the southern-most dock in Stormwind Harbor that can take you there.",
    [97899] = "Speak with Whuut in Orgrimmar to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97900] = "Speak with Dwukk in Razor Hill to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97901] = "Speak with Jhag in Orgrimmar to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97902] = "Speak with Mukdrak in Razor Hill to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97903] = "Speak with Rawrk in Razor Hill to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97904] = "Speak with Lau'Tiki near Sen'jin Village to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97905] = "Speak with Jandi in Orgrimmar to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97906] = "Speak with Karolek in Orgrimmar to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97907] = "Speak with Krunn in Razor Hill to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97908] = "Speak with Thuwd in Orgrimmar to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97914] = "Bring Thundris' Letter to Baros Alexston in Stormwind. Thundris mentioned a boat in Auberdine that can take you there.",
    [97915] = "Speak with Alchemist Mallory in Elwynn Forest near Stormwind to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97916] = "Speak with Smith Argus in Goldshire to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97917] = "Speak with Betty Quin in Stormwind to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
