    [97924] = "Speak with Helene Peltskinner in Goldshire to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97925] = "Speak with Eldrin in the Eastvale Logging Camp in Elwynn Forest to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97926] = "Bring Alexston's Reply to Thundris Windweaver in Auberdine in Darkshore.",
    [97938] = "Speak with Cyndra Kindwhisper in Dolanaar to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
