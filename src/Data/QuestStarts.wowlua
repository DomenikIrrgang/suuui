    [1691] = "Take down 10 Wastewander Shadow Mages, 8 Wastewander Rogues, and 6 Wastewander Assassins for Chief Engineer Bilgewhizzle in Gadgetzan.",
    [1692] = "Bring the Case of Elunite to Smith Mathiel.",
    [1698] = "Speak with Yorus Barleybrew.",
    [1699] = "Enter the Rethban Caverns, reach the first fork, and return to Yorus Barleybrew within the time allowed. You must not die and release your spirit.",
    [1700] = "Bring Furen's Notes to Grimand Elmore.",
    [1701] = "Gather the materials Furen Longbeard requires, and bring them to him in Stormwind.",
    [1702] = "Bring the Cask of Scalder to Furen Longbeard.",
    [1703] = "Bring Furen's Notes to Mathiel.",
    [1704] = "Bring Furen's Notes to Klockmort Spannerspan.",
    [1705] = "Bring 20 vials of Burning Blood and 1 Burning Rock to Grimand Elmore in Stormwind.",
    [1707] = "Bring 5 Wastewander Water Pouches to Spigot Operator Luglunket in Gadgetzan.",
    [1708] = "Bring 20 loads of Searing Coral to Klockmort Spannerspan in Ironforge.",
    [1710] = "Bring 20 Sunscorched Shells to Mathiel in Darnassus.",
    [1712] = "Bring the items on Bath'rah's Parchment to Bath'rah the Windwatcher in Alterac.",
    [1713] = "Bring the Whirlwind Heart to Bath'rah Windwatcher.",
    [1715] = "Report to Gakin the Darkbinder in the Mage Quarter of Stormwind.",
    [1716] = "Speak with Takar the Seer in the Barrens.",
    [1717] = "Report to Gakin the Darkbinder in the Mage Quarter of Stormwind.",
    [1718] = "Speak with Klannoc Macleod.",
    [1719] = "Kill Big Will, then speak to Klannoc Macleod on Fray Island.",
    [1738] = "Retrieve the Heartswood from Ashenvale and bring it to Gakin the Darkbinder in the Mage Quarter of Stormwind.",
    [1739] = "Using the Heartswood Core, summon and subdue a succubus, then return the Heartswood Core to Gakin the Darkbinder in the Slaughtered Lamb.",
    [1740] = "Find 3 Soran'ruk Fragments and 1 Large Soran'ruk Fragment and return them to Doan Karhan in the Barrens.",
    [1758] = "Speak with Krom Stoutarm in Ironforge.",
    [1778] = "Speak to Tiza Battleforge in Ironforge.",
    [1779] = "Take the Symbol of Life and speak to Muiredon Battleforge in Ironforge.",
    [1780] = "Speak to Duthorian Rall in Stormwind.",
    [1781] = "Take the Symbol of Life to Gazin Tenorm in Stormwind.",
    [1783] = "Take the Symbol of Life and resurrect Narm Faulk in Dun Morogh.",
    [1784] = "Retrieve a Dark Iron Script from the Dark Iron dwarves near Helm's Bed, and return to Muiredon Battleforge in Ironforge.",
    [1785] = "Speak to Tiza Battleforge in Ironforge.",
    [1786] = "Take the Symbol of Life and resurrect Henze Faulk in Elwynn.",
    [1787] = "Retrieve a Defias Script from the Defias Rogue Wizards in Elwynn, and return to Gazin Tenorm in Stormwind.",
    [1788] = "Speak to Duthorian Rall in Stormwind.",
    [1791] = "Speak with Bath'rah the Windwatcher.",
    [1795] = "Using the Tome of the Cabal, summon and subdue a felhunter, then return the Tome of the Cabal to Strahad Farsan in Ratchet.",
    [1796] = "Bring Robes of the Arcana to Menara Voidrender in the Barrens.",
    [1798] = "Speak with Strahad Farsan in the Barrens.",
    [1799] = "Speak to Menara's acolytes inside the tower above Ratchet and choose one of their paths to follow. Afterwards, bring an Infernal Orb to Tabetha in Dustwallow Marsh.",
    [1800] = "Take your ward to the old Lordaeron Throne Room that lies just before descending into the Undercity.",
    [1801] = "Speak with Jorah Annison in the Undercity.",
    [1802] = "Retrieve the Moldy Tome and Tattered Manuscript for Krom Stoutarm in Ironforge.",
    [1803] = "Retrieve the Moldy Tome and Tattered Manuscript for Jorah Annison in the Undercity.",
