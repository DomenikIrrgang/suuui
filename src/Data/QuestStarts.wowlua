    [3002] = "Bring the Gordunni Orb to Uthel'nay in the Darkbriar Lodge in Orgrimmar.",
    [3022] = "Bring the Carefully-packed Crate to Erelas Ambersky in Rut'theran Village.",
    [3042] = "Bring 20 Vials of Troll Temper to Trenton Lighthammer in Gadgetzan.",
    [3062] = "Talo Thornhoof in Camp Mojache wants Edana Hatetalon's Dark Heart.",
    [3063] = "Talo Thornhoof wants you to kill 4 Northspring Harpies, 4 Northspring Roguefeathers, 4 Northspring Windcallers, and 4 Northspring Slayers.",
    [3065] = "Read the Simple Tablet and speak to Frang in the Valley of Trials.",
    [3082] = "Speak to Jen'shan in the Valley of Trials.",
    [3083] = "Read the Encrypted Tablet and speak to Rwag in the Valley of Trials.",
    [3084] = "Speak to Shikrik in the Valley of Trials.",
    [3085] = "Read the Hallowed Tablet and speak to Ken'jai outside the Den in the Valley of Trials.",
    [3086] = "Read the Glyphic Tablet and speak with Mai'ah near the entrance to the Den in the Valley of Trials.",
