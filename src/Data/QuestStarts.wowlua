    [8920] = "Acquire 15 Silithus Venom Samples and 20 gold and bring them along with a set of Bracers of Valor to Mokvar in Orgrimmar.",
    [8921] = "Return to Mux Manascrambler in Gadgetzan with 1 Delicate Arcanite Converter, 4 Greater Eternal Essence, 10 Stonescale Oil, 25 Volcanic Ash and 40 gold.",
    [8922] = "Bring the Sealed Blood Container to Mux Manascrambler inside Gadgetzan in Tanaris.",
    [8923] = "Take the Sealed Venom Container to Mux Manascrambler in Gadgetzan.",
    [8924] = "Use the Ectoplasmic Distiller near incorporeal undead to collect 12 Scorched Ectoplasms in Silithus, 12 Frozen Ectoplasms in Winterspring and 12 Stable Ectoplasms in the Eastern Plaguelands. Bring them along with the Ectoplasmic Distiller back to Mux Manascrambler in Gadgetzan.",
    [8925] = "Find Magma Lord Bokk in the Burning Steppes, obtain his Magma Core and bring it to Mux Manascrambler in Gadgetzan.",
    [8926] = "Bring a Wildheart Belt and a set of Wildheart Gloves Deliana in Ironforge.",
    [8927] = "Bring a Wildheart Belt and a set of Wildheart Gloves to Mokvar in Orgrimmar.",
    [8928] = "Search for an imp inside a cave at the entrance of Darkwhisper Gorge in southern Winterspring, purchase a Fel Elemental Rod and return to Mux Manascrambler in Gadgetzan.",
    [8929] = "Use the Extra-Dimensional Ghost Revealer at the entrance to Stratholme and speak with the ghost of Anthion Harmon.",
    [8930] = "Use the Extra-Dimensional Ghost Revealer at the entrance to Stratholme and speak with the ghost of Anthion Harmon.",
    [8931] = "Bring a Beaststalker's Belt and a set of Beaststalker's Gloves to Deliana in Ironforge.",
    [8932] = "Bring a Magister's Belt and a set of Magister's Gloves to Deliana in Ironforge.",
