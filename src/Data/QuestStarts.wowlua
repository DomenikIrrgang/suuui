    [234] = "Deliver the letter to Grelin Whitebeard.",
    [235] = "Speak with Senani Thunderheart at Splintertree Post, Ashenvale.",
    [237] = "Mountaineer Gravelgaw in the southern guard tower wants you to kill 10 Stonesplinter Skullthumpers and 10 Stonesplinter Seers and report back to him.",
    [238] = "Bring the Field Sampling Kit to Apothecary Zinge in the Undercity.",
    [239] = "Go to the Westbrook Garrison and speak with Deputy Rainer.",
    [240] = "Return to Jitters with the Dusky Crab Cakes.",
    [243] = "Speak to Chief Engineer Bilgewhizzle in Gadgetzan about getting a power source for the testing kit.",
    [244] = "Report to Deputy Feldon.",
    [245] = "Kill 15 Pygmy Venom Web Spiders, and then report back to Watcher Dodds in Duskwood.",
    [246] = "Kill 10 Redridge Mongrels and 6 Redridge Poachers, then report back to Deputy Feldon in Lakeshire.",
    [248] = "Climb the intact watch tower beside Stonewatch Keep. Find a suitable container to place the Glyph of Azora.",
    [249] = "Defeat Morganth. Bring his Pendant of Shadow to Theocritus at the Tower of Azora in Elwynn Forest.",
    [250] = "Investigate the area near the eastern ramp of the Dam and bring Chief Engineer Hinderweir a clue that might reveal what the Dark Iron Dwarves are up to.",
    [251] = "Bring the Letter to Ello to Sirra Von'Indi.",
    [252] = "Bring the Translated Letter to Lord Ello Ebonlocke",
    [253] = "Find Eliza's grave. Retrieve the Embalmer's Heart from her, then return to Ello Ebonlocke.",
    [255] = "Magistrate Bluntnose of Thelsamar has hired you to kill 4 Mo'grosh Ogres, 4 Mo'grosh Brutes and 4 Mo'grosh Enforcers.",
    [256] = "Kill Chok'sul and bring his head to Magistrate Bluntnose of Thelsamar.",
    [257] = "Kill 6 Mountain Buzzards and return to Daryl the Youngling in the Farstrider Lodge within 15 minutes.",
    [258] = "Kill 5 Elder Mountain Boars and return to Daryl the Youngling in the Farstrider Lodge within 12 minutes.",
    [261] = "Destroy 30 Undead Ravagers, then return to Brother Anton at Nijel's Point.",
    [262] = "Take the book you found at Sven's farm and show it to townsfolk in Darkshire.",
    [263] = "Mountaineer Wallbang in the southern guard tower wants you to kill 10 Stonesplinter Shaman and 10 Stonesplinter Bonesnappers.",
    [264] = "Place Clarice's Pendant on Yuriv's Tomb in Silverpine.",
    [265] = "See if other townsfolk have clues about the shadowy figure.",
    [266] = "Search the inn for clues about the shadowy figure.",
    [267] = "Bring 8 Trogg Stone Teeth to Captain Rugelfuss in the southern guard tower.",
    [268] = "Return to Sven with Jitters' completed journal.",
    [269] = "Give Jitters' Completed Journal to Bishop Farthing in Stormwind.",
    [270] = "Go to Menethil Harbor in the Wetlands, and speak with Glorin Steelbrow.",
    [271] = "Kill Ol' Sooty then show your handiwork to Daryl the Youngling at the Farstrider Lodge.",
    [272] = "Find the Half Pendant of Aquatic Agility and the Half Pendant of Aquatic Endurance. Speak with the residents of Moonglade to learn clues as to where these items may be located. Form the Pendant of the Sea Lion from the two pendant halves. You need to be in proximity of the Shrine of Remulos to do this. Bring the joined pendant to Dendrite Starblaze in the village of Nighthaven, Moonglade.",
    [273] = "Speak with Huldar.",
    [274] = "Ashlan Stonesmirk wants you to return to Chief Engineer Hinderweir and inform him of the new discovery.",
    [275] = "Kill 12 Fen Creepers, then return to Rethiel the Greenwarden in the Wetlands.",
    [276] = "Kill 15 Mosshide Gnolls and 10 Mosshide Mongrels, then return to Rethiel the Greenwarden in the Wetlands.",
    [277] = "Bring Rethiel the Greenwarden 9 Crude Flints.",
    [278] = "Chief Engineer Hinderweir wants you to gather Lurker Venom, a Mo'grosh Crystal, and a Crocolisk Tear.",
    [279] = "Kill 12 Bluegill Murlocs. Slay Gobbler and take his head. Bring Gobbler's Head to Karl Boran in Menethil Harbor.",
    [280] = "Chief Engineer Hinderweir wants you to swim down to the base of the dam, locate the powder keg and stir in the Disarming Mixture to prevent an explosion.",
    [281] = "Search the crates and barrels at the coastal Murloc camps.",
    [282] = "Speak with Mountaineer Thalos.",
    [283] = "The Disarming Mixture seemed to take effect. Return to Chief Engineer Hinderweir to report the good news.",
    [284] = "Search for the Menethil Statuette.",
    [285] = "Continue searching the Murloc hovels for the Menethil Statuette.",
    [286] = "Bring Karl Boran the Menethil Statuette.",
    [287] = "Explore Frostmane Hold, and kill 5 Frostmane Headhunters for Senir Whitebeard in Kharanos.",
    [288] = "Buy First Mate Fitzsimmons a Flagon of Mead.",
    [289] = "Kill 13 Cursed Sailors, 5 Cursed Marines and First Mate Snellig. Bring Snellig's Snuffbox to First Mate Fitzsimmons in Menethil Harbor.",
    [290] = "Get the Intrepid Strongbox Key from Captain Halyndor. Use the key to open the Intrepid's Locked Strongbox.",
    [291] = "Deliver Senir's report to Senator Barin Redstone in Ironforge.",
    [292] = "Bring the Cursed Eye of Paleth to Glorin Steelbrow.",
    [293] = "Bring Archbishop Benedictus the Cursed Eye of Paleth. Benedictus is in the Cathedral of Light, in the city of Stormwind.",
    [294] = "Ormer Ironbraid at the Whelgar Excavation Site wants you to kill 10 Mottled Screechers and 10 Mottled Raptors.",
    [295] = "Ormer Ironbraid wants you to kill 10 Mottled Scytheclaw raptors and 10 Mottled Razormaw raptors then return to him at the Whelgar Excavation Site.",
    [296] = "Ormer Ironbraid at the Whelgar Excavation Site wants you to kill Sarltooth and return to him with one of his talons once the task is fulfilled.",
    [297] = "Bring Magmar Fellhew 8 Carved Stone Idols.",
    [298] = "Bring Ironband's Progress Report to Jern Hornhelm in Thelsamar.",
    [299] = "Prospector Whelgar wants you to scour the excavation site in search of the 4 missing tablet fragments: Ados, Modr, Golm and Neru.",
    [301] = "Take Ironband's Progress Report to Prospector Stormpike.",
    [302] = "Speak with Jern Hornhelm in Thelsamar.",
    [303] = "Motley Garmason at Dun Modr wants you to kill 10 Dark Iron Dwarves, 5 Dark Iron Tunnelers, 5 Dark Iron Saboteurs and 5 Dark Iron Demolitionists.",
    [304] = "Kill Balgaras the Foul and bring his ear to Longbraid the Grim outside of Dun Modr.",
    [305] = "Tarrel Rockweaver wants you to travel to the Excavation Site and contact Merrin Rockweaver.",
    [306] = "Return to Tarrel Rockweaver with Merrin's note.",
    [307] = "Go to the Silver Stream Mine and collect 4 loads of Miners' Gear. Return to Mountaineer Stormpike.",
    [309] = "Ensure Miran and the shipment arrive at the excavation site, then inform Prospector Ironband.",
    [310] = "In the basement of the Thunderbrew Distillery in Kharanos, replace a barrel of Thunder Ale with a Barrel of Barleybrew Scalder.",
    [311] = "Bring the barrel of Thunder Ale to Marleth Barleybrew at the Brewnall Village.",
    [312] = "Retrieve Tundra MacGrann's dried meats from the stolen meat locker in Old Icebeard's cave.",
    [313] = "Gather 8 Wendigo Manes and bring them to Pilot Stonegear.",
    [314] = "Rudra Amberstill wants you to slay Vagash and bring his fang to her at the Ram ranch.",
    [315] = "Bring 6 Shimmerweeds to Rejold Barleybrew in the Brewnall Village.",
    [317] = "Gather 4 Chunks of Boar Meat and 2 Thick Bear Furs, and deliver them to Pilot Bellowfiz at Steelgrill's Depot.",
    [318] = "Get a cask of Evershine from Rejold Barleybrew in Brewnall Village.",
    [319] = "Kill 6 Ice Claw Bears, 8 Elder Crag Boars, and 8 Snow Leopards, and then return to Rejold Barleybrew in Brewnall Village.",
    [320] = "Give the cask of Evershine to Pilot Bellowfiz at Steelgrill's Depot.",
    [321] = "Search the wreckage of The Flying Osprey in the Wetlands.",
    [322] = "Take the Crate of Lightforge Ingots to Grimand Elmore in Stormwind.",
    [323] = "Kill 15 Skeletal Raiders, 3 Skeletal Healers and 3 Skeletal Warders, and then return to Sven.",
    [324] = "Gather 5 Lightforge Ingots, then return to Glorin Steelbrow in the Wetlands.",
    [325] = "Bring Morbent's Bane to Sven in Duskwood.",
    [328] = "Use the Small Brass Key to open Bookie Herod's Strongbox.",
    [329] = "Take the Muddy Note to Lieutenant Doren at the Rebel Camp.",
    [330] = "Speak with Corporal Sethman.",
    [331] = "Speak with Lieutenant Doren.",
    [332] = "Go to the Gallina Winery, and bring Suzetta Gallina the Wine Ticket for a free bottle of wine.",
    [333] = "Go to the Canal Tailor Shop and bring Rema Schneider the Cloth Request from Harlan Bagley.",
    [334] = "Go to the Larson Clothiers in the Stormwind Mage Quarter, and give Thurman Schneider his Sewing Kit.",
    [335] = "Zardeth the Black Claw wants you to bring him a Tear of Tilloa from Darkshire and a Musquash Root from the Wetlands.",
    [336] = "Take the Black Claw Stout to Lord Wishock in the Hall of Petitioners.",
    [338] = "Collect the missing pages from The Green Hills of Stranglethorn manuscript. Once all four chapters are complete, return them to Barnil.",
    [339] = "Bring pages 1, 4, 6, and 8 of Nesingwary's The Green Hills of Stranglethorn to Barnil Stonepot in order to complete Chapter I.",
    [340] = "Bring pages 10, 11, 14 and 16 of Nesingwary's The Green Hills of Stranglethorn to Barnil Stonepot in order to complete Chapter II.",
    [341] = "Bring pages 18, 20, 21and 24 of Nesingwary's The Green Hills of Stranglethorn to Barnil Stonepot in order to complete Chapter III.",
    [342] = "Bring pages 25, 26, and 27 of Nesingwary's The Green Hills of Stranglethorn to Barnil Stonepot in order to complete Chapter IV.",
    [343] = "Go to the Royal Library in Stormwind Keep and speak with Milton Sheaf. He can find for you the book on metallurgy that Brother Kristoff needs for his speech.",
    [344] = "Speak with Brother Paxton in the Northshire Abbey.",
    [345] = "Speak with Foreman Oslow in Lakeshire and ask him for Rethban Iron Ore.",
    [346] = "Return to Brother Kristoff in the Cathedral Square. Give him the book The Stresses of Iron.",
    [347] = "Gather 5 loads of Rethban Ore and bring it to Brother Paxton in the Northshire Library.",
    [348] = "Seek out Witch Doctor Unbagwa and have him summon Mokk the Savage. Bring the Heart of Mokk to Fin Fizracket.",
    [350] = "Speak to Elling Trias in Stormwind.",
    [353] = "Deliver the Package for Stormpike to Mountaineer Stormpike in Loch Modan.",
    [354] = "Bring Gregor's Remains, Nissa's Remains and Thurman's Remains to Coleman Farthing in Brill.",
    [355] = "Speak with Magistrate Sevren in Brill.",
    [356] = "Kill 8 Bleeding Horrors and 8 Wandering Spirits, then report back to Linnea at her camp.",
    [357] = "Bring the Lich's Spellbook to Bethor Iceshard in the Undercity.",
    [358] = "Kill Rot Hide Graverobbers and Rot Hide Mongrels. Bring 8 Embalming Ichors to Magistrate Sevren in Brill.",
    [359] = "Speak with Deathguard Linnea.",
    [360] = "Return to Magistrate Sevren in Brill.",
    [361] = "Find Yvette Farthing, and deliver to her the letter from Thurman Agamand.",
    [362] = "Slay Devlin Agamand, and bring Devlin's Remains to Coleman Farthing in Brill.",
    [363] = "Speak with Shadow Priest Sarvis.",
    [364] = "Shadow Priest Sarvis wants you to kill 8 Mindless Zombies and 8 Wretched Zombies.",
    [365] = "Steal 10 pumpkins from the farm to the west, just north of Deathknell and take them to Apothecary Johaan in Brill.",
    [366] = "Return Gunther's Spellbook to him, on the island of Gunther's Retreat.",
    [367] = "Apothecary Johaan in the town of Brill wants you to collect 5 Vials of Darkhound Blood.",
    [368] = "Apothecary Johaan of the town of Brill needs 5 Vile Fin Scales from Murlocs in Tirisfal Glades.",
    [369] = "Apothecary Johaan in the town of Brill wants you to bring him 4 samples of venom from a Vicious Night Web Spider.",
    [370] = "Executor Zygand in Brill wants you to kill Captain Perrine, 3 Scarlet Zealots and 3 Scarlet Missionaries.",
    [371] = "Executor Zygand in Brill has commissioned you to slay Captain Vachon and 5 Scarlet Friars.",
    [372] = "Executor Zygand in the town of Brill wants you to assassinate Captain Melrache and his two bodyguards.",
    [374] = "Bring 10 Scarlet Insignia Rings to Deathguard Burgess in Brill.",
    [375] = "Bring five Duskbat Pelts and some Coarse Thread to Gretchen Dedmar in Brill.",
    [376] = "Novice Elreth requires 6 Scavenger Paws and 6 Duskbat Wings.",
    [377] = "Councilman Millstipe of Darkshire wants you to bring him the hand of Dextren Ward.",
    [378] = "Motley Garmason wants Kam Deepfury's head brought to him at Dun Modr.",
    [379] = "Bring 5 Wastewander Water Pouches to Chief Engineer Bilgewhizzle in Gadgetzan.",
    [380] = "Executor Arren wants you to kill 10 Young Night Web Spiders and 8 Night Web Spiders.",
    [381] = "Bring Executor Arren 12 Scarlet Armbands from Scarlet Converts and Scarlet Initiates.",
    [382] = "Kill Meven Korgal, the messenger, at the Crusader camp, then return any information you find to Executor Arren.",
    [383] = "Deliver the Scarlet Crusade Documents to Executor Zygand in Brill.",
    [384] = "Ragnar Thunderbrew in Kharanos wants 6 Crag Boar Ribs and a mug of Rhapsody Malt.",
    [385] = "Get 5 pieces of Crocolisk Meat and 6 Crocolisk Skins for Marek Ironheart at the Farstrider Lodge.",
    [386] = "Bring the head of Targorr the Dread to Guard Berton in Lakeshire.",
    [387] = "Warden Thelwater of Stormwind wants you to kill 10 Defias Prisoners, 8 Defias Convicts, and 8 Defias Insurgents in The Stockade.",
    [388] = "Nikova Raskol of Stormwind wants you to collect 10 Red Wool Bandanas.",
    [389] = "Speak with Warden Thelwater in the Stockade.",
    [391] = "Kill Bazil Thredd and bring his head back to Warden Thelwater at the Stockade.",
    [392] = "Bring the Sealed Description of Thredd's Visitor to Baros Alexston in Stormwind.",
    [393] = "Bring the Sealed Description of Thredd's Visitor to Master Mathias Shaw in Stormwind.",
    [394] = "Speak to Mathias Shaw in Stormwind.",
    [395] = "Speak with Baros Alexston in Stormwind.",
    [396] = "Deliver Baros Alexston's report on the Defias Brotherhood to King Varian Wrynn in Stormwind Keep.",
    [397] = "Speak with Zggi, the servant of Zardeth the Blackclaw, to claim your reward.",
    [398] = "Kill Maggot Eye and return to Executor Zygand in Brill with his paw for a reward.",
    [399] = "Go to Baros Alexston's house in Westfall and search for his compass, then return it to him in Cathedral Square of Stormwind.",
    [400] = "Deliver Steelgrill's Tools to Beldin Steelgrill.",
    [401] = "Wait a moment, then speak with Sirra Von'Indi again.",
    [404] = "Bring 7 Putrid Claws to Deathguard Dillinger in Brill.",
    [405] = "Present Sevren's Orders to Bethor Iceshard in the Undercity.",
    [407] = "Take the Laced Pumpkin to the Captured Scarlet Zealot who is being held in the cellar of the Gallow's End Tavern.",
    [408] = "Kill 8 Wailing Ancestors and 8 Rotting Ancestors. Kill Captain Dargol, and bring his skull to Magistrate Sevren in Brill.",
    [409] = "Obtain a Candle of Beckoning. Summon Lillith Nefara and kill her. Return to Gunther on his island.",
    [411] = "Bring the Nether Gem to Bethor Iceshard in the Undercity.",
    [412] = "Bring Razzle Sprysprocket in Kharanos 8 Restabilization Cogs and 8 Gyromechanic Gears.",
    [413] = "Take the Barrel of Shimmer Stout to Mountaineer Barleybrew.",
    [414] = "Take the Cask of Shimmer Stout to Mountaineer Kadrell.",
    [415] = "Speak with Rejold Barleybrew.",
    [416] = "Bring 12 Tunnel Rat Ears to Mountaineer Kadrell in Thelsamar.",
    [417] = "Kill Mangeclaw. Bring his Mangy Claw and Hildelve's Journal to Pilot Hammerfoot.",
    [418] = "Bring 3 pieces of Bear Meat, 3 Boar Intestines, and 3 Spider Ichor to Vidra Hearthstove in Thelsamar.",
    [419] = "Find Pilot Hildelve.",
    [420] = "Deliver Grelin's report to Senir Whitebeard in Kharanos.",
    [421] = "Dalar Dawnweaver at the Sepulcher wants you to kill 5 Moonrage Whitescalps.",
    [422] = "Retrieve the Remedy of Arugal for Dalar Dawnweaver at the Sepulcher.",
    [423] = "Bring 6 Glutton Shackles and 3 Darksoul Shackles to Dalar Dawnweaver at the Sepulcher.",
    [424] = "Kill Grimson the Pale and bring his head to Dalar Dawnweaver at the Sepulcher.",
    [425] = "Kill Ivar the Foul, and bring Ivar's Head to Rane Yorick at the Ivar Patch.",
    [426] = "Gather 5 Notched Ribs and 3 Blackened Skulls, then return to Deathguard Dillinger in Brill.",
    [427] = "Executor Zygand of Brill wants you to kill 10 Scarlet Warriors.",
    [428] = "Find the Deathstalkers Quinn and Rane Yorick.",
    [429] = "Gather 6 discolored worg hearts and bring them to Apothecary Renferrel at the Sepulcher.",
    [430] = "Bring Quinn's potion to Quinn Yorick at the Ivar Patch, north of the Sepulcher.",
    [432] = "Kill 6 Rockjaw Skullthumpers for Foreman Stonebrow at the Gol'Bolar quarry.",
    [433] = "Kill 10 Rockjaw Bonesnappers for Senator Mehr Stonehallow at the Gol'Bolar quarry.",
    [434] = "Remain in the garden until Lord Gregor Lescovar and Marzon the Silent Blade have had their conversation. Afterwards, kill them both before returning to Elling Trias in Stormwind.",
    [435] = "Escort Erland through the wolves, to Rane Yorick.",
    [436] = "Speak with Explorer Fellhew.",
    [437] = "Kill rot hide gnolls at the Dead Fields. When Nightlash appears, kill her. Bring the Essence of Nightlash to High Executor Hadrec at the Sepulcher.",
    [438] = "Go to the Decrepit Ferry. Search for the reason the Scourge are there.",
    [439] = "Bring Deliah's Ring to High Executor Hadrec at the Sepulcher.",
    [440] = "Bring Deliah's Ring to Magistrate Sevren in Brill.",
    [441] = "Bring Deliah's Ring to Raleigh.",
    [442] = "Bring Thule's Head to High Executor Hadrec at the Sepulcher.",
    [443] = "Bring 8 bottles of rot hide ichor to Apothecary Renferrel at the Sepulcher.",
    [444] = "Bring the Sample Ichor to Bethor Iceshard in the Undercity.",
    [445] = "Take Apothecary Johaan's findings to Apothecary Renferrel in Silverpine Forest.",
    [446] = "Bring Bethor's Scroll to Apothecary Renferrel at the Silverpine Sepulcher.",
    [447] = "Collect 6 Grizzled Bear Hearts and 6 samples of Skittering Blood and deliver them to Master Apothecary Faranell in the Undercity.",
    [448] = "Report to High Executor Hadrec at the Sepulcher.",
    [449] = "Bring the Deathstalker Report to High Executor Hadrec at the Sepulcher.",
    [450] = "Retrieve Apothecary Berard's journal from Pyrewood Village and take it to Apothecary Renferrel at the Sepulcher.",
    [451] = "Bring 6 samples of Lake Creeper Moss, 6 samples of Lake Skulker Moss and a Hardened Tumor to Master Apothecary Faranell in the Undercity.",
    [452] = "Help Deathstalker Faerleia kill the Pyrewood Council.",
    [453] = "Find the Shadowy Figure. Your clues: He is not native to Darkshire. He is a nervous, jittery person. He left Darkshire and headed west.",
    [454] = "Speak with Miran.",
    [455] = "Traverse Dun Algaz. Kill 8 Dragonmaw Scouts and 6 Dragonmaw Grunts. Report to Valstag Ironjaw in Menethil Harbor.",
    [456] = "Kill 7 Young Nightsabers and 4 Young Thistle Boars and return to Conservator Ilthalaine.",
    [457] = "Conservator Ilthalaine needs you to kill 7 Mangy Nightsabers and 7 Thistle Boars.",
    [458] = "Seek out the dryad known as Tarindrella.",
    [459] = "Collect 8 Fel Moss and bring them to Tarindrella.",
    [460] = "Bring Alaric's Head to his grave.",
    [461] = "Take Alaric to the hidden alcove.",
    [463] = "Find the Greenwarden.",
    [464] = "Bring 8 Dragonmaw War Banners to Captain Stoutfist.",
    [465] = "Destroy the Dragonmaw catapults.",
    [466] = "Bring 6 loads of Incendicite Ore to Pilot Stonegear in Dun Morogh.",
    [467] = "Speak with Pilot Stonegear.",
    [468] = "Speak with Mountaineer Rockgar.",
    [469] = "Deliver the Bundle of Crocolisk Skins to James Halloran, the tanner, in Menethil Harbor.",
    [470] = "One of the oozes at Ironbeard's Tomb has Sida's bag, retrieve it and bring it back to her in Menethil Harbor.",
    [471] = "Collect 6 Giant Crocolisk Skins and bring them to James Halloran in Menethil Harbor.",
    [472] = "Search for Longbraid near the town of Dun Modr.",
    [473] = "Speak with Captain Stoutfist.",
    [474] = "Kill Chieftain Nek'rosh Bring Nek'rosh's Head to Captain Stoutfist.",
    [475] = "Seek out Gaerolas Talvethren in Starbreeze Village.",
    [476] = "Return to Athridas Bearmantle in Dolanaar.",
    [477] = "Retrieve the contents of one of the Dalaran wizards' crates. You will find Pyrewood Village to the south.",
    [478] = "Bring the strange pendant to Shadow Priest Allister at the Sepulcher.",
    [479] = "Obtain 8 Dalaran Pendants for Shadow Priest Allister at the Sepulcher.",
    [480] = "Kill the Dalaran archmage, then retrieve his staff for Shadow Priest Allister at the Sepulcher.",
    [481] = "Take the rune-inscribed pendant to Dalar Dawnweaver at the Sepulcher.",
    [482] = "Speak with Shadow Priest Allister at the Sepulcher.",
    [483] = "Retrieve the Relics of Wakening and bring them to Athridas Bearmantle in Dolanaar.",
    [484] = "Obtain 4 Young Crocolisk Skins for James Halloran in Menethil Harbor.",
    [486] = "Kill Ursal the Mauler and return to Athridas Bearmantle in Dolanaar.",
    [487] = "Slay 6 Gnarlpine Ambushers and return to Sentinel Amara Nightwalker outside of Dolanaar.",
    [488] = "Bring Zenn Foulhoof outside of Dolanaar 3 Nightsaber Fangs, 3 Strigid Owl Feathers and 3 swatches of Webwood Spider Silk.",
    [489] = "Collect 3 Fel Cones and give them to Zenn Foulhoof outside of Dolanaar.",
    [490] = "Shayla Nightbreeze on the road outside of Darnassus wants you to bring her 15 Gnarlpine Fangs.",
    [491] = "Take the Woven Wand to Bethor Iceshard in the Magic Quarter of the Undercity.",
    [492] = "Bring Johaan's Special Drink to the Captured Mountaineer.",
    [493] = "Deliver Apothecary Renferrel's findings to Apothecary Lydon in the town of Tarren Mill in the Hillsbrad Foothills.",
    [494] = "Travel to Tarren Mill to deliver Deathstalker Lesh's message to High Executor Darthalia.",
    [495] = "Report to Melisara at Tarren Mill in the Hillsbrad Foothills.",
    [496] = "Apothecary Lydon of Tarren Mill wants 10 Gray Bear Tongues and some Creeper Ichor.",
    [498] = "Krusk in Tarren Mill needs you to free Drull and Tog'thar from Durnholde Keep.",
    [499] = "Give Umpi the Elixir of Suffering.",
    [500] = "Gather 9 Dirty Knucklebones from Crushridge ogres in the Alterac Mountains. Bring them to Marshal Redpath in Southshore.",
    [501] = "Bring 10 vials of Mountain Lion Blood to Apothecary Lydon in Tarren Mill.",
    [502] = "Feed the Elixir of Pain to Stanley.",
    [503] = "Free Gol'dir then return to Krusk in Tarren Mill.",
    [504] = "Slay 15 Crushridge Warmongers, then return to Marshal Redpath in Southshore.",
    [505] = "Kill 12 Syndicate Footpads and 8 Syndicate Thieves, then return to Magistrate Henry Maleb in Southshore.",
    [506] = "Return the information gathered by Gol'dir to Krusk in Tarren Mill.",
    [507] = "Kill Lord Aliden Perenolde and ask his mistress, Elysa, about Taretha's pendant.",
    [508] = "Return Taretha's pendant to Krusk in Tarren Mill.",
    [509] = "Bring 6 Mudsnout Blossoms to Apothecary Lydon in Tarren Mill.",
    [510] = "Bring the Foreboding Plans to Magistrate Maleb in Southshore.",
    [511] = "Bring the Encrypted Letter to Loremaster Dibbs in Southshore.",
    [512] = "Bring 7 Alterac Signet Rings to Magistrate Maleb in Southshore.",
    [513] = "Take the Mudsnout Composite to Master Apothecary Faranell in the Undercity.",
    [514] = "Take the Cleverly Encrypted Letter to Prospector Stormpike in Ironforge.",
    [515] = "Bring the Mudsnout Mixture, a Strong Troll's Blood Potion, 5 Daggerspine Scales and 5 Torn Fin Eyes to Apothecary Lydon in Tarren Mill.",
    [516] = "Locate Beren's Peril, then kill 6 Ravenclaw Drudgers and 6 Ravenclaw Guardians, then return to Shadow Priest Allister at the Sepulcher.",
    [517] = "Bring a keg of Shindigger Stout to Apothecary Lydon in Tarren Mill.",
    [518] = "Kill 10 Crushridge Maulers for Melisara in Tarren Mill.",
    [519] = "Kill Targ, Muckrake, and Glommus and bring their heads to Melisara in Tarren Mill.",
    [520] = "Kill Mug'Thol, and return his head with the Crown of Will to Melisara in Tarren Mill.",
    [521] = "Deliver the Crown of Will to Sharlindra in the Undercity.",
    [522] = "Bring the Assassin's Contract to Magistrate Maleb in Southshore.",
    [523] = "Bring the Head of Baron Vardus to Magistrate Maleb in Southshore.",
    [524] = "Place the Tainted Keg on the rug for the captured farmers.",
    [525] = "Bring the Decrypted Letter to Magistrate Maleb in Southshore.",
    [526] = "Gather 5 lightforge ingots, then return to Glorin Steelbrow in the Wetlands.",
    [527] = "Kill 6 Hillsbrad Farmhands, 6 Hillsbrad Farmers, Farmer Ray and Farmer Getz and report back to Darthalia in Tarren Mill.",
    [528] = "Kill 15 Hillsbrad Peasants and report back to Darthalia in Tarren Mill.",
    [529] = "Kill Blacksmith Verringtan and 4 Hillsbrad Apprentice Blacksmiths. Retrieve a shipment of iron and report back to Darthalia in Tarren Mill.",
    [530] = "Kill Valdred Moray. Bring his hands to Raleigh Andrean in the Undercity.",
    [531] = "Bring Ol' Sooty's head to Vyrin Swiftwind at the Farstrider Lodge.",
    [532] = "Kill Magistrate Burnside and 5 Hillsbrad Councilmen. Destroy the Hillsbrad Proclamation. Steal the Hillsbrad Town Registry. Report back to Darthalia in Tarren Mill afterwards.",
    [533] = "Retrieve information about Gol'dir's whereabouts for Krusk in Tarren Mill.",
    [535] = "Bring a mug of Southshore Stout to Valik in the Syndicate camp.",
    [536] = "Kill 10 Torn Fin Tidehunters and 10 Torn Fin Oracles for Lieutenant Farren Orinelle in Southshore.",
    [537] = "Kill 4 Argus Shadow Mages. Bring the Head of Nagaz to Magistrate Maleb in Southshore.",
    [538] = "Speak with Loremaster Dibbs in Southshore.",
    [539] = "Kill Foreman Bonds and 10 Hillsbrad Miners and report back to Darthalia in Tarren Mill.",
    [540] = "Bring 5 Recovered Tomes and the Worn Leather Book containing The Arm of Gri'lek to Loremaster Dibbs in Southshore.",
    [541] = "Travel to Dun Garok and kill 8 Mountaineers, 4 Riflemen, 2 Priests and Captain Ironhill and report back to Darthalia in Tarren Mill.",
    [542] = "Bring the Tomes of Alterac to Milton Sheaf in Stormwind.",
    [543] = "Bring the Perenolde Tiara to Remington Ridgewell in Stormwind.",
    [544] = "Find the traitors and recover their artifacts, then return to Magus Voidglare in Tarren Mill.",
    [545] = "Kill 6 Dalaran Summoners and 12 Elemental Slaves, then return to Magus Voidglare in Tarren Mill.",
    [546] = "Deathguard Samsa of Tarren Mill wants 30 Hillsbrad Human Skulls.",
    [547] = "Retrieve Deathguard Humbert's sword from Dun Garok and return it to him in Tarren Mill.",
    [549] = "Kill 10 Syndicate Rogues and 10 Syndicate Watchmen. Return to High Executor Darthalia in Tarren Mill for your reward.",
    [550] = "Take Darthalia's Sealed Commendation to Varimathras in the Undercity.",
    [551] = "Take the Ensorcelled Parchment to Loremaster Dibbs in Southshore.",
    [552] = "Retrieve Helcular's Rod from the Yeti and bring it back to Novice Thaivand in Tarren Mill.",
    [553] = "Charge the Rod of Helcular with the powers of the Flame of Azel, Flame of Veraz and the Flame of Uzel. Drive the charged rod into Helcular's grave in Southshore.",
