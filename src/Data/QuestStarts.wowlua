    [1881] = "Speak with Anastasia Hartwell.",
    [1882] = "Bring Balnir Snapdragons to Anastasia Hartwell in the Mage Quarter of the Undercity.",
    [1883] = "Speak with Un'thuwa.",
    [1884] = "Destroy 4 Ju-Ju Heaps, then return to Un'thuwa in Sen'jin Village.",
    [1885] = "Speak with Mennet Carkad in the Rogues' Quarter of the Undercity.",
    [1886] = "Get Astor's Letter of Introduction and return it to Mennet Carkad in the Rogues' Quarter.",
    [1898] = "Speak with Andron Gant in the Undercity.",
    [1899] = "Bring Andron's Ledger to Mennet Carkad in the Rogues' Quarter of Undercity.",
    [1918] = "Bring the Befouled Water Globe to Mastok Wrilehiss at Splintertree Post, Ashenvale.",
    [1919] = "Speak with Jennea Cannon in Stormwind.",
    [1920] = "Obtain a Cantation of Manifestation and a Chest of Containment coffers from behind Jennea Cannon. Bring 3 Filled Containment Coffers to Jennea at the Wizard's Sanctum.",
    [1921] = "Bring 10 Linen Cloth and the 6 Charged Rift Gems to Wynne Larson in Stormwind.",
