    [1824] = "Bring 5 twitching antennae to Ruga Ragetotem at Camp Taurajo",
    [1825] = "Speak with Thun'grim Firegaze in the Barrens.",
    [1838] = "Bring to Thun'grim Firegaze 15 Smoky Iron Ingots, 10 Powdered Azurite, 10 Iron Bars and a Vial of Phlogiston.",
    [1839] = "Speak with Ula'elek in Durotar.",
    [1840] = "Speak with Orm Stonehoof in Thunder Bluff.",
