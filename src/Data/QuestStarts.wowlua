    [97970] = "Speak with Messana Crestwind in Shen'dar Village to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97971] = "Speak with Mendalass Tattermend in Shen'dar Village to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97972] = "Speak with Taleen Shimmerthread in Shen'dar Village to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97973] = "Speak with Taleen Shimmerthread in Shen'dar Village to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [97977] = "Collect 4 Gnarlpine Totems and bring them to Tarindrella.",
    [97979] = "Cast Elune's Light and Shadowmeld.",
    [97985] = "Slay Stormheart in Thousand Needles and acquire its heart.",
    [98013] = "Eliminate 12 Stormscale Myrmidons, 8 Stormscale Sorceresses, and 6 Stormscale Warriors for Arbal at the Grove of the Ancients.",
    [98021] = "Report To Gryan Stoutmantle at Sentinel Hill in Westfall.",
    [98024] = "Report To Thork at The Crossroads in The Barrens.",
    [98025] = "Find and slay the owl known as Jai'vhanel and take one of her feathers. The black owl was last seen north of the Ameth'Aran ruins near the mountain base. Report the death of Jai'vhanel to Sentinel Glynda Nal'Shea in Auberdine.",
    [98028] = "Bring the Clouded Water Globe to Onu at the Grove of the Ancients in Darkshore.",
    [98042] = "Obtain a Peerless Eye from a Twilight Disciple or Thug at the Master's Glaive in Darkshore and find someone in Auberdine who is willing to take it.",
    [98046] = "Bring the Drained Vessel to Lariia in the Temple of the Moon in Darnassus.",
    [98065] = "Bring the Moonwell Remnants to Tyrande Whisperwind in the Temple of the Moon in Darnassus.",
    [98067] = "Place Sentinel Owls at the entrance to the Cenarion Hold depths, the Darnassus Bank, the Craftsman's Terrace Inn, and the City Gate for Sentinel Dalia Sunblade in the Temple of the Moon in Darnassus.",
    [98069] = "Bring 8 Stolen Freewind Supplies to Jandia in Freewind Post.",
    [98070] = "Slay 5 Screeching Harpies, 5 Screeching Roguefeather Harpies and 5 Screeching Windcaller Harpies.",
    [98071] = "Deliver the bottles of Fallrook Varietal to Dun Garok in southeast Hillsbrad Foothills, and bring back a sack of their Homebrew Hops.",
    [98094] = "High Executor Darthalia wants you to deliver updated orders to Deathstalker Masoj, south of Tarren Mill, outside of Dun Garok.",
    [98095] = "Deathstalker Masoj needs you to place the three Apothecary Vials on peaks around Hillsbrad Foothills and return to him.",
    [98155] = "Bring 5 Pristine Pesterhide Pelts to Kristy Grant.",
    [98190] = "Bring the Menethil Statuette to Highlord Bolvar Fordragon in Stormwind Keep.",
    [98191] = "Bring the Menethil Statuette to Lord Grayson Shadowbreaker in the Cathedral of Light.",
    [98197] = "Recover 6 Khaz Modan Timber and 30 Khaz Modan Iron from Menethil Harbor for Valstag Ironjaw.",
    [98209] = "Bring Nord'el to Thundris Windweaver in Auberdine in Darkshore. You recall Sylessa mentioning a boat in Menethil Harbor can take you there.",
    [98216] = "Use the Goaz Stone near the Goaz Warder and bring its Titanic Keystone back to Prospector Whelgar.",
    [98221] = "Captain Stoutfist in Menethil Keep wants you to destroy the 4 sets of Attack Plans in the Angerfang Encampment.",
    [98230] = "Find Howin Kindfeather east of Menethil Harbor, along the road.",
    [98245] = "Collect 10 Razormaw Incisors for Howin Kindfeather.",
    [98282] = "Collect an Unruptured Stalker Gland from Thelgen Rock for Caitlin Grassman in Menethil Harbor.",
    [98283] = "Bring Carnage's Head to Rethiel the Greenwarden in The Green Belt.",
    [98284] = "Speak with Nasalanna Windsinger in Shen'dar Village to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [98285] = "Speak with the Strange Hermit in Shadowgale Forest to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [98286] = "Speak with Nasalanna Windsinger in Shen'dar Village to learn to craft a camping item for your profession once you have shown proficiency in your skill.",
    [98291] = "Kill 8 Dragonmaw Reclaimers, 5 Dragonmaw Soulbinders, and 3 Dragonmaw Infiltrators in Dragonmaw Retreat for Howin Kindfeather.",
    [98297] = "Kill the Subdued Dragonspawn at the Dragonmaw Gates for Howin Kindfeather.",
    [98298] = "Bring 6 Worgen Bits to Dalar Dawnweaver in The Sepulcher.",
    [98299] = "Slay 5 Sickly Refugees and 5 Haggard Refugees for Dalar Dawnweaver in The Sepulcher.",
    [98300] = "Deliver Howin's Missive to King Magni Bronzebeard in Ironforge.",
    [98310] = "Use the Goaz Stone near Ados, Modr, Golm, and Neru and bring their hearts back to Prospector Whelgar.",
    [98313] = "Bring the Whelgar Relic Package to Historian Karnik in Ironforge.",
    [98319] = "Find Mountaineer Cornelius in the Grizzled Den for Mountaineer Gretchen.",
    [98321] = "Collect 8 Flintfire Shipments from the Grizzled Den for Tongus Flintfire in Kharanos.",
    [98322] = "Check in on Mountaineer Gretchen west of Kharanos.",
    [98323] = "Deliver Mountaineer Gretchen's Report back to Senir Whitebeard in Kharanos.",
    [98326] = "Slay Frosthowl and collect the Sack of Fish for Gretta Ganter in Brewnall Village",
    [98340] = "Speak with Dendrite Starblaze in the village of Nighthaven, Moonglade.",
    [98341] = "Seek out the Avatar of Saeyleenan in the southern part Moonglade and learn what it has to share with you about the nature of the windborne cat.",
    [98342] = "Recover the Relic of the Fang, Relic of the Claw, and Relic of the Silent Shadow from the Stormrage Barrow Den, and return them to the Great Cat Spirit.",
    [98362] = "Return to Thunder Bluff and speak with Turak Runetotem on the Elder Rise.",
    [98386] = "Slay 12 Greater Tarantulas and destroy 6 Tarantula Eggs in Alther's Mill for Foreman Oslow in Redridge.",
    [98387] = "Bring 8 Stolen Weapons and 10 Blackrock Supplies to Marshal Marris in Lakeshire.",
    [98389] = "Free 6 Webbed Victims in Night's Web Hollow for Aramis Hammerhand in Deathknell.",
    [98391] = "Speak to Sister Aquinne in Darnassus.",
    [98392] = "Collect Hatescreech's Amulet, Windmistress Gaedress' Amulet, and Witchmother Arysa's Amulet for Sentinel Arynia Cloudsbreak in the Oracle Glade.",
    [98393] = "Speak with Dendrite Starblaze in the village of Nighthaven, Moonglade.",
    [98394] = "Seek out the Great Cat Spirit in southern part Moonglade and learn what it has to share with you about the nature of the cat.",
    [98396] = "Recover the Relic of the Fang, Relic of the Claw, and Relic of the Silent Shadow from the Stormrage Barrow Den, and return them to the Great Cat Spirit.",
    [98397] = "Return to Darnassus and speak with Mathrengyl Bearwalker in the Cenarion Enclave.",
    [98398] = "Find the Oracle Tree Bark nearby to receive its message.",
    [98403] = "Kill 8 Befouled Webwoods and bring Xethorr the Wicked's Mature Fel Moss to Tallonkai Swiftroot in Dolanaar.",
    [98404] = "Recover the Relic of the Fang, Relic of the Claw, and Relic of the Silent Shadow from the Stormrage Barrow Den, and return them to the Avatar of Saeyleenan.",
    [98405] = "Seek out the Great Cat Spirit in southern part Moonglade and learn what it has to share with you about the nature of the cat.",
    [98407] = "Collect 5 Spiked Collars from Redridge Thrashers for Deputy Feldon near Lakeshire.",
    [98417] = "Maseara Autumnmoon wants you to search west of Forest Song, amongst the Satyrnaar demons. Report any signs of her husband Kurothel upon your return.",
    [98418] = "Kill 5 Xavian Rogues, 5 Felsworn, 5 Betrayers, and 5 Hellcallers. Return to Maseara Autumnmoon in Forest Song afterwards.",
    [98424] = "Collect the rest of Supervisor Fizsprocket's pages inside The Venture Co. Mine and bring them to Morin Cloudstalker near Bloodhoof Village.",
    [98427] = "Bring the Clearcutter Key to Morin Cloudstalker outside Bloodhoof Village.",
    [98435] = "Bring Thunderhorn's Report to Arch Druid Hamuul Runetotem in Thunder Bluff.",
    [98459] = "Deliver Tom's Gift to Bart Tidewater in Menethil Harbor in the Wetlands.",
    [98461] = "Deliver Hollee's Note to Tarrel Rockweaver near Menethil Harbor in the Wetlands.",
    [98463] = "Visit Nixxrax Fillamug in the Salty Sailor Tavern in Booty Bay in Stranglethorn.",
    [98512] = "Kill 10 Al'Aketh Assassins in the Shen'dar Highlands.",
    [98545] = "Deliver the Sealed Letter to Glix Xizzix in the Undercity.",
    [98574] = "Read the Hallowed Memorandum and speak to Branstock Khalder in Anvilmar.",
    [98575] = "Read the Tainted Tablet and speak to Nartok inside the Den in the Valley of Trials.",
    [98576] = "Read the Glyphic Parchment and speak with Mai'ah near the entrance to the Den in the Valley of Trials.",
    [98581] = "Read the Archaic Rune and speak to Teo Hammerstorm in Anvilmar.",
    [98601] = "Read the Consecrated Scroll and speak to Aramis Hammerhand in the church in Deathknell.",
    [98739] = "Speak to Dendrite.",
    [98815] = "Return 4 Thicket Raptor Hides to James Halloran, the tanner, in Menethil Harbor.",
    [98823] = "Bring the Titan Relic to Muln Earthfury at the Skywatcher Plateau in northwest Mulgore.",
    [98824] = "Bring the Titan Relic to High Explorer Magellas in Ironforge's Hall of Explorers.",
    [98887] = "Bring 3 Darkspear Islands Marks of Honor to a Horde Warbringer outside the battlegrounds.",
    [98895] = "Bring 3 Darkspear Islands Marks of Honor to an Alliance Brigadier General outside the battlegrounds.",
    [98906] = "Win a Darkspear Islands battleground and return back to Nizook Boof at The Merchant Coast.",
    [99046] = "Search for Sentinel Eralya Leafshadow on the road leading to the Oracle Glade.",
    [99047] = "Seek aid from Byancie in Dolaanar for Sentinel Eralya Leafshadow.",
    [99048] = "Find Heglan Shadeeye north of Tiragarde Keep.",
    [99049] = "Find signs of what attacked Heglan Shadeeye.",
    [99050] = "Collect 6 Dewy Lasher Fronds, an Empty Vial, and a Refreshing Spring Water for Byancie in Dolanaar.",
    [99051] = "Collect 9 Naga Spinefins.",
    [99052] = "Kill the sea giant along Durotar's north coast and bring back proof of your accomplishment.",
    [99053] = "Help Sentinel Lynessa Duskblossom escape Ban'ethil Barrow Den, and report her safety to Sentinel Kyra Starsong in Dolanaar.",
    [99073] = "Take the Lashwater Salve to Sentinel Eralya Leafshadow on the road to the Oracle Tree.",
    [99079] = "Find Longwalker Malah Longwind east of Bloodhoof Village, near the edge of Mulgore.",
    [99080] = "Kill 6 Galak Centaurs, 4 Galak Outrunners, and bring the head of Herak the Pillager to Baine Bloodhoof.",
    [99081] = "Bring Longwalker Malah's Report to Brave Wildrunner in Bloodhoof Village.",
    [99082] = "Seek audience with High Chieftain Cairne Bloodhoof in Thunder Bluff.",
    [99101] = "Bring Longwalker Malah's Report to Baine Bloodhoof.",
    [99108] = "Defeat 3 other players in duels or Novice Warriors for Tang Stonehoof.",
    [99123] = "Help Pal'juh escape Kolkar Crag and bring news of your success to Master Vornal in Sen'jin Village.",
    [99127] = "Check the fishing nets in Crystal Lake.",
    [99128] = "Kill the murlocs at Crystal Lake.",
    [99129] = "Speak with Remy \"Two Times\" about Jason's murloc problems.",
    [99130] = "Collect ingredients for murloc bait.",
    [99131] = "Return to Jason Mathers.",
    [99134] = "Punish 5 Deathguards for Executor Zygand.",
    [99141] = "Obtain reports from Deathguard Dillinger, Deathguard Kristof, and Gordo for Executor Zygand.",
    [99142] = "Collect 5 Tomb Weed and deliver them back to Junior Apothecary Holland.",
    [99143] = "Collect 6 pieces of shiny junk from the nearby Murloc camp.",
    [99144] = "Help Bareth Dawnstone escape Crusader's Outpost, and report his safety to Shari Stilwell in Brill.",
    [99152] = "Collect 6 Faintly Glowing Bones for Hilda the Breaker.",
    [99153] = "Find the Hidden Crystal Fragment beneath Shadowvale for Ephram Barbaro.",
    [99156] = "Bring Riptear's Heart to Deathguard Linnea.",
    [99158] = "Bring the crate of candles to Father Gavin.",
    [99159] = "Collect 14 pieces of firewood.",
    [99160] = "Destroy 10 minor ice elementals.",
    [99161] = "Kill Avala and retrieve its core.",
    [99162] = "Collect the rifles of fallen mountaineers.",
    [99411] = "Ahab Wheathoof at Bloodhoof Village in Mulgore wants you to feed his prized puppy, Kyle the Frenzied. Feed Kyle Tender Strider Meat and return to Ahab Wheathoof.",
