    [8960] = "Travel to Blackrock Mountain and use the Extra-Dimensional Ghost Revealer to find Bodley near Blackrock Spire.",
    [8961] = "Gather the Incendicite of Incendius, the Ember of Emberseer and the Cinder of Cynders, along with a Hallowed Brazier, and return them to Bodley inside Blackrock Mountain.",
    [8962] = "Acquire Druidical Remains and return them to Bodley inside Blackrock Mountain.",
    [8963] = "Acquire a Starbreeze Village Relic and return it to Bodley inside Blackrock Mountain.",
    [8964] = "Retrieve a Brilliant Sword of Zealotry and return it to Bodley inside Blackrock Mountain.",
    [8965] = "Obtain Soul Ashes of the Banished and return them to Bodley inside Blackrock Mountain.",
    [8966] = "Use the Brazier of Beckoning to summon forth the spirit of Mor Grayhoof and slay him. Return to Bodley inside Blackrock Mountain with the Left Piece of Lord Valthalak's Amulet and the Brazier of Beckoning.",
    [8967] = "Use the Brazier of Beckoning to summon forth the spirit of Isalien and slay her. Return to Bodley inside Blackrock Mountain with the Left Piece of Lord Valthalak's Amulet and the Brazier of Beckoning.",
    [8968] = "Use the Brazier of Beckoning to summon forth Jarien and Sothos and slay them. Return to Bodley inside Blackrock Mountain with the Left Piece of Lord Valthalak's Amulet and the Brazier of Beckoning.",
    [8969] = "Use the Brazier of Beckoning to summon forth the spirit of Kormok and slay him. Return to Bodley inside Blackrock Mountain with the Left Piece of Lord Valthalak's Amulet and the Brazier of Beckoning.",
    [8970] = "Gather 20 Bloodkelp from the Strashaz naga and then return to Bodley inside Blackrock Mountain.",
    [8977] = "Bring the Extra-Dimensional Ghost Revealer to Deliana in Ironforge.",
    [8978] = "Return to Mokvar in Orgrimmar with the Extra-Dimensional Ghost Revealer.",
    [8979] = "Bring 1 Cologne Bottle and 1 Perfume Bottle to Apothecary Zinge in the Undercity's Apothecarium.",
    [8980] = "Return to Fenstad Argyle outside the bank in the Undercity.",
    [8982] = "Speak with Innkeeper Norman in the Undercity.",
    [8983] = "Speak with Mara Rennick at the tailor's shop in the Undercity's Mage Quarter.",
    [8984] = "Find Apothecary Staffron Lerent in the Hillsbrad Foothills past Ravenholdt Manor.",
    [8985] = "Acquire a Starbreeze Village Relic and return it to Bodley inside Blackrock Mountain.",
    [8986] = "Acquire Druidical Remains and return them to Bodley inside Blackrock Mountain.",
    [8987] = "Retrieve a Brilliant Sword of Zealotry and return it to Bodley inside Blackrock Mountain.",
    [8988] = "Obtain Soul Ashes of the Banished and return them to Bodley inside Blackrock Mountain.",
    [8989] = "Use the Brazier of Beckoning to summon forth the spirit of Mor Grayhoof and slay him. Return to Bodley inside Blackrock Mountain with the recombined Lord Valthalak's Amulet and the Brazier of Beckoning.",
    [8990] = "Use the Brazier of Beckoning to summon forth the spirit of Isalien and slay her. Return to Bodley inside Blackrock Mountain with the recombined Lord Valthalak's Amulet and the Brazier of Beckoning.",
    [8991] = "Use the Brazier of Beckoning to summon forth Jarien and Sothos and slay them. Return to Bodley inside Blackrock Mountain with the recombined Lord Valthalak's Amulet and the Brazier of Beckoning.",
    [8992] = "Use the Brazier of Beckoning to summon forth the spirit of Kormok and slay him. Return to Bodley inside Blackrock Mountain with the recombined Lord Valthalak's Amulet and the Brazier of Beckoning.",
    [8994] = "Gather 40 Blackrock Bracers and acquire a Flask of Supreme Power. Return them to Bodley inside Blackrock Mountain.",
    [8995] = "Use the Brazier of Beckoning to summon Lord Valthalak. Dispatch him, and use Lord Valthalak's Amulet on the corpse. Then, return Lord Valthalak's Amulet to the Spirit of Lord Valthalak.",
