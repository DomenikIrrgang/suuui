-- Data/Presets/init.wowlua
-- The Cooldown Manager's presets for your class. Each class's file
-- (Data/Presets/<CLASS>.wowlua, generated by tools/gen_presets.lua) builds
-- its own; only your class's are built, as only your class's file loaded
-- when they were plain Lua. The types follow what tools/gen_presets.lua
-- writes (tools/presets_source.lua explains every field): a field it starts
-- writing needs adding here.

import * as secret from "wowlua:secret"
import build as druid from "./DRUID"
import build as hunter from "./HUNTER"
import build as mage from "./MAGE"
import build as paladin from "./PALADIN"
import build as priest from "./PRIEST"
import build as rogue from "./ROGUE"
import build as shaman from "./SHAMAN"
import build as warlock from "./WARLOCK"
import build as warrior from "./WARRIOR"

--- A condition of a `when`: its type picks the field that goes with it
--- (group: value; classes: classes, others; talent: talents, as spell IDs;
--- role: roles; stance: stances; instance, target: kinds); `not` turns it
--- around.
export type PresetCondition = {
    type: string,
    value?: string,
    classes?: string[],
    others?: boolean,
    talents?: number[],
    roles?: string[],
    stances?: string[],
    kinds?: string[],
    -- ["not"] = true: as an indexer, since 0.9.1 has no optional field
    -- with a bracketed key (`["not"]?: boolean` doesn't parse)
    [string]: any,
}

--- match: "all" (left out) or "any"
export type PresetWhen = { match?: string, conditions: PresetCondition[] }

--- A group's member, with its own art
export type PresetMember = { name: string, source?: string, icon?: number, when?: PresetWhen, ids: number[] }

--- An entry of a preset's list: one spell or aura (ids), a weapon enchant
--- (enchant, no ids), a group (one slot for its members) or a collection
--- (its entries side by side, no ids); the behaviour fields are the
--- Cooldown Manager's Behaviour panel's.
export type PresetEntry = {
    name: string,
    ids?: number[],
    mine?: boolean,
    icon?: number,
    enchant?: string,
    collection?: boolean,
    entries?: PresetEntry[],
    group?: boolean,
    max?: number,
    fixedIcon?: boolean,
    members?: PresetMember[],
    when?: PresetWhen,
    -- behaviour
    ready?: string,
    pop?: boolean,
    sound?: string,
    onCooldown?: string,
    show?: string,
    unusable?: string,
    border?: string,
    effect?: string,
    effectName?: string,
    effectIDs?: number[],
    missing?: string,
    size?: string,
    glow?: boolean,
    digits?: boolean,
    stacks?: boolean,
    expiring?: number,
    soundAppear?: string,
    soundStack?: string,
    soundDrop?: string,
    hidden?: boolean,
    source?: string,
}

export type PresetLists = {
    essential: PresetEntry[],
    utility: PresetEntry[],
    buffs: PresetEntry[],
    debuffs: PresetEntry[],
    procs: PresetEntry[],
}

--- tree: the talent tree (1-3, left to right; 0 Unspecced)
export type CooldownPreset = { id: string, name: string, tree: number, lists: PresetLists }

const BUILD: { [string]: () -> CooldownPreset[] } = {
    DRUID = druid, HUNTER = hunter, MAGE = mage, PALADIN = paladin, PRIEST = priest,
    ROGUE = rogue, SHAMAN = shaman, WARLOCK = warlock, WARRIOR = warrior,
}

local _, classFile = UnitClass("player")
local build = BUILD[secret.known(classFile, "")]

--- Your class's presets; nil for a class without a file
export local cooldownPresets: CooldownPreset[]? = build and build() or nil
