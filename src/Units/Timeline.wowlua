-- Units/Timeline.wowlua
-- The encounter timeline (step 1.13): top centre, 28px down, now at the
-- left, the next 30 seconds to the right. It shows whatever the game's
-- encounter timeline holds (C_EncounterTimeline): boss abilities if the game
-- sends them (Forever has the feature off, 2026-10-12) and the timers addons
-- add to it, SuuUI's pull countdown first. Hidden while nothing is on it.
--
-- The pull countdown: "/suu pull [seconds]" (default 10; 0 cancels). It
-- rides the timeline as "Pull", counts down as an alert (out of combat too;
-- setting: the whole countdown, the last ten seconds or none) and says
-- "Pull!" at zero. Combat cancels it.
-- It is Blizzard's own countdown (C_PartyInfo.DoCountdown, the /countdown
-- one), which boss mods use too: a countdown anyone starts (SuuUI, a boss
-- mod, /countdown) shows here, and SuuUI's shows in theirs and, without
-- any addon, as Blizzard's numbers. While SuuUI's alert shows the countdown,
-- Blizzard's own numbers (TimerTracker) stay away. On a
-- client without it, SuuUI sends its own message to everyone with SuuUI.

import SuuUI from "/Core/API"
import type SelectOption from "/UI/Select"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type EncounterTimeline, TimelineEvent from "/UI/Timeline"
import type Position from "/EditMode/EditMode"
import after, every from "wowlua:timer"
import hook from "wowlua:hooks"
import isSecret from "wowlua:secret"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"

local isNumber = secret.isNumber

local UI = SuuUI.UI

local DEFAULTS = {
    position = { point = "TOP", x = 0, y = -28 } :: Position,
    variant = "track",   -- "track" | "list" | "off"
    pullSeconds = 10,
    pullAlert = "all",   -- "all" | "last10" | "off": the countdown as an alert
    pullVoice = "Bella", -- a voice in Media/Sounds/Countdown, or "off": the last ten seconds spoken
    source = "suui",     -- "suui" | "dbm" | "bigwigs": where boss timers come from
    hideTheirs = true,   -- with a boss mod as the source: its own bars (and DBM's warnings) hidden
    dbmWarningsWas = "", -- DBM's HideDBMWarnings before SuuUI set it ("" none)
}

local M: TimelineModule


local PREFIX = "SuuUI"
local PULL_SPELL, PULL_ICON = 100, 132337 -- Charge's spell and art
local ET = C_EncounterTimeline

-- A timer's badge (the design's).
type Badge = { tone: string, text: string }

-- The role and danger icons an ability carries (EncounterEventIconmask, one
-- bit per Enum.EncounterTimelineIconSet value), as the design's badges.
type IconBadge = { icon: string, tone: string, text: string }
local BADGES: IconBadge[] = {
    { icon = "TankAlert", tone = "warning", text = "Tank" }, { icon = "Deadly", tone = "danger", text = "Lethal" },
    { icon = "HealerAlert", tone = "info", text = "Healer" }, { icon = "Dispel", tone = "magic", text = "Dispel" },
    { icon = "Enrage", tone = "warning", text = "Enrage" },
}
local function badgeOf(mask: unknown): Badge?
    local set = tbl.field(Enum, "EncounterTimelineIconSet")
    if not isNumber(mask) or mask == 0 or not set then return nil end
    for _, b in ipairs(BADGES) do
        local v = tbl.field(set, b.icon)
        if isNumber(v) and bit.band(mask, bit.lshift(1, v)) ~= 0 then return { tone = b.tone, text = b.text } end
    end
    return nil
end

--------------------------------------------------------------------------------
-- The timeline's events
--------------------------------------------------------------------------------

local ACTIVE, PAUSED = 0, 1

--------------------------------------------------------------------------------
-- Boss mods as a source: DBM's timer callbacks, BigWigs' bar messages. Only
-- the ones loaded are offered; a source that's gone falls back to SuuUI.
--------------------------------------------------------------------------------

local function plain(v: unknown): v is string return not isSecret(v) and type(v) == "string" and v ~= "" end
local function iconOf(v: unknown): (number | string)?
    if isSecret(v) then return nil end
    return tonumber(v) or (type(v) == "string" and v ~= "" and v) or nil
end
-- a boss mod's own pull bar: SuuUI's countdown shows the pull already
local function isPull(text: unknown): boolean return plain(text) and text:lower():find("^pull") ~= nil end

-- A boss mod's function `key` of its global `name` (nil: not loaded).
local function addonFn(name: string, key: string): ((...unknown) -> ...unknown)?
    local fn = tbl.field(tbl.field(_G, name), key)
    if type(fn) == "function" then return fn :: (...unknown) -> ...unknown end
    return nil
end

-- DBM's options table, while DBM is loaded.
local function dbmOptions(): { [string]: unknown }?
    local options = tbl.field(tbl.field(_G, "DBM"), "Options")
    if type(options) == "table" then return options :: { [string]: unknown } end
    return nil
end

type Source = { label: string, loaded: () -> boolean }
local SOURCES: { [string]: Source } = {
    dbm = { label = "DBM", loaded = function(): boolean return addonFn("DBM", "RegisterCallback") ~= nil end },
    bigwigs = { label = "BigWigs", loaded = function(): boolean return addonFn("BigWigsLoader", "RegisterMessage") ~= nil end },
}

-- keep a frame invisible while its test says so (one hook per frame)
local hideTests: { [Frame]: () -> boolean } = {}
local hideHooked: { [Frame]: boolean } = {}
setmetatable(hideTests, { __mode = "k" })
setmetatable(hideHooked, { __mode = "k" })
local function keepHidden(frame: Frame?, test: () -> boolean)
    if not frame then return end
    hideTests[frame] = test
    if not hideHooked[frame] then
        hideHooked[frame] = true
        hook(frame, "SetAlpha", function(f, a)
            local hidden = hideTests[f]
            if not issecretvalue(a) and a > 0 and hidden and hidden() then f:SetAlpha(0) end
        end)
    end
    if test() then frame:SetAlpha(0) end
end

-- DBM's timer types (colorId): 4 interrupt, 5 role (tank).
local DBM_BADGE: { [number]: Badge } = { [4] = { tone = "info", text = "Kick" }, [5] = { tone = "warning", text = "Tank" } }

--------------------------------------------------------------------------------
-- The countdown voice: the last ten seconds and "Pull!" spoken
-- (Media/Sounds/Countdown: SuuUI's own, generated with Kokoro-82M, Apache-2.0
-- weights, see its license.txt and tools/gen_countdown_voice.py). Addon
-- sound files play on Forever (game-data paths don't). Quiet while a boss
-- mod feeds the timeline: it counts out loud itself then.
--------------------------------------------------------------------------------

local VOICES: { [string]: boolean } = { Heart = true, Bella = true, Michael = true }
local VOICE_PATH = "Interface\\AddOns\\SuuUI\\Media\\Sounds\\Countdown\\%s\\%s.ogg"

-- Who may start one for the group: the leader or an assistant (anyone in a
-- party without a leader flag).
local function canLead(): boolean
    if not secret.flag(IsInGroup()) then return true end
    if secret.flag(UnitIsGroupLeader("player")) or secret.flag(UnitIsGroupAssistant("player")) then return true end
    return not secret.flag(IsInRaid())
end

local function blizzardCountdown(): ((seconds: number) -> ())?
    return C_PartyInfo and C_PartyInfo.DoCountdown
end

--------------------------------------------------------------------------------
-- A test: four abilities and one past the window, on the real timeline
--------------------------------------------------------------------------------

type TestAbility = { spell: number, icon: number, seconds: number, name: string, badge?: Badge }
local TEST: TestAbility[] = {
    { spell = 871, icon = 132362, seconds = 4, name = "Shield Wall", badge = { tone = "warning", text = "Tank" } },
    { spell = 122, icon = 135848, seconds = 11, name = "Frost Nova" },
    { spell = 5740, icon = 136186, seconds = 19, name = "Rain of Fire", badge = { tone = "info", text = "Spread" } },
    { spell = 6789, icon = 136145, seconds = 26, name = "Death Coil", badge = { tone = "danger", text = "Lethal" } },
    { spell = 1680, icon = 132369, seconds = 44, name = "Whirlwind" },
}

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

local SECTION: SettingsSection = {
    id = "timeline", label = "Timeline", category = "Insights", order = 30,
    preview = function(parent: Frame): Frame return M:PreviewView(parent) end,
    groups = {
        { title = "Encounter timeline", description = "What's coming, riding toward now: boss abilities when the game sends them (Forever doesn't yet) and SuuUI's pull countdown. Hidden while nothing is on it.", rows = {
            { key = "variant", label = "Show", control = "segmented", stacked = true,
              options = { { value = "track", label = "Timeline" }, { value = "list", label = "List" }, { value = "off", label = "Off" } },
              description = "Timeline: a line across the top of the screen, the next 30 seconds. List: the older panel, soonest first." },
            { label = "Try it", control = "button", text = "Show a test timeline",
              description = "Five abilities on the real timeline, the last one past its 30 seconds.",
              onClick = function() M:Test() end },
        } },
        { title = "Boss timers", rows = {
            { key = "source", label = "From", control = "segmented", stacked = true,
              options = { { value = "suui", label = "SuuUI" } },
              description = function()
                  local missing: string[] = {}
                  for _, key in ipairs({ "dbm", "bigwigs" }) do
                      local source = assert(SOURCES[key])
                      if not source.loaded() then missing[#missing + 1] = source.label end
                  end
                  local text = "SuuUI: the game's own timeline (Forever sends no boss data yet) and SuuUI's timers. A boss mod: its boss timers ride the timeline, SuuUI's pull countdown too; you can turn its own bars off in its settings."
                  if #missing > 0 then text = text .. " Install " .. table.concat(missing, " or ") .. " to use " .. (#missing > 1 and "theirs" or "its") .. "." end
                  return text
              end },
            { key = "hideTheirs", label = "Hide their bars", control = "toggle",
              disabled = function() return M:Get("source") == "suui", "Choose DBM or BigWigs first." end,
              description = "While a boss mod feeds the timeline, its own timer bars stay hidden; DBM's warnings too (its \"Hide DBM warnings\" option, given back when you switch). BigWigs' messages can't be hidden from outside: turn them off in BigWigs if you like." },
        } },
        { title = "Pull countdown", description = "/suu pull starts it (/suu pull 15 for 15 seconds, /suu pull 0 cancels). It is the game's own countdown, the one DBM and BigWigs use: in a group, the leader's or an assistant's reaches everyone (their boss mods show it, players without addons see the game's numbers), and theirs shows here. Combat ends it.", rows = {
            { key = "pullSeconds", label = "Length", control = "slider", min = 5, max = 30, step = 1, unit = "s" },
            { key = "pullAlert", label = "Alert", control = "segmented", stacked = true,
              options = { { value = "all", label = "Whole countdown" }, { value = "last10", label = "Last 10 seconds" }, { value = "off", label = "Off" } },
              description = "The countdown in the middle of the screen, then \"Pull!\". Off: only on the timeline." },
            { key = "pullVoice", label = "Voice", control = "segmented",
              options = { { value = "Bella", label = "Bella" }, { value = "Heart", label = "Heart" }, { value = "Michael", label = "Michael" },
                          { value = "off", label = "Off" } }, stacked = true,
              description = "The last ten seconds and \"Pull!\" spoken. Quiet while DBM or BigWigs feeds the timeline (Boss timers): it counts out loud itself then." },
            { label = "Listen", control = "button", text = "Hear the voice",
              disabled = function() return M:Get("pullVoice") == "off", "Choose a voice first." end,
              onClick = function()
                  local voice = M:Get("pullVoice")
                  for i, n in ipairs({ "3", "2", "1", "pull" }) do after(i - 1, function() M:Speak(n, voice) end) end
              end },
            { label = "Start one", control = "button", text = "Start a pull countdown",
              onClick = function() M:Pull() end },
        } },
    },
}

-- A countdown kept for /reload (SuuUIProbe.countdown): what the client sent.
type CountdownProbe = { at: number, args: string[] }

class TimelineModule extends Module<typeof(DEFAULTS)>
    -- the boss mod's timers, by its own id
    addonTimers: { [string]: TimelineEvent } = {}
    -- a countdown asked of the game, its event awaited
    awaiting: table? = nil
    -- SuuUI's own timers' badges and names, by the timeline's id
    badges: { [number]: Badge } = {}
    labels: { [number]: string } = {}
    hooked: boolean? = nil
    -- the boss mods' displays hooked: DBM's bars, LibCandyBar's
    hookedParts: { dbt?: boolean, candy?: boolean } = {}
    preview: EncounterTimeline? = nil
    pullEnds: number? = nil
    pullID: number? = nil
    pullTicker: TickerHandle? = nil
    refreshToken: table? = nil
    timeline: EncounterTimeline? = nil
    trackerOff: boolean? = nil
    voiceToken: table? = nil

    constructor()
        super({
            id = "timeline",
            name = "Encounter timeline",
            description = "Upcoming boss abilities and SuuUI's pull countdown riding toward now, top centre.",
            api = "0.10",
            combatSafe = true,
            defaults = DEFAULTS,
        })
    end

    function SourceOptions(): SelectOption<string>[]
        local opts: SelectOption<string>[] = { { value = "suui", label = "SuuUI" } }
        for _, key in ipairs({ "dbm", "bigwigs" }) do
            local source = assert(SOURCES[key])
            if source.loaded() then opts[#opts + 1] = { value = key, label = source.label } end
        end
        return opts
    end

    -- The boss mod's timers, by its own id: { label, icon, badge, endsAt or paused }
    function AddonTimer(source: string, id: unknown, text: unknown, seconds: unknown, icon: unknown, badge: Badge?)
        if self:Get("source") ~= source or not isNumber(seconds) or seconds <= 0 or isPull(text) then return end
        local key = tostring(id)
        self.addonTimers[key] = { id = "addon:" .. key, label = plain(text) and text or "", icon = iconOf(icon),
                                  badge = badge, endsAt = GetTime() + seconds }
        self:Refresh()
    end

    function AddonTimerStop(source: string, id: unknown)
        if self:Get("source") ~= source then return end
        if id == nil then self.addonTimers = {} else self.addonTimers[tostring(id)] = nil end
        self:Refresh()
    end

    function AddonTimerPause(source: string, id: unknown, paused: boolean)
        local t = self:Get("source") == source and self.addonTimers[tostring(id)] or nil
        if not t then return end
        local endsAt, pausedLeft = t.endsAt, t.paused
        if paused and endsAt then
            t.paused, t.endsAt = math.max(0, endsAt - GetTime()), nil
        elseif not paused and pausedLeft then
            t.endsAt, t.paused = GetTime() + pausedLeft, nil
        end
        self:Refresh()
    end

    --------------------------------------------------------------------------------
    -- Their own display, hidden while they feed the timeline (setting).
    -- DBM: its HideDBMWarnings option (warnings and announces; kept and handed
    -- back), and each bar DBT makes kept at alpha 0 (its HideDBMBars would stop
    -- the timers themselves, callbacks included). BigWigs: each LibCandyBar bar
    -- it starts kept at alpha 0. BigWigs' messages have no way in from outside.
    --------------------------------------------------------------------------------

    function Suppressing(source: string): boolean
        return self:IsEnabled() and self:Get("hideTheirs") and self:Get("source") == source
    end

    function ApplySuppression()
        -- DBM's warnings: on while DBM feeds the timeline, your own setting back otherwise
        local options = dbmOptions()
        if options then
            local want = self:Suppressing("dbm")
            local was = self:Get("dbmWarningsWas")
            if want and was == "" then
                self:Set("dbmWarningsWas", options.HideDBMWarnings and "true" or "false")
                options.HideDBMWarnings = true
            elseif not want and was ~= "" then
                options.HideDBMWarnings = was == "true"
                self:Set("dbmWarningsWas", "")
            end
        end
    end

    -- Each part once, as soon as its library is there (BigWigs loads its
    -- plugins, LibCandyBar with them, on demand: tried again on ADDON_LOADED).
    function HookDisplays()
        local hooked = self.hookedParts
        -- DBM's bars
        local dbt = tbl.field(_G, "DBT")
        local create = addonFn("DBT", "CreateBar")
        if not hooked.dbt and type(dbt) == "table" and create then
            hooked.dbt = true
            ;(dbt :: { [string]: unknown }).CreateBar = function(bars: unknown, ...: unknown): unknown
                local bar = create(bars, ...)
                if type(bar) == "table" then
                    keepHidden(frames.asFrame(tbl.field(bar, "frame")), function(): boolean return M:Suppressing("dbm") end)
                end
                return bar
            end
        end
        -- BigWigs' bars (LibCandyBar, shared: only bars BigWigs tags as its own)
        local libStub = tbl.field(_G, "LibStub")
        local candy: unknown = nil
        -- (LibStub is a table one calls)
        if not hooked.candy and libStub then
            local ok: boolean, lib: unknown = pcall(libStub :: (major: string, silent: boolean) -> unknown, "LibCandyBar-3.0", true)
            if ok then candy = lib end
        end
        local proto = tbl.field(candy, "barPrototype")
        if type(proto) == "table" and tbl.field(proto, "Start") then
            hooked.candy = true
            hook(proto, "Start", function(bar: unknown)
                local get = tbl.field(bar, "Get")
                local frame = frames.asFrame(bar)
                if type(get) == "function" and (get :: (bar: unknown, key: string) -> unknown)(bar, "bigwigs:module") ~= nil then
                    keepHidden(frame, function(): boolean return M:Suppressing("bigwigs") end)
                elseif frame then
                    -- the pool is shared: another addon's bar shows as it likes
                    hideTests[frame] = nil
                end
            end)
        end
    end

    function HookSources()
        if self.hooked then return end
        self.hooked = true
        local register = addonFn("DBM", "RegisterCallback")
        if register then
            local dbm = tbl.field(_G, "DBM")
            local function on(event: string, fn: (...unknown) -> ()) pcall(register, dbm, event, fn) end
            on("DBM_TimerBegin", function(_: unknown, id: unknown, msg: unknown, timer: unknown, icon: unknown, _: unknown, _: unknown, colorId: unknown)
                self:AddonTimer("dbm", id, msg, timer, icon, isNumber(colorId) and DBM_BADGE[colorId] or nil)
            end)
            on("DBM_TimerStop", function(_: unknown, id: unknown) self:AddonTimerStop("dbm", id) end)
            on("DBM_TimerPause", function(_: unknown, id: unknown) self:AddonTimerPause("dbm", id, true) end)
            on("DBM_TimerResume", function(_: unknown, id: unknown) self:AddonTimerPause("dbm", id, false) end)
            on("DBM_TimerUpdate", function(_: unknown, id: unknown, elapsed: unknown, total: unknown)
                local t = self:Get("source") == "dbm" and self.addonTimers[tostring(id)] or nil
                if t and isNumber(elapsed) and isNumber(total) then
                    t.endsAt, t.paused = GetTime() + math.max(0, total - elapsed), nil
                    self:Refresh()
                end
            end)
        end
        local reg = addonFn("BigWigsLoader", "RegisterMessage")
        if reg then
            -- BigWigs keys its bars by module and text
            local owner = {}
            local function key(module: unknown, text: unknown): string return tostring(module) .. "\31" .. (plain(text) and text or "?") end
            local function on(message: string, fn: (...unknown) -> ()) pcall(reg, owner, message, fn) end
            on("BigWigs_StartBar", function(_: unknown, module: unknown, _: unknown, text: unknown, time: unknown, icon: unknown)
                self:AddonTimer("bigwigs", key(module, text), text, time, icon)
            end)
            on("BigWigs_StopBar", function(_: unknown, module: unknown, text: unknown) self:AddonTimerStop("bigwigs", key(module, text)) end)
            on("BigWigs_StopBars", function() self:AddonTimerStop("bigwigs", nil) end)
            on("BigWigs_PauseBar", function(_: unknown, module: unknown, text: unknown) self:AddonTimerPause("bigwigs", key(module, text), true) end)
            on("BigWigs_ResumeBar", function(_: unknown, module: unknown, text: unknown) self:AddonTimerPause("bigwigs", key(module, text), false) end)
        end
    end

    -- Everything on the timeline, as the component's list: the game's timeline
    -- (with a boss mod as the source, only SuuUI's own timers from it: the pull)
    -- and the chosen boss mod's timers. One whose time is secret can't be
    -- placed, so it's left out.
    function Read(): TimelineEvent[]
        local list: TimelineEvent[] = {}
        local now = GetTime()
        local source = self:Get("source")
        if source ~= "suui" then
            for id, t in pairs(self.addonTimers) do
                local endsAt = t.endsAt
                if t.paused or (endsAt and endsAt > now) then list[#list + 1] = t else self.addonTimers[id] = nil end
            end
        end
        if not ET then return list end
        local ok, ids = pcall(ET.GetEventList)
        if not ok or type(ids) ~= "table" then return list end
        local script = tbl.field(tbl.field(Enum, "EncounterTimelineEventSource"), "Script")
        local SCRIPT: number? = isNumber(script) and script or nil
        for _, id in ipairs(ids) do
            local okS: boolean, state: unknown = pcall(ET.GetEventState, id)
            local okR: boolean, left: unknown = pcall(ET.GetEventTimeRemaining, id)
            local okI, info = pcall(ET.GetEventInfo, id)
            if okS and okR and okI and isNumber(state) and (state == ACTIVE or state == PAUSED) and isNumber(left)
               and (left > 0 or state == PAUSED) and type(info) == "table"
               and (source == "suui" or not isNumber(info.source) or info.source == SCRIPT) then
                local label: string? = nil
                if not isSecret(info.spellName) and type(info.spellName) == "string" then label = info.spellName end
                local icon = info.iconFileID
                local e: TimelineEvent = { id = id, label = self.labels[id] or label or "", icon = isNumber(icon) and icon or nil,
                            badge = self.badges[id] or badgeOf(info.icons) }
                if state == PAUSED then e.paused = left else e.endsAt = now + left end
                list[#list + 1] = e
            end
        end
        return list
    end

    function Refresh()
        local timeline = self.timeline
        if not timeline then return end
        local variant = self:Get("variant")
        local events = self:Read()
        local shown = variant ~= "off" and not self:Get("position").hidden and #events > 0
        if shown then
            timeline:SetVariant(variant)
            timeline:SetEvents(events)
        else
            timeline:SetEvents({})
        end
        timeline:SetShown(shown and true or false)
        -- read again when the soonest one runs out (it leaves the timeline)
        local soonest: number? = nil
        for _, e in ipairs(events) do
            local endsAt = e.endsAt
            if endsAt and (not soonest or endsAt < soonest) then soonest = endsAt end
        end
        if soonest then
            local token = {}
            self.refreshToken = token
            after(math.max(0.05, soonest - GetTime() + 0.05), function()
                if self.refreshToken == token and self:IsEnabled() then self:Refresh() end
            end)
        end
    end

    -- n: "1"-"10", or "pull"
    function Speak(n: number | string, voice: string?)
        local v = voice or self:Get("pullVoice")
        if not VOICES[v] then return end
        local count = tonumber(n)
        if n ~= "pull" and (not count or count < 1 or count > 10) then return end
        pcall(PlaySoundFile, VOICE_PATH:format(v, tostring(n)), "Master")
    end

    -- Each of the last ten seconds on the second, then "Pull!".
    function ScheduleVoice(seconds: number, token: table)
        local voice = self:Get("pullVoice")
        if not VOICES[voice] or self:Get("source") ~= "suui" then return end
        for n = math.min(10, math.floor(seconds)), 1, -1 do
            after(seconds - n, function()
                if self.voiceToken == token then self:Speak(n, voice) end
            end)
        end
        after(seconds, function()
            if self.voiceToken == token then self:Speak("pull", voice) end
        end)
    end

    function CancelPull(quiet: boolean?)
        self.voiceToken = nil
        local id = self.pullID
        if id and ET then pcall(ET.CancelScriptEvent, id) end
        self.pullID = nil
        self.pullEnds = nil
        local ticker = self.pullTicker
        if ticker then ticker:Cancel(); self.pullTicker = nil end
        SuuUI.HideAlert("pull")
        if not quiet then self:Refresh() end
    end

    function StartPull(given: unknown, from: string?)
        self:CancelPull(true)
        local seconds = math.floor(tonumber(given) or 0)
        if seconds <= 0 then
            self:Refresh()
            return
        end
        seconds = math.min(seconds, 60)
        if ET and ET.AddScriptEvent then
            local ok, id = pcall(ET.AddScriptEvent, { spellID = PULL_SPELL, iconFileID = PULL_ICON, duration = seconds, overrideName = "Pull" })
            if ok and isNumber(id) then
                self.pullID = id
                self.labels[id] = "Pull"
            end
        end
        local endsAt = GetTime() + seconds
        self.pullEnds = endsAt
        local token = {}
        self.voiceToken = token
        self:ScheduleVoice(seconds, token)
        local detail = from and ("from " .. from) or nil
        -- the countdown as an alert (all of it, or the last ten seconds), then "Pull!"
        local mode = self:Get("pullAlert")
        local function tick()
            local left = endsAt - GetTime()
            if left <= 0 then
                if mode ~= "off" then
                    SuuUI.ShowAlert("pull", "info", "Pull!", detail)
                    after(1.5, function() SuuUI.HideAlert("pull") end)
                end
                local ticker = self.pullTicker
                if ticker then ticker:Cancel() end
                self.pullTicker = nil
                self.pullID = nil
                self.pullEnds = nil
            elseif mode == "all" or (mode == "last10" and left <= 10) then
                SuuUI.ShowAlert("pull", "info", ("Pull in %d"):format(math.ceil(left)), detail)
            end
        end
        self.pullTicker = every(0.25, tick)
        tick()
        self:Refresh()
    end

    function Pull(arg: unknown?)
        local seconds = math.floor(tonumber(arg) or self:Get("pullSeconds"))
        if secret.flag(IsInGroup()) and not canLead() then
            self:Print("Only the leader or an assistant can start a pull countdown in a raid.")
            return
        end
        -- Blizzard's countdown: everyone's START_PLAYER_COUNTDOWN (ours too) starts it
        local doCountdown = blizzardCountdown()
        if doCountdown then
            -- armed before the call: the client fires START_PLAYER_COUNTDOWN inside
            -- it, before it returns (2026-10-12); without that event, ours anyway
            local token = {}
            self.awaiting = token
            if pcall(doCountdown, math.max(0, seconds)) then
                if seconds <= 0 then self.awaiting = nil; self:CancelPull() return end
                after(0.5, function()
                    if self.awaiting == token then
                        self.awaiting = nil
                        if not self.pullEnds then self:StartPull(seconds) end
                    end
                end)
                return
            end
            self.awaiting = nil
        end
        if secret.flag(IsInGroup()) then
            local channel = secret.flag(IsInRaid()) and "RAID" or "PARTY"
            pcall(C_ChatInfo.SendAddonMessage, PREFIX, ("PULL\t%d"):format(seconds), channel)
        end
        self:StartPull(seconds)
    end

    -- Blizzard's countdown started or cancelled (by anyone: SuuUI, DBM,
    -- BigWigs, /countdown).
    function OnCountdown(guid: unknown, seconds: unknown, ...: unknown)
        -- what the client sends (kept for /reload: SuuUIProbe.countdown)
        local probe = tbl.field(_G, "SuuUIProbe")
        if type(probe) ~= "table" then
            probe = {}
            rawset(_G, "SuuUIProbe", probe)
        end
        local saved = probe :: { countdown?: CountdownProbe[] }
        local kept = saved.countdown or {}
        saved.countdown = kept
        local args = { guid, seconds, ... }
        local shown: string[] = {}
        for i = 1, select("#", ...) + 2 do
            local v = args[i]
            shown[i] = isSecret(v) and "secret" or tostring(v)
        end
        table.insert(kept, { at = GetTime(), args = shown })
        while #kept > 12 do table.remove(kept, 1) end
        -- ours arrived (or anyone's): no fallback start
        self.awaiting = nil
        if isSecret(guid) or isSecret(seconds) or not isNumber(seconds) then return end
        if InCombatLockdown() then return end
        -- the same countdown again (the event can come more than once): keep it
        local ends = self.pullEnds
        if ends and math.abs(GetTime() + seconds - ends) < 1.5 then return end
        local from: string? = nil
        if type(guid) == "string" and guid ~= (UnitGUID("player") :: string?) and GetPlayerInfoByGUID then
            local ok, _, _, _, _, _, name = pcall(GetPlayerInfoByGUID, guid)
            if ok and not isSecret(name) and type(name) == "string" then from = name end
        end
        self:StartPull(seconds, from)
    end

    -- Blizzard's big countdown numbers, kept away while SuuUI's alert counts.
    function BlizzardNumbers(show: boolean)
        local tracker = frames.find("TimerTracker")
        if not tracker then return end
        if show then
            if self.trackerOff then
                pcall(tracker.RegisterEvent, tracker, "START_PLAYER_COUNTDOWN")
                pcall(tracker.RegisterEvent, tracker, "CANCEL_PLAYER_COUNTDOWN")
                self.trackerOff = nil
            end
        elseif not self.trackerOff then
            pcall(tracker.UnregisterEvent, tracker, "START_PLAYER_COUNTDOWN")
            pcall(tracker.UnregisterEvent, tracker, "CANCEL_PLAYER_COUNTDOWN")
            self.trackerOff = true
        end
    end

    function OnMessage(prefix: unknown, text: unknown, _: unknown, sender: unknown)
        if prefix ~= PREFIX or type(text) ~= "string" or isSecret(text) then return end
        local seconds = text:match("^PULL\t(%-?%d+)$")
        if not seconds then return end
        if isSecret(sender) or type(sender) ~= "string" then return end
        -- our own message comes back: already started
        local me = Ambiguate(SuuUI.FullName("player") :: string, "short")
        if Ambiguate(sender, "short") == me then return end
        self:StartPull(tonumber(seconds), Ambiguate(sender, "short"))
    end

    function Test()
        if not (ET and ET.AddScriptEvent) then
            self:Print("This client has no encounter timeline.")
            return
        end
        for _, t in ipairs(TEST) do
            local ok, id = pcall(ET.AddScriptEvent, { spellID = t.spell, iconFileID = t.icon, duration = t.seconds, overrideName = t.name })
            if ok and isNumber(id) then
                self.labels[id] = t.name
                self.badges[id] = t.badge
            end
        end
        self:Refresh()
    end

    function PreviewView(parent: Frame): EncounterTimeline
        local p = self.preview or UI.EncounterTimeline(parent, { variant = "track" })
        self.preview = p
        p:SetParent(parent)
        local variant = self:Get("variant")
        p:SetVariant(variant == "list" and "list" or "track")
        local list: TimelineEvent[] = {}
        for i, t in ipairs(TEST) do list[i] = { id = -i, label = t.name, icon = t.icon, badge = t.badge, paused = t.seconds } end
        p:SetEvents(list)
        p:SetMeta("Ashmaw the Devourer")
        return p
    end

    override function OnEnable()
        -- the boss mods loaded now; a chosen one that's gone: back to SuuUI
        local options = self:SourceOptions()
        local available: { [string]: boolean } = {}
        for _, o in ipairs(options) do if o.value then available[o.value] = true end end
        if not available[self:Get("source")] then self:Set("source", "suui") end
        for _, g in ipairs(SECTION.groups or {}) do
            for _, row in ipairs(g.rows) do
                if row.key == "source" then row.options = options end
            end
        end
        self:HookSources()
        self:HookDisplays()
        self:ApplySuppression()
        self:OnGameEvent("ADDON_LOADED", function() self:HookDisplays() end)
        local timeline = self.timeline
        if not timeline then
            timeline = UI.EncounterTimeline(SuuUI.Root, { variant = self:Get("variant") == "list" and "list" or "track" })
            timeline:SetFrameStrata("MEDIUM")
            timeline:Hide()
            self.timeline = timeline
        end
        self:RegisterMover(timeline, { key = "position", label = "Encounter timeline", managedShow = true,
            enabled = function() return self:Get("variant") ~= "off" end })
        -- "encounterTimeline": its place, for what shares the top edge with it
        -- (your buffs stop short of it)
        local function publish()
            local on = self:Get("variant") ~= "off" and not self:Get("position").hidden
            SuuUI.PublishAnchor("encounterTimeline", on and timeline or nil)
        end
        publish()
        self:RegisterSettings(SECTION)
        self:RegisterCommand("pull", "Start a pull countdown: /suu pull [seconds] (0 cancels).", function(arg: string) self:Pull(arg) end)
        SuuUI.AllowAlertOutOfCombat("pull")
        if C_ChatInfo and C_ChatInfo.RegisterAddonMessagePrefix then C_ChatInfo.RegisterAddonMessagePrefix(PREFIX) end
        self:OnGameEvent("CHAT_MSG_ADDON", function(_, ...) self:OnMessage(...) end)
        for _, e in ipairs({ "ENCOUNTER_TIMELINE_EVENT_ADDED", "ENCOUNTER_TIMELINE_EVENT_REMOVED", "ENCOUNTER_TIMELINE_EVENT_STATE_CHANGED",
                             "ENCOUNTER_TIMELINE_EVENT_TRACK_CHANGED", "ENCOUNTER_TIMELINE_STATE_UPDATED" }) do
            self:OnGameEvent(e, function() self:Refresh() end)
        end
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function() if self.pullTicker then self:CancelPull() end end)
        self:OnGameEvent("START_PLAYER_COUNTDOWN", function(_, ...) self:OnCountdown(...) end)
        self:OnGameEvent("CANCEL_PLAYER_COUNTDOWN", function() self:CancelPull() end)
        self:BlizzardNumbers(self:Get("pullAlert") == "off")
        self:Watch("pullAlert", function() self:BlizzardNumbers(self:Get("pullAlert") == "off") end)
        self:Watch("source", function() self.addonTimers = {}; self:ApplySuppression(); self:Refresh() end)
        self:Watch("hideTheirs", function() self:ApplySuppression() end)
        self:WatchAll({ "variant", "position" }, function()
            publish()
            self:Refresh()
            SuuUI.EditMode.Refresh()
            local preview = self.preview
            if preview and preview:IsVisible() then self:PreviewView(assert(preview:GetParent())) end
        end)
        self:Refresh()
    end

    override function OnDisable()
        self:BlizzardNumbers(true)
        -- DBM's own setting back (Suppressing is false once disabled)
        local options = dbmOptions()
        if options and self:Get("dbmWarningsWas") ~= "" then
            options.HideDBMWarnings = self:Get("dbmWarningsWas") == "true"
            self:Set("dbmWarningsWas", "")
        end
        self:CancelPull(true)
        local timeline = self.timeline
        if timeline then timeline:Hide() end
    end
end

M = SuuUI.AddModule(TimelineModule.new())

-- The first voices (borrowed for a day) gave way to SuuUI's own.
M:Migrate("pullVoice-kokoro-3", function(values: { [string]: unknown })
    local v = values.pullVoice
    if v == "David" or v == "Male" or v == "Fenrir" or v == "Puck" then values.pullVoice = "Michael"
    elseif v == "Jim" or v == "Female" then values.pullVoice = "Bella" end
end)

-- "Last 5 seconds" became "Last 10 seconds".
M:Migrate("pullAlert-last10", function(values: { [string]: unknown })
    if values.pullAlert == "last5" then values.pullAlert = "last10" end
end)
