-- Units/Merchant.wowlua
-- SuuUI's own merchant window (plan 3.6, design component MerchantWindow):
-- the game's MerchantFrame stays open (it drives the conversation) but out of
-- sight, and this window shows the goods as one scrolling list with a
-- search, buys any number of items in the merchant's stack sizes, shows how
-- many you have and what you already know, buys back, repairs and sells
-- junk. None of it is protected (/suu probe windows, 2026-10-16).
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SuuButton from "/UI/Controls"
import type TextField from "/UI/Inputs"
import type Money from "/UI/Inventory"
import ItemSlot from "/UI/Inventory"
import type ScrollArea, WindowFrame, Panel from "/UI/Panel"
import type Select, SelectOption from "/UI/Select"
import type Text from "/UI/Text"
import after, every from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import asFrame, named, part from "/UI/Reskin"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {}

local isSecret = secret.isSecret
-- a value that is there and not secret (narrows: no longer nil or Secret)
type Plain = string | number | boolean | table
local function plain(v: unknown): v is Plain return v ~= nil and not isSecret(v) end
-- One of the game's functions, if it has it: every value it returns, as it
-- comes (read each with `str` or `num`; the junk's price is GetItemInfo's
-- eleventh), nothing when it fails.
local function okThen(ok: boolean, ...: unknown): ...unknown
    if ok then return ... end
    return nil
end
local function call(fn: unknown, ...: unknown): ...unknown
    if type(fn) ~= "function" then return nil end
    return okThen(pcall(fn :: (...unknown) -> ...unknown, ...))
end
local function str(v: unknown): string? if plain(v) and type(v) == "string" then return v end return nil end
local function num(v: unknown): number? if plain(v) and type(v) == "number" then return v end return nil end
-- a texture: a file ID or a path
local function art(v: unknown): (number | string)? return num(v) or str(v) end

local WIDTH, HEIGHT = 440, 600
local ROW_H = 46
local QUALITY: { [number]: string } = { [0] = "poor", "common", "uncommon", "rare", "epic", "legendary", "legendary", "legendary" }
local HIGH_PRICE = 1500000 -- 150g: the game asks before a purchase this dear

-- "1g 20s" in the coin colours, zero coins at the end left out.
local function coins(given: number?): string
    local copper = math.max(0, math.floor(given or 0))
    local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local parts: string[] = {}
    local function add(v: number, unit: string, hex: string) parts[#parts + 1] = v .. "|cff" .. hex .. unit .. "|r" end
    if g > 0 then add(g, "g", T.color["coin-gold"].hex) end
    if s > 0 or (g > 0 and c > 0) then add(s, "s", T.color["coin-silver"].hex) end
    if c > 0 or #parts == 0 then add(c, "c", T.color["coin-copper"].hex) end
    return table.concat(parts, " ")
end

local function icon(texture: (number | string)?): string return texture and ("|T" .. texture .. ":12:12:0:0|t") or "" end

--------------------------------------------------------------------------------
-- The goods
--------------------------------------------------------------------------------

-- "Already known" in the item's tooltip: a recipe, pet or mount you have.
local function isKnown(index: number): boolean
    local data = C_TooltipInfo and call(C_TooltipInfo.GetMerchantItem, index)
    local lines = part(data, "lines")
    if type(lines) ~= "table" then return false end
    for _, line in ipairs(lines :: unknown[]) do
        local text = part(line, "leftText")
        if plain(text) and text == ITEM_SPELL_KNOWN then return true end
    end
    return false
end

-- How many of an item (or currency) you have.
local function haveOf(link: string?, isCurrency: boolean?): number
    if not link then return 0 end
    if isCurrency then
        local info = C_CurrencyInfo and call(C_CurrencyInfo.GetCurrencyInfoFromLink, link)
        return num(part(info, "quantity")) or 0
    end
    return num(call(C_Item.GetItemCount, link, true, false, true)) or 0
end

-- A merchant item's other cost: an item or a currency.
type Cost = { texture?: number | string, value: number, link?: string, currency: boolean, name?: string }

-- One merchant item as the list shows it.
type Entry = {
    index: number, name: string, texture?: number | string, link?: string, quality: string,
    price: number, stack: number, stock: number, usable: boolean, purchasable: boolean,
    maxStack: number, costs: Cost[], have: number, known: boolean,
}

-- How many purchases you can make of an item, and why not more (nil: no cap
-- but the merchant's own).
local function purchaseCap(e: Entry): (number, string?)
    local cap: number, why: string? = math.huge, nil
    if e.stock >= 0 then cap, why = e.stock, "left" end
    if e.price > 0 then
        local afford = math.floor((GetMoney() or 0) / e.price)
        if afford < cap then cap, why = afford, "afford" end
    end
    for _, c in ipairs(e.costs) do
        local afford = math.floor(haveOf(c.link, c.currency) / c.value)
        if afford < cap then cap, why = afford, "afford" end
    end
    return cap, why
end

-- What a quantity (in items) really buys: whole purchases of the stack size,
-- capped. Returns purchases, items, and a note for the row.
local function plan(e: Entry, given: number?): (number, number, string?)
    local qty = math.max(1, math.floor(given or e.stack))
    local purchases = math.ceil(qty / e.stack)
    local cap, why = purchaseCap(e)
    local note: string? = nil
    if purchases > cap then
        purchases = math.max(0, cap)
        note = why == "left" and "Capped at what's left" or ("Capped: you can afford " .. purchases)
    end
    local items = purchases * e.stack
    if not note and e.stack > 1 and purchases > 1 then
        note = ("= %d purchases%s"):format(purchases, items ~= qty and (", " .. items .. " items") or "")
    elseif not note and e.stack > 1 and items ~= qty then
        note = ("= %d items"):format(items)
    end
    return purchases, items, note
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

-- A row's item: its tooltip (a merchant's item or one to buy back), a
-- click links it.
export class MerchantSlot extends ItemSlot
    index: number? = nil
    buyback: boolean = false
    link: string? = nil

    constructor(parent: Frame)
        super(parent, nil)
        self:SetScript("OnEnter", function()
            local index = self.index
            if not index then return end
            GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
            if self.buyback then GameTooltip:SetBuybackItem(index) else GameTooltip:SetMerchantItem(index) end
            GameTooltip:Show()
        end)
        self:SetScript("OnLeave", function() GameTooltip:Hide() end)
        self:SetScript("OnClick", function()
            local link = self.link
            if link then HandleModifiedItemClick(link) end
        end)
    end
end

-- A row: the item, its name, price and status; a quantity and Buy.
export class MerchantRow extends Frame
    readonly rule: Texture
    readonly slot: MerchantSlot
    -- red over what you can't use or buy
    readonly tint: Texture
    readonly buy: SuuButton
    readonly qty: TextField
    readonly name: Text
    readonly money: Money
    readonly costs: Text
    readonly status: Text
    entry: Entry? = nil
    -- the item the quantity was typed for
    qtyFor: string? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(ROW_H)
        self.rule = UI.Fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetPoint("BOTTOMLEFT")
        self.rule:SetPoint("BOTTOMRIGHT")
        self.rule:SetHeight(1)
        self.slot = MerchantSlot.new(self)
        self.slot:SetPoint("LEFT", 0, 0)
        self.tint = self.slot:CreateTexture(nil, "OVERLAY")
        self.tint:SetPoint("TOPLEFT", 1, -1)
        self.tint:SetPoint("BOTTOMRIGHT", -1, 1)
        self.tint:SetColorTexture(0.9, 0, 0, 0.45)
        self.buy = UI.Button(self, { text = "Buy", width = 64 })
        self.buy:SetPoint("RIGHT", 0, 0)
        self.qty = UI.TextField(self, { width = 52 })
        self.qty:SetPoint("RIGHT", self.buy, "LEFT", -S["space-2"], 0)
        self.qty.edit:SetNumeric(true)
        self.qty.edit:SetMaxLetters(4)
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.slot, "TOPRIGHT", S["space-4"], 1)
        self.name:SetPoint("RIGHT", self.qty, "LEFT", -S["space-4"], 0)
        self.name:SetWordWrap(false)
        self.money = UI.Money(self)
        self.money:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -4)
        self.costs = UI.Text(self, "caption", "ink")
        self.costs:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -4)
        self.status = UI.Text(self, "caption", "ink-muted")
        self.status:SetWordWrap(false)
    end

    -- The line under the name: the price, then what's left, what you have and
    -- the quantity's note.
    function DrawStatus(parts: string[])
        local anchor: Region = self.money:IsShown() and self.money or self.costs
        self.status:ClearAllPoints()
        self.status:SetPoint("LEFT", anchor, "RIGHT", S["space-4"], 0)
        self.status:SetPoint("RIGHT", self.qty, "LEFT", -S["space-4"], 0)
        self.status:SetValue(table.concat(parts, "  ·  "))
    end
end

-- What is worn, over the foot: the anvil and the pieces.
class WearLine extends Frame
    readonly glyph: Texture
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetSize(16, 16)
        self.glyph:SetPoint("LEFT", 0, 0)
        self.glyph:SetTexture("Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\anvil.tga")
        self.text = UI.Text(self, "body", "ink-muted")
        self.text:SetPoint("LEFT", self.glyph, "RIGHT", S["space-2"], 0)
        self.text:SetPoint("RIGHT")
        self.text:SetJustifyH("LEFT")
        self.text:SetWordWrap(false)
    end
end

local function amber(text: string): string return "|cff" .. T.color["amber"].hex .. text .. "|r" end

-- A grey item in your bags.
type JunkSlot = { bag: number, slot: number }

-- The grey items in your bags and what they fetch.
local function junkSlots(): (JunkSlot[], number)
    local list: JunkSlot[], copper = {}, 0
    for bag = 0, 4 do
        for slot = 1, (num(call(C_Container.GetContainerNumSlots, bag)) or 0) do
            local info = call(C_Container.GetContainerItemInfo, bag, slot)
            local quality, noValue, locked = part(info, "quality"), part(info, "hasNoValue"), part(info, "isLocked")
            if plain(quality) and quality == 0 and not (plain(noValue) and noValue) and not (plain(locked) and locked) then
                local link = str(part(info, "hyperlink"))
                local price = link and num(select(11, call(C_Item.GetItemInfo, link))) or 0
                list[#list + 1] = { bag = bag, slot = slot }
                copper = copper + price * (num(part(info, "stackCount")) or 1)
            end
        end
    end
    return list, copper
end

--------------------------------------------------------------------------------
-- Over the game's merchant frame
--------------------------------------------------------------------------------

class MerchantModule extends Module<typeof(DEFAULTS)>
    away: boolean? = nil
    content: Frame? = nil
    empty: Text? = nil
    filter: Select<number>? = nil
    guild: SuuButton? = nil
    hasFilter: boolean = false
    junk: SuuButton? = nil
    last: Frame? = nil
    lastLabel: Text? = nil
    lastRow: MerchantRow? = nil
    lastRule: Frame? = nil
    list: ScrollArea? = nil
    money: Money? = nil
    -- between the game's MERCHANT_SHOW and MERCHANT_CLOSED
    open: boolean? = nil
    -- the quantities typed at this vendor, by item
    qty: { [string]: number } = {}
    refreshPending: boolean? = nil
    repair: SuuButton? = nil
    repairOne: SuuButton? = nil
    repairPrimary: SuuButton? = nil
    rows: MerchantRow[] = {}
    search: TextField? = nil
    selling: TickerHandle? = nil
    tab: string? = nil
    tools: Frame? = nil
    wear: WearLine? = nil
    window: WindowFrame? = nil

    constructor()
        super({
            id = "merchant",
            name = "Merchant",
            description = "SuuUI's merchant window: one list with a search, a quantity to buy, what you have and know, buy back, repair and sell junk.",
            api = "0.17",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function Item(index: number): Entry?
        local info = call(C_MerchantFrame.GetItemInfo, index)
        local name = str(part(info, "name"))
        if not name then return nil end
        local link = str(call(GetMerchantItemLink, index))
        local quality = link and num(select(3, call(C_Item.GetItemInfo, link))) or nil
        local e: Entry = {
            index = index, name = name, texture = art(part(info, "texture")), link = link,
            quality = QUALITY[quality or 1] or "common",
            price = num(part(info, "price")) or 0, stack = math.max(1, num(part(info, "stackCount")) or 1),
            stock = num(part(info, "numAvailable")) or -1,
            usable = part(info, "isUsable") == true, purchasable = part(info, "isPurchasable") == true,
            maxStack = math.max(1, num(call(GetMerchantItemMaxStack, index)) or 1),
            costs = {}, have = 0, known = false,
        }
        if part(info, "hasExtendedCost") then
            for k = 1, (num(call(GetMerchantItemCostInfo, index)) or 0) do
                local texture, valueR, costLink, currencyName = call(GetMerchantItemCostItem, index, k)
                local value = num(valueR)
                if value and value > 0 then
                    local currency = str(currencyName)
                    e.costs[#e.costs + 1] = { texture = art(texture), value = value, link = str(costLink), currency = currencyName ~= nil,
                                              name = currency }
                end
            end
        end
        e.have = link and haveOf(link) or 0
        e.known = isKnown(index)
        return e
    end

    -- Buys `items` of a merchant item, in calls the merchant takes (whole stacks,
    -- up to its most a time), a moment apart.
    function Buy(e: Entry, items: number)
        if items <= 0 then return end
        local per = math.max(e.stack, math.floor(e.maxStack / e.stack) * e.stack)
        local queue: number[], left = {}, items
        while left > 0 do
            local n = math.min(per, left)
            queue[#queue + 1] = n
            left = left - n
        end
        local k = 0
        local function step()
            k = k + 1
            local n = queue[k]
            if not n or not self.open then return end
            BuyMerchantItem(e.index, n)
            if queue[k + 1] then after(0.3, step) end
        end
        step()
    end

    -- Asks first where the game would: other costs, or a dear purchase.
    function ConfirmBuy(e: Entry, purchases: number, items: number)
        local money = e.price * purchases
        local costs: string[] = {}
        for _, c in ipairs(e.costs) do costs[#costs + 1] = (c.value * purchases) .. " " .. icon(c.texture) end
        if money > 0 then costs[#costs + 1] = coins(money) end
        if #e.costs == 0 and money < HIGH_PRICE then
            self:Buy(e, items)
            return
        end
        UI.Confirm({ title = "Buy " .. e.name .. "?",
            text = ("%d × %s for %s."):format(items, e.name, table.concat(costs, ", ")),
            confirm = "Buy", onConfirm = function() self:Buy(e, items) end })
    end

    function DrawGoodsRow(r: MerchantRow, e: Entry)
        r.entry = e
        r.slot.index, r.slot.buyback, r.slot.link = e.index, false, e.link
        r.slot.skin:SetItem({ icon = e.texture, count = e.stack, quality = e.quality, dim = e.known })
        r.tint:SetShown(not e.known and (not e.usable or not e.purchasable))
        r.name:SetValue(e.name)
        r.name:SetColor(e.known and "ink-faint" or ((e.quality ~= "common") and ("quality-" .. e.quality) or "ink"))
        if e.known then
            r.money:Hide()
            r.costs:Show()
            r.costs:SetValue("|cff" .. T.color["fel"].hex .. "✓ Known|r")
        elseif #e.costs > 0 then
            local parts: string[] = {}
            for _, c in ipairs(e.costs) do parts[#parts + 1] = c.value .. " " .. icon(c.texture) end
            if e.price > 0 then parts[#parts + 1] = coins(e.price) end
            r.money:Hide()
            r.costs:Show()
            r.costs:SetValue(table.concat(parts, "  "))
        else
            r.costs:Hide()
            r.money:Show()
            r.money:SetCopper(e.price)
        end
        r.qty:SetShown(not e.known)
        -- the quantity typed for this item at this vendor, else one purchase
        local key = e.link or e.name
        if r.qtyFor ~= key or not r.qty.edit:HasFocus() then
            r.qty:SetValue(tostring(self.qty[key] or e.stack))
        end
        r.qtyFor = key
        local function refreshNote()
            local qty = tonumber(r.qty.edit:GetText()) or e.stack
            if qty ~= e.stack then self.qty[key] = qty else self.qty[key] = nil end
            local purchases, _, note = plan(e, qty)
            local parts: string[] = {}
            if e.stock >= 0 then parts[#parts + 1] = amber(e.stock .. " left") end
            if e.have > 0 then parts[#parts + 1] = "You have " .. e.have end
            if note and not e.known then parts[#parts + 1] = note:find("^Capped") and amber(note) or note end
            r:DrawStatus(parts)
            r.qty.border:SetColor(note and note:find("^Capped") and "gilt" or "gilt-line")
            r.buy:SetEnabledState(not e.known and purchases > 0 and e.purchasable)
        end
        r.qty.onTextChanged = function(_: string) refreshNote() end
        r.qty.onChange = function(_: string) refreshNote() end
        refreshNote()
        r.buy:SetLabel("Buy")
        r.buy:SetScript("OnClick", function()
            local qty = tonumber(r.qty.edit:GetText()) or e.stack
            local purchases, items = plan(e, qty)
            if purchases > 0 then self:ConfirmBuy(e, purchases, items) end
        end)
    end

    function DrawBuybackRow(r: MerchantRow, i: number, undo: boolean?)
        local nameR, texture, priceR, quantity, _, usable = call(GetBuybackItemInfo, i)
        local link = str(call(GetBuybackItemLink, i))
        local quality = link and num(select(3, call(C_Item.GetItemInfo, link))) or nil
        local price = num(priceR) or 0
        r.entry = nil
        r.slot.index, r.slot.buyback, r.slot.link = i, true, link
        r.slot.skin:SetItem({ icon = art(texture), count = num(quantity), quality = QUALITY[quality or 1] or "common" })
        r.tint:SetShown(usable == false)
        r.name:SetValue(str(nameR) or "?")
        r.name:SetColor((quality and quality ~= 1) and ("quality-" .. (QUALITY[quality] or "common")) or "ink")
        r.costs:Hide()
        r.money:Show()
        r.money:SetCopper(price)
        r.qty:Hide()
        r:DrawStatus({})
        r.buy:SetLabel(undo and "Undo" or "Buy back")
        r.buy:SetEnabledState((GetMoney() or 0) >= price)
        r.buy:SetScript("OnClick", function() BuybackItem(i) end)
    end

    -- The last sold item's strip: its caption and one row.
    function LastHeight(): number
        return S["space-4"] + T.type.caption.lineHeight + S["space-2"] + ROW_H
    end

    function Build()
        local w = UI.WindowFrame(SuuUI.Root, { name = "SuuUIMerchantWindow", title = "Merchant", width = WIDTH, height = HEIGHT,
            footer = true, onClose = function(win: Panel) win:Hide() end,
            tabs = { { key = "buy", label = "Merchant" }, { key = "buyback", label = "Buy back" } },
            onTab = function(key: string)
                self.tab = key
                local list = self.list
                if list then list:SetVerticalScroll(0) end
                self:Refresh()
            end })
        w:SetPoint("TOPLEFT", UIParent, "TOPLEFT", 16, -116)
        w:Hide()
        w:HookScript("OnHide", function()
            if self.open then CloseMerchant() end
        end)
        self.window = w
        -- the tools stay on top; only the list under them scrolls (with a bar)
        w.scroll:Hide()
        local tools = CreateFrame("Frame", nil, w.body)
        tools:SetPoint("TOPLEFT")
        tools:SetPoint("TOPRIGHT")
        tools:SetHeight(30)
        self.tools = tools
        local BAR = S["space-3"]
        local list = UI.ScrollArea(w.body, BAR)
        self.list = list
        list:SetPoint("BOTTOMLEFT")
        list:SetPoint("BOTTOMRIGHT", -(BAR + 3), 0)
        local c = list.child
        list:HookScript("OnSizeChanged", function(_: Frame, width: number) c:SetWidth(width) end)
        self.content = c
        -- the tools: a search over the goods, the game's filter
        local search = UI.TextField(tools, { width = 240, placeholder = "Search", onTextChanged = function() self:Refresh() end })
        self.search = search
        search:SetPoint("TOPLEFT")
        local options: SelectOption<number>[] = {}
        if LE_LOOT_FILTER_ALL then options[#options + 1] = { value = LE_LOOT_FILTER_ALL, label = "All items" } end
        if LE_LOOT_FILTER_CLASS then options[#options + 1] = { value = LE_LOOT_FILTER_CLASS, label = "Your class" } end
        if LE_LOOT_FILTER_BOE then options[#options + 1] = { value = LE_LOOT_FILTER_BOE, label = "Bind on equip" } end
        local filter: Select<number> = UI.Select(tools, { width = 160, options = options, onChange = function(v: number)
            call(SetMerchantFilter, v)
            self:Refresh()
        end })
        self.filter = filter
        filter:SetPoint("TOPRIGHT")
        self.hasFilter = #options > 0
        self.rows = {}
        -- the item you sold last, with Undo: fixed under the list
        local last = CreateFrame("Frame", nil, w.body)
        last:SetPoint("BOTTOMLEFT")
        last:SetPoint("BOTTOMRIGHT", -(S["space-3"] + 3), 0)
        last:SetHeight(self:LastHeight())
        self.last = last
        local rule = UI.Hairline(last, "gilt-faint")
        self.lastRule = rule
        rule:SetPoint("TOPLEFT")
        rule:SetPoint("TOPRIGHT")
        local label = UI.Text(last, "caption", "ink-muted")
        self.lastLabel = label
        label:SetValue("Last sold")
        label:SetPoint("TOPLEFT", 0, -S["space-4"])
        local lastRow = MerchantRow.new(last)
        self.lastRow = lastRow
        lastRow:SetPoint("BOTTOMLEFT")
        lastRow:SetPoint("BOTTOMRIGHT")
        lastRow.rule:Hide()
        last:Hide()
        -- what is worn, over the foot (the Durability module's "On your gear",
        -- design board "Durability" C): at a merchant who repairs, while a
        -- piece is at or below the line
        local wear = WearLine.new(w.body)
        wear:SetPoint("BOTTOMLEFT")
        wear:SetPoint("BOTTOMRIGHT", -(S["space-3"] + 3), 0)
        wear:Hide()
        self.wear = wear
        self.empty = UI.Text(c, "body", "ink-muted")
        -- the foot: repair, guild repair, sell junk; your money at the right
        local f = assert(w.footer)
        local money = UI.Money(f)
        self.money = money
        money:SetPoint("RIGHT", 0, 0)
        local repair = UI.Button(f, { text = "Repair all", onClick = function() call(RepairAllItems, false) end })
        self.repair = repair
        repair:SetPoint("LEFT", 0, 0)
        -- the same, primary while the line over the foot names worn pieces
        local repairPrimary = UI.Button(f, { text = "Repair all", variant = "primary", icon = "anvil",
            onClick = function() call(RepairAllItems, false) end })
        self.repairPrimary = repairPrimary
        repairPrimary:SetPoint("LEFT", 0, 0)
        repairPrimary:Hide()
        local repairOne = UI.Button(f, { text = "One", width = 52, onClick = function()
            if InRepairMode and InRepairMode() then call(HideRepairCursor) else call(ShowRepairCursor) end
        end, tooltip = { title = "Repair one item", description = "Then click the item: on your character or in your bags." } })
        self.repairOne = repairOne
        local guild = UI.Button(f, { text = "Guild", onClick = function() call(RepairAllItems, true) end })
        self.guild = guild
        guild:SetPoint("LEFT", repairOne, "RIGHT", S["space-2"], 0)
        self.junk = UI.Button(f, { text = "Sell junk", onClick = function() self:SellJunk() end })
    end

    -- Keeps n rows in the list, positioned from y; returns them.
    function Rows(n: number, y: number): MerchantRow[]
        local c = assert(self.content)
        for i = 1, math.max(n, #self.rows) do
            local r = self.rows[i]
            if i <= n then
                if not r then
                    r = MerchantRow.new(c)
                    self.rows[i] = r
                end
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", 0, -(y + (i - 1) * ROW_H))
                r:SetPoint("RIGHT", c, "RIGHT")
                r.rule:Show()
                r:Show()
            elseif r then
                r:Hide()
            end
        end
        return self.rows
    end

    function Refresh()
        local w = self.window
        if not (w and w:IsShown() and self.open) then return end
        -- (built with the window)
        local c, tools, filter, last, list = assert(self.content), assert(self.tools), assert(self.filter), assert(self.last), assert(self.list)
        local empty, wear, search = assert(self.empty), assert(self.wear), assert(self.search)
        local name = UnitName("npc")
        w:SetTitle(plain(name) and name or "Merchant")
        local buy = (self.tab or "buy") == "buy"
        tools:SetShown(buy)
        filter:SetShown(self.hasFilter)
        if buy then filter:SetValue(num(call(GetMerchantFilter))) end
        -- the last sold item under the list (Merchant tab, once you sold one)
        local lastN = num(call(GetNumBuybackItems)) or 0
        local showLast = buy and lastN > 0
        last:SetShown(showLast)
        if showLast then self:DrawBuybackRow(assert(self.lastRow), lastN, true) end
        local wearShown = self:DrawWear()
        last:ClearAllPoints()
        if wearShown then
            last:SetPoint("BOTTOMLEFT", wear, "TOPLEFT")
            last:SetPoint("BOTTOMRIGHT", wear, "TOPRIGHT")
        else
            last:SetPoint("BOTTOMLEFT")
            last:SetPoint("BOTTOMRIGHT", -(S["space-3"] + 3), 0)
        end
        list:ClearAllPoints()
        list:SetPoint("TOPLEFT", 0, buy and -(30 + S["space-4"]) or 0)
        if showLast then
            list:SetPoint("BOTTOMRIGHT", last, "TOPRIGHT", 0, S["space-2"])
        elseif wearShown then
            list:SetPoint("BOTTOMRIGHT", wear, "TOPRIGHT", 0, S["space-2"])
        else
            list:SetPoint("BOTTOMRIGHT", -(S["space-3"] + 3), 0)
        end
        local y = 0
        empty:Hide()
        local used = 0
        if buy then
            local query = (search.edit:GetText() or ""):lower()
            local goods: Entry[] = {}
            for i = 1, (num(call(GetMerchantNumItems)) or 0) do
                local e = self:Item(i)
                if e and (query == "" or e.name:lower():find(query, 1, true)) then goods[#goods + 1] = e end
            end
            local rows = self:Rows(#goods, y)
            for i, e in ipairs(goods) do self:DrawGoodsRow(rows[i], e) end
            used = #goods
            y = y + used * ROW_H
            if used > 0 then rows[used].rule:Hide() end
            if used == 0 then
                empty:ClearAllPoints()
                empty:SetPoint("TOPLEFT", 0, -(y + S["space-4"]))
                empty:SetValue(query ~= "" and "Nothing here matches." or "This merchant has nothing to sell.")
                empty:Show()
                y = y + 40
            end
        else
            local n = num(call(GetNumBuybackItems)) or 0
            local rows = self:Rows(n, y)
            for i = 1, n do self:DrawBuybackRow(rows[i], i) end
            if n > 0 then rows[n].rule:Hide() end
            y = y + n * ROW_H
            if n == 0 then
                empty:ClearAllPoints()
                empty:SetPoint("TOPLEFT", 0, -S["space-4"])
                empty:SetValue("Nothing sold to buy back.")
                empty:Show()
                y = 40
            end
        end
        c:SetHeight(math.max(1, y))
        self:RefreshFoot()
    end

    -- One grey item a moment until none is left or the merchant closes.
    function SellJunk()
        if self.selling then return end
        self.selling = every(0.2, function(ticker: TickerHandle)
            local list = junkSlots()
            local first = list[1]
            if not self.open or not first or InCombatLockdown() then
                ticker:Cancel()
                self.selling = nil
                self:RefreshFoot()
                return
            end
            C_Container.UseContainerItem(first.bag, first.slot)
        end)
    end

    -- The line over the foot: "Chest broken · Legs 9%, Main hand 12% · 6 more
    -- worn" (broken in ember, damaged in amber), at a merchant who repairs.
    -- Shown: true.
    function DrawWear(): boolean
        local wear = assert(self.wear)
        local d = SuuUI.Durability()
        local show = d ~= nil and d.parts.gear and d.state ~= "fine" and call(CanMerchantRepair) and true or false
        wear:SetShown(show)
        if not (show and d) then return false end
        local broken: string[], damaged: string[], worn = {}, {}, 0
        for _, p in ipairs(d.pieces) do
            if p.state == "broken" then broken[#broken + 1] = p.label
            elseif p.state == "damaged" then damaged[#damaged + 1] = p.label .. " " .. p.percent .. "%"
            elseif p.current < p.max then worn = worn + 1 end
        end
        local function c(token: keyof typeof(T.color), text: string): string return "|cff" .. T.color[token].hex .. text .. "|r" end
        local parts: string[] = {}
        if #broken > 0 then parts[#parts + 1] = c("ember-text", table.concat(broken, ", ") .. " broken") end
        if #damaged > 0 then parts[#parts + 1] = c("amber", table.concat(damaged, ", ")) end
        if worn > 0 then parts[#parts + 1] = worn .. " more worn" end
        wear.text:SetValue(table.concat(parts, " · "))
        UI.Paint(wear.glyph, #broken > 0 and "ember-text" or "amber")
        wear:SetHeight(math.max(16, T.type.body.lineHeight) + S["space-2"])
        return true
    end

    function RefreshFoot()
        local w = self.window
        if not w then return end
        -- (built with the window)
        local money, repair, repairPrimary, repairOne = assert(self.money), assert(self.repair), assert(self.repairPrimary), assert(self.repairOne)
        local guildButton, junk, wear = assert(self.guild), assert(self.junk), assert(self.wear)
        money:SetCopper(GetMoney() or 0)
        local canRepair = call(CanMerchantRepair) and true or false
        local costR, needed = call(GetRepairAllCost)
        local cost = num(costR) or 0
        -- primary while the line over the foot shows
        local primary = canRepair and wear:IsShown()
        repair:SetShown(canRepair and not primary)
        repairPrimary:SetShown(primary)
        repairOne:SetShown(canRepair)
        if canRepair then
            for _, b in ipairs({ repair, repairPrimary }) do
                b:SetLabel(cost > 0 and ("Repair all  " .. coins(cost)) or "Repair all")
                b:SetEnabledState(needed and cost > 0 and (GetMoney() or 0) >= cost)
            end
        end
        repairOne:ClearAllPoints()
        repairOne:SetPoint("LEFT", primary and repairPrimary or repair, "RIGHT", S["space-2"], 0)
        local guild = canRepair and call(CanGuildBankRepair) and true or false
        guildButton:SetShown(guild)
        if guild then
            local left = num(call(GetGuildBankWithdrawMoney))
            guildButton.tooltip = { title = "Repair from the guild bank",
                description = left and left >= 0 and ("The guild can still pay " .. coins(left) .. " today.") or nil }
            guildButton:SetEnabledState(needed and cost > 0)
        end
        local list, copper = junkSlots()
        junk:SetLabel(#list > 0 and ("Sell junk  " .. coins(copper)) or "Sell junk")
        junk:SetEnabledState(#list > 0 and not self.selling)
        junk.tooltip = #list == 0 and { title = "Sell junk", description = "No grey items in your bags." } or nil
        junk:ClearAllPoints()
        local prev: Frame? = (guild and guildButton) or (canRepair and repairOne) or nil
        if prev then junk:SetPoint("LEFT", prev, "RIGHT", S["space-2"], 0) else junk:SetPoint("LEFT", 0, 0) end
        -- the merchant's currencies in the header
        local meta: string[] = {}
        local currencies = C_MerchantFrame.GetMerchantCurrencies and call(C_MerchantFrame.GetMerchantCurrencies)
        if type(currencies) == "table" then
            for _, id in ipairs(currencies :: unknown[]) do
                local info = call(C_CurrencyInfo.GetCurrencyInfo, id)
                if info and #meta < 6 then meta[#meta + 1] = (num(part(info, "quantity")) or 0) .. " " .. icon(art(part(info, "iconFileID"))) end
            end
        end
        local header = w.meta
        if header then header:SetValue(table.concat(meta, "   ")) end
    end

    -- A burst of updates draws once.
    function QueueRefresh()
        if self.refreshPending then return end
        self.refreshPending = true
        after(0.05, function()
            self.refreshPending = nil
            self:Refresh()
        end)
    end

    -- The game's frame out of sight: see-through and off screen, still shown,
    -- and back off screen whenever the game places it again.
    function Away(frame: Frame?)
        if not frame or self.away then return end
        self.away = true
        local placing = false
        local function away()
            if not self:IsEnabled() then return end
            placing = true
            frame:SetAlpha(0)
            frame:ClearAllPoints()
            frame:SetPoint("TOPLEFT", UIParent, "TOPRIGHT", 5000, 0)
            placing = false
        end
        away()
        hook(frame, "SetPoint", function() if not placing then after(0, away) end end)
        hookScript(frame, "OnShow", function() after(0, away) end)
    end

    override function OnEnable()
        self.qty = {}
        if not self.window then self:Build() end
        self:OnGameEvent("MERCHANT_SHOW", function()
            self.open = true
            self.qty = {} -- quantities start over at every vendor
            self:Away(asFrame(named("MerchantFrame")))
            call(ResetSetMerchantFilter)
            assert(self.search):SetValue("")
            local w = assert(self.window)
            w:Show()
            w:SetTab("buy")
        end)
        self:OnGameEvent("MERCHANT_CLOSED", function()
            self.open = false
            if InRepairMode and InRepairMode() then HideRepairCursor() end
            assert(self.window):Hide()
        end)
        for _, e in ipairs({ "MERCHANT_UPDATE", "MERCHANT_FILTER_ITEM_UPDATE", "BAG_UPDATE_DELAYED", "GET_ITEM_INFO_RECEIVED",
                             "UPDATE_INVENTORY_DURABILITY", "CURRENCY_DISPLAY_UPDATE" }) do
            self:OnGameEvent(e, function() self:QueueRefresh() end)
        end
        self:OnGameEvent("PLAYER_MONEY", function() self:QueueRefresh() end)
        -- the Durability module's reading (the line over the foot)
        self:On("SUUUI_DURABILITY_CHANGED", function() self:QueueRefresh() end)
        self:On("SUUUI_SERVICE_CHANGED", function(_, name) if name == "durability" then self:QueueRefresh() end end)
        -- prices and notes carry colour codes; the strip's caption can change size
        self:On("SUUUI_THEME_CHANGED", function()
            local last = self.last
            if last then last:SetHeight(self:LastHeight()) end
            self:Refresh()
        end)
    end

    override function OnDisable()
        local w = self.window
        if w then w:Hide() end
    end
end

-- (the tests read it)
export local M = SuuUI.AddModule(MerchantModule.new())
