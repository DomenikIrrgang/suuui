-- Units/Windows/WorldMap.wowlua
-- The world map in SuuUI's look (Units/Windows): its header ("Continent ›
-- Zone", a click on it a level up through a secure button), the header's
-- second row (the game's filter menu, waypoint pin, the quest log's search,
-- count and settings), the side-panel toggle, the status line with the
-- coordinates, and enlarging by a scale. Each a function taking the module;
-- the module's methods (SkinWorldMap, StatusLine, Enlarging) call them.
-- The quest log beside the map is Units/Windows/QuestLog's; the map's top
-- and the second row's measures (ROW_MID, SEARCH_H) are shared with it.

import SuuUI from "/Core/API"
import type WindowChrome from "/Core/API"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import * as events from "wowlua:events"
import * as secure from "wowlua:secure"
import type WindowsModule from "/Units/Windows"
import part, button, quiet, shows, glyphOn, skinMaxMin from "/Units/Windows/Shared"

local chromeOf = SuuUI.UI.WindowChrome

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local try, tryMethod = errors.try, errors.tryMethod
local asNumber, flag, field = secret.asNumber, secret.flag, tbl.field
local find = frames.find

--------------------------------------------------------------------------------
-- The world map
--------------------------------------------------------------------------------

-- "Kalimdor › Durotar": the map's continent before its name.
-- The map the world map shows (Blizzard's code keeps it in a field its
-- declarations can't type).
local function shownMap(): number?
    return WorldMapFrame and secret.asNumber(WorldMapFrame:GetMapID()) or nil
end

local function mapTitle(mapID: number?): string
    local info = mapID and C_Map.GetMapInfo(mapID)
    if not info then
        return "World map"
    end
    local continent: string? = nil
    local parent = info.parentMapID
    local guard = 0
    local CONTINENT = Enum.UIMapType and Enum.UIMapType.Continent or 2
    while parent and parent > 0 and guard < 6 do
        local p = C_Map.GetMapInfo(parent)
        if not p then
            break
        end
        if p.mapType == CONTINENT then
            continent = p.name
            break
        end
        parent, guard = p.parentMapID, guard + 1
    end
    return continent and (continent .. " › " .. info.name) or info.name
end

-- The map's top: the game keeps 67px over it for its breadcrumb bar
-- (TITLE_CANVAS_SPACER_FRAME_HEIGHT), hidden here: SuuUI's header covers
-- that band, so the map starts right under the header, level with the quest
-- log's top (the game's QuestMapFrame at -25, moved down with it). The
-- map keeps the game's own size: resized from SuuUI's code (the band cut
-- out, the enlarged size), the map's zoom was written by it, and the game
-- refused to place its pins in combat later ("Blocked in combat:
-- SetPassThroughButtons", found in game). The header's second row
-- (filters, the log's search) is ROW_EXTRA taller than other windows'
-- (asked: a taller search box).
local ROW_EXTRA = 8
local GAME_MAP_TOP, MAP_TOP = 67, 25 + ROW_EXTRA
local CUT = GAME_MAP_TOP - MAP_TOP
-- the second row's controls, their middles on one line in it, the
-- chrome's rowMid (anchored by their bottoms, controls of different heights
-- sat at different heights: found in game)
export const ROW_MID = S["space-1"] + 11 + ROW_EXTRA / 2
export const SEARCH_H = 26

--------------------------------------------------------------------------------
-- The world map (3.5, stage 1; source read 2026-10-15: WorldMapFrame isn't
-- protected, its quest log is QuestMapFrame docked as a 333px side panel):
-- SuuUI's header with "Continent › Zone", the game's border, portrait and
-- title away, the quest log and its details restyled in place (their
-- clicks stay the game's), the game's own filter menu, side-panel toggle
-- and maximize in SuuUI's look, and a status line: the coordinates under
-- the cursor (yours when it's off the map). Small, in the window row under
-- the micro menu; maximized, SuuUI's enlarged map in the screen's middle.
--------------------------------------------------------------------------------

export function skinWorldMap(self: WindowsModule)
    if not find("WorldMapFrame") then
        return
    end
    local f = WorldMapFrame
    if chromeOf(f) then
        return
    end
    local b = part(f, "BorderFrame")
    local chrome = UI.SkinWindow(f, {
        title = mapTitle(shownMap()),
        icon = "map",
        binding = "TOGGLEWORLDMAP",
        close = button(b, "CloseButton") or button(_G, "WorldMapFrameCloseButton"),
        -- (over the game's band: the header's bottom where the map starts)
        topInset = 24 + ROW_EXTRA + CUT,
        headExtra = ROW_EXTRA,
        under = "microMenu",
        hide = {
            field(b, "NineSlice"),
            field(b, "PortraitContainer"),
            field(b, "TitleContainer"),
            field(b, "Bg"),
            field(b, "TopTileStreaks"),
            field(b, "InsetBorderTop"),
        },
    })
    -- the help-plate button: away
    quiet(part(b, "Tutorial"))
    local mm = part(b, "MaximizeMinimizeFrame")
    skinMaxMin(chrome, mm)
    -- the title follows the map; a click on it goes up a level (as a
    -- right-click on the map does): the header names the place, so the
    -- game's breadcrumb bar goes, and its strip with it
    local title = chrome.title
    local up = CreateFrame("Button", nil, chrome.head)
    up:SetFrameLevel(chrome.head:GetFrameLevel() + 2)
    -- over the title, but hung on the header (a frame), at the title's
    -- place and size: the secure button that comes over it can't hang on
    -- a frame that hangs on a text ("Cannot anchor protected frames to
    -- regions", found in game 2026-11-11)
    local head = chrome.head
    local function placeUp()
        -- (a secure button hangs on it: not moved in a fight)
        local over = self.upOver
        if InCombatLockdown() and over and over.button:IsShown() then
            return
        end
        local l, t, hl, ht = title:GetLeft(), title:GetTop(), head:GetLeft(), head:GetTop()
        if not (l and t and hl and ht) then
            return
        end
        up:ClearAllPoints()
        up:SetPoint("TOPLEFT", head, "TOPLEFT", l - hl - 2, t - ht + 2)
        up:SetSize(title:GetWidth() + 4, title:GetHeight() + 4)
    end
    placeUp()
    f:HookScript("OnShow", placeUp)
    -- the way up: a secure click on the game's breadcrumb bar's parent
    -- level (its click sets the map, as the game's own), through a secure
    -- button that comes over the title while the mouse is on it, out of
    -- combat (asked 2026-11-05). Set from SuuUI's code, the map's pins were
    -- taken by it, and the map opened in combat was refused later ("Blocked
    -- in combat: SetPassThroughButtons", found in game). In combat the
    -- title does nothing; a right-click on the map still goes up.
    local function parentLevel(): Frame?
        local nb = part(f, "NavBar")
        local list = nb and tbl.list(field(nb, "navList"))
        return list and #list > 1 and frames.asFrame(list[#list - 1]) or nil
    end
    local function upOff()
        local over = self.upOver
        if over and over.button:IsShown() then
            over.hide()
        end
    end
    -- let go as a fight starts (the mouse may rest on the title): a
    -- secure button left hanging on the header would make the map
    -- protected for the fight. The event comes before the lockdown, so
    -- the button can still be hidden then.
    self:OnGameEvent("PLAYER_REGEN_DISABLED", upOff)
    local function upOn()
        local target = parentLevel()
        if InCombatLockdown() or not target then
            return
        end
        local over = self.upOver
        if over and over.button:IsShown() then
            over.set("clickbutton1", target)
            return
        end
        placeUp()
        if not over then
            local made = secure.overlay(up)
            local holder = CreateFrame("Frame", nil, UIParent)
            secure.visibility(holder, "[combat] hide; show")
            made.button:SetParent(holder)
            made.set("type1", "click")
            made.button:HookScript("OnLeave", upOff)
            -- the map changed under it: the new parent level next time
            made.button:HookScript("PostClick", function()
                self:After(0, upOff)
            end)
            self.upOver = made
            over = made
        end
        over.set("clickbutton1", target)
        over.show()
    end
    up:SetScript("OnEnter", function(self2: Button)
        upOn()
        local id = shownMap()
        local info = id and C_Map.GetMapInfo(id)
        local parent = info and info.parentMapID and C_Map.GetMapInfo(info.parentMapID)
        if parent then
            UI.ShowTooltip(self2, { title = "Up to " .. parent.name, description = "Or right-click the map" })
        end
        title:SetColor("ink")
    end)
    up:SetScript("OnLeave", function()
        UI.HideTooltip()
        title:SetColor("gilt-text")
    end)
    f:HookScript("OnHide", upOff)
    events.onRegistry(
        "MapCanvas.MapSet",
        function(mapID: unknown)
            if f:IsShown() then
                chrome:SetTitle(mapTitle(asNumber(mapID)))
                placeUp()
            end
        end,
        self
    )
    -- (left where the game puts it, which it measures itself against:
    -- see-through, and its buttons, made again on every map change, without
    -- the mouse so they don't take clicks over the map's top)
    local function quietNav()
        local nb = part(f, "NavBar")
        if not nb then
            return
        end
        nb:SetAlpha(0)
        nb:EnableMouse(false)
        for _, btn in ipairs(tbl.list(field(nb, "navList"))) do
            local frame = frames.asFrame(btn)
            if frame then
                frame:EnableMouse(false)
            end
        end
        for _, key in ipairs({ "home", "overflowButton" }) do
            local frame = part(nb, key)
            if frame then
                frame:EnableMouse(false)
            end
        end
    end
    quietNav()
    hook(f, "OnMapChanged", quietNav)
    -- (the map stays where the game puts it, under its band: the header
    -- covers the band; see GAME_MAP_TOP)
    -- the game's own coordinates (SuuUI's status line shows them)
    for _, o in ipairs(tbl.list(field(f, "overlayFrames"))) do
        local frame = frames.asFrame(o)
        if frame and field(o, "PlayerCoords") and field(o, "CursorCoords") then
            frame:SetAlpha(0)
        end
    end
    -- the header's second row: the game's filter menu (its reset × away)
    -- and waypoint pin on the left, the quest log's search, count and
    -- settings on the right
    local track, pin = part(f, "WorldMapTrackingOptionsButton"),
        frames.asButton(field(f, "WorldMapTrackingPinButton"))
    local function placeRow()
        if track then
            track:ClearAllPoints()
            track:SetPoint("LEFT", chrome.head, "BOTTOMLEFT", S["space-5"], ROW_MID)
            track:SetFrameLevel(chrome.head:GetFrameLevel() + 3)
        end
        if pin then
            pin:ClearAllPoints()
            if track then
                pin:SetPoint("LEFT", track, "RIGHT", S["space-2"], 0)
            else
                pin:SetPoint("LEFT", chrome.head, "BOTTOMLEFT", S["space-5"], ROW_MID)
            end
            pin:SetFrameLevel(chrome.head:GetFrameLevel() + 3)
        end
    end
    if track then
        UI.ReskinDropdown(track, { glyph = "filter" })
        track:SetSize(22, 22)
        quiet(part(track, "ResetButton"))
    end
    if pin then
        glyphOn(pin, "pushpin", 14)
    end
    placeRow()
    -- the game anchors them over the map again on every map change
    hook(f, "OnMapChanged", placeRow)
    if field(f, "AdjustOverlayFrames") then
        hook(f, "AdjustOverlayFrames", placeRow)
    end
    local list = find("QuestScrollFrame")
    if list then
        -- the log's top level with the map's (the game's -25)
        local q = find("QuestMapFrame")
        if q and q:GetParent() == f then
            q:SetPoint("TOPRIGHT", f, "TOPRIGHT", -3, -GAME_MAP_TOP)
        end
        -- the list starts level with the map (the search row was over it)
        list:SetPoint("TOPLEFT", 0, 0)
        local gear, count, search = part(list, "SettingsDropdown"), find("QuestLogCount"), part(list, "SearchBox")
        local right: Frame = chrome.head
        if gear then
            UI.ReskinDropdown(gear, { glyph = "gear" })
            gear:SetSize(22, 22)
            gear:ClearAllPoints()
            gear:SetPoint("RIGHT", chrome.head, "BOTTOMRIGHT", -S["space-5"], ROW_MID)
            -- its menu under the header's rule, not over the row
            local anchor = try(
                field(_G, "AnchorUtil", "CreateAnchor"),
                "TOPRIGHT",
                gear,
                "BOTTOMRIGHT",
                0,
                -(ROW_MID - 11 + S["space-2"])
            )
            if anchor then
                tryMethod(gear, "SetMenuAnchor", anchor)
            end
            right = gear
        end
        if count then
            count:ClearAllPoints()
            if gear then
                count:SetPoint("RIGHT", gear, "LEFT", -S["space-3"], 0)
            else
                count:SetPoint("RIGHT", chrome.head, "BOTTOMRIGHT", -S["space-5"], ROW_MID)
            end
            right = count
        end
        if search and right ~= chrome.head then
            search:ClearAllPoints()
            search:SetPoint("RIGHT", right, "LEFT", -S["space-3"], 0)
        end
    end
    local toggle = part(f, "SidePanelToggle")
    for _, key in ipairs({ "OpenButton", "CloseButton" }) do
        local btn = button(toggle, key)
        if btn then
            for _, t in ipairs(frames.stateTextures(btn)) do
                t:SetAlpha(0)
            end
            UI.Fill(btn, "surface-raised", "BACKGROUND", 7):SetAllPoints()
            UI.Border(btn, "gilt-line")
            local g = btn:CreateTexture(nil, "OVERLAY")
            UI.Glyph(g, (key == "OpenButton" and "chevronLeft" or "chevronRight"))
            g:SetSize(12, 12)
            g:SetPoint("CENTER")
            UI.Paint(g, "ink-muted")
        end
    end
    -- the quest log: restyled now and whenever the game lays it out again
    self:RestyleQuestLog()
    if field(_G, "QuestLogQuests_Update") then
        hook("QuestLogQuests_Update", function()
            self:RestyleQuestLog()
        end)
    end
    if field(_G, "QuestMapFrame_ShowQuestDetails") then
        hook("QuestMapFrame_ShowQuestDetails", function()
            self:After(0, function()
                self:RestyleQuestLog()
            end)
        end)
    end
    self.status = self:StatusLine(f)
    self:Enlarging(f, chrome, mm)
    self.worldMap = chrome
end

-- The status line: the coordinates, over the map's bottom left (no zoom
-- buttons: the mouse wheel zooms, asked in game).
export function statusLine(self: WindowsModule, f: typeof(WorldMapFrame)): Frame
    local status = CreateFrame("Frame", nil, f)
    -- (over the map's pins, the game's and SuuUI's: frame levels 2000 up)
    status:SetFrameLevel(4000)
    -- (as wide as its text, at least as "00.0, 00.0": the zoom buttons it
    -- once held are gone)
    local function measureMin(): number
        return math.ceil(UI.MeasureText("numeric", "00.0, 00.0"))
    end
    local minW = measureMin()
    local container = part(f, "ScrollContainer")
    status:SetSize(minW + 2 * S["space-4"], 26)
    status:SetPoint("BOTTOMLEFT", container or f, "BOTTOMLEFT", S["space-3"], S["space-3"])
    UI.Fill(status, "surface-glass"):SetAllPoints()
    UI.Border(status, "gilt-line")
    local coord = UI.Text(status, "numeric", "ink")
    coord:SetPoint("LEFT", S["space-4"], 0)
    local wait = 0
    status:SetScript("OnUpdate", function(_: Frame, elapsed: number)
        wait = wait - elapsed
        if wait > 0 then
            return
        end
        wait = 0.05
        local x: number?, y: number?, you = nil, nil, false
        -- the cursor's spot while it's over the map, over a pin too (the
        -- canvas loses the mouse focus to the pin: it read your position;
        -- found in game); yours off the map
        if container and container:IsMouseOver() then
            local rx, ry = f:GetNormalizedCursorPosition()
            local cx, cy = secret.asNumber(rx), secret.asNumber(ry)
            if cx and cy and cx >= 0 and cx <= 1 and cy >= 0 and cy <= 1 then
                x, y = cx, cy
            end
        end
        if not x then
            local id = shownMap()
            local pos = id and C_Map.GetPlayerMapPosition(id, "player")
            if pos then
                x, y = pos:GetXY()
                you = true
            end
        end
        if x and y and (x > 0 or y > 0) then
            local text = ("%.1f, %.1f"):format(x * 100, y * 100)
            local w = math.ceil(UI.MeasureText("numeric", text .. (you and "  you" or "")))
            coord:SetValue(text .. (you and "  |cff" .. T.color["ink-muted"].hex .. "you|r" or ""))
            status:SetWidth(math.max(minW, w) + 2 * S["space-4"])
            status:SetAlpha(1)
        else
            coord:SetValue("")
            status:SetAlpha(0)
        end
    end)
    -- a theme can change the numbers' width
    self:On("SUUUI_THEME_CHANGED", function()
        minW = measureMin()
    end)
    return status
end

-- The window's size: windowed, the game's own (it sizes the map; see
-- GAME_MAP_TOP). Enlarged (the maximize button): the same window larger,
-- in the screen's middle, the quest log beside it as you left it, the
-- world around it seen and clickable (asked in game). A scale instead
-- (no resize from SuuUI's code) made the header, the log and the pins as
-- much bigger: the resize was asked for back (2026-11-05). The game's own
-- fullscreen isn't used: its black backdrop blocks the world and it shows
-- the map alone.
export function enlarging(self: WindowsModule, f: typeof(WorldMapFrame), chrome: WindowChrome, mm: Frame?)
    local function enlarged(): boolean
        return self:Get("mapEnlarged")
    end
    local function share(): number
        local wm = SuuUI.GetModule("worldmap")
        return (asNumber(wm and wm:Setting("enlargedSize")) or 80) / 100
    end
    local function logWidth(): number
        return shows(field(f, "QuestLog")) and (asNumber(field(f, "questLogWidth")) or 0) or 0
    end
    local function look(on: boolean)
        if mm then
            tryMethod(mm, on and "SetMinimizedLook" or "SetMaximizedLook")
        end
    end
    -- what keeps its usual size in the scaled window: the quest log, the
    -- side toggle, the coordinates, the size and waypoint buttons (the
    -- header with its controls: the chrome's SetBody)
    local vis: Frame? = nil
    local function usual(r: Region?, k: number)
        if r then
            r:SetScale(1 / k)
        end
    end
    local function scaleTo(k: number)
        f:SetScale(k)
        local sc = part(f, "ScrollContainer")
        local q = find("QuestMapFrame")
        local logShown = logWidth() > 0
        usual(mm, k)
        usual(part(f, "SidePanelToggle"), k)
        usual(frames.asFrame(field(f, "WorldMapTrackingPinButton")), k)
        usual(self.status, k)
        if q and q:GetParent() == f then
            q:SetScale(1 / k)
            q:ClearAllPoints()
            if k == 1 then
                -- the game's place, its top level with the map's
                q:SetPoint("TOPRIGHT", f, "TOPRIGHT", -3, -GAME_MAP_TOP)
                q:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -3, 3)
            else
                -- right beside the map, as tall
                q:SetPoint("TOPLEFT", sc, "TOPRIGHT", 3, 0)
                q:SetPoint("BOTTOMLEFT", sc, "BOTTOMRIGHT", 3, 0)
            end
        end
        if k == 1 then
            chrome:SetBody(nil, 1)
            f:SetHitRectInsets(0, 0, 0, 0)
        else
            -- the part that shows: the header (its usual height) right on
            -- the map, down to the map's (or the log's) bottom right
            local h = chrome.head:GetHeight()
            local v = vis or CreateFrame("Frame", nil, f)
            vis = v
            v:EnableMouse(false)
            v:SetScale(1 / k)
            v:ClearAllPoints()
            v:SetPoint("TOPLEFT", f, "TOPLEFT", 0, -((GAME_MAP_TOP - 1) * k - h))
            v:SetPoint("BOTTOMRIGHT", (logShown and q) or sc, "BOTTOMRIGHT", 3, -2)
            -- (the window's units: what's over the window's top, what's
            -- unseen on its right; clicks only where it shows)
            local rise = h / k - (GAME_MAP_TOP - 1)
            local right = logShown and (3 + logWidth()) * (1 - 1 / k) or 3 * (1 - 1 / k)
            chrome:SetBody(v, k, rise, right)
            f:SetHitRectInsets(0, right, math.max(0, -rise), 0)
        end
        -- SuuUI's pins sized for the window's scale
        local wm = SuuUI.GetModule("worldmap")
        if wm then
            tryMethod(wm, "QueueLayout")
        end
        -- the flight map's too, its destinations and Fly bar
        local fm = SuuUI.GetModule("flightmap")
        if fm and fm:IsEnabled() then
            tryMethod(fm, "QueueLayout")
            tryMethod(fm, "PlaceSide")
            tryMethod(fm, "UpdateBar")
        end
        -- the quest details' buttons between the map and the edge again
        self:After(0, function()
            self:PlaceQuestDetails()
        end)
    end
    local function fit()
        if flag(tryMethod(f, "IsMaximized")) then
            return
        end
        if not enlarged() then
            scaleTo(1)
            return
        end
        -- the map larger by a scale (resized from SuuUI's code, the game
        -- refused its pins in combat after: asked 2026-11-05), all else at
        -- its usual size; the window the setting's share of the screen's
        -- height, header included, and narrower than the screen
        local minW, minH = asNumber(field(f, "minimizedWidth")) or 702, asNumber(field(f, "minimizedHeight")) or 534
        local w0, h0 = minW - 5, minH - GAME_MAP_TOP - 2
        local margin = S["space-3"]
        local h = chrome.head:GetHeight()
        local k = (UIParent:GetHeight() * share() - h - 3) / h0
        local roomW = UIParent:GetWidth() - 2 * margin - 5 - logWidth()
        if w0 * k > roomW then
            k = roomW / w0
        end
        scaleTo(math.max(k, 1))
    end
    local function setEnlarged(on: boolean)
        self:Set("mapEnlarged", on)
        look(on)
        fit()
        -- enlarged in the middle of the screen, small in the window row
        -- under the micro menu
        UI.CenterWindow(f, on)
    end
    if mm then
        -- the game minimizes on every open (to its own state): only the
        -- buttons' clicks change the size
        tryMethod(mm, "SetOnMaximizedCallback", function() end)
        tryMethod(mm, "SetOnMinimizedCallback", function() end)
        local max, min = button(mm, "MaximizeButton"), button(mm, "MinimizeButton")
        if max then
            hookScript(max, "OnClick", function()
                setEnlarged(true)
            end)
        end
        if min then
            hookScript(min, "OnClick", function()
                setEnlarged(false)
            end)
        end
    end
    -- the game's fullscreen, chosen before (its setting): enlarged instead
    -- (0.47: the module's CVar, held at 1 while it is on; the player's
    -- value back when it's off. Written also when it already is 1: on a
    -- character that played with SuuUI before 0.47 SuuUI's own 1 is
    -- there, and the game's default stands in for the player's)
    local fullscreen = not GetCVarBool("miniWorldMap")
    self:SetCVar("miniWorldMap", 1, { seedDefault = true })
    if fullscreen then
        self:Set("mapEnlarged", true)
    end
    hook(f, "Minimize", fit)
    if field(f, "SetQuestLogPanelShown") then
        hook(f, "SetQuestLogPanelShown", fit)
    end
    -- (enlarged: in the exact middle, over the cast bar as the game's
    -- fullscreen map; risen above it, it went to the screen's top)
    UI.CenterWindow(f, enlarged(), { overCastBar = true })
    hookScript(f, "OnShow", function()
        look(enlarged())
        fit()
    end)
    self:On("SUUUI_SETTING_CHANGED", function(_, namespace: string, key: string)
        if namespace == "worldmap" and key == "enlargedSize" and f:IsShown() then
            fit()
        end
    end)
    -- a theme can change the header's height
    self:On("SUUUI_THEME_CHANGED", function()
        if f:IsShown() and not InCombatLockdown() then
            fit()
        end
    end)
    fit()
end
