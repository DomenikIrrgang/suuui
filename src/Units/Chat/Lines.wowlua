-- Units/Chat/Lines.wowlua
-- The chat's lines as text (Units/Chat): Blizzard's finished line in the
-- design's form, as plain text, dimmed, as saved in the kept chat, and the
-- divider's rules. Pure text work: what it reads of the world (the
-- settings, Blizzard's timestamp format, a name's class) comes in as
-- arguments, so the chat module and the tests call it alike.

import SuuUI from "/Core/API"
import isSecret from "wowlua:secret"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import isColor, rgba, hex as colorHex from "/UI/Draw"

local T = SuuUI.Tokens

-- a value that's there and readable
type Readable = string | number | boolean | table | (...unknown) -> ...unknown
export function plain(v: unknown): v is Readable
    return v ~= nil and not isSecret(v)
end

export const DIAMOND = "Interface\\AddOns\\SuuUI\\Media\\Textures\\ChatDiamond.tga"
local WHITE = "Interface\\Buttons\\WHITE8X8"

-- The names' classes in a line, in the order they come (false: none found).
export type Classes = { [number]: string | false }
-- What follows the author in Blizzard's line, and the tag the design puts
-- first ("" for none).
export type Verb = { tail: string, tag: string }
-- A line as saved in the kept chat.
export type Saved = { text: string, at: number, rgb?: string, who?: string }

-- What a line is formatted with: the chat's settings, Blizzard's timestamp
-- as a pattern (nil: none, or SuuUI's time is off), the verbs, and a name's
-- class (`lineID` nil for a line from an earlier session).
export type FormatOptions = {
    diamonds: boolean,
    short: boolean,
    colored: boolean,
    stamp: string?,
    verbs: Verb[],
    classOf: (name: string?, lineID: string?) -> string?,
}

local function tail(fmt: unknown): string?
    return type(fmt) == "string" and fmt:match("^%%s(.+)$") or nil
end

-- A verb from one of Blizzard's formats ("%s says: "), or nil when it
-- isn't one.
export function verb(fmt: unknown, tag: string): Verb?
    local t = tail(fmt)
    return t and { tail = t, tag = tag } or nil
end

export function stripColour(s: string): string
    return (s:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", ""))
end

-- Blizzard's own timestamp (its option in Social) as a pattern for the
-- start of a line: its date format with the numbers as wildcards.
local stampFormat, stampPattern
export function stampPatternOf(fmt: unknown): string?
    if not plain(fmt) or type(fmt) ~= "string" or fmt == "" or fmt == "none" then
        return nil
    end
    if fmt ~= stampFormat then
        stampFormat = fmt
        local out = {}
        local i = 1
        while i <= #fmt do
            local c = fmt:sub(i, i)
            if c == "%" and i < #fmt then
                local k = fmt:sub(i + 1, i + 1)
                out[#out + 1] = (k == "p") and "[AaPp]%.?[Mm]%.?" or "%d+"
                i = i + 2
            else
                out[#out + 1] = c:gsub("%p", "%%%0")
                i = i + 1
            end
        end
        stampPattern = table.concat(out)
    end
    return stampPattern
end

export function stripStamp(text: string, pattern: string?): string
    if not pattern then
        return text
    end
    local rest = text:match("^" .. pattern .. "(.*)$")
    if rest then
        return rest
    end
    -- coloured
    local colour = text:match("^|c%x%x%x%x%x%x%x%x")
    if colour then
        rest = text:sub(11):match("^" .. pattern .. "|r(.*)$")
        if rest then
            return rest
        end
    end
    return text
end

-- The class diamond in a class's colour ("" for none).
export function chip(class: string?): string
    local token = class and "class-" .. class:lower()
    if not (token and isColor(token)) then
        return ""
    end
    local r, g, b = rgba(token)
    return ("|T%s:0:0:0:0:32:32:0:32:0:32:%d:%d:%d|t"):format(
        DIAMOND,
        math.floor(r * 255 + 0.5),
        math.floor(g * 255 + 0.5),
        math.floor(b * 255 + 0.5)
    )
end

-- Blizzard's finished line → the design's (without the time). `id`: the
-- line's id for the diamond's copy link. `old`: a line kept from an earlier
-- session (its line ids mean nothing now). `classes`: the names' classes in
-- the order they come, filled the first time and read when the line is
-- formatted again (a theme's new colours), so a name keeps the class it was
-- shown with.
export function formatLine(text: string, id: number?, old: boolean?, classes: Classes?, o: FormatOptions): string
    local diamonds, short, colored = o.diamonds, o.short, o.colored
    -- SuuUI shows the time: Blizzard's own goes
    text = stripStamp(text, o.stamp)
    -- channel tags: no brackets, numbered ones without the zone
    if short then
        text = text:gsub("(|Hchannel:[^|]*|h)%[(.-)%](|h)", function(open, label, close)
            return open .. label:gsub("%s+%-%s+.*$", "") .. close
        end)
    end
    -- the say/yell/whisper verb after the first name → a tag before it
    local head, link, rest = text:match("^(.-)(|Hplayer:.-|h.-|h)(.*)$")
    if head and link and rest then
        for _, v in ipairs(o.verbs) do
            if rest:sub(1, #v.tail) == v.tail then
                text = head .. (v.tag ~= "" and (v.tag .. " ") or "") .. link .. ": " .. rest:sub(#v.tail + 1)
                break
            end
        end
    end
    -- names: no brackets, the class diamond first, the name in its class
    -- colour (or the line's)
    local k = 0
    text = text:gsub("|Hplayer:([^|]*)|h%[(.-)%]|h", function(data, shown)
        local name, lineID = data:match("^([^:]+):?(%d*)")
        k = k + 1
        local class: string? = nil
        local known: string | false | nil = nil
        if classes then
            known = classes[k]
        end
        if known ~= nil then
            if known then
                class = known
            end
        elseif diamonds or colored then
            class = o.classOf(name, (not old and lineID ~= "") and lineID or nil)
            if classes then
                classes[k] = class or false
            end
        end
        local mark = diamonds and chip(class) or ""
        -- the diamond copies the line (asked 2026-10-18)
        if mark ~= "" and id then
            mark = "|Haddon:suuui:copy:" .. id .. "|h" .. mark .. "|h"
        end
        local token = colored and class and "class-" .. class:lower()
        local label = stripColour(shown)
        if token and isColor(token) then
            label = "|cff" .. colorHex(token) .. label .. "|r"
        end
        return mark .. "|Hplayer:" .. data .. "|h" .. label .. "|h"
    end)
    text = text:gsub("(|HBNplayer:[^|]*|h)%[(.-)%](|h)", "%1%2%3")
    return text
end

-- A line as plain text: its time, tag, name and message, links as their
-- labels, without colours, icons or the diamond.
export function plainLine(text: string): string
    text = text:gsub("|T.-|t", ""):gsub("|A.-|a", "")
    text = text:gsub("|H.-|h(.-)|h", "%1")
    text = text:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", "")
    return (text:gsub("^%s+", ""))
end

--------------------------------------------------------------------------------
-- Kept chat
--------------------------------------------------------------------------------

export function rgbHex(r: unknown, g: unknown, b: unknown): string?
    if not (plain(r) and plain(g) and plain(b)) then
        return nil
    end
    if type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then
        return nil
    end
    local function c(v: number): number
        return math.max(0, math.min(255, math.floor(v * 255 + 0.5)))
    end
    return ("%02x%02x%02x"):format(c(r), c(g), c(b))
end

export function hexRGB(hex: unknown): (number?, number?, number?)
    if type(hex) ~= "string" or not hex:match("^%x%x%x%x%x%x$") then
        return nil
    end
    return (tonumber(hex:sub(1, 2), 16) or 0) / 255,
        (tonumber(hex:sub(3, 4), 16) or 0) / 255,
        (tonumber(hex:sub(5, 6), 16) or 0) / 255
end

-- A line as saved, or nil for one that mustn't be (secret, empty, a
-- Battle.net name's |K code, no readable time).
export function keptLine(text: unknown, r: unknown, g: unknown, b: unknown, at: unknown): Saved?
    if not plain(text) or type(text) ~= "string" or text == "" or text:find("|K", 1, true) then
        return nil
    end
    if not plain(at) or type(at) ~= "number" then
        return nil
    end
    return { text = text, at = at, rgb = rgbHex(r, g, b) }
end

-- An earlier line dimmed: its colours (and the class diamond's) at `dim`
-- over the dark ground (a line can't have an alpha of its own).
local DIAMOND_COLOURED = "(|T" .. DIAMOND:gsub("%p", "%%%0") .. "[^|]-):(%d+):(%d+):(%d+)|t"
export function dimmed(text: string, dim: number): string
    local function dimByte(v: string | number | nil): number
        return math.floor((tonumber(v) or 0) * dim + 0.5)
    end
    text = text:gsub("|c(%x%x)(%x%x)(%x%x)(%x%x)", function(a, r, g, b)
        return ("|c%s%02x%02x%02x"):format(
            a,
            dimByte(tonumber(r, 16)),
            dimByte(tonumber(g, 16)),
            dimByte(tonumber(b, 16))
        )
    end)
    return (text:gsub(DIAMOND_COLOURED, function(head, r, g, b)
        return ("%s:%d:%d:%d|t"):format(head, dimByte(r), dimByte(g), dimByte(b))
    end))
end

-- "just now", "5 min ago", "2 h ago", "3 days ago"
export function ago(seconds: number): string
    if seconds < 90 then
        return "just now"
    end
    if seconds < 3600 then
        return math.floor(seconds / 60 + 0.5) .. " min ago"
    end
    if seconds < 48 * 3600 then
        return math.floor(seconds / 3600 + 0.5) .. " h ago"
    end
    return math.floor(seconds / 86400 + 0.5) .. " days ago"
end

-- The divider's gilt-line rule, fading out towards its far end: in steps,
-- each darker towards the glass (a texture in a line can't fade).
export function rule(width: number, rising: boolean): string
    local c, steps, out = T.color["gilt-line"], 6, {}
    local each = math.floor(width / steps)
    for i = 1, steps do
        local k = (rising and i or (steps + 1 - i)) / steps * c[4] * 255
        local w = (i == steps) and (width - each * (steps - 1)) or each
        if w > 0 then
            out[#out + 1] = ("|T%s:1:%d:0:0:8:8:0:8:0:8:%d:%d:%d|t"):format(
                WHITE,
                w,
                math.floor(c[1] * k + 0.5),
                math.floor(c[2] * k + 0.5),
                math.floor(c[3] * k + 0.5)
            )
        end
    end
    return table.concat(out)
end

--------------------------------------------------------------------------------
-- Chat types by colour
--------------------------------------------------------------------------------

-- Whisper lines are told by their event, else by Blizzard's colour for the
-- whisper chat types.
local WHISPER_TYPES = { "WHISPER", "WHISPER_INFORM", "BN_WHISPER", "BN_WHISPER_INFORM" }

-- Whether a line's colour is a chat type's (`info`: its ChatTypeInfo entry).
export function sameColor(info: unknown, r: unknown, g: unknown, b: unknown): boolean
    local ir, ig, ib = secret.asNumber(tbl.field(info, "r")),
        secret.asNumber(tbl.field(info, "g")),
        secret.asNumber(tbl.field(info, "b"))
    if not (ir and ig and ib) or type(r) ~= "number" or type(g) ~= "number" or type(b) ~= "number" then
        return false
    end
    return math.abs(ir - r) < 0.01 and math.abs(ig - g) < 0.01 and math.abs(ib - b) < 0.01
end

-- `types`: Blizzard's ChatTypeInfo (the live one by default).
export function isWhisperLine(
    r: unknown,
    g: unknown,
    b: unknown,
    event: unknown,
    types: unknown = ChatTypeInfo
): boolean
    if type(event) == "string" and not isSecret(event) then
        return event:find("WHISPER", 1, true) ~= nil
    end
    if isSecret(r) or isSecret(g) or isSecret(b) then
        return false
    end
    for _, t in ipairs(WHISPER_TYPES) do
        if sameColor(tbl.field(types, t), r, g, b) then
            return true
        end
    end
    return false
end
