-- Units/Chat/Windows.wowlua
-- Blizzard's chat windows (Units/Chat): a window's ID, its name and font
-- size, a game global that is a frame; Settings › Chat › Windows, the
-- editor of them (a row per window: name, size, Blizzard's chat settings,
-- close; a new window), which takes the module it acts on; and what the
-- module does to the windows (closing one, a font size, a name, Blizzard's
-- chat settings for one, a new window, a whisper window opened).

import SuuUI from "/Core/API"
import type TextField, Stepper, SuuButton from "/Core/API"
import type ChatModule from "../Chat"
import askText from "./Panel"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as errors from "wowlua:errors"
import * as frames from "wowlua:frames"
import * as chat from "wowlua:chat"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local field, asString, asNumber = tbl.field, secret.asString, secret.asNumber

-- One of Blizzard's chat windows.
type Window = chat.Window

-- A window's ID.
export function idOf(cf: Window): number
    return cf:GetID()
end

-- A window's name in Blizzard's settings, when readable.
export function windowName(cf: Window): string?
    return asString((GetChatWindowInfo(idOf(cf))))
end

-- A window's font size: Blizzard's setting for it; a whisper window (no
-- saved settings) keeps the one chosen in SuuUI's tab menu.
local tempSizes: { [Window]: number } = {}
export function fontSize(cf: Window): number
    local temp = tempSizes[cf]
    if temp then
        return temp
    end
    local size = asNumber(select(2, errors.try(field(_G, "FCF_GetChatWindowInfo"), idOf(cf))))
    if not size or size <= 0 then
        return 13
    end
    return size
end

-- The value of a game global, when it is a frame.
export function globalFrame(name: string): Frame?
    return frames.find(name)
end

--------------------------------------------------------------------------------
-- Settings › Chat › Windows: each window (whisper windows aside) with its
-- name, font size, Blizzard's chat settings for it and closing; a new one.
--------------------------------------------------------------------------------

local EDIT_W, ROW_H = 520, 38

export class WindowRow extends Frame
    readonly name: TextField
    readonly size: Stepper
    readonly config: SuuButton
    readonly close: Button
    cf: Window? = nil

    constructor(m: ChatModule, parent: Frame)
        super(nil, parent)
        self:SetSize(EDIT_W - 12, ROW_H)
        self.name = UI.TextField(self, {
            width = 200,
            onChange = function(text: string)
                local cf = self.cf
                if cf then
                    m:RenameWindow(cf, strtrim(text))
                end
            end,
        })
        self.name:SetPoint("LEFT")
        self.size = UI.Stepper(self, {
            min = 8,
            max = 24,
            step = 1,
            unit = "px",
            onChange = function(v: number)
                local cf = self.cf
                if cf then
                    m:SetFontSize(cf, v)
                end
            end,
        })
        SuuUI.Layout.Follow(self, function()
            self.size:SetPoint("LEFT", self.name, "RIGHT", S["space-4"], 0)
        end)
        self.config = UI.Button(self, {
            text = "Chat settings…",
            onClick = function()
                local cf = self.cf
                if cf then
                    m:OpenChatSettings(cf)
                end
            end,
            tooltip = {
                title = "Chat settings",
                description = "Blizzard's settings for this window: which channels and messages it shows.",
            },
        })
        SuuUI.Layout.Follow(self, function()
            self.config:SetPoint("LEFT", self.size, "RIGHT", S["space-4"], 0)
        end)
        self.close = UI.CloseButton(self, function()
            local cf = self.cf
            if cf then
                m:CloseWindow(cf)
            end
        end)
        SuuUI.Layout.Follow(self, function()
            self.close:SetPoint("RIGHT", -S["space-2"], 0)
        end)
    end
end

export class WindowsEditor extends Frame
    readonly rows: WindowRow[] = {}
    readonly well: Frame
    readonly add: SuuButton

    constructor(readonly m: ChatModule, parent: Frame)
        super(nil, parent)
        self:SetSize(EDIT_W, 100)
        self.well = CreateFrame("Frame", nil, self)
        UI.Fill(self.well, "surface-sunk"):SetAllPoints()
        UI.Border(self.well, "gilt-faint")
        self.well:SetPoint("TOPLEFT")
        self.add = UI.Button(self, {
            text = "New window",
            onClick = function()
                askText("New window", "", "A name · Enter makes it · Esc cancels", function(name: string)
                    m:NewWindow(name)
                end)
            end,
        })
        m.windowsEditor = self
        self:Refresh()
        self:HookScript("OnShow", function()
            self:Refresh()
        end)
    end

    function Refresh()
        for _, r in ipairs(self.rows) do
            r:Hide()
        end
        local y = 6
        local i = 0
        for _, cf in ipairs(self.m:Windows()) do
            if not chat.isTemporary(cf) then
                i = i + 1
                local r = self.rows[i] or WindowRow.new(self.m, self.well)
                self.rows[i] = r
                r.cf = cf
                r.name:SetValue(windowName(cf) or "")
                r.size:SetValue(fontSize(cf))
                r.config:SetShown(ChatConfigFrame ~= nil)
                r.close:SetShown(cf ~= ChatFrame1 and cf ~= ChatFrame2 and field(_G, "FCF_Close") ~= nil)
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", 6, -y)
                r:Show()
                y = y + ROW_H
            end
        end
        local wellH = y + 6
        self.well:SetSize(EDIT_W, wellH)
        local canOpen = field(_G, "FCF_CanOpenNewWindow")
        local canNew = field(_G, "FCF_OpenNewWindow") ~= nil and (not canOpen or secret.flag(errors.try(canOpen)))
        self.add:SetShown(canNew)
        self.add:ClearAllPoints()
        self.add:SetPoint("TOPLEFT", 0, -(wellH + 10))
        self:SetHeight(wellH + (canNew and (10 + 30) or 0))
    end
end

--------------------------------------------------------------------------------
-- What the module does to the windows
--------------------------------------------------------------------------------

export function closeWindow(self: ChatModule, cf: Window)
    errors.try(field(_G, "FCF_Close"), cf)
    if self.selected == cf then
        self:Select(ChatFrame1)
    else
        self:UpdateTabs()
    end
    local editor = self.windowsEditor
    if editor and editor:IsVisible() then
        editor:Refresh()
    end
end

-- Sizes and names go through the client's own chat window settings;
-- Blizzard's chat settings open on the window.
export function setFontSize(self: ChatModule, cf: Window, size: number)
    if chat.isTemporary(cf) then
        tempSizes[cf] = size
    else
        errors.try(SetChatWindowSize, idOf(cf), size)
    end
    if self:ApplyFont(cf) then
        self:ApplyMirrorFont(cf)
    end
end

export function renameWindow(self: ChatModule, cf: Window, name: string)
    if name == "" or chat.isTemporary(cf) then
        return
    end
    errors.try(SetChatWindowName, idOf(cf), name)
    self:UpdateTabs()
end

export function openChatSettings(self: ChatModule, cf: Window)
    local config = ChatConfigFrame
    if not config then
        return
    end
    -- the window Blizzard's chat settings act on (its tab menu sets it so)
    CURRENT_CHAT_FRAME_ID = idOf(cf)
    if config:IsShown() then
        HideUIPanel(config)
    end
    ShowUIPanel(config)
end

export function newWindow(self: ChatModule, name: string)
    local open = field(_G, "FCF_OpenNewWindow")
    if name == "" or not open then
        return
    end
    local cf = chat.asWindow(errors.try(open, name))
    self:After(0, function()
        self:SkinAll()
        if cf and self.mirrors[cf] then
            self:Select(cf)
        end
        local editor = self.windowsEditor
        if editor and editor:IsVisible() then
            editor:Refresh()
        end
    end)
end

-- A whisper window just opened from SuuUI (a name's menu, the Search
-- tab): skinned, the whispers with that player so far put in
-- (Blizzard's starts empty), and shown.
export function openedWindow(self: ChatModule, cf: Window?, name: string?)
    self:After(0, function()
        self:SkinAll()
        local m = cf and self.mirrors[cf]
        if not (cf and m) then
            return
        end
        if name and m.target ~= name:lower() then
            self:FillWhispers(m, name)
        end
        self:Select(cf)
    end)
end

-- The whisper window with a player: the open one (its tab chosen), else a
-- new one.
export function openWhisperWindow(self: ChatModule, name: string)
    local want = name:lower():match("^([^%-]+)")
    for _, cf in ipairs(self:Windows()) do
        local kind, target = chat.conversation(cf)
        if kind == "WHISPER" and target and target:lower():match("^([^%-]+)") == want then
            self:OpenedWindow(cf, name)
            return
        end
    end
    local open = field(_G, "FCF_OpenTemporaryWindow")
    if not open then
        return
    end
    self:OpenedWindow(chat.asWindow(errors.try(open, "WHISPER", name)), name)
end
