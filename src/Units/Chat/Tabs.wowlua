-- Units/Chat/Tabs.wowlua
-- The chat tabs' order and geometry as data (Units/Chat): a window's key
-- in the saved order, the windows in a character's order, where a dragged
-- tab drops, the glide's easing and edit mode's dashed outline.

import * as lines from "./Lines"

local plain = lines.plain

-- What a window offers for its key (a chat frame).
export type Window = { isTemporary?: any, chatTarget?: any, GetID: (self: any) -> number, [string]: any }
-- A dash of the outline: its top left corner inside the frame, its size.
export type Dash = { x: number, y: number, w: number, h: number }

export const DASH = 3
export const GAP_DASH = 2

-- A window's key in the saved order: its window ID, or a whisper's player.
export function tabKey(cf: Window): string?
    if cf.isTemporary then
        local t = cf.chatTarget
        if plain(t) and type(t) == "string" and t ~= "" then return "w:" .. t end
        return nil
    end
    return "id:" .. cf:GetID()
end

-- The windows in a kept order: the kept ones first as kept, then the rest
-- in the starting order (a new whisper tab at the end). `order` loses what
-- it can't keep: a whisper keeps its place only while its tab is open.
export function ordered<W>(windows: W[], order: any[], keyOf: (w: W) -> string?): W[]
    local byKey: { [string]: W }, out: W[], used: { [any]: boolean } = {}, {}, {}
    for _, cf in ipairs(windows) do
        local k = keyOf(cf)
        if k then byKey[k] = cf end
    end
    for i = #order, 1, -1 do
        local k = order[i]
        if type(k) ~= "string" or (k:sub(1, 2) == "w:" and not byKey[k]) then table.remove(order, i) end
    end
    for _, k in ipairs(order) do
        local cf = byKey[k]
        if cf and not used[cf] then used[cf] = true; out[#out + 1] = cf end
    end
    for _, cf in ipairs(windows) do
        if not used[cf] then out[#out + 1] = cf end
    end
    return out
end

-- The keys of windows in order, those without one left out.
export function keysOf<W>(list: W[], keyOf: (w: W) -> string?): string[]
    local keys: string[] = {}
    for _, cf in ipairs(list) do
        local k = keyOf(cf)
        if k then keys[#keys + 1] = k end
    end
    return keys
end

-- A dragged tab's place among the others: after every other tab whose
-- middle its own middle has passed. `mids`: the others' middles in order
-- (false: one without a tab).
export function dropIndex(mids: (number | false)[], centre: number): number
    local index = 1
    for i, mid in ipairs(mids) do
        if mid and mid < centre then index = i + 1 end
    end
    return index
end

-- The glide's easing (smoothstep).
export function smooth(t: number): number return t * t * (3 - 2 * t) end

-- A dashed outline of w × h: 3 px dashes, 2 px gaps, `px` thick, inside
-- its edge (top and bottom first, then the sides between them).
export function dashes(w: number, h: number, px: number): Dash[]
    local out: Dash[] = {}
    local step = DASH + GAP_DASH
    for x = 0, w - 1, step do
        local dw = math.min(DASH, w - x)
        out[#out + 1] = { x = x, y = 0, w = dw, h = px }
        out[#out + 1] = { x = x, y = h - px, w = dw, h = px }
    end
    for y = step, h - step, step do
        local dh = math.min(DASH, h - y)
        out[#out + 1] = { x = 0, y = y, w = px, h = dh }
        out[#out + 1] = { x = w - px, y = y, w = px, h = dh }
    end
    return out
end
