-- Units/Campsite.wowlua
-- Campfires (step 2.8): what a fire does for you, said through SuuUI's
-- alerts (the band in the middle of the screen that warns of aggro), as
-- each phase begins. Camping has no window: everything comes from your own
-- auras (probed 2026-10-13).
--   Campfire Nearby (1283391)      → "Campfire nearby", until you rest
--                                    (or for General › Campfire's seconds)
--   Welcoming Campfire (1229739)   → "Resting by the fire", counting down
--                                    the minute seated
--   Camp Benefits (1229741)        → "Camp Benefits" for a few seconds
-- Camp Benefits wins over Welcoming Campfire (it comes back every minute
-- while you stay seated). Combat alerts outrank these (info tone), and
-- combat ending clears them. Fires you pass (not the ones you light: those
-- go out) are remembered per character for the world map (3.5).
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import after, every from "wowlua:timer"

local M = SuuUI.RegisterModule({
    id = "campsite",
    name = "Campfire",
    description = "Alerts at a campfire: one is near, resting by it, Camp Benefits gained.",
    api = "0.12",
    combatSafe = true,
    defaults = {
        nearbyFor = 0, -- seconds the "Campfire nearby" alert stays; 0: until you rest or walk away
    },
})

local KEY = "suu:campfire"
local NEARBY, WELCOMING, BENEFITS = 1283391, 1229739, 1229741
local LIGHT_FIRE = 1307227 -- Basic Campfire (the kit's spell)
local BRIEF = 6            -- seconds a "nearby" or "benefits" alert stays
local MAX_FIRES = 100

local function clock(s: number): string
    s = math.max(0, math.floor(s + 0.5))
    if s >= 3600 then return ("%dh"):format(s / 3600) end
    if s >= 600 then return ("%dm"):format(s / 60) end
    return ("%d:%02d"):format(s / 60, s % 60)
end

-- One of your auras by spell, or nil; false when it can't be read (combat).
-- (a secret aura reads as one that can't be read)
local function aura(spellID: number): AuraData | false | nil
    local ok, a = pcall(C_UnitAuras.GetPlayerAuraBySpellID, spellID)
    if not ok or issecretvalue(a) then return false end
    return a
end

--------------------------------------------------------------------------------
-- Phases and their alerts
--------------------------------------------------------------------------------

-- "nearby", "resting", "rested" or nil; false when auras can't be read.
function M:Phase()
    local near, welcoming, benefits = aura(NEARBY), aura(WELCOMING), aura(BENEFITS)
    if near == false or welcoming == false or benefits == false then return false end
    if not near and not welcoming then return nil, nil end
    if benefits then return "rested", benefits end
    if welcoming then return "resting", welcoming end
    return "nearby", nil
end

-- What Camp Benefits does: its tooltip's text after the name, out of
-- combat, as the alert's lines. The text is a heading ("Gained the following
-- camp benefits:") and a line per benefit, "Tent: You received …" (found in
-- game): the heading and the time left are dropped, bullets stripped, each
-- benefit a line with its name in ink and what it does in ink-muted.
local MAX_LINE = 110
local function effectOf(a: any?): (string?, number?)
    if not a or issecretvalue(a.auraInstanceID) or not a.auraInstanceID then return nil end
    if not (C_TooltipInfo and C_TooltipInfo.GetUnitBuffByAuraInstanceID) then return nil end
    local ok, data = pcall(C_TooltipInfo.GetUnitBuffByAuraInstanceID, "player", a.auraInstanceID)
    if not ok or not data or issecretvalue(data) or type(data.lines) ~= "table" then return nil end
    local muted = SuuUI.Tokens.color["ink-muted"].hex
    local out = {}
    for i = 2, #data.lines do
        local text = data.lines[i].leftText
        if not issecretvalue(text) and text then
            for line in text:gmatch("[^\r\n]+") do
                line = line:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", "")
                line = line:gsub("^[%s%-%*•·]+", ""):gsub("%s+$", "")
                if line ~= "" and not line:find(":$") and not line:lower():find("remaining", 1, true) then
                    if #line > MAX_LINE then line = line:sub(1, MAX_LINE):gsub("%s+%S*$", "") .. "…" end
                    local name, rest = line:match("^([^:]+):%s+(.+)$")
                    out[#out + 1] = name and rest and (name .. ": |cff" .. muted .. rest .. "|r") or line
                end
            end
        end
    end
    if #out == 0 then return nil end
    return table.concat(out, "\n"), #out
end

local function restLeft(a: any?): number?
    if not a then return nil end
    local x = a.expirationTime
    if not issecretvalue(x) and x and x > 0 then return x - GetTime() end
end

function M:Alert(phase: string?, a: any?)
    if self.briefTimer then self.briefTimer:Cancel(); self.briefTimer = nil end
    self.rested = nil
    if self.ticker then self.ticker:Cancel(); self.ticker = nil end
    if phase == "nearby" then
        -- (flying over one: no fire to sit at; asked 2026-10-19)
        if UnitOnTaxi("player") then SuuUI.HideAlert(KEY) return end
        -- stays until you rest (or walk away), or for the setting's seconds
        SuuUI.ShowAlert(KEY, "info", "Campfire nearby", "Sit for a minute: an hour of Camp Benefits")
        local stay = self:Get("nearbyFor")
        if not stay or stay <= 0 then return end
        self.briefTimer = after(stay, function()
            self.briefTimer = nil
            SuuUI.HideAlert(KEY)
        end)
        return
    elseif phase == "resting" then
        local function show()
            local left = restLeft(a)
            SuuUI.ShowAlert(KEY, "info", "Resting by the fire", left and ("Camp Benefits in " .. clock(left)) or "Stay seated for a minute")
        end
        show()
        self.ticker = every(0.5, show)
        return
    elseif phase == "rested" then
        -- what you gained, with the time in the title
        local left = restLeft(a)
        local title = (left and left < 3500) and ("Camp Benefits · " .. clock(left) .. " left") or "Camp Benefits gained · 1h"
        local effect, count = effectOf(a)
        if a and a.effect then effect, count = a.effect(), 2 end
        SuuUI.ShowAlert(KEY, "info", title, effect or "For the next hour")
        self.rested = { title = title, a = a }
        -- longer with more to read: 6 s and 2 more per benefit, at most 16
        self.briefTimer = after(math.min(16, BRIEF + 2 * (count or 1)), function()
            self.briefTimer = nil
            SuuUI.HideAlert(KEY)
        end)
        return
    else
        SuuUI.HideAlert(KEY)
        return
    end
    self.briefTimer = after(BRIEF, function()
        self.briefTimer = nil
        SuuUI.HideAlert(KEY)
    end)
end

function M:Update()
    local phase, a = self:Phase()
    if phase == false then return end -- in combat: as it was
    if phase == self.phase then return end
    local was = self.phase
    self.phase = phase
    -- walking away: its alert goes
    if not phase then
        self:Alert(nil)
        return
    end
    -- a fire you just walked up to while already rested: say how long is left
    if was == nil and phase == "rested" then
        self:Alert("rested", a)
        return
    end
    self:Alert(phase, a)
end

--------------------------------------------------------------------------------
-- Fires you pass, for the map
--------------------------------------------------------------------------------

function M:RememberFire()
    -- a fire you just lit yourself goes out: not one to remember
    if self.litAt and GetTime() - self.litAt < 10 then return end
    local map = C_Map.GetBestMapForUnit("player")
    if issecretvalue(map) or not map then return end
    local pos = C_Map.GetPlayerMapPosition(map, "player")
    if not pos then return end
    local x, y = pos:GetXY()
    if not (not issecretvalue(x) and not issecretvalue(y) and x and y) then return end
    local data = self:CharData()
    data.fires = data.fires or {}
    for _, f in ipairs(data.fires) do
        if f.map == map and math.abs(f.x - x) < 0.01 and math.abs(f.y - y) < 0.01 then
            f.seen = time()
            return
        end
    end
    table.insert(data.fires, { map = map, x = x, y = y, seen = time() })
    while #data.fires > MAX_FIRES do table.remove(data.fires, 1) end
end

--------------------------------------------------------------------------------
-- Settings and a look without a fire
--------------------------------------------------------------------------------

function M:Sample(phase: string?)
    local fake = { expirationTime = GetTime() + (phase == "resting" and 42 or 3600), effect = function()
        local muted = SuuUI.Tokens.color["ink-muted"].hex
        return "Tent: |cff" .. muted .. "(here: what it does, read from the buff itself)|r\nMana Well: |cff" .. muted
            .. "(and each other benefit on its own line)|r"
    end }
    self:Alert(phase or "nearby", fake)
    if phase ~= "rested" then
        -- a sample doesn't stay
        self.briefTimer = after(BRIEF, function()
            self.briefTimer = nil
            if self.ticker then self.ticker:Cancel(); self.ticker = nil end
            SuuUI.HideAlert(KEY)
        end)
    end
end

local SECTION = {
    id = "campsite", label = "Campfire", category = "General", order = 26,
    groups = {
        { title = "Campfire alerts", description = "At a campfire SuuUI's alerts say what it does for you: a fire is near, the minute seated counting down, then Camp Benefits gained. They need the Alerts module; combat alerts come first.", rows = {
            { key = "nearbyFor", label = "\"Campfire nearby\" stays", control = "slider", min = 0, max = 60, step = 5,
              format = function(v: number): string return v == 0 and "Until you rest" or (v .. " s") end,
              description = "Until you sit down and rest (or walk away), or only this many seconds." },
            { label = "Show them", control = "button", text = "Nearby, resting, rested",
              description = "Each alert in turn, without a fire.",
              onClick = function()
                  M:Sample("nearby")
                  after(BRIEF + 0.5, function() M:Sample("resting") end)
                  after(BRIEF * 2 + 1, function() M:Sample("rested") end)
              end },
        } },
    },
}

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

function M:OnEnable()
    SuuUI.AllowAlertOutOfCombat(KEY)
    self:RegisterSettings(SECTION)
    self:OnUnitEvent("UNIT_AURA", { "player" }, function()
        local wasNear = self.near
        local near = aura(NEARBY)
        if near ~= false then
            self.near = near and true or false
            if self.near and not wasNear then self:RememberFire() end
        end
        self:Update()
    end)
    self:OnUnitEvent("UNIT_SPELLCAST_SUCCEEDED", { "player" }, function(_, _, _, spellID)
        if not issecretvalue(spellID) and spellID == LIGHT_FIRE then self.litAt = GetTime() end
    end)
    -- combat ending clears every alert: say again what still holds (after the
    -- Alerts module has cleared)
    self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
        after(0.2, function() self.phase = "unknown"; self:Update() end)
    end)
    self:RegisterCommand("campsite", "The campfire alerts without a fire: /suu campsite nearby, resting or rested.", function(arg)
        self:Sample((arg == "resting" or arg == "rested") and arg or "nearby")
    end)
    -- after a login or /reload by a fire: the alert for where you are, once
    -- the game has your auras (and the Alerts module is up)
    local function sayNow()
        after(1, function()
            if not self:IsEnabled() then return end
            self.near = aura(NEARBY) and true or false
            self.phase = "unknown"
            self:Update()
        end)
    end
    self:OnGameEvent("PLAYER_ENTERING_WORLD", sayNow)
    sayNow()
    -- the benefits' lines carry a colour code: shown again while up
    self:On("SUUUI_THEME_CHANGED", function()
        local r = self.rested
        if not (r and self.briefTimer) or InCombatLockdown() then return end
        local effect = r.a and r.a.effect and r.a.effect() or effectOf(r.a)
        SuuUI.ShowAlert(KEY, "info", r.title, effect or "For the next hour")
    end)
end

function M:OnDisable()
    if self.ticker then self.ticker:Cancel(); self.ticker = nil end
    if self.briefTimer then self.briefTimer:Cancel(); self.briefTimer = nil end
    SuuUI.HideAlert(KEY)
end
