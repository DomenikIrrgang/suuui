-- Units/Threat.wowlua
-- The threat meter and the pull warning (step 1.11). A built-in module
-- written against the public API only.
--
-- The meter: your target's threat table, in combat with a hostile target
-- (Show "In combat"; "Always" keeps it on screen, empty without one),
-- left of the damage meter in the bottom right corner (its right edge 292px
-- from the screen's, 28px up), as tall as the damage meter (its Rows; 8
-- while that module is off). Rows by % (ranked)
-- while the client lets SuuUI compare it; when the % is secret (bosses), by
-- threat state, then group order. The state (UnitThreatSituation) stays
-- readable in combat, so the badges and the warning work everywhere.
--
-- The warning: an amber alert "You're about to pull" while you're over the
-- tank's threat but not yet holding the mob (status 1), with your threat drop
-- if it's ready; an ember "You have drawn aggro" once you hold it (status
-- 2-3) and aren't the tank: in a group, or (setting) while your pet is on the
-- mob's threat table, so a hunter or warlock pulling off the pet hears it.
-- Both go when the reason does.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type ThreatMeter, ThreatEntry, ThreatOptions from "/UI/ThreatMeter"
import type AlertTone, FormatArg from "/UI/Alert"
import type Position from "/EditMode/EditMode"
import * as secret from "wowlua:secret"

local isNumber = secret.isNumber

local UI = SuuUI.UI

local DEFAULTS = {
    position = { point = "BOTTOMRIGHT", x = -292, y = 28 } :: Position,
    shows = "always",  -- "off" | "combat" | "always"
    who = "group",     -- "group" | "tanks" | "self"
    marker = "role",   -- "role" | "class" | "none"
    raw = true,
    warnPull = true,
    aggroAlert = "pet", -- "off" | "group" | "pet" (in a group, or with your pet on the mob)
    openWorld = true,  -- the alerts outside instances too
}

local M: ThreatModule


local TICK = 0.2

-- What saves you from a mob you pulled, by class (the first one ready shows).
local THREAT_DROPS: { [string]: string[] } = {
    HUNTER = { "Feign Death" },
    ROGUE = { "Feint", "Vanish" },
    PRIEST = { "Fade" },
    MAGE = { "Ice Block" },
    DRUID = { "Cower" },
    PALADIN = { "Divine Shield" },
}

local function playerClass(): string
    local _, class = UnitClass("player")
    return class :: string -- your own class reads plain (used unguarded, as before)
end

-- The first threat drop you know and can use now, by name, or nil. A
-- cooldown's times are secret in combat, but whether it runs (isActive)
-- isn't. This client has no isOnGCD, and the global cooldown makes every
-- spell read as running: while it runs (spell 29515, Forever's GCD
-- reference) each drop keeps what it read before it started.
local GCD_SPELL = 29515
local dropReady: { [string]: boolean } = {}

local function running(id: number): boolean?
    local cd = C_Spell.GetSpellCooldown(id) :: SpellCooldownInfo? -- a table; its fields may be secret
    if not cd then return nil end
    local active = cd.isActive
    if not secret.isSecret(active) and active ~= nil then return active and true or false end
    if isNumber(cd.duration) then return cd.duration > 0 end
    return nil
end

local function readyDrop(): string?
    local gcd = running(GCD_SPELL)
    for _, name in ipairs(THREAT_DROPS[playerClass()] or {}) do
        local info = C_Spell.GetSpellInfo(name)
        local id = info and info.spellID
        if id and not secret.isSecret(id) and IsPlayerSpell(id) then
            if not gcd or dropReady[name] == nil then
                local r = running(id)
                if r ~= nil then dropReady[name] = not r end
            end
            if dropReady[name] then return name end
        end
    end
    return nil
end

--------------------------------------------------------------------------------
-- Reading the threat table
--------------------------------------------------------------------------------

local function roleOf(unit: string): string?
    if unit == "player" then return (SuuUI.Role()) end
    local role = UnitGroupRolesAssigned(unit)
    if secret.isSecret(role) or role == "NONE" then return nil end
    return role
end

-- A row of the threat table (the name and the % may be secret).
type Row = { name?: string | Secret<string>, class?: string, role?: string, status?: number, percent?: number | Secret<number>,
             raw?: number | Secret<number>, you: boolean, unit: string }

-- One unit's row, or nil while it isn't on the target's threat table.
local function sample(unit: string, pet: boolean?): Row?
    if not UnitExists(unit) then return nil end
    local given = UnitThreatSituation(unit, "target")
    local status = isNumber(given) and given or nil
    local ok, _, _, scaled, _, value = pcall(UnitDetailedThreatSituation, unit, "target")
    if not ok then return nil end
    -- off the table: no status and no % (a secret % may still be someone's)
    if status == nil and not secret.isSecret(scaled) and scaled == nil then return nil end
    local _, given = UnitClass(unit)
    local class = not secret.isSecret(given) and given or nil
    return {
        name = (UnitName(unit)), class = (not pet) and class or nil,
        role = pet and "PET" or roleOf(unit), status = status,
        percent = scaled, raw = value, you = unit == "player", unit = unit,
    }
end

-- Every row of the group (you first, pets after their owners), and whether
-- any % is secret.
local function readRows(): (Row[], boolean)
    local rows: Row[], hidden = {}, false
    local function add(unit: string, pet: boolean?)
        local r = sample(unit, pet)
        if r then
            rows[#rows + 1] = r
            if secret.isSecret(r.percent) then hidden = true end
        end
    end
    add("player")
    add("pet", true)
    if secret.flag(IsInRaid()) then
        for i = 1, 40 do
            local u = "raid" .. i
            if UnitExists(u) and not secret.flag(UnitIsUnit(u, "player")) then
                add(u)
                add("raidpet" .. i, true)
            end
        end
    else
        for i = 1, 4 do
            add("party" .. i)
            add("partypet" .. i, true)
        end
    end
    return rows, hidden
end

--------------------------------------------------------------------------------
-- The meter and the warning
--------------------------------------------------------------------------------

-- An enemy with a threat table: never a player or a player's pet or
-- totem (player-controlled: a tester in a battleground got aggro warnings
-- from an enemy player's pet, 2026-10-18).
local function hostileTarget(): boolean
    return UnitExists("target") and secret.flag(UnitCanAttack("player", "target")) and not secret.flag(UnitIsDeadOrGhost("target"))
        and not secret.flag(UnitPlayerControlled("target"))
end

local function inCombat(): boolean
    return InCombatLockdown() or secret.flag(UnitAffectingCombat("player"))
end

-- The alerts this module raised: only those are taken away again (the
-- driver runs every tick, out of combat too while the meter always shows:
-- it told the Alerts module "no aggro" five times a second, found in game).
local raised: { [string]: boolean } = {}

local function alert(key: string, tone: AlertTone, title: string, detail: string, ...: FormatArg)
    raised[key] = true
    SuuUI.ShowAlert(key, tone, title, detail, ...)
end

local function unalert(key: string)
    if not raised[key] then return end
    raised[key] = nil
    SuuUI.HideAlert(key)
end

-- Rows as the meter takes them.
local function entries(rows: Row[]): ThreatEntry[]
    local out: ThreatEntry[] = {}
    for i, r in ipairs(rows) do out[i] = r end
    return out
end

-- Someone in your group meant to hold the mobs: a tank (by role) or a pet,
-- yours or a group member's. Without one (two damage dealers questing
-- together) the alerts fired at every pull (asked in game).
local function groupHasHolder(): boolean
    if UnitExists("pet") then return true end
    local raid = secret.flag(IsInRaid())
    local n = raid and 40 or 4
    for i = 1, n do
        local unit = (raid and "raid" or "party") .. i
        if UnitExists(unit) then
            if roleOf(unit) == "TANK" then return true end
            if UnitExists(raid and ("raidpet" .. i) or ("partypet" .. i)) then return true end
        end
    end
    return false
end

--------------------------------------------------------------------------------
-- Settings and the preview
--------------------------------------------------------------------------------

local SAMPLE: ThreatEntry[] = {
    { name = "Brannoc", class = "WARRIOR", role = "TANK", status = 2, percent = 100, raw = 1842000 },
    { name = "Morrow", class = "ROGUE", role = "DAMAGER", status = 1, percent = 93, raw = 1931000 },
    { name = "Lisset", class = "MAGE", role = "DAMAGER", status = 0, percent = 70, raw = 1674000 },
    { name = "Vosk", class = "WARRIOR", role = "DAMAGER", status = 0, percent = 66, raw = 1336000 },
    { name = "Hadrin", class = "WARRIOR", role = "TANK", status = 0, percent = 58, raw = 1173000 },
    { name = "Veyra", class = "SHAMAN", role = "HEALER", status = 0, percent = 21, raw = 502000 },
}

-- The damage meter's Rows, so both meters are the same height.
local function meterRows(): number
    local dm = SuuUI.GetModule("damagemeter")
    local rows = dm and dm:Get("rows")
    return type(rows) == "number" and rows or 8
end

local function meterOff(): (boolean, string)
    return M:Get("shows") == "off", "Show the threat meter first."
end

local SECTION: SettingsSection = {
    id = "threat", label = "Damage & threat", category = "Insights", order = 50, merge = "damagemeter",
    preview = function(parent: Frame): ThreatMeter return M:PreviewView(parent) end,
    previewTitle = "Live preview · Threat",
    groups = {
        { title = "Threat meter", description = "Your target, in combat. On bosses the client lets SuuUI show each player's threat but not compare it, so the list orders by threat state.", rows = {
            { key = "shows", label = "Show", control = "segmented", stacked = true,
              options = { { value = "off", label = "Off" }, { value = "combat", label = "In combat" }, { value = "always", label = "Always" } },
              description = "In combat: while you fight a hostile target. Always: on screen all the time, empty without a hostile target." },
            { key = "who", label = "Who", control = "segmented", stacked = true, disabled = meterOff,
              options = { { value = "group", label = "Group" }, { value = "tanks", label = "Tanks and me" }, { value = "self", label = "Just me" } } },
            { key = "marker", label = "Before the name", control = "segmented", disabled = meterOff,
              options = { { value = "role", label = "Role icon" }, { value = "class", label = "Class icon" }, { value = "none", label = "None" } } },
            { key = "raw", label = "Raw threat", control = "toggle", disabled = meterOff,
              description = "The threat number before the percent (not on bosses: the client hides it there)." },
            { key = "warnPull", label = "Warn me before I pull", control = "toggle",
              description = "An alert as soon as you pass the tank's (or a pet's) threat, in a group with a tank or a pet. Works on bosses: it needs only the threat state. Needs the Alerts module." },
            { key = "aggroAlert", label = "When I draw aggro", control = "segmented", stacked = true,
              options = { { value = "off", label = "Off" }, { value = "group", label = "In a group" }, { value = "pet", label = "In a group or with my pet" } },
              description = "An ember alert once a mob turns to you and you aren't the tank. In a group: one with a tank or a pet out (not two damage dealers questing together). With my pet: also solo, while your pet is on the mob (not when you open on it before your pet arrives)." },
            { key = "openWorld", label = "In the open world", control = "toggle",
              description = "Both alerts outside dungeons, raids and battlegrounds too. Off: only in instances." },
        } },
    },
}

class ThreatModule extends Module<typeof(DEFAULTS)>
    driver: Frame? = nil
    meter: ThreatMeter? = nil
    preview: ThreatMeter? = nil

    constructor()
        super({
            id = "threat",
            name = "Threat meter",
            description = "Your target's threat in combat, and a warning before you pull.",
            api = "0.10",
            combatSafe = true,
            defaults = DEFAULTS,
        })
    end

    function MeterOpts(byState: boolean): ThreatOptions
        return { show = self:Get("who"), marker = self:Get("marker"), raw = self:Get("raw"), byState = byState }
    end

    -- Whether the alerts apply here: in an instance, or anywhere with Open
    -- world on; in a group with someone to hold the mobs; solo (the aggro
    -- alert's With my pet) with your pet on the mob.
    function AlertsApply(rows: Row[], aggro: boolean?): boolean
        if not self:Get("openWorld") and not secret.flag(IsInInstance()) then return false end
        if secret.flag(IsInGroup()) then return groupHasHolder() end
        if aggro and self:Get("aggroAlert") ~= "pet" then return false end
        for _, r in ipairs(rows) do
            if r.unit == "pet" then return true end
        end
        return false
    end

    function AggroApplies(rows: Row[]): boolean
        if self:Get("aggroAlert") == "off" then return false end
        return self:AlertsApply(rows, true)
    end

    function Warn(rows: Row[])
        local me: Row? = nil
        for _, r in ipairs(rows) do if r.you then me = r end end
        local status = me and me.status
        local tank = me and me.role == "TANK"
        if not isNumber(status) or tank then
            unalert("threat-pull")
            unalert("threat-aggro")
            return
        end
        local drop = readyDrop()
        local dropText = drop and (" · " .. drop .. " ready") or ""
        if status == 1 and self:Get("warnPull") and self:AlertsApply(rows) then
            unalert("threat-aggro")
            -- whoever holds the mob: the first other row at 2-3
            local holder: Row? = nil
            for _, r in ipairs(rows) do
                if not r.you and isNumber(r.status) and r.status >= 2 then holder = r break end
            end
            if holder then
                alert("threat-pull", "warning", "You're about to pull", "%s · over %s's threat%s",
                    (UnitName("target")) or "", holder.name or "", dropText)
            else
                alert("threat-pull", "warning", "You're about to pull", "%s%s", (UnitName("target")) or "", dropText)
            end
        elseif status >= 2 and self:AggroApplies(rows) then
            unalert("threat-pull")
            alert("threat-aggro", "danger", "You have drawn aggro", "%s%s", (UnitName("target")) or "", dropText)
        else
            unalert("threat-pull")
            unalert("threat-aggro")
        end
    end

    function Update()
        local meter = self.meter
        if not meter then return end
        local hostile = hostileTarget()
        local fighting = hostile and inCombat()
        local shows = self:Get("shows")
        local wantMeter = not self:Get("position").hidden and (shows == "always" or (shows == "combat" and fighting))
        local rows: Row[], hidden = {}, false
        if hostile then rows, hidden = readRows() end
        if wantMeter then
            -- the name may be secret: passed on, never tested
            if hostile then meter:SetTarget((UnitName("target"))) else meter:SetTarget(nil) end
            meter:SetRows(entries(rows), self:MeterOpts(hidden))
            meter:Show()
        else
            meter:Hide()
        end
        if fighting then
            self:Warn(rows)
        else
            unalert("threat-pull")
            unalert("threat-aggro")
        end
    end

    -- A driver reads the table every TICK (threat moves all the time) in combat,
    -- and out of combat too while the meter always shows.
    function Refresh()
        local driver = self.driver
        if driver then driver:SetShown(inCombat() or self:Get("shows") == "always") end
        self:Update()
    end

    -- Whether the driver runs (the table is read).
    function Driving(): boolean
        local driver = self.driver
        return driver ~= nil and driver:IsShown()
    end

    function PreviewView(parent: Frame): ThreatMeter
        local preview = self.preview
        if not preview then
            preview = UI.ThreatMeter(parent, { rows = meterRows() })
            preview:SetTarget("Lava Surger")
            self.preview = preview
        end
        preview:SetParent(parent)
        preview:SetMaxRows(meterRows())
        self:RefreshPreview()
        return preview
    end

    function RefreshPreview()
        local preview = self.preview
        if not preview then return end
        -- you: the healer, or yourself by name with your class
        local rows: ThreatEntry[] = {}
        for i, r in ipairs(SAMPLE) do
            rows[i] = { name = r.name, class = r.class, role = r.role, status = r.status, percent = r.percent, raw = r.raw,
                        you = i == #SAMPLE }
        end
        preview:SetRows(rows, self:MeterOpts(false))
    end

    override function OnEnable()
        local meter = self.meter
        if not meter then
            meter = UI.ThreatMeter(SuuUI.Root, { rows = meterRows() })
            meter:SetFrameStrata("MEDIUM")
            meter:Hide()
            self.meter = meter
            local driver = CreateFrame("Frame")
            driver:Hide()
            local wait = 0
            driver:SetScript("OnUpdate", function(_: Frame, elapsed: number)
                wait = wait - elapsed
                if wait > 0 then return end
                wait = TICK
                self:Update()
            end)
            self.driver = driver
        end
        self:RegisterMover(meter, { key = "position", label = "Threat meter", managedShow = true,
            enabled = function() return self:Get("shows") ~= "off" end })
        self:RegisterSettings(SECTION)
        self:Watch("shows", function() SuuUI.EditMode.Refresh(); self:Refresh() end)
        self:WatchAll({ "who", "marker", "raw" }, function() self:RefreshPreview(); if self:Driving() then self:Update() end end)
        self:WatchAll({ "warnPull", "aggroAlert", "openWorld", "position" }, function() if self:Driving() then self:Update() end end)
        -- as tall as the damage meter
        meter:SetMaxRows(meterRows())
        self:On("SUUUI_SETTING_CHANGED", function(_, namespace, key)
            if namespace == "damagemeter" and key == "rows" then
                meter:SetMaxRows(meterRows())
                local preview = self.preview
                if preview then preview:SetMaxRows(meterRows()); self:RefreshPreview() end
                if self:Driving() then self:Update() end
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function() self:Refresh() end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function() self:Refresh() end)
        self:OnGameEvent("PLAYER_TARGET_CHANGED", function() if self:Driving() then self:Update() end end)
        self:Refresh()
    end

    override function OnDisable()
        if self.driver then self.driver:Hide() end
        if self.meter then self.meter:Hide() end
        unalert("threat-pull")
        unalert("threat-aggro")
    end
end

M = SuuUI.AddModule(ThreatModule.new())

-- The toggle "Show the threat meter" became the choice Show: Off / In combat / Always.
M:Migrate("shows", function(values)
    if type(values.shown) == "boolean" then
        values.shows = values.shown and "combat" or "off"
    end
    values.shown = nil
end)
