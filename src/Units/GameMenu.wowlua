-- Units/GameMenu.wowlua
-- SuuUI's own game menu (plan 3.7, design component GameMenu): Esc shows a
-- compact panel in the middle of a dimmed screen. Return to Game first, then
-- Game (Options, Edit Mode, Macros, AddOns, SuuUI settings), Help (Support)
-- and Session (Reload UI, Log Out, Exit Game); a light info line at the
-- foot. Options and Edit Mode stay the game's own windows (decided
-- 2026-10-17); Macros and AddOns open what is open for them (SuuUI's own
-- when those modules are on).
-- Reload UI, Log Out and Exit Game are secure buttons on top running
-- /reload, /logout and /quit (the game blocks them from addon code: found in
-- game, 2026-10-17); placed while the menu shows, out of combat.
-- Esc stays the game's: its GameMenuFrame still opens and closes on Esc,
-- out of sight, and this panel shows and hides with it. Opening each entry
-- from SuuUI's code taints nothing (/suu probe gamemenu, 2026-10-17).
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type Panel from "/UI/Panel"
import type Text from "/UI/Text"
import * as secret from "wowlua:secret"
import * as secure from "wowlua:secure"
import * as frames from "wowlua:frames"
import type AwayHandle from "wowlua:frames"
import type Overlay from "wowlua:secure"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {}

local M: GameMenuModule

local WIDTH = 300
local ITEM_H = 30
local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"

-- Closes the game's menu (this panel follows), then does what was chosen.
local function closeThen(fn: (() -> ())?, sound: number?): () -> ()
    return function()
        PlaySound(sound or SOUNDKIT.IG_MAINMENU_OPTION)
        if GameMenuFrame:IsShown() then
            HideUIPanel(GameMenuFrame)
        end
        if fn then
            fn()
        end
    end
end

-- In a fight: the lockdown, or its event already (it comes a moment before
-- the lockdown: the entries are drawn blocked from there).
local function inFight(): boolean
    return InCombatLockdown() or M.fighting == true
end

local function exitBlocked(): string?
    if StaticPopup_Visible and (StaticPopup_Visible("CAMP") or StaticPopup_Visible("QUIT")) then
        return "Already on the way out"
    end
    if inFight() then
        return "Not in combat"
    end
end

local function notInCombat(): string?
    if inFight() then
        return "Not in combat"
    end
    return nil
end

-- An entry: what it says, its glyph, what a click does, why it's blocked
-- now (nil: it isn't); the secure ones a slash command and a sound instead
-- of the click.
export type Entry = {
    label: string,
    glyph: string,
    onClick?: () -> (),
    blocked?: () -> string?,
    slash?: string,
    sound?: number,
}
-- A group of entries under a caption.
export type Group = { name: string, entries: Entry[] }

local GROUPS: Group[] = {
    {
        name = "Game",
        entries = {
            {
                label = "Options",
                glyph = "gear",
                onClick = closeThen(function()
                    SettingsPanel:Open()
                end),
            },
            {
                label = "Edit Mode",
                glyph = "pushpin",
                onClick = closeThen(function()
                    ShowUIPanel(EditModeManagerFrame)
                end),
                blocked = function(): string?
                    if inFight() then
                        return "Not in combat"
                    end
                    if EditModeManagerFrame and EditModeManagerFrame.CanEnterEditMode and
                        not EditModeManagerFrame:CanEnterEditMode() then
                        return "Not available right now"
                    end
                    return nil
                end,
            },
            {
                label = "Macros",
                glyph = "scroll",
                onClick = closeThen(function()
                    ShowMacroFrame()
                end),
            },
            {
                label = "AddOns",
                glyph = "menu",
                onClick = closeThen(function()
                    ShowUIPanel(AddonList)
                end),
            },
            {
                label = "SuuUI settings",
                glyph = "markDiamond",
                onClick = closeThen(function()
                    SuuUI.OpenSettings()
                end),
            },
        },
    },
    {
        name = "Help",
        entries = {
            {
                label = "Support",
                glyph = "chat",
                onClick = closeThen(function()
                    ToggleHelpFrame()
                end),
            },
        },
    },
    {
        name = "Session",
        entries = {
            {
                label = "Reload UI",
                glyph = "reset",
                blocked = notInCombat,
                slash = "/reload",
                sound = SOUNDKIT.IG_MAINMENU_OPTION,
            },
            {
                label = "Log Out",
                glyph = "door",
                blocked = exitBlocked,
                slash = "/logout",
                sound = SOUNDKIT.IG_MAINMENU_LOGOUT,
            },
            -- asks first (asked 2026-10-18: a slip of the finger quit the game)
            {
                label = "Exit Game",
                glyph = "close",
                onClick = closeThen(function()
                    M:ConfirmQuit()
                end),
                blocked = exitBlocked,
            },
        },
    },
}

-- A plugin's entry (M:AddGameMenuItem: { group, label, glyph, onClick,
-- blocked = fn -> reason }; read with care), and the group it goes in.
local function pluginEntry(v: unknown): (Entry?, string)
    if type(v) ~= "table" then
        return nil, "Game"
    end
    local t = v :: { [string]: unknown }
    local group, label, glyph, onClick, blocked = t.group, t.label, t.glyph, t.onClick, t.blocked
    return {
            label = type(label) == "string" and label or "?",
            glyph = type(glyph) == "string" and glyph or "markDiamond",
            onClick = closeThen(type(onClick) == "function" and onClick :: () -> () or nil),
            blocked = type(blocked) == "function" and blocked :: () -> string? or nil,
        },
        type(group) == "string" and group or "Game"
end

-- An entry of the panel.
export class MenuItem extends Button
    readonly def: Entry
    readonly hover: Texture
    readonly glyph: Texture
    readonly label: Text
    -- why it's blocked now (nil: it isn't)
    blocked: string? = nil

    constructor(parent: Frame, def: Entry)
        super(nil, parent)
        self.def = def
        self:SetHeight(ITEM_H)
        self.hover = UI.Fill(self, "surface-raised", "BACKGROUND")
        self.hover:SetAllPoints()
        self.hover:Hide()
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetSize(14, 14)
        self.glyph:SetPoint("LEFT", S["space-4"], 0)
        self.glyph:SetTexture(GLYPHS .. def.glyph)
        UI.Paint(self.glyph, "ink-muted")
        self.label = UI.Text(self, "label", "ink")
        self.label:SetPoint("LEFT", self.glyph, "RIGHT", S["space-4"], 0)
        self.label:SetValue(def.label)
        self:SetScript("OnEnter", function()
            self.hover:Show()
            local blocked = self.blocked
            if blocked then
                UI.ShowTooltip(self, { title = def.label, description = blocked })
            else
                UI.Paint(self.glyph, "gilt-text")
            end
        end)
        self:SetScript("OnLeave", function()
            self.hover:Hide()
            UI.Paint(self.glyph, "ink-muted")
            UI.HideTooltip()
        end)
        self:SetScript("OnClick", function()
            local click = def.onClick
            if self.blocked or not click then
                return
            end
            UI.HideTooltip()
            click()
        end)
    end

    -- Why it's blocked now, drawn (dimmed while it is).
    function Draw()
        local why = self.def.blocked
        self.blocked = why and why() or nil
        self:SetAlpha(self.blocked and 0.45 or 1)
    end
end

--------------------------------------------------------------------------------
-- The panel
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- With the game's menu
--------------------------------------------------------------------------------

class GameMenuModule extends Module<typeof(DEFAULTS)>
    -- the game's menu kept away
    away: AwayHandle? = nil
    builtLine: number? = nil
    dim: Frame? = nil
    fighting: boolean? = nil
    items: MenuItem[] = {}
    -- the secure covers over the secure entries, by their place in secureItems
    overs: { [number]: Overlay }? = nil
    panel: Panel? = nil
    perf: Text? = nil
    quitOver: Overlay? = nil
    secureItems: MenuItem[]? = nil
    stale: true? = nil
    ticker: TickerHandle? = nil
    who: Text? = nil

    constructor()
        super({
            id = "gamemenu",
            name = "Game menu",
            description = "SuuUI's game menu (Esc): Return to Game, the game's windows, Reload UI, Log Out and Exit Game in one compact panel.",
            api = "0.17",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function BuildItem(parent: Frame, def: Entry): MenuItem
        local b = MenuItem.new(parent, def)
        if def.slash then
            local items = self.secureItems or {}
            self.secureItems = items
            items[#items + 1] = b
        end
        return b
    end

    -- SuuUI's groups with plugins' entries (0.17, M:AddGameMenuItem: { group,
    -- label, glyph, onClick, blocked = fn -> reason }): in their group, or a
    -- group of their own before Session, which stays last.
    function Groups(): Group[]
        local out: Group[], byName: { [string]: Group } = {}, {}
        for i, g in ipairs(GROUPS) do
            local copy: Group = { name = g.name, entries = { unpack(g.entries) } }
            out[i] = copy
            byName[g.name] = copy
        end
        for _, item in ipairs(SuuUI.Additions("gamemenu")) do
            local entry, name = pluginEntry(item)
            if entry then
                local g = byName[name]
                if not g then
                    g = { name = name, entries = {} }
                    byName[name] = g
                    table.insert(out, #out, g)
                end
                g.entries[#g.entries + 1] = entry
            end
        end
        return out
    end

    -- Built again for plugins' entries, the next time it opens out of combat.
    -- Its secure covers can't be freed: the old ones stay hidden.
    function Rebuild()
        if InCombatLockdown() then
            return
        end
        self.stale = nil
        for _, over in pairs(self.overs or {}) do
            over.hide()
        end
        self.overs, self.secureItems = nil, nil
        local dim = self.dim
        if dim then
            dim:Hide()
            dim:SetScript("OnUpdate", nil)
        end
        self:Build()
    end

    function Build()
        -- the dimmed screen under it
        local dim = CreateFrame("Frame", nil, SuuUI.Root)
        dim:SetAllPoints(UIParent)
        dim:SetFrameStrata("DIALOG")
        dim:EnableMouse(true)
        local shade = dim:CreateTexture(nil, "BACKGROUND")
        shade:SetAllPoints()
        shade:SetColorTexture(0, 0, 0, 0.55)
        dim:Hide()
        self.dim = dim

        local p = UI.Panel(dim, { title = "Game Menu", keybind = "Esc", width = WIDTH, ornament = true, solid = true })
        p:SetPoint("CENTER", UIParent, "CENTER", 0, 40)
        p:SetFrameLevel(dim:GetFrameLevel() + 5)
        self.panel = p
        local body = p.body
        local y = 0
        local back = UI.Button(body, {
            text = "Return to Game",
            variant = "primary",
            onClick = closeThen(nil, SOUNDKIT.IG_MAINMENU_CONTINUE),
        })
        back:SetHeight(34)
        back:SetPoint("TOPLEFT")
        back:SetPoint("TOPRIGHT")
        y = y + 34 + S["space-5"]
        self.items = {}
        for _, g in ipairs(self:Groups()) do
            local label = UI.Text(body, "caption", "ink-faint")
            label:SetPoint("TOPLEFT", S["space-3"], -y)
            label:SetValue(g.name)
            y = y + T.type.caption.lineHeight + S["space-2"]
            for _, def in ipairs(g.entries) do
                local b = self:BuildItem(body, def)
                b:SetPoint("TOPLEFT", 0, -y)
                b:SetPoint("RIGHT")
                self.items[#self.items + 1] = b
                y = y + ITEM_H + 1
            end
            y = y + S["space-5"] - 1
        end
        -- the info line: who and where, frame rate and latency
        local rule = UI.Fill(body, "gilt-faint", "ARTWORK")
        rule:SetPoint("TOPLEFT", 0, -y)
        rule:SetPoint("TOPRIGHT", 0, -y)
        rule:SetHeight(1)
        y = y + 1 + S["space-4"]
        local who = UI.Text(body, "caption", "ink-muted")
        who:SetPoint("TOPLEFT", 0, -y)
        self.who = who
        local perf = UI.Text(body, "caption", "ink-faint")
        perf:SetPoint("TOPRIGHT", 0, -y)
        self.perf = perf
        y = y + T.type.caption.lineHeight
        body:SetSize(WIDTH - 2 * S["space-5"], y)
        p:Fit()
        self.builtLine = T.type.caption.lineHeight
    end

    function Draw()
        for _, b in ipairs(self.items) do
            b:Draw()
        end
        local name, given = UnitFullName("player")
        local realm = secret.known(given, "")
        local who = self.who
        if who then
            who:SetValue(secret.known(name, "") .. (realm ~= "" and (" · " .. realm) or ""))
        end
        self:DrawPerf()
    end

    -- Exit Game's question: SuuUI's dialog, its Exit Game button covered by a
    -- secure /quit (quitting from addon code is blocked on Forever). Out of
    -- combat; the cover goes with the dialog.
    function ConfirmQuit()
        if InCombatLockdown() then
            return
        end
        local d = UI.Confirm({
            title = "Exit the game?",
            text = "You'll leave the world and the game closes.",
            confirm = "Exit Game",
            onConfirm = function() end,
        })
        local over = self.quitOver
        if not over then
            local made = secure.overlay(d.ok, { strata = "FULLSCREEN_DIALOG" })
            made.set("type1", "macro")
            made.set("macrotext1", "/quit")
            made.button:SetScript("PreClick", function()
                PlaySound(SOUNDKIT.IG_MAINMENU_QUIT)
            end)
            d:HookScript("OnHide", function()
                made.hide()
            end)
            self.quitOver = made
            over = made
        end
        over.show()
    end

    -- The secure buttons over Reload UI, Log Out and Exit Game: there while the
    -- menu shows (out of combat: a secure frame can't be placed in one).
    function PlaceSecure(on: boolean)
        if InCombatLockdown() then
            return
        end
        local overs = self.overs or {}
        self.overs = overs
        local panel = self.panel
        for i, item in ipairs(self.secureItems or {}) do
            local over = overs[i]
            if not over and on then
                local def = item.def
                over = secure.overlay(item)
                over.set("type1", "macro")
                over.set("macrotext1", def.slash)
                over.button:SetScript("PreClick", function()
                    PlaySound(def.sound or SOUNDKIT.IG_MAINMENU_OPTION)
                end)
                -- the menu closes after (closing it first would hide this button mid-click)
                over.button:SetScript("PostClick", function()
                    C_Timer.After(0, function()
                        if GameMenuFrame:IsShown() then
                            HideUIPanel(GameMenuFrame)
                        end
                    end)
                end)
                overs[i] = over
            end
            if over then
                if on and not item.blocked then
                    over.show()
                    if panel then
                        over.button:SetFrameLevel(panel:GetFrameLevel() + 20)
                    end
                else
                    over.hide()
                end
            end
        end
    end

    function DrawPerf()
        local fps = math.floor((GetFramerate() or 0) + 0.5)
        local _, _, home, world = GetNetStats()
        local perf = self.perf
        if perf then
            perf:SetValue(("%d fps · %d ms"):format(fps, world or home or 0))
        end
    end

    -- The game's menu out of sight: see-through and off screen, still shown
    -- (it isn't protected: it moves in a fight too). Again on every show and
    -- whenever the game places it (it sets both itself when it opens).
    function Away(frame: Frame)
        if self.away then
            return
        end
        self.away = frames.keepAway(frame, {
            fade = true,
            when = function(): boolean
                return self:IsEnabled()
            end,
        })
    end

    function PutAway()
        local away = self.away
        if away then
            away.apply()
        end
    end

    -- The dimmed screen under the panel (Build makes it, Rebuild again).
    function Dim(): Frame
        return assert(self.dim)
    end

    override function OnEnable()
        local g = GameMenuFrame
        if not g then
            return
        end
        if not self.panel then
            self:Build()
        end
        self:Away(g)
        self:On("SUUUI_ADDITIONS_CHANGED", function(_, list)
            if list == "gamemenu" then
                self.stale = true
            end
        end)
        if #SuuUI.Additions("gamemenu") > 0 then
            self.stale = true
        end
        -- a theme with another caption line height: built again (colours follow by themselves)
        self:On("SUUUI_THEME_CHANGED", function()
            if self.builtLine ~= T.type.caption.lineHeight then
                self.stale = true
            end
        end)
        g:HookScript("OnShow", function()
            if not self:IsEnabled() then
                return
            end
            if self.stale then
                self:Rebuild()
            end
            self:Away(g)
            C_Timer.After(0, function()
                self:PutAway()
            end)
            self:Draw()
            self:Dim():Show()
            self:PlaceSecure(true)
            -- while it shows: keep it away, whatever the game does to it
            self:Dim():SetScript("OnUpdate", function()
                local _, rel = g:GetPoint(1)
                if g:GetAlpha() > 0 or rel ~= UIParent or g:GetNumPoints() ~= 1 then
                    self:PutAway()
                end
            end)
            if not self.ticker then
                self.ticker = C_Timer.NewTicker(1, function()
                    if self:Dim():IsShown() then
                        self:DrawPerf()
                    end
                end)
            end
        end)
        g:HookScript("OnHide", function()
            self:PlaceSecure(false)
            self:Dim():Hide()
            self:Dim():SetScript("OnUpdate", nil)
            if self.ticker then
                self.ticker:Cancel()
                self.ticker = nil
            end
        end)
        for _, e in ipairs({ "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED" }) do
            self:OnGameEvent(e, function()
                self.fighting = e == "PLAYER_REGEN_DISABLED" or nil
                if self:Dim():IsShown() then
                    self:Draw()
                end
                self:PlaceSecure(self:Dim():IsShown())
            end)
        end
    end

    override function OnDisable()
        local dim = self.dim
        if dim then
            dim:Hide()
        end
    end
end

M = SuuUI.AddModule(GameMenuModule.new())
