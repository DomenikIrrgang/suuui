-- Units/Windows.wowlua
-- Blizzard's other windows in SuuUI's WindowFrame look (Phase 3), restyled
-- in place through UI.SkinWindow: their clicks, tabs and panes stay
-- Blizzard's. Each window is skinned when its addon has loaded.
--   3.2a: the spells window (PlayerSpellsFrame: Specialization, Talents,
--         Spellbook; protected, so its parts move only out of combat) and the
--         Legacy window (LegacySystemFrame: Tree, Challenges, Reward track):
--         SuuUI's header, the tabs as text tabs along the top, Blizzard's
--         metal frame, portrait and title strip out of sight. Both open
--         lined up under the micro menu (the protected spells window moved
--         only out of combat). The Legacy window opens in the middle of the
--         screen instead (asked for in game), like SuuUI's Talents window.
--   3.3:  the professions window (ProfessionsFrame), in the middle too.
--   3.6:  the trainer window (ClassTrainerFrame), under the micro menu, and
--         the collections window (CollectionsJournal), its collections as
--         text tabs along the top, the empty ones greyed.
-- A built-in module written against the public API only.
--
-- This file is the module: its state, its lifecycle, SkinAll, and the
-- spells, Legacy and professions windows. The other windows are in parts
-- beside it, each a function taking the module that the module's method of
-- the same name calls:
--   Windows/Shared       what the windows share (a part by key, the art
--                        SkinWindow hides, a glyph button, max/min)
--   Windows/Social       the friends, social, guild and group finder windows
--   Windows/WorldMap     the world map: header, way up, second row, status
--                        line, enlarging
--   Windows/QuestLog     the world map's quest log and quest details
--   Windows/Trainer      the trainer window
--   Windows/Collections  the collections window

import SuuUI, Module from "/Core/API"
import type WindowChrome, SkinTab from "/Core/API"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import * as secure from "wowlua:secure"
import part, button, quiet, tabLabel, shows, skinMaxMin, art from "/Units/Windows/Shared"
import * as social from "/Units/Windows/Social"
import * as worldMap from "/Units/Windows/WorldMap"
import * as questLog from "/Units/Windows/QuestLog"
import * as trainer from "/Units/Windows/Trainer"
import * as collections from "/Units/Windows/Collections"

local chromeOf = SuuUI.UI.WindowChrome

local UI = SuuUI.UI
local asString, field = secret.asString, tbl.field
local find = frames.find

-- (the world map enlarged: its maximize button)
local DEFAULTS = { mapEnlarged = true }

local M: WindowsModule

--------------------------------------------------------------------------------
-- The spells window
--------------------------------------------------------------------------------

-- The key each tab opens with.
local SPELL_BINDINGS: { [string]: string } = {
    Spellbook = "TOGGLESPELLBOOK",
    Talents = "TOGGLETALENTS",
    Specialization = "TOGGLESPECIALIZATION",
}

--------------------------------------------------------------------------------
-- The Legacy window
--------------------------------------------------------------------------------

type LegacyTab = { name: string, label: string, short?: string, track?: boolean }
local LEGACY_TABS: LegacyTab[] = {
    { name = "LegacyTreeTab", label = "Tree" },
    { name = "LegacyChallengeTab", label = "Challenges" },
    { name = "LegacyRewardTrackTab", label = "Reward track", short = "Rewards", track = true },
}

export class WindowsModule extends Module<typeof(DEFAULTS)>
    spells: WindowChrome? = nil
    legacy: WindowChrome? = nil
    professions: WindowChrome? = nil
    friends: WindowChrome? = nil
    social: WindowChrome? = nil
    communities: WindowChrome? = nil
    groupFinder: WindowChrome? = nil
    worldMap: WindowChrome? = nil
    trainer: WindowChrome? = nil
    collections: WindowChrome? = nil
    -- the Guild module's own pages as tabs of the guild window
    logTab: Button? = nil
    settingsTab: Button? = nil
    -- the group finder's gear, the world map's status line
    gear: Button? = nil
    status: Frame? = nil
    -- the secure button over the map's title (its way up)
    upOver: secure.Overlay? = nil
    -- the quest log's headers' font (label, in ink)
    questFont: Font? = nil
    -- the quest log restyled in this frame (GetTime), once more next frame
    questRestyledAt: number? = nil
    questRestylePending: boolean? = nil
    -- SuuUI's stand-ins for the collections the game hides, by their ID
    readonly standIns: { [number]: Button } = {}
    -- the group finder's size (wide: the Group Finder module's Browse page)
    static readonly GROUP_FINDER_SIZE: number[] = { 960, 600 }

    constructor()
        super({
            id = "windows",
            name = "Blizzard windows",
            description = "Blizzard's other windows in SuuUI's look: spells, Legacy, professions, friends, guild, group finder, the world map, the trainer and collections.",
            api = "0.12",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function SkinSpells()
        local f = find("PlayerSpellsFrame")
        if not f or chromeOf(f) or InCombatLockdown() then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Talents",
            icon = "book",
            binding = "TOGGLETALENTS",
            close = button(_G, "PlayerSpellsFrameCloseButton"),
            topInset = 20,
            -- under the micro menu like the others (found in game: Blizzard's
            -- place put SuuUI's header against the top of the screen)
            under = "microMenu",
            hide = {
                field(f, "NineSlice"),
                field(f, "PortraitContainer"),
                field(f, "TitleContainer"),
                field(_G, "PlayerSpellsFrameBg"),
                field(f, "TopTileStreaks"),
            },
        })
        -- the tabs (Blizzard's tab system, bottom left) along the top
        local system = part(f, "TabSystem") or part(f, "tabSystem")
        local list: SkinTab[] = {}
        if system then
            for _, b in ipairs(frames.children(system)) do
                local label = frames.asButton(b) and tabLabel(b)
                if label then
                    list[#list + 1] = {
                        button = b,
                        label = label,
                        short = label,
                        selected = function(): boolean
                            return shows(field(b, "LeftActive"))
                        end,
                    }
                end
            end
            table.sort(list, function(a: SkinTab, b: SkinTab): boolean
                return (a.button:GetLeft() or 0) < (b.button:GetLeft() or 0)
            end)
            system:SetAlpha(1)
        end
        chrome:SetTabs(list)
        -- the title and key chip follow the open tab
        local titleText = frames.asFontString(field(_G, "PlayerSpellsFrameTitleText"))
        local function follow()
            local title = titleText and asString(titleText:GetText())
            for _, def in ipairs(list) do
                local selected = def.selected
                if selected and selected() then
                    title = def.label
                    chrome:SetBinding(SPELL_BINDINGS[def.label])
                end
            end
            if title then
                chrome:SetTitle(title)
            end
            chrome:UpdateTabs()
        end
        if titleText then
            hook(titleText, "SetText", follow)
        end
        for _, def in ipairs(list) do
            hookScript(def.button, "OnClick", function()
                self:After(0, follow)
            end)
        end
        hookScript(f, "OnShow", function()
            self:After(0, follow)
        end)
        skinMaxMin(chrome, part(f, "MaximizeMinimizeButton"))
        follow()
        self.spells = chrome
    end

    function SkinLegacy()
        local f = find("LegacySystemFrame")
        if not f or chromeOf(f) then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Legacy",
            icon = "trophy",
            close = button(_G, "LegacySystemFrameCloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = {
                field(f, "NineSlice"),
                field(f, "PortraitContainer"),
                field(f, "TitleContainer"),
                field(_G, "LegacySystemFrameBg"),
                field(f, "TopTileStreaks"),
            },
        })
        -- SuuUI's Legacy pages put the reward track along the window's foot:
        -- then no tab for it (its button out of sight)
        local legacy = SuuUI.GetModule("legacy")
        local ownTrack = legacy ~= nil and legacy:Setting("enabled") == true
        local list: SkinTab[] = {}
        for _, t in ipairs(LEGACY_TABS) do
            -- fields of the window on Forever, not globals (found in game: no tabs)
            local b = part(f, t.name) or find(t.name)
            if b and ownTrack and t.track then
                quiet(b)
                b:ClearAllPoints()
                b:SetPoint("TOPLEFT", UIParent, "TOPRIGHT", 5000, 0)
            elseif b then
                list[#list + 1] = {
                    button = b,
                    label = t.label,
                    short = t.short or t.label,
                    selected = function(): boolean
                        return shows(field(b, "SelectedTexture"))
                    end,
                }
            end
        end
        chrome:SetTabs(list)
        hookScript(f, "OnShow", function()
            self:After(0, function()
                chrome:UpdateTabs()
            end)
        end)
        -- in the middle of the screen, like the Talents window (asked for in game)
        UI.CenterWindow(f, true)
        self.legacy = chrome
    end

    --------------------------------------------------------------------------------
    -- The professions window (3.3): SuuUI's header; the Professions module puts
    -- its pages over Blizzard's. In the middle of the screen, like Talents and
    -- Legacy.
    --------------------------------------------------------------------------------

    function SkinProfessions()
        local f = find("ProfessionsFrame")
        if not f or chromeOf(f) or InCombatLockdown() then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Professions",
            icon = "hammer",
            binding = "TOGGLEPROFESSIONBOOK",
            close = button(f, "CloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = art(f),
        })
        UI.CenterWindow(f, true)
        self.professions = chrome
    end

    --------------------------------------------------------------------------------
    -- The friends, social, guild and group finder windows (Windows/Social)
    --------------------------------------------------------------------------------

    function SkinFriends()
        social.skinFriends(self)
    end

    function SkinSocial()
        social.skinSocial(self)
    end

    function SocialTabs()
        social.socialTabs(self)
    end

    function SkinCommunities()
        social.skinCommunities(self)
    end

    function SkinGroupFinder()
        social.skinGroupFinder(self)
    end

    --------------------------------------------------------------------------------
    -- The world map's quest log (Windows/QuestLog)
    --------------------------------------------------------------------------------

    function RestyleQuestLog()
        questLog.restyleQuestLog(self)
    end

    function StyleDetails(d: Frame)
        questLog.styleDetails(self, d)
    end

    function StyleRewardMoney(fs: FontString)
        questLog.styleRewardMoney(fs)
    end

    function PlaceQuestList(q: Frame, list: Frame)
        questLog.placeQuestList(q, list)
    end

    function PlaceQuestDetails()
        questLog.placeQuestDetails()
    end

    --------------------------------------------------------------------------------
    -- The world map (Windows/WorldMap)
    --------------------------------------------------------------------------------

    function SkinWorldMap()
        worldMap.skinWorldMap(self)
    end

    function StatusLine(f: typeof(WorldMapFrame)): Frame
        return worldMap.statusLine(self, f)
    end

    function Enlarging(f: typeof(WorldMapFrame), chrome: WindowChrome, mm: Frame?)
        worldMap.enlarging(self, f, chrome, mm)
    end

    --------------------------------------------------------------------------------
    -- The trainer window (Windows/Trainer)
    --------------------------------------------------------------------------------

    function SkinTrainer()
        trainer.skinTrainer(self)
    end

    --------------------------------------------------------------------------------
    -- The collections window (Windows/Collections)
    --------------------------------------------------------------------------------

    function SetCollectionTabs()
        collections.setCollectionTabs(self)
    end

    function SkinCollections()
        collections.skinCollections(self)
    end


    function SkinAll()
        self:SkinTrainer()
        self:SkinCollections()
        self:SkinSpells()
        self:SkinLegacy()
        self:SkinProfessions()
        self:SkinFriends()
        self:SkinSocial()
        self:SkinCommunities()
        self:SkinGroupFinder()
        self:SkinWorldMap()
    end

    override function OnEnable()
        self:SkinAll()
        -- their addons load on demand
        self:OnGameEvent("ADDON_LOADED", function()
            self:SkinAll()
        end)
        -- the spells window is protected: skinned after combat if it loaded during one
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self:SkinAll()
        end)
        -- a theme's text styles: the quest headers' font copied again, the quest
        -- log (its rows measured for the fonts) restyled
        self:On("SUUUI_THEME_CHANGED", function()
            local font = self.questFont
            if font then
                font:CopyFontObject(SuuUI.Fonts.Get("label"))
                UI.Bind(font, questLog.inkFont)
            end
            local q = find("QuestMapFrame")
            if q and q:IsVisible() then
                self:RestyleQuestLog()
            end
        end)
    end
end

M = SuuUI.AddModule(WindowsModule.new())
