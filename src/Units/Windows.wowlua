-- Whether a collection's count is 0 (an unreadable count isn't).
local function emptyCount(def: CollectionTab): boolean
    local count = def.count
    return count ~= nil and asNumber(count()) == 0
end

-- The game's tab for a collection (by its ID), if there is one.
local function gameTab(f: Frame, id: number): Frame?
    for _, t in ipairs(tbl.list(field(f, "TabContainer", "Tabs"))) do
        local tab = frames.asFrame(t)
        if tab and tab:GetID() == id then
            return tab
        end
    end
    return nil
end

-- The game's pane art away: the stone tile and its backdrop, the bronze
-- corners, the shadows, the inner frame edge, the old-style tabs (found
-- with /suu probe collart). SuuUI's glass shows through.
local PANE_ART = {
    "^collections%-background",
    "UI%-Frame%-Inner",
    "^uiframe%-activetab",
    "^_uiframe%-activetab",
    "^uiframe%-tab",
    "^_uiframe%-tab",
}
local PANE_FILES: { [number]: boolean } = { [374154] = true }

local function clearPaneArt(frame: Frame, depth: number)
    if depth > 8 then
        return
    end
    for _, r in ipairs(frames.textures(frame)) do
        local atlas = asString(r:GetAtlas())
        local file = asNumber(r:GetTexture())
        local hide = file ~= nil and PANE_FILES[file] == true
        if atlas and not hide then
            for _, pat in ipairs(PANE_ART) do
                if atlas:find(pat) then
                    hide = true
                    break
                end
            end
        end
        if hide then
            r:SetAlpha(0)
        end
    end
    for _, c in ipairs(frames.children(frame)) do
        clearPaneArt(c, depth + 1)
    end
end

-- The panes' search boxes and Filter buttons at the height of the class
-- dropdown beside them (the game's are 18-20px; SuuUI's own 30 doesn't fit
-- the game's layout). Out of combat: the window is protected.
local CONTROL_H = 26
local PANES = { "MountJournal", "PetJournal", "ToyBox", "HeirloomsJournal", "WardrobeCollectionFrame" }

local function sizeControls(pane: Frame)
    if InCombatLockdown() then
        return
    end
    for _, key in ipairs({ "searchBox", "SearchBox", "FilterButton", "FilterDropdown", "filterButton" }) do
        local c = part(pane, key)
        if c then
            c:SetHeight(CONTROL_H)
        end
    end
end

-- The appearances' Items and Sets as SuuUI's text tabs (kept here, never on them).
type PaneTab = { label: Text, draw: () -> () }
local paneTabs: { [Frame]: PaneTab } = tbl.weakKeys()
local paneMarkers: { [Frame]: TabMarker } = tbl.weakKeys()

-- The appearances' Items and Sets as SuuUI's text tabs, as the window's own
-- row: SuuUI's label (header, ink-muted, ink on hover, gilt-text over a gilt
-- hairline with its jewel when chosen; the game shows its LeftActive art on
-- the chosen one), the tab as wide as its label. The game's own label keeps
-- getting the game's font, so it stays out of sight.
local function skinPaneTab(tab: Frame?)
    if not tab or paneTabs[tab] then
        return
    end
    leave(tab, "button")
    for _, r in ipairs(frames.textures(tab)) do
        r:SetAlpha(0)
    end
    local own = frames.asFontString(field(tab, "Text") or tryMethod(tab, "GetFontString"))
    local label = UI.Text(tab, "header", "ink-muted")
    label:SetPoint("BOTTOM", 0, S["space-3"])
    label:SetValue(own and asString(own:GetText()) or "")
    -- the chosen one's underline and jewel, gliding (one for both tabs)
    local pane = assert(frames.asFrame(tab:GetParent()))
    local marker = paneMarkers[pane] or UI.TabMarker(pane, { level = 6 })
    paneMarkers[pane] = marker
    marker:Track(tab)
    local hover = false
    local active = part(tab, "LeftActive") or frames.asRegion(field(tab, "LeftActive"))
    local function draw()
        local on = active ~= nil and active:IsShown()
        if own then
            own:SetAlpha(0)
            local text = asString(own:GetText())
            if text then
                label:SetValue(text)
            end
        end
        label:SetColor(on and "gilt-text" or hover and "ink" or "ink-muted")
        if on then
            marker:SetChosen(tab)
        elseif marker.chosen == tab then
            marker:SetChosen(nil)
        end
    end
    if active then
        for _, m in ipairs({ "Show", "Hide", "SetShown" }) do
            hook(active, m, draw)
        end
    end
    hookScript(tab, "OnEnter", function()
        hover = true
        draw()
    end)
    hookScript(tab, "OnLeave", function()
        hover = false
        draw()
    end)
    paneTabs[tab] = { label = label, draw = draw }
    draw()
end

-- The appearances' slot strip: round icons, so the chosen one gets a round
-- arcane glow behind it (SuuUI's soft disc) instead of a square fill.
local SOFT_DISC = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleSoft.tga"
local glowing: { [Texture]: boolean } = tbl.weakKeys()

local function skinSlotButtons(frame: Frame?, depth: number)
    if not frame or depth > 4 then
        return
    end
    for _, b in ipairs(frames.children(frame)) do
        local sel = frames.asTexture(field(b, "SelectedTexture"))
        if sel and not glowing[sel] then
            glowing[sel] = true
            sel:SetTexture(SOFT_DISC)
            UI.Paint(sel, "arcane")
            sel:SetAlpha(0.55)
            sel:SetDrawLayer("BACKGROUND", 2)
            sel:ClearAllPoints()
            sel:SetPoint("CENTER")
            sel:SetSize(48, 48)
        end
        skinSlotButtons(b, depth + 1)
    end
end

-- The Items and Sets row: from the class dropdown's left edge, its bottom
-- level with the search box's, space-5 between the tabs. Read from where
-- the game put those two (skipped while their places can't be read);
-- out of combat, the window being protected.
local function placePaneTabs(w: Frame)
    if InCombatLockdown() then
        return
    end
    local items = part(w, "ItemsTab") or find("WardrobeCollectionFrameTab1")
    local sets = part(w, "SetsTab") or find("WardrobeCollectionFrameTab2")
    local class, search = part(w, "ClassDropdown"), part(w, "searchBox")
    if not (items and paneTabs[items] and class and search) then
        return
    end
    local left, wLeft, bottom, top = class:GetLeft(), w:GetLeft(), search:GetBottom(), w:GetTop()
    if not (left and wLeft and bottom and top) or secret.isSecret(left) or secret.isSecret(bottom) then
        return
    end
    local x, y = left - wLeft, bottom - top
    local prev: Frame? = nil
    local row: Frame[] = { items }
    if sets then
        row[2] = sets
    end
    for _, tab in ipairs(row) do
        local made = paneTabs[tab]
        if made then
            tab:SetSize(math.ceil(UI.MeasureText("header", made.label:GetText() or "")), 30)
            tab:ClearAllPoints()
            if prev then
                tab:SetPoint("BOTTOMLEFT", prev, "BOTTOMRIGHT", S["space-5"], 0)
            else
                tab:SetPoint("BOTTOMLEFT", w, "TOPLEFT", x, y)
            end
            if tab:IsShown() then
                prev = tab
            end
        end
    end
    local marker = paneMarkers[w]
    if marker then
        marker:Aim()
    end
end

class WindowsModule extends Module<typeof(DEFAULTS)>
    spells: WindowChrome? = nil
    legacy: WindowChrome? = nil
    professions: WindowChrome? = nil
    friends: WindowChrome? = nil
    social: WindowChrome? = nil
    communities: WindowChrome? = nil
    groupFinder: WindowChrome? = nil
    worldMap: WindowChrome? = nil
    trainer: WindowChrome? = nil
    collections: WindowChrome? = nil
    -- the Guild module's own pages as tabs of the guild window
    logTab: Button? = nil
    settingsTab: Button? = nil
    -- the group finder's gear, the world map's status line
    gear: Button? = nil
    status: Frame? = nil
    -- the quest log's headers' font (label, in ink)
    questFont: Font? = nil
    -- SuuUI's stand-ins for the collections the game hides, by their ID
    readonly standIns: { [number]: Button } = {}
    -- the group finder's size (wide: the Group Finder module's Browse page)
    static readonly GROUP_FINDER_SIZE: number[] = { 960, 600 }

    constructor()
        super({
            id = "windows",
            name = "Blizzard windows",
            description = "Blizzard's other windows in SuuUI's look: spells, Legacy, professions, friends, guild, group finder, the world map, the trainer and collections.",
            api = "0.12",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function SkinSpells()
        local f = find("PlayerSpellsFrame")
        if not f or chromeOf(f) or InCombatLockdown() then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Talents",
            icon = "book",
            binding = "TOGGLETALENTS",
            close = button(_G, "PlayerSpellsFrameCloseButton"),
            topInset = 20,
            -- under the micro menu like the others (found in game: Blizzard's
            -- place put SuuUI's header against the top of the screen)
            under = "microMenu",
            hide = {
                field(f, "NineSlice"),
                field(f, "PortraitContainer"),
                field(f, "TitleContainer"),
                field(_G, "PlayerSpellsFrameBg"),
                field(f, "TopTileStreaks"),
            },
        })
        -- the tabs (Blizzard's tab system, bottom left) along the top
        local system = part(f, "TabSystem") or part(f, "tabSystem")
        local list: SkinTab[] = {}
        if system then
            for _, b in ipairs(frames.children(system)) do
                local label = frames.asButton(b) and tabLabel(b)
                if label then
                    list[#list + 1] = {
                        button = b,
                        label = label,
                        short = label,
                        selected = function(): boolean
                            return shows(field(b, "LeftActive"))
                        end,
                    }
                end
            end
            table.sort(list, function(a: SkinTab, b: SkinTab): boolean
                return (a.button:GetLeft() or 0) < (b.button:GetLeft() or 0)
            end)
            system:SetAlpha(1)
        end
        chrome:SetTabs(list)
        -- the title and key chip follow the open tab
        local titleText = frames.asFontString(field(_G, "PlayerSpellsFrameTitleText"))
        local function follow()
            local title = titleText and asString(titleText:GetText())
            for _, def in ipairs(list) do
                local selected = def.selected
                if selected and selected() then
                    title = def.label
                    chrome:SetBinding(SPELL_BINDINGS[def.label])
                end
            end
            if title then
                chrome:SetTitle(title)
            end
            chrome:UpdateTabs()
        end
        if titleText then
            hook(titleText, "SetText", follow)
        end
        for _, def in ipairs(list) do
            hookScript(def.button, "OnClick", function()
                after(0, follow)
            end)
        end
        hookScript(f, "OnShow", function()
            after(0, follow)
        end)
        skinMaxMin(chrome, part(f, "MaximizeMinimizeButton"))
        follow()
        self.spells = chrome
    end

    function SkinLegacy()
        local f = find("LegacySystemFrame")
        if not f or chromeOf(f) then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Legacy",
            icon = "trophy",
            close = button(_G, "LegacySystemFrameCloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = {
                field(f, "NineSlice"),
                field(f, "PortraitContainer"),
                field(f, "TitleContainer"),
                field(_G, "LegacySystemFrameBg"),
                field(f, "TopTileStreaks"),
            },
        })
        -- SuuUI's Legacy pages put the reward track along the window's foot:
        -- then no tab for it (its button out of sight)
        local legacy = SuuUI.GetModule("legacy")
        local ownTrack = legacy ~= nil and legacy:Get("enabled") == true
        local list: SkinTab[] = {}
        for _, t in ipairs(LEGACY_TABS) do
            -- fields of the window on Forever, not globals (found in game: no tabs)
            local b = part(f, t.name) or find(t.name)
            if b and ownTrack and t.track then
                quiet(b)
                b:ClearAllPoints()
                b:SetPoint("TOPLEFT", UIParent, "TOPRIGHT", 5000, 0)
            elseif b then
                list[#list + 1] = {
                    button = b,
                    label = t.label,
                    short = t.short or t.label,
                    selected = function(): boolean
                        return shows(field(b, "SelectedTexture"))
                    end,
                }
            end
        end
        chrome:SetTabs(list)
        hookScript(f, "OnShow", function()
            after(0, function()
                chrome:UpdateTabs()
            end)
        end)
        -- in the middle of the screen, like the Talents window (asked for in game)
        UI.CenterWindow(f, true)
        self.legacy = chrome
    end

    --------------------------------------------------------------------------------
    -- The professions window (3.3): SuuUI's header; the Professions module puts
    -- its pages over Blizzard's. In the middle of the screen, like Talents and
    -- Legacy.
    --------------------------------------------------------------------------------

    function SkinProfessions()
        local f = find("ProfessionsFrame")
        if not f or chromeOf(f) or InCombatLockdown() then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Professions",
            icon = "hammer",
            binding = "TOGGLEPROFESSIONBOOK",
            close = button(f, "CloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = art(f),
        })
        UI.CenterWindow(f, true)
        self.professions = chrome
    end

    --------------------------------------------------------------------------------
    -- The friends window (3.4): SuuUI's header; Contacts and Raid as tabs (the
    -- Social module puts its pages over Blizzard's); Quick Join left out
    -- (asked: not used on Forever).
    --------------------------------------------------------------------------------

    function SkinFriends()
        local f = find("FriendsFrame")
        if not f or chromeOf(f) then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Social",
            icon = "people",
            binding = "TOGGLESOCIAL",
            close = button(_G, "FriendsFrameCloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = withGlobal(art(f), "FriendsFrameInset"),
        })
        local list: SkinTab[] = {}
        local function selectedTab(): number?
            return asNumber(field(f, "selectedTab")) or asNumber(try(field(_G, "PanelTemplates_GetSelectedTab"), f))
        end
        for _, t in ipairs(FRIENDS_TABS) do
            local b = find(t.name)
            if b then
                local index = t.tab
                list[#list + 1] = {
                    button = b,
                    label = t.label,
                    short = t.label,
                    selected = function(): boolean
                        return selectedTab() == index
                    end,
                }
            end
        end
        chrome:SetTabs(list)
        -- Quick Join's tab out of sight
        local qj = find("FriendsFrameTab4")
        if qj then
            quiet(qj)
            qj:ClearAllPoints()
            qj:SetPoint("TOPLEFT", UIParent, "TOPRIGHT", 5000, 0)
        end
        hookScript(f, "OnShow", function()
            after(0, function()
                chrome:UpdateTabs()
            end)
        end)
        if field(_G, "PanelTemplates_SetTab") then
            hook("PanelTemplates_SetTab", function(frame: unknown)
                if frame == f then
                    chrome:UpdateTabs()
                end
            end)
        end
        self.friends = chrome
    end

    -- Forever's own social window (SocialUIFrame, O): SuuUI's header; its
    -- tabs down the right side stay Blizzard's for now.
    function SkinSocial()
        local f = find("SocialUIFrame")
        if not f or chromeOf(f) then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Social",
            icon = "people",
            binding = "TOGGLESOCIAL",
            close = button(_G, "SocialUIFrameCloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = {
                field(f, "NineSlice"),
                field(f, "PortraitContainer"),
                field(f, "TitleContainer"),
                field(_G, "SocialUIFrameInset"),
                field(_G, "SocialUIFrameBg"),
                field(f, "TopTileStreaks"),
            },
        })
        -- every other texture of the window's own away too: one behind the
        -- content (under the Battle.net bar) darkened half the page, found in
        -- game; SuuUI's glass stays
        clearArt(f, chrome)
        -- its four tab buttons down the right side as text tabs along the header,
        -- like every other window (asked for in game); top to bottom they open
        -- the friends list, Recent Allies, Friend Requests and Raid. Which one is
        -- lit follows the content actually shown. Set up when the window opens
        -- (the buttons aren't there, or have no size, when it's skinned at login)
        hookScript(f, "OnShow", function()
            after(0, function()
                self:SocialTabs()
            end)
        end)
        if f:IsShown() then
            self:SocialTabs()
        end
        self.social = chrome
    end

    function SocialTabs()
        local f = find("SocialUIFrame")
        local chrome = f and chromeOf(f)
        if not f or not chrome then
            return
        end
        if chrome.tabs then
            chrome:UpdateTabs()
            return
        end
        local allies, requests = part(f, "RecentAlliesList"), part(f, "FriendRequestsList")
        local function friendsList(): Frame?
            for _, c in ipairs(frames.children(f)) do
                if field(c, "FilterBar") and c ~= allies and c ~= requests then
                    return c
                end
            end
            return nil
        end
        -- the side buttons: f's own unnamed buttons, about 54 square (the close
        -- button has a name)
        local buttons: Frame[] = {}
        for _, c in ipairs(frames.children(f)) do
            if frames.asButton(c) and not c:GetName() then
                local w, h = c:GetWidth(), c:GetHeight()
                if w > 40 and w < 70 and h > 40 and h < 70 then
                    buttons[#buttons + 1] = c
                end
            end
        end
        if #buttons < 4 then
            return
        end
        table.sort(buttons, function(a: Frame, b: Frame): boolean
            return (a:GetTop() or 0) > (b:GetTop() or 0)
        end)
        local pages: SocialPage[] = {
            { label = "Friends", frame = friendsList() },
            { label = "Recent allies", short = "Allies", frame = allies },
            { label = "Requests", frame = requests },
            { label = "Raid", frame = part(f, "RaidFrame") },
        }
        local tabs: SkinTab[] = {}
        for i, b in ipairs(buttons) do
            local page = pages[i]
            if page then
                local shown = page.frame
                tabs[#tabs + 1] = {
                    button = b,
                    label = page.label,
                    short = page.short or page.label,
                    selected = function(): boolean
                        return shown ~= nil and shown:IsShown()
                    end,
                }
                if shown then
                    hookScript(shown, "OnShow", function()
                        chrome:UpdateTabs()
                    end)
                end
            end
        end
        chrome:SetTabs(tabs)
    end

    --------------------------------------------------------------------------------
    -- The guild window (Blizzard's Communities window, J; 3.4): SuuUI's header,
    -- every texture of its own away, its side tabs (Chat, Roster, Info) as text
    -- tabs along the header; the play-style tab left out for now. The Guild
    -- module puts its pages over Blizzard's.
    --------------------------------------------------------------------------------

    function SkinCommunities()
        local f = find("CommunitiesFrame")
        if not f or chromeOf(f) then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Guild",
            icon = "flag",
            binding = "TOGGLEGUILDTAB",
            close = button(_G, "CommunitiesFrameCloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = withGlobal(art(f, "PortraitOverlay"), "CommunitiesFrameInset"),
        })
        clearArt(f, chrome)
        skinMaxMin(chrome, part(f, "MaxMinButtonFrame"))
        local tabs: SkinTab[] = {}
        -- the guild module's own pages (Log, Settings): while one shows,
        -- Blizzard's tabs aren't the lit one
        local function guild(): unknown
            local g = SuuUI.GetModule("guild")
            return g and g:IsEnabled() and g or nil
        end
        local function ownPage(): unknown
            return field(guild(), "ownPage")
        end
        local function showOwn(key: string?)
            tryMethod(guild(), "ShowOwn", key)
        end
        for _, t in ipairs({ { "ChatTab", "Chat" }, { "RosterTab", "Roster" }, { "GuildInfoTab", "Info" } }) do
            local b = part(f, t[1])
            if b then
                -- check buttons: the restyle pass made them checkboxes (found in
                -- game); they're tabs, drawn by SetTabs
                markOwn(b)
                local check = frames.asCheckButton(b)
                tabs[#tabs + 1] = {
                    button = b,
                    label = t[2],
                    short = t[2],
                    selected = function(): boolean
                        return ownPage() == nil and check ~= nil and check:GetChecked()
                    end,
                }
                hookScript(b, "OnClick", function()
                    showOwn(nil)
                    after(0, function()
                        chrome:UpdateTabs()
                    end)
                end)
            end
        end
        local gm = SuuUI.GetModule("guild")
        if gm and gm:Get("enabled") then
            local function ownTab(key: string, label: string): Button
                local b = CreateFrame("Button", nil, f)
                b:SetScript("OnClick", function()
                    showOwn(key)
                    chrome:UpdateTabs()
                end)
                tabs[#tabs + 1] = {
                    button = b,
                    label = label,
                    short = label,
                    selected = function(): boolean
                        return ownPage() == key
                    end,
                }
                return b
            end
            self.logTab = ownTab("log", "Log")
            -- Settings: the Guild Master's (the ranks and what each may do)
            if flag(try(IsGuildLeader)) then
                self.settingsTab = ownTab("settings", "Settings")
            end
        end
        if #tabs > 0 then
            chrome:SetTabs(tabs)
        end
        -- the play-style and benefits tabs out of sight
        for _, key in ipairs({ "GuildPreferredPlaySettingsTab", "GuildBenefitsTab" }) do
            local b = part(f, key)
            if b then
                markOwn(b)
                quiet(b)
            end
        end
        if field(f, "SetDisplayMode") then
            local window = f :: Frame & { SetDisplayMode: (self: Frame, mode: unknown) -> () }
            hook(window, "SetDisplayMode", function()
                chrome:UpdateTabs()
            end)
        end
        hookScript(f, "OnShow", function()
            after(0, function()
                chrome:UpdateTabs()
            end)
        end)
        self.communities = chrome
    end

    --------------------------------------------------------------------------------
    -- The group finder window (LFGParentFrame, the vanilla-style one on Forever;
    -- probed 2026-10-14): SuuUI's header, wider (the Group Finder module's
    -- Browse page lists tool and chat entries side by side), its own art away,
    -- its three side tabs (frames that switch on a click's release:
    -- LFGParentFrame_SetActiveTab) as text tabs along the header: Browse, List
    -- yourself, Who. The Group Finder module puts its pages over Blizzard's.
    --------------------------------------------------------------------------------

    function SkinGroupFinder()
        local f = find("LFGParentFrame")
        if not f or chromeOf(f) then
            return
        end
        local size = WindowsModule.GROUP_FINDER_SIZE
        f:SetSize(size[1], size[2])
        local chrome = UI.SkinWindow(f, {
            title = "Group Finder",
            icon = "search",
            binding = "TOGGLEGROUPFINDER",
            close = button(_G, "LFGParentFrameCloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = {
                field(f, "NineSlice"),
                field(f, "PortraitContainer"),
                field(f, "TitleContainer"),
                field(_G, "LFGParentFramePortrait"),
                field(f, "Inset"),
                field(f, "Bg"),
                field(f, "TopTileStreaks"),
            },
        })
        clearArt(f, chrome)
        -- the eye (strata HIGH, over the header's tabs) out of sight and out of the way
        quiet(find("LFGParentFramePortrait"))
        local browse, listing, who = find("LFGBrowseFrame"), find("LFGListingFrame"), find("LFGWhoListFrame")
        -- each page is a whole Blizzard frame of its own over the window (found in
        -- game): its metal frame, portrait ring, "Looking For Group" title and
        -- backdrops away; its controls stay
        for _, page in ipairs({ browse, listing, who }) do
            for _, key in ipairs({
                "NineSlice",
                "PortraitContainer",
                "TitleContainer",
                "Bg",
                "TopTileStreaks",
                "BackgroundArt",
                "headerBackground",
                "insideFrame",
                "BarTop",
                "BarMiddle",
                "Inset",
                "RolesSection",
                "DividerFrame",
            }) do
                local r = frames.asRegion(field(page, key))
                if r then
                    r:SetAlpha(0)
                end
            end
        end
        local tabs: SkinTab[] = {}
        local listingTab: SkinTab? = nil
        local listingButton = part(f, "ListingTab")
        for _, t in ipairs({
            { part(f, "BrowsingTab"), "Browse", browse, "Browse" },
            { listingButton, "List yourself", listing, "List" },
            { part(f, "WhoListingTab"), "Who", who, "Who" },
        }) do
            local b, label, page, short = frames.asFrame(t[1]),
                asString(t[2]) or "",
                frames.asFrame(t[3]),
                asString(t[4])
            if b then
                local tab: SkinTab = {
                    button = b,
                    label = label,
                    short = short or label,
                    selected = function(): boolean
                        return page ~= nil and page:IsShown()
                    end,
                }
                tabs[#tabs + 1] = tab
                if b == listingButton then
                    listingTab = tab
                end
                if page then
                    hookScript(page, "OnShow", function()
                        chrome:UpdateTabs()
                    end)
                end
            end
        end
        chrome:SetTabs(tabs)
        self.groupFinder = chrome
        -- the second tab says My listing while you're listed
        local function relabel()
            if not listingTab then
                return
            end
            local listed = flag(try(field(C_LFGList, "HasActiveEntryInfo")))
            listingTab.label = listed and "My listing" or "List yourself"
            listingTab.short = listed and "Listing" or "List"
            chrome:LayoutTabs()
        end
        self:OnGameEvent("LFG_LIST_ACTIVE_ENTRY_UPDATE", relabel)
        relabel()
        -- the tab row's right: a gear that opens Settings › Group Finder
        local gear = CreateFrame("Button", nil, chrome.head)
        gear:SetSize(22, 22)
        gear:SetPoint("BOTTOMRIGHT", chrome.head, "BOTTOMRIGHT", -S["space-5"], S["space-1"])
        gear:SetFrameLevel(chrome.head:GetFrameLevel() + 3)
        local glyph = gear:CreateTexture(nil, "ARTWORK")
        glyph:SetTexture(GLYPHS .. "gear.tga")
        glyph:SetSize(14, 14)
        glyph:SetPoint("CENTER")
        UI.Paint(glyph, "ink-muted")
        local edge = UI.Border(gear, "gilt-line")
        edge:SetShown(false)
        gear:SetScript("OnEnter", function(b: Button)
            edge:SetShown(true)
            UI.Paint(glyph, "ink")
            UI.ShowTooltip(b, {
                title = "Group Finder settings",
                description = "Channels, languages, your ad and the notifications",
            })
        end)
        gear:SetScript("OnLeave", function()
            edge:SetShown(false)
            UI.Paint(glyph, "ink-muted")
            UI.HideTooltip()
        end)
        gear:SetScript("OnClick", function()
            SuuUI.OpenSettings("groupfinder")
        end)
        self.gear = gear
    end

    --------------------------------------------------------------------------------
    -- The world map (3.5, stage 1; source read 2026-10-15: WorldMapFrame isn't
    -- protected, its quest log is QuestMapFrame docked as a 333px side panel):
    -- SuuUI's header with "Continent › Zone", the game's border, portrait and
    -- title away, the quest log and its details restyled in place (their
    -- clicks stay the game's), the game's own filter menu, side-panel toggle
    -- and maximize in SuuUI's look, and a status line: the coordinates under
    -- the cursor (yours when it's off the map). Small, in the window row under
    -- the micro menu; maximized, SuuUI's enlarged map in the screen's middle.
    --------------------------------------------------------------------------------

    function RestyleQuestLog()
        local q = find("QuestMapFrame")
        if not q then
            return
        end
        local list = frames.asScrollFrame(field(_G, "QuestScrollFrame"))
        local sb = part(list, "SearchBox")
        -- (its × not made a button by the reskin)
        local clear = part(sb, "clearButton")
        if clear then
            leave(clear, "button")
        end
        UI.Reskin(q)
        if sb and not styledSearch[sb] then
            styleQuestSearch(sb)
        end
        local d = part(q, "DetailsFrame")
        if d then
            for _, key in ipairs({ "Bg", "SealMaterialBG", "BorderFrame" }) do
                local r = frames.asRegion(field(d, key))
                if r then
                    r:SetAlpha(0)
                end
            end
            if not styledDetails[d] then
                styledDetails[d] = true
                self:StyleDetails(d)
            end
        end
        -- the list's ornate frame and parchment away
        if not list then
            return
        end
        for _, key in ipairs({ "BorderFrame", "Background" }) do
            local r = frames.asRegion(field(list, key))
            if r then
                r:SetAlpha(0)
            end
        end
        if not placedList[list] then
            placedList[list] = true
            self:PlaceQuestList(q, list)
        end
        -- the zone headers in label ink, hovered or not (the game switches a
        -- header's font on hover, so a header first seen hovered read as a
        -- title; found in game)
        -- (their own font in ink: the button takes its font's colour on hover)
        local label = self.questFont
        if not label then
            local made = CreateFont("SuuUIQuestHeaderFont")
            made:CopyFontObject(SuuUI.Fonts.Get("label"))
            UI.Bind(made, inkFont)
            self.questFont = made
            label = made
        end
        for _, poolKey in ipairs({ "headerFramePool", "campaignHeaderMinimalFramePool" }) do
            for _, row in ipairs(frames.rows(field(list, poolKey))) do
                local b = frames.asButton(row)
                if b then
                    b:SetNormalFontObject(label)
                    b:SetHighlightFontObject(label)
                    b:SetDisabledFontObject(label)
                end
                for _, fs in ipairs(frames.fontStrings(row)) do
                    fs:SetFontObject(label)
                    UI.Paint(fs, "ink")
                end
                local text = frames.asFontString(field(row, "ButtonText") or (b and b:GetFontString()))
                if text then
                    text:SetFontObject(label)
                    UI.Paint(text, "ink")
                end
            end
        end
        -- a tracked quest: the drawing's eye, not the game's yellow tick
        for _, row in ipairs(frames.rows(field(list, "titleFramePool"))) do
            local cb = part(row, "Checkbox")
            if cb then
                local eye = trackEyes[cb]
                if not eye then
                    for _, r in ipairs(frames.textures(cb)) do
                        r:SetAlpha(0)
                    end
                    local made = cb:CreateTexture(nil, "OVERLAY", nil, 7)
                    made:SetTexture(GLYPHS .. "eye.tga")
                    made:SetSize(14, 14)
                    made:SetPoint("CENTER")
                    UI.Paint(made, "ink-muted")
                    trackEyes[cb] = made
                    eye = made
                end
                eye:SetShown(shows(field(cb, "CheckMark")))
            end
        end
        fitQuestRows(list)
    end

    -- The quest details, once: sized for SuuUI's window, the buttons and
    -- rewards centred in their column, the game's art away.
    function StyleDetails(d: Frame)
        -- the game sizes the details for its own window (502 px, its
        -- text 430, from the log's top 1 px down): to the log's bottom
        -- instead, 3 px above it as the game's, so they fit the small
        -- window and run all the way down the enlarged one (fixed, they
        -- stopped two thirds down it, found in game); the text to the
        -- game's 29 px above the details' bottom
        d:SetPoint("BOTTOMRIGHT", 0, 3)
        local scroll = part(d, "ScrollFrame")
        if scroll then
            scroll:SetPoint("BOTTOMLEFT", d, "BOTTOMLEFT", 5, 29)
        end
        -- Abandon / Share / Track and the rewards centred in the column
        -- the details sit in, between the map and the window's edge,
        -- measured as they show (lined up with the details alone they
        -- sat left: the column runs on past them over the text's scroll
        -- bar; found in game). The game's dividers between them away.
        for _, key in ipairs({ "AbandonButton", "ShareButton", "TrackButton" }) do
            for _, r in ipairs(frames.textures(part(d, key) or d)) do
                local atlas = part(d, key) and asString(r:GetAtlas())
                if atlas and atlas:find("BtnDiv") then
                    r:SetAlpha(0)
                end
            end
        end
        -- (a frame after showing, when the positions are there; again when
        -- the window changes size: fullscreen)
        local function place()
            after(0, function()
                self:PlaceQuestDetails()
            end)
        end
        hookScript(d, "OnShow", place)
        local map = find("WorldMapFrame")
        if map then
            hookScript(map, "OnSizeChanged", place)
        end
        -- the strip with Back: its art away, a hairline under it
        local back = part(d, "BackFrame")
        if back then
            for _, r in ipairs(frames.textures(back)) do
                r:SetAlpha(0)
            end
            local line = UI.Hairline(back, "gilt-line")
            line:SetPoint("BOTTOMLEFT", 6, 8)
            line:SetPoint("BOTTOMRIGHT", -6, 8)
        end
        -- the rewards: surface instead of the brown art (still opaque:
        -- the text scrolls under it), a hairline on top, the label in ink
        local rewards = part(d, "RewardsFrameContainer", "RewardsFrame")
        if rewards then
            for _, key in ipairs({ "Top", "Bottom", "Background" }) do
                local r = frames.asRegion(field(rewards, key))
                if r then
                    r:SetAlpha(0)
                end
            end
            local fill = UI.Fill(rewards, "surface", "BACKGROUND")
            fill:SetAllPoints()
            local line = UI.Hairline(rewards, "gilt-line")
            line:SetPoint("TOPLEFT", 6, 0)
            line:SetPoint("TOPRIGHT", -6, 0)
            local label = frames.asFontString(field(rewards, "Label"))
            if label then
                label:SetFontObject(SuuUI.Fonts.Get("label"))
                UI.Paint(label, "ink")
            end
        end
    end

    function PlaceQuestList(q: Frame, list: Frame)
        local quests = part(q, "QuestsFrame")
        if quests then
            list:ClearAllPoints()
            list:SetPoint("TOPLEFT", quests, "TOPLEFT", LIST_SHIFT, 0)
            list:SetPoint("BOTTOMRIGHT", quests, "BOTTOMRIGHT", LIST_SHIFT, 0)
        end
        -- (its 8px in the middle of the 24px between the headers and the edge)
        local bar = part(list, "ScrollBar")
        if bar then
            bar:ClearAllPoints()
            bar:SetPoint("TOPLEFT", list, "TOPRIGHT", -2, 2)
            bar:SetPoint("BOTTOMLEFT", list, "BOTTOMRIGHT", -2, -4)
        end
        -- the search box: its left (SuuUI's edge 4px outside it) under the
        -- headers' left (the log is questLogWidth wide at the window's right),
        -- its right by the count, its middle on the row's
        local sb, count, map = part(list, "SearchBox"), find("QuestLogCount"), find("WorldMapFrame")
        local mapChrome = map and chromeOf(map)
        if not (sb and count and map and mapChrome) then
            return
        end
        local fromRight = (asNumber(field(map, "questLogWidth")) or 333) - LIST_SHIFT - HEADER_X - 4
        sb:ClearAllPoints()
        sb:SetPoint("LEFT", mapChrome.head, "BOTTOMRIGHT", -fromRight, ROW_MID)
        sb:SetPoint("RIGHT", count, "LEFT", -S["space-3"], 0)
    end

    -- The quest details' buttons and rewards, centred between the map and the
    -- window's edge with the same margin either side.
    function PlaceQuestDetails()
        local f = find("WorldMapFrame")
        local d = part(find("QuestMapFrame"), "DetailsFrame")
        local container = part(f, "ScrollContainer")
        if not (f and d and d:IsVisible() and container) then
            return
        end
        local mapRight, edge, left = container:GetRight(), f:GetRight(), d:GetLeft()
        if not (mapRight and edge and left) then
            return
        end
        local MARGIN, GAP = 11, 4
        local x0, x1 = mapRight + MARGIN - left, edge - MARGIN - left
        local ab, sh, tr = part(d, "AbandonButton"), part(d, "ShareButton"), part(d, "TrackButton")
        if ab and sh and tr then
            local w = math.floor((x1 - x0 - 2 * GAP) / 3)
            ab:ClearAllPoints()
            ab:SetPoint("BOTTOMLEFT", x0, 0)
            sh:ClearAllPoints()
            sh:SetPoint("LEFT", ab, "RIGHT", GAP, 0)
            tr:ClearAllPoints()
            tr:SetPoint("LEFT", sh, "RIGHT", GAP, 0)
            for _, btn in ipairs({ ab, sh, tr }) do
                btn:SetWidth(w)
            end
        end
        -- (the rewards start at the details' left: as wide as puts their middle
        -- in the column's)
        local box = part(d, "RewardsFrameContainer")
        if box then
            box:SetWidth(x0 + x1)
            local rewards = part(box, "RewardsFrame")
            if rewards then
                rewards:SetWidth(x0 + x1)
            end
        end
    end

    function SkinWorldMap()
        if not find("WorldMapFrame") then
            return
        end
        local f = WorldMapFrame
        if chromeOf(f) then
            return
        end
        local b = part(f, "BorderFrame")
        local chrome = UI.SkinWindow(f, {
            title = mapTitle(shownMap()),
            icon = "map",
            binding = "TOGGLEWORLDMAP",
            close = button(b, "CloseButton") or button(_G, "WorldMapFrameCloseButton"),
            topInset = 24 + ROW_EXTRA,
            headExtra = ROW_EXTRA,
            under = "microMenu",
            hide = {
                field(b, "NineSlice"),
                field(b, "PortraitContainer"),
                field(b, "TitleContainer"),
                field(b, "Bg"),
                field(b, "TopTileStreaks"),
                field(b, "InsetBorderTop"),
            },
        })
        -- the help-plate button: away
        quiet(part(b, "Tutorial"))
        local mm = part(b, "MaximizeMinimizeFrame")
        skinMaxMin(chrome, mm)
        -- the title follows the map; a click on it goes up a level (as a
        -- right-click on the map does): the header names the place, so the
        -- game's breadcrumb bar goes, and its strip with it
        local title = chrome.title
        local up = CreateFrame("Button", nil, chrome.head)
        up:SetPoint("TOPLEFT", title, "TOPLEFT", -2, 2)
        up:SetPoint("BOTTOMRIGHT", title, "BOTTOMRIGHT", 2, -2)
        up:SetFrameLevel(chrome.head:GetFrameLevel() + 2)
        up:SetScript("OnClick", function()
            local id = shownMap()
            local info = id and C_Map.GetMapInfo(id)
            local parent = info and info.parentMapID
            if parent and parent > 0 then
                f:SetMapID(parent)
            end
        end)
        up:SetScript("OnEnter", function(self2: Button)
            local id = shownMap()
            local info = id and C_Map.GetMapInfo(id)
            local parent = info and info.parentMapID and C_Map.GetMapInfo(info.parentMapID)
            if parent then
                UI.ShowTooltip(self2, { title = "Up to " .. parent.name, description = "Or right-click the map" })
            end
            title:SetColor("ink")
        end)
        up:SetScript("OnLeave", function()
            UI.HideTooltip()
            title:SetColor("gilt-text")
        end)
        events.onRegistry(
            "MapCanvas.MapSet",
            function(mapID: unknown)
                if f:IsShown() then
                    chrome:SetTitle(mapTitle(asNumber(mapID)))
                end
            end,
            self
        )
        -- (left where the game puts it, which it measures itself against:
        -- see-through, and its buttons, made again on every map change, without
        -- the mouse so they don't take clicks over the map's top)
        local function quietNav()
            local nb = part(f, "NavBar")
            if not nb then
                return
            end
            nb:SetAlpha(0)
            nb:EnableMouse(false)
            for _, btn in ipairs(tbl.list(field(nb, "navList"))) do
                local frame = frames.asFrame(btn)
                if frame then
                    frame:EnableMouse(false)
                end
            end
            for _, key in ipairs({ "home", "overflowButton" }) do
                local frame = part(nb, key)
                if frame then
                    frame:EnableMouse(false)
                end
            end
        end
        quietNav()
        hook(f, "OnMapChanged", quietNav)
        -- the map right under the header (the game sets its top whenever the
        -- quest log opens or closes)
        local spacer = part(f, "TitleCanvasSpacerFrame")
        local function logWidth(): number
            return shows(field(f, "QuestLog")) and (asNumber(field(f, "questLogWidth")) or 0) or 0
        end
        if spacer and field(f, "UpdateSpacerFrameAnchoring") then
            local function placeSpacer()
                spacer:SetPoint("BOTTOMRIGHT", f, "TOPRIGHT", -3 - logWidth(), -MAP_TOP)
                f:OnFrameSizeChanged()
            end
            hook(f, "UpdateSpacerFrameAnchoring", placeSpacer)
            placeSpacer()
            -- the breadcrumb bar measures itself between the spacer's top and
            -- bottom (25px under its top): kept as tall as it was
            local nb = part(f, "NavBar")
            if nb then
                local x = asNumber(field(_G, "WorldMapConstants", "NAVBAR_X_OFFSET")) or 0
                nb:SetPoint("BOTTOMRIGHT", spacer, "BOTTOMRIGHT", x, 9 - CUT)
            end
        end
        -- the game's own coordinates (SuuUI's status line shows them)
        for _, o in ipairs(tbl.list(field(f, "overlayFrames"))) do
            local frame = frames.asFrame(o)
            if frame and field(o, "PlayerCoords") and field(o, "CursorCoords") then
                frame:SetAlpha(0)
            end
        end
        -- the header's second row: the game's filter menu (its reset × away)
        -- and waypoint pin on the left, the quest log's search, count and
        -- settings on the right
        local track, pin = part(f, "WorldMapTrackingOptionsButton"),
            frames.asButton(field(f, "WorldMapTrackingPinButton"))
        local function placeRow()
            if track then
                track:ClearAllPoints()
                track:SetPoint("LEFT", chrome.head, "BOTTOMLEFT", S["space-5"], ROW_MID)
                track:SetFrameLevel(chrome.head:GetFrameLevel() + 3)
            end
            if pin then
                pin:ClearAllPoints()
                if track then
                    pin:SetPoint("LEFT", track, "RIGHT", S["space-2"], 0)
                else
                    pin:SetPoint("LEFT", chrome.head, "BOTTOMLEFT", S["space-5"], ROW_MID)
                end
                pin:SetFrameLevel(chrome.head:GetFrameLevel() + 3)
            end
        end
        if track then
            UI.ReskinDropdown(track, { glyph = "filter" })
            track:SetSize(22, 22)
            quiet(part(track, "ResetButton"))
        end
        if pin then
            glyphOn(pin, "pushpin", 14)
        end
        placeRow()
        -- the game anchors them over the map again on every map change
        hook(f, "OnMapChanged", placeRow)
        if field(f, "AdjustOverlayFrames") then
            hook(f, "AdjustOverlayFrames", placeRow)
        end
        local list = find("QuestScrollFrame")
        if list then
            -- the log's top level with the map's (the game's -25)
            local q = find("QuestMapFrame")
            if q and q:GetParent() == f then
                q:SetPoint("TOPRIGHT", f, "TOPRIGHT", -3, -MAP_TOP)
            end
            -- the list starts level with the map (the search row was over it)
            list:SetPoint("TOPLEFT", 0, 0)
            local gear, count, search = part(list, "SettingsDropdown"), find("QuestLogCount"), part(list, "SearchBox")
            local right: Frame = chrome.head
            if gear then
                UI.ReskinDropdown(gear, { glyph = "gear" })
                gear:SetSize(22, 22)
                gear:ClearAllPoints()
                gear:SetPoint("RIGHT", chrome.head, "BOTTOMRIGHT", -S["space-5"], ROW_MID)
                -- its menu under the header's rule, not over the row
                local anchor = try(
                    field(_G, "AnchorUtil", "CreateAnchor"),
                    "TOPRIGHT",
                    gear,
                    "BOTTOMRIGHT",
                    0,
                    -(ROW_MID - 11 + S["space-2"])
                )
                if anchor then
                    tryMethod(gear, "SetMenuAnchor", anchor)
                end
                right = gear
            end
            if count then
                count:ClearAllPoints()
                if gear then
                    count:SetPoint("RIGHT", gear, "LEFT", -S["space-3"], 0)
                else
                    count:SetPoint("RIGHT", chrome.head, "BOTTOMRIGHT", -S["space-5"], ROW_MID)
                end
                right = count
            end
            if search and right ~= chrome.head then
                search:ClearAllPoints()
                search:SetPoint("RIGHT", right, "LEFT", -S["space-3"], 0)
            end
        end
        local toggle = part(f, "SidePanelToggle")
        for _, key in ipairs({ "OpenButton", "CloseButton" }) do
            local btn = button(toggle, key)
            if btn then
                for _, t in ipairs(frames.stateTextures(btn)) do
                    t:SetAlpha(0)
                end
                UI.Fill(btn, "surface-raised", "BACKGROUND", 7):SetAllPoints()
                UI.Border(btn, "gilt-line")
                local g = btn:CreateTexture(nil, "OVERLAY")
                g:SetTexture(GLYPHS .. (key == "OpenButton" and "chevronLeft" or "chevronRight") .. ".tga")
                g:SetSize(12, 12)
                g:SetPoint("CENTER")
                UI.Paint(g, "ink-muted")
            end
        end
        -- the quest log: restyled now and whenever the game lays it out again
        self:RestyleQuestLog()
        if field(_G, "QuestLogQuests_Update") then
            hook("QuestLogQuests_Update", function()
                self:RestyleQuestLog()
            end)
        end
        if field(_G, "QuestMapFrame_ShowQuestDetails") then
            hook("QuestMapFrame_ShowQuestDetails", function()
                after(0, function()
                    self:RestyleQuestLog()
                end)
            end)
        end
        self.status = self:StatusLine(f)
        self:Enlarging(f, chrome, mm)
        self.worldMap = chrome
    end

    -- The status line: the coordinates, over the map's bottom left (no zoom
    -- buttons: the mouse wheel zooms, asked in game).
    function StatusLine(f: typeof(WorldMapFrame)): Frame
        local status = CreateFrame("Frame", nil, f)
        -- (over the map's pins, the game's and SuuUI's: frame levels 2000 up)
        status:SetFrameLevel(4000)
        -- (as wide as its text, at least as "00.0, 00.0": the zoom buttons it
        -- once held are gone)
        local function measureMin(): number
            return math.ceil(UI.MeasureText("numeric", "00.0, 00.0"))
        end
        local minW = measureMin()
        local container = part(f, "ScrollContainer")
        status:SetSize(minW + 2 * S["space-4"], 26)
        status:SetPoint("BOTTOMLEFT", container or f, "BOTTOMLEFT", S["space-3"], S["space-3"])
        UI.Fill(status, "surface-glass"):SetAllPoints()
        UI.Border(status, "gilt-line")
        local coord = UI.Text(status, "numeric", "ink")
        coord:SetPoint("LEFT", S["space-4"], 0)
        local wait = 0
        status:SetScript("OnUpdate", function(_: Frame, elapsed: number)
            wait = wait - elapsed
            if wait > 0 then
                return
            end
            wait = 0.05
            local x: number?, y: number?, you = nil, nil, false
            -- the cursor's spot while it's over the map, over a pin too (the
            -- canvas loses the mouse focus to the pin: it read your position;
            -- found in game); yours off the map
            if container and container:IsMouseOver() then
                local rx, ry = f:GetNormalizedCursorPosition()
                local cx, cy = secret.asNumber(rx), secret.asNumber(ry)
                if cx and cy and cx >= 0 and cx <= 1 and cy >= 0 and cy <= 1 then
                    x, y = cx, cy
                end
            end
            if not x then
                local id = shownMap()
                local pos = id and C_Map.GetPlayerMapPosition(id, "player")
                if pos then
                    x, y = pos:GetXY()
                    you = true
                end
            end
            if x and y and (x > 0 or y > 0) then
                local text = ("%.1f, %.1f"):format(x * 100, y * 100)
                local w = math.ceil(UI.MeasureText("numeric", text .. (you and "  you" or "")))
                coord:SetValue(text .. (you and "  |cff" .. T.color["ink-muted"].hex .. "you|r" or ""))
                status:SetWidth(math.max(minW, w) + 2 * S["space-4"])
                status:SetAlpha(1)
            else
                coord:SetValue("")
                status:SetAlpha(0)
            end
        end)
        -- a theme can change the numbers' width
        self:On("SUUUI_THEME_CHANGED", function()
            minW = measureMin()
        end)
        return status
    end

    -- The window's size around the map's new top: windowed, shorter by the
    -- room the game kept over the map. Enlarged (the maximize button): the
    -- same window larger, in the screen's middle, the quest log beside it as
    -- you left it, the world around it seen and clickable (asked in game).
    -- The game's own fullscreen isn't used: its black backdrop
    -- blocks the world and it shows the map alone.
    function Enlarging(f: typeof(WorldMapFrame), chrome: WindowChrome, mm: Frame?)
        local function enlarged(): boolean
            return self:Get("mapEnlarged")
        end
        local function share(): number
            local wm = SuuUI.GetModule("worldmap")
            return (asNumber(wm and wm:Get("enlargedSize")) or 80) / 100
        end
        local function logWidth(): number
            return shows(field(f, "QuestLog")) and (asNumber(field(f, "questLogWidth")) or 0) or 0
        end
        local function look(on: boolean)
            if mm then
                tryMethod(mm, on and "SetMinimizedLook" or "SetMaximizedLook")
            end
        end
        local function fit()
            if flag(tryMethod(f, "IsMaximized")) then
                return
            end
            local log = logWidth()
            local minW, minH = asNumber(field(f, "minimizedWidth")), asNumber(field(f, "minimizedHeight"))
            if not enlarged() then
                if minW then
                    f:SetWidth(minW + log)
                end
                if minH then
                    f:SetHeight(minH - CUT)
                end
                f:OnFrameSizeChanged()
                return
            end
            -- the map keeps the windowed map's shape; the window, header
            -- included, the setting's share of the screen's height, and narrower
            -- than the screen
            local w0, h0 = (minW or 702) - 5, (minH or 534) - GAME_MAP_TOP - 2
            local margin = S["space-3"]
            local mapH = UIParent:GetHeight() * share() - (chrome.riseH or 0) - MAP_TOP - 2
            local mapW = mapH * w0 / h0
            local roomW = UIParent:GetWidth() - 2 * margin - 5 - log
            if mapW > roomW then
                mapW, mapH = roomW, roomW * h0 / w0
            end
            f:SetSize(math.floor(mapW + 5 + log), math.floor(mapH + MAP_TOP + 2))
            f:OnFrameSizeChanged()
        end
        local function setEnlarged(on: boolean)
            self:Set("mapEnlarged", on)
            look(on)
            fit()
            -- enlarged in the middle of the screen, small in the window row
            -- under the micro menu
            UI.CenterWindow(f, on)
        end
        if mm then
            -- the game minimizes on every open (to its own state): only the
            -- buttons' clicks change the size
            tryMethod(mm, "SetOnMaximizedCallback", function() end)
            tryMethod(mm, "SetOnMinimizedCallback", function() end)
            local max, min = button(mm, "MaximizeButton"), button(mm, "MinimizeButton")
            if max then
                hookScript(max, "OnClick", function()
                    setEnlarged(true)
                end)
            end
            if min then
                hookScript(min, "OnClick", function()
                    setEnlarged(false)
                end)
            end
        end
        -- the game's fullscreen, chosen before (its setting): enlarged instead
        if not GetCVarBool("miniWorldMap") then
            SetCVar("miniWorldMap", 1)
            self:Set("mapEnlarged", true)
        end
        hook(f, "Minimize", fit)
        if field(f, "SetQuestLogPanelShown") then
            hook(f, "SetQuestLogPanelShown", fit)
        end
        UI.CenterWindow(f, enlarged())
        hookScript(f, "OnShow", function()
            look(enlarged())
            fit()
        end)
        self:On("SUUUI_SETTING_CHANGED", function(_, namespace: string, key: string)
            if namespace == "worldmap" and key == "enlargedSize" and f:IsShown() then
                fit()
            end
        end)
        -- a theme can change the header's height
        self:On("SUUUI_THEME_CHANGED", function()
            if f:IsShown() and not InCombatLockdown() then
                fit()
            end
        end)
        fit()
    end

    --------------------------------------------------------------------------------
    -- The trainer window (3.6): restyled in place, the game's list and Train
    -- (Blizzard_TrainerUI, loaded on demand); the trainer's name in the title.
    -- Only while the Trainer module (SuuUI's own window) is off.
    --------------------------------------------------------------------------------

    function SkinTrainer()
        local f = find("ClassTrainerFrame")
        if not f or chromeOf(f) then
            return
        end
        -- SuuUI's own trainer window takes its place while that module is on
        local own = SuuUI.GetModule("trainer")
        if own and own:IsEnabled() then
            return
        end
        local trainerUI = { addon = "Blizzard_TrainerUI" }
        hook(
            _G,
            "ClassTrainerFrame_InitServiceButton",
            function(b: unknown)
                styleTrainerRow(b)
            end,
            trainerUI
        )
        hook(
            _G,
            "ClassTrainerFrame_InitCategoryButton",
            function(c: unknown)
                styleTrainerCategory(c)
            end,
            trainerUI
        )
        -- a profession's next rank (Journeyman Blacksmith) sits over the list as
        -- a row of its own, filled by the list's update
        hook(
            _G,
            "ClassTrainerFrame_Update",
            function()
                local step = find("ClassTrainerFrameSkillStepButton")
                if step and step:IsShown() then
                    styleTrainerRow(step)
                end
            end,
            trainerUI
        )
        local hide = art(f)
        for _, extra in ipairs({
            field(_G, "ClassTrainerFrameInset", "NineSlice"),
            field(_G, "ClassTrainerFrameInsetBg"),
            field(_G, "ClassTrainerFrameMoneyBg"),
            field(_G, "ClassTrainerFrameBottomInset"),
        }) do
            hide[#hide + 1] = extra
        end
        local chrome = UI.SkinWindow(f, {
            title = "Trainer",
            icon = "book",
            close = button(_G, "ClassTrainerFrameCloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = hide,
        })
        -- the frame's own art away (SuuUI's glass stays)
        clearArt(f, chrome)
        local scrollBox, scrollBar = part(f, "ScrollBox"), part(f, "ScrollBar")
        if scrollBox then
            UI.ReskinScrollBox(scrollBox)
        end
        if scrollBar then
            UI.ReskinScrollBar(scrollBar)
        end
        local status = frames.asStatusBar(field(_G, "ClassTrainerStatusBar"))
        if status then
            UI.ReskinStatusBar(status)
        end
        local d = part(f, "FilterDropdown")
        if d then
            UI.ReskinDropdown(d)
            -- the game's is 18px tall: room inside for SuuUI's field, centred on
            -- the rank bar's line, clear of the list
            d:SetSize(130, 26)
            d:ClearAllPoints()
            d:SetPoint("TOPRIGHT", f, "TOPRIGHT", -13, -31)
            local text = frames.asFontString(field(d, "Text") or field(d, "text"))
            if text then
                text:ClearAllPoints()
                text:SetPoint("LEFT", S["space-4"], 0)
                text:SetPoint("RIGHT", -(S["space-3"] + 12 + S["space-2"]), 0)
                text:SetJustifyH("LEFT")
            end
        end
        local train = button(_G, "ClassTrainerTrainButton")
        if train then
            UI.ReskinButton(train)
        end
        -- your money in SuuUI's money at the foot, the game's away
        local money = part(f, "money") or find("ClassTrainerFrameMoney")
        if money then
            money:SetAlpha(0)
        end
        local mine = UI.Money(f)
        mine:SetPoint("BOTTOMLEFT", S["space-5"], 9)
        local function title()
            local name = asString(UnitName("npc"))
            if name and name ~= "" then
                chrome:SetTitle(name)
            end
            UI.Reskin(f)
            mine:SetCopper(GetMoney())
        end
        hookScript(f, "OnEvent", function(_: Frame, event: string)
            if event == "PLAYER_MONEY" or event == "TRAINER_UPDATE" then
                mine:SetCopper(GetMoney())
            end
        end)
        hookScript(f, "OnShow", function()
            after(0, title)
        end)
        if f:IsShown() then
            title()
        end
        self.trainer = chrome
    end

    --------------------------------------------------------------------------------
    -- The collections window (3.6, design board "Collections"): restyled in
    -- place (the journal is protected; Summon and the toy buttons stay the
    -- game's own). Its five collections are text tabs along the top, as in
    -- SuuUI's other windows (asked in game, 2026-10-16: not icon tabs down the
    -- right side). The game hides a collection's tab while this character has
    -- nothing of it; SuuUI's stand-in takes its place, greyed, not clickable,
    -- its tooltip saying why, as does a tab whose count is 0. A collection with
    -- something in it is a normal tab again.
    --------------------------------------------------------------------------------

    -- The tab row: the game's tab where it shows one, SuuUI's stand-in where it
    -- hides one. The game lays its tabs out again each time the window opens;
    -- the window is protected, so this waits for the end of combat.
    function SetCollectionTabs()
        local f, chrome = find("CollectionsJournal"), self.collections
        if not (f and chrome) or InCombatLockdown() then
            return
        end
        local list: SkinTab[] = {}
        for id, def in ipairs(COLLECTION_TABS) do
            local tab = gameTab(f, id)
            local shown: Frame
            if tab and tab:IsShown() then
                shown = tab
                local standIn = self.standIns[id]
                if standIn then
                    standIn:Hide()
                end
            else
                local standIn = self.standIns[id] or CreateFrame("Button", nil, f)
                self.standIns[id] = standIn
                standIn:Show()
                shown = standIn
            end
            local hidden = shown ~= tab
            list[#list + 1] = {
                button = shown,
                label = def.label,
                reason = def.empty,
                selected = function(): boolean
                    return not hidden and asNumber(field(f, "TabContainer", "selectedTab")) == id
                end,
                disabled = function(): boolean
                    return hidden or emptyCount(def)
                end,
            }
        end
        chrome:SetTabs(list)
    end

    function SkinCollections()
        local f = find("CollectionsJournal")
        if not f or chromeOf(f) or InCombatLockdown() then
            return
        end
        local chrome = UI.SkinWindow(f, {
            title = "Collections",
            icon = "gem",
            binding = "TOGGLECOLLECTIONS",
            close = button(f, "CloseButton"),
            topInset = 20,
            under = "microMenu",
            hide = art(f),
        })
        self.collections = chrome
        -- the appearances' Items and Sets: SuuUI's text tabs (before the generic
        -- restyle, which would make buttons of them)
        local wardrobe = find("WardrobeCollectionFrame")
        if wardrobe then
            skinPaneTab(part(wardrobe, "ItemsTab") or find("WardrobeCollectionFrameTab1"))
            skinPaneTab(part(wardrobe, "SetsTab") or find("WardrobeCollectionFrameTab2"))
        end
        -- the game's parts in SuuUI's look, again whenever another pane shows
        local function refresh()
            UI.Reskin(f)
            for _, name in ipairs(PANES) do
                local pane = find(name)
                if pane and pane:IsShown() then
                    clearPaneArt(pane, 0)
                    sizeControls(pane)
                end
            end
            if wardrobe and wardrobe:IsShown() then
                placePaneTabs(wardrobe)
                local items = part(wardrobe, "ItemsCollectionFrame") or part(wardrobe, "activeFrame")
                skinSlotButtons(part(items, "SlotsFrame"), 0)
            end
            self:SetCollectionTabs()
        end
        hook(_G, "CollectionsJournal_UpdateSelectedTab", function()
            after(0, refresh)
        end, { addon = "Blizzard_Collections" })
        hookScript(f, "OnShow", function()
            after(0, refresh)
        end)
        self:SetCollectionTabs()
        if f:IsShown() then
            refresh()
        end
    end

    function SkinAll()
        self:SkinTrainer()
        self:SkinCollections()
        self:SkinSpells()
        self:SkinLegacy()
        self:SkinProfessions()
        self:SkinFriends()
        self:SkinSocial()
        self:SkinCommunities()
        self:SkinGroupFinder()
        self:SkinWorldMap()
    end

    override function OnEnable()
        self:SkinAll()
        -- their addons load on demand
        self:OnGameEvent("ADDON_LOADED", function()
            self:SkinAll()
        end)
        -- the spells window is protected: skinned after combat if it loaded during one
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self:SkinAll()
        end)
        -- a theme's text styles: the quest headers' font copied again, the quest
        -- log (its rows measured for the fonts) restyled
        self:On("SUUUI_THEME_CHANGED", function()
            local font = self.questFont
            if font then
                font:CopyFontObject(SuuUI.Fonts.Get("label"))
                UI.Bind(font, inkFont)
            end
            local q = find("QuestMapFrame")
            if q and q:IsVisible() then
                self:RestyleQuestLog()
            end
        end)
    end
end

M = SuuUI.AddModule(WindowsModule.new())
