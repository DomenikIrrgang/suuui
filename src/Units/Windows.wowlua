--------------------------------------------------------------------------------
-- The world map
--------------------------------------------------------------------------------

-- "Kalimdor › Durotar": the map's continent before its name.
-- The map the world map shows (Blizzard's code keeps it in a field its
-- declarations can't type).
local function shownMap(): number?
    return WorldMapFrame and secret.asNumber(WorldMapFrame:GetMapID()) or nil
end

local function mapTitle(mapID: number?): string
    local info = mapID and C_Map.GetMapInfo(mapID)
    if not info then
        return "World map"
    end
    local continent: string? = nil
    local parent = info.parentMapID
    local guard = 0
    local CONTINENT = Enum.UIMapType and Enum.UIMapType.Continent or 2
    while parent and parent > 0 and guard < 6 do
        local p = C_Map.GetMapInfo(parent)
        if not p then
            break
        end
        if p.mapType == CONTINENT then
            continent = p.name
            break
        end
        parent, guard = p.parentMapID, guard + 1
    end
    return continent and (continent .. " › " .. info.name) or info.name
end

-- The tracked quests' eyes, by their check box.
local trackEyes: { [Frame]: Texture } = tbl.weakKeys()

-- The map's top: the game keeps 67px over it for its breadcrumb bar
-- (TITLE_CANVAS_SPACER_FRAME_HEIGHT); SuuUI's starts it right under the
-- header, level with the quest log's top (the game's QuestMapFrame at -25,
-- moved down with it). The header's second row (filters, the log's search)
-- is ROW_EXTRA taller than other windows' (asked: a taller search box).
-- The window is as much shorter, so the map keeps its shape; the quest
-- log and its details run down to its bottom.
local ROW_EXTRA = 8
local GAME_MAP_TOP, MAP_TOP = 67, 25 + ROW_EXTRA
local CUT = GAME_MAP_TOP - MAP_TOP
-- the second row's controls, their middles on one line in it, the
-- chrome's rowMid (anchored by their bottoms, controls of different heights
-- sat at different heights: found in game)
local ROW_MID = S["space-1"] + 11 + ROW_EXTRA / 2
local SEARCH_H = 26

-- What SuuUI did once to the game's quest log parts (kept here, never on them).
local styledSearch: { [Frame]: boolean } = tbl.weakKeys()
local styledDetails: { [Frame]: boolean } = tbl.weakKeys()
local placedList: { [Frame]: boolean } = tbl.weakKeys()

-- The quest log's search box in the header's second row: as tall as the
-- row's controls allow, SuuUI's search glyph in front (the reskin hid the
-- game's), its × a glyph (the reskin had made it a button: a bare square).
local function styleQuestSearch(sb: Frame)
    styledSearch[sb] = true
    sb:SetHeight(SEARCH_H)
    -- (Forever sets it to 200 x 20 on every count update; its width is
    -- SuuUI's anchors')
    if field(_G, "QuestLogQuests_ShowQuestCount") then
        hook("QuestLogQuests_ShowQuestCount", function()
            sb:SetHeight(SEARCH_H)
        end)
    end
    local icon = frames.asTexture(field(sb, "searchIcon") or field(sb, "SearchIcon"))
    if icon then
        icon:SetTexture(GLYPHS .. "search.tga")
        icon:SetTexCoord(0, 1, 0, 1)
        icon:SetSize(12, 12)
        icon:ClearAllPoints()
        icon:SetPoint("LEFT", sb, "LEFT", S["space-1"], 0)
        icon:SetAlpha(1)
        UI.Paint(icon, "ink-muted")
        -- (the game tints it on focus)
        hookScript(sb, "OnEditFocusGained", function()
            UI.Paint(icon, "ink")
        end)
        hookScript(sb, "OnEditFocusLost", function()
            UI.Paint(icon, "ink-muted")
        end)
    end
    local instructions = frames.asFontString(field(sb, "Instructions"))
    if instructions then
        instructions:SetFontObject(SuuUI.Fonts.Get("body"))
        UI.Paint(instructions, "ink-muted")
    end
    local x = part(sb, "clearButton")
    if x then
        for _, r in ipairs(frames.textures(x)) do
            r:SetAlpha(0)
        end
        local glyph = x:CreateTexture(nil, "OVERLAY", nil, 7)
        glyph:SetTexture(GLYPHS .. "close.tga")
        glyph:SetSize(10, 10)
        glyph:SetPoint("CENTER")
        UI.Paint(glyph, "ink-muted")
        hookScript(x, "OnEnter", function()
            UI.Paint(glyph, "ink")
        end)
        hookScript(x, "OnLeave", function()
            UI.Paint(glyph, "ink-muted")
        end)
    end
end

-- The quest list's rows measured again: the game sizes each quest's row
-- for the fonts it had, the reskin gives SuuUI's after, and long
-- objectives wrapped onto more lines than their row had (into the next
-- quest; found in game). The game's sums (QuestLogQuests_AddQuestButton):
-- 8 + the title, each objective 3 (the first) or 2 under the one before,
-- 4 without objectives, 6 for the marker; then the list stacked again.
local function fitQuestRows(list: Frame)
    local titles = field(list, "titleFramePool")
    local contents = field(list, "Contents")
    if not (titles and field(contents, "Layout")) then
        return
    end
    local below: { [number]: number } = {}
    for _, line in ipairs(frames.rows(field(list, "objectiveFramePool"))) do
        local id = asNumber(field(line, "questID"))
        local text = frames.asFontString(field(line, "Text"))
        if id and text then
            local h = text:GetStringHeight()
            line:SetHeight(h)
            local before = below[id]
            below[id] = (before or 0) + h + (before and 2 or 3)
        end
    end
    local objectives = GetCVarBool("showQuestObjectivesInLog")
    local changed = false
    for _, row in ipairs(frames.rows(titles)) do
        local id = asNumber(field(row, "questID"))
        local text = frames.asFontString(field(row, "Text"))
        if id and text then
            local h = 8 + text:GetStringHeight() + (objectives and (below[id] or 0) or 4) + 6
            if math.abs(row:GetHeight() - h) > 0.5 then
                row:SetHeight(h)
                changed = true
            end
        end
    end
    if changed then
        tryMethod(contents, "Layout")
    end
end

-- a font object's colour in ink (UI.Paint colours regions, not fonts)
local function inkFont(font: Font)
    font:SetTextColor(UI.RGBA("ink"))
end

-- The quest list centred in the panel beside the map: the game keeps 22px
-- right of it for its scroll bar, which left its headers 12px from the
-- map and 35px from the window's edge (measured in game: /suu probe map
-- log). The list moves right by half the difference, the scroll bar into
-- the margin it leaves; the search box (fixed at 200px from the quest
-- count leftwards, it ran 10px over the map) starts where the headers do.
local LIST_SHIFT = 11
local HEADER_X = 9 -- the game's zone headers, from the list's left

--------------------------------------------------------------------------------
-- The trainer window
--------------------------------------------------------------------------------

-- What SuuUI added to a trainer row (kept here, never on the game's row).
type TrainerRow = { money: Money }
local trainerRows: { [Frame]: TrainerRow } = tbl.weakKeys()
local trainerHeads: { [Frame]: boolean } = tbl.weakKeys()

-- One service row after the game filled it: flat, a hairline under it, the
-- hover and the choice in SuuUI's colours, a 32px icon in an edge, the price
-- as SuuUI's money (ember digits while you can't afford it), and the name
-- and rank fitted again for SuuUI's type.
local function styleTrainerRow(given: unknown)
    local b = frames.asButton(given)
    local icon = b and frames.asTexture(field(b, "icon"))
    local name, nameSub, sub = frames.asFontString(field(b, "name")),
        frames.asFontString(field(b, "nameSubText")),
        frames.asFontString(field(b, "subText"))
    if not (b and icon and name and nameSub and sub) then
        return
    end
    local gameMoney = part(b, "money")
    local row = trainerRows[b]
    if not row then
        local n = b:GetNormalTexture()
        if n then
            n:SetAlpha(0)
        end
        local disabled = part(b, "disabledBG") or frames.asRegion(field(b, "disabledBG"))
        if disabled then
            disabled:SetAlpha(0)
        end
        local hl = b:GetHighlightTexture()
        if hl then
            UI.PaintFill(hl, "surface-raised")
            hl:SetBlendMode("BLEND")
            hl:SetAlpha(0.6)
        end
        local selected = frames.asTexture(field(b, "selectedTex"))
        if selected then
            UI.PaintFill(selected, "arcane-soft")
            selected:SetBlendMode("BLEND")
            selected:ClearAllPoints()
            selected:SetAllPoints()
        end
        local rule = b:CreateTexture(nil, "ARTWORK")
        UI.PaintFill(rule, "gilt-faint")
        rule:SetHeight(1)
        rule:SetPoint("BOTTOMLEFT", S["space-2"], 0)
        rule:SetPoint("BOTTOMRIGHT", -S["space-2"], 0)
        icon:SetSize(32, 32)
        icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        local iconEdge = CreateFrame("Frame", nil, b)
        iconEdge:SetAllPoints(icon)
        UI.Border(iconEdge, "gilt-hairline")
        if gameMoney then
            gameMoney:SetAlpha(0)
        end
        local money = UI.Money(b)
        money:SetPoint("TOPRIGHT", -S["space-4"], -S["space-3"])
        -- the row's texts are styled here, once: the general pass leaves them
        -- (it chose a font by each text's length, so rows differed)
        SuuUI.Fonts.Apply(name, "label")
        SuuUI.Fonts.Apply(nameSub, "caption")
        SuuUI.Fonts.Apply(sub, "caption")
        UI.Paint(name, "ink")
        UI.Paint(nameSub, "ink-muted")
        UI.Paint(sub, "ink-muted")
        local alternate = frames.asFontString(field(b, "alternateCost"))
        local texts: FontString[] = { name, nameSub, sub }
        if alternate then
            SuuUI.Fonts.Apply(alternate, "caption")
            texts[#texts + 1] = alternate
        end
        for _, fs in ipairs(texts) do
            leave(fs, "text")
            fs:SetShadowOffset(0, 0)
        end
        -- the requirements: one line under the name, to the row's right edge
        sub:ClearAllPoints()
        sub:SetPoint("TOPLEFT", name, "BOTTOMLEFT", 0, -4)
        sub:SetPoint("RIGHT", b, "RIGHT", -S["space-4"], 0)
        sub:SetHeight(14)
        sub:SetWordWrap(false)
        sub:SetJustifyV("TOP")
        row = { money = money }
        trainerRows[b] = row
    end
    -- the price (the game's frame stays, see-through: it still reports its state)
    local cost = gameMoney and gameMoney:IsShown() and asNumber(try(GetTrainerServiceCost, b:GetID())) or nil
    if cost and cost > 0 then
        row.money:SetCopper(cost)
        UI.Paint(row.money.text, GetMoney() >= cost and "ink" or "ember-text")
        row.money:Show()
    else
        row.money:Hide()
    end
    -- name and rank in the room the price leaves
    local priceW = row.money:IsShown() and (row.money:GetWidth() + S["space-4"]) or 0
    local room = b:GetWidth() - (6 + 32 + 6) - priceW - S["space-4"]
    local nameW = math.max(1, math.min(name:GetUnboundedStringWidth(), room))
    name:SetWidth(nameW)
    local rank = asString(nameSub:GetText())
    local subRoom = room - nameW - 5
    if rank and rank ~= "" and subRoom > 8 then
        nameSub:SetWordWrap(false)
        nameSub:SetWidth(math.min(nameSub:GetUnboundedStringWidth(), subRoom))
        nameSub:Show()
    else
        nameSub:Hide()
    end
end

-- A category row: its name as a SuuUI heading over a gilt-faint rule.
local function styleTrainerCategory(given: unknown)
    local c = frames.asFrame(given)
    if not c or trainerHeads[c] then
        return
    end
    trainerHeads[c] = true
    for _, key in ipairs({ "LeftPiece", "RightPiece", "CenterPiece" }) do
        local piece = frames.asRegion(field(c, key))
        if piece then
            piece:SetAlpha(0)
        end
    end
    local label = frames.asFontString(field(c, "Label"))
    if label then
        SuuUI.Fonts.Apply(label, "header")
        UI.Paint(label, "gilt-text")
        -- the game sets its own fonts on hover: back to SuuUI's after
        hookScript(c, "OnEnter", function()
            SuuUI.Fonts.Apply(label, "header")
            UI.Paint(label, "ink")
        end)
        hookScript(c, "OnLeave", function()
            SuuUI.Fonts.Apply(label, "header")
            UI.Paint(label, "gilt-text")
        end)
    end
    local collapse = frames.asTexture(field(c, "CollapseIcon"))
    if collapse then
        UI.Paint(collapse, "gilt-text")
    end
    local rule = c:CreateTexture(nil, "ARTWORK")
    UI.PaintFill(rule, "gilt-faint")
    rule:SetHeight(1)
    rule:SetPoint("BOTTOMLEFT", S["space-2"], 1)
    rule:SetPoint("BOTTOMRIGHT", -S["space-2"], 1)
end

