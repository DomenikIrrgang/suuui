-- Units/Windows.wowlua
-- Blizzard's other windows in SuuUI's WindowFrame look (Phase 3), restyled
-- in place through UI.SkinWindow: their clicks, tabs and panes stay
-- Blizzard's. Each window is skinned when its addon has loaded.
--   3.2a: the spells window (PlayerSpellsFrame: Specialization, Talents,
--         Spellbook; protected, so its parts move only out of combat) and the
--         Legacy window (LegacySystemFrame: Tree, Challenges, Reward track):
--         SuuUI's header, the tabs as text tabs along the top, Blizzard's
--         metal frame, portrait and title strip out of sight. Both open
--         lined up under the micro menu (the protected spells window moved
--         only out of combat). The Legacy window opens in the middle of the
--         screen instead (asked for in game), like SuuUI's Talents window.
--   3.3:  the professions window (ProfessionsFrame), in the middle too.
--   3.6:  the trainer window (ClassTrainerFrame), under the micro menu, and
--         the collections window (CollectionsJournal), its collections as
--         text tabs along the top, the empty ones greyed.
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import chromeOf from "/UI/WindowSkin"
import type WindowChrome, SkinTab from "/UI/WindowSkin"
import markOwn, leave from "/UI/Reskin"
import type Money from "/UI/Inventory"
import type TabMarker from "/UI/TabMarker"
import type Text from "/UI/Text"
import hook, hookScript from "wowlua:hooks"
import after from "wowlua:timer"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import * as events from "wowlua:events"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local try, tryMethod = errors.try, errors.tryMethod
local asString, asNumber, flag, field = secret.asString, secret.asNumber, secret.flag, tbl.field
local find = frames.find

-- (the world map enlarged: its maximize button)
local DEFAULTS = { mapEnlarged = true }

local M: WindowsModule

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"

-- A part of one of the game's frames, by its key(s).
local function part(f: unknown, ...: string): Frame?
    return frames.asFrame(field(f, ...))
end
local function button(f: unknown, ...: string): Button?
    return frames.asButton(field(f, ...))
end

-- The parts SkinWindow hides: a window's usual art, and more by key.
local function art(f: Frame, ...: string): unknown[]
    local out: unknown[] = {}
    for _, key in ipairs({ "NineSlice", "PortraitContainer", "TitleContainer", "Bg", "TopTileStreaks", ... }) do
        out[#out + 1] = field(f, key)
    end
    return out
end

-- A list of parts with one of the game's globals added.
local function withGlobal(list: unknown[], name: string): unknown[]
    list[#list + 1] = field(_G, name)
    return list
end

-- A window's own textures away (SuuUI's glass, its chrome's, stays).
local function clearArt(f: Frame, chrome: WindowChrome)
    for _, t in ipairs(frames.textures(f)) do
        if t ~= chrome.bg then
            t:SetAlpha(0)
        end
    end
end

-- One of the game's parts out of sight and out of the mouse's way.
local function quiet(r: Frame?)
    if not r then
        return
    end
    r:SetAlpha(0)
    r:EnableMouse(false)
end

-- A tab button's own label ("Talents").
local function tabLabel(b: Frame): string?
    return asString(tryMethod(field(b, "Text") or field(b, "text"), "GetText"))
end

-- Whether one of the game's parts shows now.
local function shows(r: unknown): boolean
    return flag(tryMethod(r, "IsShown"))
end

--------------------------------------------------------------------------------
-- The spells window
--------------------------------------------------------------------------------

-- The key each tab opens with.
local SPELL_BINDINGS: { [string]: string } = {
    Spellbook = "TOGGLESPELLBOOK",
    Talents = "TOGGLETALENTS",
    Specialization = "TOGGLESPECIALIZATION",
}

-- A button with a glyph on SuuUI's edge: the game's art away, the glyph in
-- ink-muted, ink with its edge on hover.
local function glyphOn(b: Button, glyphName: string, size: number)
    for _, r in ipairs(frames.textures(b)) do
        r:SetAlpha(0)
    end
    for _, t in ipairs(frames.stateTextures(b)) do
        t:SetAlpha(0)
    end
    local glyph = b:CreateTexture(nil, "OVERLAY", nil, 7)
    glyph:SetTexture(GLYPHS .. glyphName .. ".tga")
    glyph:SetSize(size, size)
    glyph:SetPoint("CENTER")
    UI.Paint(glyph, "ink-muted")
    local edge = UI.Border(b, "gilt-line")
    edge:SetShown(false)
    hookScript(b, "OnEnter", function()
        edge:SetShown(true)
        UI.Paint(glyph, "ink")
    end)
    hookScript(b, "OnLeave", function()
        edge:SetShown(false)
        UI.Paint(glyph, "ink-muted")
    end)
    b:SetSize(22, 22)
end

-- Blizzard's maximise/minimise pair, next to the key chip: a gilt plus or
-- minus on SuuUI's edge.
local function skinMaxMin(chrome: WindowChrome, mm: Frame?)
    if not mm then
        return
    end
    for _, key in ipairs({ "MaximizeButton", "MinimizeButton" }) do
        local b = button(mm, key)
        if b then
            glyphOn(b, key == "MaximizeButton" and "plus" or "minus", 12)
        end
    end
    mm:SetSize(22, 22)
    mm:ClearAllPoints()
    local right: Frame = chrome.key or chrome.close or chrome.head
    mm:SetPoint("RIGHT", right, "LEFT", -S["space-3"], 0)
    mm:SetFrameLevel(chrome.head:GetFrameLevel() + 3)
end

