-- Units/Readiness.wowlua
-- Readiness (step 1.13): between pulls, the big cooldowns of everyone in the
-- group who runs SuuUI (battle resurrection, mana and survival cooldowns),
-- and a Ready check button for the leader or an assistant. Each SuuUI shares
-- its own through addon messages (prefix "SuuUI": "RDY\t<id>:<seconds left>,…",
-- "RDYQ" asks everyone to send theirs). Hidden from the pull until the
-- encounter (or the fight) ends. Top right, under the minimap's place.
--
-- Cooldowns are read out of combat only (their times are secret in combat,
-- and addon messages are restricted there); what a player sent last stays,
-- counting down.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type Readiness, Entry as ReadinessEntry from "/UI/Readiness"
import type Position from "/EditMode/EditMode"
import * as secret from "wowlua:secret"
import after, every from "wowlua:timer"


local UI = SuuUI.UI

local DEFAULTS = {
    position = { point = "TOPRIGHT", x = -28, y = -300 } :: Position,
    shows = "off",      -- "instance" | "group" | "always" | "off"
}

local M: ReadinessModule


-- wowlua:secret's test, as a predicate of this file's own (0.9.1 narrows
-- nothing through an imported predicate while the project has an import
-- cycle; Docs/port-notes/units-group.md)
local function isSecret(v: unknown): v is Secret<unknown> return secret.isSecret(v) end
local function readable(v: unknown): v is number return not isSecret(v) and type(v) == "number" end
local PREFIX = "SuuUI"

-- The game's functions this file reads about the group and your spells,
-- taken once as it loads (as the release build's cached globals are).
-- Tests replace them here: a replacement in _G would taint Blizzard's own
-- code that reads it (docs: Docs/test-notes/units-group.md).
local game = {
    UnitClass = UnitClass, IsPlayerSpell = IsPlayerSpell,
    GetSpellInfo = C_Spell.GetSpellInfo, GetSpellCooldown = C_Spell.GetSpellCooldown, GetSpellName = C_Spell.GetSpellName,
    IsInRaid = IsInRaid, IsInGroup = IsInGroup, IsInInstance = IsInInstance,
    UnitExists = UnitExists, UnitIsUnit = UnitIsUnit,
    UnitIsGroupLeader = UnitIsGroupLeader, UnitIsGroupAssistant = UnitIsGroupAssistant,
    SendAddonMessage = C_ChatInfo.SendAddonMessage,
}
local HEARTBEAT = 30

-- The cooldowns a group plans around, per class (the first rank you know).
local MAJOR: { [string]: string[] } = {
    DRUID = { "Rebirth", "Innervate", "Tranquility" },
    SHAMAN = { "Mana Tide Totem", "Reincarnation" },
    WARRIOR = { "Shield Wall", "Last Stand", "Challenging Shout" },
    PALADIN = { "Lay on Hands", "Divine Intervention", "Blessing of Protection" },
    PRIEST = { "Power Infusion" },
    MAGE = { "Evocation", "Ice Block" },
    WARLOCK = {},
    ROGUE = {},
    HUNTER = {},
}

-- your own class is never secret
local function playerClass(): string
    local _, class = game.UnitClass("player")
    return class :: string
end

-- your own short name (the whole name first: Forever's surnames)
local function playerName(): string
    return Ambiguate(SuuUI.FullName("player") :: string, "short")
end

--------------------------------------------------------------------------------
-- Sharing
--------------------------------------------------------------------------------

local function channel(): ("RAID" | "PARTY")?
    if UI.Flag(game.IsInRaid()) then return "RAID" end
    if UI.Flag(game.IsInGroup()) then return "PARTY" end
    return nil
end

-- One of your cooldowns: its spell and the seconds left (0: ready).
type Cooldown = { id: number, left: number }
-- A cooldown someone shared: its spell and the GetTime() it's ready.
export type Shared = { id: number, endsAt: number }
-- What a player shared last, and when.
export type Heard = { at: number, spells: Shared[] }
-- The last message sent (for /suu ready).
export type Sent = { at: string, ok: boolean, result: string, text: string }

-- The share message for cooldowns { { id, left } }: "RDY\t<id>:<left>,…"
-- (seconds rounded).
local function encodeShare(own: Cooldown[]): string
    local parts: string[] = {}
    for _, c in ipairs(own) do parts[#parts + 1] = ("%d:%d"):format(c.id, math.floor(c.left + 0.5)) end
    return "RDY\t" .. table.concat(parts, ",")
end

-- A share message's cooldowns as { id, endsAt } (from `now`); nil when the
-- text isn't one.
local function decodeShare(text: string, now: number): Shared[]?
    local payload = text:match("^RDY\t(.*)$")
    if not payload then return nil end
    local spells: Shared[] = {}
    for id, left in payload:gmatch("(%d+):(%d+)") do
        local n = tonumber(id)
        if n then spells[#spells + 1] = { id = n, endsAt = now + (tonumber(left) or 0) } end
    end
    return spells
end

--------------------------------------------------------------------------------
-- The panel
--------------------------------------------------------------------------------

-- The group's members (you first) as { name, class }.
type Member = { name: string, class: (string | Secret<string>)?, you?: boolean }
local function roster(): Member[]
    local out: Member[] = { { name = playerName(), class = playerClass(), you = true } }
    local function add(unit: string)
        if game.UnitExists(unit) and not UI.Flag(game.UnitIsUnit(unit, "player")) then
            -- the whole name, as their messages carry it (Forever's surnames)
            local name = SuuUI.FullName(unit)
            if not isSecret(name) and name then name = Ambiguate(name, "short") end
            local _, class = game.UnitClass(unit)
            if not isSecret(name) and name then
                out[#out + 1] = { name = name, class = (not isSecret(class)) and class or nil }
            end
        end
    end
    if UI.Flag(game.IsInRaid()) then
        for i = 1, 40 do add("raid" .. i) end
    else
        for i = 1, 4 do add("party" .. i) end
    end
    return out
end

-- A row of the panel, with its place in the group.
type Row = ReadinessEntry & { order: number }

-- The panel's order: ready first, then the soonest, then group order.
local function rowBefore(a: Row, b: Row): boolean
    local la, lb = a.endsAt or 0, b.endsAt or 0
    if (la == 0) ~= (lb == 0) then return la == 0 end
    if la ~= lb then return la < lb end
    return a.order < b.order
end

-- Whether the "shows" setting wants the panel: in a group, in a dungeon
-- or raid's instance (`kind`: IsInInstance's), or always.
local function wanted(shows: string, inGroup: boolean, kind: string?): boolean
    return shows == "always"
        or (shows == "group" and inGroup)
        or (shows == "instance" and inGroup and (kind == "party" or kind == "raid"))
end

local function canCheck(): boolean
    return UI.Flag(game.IsInGroup()) and (UI.Flag(game.UnitIsGroupLeader("player")) or UI.Flag(game.UnitIsGroupAssistant("player")))
end

local SECTION = {
    id = "readiness", label = "Readiness", category = "Insights", order = 40,
    preview = function(parent: Frame) return M:PreviewView(parent) end,
    groups = {
        { title = "Readiness", description = "Between pulls: the big cooldowns of everyone in your group who runs SuuUI, and a Ready check button for the leader or an assistant. Hidden from the pull until the fight ends.", rows = {
            { key = "shows", label = "Show", control = "segmented", stacked = true,
              options = { { value = "instance", label = "In a dungeon or raid" }, { value = "group", label = "In any group" },
                          { value = "always", label = "Always" }, { value = "off", label = "Off" } },
              description = "Always: solo too, with your own cooldowns (to see it at work)." },
        } },
    },
}

class ReadinessModule extends Module<typeof(DEFAULTS)>
    encounter: true? = nil
    -- what each player shared last, by short name
    heard: { [string]: Heard }? = nil
    lastSend: Sent? = nil
    -- yours, as shared ones
    own: Shared[]? = nil
    panel: Readiness? = nil
    preview: Readiness? = nil
    shareQueued: true? = nil
    ticker: TickerHandle? = nil

    constructor()
        super({
            id = "readiness",
            name = "Readiness",
            description = "Between pulls: your group's big cooldowns (from everyone with SuuUI) and a Ready check button.",
            api = "0.10",
            combatSafe = true,
            defaults = DEFAULTS,
        })
    end

    -- Yours: { { id, left } } (left in seconds, 0 ready), or nil in combat.
    function ReadOwn(): Cooldown[]?
        if InCombatLockdown() then return nil end
        local out: Cooldown[] = {}
        for _, name in ipairs(MAJOR[playerClass()] or {}) do
            local info = game.GetSpellInfo(name)
            local id = info and info.spellID
            if readable(id) and game.IsPlayerSpell(id) then
                local cd = game.GetSpellCooldown(id)
                local left = 0
                if cd and not isSecret(cd) and readable(cd.startTime) and readable(cd.duration) and cd.duration > 1.5 then
                    left = math.max(0, cd.startTime + cd.duration - GetTime())
                end
                out[#out + 1] = { id = id, left = left }
            end
        end
        return out
    end

    function Send(text: string)
        local ch = channel()
        if not ch or InCombatLockdown() then return end
        local ok, result = pcall(game.SendAddonMessage, PREFIX, text, ch)
        self.lastSend = { at = tostring(date("%H:%M:%S")), ok = ok, result = isSecret(result) and "secret" or tostring(result), text = text:sub(1, 40) }
    end

    function Share()
        local own = self:ReadOwn()
        if not own then return end
        self:Send(encodeShare(own))
    end

    -- One share soon (a burst of cooldown events makes one message).
    function ShareSoon()
        if self.shareQueued then return end
        self.shareQueued = true
        after(2, function()
            self.shareQueued = nil
            if self:IsEnabled() then self:Share() end
        end)
    end

    function OnMessage(prefix: unknown, text: unknown, _: unknown, sender: unknown)
        if prefix ~= PREFIX or isSecret(text) or type(text) ~= "string" then return end
        if isSecret(sender) or type(sender) ~= "string" then return end
        local who = Ambiguate(sender, "short")
        -- whole names: Forever's characters have surnames (SuuUI.FullName)
        if who == playerName() then return end
        if text == "RDYQ" then
            self:ShareSoon()
            return
        end
        local now = GetTime()
        local spells = decodeShare(text, now)
        if not spells then return end
        local heard = self.heard or {}
        self.heard = heard
        heard[who] = { at = now, spells = spells }
        self:Update()
    end

    function Rows(): Row[]
        local rows: Row[], now = {}, GetTime()
        local own = self:ReadOwn()
        if own then
            local mine: Shared[] = {}
            for _, c in ipairs(own) do mine[#mine + 1] = { id = c.id, endsAt = now + c.left } end
            self.own = mine
        end
        for order, p in ipairs(roster()) do
            local heard = self.heard and self.heard[p.name]
            local spells = p.you and self.own or (heard and heard.spells)
            local class = p.class
            for _, c in ipairs(spells or {}) do
                local name = game.GetSpellName(c.id)
                rows[#rows + 1] = { icon = (C_Spell.GetSpellTexture(c.id)), spell = not isSecret(name) and name or "?", who = p.name,
                    class = not isSecret(class) and class or nil, endsAt = c.endsAt > now and c.endsAt or nil, order = order }
            end
        end
        table.sort(rows, rowBefore)
        return rows
    end

    -- `fighting`: a fight is starting (PLAYER_REGEN_DISABLED comes before
    -- InCombatLockdown turns true).
    function Update(fighting: boolean?)
        local panel = self.panel
        if not panel then return end
        local _, kind = game.IsInInstance()
        local where = wanted(self:Get("shows"), UI.Flag(game.IsInGroup()), kind)
        local shown = where and not self:Get("position").hidden and not InCombatLockdown() and not fighting and not self.encounter
        if shown then
            local rows = self:Rows()
            local entries: ReadinessEntry[] = {}
            for i, r in ipairs(rows) do entries[i] = r end
            panel:SetRows(entries)
            panel:SetActionShown(canCheck())
            shown = #rows > 0 or canCheck()
        end
        panel:SetShown(shown and true or false)
    end

    function PreviewView(parent: Frame): Readiness
        if not self.preview then
            self.preview = UI.Readiness(parent, {})
            local now = GetTime()
            self.preview:SetRows({
                { icon = C_Spell.GetSpellTexture(20484), spell = "Rebirth", who = "Thessaly", class = "DRUID" },
                { icon = C_Spell.GetSpellTexture(16190), spell = "Mana Tide Totem", who = "Veyra", class = "SHAMAN" },
                { icon = C_Spell.GetSpellTexture(871), spell = "Shield Wall", who = "Brannoc", class = "WARRIOR" },
                { icon = C_Spell.GetSpellTexture(29166), spell = "Innervate", who = "Thessaly", class = "DRUID", endsAt = now + 250 },
            })
            self.preview:SetActionShown(true)
        end
        self.preview:SetParent(parent)
        return self.preview
    end

    override function OnEnable()
        if not self.panel then
            self.panel = UI.Readiness(SuuUI.Root, { onReadyCheck = function() DoReadyCheck() end })
            self.panel:SetFrameStrata("MEDIUM")
            self.panel:Hide()
        end
        self:RegisterMover(self.panel, { key = "position", label = "Readiness", managedShow = true,
            enabled = function() return self:Get("shows") ~= "off" end })
        self:RegisterSettings(SECTION)
        self:RegisterCommand("ready", "Readiness: who shared cooldowns, and the last message sent.", function()
            local names = {}
            for name, d in pairs(self.heard or {}) do names[#names + 1] = ("%s (%d)"):format(name, #d.spells) end
            self:Print(#names > 0 and ("heard from " .. table.concat(names, ", ")) or "nobody shared yet")
            local s = self.lastSend
            self:Print(s and ("last sent %s: %s, %s (%s)"):format(s.at, s.ok and "ok" or "error", s.result, s.text) or "nothing sent yet")
        end)
        if C_ChatInfo and C_ChatInfo.RegisterAddonMessagePrefix then C_ChatInfo.RegisterAddonMessagePrefix(PREFIX) end
        self:OnGameEvent("CHAT_MSG_ADDON", function(_, ...) self:OnMessage(...) end)
        self:OnGameEvent("GROUP_ROSTER_UPDATE", function()
            self:Update()
            if channel() then self:Send("RDYQ"); self:ShareSoon() end
        end)
        self:OnGameEvent("PLAYER_ENTERING_WORLD", function() self:Update() end)
        self:OnGameEvent("SPELL_UPDATE_COOLDOWN", function()
            if not InCombatLockdown() and channel() then self:ShareSoon() end
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function() self:Update(true) end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            after(1, function() if self:IsEnabled() then self:Update(); self:ShareSoon() end end)
        end)
        self:OnGameEvent("ENCOUNTER_START", function() self.encounter = true; self:Update() end)
        self:OnGameEvent("ENCOUNTER_END", function() self.encounter = nil; self:Update() end)
        self:Watch("shows", function() self:Update(); SuuUI.EditMode.Refresh() end)
        self:Watch("position", function() self:Update() end)
        -- a heartbeat: everyone's view stays fresh
        if not self.ticker then
            self.ticker = every(HEARTBEAT, function()
                if self:IsEnabled() and channel() and not InCombatLockdown() then self:Share() end
            end)
        end
        self:Update()
    end

    override function OnDisable()
        if self.panel then self.panel:Hide() end
    end
end

M = SuuUI.AddModule(ReadinessModule.new())
