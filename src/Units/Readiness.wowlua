-- Units/Readiness.wowlua
-- Readiness (step 1.13): between pulls, the big cooldowns of everyone in the
-- group who runs SuuUI (battle resurrection, mana and survival cooldowns),
-- and a Ready check button for the leader or an assistant. Each SuuUI shares
-- its own through addon messages (prefix "SuuUI": "RDY\t<id>:<seconds left>,…",
-- "RDYQ" asks everyone to send theirs). Hidden from the pull until the
-- encounter (or the fight) ends. Top right, under the minimap's place.
--
-- Cooldowns are read out of combat only (their times are secret in combat,
-- and addon messages are restricted there); what a player sent last stays,
-- counting down.
--
-- How much it sends (0.47; before, a question on every roster event and a
-- share every 2 s while anyone cast, panel on or off): yours goes out when
-- it changed (a cooldown's ready state, or its end moved by more than 2 s;
-- a class without big cooldowns sends nothing), when someone new joins, and
-- in answer to a question (at most once per 10 s, a moment later). Sharing
-- your own goes on with the panel off: it serves the others. Asking ("RDYQ")
-- only while your panel is wanted, a few seconds after someone new joined
-- and only for players nobody heard from, at most once per 10 s. Shares and
-- questions are taken from the group's channels only, and who left is
-- forgotten.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type Readiness, Entry as ReadinessEntry from "/UI/Readiness"
import type Position from "/EditMode/EditMode"
import * as secret from "wowlua:secret"

local isNumber = secret.isNumber

local UI = SuuUI.UI

local DEFAULTS = {
    position = { point = "TOPRIGHT", x = -28, y = -300 } :: Position,
    shows = "off", -- "instance" | "group" | "always" | "off"
}

local M: ReadinessModule

-- The game's functions this file reads about the group and your spells,
-- taken once as it loads (as the release build's cached globals are).
-- Tests replace them here: a replacement in _G would taint Blizzard's own
-- code that reads it (docs: Docs/test-notes/units-group.md).
local game = {
    UnitClass = UnitClass,
    IsPlayerSpell = IsPlayerSpell,
    GetSpellInfo = C_Spell.GetSpellInfo,
    GetSpellCooldown = C_Spell.GetSpellCooldown,
    GetSpellName = C_Spell.GetSpellName,
    IsInRaid = IsInRaid,
    IsInGroup = IsInGroup,
    IsInInstance = IsInInstance,
    UnitExists = UnitExists,
    UnitIsUnit = UnitIsUnit,
    UnitIsGroupLeader = UnitIsGroupLeader,
    UnitIsGroupAssistant = UnitIsGroupAssistant,
}
local HEARTBEAT = 30
local ASK_EVERY = 10 -- seconds between two questions, and two answers
local ASK_AFTER = 5 -- seconds after someone joined: by then they shared
local MAX_SPELLS = 20 -- spells taken from one share
local SAME_WITHIN = 2 -- seconds a cooldown's end may move and stay the same

-- The cooldowns a group plans around, per class (the first rank you know).
local MAJOR: { [string]: string[] } = {
    DRUID = { "Rebirth", "Innervate", "Tranquility" },
    SHAMAN = { "Mana Tide Totem", "Reincarnation" },
    WARRIOR = { "Shield Wall", "Last Stand", "Challenging Shout" },
    PALADIN = { "Lay on Hands", "Divine Intervention", "Blessing of Protection" },
    PRIEST = { "Power Infusion" },
    MAGE = { "Evocation", "Ice Block" },
    WARLOCK = {},
    ROGUE = {},
    HUNTER = {},
}

-- your own class is never secret
local function playerClass(): string
    local _, class = game.UnitClass("player")
    return class :: string
end

-- your own short name (the whole name first: Forever's surnames)
local function playerName(): string
    return Ambiguate(SuuUI.FullName("player") :: string, "short")
end

--------------------------------------------------------------------------------
-- Sharing
--------------------------------------------------------------------------------

local function channel(): ("RAID" | "PARTY")?
    if secret.flag(game.IsInRaid()) then
        return "RAID"
    end
    if secret.flag(game.IsInGroup()) then
        return "PARTY"
    end
    return nil
end

-- One of your cooldowns: its spell and the seconds left (0: ready).
type Cooldown = { id: number, left: number }
-- A cooldown someone shared: its spell and the GetTime() it's ready.
export type Shared = { id: number, endsAt: number }
-- What a player shared last, and when.
export type Heard = { at: number, spells: Shared[] }
-- The last message sent (for /suu ready).
export type Sent = { at: string, ok: boolean, result: string, text: string }

-- A share's payload for cooldowns { { id, left } }: "<id>:<left>,…"
-- (seconds rounded).
local function sharePayload(own: Cooldown[]): string
    local parts: string[] = {}
    for _, c in ipairs(own) do
        parts[#parts + 1] = ("%d:%d"):format(c.id, math.floor(c.left + 0.5))
    end
    return table.concat(parts, ",")
end

-- The share message: "RDY\t<id>:<left>,…".
local function encodeShare(own: Cooldown[]): string
    return "RDY\t" .. sharePayload(own)
end

-- A share's spells and seconds left, checked: a spell ID 1..2^31, at most
-- a day left, at most MAX_SPELLS of them (what isn't one is skipped).
type Left = { id: number, left: number }
local function readPayload(payload: string): Left[]
    local out: Left[] = {}
    for id, left in payload:gmatch("(%d+):(%d+)") do
        local n, l = SuuUI.Comm.Int(id, 1, 2 ^ 31), SuuUI.Comm.Int(left, 0, 86400)
        if n and l then
            out[#out + 1] = { id = n, left = l }
            if #out >= MAX_SPELLS then
                break
            end
        end
    end
    return out
end

-- A share message's cooldowns as { id, endsAt } (from `now`); nil when the
-- text isn't one.
local function decodeShare(text: string, now: number): Shared[]?
    local payload = text:match("^RDY\t(.*)$")
    if not payload then
        return nil
    end
    local spells: Shared[] = {}
    for _, c in ipairs(readPayload(payload)) do
        spells[#spells + 1] = { id = c.id, endsAt = now + c.left }
    end
    return spells
end

-- Whether a share repeats the last one sent `age` seconds ago: the same
-- spells, each ready then as now, or ending within SAME_WITHIN of the end
-- told then (seconds left count down, so the text itself always changes).
local function sameShare(last: string, now: string, age: number): boolean
    local a, b = readPayload(last), readPayload(now)
    if #a ~= #b then
        return false
    end
    for i, was in ipairs(a) do
        local is = b[i]
        if was.id ~= is.id then
            return false
        end
        local wasLeft = math.max(0, was.left - age)
        if (wasLeft == 0) ~= (is.left == 0) or math.abs(wasLeft - is.left) > SAME_WITHIN then
            return false
        end
    end
    return true
end

--------------------------------------------------------------------------------
-- The panel
--------------------------------------------------------------------------------

-- The group's members (you first) as { name, class }.
type Member = { name: string, class: (string | Secret<string>)?, you?: boolean }
local function roster(): Member[]
    local out: Member[] = { { name = playerName(), class = playerClass(), you = true } }
    local function add(unit: string)
        if game.UnitExists(unit) and not secret.flag(game.UnitIsUnit(unit, "player")) then
            -- the whole name, as their messages carry it (Forever's surnames)
            local name = SuuUI.FullName(unit)
            if not secret.isSecret(name) and name then
                name = Ambiguate(name, "short")
            end
            local _, class = game.UnitClass(unit)
            if not secret.isSecret(name) and name then
                out[#out + 1] = { name = name, class = (not secret.isSecret(class)) and class or nil }
            end
        end
    end
    if secret.flag(game.IsInRaid()) then
        for i = 1, 40 do
            add("raid" .. i)
        end
    else
        for i = 1, 4 do
            add("party" .. i)
        end
    end
    return out
end

-- A row of the panel, with its place in the group.
type Row = ReadinessEntry & { order: number }

-- The panel's order: ready first, then the soonest, then group order.
local function rowBefore(a: Row, b: Row): boolean
    local la, lb = a.endsAt or 0, b.endsAt or 0
    if (la == 0) ~= (lb == 0) then
        return la == 0
    end
    if la ~= lb then
        return la < lb
    end
    return a.order < b.order
end

-- Whether the "shows" setting wants the panel: in a group, in a dungeon
-- or raid's instance (`kind`: IsInInstance's), or always.
local function wanted(shows: string, inGroup: boolean, kind: string?): boolean
    return shows == "always" or (shows == "group" and inGroup) or
        (shows == "instance" and inGroup and (kind == "party" or kind == "raid"))
end

local function canCheck(): boolean
    return secret.flag(game.IsInGroup()) and
        (secret.flag(game.UnitIsGroupLeader("player")) or secret.flag(game.UnitIsGroupAssistant("player")))
end

local SECTION: SettingsSection = {
    id = "readiness",
    label = "Readiness",
    category = "Insights",
    order = 40,
    preview = function(parent: Frame)
        return M:PreviewView(parent)
    end,
    groups = {
        {
            title = "Readiness",
            description = "Between pulls: the big cooldowns of everyone in your group who runs SuuUI, and a Ready check button for the leader or an assistant. Hidden from the pull until the fight ends.",
            rows = {
                {
                    key = "shows",
                    label = "Show",
                    control = "segmented",
                    stacked = true,
                    options = {
                        { value = "instance", label = "In a dungeon or raid" },
                        { value = "group", label = "In any group" },
                        { value = "always", label = "Always" },
                        { value = "off", label = "Off" },
                    },
                    description = "Always: solo too, with your own cooldowns (to see it at work).",
                },
            },
        },
    },
}

class ReadinessModule extends Module<typeof(DEFAULTS)>
    encounter: true? = nil
    -- what each player shared last, by short name
    heard: { [string]: Heard }? = nil
    lastSend: Sent? = nil
    -- the group's other members when the roster was last read, by short name
    members: { [string]: boolean }? = nil
    -- the newcomers not heard from yet, to ask
    newcomers: { [string]: boolean }? = nil
    -- when you last asked
    askedAt: number? = nil
    askQueued: true? = nil
    rosterQueued: true? = nil
    updateQueued: true? = nil
    -- yours, as shared ones
    own: Shared[]? = nil
    panel: Readiness? = nil
    preview: Readiness? = nil
    shareQueued: true? = nil
    -- the share queued answers someone (sent even if unchanged)
    shareForced: true? = nil
    ticker: TickerHandle? = nil

    constructor()
        super({
            id = "readiness",
            name = "Readiness",
            description = "Between pulls: your group's big cooldowns (from everyone with SuuUI) and a Ready check button.",
            api = "0.10",
            combatSafe = true,
            defaults = DEFAULTS,
        })
    end

    -- Yours: { { id, left } } (left in seconds, 0 ready), or nil in combat.
    function ReadOwn(): Cooldown[]?
        if InCombatLockdown() then
            return nil
        end
        local out: Cooldown[] = {}
        for _, name in ipairs(MAJOR[playerClass()] or {}) do
            local info = game.GetSpellInfo(name)
            local id = info and info.spellID
            if isNumber(id) and game.IsPlayerSpell(id) then
                local cd = game.GetSpellCooldown(id)
                local left = 0
                if cd and not secret.isSecret(cd) and isNumber(cd.startTime) and isNumber(cd.duration) and
                    cd.duration > 1.5 then
                    left = math.max(0, cd.startTime + cd.duration - GetTime())
                end
                out[#out + 1] = { id = id, left = left }
            end
        end
        return out
    end

    -- "verb" or "verb\t<payload>" to the group (nothing solo, in combat or
    -- the chat lockdown: SuuUI's sender refuses then). `unlessSame`: not
    -- when it repeats the last share (sameShare).
    function Send(verb: string, payload: string?, unlessSame: boolean?)
        local ch = channel()
        if not ch then
            return
        end
        local ok, result, tried = self:SendAddonMessage(
            verb,
            payload,
            ch,
            nil,
            unlessSame and { unlessSame = sameShare } or nil
        )
        if not tried then
            return
        end
        local text = payload and (verb .. "\t" .. payload) or verb
        self.lastSend = { at = tostring(date("%H:%M:%S")), ok = ok, result = result, text = text:sub(1, 40) }
    end

    -- Yours, when it changed since the last share (`force`: whatever, it was
    -- asked for); nothing when your class has none of the big cooldowns.
    function Share(force: boolean?)
        local own = self:ReadOwn()
        if not own or #own == 0 then
            return
        end
        self:Send("RDY", sharePayload(own), not force)
    end

    -- One share soon (a burst of cooldown events makes one message); an
    -- answer a moment later, not all of a raid's at once.
    function ShareSoon(force: boolean?)
        if force then
            self.shareForced = true
        end
        if self.shareQueued then
            return
        end
        self.shareQueued = true
        self:After(force and (2 + math.random() * 2) or 2, function()
            self.shareQueued = nil
            local forced = self.shareForced
            self.shareForced = nil
            self:Share(forced)
        end)
    end

    -- "RDY\t<id>:<left>,…" from someone in the group (the receiver checked
    -- the channel and the rate; your own was dropped there).
    function OnShare(payload: string, sender: string)
        local now = GetTime()
        local spells = decodeShare("RDY\t" .. payload, now)
        if not spells then
            return
        end
        local heard = self.heard or {}
        self.heard = heard
        -- whole names: Forever's characters have surnames (SuuUI.FullName)
        heard[Ambiguate(sender, "short")] = { at = now, spells = spells }
        self:UpdateSoon()
    end

    -- The panel again once a burst of shares is in.
    function UpdateSoon()
        if self.updateQueued then
            return
        end
        self.updateQueued = true
        self:After(0.5, function()
            self.updateQueued = nil
            self:Update()
        end)
    end

    -- Whether you ask the group: only while your panel is wanted here.
    function Asks(): boolean
        local _, kind = game.IsInInstance()
        return wanted(self:Get("shows"), secret.flag(game.IsInGroup()), kind)
    end

    -- The roster changes in bursts: read once it settles.
    function RosterSoon()
        if self.rosterQueued then
            return
        end
        self.rosterQueued = true
        self:After(1, function()
            self.rosterQueued = nil
            self:RosterChanged()
        end)
    end

    -- Who left is forgotten; someone new gets yours, and is asked for theirs
    -- if they haven't shared a moment later.
    function RosterChanged()
        self:Update()
        -- (names may be secret in combat: read again once it ends)
        if InCombatLockdown() then
            return
        end
        if not channel() then
            self.members, self.heard = nil, nil
            return
        end
        local names: { [string]: boolean } = {}
        for _, p in ipairs(roster()) do
            if not p.you then
                names[p.name] = true
            end
        end
        local heard = self.heard
        if heard then
            for who in pairs(heard) do
                if not names[who] then
                    heard[who] = nil
                end
            end
        end
        local known = self.members or {}
        local newcomers = self.newcomers or {}
        local new = false
        for who in pairs(names) do
            if not known[who] then
                new = true
                newcomers[who] = true
            end
        end
        self.members = names
        if new then
            self.newcomers = newcomers
            self:ShareSoon(true)
            if self:Asks() then
                self:AskSoon()
            end
        end
    end

    -- A question for those not heard from, ASK_AFTER seconds on, at most
    -- once per ASK_EVERY.
    function AskSoon()
        if self.askQueued then
            return
        end
        self.askQueued = true
        local asked = self.askedAt
        local wait = math.max(ASK_AFTER, asked and (ASK_EVERY - (GetTime() - asked)) or 0)
        self:After(wait, function()
            self.askQueued = nil
            local heard, members = self.heard or {}, self.members or {}
            local newcomers = self.newcomers or {}
            self.newcomers = nil
            for who in pairs(newcomers) do
                if members[who] and not heard[who] then
                    self.askedAt = GetTime()
                    self:Send("RDYQ")
                    return
                end
            end
        end)
    end

    function Rows(): Row[]
        local rows: Row[], now = {}, GetTime()
        local own = self:ReadOwn()
        if own then
            local mine: Shared[] = {}
            for _, c in ipairs(own) do
                mine[#mine + 1] = { id = c.id, endsAt = now + c.left }
            end
            self.own = mine
        end
        for order, p in ipairs(roster()) do
            local heard = self.heard and self.heard[p.name]
            local spells = p.you and self.own or (heard and heard.spells)
            local class = p.class
            for _, c in ipairs(spells or {}) do
                local name = game.GetSpellName(c.id)
                rows[#rows + 1] = {
                    icon = (C_Spell.GetSpellTexture(c.id)),
                    spell = not secret.isSecret(name) and name or "?",
                    who = p.name,
                    class = not secret.isSecret(class) and class or nil,
                    endsAt = c.endsAt > now and c.endsAt or nil,
                    order = order,
                }
            end
        end
        table.sort(rows, rowBefore)
        return rows
    end

    -- `fighting`: a fight is starting (PLAYER_REGEN_DISABLED comes before
    -- InCombatLockdown turns true).
    function Update(fighting: boolean?)
        local panel = self.panel
        if not panel then
            return
        end
        local _, kind = game.IsInInstance()
        local where = wanted(self:Get("shows"), secret.flag(game.IsInGroup()), kind)
        local shown = where and not self:Get("position").hidden and not InCombatLockdown() and not fighting and
            not self.encounter
        if shown then
            local rows = self:Rows()
            local entries: ReadinessEntry[] = {}
            for i, r in ipairs(rows) do
                entries[i] = r
            end
            panel:SetRows(entries)
            panel:SetActionShown(canCheck())
            shown = #rows > 0 or canCheck()
        end
        panel:SetShown(shown and true or false)
    end

    function PreviewView(parent: Frame): Readiness
        if not self.preview then
            self.preview = UI.Readiness(parent, {})
            local now = GetTime()
            self.preview:SetRows({
                { icon = C_Spell.GetSpellTexture(20484), spell = "Rebirth", who = "Thessaly", class = "DRUID" },
                { icon = C_Spell.GetSpellTexture(16190), spell = "Mana Tide Totem", who = "Veyra", class = "SHAMAN" },
                { icon = C_Spell.GetSpellTexture(871), spell = "Shield Wall", who = "Brannoc", class = "WARRIOR" },
                {
                    icon = C_Spell.GetSpellTexture(29166),
                    spell = "Innervate",
                    who = "Thessaly",
                    class = "DRUID",
                    endsAt = now + 250,
                },
            })
            self.preview:SetActionShown(true)
        end
        self.preview:SetParent(parent)
        return self.preview
    end

    override function OnEnable()
        if not self.panel then
            self.panel = UI.Readiness(SuuUI.Root, {
                onReadyCheck = function()
                    DoReadyCheck()
                end,
            })
            self.panel:SetFrameStrata("MEDIUM")
            self.panel:Hide()
        end
        self:RegisterMover(self.panel, {
            key = "position",
            label = "Readiness",
            managedShow = true,
            enabled = function()
                return self:Get("shows") ~= "off"
            end,
        })
        self:RegisterSettings(SECTION)
        self:RegisterCommand("ready", "Readiness: who shared cooldowns, and the last message sent.", function()
            local names = {}
            for name, d in pairs(self.heard or {}) do
                names[#names + 1] = ("%s (%d)"):format(name, #d.spells)
            end
            self:Print(#names > 0 and ("heard from " .. table.concat(names, ", ")) or "nobody shared yet")
            local s = self.lastSend
            self:Print(
                s and ("last sent %s: %s, %s (%s)"):format(s.at, s.ok and "ok" or "error", s.result, s.text) or
                    "nothing sent yet"
            )
        end)
        self:OnAddonMessage("RDY", { rate = { count = 5, seconds = 10 } }, function(payload, sender)
            self:OnShare(payload, sender)
        end)
        -- a question: answered at most once per ASK_EVERY, whoever asks
        self:OnAddonMessage("RDYQ", { replyEvery = ASK_EVERY, rate = { count = 2, seconds = 10 } }, function()
            self:ShareSoon(true)
        end)
        self:OnGameEvent("GROUP_ROSTER_UPDATE", function()
            self:Update()
            self:RosterSoon()
        end)
        self:OnGameEvent("PLAYER_ENTERING_WORLD", function()
            self:Update()
        end)
        self:OnGameEvent("SPELL_UPDATE_COOLDOWN", function()
            if not InCombatLockdown() and channel() then
                self:ShareSoon()
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            self:Update(true)
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self:After(1, function()
                self:Update()
                self:ShareSoon()
                self:RosterSoon()
            end)
        end)
        self:OnGameEvent("ENCOUNTER_START", function()
            self.encounter = true
            self:Update()
        end)
        self:OnGameEvent("ENCOUNTER_END", function()
            self.encounter = nil
            self:Update()
        end)
        self:Watch("shows", function()
            self:Update()
            SuuUI.EditMode.Refresh()
            -- wanted now: those not heard from are asked
            if self:Asks() and channel() then
                local newcomers = self.newcomers or {}
                for who in pairs(self.members or {}) do
                    newcomers[who] = true
                end
                self.newcomers = newcomers
                self:AskSoon()
            end
        end)
        self:Watch("position", function()
            self:Update()
        end)
        -- a heartbeat: what changed without an event goes out (nothing
        -- when nothing did)
        self.ticker = self:Every(HEARTBEAT, function()
            if channel() and not InCombatLockdown() then
                self:Share()
            end
        end)
        self:Update()
        -- (after a reload in a group: everyone is new)
        self.members = nil
        self:RosterSoon()
    end

    override function OnDisable()
        if self.panel then
            self.panel:Hide()
        end
        -- (its timers are cancelled: nothing stays queued)
        self.heard, self.members, self.newcomers, self.own = nil, nil, nil, nil
        self.shareQueued, self.shareForced, self.askQueued, self.rosterQueued, self.updateQueued = nil, nil, nil, nil, nil
        self.askedAt, self.ticker = nil, nil
    end
end

M = SuuUI.AddModule(ReadinessModule.new())
