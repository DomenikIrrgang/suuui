-- Settings
--------------------------------------------------------------------------------

local PREVIEW_QUESTS: TrackerQuest[] = {
    { questID = 1, zone = "Duskwater Hollow", title = "The Ashmaw Den", difficulty = "difficult", objectives = {
        { text = "Ashmaw Ravager slain", progress = "3/8" },
        { text = "Ember Pelt", progress = "5/5", done = true },
    }, item = { preview = true, icon = 134075 } },
    { questID = 2, zone = "Duskwater Hollow", title = "Letters for the Crossroads", difficulty = "standard", complete = true },
    { questID = 3, zone = "Durotar", title = "Speargrass Cuttings", difficulty = "trivial", objectives = {
        { text = "Handful of Cattails", progress = "0/2" },
        { text = "Speargrass Cuttings", progress = "1/4" },
    } },
}

local SECTION = {
    id = "tracker", label = "Objective tracker", category = "World", order = 15,
    preview = function(parent: Frame): Frame return M:PreviewView(parent) end,
    groups = {
        { title = "Objective tracker", description = "Your tracked quests under the minimap. Left click a quest for its details on the map; right click to focus, share or stop tracking it. Move it in edit mode.", rows = {
            { key = "shows", label = "Shows", control = "segmented", options = UI.VISIBILITY_OPTIONS, combat = true,
              description = "Always, only in combat, or when the mouse is over it." },
            { key = "maxHeight", label = "Height", control = "slider", min = 160, max = 800, step = 10, unit = "px", combat = true,
              description = "The most it takes down the screen; scroll with the mouse wheel for the quests below." },
            { key = "autoTrack", label = "Track accepted quests", control = "toggle",
              description = "A quest you accept goes on the tracker at once." },
            { key = "items", label = "Quest items", control = "toggle", combat = true,
              description = "A quest's usable item left of its title: click it to use, in combat too." },
            { key = "collapseInBossFights", label = "Collapse in boss fights", control = "toggle", combat = true,
              description = "Only the head while a boss is up (its quest items hide too); back after the fight." },
            { key = "recipes", label = "Tracked recipes", control = "toggle", combat = true,
              description = "Recipes you track in Professions, under the quests: their reagents and whether you can craft them." },
        } },
    },
}

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

class ObjectiveTrackerModule extends Module<typeof(DEFAULTS)>
    blizzardHidden: boolean? = nil
    encounter: boolean? = nil
    -- the placed frame, its secure parts and the tracker (on enable)
    frame: TrackerFrame? = nil
    readonly itemButtons: QuestItemButton[] = {}
    itemsShown: number = 0
    opener: RecipeOpener? = nil
    pendingItems: boolean? = nil
    pendingSecure: boolean? = nil
    pendingSize: boolean? = nil
    preview: ObjectiveTracker? = nil
    quests: Quest[]? = nil
    refreshQueued: boolean? = nil
    waitingItems: boolean? = nil

    constructor()
        super({
            id = "tracker",
            name = "Objective tracker",
            description = "Your tracked quests under the minimap, with quest items you can use in combat.",
            api = "0.11",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- The placed frame (built on enable).
    function Parts(): TrackerFrame
        return assert(self.frame)
    end

    -- Your tracked quests, sorted by zone (sortQuests).
    function TrackedQuests(): Quest[]
        local list: Quest[] = {}
        local n = C_QuestLog.GetNumQuestWatches()
        if not secret.readable(n) then return list end
        for i = 1, n do
            local id = C_QuestLog.GetQuestIDForQuestWatchIndex(i)
            if secret.readable(id) and id then
                local q = questOf(id)
                if q then
                    q.zone = zoneOf(id, q.logIndex)
                    q.distance = distanceOf(id)
                    list[#list + 1] = q
                end
            end
        end
        sortQuests(list, hereNames())
        return list
    end

    function ItemButton(i: number): QuestItemButton
        local b = self.itemButtons[i]
        if b then return b end
        b = QuestItemButton.new(self:Parts().holder, i)
        self.itemButtons[i] = b
        return b
    end

    -- The buttons beside their quests (out of combat only).
    function LayoutItems(quests: Quest[])
        if InCombatLockdown() then self.pendingItems = true return end
        self.pendingItems = nil
        local parts = self:Parts()
        local used = 0
        -- placed even while collapsed: the holder hides them, and shows them
        -- in place when the tracker opens again, in combat too
        if self:Get("items") then
            for _, q in ipairs(quests) do
                local item = q.item
                local top = item and parts.tracker:QuestTop(q.questID)
                if item and top then
                    used = used + 1
                    local b = self:ItemButton(used)
                    b.logIndex, b.link = q.logIndex, item.link
                    b:SetAttribute("item", item.link)
                    b.art:SetTexture(item.icon)
                    b.art:Show()
                    b.count:SetText(item.charges > 1 and tostring(item.charges) or "")
                    b:ClearAllPoints()
                    b:SetPoint("TOPRIGHT", parts.holder, "TOPLEFT", -S["space-3"], -(top - 2))
                    b:Show()
                    b:UpdateCooldown()
                end
            end
        end
        for i = used + 1, #self.itemButtons do
            local b = self.itemButtons[i]
            b:Hide()
            b:SetAttribute("item", nil)
            b.logIndex, b.link = nil, nil
        end
        self.itemsShown = used
    end

    -- Cooldowns and range, a few times a second while items show.
    function TickItems()
        for i = 1, self.itemsShown do
            local b = self.itemButtons[i]
            local logIndex = b.logIndex
            if logIndex and IsQuestLogSpecialItemInRange then
                b:SetSuggested(secret.asNumber(errors.try(IsQuestLogSpecialItemInRange, logIndex)) == 1)
            end
        end
    end

    -- The quest items placed: their cooldowns current.
    function ItemCooldowns()
        for i = 1, self.itemsShown do self.itemButtons[i]:UpdateCooldown() end
    end

    ----------------------------------------------------------------------------
    -- Collapsing: the head's toggle and boss fights (secure, so in combat too)
    ----------------------------------------------------------------------------

    function InBossFight(): boolean
        return self:Parts().holder:GetAttribute("state-boss") == 1
            or (self.encounter and self:Get("collapseInBossFights")) or false
    end

    -- The head's toggle folds the quests only (the Recipes section stays:
    -- asked for in game); a boss fight folds everything.
    function ApplyCollapse()
        local tracker = self:Parts().tracker
        tracker:SetCollapsed(self:InBossFight())
        tracker:SetQuestsCollapsed(self:Get("collapsed"))
        self:QueueRefresh()
    end

    -- The saved collapse and the boss setting, into the secure side (out of combat).
    function ApplySecure()
        if InCombatLockdown() then self.pendingSecure = true return end
        self.pendingSecure = nil
        local holder = self:Parts().holder
        holder:SetAttribute("usercollapsed", self:Get("collapsed") and true or false)
        UnregisterStateDriver(holder, "boss")
        RegisterStateDriver(holder, "boss", bossDriver(self:Get("collapseInBossFights")))
        self:ApplyCollapse()
    end

    ----------------------------------------------------------------------------
    -- Clicks on a quest
    ----------------------------------------------------------------------------

    function QuestClick(questID: number, button: string, row: QuestRow)
        if button == "LeftButton" then
            errors.try(QuestMapFrame_OpenToQuestDetails, questID)
            return
        end
        -- SuuUI's menu, in the tooltip's look (asked for in game)
        UI.ContextMenuFrom(row, function(_, root)
            local title = C_QuestLog.GetTitleForQuestID and C_QuestLog.GetTitleForQuestID(questID)
            if secret.readable(title) and title then root:CreateTitle(title) end
            if C_SuperTrack and C_SuperTrack.SetSuperTrackedQuestID then
                local focused = C_SuperTrack.GetSuperTrackedQuestID and C_SuperTrack.GetSuperTrackedQuestID() == questID
                root:CreateButton(focused and "Stop focusing" or "Focus", function()
                    pcall(C_SuperTrack.SetSuperTrackedQuestID, focused and 0 or questID)
                end)
            end
            local pushable = C_QuestLog.IsPushableQuest and C_QuestLog.IsPushableQuest(questID)
            if secret.readable(pushable) and pushable and IsInGroup() and QuestLogPushQuest then
                root:CreateButton("Share", function()
                    if C_QuestLog.SetSelectedQuest then C_QuestLog.SetSelectedQuest(questID) end
                    pcall(QuestLogPushQuest)
                end)
            end
            root:CreateButton("Open in quest log", function()
                errors.try(QuestMapFrame_OpenToQuestDetails, questID)
            end)
            root:CreateButton("Stop tracking", function()
                pcall(C_QuestLog.RemoveQuestWatch, questID)
            end)
        end, "quest", { questID = questID })
    end

    ----------------------------------------------------------------------------
    -- Tracked recipes
    ----------------------------------------------------------------------------

    -- The tracked recipes as tracker entries.
    function TrackedRecipes(): TrackerQuest[]
        local out: TrackerQuest[] = {}
        if not self:Get("recipes") or not C_TradeSkillUI then return out end
        local ok, tracked = pcall(C_TradeSkillUI.GetRecipesTracked, false)
        if not ok or type(tracked) ~= "table" then return out end
        for _, id in ipairs(tracked) do
            local got, sch = pcall(C_TradeSkillUI.GetRecipeSchematic, id, false)
            if got and type(sch) == "table" then
                local objectives: TrackerObjective[] = {}
                local product = sch.outputItemID
                local name: string?, quality: number?, icon: number | string | nil = nil, nil, nil
                if product then
                    local n, _, q, _, _, _, _, _, _, ic = errors.try(C_Item.GetItemInfo, product)
                    name, quality, icon = secret.asString(n), secret.asNumber(q), secret.asNumber(ic)
                    if not name then self.waitingItems = true; errors.try(C_Item.RequestLoadItemDataByID, product) end
                end
                local can = math.huge
                for _, slot in ipairs(sch.reagentSlotSchematics or {}) do
                    local reagent = slot.reagents and slot.reagents[1]
                    local itemID = reagent and reagent.itemID
                    if itemID and slot.required ~= false then
                        local need = slot.quantityRequired or 1
                        local have = secret.asNumber(errors.try(C_Item.GetItemCount, itemID)) or 0
                        local rName = secret.asString(errors.try(C_Item.GetItemNameByID, itemID))
                        if not rName then self.waitingItems = true; errors.try(C_Item.RequestLoadItemDataByID, itemID) end
                        objectives[#objectives + 1] = { text = rName or "…", progress = math.min(have, need) .. "/" .. need,
                                                        done = have >= need }
                        can = math.min(can, math.floor(have / math.max(1, need)))
                    end
                end
                if can == math.huge then can = 0 end
                out[#out + 1] = {
                    questID = id,
                    objectives = objectives,
                    title = name or secret.asString(sch.name) or ("Recipe " .. id),
                    color = QUALITY[quality or 1] or "ink",
                    icon = icon or secret.asNumber(errors.try(C_Spell.GetSpellTexture, id)) or 134400,
                    complete = can > 0,
                    turnIn = "Ready to craft",
                    count = can > 0 and ("×" .. can) or nil,
                }
            end
        end
        return out
    end

    function RecipeOpener(): RecipeOpener
        local opener = self.opener
        if opener then return opener end
        opener = RecipeOpener.new(self, self:Parts())
        self.opener = opener
        return opener
    end

    -- The mouse onto a tracked recipe: the secure opener over it (out of combat).
    function RowEnter(row: QuestRow)
        local quest = row.quest
        if not (quest and quest.recipe) or InCombatLockdown() then return end
        local id = quest.questID
        local line = recipeSkillLine(id)
        local spell = line and SuuUI.ProfessionOpener(line)
        if not spell then return end
        local b = self:RecipeOpener()
        b.recipeID, b.row = id, row
        -- its profession already open: no cast (it would close the window, found
        -- in game), the click only chooses the recipe; unless it's the one shown
        -- already: then the cast closes the window, a toggle (asked for)
        local open = professionShown(line) and ProfessionsFrame and ProfessionsFrame:IsShown()
        b.casting = not open or SuuUI.ShownRecipe() == id
        b:SetAttribute("type1", b.casting and "spell" or nil)
        b:SetAttribute("spell1", spell)
        b:ClearAllPoints()
        b:SetAllPoints(row)
        b:SetFrameLevel(row:GetFrameLevel() + 5)
        b:Show()
    end

    function RecipeMenu(recipeID: number, row: QuestRow)
        UI.ContextMenuFrom(row, function(_, root)
            local title = row.quest and row.quest.title
            if title then root:CreateTitle(title) end
            root:CreateButton("Stop tracking", function()
                pcall(C_TradeSkillUI.SetRecipeTracked, recipeID, false, false)
            end)
        end, "trackedRecipe", { recipeID = recipeID })
    end

    -- The row's own clicks: in combat (no opener then), or the profession
    -- already open (choosing the recipe needs no cast).
    function RecipeClick(recipeID: number, button: string, row: QuestRow)
        if button == "LeftButton" then
            if professionShown(recipeSkillLine(recipeID)) then
                SuuUI.OpenRecipe(recipeID)
            elseif InCombatLockdown() then
                self:Print("Professions open out of combat.")
            end
            return
        end
        self:RecipeMenu(recipeID, row)
    end

    ----------------------------------------------------------------------------
    -- Drawing
    ----------------------------------------------------------------------------

    function Refresh()
        self.refreshQueued = nil
        local parts = self.frame
        if not parts then return end
        local tracker = parts.tracker
        local quests = self:TrackedQuests()
        local combat = InCombatLockdown()
        -- in combat, with item buttons placed: keep everyone where they are
        local freeze = combat and self.itemsShown > 0
        -- the tracked recipes: their own section after the quests, in the same
        -- list, so they scroll together within the tracker's height (asked for
        -- in game: a block of their own sat too low on the screen)
        local recipes = self:TrackedRecipes()
        tracker:SetRecipes(recipes, self:Get("recipesCollapsed"),
            #recipes == 1 and "1 recipe" or (#recipes .. " recipes"))
        local shown: TrackerQuest[] = {}
        for i, q in ipairs(quests) do shown[i] = q end
        tracker:SetQuests(shown, freeze)
        local n = #quests
        tracker:SetMeta(n == 1 and "1 quest" or (n .. " quests"))
        self.quests = quests
        if combat then
            self.pendingItems = true
            -- the ones placed keep their cooldowns current
            self:ItemCooldowns()
        else
            self:LayoutItems(quests)
        end
        -- nothing tracked: nothing shown (the frame itself stays: it holds
        -- secure buttons, and its visibility is the Shows setting's)
        -- the list moved under it: the opener waits for the mouse again
        local opener = self.opener
        if opener and opener:IsShown() and not combat then opener:Hide() end
        local empty = n == 0 and #recipes == 0
        tracker:SetAlpha(empty and 0 or 1)
        parts.toggle:SetAlpha(empty and 0 or 1)
    end

    -- Many quest events come at once: one refresh on the next frame.
    function QueueRefresh()
        if self.refreshQueued then return end
        self.refreshQueued = true
        after(0, function() if self:IsEnabled() then self:Refresh() end end)
    end

    function ApplySize()
        if InCombatLockdown() then self.pendingSize = true return end
        self.pendingSize = nil
        local h = self:Get("maxHeight")
        local parts = self:Parts()
        parts:SetSize(WIDTH, h)
        parts.tracker:SetMaxHeight(h)
        self:Refresh()
    end

    function ApplyShows()
        UI.SetVisibility(self:Parts(), self:Get("position").hidden and "hidden" or self:Get("shows"))
    end

    function PreviewView(parent: Frame): Frame
        local preview = self.preview
        if not preview then
            preview = UI.ObjectiveTracker(parent, { width = WIDTH })
            preview:SetQuests(PREVIEW_QUESTS)
            preview:SetMeta("3 quests")
            self.preview = preview
        end
        preview:SetParent(parent)
        return preview
    end

    ----------------------------------------------------------------------------
    -- Lifecycle
    ----------------------------------------------------------------------------

    override function OnEnable()
        if not C_QuestLog or not C_QuestLog.GetNumQuestWatches then return end
        local parts = self.frame
        if not parts then
            parts = TrackerFrame.new(self)
            self.frame = parts
            local tracker = parts.tracker
            tracker.onQuestClick = function(id: number, button: string, row: QuestRow) self:QuestClick(id, button, row) end
            -- the items follow the list (out of combat: in combat it's locked
            -- while items show)
            tracker.onScroll = function()
                local quests = self.quests
                if not InCombatLockdown() and quests then self:LayoutItems(quests) end
            end
            tracker.onRecipeClick = function(id: number, button: string, row: QuestRow) self:RecipeClick(id, button, row) end
            tracker.onRowEnter = function(row: QuestRow) self:RowEnter(row) end
            tracker.onSectionToggle = function()
                self:Set("recipesCollapsed", not self:Get("recipesCollapsed"))
                self:Refresh()
            end
            local wait, resort = 0, 10
            parts:SetScript("OnUpdate", function(_, elapsed)
                -- as you move, the nearest quests come up (not in combat: the
                -- list holds still then)
                resort = resort - elapsed
                if resort <= 0 then
                    resort = 10
                    -- (nor while you're reading it with the mouse on it)
                    if not InCombatLockdown() and not tracker:IsMouseOver() then self:QueueRefresh() end
                end
                wait = wait - elapsed
                if wait > 0 then return end
                wait = 0.25
                self:TickItems()
            end)
        end
        local tracker = parts.tracker
        -- Blizzard's tracker out of sight while this runs
        if ObjectiveTrackerFrame and not self.blizzardHidden then
            self.blizzardHidden = true
            SuuUI.SuppressBlizzard(ObjectiveTrackerFrame)
        end
        self:RegisterMover(parts, { key = "position", label = "Objective tracker", managedShow = true })
        self:RegisterSettings(SECTION)
        self:ApplyShows()
        self:ApplySize()
        self:ApplySecure()
        self:Watch("shows", function() self:ApplyShows() end)
        self:Watch("position", function() self:ApplyShows() end)
        self:Watch("maxHeight", function() self:ApplySize() end)
        self:Watch("items", function() self:Refresh() end)
        self:Watch("recipes", function() self:Refresh() end)
        self:Watch("collapseInBossFights", function() self:ApplySecure() end)
        -- a theme's line heights: laid out again (the preview too)
        self:On("SUUUI_THEME_CHANGED", function()
            self:QueueRefresh()
            local preview = self.preview
            if preview then preview:SetQuests(PREVIEW_QUESTS) end
        end)
        local valid = C_EventUtils and C_EventUtils.IsEventValid
        -- a quest you accept goes on the tracker
        self:OnGameEvent("QUEST_ACCEPTED", function(_: unknown, a: unknown, b: unknown)
            if not self:Get("autoTrack") then return end
            -- (questLogIndex, questID) on older clients, (questID) on newer ones
            local questID = secret.asNumber(b or a)
            if not (questID and C_QuestLog.AddQuestWatch) then return end
            local watched = C_QuestLog.GetQuestWatchType and C_QuestLog.GetQuestWatchType(questID)
            if watched == nil then pcall(C_QuestLog.AddQuestWatch, questID) end
        end)
        for _, e in ipairs({ "QUEST_LOG_UPDATE", "QUEST_WATCH_LIST_CHANGED", "QUEST_WATCH_UPDATE", "QUEST_ACCEPTED",
                             "QUEST_REMOVED", "QUEST_TURNED_IN", "QUEST_ITEM_UPDATE", "PLAYER_LEVEL_UP",
                             "PLAYER_ENTERING_WORLD",
                             -- tracked recipes: tracking changes, reagents come and go
                             "TRACKED_RECIPE_UPDATE", "BAG_UPDATE_DELAYED" }) do
            if not valid or valid(e) then self:OnGameEvent(e, function() self:QueueRefresh() end) end
        end
        -- an item's cooldown: only the quest items' own (it comes with every
        -- potion and trinket; a whole redraw each time was most of SuuUI's
        -- garbage, 175 KB a redraw: /suu probe garbage, 2026-10-18)
        self:OnGameEvent("BAG_UPDATE_COOLDOWN", function() self:ItemCooldowns() end)
        -- a new zone: sorted again (the zone you're in goes first)
        for _, e in ipairs({ "ZONE_CHANGED_NEW_AREA", "ZONE_CHANGED", "QUEST_POI_UPDATE" }) do
            if not valid or valid(e) then self:OnGameEvent(e, function() self:QueueRefresh() end) end
        end
        -- item names the game hadn't loaded yet (tracked recipes' reagents)
        self:OnGameEvent("GET_ITEM_INFO_RECEIVED", function()
            if self.waitingItems then self.waitingItems = false; self:QueueRefresh() end
        end)
        -- a boss fight without a boss unit: the tracker (not its items) collapses
        for _, e in ipairs({ "ENCOUNTER_START", "ENCOUNTER_END" }) do
            if not valid or valid(e) then
                self:OnGameEvent(e, function(event)
                    self.encounter = event == "ENCOUNTER_START"
                    self:ApplyCollapse()
                end)
            end
        end
        -- secure item buttons can't move in combat: neither does the list then
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            -- the recipe opener away (a profession can't open in combat)
            local opener = self.opener
            if opener then opener:Hide() end
            tracker:SetScrollLocked(self.itemsShown > 0)
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            tracker:SetScrollLocked(false)
            if self.pendingSecure then self:ApplySecure() end
            if self.pendingSize then self:ApplySize() end
            self:Refresh()
        end)
    end

    override function OnDisable()
        local parts = self.frame
        if parts then parts:Hide() end
    end
end

M = SuuUI.AddModule(ObjectiveTrackerModule.new())
