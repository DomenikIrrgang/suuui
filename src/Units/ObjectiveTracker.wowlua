-- Units/ObjectiveTracker.wowlua
-- The objective tracker (step 2.3): your tracked quests on the world under
-- the minimap, top right (28px in, 300px down, under its clock), 260px wide. Titles in their
-- difficulty colour (the game's own: GetQuestDifficultyColor), grouped by
-- their quest log zone (the zone you're in first, then the nearest, sorted
-- again every 10 seconds out of combat and on zone changes), objectives
-- with their counts, "Ready to turn in" once a quest is done; the mouse
-- wheel scrolls what doesn't fit the height (not in combat while quest
-- items show: their secure buttons can't move then). Blizzard's tracker is hidden
-- while this runs. A built-in module written against the public API only.
--
-- Quest items: SuuUI's secure action buttons (type "item") left of their
-- quest's title; a click is a secure use, so they work in combat. Secure
-- buttons are placed and set up out of combat only: in combat the quests
-- keep their places (a quest's height only grows) so a button never ends up
-- beside the wrong quest; everything is laid out again when combat ends.
-- During a boss fight (a boss unit exists: a secure state driver, so it
-- works in combat) the tracker collapses to its head and the item buttons
-- hide, out of the boss frames' way. The head's toggle is secure too.
-- Left click a quest: its details on the map; right click: focus, share,
-- stop tracking.
-- Tracked recipes (asked for in game: Blizzard's tracker showed them, this
-- one didn't; their own category, not among the quests): a Recipes section
-- after the quests in the same list (they scroll together within the
-- height), its own head and toggle: each recipe's product
-- icon and name (quality colour), "×3" when you can make it, its reagents
-- as objectives ("Iron Bar 3/6", checked once you have them), or "Ready to
-- craft". Left click opens it in Professions; right click: open, stop
-- tracking.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import ActionButton from "/UI/ActionButton"
import type ObjectiveTracker, QuestRow, TrackerQuest, TrackerObjective from "/UI/ObjectiveTracker"
import type TooltipSource from "/UI/Tooltip"
import type Position from "/EditMode/EditMode"
import after from "wowlua:timer"
import * as errors from "wowlua:errors"
import * as secret from "wowlua:secret"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {
    -- under the minimap's clock (it ends 271px down), space-6 clear
    position = { point = "TOPRIGHT", x = -28, y = -300 } :: Position,
    shows = "always",
    maxHeight = 440,
    collapsed = false,            -- the head's toggle
    collapseInBossFights = true,
    items = true,                 -- quest items beside their quests
    recipes = true,               -- tracked recipes, their own block under the quests
    recipesCollapsed = false,     -- that block's head toggle
    autoTrack = true,             -- a quest you accept is tracked (asked 2026-10-18)
}

local M: ObjectiveTrackerModule

local WIDTH = 260

-- A errors.try that may fail or not exist: its results, or nothing.

-- A tracked quest's usable item.
export type QuestItem = { link: string, icon?: number | string, charges: number }
-- A tracked quest as the tracker draws it, and its sort keys (its zone, how
-- far it is, its place in the quest log).
export type Quest = {
    questID: number,
    logIndex: number,
    title: string,
    difficulty: string,
    complete: boolean,
    failed: boolean,
    objectives?: TrackerObjective[],
    tooltip?: TooltipSource,
    item?: QuestItem,
    zone?: string,
    distance?: number,
}
-- What sortQuests reads.
export type QuestPlace = { zone?: string, distance?: number, logIndex: number }

--------------------------------------------------------------------------------
-- Quests from the game
--------------------------------------------------------------------------------

-- The game's difficulty colour, by its font name, as the design's token.
local DIFFICULTY_FONTS: { font: string, token: string }[] = {
    { font = "VeryDifficult", token = "very-difficult" }, { font = "Impossible", token = "impossible" },
    { font = "Difficult", token = "difficult" }, { font = "Standard", token = "standard" },
    { font = "Trivial", token = "trivial" },
}
local function difficultyOf(level: number): string
    if not (secret.readable(level) and GetQuestDifficultyColor) then return "standard" end
    local c = errors.try(GetQuestDifficultyColor, level)
    local font = type(c) == "table" and secret.asString((c :: { font: unknown }).font)
    if not font then return "standard" end
    for _, d in ipairs(DIFFICULTY_FONTS) do
        if font:find(d.font, 1, true) then return d.token end
    end
    return "standard"
end

-- "0/2 Handful of Cattails" or "Cattails: 0/2" → the text and its count.
local function splitObjective(text: string): (string?, string?)
    local count, rest = text:match("^(%d+%s*/%s*%d+)%s+(.+)$")
    if count then return rest, count end
    rest, count = text:match("^(.-):?%s+(%d+%s*/%s*%d+)$")
    if count then return rest, count end
    return text, nil
end

local function objectivesOf(questID: number): TrackerObjective[]
    local out: TrackerObjective[] = {}
    local ok, list = pcall(C_QuestLog.GetQuestObjectives, questID)
    if not ok or type(list) ~= "table" then return out end
    for _, o in ipairs(list) do
        local text = secret.readable(o.text) and o.text or ""
        local shown, count = splitObjective(text)
        out[#out + 1] = { text = shown, progress = count, done = secret.readable(o.finished) and o.finished == true }
    end
    return out
end

-- One tracked quest as the tracker draws it (nil: not in the log).
local function questOf(questID: number): Quest?
    local logIndex = C_QuestLog.GetLogIndexForQuestID(questID)
    if not secret.readable(logIndex) or not logIndex then return nil end
    local info = C_QuestLog.GetInfo(logIndex)
    if type(info) ~= "table" or info.isHeader or info.isHidden then return nil end
    local complete = C_QuestLog.IsComplete(questID) or C_QuestLog.ReadyForTurnIn(questID)
    local failed = C_QuestLog.IsFailed and C_QuestLog.IsFailed(questID)
    local q: Quest = {
        questID = questID,
        logIndex = logIndex,
        title = secret.readable(info.title) and info.title or "",
        difficulty = difficultyOf(info.difficultyLevel or info.level),
        complete = secret.readable(complete) and complete == true,
        failed = secret.readable(failed) and failed == true,
    }
    if not q.complete then q.objectives = objectivesOf(questID) end
    -- a quest with nothing to count, not complete (rare): its text instead
    if q.complete then
        local text = secret.asString(errors.try(GetQuestLogCompletionText, logIndex))
        if text and text ~= "" then q.tooltip = { title = q.title, description = text } end
    end
    -- its usable item
    if GetQuestLogSpecialItemInfo then
        local ok, link, icon, charges, showWhenComplete = pcall(GetQuestLogSpecialItemInfo, logIndex)
        if ok and secret.readable(link) and link and (not q.complete or showWhenComplete) then
            q.item = { link = link, icon = icon, charges = secret.readable(charges) and charges or 0 }
        end
    end
    return q
end

-- The quest log's heading over a quest (its zone, or a group such as a
-- class or "Dungeon").
local function zoneOf(questID: number, logIndex: number): string?
    local header: number? = C_QuestLog.GetHeaderIndexForQuest and C_QuestLog.GetHeaderIndexForQuest(questID)
    if not (secret.readable(header) and header) then
        -- walk up the log to the heading above
        for i = logIndex - 1, 1, -1 do
            local info = C_QuestLog.GetInfo(i)
            if type(info) == "table" and info.isHeader then header = i break end
        end
    end
    local info = header and C_QuestLog.GetInfo(header)
    return type(info) == "table" and secret.readable(info.title) and info.title or nil
end

-- How far a quest is (squared), when it's on your continent; nil otherwise.
local function distanceOf(questID: number): number?
    if not C_QuestLog.GetDistanceSqToQuest then return nil end
    local ok, d, onContinent = pcall(C_QuestLog.GetDistanceSqToQuest, questID)
    if ok and secret.readable(d) and d and secret.readable(onContinent) and onContinent then return d end
    return nil
end

-- The zone you're in, by both names the game uses.
local function hereNames(): { [string]: boolean }
    local here: { [string]: boolean } = {}
    for _, name in ipairs({ GetRealZoneText and GetRealZoneText(), GetZoneText and GetZoneText() }) do
        if secret.readable(name) and name ~= "" then here[name] = true end
    end
    local map = C_Map.GetBestMapForUnit("player")
    local info = secret.readable(map) and map and C_Map.GetMapInfo(map) or nil
    if info and secret.readable(info.name) then here[info.name] = true end
    return here
end

-- A zone's sort keys: you're in it, its nearest quest, its first in the log.
type ZoneKeys = { here: boolean, first: number, nearest?: number }

-- The quests by zone: the zone you're in (`here`, by name) first, then the
-- zones by their nearest quest, then the rest (another continent, nothing
-- to point at) in quest log order; inside a zone the nearest first. Sorts
-- `list` in place (each quest: zone, distance, logIndex).
export function sortQuests<Q extends QuestPlace>(list: Q[], here: { [string]: boolean })
    local zones: { [string]: ZoneKeys } = {}
    for _, q in ipairs(list) do
        local key = q.zone or ""
        local z: ZoneKeys? = zones[key]
        if not z then
            z = { here = here[key] and true or false, first = q.logIndex }
            zones[key] = z
        end
        local distance = q.distance
        local nearest = z.nearest
        if distance and (not nearest or distance < nearest) then z.nearest = distance end
        if q.logIndex < z.first then z.first = q.logIndex end
    end
    table.sort(list, function(a: Q, b: Q): boolean
        local za, zb = assert(zones[a.zone or ""]), assert(zones[b.zone or ""])
        if za ~= zb then
            if za.here ~= zb.here then return za.here end
            local da, db = za.nearest or math.huge, zb.nearest or math.huge
            if da ~= db then return da < db end
            return za.first < zb.first
        end
        local da, db = a.distance or math.huge, b.distance or math.huge
        if da ~= db then return da < db end
        return a.logIndex < b.logIndex
    end)
end

--------------------------------------------------------------------------------
-- Quest item buttons (secure)
--------------------------------------------------------------------------------

-- A quest's item: SuuUI's secure action button (type "item") left of its
-- quest's title; its cooldown and tooltip the quest item's, the design's
-- "suggested" look in the quest's area.
export class QuestItemButton extends ActionButton
    logIndex: number? = nil
    link: string? = nil
    suggested: boolean? = nil
    suggest: Frame? = nil

    constructor(parent: Frame, i: number)
        super(parent, "SuuUIQuestItem" .. i, "icon-md")
        -- both: a secure button acts on the one the game's ActionButtonUseKeyDown names
        self:RegisterForClicks("AnyDown", "AnyUp")
        self:SetAttribute("type", "item")
        self:SetHotkey("")
        -- an item, not an action slot: the button would draw itself empty
        -- (an empty slot hides its face)
        self.hasAction = true
        self:UpdateEmpty()
    end

    override function UpdateCooldown()
        local logIndex = self.logIndex
        if not logIndex or not GetQuestLogSpecialItemCooldown then return end
        local ok, start, duration = pcall(GetQuestLogSpecialItemCooldown, logIndex)
        if ok and start and duration then
            pcall(self.cooldown.SetCooldown, self.cooldown, start, duration)
            local on = secret.readable(duration) and duration > 1.5
            self.coolingDown = on and true or false
        else
            self.cooldown:Clear()
            self.coolingDown = false
        end
        self:UpdateArt()
    end

    override function ShowTooltip()
        if self.logIndex and GameTooltip.SetQuestLogSpecialItem then
            pcall(GameTooltip.SetQuestLogSpecialItem, GameTooltip, self.logIndex)
        elseif self.link then
            GameTooltip:SetHyperlink(self.link)
        end
    end

    -- In the quest's area: an arcane border, its glow and an arcane ring just inside.
    function SetSuggested(given: unknown)
        local on = given and true or false
        if self.suggested == on then return end
        self.suggested = on
        local suggest = self.suggest
        if not suggest then
            suggest = CreateFrame("Frame", nil, self.over)
            suggest:SetAllPoints()
            UI.Border(suggest, "arcane", { layer = "OVERLAY" })
            UI.Border(suggest, "arcane", { inset = 2, layer = "OVERLAY" })
            UI.Shadow(suggest, "glow-arcane")
            self.suggest = suggest
        end
        suggest:SetShown(on)
    end
end

--------------------------------------------------------------------------------
-- The placed frame and its secure parts
--------------------------------------------------------------------------------

local function bossDriver(on: unknown): string
    return on and "[@boss1,exists] 1; 0" or "0"
end

-- The placed frame: the tracker's whole height, so its secure parts'
-- anchors never move in combat. The item buttons' holder at its top left
-- hides while a boss exists or the tracker is collapsed; the head's toggle
-- is secure too.
class TrackerFrame extends Frame
    readonly holder: Frame
    readonly toggle: Button
    readonly tracker: ObjectiveTracker

    constructor(m: ObjectiveTrackerModule)
        super("SuuUIObjectiveTracker", SuuUI.Root)
        self:SetFrameStrata("LOW")
        local h = CreateFrame("Frame", "SuuUIObjectiveTrackerItems", self, "SecureHandlerStateTemplate")
        h:SetPoint("TOPLEFT")
        h:SetSize(1, 1)
        -- (the state driver gives "1" as the number 1: SecureStateDriver.lua
        -- turns a number-like state into a number)
        h:SetAttribute("_onstate-boss", [=[
            if newstate == 1 or self:GetAttribute("usercollapsed") then self:Hide() else self:Show() end
        ]=])
        self.holder = h
        -- the head's toggle
        local b = CreateFrame("Button", "SuuUIObjectiveTrackerToggle", self, "SecureHandlerClickTemplate")
        b:SetPoint("TOPLEFT")
        b:RegisterForClicks("LeftButtonUp")
        b:SetFrameRef("holder", h)
        b:SetAttribute("_onclick", [=[
            local h = self:GetFrameRef("holder")
            local collapsed = not h:GetAttribute("usercollapsed")
            h:SetAttribute("usercollapsed", collapsed)
            if collapsed or h:GetAttribute("state-boss") == 1 then h:Hide() else h:Show() end
        ]=])
        b:HookScript("OnClick", function()
            m:Set("collapsed", h:GetAttribute("usercollapsed") and true or false)
            m:ApplyCollapse()
        end)
        h:HookScript("OnAttributeChanged", function(_, name)
            if name == "state-boss" then m:ApplyCollapse() end
        end)
        self.toggle = b
        local tracker = UI.ObjectiveTracker(self, { width = WIDTH, toggle = b })
        tracker:SetPoint("TOPLEFT")
        b:SetFrameLevel(tracker:GetFrameLevel() + 5)
        self.tracker = tracker
    end
end

--------------------------------------------------------------------------------
-- Tracked recipes
--------------------------------------------------------------------------------

local QUALITY: { [number]: string } = { [0] = "quality-poor", "ink", "quality-uncommon", "quality-rare", "quality-epic", "quality-legendary" }

-- Opening a profession from an addon is protected (blocked from the
-- tracker, found in game): out of combat a secure button lies over the
-- recipe under the mouse and casts the spell that opens its profession, as
-- an action bar would; the Professions window then chooses the recipe. A
-- right click on it is SuuUI's menu. In combat the rows take the clicks.
local function recipeSkillLine(recipeID: number): number?
    local line, _, parent = errors.try(C_TradeSkillUI.GetTradeSkillLineForRecipe, recipeID)
    local p = secret.asNumber(parent)
    return (p and p ~= 0) and p or secret.asNumber(line)
end

-- Its profession open in the Professions window, ready.
local function professionShown(line: number?): boolean
    local ok, base = pcall(C_TradeSkillUI.GetBaseProfessionInfo)
    return ok and type(base) == "table" and base.professionID == line and errors.try(C_TradeSkillUI.IsTradeSkillReady) and true or false
end

-- The secure button over a tracked recipe's row: a cast opens its profession.
class RecipeOpener extends Button
    recipeID: number? = nil
    row: QuestRow? = nil
    -- the click casts (else it only chooses the recipe)
    casting: boolean = true

    constructor(m: ObjectiveTrackerModule, parent: Frame)
        super("SuuUIRecipeOpener", parent, "SecureActionButtonTemplate")
        -- down and up: the action fires on the one ActionButtonUseKeyDown picks
        self:RegisterForClicks("LeftButtonDown", "LeftButtonUp", "RightButtonUp")
        self:SetAttribute("type1", "spell")
        self:HookScript("PreClick", function(_, button)
            local id = self.recipeID
            if button == "LeftButton" and id then SuuUI.ExpectRecipe(id) end
        end)
        self:HookScript("PostClick", function(_, button)
            local id, row = self.recipeID, self.row
            if button == "RightButton" and row and id then
                m:RecipeMenu(id, row)
            elseif button == "LeftButton" and not self.casting and id then
                -- its profession already open: only the recipe chosen
                SuuUI.OpenRecipe(id)
            end
            -- the next click decides afresh (opened, closed, chosen by now)
            after(0.3, function()
                local now = self.row
                if self:IsShown() and now and self:IsMouseOver() and not InCombatLockdown() then m:RowEnter(now) end
            end)
        end)
        self:SetScript("OnEnter", function()
            local row = self.row
            if row then row:LockHighlight() end
        end)
        self:SetScript("OnLeave", function()
            local row = self.row
            if row then row:UnlockHighlight() end
            if not InCombatLockdown() then self:Hide() end
        end)
        self:Hide()
    end
end

