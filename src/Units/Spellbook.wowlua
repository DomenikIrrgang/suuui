-- Units/Spellbook.wowlua
-- SuuUI's Spellbook page (step 3.2b, design board "Spellbook") inside the
-- spells window's Spellbook tab, in place of Blizzard's page: the schools
-- down the left, two columns of spells, the unlearned ones too.
-- A built-in module written against the public API only.
--
-- What you know comes from the spellbook (C_SpellBook: every rank, the
-- flyouts' spells unpacked); what you don't from the class trainer's list
-- (Data/Trainer, from /suu probe class: name, level, cost, school, icon,
-- description). Ranks for those are worked out by level: a trainer entry at
-- or below the level of your best rank is yours (the book may hold only the
-- best one); the ones above follow it.
--
-- Each learned spell is a SecureActionButton (type "spell"): clicking casts
-- it, dragging puts it on a bar (through the game's secure drag handler:
-- an addon's C_SpellBook.PickupSpellBookItem is blocked in combat, found
-- in game). What every school's pages cast is handed
-- to the page's secure router out of combat, so schools and pages switch
-- in combat too (asked for in game); the switches (Unlearned, All ranks)
-- wait for the end of combat, as they change what the pages hold.
--
-- A level-up shows what it brings: the level-up card (UI.LevelUp, through
-- SuuUI.ShowLevelUp) in the alerts' place, out of combat (a level gained in
-- combat waits for its end). /suu levelup [level] shows it without one.


import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type Spellbook, SpellCell, BookSpell, BookSchool, BookAll from "/UI/Spellbook"
import type LevelUpCard, LevelUpDef, LevelUpSpell from "/UI/LevelUp"
import type TrainerSpell from "/Data/Trainer"
import type Color from "/Core/Tokens"
import after from "wowlua:timer"
import * as secret from "wowlua:secret"
import hook, hookScript from "wowlua:hooks"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"

local UI, T = SuuUI.UI, SuuUI.Tokens

local DEFAULTS = {
    unlearned = true,
    allRanks = false,
    levelUp = true,     -- the level-up card
    untrained = true,   -- it lists earlier levels' spells still to train too
    trainingCost = true, -- what training it all costs: the page's head, the micro menu
    levelUpFor = 0,     -- seconds it stays; 0: 4 and 1 more for each spell shown
}

local M: SpellbookModule

local function coins(copperArg: unknown): string
    local copper = tonumber(copperArg) or 0
    local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local parts: string[] = {}
    if g > 0 then parts[#parts + 1] = g .. "g" end
    if s > 0 or (g > 0 and c > 0) then parts[#parts + 1] = s .. "s" end
    if c > 0 or #parts == 0 then parts[#parts + 1] = c .. "c" end
    return table.concat(parts, " ")
end

local function rankOf(sub: unknown): number?
    return type(sub) == "string" and tonumber(sub:match("(%d+)")) or nil
end

--------------------------------------------------------------------------------
-- What you know
--------------------------------------------------------------------------------

local BANK = Enum.SpellBookSpellBank and Enum.SpellBookSpellBank.Player or 0
local SPELL, FLYOUT = 1, 4
if Enum.SpellBookItemType then SPELL, FLYOUT = Enum.SpellBookItemType.Spell, Enum.SpellBookItemType.Flyout end

-- A school of the page: its name, icon, and its spellbook slots.
export type School = { name: string, icon: number | string, first: number, count: number }

-- A spell on the page: learned (its spellbook slot or flyout spell), passive,
-- or one to train ("trainable" now, "future" at its level), with its rank,
-- the line under it, the level it comes at and, to train, its cost.
export type BookEntry = {
    label: string, status: string, level: number, rank?: number, sub?: string, icon?: number | string,
    spellID?: number, slot?: number, lowRank?: boolean, text?: string, cost?: number, fresh?: boolean,
}

-- A tree's school by the spellbook's (or the trainer's) name for it: the
-- shaman's Elemental tree is the spellbook's Elemental Combat, the priest's
-- Shadow its Shadow Magic (by the tree's name the school showed twice, once
-- empty; found in game). `book`: the spellbook's schools, `byName` them by
-- name, `trainer`: the trainer's entries.
local function schoolName(name: string, book: School[], byName: { [string]: School }, trainer: TrainerSpell[]): string
    if byName[name] then return name end
    local prefix = name .. " "
    for _, s in ipairs(book) do
        if s.name:sub(1, #prefix) == prefix then return s.name end
    end
    for _, t in ipairs(trainer) do
        if type(t.school) == "string" and t.school:sub(1, #prefix) == prefix then return t.school end
    end
    return name
end

-- Every spell that is its own entry in the spellbook, in any school.
local function ownEntries(): { [number]: boolean }
    local ids: { [number]: boolean } = {}
    for i = 1, C_SpellBook.GetNumSpellBookSkillLines() do
        local line = C_SpellBook.GetSpellBookSkillLineInfo(i)
        if line and not line.shouldHide then
            for slot = line.itemIndexOffset + 1, line.itemIndexOffset + line.numSpellBookItems do
                local info = C_SpellBook.GetSpellBookItemInfo(slot, BANK)
                if info and info.itemType == SPELL and info.spellID then ids[info.spellID] = true end
            end
        end
    end
    return ids
end

--------------------------------------------------------------------------------
-- What the trainer still has for you
--------------------------------------------------------------------------------

-- The last line of an unlearned spell's tooltip: train now (arcane) and the
-- cost in coin colours, or the level it comes at.
local colors: { [string]: Color } = T.color
local function hex(token: string): string return assert(colors[token]).hex end
local function coinText(copperArg: unknown): string
    local copper = tonumber(copperArg) or 0
    local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local parts: string[] = {}
    if g > 0 then parts[#parts + 1] = g .. "|cff" .. hex("coin-gold") .. "g|r" end
    if s > 0 then parts[#parts + 1] = s .. "|cff" .. hex("coin-silver") .. "s|r" end
    if c > 0 or #parts == 0 then parts[#parts + 1] = c .. "|cff" .. hex("coin-copper") .. "c|r" end
    return table.concat(parts, " ")
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

-- Only each spell's best rank (the spellbook marks lower ones; flyout
-- spells by name), in the list's order.
local function bestRanks(learned: BookEntry[]): BookEntry[]
    local best: { [string]: BookEntry } = {}
    local shown: BookEntry[] = {}
    for _, s in ipairs(learned) do
        if not s.lowRank then
            local b = best[s.label]
            if not b or (s.rank or 0) > (b.rank or 0) then best[s.label] = s end
        end
    end
    for _, s in ipairs(learned) do
        if best[s.label] == s then shown[#shown + 1] = s end
    end
    return shown
end

-- The window's width for the longest name across every school (steady
-- while paging): page insets 2 × 20, the schools' column 40 and its gap 12,
-- two columns of icon 36 + 8 + text + 6, 20 apart; at least 560 (the head's
-- switches), at most Blizzard's 809.
local function pageWidth(widest: number): number
    return math.floor(math.min(809, math.max(560, 40 + 52 + 2 * (50 + math.ceil(widest)) + 20)))
end

-- The cooldown sweeps on the page's learned spells (the global one too):
-- whether one runs is readable (secret.flag), its timing only as the
-- engine's duration object (secret in combat).

--------------------------------------------------------------------------------
-- Building it into the spells window
--------------------------------------------------------------------------------

-- The Spellbook tab as tall as the Character window (asked for in game);
-- Blizzard's height back for the other tabs. Out of combat (protected).
local SHORT = 484
local TALL = SHORT + 44
-- as wide as the Character window with its stats pane: two columns of spell
-- names need no more (Blizzard's 809 left space to the right: found in game)
local NARROW = 631

-- The spells window and its Spellbook page (once Blizzard's addon loaded).
local function spellsWindow(): Frame? return frames.find("PlayerSpellsFrame") end
local function bookPage(f: Frame?): Frame?
    return frames.asFrame(tbl.field(f, "SpellBookFrame")) or frames.asFrame(tbl.field(f, "SpellbookFrame"))
end

--------------------------------------------------------------------------------
-- What a level brings
--------------------------------------------------------------------------------

local LEVEL_UP = "suu:levelup"
local SHOWN = 10

local function spells(n: number): string return n == 1 and "1 spell" or (n .. " spells") end

-- A spell on the level-up card, and what sorts it (new before older levels').
type CardSpell = {
    icon?: number | string, name: string, rank?: number, isNew: boolean, cost: number, text?: string, meta: string,
    spellID?: number, level: number, old: boolean, note?: string,
}

-- The settings' preview: the card at its real size.
class LevelUpPreview extends Frame
    readonly card: LevelUpCard

    constructor(parent: Frame)
        super(nil, parent)
        self.card = UI.LevelUp(self)
        self.card:SetPoint("TOPLEFT")
        self.card:HookScript("OnSizeChanged", function(c) self:SetSize(c:GetWidth(), c:GetHeight()) end)
    end
end

local function levelUpOff(): (boolean?, string?)
    if not M:Get("levelUp") then return true, "The level-up card is off." end
    return nil, nil
end

local SECTION: SettingsSection = {
    id = "spellbook", label = "Spellbook", category = "General", order = 27,
    preview = function(parent: Frame): Frame return M:PreviewView(parent) end,
    previewNote = "Your next level that brings spells, as the card will show it.",
    groups = {
        { title = "Spells to train", description = "What your class trainer has for you now, across every school.", rows = {
            { key = "trainingCost", label = "Training cost", control = "toggle",
              description = "How many spells you can train in all and what that costs: in the Spellbook's head (in ember when you can't afford it all) and the micro menu's Spellbook tooltip." },
        } },
        { title = "Level up", description = "When you reach a level, a card where the alerts show lists what your class trainer now has for you, and what training all of it costs. Out of combat; a level gained in a fight waits for its end. It needs the Alerts module.", rows = {
            { key = "levelUp", label = "Level-up card", control = "toggle",
              description = "The new spells and ranks your trainer has for you when you reach a level." },
            { key = "levelUpFor", label = "Card stays", control = "slider", min = 0, max = 60, step = 5,
              format = function(v: number): string return v == 0 and "By spells" or (v .. " s") end,
              description = "By spells: 4 seconds and one more for each spell on the card. Or always this many seconds.",
              disabled = levelUpOff },
            { key = "untrained", label = "Spells still to train", control = "toggle",
              description = "The card lists the spells from earlier levels you haven't trained yet too, with the level they came at, until you train them.",
              disabled = levelUpOff },
            { label = "Try it", control = "button", text = "Show the card",
              description = "Your next level's card on screen now.",
              onClick = function() M:PreviewLevelUp() end },
        } },
    },
}

-- The game's own level-up toast (its event toasts: "Level 12", the spells it
-- brings) out of sight while the level-up card is on (asked 2026-10-18).
-- Only level-up toasts: the others (flight points, scenarios) stay.
local LEVEL_TOASTS: { [unknown]: boolean } = {}
for _, key in ipairs({ "LevelUp", "LevelUpSpell", "LevelUpDungeon", "LevelUpRaid", "LevelUpPvP" }) do
    local v = tbl.field(tbl.field(Enum, "EventToastEventType"), key)
    if v ~= nil then LEVEL_TOASTS[v] = true end
end

-- What the trainer's known entries for a spell name say: the levels and
-- ranks you have of it, and whether it has ranks.
type Known = { levels: { [number]: boolean }, maxRank: number, maxLevel: number, ranked?: boolean }

export class SpellbookModule extends Module<typeof(DEFAULTS)>
    blizzHeight: number? = nil
    blizzWidth: number? = nil
    book: Spellbook? = nil
    -- a trainer rank's spell ID, by name and level
    readonly ids: { [string]: number } = {}
    levelFrom: number? = nil
    levelTimer: TimerHandle? = nil
    levelTo: number? = nil
    page: number? = nil
    prepared: boolean = false
    previewView: LevelUpPreview? = nil
    renderAfterCombat: boolean = false
    sayTimer: TimerHandle? = nil
    school: number? = nil
    sizing: boolean = false
    -- the spells on the page shown
    slice: BookEntry[]? = nil
    toastsHooked: boolean? = nil
    wantWidth: number? = nil

    constructor()
        super({
            id = "spellbook",
            name = "Spellbook",
            description = "SuuUI's Spellbook page: your spells by school, the ones to train and still to come.",
            api = "0.12",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- The schools (General, then the three talent trees). A tree you have no
    -- spell in yet (at level 1) is there too, from the class's talents and the
    -- trainer's list: its spells to come show with their level (asked for in
    -- game).
    function Schools(): School[]
        local book: School[], byName: { [string]: School } = {}, {}
        for i = 1, C_SpellBook.GetNumSpellBookSkillLines() do
            local info = C_SpellBook.GetSpellBookSkillLineInfo(i)
            if info and not info.shouldHide and not info.isGuild then
                local s: School = { name = info.name, icon = info.iconID, first = info.itemIndexOffset + 1, count = info.numSpellBookItems }
                book[#book + 1] = s
                byName[s.name] = s
            end
        end
        -- the trees, in order
        local _, class = UnitClass("player")
        local trees: { [number]: string } = {}
        for _, t in ipairs(SuuUI.ClassTalents and SuuUI.ClassTalents(class :: string) or {}) do
            local spec = t.spec
            if t.tree and spec and not trees[t.tree] then trees[t.tree] = spec end
        end
        -- a tree's own icon: the game's spec info (when its name is the tree's),
        -- else the tree's earliest trainer spell (alphabetical was wrong: found
        -- in game)
        local _, _, classID = UnitClass("player")
        local function treeIcon(name: string, tree: number): (number | string)?
            local tries: (() -> (unknown, unknown))[] = {
                function(): (unknown, unknown) local _, n, _, icon = GetSpecializationInfoForClassID(classID :: number, tree); return n, icon end,
                function(): (unknown, unknown) local _, n, _, icon = C_SpecializationInfo.GetSpecializationInfo(tree); return n, icon end,
            }
            for _, try in ipairs(tries) do
                local ok, n, icon = pcall(try)
                if ok and (type(icon) == "number" or type(icon) == "string") and n == name then return icon :: number | string end
            end
            local best: TrainerSpell? = nil
            for _, t in ipairs(SuuUI.TrainerSpells()) do
                if t.school == name and t.icon and (not best or t.level < best.level) then best = t end
            end
            return best and best.icon
        end
        local out: School[], used: { [School]: boolean } = {}, {}
        local general = book[1]
        if general then out[1] = general; used[general] = true end
        for tree = 1, 3 do
            local spec = trees[tree]
            local name = spec and schoolName(spec, book, byName, SuuUI.TrainerSpells())
            if spec and name then
                local s = byName[name] or { name = name, icon = treeIcon(name, tree) or treeIcon(spec, tree) or 134400, first = 1, count = 0 }
                out[#out + 1] = s
                used[s] = true
            end
        end
        -- anything else the spellbook has (another client's lines)
        for _, s in ipairs(book) do
            if not used[s] then out[#out + 1] = s end
        end
        return out
    end

    -- A school's learned spells, in the spellbook's order, flyouts unpacked.
    function Learned(school: School): BookEntry[]
        local list: BookEntry[] = {}
        -- a flyout's spells, unpacked, but not those with their own entry
        -- elsewhere (Forever's warrior has a stances flyout under Protection:
        -- Battle Stance showed there and under Arms, found in game)
        local own: { [number]: boolean }? = nil
        for slot = school.first, school.first + school.count - 1 do
            local info = C_SpellBook.GetSpellBookItemInfo(slot, BANK)
            local action = info and info.actionID
            if info and info.itemType == FLYOUT and GetFlyoutInfo and action then
                local _, _, n = GetFlyoutInfo(action)
                for j = 1, n or 0 do
                    local spellID, _, known, name = GetFlyoutSlotInfo(action, j)
                    local mine = own or ownEntries()
                    own = mine
                    if known and spellID and not mine[spellID] then
                        local sub = C_Spell.GetSpellSubtext and C_Spell.GetSpellSubtext(spellID) or nil
                        list[#list + 1] = { label = name, spellID = spellID, rank = rankOf(sub), sub = sub,
                            icon = C_Spell.GetSpellTexture(spellID), status = "learned",
                            level = C_Spell.GetSpellLevelLearned and C_Spell.GetSpellLevelLearned(spellID) or 0 }
                    end
                end
            elseif info and info.itemType == SPELL then
                local passive = info.isPassive and true or false
                local spellID = info.spellID
                list[#list + 1] = { label = info.name, spellID = spellID, slot = slot, rank = rankOf(info.subName),
                    sub = passive and "Passive" or ((info.subName and info.subName ~= "") and info.subName or nil),
                    icon = info.iconID, status = passive and "passive" or "learned",
                    lowRank = C_SpellBook.IsSpellBookItemLowRank and C_SpellBook.IsSpellBookItemLowRank(slot, BANK) or false,
                    level = C_Spell.GetSpellLevelLearned and spellID and C_Spell.GetSpellLevelLearned(spellID) or 0 }
            end
        end
        -- "Racial Passive" and the like keep their own words
        for _, s in ipairs(list) do
            if s.status == "passive" and s.rank == nil then
                local slot = s.slot
                local info = slot and C_SpellBook.GetSpellBookItemInfo(slot, BANK)
                if info and info.subName and info.subName ~= "" then s.sub = info.subName end
            end
        end
        return list
    end

    -- Trainer entries by school name (unknown schools go to General).
    function TrainerBySchool(schools: School[]): { [string]: TrainerSpell[] }
        local names: { [string]: boolean } = {}
        for _, s in ipairs(schools) do names[s.name] = true end
        local general = schools[1] and schools[1].name
        local by: { [string]: TrainerSpell[] } = {}
        for _, t in ipairs(SuuUI.TrainerSpells()) do
            local school = names[t.school] and t.school or general
            if school then
                local list = by[school] or {}
                by[school] = list
                table.insert(list, t)
            end
        end
        return by
    end

    -- The ranks you don't have yet, from the trainer's entries for each name;
    -- trainable up to `levelArg` (your level by default).
    function Unlearned(entries: TrainerSpell[]?, learnedAll: BookEntry[], levelArg: number?): BookEntry[]
        local known: { [string]: Known } = {}
        for _, s in ipairs(learnedAll) do
            local k = known[s.label] or { levels = {}, maxRank = 0, maxLevel = 0 }
            known[s.label] = k
            if s.level then
                k.levels[s.level] = true
                if s.level > k.maxLevel then k.maxLevel = s.level end
            end
            local rank = s.rank
            if rank and rank > k.maxRank then k.maxRank = rank end
            if rank then k.ranked = true end
        end
        local byName: { [string]: TrainerSpell[] }, order: string[] = {}, {}
        for _, t in ipairs(entries or {}) do
            local list = byName[t.name]
            if not list then list = {}; byName[t.name] = list; order[#order + 1] = t.name end
            table.insert(list, t)
        end
        local out: BookEntry[], level = {}, levelArg or UnitLevel("player") or 1
        for _, name in ipairs(order) do
            local list = assert(byName[name])
            table.sort(list, function(a: TrainerSpell, b: TrainerSpell): boolean return a.level < b.level end)
            local have = known[name] ~= nil
            local k = known[name] or { levels = {}, maxRank = 0, maxLevel = 0 }
            local ranked = k.ranked or #list > 1
            local next = k.maxRank
            for i, t in ipairs(list) do
                -- yours: a spell without ranks you know (a passive such as Parry:
                -- the game gives it no level, found in game); a rank at or below
                -- your best one's level (the game drops lower ranks from the book
                -- once a higher one is learned: Devotion Aura Rank 3 alone at
                -- level 21 made the level 1 and 10 ranks "Rank 4 and 5"); with no
                -- levels to go by, as many ranks as your best one's number
                local mine = (have and not k.ranked)
                    or k.levels[t.level] or t.level <= k.maxLevel
                    or (k.maxLevel == 0 and i <= k.maxRank)
                if not mine then
                    next = next + 1
                    local trainable = t.level <= level
                    out[#out + 1] = { label = name, rank = ranked and next or nil, icon = t.icon, text = t.text, cost = t.cost,
                        fresh = known[name] == nil,
                        level = t.level, status = trainable and "trainable" or "future",
                        sub = trainable and ("Train now · " .. coins(t.cost)) or ("Level " .. t.level) }
                end
            end
        end
        table.sort(out, function(a: BookEntry, b: BookEntry): boolean
            if a.status ~= b.status then return a.status == "trainable" end
            if a.level ~= b.level then return a.level < b.level end
            return a.label < b.label
        end)
        return out
    end

    -- A trainer rank's own spell ID, for the game's spell tooltip: of every ID
    -- with its name (Data/Trainer, from the ID scan), the one the game says is
    -- learned at that level; its rank and icon settle a tie. nil when none fits
    -- (SuuUI's own tooltip then).
    function SpellIDFor(s: BookEntry): number?
        local name, level = s.label, s.level
        if not name or not level then return nil end
        local key = name .. "#" .. level
        local known = self.ids[key]
        if known then return known end
        local best: number?, bestScore = nil, 0
        for _, id in ipairs(SuuUI.TrainerSpellIDs()[name] or {}) do
            local score = 0
            local ok, learned = pcall(C_Spell.GetSpellLevelLearned, id)
            if ok and learned == level then score = score + 4 end
            if s.rank and C_Spell.GetSpellSubtext then
                local okR, sub = pcall(C_Spell.GetSpellSubtext, id)
                if okR and sub == ("Rank " .. s.rank) then score = score + 2 end
            end
            if s.icon and C_Spell.GetSpellTexture(id) == s.icon then score = score + 1 end
            if score > bestScore then best, bestScore = id, score end
        end
        -- the level, or the rank and icon together (a miss isn't kept: the
        -- game may not have loaded the spell's data yet)
        if bestScore < 3 or not best then return nil end
        self.ids[key] = best
        return best
    end

    function TrainLine(s: BookEntry): string
        if s.level and s.level <= (UnitLevel("player") or 1) then
            return "|cff" .. hex("arcane") .. "Train now at your class trainer|r  |cff" .. hex("ink") .. coinText(s.cost) .. "|r"
        end
        return "|cff" .. hex("ink-muted") .. "Learn at level " .. tostring(s.level) .. " · |r" .. coinText(s.cost)
    end

    -- An unlearned spell's tooltip: the game's own when its ID is found, with
    -- the training line under it; else SuuUI's.
    function ShowUnlearnedTip(owner: Frame, s: BookEntry)
        local id = self:SpellIDFor(s)
        if id then
            UI.SpellTooltip(owner, id, self:TrainLine(s))
            return
        end
        UI.ShowTooltip(owner, { title = s.label, subtitle = s.rank and ("Rank " .. s.rank) or nil, description = s.text,
            meta = s.status == "trainable" and ("Train now at your class trainer · " .. coins(s.cost)) or ("Learn at level " .. s.level) })
    end

    -- The list a school shows, with the switches applied.
    function SchoolList(school: School, trainer: { [string]: TrainerSpell[] }): (BookEntry[], number)
        local learned = self:Learned(school)
        local shown = self:Get("allRanks") and learned or bestRanks(learned)
        local unlearned = self:Unlearned(trainer[school.name], learned)
        local list: BookEntry[] = {}
        for _, s in ipairs(shown) do list[#list + 1] = s end
        local toTrain, nextShown = 0, {} :: { [string]: boolean }
        for _, s in ipairs(unlearned) do
            if s.status == "trainable" then toTrain = toTrain + 1 end
            if self:Get("unlearned") then
                -- without All ranks: only each spell's next rank to come
                if self:Get("allRanks") or not nextShown[s.label] then
                    list[#list + 1] = s
                    nextShown[s.label] = true
                end
            end
        end
        return list, toTrain
    end

    -- force: also while the window is closed (out of combat), so the page and
    -- its buttons are ready before a fight: the buttons can't change in one.
    function Render(force: boolean?)
        local book = self.book
        if not book or not (force or book:IsVisible()) then return end
        -- in combat: only the look of a school or page the router already points
        -- the buttons at (prepared out of combat)
        local combat = InCombatLockdown()
        if combat and not self.prepared then
            self.renderAfterCombat = true
            return
        end
        local schools = self:Schools()
        if #schools == 0 then return end
        local chosen = math.max(1, math.min(self.school or 2, #schools))
        self.school = chosen
        local trainer = self:TrainerBySchool(schools)
        local tabs: BookSchool[] = {}
        local current: BookEntry[], toTrain = {}, 0
        local widest = 0
        local casts: (number | false)[][] = {}
        for i, s in ipairs(schools) do
            local list, n = self:SchoolList(s, trainer)
            local ids: (number | false)[] = {}
            for k, sp in ipairs(list) do ids[k] = (sp.status == "learned" and sp.spellID) or false end
            casts[i] = ids
            for _, sp in ipairs(list) do
                local name = (sp.label or "") .. ((sp.status ~= "learned" and sp.status ~= "passive" and sp.rank) and ("  Rank " .. sp.rank) or "")
                widest = math.max(widest, UI.MeasureText("label", name), UI.MeasureText("caption", sp.sub or ""))
            end
            tabs[i] = { label = s.name, icon = s.icon, trainable = n, active = i == chosen }
            if i == chosen then current, toTrain = list, n end
        end
        -- the window as wide as two columns of the longest name (out of combat)
        local want = pageWidth(widest)
        if not combat and want ~= self.wantWidth then
            self.wantWidth = want
            self:Shorten()
        end
        book:SetWidest(widest)
        book:SetSchools(tabs)
        local okAll, count, cost = pcall(self.CountToTrain, self)
        local all: BookAll? = okAll and self:Get("trainingCost") and { count = count, cost = cost, short = (GetMoney() or 0) < cost } or nil
        book:SetHead(assert(schools[chosen]).name, toTrain, all)
        book:SetSwitches(self:Get("unlearned"), self:Get("allRanks"))
        -- as many as the page holds
        local perPage = book:FitRows() * 2
        local pages = math.max(1, math.ceil(#current / perPage))
        local page = math.min(math.max(1, self.page or 1), pages)
        self.page = page
        local slice: BookEntry[] = {}
        local shown: BookSpell[] = {}
        for i = 1, perPage do
            local s = current[(page - 1) * perPage + i]
            slice[i] = s
            shown[i] = s
        end
        self.slice = slice
        book:SetSpells(shown)
        book:SetPage(page, pages)
        self:UpdateCooldowns()
        -- what each button casts (learned spells only), on every school's
        -- pages: the router points the buttons at this one, in combat too
        if not combat then
            book:SetCasts(casts, perPage)
            book:SetCastPage(chosen, page)
            self.prepared = true
        end
    end

    function UpdateCooldowns()
        local book = self.book
        if not book or not book:IsVisible() then return end
        for i in ipairs(book.cells) do
            local s = self.slice and self.slice[i]
            local id = s and (s.status == "learned") and s.spellID
            local info = id and C_Spell.GetSpellCooldown and C_Spell.GetSpellCooldown(id)
            local active = info and secret.flag(info.isActive) or false
            local gcd = info and secret.flag(info.isOnGCD) or false
            local d = active and id and C_Spell.GetSpellCooldownDuration and C_Spell.GetSpellCooldownDuration(id) or nil
            book:SetCooldown(i, active, gcd, d)
        end
    end

    function Build()
        local f = spellsWindow()
        local page = bookPage(f)
        if not f or not page or self.book or InCombatLockdown() then return end
        -- Blizzard's page out of sight (still there underneath; SuuUI's covers it)
        for _, key in ipairs({ "CategoryTabSystem", "PagedSpellsFrame", "PagingControls", "SearchBox", "SearchBoxIcon",
                               "SettingsDropdown", "SettingsTopFaceIcon", "AssistedCombatRotationSpellFrame", "HelpPlateButton",
                               "SearchPreviewContainer", "PreviousCategoryIcon", "NextCategoryIcon" }) do
            local r = frames.asRegion(tbl.field(page, key))
            if r then r:SetAlpha(0) end
        end
        for _, r in ipairs({ page:GetRegions() }) do if r:GetObjectType() == "Texture" then r:SetAlpha(0) end end
        -- its spell buttons off screen too: see-through only, Blizzard's wider
        -- page stuck out of the window and they took the mouse there (found in
        -- game on the Talents tab, the same on this one). Back off screen
        -- whenever Blizzard places them again (out of combat).
        local paged = frames.asFrame(tbl.field(page, "PagedSpellsFrame"))
        if paged then frames.keepAway(paged) end
        local book = UI.Spellbook(page, { rows = 6, edgeInset = 20 })
        -- on the window itself (the window is shortened while this tab shows;
        -- Blizzard's page keeps its own, taller size)
        book:SetPoint("TOPLEFT", f, "TOPLEFT", 20, -44)
        book:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -20, 16)
        book:SetFrameLevel(page:GetFrameLevel() + 50)
        book:EnableMouse(true) -- Blizzard's buttons underneath get no clicks
        self.book = book
        -- (the secure router has already pointed the buttons at the new page)
        book.onSchool = function(i: number)
            self.school, self.page = i, 1
            self:Render()
        end
        book.onPage = function(delta: number)
            self.page = (self.page or 1) + delta
            self:Render()
        end
        book.onSwitch = function(key: string, on: boolean)
            self:Set(key == "unlearned" and "unlearned" or "allRanks", on)
            self.page = 1
            -- (what the pages hold changes: after combat)
            if InCombatLockdown() then self.prepared = false end
            self:Render()
        end
        book.onEnter = function(i: number, c: SpellCell)
            local s = self.slice and self.slice[i]
            if not s then return end
            if s.status == "learned" or s.status == "passive" then
                GameTooltip:SetOwner(c.button, "ANCHOR_RIGHT")
                local slot, spellID = s.slot, s.spellID
                if slot then GameTooltip:SetSpellBookItem(slot, BANK) elseif spellID then GameTooltip:SetSpellByID(spellID) end
                GameTooltip:Show()
            else
                self:ShowUnlearnedTip(c.button, s)
            end
        end
        book.onLeave = function()
            GameTooltip:Hide()
            UI.HideTooltip()
        end
        -- a sweep ended: the game can call it active a moment longer
        book.onCooldownDone = function()
            self:UpdateCooldowns()
            after(0.1, function() self:UpdateCooldowns() end)
        end
        book:HookScript("OnShow", function() self:UpdateCooldowns() end)
        -- Blizzard's maximise/minimise switches its own book between one and two
        -- pages: nothing to do with SuuUI's page, so it goes while this tab shows
        local function maxMin(on: boolean)
            local mm = frames.asFrame(tbl.field(f, "MaximizeMinimizeButton"))
            if not mm then return end
            mm:SetAlpha(on and 1 or 0)
            if InCombatLockdown() then return end -- (inside a protected window)
            for _, b in ipairs(frames.children(mm)) do b:EnableMouse(on) end
        end
        book:HookScript("OnShow", function() maxMin(false); self:Shorten(); self:Render() end)
        book:HookScript("OnHide", function() maxMin(true); self:Restore() end)
        -- Blizzard's UpdateSize sets the height again right after the window
        -- shows (in the same frame): shortened at once, so the tall one is never
        -- drawn (the flicker, found with /suu probe flicker)
        local function again()
            if not self.sizing and page:IsShown() then self:Shorten() end
        end
        hook(f, "SetHeight", again)
        hook(f, "SetWidth", again)
        hook(f, "SetSize", again)
        book:HookScript("OnSizeChanged", function() if book:IsVisible() then self:Render() end end)
        -- filled now, while the window is still closed
        self:Render(true)
    end

    function Shorten()
        local f = spellsWindow()
        if not f or InCombatLockdown() then return end
        -- the Character window's open height and one row of spells more (36px
        -- icons, 8px apart: 44), asked for in game; no longer tied to the
        -- Character window
        local target = TALL
        local width = self.wantWidth or NARROW
        self:Place()
        local narrow = math.abs(f:GetWidth() - width) < 1
        if math.abs(f:GetHeight() - target) < 1 and narrow then return end
        if math.abs(f:GetHeight() - target) >= 1 then self.blizzHeight = f:GetHeight() end
        if not narrow then self.blizzWidth = f:GetWidth() end
        self.sizing = true
        f:SetHeight(target)
        f:SetWidth(width)
        self.sizing = false
    end

    -- The window opened in combat too at this size and place (its secure
    -- placer: SuuUI can't size or move it in a fight). Out of combat; the
    -- placer needs SuuUI's skin on the window, which may come after the page
    -- (found in game: first opened in a fight, Blizzard's size and place).
    function Place()
        local f = spellsWindow()
        if not f or InCombatLockdown() then return end
        local placer = UI.SecurePlacement(f)
        local page = bookPage(f)
        if placer and page then
            placer:Track("spellbook", page)
            placer:SetTabSize("spellbook", self.wantWidth or NARROW, TALL)
        end
    end

    -- How many spells you could train now, across every school; said to the
    -- rest of SuuUI (the micro menu marks its Spellbook button) whenever it may
    -- have changed. Needs no window: the spellbook and trainer data are there.
    -- Returns the count and what training all of it costs (copper).
    function CountToTrain(): (number, number)
        local schools = self:Schools()
        local trainer = self:TrainerBySchool(schools)
        local total, cost = 0, 0
        for _, s in ipairs(schools) do
            for _, e in ipairs(self:Unlearned(trainer[s.name], self:Learned(s))) do
                if e.status == "trainable" then
                    total = total + 1
                    cost = cost + (tonumber(e.cost) or 0)
                end
            end
        end
        return total, cost
    end

    function SayToTrain()
        if self.sayTimer then return end
        self.sayTimer = after(1, function()
            self.sayTimer = nil
            if not self:IsEnabled() then return end
            local ok, n, cost = pcall(self.CountToTrain, self)
            if ok then self:Emit("SUUUI_SPELLS_TO_TRAIN", n, self:Get("trainingCost") and cost or nil) end
        end)
    end

    -- The spells and ranks the trainer has for levels from..to that you don't
    -- have, and with the Untrained setting the earlier levels' ones too (their
    -- level as a note): this level's first, new spells first, then by name.
    function NewBetween(from: number, to: number): CardSpell[]
        local schools = self:Schools()
        local trainer = self:TrainerBySchool(schools)
        local older = self:Get("untrained")
        local list: CardSpell[] = {}
        for _, school in ipairs(schools) do
            for _, e in ipairs(self:Unlearned(trainer[school.name], self:Learned(school))) do
                local now = e.level >= from and e.level <= to
                if now or (older and e.level < from) then
                    list[#list + 1] = { icon = e.icon, name = e.label, rank = e.rank, isNew = e.fresh == true, cost = tonumber(e.cost) or 0,
                        text = e.text, meta = self:TrainLine(e),
                        spellID = self:SpellIDFor(e), level = e.level,
                        old = not now, note = not now and ("Level " .. e.level) or nil }
                end
            end
        end
        table.sort(list, function(a: CardSpell, b: CardSpell): boolean
            if a.old ~= b.old then return b.old end
            if a.isNew ~= b.isNew then return a.isNew end
            if a.name ~= b.name then return a.name < b.name end
            return (a.rank or 0) < (b.rank or 0)
        end)
        return list
    end

    -- The card's content for reaching `level` (and any level since `from`); nil
    -- when the trainer has nothing for you. Also how many spells it holds.
    function LevelUpCard(level: number, from: number?): (LevelUpDef?, number)
        local list = self:NewBetween(from or level, level)
        if #list == 0 then return nil, 0 end
        local cost, fresh, old = 0, 0, 0
        local shown: LevelUpSpell[] = {}
        for i, sp in ipairs(list) do
            cost = cost + sp.cost
            if sp.old then old = old + 1 else fresh = fresh + 1 end
            shown[i] = sp
        end
        local detail
        if old == 0 then detail = (fresh == 1 and "1 new spell" or (fresh .. " new spells")) .. " to train"
        elseif fresh == 0 then detail = spells(old) .. " still to train"
        else detail = (fresh == 1 and "1 new spell" or (fresh .. " new spells")) .. ", " .. old .. " still to train" end
        local n = #list
        return {
            title = "Level " .. level,
            detail = detail,
            spells = shown,
            more = n > SHOWN and ("+ " .. (n - SHOWN) .. " more in your Spellbook") or nil,
            cost = cost,
        }, n
    end

    -- The next level that brings the trainer something (for the preview and
    -- /suu levelup).
    function NextLevelUp(): LevelUpDef?
        for l = (UnitLevel("player") or 1) + 1, 80 do
            local def = self:LevelUpCard(l)
            if def then return def end
        end
        return nil
    end

    -- The card for reaching `level`; false when the trainer has nothing for you.
    function ShowLevelUp(level: number, from: number?): boolean
        local def, n = self:LevelUpCard(level, from)
        if not def then return false end
        SuuUI.ShowLevelUp(LEVEL_UP, def)
        -- the setting's seconds, or 4 s and 1 more for each spell shown (14 at most)
        local timer = self.levelTimer
        if timer then timer:Cancel() end
        local stay = self:Get("levelUpFor")
        if stay <= 0 then stay = 4 + math.min(n, SHOWN) end
        self.levelTimer = after(stay, function()
            self.levelTimer = nil
            SuuUI.HideAlert(LEVEL_UP)
        end)
        return true
    end

    -- A level gained: now, or once combat ends.
    function LevelGained(levelArg: unknown)
        local level = tonumber(levelArg) or UnitLevel("player")
        self.levelFrom = math.min(self.levelFrom or level, level)
        self.levelTo = math.max(self.levelTo or level, level)
        if InCombatLockdown() then return end
        after(0.5, function()
            local from, to = self.levelFrom, self.levelTo
            if not to or InCombatLockdown() then return end
            self.levelFrom, self.levelTo = nil, nil
            if self:Get("levelUp") then pcall(self.ShowLevelUp, self, to, from) end
        end)
    end

    -- The next level's card on screen (the settings' button, /suu levelup).
    function PreviewLevelUp()
        for l = (UnitLevel("player") or 1) + 1, 80 do
            if self:ShowLevelUp(l) then return end
        end
        self:Print("Nothing left to learn from the trainer.")
    end

    -- The settings' preview: the next level's card at its real size.
    function PreviewView(parent: Frame): Frame
        local view = self.previewView
        if not view then
            local made = LevelUpPreview.new(parent)
            view = made
            self.previewView = made
            self:On("SUUUI_SETTING_CHANGED", function(_, namespace)
                if namespace == self.id and made:IsVisible() then self:DrawPreview() end
            end)
        end
        view:SetParent(parent)
        self:DrawPreview()
        return view
    end

    function DrawPreview()
        local view = self.previewView
        if not view then return end
        local ok, def = pcall(self.NextLevelUp, self)
        view.card:SetLevelUp(ok and def or { title = "Level " .. ((UnitLevel("player") or 1) + 1), detail = "Nothing left to learn from the trainer" })
        view:SetSize(view.card:GetWidth(), view.card:GetHeight())
    end

    -- The Character window resized while the Spellbook shows: the same height.
    function MeasureCharacter()
        local book = self.book
        if book and book:IsVisible() then self:Shorten() end
    end

    function Restore()
        local f = spellsWindow()
        local height, width = self.blizzHeight, self.blizzWidth
        if not f or InCombatLockdown() or not (height or width) then return end
        self.sizing = true
        if height then f:SetHeight(height) end
        if width then f:SetWidth(width) end
        self.sizing = false
        self.blizzHeight, self.blizzWidth = nil, nil
    end

    function HideLevelToasts()
        local f = frames.find("EventToastManagerFrame")
        if not f or self.toastsHooked then return end
        self.toastsHooked = true
        -- (its DisplayToast is the toast manager's mixin's, not declared)
        hook(f :: { [string]: unknown }, "DisplayToast", function(given: unknown)
            local frame = frames.asFrame(given)
            if not frame then return end
            local info = tbl.field(tbl.field(frame, "currentDisplayingToast"), "toastInfo")
            local level = self:IsEnabled() and self:Get("levelUp") and info ~= nil and LEVEL_TOASTS[tbl.field(info, "eventType")] == true
            frame:SetAlpha(level and 0 or 1)
            frame:EnableMouse(not level)
        end)
    end

    override function OnEnable()
        self:HideLevelToasts()
        local cf = frames.find("CharacterFrame")
        if cf then
            hookScript(cf, "OnShow", function() after(0, function() self:MeasureCharacter() end) end)
            hookScript(cf, "OnSizeChanged", function() self:MeasureCharacter() end)
        end
        -- Blizzard's spells window loads the first time it opens; in combat the
        -- page couldn't be built then, and Blizzard's own showed (found in
        -- game). Loaded now, out of combat, so the page is built and filled
        -- before any fight.
        if C_AddOns and C_AddOns.IsAddOnLoaded and not C_AddOns.IsAddOnLoaded("Blizzard_PlayerSpells") and not InCombatLockdown() then
            pcall(C_AddOns.LoadAddOn, "Blizzard_PlayerSpells")
        end
        self:Build()
        self:OnGameEvent("ADDON_LOADED", function() self:Build() end)
        for _, e in ipairs({ "SPELLS_CHANGED", "PLAYER_LEVEL_UP" }) do
            self:OnGameEvent(e, function()
                if self.book then self:Render(true) end
                self:SayToTrain()
            end)
        end
        self:OnGameEvent("PLAYER_ENTERING_WORLD", function() self:SayToTrain() end)
        -- the page made ready as a fight starts (the moment before the
        -- lockdown) if it never was: the window first opened in that fight
        -- takes the Spellbook's size, and its school and page buttons work
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            if not self.book then return end
            if not self.prepared then self:Render(true) end
            self:Place()
        end)
        -- the sweeps: in combat too (only the look changes)
        for _, e in ipairs({ "SPELL_UPDATE_COOLDOWN", "ACTIONBAR_UPDATE_COOLDOWN" }) do
            self:OnGameEvent(e, function() self:UpdateCooldowns() end)
        end
        -- the cost in ember when your money no longer covers it, and the setting
        self:OnGameEvent("PLAYER_MONEY", function()
            local book = self.book
            if book and book:IsVisible() then self:Render() end
        end)
        self:On("SUUUI_SETTING_CHANGED", function(_, namespace, key)
            if namespace ~= self.id or key ~= "trainingCost" then return end
            if self.book then self:Render() end
            self:SayToTrain()
        end)
        -- the page's ranks and costs carry colour codes: drawn again (after
        -- combat, as any render)
        self:On("SUUUI_THEME_CHANGED", function()
            if self.book then self:Render() end
            local view = self.previewView
            if view and view:IsVisible() then self:DrawPreview() end
        end)
        SuuUI.AllowAlertOutOfCombat(LEVEL_UP)
        self:RegisterSettings(SECTION)
        self:OnGameEvent("PLAYER_LEVEL_UP", function(_, level) self:LevelGained(level) end)
        -- as if you went from where you are now to that level: everything the
        -- levels in between bring, your settings applied (the card on or off
        -- aside), in combat too
        self:RegisterCommand("levelup", "Simulate reaching a level from where you are now: /suu levelup <level> (no level: the next one that brings spells).", function(arg)
            local level = tonumber(arg and arg:match("%d+"))
            if not level then return self:PreviewLevelUp() end
            local now = UnitLevel("player") or 1
            local from = level > now and (now + 1) or level
            if not self:ShowLevelUp(level, from) then
                self:Print(("Nothing from the trainer between level %d and %d."):format(from, level))
            end
        end)
        self:SayToTrain()
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if self.levelTo then self:LevelGained(self.levelTo) end
            if not self.book then self:Build() end
            if self.renderAfterCombat then
                self.renderAfterCombat = false
                self:Render(true)
            end
        end)
    end
end

M = SuuUI.AddModule(SpellbookModule.new())
