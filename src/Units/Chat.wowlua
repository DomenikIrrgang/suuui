--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

export class ChatModule extends Module<typeof(DEFAULTS)>
    panel: ChatPanel? = nil
    -- SuuUI's message frame per window, the one shown, the tab chosen
    mirrors: { [Window]: Mirror } = {}
    activeMirror: Mirror? = nil
    selected: TabOf? = nil
    unread: { [Window]: boolean } = {}
    whispers: Whisper[] = {}
    search: SearchPage? = nil
    windowsEditor: WindowsEditor? = nil
    -- the input's history: the recall under way, Enter seen, boxes hooked
    recall: Recall? = nil
    keyCapture: boolean? = nil
    historyBoxes: { [EditBox]: boolean } = {}
    -- Blizzard's art and fonts dealt with
    sbHooked: { [Frame]: boolean } = {}
    fontSizes: { [Window]: number } = {}
    -- ChatFrame1's place: waiting for the end of combat, being set
    pendingPlace: boolean? = nil
    pendingSkin: boolean? = nil
    placing: boolean? = nil
    -- the tabs: a press, a drag, a glide on the next layout
    press: Press? = nil
    drag: Drag? = nil
    glideOnce: boolean? = nil
    -- the idle fade
    awake: boolean? = nil
    lastActive: number = 0
    frameCount: number = 0
    -- the windows' refresh: waiting for the next frame, the windows and
    -- Blizzard's code watched, the edit boxes as last seen
    windowsPending: boolean? = nil
    watchedWindows: { [Window]: boolean } = {}
    windowCodeHooked: boolean? = nil
    boxes: EditBox[] = {}
    -- kept chat
    historyLoaded: boolean? = nil
    loggedOutAt: number? = nil
    keptWindows: { [number]: unknown }? = nil
    warnedGlobal: boolean? = nil
    anchorHooked: boolean? = nil
    driver: Frame? = nil

    constructor()
        super({
            id = "chat",
            name = "Chat",
            description = "Blizzard's chat in SuuUI's look: a glass panel, SuuUI tabs and input, fading while idle.",
            api = "0.11",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function Panel(): ChatPanel
        return (assert(self.panel, "no chat panel"))
    end

    ----------------------------------------------------------------------------
    -- The panel and Blizzard's chat in it
    ----------------------------------------------------------------------------

    function PanelSize(): (number, number)
        local w = UI.Size("chat-w")
        -- the panel (tabs and lines), then the input below it at the same width
        local h = padTop() + TABS_H + chatGap() + self:Get("logHeight") + padBottom() + chatGap() + INPUT_H
        return w, h
    end

    -- The log's rectangle in UIParent units, from the panel (SuuUI's own frame).
    function LogRect(): (number?, number, number, number)
        local p = self:Panel()
        local l, b, w = p:GetLeft(), p:GetBottom(), p:GetWidth()
        if not (l and b) then
            return nil, 0, 0, 0
        end
        local k = p:GetEffectiveScale() / UIParent:GetEffectiveScale()
        local left = (l + padX()) * k
        local right = (l + w - padX()) * k
        local bottom = (b + INPUT_H + chatGap() + padBottom()) * k
        local top = bottom + self:Get("logHeight") * k
        return left, bottom, right, top
    end

    function PlaceChat()
        local cf = ChatFrame1
        if not self.panel then
            return
        end
        if InCombatLockdown() and cf:IsProtected() then
            self.pendingPlace = true
            return
        end
        self.pendingPlace = nil
        local left, bottom, right, top = self:LogRect()
        if not left then
            return
        end
        -- (Blizzard's own SetPoint is hooked by its edit mode: the base one)
        local clear = field(cf, "ClearAllPointsBase") or cf.ClearAllPoints
        local setPoint = field(cf, "SetPointBase") or cf.SetPoint
        self.placing = true
        errors.try(clear, cf)
        errors.try(setPoint, cf, "BOTTOMLEFT", UIParent, "BOTTOMLEFT", left, bottom)
        errors.try(setPoint, cf, "TOPRIGHT", UIParent, "BOTTOMLEFT", right, top)
        self.placing = nil
    end

    -- One window's art away, its font SuuUI's (at Blizzard's size for it), its
    -- edit box on the panel's field.
    function SkinFrame(cf: Window)
        local name = cf:GetName()
        if not name then
            return
        end
        emptyTextures(cf)
        local background = frames.asFrame(field(cf, "Background"))
        if background then
            background:SetAlpha(0)
            emptyTextures(background)
        end
        local buttons = globalFrame(name .. "ButtonFrame")
        alphaOff(buttons)
        emptyTextures(buttons)
        -- Blizzard shows these again with its own fades: the scroll-to-bottom
        -- button hides itself whenever shown; the scrollbar's steppers go to a
        -- hidden frame, its track and thumb invisible
        local sb = frames.asFrame(field(cf, "ScrollToBottomButton"))
        if sb then
            alphaOff(sb)
            sb:Hide()
            if not self.sbHooked[sb] then
                self.sbHooked[sb] = true
                hookScript(sb, "OnShow", function()
                    sb:Hide()
                end)
            end
        end
        local bar = frames.asFrame(field(cf, "ScrollBar"))
        if bar then
            for _, key in ipairs({ "Back", "Forward" }) do
                local step = frames.asFrame(field(bar, key))
                if step then
                    step:SetParent(hidden)
                end
            end
            alphaOff(frames.asRegion(field(bar, "Track")))
            alphaOff(bar)
        end
        alphaOff(globalFrame(name .. "ResizeButton"))
        self:ApplyFont(cf)
        -- inert: its text invisible, no mouse, wheel or links (SuuUI's copy is the
        -- one shown and clicked); chat frames can be protected in combat while a
        -- whisper window exists: then again after combat
        local container = frames.asRegion(field(cf, "FontStringContainer"))
        if container then
            container:SetAlpha(0)
        end
        local ok = pcall(function()
            cf:EnableMouse(false)
            cf:EnableMouseWheel(false)
            cf:SetHyperlinksEnabled(false)
        end)
        if not ok then
            self.pendingSkin = true
        end
        self:Mirror(cf)
        -- the edit box (temporary windows' too: restyled only, never hooked)
        local eb = chat.editBox(cf)
        if eb then
            for _, part in ipairs({ "Left", "Mid", "Right", "FocusLeft", "FocusMid", "FocusRight" }) do
                alphaOff(frames.asRegion(_G[name .. "EditBox" .. part]))
            end
            for _, key in ipairs({ "focusLeft", "focusMid", "focusRight" }) do
                local r = frames.asRegion(field(eb, key))
                if r then
                    r:SetAlpha(0)
                end
            end
            eb:ClearAllPoints()
            -- on the field below the panel, anchored to it: the edit box has
            -- UIParent's scale and the panel SuuUI's, so offsets and a height
            -- in the panel's units would put it lower and taller than the field
            -- (in game at 0.64 against 0.533: 5 below its bottom, the text low)
            local panel = self.panel
            if panel then
                eb:SetPoint("TOPLEFT", panel.field, "TOPLEFT")
                eb:SetPoint("BOTTOMRIGHT", panel.field, "BOTTOMRIGHT")
            else
                eb:SetPoint("TOPLEFT", cf, "BOTTOMLEFT", -padX(), -(padBottom() + chatGap()))
                eb:SetPoint("TOPRIGHT", cf, "BOTTOMRIGHT", padX(), -(padBottom() + chatGap()))
                eb:SetHeight(INPUT_H)
            end
            eb:SetTextInsets(S["space-4"], S["space-4"], 0, 0)
            -- Up and Down recall what you sent (the edit box's own history),
            -- without Alt
            eb:SetAltArrowKeyMode(false)
            self:HistoryFor(eb)
            self:EditBoxFont(eb, fontSize(cf))
        end
    end

    function EditBoxFont(eb: EditBox, size: number)
        eb:SetFont(bodyFont(), size, "")
        for _, key in ipairs({ "header", "headerSuffix" }) do
            local fs = frames.asFontString(field(eb, key))
            if fs then
                fs:SetFont(bodyFont(), size, "")
            end
        end
    end

    -- SuuUI's body face at Blizzard's size for the window (its own setting),
    -- with the design's shadow. Checked again when the windows change
    -- (RefreshWindows): the window's menu changes the size.
    function ApplyFont(cf: Window): boolean
        local size = fontSize(cf)
        local was = self.fontSizes[cf]
        if was == size then
            return false
        end
        self.fontSizes[cf] = size
        cf:SetFont(bodyFont(), size, "")
        cf:SetShadowOffset(1, -1)
        cf:SetShadowColor(0, 0, 0, 0.8)
        local eb = was ~= nil and chat.editBox(cf)
        if eb then
            self:EditBoxFont(eb, size)
        end
        return true
    end

    function SkinAll()
        for _, cf in ipairs(chatFrames()) do
            self:SkinFrame(cf)
        end
        -- Blizzard's tab strip: invisible and out of the mouse's way (SuuUI's own
        -- tabs are the ones used)
        local dock = globalFrame("GeneralDockManager")
        if dock then
            dock:SetAlpha(0)
            for _, cf in ipairs(chat.docked()) do
                local name = cf:GetName()
                local tab = name and globalFrame(name .. "Tab")
                if tab then
                    pcall(tab.EnableMouse, tab, false)
                end
            end
        end
        for _, name in ipairs({
            "QuickJoinToastButton",
            "ChatFrameMenuButton",
            "ChatFrameChannelButton",
            "ChatFrameToggleVoiceDeafenButton",
            "ChatFrameToggleVoiceMuteButton",
        }) do
            alphaOff(globalFrame(name))
        end
    end

    ----------------------------------------------------------------------------
    -- Mirrors: SuuUI's message frame for each Blizzard window
    -- (Units/Chat/Mirrors)
    ----------------------------------------------------------------------------

    function MirrorFrame(): MessageFrame
        return chatMirrors.mirrorFrame(self)
    end

    function FormatLine(text: string, id: number?, old: boolean?, classes: Classes?): string
        return chatMirrors.formatLine(self, text, id, old, classes)
    end

    function CopyLine(id: number?)
        chatMirrors.copyLine(self, id)
    end

    function NewLine(m: Mirror, text: ChatText, r: Color?, g: Color?, b: Color?, at: number?, old: boolean?): Line
        return chatMirrors.newLine(self, m, text, r, g, b, at, old)
    end

    function Put(m: Mirror, text: ChatText, r: Color?, g: Color?, b: Color?, at: number?, old: boolean?): Line
        return chatMirrors.put(self, m, text, r, g, b, at, old)
    end

    function Append(m: Mirror, line: Line)
        chatMirrors.append(self, m, line)
    end

    function ShowTimes(): boolean
        return chatMirrors.showTimes(self)
    end

    function Render(line: Line, withTime: boolean?): ChatText
        return chatMirrors.render(self, line, withTime)
    end

    function Redraw(m: Mirror)
        chatMirrors.redraw(self, m)
    end

    function RedrawShown()
        chatMirrors.redrawShown(self)
    end

    function WatchClasses()
        chatMirrors.watchClasses(self)
    end

    function KeepWhisper(text: ChatText, r: Color?, g: Color?, b: Color?, event: unknown)
        chatMirrors.keepWhisper(self, text, r, g, b, event)
    end

    function WhispersWith(name: string): Whisper[]
        return chatMirrors.whispersWith(self, name)
    end

    function Mirror(cf: Window)
        chatMirrors.mirror(self, cf)
    end

    function ApplyMirrorFont(cf: Window)
        chatMirrors.applyMirrorFont(self, cf)
    end

    ----------------------------------------------------------------------------
    -- History: what you sent, recalled with Up and Down (Units/Chat/Recall)
    ----------------------------------------------------------------------------

    function History(): string[]
        return chatRecall.history(self)
    end

    function AddHistory(line: string)
        chatRecall.addHistory(self, line)
    end

    function Recall(eb: EditBox, step: number)
        chatRecall.recall(self, eb, step)
    end

    function HistoryFor(eb: EditBox)
        chatRecall.historyFor(self, eb)
    end

    function WatchSent()
        chatRecall.watchSent(self)
    end

    ----------------------------------------------------------------------------
    -- Tabs: SuuUI's own buttons, one per Blizzard window, in SuuUI's order
    -- (Units/Chat/TabBar)
    ----------------------------------------------------------------------------

    function Windows(): Window[]
        return chatTabBar.tabWindows(self)
    end

    function TabFor(cf: TabOf): TabButton
        return chatTabBar.tabFor(self, cf)
    end

    function CombatFilterBar(show: boolean)
        chatTabBar.combatFilterBar(self, show)
    end

    function TabMenu(b: TabButton)
        chatTabBar.tabMenu(self, b)
    end

    function Select(cf: TabOf)
        chatTabBar.selectTab(self, cf)
    end

    function UpdateTabs()
        chatTabBar.updateTabs(self)
    end

    function TabInk(b: TabButton, arranging: boolean): string
        return chatTabBar.tabInk(self, b, arranging)
    end

    function OrderedWindows(): Window[]
        return chatTabBar.orderedWindows(self)
    end

    function SaveTabOrder(list: Window[])
        chatTabBar.saveTabOrder(self, list)
    end

    function HasTabOrder(): boolean
        return chatTabBar.hasTabOrder(self)
    end

    function ResetTabOrder()
        chatTabBar.resetTabOrder(self)
    end

    function Arranging(): boolean
        return chatTabBar.isArranging(self)
    end

    function CanDrag(): boolean
        return chatTabBar.canDrag(self)
    end

    function SetTab(b: TabButton, x: number, y: number)
        chatTabBar.setTab(self, b, x, y)
    end

    function PlaceTab(b: TabButton, x: number, glide: boolean?)
        chatTabBar.placeTab(self, b, x, glide)
    end

    function RunSlides()
        chatTabBar.runSlides(self)
    end

    function PressTab(b: TabButton)
        chatTabBar.pressTab(self, b)
    end

    function StopDragger()
        chatTabBar.stopDragger(self)
    end

    function DragStep()
        chatTabBar.dragStep(self)
    end

    function BeginDrag(press: Press)
        chatTabBar.beginDrag(self, press)
    end

    function LayoutDrag(d: Drag, index: number)
        chatTabBar.layoutDrag(self, d, index)
    end

    function MoveDrag(cx: number)
        chatTabBar.moveDrag(self, cx)
    end

    function EndDrag(keep: boolean)
        chatTabBar.endDrag(self, keep)
    end

    function EditModeChanged(on: boolean?)
        chatTabBar.editModeChanged(self, on)
    end

    ----------------------------------------------------------------------------
    -- The windows: closed, sized, named, made (Units/Chat/Windows)
    ----------------------------------------------------------------------------

    function CloseWindow(cf: Window)
        chatWindows.closeWindow(self, cf)
    end

    function SetFontSize(cf: Window, size: number)
        chatWindows.setFontSize(self, cf, size)
    end

    function RenameWindow(cf: Window, name: string)
        chatWindows.renameWindow(self, cf, name)
    end

    function OpenChatSettings(cf: Window)
        chatWindows.openChatSettings(self, cf)
    end

    function NewWindow(name: string)
        chatWindows.newWindow(self, name)
    end

    function OpenedWindow(cf: Window?, name: string?)
        chatWindows.openedWindow(self, cf, name)
    end

    function OpenWhisperWindow(name: string)
        chatWindows.openWhisperWindow(self, name)
    end

    ----------------------------------------------------------------------------
    -- Kept chat (Units/Chat/Kept)
    ----------------------------------------------------------------------------

    function DividerText(m: Mirror, at: number?): string
        return chatKept.dividerText(self, m, at)
    end

    function Draw(m: Mirror, line: Line, withTime: boolean?)
        chatKept.draw(self, m, line, withTime)
    end

    function LoadHistory()
        chatKept.loadHistory(self)
    end

    function RestoreKept(cf: Window, m: Mirror)
        chatKept.restoreKept(self, cf, m)
    end

    function WhisperWindowLines(cf: Window, m: Mirror)
        chatKept.whisperWindowLines(self, cf, m)
    end

    function FillWhispers(m: Mirror, name: string)
        chatKept.fillWhispers(self, m, name)
    end

    function SaveHistory()
        chatKept.saveHistory(self)
    end

    function ClearHistory()
        chatKept.clearHistory(self)
    end

    ----------------------------------------------------------------------------
    -- The Search tab (Units/Chat/SearchPage)
    ----------------------------------------------------------------------------

    function ShowSearch(show: boolean)
        chatSearchPage.showSearch(self, show)
    end

    function KeptLines(): KeptEntry[]
        return chatSearchPage.keptLines(self)
    end

    function FindLines(q: string, scope: string): (Found[], number)
        return chatSearchPage.findLines(self, q, scope)
    end

    function ShowRow(r: SearchRow, e: KeptEntry, q: string, size: number, width: number)
        chatSearchPage.showRow(self, r, e, q, size, width)
    end

    function RunSearch()
        chatSearchPage.runSearch(self)
    end

    ----------------------------------------------------------------------------
    -- Idle: ground, border, tabs and input fade; the lines stay
    ----------------------------------------------------------------------------

    function Wake()
        self.lastActive = GetTime()
    end

    -- The windows looked at again: a new one (a whisper tab) skinned, a font
    -- size changed in a window's menu applied, the tabs laid out (names,
    -- docking, whisper windows opened or closed, unread marks). Run when
    -- something changed them (WindowsChanged), never on a timer.
    function RefreshWindows()
        if not self.panel then
            return
        end
        local windows = chatFrames()
        if #windows ~= self.frameCount then
            self.frameCount = #windows
            self:SkinAll()
        end
        local boxes: EditBox[] = {}
        for _, cf in ipairs(windows) do
            self:WatchWindow(cf)
            if self:ApplyFont(cf) then
                self:ApplyMirrorFont(cf)
            end
            local eb = chat.editBox(cf)
            if eb then
                boxes[#boxes + 1] = eb
            end
        end
        self.boxes = boxes
        self:UpdateTabs()
    end

    -- Something changed the windows: refreshed a frame later, once however
    -- many changes come in that frame.
    function WindowsChanged()
        if self.windowsPending then
            return
        end
        self.windowsPending = true
        self:After(0, function()
            self.windowsPending = nil
            if self:IsEnabled() then
                self:RefreshWindows()
            end
        end)
    end

    -- A window shown or hidden (a whisper window opened or closed): the tabs
    -- again.
    function WatchWindow(cf: Window)
        if self.watchedWindows[cf] then
            return
        end
        self.watchedWindows[cf] = true
        for _, script in ipairs({ "OnShow", "OnHide" }) do
            hookScript(cf, script, function()
                if self:IsEnabled() then
                    self:WindowsChanged()
                end
            end)
        end
    end

    -- Blizzard's own window code (its tab menu: rename, font size, new
    -- window, close, dock and undock, a whisper window): the windows again.
    function HookWindowCode()
        if self.windowCodeHooked then
            return
        end
        self.windowCodeHooked = true
        for _, name in ipairs(WINDOW_CODE) do
            if type(field(_G, name)) == "function" then
                hook(name, function()
                    if self:IsEnabled() then
                        self:WindowsChanged()
                    end
                end)
            end
        end
    end

    -- Whether one of the chat's inputs has the keyboard: Blizzard's edit
    -- boxes (as last refreshed) or the Search tab's field.
    function InputFocused(): boolean
        local search = self.search
        if search ~= nil and search.field.edit:HasFocus() then
            return true
        end
        for _, eb in ipairs(self.boxes) do
            if hasFocus(eb) then
                return true
            end
        end
        return false
    end

    -- The idle fade, checked every TICK: cheap (the mouse over the panel, an
    -- input's focus). The windows and tabs are refreshed by what changes
    -- them (RefreshWindows), not here.
    function Tick()
        local p = self.panel
        if not p then
            return
        end
        local awake = true
        local search = self.search
        if self:Get("fadeIdle") then
            local hovered = p:IsMouseOver() and true or false
            local focused = self:InputFocused()
            if hovered or focused or self.drag or SuuUI.EditMode.IsActive() then
                self:Wake()
            end
            awake = (GetTime() - self.lastActive) < self:Get("idleDelay")
        end
        if awake ~= self.awake then
            self.awake = awake
            self:RedrawShown()
            local a = awake and 1 or 0
            SuuUI.Motion.AlphaTo(p.deco, a, awake and 0.2 or 1.2)
            SuuUI.Motion.AlphaTo(p.tabs, a, awake and 0.2 or 1.2)
            -- the Search tab's field and chips go with the tabs; its lines stay
            if search then
                SuuUI.Motion.AlphaTo(search.head, a, awake and 0.2 or 1.2)
            end
            -- Blizzard's edit boxes: hidden while idle and unfocused
            for _, eb in ipairs(self.boxes) do
                if not hasFocus(eb) then
                    eb:SetAlpha(a)
                end
            end
        end
    end

    ----------------------------------------------------------------------------
    -- The Global tab (Units/Chat/GlobalTab)
    ----------------------------------------------------------------------------

    function ApplyGlobalTab()
        chatGlobalTab.applyGlobalTab(self)
    end

    ----------------------------------------------------------------------------
    -- Lifecycle
    ----------------------------------------------------------------------------

    -- A theme or colour vision changed. The lines carry its colours as codes
    -- (the time, names in class colour, class diamonds, the "Earlier"
    -- divider, earlier lines dimmed): each mirror's kept lines formatted again
    -- from Blizzard's text, with the classes they were shown with, and drawn
    -- again (the shown one now, the others when chosen); the same lines, in
    -- the same order. The tabs' names and the search's chips fitted to the
    -- faces.
    function ApplyTheme()
        -- the lines' face again (the theme's body style), at each window's
        -- own size: its lines, SuuUI's copy of them and its edit box
        local skinned = self.fontSizes
        self.fontSizes = {}
        for cf in pairs(skinned) do
            self:ApplyFont(cf)
            self:ApplyMirrorFont(cf)
            local eb = chat.editBox(cf)
            if eb then
                self:EditBoxFont(eb, fontSize(cf))
            end
        end
        for _, m in pairs(self.mirrors) do
            if not m.raw then
                for _, line in ipairs(m.lines) do
                    local src = line.src
                    if src then
                        line.text = self:FormatLine(src, line.id, line.old, line.classes)
                    end
                end
                m.drawnWithTime = nil
            end
        end
        for _, w in ipairs(self.whispers) do
            local shown = w.shown
            if shown then
                shown.text = self:FormatLine(w.text, nil, w.old, shown.classes)
            end
        end
        self:RedrawShown()
        local p = self.panel
        if p then
            for _, b in ipairs(p.tabButtons) do
                tabFace(b.label)
            end
            -- a theme's spacing: the panel's padding and gaps, its size, and
            -- Blizzard's chat in it (after combat where it is protected)
            p:Place()
            self:Layout()
        end
        local s = self.search
        if s then
            s:PlaceChips()
        end
        self:RunSearch()
    end

    function Layout()
        local w, h = self:PanelSize()
        self:Panel():SetSize(w, h)
        self:After(0, function()
            self:PlaceChat()
        end)
    end

    -- Skinned and placed a frame later (never while the chat code is
    -- mid-update).
    function SkinSoon()
        self:After(0, function()
            self:SkinAll()
            self:PlaceChat()
            self:RefreshWindows()
        end)
    end

    override function OnEnable()
        -- Blizzard's combat log loads when its tab is first shown, which never
        -- happens now: loaded here (its lines and its filter bar)
        if not C_AddOns.IsAddOnLoaded("Blizzard_CombatLog") then
            pcall(C_AddOns.LoadAddOn, "Blizzard_CombatLog")
        end
        local p = self.panel or ChatPanel.new()
        self.panel = p
        p:Show()
        -- the kept chat, before the first window's mirror is made
        self:LoadHistory()
        self:Layout()
        self:RegisterMover(p, { key = "position", label = "Chat", managedShow = true })
        -- the lines' box (tabs and lines, without the input): the command
        -- palette opens over it
        SuuUI.PublishAnchor("chat", p.box, self)
        self:RegisterSettings(SECTION)
        self:Wake()
        self:SkinSoon()
        -- Blizzard places ChatFrame1 again (Edit Mode, layout passes): ours again
        if field(ChatFrame1, "ApplySystemAnchor") and not self.anchorHooked then
            self.anchorHooked = true
            hook(ChatFrame1, "ApplySystemAnchor", function()
                if self.placing or not self:IsEnabled() then
                    return
                end
                self:After(0, function()
                    self:PlaceChat()
                end)
            end)
        end
        -- the windows and tabs refreshed when Blizzard's code changes them
        self:HookWindowCode()
        -- new windows (whispers, a new tab): skinned a frame later
        for _, e in ipairs(WINDOW_EVENTS) do
            self:OnGameEvent(e, function()
                self:SkinSoon()
            end)
        end
        for _, e in ipairs(WAKE) do
            self:OnGameEvent(e, function()
                self:Wake()
            end)
        end
        -- a whisper opens a temporary window: skinned a frame later
        for _, e in ipairs(WHISPER_EVENTS) do
            self:OnGameEvent(e, function()
                self:After(0, function()
                    self:SkinAll()
                    self:RefreshWindows()
                end)
            end)
        end
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if self.pendingPlace then
                self:PlaceChat()
            end
            if self.pendingSkin then
                self.pendingSkin = nil
                self:SkinAll()
                self:WindowsChanged()
            end
            self:ApplyGlobalTab()
        end)
        -- the channels settle a moment after login; joins and leaves later
        self:After(3, function()
            self:ApplyGlobalTab()
        end)
        for _, e in ipairs(CHANNEL_EVENTS) do
            self:OnGameEvent(e, function()
                self:After(0.5, function()
                    self:ApplyGlobalTab()
                end)
            end)
        end
        self:WatchSent()
        self:WatchClasses()
        -- kept chat saved as the game logs out or reloads
        self:OnGameEvent("PLAYER_LOGOUT", function()
            self:SaveHistory()
        end)
        self:Watch("keepHistory", function()
            if not self:Get("keepHistory") then
                self:CharData().kept = nil
            end
        end)
        self:Watch("timestamps", function()
            for _, m in pairs(self.mirrors) do
                m.drawnWithTime = nil
            end
            self:RedrawShown()
        end)
        self:Watch("globalTab", function()
            self:ApplyGlobalTab()
        end)
        self:Watch("position", function()
            self:After(0, function()
                self:PlaceChat()
            end)
        end)
        self:Watch("logHeight", function()
            self:Layout()
        end)
        self:Watch("fadeIdle", function()
            self:Wake()
        end)
        self:Watch("tabReorder", function()
            if self.drag or self.press then
                self:EndDrag(false)
            end
        end)
        self:On("SUUUI_EDITMODE_CHANGED", function(_, on)
            self:EditModeChanged(on)
        end)
        self:On("SUUUI_ROOT_SCALED", function()
            self:After(0, function()
                self:PlaceChat()
            end)
        end)
        self:On("SUUUI_THEME_CHANGED", function()
            self:ApplyTheme()
        end)
        if not self.driver then
            local driver = CreateFrame("Frame")
            self.driver = driver
            local wait = 0
            driver:SetScript("OnUpdate", function(_, elapsed: number)
                wait = wait - elapsed
                if wait > 0 then
                    return
                end
                wait = TICK
                if self:IsEnabled() then
                    self:Tick()
                end
            end)
        end
        assert(self.driver):Show()
    end

    -- Only after a failed OnEnable (reloadToToggle; X-11.a7): the panel and
    -- the driver away. The anchor "chat" goes with the release, and so do
    -- the timers that would have moved Blizzard's chat into the panel.
    override function OnDisable()
        local p = self.panel
        if p then
            p:Hide()
        end
        local driver = self.driver
        if driver then
            driver:Hide()
        end
    end
end

M = SuuUI.AddModule(ChatModule.new())