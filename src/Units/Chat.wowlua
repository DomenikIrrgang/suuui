            { key = "logHeight", label = "Height", control = "slider", min = 100, max = 400, step = 10, unit = "px", combat = true,
              description = "The lines' area; the panel adds the tabs and the input." },
            { key = "fadeIdle", label = "Fade when idle", control = "toggle",
              description = "Ground, border, tabs and input fade; the lines stay. Back on the mouse, a new message or typing." },
            { key = "idleDelay", label = "Idle after", control = "slider", min = 5, max = 60, step = 1, unit = "s", disabled = idleOff },
            { key = "globalTab", label = "Global channels in their own tab", control = "toggle",
              description = "General, Trade, LocalDefense and the rest in a Global tab (your Guild tab renamed, or a new one); the General tab keeps everything else. Channels you join later go there too. Off: SuuUI leaves your tabs as they are." },
        } },
        { title = "Windows", description = "Each tab's window: its name, font size and Blizzard's settings for what it shows. A right click on a tab opens Blizzard's settings for it; whisper windows close with a right click on their tab.", rows = {
            { label = "Windows", control = "custom", build = function(p: Frame): Frame return WindowsEditor.new(p) end, stacked = true },
            { key = "tabReorder", label = "Reorder tabs", control = "segmented",
              options = { { value = "drag", label = "Drag anytime" }, { value = "edit", label = "In edit mode" } },
              description = "Drag a tab along the tab row to give it a new place (Search stays last); Esc or letting go away from the row puts it back. In edit mode: only while SuuUI's edit mode is open, where the tabs show grips. Edit mode arranges them with either." },
            { label = "Tab order", control = "button", text = "Reset",
              description = function(): string
                  return "Reset puts General and Global first, your other windows after them, whispers last. "
                      .. (M:HasTabOrder() and "Kept for this character · changed." or "Kept for this character.")
              end,
              disabled = function(): (boolean, string?)
                  if not M:HasTabOrder() then return true, "The tabs are in their starting order." end
                  return false
              end,
              onClick = function() M:ResetTabOrder() end },
        } },
        { title = "Lines", rows = {
            { key = "timestamps", label = "Timestamps", control = "toggle",
              description = "The time before each line while you're using the chat; gone when it fades. Blizzard's own (Options › Social) is left out then." },
            { key = "classNames", label = "Names in class colour", control = "toggle",
              description = "Players' names in chat in their class colour." },
            { key = "classDiamonds", label = "Class diamonds", control = "toggle",
              description = "A diamond in the class colour before each name. Names take the line's colour." },
            { key = "shortChannels", label = "Short channel names", control = "toggle",
              description = "\"2. Trade\" rather than \"[2. Trade - City]\"; tags without brackets." },
        } },
        { title = "Kept chat", description = "What the tabs held when you logged out comes back on login, dimmed above an \"Earlier\" divider; whispers are kept per player, so a whisper window opens with your earlier conversation. The Search tab looks through all of it.", rows = {
            { key = "keepHistory", label = "Keep chat across logouts", control = "toggle",
              description = "Saved for this character: the last 100 lines of each tab and the last 200 whispers, with their time. The Combat Log isn't kept, nor lines the game hides during a boss fight. Off: nothing is saved from now on." },
            { label = "Kept chat", control = "button", text = "Clear kept chat",
              description = "Forgets every kept line and whisper and empties the tabs (the Combat Log stays).",
              onClick = function()
                  UI.Confirm({ title = "Clear kept chat?", confirm = "Clear",
                      text = "Every kept line and whisper is forgotten and the chat tabs are emptied. This can't be undone.",
                      onConfirm = function() M:ClearHistory() end })
              end },
        } },
        { title = "Input", rows = {
            { key = "recall", label = "Up and Down recall", control = "toggle",
              description = "Up and Down bring back what you sent (messages and commands, per character). SuuUI types the line in, so the game then treats the input as SuuUI's until you /reload: commands it protects typed in chat (/camp, /logout, /target, /focus) may be refused, and so may chat in a boss fight. Turn it off for dungeons and raids if that bites." },
        } },
    },
}


--------------------------------------------------------------------------------
-- Lines in the design's form: the time (ink-muted, only while the chat is
-- in use), the tag without brackets ("Party", "2. Trade", "From", "Yell"),
-- the class diamond before a name, the name in the line's colour. Taken
-- from Blizzard's finished line (its links stay as they are); a secret line
-- goes in whole. The combat log's lines are left as Blizzard writes them.
--------------------------------------------------------------------------------

local MAX_LINES = 500
local DIAMOND = chatLines.DIAMOND
local classByName: { [string]: string } = {}

-- what follows the author in Blizzard's line → the tag the design puts first
-- ("" for none)
local VERBS: chatLines.Verb[]? = nil
local function verbs(): chatLines.Verb[]
    if VERBS then return VERBS end
    local list: chatLines.Verb[] = {}
    VERBS = list
    local function add(fmt: unknown, tag: string) local v = chatLines.verb(fmt, tag); if v then list[#list + 1] = v end end
    add(field(_G, "CHAT_SAY_GET"), "")
    add(field(_G, "CHAT_YELL_GET"), asString(field(_G, "CHAT_MSG_YELL")) or "Yell")
    add(field(_G, "CHAT_WHISPER_GET"), "From")
    add(field(_G, "CHAT_BN_WHISPER_GET"), "From")
    return list
end

-- A player's class from their GUID, when readable.
local function classOfGUID(guid: string): string?
    local _, class = errors.try(GetPlayerInfoByGUID, guid)
    return asString(class)
end

local function classOf(name: string?, lineID: string?): string?
    local id = lineID and tonumber(lineID)
    local guid = id and asString(errors.try(field(C_ChatInfo, "GetChatLineSenderGUID"), id))
    local fromGUID = guid and classOfGUID(guid)
    if fromGUID then return fromGUID end
    local key = name and name:lower()
    local known = key and classByName[key]
    if known then return known end
    local base = key and key:match("^([^%-]+)")
    local fromBase = base and base ~= key and classByName[base]
    if fromBase then return fromBase end
    local _, class = errors.try(UnitClass, name)
    return asString(class)
end

-- Blizzard's own timestamp (its option in Social) as a pattern for the
-- start of a line: its date format with the numbers as wildcards.
local function blizzardStamp(): string?
    return chatLines.stampPatternOf(errors.try(GetCVar, "showTimestamps"))
end

-- Lines by their ID, for the diamond's copy (gone with their mirror's
-- oldest lines)
local lineSeq = 0
local linesByID: { [number]: Line } = tbl.weakValues()

local plainLine = chatLines.plainLine

-- Whisper lines (to and from), kept for a whisper window opened later (and,
-- with Kept chat, across logouts).
local WHISPER_KEEP = 300
local isWhisperLine = chatLines.isWhisperLine

-- What the input holds as a line to keep (Units/Chat/Input reads it).
local function typedLine(eb: EditBox): string?
    return chatInput.typedLine(eb:GetText(), function(key: string): unknown return eb:GetAttribute(key) end)
end

local function chatLockdown(): boolean
    return errors.try(field(C_ChatInfo, "InChatMessagingLockdown")) == true
end

-- The combat log's filter bar (Blizzard's: My actions, What happened to me?
-- …), shown at the top of the lines while the Combat Log tab is.
local FILTER_H = 24

-- Tab order (asked 2026-10-19; design board "Chat tabs · drag to reorder",
-- B and C, the user's pick): every tab but Search can be dragged along the
-- row (Search stays last). After 6 px the tab lifts onto a gilt-edged plate
-- and moves with the pointer, and the tabs it passes slide aside, so the
-- row always shows the order you'll get (B). Setting "Reorder tabs": by
-- dragging anytime (B), or only in SuuUI's edit mode, where the tabs get
-- dashed outlines and grips and any press-and-move drags (C; also there
-- with B). Esc, a right click or letting go away from the row puts the tab
-- back. The order is kept per character by window ID; a whisper tab by its
-- player, only while it's open (a new one comes in before Search).
local DRAG_START = 6      -- px along the row before a press becomes a drag
local LIFT = 4            -- the dragged tab rides this far up on its plate
local SLIDE = T.duration["dur-fast"]
local smooth = chatTabs.smooth

-- The pointer's x along the row, in the row's units.
local function cursorX(row: Frame): number
    local x = GetCursorPosition()
    return x / row:GetEffectiveScale() - (row:GetLeft() or 0)
end

-- Kept chat: each tab's last lines and the whispers, saved for the
-- character at logout (and on a reload) and shown again on login: dimmed
-- (opacity-ooc) above a divider "Earlier · logged out 2 h ago" (design:
-- Chat history and search, option B). Only readable lines are kept: never a
-- secret one (an encounter's chat lockdown), never one with a Battle.net
-- name (its |K code means nothing next session), never the Combat Log's.
local KEEP_LINES, KEEP_WHISPERS = 100, 200
local DIM = T.opacity["opacity-ooc"]
local hexRGB, keptLine, ago, rule = chatLines.hexRGB, chatLines.keptLine, chatLines.ago, chatLines.rule
local function dimmed(text: string): string return chatLines.dimmed(text, DIM) end

-- The search's limits.
local GROUP_SHOWN = 2 -- a player's lines shown before "N more"
local MAX_ROWS = 200
local KIND_LABEL = chatSearch.KIND_LABEL
local snippet = chatSearch.snippet
-- Where the match sits in a line (Units/Chat/Search), measured in the
-- lines' font at `size`.
local function matchSpan(text: string, q: string, size: number): (number?, number?, string?, number[]?, (number?)[]?, number?)
    return chatSearch.matchSpan(text, q, function(part: string): number return measureBody(part, size) end)
end

local function isMe(key: string): boolean
    local me = asString(SuuUI.FullName("player"))
    local name = asString(UnitName("player"))
    return (me ~= nil and me:lower() == key) or (name ~= nil and name:lower() == key)
end

local function editBoxes(): EditBox[]
    local out: EditBox[] = {}
    for _, cf in ipairs(chatFrames()) do
        local eb = chat.editBox(cf)
        if eb then out[#out + 1] = eb end
    end
    return out
end

local function hasFocus(eb: EditBox): boolean
    return errors.try(eb.HasFocus, eb) == true
end

local function editBoxFocused(): boolean
    for _, eb in ipairs(editBoxes()) do
        if hasFocus(eb) then return true end
    end
    return false
end

-- Global channels in their own tab (Blizzard's own chat settings, as its
-- tab menu sets them): General keeps everything but the numbered channels;
-- a "Global" tab (a "Guild" tab renamed, else a new one) shows only those.
-- Channels joined later move there too. Out of combat only.

-- The channels a window is set to show (joined or not: GetChatWindowChannels
-- lists name, id pairs).
local function windowChannels(id: number): string[]
    local out: string[] = {}
    local list = { GetChatWindowChannels(id) }
    for i = 1, #list, 2 do
        local name = asString(list[i])
        if name then out[#out + 1] = name end
    end
    return out
end

-- the numbered channels you're in, by name
local function joinedChannels(): string[]
    local out: string[] = {}
    local list = { GetChannelList() }
    for i = 1, #list, 3 do
        local name = asString(list[i + 1])
        if name then out[#out + 1] = name end
    end
    return out
end

-- the window with one of these names (any case), or nil
local function windowNamed(...: string): Window?
    local wanted: { [string]: boolean } = {}
    for _, n in ipairs({ ... }) do wanted[n:lower()] = true end
    for i = 1, asNumber(field(_G, "NUM_CHAT_WINDOWS")) or 10 do
        local name = asString((GetChatWindowInfo(i)))
        if name and wanted[name:lower()] then return chat.window("ChatFrame" .. i) end
    end
    return nil
end

-- A channel call on a window (AddChannel, RemoveChannel …), quietly.
local function channelCall(cf: Window, method: string, ...: unknown)
    errors.tryMethod(cf, method, ...)
end

-- chat messages that wake the panel: to you and your group (public chat,
-- Trade, say and yell, would keep it awake for good)
local WAKE: EventName[] = { "CHAT_MSG_PARTY", "CHAT_MSG_PARTY_LEADER", "CHAT_MSG_RAID", "CHAT_MSG_RAID_LEADER",
    "CHAT_MSG_RAID_WARNING", "CHAT_MSG_GUILD", "CHAT_MSG_OFFICER", "CHAT_MSG_WHISPER", "CHAT_MSG_WHISPER_INFORM",
    "CHAT_MSG_BN_WHISPER", "CHAT_MSG_BN_WHISPER_INFORM", "CHAT_MSG_INSTANCE_CHAT", "CHAT_MSG_INSTANCE_CHAT_LEADER" }
-- the chat events that tell a sender's class
local CLASS_EVENTS: EventName[] = { "CHAT_MSG_SAY", "CHAT_MSG_YELL", "CHAT_MSG_EMOTE", "CHAT_MSG_PARTY", "CHAT_MSG_PARTY_LEADER",
    "CHAT_MSG_RAID", "CHAT_MSG_RAID_LEADER", "CHAT_MSG_RAID_WARNING", "CHAT_MSG_INSTANCE_CHAT",
    "CHAT_MSG_INSTANCE_CHAT_LEADER", "CHAT_MSG_GUILD", "CHAT_MSG_OFFICER", "CHAT_MSG_WHISPER",
    "CHAT_MSG_WHISPER_INFORM", "CHAT_MSG_CHANNEL" }
-- what makes a new window to skin
local WINDOW_EVENTS: EventName[] = { "UPDATE_CHAT_WINDOWS", "UPDATE_FLOATING_CHAT_WINDOWS", "PLAYER_ENTERING_WORLD",
    "UI_SCALE_CHANGED" }
-- a whisper opens a temporary window
local WHISPER_EVENTS: EventName[] = { "CHAT_MSG_WHISPER", "CHAT_MSG_WHISPER_INFORM", "CHAT_MSG_BN_WHISPER",
    "CHAT_MSG_BN_WHISPER_INFORM" }
-- the channels' changes
local CHANNEL_EVENTS: EventName[] = { "CHANNEL_UI_UPDATE", "CHAT_MSG_CHANNEL_NOTICE" }

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

class ChatModule extends Module<typeof(DEFAULTS)>
    panel: ChatPanel? = nil
    -- SuuUI's message frame per window, the one shown, the tab chosen
    mirrors: { [Window]: Mirror } = {}
    activeMirror: Mirror? = nil
    selected: TabOf? = nil
    unread: { [Window]: boolean } = {}
    whispers: Whisper[] = {}
    search: SearchPage? = nil
    windowsEditor: WindowsEditor? = nil
    -- the input's history: the recall under way, Enter seen, boxes hooked
    recall: Recall? = nil
    keyCapture: boolean? = nil
    historyBoxes: { [EditBox]: boolean } = {}
    -- Blizzard's art and fonts dealt with
    sbHooked: { [Frame]: boolean } = {}
    fontSizes: { [Window]: number } = {}
    -- ChatFrame1's place: waiting for the end of combat, being set
    pendingPlace: boolean? = nil
    pendingSkin: boolean? = nil
    placing: boolean? = nil
    -- the tabs: a press, a drag, a glide on the next layout
    press: Press? = nil
    drag: Drag? = nil
    glideOnce: boolean? = nil
    -- the idle fade
    awake: boolean? = nil
    lastActive: number = 0
    frameCount: number = 0
    -- kept chat
    historyLoaded: boolean? = nil
    loggedOutAt: number? = nil
    keptWindows: { [number]: unknown }? = nil
    warnedGlobal: boolean? = nil
    anchorHooked: boolean? = nil
    driver: Frame? = nil

    constructor()
        super({
            id = "chat",
            name = "Chat",
            description = "Blizzard's chat in SuuUI's look: a glass panel, SuuUI tabs and input, fading while idle.",
            api = "0.11",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function Panel(): ChatPanel
        return (assert(self.panel, "no chat panel"))
    end

    ----------------------------------------------------------------------------
    -- The panel and Blizzard's chat in it
    ----------------------------------------------------------------------------

    function PanelSize(): (number, number)
        local w = UI.Size("chat-w")
        -- the panel (tabs and lines), then the input below it at the same width
        local h = PAD_TOP + TABS_H + GAP + self:Get("logHeight") + PAD_BOTTOM + GAP + INPUT_H
        return w, h
    end

    -- The log's rectangle in UIParent units, from the panel (SuuUI's own frame).
    function LogRect(): (number?, number, number, number)
        local p = self:Panel()
        local l, b, w = p:GetLeft(), p:GetBottom(), p:GetWidth()
        if not (l and b) then return nil, 0, 0, 0 end
        local k = p:GetEffectiveScale() / UIParent:GetEffectiveScale()
        local left = (l + PAD_X) * k
        local right = (l + w - PAD_X) * k
        local bottom = (b + INPUT_H + GAP + PAD_BOTTOM) * k
        local top = bottom + self:Get("logHeight") * k
        return left, bottom, right, top
    end

    function PlaceChat()
        local cf = ChatFrame1
        if not self.panel then return end
        if InCombatLockdown() and cf:IsProtected() then self.pendingPlace = true return end
        self.pendingPlace = nil
        local left, bottom, right, top = self:LogRect()
        if not left then return end
        -- (Blizzard's own SetPoint is hooked by its edit mode: the base one)
        local clear = field(cf, "ClearAllPointsBase") or cf.ClearAllPoints
        local setPoint = field(cf, "SetPointBase") or cf.SetPoint
        self.placing = true
        errors.try(clear, cf)
        errors.try(setPoint, cf, "BOTTOMLEFT", UIParent, "BOTTOMLEFT", left, bottom)
        errors.try(setPoint, cf, "TOPRIGHT", UIParent, "BOTTOMLEFT", right, top)
        self.placing = nil
    end

    -- One window's art away, its font SuuUI's (at Blizzard's size for it), its
    -- edit box on the panel's field.
    function SkinFrame(cf: Window)
        local name = cf:GetName()
        if not name then return end
        emptyTextures(cf)
        local background = frames.asFrame(field(cf, "Background"))
        if background then
            background:SetAlpha(0)
            emptyTextures(background)
        end
        local buttons = globalFrame(name .. "ButtonFrame")
        alphaOff(buttons)
        emptyTextures(buttons)
        -- Blizzard shows these again with its own fades: the scroll-to-bottom
        -- button hides itself whenever shown; the scrollbar's steppers go to a
        -- hidden frame, its track and thumb invisible
        local sb = frames.asFrame(field(cf, "ScrollToBottomButton"))
        if sb then
            alphaOff(sb)
            sb:Hide()
            if not self.sbHooked[sb] then
                self.sbHooked[sb] = true
                hookScript(sb, "OnShow", function() sb:Hide() end)
            end
        end
        local bar = frames.asFrame(field(cf, "ScrollBar"))
        if bar then
            for _, key in ipairs({ "Back", "Forward" }) do
                local step = frames.asFrame(field(bar, key))
                if step then step:SetParent(hidden) end
            end
            alphaOff(frames.asRegion(field(bar, "Track")))
            alphaOff(bar)
        end
        alphaOff(globalFrame(name .. "ResizeButton"))
        self:ApplyFont(cf)
        -- inert: its text invisible, no mouse, wheel or links (SuuUI's copy is the
        -- one shown and clicked); chat frames can be protected in combat while a
        -- whisper window exists: then again after combat
        local container = frames.asRegion(field(cf, "FontStringContainer"))
        if container then container:SetAlpha(0) end
        local ok = pcall(function()
            cf:EnableMouse(false)
            cf:EnableMouseWheel(false)
            cf:SetHyperlinksEnabled(false)
        end)
        if not ok then self.pendingSkin = true end
        self:Mirror(cf)
        -- the edit box (temporary windows' too: restyled only, never hooked)
        local eb = chat.editBox(cf)
        if eb then
            for _, part in ipairs({ "Left", "Mid", "Right", "FocusLeft", "FocusMid", "FocusRight" }) do
                alphaOff(frames.asRegion(_G[name .. "EditBox" .. part]))
            end
            for _, key in ipairs({ "focusLeft", "focusMid", "focusRight" }) do
                local r = frames.asRegion(field(eb, key))
                if r then r:SetAlpha(0) end
            end
            eb:ClearAllPoints()
            -- on the field below the panel: out by the panel's padding, down by
            -- its bottom padding and the gap
            eb:SetPoint("TOPLEFT", cf, "BOTTOMLEFT", -PAD_X, -(PAD_BOTTOM + GAP))
            eb:SetPoint("TOPRIGHT", cf, "BOTTOMRIGHT", PAD_X, -(PAD_BOTTOM + GAP))
            eb:SetHeight(INPUT_H)
            eb:SetTextInsets(S["space-4"], S["space-4"], 0, 0)
            -- Up and Down recall what you sent (the edit box's own history),
            -- without Alt
            eb:SetAltArrowKeyMode(false)
            self:HistoryFor(eb)
            self:EditBoxFont(eb, fontSize(cf))
        end
    end

    function EditBoxFont(eb: EditBox, size: number)
        eb:SetFont(BODY_FONT, size, "")
        for _, key in ipairs({ "header", "headerSuffix" }) do
            local fs = frames.asFontString(field(eb, key))
            if fs then fs:SetFont(BODY_FONT, size, "") end
        end
    end

    -- SuuUI's body face at Blizzard's size for the window (its own setting),
    -- with the design's shadow. Checked again on each tick: the window's menu
    -- changes the size.
    function ApplyFont(cf: Window): boolean
        local size = fontSize(cf)
        local was = self.fontSizes[cf]
        if was == size then return false end
        self.fontSizes[cf] = size
        cf:SetFont(BODY_FONT, size, "")
        cf:SetShadowOffset(1, -1)
        cf:SetShadowColor(0, 0, 0, 0.8)
        local eb = was ~= nil and chat.editBox(cf)
        if eb then self:EditBoxFont(eb, size) end
        return true
    end

    function SkinAll()
        for _, cf in ipairs(chatFrames()) do self:SkinFrame(cf) end
        -- Blizzard's tab strip: invisible and out of the mouse's way (SuuUI's own
        -- tabs are the ones used)
        local dock = globalFrame("GeneralDockManager")
        if dock then
            dock:SetAlpha(0)
            for _, cf in ipairs(chat.docked()) do
                local name = cf:GetName()
                local tab = name and globalFrame(name .. "Tab")
                if tab then pcall(tab.EnableMouse, tab, false) end
            end
        end
        for _, name in ipairs({ "QuickJoinToastButton", "ChatFrameMenuButton", "ChatFrameChannelButton",
                                "ChatFrameToggleVoiceDeafenButton", "ChatFrameToggleVoiceMuteButton" }) do
            alphaOff(globalFrame(name))
        end
    end

    ----------------------------------------------------------------------------
    -- Mirrors: SuuUI's message frame for each Blizzard window
    ----------------------------------------------------------------------------

    function MirrorFrame(): MessageFrame
        local m = CreateFrame("ScrollingMessageFrame", nil, self:Panel().log)
        m:SetAllPoints()
        m:SetJustifyH("LEFT")
        m:SetFading(false)
        m:SetMaxLines(MAX_LINES)
        m:SetIndentedWordWrap(true)
        m:EnableMouseWheel(true)
        m:SetScript("OnMouseWheel", function(_, delta: number)
            if IsShiftKeyDown() then
                if delta > 0 then m:ScrollToTop() else m:ScrollToBottom() end
            elseif delta > 0 then m:ScrollUp() else m:ScrollDown() end
        end)
        links(m)
        m:Hide()
        return m
    end

    -- Blizzard's finished line → the design's (without the time). `old`: a
    -- line kept from an earlier session (its line ids mean nothing now).
    -- `classes`: the names' classes in the order they come, filled the first
    -- time and read when the line is formatted again (a theme's new colours),
    -- so a name keeps the class it was shown with. (Units/Chat/Lines does the
    -- text; this gives it the settings and the world's answers.)
    function FormatLine(text: string, id: number?, old: boolean?, classes: Classes?): string
        return chatLines.formatLine(text, id, old, classes, {
            diamonds = self:Get("classDiamonds"), short = self:Get("shortChannels"), colored = self:Get("classNames"),
            -- SuuUI shows the time: Blizzard's own goes
            stamp = self:Get("timestamps") and blizzardStamp() or nil,
            verbs = verbs(), classOf = classOf,
        })
    end

    function CopyLine(id: number?)
        local line = id and linesByID[id]
        if not line then return end
        askText("Copy line", plainLine(asString(self:Render(line, true)) or ""), "Ctrl+C to copy · Esc closes")
    end

    -- A line for a mirror: Blizzard's text (`src`, readable lines only) and
    -- the design's. `at` and `old` for a line kept from an earlier session.
    function NewLine(m: Mirror, text: ChatText, r: Color?, g: Color?, b: Color?, at: number?, old: boolean?): Line
        lineSeq = lineSeq + 1
        local readable = asString(text)
        if m.raw or not readable then
            return { text = text, raw = true, r = r, g = g, b = b, at = at or time(), id = lineSeq, old = old }
        end
        local classes: Classes = {}
        local line: Line = { src = readable, classes = classes, text = self:FormatLine(readable, lineSeq, old, classes),
                             r = r, g = g, b = b, at = at or time(), id = lineSeq, old = old }
        linesByID[lineSeq] = line
        return line
    end

    -- One line into a mirror: kept (to show again with or without the time)
    -- and shown as the chat is now.
    function Put(m: Mirror, text: ChatText, r: Color?, g: Color?, b: Color?, at: number?, old: boolean?): Line
        local line = self:NewLine(m, text, r, g, b, at, old)
        self:Append(m, line)
        return line
    end

    function Append(m: Mirror, line: Line)
        local lines = m.lines
        lines[#lines + 1] = line
        if #lines > MAX_LINES then table.remove(lines, 1) end
        local withTime = self:ShowTimes()
        -- drawn otherwise than its earlier lines: all again when it's next shown
        if m.drawnWithTime ~= withTime then m.drawnWithTime = nil end
        self:Draw(m, line, withTime)
    end

    function ShowTimes(): boolean
        return self:Get("timestamps") and self.awake ~= false
    end

    function Render(line: Line, withTime: boolean?): ChatText
        local text = line.text
        if line.raw or not withTime then return text end
        return "|cff" .. T.color["ink-muted"].hex .. date("%H:%M", line.at) .. "|r  " .. (asString(text) or "")
    end

    -- The mirror's lines again (the time came or went), where it was scrolled.
    function Redraw(m: Mirror)
        local withTime = self:ShowTimes()
        if m.raw or m.drawnWithTime == withTime then return end
        m.drawnWithTime = withTime
        local f = m.frame
        local offset = f:GetScrollOffset()
        f:Clear()
        for _, line in ipairs(m.lines) do self:Draw(m, line, withTime) end
        if offset > 0 then pcall(f.SetScrollOffset, f, offset) end
    end

    -- The shown window now, the others when they're chosen.
    function RedrawShown()
        local m = self.activeMirror
        if m then self:Redraw(m) end
    end

    -- Names' classes from the chat events (a line whose sender the client
    -- can't tell from its line id).
    function WatchClasses()
        for _, e in ipairs(CLASS_EVENTS) do
            self:OnGameEvent(e, function(_, ...: unknown)
                local sender, guid = asString((select(2, ...))), asString((select(12, ...)))
                local class = sender and guid and classOfGUID(guid)
                if sender and class then classByName[sender:lower()] = class end
            end)
        end
    end

    function KeepWhisper(text: ChatText, r: Color?, g: Color?, b: Color?, event: unknown)
        local line = asString(text)
        if not line or not isWhisperLine(r, g, b, event) then return end
        local who = line:match("|Hplayer:([^:|]+)")
        if not who then return end
        local list = self.whispers
        -- the same line in a second window (General and the whisper window)
        for i = #list, math.max(1, #list - 4), -1 do
            if list[i].text == line then return end
        end
        list[#list + 1] = { who = who:lower(), text = line, r = r, g = g, b = b, at = time() }
        if #list > WHISPER_KEEP then table.remove(list, 1) end
    end

    -- The kept lines with a player: "Name" matches "Name-Realm" too.
    function WhispersWith(name: string): Whisper[]
        local out: Whisper[] = {}
        local want = name:lower()
        local base = want:match("^([^%-]+)")
        for _, line in ipairs(self.whispers) do
            local who = line.who
            if who == want or who:match("^([^%-]+)") == base then out[#out + 1] = line end
        end
        return out
    end

    -- Every line Blizzard adds to the window, copied (a secret one whole), and
    -- what it already holds.
    function Mirror(cf: Window)
        local made = self.mirrors[cf]
        if made then
            -- a whisper window Blizzard reused for someone else
            self:WhisperWindowLines(cf, made)
            return
        end
        local m: Mirror = { frame = self:MirrorFrame(), lines = {}, raw = cf == ChatFrame2 }
        self.mirrors[cf] = m
        self:ApplyMirrorFont(cf)
        -- what the tab held at logout, above a divider
        local temporary = chat.isTemporary(cf)
        if not m.raw and not temporary then self:RestoreKept(cf, m) end
        for i = 1, cf:GetNumMessages() do
            local ok, text, r, g, b = pcall(cf.GetMessageInfo, cf, i)
            if ok and (isSecret(text) or text ~= nil) then
                self:Put(m, text, r, g, b)
                if cf == ChatFrame1 or temporary then self:KeepWhisper(text, r, g, b) end
            end
        end
        -- a whisper window: the kept whispers with that player before its own
        self:WhisperWindowLines(cf, m)
        m.drawnWithTime = self:ShowTimes()
        -- the combat log clears and refills its window on a filter change
        hook(cf, "Clear", function()
            m.frame:Clear()
            wipe(m.lines)
            m.target = nil
        end)
        hook(cf, "AddMessage", function(_, text: ChatText, r: Color?, g: Color?, b: Color?, ...: unknown)
            if not isSecret(text) and text == nil then return end
            self:Put(m, text, r, g, b)
            -- whisper windows' too (Blizzard may show a whisper only there)
            self:KeepWhisper(text, r, g, b, (select(4, ...)))
            if m ~= self.activeMirror and cf ~= ChatFrame2 then self.unread[cf] = true end
        end)
    end

    function ApplyMirrorFont(cf: Window)
        local m = self.mirrors[cf]
        if not m then return end
        local f = m.frame
        f:SetFont(BODY_FONT, fontSize(cf), "")
        f:SetShadowOffset(1, -1)
        f:SetShadowColor(0, 0, 0, 0.8)
        -- the divider's rules are measured for the font
        m.drawnWithTime = nil
        if m == self.activeMirror then self:Redraw(m) end
    end

    ----------------------------------------------------------------------------
    -- History: what you sent and the commands you ran, recalled with Up and
    -- Down, kept for the character across reloads. This client's input has
    -- no recall of its own. Taken on Enter, before Blizzard runs the line (a
    -- message as the command that sends it again: "/p hi", "/w Name hi");
    -- your own lines coming back as chat events fill in if that key never
    -- reaches SuuUI. A recalled line is typed in by SuuUI, so what's sent
    -- with it runs as SuuUI's: in combat Up and Down pass over protected
    -- commands (/cast, /target …: blocked then), and in an encounter's chat
    -- lockdown (messages blocked) they do nothing.
    ----------------------------------------------------------------------------

    function History(): string[]
        local data = self:CharData()
        local list: string[] = {}
        for _, line in ipairs(tbl.list(data.history)) do
            local s = asString(line)
            if s then list[#list + 1] = s end
        end
        data.history = list
        return list
    end

    function AddHistory(line: string)
        if not chatInput.push(self:History(), line) then return end
        self.recall = nil
    end

    -- Up: one line further back; Down: one forward, past the newest an empty
    -- input. A recall starts over once the text isn't the recalled line.
    function Recall(eb: EditBox, step: number)
        if not self:Get("recall") or chatLockdown() then return end
        -- the command palette's list is open: its arrows choose there
        local palette = SuuUI.GetModule("chatcommands")
        if palette and palette:IsEnabled() and secret.flag(errors.tryMethod(palette, "TakesArrows", eb)) then return end
        local list = self:History()
        if #list == 0 then return end
        local r = self.recall
        local text = asString(eb:GetText())
        if not (r and r.eb == eb and text and text == r.shown) then
            r = { eb = eb, index = #list + 1 }
            self.recall = r
        end
        -- in combat past protected commands
        local index = chatInput.recallIndex(list, r.index, step, InCombatLockdown() and true or false)
        if not index then return end
        r.index = index
        eb:SetText(list[index] or "")
        eb:SetCursorPosition(#(eb:GetText() or ""))
        -- as the input shows it (Blizzard may turn "/p " into its header)
        r.shown = asString(eb:GetText())
    end

    -- An edit box gets the history: Enter keeps the line, Up and Down recall.
    function HistoryFor(eb: EditBox)
        if self.historyBoxes[eb] then return end
        self.historyBoxes[eb] = true
        hookScript(eb, "OnKeyDown", function(box: EditBox, key: string)
            if key ~= "ENTER" and key ~= "NUMPADENTER" then return end
            local line = typedLine(box)
            if line then
                self.keyCapture = true
                self:AddHistory(line)
            end
        end)
        hookScript(eb, "OnArrowPressed", function(box: EditBox, key: string)
            if key == "UP" then self:Recall(box, -1) elseif key == "DOWN" then self:Recall(box, 1) end
        end)
    end

    function WatchSent()
        for event in pairs(chatInput.SENT) do
            self:OnGameEvent(event, function(_, ...: unknown)
                if self.keyCapture then return end
                local text, sender, channelNumber, guid = (select(1, ...)), (select(2, ...)), (select(8, ...)), (select(12, ...))
                local line = chatInput.sentLine(event, text, sender, channelNumber, guid)
                if line then self:AddHistory(line) end
            end)
        end
    end

    ----------------------------------------------------------------------------
    -- Tabs: SuuUI's own buttons, one per Blizzard window, in SuuUI's order
    ----------------------------------------------------------------------------

    -- The windows as tabs: docked ones (General first, Global second, the rest
    -- in the dock's order), then whisper windows.
    function Windows(): Window[]
        local out: Window[] = {}
        local seen: { [Window]: boolean } = {}
        local function add(cf: Window?)
            if cf and not seen[cf] then seen[cf] = true; out[#out + 1] = cf end
        end
        local docked = chat.docked()
        local function named(wanted: string): Window?
            for _, cf in ipairs(docked) do
                local name = windowName(cf)
                if name and name:lower() == wanted then return cf end
            end
            return nil
        end
        add(ChatFrame1)
        add(named("global"))
        for _, cf in ipairs(docked) do if not chat.isTemporary(cf) then add(cf) end end
        for _, cf in ipairs(docked) do add(cf) end
        -- whisper windows Blizzard didn't dock (a closed one is hidden)
        for _, cf in ipairs(chatFrames()) do
            if chat.isTemporary(cf) and cf:IsShown() then add(cf) end
        end
        return out
    end

    -- The button showing a window's tab (a free one, or a new one).
    function TabFor(cf: TabOf): TabButton
        local p = self:Panel()
        local made = p.tabFor[cf]
        if made then return made end
        local b: TabButton? = nil
        for _, free in ipairs(p.tabButtons) do
            if not free.cf then b = free break end
        end
        local tab = b or TabButton.new(self, p)
        if not b then p.tabButtons[#p.tabButtons + 1] = tab end
        -- placed at once where it first shows
        tab.cf, tab.x, tab.y, tab.slide = cf, nil, nil, nil
        p.tabFor[cf] = tab
        return tab
    end

    -- The combat log's filter bar, shown at the top of the lines while the
    -- Combat Log tab is: Blizzard shows it only while its own dock has the
    -- combat log selected, which it no longer is. The lines move down to
    -- make room.
    function CombatFilterBar(show: boolean)
        local bar = globalFrame("CombatLogQuickButtonFrame_Custom")
        local mirror = self.mirrors[ChatFrame2]
        if mirror then
            local f = mirror.frame
            f:ClearAllPoints()
            f:SetPoint("TOPLEFT", 0, (show and bar) and -(FILTER_H + S["space-1"]) or 0)
            f:SetPoint("BOTTOMRIGHT")
        end
        if not bar then return end
        if show then
            local log = self:Panel().log
            -- out of ChatFrame2 (always hidden now: Blizzard's dock stays on
            -- General) into the lines' area
            if bar:GetParent() ~= log then bar:SetParent(log) end
            bar:ClearAllPoints()
            bar:SetPoint("TOPLEFT", log, "TOPLEFT", 0, 0)
            bar:SetPoint("TOPRIGHT", log, "TOPRIGHT", 0, 0)
            bar:SetHeight(FILTER_H)
            bar:SetFrameStrata("MEDIUM")
            bar:Show()
        else
            bar:Hide()
        end
    end

    -- Right click on a tab: Blizzard's chat settings for its window (asked
    -- 2026-10-18); on a whisper tab, a menu to close it. The windows' font
    -- size, name, new and closing are in SuuUI's settings, Chat › Windows.
    function TabMenu(b: TabButton)
        local cf = b.cf
        if not cf or cf == "search" then return end
        if not chat.isTemporary(cf) then
            self:OpenChatSettings(cf)
            return
        end
        if not field(_G, "FCF_Close") then return end
        UI.ContextMenuFrom(b, function(_, root)
            root:CreateButton("Close", function() self:CloseWindow(cf) end)
        end, "chatTab", { chatFrame = cf })
    end

    function CloseWindow(cf: Window)
        errors.try(field(_G, "FCF_Close"), cf)
        if self.selected == cf then self:Select(ChatFrame1) else self:UpdateTabs() end
        local editor = self.windowsEditor
        if editor and editor:IsVisible() then editor:Refresh() end
    end

    -- Sizes and names go through the client's own chat window settings;
    -- Blizzard's chat settings open on the window.
    function SetFontSize(cf: Window, size: number)
        if chat.isTemporary(cf) then
            tempSizes[cf] = size
        else
            errors.try(SetChatWindowSize, idOf(cf), size)
        end
        if self:ApplyFont(cf) then self:ApplyMirrorFont(cf) end
    end

    function RenameWindow(cf: Window, name: string)
        if name == "" or chat.isTemporary(cf) then return end
        errors.try(SetChatWindowName, idOf(cf), name)
        self:UpdateTabs()
    end

    function OpenChatSettings(cf: Window)
        local config = ChatConfigFrame
        if not config then return end
        -- the window Blizzard's chat settings act on (its tab menu sets it so)
        CURRENT_CHAT_FRAME_ID = idOf(cf)
        if config:IsShown() then HideUIPanel(config) end
        ShowUIPanel(config)
    end

    function NewWindow(name: string)
        local open = field(_G, "FCF_OpenNewWindow")
        if name == "" or not open then return end
        local cf = chat.asWindow(errors.try(open, name))
        after(0, function()
            if not self:IsEnabled() then return end
            self:SkinAll()
            if cf and self.mirrors[cf] then self:Select(cf) end
            local editor = self.windowsEditor
            if editor and editor:IsVisible() then editor:Refresh() end
        end)
    end

    -- A whisper window just opened from SuuUI (a name's menu, the Search
    -- tab): skinned, the whispers with that player so far put in
    -- (Blizzard's starts empty), and shown.
    function OpenedWindow(cf: Window?, name: string?)
        after(0, function()
            if not self:IsEnabled() then return end
            self:SkinAll()
            local m = cf and self.mirrors[cf]
            if not (cf and m) then return end
            if name and m.target ~= name:lower() then self:FillWhispers(m, name) end
            self:Select(cf)
        end)
    end

    -- The whisper window with a player: the open one (its tab chosen), else a
    -- new one.
    function OpenWhisperWindow(name: string)
        local want = name:lower():match("^([^%-]+)")
        for _, cf in ipairs(self:Windows()) do
            local kind, target = chat.conversation(cf)
            if kind == "WHISPER" and target and target:lower():match("^([^%-]+)") == want then
                self:OpenedWindow(cf, name)
                return
            end
        end
        local open = field(_G, "FCF_OpenTemporaryWindow")
        if not open then return end
        self:OpenedWindow(chat.asWindow(errors.try(open, "WHISPER", name)), name)
    end

    function Select(cf: TabOf)
        self.selected = cf
        self.activeMirror = nil
        for frame, mirror in pairs(self.mirrors) do
            mirror.frame:SetShown(frame == cf)
            if frame == cf then
                self.activeMirror = mirror
                self.unread[frame] = nil
            end
        end
        self:ShowSearch(cf == "search")
        self:RedrawShown()
        self:CombatFilterBar(cf == ChatFrame2)
        self:UpdateTabs()
    end

    function UpdateTabs()
        local p = self:Panel()
        local windows = self:OrderedWindows()
        local selected = self.selected
        if not selected or (selected ~= "search" and not tContains(windows, selected)) then
            self.selected = nil
            self:Select(ChatFrame1)
            return
        end
        -- its mirror may have come after the choice
        local mirror = selected ~= "search" and self.mirrors[selected] or nil
        if mirror and not mirror.frame:IsShown() then self:Select(selected) return end
        -- a drag lays the row out itself until it ends
        if self.drag then return end
        -- the Search tab last, after the whispers
        local tabs: TabOf[] = { unpack(windows) }
        tabs[#tabs + 1] = SEARCH
        local arranging = self:Arranging()
        local glide = self.glideOnce
        self.glideOnce = nil
        local x = 0
        local chosen: TabButton? = nil
        local used: { [TabButton]: boolean } = {}
        for _, cf in ipairs(tabs) do
            local b = self:TabFor(cf)
            used[b] = true
            local name: string? = nil
            if cf == "search" then
                name = "Search"
            else
                name = windowName(cf)
                local _, target = chat.conversation(cf)
                if target then name = target end
            end
            b.label:SetText(name or "")
            b.label.value = nil
            local w = 60
            if name then
                w = math.min(140, math.ceil(b.label:GetUnboundedStringWidth()) + 2)
            end
            b.label:SetWidth(w)
            local active = cf == selected
            b.active = active
            -- the hover's ink kept (this runs every tick: it reset it at once)
            b.label:SetColor(self:TabInk(b, arranging))
            b.unread:SetShown(not active and cf ~= "search" and self.unread[cf] == true)
            local tw = w + 8 + b:EditLook(arranging, cf == "search")
            b:SetWidth(tw)
            b.markWidth = tw
            b:Show()
            self:PlaceTab(b, x, glide)
            if active then chosen = b end
            x = x + tw + S["space-5"]
        end
        for _, b in ipairs(p.tabButtons) do
            if not used[b] then
                local cf = b.cf
                if cf then p.tabFor[cf] = nil end
                b.cf, b.slide = nil, nil
                b:Hide()
            end
        end
        p.marker:SetChosen(chosen)
    end

    -- A tab's name colour: the chosen one gilt, the hovered one ink; Search
    -- faint while the tabs are arranged.
    function TabInk(b: TabButton, arranging: boolean): string
        if b.active then return "gilt-text" end
        if arranging and b.cf == "search" then return "ink-faint" end
        local d = self.drag
        if b.hover or (d and d.b == b) then return "ink" end
        return "ink-muted"
    end

    -- The windows in this character's order: the kept ones first as kept,
    -- then the rest in the starting order (a new whisper tab at the end).
    function OrderedWindows(): Window[]
        local windows = self:Windows()
        local kept = self:CharData().tabOrder
        if type(kept) ~= "table" then return windows end
        -- (a whisper keeps its place only while its tab is open)
        return chatTabs.ordered(windows, tbl.list(kept), chatTabs.tabKey)
    end

    function SaveTabOrder(list: Window[])
        self:CharData().tabOrder = chatTabs.keysOf(list, chatTabs.tabKey)
    end

    function HasTabOrder(): boolean
        return type(self:CharData().tabOrder) == "table"
    end

    -- Back to the starting order: General and Global, the other windows, whispers.
    function ResetTabOrder()
        self:CharData().tabOrder = nil
        if not self.panel then return end
        self.glideOnce = true
        self:UpdateTabs()
    end

    -- Tabs arranged in edit mode (grips, a press on a tab drags).
    function Arranging(): boolean
        return SuuUI.EditMode.IsActive() and true or false
    end

    -- Whether a press on a tab may drag it now.
    function CanDrag(): boolean
        if self:Arranging() then return true end
        return self:Get("tabReorder") == "drag"
    end

    ----------------------------------------------------------------------------
    -- Placing and sliding the tabs
    ----------------------------------------------------------------------------

    function SetTab(b: TabButton, x: number, y: number)
        local p = self:Panel()
        b:ClearAllPoints()
        b:SetPoint("BOTTOMLEFT", p.tabs, "BOTTOMLEFT", x, y)
        b.x, b.y, b.markLeft = x, y, x
        if b.active then p.marker:Aim() end
    end

    -- A tab to its place in the row: at once, or gliding there (dur-fast; at
    -- once with reduced motion). A glide on its way turns to a new place.
    function PlaceTab(b: TabButton, x: number, glide: boolean?)
        local d = self.drag
        if d and d.b == b then return end
        local sl = b.slide
        if sl then
            if sl.tx ~= x then
                b.slide = { fx = b.x or 0, fy = b.y or 0, tx = x, start = GetTime() }
            end
            return
        end
        if b.x == x and (b.y or 0) == 0 then return end
        local from = b.x
        if glide and from and not SuuUI.Motion.Reduced() then
            b.slide = { fx = from, fy = b.y or 0, tx = x, start = GetTime() }
            self:RunSlides()
        else
            self:SetTab(b, x, 0)
            b:HidePlate()
        end
    end

    function RunSlides()
        local p = self:Panel()
        local slider = p.slider or CreateFrame("Frame", nil, p.tabs)
        p.slider = slider
        slider:SetScript("OnUpdate", function()
            local moving = false
            for _, b in ipairs(p.tabButtons) do
                local sl = b.slide
                if sl then
                    local t = (GetTime() - sl.start) / SLIDE
                    if t >= 1 or not b.cf then
                        b.slide = nil
                        self:SetTab(b, sl.tx, 0)
                        -- the plate drops back into the row as it lands
                        b:HidePlate()
                        if b.cf then b.label:SetColor(self:TabInk(b, self:Arranging())) end
                    else
                        local e = smooth(t)
                        self:SetTab(b, sl.fx + (sl.tx - sl.fx) * e, sl.fy * (1 - e))
                        moving = true
                    end
                end
            end
            if not moving then slider:SetScript("OnUpdate", nil) end
        end)
    end

    ----------------------------------------------------------------------------
    -- Dragging a tab
    ----------------------------------------------------------------------------

    function PressTab(b: TabButton)
        if b.cf == "search" or self.drag or not self:CanDrag() then return end
        local p = self:Panel()
        self.press = { b = b, x0 = cursorX(p.tabs) }
        local dragger = p.dragger or CreateFrame("Frame", nil, p.tabs)
        p.dragger = dragger
        dragger:SetScript("OnUpdate", function() self:DragStep() end)
    end

    function StopDragger()
        local dragger = self:Panel().dragger
        self.press = nil
        if dragger then
            dragger:SetScript("OnUpdate", nil)
            dragger:SetScript("OnKeyDown", nil)
            if not InCombatLockdown() then pcall(dragger.EnableKeyboard, dragger, false) end
        end
    end

    function DragStep()
        local press = self.press
        local tabs = self:Panel().tabs
        if not press or not tabs:IsVisible() then return self:EndDrag(false) end
        local cx = cursorX(tabs)
        if not self.drag then
            -- released before it moved far enough: a click
            if not IsMouseButtonDown("LeftButton") then return self:StopDragger() end
            local threshold = self:Arranging() and 2 or DRAG_START
            if math.abs(cx - press.x0) < threshold then return end
            self:BeginDrag(press)
        end
        if IsMouseButtonDown("RightButton") then return self:EndDrag(false) end
        if not IsMouseButtonDown("LeftButton") then
            -- let go on the row: there; away from it: back
            return self:EndDrag(tabs:IsMouseOver(12, -12, -24, 24) and true or false)
        end
        self:MoveDrag(cx)
    end

    function BeginDrag(press: Press)
        local p = self:Panel()
        local b = press.b
        -- the others in their order, without it; its place among them
        local others: Window[] = {}
        local index = 1
        for _, cf in ipairs(self:OrderedWindows()) do
            if cf == b.cf then index = #others + 1 else others[#others + 1] = cf end
        end
        -- it may go as far as the place before Search
        local span = b:GetWidth()
        for _, cf in ipairs(others) do
            local o = p.tabFor[cf]
            if o then span = span + S["space-5"] + o:GetWidth() end
        end
        self.drag = { b = b, x0 = press.x0, others = others, index = index, start = index,
                      grab = press.x0 - (b.x or 0), maxX = span - b:GetWidth() }
        b.dragged = true
        b.slide = nil
        -- it lifted onto its plate, both over the others as it passes them
        local base = p.tabs:GetFrameLevel()
        for _, o in ipairs(p.tabButtons) do o:SetFrameLevel(base + (o == b and 2 or 0)) end
        local pl = b:Plate()
        pl:SetFrameLevel(base + 1)
        pl:Show()
        b.label:SetColor(self:TabInk(b, self:Arranging()))
        -- Esc puts it back (out of combat: taking keys is refused in it)
        local f = p.dragger
        if f and not InCombatLockdown() and pcall(f.EnableKeyboard, f, true) then
            pcall(f.SetPropagateKeyboardInput, f, true)
            f:SetScript("OnKeyDown", function(_, key: string)
                if InCombatLockdown() then return end
                local esc = key == "ESCAPE"
                pcall(f.SetPropagateKeyboardInput, f, not esc)
                if esc then self:EndDrag(false) end
            end)
        end
    end

    -- The row for the dragged tab at `index`: the others slide to their places.
    function LayoutDrag(d: Drag, index: number)
        local p = self:Panel()
        local x = 0
        for i = 1, #d.others + 1 do
            local b: TabButton? = nil
            if i == index then
                b = d.b
                d.slotX = x
            else
                b = p.tabFor[d.others[i < index and i or i - 1]]
                if b then self:PlaceTab(b, x, true) end
            end
            if b then x = x + b:GetWidth() + S["space-5"] end
        end
    end

    function MoveDrag(cx: number)
        local d = self.drag
        if not d then return end
        local p = self:Panel()
        local b = d.b
        local x = math.max(0, math.min(d.maxX, cx - d.grab))
        -- its place: after every other tab whose middle it has passed
        local centre = x + b:GetWidth() / 2
        local mids: (number | false)[] = {}
        for i, cf in ipairs(d.others) do
            local o = p.tabFor[cf]
            local sl = o and o.slide
            mids[i] = o and ((sl and sl.tx or o.x or 0) + o:GetWidth() / 2) or false
        end
        local index = chatTabs.dropIndex(mids, centre)
        if index ~= d.index or not d.slotX then
            d.index = index
            self:LayoutDrag(d, index)
        end
        self:SetTab(b, x, LIFT)
    end

    -- The drag ends: kept in its new place (and saved), or back where it was.
    function EndDrag(keep: boolean)
        local d = self.drag
        local p = self:Panel()
        self:StopDragger()
        if not d then return end
        self.drag = nil
        for _, o in ipairs(p.tabButtons) do o:SetFrameLevel(p.tabs:GetFrameLevel() + 1) end
        local b = d.b
        -- its plate under it again as it drops
        local pl = b.plate
        if pl then pl:SetFrameLevel(p.tabs:GetFrameLevel()) end
        local cf = b.cf
        if keep and d.index ~= d.start and cf and cf ~= "search" then
            local list: Window[] = {}
            for _, o in ipairs(d.others) do list[#list + 1] = o end
            table.insert(list, d.index, cf)
            self:SaveTabOrder(list)
        end
        -- it glides to its place (the new one or its own) as its plate drops
        self.glideOnce = true
        self:UpdateTabs()
        local x, y = b.x or 0, b.y
        if y and y ~= 0 and not b.slide then
            if SuuUI.Motion.Reduced() then
                self:SetTab(b, x, 0)
                b:HidePlate()
            else
                b.slide = { fx = x, fy = y, tx = x, start = GetTime() }
                self:RunSlides()
            end
        end
    end

    -- Edit mode in or out: the tabs over the chat's own outline while it shows
    -- (so they take the press), the hint under them; a drag in play ends.
    function EditModeChanged(on: boolean?)
        local p = self.panel
        if not p then return end
        if self.drag or self.press then self:EndDrag(false) end
        p.tabs:SetFrameStrata(on and "FULLSCREEN_DIALOG" or "MEDIUM")
        if on and not p.editHint then p.editHint = EditHint.new(p) end
        local hint = p.editHint
        if hint then hint:SetShown(on and true or false) end
        self:Wake()
        self:UpdateTabs()
    end

    ----------------------------------------------------------------------------
    -- Kept chat
    ----------------------------------------------------------------------------

    -- "Earlier · logged out 2 h ago" between gilt jewels, the rules filling the
    -- line either side.
    function DividerText(m: Mirror, at: number?): string
        local _, size = m.frame:GetFont()
        local g = T.color.gilt
        local jewel = ("|T%s:0:0:0:0:32:32:0:32:0:32:%d:%d:%d|t"):format(DIAMOND,
            math.floor(g[1] * 255 + 0.5), math.floor(g[2] * 255 + 0.5), math.floor(g[3] * 255 + 0.5))
        local label = "|cff" .. T.color["ink-muted"].hex .. "Earlier · logged out " .. ago(time() - (at or time())) .. "|r"
        local middle = "  " .. jewel .. "  " .. label .. "  " .. jewel .. "  "
        -- the mirror's own width when it has one, with room to spare: a line
        -- even a pixel too long wraps its right rule onto a line of its own
        local width = m.frame:GetWidth()
        if width <= 0 then width = logWidth() end
        local side = math.floor((width - 24 - measureBody(middle, size or 13)) / 2)
        if side < 12 then return middle end
        return rule(side, true) .. middle .. rule(side, false)
    end

    -- A line into its mirror: an earlier one dimmed, the divider measured.
    function Draw(m: Mirror, line: Line, withTime: boolean?)
        if line.divider then
            m.frame:AddMessage(self:DividerText(m, line.at), 1, 1, 1)
            return
        end
        local text, r, g, b = self:Render(line, withTime), line.r, line.g, line.b
        local readable = asString(text)
        if line.old and readable then
            m.frame:AddMessage(dimmed(readable), (asNumber(r) or 1) * DIM, (asNumber(g) or 1) * DIM, (asNumber(b) or 1) * DIM)
            return
        end
        m.frame:AddMessage(text, r, g, b)
    end

    -- What was saved at logout, to put back as the windows' mirrors are made.
    function LoadHistory()
        if self.historyLoaded then return end
        self.historyLoaded = true
        local kept = self:CharData().kept
        if not self:Get("keepHistory") or type(kept) ~= "table" then return end
        self.loggedOutAt = asNumber(field(kept, "at")) or time()
        local windows: { [number]: unknown } = {}
        local saved = field(kept, "windows")
        if type(saved) == "table" then
            for id, w in pairs(saved) do
                if type(id) == "number" then windows[id] = w end
            end
        end
        self.keptWindows = windows
        local classes = field(kept, "classes")
        if type(classes) == "table" then
            for name, class in pairs(classes) do
                if type(name) == "string" and type(class) == "string" and not classByName[name] then classByName[name] = class end
            end
        end
        local list: Whisper[] = {}
        for _, w in ipairs(tbl.list(field(kept, "whispers"))) do
            local who, text, at = asString(field(w, "who")), asString(field(w, "text")), asNumber(field(w, "at"))
            if who and text and at then
                local r, g, b = hexRGB(field(w, "rgb"))
                list[#list + 1] = { who = who, text = text, r = r, g = g, b = b, at = at, old = true }
            end
        end
        -- this session's after them
        for _, w in ipairs(self.whispers) do list[#list + 1] = w end
        self.whispers = list
    end

    -- A tab's kept lines (if it's the window they came from: same id, same
    -- name), then the divider.
    function RestoreKept(cf: Window, m: Mirror)
        local id = idOf(cf)
        local kept = self.keptWindows
        local saved = kept and kept[id]
        if not (kept and type(saved) == "table") then return end
        kept[id] = nil
        local name = windowName(cf)
        local lines = field(saved, "lines")
        if not name or name ~= field(saved, "name") or type(lines) ~= "table" then return end
        local any = false
        for _, s in ipairs(tbl.list(lines)) do
            local text, at = asString(field(s, "text")), asNumber(field(s, "at"))
            if text and at then
                local r, g, b = hexRGB(field(s, "rgb"))
                self:Put(m, text, r, g, b, at, true)
                any = true
            end
        end
        if any then self:Append(m, { divider = true, text = "", at = self.loggedOutAt or time() }) end
    end

    -- A whisper window's player: their kept whispers before what it holds.
    function WhisperWindowLines(cf: Window, m: Mirror)
        local kind, target = chat.conversation(cf)
        if kind ~= "WHISPER" or not target or target == "" then return end
        if m.target == target:lower() then return end
        self:FillWhispers(m, target)
    end

    -- The kept whispers with a player into their window, before its own lines
    -- (none twice): earlier sessions' dimmed, then the divider.
    function FillWhispers(m: Mirror, name: string)
        m.target = name:lower()
        local have: { [string]: boolean } = {}
        for _, line in ipairs(m.lines) do
            local src = line.src
            if src then have[src] = true end
        end
        local list: Line[] = {}
        local lastOld: number? = nil
        for _, w in ipairs(self:WhispersWith(name)) do
            if not have[w.text] then
                list[#list + 1] = self:NewLine(m, w.text, w.r, w.g, w.b, w.at, w.old)
                if w.old then lastOld = #list end
            end
        end
        if #list == 0 then return end
        if lastOld then table.insert(list, lastOld + 1, { divider = true, text = "", at = self.loggedOutAt or time() }) end
        for _, line in ipairs(m.lines) do list[#list + 1] = line end
        while #list > MAX_LINES do table.remove(list, 1) end
        m.lines = list
        m.drawnWithTime = nil
        self:Redraw(m)
    end

    -- At logout (a reload too): each tab's last lines, the whispers, and the
    -- classes of the names in them (a line's own sender is gone with its id).
    function SaveHistory()
        local data = self:CharData()
        if not self:Get("keepHistory") then data.kept = nil return end
        local kept: Kept = { at = time(), windows = {}, whispers = {}, classes = {} }
        local function noteClasses(text: string)
            for name in text:gmatch("|Hplayer:([^:|]+)") do
                local key = name:lower()
                local class = classByName[key] or classByName[key:match("^([^%-]+)") or key]
                if class then kept.classes[key] = class end
            end
        end
        -- the newest `keep` of a list, oldest first
        local function last<I>(list: I[], keep: number, make: (item: I) -> Saved?): Saved[]
            local out: Saved[] = {}
            for i = #list, 1, -1 do
                local saved = make(list[i])
                if saved then
                    out[#out + 1] = saved
                    noteClasses(saved.text)
                    if #out >= keep then break end
                end
            end
            for i = 1, math.floor(#out / 2) do out[i], out[#out + 1 - i] = out[#out + 1 - i], out[i] end
            return out
        end
        for _, cf in ipairs(self:Windows()) do
            local m = self.mirrors[cf]
            local name = windowName(cf)
            if m and not m.raw and not chat.isTemporary(cf) and name then
                local lines = last(m.lines, KEEP_LINES, function(line: Line): Saved?
                    local src = line.src
                    return src and keptLine(src, line.r, line.g, line.b, line.at) or nil
                end)
                if #lines > 0 then kept.windows[idOf(cf)] = { name = name, lines = lines } end
            end
        end
        kept.whispers = last(self.whispers, KEEP_WHISPERS, function(w: Whisper): Saved?
            local saved = keptLine(w.text, w.r, w.g, w.b, w.at)
            if saved then saved.who = w.who end
            return saved
        end)
        data.kept = kept
    end

    -- Settings › Chat › Clear kept chat: the saved lines, the whispers and the
    -- tabs' lines (or they'd be kept again at logout).
    function ClearHistory()
        self:CharData().kept = nil
        self.keptWindows = nil
        self.whispers = {}
        for _, m in pairs(self.mirrors) do
            if not m.raw then
                m.frame:Clear()
                wipe(m.lines)
                m.target = nil
            end
        end
        self:RunSearch()
    end

    ----------------------------------------------------------------------------
    -- The Search tab
    ----------------------------------------------------------------------------

    function ShowSearch(show: boolean)
        if show and not self.search then self.search = SearchPage.new(self:Panel().log) end
        local s = self.search
        if not s then return end
        s:SetShown(show)
        local edit = s.field.edit
        if show then
            s.head:SetAlpha(1)
            self:RunSearch()
            edit:SetFocus()
        elseif edit:HasFocus() then
            edit:ClearFocus()
        end
    end

    -- Every kept line once (a whisper in General and in its window is one),
    -- newest first.
    function KeptLines(): KeptEntry[]
        local out: KeptEntry[] = {}
        local seen: { [string]: boolean } = {}
        local function add(src: string, line: Line, r: unknown, g: unknown, b: unknown, where: string, whisper: boolean?)
            if seen[src] then return end
            seen[src] = true
            out[#out + 1] = { src = src, line = line, r = r, g = g, b = b, where = where, whisper = whisper, n = #out + 1 }
        end
        for _, w in ipairs(self.whispers) do
            local shown = w.shown
            if not shown then
                local classes: Classes = {}
                shown = { text = self:FormatLine(w.text, nil, w.old, classes), at = w.at, classes = classes }
                w.shown = shown
            end
            add(w.text, shown, w.r, w.g, w.b, KIND_LABEL.whisper or "Whispers", true)
        end
        for _, cf in ipairs(self:Windows()) do
            local m = self.mirrors[cf]
            if m and not m.raw and not chat.isTemporary(cf) then
                local where = windowName(cf) or "Chat"
                for _, line in ipairs(m.lines) do
                    local src = line.src
                    if src then add(src, line, line.r, line.g, line.b, where) end
                end
            end
        end
        table.sort(out, function(a: KeptEntry, b: KeptEntry): boolean
            if a.line.at ~= b.line.at then return a.line.at > b.line.at end
            return a.n > b.n
        end)
        return out
    end

    -- The lines with `q` (lower case) in them, in `scope`, by player, the
    -- newest player first; and how many lines.
    function FindLines(q: string, scope: string): (Found[], number)
        return chatSearch.findLines(self:KeptLines(), q, scope)
    end

    -- One matching line: its text (cut to show the match if it's long), the
    -- match on a faint ink ground, underlined in the line's colour.
    function ShowRow(r: SearchRow, e: KeptEntry, q: string, size: number, width: number)
        local text = asString(self:Render(e.line :: Line, true)) or ""
        local cr, cg, cb = asNumber(e.r) or 1, asNumber(e.g) or 1, asNumber(e.b) or 1
        r.text:SetFont(BODY_FONT, size, "")
        r.text:SetTextColor(cr, cg, cb)
        r.ground:Hide()
        r.under:Hide()
        local x1, x2, shown, at, linkStarts, s = matchSpan(text, q, size)
        if x2 and x2 > width - 2 and shown and at and linkStarts and s then
            local cut = snippet(text, shown, at, linkStarts, s)
            if cut then
                text = cut
                x1, x2 = matchSpan(text, q, size)
            end
        end
        r.text:SetText(text)
        if x1 and x2 and x2 <= width then
            r.ground:ClearAllPoints()
            r.ground:SetPoint("TOPLEFT", r, "TOPLEFT", x1 - 1, 0)
            r.ground:SetPoint("BOTTOMRIGHT", r, "BOTTOMLEFT", x2 + 1, 0)
            r.ground:Show()
            r.under:ClearAllPoints()
            r.under:SetPoint("BOTTOMLEFT", r, "BOTTOMLEFT", x1, 2)
            r.under:SetPoint("BOTTOMRIGHT", r, "BOTTOMLEFT", x2, 2)
            r.under:SetHeight(1)
            r.under:SetVertexColor(cr, cg, cb)
            r.under:Show()
        end
    end

    -- The search again: on typing, a chip, the tab chosen, a group opened.
    function RunSearch()
        local s = self.search
        if not (s and s:IsShown()) then return end
        for _, b in ipairs(s.chips) do
            local on = b.value == s.scope
            UI.PaintFill(b.bg, on and "arcane-soft" or "surface-raised")
            b.edge:SetColor(on and "arcane" or "gilt-line")
            b.label:SetColor(on and "ink" or "ink-muted")
        end
        local query = strtrim(s.field.edit:GetText() or "")
        local q = query:lower()
        -- a new search starts at the top, its groups closed
        if q ~= s.lastQuery or s.scope ~= s.lastScope then
            s.lastQuery, s.lastScope = q, s.scope
            wipe(s.open)
            s.scroll:SetVerticalScroll(0)
        end
        for _, h in ipairs(s.headers) do h:Hide() end
        for _, r in ipairs(s.rows) do r:Hide() end
        for _, b in ipairs(s.mores) do b:Hide() end
        local groups: Found[], total = {}, 0
        if #q >= 2 then groups, total = self:FindLines(q, s.scope) end
        s.count:SetValue(chatSearch.countText(q, total))
        s.note:SetValue(chatSearch.noteText(q, total))
        local width = logWidth() - 8
        local size = fontSize(ChatFrame1)
        local rowH = math.ceil(size) + 5
        local y = 0
        local nh, nr, nm = 0, 0, 0
        for gi, group in ipairs(groups) do
            if nr >= MAX_ROWS then break end
            if gi > 1 then y = y + S["space-2"] end
            nh = nh + 1
            local h = s:Header(nh)
            h.rule:SetShown(gi > 1)
            local who = group.who
            local name = who and who:match("^([^%-]+)")
            local class = who and classOf(who)
            local token = class and T.color["class-" .. class:lower()] and ("class-" .. class:lower()) or nil
            UI.Paint(h.jewel, token or "ink-muted")
            h.jewel:SetShown(name ~= nil)
            h.name:ClearAllPoints()
            h.name:SetPoint("LEFT", h, "LEFT", name and (6 + S["space-3"]) or 0, -2)
            h.name:SetValue(name or "Other lines")
            h.name:SetColor(token or (name and "ink" or "gilt-text"))
            local n = #group.lines
            h.count:SetValue(chatSearch.groupCount(group))
            h.who = who
            h.whisper:SetShown(who ~= nil and not isMe(group.key) and field(_G, "FCF_OpenTemporaryWindow") ~= nil)
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", s.list, "TOPLEFT", 0, -y)
            h:SetWidth(width)
            h:Show()
            y = y + GROUP_H
            local shownLines = s.open[group.key] and n or math.min(GROUP_SHOWN, n)
            for li = 1, shownLines do
                if nr >= MAX_ROWS then break end
                nr = nr + 1
                local r = s:Row(nr)
                r:SetSize(width, rowH)
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", s.list, "TOPLEFT", 0, -y)
                self:ShowRow(r, group.lines[li], q, size, width)
                r:Show()
                y = y + rowH + ROW_GAP
            end
            if n > shownLines then
                nm = nm + 1
                local b = s:More(nm)
                b.key = group.key
                b.label:SetValue((n - shownLines) .. " more")
                b:SetWidth(math.ceil(UI.MeasureText("caption", tostring(b.label.value or ""))) + 4)
                b:ClearAllPoints()
                b:SetPoint("TOPLEFT", s.list, "TOPLEFT", 0, -y)
                b:Show()
                y = y + MORE_H
            end
        end
        s.note:SetShown(nh == 0)
        s.list:SetHeight(math.max(1, y))
    end

    ----------------------------------------------------------------------------
    -- Idle: ground, border, tabs and input fade; the lines stay
    ----------------------------------------------------------------------------

    function Wake()
        self.lastActive = GetTime()
    end

    function Tick()
        local p = self.panel
        if not p then return end
        -- a new window (a whisper tab): skinned
        local windows = chatFrames()
        if #windows ~= self.frameCount then
            self.frameCount = #windows
            self:SkinAll()
        end
        -- the window's own font size may have changed in its menu
        for _, cf in ipairs(windows) do
            if self:ApplyFont(cf) then self:ApplyMirrorFont(cf) end
        end
        self:UpdateTabs()
        local awake = true
        local search = self.search
        if self:Get("fadeIdle") then
            local hovered = p:IsMouseOver() and true or false
            local focused = editBoxFocused() or (search ~= nil and search.field.edit:HasFocus())
            if hovered or focused or self.drag or SuuUI.EditMode.IsActive() then self:Wake() end
            awake = (GetTime() - self.lastActive) < self:Get("idleDelay")
        end
        if awake ~= self.awake then
            self.awake = awake
            self:RedrawShown()
            local a = awake and 1 or 0
            SuuUI.Motion.AlphaTo(p.deco, a, awake and 0.2 or 1.2)
            SuuUI.Motion.AlphaTo(p.tabs, a, awake and 0.2 or 1.2)
            -- the Search tab's field and chips go with the tabs; its lines stay
            if search then SuuUI.Motion.AlphaTo(search.head, a, awake and 0.2 or 1.2) end
            -- Blizzard's edit boxes: hidden while idle and unfocused
            for _, eb in ipairs(editBoxes()) do
                if not hasFocus(eb) then eb:SetAlpha(a) end
            end
        end
    end

    ----------------------------------------------------------------------------
    -- The Global tab
    ----------------------------------------------------------------------------

    -- Channels live on the windows on this client: frame:AddChannel(name),
    -- frame:RemoveChannel(name), frame:RemoveAllMessageGroups() (/suu probe chat).
    function ApplyGlobalTab()
        if not self:Get("globalTab") or InCombatLockdown() then return end
        local general = ChatFrame1
        if not (field(general, "AddChannel") and field(general, "RemoveChannel")) then
            if not self.warnedGlobal then
                self.warnedGlobal = true
                self:Print("This client's chat windows have no AddChannel/RemoveChannel: the Global tab can't be set up.")
            end
            return
        end
        local global = windowNamed("Global")
        if not global then
            -- a "Guild" tab becomes Global (its guild messages go back to General), else a new tab
            local guild = windowNamed("Guild")
            local rename, open = field(_G, "FCF_SetWindowName"), field(_G, "FCF_OpenNewWindow")
            if guild and rename then
                errors.try(rename, guild, "Global")
                channelCall(guild, "RemoveAllMessageGroups")
                global = guild
            elseif open then
                global = chat.asWindow(errors.try(open, "Global")) or windowNamed("Global")
                if global then channelCall(global, "RemoveAllMessageGroups") end
            end
        end
        if not global then return end
        -- (its place among the tabs is the player's: dragging it, as with any
        -- tab; moving the dock from addon code upsets whisper windows, and the
        -- game docks by its own order on load)
        -- everything General was set to show, and every channel you're in
        local channels: string[] = {}
        local seen: { [string]: boolean } = {}
        for _, list in ipairs({ windowChannels(idOf(general)), joinedChannels() }) do
            for _, name in ipairs(list) do
                if not seen[name] then seen[name] = true; channels[#channels + 1] = name end
            end
        end
        for _, name in ipairs(channels) do
            -- channels the group finder reads but keeps out of chat
            -- (LookingForGroup): on no window
            if SuuUI.LFG.IsHiddenChannel(name) then
                channelCall(global, "RemoveChannel", name)
            else
                channelCall(global, "AddChannel", name)
            end
            channelCall(general, "RemoveChannel", name)
        end
    end

    ----------------------------------------------------------------------------
    -- Lifecycle
    ----------------------------------------------------------------------------

    -- A theme or colour vision changed. The lines carry its colours as codes
    -- (the time, names in class colour, class diamonds, the "Earlier"
    -- divider, earlier lines dimmed): each mirror's kept lines formatted again
    -- from Blizzard's text, with the classes they were shown with, and drawn
    -- again (the shown one now, the others when chosen); the same lines, in
    -- the same order. The tabs' names and the search's chips fitted to the
    -- faces.
    function ApplyTheme()
        for _, m in pairs(self.mirrors) do
            if not m.raw then
                for _, line in ipairs(m.lines) do
                    local src = line.src
                    if src then line.text = self:FormatLine(src, line.id, line.old, line.classes) end
                end
                m.drawnWithTime = nil
            end
        end
        for _, w in ipairs(self.whispers) do
            local shown = w.shown
            if shown then shown.text = self:FormatLine(w.text, nil, w.old, shown.classes) end
        end
        self:RedrawShown()
        local p = self.panel
        if p then
            for _, b in ipairs(p.tabButtons) do tabFace(b.label) end
        end
        local s = self.search
        if s then s:PlaceChips() end
        self:RunSearch()
    end

    function Layout()
        local w, h = self:PanelSize()
        self:Panel():SetSize(w, h)
        after(0, function() if self:IsEnabled() then self:PlaceChat() end end)
    end

    -- Skinned and placed a frame later (never while the chat code is
    -- mid-update).
    function SkinSoon()
        after(0, function()
            if not self:IsEnabled() then return end
            self:SkinAll()
            self:PlaceChat()
        end)
    end

    override function OnEnable()
        -- Blizzard's combat log loads when its tab is first shown, which never
        -- happens now: loaded here (its lines and its filter bar)
        if not C_AddOns.IsAddOnLoaded("Blizzard_CombatLog") then pcall(C_AddOns.LoadAddOn, "Blizzard_CombatLog") end
        local p = self.panel or ChatPanel.new()
        self.panel = p
        -- the kept chat, before the first window's mirror is made
        self:LoadHistory()
        self:Layout()
        self:RegisterMover(p, { key = "position", label = "Chat", managedShow = true })
        -- the lines' box (tabs and lines, without the input): the command
        -- palette opens over it
        SuuUI.PublishAnchor("chat", p.box)
        self:RegisterSettings(SECTION)
        self:Wake()
        self:SkinSoon()
        -- Blizzard places ChatFrame1 again (Edit Mode, layout passes): ours again
        if field(ChatFrame1, "ApplySystemAnchor") and not self.anchorHooked then
            self.anchorHooked = true
            hook(ChatFrame1, "ApplySystemAnchor", function()
                if self.placing or not self:IsEnabled() then return end
                after(0, function() self:PlaceChat() end)
            end)
        end
        -- new windows (whispers, a new tab): skinned a frame later
        for _, e in ipairs(WINDOW_EVENTS) do
            self:OnGameEvent(e, function() self:SkinSoon() end)
        end
        for _, e in ipairs(WAKE) do
            self:OnGameEvent(e, function() self:Wake() end)
        end
        -- a whisper opens a temporary window: skinned a frame later
        for _, e in ipairs(WHISPER_EVENTS) do
            self:OnGameEvent(e, function()
                after(0, function() if self:IsEnabled() then self:SkinAll() end end)
            end)
        end
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if self.pendingPlace then self:PlaceChat() end
            if self.pendingSkin then self.pendingSkin = nil; self:SkinAll() end
            self:ApplyGlobalTab()
        end)
        -- the channels settle a moment after login; joins and leaves later
        after(3, function() if self:IsEnabled() then self:ApplyGlobalTab() end end)
        for _, e in ipairs(CHANNEL_EVENTS) do
            self:OnGameEvent(e, function()
                after(0.5, function() if self:IsEnabled() then self:ApplyGlobalTab() end end)
            end)
        end
        self:WatchSent()
        self:WatchClasses()
        -- kept chat saved as the game logs out or reloads
        self:OnGameEvent("PLAYER_LOGOUT", function() self:SaveHistory() end)
        self:Watch("keepHistory", function()
            if not self:Get("keepHistory") then self:CharData().kept = nil end
        end)
        self:Watch("timestamps", function()
            for _, m in pairs(self.mirrors) do m.drawnWithTime = nil end
            self:RedrawShown()
        end)
        self:Watch("globalTab", function() self:ApplyGlobalTab() end)
        self:Watch("position", function() after(0, function() self:PlaceChat() end) end)
        self:Watch("logHeight", function() self:Layout() end)
        self:Watch("fadeIdle", function() self:Wake() end)
        self:Watch("tabReorder", function() if self.drag or self.press then self:EndDrag(false) end end)
        self:On("SUUUI_EDITMODE_CHANGED", function(_, on) self:EditModeChanged(on) end)
        self:On("SUUUI_ROOT_SCALED", function() after(0, function() self:PlaceChat() end) end)
        self:On("SUUUI_THEME_CHANGED", function() self:ApplyTheme() end)
        if not self.driver then
            local driver = CreateFrame("Frame")
            self.driver = driver
            local wait = 0
            driver:SetScript("OnUpdate", function(_, elapsed: number)
                wait = wait - elapsed
                if wait > 0 then return end
                wait = TICK
                if self:IsEnabled() then self:Tick() end
            end)
        end
    end
end

M = SuuUI.AddModule(ChatModule.new())
