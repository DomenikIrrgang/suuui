-- Units/Chat.wowlua
-- Chat (step 2.2): SuuUI's own chat display over Blizzard's chat.
--
-- Blizzard's chat keeps receiving and formatting every message (filters of
-- other addons, links, secret payloads during encounters), but invisibly:
-- its frames' text at alpha 0, their mouse, wheel and links off. Each finished
-- line is copied (a post-hook on the window's AddMessage) into SuuUI's own
-- ScrollingMessageFrame for that window, in SuuUI's panel: a glass panel
-- `chat-w` wide at the bottom left, SuuUI's tabs (real buttons, in SuuUI's
-- order: General, Global, then the rest, whispers last; each tab is one of
-- Blizzard's windows, so its own chat settings decide what goes where), the
-- input field behind Blizzard's restyled edit box (the input stays Blizzard's:
-- the game blocks addon-sent chat in lockdown and secure slash commands), and
-- an idle fade (ground, border, tabs and input go; the lines stay). Links in
-- SuuUI's windows open with SetItemRef; shift-click inserts them. A built-in
-- module written against the public API only.
--
-- Rules for chat on this client (see IMPLEMENTATION_PLAN 2.2):
-- no FCF_* hooks, no writes to the tab alpha globals, no hooks on edit box
-- scripts, no fields on Blizzard frames, and chat frame geometry is never
-- read: ChatFrame1 is placed from the panel's own rectangle (SetPointBase,
-- two corners, no SetSize).


import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type Position from "/EditMode/EditMode"
import type Text from "/UI/Text"
import type Border from "/UI/Draw"
import type TabMarker from "/UI/TabMarker"
import type TextField, Stepper from "/UI/Inputs"
import type SuuButton from "/UI/Controls"
import type ScrollArea from "/UI/Panel"
import Panel from "/UI/Panel"
import isSecret from "wowlua:secret"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as errors from "wowlua:errors"
import * as frames from "wowlua:frames"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
-- the text work (lines, the search, the input's history, the tabs' order)
-- in modules of their own beside this one
import * as chatLines from "./Chat/Lines"
import * as chatSearch from "./Chat/Search"
import * as chatInput from "./Chat/Input"
import * as chatTabs from "./Chat/Tabs"
import * as chat from "wowlua:chat"
import invite as groupInvite from "wowlua:unit"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local field, asString, asNumber = tbl.field, secret.asString, secret.asNumber

local DEFAULTS = {
    position = { point = "BOTTOMLEFT", x = 28, y = 28 } :: Position,
    logHeight = 160,
    fadeIdle = true,
    idleDelay = 10,
    globalTab = true, -- the numbered (global) channels in a "Global" tab, not in General
    timestamps = true,    -- the time before each line, while the chat is in use
    classDiamonds = true, -- the class diamond before names
    classNames = true,    -- players' names in their class colour (asked 2026-10-18)
    shortChannels = true, -- "2. Trade", not "[2. Trade - City]"
    recall = true,        -- Up and Down bring back what you sent
    keepHistory = true,   -- each tab's last lines and the whispers kept across logouts
    tabReorder = "drag",  -- "drag": drag a tab anytime; "edit": only in edit mode
}

local M: ChatModule

-- a value that's there and readable
local BODY_FONT = "Interface\\AddOns\\SuuUI\\Media\\Fonts\\Figtree-Regular.ttf"
local PAD_X, PAD_TOP, PAD_BOTTOM = S["space-5"], S["space-2"], S["space-5"]
local TABS_H, INPUT_H, GAP = 24, 30, S["space-3"]
local TICK = 0.2

-- One of Blizzard's chat windows.
type Window = chat.Window
-- SuuUI's own message frame (one per window).
type MessageFrame = ScrollingMessageFrameMixin & Frame
-- Blizzard's text of a line, and a colour part of it: secret in an
-- encounter's chat lockdown.
type ChatText = string | Secret<string>
type Color = number | Secret<number>
-- The names' classes in a line, in the order they come (false: none found).
type Classes = chatLines.Classes
-- A line in a mirror, kept to draw again (with or without the time, in a
-- new theme): `text` the design's (Blizzard's when raw or secret), `src`
-- Blizzard's (readable lines only). A divider has no text of its own.
type Line = {
    text: ChatText, src?: string, raw?: boolean, r?: Color, g?: Color, b?: Color, at: number, id?: number,
    old?: boolean, classes?: Classes, divider?: boolean, plainText?: string,
}
-- A whisper line kept for a whisper window (and across logouts).
type Whisper = { who: string, text: string, r?: Color, g?: Color, b?: Color, at: number, old?: boolean, shown?: Line }
-- SuuUI's message frame for a window and the lines it holds: the combat
-- log's raw (as Blizzard writes them), a whisper window's player.
type Mirror = { frame: MessageFrame, lines: Line[], raw: boolean, drawnWithTime?: boolean, target?: string }
-- A line as saved in the kept chat.
type Saved = chatLines.Saved
-- A kept line for the search: Blizzard's text, the line as shown, where from.
type KeptEntry = chatSearch.KeptEntry
type Found = chatSearch.Found
-- What a tab shows: a window, or the Search tab.
type TabOf = Window | "search"
local SEARCH: TabOf = "search"
-- A tab's glide: from (fx, fy) to tx, since `start`.
type Slide = { fx: number, fy: number, tx: number, start: number }
-- A press on a tab, and the drag it became: the others in their order,
-- its place among them, where it started, where the pointer holds it.
type Press = { b: TabButton, x0: number }
type Drag = {
    b: TabButton, x0: number, others: Window[], index: number, start: number, grab: number, maxX: number,
    slotX?: number,
}
-- The input's recall: the edit box, where in the history, the line shown.
type Recall = { eb: EditBox, index: number, shown?: string }
-- A window's lines as saved at logout.
type KeptWindow = { name: string, lines: Saved[] }
-- The kept chat as saved.
type Kept = { at: number, windows: { [number]: KeptWindow }, whispers: Saved[], classes: { [string]: string } }

local hidden = CreateFrame("Frame")
hidden:Hide()

-- A window's ID.
local function idOf(cf: Window): number return cf:GetID() end

-- A window's name in Blizzard's settings, when readable.
local function windowName(cf: Window): string?
    return asString((GetChatWindowInfo(idOf(cf))))
end

-- A window's font size: Blizzard's setting for it; a whisper window (no
-- saved settings) keeps the one chosen in SuuUI's tab menu.
local tempSizes: { [Window]: number } = {}
local function fontSize(cf: Window): number
    local temp = tempSizes[cf]
    if temp then return temp end
    local size = asNumber(select(2, errors.try(field(_G, "FCF_GetChatWindowInfo"), idOf(cf))))
    if not size or size <= 0 then return 13 end
    return size
end

local chatFrames = chat.windows

-- The value of a game global, when it is a frame.
local function globalFrame(name: string): Frame? return frames.find(name) end

local function alphaOff(f: Region?)
    if not f then return end
    f:SetAlpha(0)
    local frame = frames.asFrame(f)
    if frame then pcall(frame.EnableMouse, frame, false) end
end

-- every texture region of a frame emptied (Blizzard's fades find nothing to show)
local function emptyTextures(f: Frame?)
    if not f then return end
    for _, r in ipairs(frames.textures(f)) do
        r:SetTexture("")
        pcall(r.SetAtlas, r, "")
        r:SetAlpha(0)
    end
end

--------------------------------------------------------------------------------
-- The panel (SuuUI's own frame, the mover)
--------------------------------------------------------------------------------

-- Edit mode's hint over the lines.
class EditHint extends Frame
    readonly text: Text

    constructor(p: ChatPanel)
        super(nil, p)
        self:SetFrameStrata("FULLSCREEN_DIALOG")
        self:SetPoint("TOPLEFT", p.log, "TOPLEFT", 0, 0)
        self.text = UI.Text(self, "caption", "ink-faint")
        self.text:SetShadowed(true)
        self.text:SetPoint("TOPLEFT")
        self.text:SetValue("Edit mode · drag a tab by its grip or name")
        self:SetSize(math.ceil(UI.MeasureText("caption", tostring(self.text.value or ""))) + 2, T.type.caption.lineHeight or 16)
    end
end

class ChatPanel extends Frame
    readonly deco: Frame
    -- the panel: glass ground and gilt-line edge around the tabs and lines
    readonly box: Frame
    readonly ground: Texture
    readonly border: Border
    -- the input field below the panel, as wide
    readonly field: Frame
    -- the tab bar: SuuUI's own tab buttons, above Blizzard's (invisible) dock
    readonly tabs: Frame
    readonly tabButtons: TabButton[] = {}
    readonly tabFor: { [TabOf]: TabButton } = {}
    -- the chosen tab's underline and jewel, gliding (UI.TabMarker)
    readonly marker: TabMarker
    -- the lines' area: SuuUI's message frames, one per Blizzard window
    readonly log: Frame
    slider: Frame? = nil
    dragger: Frame? = nil
    editHint: EditHint? = nil

    constructor()
        super("SuuUIChat", SuuUI.Root)
        self:SetFrameStrata("BACKGROUND")
        self:EnableMouse(false)
        self.deco = CreateFrame("Frame", nil, self)
        self.deco:SetAllPoints()
        self.box = CreateFrame("Frame", nil, self.deco)
        self.box:SetPoint("TOPLEFT")
        self.box:SetPoint("BOTTOMRIGHT", 0, INPUT_H + GAP)
        self.ground = UI.Fill(self.box, "surface-glass", "BACKGROUND")
        self.ground:SetAllPoints()
        self.border = UI.Border(self.box, "gilt-line")
        -- surface-sunk, a gilt-line edge (Blizzard's edit box sits on it)
        self.field = CreateFrame("Frame", nil, self.deco)
        self.field:SetPoint("BOTTOMLEFT")
        self.field:SetPoint("BOTTOMRIGHT")
        self.field:SetHeight(INPUT_H)
        UI.Fill(self.field, "surface-sunk", "BACKGROUND"):SetAllPoints()
        UI.Border(self.field, "gilt-line")
        self.tabs = CreateFrame("Frame", nil, self)
        self.tabs:SetFrameStrata("MEDIUM")
        self.tabs:SetPoint("TOPLEFT", PAD_X, -PAD_TOP)
        self.tabs:SetPoint("TOPRIGHT", -PAD_X, -PAD_TOP)
        self.tabs:SetHeight(TABS_H)
        self.marker = UI.TabMarker(self.tabs, { y = 2 })
        self.log = CreateFrame("Frame", nil, self)
        self.log:SetFrameStrata("LOW")
        self.log:SetPoint("TOPLEFT", PAD_X, -(PAD_TOP + TABS_H + GAP))
        self.log:SetPoint("BOTTOMRIGHT", -PAD_X, INPUT_H + GAP + PAD_BOTTOM)
    end
end

--------------------------------------------------------------------------------
-- A small box with one line of text (copy a name, name a window): Enter
-- gives the text to `onAccept` (if any) and closes, Esc closes.
--------------------------------------------------------------------------------

class TextBox extends Panel
    readonly field: TextField
    readonly hint: Text
    onAccept: ((text: string) -> ())? = nil

    constructor(title: string)
        super(SuuUI.Root, { title = title, width = 260, solid = true })
        self.field = UI.TextField(self.body, { width = 260 - S["space-5"] * 2 })
        self.field:SetPoint("TOPLEFT")
        self.hint = UI.Text(self.body, "caption", "ink-muted")
        self.hint:SetPoint("TOPLEFT", self.field, "BOTTOMLEFT", 0, -S["space-2"])
        self.field.edit:SetScript("OnEscapePressed", function() self:Hide() end)
        self.field.edit:SetScript("OnEnterPressed", function(edit: EditBox)
            local accept = self.onAccept
            self:Hide()
            if accept then accept(strtrim(edit:GetText() or "")) end
        end)
        UI.MakeModal(self)
    end
end

local textBox: TextBox? = nil
local function askText(title: string, text: string?, hint: string, onAccept: ((text: string) -> ())?)
    local box = textBox or TextBox.new(title)
    textBox = box
    box:SetTitle(title)
    -- (the hint's line height read now: a theme can change it)
    box.body:SetHeight(box.field:GetHeight() + S["space-2"] + (T.type.caption.lineHeight or 16))
    box.hint:SetValue(hint)
    box.onAccept = onAccept
    box:Show()
    local edit = box.field.edit
    edit:SetText(text or "")
    edit:SetFocus()
    -- a frame later, once the box has its width: from the start, all selected
    -- (set before that, the text scrolls out of view to the left)
    after(0, function()
        edit:SetCursorPosition(0)
        edit:HighlightText()
    end)
end

local function copyName(name: string)
    askText("Copy name", name, "Ctrl+C to copy · Esc closes")
end

-- Right click on a player's name: SuuUI's own menu (Blizzard's, opened from
-- an addon, runs tainted: copying a name is blocked then). Nothing in it
-- needs a protected action.
local function playerMenu(owner: Frame, name: string): boolean
    -- in the tooltip's look (asked for in game)
    UI.ContextMenuFrom(owner, function(_, root)
        root:CreateTitle(name)
        root:CreateButton("Whisper", function()
            chat.whisper(name, ChatFrame1)
        end)
        if field(_G, "FCF_OpenTemporaryWindow") then
            root:CreateButton("Whisper window", function() M:OpenWhisperWindow(name) end)
        end
        root:CreateButton("Invite", function()
            groupInvite(name)
        end)
        root:CreateButton("Copy name", function() copyName(name) end)
        root:CreateButton("Add friend", function()
            -- a friend request (Forever's classic friends list is off)
            if SuuUI.AddFriend(name) then M:Print("Friend request sent to " .. name .. ".") end
        end)
        root:CreateButton("Ignore", function()
            errors.try(field(C_FriendList, "AddIgnore"), name)
        end)
    end, "chatPlayer", { name = name })
    return true
end

local function linkClick(frame: Frame, link: unknown, text: unknown, button: string)
    local l = asString(link)
    if not l then return end
    -- a line's class diamond: the whole line to copy
    local copyID = l:match("^addon:suuui:copy:(%d+)$")
    if copyID then
        M:CopyLine(tonumber(copyID))
        return
    end
    if button == "RightButton" then
        local name = l:match("^player:([^:]+)")
        if name and name ~= "" and playerMenu(frame, name) then return end
    end
    pcall(SetItemRef, l, text, button, frame)
end

local function linkEnter(frame: Frame, link: unknown)
    local l = asString(link)
    if not l then return end
    if l:find("^addon:suuui:copy:") then
        GameTooltip:SetOwner(frame, "ANCHOR_CURSOR")
        GameTooltip:SetText("Click to copy this line")
        GameTooltip:Show()
        return
    end
    local kind = l:match("^(%a+):")
    if kind == "item" or kind == "spell" or kind == "achievement" or kind == "quest" or kind == "currency" then
        GameTooltip:SetOwner(frame, "ANCHOR_CURSOR")
        pcall(GameTooltip.SetHyperlink, GameTooltip, l)
        GameTooltip:Show()
    end
end

-- The links of a frame's lines: they work as in the chat.
local function links(f: Frame)
    f:SetHyperlinksEnabled(true)
    f:SetScript("OnHyperlinkClick", function(_, link: string, text: string, button: string) linkClick(f, link, text, button) end)
    f:SetScript("OnHyperlinkEnter", function(_, link: string) linkEnter(f, link) end)
    f:SetScript("OnHyperlinkLeave", function() GameTooltip:Hide() end)
end

--------------------------------------------------------------------------------
-- Tabs: SuuUI's own buttons, one per Blizzard window, in SuuUI's order
--------------------------------------------------------------------------------

-- Edit mode's look of a tab (asked 2026-10-19; design board "Chat tabs ·
-- drag to reorder", C).
local GRIP_W = 10         -- the grip (6 px) and its gap, in edit mode
local EDIT_PAD = 4        -- edit mode's wider padding (6 px a side, not 4)
local PLATE_OUT = 4       -- a lifted tab's plate reaches past it on each side

-- a tab's name: 12 px in header's face (again when a theme changes it)
local function tabFace(label: Text)
    local font = SuuUI.Fonts.Get("header"):GetFont()
    label:SetFont(font, 12, "")
end

-- A dashed outline around `frame` (3 px dashes, 2 px gaps, one physical pixel
-- thick, inside its edge).
class DashedOutline
    readonly frame: Frame
    readonly parts: Texture[] = {}
    color: string = "gilt-line"
    w: number? = nil
    h: number? = nil

    constructor(frame: Frame)
        self.frame = frame
    end

    function Layout(w: number, h: number)
        local px = SuuUI.Pixel.Size(self.frame)
        local n = 0
        for _, d in ipairs(chatTabs.dashes(w, h, px)) do
            n = n + 1
            local t = self.parts[n]
            if not t then
                t = self.frame:CreateTexture(nil, "BORDER")
                self.parts[n] = t
            end
            UI.PaintFill(t, self.color)
            t:ClearAllPoints()
            t:SetPoint("TOPLEFT", self.frame, "TOPLEFT", d.x, -d.y)
            t:SetSize(d.w, d.h)
            t:Show()
        end
        for i = n + 1, #self.parts do self.parts[i]:Hide() end
        self.w, self.h = w, h
    end

    function SetColor(token: string)
        self.color = token
        for _, t in ipairs(self.parts) do UI.PaintFill(t, token) end
    end

    function Hide()
        for _, t in ipairs(self.parts) do t:Hide() end
        self.w = nil
    end
end

-- Six 2 px dots, two across and three down (the board's grip).
local function grip(b: Frame): Frame
    local g = CreateFrame("Frame", nil, b)
    g:SetSize(6, 10)
    g:SetPoint("LEFT", 6, 1)
    for i = 0, 5 do
        local t = g:CreateTexture(nil, "ARTWORK")
        UI.PaintFill(t, "gilt-line")
        t:SetSize(2, 2)
        t:SetPoint("TOPLEFT", (i % 2) * 4, -math.floor(i / 2) * 4)
    end
    return g
end

class TabButton extends Button
    readonly label: Text
    readonly unread: Texture
    hover: boolean = false
    active: boolean = false
    cf: TabOf? = nil
    -- where it sits in the row (its marker's span), its glide
    x: number? = nil
    y: number? = nil
    slide: Slide? = nil
    markWidth: number? = nil
    markLeft: number? = nil
    dragged: boolean? = nil
    -- edit mode's look: "none", "grip" or "fixed" (Search)
    look: string? = nil
    grip: Frame? = nil
    outline: DashedOutline? = nil
    -- the plate under it while lifted
    plate: Frame? = nil

    constructor(m: ChatModule, p: ChatPanel)
        super(nil, p.tabs)
        self:SetHeight(TABS_H)
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.label = UI.Text(self, "header", "ink-muted")
        tabFace(self.label)
        self.label:SetShadowed(true)
        -- centred over the underline (it was left of it: measured in header's
        -- own size, wider than the 12 px name)
        self.label:SetPoint("CENTER", 0, 1)
        self.label:SetJustifyH("CENTER")
        self.label:SetWordWrap(false)
        self.unread = UI.Diamond(self, 4, "ink")
        self.unread:SetPoint("LEFT", self.label, "RIGHT", S["space-2"], 1)
        self:SetScript("OnEnter", function()
            self.hover = true
            if not self.active then self.label:SetColor("ink") end
        end)
        self:SetScript("OnLeave", function()
            self.hover = false
            if not self.active then self.label:SetColor("ink-muted") end
        end)
        p.marker:Track(self)
        self:SetScript("OnMouseDown", function(_, button: string)
            self.dragged = nil
            if button == "LeftButton" then m:PressTab(self) end
        end)
        self:SetScript("OnClick", function(_, button: string)
            -- the release that ends a drag isn't a click
            if self.dragged then self.dragged = nil return end
            if button == "RightButton" then m:TabMenu(self) return end
            -- in edit mode a press on a tab arranges; it doesn't switch
            if m:Arranging() then return end
            local cf = self.cf
            if cf then m:Select(cf) end
        end)
    end

    -- Edit mode's look: a dashed outline and a grip (Search: a fainter
    -- outline, no grip). Returns the width it adds to the tab.
    function EditLook(arranging: boolean, fixed: boolean): number
        local extra = 0
        if arranging then extra = EDIT_PAD + (fixed and 0 or GRIP_W) end
        local look = arranging and (fixed and "fixed" or "grip") or "none"
        if self.look ~= look then
            self.look = look
            self.label:ClearAllPoints()
            self.label:SetPoint("CENTER", look == "grip" and GRIP_W / 2 or 0, 1)
            if look == "grip" and not self.grip then self.grip = grip(self) end
            local g = self.grip
            if g then g:SetShown(look == "grip") end
            local outline = self.outline
            if look ~= "none" then
                outline = outline or DashedOutline.new(self)
                self.outline = outline
                outline:SetColor(look == "fixed" and "gilt-faint" or "gilt-line")
            elseif outline then
                outline:Hide()
            end
        end
        local outline = self.outline
        if look ~= "none" and outline then
            local w = math.floor(self.label:GetWidth() + 8 + extra + 0.5)
            if outline.w ~= w then outline:Layout(w, TABS_H) end
        end
        return extra
    end

    -- The plate under it when lifted: surface-raised, a gilt edge, the
    -- panel's shadow; it reaches PLATE_OUT past the tab on each side.
    function Plate(): Frame
        local made = self.plate
        if made then return made end
        -- beside the tab, not in it (a child would cover its name); it moves
        -- with the tab
        local f = CreateFrame("Frame", nil, self:GetParent())
        f:SetPoint("TOPLEFT", self, "TOPLEFT", -PLATE_OUT, 0)
        f:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", PLATE_OUT, 0)
        UI.Fill(f, "surface-raised", "BACKGROUND"):SetAllPoints()
        UI.Border(f, "gilt")
        UI.Shadow(f, "shadow-panel")
        f:Hide()
        self.plate = f
        return f
    end

    function HidePlate()
        local pl = self.plate
        if pl then pl:Hide() end
    end
end

--------------------------------------------------------------------------------
-- The Search tab (option B): the last tab. A field and chips for where to
-- look, then the kept lines that match (every tab and the whispers), grouped
-- by player, newest first: the name in its class colour, how many lines, and
-- a Whisper button that opens the conversation in its whisper window. The
-- match on a faint ink ground, underlined. In the lines' area: the panel
-- keeps its size (the raid frames sit right above it).
--------------------------------------------------------------------------------

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local FIELD_H, CHIP_H = 26, 20
local SEARCH_HEAD_H = FIELD_H + S["space-3"] + CHIP_H + S["space-2"]
local GROUP_H, MORE_H, ROW_GAP = 32, 16, 2
local CHIPS = {
    { value = "all", label = "All tabs" }, { value = "whisper", label = "Whispers" },
    { value = "party", label = "Party" }, { value = "guild", label = "Guild" }, { value = "trade", label = "Trade" },
}

-- Widths in the lines' font (texture codes and all).
local bodyMeasure: FontString? = nil
local function measureBody(text: string, size: number): number
    local fs = bodyMeasure or UIParent:CreateFontString(nil, "OVERLAY")
    if not bodyMeasure then
        fs:Hide()
        bodyMeasure = fs
    end
    fs:SetFont(BODY_FONT, size, "")
    fs:SetText(text)
    return fs:GetUnboundedStringWidth()
end

-- the lines' width (the panel's, less its padding)
local function logWidth(): number return UI.Size("chat-w") - PAD_X * 2 end

-- Where to look: a chip.
class SearchChip extends Button
    readonly bg: Texture
    readonly edge: Border
    readonly label: Text

    constructor(s: SearchPage, readonly value: string, label: string)
        super(nil, s.head)
        self.bg = UI.Fill(self, "surface-raised")
        self.bg:SetAllPoints()
        self.edge = UI.Border(self, "gilt-line")
        self.label = UI.Text(self, "caption", "ink-muted")
        self.label:SetPoint("CENTER")
        self.label:SetValue(label)
        self:SetScript("OnEnter", function() if s.scope ~= value then self.label:SetColor("ink") end end)
        self:SetScript("OnLeave", function() if s.scope ~= value then self.label:SetColor("ink-muted") end end)
        self:SetScript("OnClick", function()
            s.scope = value
            M:RunSearch()
        end)
    end
end

-- A player's group: a rule, their class jewel, name, how many lines, Whisper.
class SearchHeader extends Frame
    readonly rule: Frame
    readonly jewel: Texture
    readonly name: Text
    readonly count: Text
    readonly whisper: SuuButton
    who: string? = nil

    constructor(s: SearchPage)
        super(nil, s.list)
        self:SetHeight(GROUP_H)
        self.rule = UI.Hairline(self, "gilt-faint")
        self.rule:SetPoint("TOPLEFT")
        self.rule:SetPoint("TOPRIGHT")
        -- 6 above, 2 below the row's content (its middle 2 below the frame's)
        self.jewel = UI.Diamond(self, 5, "ink-muted")
        self.jewel:SetPoint("CENTER", self, "LEFT", 3, -2)
        self.name = UI.Text(self, "unit-name", "ink")
        self.count = UI.Text(self, "caption", "ink-muted")
        self.count:SetPoint("LEFT", self.name, "RIGHT", S["space-4"], 0)
        self.whisper = UI.Button(self, { text = "Whisper", icon = "chat", onClick = function()
            local who = self.who
            if who then M:OpenWhisperWindow(who) end
        end })
        self.whisper:SetHeight(24)
        self.whisper:SetPoint("RIGHT", 0, -2)
    end
end

-- A matching line: its text, the match on a faint ink ground, underlined.
class SearchRow extends Frame
    readonly ground: Texture
    readonly under: Texture
    readonly text: FontString

    constructor(s: SearchPage)
        super(nil, s.list)
        self.ground = UI.Fill(self, "ink", "BACKGROUND")
        self.ground:SetAlpha(0.16)
        self.under = self:CreateTexture(nil, "ARTWORK")
        self.under:SetColorTexture(1, 1, 1, 1)
        self.text = self:CreateFontString(nil, "OVERLAY")
        self.text:SetPoint("LEFT")
        self.text:SetPoint("RIGHT")
        self.text:SetJustifyH("LEFT")
        self.text:SetWordWrap(false)
        self.text:SetShadowOffset(1, -1)
        self.text:SetShadowColor(0, 0, 0, 0.8)
        -- links in it work as in the chat
        self:EnableMouse(true)
        links(self)
    end
end

-- "N more" under a group: opens it.
class SearchMore extends Button
    readonly label: Text
    key: string = ""

    constructor(s: SearchPage)
        super(nil, s.list)
        self:SetHeight(MORE_H)
        self.label = UI.Text(self, "caption", "ink-muted")
        self.label:SetPoint("LEFT")
        self:SetScript("OnEnter", function() self.label:SetColor("ink") end)
        self:SetScript("OnLeave", function() self.label:SetColor("ink-muted") end)
        self:SetScript("OnClick", function()
            s.open[self.key] = true
            M:RunSearch()
        end)
    end
end

class SearchPage extends Frame
    readonly head: Frame
    -- the field: the search glyph, what's typed, how many lines match
    readonly field: TextField
    readonly count: Text
    readonly chips: SearchChip[] = {}
    readonly scroll: ScrollArea
    readonly list: Frame
    readonly note: Text
    readonly headers: SearchHeader[] = {}
    readonly rows: SearchRow[] = {}
    readonly mores: SearchMore[] = {}
    -- where to look, the groups opened, the last search
    scope: string = "all"
    open: { [string]: boolean } = {}
    lastQuery: string? = nil
    lastScope: string? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetAllPoints()
        self:Hide()
        self.head = CreateFrame("Frame", nil, self)
        self.head:SetPoint("TOPLEFT")
        self.head:SetPoint("TOPRIGHT")
        self.head:SetHeight(SEARCH_HEAD_H)
        local f = UI.TextField(self.head, { placeholder = "A name or a word",
            onTextChanged = function() M:RunSearch() end, onChange = function() M:RunSearch() end })
        f:SetPoint("TOPLEFT")
        f:SetPoint("TOPRIGHT")
        f:SetHeight(FIELD_H)
        local glyph = f:CreateTexture(nil, "ARTWORK")
        glyph:SetTexture(GLYPHS .. "search.tga")
        glyph:SetSize(14, 14)
        UI.Paint(glyph, "ink-muted")
        glyph:SetPoint("LEFT", S["space-4"], 0)
        self.count = UI.Text(f, "caption", "ink-muted")
        self.count:SetPoint("RIGHT", -S["space-4"], 0)
        local textX = S["space-4"] + 14 + S["space-4"]
        f.edit:ClearAllPoints()
        f.edit:SetPoint("TOPLEFT", textX, 0)
        f.edit:SetPoint("BOTTOMRIGHT", -(S["space-4"] + 60), 0)
        f.placeholder:ClearAllPoints()
        f.placeholder:SetPoint("LEFT", textX, 0)
        self.field = f
        -- where to look: one chip at a time
        for _, c in ipairs(CHIPS) do self.chips[#self.chips + 1] = SearchChip.new(self, c.value, c.label) end
        -- the matches
        self.scroll = UI.ScrollArea(self, 5)
        self.scroll:SetPoint("TOPLEFT", 0, -SEARCH_HEAD_H)
        self.scroll:SetPoint("BOTTOMRIGHT", -8, 0)
        self.list = self.scroll.child
        self.list:SetWidth(logWidth() - 8)
        self.note = UI.Text(self.list, "caption", "ink-muted")
        self.note:SetPoint("TOPLEFT", 0, -S["space-2"])
        self:PlaceChips()
    end

    -- The chips side by side, each as wide as its label (measured again
    -- when a theme changes the caption).
    function PlaceChips()
        local x = 0
        for _, b in ipairs(self.chips) do
            b:SetSize(math.ceil(UI.MeasureText("caption", tostring(b.label.value or ""))) + S["space-4"] * 2, CHIP_H)
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", self.head, "TOPLEFT", x, -(FIELD_H + S["space-3"]))
            x = x + b:GetWidth() + S["space-2"]
        end
    end

    function Header(i: number): SearchHeader
        local h = self.headers[i] or SearchHeader.new(self)
        self.headers[i] = h
        return h
    end

    function Row(i: number): SearchRow
        local r = self.rows[i] or SearchRow.new(self)
        self.rows[i] = r
        return r
    end

    function More(i: number): SearchMore
        local b = self.mores[i] or SearchMore.new(self)
        self.mores[i] = b
        return b
    end
end

--------------------------------------------------------------------------------
-- Settings › Chat › Windows: each window (whisper windows aside) with its
-- name, font size, Blizzard's chat settings for it and closing; a new one.
--------------------------------------------------------------------------------

local EDIT_W, ROW_H = 520, 38

class WindowRow extends Frame
    readonly name: TextField
    readonly size: Stepper
    readonly config: SuuButton
    readonly close: Button
    cf: Window? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(EDIT_W - 12, ROW_H)
        self.name = UI.TextField(self, { width = 200, onChange = function(text: string)
            local cf = self.cf
            if cf then M:RenameWindow(cf, strtrim(text)) end
        end })
        self.name:SetPoint("LEFT")
        self.size = UI.Stepper(self, { min = 8, max = 24, step = 1, unit = "px", onChange = function(v: number)
            local cf = self.cf
            if cf then M:SetFontSize(cf, v) end
        end })
        self.size:SetPoint("LEFT", self.name, "RIGHT", S["space-4"], 0)
        self.config = UI.Button(self, { text = "Chat settings…", onClick = function()
            local cf = self.cf
            if cf then M:OpenChatSettings(cf) end
        end, tooltip = { title = "Chat settings", description = "Blizzard's settings for this window: which channels and messages it shows." } })
        self.config:SetPoint("LEFT", self.size, "RIGHT", S["space-4"], 0)
        self.close = UI.CloseButton(self, function()
            local cf = self.cf
            if cf then M:CloseWindow(cf) end
        end)
        self.close:SetPoint("RIGHT", -S["space-2"], 0)
    end
end

class WindowsEditor extends Frame
    readonly rows: WindowRow[] = {}
    readonly well: Frame
    readonly add: SuuButton

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(EDIT_W, 100)
        self.well = CreateFrame("Frame", nil, self)
        UI.Fill(self.well, "surface-sunk"):SetAllPoints()
        UI.Border(self.well, "gilt-faint")
        self.well:SetPoint("TOPLEFT")
        self.add = UI.Button(self, { text = "New window", onClick = function()
            askText("New window", "", "A name · Enter makes it · Esc cancels", function(name: string) M:NewWindow(name) end)
        end })
        M.windowsEditor = self
        self:Refresh()
        self:HookScript("OnShow", function() self:Refresh() end)
    end

    function Refresh()
        for _, r in ipairs(self.rows) do r:Hide() end
        local y = 6
        local i = 0
        for _, cf in ipairs(M:Windows()) do
            if not chat.isTemporary(cf) then
                i = i + 1
                local r = self.rows[i] or WindowRow.new(self.well)
                self.rows[i] = r
                r.cf = cf
                r.name:SetValue(windowName(cf) or "")
                r.size:SetValue(fontSize(cf))
                r.config:SetShown(ChatConfigFrame ~= nil)
                r.close:SetShown(cf ~= ChatFrame1 and cf ~= ChatFrame2 and field(_G, "FCF_Close") ~= nil)
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", 6, -y)
                r:Show()
                y = y + ROW_H
            end
        end
        local wellH = y + 6
        self.well:SetSize(EDIT_W, wellH)
        local canOpen = field(_G, "FCF_CanOpenNewWindow")
        local canNew = field(_G, "FCF_OpenNewWindow") ~= nil and (not canOpen or secret.flag(errors.try(canOpen)))
        self.add:SetShown(canNew)
        self.add:ClearAllPoints()
        self.add:SetPoint("TOPLEFT", 0, -(wellH + 10))
        self:SetHeight(wellH + (canNew and (10 + 30) or 0))
    end
end

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

