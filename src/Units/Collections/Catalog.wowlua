-- Units/Collections/Catalog.wowlua
-- What the collections window (Units/Collections) lists: an entry (a
-- mount, pet, toy or appearance, yours or not, with its source from
-- Collections/Sources), what the game says is still wrapped and how many,
-- the paper doll's slots, an entry's status line, the search and filters
-- (filterEntries), and the lists themselves from the game's journals,
-- yours first: the module's Mounts, OpenPetList, Pets, MountScene, Toys,
-- WeaponKinds, SlotCounts, Worn and Appearances, here as functions taking
-- the module (its methods call them).

import type CollectionSource from "/Data/CollectionSources"
import type CollectionsModule from "/Units/Collections"
import data, itemName from "./Sources"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"

local try, tryMethod, field, list = errors.try, errors.tryMethod, tbl.field, tbl.list
local asNumber, asString, flag = secret.asNumber, secret.asString, secret.flag

--------------------------------------------------------------------------------
-- Gifts: what the game wraps (its fanfare), its own functions
--------------------------------------------------------------------------------

export const GIFT_ICON = "Interface\\Icons\\Item_Shop_GiftBox01"

-- Whether a mount (its ID), toy (its item) or pet (its GUID) is still
-- wrapped.
export function wrapped(kind: string, id: number | string): boolean
    if kind == "mount" then
        return flag(try(field(C_MountJournal, "NeedsFanfare"), id)) or false
    elseif kind == "toy" then
        return flag(try(field(C_ToyBoxInfo, "NeedsFanfare"), id)) or false
    elseif kind == "pet" then
        return flag(try(field(C_PetJournal, "PetNeedsFanfare"), id)) or false
    end
    return false
end

-- Opened: the game told (its "new" goes with it).
export function clearWrapped(kind: string, id: number | string)
    if kind == "mount" then
        try(field(C_MountJournal, "ClearFanfare"), id)
    elseif kind == "toy" then
        try(field(C_ToyBoxInfo, "ClearFanfare"), id)
    elseif kind == "pet" then
        try(field(C_PetJournal, "ClearFanfare"), id)
    end
end

-- The gifts still wrapped: mounts and pets as the game counts them, toys of
-- Forever's list one by one (the game has no count for those).
export type GiftCounts = { mounts: number, toys: number, pets: number }
export function giftCounts(toys: number[]): GiftCounts
    local n = 0
    for _, itemID in ipairs(toys) do
        if wrapped("toy", itemID) then
            n = n + 1
        end
    end
    return {
        mounts = asNumber(try(field(C_MountJournal, "GetNumMountsNeedingFanfare"))) or 0,
        toys = n,
        pets = asNumber(try(field(C_PetJournal, "GetNumPetsNeedingFanfare"))) or 0,
    }
end

-- An entry the strip, the stage and the shelf show: a mount, a toy or an
-- appearance, yours or not, with its source (a CollectionSources entry).
export type Entry = {
    kind: string,
    id: number,
    name: string,
    icon?: number,
    collected: boolean,
    favourite?: boolean,
    usable?: boolean,
    learned?: number,
    source?: CollectionSource,
    sourceType?: number,
    -- a mount's
    spellID?: number,
    active?: boolean,
    faction?: number,
    display?: number,
    scene?: number,
    isSelf?: boolean,
    -- a toy's
    itemID?: number,
    -- a pet's (id: its kind, the species): your copies' GUIDs (summon the
    -- first), the one summoned now, the one still wrapped, the game's source
    -- text and description, its row in the journal (for its chat link)
    guids?: string[],
    summoned?: string,
    giftGuid?: string,
    sourceText?: string,
    description?: string,
    linkIndex?: number,
    -- a gift still wrapped (a mount's, toy's or pet's)
    wrapped?: boolean,
    -- an appearance's
    visualID?: number,
    sourceID?: number,
    quality?: number,
    worn?: boolean,
    camera?: number,
}

--------------------------------------------------------------------------------
-- What there is: mounts, toys, appearances, the ones you lack too
--------------------------------------------------------------------------------

-- The paper doll's slots (the game's armor categories 1-11; weapons by kind).
export type SlotDef = { slot: string, label: string, category?: number, weapon?: string }
local SLOTS: SlotDef[] = {
    { slot = "HEADSLOT", label = "Head", category = 1 },
    { slot = "SHOULDERSLOT", label = "Shoulder", category = 2 },
    { slot = "BACKSLOT", label = "Back", category = 3 },
    { slot = "CHESTSLOT", label = "Chest", category = 4 },
    { slot = "SHIRTSLOT", label = "Shirt", category = 5 },
    { slot = "TABARDSLOT", label = "Tabard", category = 6 },
    { slot = "WRISTSLOT", label = "Wrist", category = 7 },
    { slot = "HANDSSLOT", label = "Hands", category = 8 },
    { slot = "WAISTSLOT", label = "Waist", category = 9 },
    { slot = "LEGSSLOT", label = "Legs", category = 10 },
    { slot = "FEETSLOT", label = "Feet", category = 11 },
    { slot = "MAINHANDSLOT", label = "Main hand", weapon = "main" },
    { slot = "SECONDARYHANDSLOT", label = "Off hand", weapon = "off" },
    { slot = "RANGEDSLOT", label = "Ranged", weapon = "ranged" },
}

export function slotDef(slot: string?): SlotDef?
    for _, d in ipairs(SLOTS) do
        if d.slot == slot then
            return d
        end
    end
    return nil
end

-- A weapon kind: the game's category and its name.
export type WeaponKind = { category: number, name: string }
-- A slot's yours of all; a slot with no kind for this class: why.
export type SlotCount = { have: number, all: number, reason?: string }

-- The slot's transmog location (the game asks for armor with it).
local function location(slot: string): unknown
    local get = field(_G, "TransmogUtil", "GetTransmogLocation")
    local appearance = field(Enum, "TransmogType", "Appearance")
    if not (get and appearance) then
        return nil
    end
    local loc = try(get, slot, appearance, false)
    return loc and (tryMethod(loc, "GetData")) or nil
end

export function day(at: number?): string?
    if not at then
        return nil
    end
    if at == 0 then
        return "before SuuUI"
    end
    return (date("%d %b", at):gsub("^0", ""))
end

export function status(e: Entry): (string, string)
    if not e.collected then
        return "Not collected", "ink-faint"
    end
    if e.wrapped then
        return "A gift · unwrap it", "gilt-text"
    end
    local when = day(e.learned)
    local n = e.guids and #e.guids or 1
    return "Collected" .. (n > 1 and (" ×" .. n) or "") .. (when and (" · " .. when) or ""), "gilt-text"
end

-- A pet's source as the game words it ("|cFFFFD200Drop: |rRam|nZone: …"):
-- its lines, colour codes out.
export function petSourceLines(text: string?): string[]
    local out: string[] = {}
    if not text or text == "" then
        return out
    end
    local plain = text:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", "")
    for line in (plain .. "|n"):gmatch("(.-)|n") do
        local l = strtrim(line)
        if l ~= "" then
            out[#out + 1] = l
        end
    end
    return out
end

--------------------------------------------------------------------------------
-- What the strip shows: the tab's entries through the search and filters
--------------------------------------------------------------------------------

-- The entries a search (lower case) and the filters keep: have "all",
-- "have", "missing"; list "all", "fav", "recent" (newest first, what you
-- had before SuuUI last).
export function filterEntries(all: Entry[], search: string, have: string, kind: string): Entry[]
    local out: Entry[] = {}
    for _, e in ipairs(all) do
        local ok = (search == "" or e.name:lower():find(search, 1, true)) and
            (have == "all" or (have == "have") == (e.collected and true or false)) and
            (kind ~= "fav" or e.favourite) and
            (kind ~= "recent" or e.learned ~= nil)
        if ok then
            out[#out + 1] = e
        end
    end
    if kind == "recent" then
        table.sort(out, function(a: Entry, b: Entry): boolean
            local x, y = a.learned or -1, b.learned or -1
            if x == 0 then
                x = -1
            end
            if y == 0 then
                y = -1
            end
            if x ~= y then
                return x > y
            end
            return a.name < b.name
        end)
    end
    return out
end

----------------------------------------------------------------------------
-- What there is
----------------------------------------------------------------------------

-- Every mount this character can see (the rest: the other faction's, or no
-- model in Forever's data: probed, 49 of 139), favourites and yours first.
export function mountEntries(self: CollectionsModule): Entry[]
    local MJ = C_MountJournal
    local out: Entry[] = {}
    local sources = data()
    for _, idR in ipairs(list(try(field(MJ, "GetMountIDs")))) do
        local id = asNumber(idR)
        local nameR, spellID, icon, active, usable, sourceType, favourite, _, faction, hidden, collectedR = try(
            field(MJ, "GetMountInfoByID"),
            id
        )
        local name = asString(nameR)
        if id and name and not flag(hidden) then
            local display, _, _, isSelf, _, scene = try(field(MJ, "GetMountInfoExtraByID"), id)
            local collected = flag(collectedR)
            out[#out + 1] = {
                kind = "mount",
                id = id,
                name = name,
                spellID = asNumber(spellID),
                icon = asNumber(icon),
                active = flag(active),
                usable = flag(usable),
                favourite = flag(favourite),
                collected = collected,
                sourceType = asNumber(sourceType),
                faction = asNumber(faction),
                display = asNumber(display),
                scene = asNumber(scene),
                isSelf = flag(isSelf),
                source = sources.mount[id],
                learned = self:Learned("mount", id, collected),
                wrapped = collected and wrapped("mount", id) or nil,
            }
        end
    end
    table.sort(out, function(a: Entry, b: Entry): boolean
        if a.collected ~= b.collected then
            return a.collected
        end
        -- gifts still wrapped first (where a notification's Open leads)
        if (a.wrapped and true or false) ~= (b.wrapped and true or false) then
            return a.wrapped and true or false
        end
        if a.favourite ~= b.favourite then
            return a.favourite and true or false
        end
        return a.name < b.name
    end)
    return out
end

-- The pet journal's list with nothing filtered out: the game's journal
-- keeps its own search and filters, which SuuUI's window has no use for.
-- Once a session (each change makes the game send its list again).
export function openPetList(self: CollectionsModule)
    if self.petListOpen then
        return
    end
    self.petListOpen = true
    local PJ = C_PetJournal
    if (asString(try(field(PJ, "GetSearchFilter"))) or "") ~= "" then
        try(field(PJ, "ClearSearchFilter"))
    end
    local filters = {
        asNumber(field(_G, "LE_PET_JOURNAL_FILTER_COLLECTED")) or 1,
        asNumber(field(_G, "LE_PET_JOURNAL_FILTER_NOT_COLLECTED")) or 2,
    }
    for _, f in ipairs(filters) do
        if not flag(try(field(PJ, "IsFilterChecked"), f)) then
            try(field(PJ, "SetFilterChecked"), f, true)
        end
    end
    try(field(PJ, "SetAllPetTypesChecked"), true)
    try(field(PJ, "SetAllPetSourcesChecked"), true)
end

-- Every pet of Forever (the journal lists the ones you lack too), one
-- entry a kind with your copies; yours first, gifts, favourites.
export function petEntries(self: CollectionsModule): Entry[]
    local PJ = C_PetJournal
    local out: Entry[] = {}
    if PJ == nil then
        return out
    end
    self:OpenPetList()
    local bySpecies: { [number]: Entry } = {}
    local summoned = asString(try(field(PJ, "GetSummonedPetGUID")))
    for i = 1, asNumber(try(field(PJ, "GetNumPets"))) or 0 do
        local petIDR, speciesR, ownedR, _, _, favR, revokedR, nameR, iconR, _, _, sourceR, descR = try(
            field(PJ, "GetPetInfoByIndex"),
            i
        )
        local species, name = asNumber(speciesR), asString(nameR)
        if species and name then
            local e = bySpecies[species]
            if not e then
                local _, _, _, _, speciesSource, speciesDesc, _, _, _, _, _, displayR = try(
                    field(PJ, "GetPetInfoBySpeciesID"),
                    species
                )
                local display = asNumber(displayR)
                -- (an owned pet's row came without its source and
                -- description, found in game: the species' then)
                local sourceText = asString(sourceR)
                if not sourceText or sourceText == "" then
                    sourceText = asString(speciesSource)
                end
                local description = asString(descR)
                if not description or description == "" then
                    description = asString(speciesDesc)
                end
                local made: Entry = {
                    kind = "pet",
                    id = species,
                    name = name,
                    icon = asNumber(iconR),
                    collected = false,
                    display = display,
                    scene = asNumber(try(field(PJ, "GetPetModelSceneInfoBySpeciesID"), species)),
                    sourceText = sourceText,
                    description = description,
                    linkIndex = i,
                }
                e = made
                bySpecies[species] = made
                out[#out + 1] = made
            end
            local guid = asString(petIDR)
            if guid and flag(ownedR) and not flag(revokedR) then
                local guids = e.guids or {}
                e.guids = guids
                if not guids[1] then
                    e.linkIndex = i
                end
                guids[#guids + 1] = guid
                e.collected = true
                if flag(favR) then
                    e.favourite = true
                end
                if summoned == guid then
                    e.summoned = guid
                end
                if not e.giftGuid and wrapped("pet", guid) then
                    e.giftGuid = guid
                    e.wrapped = true
                end
            end
        end
    end
    for _, e in ipairs(out) do
        e.learned = self:Learned("pet", e.id, e.collected)
    end
    table.sort(out, function(a: Entry, b: Entry): boolean
        if a.collected ~= b.collected then
            return a.collected
        end
        if (a.wrapped and true or false) ~= (b.wrapped and true or false) then
            return a.wrapped and true or false
        end
        if (a.favourite and true or false) ~= (b.favourite and true or false) then
            return a.favourite and true or false
        end
        return a.name < b.name
    end)
    return out
end

-- A mount's model scene (they hold the game's present): the first mount's
-- that has one, kept.
export function mountScene(self: CollectionsModule): number?
    local known = self.mountScene
    if known then
        return known
    end
    for _, e in ipairs(self:Mounts()) do
        if e.scene and e.scene ~= 0 then
            self.mountScene = e.scene
            return e.scene
        end
    end
    return nil
end

-- Every toy of Forever (from the client's own list: the game won't list the
-- ones you lack), yours first.
export function toyEntries(self: CollectionsModule): Entry[]
    local out: Entry[] = {}
    local sources = data()
    for _, itemID in ipairs(sources.toys) do
        local _, nameR, icon, favourite = try(field(C_ToyBox, "GetToyInfo"), itemID)
        local name = asString(nameR) or itemName(itemID) or ("Toy " .. itemID)
        local has = flag(try(PlayerHasToy, itemID))
        out[#out + 1] = {
            kind = "toy",
            id = itemID,
            itemID = itemID,
            name = name,
            icon = asNumber(icon) or asNumber(try(field(C_Item, "GetItemIconByID"), itemID)),
            favourite = flag(favourite),
            collected = has,
            usable = has and try(field(C_ToyBox, "IsToyUsable"), itemID) ~= false,
            source = sources.toy[itemID],
            learned = self:Learned("toy", itemID, has),
            wrapped = has and wrapped("toy", itemID) or nil,
        }
        if name:find("^Toy %d") then
            self.namesPending = true
        end
    end
    table.sort(out, function(a: Entry, b: Entry): boolean
        if a.collected ~= b.collected then
            return a.collected
        end
        if (a.wrapped and true or false) ~= (b.wrapped and true or false) then
            return a.wrapped and true or false
        end
        if (a.favourite and true or false) ~= (b.favourite and true or false) then
            return a.favourite and true or false
        end
        return a.name < b.name
    end)
    return out
end

-- The weapon kinds this class can use for a hand (the game names only those).
export function weaponKinds(hand: string?): WeaponKind[]
    local out: WeaponKind[] = {}
    for cat = 12, 30 do
        local nameR, isWeapon, _, canMain, canOff, canRanged = try(
            field(C_TransmogCollection, "GetCategoryInfo"),
            cat
        )
        local name = asString(nameR)
        if name and flag(isWeapon) and
            ((hand == "main" and flag(canMain)) or (hand == "off" and flag(canOff)) or
                (hand == "ranged" and flag(canRanged))) then
            out[#out + 1] = { category = cat, name = name }
        end
    end
    return out
end

-- Each slot's yours and all (a weapon slot: over the kinds this class can
-- use for it); a slot with no kind for this class: its reason.
export function slotCounts(self: CollectionsModule, className: string?): { [string]: SlotCount }
    local out: { [string]: SlotCount } = {}
    for _, def in ipairs(SLOTS) do
        local cats: number[] = {}
        if def.category then
            cats[1] = def.category
        else
            for _, k in ipairs(self:WeaponKinds(def.weapon)) do
                cats[#cats + 1] = k.category
            end
        end
        local have, all = 0, 0
        for _, cat in ipairs(cats) do
            for _, a in ipairs(
                list(try(field(C_TransmogCollection, "GetCategoryAppearances"), cat, location(def.slot)))
            ) do
                if not flag(field(a, "isHideVisual")) then
                    all = all + 1
                    if flag(field(a, "isCollected")) then
                        have = have + 1
                    end
                end
            end
        end
        out[def.slot] = {
            have = have,
            all = all,
            reason = (not def.category and #cats == 0) and
                ("No " .. def.label:lower() .. " weapons for " .. (className or "this class")) or
                nil,
        }
    end
    return out
end

-- What you wear in a slot: its appearance (visual) ID.
export function wornVisual(slot: string): number?
    local id = asNumber(try(GetInventorySlotInfo, slot))
    local itemID = id and asNumber(try(GetInventoryItemID, "player", id))
    if not itemID then
        return nil
    end
    return asNumber(try(field(C_TransmogCollection, "GetItemInfo"), itemID))
end

-- A category's appearances (yours first), each with its first source's item
-- and that item's source data.
export function appearanceEntries(self: CollectionsModule, category: number, slot: string?): Entry[]
    local TC = C_TransmogCollection
    local worn = slot and self:Worn(slot)
    local out: Entry[] = {}
    for _, a in ipairs(list(try(field(TC, "GetCategoryAppearances"), category, slot and location(slot)))) do
        local visualID = asNumber(field(a, "visualID"))
        if visualID and not flag(field(a, "isHideVisual")) then
            local first: unknown = nil
            for _, s in ipairs(list(try(field(TC, "GetAppearanceSources"), visualID))) do
                if flag(field(s, "isCollected")) then
                    first = s
                    break
                end
                first = first or s
            end
            if first then
                local itemID = asNumber(field(first, "itemID"))
                local name = asString(field(first, "name")) or itemName(itemID)
                if not name then
                    self.namesPending = true
                end
                out[#out + 1] = {
                    kind = "appearance",
                    id = visualID,
                    visualID = visualID,
                    sourceID = asNumber(field(first, "sourceID")),
                    itemID = itemID,
                    name = name or "…",
                    quality = asNumber(field(first, "quality")),
                    collected = flag(field(a, "isCollected")),
                    favourite = flag(field(a, "isFavorite")),
                    worn = worn == visualID,
                    sourceType = asNumber(field(first, "sourceType")),
                    icon = asNumber(try(field(C_Item, "GetItemIconByID"), itemID)),
                    source = itemID and data().item[itemID] or nil,
                    camera = asNumber(try(field(TC, "GetAppearanceCameraID"), visualID)),
                }
            end
        end
    end
    table.sort(out, function(a: Entry, b: Entry): boolean
        if a.worn ~= b.worn then
            return a.worn and true or false
        end
        if a.collected ~= b.collected then
            return a.collected
        end
        return (a.visualID or 0) < (b.visualID or 0)
    end)
    return out
end
