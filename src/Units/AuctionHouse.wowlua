    ----------------------------------------------------------------------------
    -- The window
    ----------------------------------------------------------------------------

    function Build(): WindowFrame
        local w = UI.WindowFrame(SuuUI.Root, {
            name = "SuuUIAuctionHouseWindow",
            title = "Auction house",
            width = WIDTH,
            height = HEIGHT,
            footer = true,
            onClose = function(win: Frame)
                win:Hide()
            end,
            tabs = {
                { key = "buy", label = "Buy" },
                { key = "sell", label = "Sell" },
                { key = "auctions", label = "Auctions" },
            },
            onTab = function(key: string)
                self.tab = key
                for k, page in pairs(self.pages) do
                    page:SetShown(k == key)
                end
                -- the house sends your auctions or bids when asked
                local mine = self.mine
                if key == "auctions" and mine then
                    self:SetAuctionsTab(mine.sub)
                end
                self:Refresh()
            end,
        })
        w:SetPoint("TOPLEFT", UIParent, "TOPLEFT", 16, -116)
        w:Hide()
        w:HookScript("OnHide", function()
            if self.open then
                try(AH.CloseAuctionHouse)
            end
        end)
        w.scroll:Hide()
        self.window = w
        local buy, sell, mine = BuyPage.new(w.body, self), SellPage.new(w.body, self), AuctionsPage.new(w.body, self)
        self.buy, self.sell, self.mine = buy, sell, mine
        self.pages.buy, self.pages.sell, self.pages.auctions = buy, sell, mine
        -- the foot: the note at the left, your money at the right
        local footer = assert(w.footer)
        local note = UI.Text(footer, "caption", "ink-muted")
        note:SetPoint("LEFT")
        note:SetPoint("RIGHT", -160, 0)
        note:SetWordWrap(false)
        self.note = note
        local money = UI.Money(footer)
        money:SetPoint("RIGHT")
        self.money = money
        return w
    end

    function Refresh()
        local window, buy = self.window, self.buy
        if not (window and buy and window:IsShown() and self.open) then
            return
        end
        self:HideStaleOvers()
        local money = self.money
        if money then
            money:SetCopper(GetMoney() or 0)
        end
        if self.tab == "sell" then
            self:DrawSell()
            return
        end
        if self.tab == "auctions" then
            self:DrawAuctions()
            return
        end
        if self.tab ~= "buy" then
            return
        end
        self:DrawCategories()
        self:DrawScan()
        -- a scan holds the main column; what it showed comes back after
        if self.scanning then
            buy.results:Hide()
            buy.itemView:Hide()
            buy.writs:Hide()
            buy.tierBar:Hide()
            buy.empty:Hide()
            buy.more:Hide()
            return
        end
        local browse, writs = self.view == "browse", self.view == "writs"
        buy.results:SetShown(browse)
        buy.writs:SetShown(writs)
        buy.tierBar:SetShown(writs)
        buy.itemView:SetShown(not (browse or writs))
        if writs then
            buy.more:Hide()
            self:DrawWrits()
        elseif browse then
            buy.empty:SetShown(false)
            self:DrawResults()
        else
            buy.empty:Hide()
            buy.more:Hide()
            self:DrawItemView()
        end
    end

    function QueueRefresh()
        -- (off: its timer would not start, and the flag would stay set)
        if self.refreshPending or not self:IsEnabled() then
            return
        end
        self.refreshPending = true
        self:After(0.05, function()
            self.refreshPending = false
            self:Refresh()
        end)
    end

    -- The game's frame out of sight: see-through and off screen, still shown,
    -- and back off screen whenever the game places it again (unless it was
    -- SuuUI placing it itself).
    function Away(frame: Frame?)
        if not frame then
            return
        end
        local function away()
            if not self:IsEnabled() then
                return
            end
            self.placing = true
            frame:SetAlpha(0)
            frame:ClearAllPoints()
            frame:SetPoint("TOPLEFT", UIParent, "TOPRIGHT", 5000, 0)
            self.placing = false
        end
        away()
        if not self.awayHooked then
            self.awayHooked = true
            hook(frame, "SetPoint", function()
                if not self.placing then
                    self:After(0, away)
                end
            end)
        end
    end

    override function OnEnable()
        self:RegisterSettings(SECTION)
        local window = self.window or self:Build()
        self:OnGameEvent("AUCTION_HOUSE_SHOW", function()
            self.open = true
            self.view, self.searched, self.catPath = "browse", false, {}
            self:After(0, function()
                local f = frames.find("AuctionHouseFrame")
                self:Away(f)
                -- a bag item right-clicked here goes to the game's sell form:
                -- to SuuUI's Sell instead
                if f and field(f, "SetPostItem") and not self.postHooked then
                    self.postHooked = true
                    -- (the house's own method, of its mixin: not a frame's)
                    local house: unknown = f
                    hook(house, "SetPostItem", function(_: Frame, loc: ItemLocationMixin?)
                        if not self:IsEnabled() or not loc then
                            return
                        end
                        window:SetTab("sell")
                        self:SetSellItem(loc)
                    end)
                end
            end)
            window:Show()
            window:SetTab("buy")
            self:Note("")
            if self.scanStopped then
                self.scanStopped = false
                self:Note("The last scan stopped when the house closed; nothing of it was kept.")
            end
        end)
        self:OnGameEvent("AUCTION_HOUSE_CLOSED", function()
            self.open = false
            self:StopScan()
            -- (no answer comes for a bid or a purchase once the house is closed)
            self:DropBid()
            self:DropPurchase()
            window:Hide()
            self:HideOvers()
        end)
        -- combat: the secure clicks let go before the lockdown (BAG-33);
        -- after it, back where their view is shown
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            self:HideOvers()
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self:OversAfterCombat()
        end)
        local function results(isResults: boolean)
            if isResults and self.waiting then
                self:Note("")
            end
            self:QueueRefresh()
        end
        self:OnGameEvent("AUCTION_HOUSE_BROWSE_RESULTS_UPDATED", function()
            self:KeepSearch()
            results(true)
        end)
        self:OnGameEvent("AUCTION_HOUSE_BROWSE_RESULTS_ADDED", function()
            self:KeepSearch()
            results(true)
        end)
        self:OnGameEvent("ITEM_KEY_ITEM_INFO_RECEIVED", function()
            results(false)
        end)
        self:OnGameEvent("ITEM_SEARCH_RESULTS_UPDATED", function()
            results(true)
        end)
        self:OnGameEvent("ITEM_SEARCH_RESULTS_ADDED", function()
            results(true)
        end)
        self:OnGameEvent("COMMODITY_SEARCH_RESULTS_UPDATED", function()
            results(true)
        end)
        self:OnGameEvent("COMMODITY_SEARCH_RESULTS_ADDED", function()
            results(true)
        end)
        self:OnGameEvent("PLAYER_MONEY", function()
            results(false)
        end)
        self:OnGameEvent("AUCTION_HOUSE_FAVORITES_UPDATED", function()
            results(false)
        end)
        self:OnGameEvent("AUCTION_HOUSE_BROWSE_FAILURE", function()
            self.historyPending = nil
            self:Note("The search failed; try again in a moment.", "error")
        end)
        self:OnGameEvent("COMMODITY_PRICE_UPDATED", function(_, unit, total)
            self:OnCommodityPrice(unit, total)
        end)
        self:OnGameEvent("COMMODITY_PRICE_UNAVAILABLE", function()
            self:DropPurchase()
            self:Note("That price isn't available any more: search again.", "error")
        end)
        self:OnGameEvent("COMMODITY_PURCHASE_SUCCEEDED", function()
            self:Note("Bought.", "ok")
            local key = self.itemKey
            if key then
                try(AH.SendSearchQuery, key, sorts(), true)
            end
        end)
        self:OnGameEvent("COMMODITY_PURCHASE_FAILED", function()
            self.buying = nil
            self:Note("The purchase failed.", "error")
        end)
        self:OnGameEvent("AUCTION_HOUSE_PURCHASE_COMPLETED", function(_, id)
            self:OnPurchaseCompleted(id)
            self:Note("Bought.", "ok")
            self.chosen, self.chosenSeen = nil, nil
            local key = self.itemKey
            if key then
                try(AH.SendSearchQuery, key, sorts(), true)
            end
        end)
        self:OnGameEvent("AUCTION_HOUSE_AUCTION_CREATED", function()
            self:Posted()
        end)
        -- prices and "Yours" carry colour codes: drawn again
        self:On("SUUUI_THEME_CHANGED", function()
            self:QueueRefresh()
        end)
        -- Auctions: the lists as the house sends them; after a change, asked again
        self:OnGameEvent("OWNED_AUCTIONS_UPDATED", function()
            if self.tab == "auctions" then
                self:QueueRefresh()
            end
        end)
        self:OnGameEvent("BIDS_UPDATED", function()
            if self.tab == "auctions" then
                self:QueueRefresh()
            end
        end)
        self:OnGameEvent("AUCTION_CANCELED", function(_, id)
            self:OnCancelled(id)
        end)
        self:OnGameEvent("BID_ADDED", function(_, id)
            self:OnBidAdded(id)
            if self.tab == "auctions" then
                try(AH.QueryBids, {}, {})
            end
        end)
        self:OnGameEvent("AUCTION_HOUSE_AUCTIONS_EXPIRED", function()
            if self.tab == "auctions" then
                try(AH.QueryOwnedAuctions, {})
            end
        end)
        self:OnGameEvent("REPLICATE_ITEM_LIST_UPDATE", function()
            self:ReadScan()
        end)
        self:HookTooltips()
        self:HookLinks()
        self:ProvideService(AUCTION_HOUSE, {
            SearchItem = function(item: number | string): boolean
                return self:SearchItem(item)
            end,
            -- (0.44) the newest price any of your characters saw (crafting costs)
            Price = function(itemID: number): AuctionPrice?
                local e = self:LowestSeen(itemID)
                return e and { price = e.price, at = e.at } or nil
            end,
        })
        -- the wait counts down while the window is open (the module's own:
        -- turning it off stops it, so a second OnEnable doesn't start another)
        self.waitTicker = self:Every(30, function()
            if window:IsShown() then
                self:DrawScan()
            end
        end)
        self:OnGameEvent("BAG_UPDATE_DELAYED", function()
            if self.tab == "sell" then
                self:QueueRefresh()
            end
        end)
        self:OnGameEvent("AUCTION_HOUSE_POST_ERROR", function()
            self.posting = nil
            self:Note("Couldn't post.", "error")
            self:DrawSell() -- Post again
        end)
        -- the sell search: what the chosen item goes for now
        self:OnGameEvent("COMMODITY_SEARCH_RESULTS_UPDATED", function(_, answered)
            self:OnSellResults(answered)
        end)
        self:OnGameEvent("ITEM_SEARCH_RESULTS_UPDATED", function(_, answered)
            self:OnSellResults(answered)
        end)
        self:OnGameEvent("ITEM_SEARCH_RESULTS_ADDED", function(_, answered)
            self:OnSellResults(answered)
        end)
        -- a query the house dropped (too many at once): the sell one again once
        -- it is ready
        self:OnGameEvent("AUCTION_HOUSE_THROTTLED_MESSAGE_DROPPED", function()
            local sell = self.sell
            if sell and sell.asking then
                sell.resend = true
            end
        end)
        self:OnGameEvent("AUCTION_HOUSE_THROTTLED_SYSTEM_READY", function()
            local sell = self.sell
            if sell and sell.resend then
                sell.resend = false
                if sell.asking then
                    self:AskSellPrice()
                end
            end
        end)
        self:OnGameEvent("AUCTION_HOUSE_SHOW_ERROR", function(_, err)
            if self:OnHouseError(err) then
                return
            end
            self:Note("The auction house said no (" .. tostring(err) .. ").", "error")
        end)
    end

    -- (its tickers and timers, a scan's reader among them, go with the
    -- release)
    override function OnDisable()
        local window = self.window
        if window then
            window:Hide()
        end
    end
end

M = SuuUI.AddModule(AuctionHouseModule.new())
