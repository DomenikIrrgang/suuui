local AUCTION_HOUSE = SuuUI.Services.AUCTION_HOUSE

local UI = SuuUI.UI
local try, field = errors.try, tbl.field

local DEFAULTS = {
    cheapCheck = true,
    cheapPercent = 25,
    cheapShare = 10,
    tipShow = true,
    tipMost = true,
    tipOffered = true,
    tipStack = true,
}

local M: AuctionHouseModule

-- A cheap few (asked 2026-10-16): a few items offered far under the rest
-- (together at most cheapShare % of everything offered, at least
-- cheapPercent % under the next price) don't set the price; Post asks first
-- when yours is that far under.
export const SECTION: SettingsSection = {
    id = "auctionhouse",
    label = "Auction house",
    category = "General",
    order = 28,
    groups = {
        {
            title = "A cheap few",
            description = "When a few items are offered far under the rest, the sell price is filled in under the rest instead, and Post asks first when your price is that far under.",
            rows = {
                {
                    key = "cheapCheck",
                    label = "Look past a cheap few",
                    control = "toggle",
                    description = "Off: the price is filled in 1c under the very cheapest offer, and Post never asks.",
                },
                {
                    key = "cheapPercent",
                    label = "Far under",
                    control = "slider",
                    min = 10,
                    max = 60,
                    step = 5,
                    unit = "%",
                    description = "How far under the rest's price counts as too cheap.",
                    disabled = function(): (boolean, string)
                        return not M:Get("cheapCheck"), "Look past a cheap few is off."
                    end,
                },
                {
                    key = "cheapShare",
                    label = "A few",
                    control = "slider",
                    min = 5,
                    max = 30,
                    step = 5,
                    unit = "%",
                    description = "The most the cheap offers may make up of everything offered, together.",
                    disabled = function(): (boolean, string)
                        return not M:Get("cheapCheck"), "Look past a cheap few is off."
                    end,
                },
            },
        },
        {
            title = "Item tooltips",
            description = "What the auction house showed last for an item, from Scan all and your searches, under its tooltip everywhere.",
            rows = {
                {
                    key = "tipShow",
                    label = "Auction prices",
                    control = "toggle",
                    description = "The lowest buyout per item and when it was seen.",
                },
                {
                    key = "tipMost",
                    label = "What most sell it for",
                    control = "toggle",
                    description = "When a cheap few sell under the rest (the rule above).",
                    disabled = function(): (boolean, string)
                        return not M:Get("tipShow"), "Auction prices are off."
                    end,
                },
                {
                    key = "tipOffered",
                    label = "How many are offered",
                    control = "toggle",
                    description = "Items offered, and in how many auctions when Scan all or a search counted them.",
                    disabled = function(): (boolean, string)
                        return not M:Get("tipShow"), "Auction prices are off."
                    end,
                },
                {
                    key = "tipStack",
                    label = "Price for the stack",
                    control = "toggle",
                    description = "On a stack in your bags: the lowest buyout times how many.",
                    disabled = function(): (boolean, string)
                        return not M:Get("tipShow"), "Auction prices are off."
                    end,
                },
            },
        },
    },
}

local AH = C_AuctionHouse
local WIDTH, HEIGHT = 840, 580

--------------------------------------------------------------------------------
-- The foot's note: info (ink-muted), ok (fel), error (ember-text)
--------------------------------------------------------------------------------

local TONE: { [string]: string } = { info = "ink-muted", ok = "fel", error = "ember-text" }

-- What SuuUI remembers per item, per character: what the house showed last,
-- what you posted at; your bids; the last Scan all.
export type CharStore = {
    seen?: { [number]: SeenEntry },
    posted?: { [number]: PostedEntry },
    bids?: { [number]: number },
    scanAt?: number,
    scanSeconds?: number,
    scanCount?: number,
    -- when the last Scan all was asked (the game's 15 minutes count from
    -- the request, whether its list ever came or was read)
    scanAsked?: number,
    -- your searches, newest first
    history?: HistoryEntry[],
    -- the writs the last Scan all found, by itemID (AuctionHouse/Writs)
    writs?: { [number]: WritEntry },
}

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

export class AuctionHouseModule extends Module<typeof(DEFAULTS)>
    window: WindowFrame? = nil
    readonly pages: { [string]: Frame } = {}
    buy: BuyPage? = nil
    sell: SellPage? = nil
    mine: AuctionsPage? = nil
    note: Text? = nil
    money: Money? = nil
    -- the house: open; the tab; the Buy page's view and what it searched
    open: boolean = false
    tab: string = "buy"
    -- "browse" (the results), "writs" (AuctionHouse/Writs) or an item's view
    view: string = "browse"
    -- the Writs' tier: "all" or one of Writs' TIERS
    writTier: string = "all"
    query: AuctionHouseBrowseQuery? = nil
    searched: boolean = false
    -- the chosen category and those above it, top first (Armor, Plate, Head)
    catPath: Category[] = {}
    filterValue: FilterValues? = nil
    -- the results' sort (a column's key, reversed): for this session
    sortKey: string = "price"
    sortReverse: boolean = false
    -- an item's view: its key, the chosen auction (its auctionID, and its
    -- prices as the player saw them when choosing it), its auctions or offers
    itemKey: ItemKey? = nil
    chosen: number? = nil
    chosenSeen: Seen? = nil
    offers: CommoditySearchResultInfo[] = {}
    auctions: ItemSearchResultInfo[] = {}
    buying: Buying? = nil
    -- a bid or buyout sent, until the house answers
    bidding: PendingBid? = nil
    posting: Posting? = nil
    sellKey: ItemKey? = nil
    scanning: Scanning? = nil
    scanTicker: TickerHandle? = nil
    -- the scan's reader, a slice of the list a frame (X-4.5)
    readTicker: TickerHandle? = nil
    -- this visit's Scan all request (GetTime) until its list is read: a list
    -- that comes after the scan's view gave up is still read (BAG-17)
    asked: number? = nil
    -- a scan the house's closing stopped: told on the next open
    scanStopped: boolean = false
    waitTicker: TickerHandle? = nil
    -- the secure clicks on the game's page: over a result row, an auction
    -- row, Buy out and Back; what each does after its click
    overs: { [string]: Overlay } = {}
    afterClick: { [string]: () -> () } = {}
    -- their parent: hidden in combat by the client
    overHolder: Frame? = nil
    -- a note for what the house is asked, cleared when its results come
    waiting: boolean = false
    refreshPending: boolean = false
    placing: boolean = false
    awayHooked: boolean = false
    postHooked: boolean = false
    tooltipHooked: boolean = false
    -- a Shift-clicked item: its name loading; the last one, when (one click
    -- can reach the game's link code twice)
    linkHooked: boolean = false
    linkLoad: LoadHandle? = nil
    linkedID: number? = nil
    linkedAt: number? = nil
    -- your searches: the one sent, kept once the house says it found
    -- something; their list open (with the focus), what's typed since
    historyPending: string? = nil
    historyOpen: boolean = false
    historyQuery: string = ""

    constructor()
        super({
            id = "auctionhouse",
            name = "Auction house",
            description = "SuuUI's auction house window: search, the game's categories, an item's auctions and a commodity's offers, buying.",
            api = "0.17",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- What SuuUI keeps for this character, and for each of yours.
    function Saved(): CharStore
        return self:CharData() :: unknown :: CharStore
    end
    function AllSaved(): CharStore[]
        local out: CharStore[] = {}
        for _, d in pairs(self:AllCharData()) do
            out[#out + 1] = d :: unknown :: CharStore
        end
        return out
    end

    -- `waiting`: a note for what the house is asked (Searching…), cleared when
    -- its results come; any other stays until the next note.
    function Note(text: string?, tone: string?, waiting: boolean?)
        self.waiting = waiting or false
        local note = self.note
        if not note then
            return
        end
        note:SetValue(text or "")
        note:SetColor(TONE[tone or "info"] or "ink-muted")
    end

