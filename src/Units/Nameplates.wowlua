-- Units/Nameplates.wowlua
-- Enemy nameplates (step 1.10): SuuUI's own plate laid on Blizzard's, the
-- design's Nameplate. A built-in module written against the public API only.
--
-- The technique (/suu probe plates confirmed it on this client): on NAME_PLATE_UNIT_ADDED, an attackable unit gets a pooled
-- SuuUI plate parented to Blizzard's nameplate; Blizzard's UnitFrame stays
-- (it is what you click, and moving it breaks click selection) at alpha 0,
-- its aura icons moved to a hidden frame (they trap the mouse even at alpha
-- 0). Nothing is ever written onto Blizzard's frames: SuuUI keeps its own
-- weak tables. Friendly units get a SuuUI plate in the open world: the name
-- in its class (or friendly) colour, the debuffs you can remove instead of
-- yours, a neutral cast (nothing to interrupt), no threat (they don't attack
-- you). Inside dungeons, raids, battlegrounds and arenas the game locks
-- friendly plates, so they stay Blizzard's (hidden in dungeons and raids, by
-- default). Your own plate (the personal resource display) stays Blizzard's.
--
-- The plate, top to bottom: up to four of your debuffs (icon-sm by default,
-- engine aura container), the name in its reaction colour with the state
-- badge and the health text (micro) at the right, the bar (nameplate, 10px by
-- default), the cast (cast-plate, 8px by default, the spell line under it).
-- The three sizes are settings. Everything the game may hide goes to the engine
-- unread: health to the StatusBar, the name to the text (a fixed width, so a
-- secret name is cut with "…"; in dungeons enemy names are secret), the
-- percentage through a curve, the value through AbbreviateNumbers.
-- Quest objectives: a gilt diamond left of the name (with the count, 3/8 or
-- 45%) on mobs one of your quests still needs, read from the unit's tooltip
-- data (structured lines, every value checked for secrecy), cached per
-- plate and re-read when the quest log changes.
-- Your target: an ink border, full opacity; the rest rest at opacity-plate.
-- Threat (readable on plates, also in dungeons): as a non-tank "Aggro" when
-- it attacks you; as a tank "Losing" when it is about to leave you and
-- "Aggro" when it has. Solo, everyone reads as a non-tank (a tank has no one
-- to lose a mob to): "Aggro" on what attacks you.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import gameUnits from "/UI/UnitFrame"
import type StandInPerson, UnitApi from "/UI/UnitFrame"
import type Text from "/UI/Text"
import type StateBadge from "/UI/Controls"
import type Border, SoftEdge from "/UI/Draw"
import type Crest from "/UI/Crest"
import type CastBar from "/UI/CastBar"
import type UnitAuras from "/UI/Auras"
import type Icon from "/UI/Icon"
import after from "wowlua:timer"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local isSecret, asNumber, asString, flag, field = secret.isSecret, secret.asNumber, secret.asString, secret.flag, tbl.field

local DEFAULTS = {
    width = 140,
    barHeight = 13,
    castHeight = 9,
    auras = 4,
    auraSize = 19,
    castBars = true,
    castTarget = true,
    castKick = true,
    dimOthers = true,
    threat = true,
    healthText = "percent", -- "percent", "value", "both" or "none", as on the unit frames
    showPlates = true,     -- off: no nameplates at all (asked 2026-10-18)
    friendlyOpenWorld = true,
    friendlyStyle = true,
    friendlyNPCs = true,   -- friendly NPCs' plates in the open world (asked 2026-10-18)
    questMarks = true,
    levels = true,         -- the level before the name, in its difficulty's colour
    eliteDragon = false,   -- the game's elite dragon round the bar's right end, in the crest's place
    raidMarker = true,
}

local M: NameplatesModule

local WHITE = "Interface\\Buttons\\WHITE8X8"
-- the damage ghost's hold before it eases down (the unit frames' own)
local GHOST_HOLD = 0.15
local INTERPOLATE = Enum.StatusBarInterpolation and Enum.StatusBarInterpolation.ExponentialEaseOut
local LOW = 0.35
local NAME_H = 14
-- The health text's room at the name row's right end, per mode: a secret
-- text can't be measured, so each mode keeps a fixed width.
local PCT_W: { [string]: number } = { percent = 32, value = 36, both = 68, none = 0 }

-- SuuUI's own records, never keys on Blizzard's frames
local hidden: { [Frame]: boolean } = tbl.weakKeys()     -- Blizzard UnitFrame -> true while hidden
local auraHome: { [Frame]: Frame } = tbl.weakKeys()     -- moved aura frame -> its parent
local byUnit: { [string]: Nameplate } = {}              -- "nameplateN" -> SuuUI plate
local questCache: { [string]: string | false } = {}     -- "nameplateN" -> false | count text ("" none)

local function barH(): number return M:Get("barHeight") end
-- the name row sits space-2 over the bar: the state badge (taller than the
-- text, centred on it) keeps a hair of air above the bar's border
local ROW_GAP = S["space-2"]
local function plateH(): number return NAME_H + ROW_GAP + barH() end

-- A health amount for a StatusBar: a secret one goes through untouched (a
-- secret value can't even be tested against nil), a missing one is `default`.
local function amount(v: number | Secret<number> | nil, default: number?): number | Secret<number>
    if isSecret(v) then return v end
    return v or default or 0
end

-- Inside an instance: dungeons and raids, and with `pvp` battlegrounds and
-- arenas too.
local function inInstance(pvp: boolean?): boolean
    local _, kind = IsInInstance()
    if kind == "party" or kind == "raid" then return true end
    return pvp == true and (kind == "pvp" or kind == "arena")
end

local stash = CreateFrame("Frame")
stash:Hide()

--------------------------------------------------------------------------------
-- Blizzard's plate: hidden under ours, back for friendly units
--------------------------------------------------------------------------------

local guard = false
local hookedAlpha: { [Frame]: boolean } = tbl.weakKeys()

-- A plate's aura icons (they catch the mouse even at alpha 0).
local function aurasOf(uf: Frame): Frame?
    local auras = frames.asFrame(field(uf, "AurasFrame"))
    if auras and not auras:IsForbidden() then return auras end
    return nil
end

local function hideBlizzard(uf: Frame?)
    if not uf or uf:IsForbidden() then return end
    hidden[uf] = true
    uf:SetAlpha(0)
    if not hookedAlpha[uf] then
        hookedAlpha[uf] = true
        -- (hooksecurefunc, not wowlua:hooks: this runs on every alpha change of
        -- every plate, and the stdlib's error isolation costs a table and a
        -- closure per call)
        hooksecurefunc(uf, "SetAlpha", function(self: Frame)
            if hidden[self] and not guard then
                guard = true
                self:SetAlpha(0)
                guard = false
            end
        end)
    end
    local auras = aurasOf(uf)
    if auras and auras:GetParent() ~= stash then
        auraHome[auras] = auras:GetParent() :: Frame
        auras:SetParent(stash)
    end
end

local function restoreBlizzard(uf: Frame?)
    if not uf or uf:IsForbidden() or not hidden[uf] then return end
    hidden[uf] = nil
    uf:SetAlpha(1)
    local auras = aurasOf(uf)
    local home = auras and auraHome[auras]
    if auras and home then
        auras:SetParent(home)
        auraHome[auras] = nil
    end
end

--------------------------------------------------------------------------------
-- The plate
--------------------------------------------------------------------------------

local lowCurve: CurveObject | false | nil = nil
local function belowLow(): CurveObject?
    if lowCurve == nil then
        lowCurve = false
        if C_CurveUtil and Enum.LuaCurveType then
            local c = C_CurveUtil.CreateCurve()
            c:SetType(Enum.LuaCurveType.Step)
            c:AddPoint(0, 1)
            c:AddPoint(LOW, 0)
            lowCurve = c
        end
    end
    return lowCurve or nil
end

local function gradient(bar: StatusBar, deep: string, fill: string)
    UI.PaintGradient(bar:GetStatusBarTexture(), "HORIZONTAL", deep, fill)
end

-- Is this mob one of your quest objectives, still open? Its tooltip data says:
-- a QuestTitle line (the quest's id), then QuestObjective lines (done or
-- not, have and need). Only quests in your own log count (a group member's
-- objective is in your tooltip too). Returns false, or the count to show
-- ("3/8", "45%", or "" for a single mob).
local function questObjective(unit: string): string | false
    local LT = Enum.TooltipDataLineType
    local questID: number? = nil
    for _, line in ipairs(tbl.list(field(errors.tryValue(C_TooltipInfo.GetUnit, unit), "lines"))) do
        local kind = asNumber(field(line, "type"))
        if kind == LT.QuestTitle then
            questID = asNumber(field(line, "id"))
        elseif kind == LT.QuestObjective then
            local onQuest = questID == nil or errors.tryValue(C_QuestLog.IsOnQuest, questID) ~= false
            if secret.asBoolean(field(line, "completed")) == false and onQuest then
                local text = asString(field(line, "leftText"))
                local pct = text and text:match("(%d+)%s*%%")
                if pct then return pct .. "%" end
                local have, need = asNumber(field(line, "numFulfilled")), asNumber(field(line, "numRequired"))
                if have and need and need > 1 then return have .. "/" .. need end
                return ""
            end
        end
    end
    return false
end

local function questText(unit: string): string | false
    local cached = questCache[unit]
    if cached ~= nil then return cached end
    local result: string | false = false
    -- players are never quest objectives: no tooltip to read (/suu perf)
    if not flag(UnitIsPlayer(unit)) then
        local ok, r = pcall(questObjective, unit)
        if ok and r then result = r end
    end
    questCache[unit] = result
    return result
end

-- The unit's level before its name in its difficulty's colour, "+" for an
-- elite (asked 2026-10-18; design "Nameplate level options", A): after a
-- quest mark, before the name; on friendly plates too (asked); not when
-- it's secret.
local ELITE: { [string]: boolean } = { elite = true, rareelite = true }

local REACTION: { [number]: string } = { [1] = "reaction-hostile", [2] = "reaction-hostile", [3] = "reaction-hostile", [4] = "reaction-neutral" }

-- What a plate hears for its unit.
local PLATE_EVENTS: EventName[] = { "UNIT_HEALTH", "UNIT_MAXHEALTH", "UNIT_NAME_UPDATE", "UNIT_THREAT_LIST_UPDATE" }

-- The preview's drawn parts (the engine draws the real casts and debuffs).
type Fakes = { cast: StatusBar, castBorder: Border, icon: Icon, lock: Frame, lockArt: Texture,
               spell: Text, target: Text, time: Text, icons: Icon[] }

-- The unit functions plates read: the game's, or a preview's stand-ins.
local GAME = gameUnits()

export class Nameplate extends Frame
    api: UnitApi
    name: Text
    level: Text
    levelW: number = 0
    pct: Text
    raidMarker: Texture
    quest: Frame
    questMark: Texture
    questCount: Text
    questW: number = 0
    badge: StateBadge
    bar: Frame
    ghost: StatusBar
    health: StatusBar
    healthLow: StatusBar
    border: Border
    crest: Crest
    dragon: Texture
    glow: SoftEdge
    cast: CastBar
    auras: UnitAuras? = nil
    -- the plate's unit while it's on one ("nameplateN"; a preview's "plateN")
    unit: string? = nil
    friendly: boolean = false
    preview: boolean = false
    previewRole: string? = nil
    previewQuest: string? = nil
    fakes: Fakes? = nil
    events: Frame? = nil
    textMode: string? = nil
    ghostValue: number | Secret<number> = 0
    ghostTimer: TimerHandle? = nil
    state: string? = nil
    isTarget: boolean = false

    constructor(parent: Frame, api: UnitApi?)
        super(nil, parent)
        self.api = api or GAME
        self:EnableMouse(false)
        local w: number = M:Get("width")
        self:SetSize(w, plateH())

        -- the name row: name (reaction colour), badge, health text
        self.name = UI.Text(self, "unit-name-sm", "ink")
        self.name:SetShadowed(true)
        self.name:SetWordWrap(false)
        self.name:SetPoint("BOTTOMLEFT", self, "TOPLEFT", 0, -NAME_H)
        -- the level before the name (after a quest mark), by difficulty
        self.level = UI.Text(self, "micro", "ink")
        self.level:SetShadowed(true)
        self.pct = UI.Text(self, "micro", "ink")
        self.pct:SetShadowed(true)
        self.pct:SetPoint("BOTTOMRIGHT", self, "TOPRIGHT", 0, -NAME_H)
        -- the raid target marker, just left of the plate, centred on what shows
        -- of it: the name's capitals sit in the lower ~9px of their row, so the
        -- plate's own middle would put the marker high
        self.raidMarker = UI.RaidMarker(self, 18)
        self.raidMarker:SetPoint("RIGHT", self, "LEFT", -S["space-2"], -math.floor((NAME_H - 9) / 2 + 0.5))
        -- a quest objective: the gilt diamond and what you have of it
        self.quest = CreateFrame("Frame", nil, self)
        self.quest:SetHeight(NAME_H)
        self.quest:SetPoint("BOTTOMLEFT", self, "TOPLEFT", 0, -NAME_H)
        self.questMark = UI.Diamond(self.quest, 8, "gilt")
        self.questMark:SetPoint("LEFT", 0, 0)
        self.questCount = UI.Text(self.quest, "micro", "gilt-text")
        self.questCount:SetShadowed(true)
        self.questCount:SetPoint("LEFT", self.questMark, "RIGHT", 3, 0)
        self.quest:Hide()
        self.badge = UI.StateBadge(self, "danger", "")
        self.badge:SetPoint("RIGHT", self.pct, "LEFT", -S["space-2"], 0)
        self.badge:Hide()

        -- the bar
        local bar = CreateFrame("Frame", nil, self)
        bar:SetPoint("BOTTOMLEFT")
        bar:SetPoint("BOTTOMRIGHT")
        bar:SetHeight(barH())
        UI.Fill(bar, "surface-sunk"):SetAllPoints()
        self.bar = bar
        local inner = CreateFrame("Frame", nil, bar)
        inner:SetPoint("TOPLEFT", 1, -1)
        inner:SetPoint("BOTTOMRIGHT", -1, 1)
        inner:SetClipsChildren(true)
        -- the damage ghost behind the fill, as on the unit frames: it trails the
        -- health after a hold and the engine eases it down (asked 2026-10-19)
        self.ghost = CreateFrame("StatusBar", nil, inner)
        self.ghost:SetAllPoints()
        self.ghost:SetStatusBarTexture(WHITE)
        self.ghost:GetStatusBarTexture():SetSnapToPixelGrid(false)
        UI.Paint(self.ghost, "ghost")
        self.health = CreateFrame("StatusBar", nil, inner)
        self.health:SetAllPoints()
        self.health:SetStatusBarTexture(WHITE)
        self.health:SetFrameLevel(self.ghost:GetFrameLevel() + 1)
        gradient(self.health, "unit-fill-deep", "unit-fill")
        self.healthLow = CreateFrame("StatusBar", nil, inner)
        self.healthLow:SetAllPoints()
        self.healthLow:SetStatusBarTexture(WHITE)
        gradient(self.healthLow, "unit-fill-low-deep", "unit-fill-low")
        self.healthLow:SetFrameLevel(self.health:GetFrameLevel() + 1)
        self.healthLow:SetAlpha(0)
        local edge = CreateFrame("Frame", nil, bar)
        edge:SetAllPoints()
        edge:SetFrameLevel(self.healthLow:GetFrameLevel() + 1)
        self.border = UI.Border(edge, "gilt-hairline")
        -- rare and elite: the small crest just outside the bar's right end, as
        -- the raid marker sits outside the left (design "Rare and elite units" B)
        self.crest = UI.Crest(edge, "plate")
        self.crest:SetPoint("CENTER", bar, "RIGHT", 7.5, 0)
        -- or the game's elite dragon round the right end, over the bar as on
        -- the target frame (design "Elite dragon (with crest B)" D)
        local dragonHost = CreateFrame("Frame", nil, bar)
        dragonHost:SetAllPoints()
        dragonHost:SetFrameLevel(edge:GetFrameLevel() + 1)
        self.dragon = dragonHost:CreateTexture(nil, "ARTWORK")
        self.dragon:Hide()
        self.glow = UI.Shadow(bar, "glow-ember")
        self.glow:SetShown(false)

        -- the cast, under the bar
        self.cast = UI.CastBar(self, "none", { size = "plate", width = w, icon = false, target = true })
        self.cast:SetBarHeight(M:Get("castHeight"))
        self.cast:SetTargetShown(M:Get("castTarget"))
        self.cast:SetKickShown(M:Get("castKick"))
        self.cast:SetPoint("TOPLEFT", self, "BOTTOMLEFT", 0, -S["space-1"])
        SuuUI.TagInstance(self.cast, { module = M.id, role = "nameplate" })
        SuuUI.AddInstance("nameplate", self, { module = M.id, preview = api ~= nil or nil })
    end

    -- Your debuffs on it, above the name (the engine fills them).
    function BuildAuras()
        local auras = UI.AuraContainer(self, "none", { size = M:Get("auraSize"), spacing = S["space-1"], anchor = "BOTTOMLEFT", growth = { "RIGHT", "UP" },
            groups = {
                { key = "mine", filter = { "HARMFUL", "PLAYER" }, max = 4, harmfulEdge = true },
                -- on friendly plates: what you can remove, with its type's border
                { key = "removable", filter = { "HARMFUL", "RAID_PLAYER_DISPELLABLE" }, max = 0, dispel = true, harmfulEdge = true },
            } })
        self.auras = auras
        if auras then auras.container:SetPoint("BOTTOMLEFT", self, "TOPLEFT", 0, S["space-1"]) end
    end

    function SetPlateWidth(w: number)
        self:SetSize(w, plateH())
        self.bar:SetHeight(barH())
        local mode: string = M:Get("healthText")
        local textW = PCT_W[mode] or 32
        -- the badge left of the health text, or at the row's end without one
        if self.textMode ~= mode then
            self.textMode = mode
            self.badge:ClearAllPoints()
            if textW > 0 then
                self.badge:SetPoint("RIGHT", self.pct, "LEFT", -S["space-2"], 0)
            else
                self.badge:SetPoint("RIGHT", self, "TOPRIGHT", 0, -NAME_H / 2)
            end
        end
        self.name:SetWidth(math.max(20, w - self.questW - self.levelW - (textW > 0 and textW + S["space-2"] or 0)
            - (self.badge:IsShown() and self.badge.knownWidth + S["space-2"] or 0)))
    end

    function UpdateQuest()
        local text: string | false = false
        local u = self.unit
        if M:Get("questMarks") and not self.friendly and u then
            if self.preview then text = self.previewQuest or false else text = questText(u) end
        end
        local w = 0
        if text then
            self.questCount:SetValue(text)
            self.questCount:SetShown(text ~= "")
            local qw = 8 + (text ~= "" and (3 + math.ceil(self.questCount:GetUnboundedStringWidth())) or 0)
            self.quest:SetWidth(qw)
            w = qw + S["space-2"]
        end
        self.quest:SetShown(text ~= false)
        self.questW = w
        self:PlaceName()
    end

    -- The quest mark, the level, then the name.
    function PlaceName()
        local x = self.questW
        self.level:ClearAllPoints()
        self.level:SetPoint("BOTTOMLEFT", self, "TOPLEFT", x, -NAME_H + 1)
        self.name:ClearAllPoints()
        self.name:SetPoint("BOTTOMLEFT", self, "TOPLEFT", x + self.levelW, -NAME_H)
        self:SetPlateWidth(M:Get("width"))
    end

    function UpdateLevel()
        local A, u = self.api, self.unit
        if not u then return end
        local text: string? = nil
        -- the rare and elite crest (or the dragon), whether the level shows or not
        local okCrest, kind = pcall(A.UnitClassification or UnitClassification, u)
        local classification = okCrest and kind or nil
        local okBoss, boss = pcall(A.UnitIsBossMob or UnitIsBossMob, u)
        local art = M:Get("eliteDragon") and UI.DragonArt(classification, okBoss and boss or nil)
        self.crest:SetClassification(not art and classification or nil)
        UI.PlaceDragon(self.dragon, art, self.bar, self.bar:GetHeight())
        if M:Get("levels") then
            local ok, level = pcall(A.UnitLevel, u)
            local lv = ok and asNumber(level) or nil
            if lv then
                local c = asString(classification)
                local elite = c and ELITE[c]
                -- "25+" an elite, "??" a boss or one far above you (the design's
                -- direction A, chosen 2026-10-18; after a quest mark, as asked)
                local isBoss = c == "worldboss" or lv <= 0
                text = isBoss and "??" or (tostring(lv) .. (elite and "+" or ""))
                self.level:SetColor(UI.LevelColor(lv))
            end
        end
        self.level:SetValue(text or "")
        self.level:SetShown(text ~= nil)
        -- space-2 to the name, as after a quest mark (space-1 read cramped in game)
        self.levelW = text and (math.ceil(self.level:GetUnboundedStringWidth()) + S["space-2"]) or 0
        self:PlaceName()
    end

    -- `instant`: a plate given a unit (the ghost isn't the last mob's).
    function UpdateHealth(instant: boolean?)
        local A, u = self.api, self.unit
        if not u then return end
        local max, cur = A.UnitHealthMax(u), A.UnitHealth(u)
        self.health:SetMinMaxValues(0, amount(max, 1))
        self.health:SetValue(amount(cur))
        self.ghost:SetMinMaxValues(0, amount(max, 1))
        local timer = self.ghostTimer
        if instant or not INTERPOLATE then
            if timer then timer:Cancel() self.ghostTimer = nil end
            self.ghost:SetValue(amount(cur))
        else
            self.ghostValue = amount(cur)
            if not timer then
                self.ghostTimer = after(GHOST_HOLD, function()
                    self.ghostTimer = nil
                    self.ghost:SetValue(self.ghostValue, INTERPOLATE)
                end)
            end
        end
        self.healthLow:SetMinMaxValues(0, amount(max, 1))
        self.healthLow:SetValue(amount(cur))
        local curve = belowLow()
        local percent = A.UnitHealthPercent
        if curve and percent then
            self.healthLow:SetAlpha(amount(percent(u, true, curve)))
        else
            self.healthLow:SetAlpha(0)
        end
        -- The health text: the percentage through a curve, the value through
        -- AbbreviateNumbers (a secret health gives a secret string). Neither is
        -- ever tested: they go to the engine's formatting as they are.
        local mode: string = M:Get("healthText")
        -- (never tested: a secret can't be, not even against nil; the flags say)
        local pct: number | Secret<number> = 0
        local value: string | Secret<string> = ""
        local hasPct = (mode == "percent" or mode == "both") and percent ~= nil and CurveConstants ~= nil
        local hasValue = false -- a plain flag: the value itself may be secret
        if hasPct and percent then
            local p = percent(u, true, CurveConstants.ScaleTo100)
            pct = isSecret(p) and p or (p or 0) + 0.5
        end
        if mode == "value" or mode == "both" then
            local ok, text = pcall(AbbreviateNumbers, amount(cur))
            if ok then value, hasValue = text, true end
        end
        if mode == "both" and hasPct and hasValue then
            self.pct:SetFormattedText("%s · %d%%", value, pct)
        elseif mode ~= "percent" and hasValue then
            self.pct:SetText(value)
        elseif hasPct then
            self.pct:SetFormattedText("%d%%", pct)
        else
            self.pct:Hide()
            return
        end
        self.pct:Show()
    end

    function UpdateName()
        local A, u = self.api, self.unit
        if not u then return end
        self.name:SetText(A.UnitName(u))
        local r = asNumber(A.UnitReaction(u, "player"))
        self.name:SetColor(r and (REACTION[r] or "reaction-friendly") or "reaction-hostile")
        -- friendly players in their class colour (never tested: may be secret)
        if self.friendly then
            local okPlayer, player = pcall(A.UnitIsPlayer, u)
            if okPlayer and flag(player) then
                local _, class = A.UnitClass(u)
                if class ~= nil then
                    local c = errors.tryValue(C_ClassColor.GetClassColor, class)
                    if c then pcall(self.name.SetTextColor, self.name, c:GetRGB()) end
                end
            end
        end
    end

    -- Threat (readable on plates): non-tank Aggro, tank Losing / Aggro; solo
    -- as a non-tank.
    function UpdateThreat()
        local A, u = self.api, self.unit
        local tone: string?, word: string? = nil, nil
        -- never on players or their pets and totems (no threat table: an enemy
        -- player's pet showed Aggro in a battleground, 2026-10-18)
        local controlled = u ~= nil and not self.preview and flag(errors.tryValue(UnitPlayerControlled, u))
        local situation = A.UnitThreatSituation
        if u and situation and M:Get("threat") and not self.friendly and not controlled then
            local status = asNumber(situation("player", u))
            if status then
                local tank
                if self.preview then tank = self.previewRole == "TANK" else tank = IsInGroup() and SuuUI.Role() == "TANK" end
                if tank then
                    if status == 2 then tone, word = "warning", "Losing"
                    elseif status <= 1 then tone, word = "danger", "Aggro" end
                elseif status >= 2 then
                    tone, word = "danger", "Aggro"
                end
            end
        end
        self.state = tone
        -- the state first, while a new badge is still hidden: it fades in each
        -- time it appears
        if tone then self.badge:SetState(tone, word or "") end
        self.badge:SetShown(tone ~= nil)
        self:SetPlateWidth(M:Get("width"))
        self:UpdateBorder()
    end

    function UpdateBorder()
        local color = "gilt-hairline"
        if self.state == "danger" then color = "ember"
        elseif self.state == "warning" then color = "amber"
        elseif self.isTarget then color = "ink" end
        self.border:SetColor(color)
        self.glow:SetShown(self.state == "danger")
    end

    -- Your target at full opacity with an ink border; with a target, the rest dim.
    function UpdateTarget()
        local A, u = self.api, self.unit
        if not u then return end
        self.isTarget = secret.asBoolean(A.UnitIsUnit(u, "target")) == true
        local dim = M:Get("dimOthers") and not self.isTarget and (self.preview or UnitExists("target"))
        self:SetAlpha(dim and T.opacity["opacity-plate"] or 1)
        self:UpdateBorder()
    end

    function UpdateRaidMarker()
        if not M:Get("raidMarker") then
            self.raidMarker:Hide()
            return
        end
        UI.ShowRaidMarker(self.raidMarker, self.unit, self.api)
    end

    function Refresh()
        self:UpdateRaidMarker()
        self:UpdateQuest()
        self:UpdateLevel()
        self:UpdateName()
        self:UpdateHealth(true)
        self:UpdateThreat()
        self:UpdateTarget()
    end

    -- Its unit's events (its unit token changes as plates are reused).
    function Listen()
        local events = self.events
        if not events then
            local made = CreateFrame("Frame")
            made:SetScript("OnEvent", function(_: Frame, event: string)
                if not self.unit then return end
                if event == "UNIT_NAME_UPDATE" then self:UpdateName()
                elseif event == "UNIT_THREAT_LIST_UPDATE" then self:UpdateThreat()
                else self:UpdateHealth() end
            end)
            self.events = made
            events = made
        end
        events:UnregisterAllEvents()
        local u = self.unit
        if not u then return end
        for _, e in ipairs(PLATE_EVENTS) do pcall(events.RegisterUnitEvent, events, e, u) end
    end
end

--------------------------------------------------------------------------------
-- The pool
--------------------------------------------------------------------------------

local pool: Nameplate[] = {}

-- Plates are made ahead (an aura container is dear: a plate built while
-- they pour in took 6.8 ms, /suu perf): POOL ready out of combat, topped up
-- one a frame while the pool runs low.
local POOL, POOL_LOW = 24, 8
local filling = false

local function newPlate(): Nameplate
    local f = Nameplate.new(UIParent)
    f:BuildAuras()
    return f
end

local function fill()
    if filling then return end
    filling = true
    local function step()
        if InCombatLockdown() or #pool >= POOL then filling = false return end
        local f = newPlate()
        f:Hide()
        pool[#pool + 1] = f
        after(0, step)
    end
    after(0, step)
end

local function acquire(): Nameplate
    local f = table.remove(pool) or newPlate()
    if #pool < POOL_LOW then fill() end
    return f
end

local function release(f: Nameplate)
    local events = f.events
    if events then events:UnregisterAllEvents() end
    f.cast:Deactivate()
    local auras = f.auras
    if auras then auras:SetUnit("none") end
    f.unit, f.friendly = nil, false
    f:Hide()
    f:ClearAllPoints()
    f:SetParent(UIParent)
    pool[#pool + 1] = f
end

-- A SuuUI plate sits on Blizzard's with the bar's middle on its centre.
local function anchor(f: Nameplate, plate: Region)
    f:ClearAllPoints()
    f:SetPoint("BOTTOM", plate, "CENTER", 0, -(barH() / 2))
end

-- The game's "show friendly players' plates": current clients call it
-- nameplateShowFriendlyPlayers, older ones nameplateShowFriends. Written to
-- whichever this client has (an unknown name reads back nil).
local FRIENDLY_CVARS = { "nameplateShowFriendlyPlayers", "nameplateShowFriends" }

local function showFriendly(on: boolean)
    for _, name in ipairs(FRIENDLY_CVARS) do
        if C_CVar.GetCVar(name) ~= nil then pcall(C_CVar.SetCVar, name, on and "1" or "0") end
    end
end

--------------------------------------------------------------------------------
-- Nameplate settings of the game: full alpha and scale (SuuUI dims itself),
-- out of combat only (the CVars are protected in combat)
--------------------------------------------------------------------------------

local CVARS = {
    nameplateMinAlpha = "1", nameplateMaxAlpha = "1", nameplateSelectedAlpha = "1", nameplateNotSelectedAlpha = "1",
    nameplateMinScale = "1", nameplateMaxScale = "1", nameplateSelectedScale = "1",
}

--------------------------------------------------------------------------------
-- The preview: made-up plates (the design's), your target first
--------------------------------------------------------------------------------

type PreviewCast = { name: string, icon: number, progress: number, time: string, target?: string, targetClass?: string, locked?: boolean }
type PreviewPerson = { name: string, marker?: number, health: number, max: number, reaction: number, target?: boolean,
                       threat?: number, debuffs?: number[], debuffType?: string, quest?: string, friendly?: boolean,
                       class?: string, cast?: PreviewCast }
local PEOPLE: PreviewPerson[] = {
    { name = "Cinder Acolyte", marker = 8, health = 0.62, max = 13800, reaction = 2, target = true, threat = 3, debuffs = { 1978, 1130 }, cast = { name = "Flame Lash", icon = 133, progress = 0.55, time = "0.9s", target = "Kaelith", targetClass = "PRIEST" } },
    { name = "Ember Hound", marker = 7, health = 0.81, max = 8400, reaction = 2, threat = 2, quest = "3/8" },
    { name = "Ashbound Ritualist", health = 0.28, max = 11200, reaction = 2, threat = 0, cast = { name = "Rain of Ash", icon = 5740, progress = 0.3, time = "1.9s", locked = true } },
    { name = "Dusk Prowler", health = 1, max = 6900, reaction = 4 },
    { name = "Ysolde", health = 0.9, max = 3900, reaction = 5, friendly = true, class = "PALADIN", debuffs = { 702 }, debuffType = "Curse",
      cast = { name = "Flash of Light", icon = 19750, progress = 0.7, time = "0.4s" } },
}

local function person(unit: string): PreviewPerson return PEOPLE[tonumber(unit:match("(%d)$")) or 1] or PEOPLE[1] end

-- The preview's stand-in for the game's unit functions.
local function previewApi(): UnitApi
    local api = UI.UnitStandIn(function(u: string): StandInPerson
        local p = person(u)
        return { name = p.name, class = p.class, health = p.health, max = p.max, marker = p.marker }
    end)
    api.UnitReaction = function(u: string, _: string): number return person(u).reaction end
    api.UnitHealthPercent = function(u: string, _: boolean?, curve: CurveObjectBase?): number
        local h = person(u).health
        if CurveConstants and curve == CurveConstants.ScaleTo100 then return h * 100 end
        return h < LOW and 1 or 0 -- the plate's low-health curve
    end
    api.UnitThreatSituation = function(_: string, u: string?): number? return u and person(u).threat end
    api.UnitIsUnit = function(u: string, other: string): boolean return other == "target" and person(u).target == true end
    return api
end

-- The preview's drawn cast and debuffs on a plate.
local function addFakes(f: Nameplate, castH: number): Fakes
    local cast = CreateFrame("StatusBar", nil, f)
    cast:SetPoint("TOPLEFT", f, "BOTTOMLEFT", 0, -S["space-1"])
    cast:SetSize(1, castH)
    cast:SetStatusBarTexture(WHITE)
    local castBorder = UI.Border(cast, "gilt-hairline")
    -- the spell's icon leading the line; the lock inside the bar's left end
    local icon = UI.Icon(f, 13)
    icon:SetPoint("TOPLEFT", cast, "BOTTOMLEFT", 0, -S["space-1"])
    local lock = CreateFrame("Frame", nil, cast)
    lock:SetAllPoints()
    lock:SetFrameLevel(cast:GetFrameLevel() + 3)
    local lockArt = lock:CreateTexture(nil, "OVERLAY")
    lockArt:SetTexture("Interface\\LFGFrame\\UI-LFG-ICON-LOCK")
    lockArt:SetDesaturated(true)
    UI.Paint(lockArt, "ink")
    lockArt:SetPoint("LEFT", 2, 0)
    local spell = UI.Text(f, "caption", "ink")
    spell:SetShadowed(true)
    spell:SetPoint("LEFT", icon, "RIGHT", S["space-2"], 0)
    local target = UI.Text(f, "caption", "ink")
    target:SetShadowed(true)
    target:SetPoint("TOPLEFT", icon, "BOTTOMLEFT", 13 + S["space-2"], 0)
    local time = UI.Text(f, "caption", "ink")
    time:SetShadowed(true)
    time:SetPoint("TOPRIGHT", cast, "BOTTOMRIGHT", 0, -S["space-1"])
    local icons: Icon[] = {}
    for k = 1, 4 do
        local i = UI.Icon(f, "icon-sm")
        i:Hide()
        icons[k] = i
    end
    return { cast = cast, castBorder = castBorder, icon = icon, lock = lock, lockArt = lockArt,
             spell = spell, target = target, time = time, icons = icons }
end

-- The cast rows wait for cast bars.
local function castBarsOff(): (boolean, string?)
    if not M:Get("castBars") then return true, "Turn Cast bars on first." end
    return false
end

local SECTION = {
    id = "nameplates", label = "Nameplates", category = "Frames", order = 20,
    preview = function(parent: Frame): Frame return M:PreviewView(parent) end,
    groups = {
        { title = "Nameplates", rows = {
            { key = "showPlates", label = "Nameplates", control = "toggle", combat = true,
              description = "Off: no nameplates at all, enemies' or friends' (the game's own nameplate settings, kept off until you turn this on again)." },
        } },
        { title = "Size", description = "SuuUI's plates on enemies. Turning the module off brings Blizzard's back after a reload.", rows = {
            { key = "width", label = "Width", control = "slider", min = 100, max = 200, step = 2, unit = "px", live = false },
            { key = "barHeight", label = "Health bar height", control = "slider", min = 4, max = 24, step = 1, unit = "px", live = false },
            { key = "auraSize", label = "Debuff size", control = "slider", min = 12, max = 28, step = 1, unit = "px", live = false, combat = true,
              disabled = function(): (boolean, string?)
                  if M:Get("auras") == 0 then return true, "Set Debuff icons above 0 first." end
                  return false
              end },
            { key = "castHeight", label = "Cast bar height", control = "slider", min = 4, max = 20, step = 1, unit = "px", live = false,
              disabled = castBarsOff },
        } },
        { title = "Casts", rows = {
            { key = "castBars", label = "Cast bars", control = "toggle",
              description = "Under the bar: arcane when you can interrupt it, a lock when you can't." },
            { key = "castTarget", label = "Cast target", control = "toggle",
              description = "Who the spell is aimed at, under the spell name, in their class colour.", disabled = castBarsOff },
            { key = "castKick", label = "Your interrupt", control = "toggle",
              description = "On interruptible casts: a diamond in arcane when your interrupt is ready, its seconds when it isn't.", disabled = castBarsOff },
        } },
        { title = "On the plate", rows = {
            { key = "auras", label = "Debuff icons", control = "stepper", min = 0, max = 4, step = 1,
              description = "Above the name, with their time. Only yours." },
            { key = "levels", label = "Level", control = "toggle",
              description = "The level before the name (after a quest mark), coloured by how hard it is for you (green, yellow, orange, red; grey when it gives nothing). A + for elites, ?? for bosses. Friendly plates too." },
            { key = "eliteDragon", label = "Elite dragon", control = "toggle",
              description = "The game's own dragon round the bar's right end for elites, rares and bosses, in place of the crest; friendly and neutral NPCs too." },
            { key = "healthText", label = "Health text", control = "segmented",
              options = { { value = "percent", label = "64%" }, { value = "value", label = "8.5k" },
                          { value = "both", label = "8.5k · 64%" }, { value = "none", label = "None" } },
              description = "At the right end of the name row: the health percentage, the current health, or both." },
            { key = "threat", label = "Threat badges", control = "toggle",
              description = "Aggro when a mob attacks you. As a tank in a group: Losing when it's about to leave you, Aggro when it has." },
            { key = "raidMarker", label = "Raid markers", control = "toggle",
              description = "Skull, cross and the rest, just left of the plate." },
            { key = "questMarks", label = "Quest objectives", control = "toggle",
              description = "A gilt mark left of the name on mobs your quests still need, with what you have (3/8)." },
            { key = "dimOthers", label = "Dim all but your target", control = "toggle",
              description = "With a target, other plates rest at 72% so yours reads first." },
        } },
        { title = "Friendly nameplates", rows = {
            { key = "friendlyOpenWorld", label = "Only in the open world", control = "toggle", combat = true,
              description = "Friendly players' plates show in the open world and hide in dungeons and raids. Turning it off brings them back everywhere; from then on the game's own nameplate setting decides." },
            { key = "friendlyNPCs", label = "Friendly NPCs", control = "toggle", combat = true,
              description = "Plates for friendly NPCs too (guards, vendors, quest givers), in the open world. Turning it off hands the game's own setting back." },
            { key = "friendlyStyle", label = "SuuUI's look", control = "toggle",
              description = "In the open world: the name in its class colour, the bar, the health text, the debuffs you can remove and casts. Inside dungeons, raids, battlegrounds and arenas the game keeps its own." },
        } },
    },
}

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

class NameplatesModule extends Module<typeof(DEFAULTS)>
    -- a plate that read as friendly, looked at once more
    readonly recheck: { [string]: boolean } = {}
    previewView: Frame? = nil
    previewPlates: Nameplate[] = {}

    constructor()
        super({
            id = "nameplates",
            name = "Nameplates",
            description = "Enemy nameplates: your debuffs, name, health, threat and casts.",
            api = "0.9",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function OnPlateAdded(unit: string)
        local plate = errors.tryValue(C_NamePlate.GetNamePlateForUnit, unit)
        if not plate or plate:IsForbidden() then return end
        local uf = plate.UnitFrame
        local old = byUnit[unit]
        if old then release(old); byUnit[unit] = nil end
        -- your own plate (the personal resource display) stays Blizzard's
        if flag(UnitIsUnit(unit, "player")) then
            restoreBlizzard(uf)
            return
        end
        local friendly = not flag(UnitCanAttack("player", unit))
        if friendly and self:FriendlyStyled() then
            -- a friendly plate now; the recheck below still turns it into an
            -- enemy's if the unit only read as friendly on its first frame
            self:Attach(unit, plate, true)
        elseif friendly then
            restoreBlizzard(uf)
        end
        if friendly then
            -- an enemy can read as not attackable on its plate's first frame:
            -- look once more
            if not self.recheck[unit] then
                self.recheck[unit] = true
                after(0.2, function()
                    self.recheck[unit] = nil
                    local f = byUnit[unit]
                    if self:IsEnabled() and UnitExists(unit) and flag(UnitCanAttack("player", unit)) and (not f or f.friendly) then self:OnPlateAdded(unit) end
                end)
            end
            return
        end
        self:Attach(unit, plate, false)
    end

    -- A plate whose unit may have changed sides (a duel): laid again only when
    -- it did, otherwise just redrawn.
    function Recheck(unit: string)
        local f = byUnit[unit]
        if f and f.friendly == not flag(UnitCanAttack("player", unit)) then
            f:Refresh()
            return
        end
        self:OnPlateAdded(unit)
    end

    -- SuuUI's friendly plates: open world only. Wider than the friendly CVar
    -- (ApplyFriendly), on purpose: the game locks friendly plates in battlegrounds
    -- and arenas too, so SuuUI's look is off there although they stay shown.
    function FriendlyStyled(): boolean
        if not self:Get("friendlyStyle") then return false end
        return not inInstance(true)
    end

    -- Lays a SuuUI plate on Blizzard's: an enemy's, or a friendly one (name,
    -- bar and health text only).
    function Attach(unit: string, plate: Frame, friendly: boolean)
        local uf = frames.asFrame(field(plate, "UnitFrame"))
        if uf and uf:IsForbidden() then return end
        hideBlizzard(uf)
        local f = acquire()
        f.unit, f.friendly = unit, friendly
        questCache[unit] = nil
        byUnit[unit] = f
        f:SetParent(plate)
        anchor(f, plate)
        f:SetFrameLevel(plate:GetFrameLevel() + 2)
        f:SetPlateWidth(self:Get("width"))
        f:Listen()
        local auras = f.auras
        if auras then
            self:ApplyAuraCount(f)
            auras:SetUnit(unit)
        end
        f.cast:SetNeutral(friendly)
        if self:Get("castBars") then
            f.cast:SetUnit(unit)
            if not f.cast.active then f.cast:Activate() end
        else
            f.cast:Deactivate()
        end
        f:Refresh()
        f:Show()
    end

    function OnPlateRemoved(unit: string)
        questCache[unit] = nil
        local f = byUnit[unit]
        if f then
            byUnit[unit] = nil
            release(f)
        end
    end

    function ApplyAuraCount(f: Nameplate)
        local auras = f.auras
        if not auras then return end
        local n: number = self:Get("auras")
        auras:SetGroupMax("mine", f.friendly and 0 or n)
        auras:SetGroupMax("removable", f.friendly and n or 0)
    end

    function ForEach(fn: (f: Nameplate) -> ())
        for _, f in pairs(byUnit) do fn(f) end
        for _, f in ipairs(self.previewPlates) do fn(f) end
    end

    -- The sizes and cast options on every live, pooled and preview plate. Aura
    -- icons resize out of combat only (the engine's buttons refuse it in combat).
    function ApplySizes()
        local function each(fn: (f: Nameplate) -> ())
            for _, f in pairs(byUnit) do fn(f) end
            for _, f in ipairs(pool) do fn(f) end
        end
        local w: number = self:Get("width")
        local function apply(f: Nameplate)
            f.cast.totalW = w
            f.cast:SetWidth(w)
            f.cast:Arrange()
            f.cast:SetBarHeight(self:Get("castHeight"))
            f.cast:SetTargetShown(self:Get("castTarget"))
            f.cast:SetKickShown(self:Get("castKick"))
            f:SetPlateWidth(w)
        end
        each(apply)
        for _, f in ipairs(self.previewPlates) do apply(f) end
        -- the bar's middle stays on Blizzard's plate's centre
        for _, f in pairs(byUnit) do
            local plate = f:GetParent()
            if plate then anchor(f, plate) end
        end
        self:RunOutOfCombat("auraSize", function()
            each(function(f: Nameplate)
                local auras = f.auras
                if auras then
                    auras:SetGroupSize("mine", self:Get("auraSize"))
                    auras:SetGroupSize("removable", self:Get("auraSize"))
                end
            end)
        end)
    end

    function ApplyGameSettings()
        self:RunOutOfCombat("cvars", function()
            for k, v in pairs(CVARS) do pcall(C_CVar.SetCVar, k, v) end
            errors.try(C_NamePlate.SetNamePlateSize, self:Get("width"), plateH() + 8)
        end)
    end

    -- No nameplates at all (the game's enemy and friendly plate settings off):
    -- a choice of its own, kept until it's turned on again, which brings the
    -- enemies' back and leaves the friendly ones to the setting above.
    function ApplyShown(changed: boolean?)
        if self:Get("showPlates") and not changed then return end
        self:RunOutOfCombat("shown", function()
            local on = self:Get("showPlates")
            if C_CVar.GetCVar("nameplateShowEnemies") ~= nil then pcall(C_CVar.SetCVar, "nameplateShowEnemies", on and "1" or "0") end
            if on then self:ApplyFriendly(true) else showFriendly(false) end
        end)
    end

    -- Friendly NPCs' plates (guards, vendors, quest givers): the game shows none
    -- unless its own setting is on. With this, in the open world only, as the
    -- friendly players' (asked 2026-10-18: their level, as on every plate).
    -- Turned off, the game's setting goes back off once and is yours again.
    function ApplyFriendlyNPCs(released: boolean?)
        if not self:Get("friendlyNPCs") and not released then return end
        self:RunOutOfCombat("friendlyNPCs", function()
            if C_CVar.GetCVar("nameplateShowFriendlyNPCs") == nil then return end
            local on = self:Get("showPlates") and self:Get("friendlyNPCs") and not inInstance()
            pcall(C_CVar.SetCVar, "nameplateShowFriendlyNPCs", on and "1" or "0")
        end)
    end

    -- Friendly players' plates in the open world only: inside a dungeon or raid
    -- the game locks them, and in a group they mostly cover the fight. Narrower
    -- than FriendlyStyled, on purpose: in battlegrounds and arenas they stay
    -- shown (Blizzard's look). SuuUI owns the game's setting while this is on;
    -- turned off (`released`), the plates come back once and the game's setting
    -- is yours again.
    function ApplyFriendly(released: boolean?)
        if not self:Get("showPlates") then return end
        if not self:Get("friendlyOpenWorld") and not released then return end
        self:RunOutOfCombat("friendly", function()
            -- read again: the setting may have changed while combat lasted
            showFriendly(not (self:Get("friendlyOpenWorld") and inInstance()))
        end)
    end

    function PreviewView(parent: Frame): Frame
        local view = self.previewView
        if not view then
            local api = previewApi()
            local made = CreateFrame("Frame", nil, parent)
            self.previewView = made
            view = made
            for i = 1, #PEOPLE do
                local f = Nameplate.new(made, api)
                f.unit, f.preview, f.previewRole, f.friendly = "plate" .. i, true, "TANK", PEOPLE[i].friendly == true
                f.previewQuest = PEOPLE[i].quest
                f.cast:Hide()
                -- a drawn cast and drawn debuffs (the engine draws the real ones)
                f.fakes = addFakes(f, self:Get("castHeight"))
                self.previewPlates[i] = f
            end
        end
        view:SetParent(parent)
        self:DrawPreview()
        return view
    end

    function DrawPreview()
        local view = self.previewView
        if not view then return end
        local w: number, auraPx: number, castPx: number = self:Get("width"), self:Get("auraSize"), self:Get("castHeight")
        -- room for the raid markers left of the plates, so the view centres whole
        local markerW = self:Get("raidMarker") and (18 + S["space-2"]) or 0
        local y = 0
        for i, f in ipairs(self.previewPlates) do
            local d = PEOPLE[i]
            local fakes = f.fakes
            f:SetShown(not d.friendly or self:Get("friendlyStyle"))
            if not f:IsShown() or not fakes then break end
            f:SetPlateWidth(w)
            f:Refresh()
            f:ClearAllPoints()
            local top = (d.debuffs and self:Get("auras") > 0) and (auraPx + S["space-1"] * 2) or 0
            f:SetPoint("TOPLEFT", view, "TOPLEFT", markerW, -(y + top + NAME_H))
            f:Show()
            for k, icon in ipairs(fakes.icons) do
                local id = d.debuffs and d.debuffs[k]
                icon:SetSize(auraPx, auraPx)
                icon:ClearAllPoints()
                icon:SetPoint("BOTTOMLEFT", f, "TOPLEFT", (k - 1) * (auraPx + S["space-1"]), S["space-1"])
                icon:SetShown(id ~= nil and k <= self:Get("auras"))
                if id then icon:SetArt(C_Spell.GetSpellTexture(id)) end
                icon:SetBorder(d.debuffType and ("dispel-" .. d.debuffType:lower()) or "gilt-hairline")
            end
            local cast = self:Get("castBars") and d.cast or nil
            fakes.cast:SetShown(cast ~= nil)
            fakes.spell:SetShown(cast ~= nil)
            fakes.icon:SetShown(cast ~= nil)
            local target = cast and self:Get("castTarget") and cast.target or nil
            fakes.target:SetShown(target ~= nil)
            fakes.time:SetShown(cast ~= nil)
            local castH = 0
            if cast then
                fakes.cast:SetSize(w, castPx)
                fakes.cast:SetMinMaxValues(0, 1)
                fakes.cast:SetValue(cast.progress)
                local stoppable = not (cast.locked or d.friendly)
                UI.Paint(fakes.cast, stoppable and "arcane-glow" or "unit-fill")
                fakes.castBorder:SetColor(stoppable and "arcane" or "gilt-hairline")
                fakes.spell:SetValue(cast.name)
                fakes.icon:SetArt(C_Spell.GetSpellTexture(cast.icon))
                fakes.lock:SetShown(cast.locked == true)
                fakes.lockArt:SetSize(math.max(8, castPx), math.max(8, castPx))
                fakes.time:SetValue(cast.time)
                castH = castPx + 13 + S["space-1"] * 2 + (target and 13 or 0)
                if target then
                    local r, g, b = UI.RGBA("ink-muted")
                    fakes.target:SetText(("|cff%02x%02x%02x›|r %s"):format(r * 255, g * 255, b * 255, target))
                    local c = errors.tryValue(C_ClassColor.GetClassColor, cast.targetClass or "PRIEST")
                    if c then fakes.target:SetTextColor(c:GetRGB()) end
                end
            end
            y = y + top + plateH() + castH + S["space-6"]
        end
        view:SetSize(markerW + w, y)
    end

    override function OnEnable()
        self:RegisterSettings(SECTION)
        self:ApplyGameSettings()
        self:ApplyShown()
        self:ApplyFriendly()
        self:ApplyFriendlyNPCs()
        -- your level up: the plates' levels change colour
        self:OnGameEvent("PLAYER_LEVEL_UP", function()
            after(0.5, function() for _, f in pairs(byUnit) do f:UpdateLevel() end end)
        end)
        self:OnGameEvent("PLAYER_ENTERING_WORLD", function()
            self:ApplyShown()
            self:ApplyFriendly()
            self:ApplyFriendlyNPCs()
            wipe(questCache)
        end)
        -- quest progress: read every plate's objective again (once per burst)
        local questDirty = false
        local function questsChanged()
            wipe(questCache)
            if questDirty then return end
            questDirty = true
            after(0.5, function()
                questDirty = false
                for _, f in pairs(byUnit) do f:UpdateQuest() end
            end)
        end
        -- only when objectives change: QUEST_LOG_UPDATE fires all the time, and
        -- every plate's tooltip read again each time was most of the module's
        -- time (/suu perf)
        for _, e in ipairs({ "QUEST_WATCH_UPDATE", "QUEST_ACCEPTED", "QUEST_REMOVED", "QUEST_TURNED_IN" }) do
            self:OnGameEvent(e, questsChanged)
        end
        self:OnGameEvent("UNIT_QUEST_LOG_CHANGED", function(_, unit) if unit == "player" then questsChanged() end end)
        self:OnGameEvent("ZONE_CHANGED_NEW_AREA", function() self:ApplyFriendly() end)
        self:Watch("friendlyOpenWorld", function() self:ApplyFriendly(true) end)
        self:Watch("showPlates", function() self:ApplyShown(true); self:ApplyFriendlyNPCs(true) end)
        self:Watch("friendlyNPCs", function() self:ApplyFriendlyNPCs(true) end)
        self:Watch("friendlyStyle", function()
            for i = 1, 40 do
                local unit = "nameplate" .. i
                if UnitExists(unit) then self:OnPlateAdded(unit) end
            end
            self:DrawPreview()
        end)
        -- plates (and their aura containers) made ahead, out of combat
        self:RunOutOfCombat("pool", function() fill() end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function() if #pool < POOL then fill() end end)
        -- plates already up (a reload next to mobs)
        for i = 1, 40 do
            local unit = "nameplate" .. i
            if UnitExists(unit) then self:OnPlateAdded(unit) end
        end
        self:OnGameEvent("NAME_PLATE_UNIT_ADDED", function(_, unit) self:OnPlateAdded(unit) end)
        self:OnGameEvent("NAME_PLATE_UNIT_REMOVED", function(_, unit) self:OnPlateRemoved(unit) end)
        self:OnGameEvent("PLAYER_TARGET_CHANGED", function() self:ForEach(function(f: Nameplate) f:UpdateTarget() end) end)
        self:OnGameEvent("RAID_TARGET_UPDATE", function() self:ForEach(function(f: Nameplate) f:UpdateRaidMarker() end) end)
        self:OnGameEvent("GROUP_ROSTER_UPDATE", function() self:ForEach(function(f: Nameplate) f:UpdateThreat() end) end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function() self:ForEach(function(f: Nameplate) f:UpdateThreat() end) end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function() self:ForEach(function(f: Nameplate) f:UpdateThreat() end) end)
        self:On("SUUUI_ROLE_CHANGED", function() self:ForEach(function(f: Nameplate) f:UpdateThreat() end) end)
        -- the preview's target line carries a colour code
        self:On("SUUUI_THEME_CHANGED", function() self:DrawPreview() end)
        -- a unit can turn attackable (a duel): re-check its plate
        self:OnGameEvent("UNIT_FACTION", function(_, unit)
            if unit and unit:find("^nameplate") and UnitExists(unit) then self:Recheck(unit) end
        end)
        self:WatchAll({ "width", "barHeight", "castHeight", "auraSize", "auras", "castBars", "castTarget", "castKick", "dimOthers", "threat", "healthText", "questMarks", "levels", "eliteDragon", "raidMarker" }, function(key)
            for unit, f in pairs(byUnit) do
                self:ApplyAuraCount(f)
                if key == "castBars" then
                    if self:Get("castBars") then f.cast:SetUnit(unit); f.cast:Activate() else f.cast:Deactivate() end
                end
                f:Refresh()
            end
            if key == "width" or key == "barHeight" or key == "castHeight" or key == "auraSize" or key == "castTarget" or key == "castKick" then
                self:ApplySizes()
                if key == "width" or key == "barHeight" then self:ApplyGameSettings() end
            end
            self:DrawPreview()
        end)
    end

    override function OnDisable()
        for unit, f in pairs(byUnit) do
            release(f)
            byUnit[unit] = nil
        end
        -- Blizzard's plates back (the SetAlpha hook lets go once they aren't hidden)
        for uf in pairs(hidden) do restoreBlizzard(uf) end
    end
end

M = SuuUI.AddModule(NameplatesModule.new())

-- "Health %" was a toggle; it is the unit frames' health text choice now
M:Migrate("healthText", function(values: { [string]: unknown })
    if type(values.healthText) == "boolean" then values.healthText = values.healthText and "percent" or "none" end
end)
