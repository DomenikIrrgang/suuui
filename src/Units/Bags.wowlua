-- Units/Bags.wowlua
-- Your bags (step 2.5a, design board "Bags"): one window, every bag's slots
-- in one grid (backpack, bags 1-4, the reagent bag; the keyring if you want
-- it), "18 free of 80", search (the game's own item search) and a sort
-- (SuuUI's own orders or the game's; see Sorting), your money in the foot. It opens and closes with Blizzard's bags
-- (B, the bag buttons, the mailbox, a vendor, the bank): Blizzard's bag
-- frames still open and close, under a hidden parent, and SuuUI's window
-- follows them. Bottom right, movable in edit mode.
--
-- The bank (step 2.5b, boards "Bank" and "At the bank"): the same window
-- with every purchased bank tab's slots, opened at a banker top centre with
-- your bags beside it. Blizzard's bank frame opens and closes as always,
-- off screen; SuuUI's window follows BANKFRAME_OPENED/CLOSED.
-- One search runs across both.
--
-- Every character's bags and bank (step 2.5c, board "Bags window"): what
-- each character carries is saved as it changes (the bank while you are at
-- a banker), so the picker in the bags window's header shows another
-- character's bags or bank from anywhere, read only and dated. "All
-- characters" turns the search into a list of everything found on every
-- character, and where. Settings › Bags › Characters forgets one.
--
-- Item counts: an item's tooltip says which of your characters has how
-- many, and where (bags, bank, equipped), from the same saved copies.
--
-- Sell junk: at a vendor, with grey items in your bags, a button in the
-- foot sells them one at a time, each slot read again just before it sells
-- (still grey, still sellable, not locked, the vendor still open).
-- A built-in module written against the public API only.
--
-- The slots are Blizzard's own bag slot buttons (its template), each in a
-- frame whose ID is its bag: clicks, drags, shift-click links, tooltips and
-- using items are Blizzard's code, so they work in combat wherever the game
-- allows it (probed 2026-10-13). SuuUI only draws on them; nothing is
-- written on the buttons.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import BAGS from "/Core/ServiceKeys"
import type Position from "/EditMode/EditMode"
import ItemSlot from "/UI/Inventory"
import type Inventory, ItemSlotSkin, SlotSection, FoundItem, ResultRow from "/UI/Inventory"
import type LoadingMark from "/UI/LoadingMark"
import type Select, SelectOption from "/UI/Select"
import type Text from "/UI/Text"
import type SuuButton from "/UI/Controls"
import type Overlay from "wowlua:secure"
import after, every from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import * as secure from "wowlua:secure"
import * as sort from "./Bags/Sort"
import * as chars from "./Bags/Characters"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local try, field = errors.try, tbl.field
local asNumber, asString, flag = secret.asNumber, secret.asString, secret.flag

local DEFAULTS = {
    position = { point = "BOTTOMRIGHT", x = -28, y = 28 } :: Position,
    columns = 10,
    reagentBag = true,
    keyring = false,
    bank = true,
    itemCounts = true,
    bagSlots = true, -- the bag slot rails beside the windows
    bankPosition = { point = "TOP", x = -216, y = -240 } :: Position,
    sortOrder = "type", -- type, quality, level, name or game
    sortDirection = "end", -- where the items gather: end or start
}

local M: BagsModule

local QUALITY = chars.QUALITY
local KEYRING = -1
local REAGENT = 5
local BANK_FIRST = asNumber(field(Enum, "BagIndex", "CharacterBankTab_1")) or 6
local BANK_LAST = asNumber(field(Enum, "BagIndex", "CharacterBankTab_9")) or 14
local BANK_TYPE = asNumber(field(Enum, "BankType", "Character"))

local function isBank(bag: number): boolean
    return bag >= BANK_FIRST and bag <= BANK_LAST
end

local function numSlots(bag: number): number
    return asNumber(C_Container.GetContainerNumSlots(bag)) or 0
end

local function freeSlots(bag: number): number?
    return asNumber((C_Container.GetContainerNumFreeSlots(bag)))
end

-- A slot button's cooldown (its template's).
local function cooldownOf(b: Frame): Cooldown?
    local name = b:GetName()
    return frames.asCooldown(field(b, "Cooldown")) or (name and frames.asCooldown(field(_G, name .. "Cooldown")) or nil)
end

--------------------------------------------------------------------------------
-- Bag slots (design "Bags · bag slots", direction B, chosen 2026-10-17): a
-- slim rail along each window's left side, outside it, so the window keeps
-- its height. Your bags: the backpack (fixed), four bags and the reagent bag
-- after a hairline; at a banker the bank's own slots, its bag slots 2-9
-- (bought with a bag, or bought and empty) and a buy cell with the
-- next slot's cost. Drag a bag onto a slot (or click with it) to put it in,
-- drag a slot's bag away to take it off; hovering a slot lights its bag's
-- slots in the window and fades the rest. Only on what is live: your own
-- bags, and your bank at a banker.
-- On Forever the bank's "tabs" are bank bag slots (Enum.BagIndex.
-- Characterbanktab holds their bags); buying the next is restricted for
-- addon code, so the buy cell is a secure click on the game's own purchase
-- button and the game's confirmation asks (/suu probe bankslots, 2026-10-17).
--------------------------------------------------------------------------------

local RAIL_SLOT = T.size["slot"]
local RAIL_PAD, RAIL_GAP = S["space-3"], S["space-2"]
local RAIL_W = RAIL_SLOT + 2 * RAIL_PAD
local RAIL_TOP, RAIL_OFF = 52, 6
local TAB_BAG = asNumber(field(Enum, "BagIndex", "Characterbanktab"))
local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local BACKPACK_ICON = 133633

-- One cell of a rail (a bag slot, the backpack, a bank slot): its bag, the
-- inventory slot it is (a bag of yours) or the bank slot, whether it can't
-- change, what's in it.
type RailEntry = {
    kind: string,
    bag?: number,
    inv?: number,
    tab?: number,
    fixed?: boolean,
    has: boolean,
    icon: number | string,
    size: number,
    quality?: string,
}
type RailBuy = { off?: boolean, why?: string, done?: boolean, price?: number, next?: number }

local coinText = chars.coinText

-- A rail's cell: a slot with its size bottom right, a faint glyph when empty.
class RailCell extends ItemSlot
    readonly glyph: Texture
    entry: RailEntry? = nil

    constructor(parent: Frame)
        super(parent, RAIL_SLOT)
        self.glyph = self:CreateTexture(nil, "OVERLAY")
        self.glyph:SetSize(16, 16)
        self.glyph:SetPoint("CENTER")
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self:RegisterForDrag("LeftButton")
    end
end

-- The bank rail's buy cell: its cost under it, and why it can't buy.
class BuyCell extends ItemSlot
    readonly glyph: Texture
    readonly cost: Text
    off: boolean = false
    why: string? = nil
    price: number? = nil
    next: number? = nil

    constructor(rail: Frame)
        super(rail, RAIL_SLOT)
        self.glyph = self:CreateTexture(nil, "OVERLAY")
        self.glyph:SetSize(16, 16)
        self.glyph:SetPoint("CENTER")
        self.glyph:SetTexture(GLYPHS .. "plus")
        self.cost = UI.Text(rail, "micro", "ink-muted")
        self.cost:SetPoint("TOP", self, "BOTTOM", 0, -2)
        self:SetScript("OnEnter", function(cell)
            cell.skin.hover = not cell.off
            cell.skin:Draw()
            UI.ShowTooltip(cell, {
                title = "Buy bank slot",
                subtitle = cell.next and ("Bank slot " .. cell.next) or nil,
                description = cell.why or ("Costs " .. coinText(cell.price) .. ". The game asks first."),
            })
        end)
        self:SetScript("OnLeave", function(cell)
            cell.skin.hover = false
            cell.skin:Draw()
            UI.HideTooltip()
        end)
    end
end

-- A rail beside a window.
class Rail extends Frame
    readonly cells: RailCell[] = {}
    readonly sep: Texture
    buy: BuyCell? = nil

    constructor(window: Frame)
        super(nil, window)
        self:SetPoint("TOPRIGHT", window, "TOPLEFT", -RAIL_OFF, -RAIL_TOP)
        self:SetWidth(RAIL_W)
        UI.Fill(self, "surface", "BACKGROUND"):SetAllPoints()
        UI.Border(self, "gilt-faint")
        self:EnableMouse(true)
        self.sep = UI.Fill(self, "gilt-line", "ARTWORK")
        self.sep:SetSize(24, 1)
    end
end

-- A saved slot (another character's bags, or yours as last seen): SuuUI's
-- own, read only; its item's link.
class SavedSlot extends ItemSlot
    link: string? = nil

    constructor(parent: Frame)
        super(parent)
    end
end

-- The window a sort covers: the loading mark over its slots.
class SortCover extends Frame
    readonly fill: Texture
    readonly mark: LoadingMark
    readonly title: Text
    readonly caption: Text

    constructor(inv: Inventory)
        super(nil, inv.body)
        self:SetAllPoints(inv.body)
        self:SetFrameLevel(inv.body:GetFrameLevel() + 100)
        self:EnableMouse(true)
        self.fill = UI.Fill(self, "surface")
        self.fill:SetAllPoints()
        self.fill:SetAlpha(0.85)
        self.mark = UI.LoadingMark(self, { size = 60 })
        self.mark:SetPoint("CENTER", 0, 24)
        self.title = UI.Text(self, "header", "gilt-text")
        self.title:SetPoint("TOP", self.mark, "BOTTOM", 0, -S["space-4"])
        self.caption = UI.Text(self, "caption", "ink-muted")
        self.caption:SetPoint("TOP", self.title, "BOTTOM", 0, -S["space-2"])
        self:Hide()
    end
end

-- A saved character to forget, and the button (click it twice).
class ForgetRow extends Frame
    readonly select: Select<string>
    readonly button: SuuButton

    constructor(parent: Frame, options: () -> SelectOption<string>[], forget: (key: string) -> ())
        super(nil, parent)
        local choice: string? = nil
        local timer: TimerHandle? = nil
        self.select = UI.Select(self, {
            width = 190,
            placeholder = "Choose a character",
            options = options(),
            onChange = function(v: string)
                choice = v
            end,
        })
        self.select:SetPoint("LEFT")
        self.button = UI.Button(self, {
            text = "Forget",
            onClick = function(b)
                local key = choice
                if not key then
                    return
                end
                local pending = timer
                if not pending then
                    b:SetLabel("Click again")
                    timer = after(3, function()
                        timer = nil
                        b:SetLabel("Forget")
                    end)
                    return
                end
                pending:Cancel()
                timer = nil
                b:SetLabel("Forget")
                forget(key)
                choice = nil
                self.select:SetOptions(options())
                self.select:SetValue(nil)
            end,
        })
        self.button:SetPoint("LEFT", self.select, "RIGHT", S["space-3"], 0)
        self:SetSize(190 + S["space-3"] + self.button:GetWidth(), 30)
        self:SetScript("OnShow", function()
            self.select:SetOptions(options())
        end)
    end
end

--------------------------------------------------------------------------------
-- Every character's bags and bank
--------------------------------------------------------------------------------

local ago, nameOf, classDiamond = chars.ago, chars.nameOf, chars.classDiamond

local function itemTip(owner: Frame, link: unknown, extra: string[]?)
    local text = asString(link)
    local ref = text and (text:match("|H(item:[^|]+)|h") or (text:match("^item:") and text))
    if not ref then
        return
    end
    GameTooltip:SetOwner(owner, "ANCHOR_RIGHT")
    GameTooltip:SetHyperlink(ref)
    if extra then
        GameTooltip:AddLine(" ")
        for _, line in ipairs(extra) do
            GameTooltip:AddLine(line, 0.85, 0.82, 0.76)
        end
    end
    GameTooltip:Show()
end

-- What the listed bags hold now: { slots = { {t, c, q, l} or false … }, size, free, seen }.
type SavedItem = chars.SavedItem
type Snapshot = chars.Snapshot
type CharEntry = chars.CharEntry
local function snapshot(bags: number[]): Snapshot
    local slots: (SavedItem | false)[] = {}
    local size, free = 0, 0
    for _, bag in ipairs(bags) do
        local n = numSlots(bag)
        for slot = 1, n do
            local info = C_Container.GetContainerItemInfo(bag, slot)
            local icon = info and asNumber(info.iconFileID)
            local e: SavedItem | false = false
            if info and icon then
                e = {
                    t = icon,
                    c = asNumber(info.stackCount) or 1,
                    q = asNumber(info.quality) or 1,
                    l = asString(info.hyperlink),
                }
            end
            slots[#slots + 1] = e
        end
        if bag ~= REAGENT and bag ~= KEYRING then
            size = size + n
            free = free + (freeSlots(bag) or 0)
        end
    end
    return { slots = slots, size = size, free = free, seen = time() }
end

local label = chars.charLabel

