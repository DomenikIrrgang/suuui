-- Units/Bags.wowlua
-- Your bags (step 2.5a, design board "Bags"): one window, every bag's slots
-- in one grid (backpack, bags 1-4, the reagent bag; the keyring if you want
-- it), "18 free of 80", search (the game's own item search) and a sort
-- (SuuUI's own orders or the game's; see Sorting), your money in the foot
-- (a click: the Ledger at Gold, while it is on). It opens and closes with Blizzard's bags
-- (B, the bag buttons, the mailbox, a vendor, the bank): Blizzard's bag
-- frames still open and close, under a hidden parent, and SuuUI's window
-- follows them. Bottom right, movable in edit mode.
--
-- The bank (step 2.5b, boards "Bank" and "At the bank"): the same window
-- with every purchased bank tab's slots, opened at a banker top centre with
-- your bags beside it. Blizzard's bank frame opens and closes as always,
-- off screen; SuuUI's window follows BANKFRAME_OPENED/CLOSED.
-- One search runs across both.
--
-- Every character's bags and bank (step 2.5c, board "Bags window"): what
-- each character carries is saved as it changes (the bank while you are at
-- a banker), so the picker in the bags window's header shows another
-- character's bags or bank from anywhere, read only and dated. "All
-- characters" turns the search into a list of everything found on every
-- character, and where. Settings › Bags › Characters forgets one.
--
-- Item counts: an item's tooltip says which of your characters has how
-- many, and where (bags, bank, equipped), from the same saved copies.
--
-- Sell junk: at a vendor, with grey items in your bags, a button in the
-- foot sells them one at a time, each slot read again just before it sells
-- (still grey, still sellable, not locked, the vendor still open).
-- A built-in module written against the public API only.
--
-- The slots are Blizzard's own bag slot buttons (its template), each in a
-- frame whose ID is its bag: clicks, drags, shift-click links, tooltips and
-- using items are Blizzard's code, so they work in combat wherever the game
-- allows it (probed 2026-10-13). SuuUI only draws on them; nothing is
-- written on the buttons.
--
-- What lives where: this file is the module (its settings, its state, the
-- live bags' slots and their layout, selling junk, the refresh, the
-- lifecycle and its events) and the composition of its parts, each made with
-- the module and working on it: Bags/Windows (the two windows built, opened
-- and closed with Blizzard's bags, the bank at a banker), Bags/Rails (the
-- bag slot rails and the buy cell), Bags/Use (the secure button that uses an
-- item, drag and drop), Bags/Saved (every character's saved bags and bank,
-- the picker, the search across characters, item counts, the foot) and
-- Bags/SortRun (the sort's waves). Bags/Containers reads the game's bags,
-- Bags/Characters and Bags/Sort are the pure logic under Saved and SortRun.

import SuuUI, Module from "/Core/API"
import type SettingsSection, Position, Inventory, ItemSlotSkin, SlotSection, ItemSlot from "/Core/API"
import type Overlay from "wowlua:secure"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import * as sort from "./Bags/Sort"
import * as chars from "./Bags/Characters"
-- the parts (see the header)
import * as containers from "./Bags/Containers"
import Rails from "./Bags/Rails"
import type Rail from "./Bags/Rails"
import ItemUse, PLACES from "./Bags/Use"
import SavedBags from "./Bags/Saved"
import type SavedSlot, ForgetRow from "./Bags/Saved"
import SortRun from "./Bags/SortRun"
import type SortState, SortCover from "./Bags/SortRun"
import Windows from "./Bags/Windows"

local BAGS = SuuUI.Services.BAGS
local LEDGER = SuuUI.Services.LEDGER

local UI = SuuUI.UI

local try, field = errors.try, tbl.field
local asNumber, asString, flag = secret.asNumber, secret.asString, secret.flag

local DEFAULTS = {
    position = { point = "BOTTOMRIGHT", x = -28, y = 28 } :: Position,
    columns = 10,
    reagentBag = true,
    keyring = true, -- on for everyone (asked 2026-11-11)
    bank = true,
    itemCounts = true,
    bagSlots = true, -- the bag slot rails beside the windows
    bankPosition = { point = "TOP", x = -216, y = -240 } :: Position,
    sortOrder = "type", -- type, quality, level, name or game
    sortDirection = "end", -- where the items gather: end or start
}

local M: BagsModule

local QUALITY = chars.QUALITY
local KEYRING, REAGENT = containers.KEYRING, containers.REAGENT
local BANK_FIRST, BANK_LAST, BANK_TYPE = containers.BANK_FIRST, containers.BANK_LAST, containers.BANK_TYPE
local isBank, numSlots, freeSlots = containers.isBank, containers.numSlots, containers.freeSlots
local startsQuest, keySlots = containers.startsQuest, containers.keySlots
local familyOf, cooldownOf = containers.familyOf, containers.cooldownOf
local junkAt = containers.junkAt

-- What a family's bag is called (Bags/Containers).
export function familyName(family: number): string
    return containers.familyName(family)
end

-- One of bags 1-4 that takes only its own kind (Bags/Containers).
export function isSpecialBag(bag: number): boolean
    return containers.isSpecialBag(bag)
end

-- The currencies the game shows on its backpack: Bags/Containers'
-- backpackCurrencies, shown in the foot.
-- (the game's backpack-currency setters, hooked once: see OnEnable)
local currencyHooked = false

type CharEntry = chars.CharEntry
type SortSlot = sort.SortSlot
type Move = sort.Move
local SORT_OPTIONS = sort.SORT_OPTIONS

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

