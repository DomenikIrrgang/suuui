-- slot buttons made a frame while they're built ahead (BuildAhead)
local SLOTS_AHEAD = 3

-- (exported for its parts, Bags/*, which take it as a type)
export class BagsModule extends Module<typeof(DEFAULTS)>
    inv: Inventory? = nil
    bank: Inventory? = nil
    preview: Inventory? = nil
    -- the bags' frames (their ID the bag), Blizzard's slot buttons in them,
    -- SuuUI's look on each
    readonly bagFrames: { [number]: Frame } = {}
    readonly buttons: { [number]: Button[] } = {}
    readonly skins: { [Frame]: ItemSlotSkin } = {}
    -- each window's last layout of the live bags (Fill): its bags and sizes,
    -- the buttons it laid out
    readonly laid: { [Inventory]: { key: string, list: Button[] } } = {}
    readonly savedSlots: SavedSlot[] = {}
    -- Blizzard's frames kept under the hidden parent
    readonly parentHooked: { [Frame]: boolean } = {}
    bagRail: Rail? = nil
    bankRail: Rail? = nil
    buyOver: Overlay? = nil
    readonly covers: { [Inventory]: SortCover } = {}
    -- who and what the window shows, the search
    who: string? = nil
    view: string? = nil
    query: string? = nil
    more: number? = nil
    -- Blizzard's bags: the state wanted, which window opened them, the burst
    wantOpen: boolean = false
    openedBy: string? = nil
    burstShown: boolean = false
    burstOpenedBy: string? = nil
    syncQueued: boolean = false
    hooked: boolean = false
    tipHooked: boolean = false
    -- Blizzard's bank frame away
    bankHooked: boolean = false
    bankClamped: boolean = false
    bankPoint: unknown[]? = nil
    movingBank: boolean = false
    bankAwayQueued: boolean = false
    atBank: boolean = false
    atMerchant: boolean = false
    selling: TickerHandle? = nil
    saveTimer: TimerHandle? = nil
    refreshTimer: TimerHandle? = nil
    sorting: SortState? = nil
    sortDriver: Frame? = nil
    -- Using an item: one secure button that comes over the slot under the
    -- mouse, out of combat (see UseOn)
    useOver: Overlay? = nil
    useSlot: Button? = nil
    -- the slot it's over (bag, slot), and whether its left click is a spell's
    -- target (Disenchant, an enchant, a sharpening stone: used securely)
    useAt: { number }? = nil
    useTargets: boolean = false
    -- the places open whose windows take a bag item (MAIL_SHOW: true, ...)
    readonly placesOpen: { [string]: boolean } = {}
    -- Bags the game refused a sorted item for, by their own item: left out of
    -- sorts from then on, their items where they are (a profession bag whose
    -- kind the game doesn't tell: "Only Skinning can be placed in that.",
    -- reported by a player).
    refusingBags: { [number]: boolean } = {}
    -- the parts the module is made of (see the header), each made with it
    readonly windows: Windows
    readonly rails: Rails
    readonly itemUse: ItemUse
    readonly savedBags: SavedBags
    readonly sortRun: SortRun

    constructor()
        super({
            id = "bags",
            name = "Bags",
            description = "SuuUI's bags: every bag in one window with search, sort and your money.",
            api = "0.12",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
        self.windows = Windows.new(self)
        self.rails = Rails.new(self)
        self.itemUse = ItemUse.new(self)
        self.savedBags = SavedBags.new(self)
        self.sortRun = SortRun.new(self)
    end

    -- What this character keeps (its saved entry, typed).
    function Char(): CharEntry
        return self:CharData() :: unknown :: CharEntry
    end

    -- A saved character's entry (nil: none).
    function EntryOf(key: string): CharEntry?
        return self:AllCharData()[key] :: unknown :: CharEntry?
    end

    -- The bags shown, in order.
    function Bags(): number[]
        local list: number[] = { 0, 1, 2, 3, 4 }
        if self:Get("reagentBag") then
            list[#list + 1] = REAGENT
        end
        if self:Get("keyring") then
            list[#list + 1] = KEYRING
        end
        return list
    end

    -- The bank tabs you own, in order (the game's list; else every tab with slots).
    function BankBags(): number[]
        local list: number[] = {}
        if BANK_TYPE then
            for _, id in ipairs(errors.tryValue(C_Bank and C_Bank.FetchPurchasedBankTabIDs, BANK_TYPE) or {}) do
                local bag = asNumber(id)
                if bag and isBank(bag) then
                    list[#list + 1] = bag
                end
            end
        end
        if #list == 0 then
            for bag = BANK_FIRST, BANK_LAST do
                if numSlots(bag) > 0 then
                    list[#list + 1] = bag
                end
            end
        end
        return list
    end

    -- The window a bag's slots are in (nil: neither shows it).
    function InvFor(bag: number): Inventory?
        if isBank(bag) then
            return self.bank
        end
        return self.inv
    end

    --------------------------------------------------------------------------------
    -- Slots
    --------------------------------------------------------------------------------

    -- A bag's frame: its ID is the bag (Blizzard's slot buttons read it).
    function BagFrame(bag: number): Frame
        local known = self.bagFrames[bag]
        if known then
            return known
        end
        local inv = self:InvFor(bag)
        assert(inv, "no window for bag " .. bag)
        local f = CreateFrame("Frame", nil, inv.grid)
        f:SetID(bag)
        f:SetSize(1, 1)
        f:SetPoint("TOPLEFT")
        self.bagFrames[bag] = f
        return f
    end

    function SlotButton(bag: number, slot: number): Button
        local list = self.buttons[bag] or {}
        self.buttons[bag] = list
        local known = list[slot]
        if known then
            return known
        end
        local name = isBank(bag) and ("SuuUIBank%dSlot%d"):format(bag - BANK_FIRST + 1, slot) or
            ("SuuUIBag%dSlot%d"):format(bag + 2, slot)
        -- (an ItemButton is a Button the game draws an item on)
        local b = frames.asButton(
            CreateFrame("ItemButton", name, self:BagFrame(bag), "ContainerFrameItemButtonTemplate")
        )
        assert(b, "no item button")
        b:SetID(slot)
        self.skins[b] = UI.SkinItemSlot(b)
        if bag >= 0 and not isBank(bag) then
            hookScript(b, "OnEnter", function()
                self.itemUse:UseOn(b, bag, slot)
            end)
        end
        list[slot] = b
        return b
    end

    -- Your bags' slot buttons made after login, out of combat, a few a
    -- frame (Core/Ahead), so the first open only lays them out: all of them
    -- in that frame took 340k instructions and 2.4 MB (the perf scenarios).
    -- The first open makes whatever is still missing.
    function BuildAhead()
        SuuUI.BuildAhead("bags: slot buttons", function(): boolean
            if not (self:IsEnabled() and self.inv) then
                return false
            end
            local made = 0
            for _, bag in ipairs(self:Bags()) do
                local list = self.buttons[bag]
                for slot = 1, numSlots(bag) do
                    if not (list and list[slot]) then
                        self:SlotButton(bag, slot)
                        list = self.buttons[bag]
                        made = made + 1
                        if made >= SLOTS_AHEAD then
                            return true
                        end
                    end
                end
            end
            return false
        end)
    end

    function UpdateSlot(bag: number, slot: number)
        local list = self.buttons[bag]
        local b = list and list[slot]
        if not b then
            return
        end
        local info = C_Container.GetContainerItemInfo(bag, slot)
        local skin = self.skins[b]
        local icon = info and asNumber(info.iconFileID)
        if skin then
            if info and icon then
                skin:SetItem({
                    icon = icon,
                    count = asNumber(info.stackCount) or 1,
                    quality = QUALITY[asNumber(info.quality) or 1] or "common",
                    dim = flag(info.isFiltered),
                    locked = flag(info.isLocked),
                    questStart = startsQuest(bag, slot),
                })
            else
                skin:SetItem(nil)
            end
        end
        self:SlotCooldown(b, bag, slot, info ~= nil)
    end

    -- Every slot drawn again (a quest taken or dropped: which items start
    -- one changes).
    function UpdateSlots()
        for bag, list in pairs(self.buttons) do
            for slot = 1, #list do
                self:UpdateSlot(bag, slot)
            end
        end
    end

    -- A slot's cooldown sweep (`has`: an item there).
    function SlotCooldown(b: Frame, bag: number, slot: number, has: boolean)
        local cd = cooldownOf(b)
        if not cd then
            return
        end
        if not has then
            cd:Clear()
            return
        end
        local start, duration, enable = try(C_Container.GetContainerItemCooldown, bag, slot)
        local length = asNumber(duration)
        if length and length > 0 and enable ~= 0 and enable ~= false then
            errors.tryMethod(cd, "SetCooldown", start, length)
        else
            cd:Clear()
        end
    end

    -- Only the cooldowns of the shown windows' slots that hold an item
    -- (BAG_UPDATE_COOLDOWN comes with casts: a whole redraw of every slot
    -- took 5 ms in game).
    function UpdateCooldowns()
        local function each(bags: number[])
            for _, bag in ipairs(bags) do
                local list = self.buttons[bag]
                if list then
                    for slot = 1, numSlots(bag) do
                        local b = list[slot]
                        if b and C_Container.GetContainerItemID(bag, slot) then
                            self:SlotCooldown(b, bag, slot, true)
                        end
                    end
                end
            end
        end
        local inv, bank = self.inv, self.bank
        if inv and inv:IsShown() then
            each(self:Bags())
        end
        if bank and bank:IsShown() then
            each(self:BankBags())
        end
    end

    function UpdateBag(bag: number)
        for slot = 1, numSlots(bag) do
            self:UpdateSlot(bag, slot)
        end
    end

    -- Every slot of every bag a shown window holds.
    function UpdateShown()
        local inv, bank = self.inv, self.bank
        if inv and inv:IsShown() then
            for _, bag in ipairs(self:Bags()) do
                self:UpdateBag(bag)
            end
        end
        if bank and bank:IsShown() then
            for _, bag in ipairs(self:BankBags()) do
                self:UpdateBag(bag)
            end
        end
    end

    -- One window's slots laid out in order: returns its slot count and free
    -- count. `light` (a bag update): when the bags, their sizes and kinds are
    -- what the last layout of this window had and nothing else laid it out
    -- since, only the counts are written again (BAG_UPDATE drew the slots
    -- that changed); otherwise every slot is drawn and laid out.
    function Fill(inv: Inventory, given: number[], light: boolean?): (number, number, boolean)
        local total, free = 0, 0
        local mine = inv == self.inv
        -- your bags: the general ones, then the special ones (quivers, soul
        -- and profession bags), then the reagent bag and the keyring
        local bags: number[] = given
        if mine then
            local general: number[], special: number[], last: number[] = {}, {}, {}
            for _, bag in ipairs(given) do
                if bag == REAGENT or bag == KEYRING then
                    last[#last + 1] = bag
                elseif isSpecialBag(bag) then
                    special[#special + 1] = bag
                else
                    general[#general + 1] = bag
                end
            end
            bags = general
            for _, bag in ipairs(special) do
                bags[#bags + 1] = bag
            end
            for _, bag in ipairs(last) do
                bags[#bags + 1] = bag
            end
        end
        -- the reagent bag, the keyring and each special bag as a section of
        -- its own (design "Bags · reagent bag", direction A, chosen 2026-10-17)
        local sections: SlotSection[]? = nil
        local sizes: number[] = {}
        -- the slots each bag shows: all of them, the keyring's filled ones
        local shownSlots: { [number]: number[] } = {}
        local keyParts: string[] = {}
        local slotCount = 0
        for i, bag in ipairs(bags) do
            local size = numSlots(bag)
            sizes[i] = size
            local n = size
            local keys = ""
            if mine and bag == KEYRING then
                local filled = keySlots(size)
                shownSlots[i] = filled
                n = #filled
                keys = table.concat(filled, ",")
            end
            slotCount = slotCount + n
            local special = mine and isSpecialBag(bag)
            keyParts[i] = ("%d:%d:%s:%s"):format(bag, size, special and "s" or "", keys)
            if special and n > 0 then
                local here = sections or {}
                sections = here
                here[#here + 1] = {
                    at = slotCount - n + 1,
                    label = familyName(familyOf(bag)),
                    meta = ("%d · %d free"):format(n, freeSlots(bag) or 0),
                }
            end
            if mine and (bag == REAGENT or bag == KEYRING) then
                local here = sections or {}
                sections = here
                if bag == REAGENT and n == 0 then
                    here[#here + 1] = { at = slotCount - n + 1, note = "No reagent bag · the reagent slot takes one" }
                elseif bag == REAGENT then
                    here[#here + 1] = {
                        at = slotCount - n + 1,
                        label = "Reagents",
                        meta = ("%d · %d free"):format(n, freeSlots(bag) or 0),
                    }
                elseif n > 0 then
                    -- (n: the keys, as only filled slots show)
                    here[#here + 1] = { at = slotCount - n + 1, label = "Keyring", meta = tostring(n) }
                end
            end
            if bag ~= REAGENT and bag ~= KEYRING and not special then
                total = total + n
                free = free + (freeSlots(bag) or 0)
            end
        end
        local meta = ("%d free of %d"):format(free, total)
        local key = table.concat(keyParts, " ")
        local laid = self.laid[inv]
        if light and laid and laid.key == key and inv:LaidOut() == laid.list then
            inv:SetSectionMetas(sections)
            inv:SetMeta(meta)
            return total, free, true
        end
        local list: Button[] = {}
        local shown: { [number]: boolean } = {}
        for i, bag in ipairs(bags) do
            shown[bag] = true
            local n = sizes[i]
            local only = shownSlots[i]
            local on: { [number]: boolean } = {}
            if only then
                for _, slot in ipairs(only) do
                    on[slot] = true
                    list[#list + 1] = self:SlotButton(bag, slot)
                    self:UpdateSlot(bag, slot)
                end
            else
                for slot = 1, n do
                    on[slot] = true
                    list[#list + 1] = self:SlotButton(bag, slot)
                    self:UpdateSlot(bag, slot)
                end
            end
            -- hide what the bag no longer has (the keyring: its empty slots)
            -- (pairs: the keyring's list has gaps where no key ever was)
            for slot, b in pairs(self.buttons[bag] or {}) do
                if not on[slot] then
                    b:Hide()
                end
            end
        end
        for bag, slots in pairs(self.buttons) do
            if not shown[bag] and self:InvFor(bag) == inv then
                for _, b in pairs(slots) do
                    b:Hide()
                end
            end
        end
        inv:LayoutSlots(list, sections)
        self.laid[inv] = { key = key, list = list }
        inv:SetMeta(meta)
        return total, free, false
    end

    -- Every slot laid out again (bags or sizes changed), the counts, the money.
    -- `light` (a bag update): only the counts and the money when the layout
    -- holds (Fill).
    function Rebuild(light: boolean?)
        local inv = self.inv
        if not (inv and self:IsLive()) then
            return
        end
        local _, _, kept = self:Fill(inv, self:Bags(), light)
        self.savedBags:Foot()
        -- (the rail follows the bags' sizes, in the layout, and the bags
        -- equipped: UNIT_INVENTORY_CHANGED)
        if not kept then
            self.rails:DrawBagRail()
        end
    end

    function RebuildBank(light: boolean?)
        local bank = self.bank
        if not (bank and bank:IsShown()) then
            return
        end
        local tabs = self:BankBags()
        local total, _, kept = self:Fill(bank, tabs, light)
        bank:SetNote(("%s · %d slots"):format(#tabs > 1 and (#tabs .. " tabs") or "Bank", total))
        if not kept then
            self.rails:DrawBankRail()
        end
    end

    --------------------------------------------------------------------------------
    -- Bag slots (Bags/Rails)
    --------------------------------------------------------------------------------

    -- Your bags' rail: only while the window shows your own, live bags.
    function DrawBagRail()
        self.rails:DrawBagRail()
    end

    -- The bank's rail and the buy cell (at a banker).
    function DrawBankRail()
        self.rails:DrawBankRail()
    end

    --------------------------------------------------------------------------------
    -- Every character's bags and bank (Bags/Saved)
    --------------------------------------------------------------------------------

    -- This character's entry saved now.
    function SaveMe()
        self.savedBags:SaveMe()
    end

    function UpdatePicker()
        self.savedBags:UpdatePicker()
    end

    function ShowingResults(): boolean
        local inv = self.inv
        local all = inv and inv.all
        return all ~= nil and all.value == true and (self.query or "") ~= ""
    end

    -- Your own bags: Blizzard's live slots. Anything else is a saved copy.
    function IsLive(): boolean
        if not self.inv then
            return false
        end
        local who = self.who or self:CharKey()
        return who == self:CharKey() and (self.view or "bags") == "bags" and not self:ShowingResults()
    end

    -- An item's tooltip: which characters have how many of it.
    function AddCounts(tooltip: GameTooltip, data: unknown)
        self.savedBags:AddCounts(tooltip, data)
    end

    --------------------------------------------------------------------------------
    -- Sell junk
    --------------------------------------------------------------------------------

    -- The grey items in your bags and what they fetch.
    function Junk(): (number, number)
        local n, copper = 0, 0
        for _, bag in ipairs(self:Bags()) do
            if bag ~= KEYRING then
                for slot = 1, numSlots(bag) do
                    local price, count = junkAt(bag, slot)
                    if price and count then
                        n, copper = n + 1, copper + price * count
                    end
                end
            end
        end
        return n, copper
    end

    -- One grey item a tick until none is left or the vendor closes.
    function SellJunk()
        if self.selling then
            return
        end
        self.selling = self:Every(0.2, function(ticker)
            local sold = false
            if self.atMerchant and not InCombatLockdown() then
                for _, bag in ipairs(self:Bags()) do
                    if bag ~= KEYRING then
                        for slot = 1, numSlots(bag) do
                            if junkAt(bag, slot) then
                                C_Container.UseContainerItem(bag, slot)
                                sold = true
                                break
                            end
                        end
                    end
                    if sold then
                        break
                    end
                end
            end
            if not sold then
                ticker:Cancel()
                self.selling = nil
                self:UpdateJunk()
            end
        end)
    end

    -- The Sell junk button: at a vendor with something grey to sell.
    function UpdateJunk()
        local inv = self.inv
        if not inv then
            return
        end
        local n, copper = 0, 0
        if self.atMerchant and self:IsLive() then
            n, copper = self:Junk()
        end
        if n > 0 then
            inv:SetAction({
                text = "Sell junk",
                onClick = function()
                    self:SellJunk()
                end,
                tooltip = { title = "Sell junk", description = chars.junkText(n, copper) },
            })
        else
            inv:SetAction(nil)
        end
    end

    -- A refresh a moment after the typing stops (and after the game's own item
    -- search has run).
    function QueueRefresh()
        local pending = self.refreshTimer
        if pending then
            pending:Cancel()
        end
        self.refreshTimer = self:After(0.15, function()
            self.refreshTimer = nil
            if self:IsEnabled() then
                self:Guard(self.Refresh)(self)
            end
        end)
    end

    -- The window as the picker, Bags/Bank, All characters and the search say.
    function Refresh()
        local inv = self.inv
        if not (inv and inv:IsShown()) then
            return
        end
        local live = self:IsLive()
        for bag, f in pairs(self.bagFrames) do
            if not isBank(bag) then
                f:SetShown(live)
            end
        end
        inv.sort:SetEnabled(live and not self.sorting)
        self.more = nil
        if self:ShowingResults() then
            self.savedBags:HideSaved()
            self.savedBags:ShowResults()
        elseif live then
            self.savedBags:HideSaved()
            inv:SetResults(nil)
            inv:SetBanner(nil)
            self:Rebuild()
        else
            inv:SetResults(nil)
            self.savedBags:ShowSaved()
        end
        self.savedBags:Foot()
        self:UpdateJunk()
        self.rails:DrawBagRail()
    end

    --------------------------------------------------------------------------------
    -- Opening with Blizzard's bags (Bags/Windows)
    --------------------------------------------------------------------------------

    -- SuuUI's own ways (the micro menu, the close button): its window only.
    function SetOpen(on: boolean)
        self.windows:SetOpen(on)
    end

    function Toggle()
        self.windows:Toggle()
    end

    --------------------------------------------------------------------------------
    -- Sorting (Bags/SortRun)
    --------------------------------------------------------------------------------

    -- The slots a sort covers, in the window's order, as they are now.
    function SortSlots(bank: boolean): SortSlot[]
        return self.sortRun:SortSlots(bank)
    end

    -- After a refused wave: the bag to blame left out of sorts (false: none).
    function Refused(moves: Move[]): boolean
        return self.sortRun:Refused(moves)
    end

    -- Where each item belongs (Bags/Sort's sortTarget).
    function SortTarget(slots: SortSlot[], order: string, toEnd: boolean): sort.Target?
        return self.sortRun:SortTarget(slots, order, toEnd)
    end

    -- The Sort button: SuuUI's order, or the game's sort.
    function Sort(bank: boolean)
        self.sortRun:Sort(bank)
    end

    -- Stopped where it is; Sort again finishes it.
    function StopSort(why: string)
        self.sortRun:StopSort(why)
    end

    --------------------------------------------------------------------------------
    -- Settings
    --------------------------------------------------------------------------------

    function PreviewView(parent: Frame): Inventory
        local view = self.preview
        if not view then
            local inv = UI.Inventory(parent, { title = "Bags", columns = self:Get("columns"), characters = true })
            inv.onClose = function() end
            local who = inv.who
            assert(who, "no picker")
            who:SetOptions({
                {
                    value = "you",
                    label = secret.known(UnitName("player"), "You") .. " · " .. (asNumber(UnitLevel("player")) or 1),
                },
            })
            who:SetValue("you")
            local slots: ItemSlot[] = {}
            for i = 1, 40 do
                local b = UI.ItemSlot(inv.grid)
                b.skin:SetItem(PREVIEW_ITEMS[i])
                slots[i] = b
            end
            inv.previewSlots = slots
            inv:LayoutSlots(slots)
            inv:SetMeta("28 free of 40")
            inv:SetNote("3 characters · 2,112g in all")
            inv:SetMoney(12043709)
            self.preview = inv
            view = inv
        end
        view:SetParent(parent)
        return view
    end

    -- The money in the foot (0.48): a click opens the Ledger at Gold, while
    -- the Ledger is on (its service there); the tooltip says so.
    function LedgerMoney()
        local inv = self.inv
        if not inv then
            return
        end
        local svc = SuuUI.UseService(LEDGER)
        local open = svc and svc.Open
        if not open then
            inv:SetMoneyClick(nil)
            return
        end
        inv:SetMoneyClick(function()
            local now = SuuUI.UseService(LEDGER)
            local fn = now and now.Open
            if fn then
                fn("gold")
            end
        end, { title = "Money", meta = "Click: the Ledger" })
    end

    -- A saved character to forget (Settings › Bags › Characters).
    function ForgetRow(parent: Frame): ForgetRow
        return self.savedBags:ForgetRow(parent)
    end

    --------------------------------------------------------------------------------
    -- Lifecycle
    --------------------------------------------------------------------------------

    override function OnEnable()
        if not C_Container then
            return
        end
        self:ProvideService(BAGS, {
            Toggle = function()
                self.windows:Toggle()
            end,
        })
        self.windows:Build()
        local inv, bank = self.inv, self.bank
        if not (inv and bank) then
            return
        end
        self.windows:HideBlizzardBags()
        self.windows:HideBlizzardBank()
        self:BuildAhead()
        -- (the bags follow Blizzard's bags, the bank shows at a banker: not edit mode)
        self:RegisterMover(inv, { key = "position", label = "Bags", managedShow = true, anchorOnly = true })
        self:RegisterMover(bank, { key = "bankPosition", label = "Bank", managedShow = true, anchorOnly = true })
        self:RegisterSettings(SECTION)
        self:Watch("columns", function(v)
            inv:SetColumns(v)
            bank:SetColumns(v)
            self:Refresh()
            self:RebuildBank()
        end)
        self:Watch("bank", function(on)
            self.windows:HideBlizzardBank()
            if not on then
                self.windows:HideBank()
            end
        end)
        self:Watch("reagentBag", function()
            self:Refresh()
        end)
        self:Watch("bagSlots", function(on)
            local toggle = inv.slotsToggle
            if toggle then
                toggle:SetValue(on)
            end
            self.rails:DrawRails()
        end)
        self:Watch("keyring", function()
            self:Refresh()
        end)
        self:Watch("sortOrder", function()
            self.sortRun:SortTip()
        end)
        self:Watch("sortDirection", function()
            self.sortRun:SortTip()
        end)
        self.sortRun:SortTip()
        -- a theme can change the caption and micro styles the slots and rails
        -- are laid out in
        self:On("SUUUI_THEME_CHANGED", function()
            self:Refresh()
            self:RebuildBank()
            self.rails:DrawRails()
        end)
        -- Blizzard opening or closing bags, by any of its ways
        if not self.hooked then
            self.hooked = true
            for _, name in ipairs({
                "ToggleAllBags",
                "OpenAllBags",
                "CloseAllBags",
                "ToggleBag",
                "OpenBag",
                "CloseBag",
                "ToggleBackpack",
                "OpenBackpack",
                "CloseBackpack",
            }) do
                if type(field(_G, name)) == "function" then
                    hook(name, function(frame: unknown)
                        if self:IsEnabled() then
                            self.windows:BagCall(name, frame)
                        end
                    end)
                end
            end
        end
        -- what changes in the bags
        self:OnGameEvent("BAG_UPDATE", function(_, bagID)
            local bag = asNumber(bagID)
            local window = bag and self:InvFor(bag)
            if bag and window and window:IsShown() then
                self:UpdateBag(bag)
            end
        end)
        -- (an item moved, looted or used: the slots BAG_UPDATE drew and the
        -- counts; a bag put in, taken out or of another size: all laid out)
        for _, e in ipairs({ "BAG_UPDATE_DELAYED", "BAG_CONTAINER_UPDATE", "PLAYER_ENTERING_WORLD" }) do
            local light = e == "BAG_UPDATE_DELAYED"
            self:OnGameEvent(e, function()
                if inv:IsShown() then
                    self:Rebuild(light)
                    self:UpdateJunk()
                elseif not light then
                    -- (a new bag's slots, or the bags known at last)
                    self:BuildAhead()
                end
                self:RebuildBank(light)
                if e ~= "PLAYER_ENTERING_WORLD" then
                    self.savedBags:QueueSave()
                end
            end)
        end
        for _, e in ipairs({ "BANK_TABS_CHANGED", "PLAYERBANKSLOTS_CHANGED" }) do
            self:OnGameEvent(e, function()
                self:RebuildBank()
            end)
        end
        -- the rails: bags put in or taken off, the next slot's price against your money
        self:OnGameEvent("UNIT_INVENTORY_CHANGED", function(_, unit)
            if unit == "player" then
                self.rails:DrawRails()
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if bank:IsShown() then
                self.rails:DrawBankRail()
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            local over = self.buyOver
            if over then
                over.hide()
            end
            self.itemUse:HideUse()
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self.itemUse:HideUse()
        end)
        for open, closed in pairs(PLACES) do
            self:OnGameEvent(open, function()
                self.placesOpen[open] = true
                self.itemUse:HideUse()
            end)
            self:OnGameEvent(closed, function()
                self.placesOpen[open] = nil
            end)
        end
        -- a sort: its waves land, combat or a refused move stops it
        self:OnGameEvent("BAG_UPDATE_DELAYED", function()
            local st = self.sorting
            if not st then
                return
            end
            st.lastUpdate = GetTime()
            local wave = st.wait
            if wave then
                wave.updated = true
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            if self.sorting then
                self.sortRun:StopSort("combat started")
            end
        end)
        self:OnGameEvent("UI_ERROR_MESSAGE", function(_, _, message)
            local st = self.sorting
            if not (st and st.wait and not st.game) then
                return
            end
            local text = asString(message)
            -- the bank (tabs, no bag to blame): stopped at once, its first wave
            -- the game's own bank sort instead
            if st.bank then
                self.sortRun:StopSort("the game refused a move" .. (text and (" (" .. text .. ")") or ""))
                return
            end
            -- (which move it was shows once the bags have updated: SortTick)
            st.refused = text or ""
        end)
        self:OnGameEvent("BANKFRAME_OPENED", function()
            self.atBank = true
            self.windows:ShowBank()
            self.savedBags:QueueSave()
        end)
        self:OnGameEvent("BANKFRAME_CLOSED", function()
            if self.atBank then
                self.savedBags:SaveMe()
            end
            self.atBank = false
            self.windows:HideBank()
        end)
        self:OnGameEvent("PLAYER_LEVEL_UP", function()
            self.savedBags:QueueSave()
        end)
        self:OnGameEvent("PLAYER_EQUIPMENT_CHANGED", function()
            self.savedBags:QueueSave()
        end)
        local addPostCall = field(_G, "TooltipDataProcessor", "AddTooltipPostCall")
        local itemType = field(Enum, "TooltipDataType", "Item")
        if not self.tipHooked and type(addPostCall) == "function" and itemType ~= nil then
            self.tipHooked = true
            try(addPostCall, itemType, function(tooltip: unknown, data: unknown)
                if not self:IsEnabled() then
                    return
                end
                local tip = tooltip == GameTooltip and GameTooltip or tooltip == ItemRefTooltip and ItemRefTooltip or
                    nil
                if tip then
                    self:Guard(function()
                        self.savedBags:AddCounts(tip, data)
                    end)()
                end
            end)
        end
        -- a spell starting or ending its wait for an item: the left click
        -- over the slot under the mouse follows
        self:OnGameEvent("CURRENT_SPELL_CAST_CHANGED", function()
            self.itemUse:DrawUseTarget()
        end)
        self:OnGameEvent("CURSOR_CHANGED", function()
            self.itemUse:DrawUseTarget()
        end)
        self:OnGameEvent("MERCHANT_SHOW", function()
            self.atMerchant = true
            self.itemUse:HideUse()
            self:UpdateJunk()
        end)
        self:OnGameEvent("MERCHANT_CLOSED", function()
            self.atMerchant = false
            self:UpdateJunk()
        end)
        self:OnGameEvent("PLAYER_LOGOUT", function()
            self.savedBags:SaveMe()
        end)
        self:OnGameEvent("ITEM_LOCK_CHANGED", function(_, bagID, slotID)
            local bag, slot = asNumber(bagID), asNumber(slotID)
            local window = bag and self:InvFor(bag)
            if bag and slot and window and window:IsShown() then
                self:UpdateSlot(bag, slot)
            end
        end)
        self:OnGameEvent("BAG_UPDATE_COOLDOWN", function()
            self:UpdateCooldowns()
        end)
        -- a quest taken or dropped: the items that start one change (shown
        -- windows; a hidden one draws its slots as it opens)
        for _, e in ipairs({ "QUEST_ACCEPTED", "QUEST_REMOVED" }) do
            self:OnGameEvent(e, function()
                local bankWindow = self.bank
                if inv:IsShown() or (bankWindow and bankWindow:IsShown()) then
                    self:UpdateSlots()
                end
            end)
        end
        self:OnGameEvent("INVENTORY_SEARCH_UPDATE", function()
            self:UpdateShown()
        end)
        -- a currency gained or spent
        self:OnGameEvent("CURRENCY_DISPLAY_UPDATE", function()
            if inv:IsShown() then
                self.savedBags:Foot()
            end
        end)
        -- one marked for the backpack or unmarked (the Currency tab's box):
        -- no event says so, the game updates its own backpack by hand; with
        -- the bags open it showed only once they were opened again (found in
        -- game 2026-11-11). Hooked once; a frame later, when the game has it.
        if not currencyHooked and C_CurrencyInfo then
            currencyHooked = true
            for _, name in ipairs({ "SetCurrencyBackpack", "SetCurrencyBackpackByID" }) do
                if type(field(C_CurrencyInfo, name)) == "function" then
                    hook(C_CurrencyInfo, name, function()
                        self:After(0, function()
                            local open = self.inv
                            if self:IsEnabled() and open and open:IsShown() then
                                self.savedBags:Foot()
                            end
                        end)
                    end)
                end
            end
        end
        -- the money: a way into the Ledger while it is on
        self:LedgerMoney()
        self:On("SUUUI_SERVICE_CHANGED", function(_, name)
            if name == "ledger" then
                self:LedgerMoney()
            end
        end)
        self:OnGameEvent("PLAYER_MONEY", function()
            self:Char().money = GetMoney()
            if inv:IsShown() then
                self.savedBags:Foot()
            end
            if bank:IsShown() then
                self.rails:DrawBankRail()
            end
        end)
        self.windows:Sync()
    end

    override function OnDisable()
        self.itemUse:HideUse()
        local inv, bank = self.inv, self.bank
        if inv then
            inv:Hide()
        end
        if bank then
            bank:Hide()
        end
    end
end

M = SuuUI.AddModule(BagsModule.new())
