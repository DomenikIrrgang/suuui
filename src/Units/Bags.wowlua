class BagsModule extends Module<typeof(DEFAULTS)>
    inv: Inventory? = nil
    bank: Inventory? = nil
    preview: Inventory? = nil
    -- the bags' frames (their ID the bag), Blizzard's slot buttons in them,
    -- SuuUI's look on each
    readonly bagFrames: { [number]: Frame } = {}
    readonly buttons: { [number]: Button[] } = {}
    readonly skins: { [Frame]: ItemSlotSkin } = {}
    readonly savedSlots: SavedSlot[] = {}
    -- Blizzard's frames kept under the hidden parent
    readonly parentHooked: { [Frame]: boolean } = {}
    bagRail: Rail? = nil
    bankRail: Rail? = nil
    buyOver: Overlay? = nil
    readonly covers: { [Inventory]: SortCover } = {}
    -- who and what the window shows, the search
    who: string? = nil
    view: string? = nil
    query: string? = nil
    more: number? = nil
    -- Blizzard's bags: the state wanted, which window opened them, the burst
    wantOpen: boolean = false
    openedBy: string? = nil
    burstShown: boolean = false
    burstOpenedBy: string? = nil
    syncQueued: boolean = false
    hooked: boolean = false
    tipHooked: boolean = false
    -- Blizzard's bank frame away
    bankHooked: boolean = false
    bankClamped: boolean = false
    bankPoint: unknown[]? = nil
    movingBank: boolean = false
    bankAwayQueued: boolean = false
    atBank: boolean = false
    atMerchant: boolean = false
    selling: TickerHandle? = nil
    saveTimer: TimerHandle? = nil
    refreshTimer: TimerHandle? = nil
    sorting: SortState? = nil
    sortDriver: Frame? = nil

    constructor()
        super({
            id = "bags",
            name = "Bags",
            description = "SuuUI's bags: every bag in one window with search, sort and your money.",
            api = "0.12",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- What this character keeps (its saved entry, typed).
    function Char(): CharEntry
        return self:CharData() :: unknown :: CharEntry
    end

    -- A saved character's entry (nil: none).
    function EntryOf(key: string): CharEntry?
        return self:AllCharData()[key] :: unknown :: CharEntry?
    end

    -- The bags shown, in order.
    function Bags(): number[]
        local list: number[] = { 0, 1, 2, 3, 4 }
        if self:Get("reagentBag") then
            list[#list + 1] = REAGENT
        end
        if self:Get("keyring") then
            list[#list + 1] = KEYRING
        end
        return list
    end

    -- The bank tabs you own, in order (the game's list; else every tab with slots).
    function BankBags(): number[]
        local list: number[] = {}
        if BANK_TYPE then
            for _, id in ipairs(errors.tryValue(C_Bank and C_Bank.FetchPurchasedBankTabIDs, BANK_TYPE) or {}) do
                local bag = asNumber(id)
                if bag and isBank(bag) then
                    list[#list + 1] = bag
                end
            end
        end
        if #list == 0 then
            for bag = BANK_FIRST, BANK_LAST do
                if numSlots(bag) > 0 then
                    list[#list + 1] = bag
                end
            end
        end
        return list
    end

    -- The window a bag's slots are in (nil: neither shows it).
    function InvFor(bag: number): Inventory?
        if isBank(bag) then
            return self.bank
        end
        return self.inv
    end

    --------------------------------------------------------------------------------
    -- Slots
    --------------------------------------------------------------------------------

    -- A bag's frame: its ID is the bag (Blizzard's slot buttons read it).
    function BagFrame(bag: number): Frame
        local known = self.bagFrames[bag]
        if known then
            return known
        end
        local inv = self:InvFor(bag)
        assert(inv, "no window for bag " .. bag)
        local f = CreateFrame("Frame", nil, inv.grid)
        f:SetID(bag)
        f:SetSize(1, 1)
        f:SetPoint("TOPLEFT")
        self.bagFrames[bag] = f
        return f
    end

    function SlotButton(bag: number, slot: number): Button
        local list = self.buttons[bag] or {}
        self.buttons[bag] = list
        local known = list[slot]
        if known then
            return known
        end
        local name = isBank(bag) and ("SuuUIBank%dSlot%d"):format(bag - BANK_FIRST + 1, slot) or
            ("SuuUIBag%dSlot%d"):format(bag + 2, slot)
        -- (an ItemButton is a Button the game draws an item on)
        local b = frames.asButton(
            CreateFrame("ItemButton", name, self:BagFrame(bag), "ContainerFrameItemButtonTemplate")
        )
        assert(b, "no item button")
        b:SetID(slot)
        self.skins[b] = UI.SkinItemSlot(b)
        list[slot] = b
        return b
    end

    function UpdateSlot(bag: number, slot: number)
        local list = self.buttons[bag]
        local b = list and list[slot]
        if not b then
            return
        end
        local info = C_Container.GetContainerItemInfo(bag, slot)
        local skin = self.skins[b]
        local icon = info and asNumber(info.iconFileID)
        if skin then
            if info and icon then
                skin:SetItem({
                    icon = icon,
                    count = asNumber(info.stackCount) or 1,
                    quality = QUALITY[asNumber(info.quality) or 1] or "common",
                    dim = flag(info.isFiltered),
                    locked = flag(info.isLocked),
                })
            else
                skin:SetItem(nil)
            end
        end
        local cd = cooldownOf(b)
        if cd then
            local start, duration, enable = try(C_Container.GetContainerItemCooldown, bag, slot)
            local length = asNumber(duration)
            if length and length > 0 and enable ~= 0 and enable ~= false then
                errors.tryMethod(cd, "SetCooldown", start, length)
            else
                cd:Clear()
            end
        end
    end

    function UpdateBag(bag: number)
        for slot = 1, numSlots(bag) do
            self:UpdateSlot(bag, slot)
        end
    end

    -- Every slot of every bag a shown window holds.
    function UpdateShown()
        local inv, bank = self.inv, self.bank
        if inv and inv:IsShown() then
            for _, bag in ipairs(self:Bags()) do
                self:UpdateBag(bag)
            end
        end
        if bank and bank:IsShown() then
            for _, bag in ipairs(self:BankBags()) do
                self:UpdateBag(bag)
            end
        end
    end

    -- One window's slots laid out in order: returns its slot count and free count.
    function Fill(inv: Inventory, bags: number[]): (number, number)
        local list: Button[] = {}
        local shown: { [number]: boolean } = {}
        local total, free = 0, 0
        -- the reagent bag and the keyring each as a section of their own
        -- (design "Bags · reagent bag", direction A, chosen 2026-10-17)
        local sections: SlotSection[]? = nil
        for _, bag in ipairs(bags) do
            shown[bag] = true
            local n = numSlots(bag)
            if inv == self.inv and (bag == REAGENT or bag == KEYRING) then
                local here = sections or {}
                sections = here
                if bag == REAGENT and n == 0 then
                    here[#here + 1] = { at = #list + 1, note = "No reagent bag · the reagent slot takes one" }
                elseif bag == REAGENT then
                    here[#here + 1] = {
                        at = #list + 1,
                        label = "Reagents",
                        meta = ("%d · %d free"):format(n, freeSlots(bag) or 0),
                    }
                elseif n > 0 then
                    here[#here + 1] = { at = #list + 1, label = "Keyring", meta = tostring(n) }
                end
            end
            for slot = 1, n do
                list[#list + 1] = self:SlotButton(bag, slot)
                self:UpdateSlot(bag, slot)
            end
            -- hide what the bag no longer has
            local made = self.buttons[bag] or {}
            for slot = n + 1, #made do
                made[slot]:Hide()
            end
            if bag ~= REAGENT and bag ~= KEYRING then
                total = total + n
                free = free + (freeSlots(bag) or 0)
            end
        end
        for bag, slots in pairs(self.buttons) do
            if not shown[bag] and self:InvFor(bag) == inv then
                for _, b in ipairs(slots) do
                    b:Hide()
                end
            end
        end
        inv:LayoutSlots(list, sections)
        inv:SetMeta(("%d free of %d"):format(free, total))
        return total, free
    end

    -- Every slot laid out again (bags or sizes changed), the counts, the money.
    function Rebuild()
        local inv = self.inv
        if not (inv and self:IsLive()) then
            return
        end
        self:Fill(inv, self:Bags())
        self:Foot()
        self:DrawBagRail()
    end

    function RebuildBank()
        local bank = self.bank
        if not (bank and bank:IsShown()) then
            return
        end
        local tabs = self:BankBags()
        local total = self:Fill(bank, tabs)
        bank:SetNote(("%s · %d slots"):format(#tabs > 1 and (#tabs .. " tabs") or "Bank", total))
        self:DrawBankRail()
    end

    --------------------------------------------------------------------------------
    -- Bag slots
    --------------------------------------------------------------------------------

    -- One cell of a rail.
    function RailCell(rail: Rail, i: number): RailCell
        local known = rail.cells[i]
        if known then
            return known
        end
        local b = RailCell.new(rail)
        b:SetScript("OnEnter", function(cell)
            cell.skin.hover = true
            cell.skin:Draw()
            self:RailTip(cell)
            local entry = cell.entry
            local bag = entry and entry.bag
            if bag then
                self:LightBag(bag)
            end
        end)
        b:SetScript("OnLeave", function(cell)
            cell.skin.hover = false
            cell.skin:Draw()
            GameTooltip:Hide()
            UI.HideTooltip()
            self:LightBag(nil)
        end)
        b:SetScript("OnClick", function(cell)
            self:RailPut(cell)
        end)
        b:SetScript("OnReceiveDrag", function(cell)
            self:RailPut(cell)
        end)
        b:SetScript("OnDragStart", function(cell)
            self:RailPick(cell)
        end)
        rail.cells[i] = b
        return b
    end

    -- Put what the cursor holds into the slot (or pick the slot's bag up).
    function RailPut(cell: RailCell)
        local e = cell.entry
        if not e or e.fixed then
            return
        end
        local inv, tab = e.inv, e.tab
        if inv then
            if CursorHasItem() then
                try(PutItemInBag, inv)
            else
                try(PickupBagFromSlot, inv)
            end
        elseif tab and TAB_BAG then
            try(C_Container.PickupContainerItem, TAB_BAG, tab)
        end
    end

    function RailPick(cell: RailCell)
        local e = cell.entry
        if not e or e.fixed then
            return
        end
        local inv, tab = e.inv, e.tab
        if inv then
            try(PickupBagFromSlot, inv)
        elseif tab and TAB_BAG then
            try(C_Container.PickupContainerItem, TAB_BAG, tab)
        end
    end

    function RailTip(cell: RailCell)
        local e = cell.entry
        if not e then
            return
        end
        local free = e.bag and freeSlots(e.bag)
        local sizeLine = e.size > 0 and (e.size .. " slots" .. (free and (" · " .. free .. " free") or "")) or nil
        if e.fixed then
            UI.ShowTooltip(cell, {
                title = e.kind == "bank" and "Bank" or "Backpack",
                subtitle = sizeLine,
                description = e.kind == "bank" and "The bank's own slots." or "Always there; it can't be changed.",
            })
        elseif not e.has then
            UI.ShowTooltip(cell, {
                title = e.tab and ("Bank slot " .. e.tab) or (e.kind == "reagent" and "Reagent bag" or "Bag slot"),
                subtitle = "Empty",
                description = e.kind == "reagent" and "Drag a reagent bag here. Only reagent bags fit." or
                    "Drag a bag here.",
            })
        else
            GameTooltip:SetOwner(cell, "ANCHOR_RIGHT", S["space-4"], 0)
            local inv, tab = e.inv, e.tab
            local shown = false
            if inv then
                shown = flag(GameTooltip:SetInventoryItem("player", inv))
            elseif tab and TAB_BAG then
                shown = flag(GameTooltip:SetBagItem(TAB_BAG, tab))
            end
            if not shown then
                GameTooltip:SetText(tab and ("Bank slot " .. tab) or "Bag")
            end
            local r, g, b = UI.RGBA("ink-muted")
            if sizeLine then
                GameTooltip:AddLine(sizeLine, r, g, b, true)
            end
            GameTooltip:AddLine("Pick it up to take it off, or drop another bag on it to swap.", r, g, b, true)
            GameTooltip:Show()
        end
    end

    -- While a bag slot is hovered: its bag's slots stay, the rest fade.
    function LightBag(bag: number?)
        for b2, slots in pairs(self.buttons) do
            local fade = bag ~= nil and b2 ~= bag
            for _, b in ipairs(slots) do
                if b:IsShown() then
                    local skin = self.skins[b]
                    local dim = skin and skin.item and skin.item.dim
                    b:SetAlpha(fade and 0.35 or (dim and T.opacity["opacity-disabled"] or 1))
                end
            end
        end
    end

    -- The cells top to bottom; `sepBefore` the reagent bag's hairline.
    function LayoutRail(rail: Rail, entries: RailEntry[], buy: RailBuy?)
        local y = RAIL_PAD
        rail.sep:Hide()
        for i, e in ipairs(entries) do
            if e.kind == "reagent" and i > 1 then
                y = y + S["space-2"]
                rail.sep:ClearAllPoints()
                rail.sep:SetPoint("TOP", rail, "TOP", 0, -y)
                rail.sep:Show()
                y = y + 1 + S["space-2"]
            end
            local b = self:RailCell(rail, i)
            b.entry = e
            b:ClearAllPoints()
            b:SetPoint("TOP", rail, "TOP", 0, -y)
            if not e.has then
                b.skin:SetItem(nil)
                b.glyph:SetTexture(GLYPHS .. (e.kind == "reagent" and "leaf" or "bag"))
                UI.Paint(b.glyph, "ink-faint")
                b.glyph:Show()
            else
                b.glyph:Hide()
                b.skin:SetItem({ icon = e.icon, count = e.size, quality = e.quality })
            end
            b:Show()
            y = y + RAIL_SLOT + RAIL_GAP
        end
        for i = #entries + 1, #rail.cells do
            rail.cells[i]:Hide()
        end
        -- the bank's buy cell last, its cost under it
        if buy then
            local c = rail.buy
            if not c then
                c = BuyCell.new(rail)
                rail.buy = c
            end
            y = y + S["space-2"]
            c:ClearAllPoints()
            c:SetPoint("TOP", rail, "TOP", 0, -y)
            c.off, c.why, c.price, c.next = buy.off == true, buy.why, buy.price, buy.next
            UI.Paint(c.glyph, buy.off and "ink-faint" or "gilt-text")
            c:SetAlpha(buy.off and T.opacity["opacity-disabled"] or 1)
            local price = buy.price
            c.cost:SetValue(price and price > 0 and not buy.done and coinText(price) or "")
            c:Show()
            c.cost:Show()
            y = y + RAIL_SLOT + 2 + T.type.micro.lineHeight
        end
        rail:SetHeight(y - RAIL_GAP + RAIL_PAD)
    end

    -- Your bags' rail: only while the window shows your own, live bags.
    function DrawBagRail()
        local rail, inv, bank = self.bagRail, self.inv, self.bank
        if not (rail and inv) then
            return
        end
        if not (inv:IsShown() and self:IsLive() and self:Get("bagSlots")) then
            rail:Hide()
            return
        end
        -- left of the window; at a banker on its right (the bank is on its left)
        rail:ClearAllPoints()
        if bank and bank:IsShown() then
            rail:SetPoint("TOPLEFT", inv, "TOPRIGHT", RAIL_OFF, -RAIL_TOP)
        else
            rail:SetPoint("TOPRIGHT", inv, "TOPLEFT", -RAIL_OFF, -RAIL_TOP)
        end
        local entries: RailEntry[] = {
            { kind = "backpack", bag = 0, fixed = true, has = true, icon = BACKPACK_ICON, size = numSlots(0) },
        }
        local bags = { 1, 2, 3, 4 }
        if self:Get("reagentBag") then
            bags[#bags + 1] = REAGENT
        end
        -- one empty bag slot is enough to drop a bag on: the others stay out
        -- (asked for in game); the reagent slot always shows
        local emptyShown = false
        for _, bag in ipairs(bags) do
            local slot = errors.tryValue(C_Container.ContainerIDToInventoryID, bag)
            local icon = slot and asNumber(GetInventoryItemTexture("player", slot))
            local q = slot and asNumber(GetInventoryItemQuality("player", slot))
            local reagent = bag == REAGENT
            if icon or reagent or not emptyShown then
                if not icon and not reagent then
                    emptyShown = true
                end
                entries[#entries + 1] = {
                    kind = reagent and "reagent" or "bag",
                    bag = bag,
                    inv = slot,
                    has = icon ~= nil,
                    icon = icon or BACKPACK_ICON,
                    size = numSlots(bag),
                    quality = q and QUALITY[q] or nil,
                }
            end
        end
        self:LayoutRail(rail, entries)
        rail:Show()
    end

    -- The bank's rail and the buy cell (at a banker).
    function DrawBankRail()
        local rail, bank = self.bankRail, self.bank
        if not (rail and bank) then
            return
        end
        if not (bank:IsShown() and TAB_BAG and BANK_TYPE and self:Get("bagSlots")) then
            rail:Hide()
            self:PlaceBuy(false)
            return
        end
        local max = errors.tryValue(C_Bank.FetchMaxNumBankTabs, BANK_TYPE) or 9
        local bought: { [number]: boolean } = {}
        for _, bag in ipairs(self:BankBags()) do
            bought[bag - BANK_FIRST + 1] = true
        end
        -- the slots you bought, one of them empty at most (as your bags' rail,
        -- asked for in game); the buy cell stands for the rest
        local entries: RailEntry[] = {}
        local emptyShown = false
        for n = 1, max do
            local bag = BANK_FIRST + n - 1
            local info = errors.tryValue(C_Container.GetContainerItemInfo, TAB_BAG, n)
            local icon = info and asNumber(info.iconFileID)
            local owned = n == 1 or bought[n]
            if owned and (n == 1 or icon or not emptyShown) then
                if n > 1 and not icon then
                    emptyShown = true
                end
                local q = info and asNumber(info.quality)
                entries[#entries + 1] = {
                    kind = n == 1 and "bank" or "bankbag",
                    tab = n,
                    bag = bag,
                    fixed = n == 1,
                    has = icon ~= nil or n == 1,
                    icon = icon or BACKPACK_ICON,
                    size = numSlots(bag),
                    quality = q and QUALITY[q] or nil,
                }
            end
        end
        local buy: RailBuy = {}
        local nextTab = errors.tryValue(C_Bank.FetchNextPurchasableBankTabData, BANK_TYPE)
        local price = nextTab and asNumber(nextTab.tabCost)
        if errors.tryValue(C_Bank.HasMaxBankTabs, BANK_TYPE) then
            buy.off, buy.why, buy.done = true, "Every bank slot is bought.", true
        elseif nextTab and price then
            buy.price = price
            buy.next = (errors.tryValue(C_Bank.FetchNumPurchasedBankTabs, BANK_TYPE) or 0) + 1
            if not nextTab.canAfford then
                buy.off, buy.why = true, ("You need %s. You have %s."):format(coinText(price), coinText(GetMoney()))
            end
        else
            buy.off, buy.why = true, "The bank doesn't offer another slot right now."
        end
        self:LayoutRail(rail, entries, buy)
        rail:Show()
        self:PlaceBuy(not buy.off)
    end

    -- The buy cell's secure button: a click on the game's own purchase button
    -- (its confirmation asks). Placed out of combat, while the cell can buy.
    function PlaceBuy(on: boolean)
        if InCombatLockdown() then
            return
        end
        local rail = self.bankRail
        local cell = rail and rail.buy
        local target = frames.asButton(field(_G, "BankFrame", "BankPanel", "PurchaseButton"))
        local over = self.buyOver
        if not over then
            if not (on and target and cell) then
                return
            end
            -- (a layer above the windows: a click raises them, toplevel)
            over = secure.overlay(cell, { strata = "DIALOG" })
            over.set("type1", "click")
            self.buyOver = over
        end
        if target then
            over.set("clickbutton1", target)
        end
        if on and target and cell and cell:IsVisible() then
            over.show()
        else
            over.hide()
        end
    end

    function DrawRails()
        self:DrawBagRail()
        self:DrawBankRail()
    end

    --------------------------------------------------------------------------------
    -- Every character's bags and bank
    --------------------------------------------------------------------------------

    -- This character's entry: who, money, bags (and the bank while at a banker).
    -- An empty read (bags not in yet at login) never replaces a saved one.
    function SaveMe()
        local d = self:Char()
        local _, class = UnitClass("player")
        d.name, d.realm = asString(UnitName("player")), GetRealmName()
        d.class, d.level = asString(class), asNumber(UnitLevel("player"))
        d.money, d.seen = GetMoney(), time()
        local bags = snapshot(self:Bags())
        if bags.size > 0 then
            d.bags = bags
        end
        if self.atBank then
            local bank = snapshot(self:BankBags())
            if bank.size > 0 then
                d.bank = bank
            end
        end
        -- what you wear: item links by slot (head 1 … tabard 19)
        local worn: string[] = {}
        for slot = 1, 19 do
            local link = asString(GetInventoryItemLink("player", slot))
            if link then
                worn[#worn + 1] = link
            end
        end
        d.equipped = worn
    end

    function QueueSave()
        if self.saveTimer then
            return
        end
        self.saveTimer = after(1, function()
            self.saveTimer = nil
            if self:IsEnabled() then
                self:SaveMe()
            end
        end)
    end

    -- Saved characters, you first, then by name: { key, d, me }.
    function Characters(): chars.Character[]
        return chars.sortCharacters(self:AllCharData(), self:CharKey())
    end

    function UpdatePicker()
        local inv = self.inv
        local who, view = inv and inv.who, inv and inv.view
        if not (inv and who) then
            return
        end
        local opts: SelectOption<string>[] = {}
        local myRealm = GetRealmName()
        for _, c in ipairs(self:Characters()) do
            opts[#opts + 1] = { value = c.key, label = label(c, myRealm), note = c.me and "you" or ago(c.d.seen) }
        end
        who:SetOptions(opts)
        who:SetValue(self.who or self:CharKey())
        if view then
            view:SetValue(self.view or "bags")
        end
    end

    function ShowingResults(): boolean
        local inv = self.inv
        local all = inv and inv.all
        return all ~= nil and all.value == true and (self.query or "") ~= ""
    end

    -- Your own bags: Blizzard's live slots. Anything else is a saved copy.
    function IsLive(): boolean
        if not self.inv then
            return false
        end
        local who = self.who or self:CharKey()
        return who == self:CharKey() and (self.view or "bags") == "bags" and not self:ShowingResults()
    end

    -- A saved slot: SuuUI's own, read only; its tooltip from the item's link,
    -- shift-click links it.
    function SavedSlot(i: number): SavedSlot
        local known = self.savedSlots[i]
        if known then
            return known
        end
        local inv = self.inv
        assert(inv, "no bags window")
        local b = SavedSlot.new(inv.grid)
        b:SetScript("OnEnter", function(slot)
            itemTip(slot, slot.link)
        end)
        b:SetScript("OnLeave", function()
            GameTooltip:Hide()
        end)
        b:SetScript("OnClick", function(slot)
            local link = slot.link
            if link and IsModifiedClick() then
                try(field(_G, "HandleModifiedItemClick"), link)
            end
        end)
        self.savedSlots[i] = b
        return b
    end

    function HideSaved()
        for _, b in ipairs(self.savedSlots) do
            b:Hide()
        end
    end

    function ShowSaved()
        local inv = self.inv
        if not inv then
            return
        end
        local me = self:CharKey()
        local who, view = self.who or me or "", self.view or "bags"
        local d = self:EntryOf(who)
        local box: Snapshot? = nil
        if d then
            box = view == "bank" and d.bank or (view ~= "bank" and d.bags or nil)
        end
        local q = (self.query or ""):lower()
        local list: SavedSlot[] = {}
        for i, e in ipairs(box and box.slots or {}) do
            local b = self:SavedSlot(i)
            b.link = e and e.l or nil
            if e then
                local name = nameOf(e.l)
                b.skin:SetItem({
                    icon = e.t,
                    count = e.c,
                    quality = QUALITY[e.q] or "common",
                    dim = q ~= "" and not (name and name:lower():find(q, 1, true)),
                })
            else
                b.skin:SetItem(nil)
            end
            list[i] = b
        end
        for i = #list + 1, #self.savedSlots do
            self.savedSlots[i]:Hide()
        end
        inv:LayoutSlots(list)
        inv:SetMeta(box and ("%d free of %d"):format(box.free or 0, box.size or 0) or "")
        inv:SetBanner(chars.savedBanner(who, me, view, d, box))
    end

    -- "All characters": every item whose name holds the search, on every
    -- character's bags and bank, most first.
    function ShowResults()
        local inv = self.inv
        if not inv then
            return
        end
        self:SaveMe()
        local found: FoundItem[] = {}
        for i, r in ipairs(chars.searchResults(self:Characters(), (self.query or ""):lower())) do
            found[i] = {
                icon = r.icon,
                quality = r.quality,
                label = r.label,
                count = r.count,
                places = r.places,
                link = r.link,
                lines = r.lines,
            }
        end
        self.more = inv:SetResults(found)
        for _, row in ipairs(inv.resultRows or {}) do
            row:EnableMouse(true)
            row.onEnter = function(rowFrame: ResultRow)
                local it = rowFrame.item
                if it.link then
                    itemTip(rowFrame, it.link, it.lines)
                end
            end
            row.onLeave = function()
                GameTooltip:Hide()
            end
        end
        inv:SetMeta(#found == 1 and "1 item" or ("%d items"):format(#found))
        inv:SetBanner(nil)
    end

    -- The foot: the reagent bag on your own bags, else every character's gold;
    -- the money of whoever is shown.
    function Foot()
        local inv = self.inv
        if not inv then
            return
        end
        local who = self.who or self:CharKey()
        local more = self:ShowingResults() and (self.more or 0) or 0
        local reagentFree: number? = nil
        if self:IsLive() and self:Get("reagentBag") and numSlots(REAGENT) > 0 then
            reagentFree = freeSlots(REAGENT) or 0
        end
        local note, money = chars.foot(self:Characters(), who, GetMoney(), more, reagentFree)
        inv:SetNote(note)
        inv:SetMoney(money)
    end

    --------------------------------------------------------------------------------
    -- Item counts in tooltips
    --------------------------------------------------------------------------------

    function CountsFor(id: number): Counts[]
        return chars.countsFor(self:Characters(), id)
    end

    function AddCounts(tooltip: GameTooltip, data: unknown)
        if not self:Get("itemCounts") then
            return
        end
        local id = asNumber(field(data, "id"))
        if not id then
            return
        end
        local counts = self:CountsFor(id)
        if #counts == 0 then
            return
        end
        local muted, gilt = T.color["ink-muted"], T.color["gilt-text"]
        tooltip:AddLine(" ")
        local all = 0
        for _, n in ipairs(counts) do
            local parts: string[] = {}
            for _, w in ipairs(WHERE) do
                local count = w.key == "bags" and n.bags or w.key == "bank" and n.bank or n.equipped
                if count > 0 then
                    parts[#parts + 1] = w.label .. " " .. count
                end
            end
            local d = n.c.d
            local classFile = d.class
            local class = classFile and asString(field(T.color, "class-" .. classFile:lower(), "hex"))
            local name = d.name or n.c.key
            local realm = d.realm
            if realm and realm ~= GetRealmName() then
                name = name .. "-" .. realm
            end
            local left = classDiamond(classFile) .. (class and ("|cff" .. class .. name .. "|r") or name)
            tooltip:AddDoubleLine(left, table.concat(parts, " · "), 1, 1, 1, muted[1], muted[2], muted[3])
            all = all + n.total
        end
        if #counts > 1 then
            tooltip:AddDoubleLine("Total", tostring(all), gilt[1], gilt[2], gilt[3], gilt[1], gilt[2], gilt[3])
        end
        tooltip:Show() -- fit the new lines
    end

    --------------------------------------------------------------------------------
    -- Sell junk
    --------------------------------------------------------------------------------

    -- The grey items in your bags and what they fetch.
    function Junk(): (number, number)
        local n, copper = 0, 0
        for _, bag in ipairs(self:Bags()) do
            if bag ~= KEYRING then
                for slot = 1, numSlots(bag) do
                    local price, count = junkAt(bag, slot)
                    if price and count then
                        n, copper = n + 1, copper + price * count
                    end
                end
            end
        end
        return n, copper
    end

    -- One grey item a tick until none is left or the vendor closes.
    function SellJunk()
        if self.selling then
            return
        end
        self.selling = every(0.2, function(ticker)
            local sold = false
            if self.atMerchant and not InCombatLockdown() then
                for _, bag in ipairs(self:Bags()) do
                    if bag ~= KEYRING then
                        for slot = 1, numSlots(bag) do
                            if junkAt(bag, slot) then
                                C_Container.UseContainerItem(bag, slot)
                                sold = true
                                break
                            end
                        end
                    end
                    if sold then
                        break
                    end
                end
            end
            if not sold then
                ticker:Cancel()
                self.selling = nil
                self:UpdateJunk()
            end
        end)
    end

    -- The Sell junk button: at a vendor with something grey to sell.
    function UpdateJunk()
        local inv = self.inv
        if not inv then
            return
        end
        local n, copper = 0, 0
        if self.atMerchant and self:IsLive() then
            n, copper = self:Junk()
        end
        if n > 0 then
            inv:SetAction({
                text = "Sell junk",
                onClick = function()
                    self:SellJunk()
                end,
                tooltip = { title = "Sell junk", description = chars.junkText(n, copper) },
            })
        else
            inv:SetAction(nil)
        end
    end

    -- A refresh a moment after the typing stops (and after the game's own item
    -- search has run).
    function QueueRefresh()
        local pending = self.refreshTimer
        if pending then
            pending:Cancel()
        end
        self.refreshTimer = after(0.15, function()
            self.refreshTimer = nil
            if self:IsEnabled() then
                self:Guard(self.Refresh)(self)
            end
        end)
    end

    -- The window as the picker, Bags/Bank, All characters and the search say.
    function Refresh()
        local inv = self.inv
        if not (inv and inv:IsShown()) then
            return
        end
        local live = self:IsLive()
        for bag, f in pairs(self.bagFrames) do
            if not isBank(bag) then
                f:SetShown(live)
            end
        end
        inv.sort:SetEnabled(live and not self.sorting)
        self.more = nil
        if self:ShowingResults() then
            self:HideSaved()
            self:ShowResults()
        elseif live then
            self:HideSaved()
            inv:SetResults(nil)
            inv:SetBanner(nil)
            self:Rebuild()
        else
            inv:SetResults(nil)
            self:ShowSaved()
        end
        self:Foot()
        self:UpdateJunk()
        self:DrawBagRail()
    end

    --------------------------------------------------------------------------------
    -- Opening with Blizzard's bags
    --------------------------------------------------------------------------------

    -- A Blizzard frame under the hidden parent, kept there (if Blizzard moves it
    -- again) while keep() says so.
    function KeepHidden(f: Frame, keep: () -> boolean)
        if f:GetParent() ~= hidden then
            f:SetParent(hidden)
        end
        if self.parentHooked[f] then
            return
        end
        self.parentHooked[f] = true
        hook(f, "SetParent", function(_: unknown, parent: unknown)
            if parent ~= hidden and self:IsEnabled() and keep() then
                after(0, function()
                    if f:GetParent() ~= hidden and self:IsEnabled() and keep() then
                        f:SetParent(hidden)
                    end
                end)
            end
        end)
    end

    -- Blizzard's bank frame opens and closes as always but out of sight: moved
    -- off screen and see-through, not hidden (its OnShow opens your bags, its
    -- OnHide ends the visit at the banker, Esc included). The game's panel
    -- manager places it again whenever panels change: it goes back off screen
    -- a frame later. With the setting off it returns to where Blizzard put it.
    function HideBlizzardBank()
        local f = frames.find("BankFrame")
        if not f then
            return
        end
        local on = self:IsEnabled() and self:Get("bank")
        if not self.bankHooked then
            self.bankHooked = true
            self.bankClamped = f:IsClampedToScreen() and true or false
            hook(f, "SetPoint", function(_: unknown, ...: unknown)
                if self.movingBank then
                    return
                end
                self.bankPoint = { ... } -- where Blizzard put it
                if self:IsEnabled() and self:Get("bank") then
                    self:QueueBankAway()
                end
            end)
            hookScript(f, "OnShow", function()
                if self:IsEnabled() and self:Get("bank") then
                    self:BankAway()
                end
            end)
        end
        if on then
            self:BankAway()
        else
            f:SetAlpha(1)
            f:SetClampedToScreen(self.bankClamped)
            local point = self.bankPoint
            if point then
                self.movingBank = true
                f:ClearAllPoints()
                errors.tryMethod(f, "SetPoint", unpack(point))
                self.movingBank = false
            end
        end
    end

    function BankAway()
        local f = frames.find("BankFrame")
        if not f then
            return
        end
        f:SetAlpha(0)
        f:SetClampedToScreen(false)
        self.movingBank = true
        f:ClearAllPoints()
        f:SetPoint("BOTTOMRIGHT", UIParent, "TOPLEFT", -200, 200)
        self.movingBank = false
    end

    function QueueBankAway()
        if self.bankAwayQueued then
            return
        end
        self.bankAwayQueued = true
        local f = frames.find("BankFrame")
        if f then
            f:SetAlpha(0)
        end
        after(0, function()
            self.bankAwayQueued = false
            if self:IsEnabled() and self:Get("bank") then
                self:BankAway()
            end
        end)
    end

    -- Blizzard's bag frames under a hidden parent: they keep opening and
    -- closing (so every way of opening bags still works), out of sight.
    function HideBlizzardBags()
        local names = { "ContainerFrameContainer", "ContainerFrameCombinedBags" }
        for i = 1, (NUM_CONTAINER_FRAMES or 13) do
            names[#names + 1] = "ContainerFrame" .. i
        end
        local container = frames.find("ContainerFrameContainer")
        for _, name in ipairs(names) do
            local f = frames.find(name)
            -- frames inside Blizzard's container go with it
            if f and f ~= container and container and f:GetParent() == container then
                f = nil
            end
            if f then
                self:KeepHidden(f, function(): boolean
                    return true
                end)
            end
        end
    end

    function BagCall(name: string, frame: unknown)
        local inv = self.inv
        local shown = inv ~= nil and inv:IsShown()
        -- Blizzard's outer calls make inner ones first (OpenAllBags opens the
        -- backpack and each bag, CloseAllBags closes them): whether the window
        -- was open is read at the first call of the moment.
        if not self.syncQueued then
            self.burstShown, self.burstOpenedBy = shown, self.openedBy
        end
        if OPENS[name] then
            -- opened for a window (a vendor, the mail): closed with it, unless
            -- the bags were open before (Blizzard's own rule)
            if name == "OpenAllBags" then
                if not self.burstShown then
                    self.openedBy = nameOfFrame(frame)
                end
            end
            self.wantOpen = true
        elseif CLOSES[name] then
            local by = name == "CloseAllBags" and nameOfFrame(frame) or nil
            if by then
                -- another window's bags closing: yours stay as they were. (The
                -- bag-by-bag closes Blizzard made inside this call came in
                -- too: bags you had opened SuuUI's way, or were open before,
                -- closed with a vendor or the mail.)
                if by ~= self.burstOpenedBy then
                    self.wantOpen, self.openedBy = self.burstShown, self.burstOpenedBy
                    self:QueueSync()
                    return
                end
            end
            -- one bag closing (the game closes a bag taken off its slot) leaves
            -- the window, which shows every bag, open (found in game)
            if name == "CloseBag" and frame ~= 0 then
                return
            end
            self.openedBy = nil
            self.wantOpen = false
        else -- a toggle
            self.openedBy = nil
            self.wantOpen = not shown
        end
        self:QueueSync()
    end

    -- SuuUI's own ways (the micro menu, the close button): its window only.
    function SetOpen(on: boolean)
        self.openedBy = nil
        self.wantOpen = on
        self:Sync()
    end

    function Toggle()
        local inv = self.inv
        self:SetOpen(not (inv and inv:IsShown()))
    end

    -- The bags at their place, or beside the bank while it is open.
    function PlaceBags()
        local inv, bank = self.inv, self.bank
        if not inv then
            return
        end
        inv:ClearAllPoints()
        if bank and bank:IsShown() then
            -- the bags' rail moves to their right side here (asked for in game)
            inv:SetPoint("TOPLEFT", bank, "TOPRIGHT", S["space-5"], 0)
        else
            local pos = self:Get("position")
            inv:SetPoint(pos.point or "CENTER", SuuUI.Root, pos.point or "CENTER", pos.x or 0, pos.y or 0)
        end
    end

    function Sync()
        local inv = self.inv
        if not inv then
            return
        end
        local open = self.wantOpen
        if open and not inv:IsShown() then
            self:PlaceBags()
            inv:Show()
            self:UpdatePicker()
            self:Refresh()
        elseif not open and inv:IsShown() then
            inv:Hide()
        end
    end

    -- At a banker (BANKFRAME_OPENED) and away again.
    function ShowBank()
        local bank = self.bank
        if not (bank and self:Get("bank")) then
            return
        end
        self:HideBlizzardBank()
        bank:Show()
        self:RebuildBank()
        self:PlaceBags()
        self:DrawBagRail()
    end

    function HideBank()
        local bank = self.bank
        if not bank or not bank:IsShown() then
            return
        end
        bank:Hide()
        self:PlaceBags()
        self:DrawBagRail()
    end

    function QueueSync()
        if self.syncQueued then
            return
        end
        self.syncQueued = true
        after(0, function()
            self.syncQueued = false
            if self:IsEnabled() then
                self:Sync()
            end
        end)
    end

    --------------------------------------------------------------------------------
    -- Sorting
    --------------------------------------------------------------------------------

    -- The slots a sort covers, in the window's order, as they are now.
    function SortSlots(bank: boolean): SortSlot[]
        local bags = bank and self:BankBags() or { 0, 1, 2, 3, 4 }
        if not bank and self:Get("reagentBag") then
            bags[#bags + 1] = REAGENT
        end
        local slots: SortSlot[] = {}
        for _, bag in ipairs(bags) do
            local family: Family = 0
            if bag == REAGENT then
                family = "reagent"
            else
                local _, f = C_Container.GetContainerNumFreeSlots(bag)
                family = asNumber(f) or 0
            end
            for slot = 1, numSlots(bag) do
                local s: SortSlot = { bag = bag, slot = slot, family = family }
                local info = C_Container.GetContainerItemInfo(bag, slot)
                if info and asNumber(info.itemID) then
                    s.item = itemOf(info)
                    s.locked = flag(info.isLocked)
                end
                slots[#slots + 1] = s
            end
        end
        return slots
    end

    -- Part stacks of one item put together (Bags/Sort's planStacks).
    function PlanStacks(slots: SortSlot[], st: sort.StackState): Move[]
        return sort.planStacks(slots, st)
    end

    -- Where each item belongs (Bags/Sort's sortTarget).
    function SortTarget(slots: SortSlot[], order: string, toEnd: boolean): sort.Target?
        return sort.sortTarget(slots, order, toEnd)
    end

    -- One wave of moves on separate slots (Bags/Sort's planWave).
    function PlanWave(slots: SortSlot[], target: sort.Target): (Move[], number)
        return sort.planWave(slots, target)
    end

    -- The window a sort covers, and the loading mark over its slots.
    function SortCover(inv: Inventory, on: boolean, title: string?)
        local c = self.covers[inv]
        if not c then
            c = SortCover.new(inv)
            self.covers[inv] = c
        end
        if on then
            c.title:SetValue(title or "Sorting")
            c.caption:SetValue("")
            c:Show()
            c.mark:Start()
        else
            c.mark:Stop()
            c:Hide()
        end
        inv.sort:SetEnabled(not on and (inv ~= self.inv or self:IsLive()))
    end

    function SortCaption(text: string?)
        local st = self.sorting
        local cover = st and self.covers[st.inv]
        if cover then
            cover.caption:SetValue(text or "")
        end
    end

    -- The Sort button: SuuUI's order, or the game's sort.
    function Sort(bank: boolean)
        if self.sorting then
            return
        end
        local inv = bank and self.bank or self.inv
        if not inv then
            return
        end
        if InCombatLockdown() then
            self:Print("Your bags can't be sorted in combat.")
            return
        end
        if CursorHasItem() then
            self:Print("Put down the item you're holding first, then press Sort.")
            return
        end
        local order, toEnd = self:Get("sortOrder"), self:Get("sortDirection") ~= "start"
        local st: SortState = {
            bank = bank,
            inv = inv,
            order = order,
            toEnd = toEnd,
            phase = "stack",
            rounds = 0,
            waves = 0,
            idle = 0,
            started = GetTime(),
            partials = {},
            noStack = {},
        }
        self.sorting = st
        self:SortCover(inv, true, bank and "Sorting the bank" or "Sorting bags")
        if order == "game" then
            st.game = true
            -- right to left off: the game fills the last bags and leaves the gaps
            -- in the first (seen in the probe)
            try(field(C_Container, "SetSortBagsRightToLeft"), not toEnd)
            if bank then
                sortBank()
            else
                try(field(C_Container, "SortBags"))
            end
            self:SortCaption("The game is sorting…")
            st.wait = { at = GetTime(), moves = {} }
            local driver = self.sortDriver
            if driver then
                driver:Show()
            end
            return
        end
        self:SortStep()
    end

    -- One wave: read, plan, send.
    function SortStep()
        local st = self.sorting
        if not st then
            return
        end
        if CursorHasItem() then
            return self:StopSort("you picked up an item")
        end
        local slots = self:SortSlots(st.bank)
        local moves: Move[]? = nil
        if st.phase == "stack" then
            st.rounds = st.rounds + 1
            local stacks = self:PlanStacks(slots, st)
            if #stacks == 0 or st.rounds > STACK_ROUNDS then
                st.phase = "place"
            else
                moves = stacks
                self:SortCaption("Stacking…")
            end
        end
        if not moves then
            local target = self:SortTarget(slots, st.order, st.toEnd)
            if not target then
                return self:StopSort("there isn't room to put everything in order")
            end
            local wave, wrong = self:PlanWave(slots, target)
            moves = wave
            if wrong == 0 then
                return self:FinishSort()
            end
            st.total = math.max(st.total or 0, wrong)
            self:SortCaption(("%d item%s to move"):format(wrong, wrong == 1 and "" or "s"))
            -- every move puts one slot right: no fewer wrong for a while means stuck
            local last = st.lastWrong
            if last and wrong >= last then
                st.idle = st.idle + 1
            else
                st.idle = 0
            end
            st.lastWrong = wrong
            if st.idle > 6 then
                return self:StopSort("some items wouldn't go where the order puts them")
            end
        end
        st.waves = st.waves + 1
        if st.waves > MAX_WAVES then
            return self:StopSort("it took too long")
        end
        for _, m in ipairs(moves) do
            pcall(C_Container.PickupContainerItem, m.from.bag, m.from.slot)
            if CursorHasItem() then
                pcall(C_Container.PickupContainerItem, m.to.bag, m.to.slot)
                if CursorHasItem() then
                    ClearCursor()
                    return self:StopSort("the game didn't take a move")
                end
            end
        end
        st.wait = { at = GetTime(), moves = moves }
        local driver = self.sortDriver
        if driver then
            driver:Show()
        end
    end

    -- Each frame while a wave is on its way: on when its slots are free again
    -- and the bags have updated (the game's sort: once the bags are quiet).
    function SortTick()
        local st, driver = self.sorting, self.sortDriver
        local w = st and st.wait
        if not (st and w) then
            if driver then
                driver:Hide()
            end
            return
        end
        local state = sort.waveState(w, GetTime(), st.game == true, st.lastUpdate, locked)
        if state == "finish" then
            return self:FinishSort()
        end
        if state == "timeout" then
            return self:StopSort("the game didn't answer")
        end
        if state == "wait" then
            return
        end
        st.wait = nil
        if driver then
            driver:Hide()
        end
        self:SortStep()
    end

    function EndSort()
        local st = self.sorting
        if not st then
            return
        end
        self.sorting = nil
        local driver = self.sortDriver
        if driver then
            driver:Hide()
        end
        self:SortCover(st.inv, false)
        if st.inv == self.inv then
            self:Rebuild()
        else
            self:RebuildBank()
        end
    end

    function FinishSort()
        self:EndSort()
    end

    -- Stopped where it is; Sort again finishes it. The bank's first wave refused:
    -- the game's bank sort instead.
    function StopSort(why: string)
        local st = self.sorting
        if not st then
            return
        end
        self:EndSort()
        if st.bank and not st.game and st.waves <= 1 and why:find("^the game") then
            sortBank()
            self:Print("The game didn't let SuuUI move bank items; your bank got the game's own sort instead.")
            return
        end
        self:Print(("Sorting stopped: %s. Press Sort to finish."):format(why))
    end

    -- The Sort button's tooltip, after the order and direction.
    function SortTip()
        local orderLabel = sort.sortLabel(self:Get("sortOrder"))
        local where = self:Get("sortDirection") == "start" and "the start" or "the end"
        local tip = {
            title = "Sort",
            description = ("%s, gathered at %s of your bags. Settings › Bags › Sort changes it."):format(
                orderLabel,
                where
            ),
        }
        local inv, bank = self.inv, self.bank
        if inv then
            inv.sort.tip = tip
        end
        if bank then
            bank.sort.tip = tip
        end
    end

    --------------------------------------------------------------------------------
    -- Settings
    --------------------------------------------------------------------------------

    function PreviewView(parent: Frame): Inventory
        local view = self.preview
        if not view then
            local inv = UI.Inventory(parent, { title = "Bags", columns = self:Get("columns"), characters = true })
            inv.onClose = function() end
            local who = inv.who
            assert(who, "no picker")
            who:SetOptions({
                {
                    value = "you",
                    label = secret.known(UnitName("player"), "You") .. " · " .. (asNumber(UnitLevel("player")) or 1),
                },
            })
            who:SetValue("you")
            local slots: ItemSlot[] = {}
            for i = 1, 40 do
                local b = UI.ItemSlot(inv.grid)
                b.skin:SetItem(PREVIEW_ITEMS[i])
                slots[i] = b
            end
            inv.previewSlots = slots
            inv:LayoutSlots(slots)
            inv:SetMeta("28 free of 40")
            inv:SetNote("3 characters · 2,112g in all")
            inv:SetMoney(12043709)
            self.preview = inv
            view = inv
        end
        view:SetParent(parent)
        return view
    end

    -- A saved character to forget (Settings › Bags › Characters).
    function ForgetRow(parent: Frame): ForgetRow
        local function options(): SelectOption<string>[]
            local out: SelectOption<string>[] = {}
            local myRealm = GetRealmName()
            for _, c in ipairs(self:Characters()) do
                if not c.me then
                    out[#out + 1] = { value = c.key, label = label(c, myRealm), note = ago(c.d.seen) }
                end
            end
            return out
        end
        return ForgetRow.new(parent, options, function(key: string)
            self:ForgetCharData(key)
        end)
    end

    --------------------------------------------------------------------------------
    -- Lifecycle
    --------------------------------------------------------------------------------

    -- The windows, the rails and the sort's driver, once.
    function Build()
        if self.inv then
            return
        end
        local inv = UI.Inventory(SuuUI.Root, {
            name = "SuuUIBags",
            title = "Bags",
            columns = self:Get("columns"),
            characters = true,
        })
        local bank = UI.Inventory(SuuUI.Root, { name = "SuuUIBank", title = "Bank", columns = self:Get("columns") })
        self.inv, self.bank = inv, bank
        local who, view, all = inv.who, inv.view, inv.all
        if who then
            who.onChange = function(key: string)
                self:Guard(function()
                    if self.sorting and key ~= self:CharKey() then
                        self:StopSort("you picked another character's bags")
                    end
                    self.who = key
                    self:Refresh()
                end)()
            end
        end
        if view then
            view.onChange = function(v: string)
                self:Guard(function()
                    self.view = v
                    self:Refresh()
                end)()
            end
        end
        if all then
            all.onChange = function(on: boolean)
                self:Guard(function()
                    inv.search.placeholder:SetValue(on and "Search every character" or "Search")
                    self:Refresh()
                end)()
            end
        end
        -- back to your own bags when it closes
        inv:HookScript("OnHide", function()
            self.who, self.view, self.query = nil, "bags", ""
        end)
        inv:SetFrameStrata("MEDIUM")
        inv:SetToplevel(true)
        inv:EnableMouse(true)
        inv:Hide()
        inv.onClose = function()
            self:SetOpen(false)
        end
        inv.sort:SetScript("OnClick", function()
            self:Guard(function()
                self:Sort(false)
            end)()
        end)
        bank:SetFrameStrata("MEDIUM")
        bank:SetToplevel(true)
        bank:EnableMouse(true)
        bank:Hide()
        bank.onClose = closeBank
        bank.sort:SetScript("OnClick", function()
            self:Guard(function()
                self:Sort(true)
            end)()
        end)
        -- a sort stops when its window closes, or another character's bags show
        inv:HookScript("OnHide", function()
            local st = self.sorting
            if st and st.inv == inv then
                self:StopSort("the bags closed")
            end
        end)
        bank:HookScript("OnHide", function()
            local st = self.sorting
            if st and st.inv == bank then
                self:StopSort("the bank closed")
            end
        end)
        local driver = CreateFrame("Frame")
        driver:Hide()
        driver:SetScript("OnUpdate", function()
            self:Guard(function()
                self:SortTick()
            end)()
        end)
        self.sortDriver = driver
        -- one search across both windows; it ends with them
        local function search(from: Inventory, other: Inventory)
            from.search.onTextChanged = function(text: string)
                self:Guard(function()
                    other.search:SetValue(text or "")
                    try(field(C_Container, "SetItemSearch"), text or "")
                    local wasLive = self:IsLive()
                    self.query = text or ""
                    if not (wasLive and self:IsLive()) then
                        self:QueueRefresh()
                    end
                end)()
            end
            from:HookScript("OnHide", function()
                if other:IsShown() then
                    return
                end
                if from.search.edit:GetText() ~= "" or other.search.edit:GetText() ~= "" then
                    from.search:SetValue("")
                    other.search:SetValue("")
                    try(field(C_Container, "SetItemSearch"), "")
                end
            end)
        end
        search(inv, bank)
        search(bank, inv)
        -- the bag slot rails (design B), and the header's Bags toggle beside
        -- All characters (asked for in game)
        self.bagRail = Rail.new(inv)
        self.bankRail = Rail.new(bank)
        local allLabel = inv.allLabel
        if allLabel then
            local toggle = UI.Toggle(inv.body, {
                value = self:Get("bagSlots"),
                onChange = function(on: boolean)
                    self:Guard(function()
                        self:Set("bagSlots", on)
                    end)()
                end,
            })
            toggle:SetPoint("RIGHT", allLabel, "LEFT", -S["space-6"], 0)
            inv.slotsToggle = toggle
            local slotsLabel = UI.Text(inv.body, "label", "ink-muted")
            slotsLabel:SetValue("Bags")
            slotsLabel:SetPoint("RIGHT", toggle, "LEFT", -S["space-4"], 0)
            inv.slotsLabel = slotsLabel
        end
        bank:HookScript("OnHide", function()
            self:PlaceBuy(false)
        end)
    end

    override function OnEnable()
        if not C_Container then
            return
        end
        self:ProvideService(BAGS, {
            Toggle = function()
                self:Toggle()
            end,
        })
        self:Build()
        local inv, bank = self.inv, self.bank
        if not (inv and bank) then
            return
        end
        self:HideBlizzardBags()
        self:HideBlizzardBank()
        -- (the bags follow Blizzard's bags, the bank shows at a banker: not edit mode)
        self:RegisterMover(inv, { key = "position", label = "Bags", managedShow = true })
        self:RegisterMover(bank, { key = "bankPosition", label = "Bank", managedShow = true })
        self:RegisterSettings(SECTION)
        self:Watch("columns", function(v)
            inv:SetColumns(v)
            bank:SetColumns(v)
            self:Refresh()
            self:RebuildBank()
        end)
        self:Watch("bank", function(on)
            self:HideBlizzardBank()
            if not on then
                self:HideBank()
            end
        end)
        self:Watch("reagentBag", function()
            self:Refresh()
        end)
        self:Watch("bagSlots", function(on)
            local toggle = inv.slotsToggle
            if toggle then
                toggle:SetValue(on)
            end
            self:DrawRails()
        end)
        self:Watch("keyring", function()
            self:Refresh()
        end)
        self:Watch("sortOrder", function()
            self:SortTip()
        end)
        self:Watch("sortDirection", function()
            self:SortTip()
        end)
        self:SortTip()
        -- a theme can change the caption and micro styles the slots and rails
        -- are laid out in
        self:On("SUUUI_THEME_CHANGED", function()
            self:Refresh()
            self:RebuildBank()
        end)
        -- Blizzard opening or closing bags, by any of its ways
        if not self.hooked then
            self.hooked = true
            for _, name in ipairs({
                "ToggleAllBags",
                "OpenAllBags",
                "CloseAllBags",
                "ToggleBag",
                "OpenBag",
                "CloseBag",
                "ToggleBackpack",
                "OpenBackpack",
                "CloseBackpack",
            }) do
                if type(field(_G, name)) == "function" then
                    hook(name, function(frame: unknown)
                        if self:IsEnabled() then
                            self:BagCall(name, frame)
                        end
                    end)
                end
            end
        end
        -- what changes in the bags
        self:OnGameEvent("BAG_UPDATE", function(_, bagID)
            local bag = asNumber(bagID)
            local window = bag and self:InvFor(bag)
            if bag and window and window:IsShown() then
                self:UpdateBag(bag)
            end
        end)
        for _, e in ipairs({ "BAG_UPDATE_DELAYED", "BAG_CONTAINER_UPDATE", "PLAYER_ENTERING_WORLD" }) do
            self:OnGameEvent(e, function()
                if inv:IsShown() then
                    self:Rebuild()
                    self:UpdateJunk()
                end
                self:RebuildBank()
                if e ~= "PLAYER_ENTERING_WORLD" then
                    self:QueueSave()
                end
            end)
        end
        for _, e in ipairs({ "BANK_TABS_CHANGED", "PLAYERBANKSLOTS_CHANGED" }) do
            self:OnGameEvent(e, function()
                self:RebuildBank()
            end)
        end
        -- the rails: bags put in or taken off, the next slot's price against your money
        self:OnGameEvent("UNIT_INVENTORY_CHANGED", function(_, unit)
            if unit == "player" then
                self:DrawRails()
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if bank:IsShown() then
                self:DrawBankRail()
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            local over = self.buyOver
            if over then
                over.hide()
            end
        end)
        -- a sort: its waves land, combat or a refused move stops it
        self:OnGameEvent("BAG_UPDATE_DELAYED", function()
            local st = self.sorting
            if not st then
                return
            end
            st.lastUpdate = GetTime()
            local wave = st.wait
            if wave then
                wave.updated = true
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            if self.sorting then
                self:StopSort("combat started")
            end
        end)
        self:OnGameEvent("UI_ERROR_MESSAGE", function(_, _, message)
            local st = self.sorting
            if not (st and st.wait and not st.game) then
                return
            end
            local text = asString(message)
            self:StopSort("the game refused a move" .. (text and (" (" .. text .. ")") or ""))
        end)
        self:OnGameEvent("BANKFRAME_OPENED", function()
            self.atBank = true
            self:ShowBank()
            self:QueueSave()
        end)
        self:OnGameEvent("BANKFRAME_CLOSED", function()
            if self.atBank then
                self:SaveMe()
            end
            self.atBank = false
            self:HideBank()
        end)
        self:OnGameEvent("PLAYER_LEVEL_UP", function()
            self:QueueSave()
        end)
        self:OnGameEvent("PLAYER_EQUIPMENT_CHANGED", function()
            self:QueueSave()
        end)
        local addPostCall = field(_G, "TooltipDataProcessor", "AddTooltipPostCall")
        local itemType = field(Enum, "TooltipDataType", "Item")
        if not self.tipHooked and type(addPostCall) == "function" and itemType ~= nil then
            self.tipHooked = true
            try(addPostCall, itemType, function(tooltip: unknown, data: unknown)
                if not self:IsEnabled() then
                    return
                end
                local tip = tooltip == GameTooltip and GameTooltip or tooltip == ItemRefTooltip and ItemRefTooltip or
                    nil
                if tip then
                    self:Guard(function()
                        self:AddCounts(tip, data)
                    end)()
                end
            end)
        end
        self:OnGameEvent("MERCHANT_SHOW", function()
            self.atMerchant = true
            self:UpdateJunk()
        end)
        self:OnGameEvent("MERCHANT_CLOSED", function()
            self.atMerchant = false
            self:UpdateJunk()
        end)
        self:OnGameEvent("PLAYER_LOGOUT", function()
            self:SaveMe()
        end)
        self:OnGameEvent("ITEM_LOCK_CHANGED", function(_, bagID, slotID)
            local bag, slot = asNumber(bagID), asNumber(slotID)
            local window = bag and self:InvFor(bag)
            if bag and slot and window and window:IsShown() then
                self:UpdateSlot(bag, slot)
            end
        end)
        for _, e in ipairs({ "BAG_UPDATE_COOLDOWN", "INVENTORY_SEARCH_UPDATE" }) do
            self:OnGameEvent(e, function()
                self:UpdateShown()
            end)
        end
        self:OnGameEvent("PLAYER_MONEY", function()
            self:Char().money = GetMoney()
            if inv:IsShown() then
                self:Foot()
            end
            if bank:IsShown() then
                self:DrawBankRail()
            end
        end)
        self:Sync()
    end

    override function OnDisable()
        local inv, bank = self.inv, self.bank
        if inv then
            inv:Hide()
        end
        if bank then
            bank:Hide()
        end
    end
end

M = SuuUI.AddModule(BagsModule.new())
