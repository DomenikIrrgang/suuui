    { icon = 132889, count = 20 },
    { icon = 135232, count = 6 },
    { icon = 134566, count = 14 },
    { icon = 134074, count = 2, quality = "uncommon" },
    { icon = 134939, quality = "rare" },
    { icon = 135637, quality = "poor" },
    { icon = 134075, quality = "uncommon" },
    { icon = 134173 },
    { icon = 133972, count = 12 },
    { icon = 134937, quality = "epic" },
}

