-- Item counts in tooltips
--------------------------------------------------------------------------------

local WHERE: { key: "bags" | "bank" | "equipped", label: string }[] = {
    { key = "bags", label = "Bags" },
    { key = "bank", label = "Bank" },
    { key = "equipped", label = "Equipped" },
}

-- How many of item `id` each saved character has: { { c, total, bags, bank, equipped } } in picker order.
type Counts = chars.Counts

--------------------------------------------------------------------------------
-- Sell junk
--------------------------------------------------------------------------------

-- A grey item the vendor will buy: its sell price per item, or nil.
local function junkAt(bag: number, slot: number): (number?, number?)
    local info = C_Container.GetContainerItemInfo(bag, slot)
    if not (info and asNumber(info.quality) == 0) then
        return nil, nil
    end
    if flag(info.hasNoValue) then
        return nil, nil
    end
    if flag(info.isLocked) then
        return nil, nil
    end
    local price = 0
    local link = asString(info.hyperlink)
    if link then
        price = asNumber((select(11, try(field(C_Item, "GetItemInfo"), link)))) or 0
    end
    return price, asNumber(info.stackCount) or 1
end

--------------------------------------------------------------------------------
-- Opening with Blizzard's bags
--------------------------------------------------------------------------------

local hidden = CreateFrame("Frame")
hidden:Hide()

-- Open or closed is SuuUI's own state, following Blizzard's open, close and
-- toggle calls (hooked) but never calling them: Blizzard's bag code run from
-- SuuUI's code writes its frames' fields as SuuUI's, and Esc, which closes
-- the bags first, then counted as an addon's in combat and couldn't close
-- any window ("Interface action failed", found in game with the spells
-- window: /suu probe taint). Of the calls of one moment the last to return
-- (the outermost: ToggleAllBags after the CloseBag inside it) decides.
local OPENS: { [string]: boolean } = { OpenAllBags = true, OpenBag = true, OpenBackpack = true }
local CLOSES: { [string]: boolean } = { CloseAllBags = true, CloseBag = true, CloseBackpack = true }

local function closeBank()
    local close = field(C_Bank, "CloseBankFrame")
    if type(close) ~= "function" then
        close = field(_G, "CloseBankFrame")
    end
    try(close)
end

local function sortBank()
    local sortFn = field(C_Container, "SortBank")
    if type(sortFn) ~= "function" then
        return
    end
    local run = sortFn :: (...unknown) -> ()
    -- (without an argument as before: 0.9.1 declares SortBank's bankType as required)
    if not (BANK_TYPE and pcall(run, BANK_TYPE)) then
        pcall(run)
    end
end

-- The window's name for a frame that opened the bags (the mail, a vendor).
local function nameOfFrame(frame: unknown): string?
    return asString(errors.tryMethod(frame, "GetName"))
end

--------------------------------------------------------------------------------
-- Sorting (asked 2026-10-19): SuuUI sorts your bags and bank itself, in the
-- order Settings › Bags › Sort picks (by type, quality, item level or name),
-- the items gathered at the start or the end of the bags; or the game's own
-- sort. What the client allows (/suu probe bagsort, 2026-10-19): picking an
-- item up and putting it on another slot (C_Container.PickupContainerItem
-- twice) works for addon code out of combat, nothing blocked; each move
-- lands in about 0.35 s (ITEM_LOCK_CHANGED, then BAG_UPDATE and
-- BAG_UPDATE_DELAYED), and moves on separate slots sent in one frame land
-- together. An item put on a part stack of its own kind stacks onto it. The
-- reagent bag takes only crafting reagents (its family reads 0; the game
-- refuses anything else with an error).
-- A sort runs in waves: the bags read as they are, where everything should
-- be worked out again, up to WAVE moves on separate slots sent, then a wait
-- for their locks to clear. Part stacks are put together first. Meanwhile
-- the window waits under the loading mark; combat, an item you pick up, the
-- window closing or the game refusing a move stops it where it is.
--------------------------------------------------------------------------------

local MAX_WAVES, STACK_ROUNDS = sort.MAX_WAVES, sort.STACK_ROUNDS
type SortSlot = sort.SortSlot
type Move = sort.Move
type Family = sort.Family
local SORT_OPTIONS = sort.SORT_OPTIONS
local itemOf = sort.itemOf

-- A sort under way: its window and order, where it stands, the wave on its
-- way, what PlanStacks remembers.
type SortState = {
    bank: boolean,
    inv: Inventory,
    order: string,
    toEnd: boolean,
    phase: string,
    rounds: number,
    waves: number,
    idle: number,
    started: number,
    partials: { [number | string]: number },
    noStack: { [number | string]: boolean },
    game?: boolean,
    wait?: sort.Wave,
    total?: number,
    lastWrong?: number,
    lastUpdate?: number,
}

local function locked(s: SortSlot): boolean
    local info = C_Container.GetContainerItemInfo(s.bag, s.slot)
    return info ~= nil and flag(info.isLocked)
end

