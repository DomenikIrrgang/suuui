-- Units/DeathRecap.wowlua
-- SuuUI's own death recap (asked 2026-10-18, design "Death recap", option
-- A "List under a health line"): the hits that killed you, from the game's
-- recap (C_DeathRecap): the killing blow on top, a small health line falling
-- to zero across the last seconds, then every hit, oldest first, ending on
-- the killing blow in ember. It opens wherever the game opens its own (the
-- death request's Recap, a death link in chat): OpenDeathRecapUI is hooked,
-- Blizzard's frame closed again, this window shown in its place.
-- The game lists hits only: health that rises between two hits was healing.
-- An event's fields aren't documented on Forever: the ones Blizzard's own
-- recap reads (/suu probe deathrecap records what a death gives).
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type WindowFrame from "/UI/Panel"
import type Icon from "/UI/Icon"
import type Text from "/UI/Text"
import hook from "wowlua:hooks"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {}

local M: DeathRecapModule


local isSecret: (v: unknown) -> boolean = issecretvalue or function(_: unknown): boolean return false end
local function readable(v: unknown): v is number return type(v) == "number" and not isSecret(v) end
local function text(v: unknown): v is string return type(v) == "string" and not isSecret(v) and v ~= "" end

-- One of the game's recap events (C_DeathRecap.GetRecapEvents, newest
-- first): undocumented on Forever, and any field may be secret, so each is
-- read with care.
export type DeathEvent = {
    event?: unknown, environmentalType?: unknown, spellId?: unknown, spellName?: unknown, timestamp?: unknown,
    currentHP?: unknown, amount?: unknown, school?: unknown, critical?: unknown, overkill?: unknown,
    sourceName?: unknown, hideCaster?: unknown, absorbed?: unknown, resisted?: unknown, blocked?: unknown,
}

local WIDTH, HEIGHT = 440, 470
local LINE_H = 44
local ROW_H = 34
local ICON = 20
local TIME_W = 44
local HEALTH_W = 64
local AMOUNT_W = 84
local SCHOOL: { [number]: string } = { [1] = "Physical", [2] = "Holy", [4] = "Fire", [8] = "Nature", [16] = "Frost", [32] = "Shadow", [64] = "Arcane" }
local ENVIRONMENT: { [string]: string } = { DROWNING = "spell_shadow_demonbreath", FALLING = "ability_rogue_quickrecovery", FIRE = "spell_fire_fire",
                      LAVA = "spell_fire_fire", SLIME = "inv_misc_slime_01", FATIGUE = "ability_creature_cursed_05" }

-- "1,956"
local function group3(n: number): string
    local s = tostring(math.floor(n + 0.5))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

-- An event's spell: its name, icon and whether it is a melee swing.
-- A spell's icon: a texture's file or ID.
type Art = string | number

local function spellOf(e: DeathEvent): (string, Art?)
    local event = e.event
    local kind = text(event) and event or ""
    if kind == "SWING_DAMAGE" then
        local consts = Constants and Constants.DeathRecapConsts
        local swing = consts and consts.SWING_DAMAGE_SPELL_ID
        return "Melee", swing and (C_Spell.GetSpellTexture(swing)) or "Interface\\Icons\\INV_Sword_04"
    end
    local environment = e.environmentalType
    if kind == "ENVIRONMENTAL_DAMAGE" and text(environment) then
        local env = environment:upper()
        local named: unknown = _G["ACTION_ENVIRONMENTAL_DAMAGE_" .. env]
        local name = text(named) and named or (env:lower():gsub("^%l", string.upper))
        return name, "Interface\\Icons\\" .. (ENVIRONMENT[env] or "ability_creature_cursed_05")
    end
    local id = e.spellId
    local icon = readable(id) and (C_Spell.GetSpellTexture(id)) or nil
    local spell = e.spellName
    return text(spell) and spell or "Unknown", icon
end

-- What else a hit says, after its caster: absorbed, resisted, blocked.
local function extras(e: DeathEvent): string[]
    local out: string[] = {}
    local function add(v: unknown, word: string)
        if readable(v) and v > 0 then out[#out + 1] = group3(v) .. " " .. word end
    end
    add(e.absorbed, "absorbed")
    add(e.resisted, "resisted")
    add(e.blocked, "blocked")
    return out
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

-- A hit's row.
class HitRow extends Frame
    readonly rule: Texture
    readonly time: Text
    readonly icon: Icon
    readonly name: Text
    readonly by: Text
    readonly hp: Text
    readonly hpTrack: Texture
    readonly hpFill: Texture
    readonly amount: Text
    readonly flag: Text
    -- for the spell's own tooltip
    spellID: number? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(WIDTH - S["space-5"] * 2, ROW_H)
        self.rule = UI.Fill(self, "gilt-faint")
        self.rule:SetHeight(1)
        self.rule:SetPoint("BOTTOMLEFT")
        self.rule:SetPoint("BOTTOMRIGHT")
        self.time = UI.Text(self, "caption", "ink-muted")
        self.time:SetPoint("LEFT", 0, 0)
        self.icon = UI.Icon(self, ICON)
        self.icon:SetPoint("LEFT", TIME_W, 0)
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.icon, "TOPRIGHT", S["space-3"], 2)
        self.name:SetWordWrap(false)
        self.by = UI.Text(self, "caption", "ink-muted")
        self.by:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, 0)
        self.by:SetWordWrap(false)
        -- health after it: the number over a short bar
        self.hp = UI.Text(self, "numeric", "ink")
        self.hp:SetPoint("TOPRIGHT", 0, -3)
        self.hpTrack = UI.Fill(self, "track")
        self.hpTrack:SetSize(HEALTH_W - S["space-3"], 3)
        self.hpTrack:SetPoint("TOPRIGHT", self.hp, "BOTTOMRIGHT", 0, -2)
        self.hpFill = UI.Fill(self, "unit-fill", "ARTWORK")
        self.hpFill:SetHeight(3)
        self.hpFill:SetPoint("LEFT", self.hpTrack, "LEFT")
        -- the amount, and critical or overkill under it
        self.amount = UI.Text(self, "numeric", "ink")
        self.amount:SetPoint("TOPRIGHT", -HEALTH_W, -3)
        self.flag = UI.Text(self, "caption", "ink-muted")
        self.flag:SetPoint("TOPRIGHT", self.amount, "BOTTOMRIGHT", 0, 0)
        local nameW = (WIDTH - S["space-5"] * 2) - TIME_W - ICON - S["space-3"] - AMOUNT_W - HEALTH_W
        self.name:SetWidth(nameW)
        self.by:SetWidth(nameW)
        -- the spell's own tooltip; a melee swing or a fall, a short one of ours
        self:EnableMouse(true)
        self:SetScript("OnEnter", function()
            local id = self.spellID
            if id then
                UI.SpellTooltip(self, id)
                return
            end
            local by = self.by:GetText()
            UI.ShowTooltip(self, { title = self.name:GetText(), subtitle = by ~= "" and by or nil })
        end)
        self:SetScript("OnLeave", function() GameTooltip:Hide(); UI.HideTooltip() end)
    end
end

-- The killing blow, on top.
class RecapHead extends Frame
    readonly kicker: Text
    readonly spell: Text
    readonly by: Text
    readonly detail: Text
    readonly health: Text
    readonly span: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetPoint("TOPLEFT")
        self.kicker = UI.Text(self, "caption", "ink-muted")
        self.kicker:SetPoint("TOPLEFT")
        self.kicker:SetValue("Killed by")
        self.spell = UI.Text(self, "label", "ember-text")
        self.spell:SetPoint("TOPLEFT", self.kicker, "BOTTOMLEFT", 0, 0)
        self.by = UI.Text(self, "label", "ink-muted")
        self.by:SetPoint("LEFT", self.spell, "RIGHT", S["space-2"], 0)
        self.detail = UI.Text(self, "caption", "ink-muted")
        self.detail:SetPoint("TOPLEFT", self.spell, "BOTTOMLEFT", 0, 0)
        self.health = UI.Text(self, "caption", "ink")
        self.health:SetPoint("TOPRIGHT")
        self.span = UI.Text(self, "caption", "ink-muted")
        self.span:SetPoint("TOPRIGHT", self.health, "BOTTOMRIGHT", 0, 0)
        self:Size()
    end

    -- As tall as its three lines (again when a theme changes them).
    function Size()
        self:SetSize(WIDTH - S["space-5"] * 2, T.type.caption.lineHeight + T.type.label.lineHeight + T.type.caption.lineHeight)
    end
end

-- The health line: health after each hit until the next, on a track, with
-- time marks under it.
class HealthLine extends Frame
    readonly steps: Texture[] = {}
    readonly marks: Text[] = {}

    constructor(parent: Frame, head: Frame)
        super(nil, parent)
        self:SetPoint("TOPLEFT", head, "BOTTOMLEFT", 0, -S["space-4"])
        self:SetSize(WIDTH - S["space-5"] * 2, LINE_H)
        UI.Fill(self, "track"):SetAllPoints()
        UI.Border(self, "gilt-hairline")
    end

    -- Its steps and marks dropped before it's drawn again.
    function Clear()
        for _, t in ipairs(self.steps) do t:Hide() end
        for _, t in ipairs(self.marks) do t:Hide() end
    end
end

-- The window and what it holds.
type RecapWindow = { window: WindowFrame, head: RecapHead, line: HealthLine, rows: HitRow[], empty: Text }

-- The i-th of a list of reused regions (made by make() the first time), shown.
local function piece<R extends Region>(list: R[], i: number, make: () -> R): R
    local r = list[i]
    if not r then
        r = make()
        list[i] = r
    end
    r:Show()
    return r
end

-- One hit as its row shows it.
export type RecapRow = {
    time: string,       -- "−2.4 s", "0 s", "" (no time)
    spell: string,
    icon?: Art,
    spellID?: number,   -- for the spell's own tooltip (not a melee swing)
    by: string,         -- caster · absorbed · resisted · blocked
    amount: string,     -- "−1,956"
    flag: string,       -- critical · overkill
    hp?: number,        -- health after it
    killing: boolean,
}

-- A step of the health line: health `hp` from `from` to `to` seconds
-- before death.
export type RecapStep = { from: number, to: number, hp: number }

-- What the recap shows of a death, from the game's events (newest first,
-- as C_DeathRecap gives them) and the maximum health (nil: unknown).
export type Recap = {
    count: number,
    span?: number,      -- seconds from the first hit to death
    head: { spell: string, by: string, detail: string, health: string, span: string },
    rows: RecapRow[],
    -- the health line, when the maximum and a time span are known
    steps?: RecapStep[],
    marks?: { t: number, text: string }[],
}

export function recapOf(events: DeathEvent[], maxHP: number?): Recap
    -- newest first: the hits oldest first, and the time each came before death
    local list: DeathEvent[], deathAt: number? = {}, nil
    for i = #events, 1, -1 do list[#list + 1] = events[i] end
    for _, e in ipairs(list) do
        local at = e.timestamp
        if readable(at) and (not deathAt or at > deathAt) then deathAt = at end
    end
    local function before(e: DeathEvent): number?
        local at = e.timestamp
        return deathAt and readable(at) and (deathAt - at) or nil
    end
    local first, last = list[1], list[#list]

    -- health after each hit (probe deathrecap: currentHP is the health
    -- before it, and hits in the same moment share one reading, so a
    -- reading the same as the hit before's goes on from that hit's)
    local after: { [number]: number }, running: number? = {}, nil
    for i, e in ipairs(list) do
        local prev = list[i - 1]
        local hp, amount = e.currentHP, e.amount
        local prevHP = prev and prev.currentHP
        if readable(hp) and not (readable(prevHP) and prevHP == hp and running) then
            running = hp
        end
        if running and readable(amount) then running = math.max(0, running - amount) end
        after[i] = running
    end
    local firstHP = first.currentHP
    local startHP = readable(firstHP) and firstHP or maxHP

    -- the head: the killing blow, its school, critical, overkill
    local bits: string[] = {}
    local lastAmount, lastSchool, lastOverkill, lastSource = last.amount, last.school, last.overkill, last.sourceName
    if readable(lastAmount) then
        local school = readable(lastSchool) and SCHOOL[lastSchool] or nil
        bits[#bits + 1] = group3(lastAmount) .. (school and (" " .. school) or "")
    end
    if last.critical == true then bits[#bits + 1] = "critical" end
    if readable(lastOverkill) and lastOverkill > 0 then bits[#bits + 1] = group3(lastOverkill) .. " overkill" end
    local span = before(first)
    local r: Recap = {
        count = #list,
        span = span,
        head = {
            spell = (spellOf(last)),
            by = text(lastSource) and not last.hideCaster and ("· " .. lastSource) or "",
            detail = table.concat(bits, " · "),
            health = startHP and (group3(startHP) .. " health to 0") or "",
            span = ("%s%d hit%s"):format(span and ("in %.1f s, "):format(span) or "", #list, #list == 1 and "" or "s"),
        },
        rows = {},
    }

    -- the health line: from the first hit to death, health after each hit
    -- until the next (the start: the health before the first)
    if maxHP and span and span > 0 then
        local steps: RecapStep[] = {}
        local function step(fromT: number, toT: number, hp: number?)
            if hp then steps[#steps + 1] = { from = fromT, to = toT, hp = hp } end
        end
        -- before the first hit, a sliver at full
        step(span, span * 0.98, startHP or maxHP)
        for i, e in ipairs(list) do
            local t = before(e) or 0
            local nextT = list[i + 1] and before(list[i + 1]) or 0
            step(t, nextT, after[i])
        end
        -- the time marks: every two seconds back from death
        local marks: { t: number, text: string }[] = {}
        for k = 0, math.floor(span / 2) do
            marks[#marks + 1] = { t = k * 2, text = k == 0 and "0 s" or ("−%d s"):format(k * 2) }
        end
        r.steps, r.marks = steps, marks
    end

    -- the hits, oldest first; the killing blow last
    for i, e in ipairs(list) do
        local spell, icon = spellOf(e)
        local t = before(e)
        local by: string[] = {}
        local source, overkill, amount, id = e.sourceName, e.overkill, e.amount, e.spellId
        if text(source) and not e.hideCaster then by[1] = source end
        for _, x in ipairs(extras(e)) do by[#by + 1] = x end
        local flag: string[] = {}
        if e.critical == true then flag[#flag + 1] = "critical" end
        if readable(overkill) and overkill > 0 then flag[#flag + 1] = group3(overkill) .. " overkill" end
        r.rows[i] = {
            time = t and (t < 0.05 and "0 s" or ("−%.1f s"):format(t)) or "",
            spell = spell,
            icon = icon,
            spellID = readable(id) and id > 0 and e.event ~= "SWING_DAMAGE" and id or nil,
            by = table.concat(by, " · "),
            amount = readable(amount) and ("−" .. group3(amount)) or "",
            flag = table.concat(flag, " · "),
            hp = after[i],
            killing = i == #list,
        }
    end
    return r
end

class DeathRecapModule extends Module<typeof(DEFAULTS)>
    hooked: boolean? = nil
    -- the death shown (false: your last one)
    shownID: (number | false)? = nil
    parts: RecapWindow? = nil

    constructor()
        super({
            id = "deathrecap",
            name = "Death recap",
            description = "SuuUI's death recap: the hits that killed you, with your health falling to zero, from the death request's Recap.",
            api = "0.17",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- The window (made the first time).
    function Window(): RecapWindow
        local parts = self.parts
        if parts then return parts end
        local w = UI.WindowFrame(SuuUI.Root, { name = "SuuUIDeathRecap", title = "Death recap", width = WIDTH, height = HEIGHT,
            onClose = function(win: Frame) win:Hide() end })
        w:SetPoint("CENTER", UIParent, "CENTER", 0, 60)
        w:Hide()
        local c = w.content
        local head = RecapHead.new(c)
        local empty = UI.Text(c, "body", "ink-muted")
        empty:SetPoint("TOPLEFT", 0, 0)
        empty:SetFixedWidth(WIDTH - S["space-5"] * 2)
        empty:SetWordWrap(true)
        local made: RecapWindow = { window = w, head = head, line = HealthLine.new(c, head), rows = {}, empty = empty }
        self.parts = made
        return made
    end

    -- The recap of `id` (nil: your last death).
    function ShowRecap(id: number?)
        local parts = self:Window()
        local w, head, line = parts.window, parts.head, parts.line
        local api = C_DeathRecap
        local ok, events = pcall(api.GetRecapEvents, id)
        for _, r in ipairs(parts.rows) do r:Hide() end
        line:Clear()
        local secret = ok and issecrettable ~= nil and issecrettable(events)
        if secret or not ok or type(events) ~= "table" or #events == 0 then
            head:Hide()
            line:Hide()
            parts.empty:SetValue(secret and "The recap is secret until combat ends." or "No recap for this death. The game recorded no hits for it.")
            parts.empty:Show()
            self:Fit(T.type.body.lineHeight * 2)
            w:Show()
            return
        end
        parts.empty:Hide()
        head:Show()
        line:Show()
        local okMax, readMax = pcall(api.GetRecapMaxHealth, id)
        local maxHP = okMax and readable(readMax) and readMax > 0 and readMax or nil
        local recap = recapOf(events :: DeathEvent[], maxHP)

        head.spell:SetValue(recap.head.spell)
        head.by:SetValue(recap.head.by)
        head.detail:SetValue(recap.head.detail)
        head.health:SetValue(recap.head.health)
        head.span:SetValue(recap.head.span)

        -- the health line
        local lineW = line:GetWidth() - 2
        local steps, marks, span = recap.steps, recap.marks, recap.span
        if maxHP and span and steps and marks then
            local function x(t: number): number return 1 + (1 - t / span) * lineW end
            for n, st in ipairs(steps) do
                local hp = st.hp
                local s = piece(line.steps, n, function(): Texture return UI.Fill(line, "unit-fill", "ARTWORK") end)
                UI.PaintFill(s, hp / maxHP < 0.35 and "unit-fill-low" or "unit-fill")
                s:ClearAllPoints()
                local left, right = x(st.from), x(st.to)
                s:SetPoint("BOTTOMLEFT", line, "BOTTOMLEFT", left, 1)
                s:SetSize(math.max(1, right - left), math.max(0.01, (LINE_H - 2) * math.max(0, hp) / maxHP))
                if hp <= 0 then s:Hide() end
            end
            for k, mk in ipairs(marks) do
                local m = piece(line.marks, k, function(): Text return UI.Text(line, "caption", "ink-faint") end)
                m:ClearAllPoints()
                m:SetPoint("TOP", line, "BOTTOMLEFT", x(mk.t), -2)
                m:SetValue(mk.text)
            end
        end

        -- the hits, oldest first; the killing blow last, in ember
        local y = line:GetHeight() + S["space-6"] + head:GetHeight() + S["space-4"]
        for i, it in ipairs(recap.rows) do
            local r = parts.rows[i]
            if not r then
                r = HitRow.new(w.content)
                parts.rows[i] = r
            end
            local killing = it.killing
            r.time:SetValue(it.time)
            r.icon:SetArt(it.icon or 134400)
            r.name:SetValue(it.spell)
            r.spellID = it.spellID
            r.name:SetColor(killing and "ember-text" or "ink")
            r.by:SetValue(it.by)
            r.amount:SetValue(it.amount)
            r.amount:SetColor(killing and "ember-text" or "ink")
            r.flag:SetValue(it.flag)
            local hp = it.hp
            r.hp:SetValue(hp and group3(hp) or "")
            if hp and maxHP then
                UI.PaintFill(r.hpFill, hp / maxHP < 0.35 and "unit-fill-low" or "unit-fill")
                r.hpFill:SetWidth(math.max(0.01, (HEALTH_W - S["space-3"]) * hp / maxHP))
                r.hpFill:SetShown(hp > 0)
            else
                r.hpFill:Hide()
            end
            r.rule:SetShown(not killing)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", w.content, "TOPLEFT", 0, -y)
            r:Show()
            y = y + ROW_H
        end

        self:Fit(y)
        w:Show()
    end

    -- The window as tall as what it shows (it scrolls only past the screen).
    function Fit(height: number)
        local w = self:Window().window
        w.content:SetHeight(height)
        local chrome = w:BodyTop() + S["space-5"]
        w:SetHeight(math.min(height + chrome, UIParent:GetHeight() - 80))
    end

    function Toggle(id: number?)
        local parts = self.parts
        if parts and parts.window:IsShown() and self.shownID == (id or false) then
            parts.window:Hide()
            return
        end
        self.shownID = id or false
        self:ShowRecap(id)
    end

    override function OnEnable()
        -- the game opens its recap through OpenDeathRecapUI (the death request's
        -- Recap, a death link in chat): this one instead
        if not self.hooked and type(OpenDeathRecapUI) == "function" then
            self.hooked = true
            hook("OpenDeathRecapUI", function(id: number?)
                if not self:IsEnabled() then return end
                local f = DeathRecapFrame
                if f and f:IsShown() then HideUIPanel(f) end
                self:Toggle(id)
            end)
        end
        -- a theme's line heights: the head sized again, the recap shown laid out again
        self:On("SUUUI_THEME_CHANGED", function()
            local parts = self.parts
            if not parts then return end
            parts.head:Size()
            if parts.window:IsShown() then self:ShowRecap(self.shownID or nil) end
        end)
        self:RegisterCommand("recap", "Shows the recap of your last death.", function() self:Toggle(nil) end)
    end
end

M = SuuUI.AddModule(DeathRecapModule.new())
