-- Units/CooldownManager.wowlua
-- SuuUI's own Cooldown Manager (step 1.7b): what it tracks is a setup per
-- class and spec, kept in the profile, each starting from a preset of your
-- class (Data/Presets/<CLASS>.lua). The spec is the talent tree with the most
-- points; without points the character is Unspecced. One profile can serve
-- every character of a role.
-- A built-in module written against the public API only.
--
-- Placement (2560x1440 reference): centred, space-3 above your cast bar
-- (its bottom 322px above the bottom edge), rows growing upward: the
-- resource bar (your power and combo points, as wide as the cast bar),
-- Utility, Essential, then the timers.
--
-- Blizzard's own Cooldown Manager isn't used: its CVar is switched off while
-- this module runs, so the two never show together.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type SelectOption, Select from "/UI/Select"
import type Position from "/EditMode/EditMode"
import type ScrollArea from "/UI/Panel"
import type SuuButton from "/UI/Controls"
import type Text from "/UI/Text"
import type Icon from "/UI/Icon"
import type Border from "/UI/Draw"
import type Toggle, Segmented, SegmentedOption, Stepper, TextField from "/UI/Inputs"
import type ToggleChips from "/UI/Pickers"
import type CooldownTracker from "/UI/CooldownTracker"
import type ResourceBar from "/UI/ResourceBar"
import type CooldownPreset from "/Data/Presets"
import Panel as PanelClass from "/UI/Panel"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import after from "wowlua:timer"
import * as Lists from "./CooldownManager/Lists"
import * as Conditions from "./CooldownManager/Conditions"
import * as migrations from "./CooldownManager/Migrations"

local UI, T = SuuUI.UI, SuuUI.Tokens
local try, tryValue, field = errors.try, errors.tryValue, tbl.field
local asNumber, asString = secret.asNumber, secret.asString

type Entry = Lists.Entry
type ListSet = Lists.ListSet
type Setup = Lists.Setup
type Path = Lists.Path
type Recent = Lists.Recent
type Condition = Conditions.Condition
type When = Conditions.When
type EditedWhen = Conditions.EditedWhen
type Choice = Conditions.Choice
type ClassTalent = Conditions.ClassTalent

-- What "+ Add" offers first ("Seen recently"), newest first, by class and kind.
type RecentByClass = { [string]: { [string]: Recent[] } }

local DEFAULTS = {
    position = { point = "BOTTOM", x = 0, y = 322 } :: Position,
    -- setups[CLASS][spec] = { preset, lists }: spec is the talent tree
    -- with the most points ("1"-"3"), "0" with none (Unspecced). One
    -- profile can hold every class and spec.
    setups = {} :: { [string]: { [string]: Setup } },
    preset = "", lists = {} :: ListSet, -- before setups (migrated once)
    shows = "always",
    essentialSize = 40,
    utilityInline = false,
    readyPop = true,
    procHighlight = true,
    -- recent[CLASS] = { cooldown = { { name, ids } … }, aura = { … } }:
    -- what "+ Add" offers first ("Seen recently"), newest first
    recent = {} :: RecentByClass,
    -- this module switched Blizzard's Cooldown Manager off (its CVar), so
    -- turning the module off switches it back on
    viewerOff = false,
    -- the resource bar under the rows (design B): your power, combo
    -- points, a druid's mana in forms; as wide as your cast bar
    resource = "both",          -- "off", "power" or "both" (with points)
    resourceWidth = "cast",     -- "cast" (your cast bar's) or "own"
    resourceOwnWidth = 340,
    resourcePoints = "over",    -- combo points "over" or "under" the bar
    resourceHeight = 14,
    resourceNumber = "value",   -- "none", "value" or "pct"
    resourceLow = true,         -- amber under 25% (mana, energy)
    resourceDruidMana = true,   -- a mana line under rage or energy
    resourceOoc = "fade",       -- out of combat: "show", "fade" or "hide"
}

local M: CooldownsModule

local _, classFile = UnitClass("player")
local CLASS: string = secret.known(classFile, "")

local function presets(): CooldownPreset[]
    return SuuUI.CooldownPresets()
end

local function findPreset(id: string?): CooldownPreset? return Lists.findPreset(presets(), id) end
local function specPreset(spec: number?): CooldownPreset? return Lists.specPreset(presets(), spec) end
local function specName(spec: number): string return Lists.specName(presets(), spec) end
local copy, copyLists = Lists.copy, Lists.copyLists

--------------------------------------------------------------------------------
-- Spec: the talent tree with the most points (0: none spent)
--------------------------------------------------------------------------------

-- Points per tree, trees told apart by position (left to right, as Forever
-- lays out its three trees in one).
local function treePoints(): ({ number }, number)
    local cfg = asNumber(try(field(C_ClassTalents, "GetActiveConfigID")))
    local info = cfg and tryValue(C_Traits.GetConfigInfo, cfg)
    if not (cfg and info and info.treeIDs) then return { 0, 0, 0 }, 0 end
    local nodes: { x: number, ranks: unknown }[] = {}
    for _, treeID in ipairs(info.treeIDs) do
        for _, nodeID in ipairs(tryValue(C_Traits.GetTreeNodes, treeID) or {}) do
            local ni = tryValue(C_Traits.GetNodeInfo, cfg, nodeID)
            local x = ni and asNumber(ni.posX)
            if ni and x and x < 20000 then
                nodes[#nodes + 1] = { x = x, ranks = ni.ranksPurchased or ni.activeRank or ni.currentRank or 0 }
            end
        end
    end
    return Lists.pointsByTree(nodes)
end

-- A key of the setups: the spec as text.
local function setupKey(spec: number?): string return tostring(spec or 0) end

--------------------------------------------------------------------------------
-- The list editor (step 1.7b-2): every entry of every list, per spell
--------------------------------------------------------------------------------

local LIST_KEYS, LIST_INFO, TABS = Lists.LIST_KEYS, Lists.LIST_INFO, Lists.TABS

-- A list's label, kind and note.
local function infoOf(key: string): Lists.ListInfo
    return LIST_INFO[key] or { label = key, kind = "aura", note = "" }
end

local function kindOf(key: string): string return infoOf(key).kind end

-- The lists of a tab ("cooldowns" or "auras").
local function tabLists(tab: string): string[] return TABS[tab] or {} end

-- Change the lists through a copy, so the setting sees a new value.
local function mutate(fn: (lists: ListSet) -> ())
    local spec = M:EditSpec()
    local lists = copy(M:Lists(spec))
    for _, key in ipairs(LIST_KEYS) do lists[key] = lists[key] or {} end
    fn(lists)
    M:SetLists(lists, spec)
end

local function newUid(): string return tostring(time()) .. math.random(1000, 9999) end

local ENCHANT_NAME, ENCHANT_INV = Lists.ENCHANT_NAME, Lists.ENCHANT_INV
local function enchantArt(enchant: string?): number | string
    local info = enchant and UI.WeaponEnchant(enchant)
    return info and info.icon or GetInventoryItemTexture("player", enchant and ENCHANT_INV[enchant] or 16) or 134400
end

local locate, entryAt, walk, regroup = Lists.locate, Lists.entryAt, Lists.walk, Lists.regroup
local SOURCE_LABEL, LIST_SOURCE, entrySource = Lists.SOURCE_LABEL, Lists.LIST_SOURCE, Lists.entrySource

--------------------------------------------------------------------------------
-- Conditions: when an entry shows at all (Conditions.wowlua), for your class
--------------------------------------------------------------------------------

local CLASSES, ROLES, STANCES, INSTANCES, TARGETS = Conditions.CLASSES, Conditions.ROLES, Conditions.STANCES,
    Conditions.INSTANCES, Conditions.TARGETS
local talentName = Conditions.talentName
local function newCondition(kind: string): Condition return Conditions.newCondition(kind, CLASS) end
local function conditionSentence(subject: string?, when: When?): string return Conditions.conditionSentence(subject, when, CLASS) end
local function conditionWords(when: When?): string? return Conditions.conditionWords(when, CLASS) end
-- Choices as a dropdown's options.
local function choiceOptions(choices: Choice[]): SelectOption<string>[]
    local out: SelectOption<string>[] = {}
    for _, c in ipairs(choices) do out[#out + 1] = { value = c.value, label = c.label } end
    return out
end
local function conditionTypes(current: string?): SelectOption<string>[]
    return choiceOptions(Conditions.conditionTypes(current, CLASS))
end

-- A class's talents, learned or not, sorted by name: { id = spellID, name,
-- tree } each. Any class's from the generated list (SuuUI.ClassTalents);
-- without it, your own class's read live from every node of the active
-- config's trees (kept once read: the config may not be there yet right
-- after login).
local liveTalents: ClassTalent[]? = nil
local function readLiveTalents(): ClassTalent[]
    if liveTalents then return liveTalents end
    local out: ClassTalent[] = {}
    local seen: { [number]: boolean } = {}
    pcall(function()
        local cfg = asNumber(try(field(C_ClassTalents, "GetActiveConfigID")))
        if not cfg then return end
        local info = tryValue(C_Traits.GetConfigInfo, cfg)
        for _, treeID in ipairs(info and info.treeIDs or {}) do
            for _, nodeID in ipairs(tryValue(C_Traits.GetTreeNodes, treeID) or {}) do
                local ni = tryValue(C_Traits.GetNodeInfo, cfg, nodeID)
                for _, entryID in ipairs(ni and ni.entryIDs or {}) do
                    local ei = tryValue(C_Traits.GetEntryInfo, cfg, entryID)
                    local definitionID = ei and asNumber(ei.definitionID)
                    local di = definitionID and tryValue(C_Traits.GetDefinitionInfo, definitionID)
                    local id = di and (asNumber(di.spellID) or asNumber(di.overriddenSpellID))
                    local name = id and asString(C_Spell.GetSpellName(id))
                    if id and name and not seen[id] then
                        seen[id] = true
                        out[#out + 1] = { id = id, name = name }
                    end
                end
            end
        end
    end)
    table.sort(out, function(x: ClassTalent, y: ClassTalent): boolean return x.name < y.name end)
    if #out > 0 then liveTalents = out end
    return out
end

local function classTalents(class: string): ClassTalent[]
    local talents = SuuUI.ClassTalents(class)
    if talents and #talents > 0 then
        local out: ClassTalent[] = {}
        for _, t in ipairs(talents) do
            out[#out + 1] = { id = t.id, name = t.name or asString(C_Spell.GetSpellName(t.id)) or ("ID " .. t.id), tree = t.tree, spec = t.spec }
        end
        table.sort(out, function(x: ClassTalent, y: ClassTalent): boolean return x.name < y.name end)
        return out
    end
    if class == CLASS then return readLiveTalents() end
    return {}
end

-- The rank of an entry you know, as the spellbook names it, and the spell
-- that shows it.
local function rankText(entry: Entry): (string, number?)
    local ids = entry.ids or {}
    for i = #ids, 1, -1 do
        local id = ids[i]
        if secret.flag(try(field(_G, "IsPlayerSpell"), id)) then
            local sub = asString(try(field(C_Spell, "GetSpellSubtext"), id))
            return (sub and sub ~= "") and sub or "Known", id
        end
    end
    -- not learned: the preset's chosen art (what most of its ranks show),
    -- else Rank 1 (the highest IDs are often NPC versions)
    return "Not learned", entry.icon or ids[1]
end

-- What "+ Add" offers: cooldowns from your spellbook (and every preset of
-- your class), auras from the presets and what is on you and your target now.
local function spellbookByName(): { [string]: number[] }
    local out: { [string]: number[] } = {}
    local lines = asNumber(try(field(C_SpellBook, "GetNumSpellBookSkillLines"))) or 0
    for line = 1, lines do
        local li = tryValue(C_SpellBook.GetSpellBookSkillLineInfo, line)
        local offset, count = li and asNumber(li.itemIndexOffset), li and asNumber(li.numSpellBookItems)
        if offset and count then
            for i = offset + 1, offset + count do
                local it = tryValue(C_SpellBook.GetSpellBookItemInfo, i, Enum.SpellBookSpellBank.Player)
                local spellID, name = it and asNumber(it.spellID), it and asString(it.name)
                if it and spellID and not it.isPassive and name then
                    local ids = out[name] or {}
                    out[name] = ids
                    table.insert(ids, spellID)
                end
            end
        end
    end
    return out
end

-- A preset's shared slot "+ Add" may copy: the entry and the list it came from.
type GroupOffer = { entry: Entry, key: string }

-- Auras other classes' presets track ("+ Add" notes their class): name ->
-- "Priest", filled by candidates("aura"). And every candidate's chosen art
-- (the presets' and the catalog's icon: what most of its IDs show), which a
-- new entry takes along.
local auraClassNote: { [string]: string } = {}
local candidateIcon: { [string]: number } = {}

-- Returns spells by name (shared slots' members and what collections hold
-- included), and the presets' shared slots by name with the list each came
-- from.
local function candidates(kind: string): ({ [string]: number[] }, { [string]: GroupOffer })
    local byName: { [string]: number[] } = {}
    local groups: { [string]: GroupOffer } = {}
    local function add(name: string?, ids: number[]?)
        if not name then return end
        local mine = byName[name] or {}
        byName[name] = mine
        local seen: { [number]: boolean } = {}
        for _, id in ipairs(mine) do seen[id] = true end
        for _, id in ipairs(ids or {}) do if not seen[id] then table.insert(mine, id); seen[id] = true end end
    end
    local keys = kind == "cooldown" and { "essential", "utility" } or { "buffs", "debuffs", "procs" }
    for _, p in ipairs(presets()) do
        for _, key in ipairs(keys) do
            walk(p.lists[key], key, function(e: Entry)
                if e.collection or e.enchant then return end
                local name = e.name
                if e.group then
                    if name then groups[name] = groups[name] or { entry = e, key = key } end
                else
                    add(name, e.ids)
                    local icon = e.icon
                    if name and icon then candidateIcon[name] = candidateIcon[name] or icon end
                end
            end)
        end
    end
    -- every class's preset auras too (a paladin tracking Power Word: Shield)
    if kind ~= "cooldown" then
        for name, a in pairs(SuuUI.AuraCatalog()) do
            if not byName[name] then
                add(name, a.ids)
                auraClassNote[name] = a.classes
            end
            local icon = a.icon
            if icon then candidateIcon[name] = candidateIcon[name] or icon end
        end
    end
    if kind == "cooldown" then
        for name, ids in pairs(spellbookByName()) do
            local cd = asNumber(try(field(_G, "GetSpellBaseCooldown"), ids[#ids]))
            if byName[name] or (cd and cd > 0) then add(name, ids) end
        end
    elseif not InCombatLockdown() then
        for _, unit in ipairs({ "player", "target" }) do
            for _, filter in ipairs({ "HELPFUL", "HARMFUL" }) do
                for i = 1, 40 do
                    local ok, a = pcall(C_UnitAuras.GetAuraDataByIndex, unit, i, filter)
                    if not ok or secret.isSecret(a) or not a then break end
                    local spellId = asNumber(a.spellId)
                    if not spellId then break end
                    add(asString(a.name), { spellId })
                end
            end
        end
    end
    for _, ids in pairs(byName) do table.sort(ids) end
    return byName, groups
end

-- "Seen recently": spells you cast and auras on you and your target (out of
-- combat, when the game shows them), newest first, RECENT_MAX per kind and
-- class. A name already near the top isn't written again.
local RECENT_MAX = 12

local function remember(kind: string, name: string?, id: number?)
    if not (name and id) then return end
    local all = M:Get("recent")
    local mine = all[CLASS]
    local recentList = Lists.pushRecent(mine and mine[kind] or {}, name, id, RECENT_MAX)
    if not recentList then return end
    local changed = copy(all)
    local byKind = changed[CLASS] or {}
    changed[CLASS] = byKind
    byKind[kind] = recentList
    M:Set("recent", changed)
end

local function recent(kind: string): Recent[]
    local mine = M:Get("recent")[CLASS]
    return mine and mine[kind] or {}
end

-- Out of combat: the auras on you (anyone's) and yours on the target. Only
-- names not yet in the list are added (newest first), in one write per scan.
local function rememberAuras()
    if InCombatLockdown() then return end
    local scanned: { name?: string, id: number }[] = {}
    local scans: { unit: string, filter: string }[] = { { unit = "player", filter = "HELPFUL" }, { unit = "target", filter = "HARMFUL|PLAYER" } }
    for _, scan in ipairs(scans) do
        for i = 1, 40 do
            local ok, a = pcall(C_UnitAuras.GetAuraDataByIndex, scan.unit, i, scan.filter)
            if not ok or secret.isSecret(a) or not a then break end
            local spellId = asNumber(a.spellId)
            if not spellId then break end
            scanned[#scanned + 1] = { name = asString(a.name), id = spellId }
        end
    end
    local fresh = Lists.mergeRecent(recent("aura"), scanned, RECENT_MAX)
    if not fresh then return end
    local all = copy(M:Get("recent"))
    local byKind = all[CLASS] or {}
    all[CLASS] = byKind
    byKind.aura = fresh
    M:Set("recent", all)
end

-- A spell you cast, if it's one of yours with a cooldown (or a preset's).
local function rememberCast(spellR: unknown)
    local spellID = asNumber(spellR)
    if not spellID or not secret.flag(try(field(_G, "IsPlayerSpell"), spellID)) then return end
    local cd = asNumber(try(field(_G, "GetSpellBaseCooldown"), spellID))
    if cd and cd > 0 then
        remember("cooldown", asString(C_Spell.GetSpellName(spellID)), spellID)
    end
end

-- The art of a list of IDs for a dropdown: the rank you know, else the first.
local function idsArt(ids: number[]?): (number | string)?
    if not ids or not ids[1] then return nil end
    for i = #ids, 1, -1 do
        if secret.flag(try(field(_G, "IsPlayerSpell"), ids[i])) then return (C_Spell.GetSpellTexture(ids[i])) end
    end
    return (C_Spell.GetSpellTexture(ids[1]))
end

-- What a typed number finds: the spell with that ID, as "Name · ID 123".
-- Its value is "id:123"; adding it adds exactly that ID.
local function spellLookup(query: string): SelectOption<string>[]?
    local id = tonumber((query or ""):match("^%s*(%d+)%s*$"))
    if not id then return nil end
    local name = asString(C_Spell.GetSpellName(id))
    if not name then return nil end
    return { { value = "id:" .. id, label = ("%s · ID %d"):format(name, id), icon = C_Spell.GetSpellTexture(id) } }
end

-- An option's value as an entry: a name (every ID it carries), "id:123", or
-- "group:Name" (a preset's shared slot, a copy with its own uid).
local function entryFor(value: string?, byName: { [string]: number[] }?, groups: { [string]: GroupOffer }?): Entry?
    if not value then return nil end
    local hand = value:match("^enchant:(%a+)$")
    local enchantName = hand and ENCHANT_NAME[hand]
    if hand and enchantName then return { enchant = hand, name = enchantName, ids = {}, uid = newUid() } end
    local id = tonumber(value:match("^id:(%d+)$"))
    if id then return { name = asString(C_Spell.GetSpellName(id)), ids = { id } } end
    local gname = value:match("^group:(.+)$")
    local offer = gname and groups and groups[gname]
    if offer then
        local g = copy(offer.entry)
        g.uid = newUid()
        return g
    end
    local ids = byName and byName[value]
    if ids then return { name = value, ids = ids, icon = candidateIcon[value] } end
    return nil
end

local ROW_H, GAP, WIDTH = 30, 4, 560
-- Nesting: each level steps in INDENT, and a rail runs down from the row it
-- belongs to, under that row's fold chevron (RAIL_X from its left edge).
local INDENT, RAIL_X = 34, 25

-- While an aura isn't up, each entry's own choice (there's no list-wide
-- one): buffs grey and debuffs "with a target" unless set.
local MISSING: SegmentedOption<string>[] = {
    { value = "hide", label = "Hide" },
    { value = "grey", label = "Grey" },
    { value = "warn", label = "Warn" },
    { value = "remind", label = "Remind" },
}
local MISSING_DEBUFF: SegmentedOption<string>[] = {
    { value = "hide", label = "Hide" },
    { value = "grey", label = "Grey" },
    { value = "target", label = "With a target" },
    { value = "warn", label = "Warn" },
    { value = "remind", label = "Remind" },
}
local MISSING_DEFAULT, MISSING_LABEL = Lists.MISSING_DEFAULT, Lists.MISSING_LABEL

-- A cooldown shared slot shows the last member you know (upgrades last).
local function knownMember(slot: Entry?): Entry?
    local members = slot and slot.members or {}
    for i = #members, 1, -1 do
        if (rankText(members[i])) ~= "Not learned" then return members[i] end
    end
    return nil
end

-- An entry's icon art: a single spell's rank you know, a shared slot's icon
-- (a cooldown slot's: the member it shows; an aura slot's, unless its icon
-- is fixed: the first member you know, else its icon).
local function artOf(e: Entry, cooldown: boolean): (number | string)?
    if e.enchant then return enchantArt(e.enchant) end
    local id: number? = nil
    if e.group and cooldown then
        local m = knownMember(e) or (e.members or {})[1]
        if m then id = select(2, rankText(m)) end
    elseif e.group then
        if not e.fixedIcon then
            for _, m in ipairs(e.members or {}) do
                local rank, known = rankText(m)
                if rank ~= "Not learned" then id = known; break end
            end
        end
        id = id or e.icon or (e.ids or {})[1]
    elseif e.ids then
        id = select(2, rankText(e))
    end
    return id and C_Spell.GetSpellTexture(id) or nil
end

local combine, accepts = Lists.combine, Lists.accepts

--------------------------------------------------------------------------------
-- The setup and preset bar: which spec's setup you edit (the active one by
-- default), your class's presets, Load, and what the lists are based on.
--------------------------------------------------------------------------------

class PresetBar extends Frame
    readonly setup: Select<number>
    readonly active: Text
    readonly select: Select<string>
    readonly status: Text
    readonly load: SuuButton
    readonly reset: SuuButton
    choice: string? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(520, 112)
        self.setup = UI.Select(self, { width = 200, onChange = function(v: number)
            M.editSpec = v
            M:Emit("SUUUI_COOLDOWNS_SETUP")
        end })
        self.setup:SetPoint("TOPLEFT")
        self.active = UI.Text(self, "caption", "ink-muted")
        self.active:SetPoint("LEFT", self.setup, "RIGHT", 10, 0)
        local options: SelectOption<string>[] = {}
        for _, p in ipairs(presets()) do options[#options + 1] = { value = p.id, label = p.name } end
        self.select = UI.Select(self, { width = 200, options = options, onChange = function(v: string) self.choice = v end })
        self.select:SetPoint("TOPLEFT", self.setup, "BOTTOMLEFT", 0, -10)
        self.status = UI.Text(self, "caption", "ink-muted")
        self.status:SetPoint("TOPLEFT", self.select, "BOTTOMLEFT", 0, -6)
        self.load = UI.Button(self, { text = "Load", variant = "primary", onClick = function()
            local choice = self.choice
            if not choice then return end
            local spec = M:EditSpec()
            local p = findPreset(choice)
            local function load() M:LoadPreset(choice, spec); self:Refresh() end
            -- loading over lists you've changed (or another preset's) asks first
            local changes = M:Changes()
            if choice ~= M:PresetId(spec) or changes > 0 then
                UI.Confirm({
                    title = "Load " .. (p and p.name or "preset") .. "?",
                    text = ("Your %s lists are replaced with %s's.%s"):format(specName(spec), p and p.name or "the preset",
                        changes > 0 and (" Your %d %s are lost."):format(changes, changes == 1 and "change" or "changes") or ""),
                    confirm = "Replace", onConfirm = load })
            else
                load()
            end
        end })
        self.load:SetPoint("LEFT", self.select, "RIGHT", 8, 0)
        self.reset = UI.Button(self, { text = "Reset to preset", onClick = function()
            local spec = M:EditSpec()
            local id = M:PresetId(spec)
            local n = M:Changes()
            if id == "" or n == 0 then return end
            UI.Confirm({ title = "Reset to preset?", text = ("Your %d %s to the %s lists are undone."):format(n, n == 1 and "change" or "changes", specName(spec)),
                confirm = "Reset", onConfirm = function() M:LoadPreset(id, spec); self:Refresh() end })
        end })
        self.reset:SetPoint("LEFT", self.load, "RIGHT", 8, 0)
        self:Refresh()
        M:Watch("setups", function() self:Refresh() end)
        M:On("SUUUI_COOLDOWNS_SETUP", function() self.choice = nil; self:Refresh() end)
    end

    function Refresh()
        local spec = M:EditSpec()
        -- the setups: Unspecced and the class's trees, the active one marked
        local specs: SelectOption<number>[] = {}
        local seen: { [number]: boolean } = {}
        for _, p in ipairs(presets()) do
            local t = p.tree or 0
            if not seen[t] then
                seen[t] = true
                specs[#specs + 1] = { value = t, label = specName(t) .. (t == M.spec and " (active)" or "") }
            end
        end
        table.sort(specs, function(a: SelectOption<number>, b: SelectOption<number>): boolean return (a.value or 0) < (b.value or 0) end)
        self.setup:SetOptions(specs)
        self.setup:SetValue(spec)
        local pts = M.points
        self.active:SetValue(("This character: %s · talents %d / %d / %d"):format(specName(M.spec), pts[1], pts[2], pts[3]))
        local p = findPreset(M:PresetId(spec))
        self.choice = self.choice or (p and p.id)
        self.select:SetValue(self.choice)
        local n = p and M:Changes() or 0
        self.status:SetValue(p and ("Based on " .. p.name .. (n > 0 and (" · " .. n .. (n == 1 and " change" or " changes")) or "")) or "No preset loaded")
    end
end

--------------------------------------------------------------------------------
-- Rows
--------------------------------------------------------------------------------

-- A small square button with a drawn ✕ (the up and down arrows it also
-- drew were never used).
class RemoveButton extends Button
    readonly border: Border

    constructor(parent: Frame, onClick: () -> ())
        super(nil, parent)
        self:SetSize(22, 22)
        self.border = UI.Border(self, "gilt-line")
        self.border:SetShown(false)
        local c = UI.Cross(self, 9, "ink-muted")
        c:SetPoint("CENTER")
        self:SetScript("OnEnter", function() self.border:SetShown(true) end)
        self:SetScript("OnLeave", function() self.border:SetShown(false) end)
        self:SetScript("OnClick", function() onClick() end)
    end
end

-- The grip at a row's left edge: two columns of three dots.
class Grip extends Frame
    readonly dots: Texture[] = {}

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(10, 16)
        for col = 0, 1 do
            for row = 0, 2 do
                local d = self:CreateTexture(nil, "OVERLAY")
                UI.PaintFill(d, "ink-faint")
                d:SetSize(2, 2)
                d:SetPoint("TOPLEFT", 2 + col * 4, -(2 + row * 5))
                self.dots[#self.dots + 1] = d
            end
        end
    end

    function Paint(token: string)
        for _, d in ipairs(self.dots) do UI.PaintFill(d, token) end
    end
end

-- The fold chevron of a collection or shared slot: down while open, right
-- while folded.
class FoldButton extends Button
    readonly strokes: Texture[] = {}

    constructor(parent: Frame, onClick: () -> ())
        super(nil, parent)
        self:SetSize(18, 18)
        for n = 1, 2 do
            local t = self:CreateTexture(nil, "OVERLAY")
            t:SetColorTexture(1, 1, 1, 1)
            t:SetSize(6, 1.5)
            self.strokes[n] = t
        end
        self:SetColor("ink-muted")
        self:SetOpen(false)
        self:SetScript("OnEnter", function() self:SetColor("gilt-text") end)
        self:SetScript("OnLeave", function() self:SetColor("ink-muted") end)
        self:SetScript("OnClick", function() onClick() end)
    end

    function SetOpen(open: boolean?)
        local a, c = self.strokes[1], self.strokes[2]
        a:ClearAllPoints()
        c:ClearAllPoints()
        a:SetRotation(math.rad(-45))
        c:SetRotation(math.rad(45))
        if open then
            a:SetPoint("CENTER", -2, 0)
            c:SetPoint("CENTER", 2, 0)
        else
            a:SetPoint("CENTER", 0, 2)
            c:SetPoint("CENTER", 0, -2)
        end
    end

    function SetColor(name: string)
        for _, t in ipairs(self.strokes) do UI.Paint(t, name) end
    end
end

-- A shared slot's mark: two small stacked cards at its icon's corner.
local function slotMark(parent: Frame, level: number): Frame
    local m = CreateFrame("Frame", nil, parent)
    m:SetFrameLevel(level)
    m:SetSize(11, 11)
    for n = 0, 1 do
        local card = CreateFrame("Frame", nil, m)
        card:SetFrameLevel(m:GetFrameLevel() + 1 + n)
        card:SetSize(8, 8)
        card:SetPoint("TOPLEFT", n * 3, -n * 3)
        UI.Fill(card, "surface-raised"):SetAllPoints()
        UI.Border(card, "gilt")
    end
    return m
end

-- A collection's glyph in place of an icon: a gilt folder outline.
local function folderGlyph(parent: Frame): Frame
    local g = CreateFrame("Frame", nil, parent)
    g:SetSize(22, 22)
    local body = CreateFrame("Frame", nil, g)
    body:SetSize(17, 11)
    body:SetPoint("CENTER", 0, -2)
    UI.Border(body, "gilt")
    local tab = CreateFrame("Frame", nil, g)
    tab:SetSize(7, 3)
    tab:SetPoint("BOTTOMLEFT", body, "TOPLEFT", 0, -1)
    UI.Border(tab, "gilt")
    return g
end

-- A rail a row sits under: its level, fainter for a shared slot's.
type Rail = { level: number, faint?: boolean }

-- What a row shows: its list and path, its entry and kind ("entry",
-- "slot", "collection", "member"), its level and rails, open (folds), the
-- shared slot of a member, what may land on it.
type RowContext = {
    key: string, path: Path, entry: Entry, kind: string, level: number, rails: Rail[],
    open?: boolean, slot?: Entry, onto?: string,
}

-- A row or a list's foot frame, with its rails.
class RailedFrame extends Frame
    readonly rails: Texture[] = {}

    -- The rails of the rows a row sits under: a collection's in gilt, a
    -- shared slot's fainter.
    function SetRails(rails: Rail[], level: number)
        for n, rl in ipairs(rails) do
            local t = self.rails[n]
            if not t then
                t = self:CreateTexture(nil, "BACKGROUND", nil, 1)
                t:SetWidth(1)
                self.rails[n] = t
            end
            UI.PaintFill(t, rl.faint and "gilt-line" or "gilt")
            t:ClearAllPoints()
            t:SetPoint("TOPLEFT", self, "TOPLEFT", (rl.level - level) * INDENT + RAIL_X, 0)
            t:SetHeight(ROW_H + GAP)
            t:Show()
        end
        for n = #rails + 1, #self.rails do self.rails[n]:Hide() end
    end
end

-- One row: grip, fold chevron (collections and shared slots), icon (a
-- shared slot's with its mark, a collection's folder), name and summary,
-- then (right to left) remove, Move to… (rows at the top of a list), Behaviour
-- and shown. The row drags by its grip.
class EntryRow extends RailedFrame
    readonly dropFill: Texture
    readonly dropEdge: Border
    readonly grip: Grip
    readonly fold: FoldButton
    readonly icon: Icon
    readonly mark: Frame
    readonly folder: Frame
    readonly name: Text
    readonly rank: Text
    readonly strip: Icon[] = {}
    readonly remove: RemoveButton
    readonly move: Select<string>
    readonly behaviour: SuuButton
    readonly shown: Toggle
    key: string = ""
    path: Path = { key = "", i = 0 }
    kind: string = "entry"
    entry: Entry = {}

    constructor(editor: ListEditor)
        super(nil, editor)
        self:SetSize(WIDTH, ROW_H)
        -- lit while a dragged row would land on it
        self.dropFill = UI.Fill(self, "arcane-soft", "BACKGROUND")
        self.dropFill:SetAllPoints()
        self.dropFill:Hide()
        self.dropEdge = UI.Border(self, "arcane")
        self.dropEdge:SetShown(false)
        self.grip = Grip.new(self)
        self.grip:SetPoint("LEFT")
        self.fold = FoldButton.new(self, function() editor:ToggleFold(self) end)
        self.fold:SetPoint("LEFT", self.grip, "RIGHT", 6, 0)
        self.icon = UI.Icon(self, 22)
        self.icon:SetPoint("LEFT", self.fold, "RIGHT", 6, 0)
        self.mark = slotMark(self, self.icon:GetFrameLevel() + 2)
        self.mark:SetPoint("BOTTOMRIGHT", self.icon, "BOTTOMRIGHT", 4, -4)
        self.folder = folderGlyph(self)
        self.folder:SetPoint("CENTER", self.icon, "CENTER")
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.icon, "TOPRIGHT", 8, 1)
        self.name:SetFixedWidth(180)
        self.rank = UI.Text(self, "caption", "ink-muted")
        self.rank:SetFixedWidth(180)
        self.rank:SetPoint("BOTTOMLEFT", self.icon, "BOTTOMRIGHT", 8, -1)
        self.remove = RemoveButton.new(self, function() editor:RemoveAt(self.path) end)
        self.remove:SetPoint("RIGHT")
        self.move = UI.Select(self, { width = 104, placeholder = "Move to…", onChange = function(to: string)
            if not to then return end
            mutate(function(l: ListSet) Lists.moveToList(l, self.key, self.path.i, to) end)
        end })
        self.behaviour = UI.Button(self, { text = "Behaviour", width = 96, onClick = function() editor:OpenBehaviour(self.path) end })
        self.shown = UI.Toggle(self, { onChange = function(v: boolean)
            mutate(function(l: ListSet)
                local e = entryAt(l, self.path)
                if e then e.hidden = (not v) or nil end
            end)
        end })
        -- drag to reorder: the editor tracks the cursor and drops
        self:EnableMouse(true)
        self:RegisterForDrag("LeftButton")
        self:SetScript("OnEnter", function() self.grip:Paint("ink-muted") end)
        self:SetScript("OnLeave", function() self.grip:Paint("ink-faint") end)
        self:SetScript("OnDragStart", function() editor:StartDrag(self) end)
        self:SetScript("OnDragStop", function() editor:StopDrag() end)
    end

    function Fill(c: RowContext)
        local e, key, kind = c.entry, c.key, c.kind
        self.key, self.path, self.kind, self.entry = key, c.path, kind, e
        local cooldown = kindOf(key) == "cooldown"
        local member = kind == "member"
        local parts: string[] = {}
        local strip: (number | string | false)[] = {}
        local dim = false
        local function add(s: string?) if s then parts[#parts + 1] = s end end
        self.icon:SetShown(kind ~= "collection")
        self.folder:SetShown(kind == "collection")
        self.mark:SetShown(kind == "slot")
        self.fold:SetShown(kind == "slot" or kind == "collection")
        self.fold:SetOpen(c.open)

        -- the summary, in words
        if kind == "collection" then
            add("collection · " .. #(e.entries or {}))
            if not c.open then
                for _, x in ipairs(e.entries or {}) do strip[#strip + 1] = artOf(x, cooldown) or false end
            end
        elseif kind == "slot" then
            local n = #(e.members or {})
            add("1 slot")
            if cooldown then
                local known = knownMember(e)
                add(known and ("shows " .. (known.name or "?")) or "none learned")
                add(n == 1 and "1 spell" or (n .. " spells"))
                dim = not known
            else
                add(n == 1 and "1 aura" or (n .. " auras"))
                add(SOURCE_LABEL[entrySource(e, key)])
            end
            if not c.open then
                for _, m in ipairs(e.members or {}) do strip[#strip + 1] = artOf(m, cooldown) or false end
            end
        elseif e.enchant then
            add("weapon enchant")
            local info = UI.WeaponEnchant(e.enchant)
            add(info and info.name or nil)
        else
            local rank = rankText(e)
            dim = rank == "Not learned"
            add(rank)
            local slot = c.slot
            if member and cooldown then
                if knownMember(slot) == e then add("shows now") end
            elseif member and slot then
                add(SOURCE_LABEL[e.source or entrySource(slot, key)])
            elseif cooldown then
                if e.effect then add("shows " .. (e.effectName or "its effect")) end
            else
                -- whose, when it isn't the list's usual
                local src = entrySource(e, key)
                if src ~= LIST_SOURCE[key] then add(SOURCE_LABEL[src]) end
            end
        end
        -- its conditions, in words
        if not (member and cooldown) then add(conditionWords(e.when)) end
        -- what the Behaviour panel changed, at a glance
        local missing = e.missing
        if not cooldown and key ~= "procs" and (kind == "entry" or kind == "slot") and not e.enchant then
            local m = missing and MISSING_LABEL[missing]
            if m then add("missing: " .. m) end
        elseif e.enchant and missing and missing ~= "warn" then
            add("missing: " .. (MISSING_LABEL[missing] or missing))
        end
        self.rank:SetValue(table.concat(parts, " · "))

        if kind == "collection" then
            -- its name in the list heads' style
            self.name:SetValue((e.name or "Collection"):upper())
            self.name:SetColor("gilt-text")
        else
            self.name:SetValue(e.name or "Shared slot")
            self.name:SetColor(dim and "ink-muted" or "ink")
            self.icon:SetArt(artOf(e, cooldown))
            self.icon:SetState(dim and "dim" or "rest")
        end

        -- right to left: remove, Move to… (top rows), Behaviour (not a cooldown
        -- slot's members: theirs is the slot's), shown (not members)
        local top = c.level == 0
        -- (a weapon enchant stays in Buffs on you)
        self.move:SetShown(top and not e.enchant)
        self.behaviour:SetShown(not (member and cooldown))
        self.shown:SetShown(not member)
        local anchor: Region = self.remove
        local gap, used = 6, self.remove:GetWidth()
        local controls: Frame[] = { self.move, self.behaviour, self.shown }
        for _, ctl in ipairs(controls) do
            if ctl:IsShown() then
                ctl:ClearAllPoints()
                ctl:SetPoint("RIGHT", anchor, "LEFT", -gap, 0)
                used = used + gap + ctl:GetWidth()
                anchor, gap = ctl, ctl == self.move and 8 or 10
            end
        end
        if top then
            local moves: SelectOption<string>[] = {}
            for _, k in ipairs(tabLists(cooldown and "cooldowns" or "auras")) do
                if k ~= key then moves[#moves + 1] = { value = k, label = infoOf(k).label } end
            end
            self.move:SetOptions(moves)
            self.move:SetValue(nil)
        end
        if not member then self.shown:SetValue(not e.hidden) end

        -- folded: its members' icons after the summary, as many as fit
        for _, t in ipairs(self.strip) do t:Hide() end
        if #strip > 0 then
            local x0 = math.min(self.rank:GetUnboundedStringWidth(), 180) + 6
            local room = WIDTH - c.level * INDENT - used - 8 - 70 - x0
            local count = math.min(#strip, math.max(0, math.floor((room + 2) / 16)))
            for n = 1, count do
                local t = self.strip[n] or UI.Icon(self, 14)
                self.strip[n] = t
                t:ClearAllPoints()
                t:SetPoint("LEFT", self.rank, "LEFT", x0 + (n - 1) * 16, 0)
                t:SetArt(strip[n] or nil)
                t:Show()
            end
        end
        self:Show()
    end
end

-- A list's head: its title, note and count.
class ListHead extends Frame
    readonly title: Text
    readonly note: Text
    readonly count: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(WIDTH, 34)
        self.title = UI.Text(self, "label", "gilt-text")
        self.title:SetPoint("TOPLEFT", 0, -4)
        self.note = UI.Text(self, "caption", "ink-muted")
        self.note:SetPoint("TOPLEFT", self.title, "BOTTOMLEFT", 0, -2)
        self.count = UI.Text(self, "caption", "ink-muted")
        self.count:SetPoint("TOPRIGHT", 0, -6)
    end
end

-- The list's foot: "+ Add…" (a Select of candidates; a typed number finds
-- any spell by its ID), "+ Shared slot" and (aura lists) "+ Collection".
class AddRow extends Frame
    readonly select: Select<string>
    readonly newSlot: SuuButton
    readonly newCollection: SuuButton
    key: string = ""
    byName: { [string]: number[] } = {}
    groups: { [string]: GroupOffer } = {}

    constructor(editor: ListEditor)
        super(nil, editor)
        self:SetSize(WIDTH, 34)
        self.select = UI.Select(self, { width = 300, placeholder = "+ Add… (name or spell ID)", lookup = spellLookup,
            onChange = function(value: string)
                local e = entryFor(value, self.byName, self.groups)
                if e then mutate(function(l: ListSet) table.insert(assert(l[self.key]), e) end) end
            end })
        self.select:SetPoint("LEFT")
        self.newSlot = UI.Button(self, { text = "+ Shared slot", onClick = function()
            local uid = newUid()
            editor.fold[uid] = true -- open, so its "+ Add to" shows
            mutate(function(l: ListSet) table.insert(assert(l[self.key]), Lists.newSlot(self.key, uid)) end)
        end })
        self.newSlot:SetPoint("LEFT", self.select, "RIGHT", 8, 0)
        self.newCollection = UI.Button(self, { text = "+ Collection", onClick = function()
            mutate(function(l: ListSet) table.insert(assert(l[self.key]), Lists.newCollection(newUid())) end)
        end })
        self.newCollection:SetPoint("LEFT", self.newSlot, "RIGHT", 8, 0)
    end
end

-- "+ Add to <name>…" at the foot of an open collection or shared slot.
class AddToRow extends RailedFrame
    readonly select: Select<string>
    path: Path = { key = "", i = 0 }
    byName: { [string]: number[] } = {}
    groups: { [string]: GroupOffer } = {}

    constructor(editor: ListEditor)
        super(nil, editor)
        self:SetSize(WIDTH, ROW_H)
        self.select = UI.Select(self, { width = 280, lookup = spellLookup, onChange = function(value: string)
            local e = entryFor(value, self.byName, self.groups)
            if not e then return end
            mutate(function(l: ListSet) Lists.addInto(l, self.path, e) end)
        end })
        self.select:SetPoint("LEFT")
    end
end

-- The row a drag carries: a ghost following the cursor.
class DragGhost extends Frame
    readonly icon: Icon
    readonly name: Text

    constructor()
        super(nil, UIParent)
        self:SetFrameStrata("TOOLTIP")
        self:SetSize(240, ROW_H)
        UI.Fill(self, "surface-raised"):SetAllPoints()
        UI.Border(self, "arcane")
        self.icon = UI.Icon(self, 22)
        self.icon:SetPoint("LEFT", 4, 0)
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("LEFT", self.icon, "RIGHT", 8, 0)
        self:Hide()
    end
end

-- What a drop at the cursor may land on, row by row: the frame, the
-- position before it, what may land on it (onto a row).
type LayoutItem = { frame: Frame, before: Path, onto?: string, path?: Path, row?: EntryRow }
-- A list as laid out: its items, its head, its foot, the position after it.
type ListLayout = { items: LayoutItem[], head: ListHead, add?: AddRow, endPath?: Path }
-- Where a drop lands: at a position (the line over `frame`), or onto a row.
type DropTarget = { path: Path, frame: Frame, onto?: string, row?: EntryRow }

--------------------------------------------------------------------------------
-- The Behaviour panel: per entry, a modal sized to what applies.
--   cooldown: when ready, pop, sound, on cooldown, show, when unusable,
--     edge, effect; a cooldown shared slot adds its name and shown
--   single aura: whose, when missing, edge, size, glow, timer, stacks,
--     amber, sounds
--   shared slot (auras): name, how many at once, icon, then as a single aura
--   a shared slot's member: whose only (how it looks is the slot's)
--   collection: name
-- and on every one of them, Conditions.
--------------------------------------------------------------------------------

local BP_W = 520
local CW = BP_W - 40 -- the body's width
local EDGES: SegmentedOption<string>[] = { { value = "default", label = "By state" }, { value = "ink", label = "Ink" },
                { value = "gilt", label = "Gilt" }, { value = "muted", label = "Muted" } }
local SOUND_OPTIONS: SelectOption<string>[] = { { value = "none", label = "None" }, { value = "chime", label = "Ready chime" },
                        { value = "ping", label = "Soft ping" }, { value = "proc", label = "Proc" },
                        { value = "warning", label = "Warning" } }
local WHOSE: SegmentedOption<string>[] = { { value = "mine", label = "Only yours" }, { value = "others", label = "Only others'" },
                { value = "any", label = "Anyone's" } }

-- A segmented choice of words.
local function segmented(parent: Frame, options: SegmentedOption<string>[], onChange: (v: string) -> ()): Segmented<string>
    return UI.Segmented(parent, { options = options, onChange = onChange })
end

-- A section of the panel: the panel stacks those that apply.
class Section extends Frame
    height: number = 0
    y: number = 0

    constructor(inner: Frame, sections: Section[])
        super(nil, inner)
        self:SetWidth(CW)
        sections[#sections + 1] = self
    end

    -- A label over a control, stacked down the section; the height so far.
    function Add(label: string?, control: Region, h: number?): number
        if label then
            local t = UI.Text(self, "caption", "ink-muted")
            t:SetPoint("TOPLEFT", 0, -self.y)
            t:SetValue(label)
            self.y = self.y + 18
        end
        control:SetPoint("TOPLEFT", 0, -self.y)
        self.y = self.y + (h or 30) + 12
        self.height = self.y
        return self.y
    end
end

--------------------------------------------------------------------------------
-- Conditions: "Conditions" and All of these | Any of these, a row per
-- condition (Not, its type, its control under them, ✕), "+ Add
-- condition", then the sentence. Its height follows its rows.
--------------------------------------------------------------------------------

local COND_X = 56 -- a condition's control, under its type

-- A chosen talent in a talent condition: icon, name, ✕.
class TalentRow extends Frame
    readonly icon: Icon
    readonly name: Text
    readonly remove: RemoveButton
    id: number = 0

    constructor(r: ConditionRow)
        super(nil, r)
        self:SetSize(300, 24)
        self.icon = UI.Icon(self, 20)
        self.icon:SetPoint("LEFT")
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("LEFT", self.icon, "RIGHT", 8, 0)
        self.name:SetFixedWidth(240)
        self.remove = RemoveButton.new(self, function()
            r.panel:SetCondition(r.index, function(c: Condition) Conditions.removeTalent(c, self.id) end)
        end)
        self.remove:SetPoint("RIGHT")
    end
end

class ConditionRow extends Frame
    readonly panel: BehaviourPanel
    readonly notButton: Button
    readonly notEdge: Border
    readonly notText: Text
    readonly type: Select<string>
    readonly remove: RemoveButton
    readonly group: Segmented<string>
    readonly classesA: ToggleChips
    readonly classesB: ToggleChips
    readonly classesOthers: Segmented<string>
    readonly roles: ToggleChips
    readonly stances: ToggleChips?
    readonly instance: ToggleChips
    readonly target: ToggleChips
    readonly plain: Text
    readonly talentRows: TalentRow[] = {}
    readonly talentClassSelect: Select<string>
    readonly addTalent: Select<string>
    readonly controls: Region[]
    talentClass: string = CLASS
    index: number = 0
    cond: Condition? = nil
    height: number = 0

    constructor(host: Frame, panel: BehaviourPanel)
        super(nil, host)
        self.panel = panel
        self:SetWidth(CW)
        UI.Fill(self, "surface-sunk"):SetAllPoints()
        UI.Border(self, "gilt-faint")
        -- Not turns the condition around (ember while on)
        self.notButton = CreateFrame("Button", nil, self)
        self.notButton:SetSize(40, 30)
        self.notButton:SetPoint("TOPLEFT", 8, -8)
        self.notEdge = UI.Border(self.notButton, "gilt-line")
        self.notText = UI.Text(self.notButton, "label", "ink-faint")
        self.notText:SetPoint("CENTER")
        self.notText:SetValue("Not")
        self.notButton:SetScript("OnClick", function()
            panel:SetCondition(self.index, function(c: Condition) c["not"] = (not c["not"]) or nil end)
        end)
        self.type = UI.Select(self, { width = 196, onChange = function(v: string?)
            if not v then return end
            panel:MutateWhen(function(w: EditedWhen) Conditions.changeType(w, self.index, v, CLASS) end)
        end })
        self.type:SetPoint("LEFT", self.notButton, "RIGHT", 8, 0)
        self.remove = RemoveButton.new(self, function()
            panel:MutateWhen(function(w: EditedWhen) table.remove(w.conditions, self.index) end)
        end)
        self.remove:SetPoint("TOPRIGHT", -8, -12)

        -- the type's controls, one set showing
        local top = -(8 + 30 + 6)
        local function chips(options: Choice[], set: (c: Condition, values: string[]) -> ()): ToggleChips
            local c = UI.ToggleChips(self, { options = options, onChange = function(values: string[])
                panel:SetCondition(self.index, function(cond: Condition) set(cond, values) end)
            end })
            c:SetPoint("TOPLEFT", COND_X, top)
            return c
        end
        self.group = segmented(self, { { value = "solo", label = "Solo" }, { value = "group", label = "Group" }, { value = "raid", label = "Raid" } },
            function(v: string) panel:SetCondition(self.index, function(c: Condition) c.value = v end) end)
        self.group:SetPoint("TOPLEFT", COND_X, top)
        -- classes in two rows of chips, one list
        local function classes()
            local all = self.classesA:GetValue()
            for _, v in ipairs(self.classesB:GetValue()) do all[#all + 1] = v end
            panel:SetCondition(self.index, function(c: Condition) c.classes = all end)
        end
        self.classesA = UI.ToggleChips(self, { options = { unpack(CLASSES, 1, 5) }, onChange = classes })
        self.classesA:SetPoint("TOPLEFT", COND_X, top)
        self.classesB = UI.ToggleChips(self, { options = { unpack(CLASSES, 6, 9) }, onChange = classes })
        self.classesB:SetPoint("TOPLEFT", COND_X, top - 32)
        -- you counted or not
        self.classesOthers = segmented(self, { { value = "me", label = "Counting you" }, { value = "others", label = "Others only" } },
            function(v: string) panel:SetCondition(self.index, function(c: Condition) c.others = (v == "others") or nil end) end)
        self.classesOthers:SetPoint("TOPLEFT", COND_X, top - 64)
        self.roles = chips(ROLES, function(c: Condition, v: string[]) c.roles = v end)
        local stances = STANCES[CLASS]
        self.stances = stances and chips(stances, function(c: Condition, v: string[]) c.stances = v end) or nil
        self.instance = chips(INSTANCES, function(c: Condition, v: string[]) c.kinds = v end)
        self.target = chips(TARGETS, function(c: Condition, v: string[]) c.kinds = v end)
        self.plain = UI.Text(self, "caption", "ink-faint")
        self.plain:SetPoint("TOPLEFT", COND_X, top - 6)
        -- talents: the chosen ones (icon, name, ✕), then a class (any: a
        -- profile may serve another character) and "+ Add talent…" of its
        -- talents (a typed number finds any spell by its ID)
        self.talentClassSelect = UI.Select(self, { width = 160, options = choiceOptions(CLASSES), value = CLASS, onChange = function(v: string?)
            if not v then return end
            self.talentClass = v
            self:TalentOptions()
        end })
        self.addTalent = UI.Select(self, { width = 300, placeholder = "+ Add talent…", lookup = spellLookup, onChange = function(v: string?)
            local id = v and (tonumber(v) or tonumber(v:match("^id:(%d+)$")))
            if not id then return end
            panel:SetCondition(self.index, function(c: Condition) Conditions.addTalent(c, id) end)
        end })
        local controls: Region[] = { self.group, self.classesA, self.classesB, self.classesOthers, self.roles, self.instance,
                                     self.target, self.plain, self.talentClassSelect, self.addTalent }
        if self.stances then controls[#controls + 1] = self.stances end
        self.controls = controls
    end

    -- The chosen class's talents, without those already chosen: by tree,
    -- left to right, each under its spec's name (Data/Talents; else the
    -- tree's number), then by name.
    function TalentOptions()
        local cond = self.cond
        local options = Conditions.talentOptions(classTalents(self.talentClass), cond and cond.talents)
        local byId: SelectOption<string>[] = {}
        for _, o in ipairs(options) do
            byId[#byId + 1] = { value = o.value and tostring(o.value), label = o.label, icon = o.icon, heading = o.heading }
        end
        self.addTalent:SetOptions(byId)
        self.addTalent:SetValue(nil)
    end

    function Fill(c: Condition)
        self.notEdge:SetColor(c["not"] and "ember" or "gilt-line")
        self.notText:SetColor(c["not"] and "ember-text" or "ink-faint")
        self.type:SetOptions(conditionTypes(c.type))
        self.type:SetValue(c.type)
        self.cond = c
        for _, ctl in ipairs(self.controls) do ctl:Hide() end
        for _, t in ipairs(self.talentRows) do t:Hide() end
        local h = 26
        local stances = self.stances
        if c.type == "group" then
            self.group:SetValue(c.value or "group")
            self.group:Show()
            h = 30
        elseif c.type == "classes" then
            self.classesA:SetValue(c.classes)
            self.classesB:SetValue(c.classes)
            self.classesOthers:SetValue(c.others and "others" or "me")
            self.classesA:Show()
            self.classesB:Show()
            self.classesOthers:Show()
            h = 64 + 30
        elseif c.type == "role" then
            self.roles:SetValue(c.roles)
            self.roles:Show()
        elseif c.type == "stance" and stances then
            stances:SetValue(c.stances)
            stances:Show()
        elseif c.type == "instance" then
            self.instance:SetValue(c.kinds)
            self.instance:Show()
        elseif c.type == "target" then
            self.target:SetValue(c.kinds)
            self.target:Show()
        elseif c.type == "talent" then
            local y = 8 + 30 + 6
            local n = 0
            for _, talent in ipairs(c.talents or {}) do
                local id = asNumber(talent)
                if id then
                    n = n + 1
                    local t = self.talentRows[n] or TalentRow.new(self)
                    self.talentRows[n] = t
                    t.id = id
                    t.icon:SetArt(C_Spell.GetSpellTexture(id))
                    t.name:SetValue(talentName(id))
                    t:ClearAllPoints()
                    t:SetPoint("TOPLEFT", COND_X, -y)
                    t:Show()
                    y = y + 28
                end
            end
            self.talentClassSelect:ClearAllPoints()
            self.talentClassSelect:SetPoint("TOPLEFT", COND_X, -y)
            self.talentClassSelect:SetValue(self.talentClass)
            self.talentClassSelect:Show()
            self.addTalent:ClearAllPoints()
            self.addTalent:SetPoint("TOPLEFT", COND_X, -(y + 36))
            self:TalentOptions()
            self.addTalent:Show()
            h = y + 36 + 30 - (8 + 30 + 6)
        else
            self.plain:SetValue(c.type == "combat" and "No options: while you're in combat."
                or "Your class has no stances or forms.")
            self.plain:Show()
            h = 20
        end
        self.height = 8 + 30 + 6 + h + 8
        self:SetHeight(self.height)
    end
end

-- The conditions' section: a row per condition.
class ConditionsSection extends Section
    readonly rows: ConditionRow[] = {}
end

-- An aura's three sounds: the field of each, and its label.
type SoundField = { get: (e: Entry) -> string?, set: (e: Entry, v: string?) -> (), label: string }
local SOUND_FIELDS: SoundField[] = {
    { get = function(e: Entry): string? return e.soundAppear end, set = function(e: Entry, v: string?) e.soundAppear = v end,
      label = "Sound when it appears" },
    { get = function(e: Entry): string? return e.soundStack end, set = function(e: Entry, v: string?) e.soundStack = v end,
      label = "when it stacks up" },
    { get = function(e: Entry): string? return e.soundDrop end, set = function(e: Entry, v: string?) e.soundDrop = v end,
      label = "when it drops" },
}

-- A switch with its label, in a row of switches.
local function switch(row: Frame, x: number, label: string, onChange: (v: boolean) -> ()): Toggle
    local t = UI.Toggle(row, { onChange = onChange })
    t:SetPoint("LEFT", x, 0)
    local l = UI.Text(row, "label", "ink")
    l:SetPoint("LEFT", t, "RIGHT", 8, 0)
    l:SetValue(label)
    return t
end

class BehaviourPanel extends PanelClass
    readonly sections: Section[] = {}
    readonly scroll: ScrollArea
    readonly inner: Frame
    -- a note on top
    readonly note: Section
    readonly noteText: Text
    -- name, beside how many show at once or shown
    readonly naming: Section
    readonly name: TextField
    readonly sideLabel: Text
    readonly max: Stepper
    readonly slotShown: Toggle
    -- an aura slot's icon
    readonly iconSection: Section
    readonly icon: Select<string | number>
    -- a member's whose
    readonly memberSection: Section
    readonly memberSource: Segmented<string>
    -- cooldowns
    readonly cd: Section
    readonly ready: Segmented<string>
    readonly pop: Segmented<string>
    readonly sound: Select<string>
    readonly onCooldown: Segmented<string>
    readonly show: Segmented<string>
    readonly unusable: Segmented<string>
    readonly cdEdge: Segmented<string>
    readonly effect: Segmented<string>
    readonly effectAura: Select<string>
    -- auras
    readonly au: Section
    readonly source: Segmented<string>
    readonly missing: Segmented<string>
    readonly missingDebuff: Segmented<string>
    readonly auEdge: Segmented<string>
    readonly size: Segmented<string>
    readonly glow: Toggle
    readonly digits: Toggle
    readonly stacks: Toggle
    readonly expiring: Stepper
    readonly soundAppear: Select<string>
    readonly soundStack: Select<string>
    readonly soundDrop: Select<string>
    readonly soundNote: Text
    -- a weapon enchant
    readonly weaponSection: Section
    readonly weapon: Segmented<string>
    readonly weaponMissing: Segmented<string>
    readonly warnOoc: Toggle
    -- conditions
    readonly cond: ConditionsSection
    readonly match: Segmented<string>
    readonly addCondition: SuuButton
    readonly condSentence: Text
    readonly condNote: Text
    readonly reset: SuuButton
    readonly done: SuuButton
    -- the entry it's open on (name is the panel's Name field: the entry's
    -- name goes in entryName)
    key: string = ""
    path: Path = { key = "", i = 0 }
    uid: (string | number)? = nil
    entryName: string? = nil
    slotUid: (string | number)? = nil
    ctx: string = "single"
    auraByName: { [string]: number[] } = {}

    constructor()
        super(SuuUI.Root, { title = "Behaviour", width = BP_W, height = 600, solid = true })
        UI.MakeModal(self)
        -- everything scrolls once the panel would outgrow the screen (many
        -- conditions): the panel stops at most of the screen's height
        self.scroll = UI.ScrollArea(self.body, 6)
        self.scroll:SetAllPoints(self.body)
        self.inner = self.scroll.child
        self.inner:SetWidth(CW)
        local function section(): Section return Section.new(self.inner, self.sections) end

        -- a note on top: a member's slot, a cooldown slot's order
        -- (the box itself, then space-5 before the next section)
        self.note = section()
        self.note.height = 34 + T.space["space-5"]
        local box = CreateFrame("Frame", nil, self.note)
        box:SetPoint("TOPLEFT")
        box:SetPoint("TOPRIGHT")
        box:SetHeight(34)
        UI.Fill(box, "surface-sunk"):SetAllPoints()
        UI.Border(box, "gilt-faint")
        self.noteText = UI.Text(box, "caption", "ink-muted")
        self.noteText:SetPoint("LEFT", 8, 0)
        self.noteText:SetFixedWidth(CW - 16)
        self.noteText:SetJustifyH("LEFT")

        -- a shared slot's or collection's name, beside how many show at
        -- once (aura slots) or shown (cooldown slots)
        local nm = section()
        nm.height = 18 + 30 + 12
        local nameLabel = UI.Text(nm, "caption", "ink-muted")
        nameLabel:SetPoint("TOPLEFT")
        nameLabel:SetValue("Name")
        self.name = UI.TextField(nm, { width = 240, onChange = function(text: string?)
            if text and text ~= "" then self:MutateEntry(function(e: Entry) e.name = text end) end
        end })
        self.name:SetPoint("TOPLEFT", 0, -18)
        self.sideLabel = UI.Text(nm, "caption", "ink-muted")
        self.sideLabel:SetPoint("TOPLEFT", 256, 0)
        self.max = UI.Stepper(nm, { min = 1, max = 4, step = 1, onChange = function(v: number)
            self:MutateEntry(function(e: Entry) e.max = v end)
        end })
        self.max:SetPoint("TOPLEFT", 256, -18)
        self.slotShown = UI.Toggle(nm, { onChange = function(v: boolean)
            self:MutateEntry(function(e: Entry) e.hidden = (not v) or nil end)
        end })
        self.slotShown:SetPoint("TOPLEFT", 256, -24)
        self.naming = nm

        -- an aura slot's icon while none of its auras is up. Automatic: what
        -- can show (the first member you know, else the icon); a member:
        -- always that one's
        local ic = section()
        self.icon = UI.Select(ic, { width = 240, placeholder = "First spell", onChange = function(v: (string | number)?)
            if v == "auto" then
                self:MutateEntry(function(e: Entry) e.fixedIcon = nil end)
            elseif type(v) == "number" then
                self:MutateEntry(function(e: Entry) e.icon, e.fixedIcon = v, true end)
            end
        end })
        ic:Add("Icon when none is up", self.icon)
        self.iconSection = ic

        -- a member's whose (unless set, the slot's)
        local ms = section()
        self.memberSource = segmented(ms, WHOSE, function(v: string)
            self:MutateEntry(function(e: Entry, slot: Entry?)
                e.source = (not slot or v ~= entrySource(slot, self.key)) and v or nil
            end)
        end)
        ms:Add("Whose", self.memberSource)
        self.memberSection = ms

        -- cooldowns
        local cd = section()
        self.ready = segmented(cd, { { value = "normal", label = "Normal" }, { value = "glow", label = "Glow" }, { value = "pulse", label = "Pulse" } },
            function(v: string) self:MutateEntry(function(e: Entry) e.ready = v ~= "normal" and v or nil end) end)
        cd:Add("When ready", self.ready)
        self.pop = segmented(cd, { { value = "default", label = "Like Display" }, { value = "on", label = "On" }, { value = "off", label = "Off" } },
            function(v: string)
                self:MutateEntry(function(e: Entry) if v == "default" then e.pop = nil else e.pop = (v == "on") end end)
            end)
        cd:Add("Pop when it comes ready", self.pop)
        self.sound = UI.Select(cd, { width = 220, options = SOUND_OPTIONS, onChange = function(v: string)
            self:MutateEntry(function(e: Entry) e.sound = v ~= "none" and v or nil end)
            if v ~= "none" then UI.TrackerSound(v) end
        end })
        cd:Add("Sound when ready", self.sound)
        self.onCooldown = segmented(cd, { { value = "grey", label = "Grey" }, { value = "dim", label = "Dim" }, { value = "hide", label = "Hide" } },
            function(v: string) self:MutateEntry(function(e: Entry) e.onCooldown = v ~= "grey" and v or nil end) end)
        cd:Add("On cooldown", self.onCooldown)
        self.show = segmented(cd, { { value = "always", label = "Always" }, { value = "ready", label = "Only when ready" },
                                   { value = "cooldown", label = "Only on cooldown" } },
            function(v: string) self:MutateEntry(function(e: Entry) e.show = v ~= "always" and v or nil end) end)
        cd:Add("Show", self.show)
        self.unusable = segmented(cd, { { value = "dim", label = "Dim" }, { value = "hide", label = "Hide" } },
            function(v: string) self:MutateEntry(function(e: Entry) e.unusable = v ~= "dim" and v or nil end) end)
        cd:Add("When unusable (not enough rage, wrong form)", self.unusable)
        self.cdEdge = segmented(cd, EDGES,
            function(v: string) self:MutateEntry(function(e: Entry) e.border = v ~= "default" and v or nil end) end)
        cd:Add("Edge when ready", self.cdEdge)
        -- "Effect running": while the spell's buff (or your debuff on the
        -- target) is up, its aura covers the icon with its own time
        self.effect = segmented(cd, { { value = "off", label = "Off" }, { value = "you", label = "Buff on you" },
                                     { value = "target", label = "Debuff on target" } },
            function(v: string)
                self:MutateEntry(function(e: Entry) e.effect = v ~= "off" and v or nil end)
                self.effectAura:SetDisabled(v == "off")
            end)
        cd:Add("While its effect runs, show it over the icon", self.effect)
        self.effectAura = UI.Select(cd, { width = 300, lookup = spellLookup, onChange = function(v: string?)
            if v == nil or v == "current" then return end
            self:MutateEntry(function(e: Entry)
                local id = tonumber(v:match("^id:(%d+)$"))
                local ids = self.auraByName[v]
                if v == "self" then
                    e.effectIDs, e.effectName = nil, nil
                elseif id then
                    e.effectIDs, e.effectName = { id }, ("%s · ID %d"):format(C_Spell.GetSpellName(id) or "?", id)
                elseif ids then
                    e.effectIDs, e.effectName = copy(ids), v
                end
            end)
        end })
        cd:Add("Effect (name or spell ID)", self.effectAura)
        self.cd = cd

        -- auras
        local au = section()
        -- whose aura counts (a shared slot's own setting; its members may differ)
        self.source = segmented(au, WHOSE, function(v: string)
            self:MutateEntry(function(e: Entry)
                e.mine = nil
                e.source = v ~= LIST_SOURCE[self.key] and v or nil
                if e.group then e.source = v end
            end)
        end)
        au:Add("Whose", self.source)
        -- (unset = the list's default: grey for buffs, with a target for debuffs)
        local function setMissing(v: string)
            self:MutateEntry(function(e: Entry) e.missing = v ~= MISSING_DEFAULT[self.key] and v or nil end)
        end
        self.missing = segmented(au, MISSING, setMissing)
        au:Add("When missing", self.missing)
        self.missingDebuff = segmented(au, MISSING_DEBUFF, setMissing)
        self.missingDebuff:SetPoint(self.missing:GetPoint())
        self.auEdge = segmented(au, EDGES,
            function(v: string) self:MutateEntry(function(e: Entry) e.border = v ~= "default" and v or nil end) end)
        au:Add("Edge", self.auEdge)
        self.size = segmented(au, { { value = "small", label = "Small" }, { value = "normal", label = "Normal" }, { value = "large", label = "Large" } },
            function(v: string) self:MutateEntry(function(e: Entry) e.size = v ~= "normal" and v or nil end) end)
        au:Add("Size", self.size)
        -- three switches in one row
        local row = CreateFrame("Frame", nil, au)
        row:SetSize(CW, 30)
        self.glow = switch(row, 0, "Glow", function(v: boolean) self:MutateEntry(function(e: Entry) e.glow = v or nil end) end)
        self.digits = switch(row, 120, "Timer", function(v: boolean)
            self:MutateEntry(function(e: Entry) if v then e.digits = nil else e.digits = false end end)
        end)
        self.stacks = switch(row, 240, "Stacks", function(v: boolean)
            self:MutateEntry(function(e: Entry) if v then e.stacks = nil else e.stacks = false end end)
        end)
        au:Add(nil, row)
        -- the amber threshold on one line, its label before it
        local amber = CreateFrame("Frame", nil, au)
        amber:SetSize(CW, 30)
        local amberLabel = UI.Text(amber, "caption", "ink-muted")
        amberLabel:SetPoint("LEFT")
        amberLabel:SetValue("Timer turns amber in the last")
        self.expiring = UI.Stepper(amber, { min = 1, max = 10, step = 1, unit = "s", onChange = function(v: number)
            self:MutateEntry(function(e: Entry) e.expiring = v ~= 3 and v or nil end)
        end })
        self.expiring:SetPoint("LEFT", amberLabel, "RIGHT", 12, 0)
        au:Add(nil, amber)
        -- sounds, three across: the engine plays them (registered on every
        -- tracker build)
        local sounds = CreateFrame("Frame", nil, au)
        sounds:SetSize(CW, 48)
        local selects: Select<string>[] = {}
        for n, s in ipairs(SOUND_FIELDS) do
            local t = UI.Text(sounds, "caption", "ink-muted")
            t:SetPoint("TOPLEFT", (n - 1) * 150, 0)
            t:SetValue(s.label)
            local sel = UI.Select(sounds, { width = 140, options = SOUND_OPTIONS, onChange = function(v: string)
                self:MutateEntry(function(e: Entry) s.set(e, v ~= "none" and v or nil) end)
                if v ~= "none" then UI.TrackerSound(v) end
            end })
            sel:SetPoint("TOPLEFT", (n - 1) * 150, -18)
            selects[n] = sel
        end
        self.soundAppear, self.soundStack, self.soundDrop = selects[1], selects[2], selects[3]
        local h = au:Add(nil, sounds, 48)
        self.soundNote = UI.Text(au, "caption", "ink-muted")
        self.soundNote:SetWordWrap(true)
        self.soundNote:SetJustifyH("LEFT")
        self.soundNote:SetFixedWidth(CW)
        self.soundNote:SetPoint("TOPLEFT", 0, -(h - 6))
        self.soundNote:SetValue("The game plays these itself, in combat too, for this aura from anyone.")
        au.height = h + 22
        self.au = au

        -- a weapon enchant: which weapon, while it has nothing on it (warn:
        -- the ember edge pulses), and whether the warning waits for the end
        -- of a fight
        local we = section()
        self.weapon = segmented(we, { { value = "main", label = "Main hand" }, { value = "off", label = "Off hand" },
                                     { value = "ranged", label = "Ranged" } },
            function(v: string) self:MutateEntry(function(e: Entry) e.enchant, e.name = v, ENCHANT_NAME[v] end) end)
        we:Add("Weapon", self.weapon)
        self.weaponMissing = segmented(we, { { value = "hide", label = "Hide" }, { value = "grey", label = "Grey" },
                                            { value = "warn", label = "Warn" } },
            function(v: string)
                self:MutateEntry(function(e: Entry) e.missing = v ~= "warn" and v or nil end)
                self.warnOoc:SetDisabled(v ~= "warn")
            end)
        we:Add("When missing (Warn: the ember edge pulses)", self.weaponMissing)
        self.warnOoc = UI.Toggle(we, { onChange = function(v: boolean)
            self:MutateEntry(function(e: Entry) e.warnCombat = (not v) or nil end)
        end })
        we:Add("Warn only out of combat", self.warnOoc)
        self.weaponSection = we

        -- conditions
        local cs = ConditionsSection.new(self.inner, self.sections)
        local rule = UI.Hairline(cs, "gilt-faint")
        rule:SetPoint("TOPLEFT")
        rule:SetPoint("TOPRIGHT")
        local title = UI.Text(cs, "label", "gilt-text")
        title:SetPoint("TOPLEFT", 0, -18)
        title:SetValue("Conditions")
        self.match = segmented(cs, { { value = "all", label = "All of these" }, { value = "any", label = "Any of these" } },
            function(v: string) self:MutateWhen(function(w: EditedWhen) w.match = v end) end)
        self.match:SetPoint("TOPRIGHT", 0, -12)
        self.addCondition = UI.Button(cs, { text = "+ Add condition", onClick = function()
            -- the first type not used yet
            self:MutateWhen(function(w: EditedWhen)
                table.insert(w.conditions, newCondition(Conditions.firstUnusedType(w.conditions, CLASS)))
            end)
        end })
        self.condSentence = UI.Text(cs, "body", "ink")
        self.condSentence:SetWordWrap(true)
        self.condSentence:SetJustifyH("LEFT")
        self.condSentence:SetFixedWidth(CW)
        self.condNote = UI.Text(cs, "caption", "ink-muted")
        self.cond = cs

        self.reset = UI.Button(self.inner, { text = "Reset", width = 90, onClick = function()
            local ctx = self.ctx
            self:MutateEntry(function(e: Entry) Lists.resetBehaviour(e, ctx) end)
        end })
        self.done = UI.Button(self.inner, { text = "Done", variant = "primary", width = 90, onClick = function() self:Hide() end })
    end

    -- The panel's entry in the lists, and the shared slot it's a member of:
    -- by uid (shared slots and collections have one; a member goes by its
    -- slot's), else at its path while that is still the same spell; nil
    -- once it's gone.
    function Find(l: ListSet): (Entry?, Entry?)
        return Lists.findEntry(l, { key = self.key, path = self.path, uid = self.uid, slotUid = self.slotUid,
                                    entryName = self.entryName })
    end

    function MutateEntry(fn: (e: Entry, slot: Entry?) -> ())
        mutate(function(l: ListSet)
            local e, slot = self:Find(l)
            if e then
                fn(e, slot)
                if slot then regroup(slot) end
            end
        end)
    end

    -- Changes the entry's conditions; with none left it has no `when`.
    function MutateWhen(fn: (w: EditedWhen) -> ())
        self:MutateEntry(function(e: Entry) Conditions.editWhen(e, fn) end)
    end

    function SetCondition(i: number, fn: (c: Condition, w: EditedWhen) -> ())
        self:MutateWhen(function(w: EditedWhen)
            local c = w.conditions[i]
            if c then fn(c, w) end
        end)
    end

    -- subject: the entry's name in the sentence (nil: "Shows …");
    -- note: under it ("Applies to everything inside.")
    function FillConditions(e: Entry, subject: string?, note: string?)
        local cs = self.cond
        local when = e.when
        local conds = when and when.conditions or {}
        self.match:SetValue(when and when.match or "all")
        local y = 12 + 30 + 10
        for _, r in ipairs(cs.rows) do r:Hide() end
        for i, c in ipairs(conds) do
            local r = cs.rows[i] or ConditionRow.new(cs, self)
            cs.rows[i] = r
            r.index = i
            r:Fill(c)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -y)
            r:Show()
            y = y + r.height + 6
        end
        self.addCondition:ClearAllPoints()
        self.addCondition:SetPoint("TOPLEFT", 0, -y)
        y = y + 30 + 10
        self.condSentence:SetValue(conditionSentence(subject, when))
        self.condSentence:ClearAllPoints()
        self.condSentence:SetPoint("TOPLEFT", 0, -y)
        y = y + math.max(16, self.condSentence:GetStringHeight()) + 6
        self.condNote:SetShown(note ~= nil)
        if note then
            self.condNote:SetValue(note)
            self.condNote:ClearAllPoints()
            self.condNote:SetPoint("TOPLEFT", 0, -y)
            y = y + 16 + 4
        end
        cs.height = y + 8
    end

    -- Opens on the entry at `path`.
    function Open(path: Path, e: Entry, slot: Entry?)
        self.key, self.path, self.uid, self.entryName, self.slotUid = path.key, path, e.uid, e.name, slot and slot.uid
        self.scroll:SetVerticalScroll(0)
        self:Refresh()
        self:Show()
    end

    function Refresh()
        local e, slot = self:Find(M:Lists(M:EditSpec()))
        if not e then self:Hide(); return end
        local cooldown = kindOf(self.key) == "cooldown"
        local ctx = (e.collection and "collection") or (e.group and "slot") or (slot and "member") or "single"
        self.ctx = ctx
        local shown: Section[]
        local meta: string
        if ctx == "collection" then
            local n = #(e.entries or {})
            shown, meta = { self.naming, self.cond }, ("Collection · %d %s"):format(n, n == 1 and "entry" or "entries")
        elseif ctx == "member" then
            local slotName = slot and slot.name
            shown, meta = { self.note, self.memberSection, self.cond }, "In " .. (slotName or "a shared slot")
            self.noteText:SetValue("One slot: how it looks follows " .. (slotName or "the shared slot") .. ".")
        elseif ctx == "slot" then
            local n = #(e.members or {})
            if cooldown then
                shown = { self.note, self.naming, self.cd, self.cond }
                self.noteText:SetValue("Shows the last spell in the list you know: put upgrades last.")
                meta = ("Shared slot · %d %s"):format(n, n == 1 and "spell" or "spells")
            else
                shown = { self.naming, self.iconSection, self.au, self.cond }
                meta = ("Shared slot · %d %s"):format(n, n == 1 and "aura" or "auras")
            end
        elseif e.enchant then
            shown, meta = { self.weaponSection, self.cond }, self.path.j and "Weapon enchant · in a collection" or "Weapon enchant"
        else
            shown = { cooldown and self.cd or self.au, self.cond }
            meta = cooldown and ("Cooldown · " .. infoOf(self.key).label)
                or (self.path.j and "Single aura · in a collection" or "Single aura")
        end
        self:SetTitle(e.name or "Behaviour", meta)

        if ctx == "slot" or ctx == "collection" then
            self.name:SetValue(e.name or "")
            self.sideLabel:SetShown(ctx == "slot")
            self.sideLabel:SetValue(cooldown and "Shown" or "How many show at once")
            self.max:SetShown(ctx == "slot" and not cooldown)
            self.max:SetValue(e.max or 1)
            self.slotShown:SetShown(ctx == "slot" and cooldown)
            self.slotShown:SetValue(not e.hidden)
        end
        if ctx == "slot" and not cooldown then
            local iconOptions: SelectOption<string | number>[] = { { value = "auto", label = "Automatic (what can show)" } }
            for _, m in ipairs(e.members or {}) do
                local art = m.icon or (m.ids and m.ids[1])
                if art then iconOptions[#iconOptions + 1] = { value = art, label = m.name, icon = C_Spell.GetSpellTexture(art) } end
            end
            self.icon:SetOptions(iconOptions)
            self.icon:SetValue(e.fixedIcon and e.icon or "auto")
        end
        if ctx == "member" and slot then
            self.memberSource:SetValue(e.source or entrySource(slot, self.key))
        end
        if cooldown and ctx ~= "member" then
            self.ready:SetValue(e.ready or "normal")
            self.pop:SetValue(e.pop == nil and "default" or (e.pop and "on" or "off"))
            self.sound:SetValue(e.sound or "none")
            self.onCooldown:SetValue(e.onCooldown or "grey")
            self.show:SetValue(e.show or "always")
            self.unusable:SetValue(e.unusable or "dim")
            self.cdEdge:SetValue(e.border or "default")
            self.effect:SetValue(e.effect or "off")
            -- the effect: the spell itself, or any aura the presets know
            self.auraByName = (candidates("aura"))
            local options: SelectOption<string>[] = { { value = "self", label = "The spell itself (" .. (e.name or "?") .. ")" } }
            local names: string[] = {}
            for name in pairs(self.auraByName) do names[#names + 1] = name end
            table.sort(names)
            for _, name in ipairs(names) do options[#options + 1] = { value = name, label = name } end
            local current = "self"
            local effectName = e.effectName
            if effectName then
                current = self.auraByName[effectName] and effectName or "current"
                if current == "current" then table.insert(options, 2, { value = "current", label = effectName }) end
            end
            self.effectAura:SetOptions(options)
            self.effectAura:SetValue(current)
            self.effectAura:SetDisabled(not e.effect)
        elseif e.enchant then
            self.weapon:SetValue(e.enchant)
            self.weaponMissing:SetValue(e.missing or "warn")
            self.warnOoc:SetValue(not e.warnCombat)
            self.warnOoc:SetDisabled((e.missing or "warn") ~= "warn")
        elseif ctx == "single" or ctx == "slot" then
            self.source:SetValue(entrySource(e, self.key))
            local debuff = self.key == "debuffs"
            self.missing:SetShown(not debuff)
            self.missingDebuff:SetShown(debuff)
            local missing = debuff and self.missingDebuff or self.missing
            missing:SetValue(e.missing or MISSING_DEFAULT[self.key])
            missing:SetAlpha(self.key == "procs" and T.opacity["opacity-disabled"] or 1)
            self.auEdge:SetValue(e.border or "default")
            self.size:SetValue(e.size or "normal")
            self.glow:SetValue(e.glow and true or false)
            self.digits:SetValue(e.digits ~= false)
            self.stacks:SetValue(e.stacks ~= false)
            self.expiring:SetValue(e.expiring or 3)
            self.soundAppear:SetValue(e.soundAppear or "none")
            self.soundStack:SetValue(e.soundStack or "none")
            self.soundDrop:SetValue(e.soundDrop or "none")
        end

        -- conditions: on every entry (a cooldown slot's members have no panel)
        self:FillConditions(e, ctx ~= "collection" and e.name or nil,
            ctx == "collection" and "Applies to everything inside." or nil)

        -- the sections that apply, stacked; Reset and Done under them
        for _, s in ipairs(self.sections) do s:Hide() end
        local h = 0
        for _, s in ipairs(shown) do
            s:ClearAllPoints()
            s:SetPoint("TOPLEFT", self.inner, "TOPLEFT", 0, -h)
            s:SetHeight(s.height)
            s:Show()
            h = h + s.height
        end
        h = h + 10
        self.reset:ClearAllPoints()
        self.reset:SetPoint("TOPLEFT", self.inner, "TOPLEFT", 0, -h)
        self.done:ClearAllPoints()
        self.done:SetPoint("TOPRIGHT", self.inner, "TOPLEFT", CW, -h)
        local content = h + 30
        self.inner:SetHeight(content)
        self:SetHeight(math.min(self:BodyTop() + content + 20, math.floor(SuuUI.Root:GetHeight() * 0.85)))
    end
end

--------------------------------------------------------------------------------
-- The list editor: the Cooldowns or Auras tab, each list's head, its rows,
-- its "+ Add"; rows drag to reorder, onto each other to share a slot.
--------------------------------------------------------------------------------

-- What a row being dragged is, and what it may land on.
type Drag = Lists.DragFrom

-- What an "+ Add" offers: what you cast or saw lately first, then
-- everything by name, and (where shared slots may go) the presets'
-- shared slots of this list. Nothing the list already has.
local function addOptions(kind: string, key: string, byName: { [string]: number[] }, groups: { [string]: GroupOffer },
                          present: { [string]: boolean }, slots: boolean?): SelectOption<string>[]
    local top: SelectOption<string>[] = {}
    local taken: { [string]: boolean } = {}
    for _, r in ipairs(recent(kind)) do
        if not present[r.name] and not taken[r.name] then
            taken[r.name] = true
            if not byName[r.name] then byName[r.name] = copy(r.ids) end
            top[#top + 1] = { value = r.name, label = r.name, icon = idsArt(r.ids) }
        end
    end
    local options: SelectOption<string>[] = {}
    for name, ids in pairs(byName) do
        if not present[name] and not taken[name] then
            local iconID = candidateIcon[name]
            options[#options + 1] = { value = name, label = name,
                icon = iconID and C_Spell.GetSpellTexture(iconID) or idsArt(ids),
                note = kind ~= "cooldown" and auraClassNote[name] or nil }
        end
    end
    if slots then
        for name, g in pairs(groups) do
            if not present[name] and g.key == key then
                local e = g.entry
                options[#options + 1] = { value = "group:" .. name, label = name .. " (Shared slot)",
                    icon = e.icon and C_Spell.GetSpellTexture(e.icon) or idsArt(e.ids) }
            end
        end
    end
    table.sort(options, function(x: SelectOption<string>, z: SelectOption<string>): boolean return (x.label or "") < (z.label or "") end)
    if #top > 0 then
        table.insert(top, 1, { heading = "Seen recently" })
        top[#top + 1] = { heading = "All" }
        for _, o in ipairs(options) do top[#top + 1] = o end
        options = top
    end
    -- Buffs on you (not in a shared slot): one entry per weapon, first
    if key == "buffs" and slots then
        local weapons: SelectOption<string>[] = {}
        for _, hand in ipairs({ "main", "off" }) do
            if not present[ENCHANT_NAME[hand]] then
                weapons[#weapons + 1] = { value = "enchant:" .. hand, label = ENCHANT_NAME[hand], icon = enchantArt(hand) }
            end
        end
        if #weapons > 0 then
            table.insert(weapons, 1, { heading = "Weapon enchants" })
            local first = options[1]
            if not (first and first.heading) then weapons[#weapons + 1] = { heading = "Auras" } end
            for _, o in ipairs(options) do weapons[#weapons + 1] = o end
            options = weapons
        end
    end
    return options
end

class ListEditor extends Frame
    readonly tabs: Segmented<string>
    readonly rows: EntryRow[] = {}
    readonly heads: ListHead[] = {}
    readonly adds: AddRow[] = {}
    readonly addTos: AddToRow[] = {}
    -- folded or open, per collection and shared slot (by uid), this session:
    -- collections start open, shared slots folded
    readonly fold: { [string]: boolean } = {}
    -- Dragging: a ghost follows the cursor; an arcane line marks where the
    -- row lands, an arcane edge the row it joins.
    readonly ghost: DragGhost
    readonly line: Texture
    tab: string = "cooldowns"
    layout: { [string]: ListLayout } = {}
    drag: Drag? = nil
    target: DropTarget? = nil
    dragRow: EntryRow? = nil
    lit: EntryRow? = nil
    behaviour: BehaviourPanel? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(WIDTH, 100)
        self.tabs = UI.Segmented(self, { options = { { value = "cooldowns", label = "Cooldowns" }, { value = "auras", label = "Auras" } },
            onChange = function(v: string) self.tab = v; self:Refresh() end })
        self.tabs:SetPoint("TOPLEFT")
        self.tabs:SetValue("cooldowns")
        self.ghost = DragGhost.new()
        self.line = self:CreateTexture(nil, "OVERLAY")
        UI.PaintFill(self.line, "arcane")
        self.line:SetHeight(2)
        self.line:Hide()

        -- the panel closes with the page (and the settings window)
        self:HookScript("OnHide", function()
            local b = self.behaviour
            if b then b:Hide() end
        end)
        -- "Seen recently" changes while the settings are closed
        self:HookScript("OnShow", function() self:Refresh() end)

        self:Refresh()
        M:Watch("setups", function() self:Refresh() end)
        M:On("SUUUI_COOLDOWNS_SETUP", function()
            -- another spec's lists: the Behaviour panel's entry isn't there
            local b = self.behaviour
            if b then b:Hide() end
            self:Refresh()
        end)
    end

    -- Where a drop at the cursor lands, in the visible tab: at a position
    -- (the line goes over `frame`), or onto a row: a single entry (a new
    -- shared slot), a shared slot (joins it) or a collection (goes last in
    -- it). Rows that can take one are split in four: the top quarter is
    -- before, the middle onto, the bottom after.
    function DropTarget(): DropTarget?
        local _, cy = GetCursorPosition()
        cy = cy / self:GetEffectiveScale()
        for _, key in ipairs(tabLists(self.tab)) do
            local L = self.layout[key]
            local add, endPath = L and L.add, L and L.endPath
            local top, bottom = L and L.head:GetTop(), add and add:GetBottom()
            if L and add and endPath and top and bottom and cy <= top and cy >= bottom then
                local items, foot, tail = L.items, add, endPath
                local function at(n: number): DropTarget
                    local it = items[n]
                    if it then return { path = it.before, frame = it.frame } end
                    return { path = tail, frame = foot }
                end
                for n, it in ipairs(items) do
                    local t, b = it.frame:GetTop(), it.frame:GetBottom()
                    if t and b then
                        b = b - GAP
                        if cy <= t and cy > b then
                            local h = t - b
                            local row = it.row
                            if it.onto and row then
                                if cy > t - h / 4 then return at(n) end
                                if cy > b + h / 4 then return { onto = it.onto, path = it.path or it.before, frame = row, row = row } end
                                return at(n + 1)
                            end
                            return cy > t - h / 2 and at(n) or at(n + 1)
                        end
                    end
                end
                local first = items[1]
                local firstTop = first and first.frame:GetTop()
                if firstTop and cy > firstTop then return at(1) end
                return at(#items + 1)
            end
        end
        return nil
    end

    function ShowDrop(t: DropTarget?)
        local lit = self.lit
        if lit then
            lit.dropFill:Hide()
            lit.dropEdge:SetShown(false)
            self.lit = nil
        end
        self.line:Hide()
        if not t then return end
        local row = t.row
        if t.onto and row then
            row.dropFill:Show()
            row.dropEdge:SetShown(true)
            self.lit = row
        else
            self.line:ClearAllPoints()
            self.line:SetPoint("BOTTOMLEFT", t.frame, "TOPLEFT", 0, 1)
            self.line:SetPoint("BOTTOMRIGHT", t.frame, "TOPRIGHT", 0, 1)
            self.line:Show()
        end
    end

    function StartDrag(row: EntryRow)
        local drag: Drag = { path = row.path, kind = row.kind, enchant = row.entry.enchant }
        self.drag = drag
        row:SetAlpha(0.4)
        self.dragRow = row
        self.ghost.icon:SetArt(row.icon:IsShown() and row.icon.art:GetTexture() or nil)
        self.ghost.name:SetValue(row.name:GetText() or "")
        self.ghost:Show()
        self:SetScript("OnUpdate", function()
            local x, y = GetCursorPosition()
            local s = UIParent:GetEffectiveScale()
            self.ghost:ClearAllPoints()
            self.ghost:SetPoint("LEFT", UIParent, "BOTTOMLEFT", x / s + 12, y / s)
            local t = self:DropTarget()
            -- a drop that isn't allowed doesn't light up
            if t and not accepts(drag, t) then t = nil end
            self.target = t
            self:ShowDrop(t)
        end)
    end

    function StopDrag()
        self:SetScript("OnUpdate", nil)
        self.ghost:Hide()
        self:ShowDrop(nil)
        local dragRow = self.dragRow
        if dragRow then dragRow:SetAlpha(1) end
        local from, to = self.drag, self.target
        self.drag, self.target, self.dragRow = nil, nil, nil
        if not (from and to) then return end
        if to.onto == "entry" then
            -- onto a single entry: offer a shared slot of the two
            local lists = M:Lists(M:EditSpec())
            local a, b = entryAt(lists, to.path), entryAt(lists, from.path)
            if not (a and b) then return end
            local names = { a.name, b.name }
            local cooldown = kindOf(to.path.key) == "cooldown"
            UI.Confirm({
                title = "Make a shared slot?",
                text = ("Make \"%s + %s\" a shared slot? %s"):format(a.name or "?", b.name or "?", cooldown
                    and "One icon: the last of them you know shows there."
                    or "One icon: whichever is up shows there."),
                confirm = "Make shared slot",
                onConfirm = function()
                    local uid = newUid()
                    self.fold[uid] = true
                    mutate(function(l: ListSet) combine(l, to.path, from.path, uid, names) end)
                end })
            return
        end
        local dest = Lists.dropPath(to)
        mutate(function(l: ListSet) Lists.moveEntry(l, from.path, dest) end)
    end

    function RemoveAt(path: Path)
        mutate(function(l: ListSet) Lists.removeAt(l, path) end)
    end

    function IsOpen(e: Entry, p: Path): boolean
        local v = self.fold[Lists.foldKey(e, p)]
        if v == nil then return e.collection and true or false end
        return v
    end

    function ToggleFold(r: EntryRow)
        self.fold[Lists.foldKey(r.entry, r.path)] = not self:IsOpen(r.entry, r.path)
        self:Refresh()
    end

    function Refresh()
        self.layout = {}
        for _, r in ipairs(self.rows) do r:Hide() end
        for _, h in ipairs(self.heads) do h:Hide() end
        for _, a in ipairs(self.adds) do a:Hide() end
        for _, a in ipairs(self.addTos) do a:Hide() end
        local lists = M:Lists(M:EditSpec())
        local y = -(30 + 12)
        local rowN, addN = 0, 0
        local found: { [string]: { byName: { [string]: number[] }, groups: { [string]: GroupOffer } } } = {}
        for i, key in ipairs(tabLists(self.tab)) do
            local info = infoOf(key)
            local cooldown = info.kind == "cooldown"
            local list = lists[key] or {}
            local known = found[info.kind]
            if not known then
                local byName, groups = candidates(info.kind)
                known = { byName = byName, groups = groups }
                found[info.kind] = known
            end
            local byName, groups = known.byName, known.groups
            local present: { [string]: boolean } = {}
            local spells, nested = 0, false
            walk(list, key, function(e: Entry)
                if e.name then present[e.name] = true end
                if e.group or e.collection then nested = true else spells = spells + 1 end
            end)
            local h = self.heads[i] or ListHead.new(self)
            self.heads[i] = h
            h.title:SetValue(info.label)
            h.note:SetValue(info.note)
            local noun = cooldown and "spell" or "aura"
            if nested then
                h.count:SetValue(("%d %s · %d %s"):format(#list, #list == 1 and "entry" or "entries", spells, spells == 1 and noun or (noun .. "s")))
            else
                h.count:SetValue(#list == 1 and "1 spell" or (#list .. " spells"))
            end
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", 0, y)
            h:Show()
            local L: ListLayout = { items = {}, head = h }
            self.layout[key] = L
            y = y - 38

            local function place(fr: RailedFrame, level: number, rails: Rail[])
                fr:ClearAllPoints()
                fr:SetPoint("TOPLEFT", level * INDENT, y)
                fr:SetWidth(WIDTH - level * INDENT)
                fr:SetRails(rails, level)
                fr:Show()
                y = y - (ROW_H + GAP)
            end
            -- c: what the row shows, plus its rails, and what may land on it;
            -- a drop over its top lands at its position
            local function row(c: RowContext)
                rowN = rowN + 1
                local r = self.rows[rowN] or EntryRow.new(self)
                self.rows[rowN] = r
                r:Fill(c)
                place(r, c.level, c.rails)
                L.items[#L.items + 1] = { frame = r, before = c.path, onto = c.onto, path = c.path, row = r }
            end
            local function addTo(box: Entry, path: Path, level: number, rails: Rail[], endPath: Path)
                addN = addN + 1
                local a = self.addTos[addN] or AddToRow.new(self)
                self.addTos[addN] = a
                a.path, a.byName, a.groups = path, byName, groups
                a.select.placeholder = "+ Add to " .. (box.name or "it") .. "…"
                a.select:SetOptions(addOptions(info.kind, key, byName, groups, present, box.collection))
                a.select:SetValue(nil)
                place(a, level, rails)
                L.items[#L.items + 1] = { frame = a, before = endPath }
            end
            -- a single entry, or a shared slot and (open) its members
            local function entryRows(e: Entry, p: Path, level: number, rails: Rail[])
                if not e.group then
                    -- (nothing joins a weapon enchant in a shared slot)
                    row({ key = key, path = p, entry = e, kind = "entry", level = level, rails = rails,
                          onto = not e.enchant and "entry" or nil })
                    return
                end
                local open = self:IsOpen(e, p)
                row({ key = key, path = p, entry = e, kind = "slot", level = level, rails = rails, open = open, onto = "slot" })
                if not open then return end
                local inner: Rail[] = { unpack(rails) }
                inner[#inner + 1] = { level = level, faint = true }
                local members = e.members or {}
                for m, x in ipairs(members) do
                    row({ key = key, path = { key = key, i = p.i, j = p.j, m = m }, entry = x, kind = "member", slot = e,
                          level = level + 1, rails = inner })
                end
                addTo(e, p, level + 1, inner, { key = key, i = p.i, j = p.j, m = #members + 1 })
            end

            for index, e in ipairs(list) do
                local p: Path = { key = key, i = index }
                if e.collection then
                    local open = self:IsOpen(e, p)
                    row({ key = key, path = p, entry = e, kind = "collection", level = 0, rails = {}, open = open, onto = "collection" })
                    if open then
                        local rails: Rail[] = { { level = 0 } }
                        local entries = e.entries or {}
                        for j, x in ipairs(entries) do entryRows(x, { key = key, i = index, j = j }, 1, rails) end
                        addTo(e, p, 1, rails, { key = key, i = index, j = #entries + 1 })
                    end
                else
                    entryRows(e, p, 0, {})
                end
            end

            local a = self.adds[i] or AddRow.new(self)
            self.adds[i] = a
            a.key = key
            a.newCollection:SetShown(not cooldown) -- collections are for auras
            a.byName, a.groups = byName, groups
            a.select:SetOptions(addOptions(info.kind, key, byName, groups, present, true))
            a.select:SetValue(nil)
            a:ClearAllPoints()
            a:SetPoint("TOPLEFT", 0, y)
            a:Show()
            L.add = a
            L.endPath = { key = key, i = #list + 1 }
            y = y - 46
        end
        self:SetHeight(-y)
        local b = self.behaviour
        if b and b:IsShown() then b:Refresh() end
    end

    -- The Behaviour panel, on the entry at `path`.
    function OpenBehaviour(path: Path)
        local t, i, slot = locate(M:Lists(M:EditSpec()), path)
        local e = t and i and t[i]
        if not e then return end
        local b = self.behaviour or BehaviourPanel.new()
        self.behaviour = b
        b:Open(path, e, slot)
    end
end

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

local function resourceOff(): (boolean, string?)
    if M:Get("resource") == "off" then return true, "Turn the resource bar on first." end
    return false
end

local SECTION: SettingsSection = {
    id = "cooldowns", label = "Cooldown Manager", category = "Frames", order = 26,
    groups = {
        { title = "What it shows", description = "Per specialization. A preset of your class fills the lists with its spells, every rank included. A shared slot puts several spells in one icon; a collection (auras) keeps entries together. Each entry decides for itself: shown or hidden, and what happens while it isn't up (auras): hidden (the others close up), grey in its place (debuffs: or only with a target), or Remind: grey only while it's missing and gone once it's up, out of combat (in combat the game hides which auras are up).", rows = {
            { label = "Your lists", control = "custom", build = function(p: Frame): Frame return PresetBar.new(p) end, stacked = true },
            { label = "Lists", control = "custom", build = function(p: Frame): Frame return ListEditor.new(p) end, stacked = true },
        } },
        { title = "How it shows", rows = {
            { key = "shows", label = "Shows", control = "segmented", options = UI.VISIBILITY_OPTIONS, combat = true,
              description = "Always, only in combat, or when the mouse is over it." },
            { key = "essentialSize", label = "Essential size", control = "slider", min = 30, max = 52, step = 2, unit = "px", live = false, combat = true,
              description = "The Essential row's icons. Utility stays at 30px unless it sits after Essential." },
            { key = "utilityInline", label = "Utility", control = "segmented", combat = true,
              options = { { value = false, label = "Own row" }, { value = true, label = "After Essential" } },
              description = "After Essential keeps the block two rows tall (the healer layout)." },
            { key = "readyPop", label = "Pop when ready", control = "toggle", description = "A cooldown coming off cooldown pops with the arcane flash." },
            { key = "procHighlight", label = "Proc highlight", control = "toggle", combat = true, description = "Procs wear the arcane edge and glow." },
        } },
        { title = "Resource bar", description = "Your mana, rage or energy under the icons, as wide as your cast bar: bar, cast bar and swing timer make one column. It moves with the Cooldown Manager.", rows = {
            { key = "resource", label = "Resource bar", control = "segmented", combat = true,
              options = { { value = "off", label = "Off" }, { value = "power", label = "Power" }, { value = "both", label = "Power + points" } },
              description = "Combo points for rogues, and druids in cat form." },
            { key = "resourceWidth", label = "Width", control = "segmented", combat = true, disabled = resourceOff,
              options = { { value = "cast", label = "Cast bar" }, { value = "own", label = "Own" } },
              description = "As your cast bar (Cast & swing bars › Width), or your own." },
            { key = "resourceOwnWidth", label = "Own width", control = "slider", min = 160, max = 400, step = 10, unit = "px", combat = true,
              disabled = function(): (boolean, string?)
                  if M:Get("resource") == "off" then return resourceOff() end
                  if M:Get("resourceWidth") ~= "own" then return true, "Follows the cast bar's width." end
                  return false
              end },
            { key = "resourcePoints", label = "Combo points", control = "segmented", combat = true,
              options = { { value = "over", label = "Over the bar" }, { value = "under", label = "Under it" } },
              disabled = function(): (boolean, string?)
                  if M:Get("resource") ~= "both" then return true, "Turn on Power + points first." end
                  if CLASS ~= "ROGUE" and CLASS ~= "DRUID" then return true, "Only rogues and druids use combo points." end
                  return false -- wowlua: coverage ignore (a rogue or druid; the test character is a warrior)
              end },
            { key = "resourceHeight", label = "Height", control = "stepper", min = 8, max = 20, step = 1, unit = "px", combat = true, disabled = resourceOff },
            { key = "resourceNumber", label = "Number", control = "segmented", combat = true, disabled = resourceOff,
              options = { { value = "none", label = "Hidden" }, { value = "value", label = "Value" }, { value = "pct", label = "Percent" } },
              description = "Written by the game: SuuUI never sees the amount." },
            { key = "resourceLow", label = "Amber when low", control = "toggle", combat = true, disabled = resourceOff,
              description = "Mana and energy under 25%." },
            { key = "resourceDruidMana", label = "Druid mana in forms", control = "toggle", combat = true,
              description = "A thin mana line under rage or energy.",
              disabled = function(): (boolean, string?)
                  if M:Get("resource") == "off" then return resourceOff() end
                  if CLASS ~= "DRUID" then return true, "Only druids change forms." end
                  return false -- wowlua: coverage ignore (a druid; the test character is a warrior)
              end },
            { key = "resourceOoc", label = "Out of combat", control = "segmented", combat = true, disabled = resourceOff,
              options = { { value = "show", label = "Show" }, { value = "fade", label = "Fade" }, { value = "hide", label = "Hide" } },
              description = "Fade rests at 60%. Hidden keeps its place, so the icons don't jump when a fight starts." },
        } },
    },
}

-- Your cast bar's width (the cast bars module's setting), or the design's.
local function castWidth(): number
    local cast = SuuUI.GetModule("castbars")
    local w: unknown = cast and cast:Setting("playerWidth")
    return type(w) == "number" and w or 340
end

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

class CooldownsModule extends Module<typeof(DEFAULTS)>
    tracker: CooldownTracker? = nil
    resource: ResourceBar? = nil
    -- this character's spec and its points per tree
    spec: number = 0
    points: number[] = { 0, 0, 0 }
    -- the spec whose setup the settings edit (nil: the active one)
    editSpec: number? = nil

    constructor()
        super({
            id = "cooldowns",
            name = "Cooldown Manager",
            description = "Your cooldowns, buffs, procs and your debuffs on the target, set up per class and spec.",
            api = "0.8",
            combatSafe = true,
            defaults = DEFAULTS,
        })
    end

    function DetectSpec(): (number, number[])
        local ok, pts, total = pcall(treePoints)
        if not ok then return 0, { 0, 0, 0 } end
        return Lists.bestTree(pts, total), pts
    end

    ----------------------------------------------------------------------------
    -- Setups: this class's lists per spec, in the profile
    ----------------------------------------------------------------------------

    function EditSpec(): number return self.editSpec or self.spec end

    function SaveSetup(spec: number?, setup: Setup)
        local all = copy(self:Peek("setups"))
        local mine = all[CLASS] or {}
        all[CLASS] = mine
        mine[setupKey(spec)] = setup
        self:Set("setups", all)
    end

    -- The setup for a spec; a spec seen the first time starts from its preset.
    -- The saved one itself, to read only (a copy of every class's setups was
    -- 414 KB of garbage a call): changes go through SetLists on a copy.
    function Setup(spec: number?): Setup
        local mine = self:Peek("setups")[CLASS]
        local saved = mine and mine[setupKey(spec)]
        if saved then return saved end
        local p = specPreset(spec) or presets()[1]
        local s: Setup = { preset = p and p.id or "", lists = p and copyLists(p) or {} }
        self:SaveSetup(spec, s)
        return s
    end

    function Lists(spec: number?): ListSet return self:Setup(spec).lists end
    function PresetId(spec: number?): string return self:Setup(spec).preset end

    function SetLists(lists: ListSet, spec: number?)
        local s = copy(self:Setup(spec))
        s.lists = lists
        self:SaveSetup(spec, s)
    end

    function LoadPreset(id: string, spec: number?): boolean
        local p = findPreset(id)
        if not p then return false end
        self:SaveSetup(spec, { preset = id, lists = copyLists(p) })
        return true
    end

    -- The lists from before setups: kept for this class's active spec, dropped
    -- when they were another class's (a profile shared across classes).
    function MigrateLists()
        local old, oldPreset = self:Get("lists"), self:Get("preset")
        if next(old) ~= nil then
            local mine = self:Peek("setups")[CLASS]
            local key = setupKey(self.spec)
            if findPreset(oldPreset) and not (mine and mine[key]) then
                self:SaveSetup(self.spec, { preset = oldPreset, lists = copy(old) })
            end
            self:Set("lists", {})
            self:Set("preset", "")
        end
    end

    function UpdateSpec()
        local spec, pts = self:DetectSpec()
        self.points = pts
        if spec ~= self.spec then
            self.spec = spec
            self.editSpec = nil -- the settings follow the new active spec
            if self.tracker and self:IsEnabled() then self:Apply() end
            self:Emit("SUUUI_COOLDOWNS_SETUP")
        end
    end

    -- How many entries differ from the preset the lists are based on: added,
    -- removed, changed (shown, behaviour, a shared slot's settings), or moved
    -- into or out of a collection. A collection counts once for itself (added,
    -- removed, renamed or its condition); it matches the preset's by uid (a
    -- preset's copy keeps the one copyLists gave it), else by name.
    function Changes(): number
        local spec = self:EditSpec()
        local p = findPreset(self:PresetId(spec))
        if not p then return 0 end
        return Lists.countChanges(p, self:Lists(spec))
    end

    function Apply()
        local t = self.tracker
        if not t then return end
        t:SetOptions({
            essentialSize = self:Get("essentialSize"),
            utilityInline = self:Get("utilityInline"),
            readyPop = self:Get("readyPop"),
            procHighlight = self:Get("procHighlight"),
        })
        -- the tracker keeps them: its own copy of this spec's
        t:SetLists(copy(self:Lists(self.spec)))
        self:ApplyVisibility()
    end

    -- The resource bar: its options, then the block lays out around it.
    function ApplyResource()
        local r, t = self.resource, self.tracker
        if not (r and t) then return end
        r:SetOptions({
            show = self:Get("resource"),
            width = self:Get("resourceWidth") == "own" and self:Get("resourceOwnWidth") or castWidth(),
            points = self:Get("resourcePoints"),
            height = self:Get("resourceHeight"),
            number = self:Get("resourceNumber"),
            low = self:Get("resourceLow"),
            druidMana = self:Get("resourceDruidMana"),
            ooc = self:Get("resourceOoc"),
        })
        if self:Get("resource") == "off" then r:Stop() else r:Start() end
        t:Layout()
    end

    -- Where and when it shows: nothing to rebuild.
    function ApplyVisibility()
        local t = self.tracker
        if not t then return end
        local pos = self:Get("position")
        UI.SetVisibility(t, pos.hidden and "hidden" or self:Get("shows"))
    end

    override function OnEnable()
        -- Blizzard's own manager would show beside this one (it comes back when
        -- this module turns off).
        if C_CVar and C_CVar.GetCVar and C_CVar.GetCVar("cooldownViewerEnabled") == "1" then
            if pcall(C_CVar.SetCVar, "cooldownViewerEnabled", "0") then self:Set("viewerOff", true) end
        end
        local tracker = self.tracker
        if not tracker then
            tracker = UI.CooldownTracker(SuuUI.Root, { name = "SuuUICooldownManager" })
            self.tracker = tracker
        else
            tracker:Start() -- turned on again
        end
        -- This character's spec, then the lists from before setups (once). A
        -- spec seen the first time starts from its preset (Setup).
        self.spec, self.points = self:DetectSpec()
        self:MigrateLists() -- before anything reads a setup (that would create it from the preset)
        -- the resource bar under the rows, part of the same frame in edit mode
        if not self.resource then
            local resource = UI.ResourceBar(tracker, { name = "SuuUIResourceBar" })
            resource.onResize = function() tracker:Layout() end
            tracker:SetFooter(resource)
            self.resource = resource
        end
        self:RegisterMover(tracker, { key = "position", label = "Cooldown Manager", managedShow = true })
        self:RegisterSettings(SECTION)
        self:Apply()
        self:ApplyResource()
        self:WatchAll({ "resource", "resourceWidth", "resourceOwnWidth", "resourcePoints", "resourceHeight",
                        "resourceNumber", "resourceLow", "resourceDruidMana", "resourceOoc" }, function() self:ApplyResource() end)
        -- as wide as your cast bar, live
        self:On("SUUUI_SETTING_CHANGED", function(_, namespace, key)
            if namespace == "castbars" and key == "playerWidth" then self:ApplyResource() end
        end)
        self:WatchAll({ "setups", "essentialSize", "utilityInline", "readyPop", "procHighlight" }, function() self:Apply() end)
        -- moving it or when it shows doesn't rebuild it
        self:WatchAll({ "shows", "position" }, function() self:ApplyVisibility() end)
        -- "Seen recently" for "+ Add" (aura changes settle first)
        local pending = false
        self:OnUnitEvent("UNIT_AURA", { "player", "target" }, function()
            if pending or InCombatLockdown() then return end
            pending = true
            after(1, function() pending = false; rememberAuras() end)
        end)
        self:OnGameEvent("PLAYER_TARGET_CHANGED", function() after(0.5, rememberAuras) end)
        self:OnUnitEvent("UNIT_SPELLCAST_SUCCEEDED", { "player" }, function(_, _, _, spellID) rememberCast(spellID) end)
        -- respecs and new talent points switch the setup
        local function respec() after(0.2, function() self:UpdateSpec() end) end
        self:OnGameEvent("TRAIT_CONFIG_UPDATED", respec)
        self:OnGameEvent("TRAIT_NODE_CHANGED", respec)
        self:OnGameEvent("PLAYER_TALENT_UPDATE", respec)
        self:OnGameEvent("CHARACTER_POINTS_CHANGED", respec)
        self:OnGameEvent("PLAYER_LEVEL_UP", respec)
        self:OnGameEvent("PLAYER_ENTERING_WORLD", respec)
        self:OnGameEvent("ACTIVE_PLAYER_SPECIALIZATION_CHANGED", respec)
    end

    -- Off: no events, driver or aura sounds, hidden in edit and keybind mode
    -- too, and Blizzard's manager back if this module switched it off.
    override function OnDisable()
        local tracker = self.tracker
        if tracker then
            tracker:Stop()
            UI.SetVisibility(tracker, "hidden")
        end
        local resource = self.resource
        if resource then resource:Stop() end
        if self:Get("viewerOff") then
            self:Set("viewerOff", false)
            self:RunOutOfCombat("viewer", function()
                if C_CVar and C_CVar.SetCVar then pcall(C_CVar.SetCVar, "cooldownViewerEnabled", "1") end
            end)
        end
    end
end

M = SuuUI.AddModule(CooldownsModule.new())

M:Migrate("essentialSize-30-52", migrations.essentialSize)
M:Migrate("slot-uids", migrations.slotUids)
M:Migrate("missing-per-entry", migrations.missingPerEntry)
M:Migrate("shaman-shields-auto", migrations.shamanShieldsAuto)
M:Migrate("short-buffs-warn", migrations.shortBuffsWarn)
