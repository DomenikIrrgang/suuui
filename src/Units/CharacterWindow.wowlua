-- Units/CharacterWindow.wowlua
-- The Character window in SuuUI's look (step 3.1, design boards
-- "Character", "Window frame"): Blizzard's own window (Forever's, with its
-- mode tabs, left and right panes; probed 2026-10-13) restyled in place, so
-- equipping, the model, every tab and Escape stay Blizzard's.
--   3.1a: the shell: SuuUI's header (icon, title, key chip, close) and the
--         mode tabs as text tabs along the top, in the design's order
--         (Character, Reputation, Currency, Player vs. Player, Skills,
--         Statistics); Blizzard's metal frame, portrait and pane
--         backgrounds out of sight. The window opens lined up under the
--         micro menu.
--   3.1b: the Character tab as the design: the identity line (class
--         diamond, name, level, race, class), the gear slots as SuuUI item
--         slots (quality edge, empty ones dimmed), the model in a gilt-faint
--         box without Blizzard's zoom and turn buttons, the stats as a
--         StatList (gilt-text heads, ink-muted labels, ink values, gilt-faint
--         rules), the side buttons (Stats, Titles, Sets) as a segmented row.
--   The Pet tab, after Character while you have a pet: the paper doll's pet
--         view (the pet's model, stats and experience; the identity line
--         the pet's), in place of Blizzard's Pet side button.
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type DurabilityInfo, DurabilityPiece from "/Core/ServiceKeys"
import type TabMarker from "/UI/TabMarker"
import type WindowChrome, SkinTab from "/UI/WindowSkin"
import type ItemSlotSkin from "/UI/Inventory"
import type Text from "/UI/Text"
import type Color from "/Core/Tokens"
import type TooltipData from "/UI/Tooltip"
import type ScrollArea from "/UI/Panel"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import isSecret from "wowlua:secret"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as errors from "wowlua:errors"
import leave from "/UI/Reskin"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local QUALITY: { [number]: string } = {
    [0] = "poor",
    "common",
    "uncommon",
    "rare",
    "epic",
    "legendary",
    "legendary",
    "legendary",
}

local SLOTS = {
    "Head",
    "Neck",
    "Shoulder",
    "Back",
    "Chest",
    "Shirt",
    "Tabard",
    "Wrist",
    "Hands",
    "Waist",
    "Legs",
    "Feet",
    "Finger0",
    "Finger1",
    "Trinket0",
    "Trinket1",
    "MainHand",
    "SecondaryHand",
    "Ranged",
}

local DEFAULTS = {}

local M: CharacterWindowModule

-- Blizzard's mode tabs (CharacterFrameModeTab1-6) by the pane they open, in
-- the design's order.
local TABS = {
    { index = 1, pane = "PaperDollFrame", label = "Character", short = "Character" },
    { index = 2, pane = "ReputationFrame", label = "Reputation", short = "Reputation" },
    { index = 5, pane = "TokenFrame", label = "Currency", short = "Currency" },
    { index = 4, pane = "PVPRankFrame", label = "Player vs. Player", short = "PvP" },
    { index = 3, pane = "SkillsFrame", label = "Skills", short = "Skills" },
    { index = 6, pane = "StatisticsFrame", label = "Statistics", short = "Stats" },
}

-- One of the game's frames by its global name.
local function frame(name: string): Frame?
    return frames.find(name)
end

local function shown(name: string): boolean
    local f = frames.asRegion(tbl.field(_G, name))
    return f and f:IsShown() or false
end

-- What each of the game's frames got already (a frame skinned once).
local done: { [unknown]: boolean } = {}
setmetatable(done, { __mode = "k" })
local function once(f: unknown): boolean
    if f == nil or done[f] then
        return false
    end
    done[f] = true
    return true
end

-- Its button textures (normal, pushed, highlight, …) out of sight.
local function hideButtonArt(b: Button, getters: string[])
    for _, get in ipairs(getters) do
        local t = frames.asRegion(errors.tryMethod(b, get))
        if t then
            t:SetAlpha(0)
        end
    end
end

--------------------------------------------------------------------------------
-- The Character tab
--------------------------------------------------------------------------------

local function alphaRegions(f: Frame?, keep: Region?)
    if not f then
        return
    end
    for _, r in ipairs({ f:GetRegions() }) do
        if r ~= keep then
            r:SetAlpha(0)
        end
    end
end

-- "Level 21 · Undead · Paladin" (an unknown level: "?").
local function identityLine(level: number?, race: string?, className: string?): string
    local parts: string[] = { "Level " .. (level or "?") }
    if race then
        parts[#parts + 1] = race
    end
    if className then
        parts[#parts + 1] = className
    end
    return table.concat(parts, " · ")
end

-- A hunter's pet's mood (C_PetInfo.GetPetHappiness: 1 to 3) by its colour,
-- as on the pet frame (Units/UnitFrames).
local MOODS: { [number]: string } = { [1] = "ember-text", [2] = "amber", [3] = "fel" }

-- The pet's line: "Level 19 · Wolf · Loyalty Level 2 · Happy", its mood in
-- the mood's colour (the game's own word: PET_HAPPINESS1-3).
local function petLine(level: number?, family: string?, loyalty: string?, mood: number?): string
    local line = identityLine(level, family, loyalty)
    local token = mood and MOODS[mood]
    local word = mood and tbl.field(_G, "PET_HAPPINESS" .. mood)
    local colors: { [string]: Color } = T.color
    local color = token and colors[token]
    if type(word) == "string" and word ~= "" and color then
        line = line .. " · |cff" .. color.hex .. word .. "|r"
    end
    return line
end

-- The arrows beside the slots in Sets mode (each slot's popout button): a
-- gilt chevron pointing away from the slot.
local LEFT_COLUMN: { [string]: boolean } = {
    Head = true,
    Neck = true,
    Shoulder = true,
    Back = true,
    Chest = true,
    Shirt = true,
    Tabard = true,
    Wrist = true,
}
local WEAPONS: { [string]: boolean } = { MainHand = true, SecondaryHand = true, Ranged = true }
local GLYPH_DIR = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"

-- "◆ Suther   Level 21 · Undead · Paladin", over the left pane.
class Identity extends Frame
    readonly diamond: Texture
    readonly name: Text
    readonly line: Text

    constructor(host: Frame)
        super(nil, host)
        self:SetPoint("TOPLEFT", S["space-5"], -S["space-3"])
        self:SetPoint("TOPRIGHT", -44, -S["space-3"])
        self:SetHeight(T.type["unit-name-lg"].lineHeight)
        self:SetFrameLevel(host:GetFrameLevel() + 520)
        -- the class diamond, centred on the name's line
        self.diamond = UI.Diamond(self, 7, "ink", "OVERLAY")
        self.diamond:SetPoint("CENTER", self, "LEFT", 4, 0)
        self.name = UI.Text(self, "unit-name-lg", "ink")
        self.name:SetPoint("LEFT", 8 + S["space-3"], 0)
        self.line = UI.Text(self, "caption", "ink-muted")
        self.line:SetPoint("LEFT", self.name, "RIGHT", S["space-4"], -1)
    end
end

--------------------------------------------------------------------------------
-- Durability (the Durability module's "On your gear", design board
-- "Durability" C): a 3 px bar inside each gear slot's foot (ink-muted, amber
-- with the percent at or below the line, all ember with "0%" and the icon
-- dimmed once broken; none on pieces that never wear), and the Gear
-- category after the stats: the average, the lowest piece, the damaged ones.
--------------------------------------------------------------------------------

-- A slot's bar for its piece: broken (all ember, no fill), the fill's token
-- and width (px of the bar), the percent shown and its colour.
export type WearView = { broken: boolean, fill?: string, width?: number, pct?: string, pctColor: string }

-- (nil: no bar)
export function wearView(p: DurabilityPiece?, gearBars: string?, barW: number?): WearView?
    if not (p ~= nil and (gearBars == "always" or p.state ~= "fine")) then
        return nil
    end
    local w = (secret.readable(barW) and barW and barW > 0) and barW or 30
    local broken = p.state == "broken"
    return {
        broken = broken,
        fill = not broken and (p.state == "damaged" and "amber" or "ink-muted") or nil,
        width = not broken and math.max(1, w * p.percent / 100) or nil,
        pct = p.state ~= "fine" and (p.percent .. "%") or nil,
        pctColor = broken and "ember-text" or "amber",
    }
end

-- The Gear category's durability rows, under the item level: the average,
-- the lowest piece, the damaged ones.
local WEAR_ROWS = { "Durability", "Lowest", "Damaged" }

-- The Lowest, Damaged and Average values for a reading.
export function wearRows(d: DurabilityInfo): (string, string, string)
    local colors: { [string]: Color } = T.color
    local function c(token: string, text: string): string
        return "|cff" .. assert(colors[token]).hex .. text .. "|r"
    end
    local low = assert(d.lowest)
    local lowest = low.label ..
        " · " ..
            (low.state == "broken" and c("ember-text", "Broken") or
                low.state == "damaged" and c("amber", low.percent .. "%") or
                (low.percent .. "%"))
    local worn: string[] = {}
    for _, p in ipairs(d.pieces) do
        if p.state == "damaged" then
            worn[#worn + 1] = p.label .. " " .. p.percent .. "%"
        end
    end
    return lowest,
        #worn > 0 and c("amber", table.concat(worn, " · ")) or c("ink-faint", "None"),
        (d.average or 0) .. "%"
end

-- Your average item level (asked for 2026-11-09), as the game's own stat
-- reads it: what you wear (at least the game's minimum), and over all you
-- carry, whole numbers. nil when unreadable. (Blizzard's General list has the
-- stat but no row for it; a row added there tainted its update.)
export function itemLevels(): (number?, number?)
    local ok, all, equipped = pcall(GetAverageItemLevel)
    if not ok or not secret.readable(all) or not secret.readable(equipped) then
        return nil, nil
    end
    local okMin, least = pcall(C_PaperDollInfo.GetMinItemLevel)
    local floor = okMin and secret.readable(least) and tonumber(least) or 0
    local worn, carried = tonumber(equipped), tonumber(all)
    if not worn or not carried then
        return nil, nil
    end
    return math.floor(math.max(floor, worn)), math.floor(carried)
end

-- A gear slot's wear bar and percent, over the slot.
class WearOverlay extends Frame
    readonly bar: Frame
    readonly bg: Texture
    readonly fill: Texture
    readonly pct: Text

    constructor(b: Frame)
        super(nil, b)
        self:SetAllPoints()
        self:SetFrameLevel(b:GetFrameLevel() + 3)
        self.bar = CreateFrame("Frame", nil, self)
        self.bar:SetPoint("BOTTOMLEFT", 3, 3)
        self.bar:SetPoint("BOTTOMRIGHT", -3, 3)
        self.bar:SetHeight(3)
        self.bg = self.bar:CreateTexture(nil, "BACKGROUND")
        self.bg:SetAllPoints()
        self.fill = self.bar:CreateTexture(nil, "ARTWORK")
        self.fill:SetPoint("TOPLEFT")
        self.fill:SetPoint("BOTTOMLEFT")
        self.pct = UI.Text(self, "micro", "amber")
        self.pct:SetPoint("TOPLEFT", 3, -2)
        self.pct:SetShadowed(true)
        self:Hide()
    end
end

-- The Gear category, before Blizzard's stat categories and scrolling with
-- them (asked for 2026-11-09, in place of a block under the stats): a head
-- and rows as SuuUI skins Blizzard's (SkinStatRow): your item level
-- (hovered: the average over all you carry), then, while the Durability
-- module shows wear on your gear, the average, the lowest piece and the
-- damaged ones.
-- Blizzard's rows' heights (CharacterStatFrameCategoryTemplate,
-- CharacterStatFrameScrollBoxBaseElementTemplate).
local GEAR_HEAD_H, GEAR_ROW_H = 40, 23
-- Blizzard's list's height in SuuUI's area: more than all its rows (a
-- player's are about 1000 px), so it shows them all and never scrolls.
local STATS_BOX_H = 3000

-- A stat row in SuuUI's skin: a gilt-faint rule on top, the label ink-muted
-- left, the value right (where Blizzard's are).
class GearRow extends Frame
    readonly label: Text
    readonly value: Text

    constructor(parent: Frame, text: string)
        super(nil, parent)
        self:SetHeight(GEAR_ROW_H)
        local rule = self:CreateTexture(nil, "ARTWORK")
        UI.PaintFill(rule, "gilt-faint")
        rule:SetHeight(1)
        rule:SetPoint("TOPLEFT")
        rule:SetPoint("TOPRIGHT")
        self.label = UI.Text(self, "body", "ink-muted")
        self.label:SetValue(text)
        self.label:SetPoint("LEFT", 11, 0)
        self.value = UI.Text(self, "numeric", "ink")
        self.value:SetJustifyH("RIGHT")
        self.value:SetWordWrap(false)
        self.value:SetPoint("RIGHT", -8, 0)
        self.value:SetPoint("LEFT", self.label, "RIGHT", S["space-3"], 0)
    end
end

class Gear extends Frame
    readonly head: Text
    readonly level: GearRow
    readonly rows: GearRow[] = {}
    -- what you wear and the average over all you carry, for the tooltip
    worn: number? = nil
    carried: number? = nil
    -- its height as laid out
    height: number = 0

    constructor(parent: Frame)
        super(nil, parent)
        self.head = UI.Text(self, "header", "gilt-text")
        self.head:SetValue("Gear")
        self.head:SetPoint("CENTER", self, "TOP", 0, 1 - GEAR_HEAD_H / 2)
        self.level = GearRow.new(self, "Item level")
        self.level:EnableMouse(true)
        UI.AttachTooltip(self.level, function(): TooltipData
            return {
                title = "Item level " .. (self.worn and tostring(self.worn) or "–"),
                lines = { { "All your items", self.carried and tostring(self.carried) or "–" } },
                description = "The average item level of the gear you wear. All your items counts the best pieces in your bags too.",
            }
        end)
        for i, label in ipairs(WEAR_ROWS) do
            self.rows[i] = GearRow.new(self, label)
        end
        self:Hide()
    end

    -- The head, the item level, the durability rows while `wear`: stacked as
    -- Blizzard stacks its rows. Its height.
    function Layout(wear: boolean): number
        local y = GEAR_HEAD_H
        local function place(r: GearRow)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -y)
            r:SetPoint("TOPRIGHT", 0, -y)
            y = y + GEAR_ROW_H
        end
        place(self.level)
        for _, r in ipairs(self.rows) do
            r:SetShown(wear)
            if wear then
                place(r)
            end
        end
        self:SetHeight(y)
        self.height = y
        return y
    end
end

--------------------------------------------------------------------------------
-- Stats: a StatList
--------------------------------------------------------------------------------

local function isGreen(r: number?, g: number, b: number): boolean?
    return r and g > 0.7 and r < 0.5 and b < 0.5
end
local function isRed(r: number?, g: number, b: number): boolean?
    return r and r > 0.8 and g < 0.4 and b < 0.4
end

-- A stat value's colour from Blizzard's: green (a bonus) fel, red (a
-- malus) ember, the rest ink.
export function statColor(r: number?, g: number, b: number): string
    if isGreen(r, g, b) then
        return "fel"
    end
    if isRed(r, g, b) then
        return "ember-text"
    end
    return "ink"
end

--------------------------------------------------------------------------------
-- The side buttons: Stats | Titles | Sets as a segmented row
--------------------------------------------------------------------------------

-- Blizzard's second side button is the equipment sets, the third the
-- titles (found in game); shown as Stats | Sets | Titles.
local SIDE = { { tab = 1, label = "Stats" }, { tab = 2, label = "Sets" }, { tab = 3, label = "Titles" } }

-- The row, its buttons (Blizzard's, with SuuUI's labels) and the marker.
export type SideTab = { button: Button, label: Text }
export type Sidebar = { row: Frame, tabs: SideTab[], marker: TabMarker }

--------------------------------------------------------------------------------
-- The other tabs, the titles and the equipment sets: Blizzard's lists and
-- detail panes through UI.Reskin (rows, category bars, bars, check buttons)
--------------------------------------------------------------------------------

local PANES = { "ReputationFrame", "SkillsFrame", "PVPRankFrame", "TokenFrame", "StatisticsFrame" }
-- a detail pane's rows that wrap (their text measured again)
local SIDE_ROWS = { "CharacterFrameSidePaneWrappedRowTemplate", "CharacterFrameSidePaneIconRowTemplate" }

class CharacterWindowModule extends Module<typeof(DEFAULTS)>
    chrome: WindowChrome? = nil
    flyoutSkinned: boolean? = nil
    -- the flyout's item buttons, the glass behind them
    readonly flyoutSkins: { [Frame]: ItemSlotSkin } = {}
    readonly flyoutGlass: { [Frame]: Texture } = {}
    identity: Identity? = nil
    modelBox: Frame? = nil
    -- the Pet tab (SuuUI's own button in the tab row), while choosing it
    petTab: Button? = nil
    choosingPet: boolean = false
    placingSide: boolean = false
    sideIndex: number? = nil
    sidebar: Sidebar? = nil
    readonly slotSkins: { [Frame]: ItemSlotSkin } = {}
    readonly slotUpdates: (() -> ())[] = {}
    readonly wear: { [Frame]: WearOverlay } = {}
    -- the stats' scroll area (Blizzard's list and the Gear category in it),
    -- Blizzard's list, the category
    statsScroll: ScrollArea? = nil
    statsBox: Frame? = nil
    gear: Gear? = nil
    -- where Blizzard's list starts in the area (under the category)
    statsTop: number? = nil
    -- a stat row's rule (stat rows have it shown, heads hidden)
    readonly statRules: { [Frame]: Texture } = {}
    -- the right pane toggle's chevron
    toggleChevron: Texture? = nil

    constructor()
        super({
            id = "character",
            name = "Character window",
            description = "The Character window (C) and its tabs in SuuUI's look.",
            api = "0.12",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function Skin()
        local cf = frame("CharacterFrame")
        if not cf or self.chrome then
            return
        end
        -- the panes' own backgrounds (the first texture of each host)
        local hide: { [number]: unknown } = {
            tbl.field(cf, "NineSlice"),
            tbl.field(cf, "PortraitContainer"),
            tbl.field(cf, "TitleContainer"),
        }
        for _, name in ipairs({ "CharacterFrameLeftPaneHost", "CharacterFrameRightPaneHost" }) do
            local host = frame(name)
            if host then
                for _, r in ipairs({ host:GetRegions() }) do
                    hide[#hide + 1] = r
                end
                -- the right pane's divider strip
                for _, c in ipairs(frames.children(host)) do
                    hide[#hide + 1] = c
                end
            end
        end
        local chrome = UI.SkinWindow(cf, {
            title = "Character",
            icon = "person",
            binding = "TOGGLECHARACTER0",
            close = frames.asButton(tbl.field(_G, "CharacterFrameCloseButton")),
            hide = hide,
            topInset = 20,
            under = "microMenu",
        })
        self.chrome = chrome
        local list: SkinTab[] = {}
        for _, t in ipairs(TABS) do
            local button = frame("CharacterFrameModeTab" .. t.index)
            if button then
                local character = t.pane == "PaperDollFrame"
                list[#list + 1] = {
                    button = button,
                    label = t.label,
                    short = t.short,
                    selected = function(): boolean
                        -- (the Character tab: not while the pet shows)
                        if character and self:PetMode() then
                            return false
                        end
                        local sel = frames.asRegion(tbl.field(button, "SelectedTexture"))
                        if sel then
                            return sel:IsShown()
                        end
                        return shown(t.pane)
                    end,
                }
                -- the Pet tab right after it, while there's a pet
                if character then
                    list[#list + 1] = {
                        button = self:BuildPetTab(cf),
                        label = "Pet",
                        selected = function(): boolean
                            return self:PetMode()
                        end,
                        hidden = function(): boolean
                            return not HasPetUI()
                        end,
                    }
                end
            end
        end
        chrome:SetTabs(list)
        -- a tab switched: the selected look follows. The Character tab chosen
        -- while the pet shows (Blizzard's click finds its pane shown and does
        -- nothing): the stats again.
        hook("ToggleCharacter", function(tab: unknown)
            if tab == "PaperDollFrame" and not self.choosingPet and cf:IsShown() and self:PetMode() then
                self:SetSidebar(1)
            end
            chrome:UpdateTabs()
        end)
        hookScript(cf, "OnShow", function()
            chrome:LayoutTabs()
            self:UpdateIdentity()
        end)
        -- closed: Blizzard forgets the side pane, the pet's view is over
        hookScript(cf, "OnHide", function()
            self:UpdatePetView()
        end)
        self:SkinPaperDoll()
    end

    function BuildIdentity()
        local host = frame("CharacterFrameLeftPaneHost")
        if not host or self.identity then
            return
        end
        local id = Identity.new(host)
        self.identity = id
        -- Blizzard's strip and its "Level 21 Paladin"
        local paperDoll = frame("PaperDollFrame")
        local strip = frames.asRegion(tbl.field(paperDoll, "TopBackgroundStripHost"))
        if strip then
            strip:SetAlpha(0)
        end
        for _, name in ipairs({ "PaperDollLevelInfo", "PaperDollPetLevelInfo" }) do
            local r = frames.asRegion(tbl.field(_G, name))
            if r then
                r:SetAlpha(0)
            end
        end
        -- only on the Character tab
        self:FollowCharacterTab(id, function()
            self:UpdateIdentity()
        end)
    end

    -- A frame shown only with the Character tab's pane. After a reload the
    -- pane counts as shown in the closed window; U picks Reputation before the
    -- window opens, so the pane is hidden unseen and sends no OnHide: the
    -- model's box and the name line stayed over the Reputation tab (found in
    -- game). So looked at again when the window opens and a tab is chosen,
    -- not only on the pane's OnShow and OnHide. `onShown`: run when it shows.
    function FollowCharacterTab(f: Frame, onShown: (() -> ())?)
        local paperDoll = frame("PaperDollFrame")
        if not paperDoll then
            return
        end
        local function sync()
            local on = paperDoll:IsShown()
            f:SetShown(on)
            if on and onShown then
                onShown()
            end
        end
        hookScript(paperDoll, "OnShow", sync)
        hookScript(paperDoll, "OnHide", sync)
        local cf = frame("CharacterFrame")
        if cf then
            hookScript(cf, "OnShow", sync)
        end
        hook("ToggleCharacter", sync)
        sync()
    end

    function UpdateIdentity()
        local id = self.identity
        if not id then
            return
        end
        local className, class = UnitClass("player")
        local token = class and not isSecret(class) and "class-" .. (class :: string):lower()
        local colors: { [string]: Color } = T.color
        if token and colors[token] then
            UI.Paint(id.diamond, token)
        end
        -- the pet's (Blizzard's "Level 19 Wolf (Loyalty Level 2)" out of
        -- sight): "Fang   Level 19 · Wolf · Loyalty Level 2 · Happy", a
        -- hunter's pet's mood in its colour
        if self:PetMode() then
            local petName = UnitName("pet")
            local family = UnitCreatureFamily("pet")
            local loyalty = C_PetInfo and C_PetInfo.GetPetLoyalty and C_PetInfo.GetPetLoyalty()
            local mood = C_PetInfo and C_PetInfo.GetPetHappiness and C_PetInfo.GetPetHappiness()
            id.name:SetValue(type(petName) == "string" and not isSecret(petName) and petName or "")
            id.line:SetValue(
                petLine(
                    secret.asNumber(UnitLevel("pet")),
                    type(family) == "string" and not isSecret(family) and family ~= "" and family or nil,
                    type(loyalty) == "string" and not isSecret(loyalty) and loyalty ~= "" and loyalty or nil,
                    type(mood) == "number" and not isSecret(mood) and mood or nil
                )
            )
            return
        end
        local name = SuuUI.FullName("player")
        id.name:SetValue(type(name) == "string" and not isSecret(name) and name or "")
        local race = UnitRace("player")
        id.line:SetValue(
            identityLine(
                secret.asNumber(UnitLevel("player")),
                type(race) == "string" and not isSecret(race) and race or nil,
                type(className) == "string" and not isSecret(className) and className or nil
            )
        )
    end

    -- An equipment slot in SuuUI's look; its border follows what Blizzard shows.
    function SkinSlot(b: Frame)
        if self.slotSkins[b] then
            return
        end
        local skin = UI.SkinItemSlot(b)
        self.slotSkins[b] = skin
        local updating = false
        local function update()
            if updating then
                return
            end
            updating = true
            local id = b:GetID()
            local link = GetInventoryItemLink("player", id)
            local q = GetInventoryItemQuality("player", id)
            local icon = skin.icon:GetTexture()
            -- a broken piece dimmed (the Durability module's "On your gear")
            local wear = self:WearOf(id)
            skin:SetItem({
                icon = icon,
                quality = (secret.readable(q) and q and QUALITY[q]) or "common",
                dim = not link or (wear ~= nil and wear.state == "broken"),
            })
            updating = false
        end
        hook(skin.icon, "SetTexture", update)
        hookScript(b, "OnShow", update)
        self.slotUpdates[#self.slotUpdates + 1] = update
        self:WearBar(b)
        update()
    end

    function SkinPopout(slotName: string, b: Frame)
        local p = frames.asButton(tbl.field(b, "popoutButton"))
        if not p or not once(p) then
            return
        end
        local glyph = p:CreateTexture(nil, "OVERLAY", nil, 7)
        glyph:SetSize(12, 12)
        glyph:SetPoint("CENTER")
        UI.Paint(glyph, "gilt-text")
        if WEAPONS[slotName] then
            glyph:SetTexture(GLYPH_DIR .. "chevronDown.tga")
            glyph:SetRotation(math.pi)
        else
            glyph:SetTexture(GLYPH_DIR .. (LEFT_COLUMN[slotName] and "chevronRight" or "chevronLeft") .. ".tga")
        end
        local function hideArt()
            hideButtonArt(p, { "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture", "GetDisabledTexture" })
            for _, r in ipairs({ p:GetRegions() }) do
                if r ~= glyph and r:GetObjectType() == "Texture" then
                    r:SetAlpha(0)
                end
            end
        end
        hideArt()
        hookScript(p, "OnShow", hideArt)
        hookScript(p, "OnEnter", function()
            UI.Paint(glyph, "gilt")
        end)
        hookScript(p, "OnLeave", function()
            UI.Paint(glyph, "gilt-text")
        end)
    end

    -- The flyout of items for a slot: glass behind, SuuUI item slots.
    function SkinFlyout()
        local fly = frame("EquipmentFlyoutFrame")
        if not fly or self.flyoutSkinned then
            return
        end
        self.flyoutSkinned = true
        local function skinButtons()
            local holder = frames.asFrame(tbl.field(fly, "buttonFrame")) or fly
            local glass = self.flyoutGlass[holder]
            for _, r in ipairs({ holder:GetRegions() }) do
                if r:GetObjectType() == "Texture" and r ~= glass then
                    r:SetAlpha(0)
                end
            end
            -- (Blizzard's highlight is a texture: no regions of its own)
            local highlight = frames.asRegion(tbl.field(fly, "Highlight"))
            if highlight then
                highlight:SetAlpha(0)
            end
            if not glass then
                glass = holder:CreateTexture(nil, "BACKGROUND", nil, -8)
                self.flyoutGlass[holder] = glass
                UI.PaintFill(glass, "surface-glass")
                glass:SetAllPoints()
                UI.Border(holder, "gilt-line")
            end
            for i = 1, 40 do
                local b = frame("EquipmentFlyoutFrameButton" .. i)
                if not b then
                    break
                end
                local skin = self.flyoutSkins[b]
                if not skin then
                    skin = UI.SkinItemSlot(b)
                    self.flyoutSkins[b] = skin
                end
                local icon = skin.icon
                local art = icon and icon:GetTexture()
                skin:SetItem(art and { icon = art } or nil)
            end
        end
        hookScript(fly, "OnShow", function()
            after(0, skinButtons)
        end)
        if type(tbl.field(_G, "EquipmentFlyout_DisplayButton")) == "function" then
            hook("EquipmentFlyout_DisplayButton", function()
                after(0, skinButtons)
            end)
        end
    end

    -- The new-set popup (name, icon, Okay, Cancel): glass in a gilt edge, its
    -- input, buttons and scrollbar through UI.Reskin; the icons stay.
    function SkinSetPopup()
        local pop = frame("GearManagerPopupFrame") or
            frames.asFrame(tbl.field(frame("PaperDollFrame"), "GearManagerPopupFrame"))
        if not pop or not once(pop) then
            return
        end
        local function art(f: Frame?)
            if not f then
                return
            end
            local nine = frames.asRegion(tbl.field(f, "NineSlice"))
            if nine then
                nine:SetAlpha(0)
            end
            for _, r in ipairs({ f:GetRegions() }) do
                if r:GetObjectType() == "Texture" then
                    r:SetAlpha(0)
                end
            end
        end
        local box = frames.asFrame(tbl.field(pop, "BorderBox"))
        art(pop)
        art(box)
        if box then
            for _, c in ipairs(frames.children(box)) do
                if c:GetObjectType() == "Frame" then
                    art(c)
                end
            end
        end
        local bg = pop:CreateTexture(nil, "BACKGROUND", nil, -8)
        UI.PaintFill(bg, "surface-glass")
        bg:SetAllPoints()
        local edge = CreateFrame("Frame", nil, pop)
        edge:SetAllPoints()
        edge:EnableMouse(false)
        UI.Border(edge, "gilt-line")
        local jewel = UI.Diamond(edge, 7, "gilt")
        jewel:SetPoint("CENTER", pop, "TOPLEFT", 0, 0)
        -- the chosen icon (top right) and the grid's icons: SuuUI's icon buttons
        -- (the chosen icon: whichever button with an Icon sits outside the grid)
        local grid = frames.asFrame(tbl.field(pop, "IconSelector"))
        local function findChosen(f: Frame, depth: number): Frame?
            if depth > 4 or f == grid then
                return nil
            end
            if f ~= pop and f:GetObjectType() == "Button" and (tbl.field(f, "Icon") or tbl.field(f, "icon")) then
                return f
            end
            for _, c in ipairs(frames.children(f)) do
                local hit = findChosen(c, depth + 1)
                if hit then
                    return hit
                end
            end
            return nil
        end
        local chosen: Frame? = nil
        local function icons()
            chosen = chosen or findChosen(pop, 0)
            if chosen then
                UI.ReskinIconButton(chosen)
            end
            local sb = grid and (tbl.field(grid, "ScrollBox") or grid)
            -- (no view yet: the box updates as it is sized, before its list is set)
            if sb and tbl.field(sb, "ForEachFrame") and
                (not tbl.field(sb, "GetView") or errors.tryMethod(sb, "GetView")) then
                errors.tryMethod(sb, "ForEachFrame", function(b: unknown)
                    UI.ReskinIconButton(b)
                end)
            end
        end
        local sb = tbl.field(grid, "ScrollBox")
        if type(sb) == "table" then
            if tbl.field(sb, "Update") then
                hook(sb, "Update", icons)
            end
            local changed = tbl.field(tbl.field(sb, "Event"), "OnDataRangeChanged")
            if tbl.field(sb, "RegisterCallback") and changed then
                errors.tryMethod(sb, "RegisterCallback", changed, icons, self)
            end
        end
        -- lined up with the window: its header's top, its bottom, space-4 beside it
        local cf = frame("CharacterFrame")
        local placing = false
        local function place()
            if placing or not cf then
                return
            end
            placing = true
            pop:ClearAllPoints()
            pop:SetPoint("TOPLEFT", cf, "TOPRIGHT", S["space-4"], UI.WINDOW_HEAD_H - 20)
            pop:SetPoint("BOTTOMLEFT", cf, "BOTTOMRIGHT", S["space-4"], 0)
            placing = false
        end
        hook(pop, "SetPoint", function()
            if not placing then
                after(0, place)
            end
        end)
        -- the icon grid ends above Okay and Cancel (Blizzard's art hid the overlap)
        local okay = frames.asRegion(tbl.field(box, "OkayButton")) or frames.asRegion(tbl.field(box, "OkButton"))
        local function fit()
            if grid and okay then
                local top, bottom = secret.asNumber(okay:GetTop()), secret.asNumber(pop:GetBottom())
                grid:SetPoint(
                    "BOTTOMRIGHT",
                    pop,
                    "BOTTOMRIGHT",
                    -S["space-5"],
                    (top and bottom) and (top - bottom + S["space-4"]) or 44
                )
            end
        end
        hookScript(pop, "OnShow", function()
            place()
            after(0, function()
                UI.Reskin(pop)
                fit()
                icons()
            end)
        end)
    end

    function UpdateSlots()
        for _, u in ipairs(self.slotUpdates) do
            u()
        end
    end

    -- The model in a gilt-faint box between the slot columns, without the
    -- zoom and turn buttons (drag the model to turn it).
    function SkinModel()
        local scene = frame("CharacterModelScene")
        local head, hands = frame("CharacterHeadSlot"), frame("CharacterHandsSlot")
        if not (scene and head and hands) or self.modelBox then
            return
        end
        local box = CreateFrame("Frame", nil, frame("CharacterFrameLeftPaneHost"))
        box:SetPoint("TOPLEFT", head, "TOPRIGHT", S["space-4"], 0)
        box:SetPoint("BOTTOMRIGHT", frame("CharacterTrinket1Slot") or hands, "BOTTOMLEFT", -S["space-4"], 0)
        box:SetFrameLevel(math.max(1, scene:GetFrameLevel() - 1))
        UI.Fill(box, "surface-sunk"):SetAllPoints()
        UI.Border(box, "gilt-faint")
        self.modelBox = box
        local controls = frames.asFrame(tbl.field(scene, "ControlFrame"))
        if controls then
            controls:SetAlpha(0)
            controls:EnableMouse(false)
            for _, c in ipairs(frames.children(controls)) do
                c:EnableMouse(false)
            end
        end
        self:FollowCharacterTab(box)
    end

    -- A slot's piece as SuuUI.Durability() reads it, while the gear part is on.
    function WearOf(slot: number): (DurabilityPiece?, DurabilityInfo?)
        local d = SuuUI.Durability()
        if not (d and d.parts.gear) then
            return nil, d
        end
        return d.bySlot[slot], d
    end

    function WearBar(b: Frame)
        if self.wear[b] then
            return
        end
        self.wear[b] = WearOverlay.new(b)
    end

    function UpdateWear()
        for b, o in pairs(self.wear) do
            local p, d = self:WearOf(b:GetID())
            local v = wearView(p, p and d and d.parts.gearBars, p and o.bar:GetWidth())
            o:SetShown(v ~= nil)
            if p and v then
                if v.broken then
                    UI.PaintFill(o.bg, "ember")
                    o.fill:Hide()
                else
                    UI.PaintFill(o.bg, "on-signal", 0.7)
                    UI.PaintFill(o.fill, assert(v.fill))
                    o.fill:SetWidth(assert(v.width))
                    o.fill:Show()
                end
                o.pct:SetColor(v.pctColor)
                o.pct:SetValue(p.percent .. "%")
                o.pct:SetShown(v.pct ~= nil)
            end
        end
        self:UpdateGear()
        self:UpdateSlots()
    end

    -- The stats scroll as SuuUI's area, so the Gear category can scroll with
    -- Blizzard's categories. Blizzard's list (its ScrollBox) goes into the
    -- area, taller than all its rows ever are, so it never scrolls itself
    -- and makes a row for every stat (it makes rows for what fits); it
    -- hangs under the category, and the area scrolls both.
    -- Nothing of Blizzard's is called or written: Blizzard's own code fills
    -- the list (a row or category added there tainted its update, and its
    -- health and power bars then failed on secret values); SuuUI reads the
    -- list's height from its view after each update. The box is resized
    -- here once; its own size handler runs in the client's layout pass.
    -- The category comes first (asked for 2026-11-09), the list under it:
    -- the list moves only when the category's height changes.
    function BuildGear()
        local pane = frame("CharacterStatsPaneScrollBox")
        local box = frames.asFrame(tbl.field(pane, "ScrollBox"))
        if not (pane and box) or self.gear then
            return
        end
        local scroll = UI.ScrollArea(pane, S["space-2"])
        scroll:SetPoint("TOPLEFT", 10, -8)
        scroll:SetPoint("BOTTOMRIGHT", -(14 + S["space-2"]), 8)
        local child = scroll.child
        scroll:HookScript("OnSizeChanged", function(_: Frame, w: number)
            child:SetWidth(w)
        end)
        box:SetParent(child)
        box:ClearAllPoints()
        box:SetPoint("TOPLEFT", child, "TOPLEFT")
        box:SetPoint("TOPRIGHT", child, "TOPRIGHT")
        box:SetHeight(STATS_BOX_H)
        -- the wheel over Blizzard's rows scrolls the area (the box has
        -- nothing to scroll)
        box:EnableMouseWheel(false)
        local bar = frames.asFrame(tbl.field(pane, "ScrollBar"))
        if bar then
            bar:Hide()
        end
        local gear = Gear.new(child)
        gear:SetFrameLevel(box:GetFrameLevel() + 20)
        gear:SetPoint("TOPLEFT", child, "TOPLEFT")
        gear:SetPoint("TOPRIGHT", child, "TOPRIGHT")
        self.statsScroll, self.statsBox, self.gear = scroll, box, gear
        -- after each of the list's updates: its height read again
        -- the item level read again as the stats show
        hookScript(pane, "OnShow", function()
            self:UpdateGear()
        end)
        local list = tbl.field(pane, "ScrollBox")
        if tbl.field(list, "Update") then
            hook(list, "Update", function()
                self:FitGear()
            end)
        end
        self:FitGear()
    end

    -- The category on top, Blizzard's list under it (moved only when the
    -- category's height changed), the area's range both: the list's height
    -- its rows and padding, as its view counted them in its last update
    -- (read, never asked for: calling its methods runs them tainted).
    function FitGear()
        local scroll, gear, box = self.statsScroll, self.gear, self.statsBox
        if not (scroll and gear and box) then
            return
        end
        local extent = secret.asNumber(tbl.field(box, "view", "extent")) or 0
        local child = scroll.child
        local top = gear:IsShown() and gear.height or 0
        if self.statsTop ~= top then
            self.statsTop = top
            box:ClearAllPoints()
            box:SetPoint("TOPLEFT", child, "TOPLEFT", 0, -top)
            box:SetPoint("TOPRIGHT", child, "TOPRIGHT", 0, -top)
        end
        child:SetHeight(math.max(1, top + extent))
    end

    function UpdateGear()
        local gear = self.gear
        if not gear then
            return
        end
        local d = SuuUI.Durability()
        local wear = d ~= nil and d.parts.gear == true and d.lowest ~= nil
        local worn, carried = itemLevels()
        if not wear and not worn then
            gear:Hide()
            self:FitGear()
            return
        end
        gear:Layout(wear)
        gear:Show()
        gear.level.value:SetValue(worn and tostring(worn) or "–")
        gear.worn, gear.carried = worn, carried
        if d and wear then
            local lowest, damaged, average = wearRows(d)
            gear.rows[1].value:SetValue(average)
            gear.rows[2].value:SetValue(lowest)
            gear.rows[3].value:SetValue(damaged)
        end
        self:FitGear()
    end

    -- A row of the stats pane: a category head (one text, a banner) or a stat
    -- (its label left, its value right).
    function SkinStatRow(row: Frame)
        local texts: FontString[] = {}
        -- a small square texture is an icon (a resistance's school): kept, the
        -- rest (banners, backgrounds) away
        local function texture(r: Texture)
            local atlasName = errors.tryMethod(r, "GetAtlas")
            local atlas = (type(atlasName) == "string" and atlasName or ""):lower()
            local w, h = r:GetSize()
            local isIcon = errors.tryMethod(r, "GetParentKey") == "Icon" or atlas:find("resistance") or
                atlas:find("icon") or
                (w and h and w > 0 and w <= 24 and math.abs(w - h) < 3)
            if isIcon then
                -- (the resistances' are 33px in a 23px row: 18px)
                r:SetAlpha(1)
                if w and w > 20 then
                    r:SetSize(18, 18)
                end
            else
                r:SetAlpha(0)
            end
        end
        local function take(r: Region)
            local tex = frames.asTexture(r)
            local fs = frames.asFontString(r)
            if tex then
                texture(tex)
            elseif fs and fs:IsShown() then
                texts[#texts + 1] = fs
            end
        end
        for _, r in ipairs({ row:GetRegions() }) do
            take(r)
        end
        for _, c in ipairs(frames.children(row)) do
            for _, r in ipairs({ c:GetRegions() }) do
                take(r)
            end
        end
        local rule = self.statRules[row]
        if not rule then
            rule = row:CreateTexture(nil, "ARTWORK")
            self.statRules[row] = rule
            UI.PaintFill(rule, "gilt-faint")
            rule:SetHeight(1)
            rule:SetPoint("TOPLEFT")
            rule:SetPoint("TOPRIGHT")
        end
        local head = #texts == 1 or (secret.asNumber(row:GetHeight()) or 0) > 30
        rule:SetShown(not head)
        if head then
            for _, t in ipairs(texts) do
                SuuUI.Fonts.Apply(t, "header")
                UI.Paint(t, "gilt-text")
                t:SetShadowOffset(0, 0)
            end
            return
        end
        -- the label and the value: Blizzard's own keys, else left to right
        local label, value = frames.asFontString(tbl.field(row, "Label")), frames.asFontString(tbl.field(row, "Value"))
        if not (label and value) then
            local readable = true
            for _, t in ipairs(texts) do
                if secret.asNumber(t:GetLeft()) == nil then
                    readable = false
                end
            end
            if readable then
                table.sort(texts, function(a: FontString, b: FontString): boolean
                    return assert(a:GetLeft()) < assert(b:GetLeft())
                end)
            end
            label, value = texts[1], texts[#texts]
        end
        if label then
            SuuUI.Fonts.Apply(label, "body")
            UI.Paint(label, "ink-muted")
            label:SetShadowOffset(0, 0)
        end
        if value and value ~= label then
            local r, g, b = value:GetTextColor()
            SuuUI.Fonts.Apply(value, "numeric")
            UI.Paint(value, statColor(r, g, b))
            value:SetShadowOffset(0, 0)
        end
    end

    function SkinStatsPane()
        for _, name in ipairs({ "CharacterStatsPaneScrollBox", "CharacterStatsPanePetScrollBox" }) do
            local pane = frame(name)
            if pane and once(pane) then
                alphaRegions(pane)
                local box = tbl.field(pane, "ScrollBox")
                if type(box) == "table" then
                    local function skinAll()
                        -- (no view yet: the box updates as it is sized, before its list is set)
                        if tbl.field(box, "ForEachFrame") and tbl.field(box, "GetView") and
                            not errors.tryMethod(box, "GetView") then
                            return
                        end
                        if tbl.field(box, "ForEachFrame") then
                            errors.tryMethod(box, "ForEachFrame", function(row: unknown)
                                local f = frames.asFrame(row)
                                if f then
                                    self:SkinStatRow(f)
                                end
                            end)
                        else
                            local target = frames.asFrame(tbl.field(box, "ScrollTarget"))
                            if target then
                                for _, row in ipairs(frames.children(target)) do
                                    self:SkinStatRow(row)
                                end
                            end
                        end
                    end
                    if tbl.field(box, "Update") then
                        hook(box, "Update", skinAll)
                    end
                    local changed = tbl.field(tbl.field(box, "Event"), "OnDataRangeChanged")
                    if tbl.field(box, "RegisterCallback") and changed then
                        errors.tryMethod(box, "RegisterCallback", changed, skinAll, self)
                    end
                    hookScript(pane, "OnShow", function()
                        after(0, skinAll)
                    end)
                    skinAll()
                end
                self:SkinScrollBar(tbl.field(pane, "ScrollBar"))
            end
        end
    end

    -- Blizzard's thin scrollbar: no track art, a gilt-line thumb.
    function SkinScrollBar(given: unknown)
        local bar = frames.asFrame(given)
        if not bar or not once(bar) then
            return
        end
        local track = frames.asFrame(tbl.field(bar, "Track"))
        if track then
            alphaRegions(track)
            local thumb = frames.asFrame(tbl.field(track, "Thumb"))
            if thumb then
                alphaRegions(thumb)
                local t = thumb:CreateTexture(nil, "OVERLAY")
                UI.PaintFill(t, "gilt-line")
                t:SetPoint("TOP")
                t:SetPoint("BOTTOM")
                t:SetWidth(2)
            end
        end
        for _, key in ipairs({ "Back", "Forward" }) do
            local r = frames.asRegion(tbl.field(bar, key))
            if r then
                r:SetAlpha(0)
            end
        end
    end

    function SkinSidebar()
        local tabs = frame("PaperDollSidebarTabs")
        if not tabs or self.sidebar then
            return
        end
        alphaRegions(tabs)
        local row = CreateFrame("Frame", nil, tabs)
        row:SetHeight(26)
        row:SetPoint("TOPLEFT", S["space-5"], -S["space-4"])
        row:SetPoint("TOPRIGHT", -S["space-5"], -S["space-4"])
        UI.Fill(row, "surface-sunk"):SetAllPoints()
        UI.Border(row, "gilt-line")
        -- the chosen one's fill and edge, gliding to the next (UI.TabMarker)
        local marker = UI.TabMarker(row, { box = { fill = "arcane-soft", border = "arcane" }, level = 1 })
        local sidebar: Sidebar = { row = row, tabs = {}, marker = marker }
        self.sidebar = sidebar
        for _, def in ipairs(SIDE) do
            local b = frames.asButton(tbl.field(_G, "PaperDollSidebarTab" .. def.tab))
            if b then
                -- (UI.Reskin leaves it a button, not a check box)
                leave(b, "check")
                alphaRegions(b)
                local icon = frames.asRegion(tbl.field(b, "Icon"))
                if icon then
                    icon:SetAlpha(0)
                end
                hideButtonArt(b, { "GetNormalTexture", "GetPushedTexture", "GetHighlightTexture", "GetCheckedTexture" })
                local label = UI.Text(b, "label", "ink-muted")
                label:SetPoint("CENTER")
                label:SetValue(def.label)
                b:SetFrameLevel(row:GetFrameLevel() + 2)
                hookScript(b, "OnEnter", function()
                    self:UpdateSidebar(b)
                end)
                hookScript(b, "OnLeave", function()
                    self:UpdateSidebar()
                end)
                sidebar.tabs[#sidebar.tabs + 1] = { button = b, label = label }
            end
        end
        local function layout()
            local n = #sidebar.tabs
            local inner = row:GetWidth() - 6
            if inner <= 0 then
                return
            end
            local each = (inner - (n - 1) * 2) / n
            for i, t in ipairs(sidebar.tabs) do
                self.placingSide = true
                t.button:ClearAllPoints()
                t.button:SetSize(each, 20)
                t.button:SetPoint("TOPLEFT", row, "TOPLEFT", 3 + (i - 1) * (each + 2), -3)
                self.placingSide = false
            end
            marker:Aim()
        end
        row:SetScript("OnSizeChanged", layout)
        for _, t in ipairs(sidebar.tabs) do
            hook(t.button, "SetPoint", function()
                if self.placingSide then
                    return
                end
                after(0, layout)
            end)
        end
        layout()
        hook("PaperDollFrame_SetSidebar", function(_: unknown, index: unknown)
            self.sideIndex = index :: number?
            self:UpdateSidebar()
            self:UpdatePetView()
        end)
        self.sideIndex = 1
        self:UpdateSidebar()
    end

    function UpdateSidebar(hover: Button?)
        local sidebar = self.sidebar
        if not sidebar then
            return
        end
        local chosen: Button? = nil
        for i, t in ipairs(sidebar.tabs) do
            local side = SIDE[i]
            local on = (side and side.tab) == self.sideIndex
            if on then
                chosen = t.button
            end
            t.label:SetColor(on and "arcane" or (t.button == hover and "ink" or "ink-muted"))
        end
        sidebar.marker:SetChosen(chosen)
    end

    ----------------------------------------------------------------------------
    -- The Pet tab: the paper doll's pet view (Blizzard's fourth side pane: the
    -- pet's model, stats and experience) as a tab of the window, shown while
    -- you have a pet; Blizzard's own Pet side button out of sight.
    -- (Its click calls Blizzard's ToggleCharacter and PaperDollFrame_SetSidebar
    -- from SuuUI's code: nothing there is protected, and a closed window drops
    -- the side pane it chose. The other tabs' clicks stay Blizzard's.)
    ----------------------------------------------------------------------------

    function BuildPetTab(cf: Frame): Button
        local b = self.petTab
        if b then
            return b
        end
        b = CreateFrame("Button", nil, cf)
        b:RegisterForClicks("LeftButtonUp")
        b:SetScript("OnClick", function()
            self:ShowPet()
        end)
        b:Hide()
        self.petTab = b
        return b
    end

    -- The paper doll showing the pet (its side pane the pet's).
    function PetMode(): boolean
        local pd, pane = frame("PaperDollFrame"), frame("CharacterStatsPanePetScrollBox")
        return pd ~= nil and pane ~= nil and pd:IsShown() and tbl.field(pd, "currentSideBar") == pane
    end

    -- The pet's view as the game resets the model: in the middle of a switch
    -- to another side pane that pane already shows while the pet's is still
    -- the current one, so any other pane shown says no.
    function PetShowing(): boolean
        if not self:PetMode() then
            return false
        end
        local get = tbl.field(_G, "GetPaperDollSideBarFrame")
        if type(get) ~= "function" then
            return true
        end
        for i = 1, 3 do
            local f = frames.asFrame((get :: (number) -> unknown)(i))
            if f and f:IsShown() then
                return false
            end
        end
        return true
    end

    -- One of the paper doll's side panes (1 the stats, 4 the pet's).
    function SetSidebar(index: number)
        local set = tbl.field(_G, "PaperDollFrame_SetSidebar")
        if type(set) == "function" then
            (set :: (unknown, number) -> ())(tbl.field(_G, "PaperDollSidebarTabs"), index)
        end
    end

    -- The Pet tab chosen: the Character pane, then its pet view. With the
    -- right pane folded away the pet's stats stay hidden (Blizzard shows them
    -- when it opens again).
    function ShowPet()
        if not HasPetUI() then
            return
        end
        local pd = frame("PaperDollFrame")
        if pd and not pd:IsShown() then
            self.choosingPet = true
            ToggleCharacter("PaperDollFrame", true)
            self.choosingPet = false
        end
        self:SetSidebar(4)
        local right, pane = frame("CharacterFrameRightPaneHost"), frame("CharacterStatsPanePetScrollBox")
        if pane and right and not right:IsShown() then
            pane:Hide()
        end
        self:UpdatePetView()
    end

    -- The pet came or went: the tab in or out of the row; gone while its
    -- view showed, the Character tab's stats again (Blizzard does that too,
    -- on UNIT_PET; looked at again a frame later).
    function UpdatePetTab()
        local chrome = self.chrome
        if chrome then
            chrome:LayoutTabs()
        end
        if not HasPetUI() then
            after(0, function()
                if not HasPetUI() and self:PetMode() then
                    self:SetSidebar(1)
                end
                self:UpdatePetView()
            end)
        end
        self:UpdatePetView()
    end

    -- Stats | Sets | Titles out of sight while the pet shows; Blizzard's
    -- happiness face (a hunter's pet, on the model; its tooltip says the
    -- diet) only then: it sat over the head slot. The tabs' look and the
    -- identity line follow.
    function UpdatePetView()
        local pet = self:PetMode()
        local sidebar = self.sidebar
        if sidebar then
            sidebar.row:SetShown(not pet)
            for _, t in ipairs(sidebar.tabs) do
                t.button:SetAlpha(pet and 0 or 1)
                t.button:EnableMouse(not pet)
            end
        end
        local face = frame("PetPaperDollPetHappinessInfo")
        if face then
            face:SetAlpha(pet and 1 or 0)
            face:EnableMouse(pet)
        end
        if self.chrome then
            assert(self.chrome):UpdateTabs()
        end
        self:UpdateIdentity()
    end

    -- Blizzard's Pet side button (the fourth) out of sight for good: the Pet
    -- tab took its place (Blizzard shows it again as a pet comes); the pet's
    -- experience bar in SuuUI's progress look.
    function SkinPet()
        local function hideButton()
            local b = frames.asButton(tbl.field(_G, "PaperDollSidebarTab4"))
            if b then
                b:SetAlpha(0)
                b:EnableMouse(false)
            end
        end
        hideButton()
        if type(tbl.field(_G, "PaperDollFrame_UpdateSidebarTabs")) == "function" then
            hook("PaperDollFrame_UpdateSidebarTabs", hideButton)
        end
        -- Your model changing (in a fight: the weapons drawn) makes the game
        -- set the scene to you, the pet's view or not (seen in game,
        -- 2026-11-08): the pet back while its view shows.
        if type(tbl.field(_G, "PaperDollFrame_SetPlayer")) == "function" then
            hook("PaperDollFrame_SetPlayer", function()
                local setPet = tbl.field(_G, "PaperDollFrame_SetPet")
                if HasPetUI() and type(setPet) == "function" and self:PetShowing() then
                    (setPet :: () -> ())()
                end
            end)
        end
        local bar = frame("PetPaperDollFrameExpBar")
        if bar and once(bar) then
            UI.ReskinFillBar(bar)
            -- (Blizzard's green: as the blue it is progress-fill)
            local fill = frames.asTexture(tbl.field(bar, "Fill"))
            if fill then
                fill:SetAtlas("common-stat-bar-blue")
            end
        end
        self:UpdatePetView()
    end

    -- New Set (its own button, centred above Equip and Save: probed 2026-10-13)
    -- exactly as wide as the two together, so the edges line up (asked for).
    function AlignSetList()
        local new, equip, save = frame("PaperDollFrameNewSet"),
            frame("PaperDollFrameEquipSet"),
            frame("PaperDollFrameSaveSet")
        if not (new and equip and save) then
            return
        end
        local left, right = secret.asNumber(equip:GetLeft()), secret.asNumber(save:GetRight())
        if not (left and right) then
            return
        end -- (secret in combat)
        new:SetWidth(right - left)
    end

    function SkinPaperDoll()
        self:BuildIdentity()
        self:UpdateIdentity()
        for _, s in ipairs(SLOTS) do
            local b = frame("Character" .. s .. "Slot")
            if b then
                self:SkinSlot(b)
                self:SkinPopout(s, b)
            end
        end
        self:SkinFlyout()
        self:SkinSetPopup()
        local pane = frames.asFrame(tbl.field(frame("PaperDollFrame"), "EquipmentManagerPane"))
        if pane then
            hookScript(pane, "OnShow", function()
                after(0, function()
                    self:AlignSetList()
                end)
            end)
        end
        self:SkinModel()
        self:SkinStatsPane()
        self:BuildGear()
        self:UpdateWear()
        self:SkinSidebar()
        self:SkinPet()
        -- the toggle for the right pane: a small square with SuuUI's edge and a
        -- chevron pointing the way the pane goes
        local toggle = frames.asButton(tbl.field(_G, "CharacterFrameRightPaneToggleButton"))
        if toggle then
            local edge = UI.Border(toggle, "gilt-line")
            local chev = toggle:CreateTexture(nil, "OVERLAY", nil, 7)
            chev:SetSize(14, 14)
            chev:SetPoint("CENTER")
            UI.Paint(chev, "ink-muted")
            self.toggleChevron = chev
            local function hideArt()
                hideButtonArt(toggle, {
                    "GetNormalTexture",
                    "GetPushedTexture",
                    "GetHighlightTexture",
                    "GetDisabledTexture",
                })
                for _, r in ipairs({ toggle:GetRegions() }) do
                    if r ~= chev and r:GetObjectType() == "Texture" then
                        r:SetAlpha(0)
                    end
                end
            end
            local right = frame("CharacterFrameRightPaneHost")
            local function draw()
                hideArt()
                chev:SetAlpha(1)
                local open = right and right:IsShown()
                chev:SetTexture(
                    "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\" ..
                        (open and "chevronLeft" or "chevronRight") .. ".tga"
                )
            end
            toggle:SetSize(22, 22)
            hookScript(toggle, "OnEnter", function()
                edge:SetColor("gilt")
                UI.Paint(chev, "ink")
            end)
            hookScript(toggle, "OnLeave", function()
                edge:SetColor("gilt-line")
                UI.Paint(chev, "ink-muted")
            end)
            hookScript(toggle, "OnClick", function()
                after(0, draw)
            end)
            if right then
                hookScript(right, "OnShow", draw)
                hookScript(right, "OnHide", draw)
            end
            draw()
        end
        self:SkinPanes()
    end

    -- A detail pane's rows (a weapon skill's chances, a faction's, the PvP
    -- rank's) in caption, measured again and laid out after the game lays
    -- them out: measured for the game's font, SuuUI's larger one ran them
    -- past the window's bottom (found in game; the pane doesn't scroll).
    function FitSidePane(pane: Frame)
        if not once(pane) then
            return
        end
        local function fit()
            local pools = tbl.field(pane, "rowPools")
            local caption = SuuUI.Fonts.Get("caption")
            for _, template in ipairs(SIDE_ROWS) do
                local iter, state, init = errors.tryMethod(pools, "EnumerateActiveByTemplate", template)
                if type(iter) == "function" then
                    local step = iter :: (unknown, unknown) -> unknown
                    local row = step(state, init)
                    while row ~= nil do
                        local r = frames.asFrame(row)
                        local label = frames.asFontString(tbl.field(row, "Label"))
                        if r and label then
                            -- (SuuUI's pass leaves its font to this)
                            leave(label, "text")
                            label:SetFontObject(caption)
                            local icon = frames.asRegion(tbl.field(row, "IconSlot"))
                            -- (a secret height, the text a secret: the row as
                            -- the game made it; found in game)
                            local textH = secret.asNumber(label:GetStringHeight())
                            local iconH = icon and secret.asNumber(icon:GetHeight()) or 0
                            if textH and iconH then
                                r:SetHeight(math.max(1, iconH, textH))
                            end
                        end
                        row = step(state, row)
                    end
                end
            end
            errors.tryMethod(tbl.field(pane, "Content"), "Layout")
            self:FitDescription(pane)
        end
        -- (the side pane mixin's methods, not declared)
        hook(pane :: unknown :: { [string]: unknown }, "LayoutRows", fit)
        hook(pane :: unknown :: { [string]: unknown }, "SetDescription", function()
            self:FitDescription(pane)
        end)
        -- (and whenever its font changes: SuuUI's pass gives it SuuUI's
        -- larger font after the game set it; measured in the game's, the box
        -- came out smaller, found in game)
        local desc = frames.asFrame(tbl.field(pane, "Description"))
        local text = desc and frames.asFontString(errors.tryMethod(desc, "GetFontString"))
        if text then
            local function refit()
                self:FitDescription(pane)
            end
            hook(text :: unknown :: { [string]: unknown }, "SetFontObject", refit)
            hook(text :: unknown :: { [string]: unknown }, "SetFont", refit)
        end
        fit()
    end

    -- A detail pane's description as tall as its text, in the room the pane
    -- has below it: the game gives it a fixed height for its own font (120
    -- for a skill, 40 for a weapon skill, 200 for a faction), and SuuUI's
    -- larger one scrolled with room to spare (found in game). Its scroll bar
    -- only when the text is taller than the room.
    function FitDescription(pane: Frame)
        local desc = frames.asFrame(tbl.field(pane, "Description"))
        if not desc or not desc:IsShown() then
            return
        end
        local text = frames.asFontString(errors.tryMethod(desc, "GetFontString"))
        if not text then
            return
        end
        local textH = secret.asNumber(text:GetStringHeight())
        local top = secret.asNumber(desc:GetTop())
        local bottom = secret.asNumber(pane:GetBottom())
        local content = frames.asFrame(tbl.field(pane, "Content"))
        local contentH = content and secret.asNumber(content:GetHeight()) or 0
        if not (textH and top and bottom and contentH) then
            return
        end
        -- (the rows' frame stands 6 below it; a little air at the foot)
        local room = top - bottom - contentH - 6 - S["space-4"]
        -- the scroll box keeps half a line of its font below the text: with
        -- less it still scrolled, its bar showing (found in game); the font's
        -- now SuuUI's, larger than the one the box measured that by
        local _, size = text:GetFont()
        local need = textH + (secret.asNumber(size) or 14) * 0.5 + 2
        local fits = need <= room
        desc:SetHeight(math.max(1, fits and need or room))
        local bar = frames.asFrame(tbl.field(pane, "DescriptionScrollBar"))
        if bar then
            bar:SetShown(not fits)
        end
    end

    function SkinPanes()
        local function watch(f: Frame?)
            if not f or not once(f) then
                return
            end
            -- its detail pane's rows
            for _, c in ipairs(frames.children(f)) do
                if tbl.field(c, "rowPools") and type(tbl.field(c, "LayoutRows")) == "function" then
                    self:FitSidePane(c)
                end
            end
            hookScript(f, "OnShow", function()
                after(0, function()
                    UI.Reskin(f)
                end)
            end)
            if f:IsShown() then
                UI.Reskin(f)
            end
        end
        for _, name in ipairs(PANES) do
            watch(frame(name))
        end
        local pd = frame("PaperDollFrame")
        if pd then
            watch(frames.asFrame(tbl.field(pd, "TitleManagerPane")))
            watch(frames.asFrame(tbl.field(pd, "EquipmentManagerPane")))
        end
    end

    override function OnEnable()
        self:OnGameEvent("PLAYER_EQUIPMENT_CHANGED", function()
            self:UpdateSlots()
            self:UpdateGear()
        end)
        -- the item level in the Gear category
        self:OnGameEvent("PLAYER_AVG_ITEM_LEVEL_UPDATE", function()
            self:UpdateGear()
        end)
        self:OnGameEvent("PLAYER_LEVEL_UP", function()
            self:UpdateIdentity()
        end)
        -- the pet came or went (the Pet tab), its level or loyalty changed
        self:OnUnitEvent("UNIT_PET", "player", function()
            self:UpdatePetTab()
        end)
        self:OnGameEvent("PET_UI_UPDATE", function()
            self:UpdatePetTab()
        end)
        self:OnUnitEvent("UNIT_PET_EXPERIENCE", "player", function()
            self:UpdateIdentity()
        end)
        self:OnUnitEvent("UNIT_HAPPINESS", "pet", function()
            self:UpdateIdentity()
        end)
        -- the Durability module's reading (it sends again on a theme change)
        self:On("SUUUI_DURABILITY_CHANGED", function()
            self:UpdateWear()
        end)
        self:On("SUUUI_SERVICE_CHANGED", function(_, name)
            if name == "durability" then
                self:UpdateWear()
            end
        end)
        if tbl.field(_G, "CharacterFrame") then
            self:Skin()
        else
            -- the window's addon loads later on some clients
            self:OnGameEvent("ADDON_LOADED", function()
                if tbl.field(_G, "CharacterFrame") then
                    self:Skin()
                end
            end)
        end
    end
end

M = SuuUI.AddModule(CharacterWindowModule.new())
