-- Units/AuctionHouse/Writs.wowlua
-- The Buy page's Writs (Units/AuctionHouse): WoW Forever's crafting orders,
-- "Craftsman's Writ: <item>", each starting a quest for one <item>. From
-- the last Scan all: each writ on the house with its tier (Journeyman,
-- Expert, Artisan: its tooltip's line under the name), its lowest buyout,
-- the requested item's lowest and the two together, cheapest first; a
-- requested item that wasn't on the house is "Not listed" (asked
-- 2026-11-16; the quest's reward is random coin, so no profit is shown).

import SuuUI from "/Core/API"
import type ItemSlot, Money, Text from "/Core/API"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import keyInfo, keyTooltip, qualityToken, QUALITY from "./Common"
import TableRow from "./Tables"
import type AuctionHouseModule from "../AuctionHouse"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local tryValue, field, list = errors.tryValue, tbl.field, tbl.list
local asString = secret.asString

export const WRIT_PREFIX = "Craftsman's Writ: "

-- The tiers, lowest first (as their tooltips name them).
export const TIERS: string[] = { "Journeyman", "Expert", "Artisan" }
local IS_TIER: { [string]: boolean } = { Journeyman = true, Expert = true, Artisan = true }

-- A writ the last Scan all found: the item it asks for (its name, and its
-- itemID when that item was on the house too); its tier once read.
export type WritEntry = { target: string, targetID?: number, tier?: string }

-- The item a writ's name asks for ("Craftsman's Writ: Ghostweave Vest":
-- "Ghostweave Vest"), nil for any other name.
export function writTarget(name: string?): string?
    if not name or name:sub(1, #WRIT_PREFIX) ~= WRIT_PREFIX then
        return nil
    end
    local target = name:sub(#WRIT_PREFIX + 1)
    return target ~= "" and target or nil
end

-- The writs of a Scan all: `writNames` the writs' names by itemID, `byName`
-- every scanned item's itemID by name. Tiers already read are kept.
export function fromScan(
    writNames: { [number]: string },
    byName: { [string]: number },
    before: { [number]: WritEntry }?
): { [number]: WritEntry }
    local out: { [number]: WritEntry } = {}
    for id, name in pairs(writNames) do
        local target = writTarget(name)
        if target then
            local old = before and before[id]
            out[id] = { target = target, targetID = byName[target], tier = old and old.tier }
        end
    end
    return out
end

-- A writ's tier from its tooltip's line under the name; nil while the game
-- hasn't loaded the item.
export function tierOf(itemID: number): string?
    local data = tryValue(C_TooltipInfo and C_TooltipInfo.GetItemByID, itemID)
    local line = list(field(data, "lines"))[2]
    local text = asString(field(line, "leftText"))
    return text and IS_TIER[text] and text or nil
end

-- A row's figures: the writ, the requested item, the two together (nil:
-- not listed).
export type WritLine = { id: number, entry: WritEntry, writ: number?, item: number?, total: number? }

-- The scanned writs of `tier` ("all": every one), cheapest total first,
-- then the ones whose item isn't listed (cheapest writ first).
export function writLines(self: AuctionHouseModule, tier: string): WritLine[]
    local out: WritLine[] = {}
    local writs = self:Saved().writs or {}
    for id, entry in pairs(writs) do
        if not entry.tier then
            entry.tier = tierOf(id)
        end
        if tier == "all" or entry.tier == tier then
            local w = self:LowestSeen(id)
            local targetID = entry.targetID
            local it = targetID and self:LowestSeen(targetID)
            local writ = w and w.price
            local item = it and it.price
            out[#out + 1] = {
                id = id,
                entry = entry,
                writ = writ,
                item = item,
                total = (writ and item) and writ + item or nil,
            }
        end
    end
    table.sort(out, function(a: WritLine, b: WritLine): boolean
        local at, bt = a.total, b.total
        if (at ~= nil) ~= (bt ~= nil) then
            return at ~= nil
        end
        if at and bt and at ~= bt then
            return at < bt
        end
        local aw, bw = a.writ or math.huge, b.writ or math.huge
        if aw ~= bw then
            return aw < bw
        end
        return a.id < b.id
    end)
    return out
end

-- A writ's row: the requested item's name (the writ's icon), the tier, the
-- writ's price, the item's (or Not listed), the total.
export class WritRow extends TableRow
    readonly slot: ItemSlot
    readonly name: Text
    readonly tier: Text
    readonly writ: Money
    readonly item: Money
    readonly missing: Text
    readonly total: Money
    readonly none: Text
    itemID: number? = nil

    constructor(parent: Frame)
        super(parent)
        self.slot = UI.ItemSlot(self, 24)
        self.slot:EnableMouse(false)
        self.name = UI.Text(self, "label", "ink")
        self.name:SetWordWrap(false)
        self.tier = UI.Text(self, "caption", "ink-muted")
        self.writ = UI.Money(self)
        self.item = UI.Money(self)
        self.missing = UI.Text(self, "caption", "ink-faint")
        self.missing:SetJustifyH("RIGHT")
        self.missing:SetValue("Not listed")
        self.total = UI.Money(self)
        self.none = UI.Text(self, "caption", "ink-faint")
        self.none:SetJustifyH("RIGHT")
        self.none:SetValue("—")
    end
end

export function drawWrits(self: AuctionHouseModule)
    local buy = self.buy
    if not buy then
        return
    end
    local t = buy.writs
    buy.tierBar:SetValue(self.writTier)
    local lines = writLines(self, self.writTier)
    local n = 0
    for i, w in ipairs(lines) do
        n = i
        local row = t:Line(i)
        local key: ItemKey = { itemID = w.id, itemLevel = 0, itemSuffix = 0, battlePetSpeciesID = 0 }
        local info = keyInfo(key)
        local quality = info and info.quality
        row.slot.skin:SetItem({ icon = info and info.iconFileID, quality = QUALITY[quality or 1] or "common" })
        row.name:SetValue(w.entry.target)
        row.name:SetColor(qualityToken(quality))
        row.tier:SetValue(w.entry.tier or "")
        local writ, item, total = w.writ, w.item, w.total
        row.writ:SetCopper(writ or 0)
        row.writ:SetShown(writ ~= nil)
        row.item:SetCopper(item or 0)
        row.item:SetShown(item ~= nil)
        row.missing:SetShown(item == nil)
        row.total:SetCopper(total or 0)
        row.total:SetShown(total ~= nil)
        row.none:SetShown(total == nil)
        local places = t:Places(t.list:GetWidth())
        row.slot:ClearAllPoints()
        row.slot:SetPoint("LEFT", places[1].x, 0)
        row.name:ClearAllPoints()
        row.name:SetPoint("LEFT", row.slot, "RIGHT", S["space-3"], 0)
        row.name:SetWidth(math.max(20, places[1].w - 24 - S["space-3"]))
        t:PlaceCells(row, {
            false,
            row.tier,
            row.writ,
            item ~= nil and row.item or row.missing,
            total ~= nil and row.total or row.none,
        })
        row.itemID = w.id
        row.onEnter = function()
            keyTooltip(row, key)
        end
        -- the writ's auctions, to buy it
        row:SetScript("OnClick", function()
            self:SearchItem(w.id)
        end)
        row:Show()
    end
    t:Fit(n)
    buy.empty:SetShown(n == 0)
    if n == 0 then
        local tier = self.writTier
        buy.empty:SetValue(
            not self:Saved().writs and "Scan all to find the writs on the auction house." or
                tier == "all" and "No writs in the last scan." or
                ("No " .. tier .. " writs in the last scan.")
        )
    end
end
