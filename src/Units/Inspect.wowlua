-- Units/Inspect.wowlua
-- SuuUI's own inspect window (plan 3.7, design component InspectWindow,
-- direction B "Side panel", chosen 2026-10-17): the inspected player's name,
-- level, race, class and guild; their gear on the Character window's paper
-- doll with each item's level; their 3D model; beside it the item level,
-- Player vs. Player and the guild. "Compare with mine" puts the difference
-- to your own item on each slot. The game's InspectFrame still runs the
-- inspect (it asks the server, closes when the target changes) but stays
-- out of sight; this window opens and closes with it. Nothing here is
-- protected (/suu probe windows, 2026-10-17).
-- View Talents opens SuuUI's Talents window with their talents, read only
-- (Forever's own inspect has no talents button: probed 2026-10-17).
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SuuButton from "/UI/Controls"
import type Toggle from "/UI/Inputs"
import type WindowFrame, Panel from "/UI/Panel"
import type Text from "/UI/Text"
import type Icon from "/UI/Icon"
import type Bar from "/UI/Bar"
import type LoadingMark from "/UI/LoadingMark"
import ItemSlot from "/UI/Inventory"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import isSecret from "wowlua:secret"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import type AwayHandle from "wowlua:frames"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {}

local M: InspectModule

local function plainNumber(v: unknown): number?
    if secret.readable(v) and type(v) == "number" then
        return v
    end
    return nil
end

local SLOT = T.size["slot"]
local SIDE_W = 230
local MODEL_W = 300
local QUALITY: { [number]: string } = {
    [0] = "poor",
    "common",
    "uncommon",
    "rare",
    "epic",
    "legendary",
    "legendary",
    "legendary",
}

-- the paper doll: the Character window's columns, weapons under the model
local LEFT = { "Head", "Neck", "Shoulder", "Back", "Chest", "Shirt", "Tabard", "Wrist" }
local RIGHT = { "Hands", "Waist", "Legs", "Feet", "Finger0", "Finger1", "Trinket0", "Trinket1" }
local WEAPONS = { "MainHand", "SecondaryHand", "Ranged" }
local LABEL: { [string]: string } = {
    Head = "Head",
    Neck = "Neck",
    Shoulder = "Shoulder",
    Back = "Back",
    Chest = "Chest",
    Shirt = "Shirt",
    Tabard = "Tabard",
    Wrist = "Wrist",
    Hands = "Hands",
    Waist = "Waist",
    Legs = "Legs",
    Feet = "Feet",
    Finger0 = "Finger",
    Finger1 = "Finger",
    Trinket0 = "Trinket",
    Trinket1 = "Trinket",
    MainHand = "Main hand",
    SecondaryHand = "Off hand",
    Ranged = "Ranged",
}

-- The window fits what it holds: the identity line, the tools, the paper doll
-- (eight slots high, the weapons under it) beside the side panel.
local TOOLS_H = 26
local COL_H = #LEFT * SLOT + (#LEFT - 1) * S["space-2"]
local DOLL_W = 2 * (SLOT + S["space-4"]) + MODEL_W
local BODY_H = T.type["unit-name-lg"].lineHeight + S["space-4"] + TOOLS_H + S["space-5"] + COL_H + S["space-4"] + SLOT
local WIDTH = S["space-5"] + DOLL_W + S["space-6"] + SIDE_W + S["space-5"]
local HEIGHT = S["space-5"] + T.type.header.lineHeight + S["space-4"] + 1 + S["space-4"] + BODY_H + S["space-5"]

local function itemLevel(link: unknown): number?
    if not secret.readable(link) or type(link) ~= "string" then
        return nil
    end
    local ok, lvl = pcall(C_Item.GetDetailedItemLevelInfo, link)
    return ok and secret.readable(lvl) and lvl and lvl > 0 and lvl or nil
end

-- the rank's name as the game's own inspect window words it
local function rankName(unit: string, rank: number): string
    if not rank or rank <= 0 then
        return PVP_RANK_0_NAME or "Civilian"
    end
    local affix = (UnitFactionGroup(unit) == "Alliance") and "_1" or "_0"
    local ranks = tbl.field(Enum, "PvPRanks")
    local first = plainNumber(tbl.field(ranks, "Rank_1")) or 5
    local key = "PVP_RANK_" .. tostring(first + rank - 1) .. affix
    local getText = GetText :: (token: string, gender: unknown) -> string
    local ok: boolean, name: unknown = pcall(getText, key, UnitSex(unit))
    if not ok or not secret.readable(name) or type(name) ~= "string" then
        return tostring(rank)
    end
    return PVP_RANK_NUMBER_AND_TITLE and PVP_RANK_NUMBER_AND_TITLE:format(rank, name) or name
end

-- "Level 21 · Undead · Paladin" (a secret or unknown level: "??"; a
-- secret race or class left out).
local function identityLine(level: unknown, race: unknown, className: unknown): string
    local lvl = plainNumber(level)
    local parts = { "Level " .. ((lvl and lvl > 0) and lvl or "??") }
    if secret.readable(race) then
        parts[#parts + 1] = tostring(race)
    end
    if secret.readable(className) then
        parts[#parts + 1] = tostring(className)
    end
    return table.concat(parts, " · ")
end

-- Their item's level against yours: the chip's text and colour ("▲3",
-- gilt; "▼2", ember), nil when they're the same or yours is unknown.
local function deltaChip(level: number, mine: number?): (string?, string?)
    local d = mine and level - mine or 0
    if d == 0 then
        return nil, nil
    end
    return (d > 0 and "▲" or "▼") .. math.abs(d), d > 0 and "gilt-text" or "ember-text"
end

-- The rank points' text and the bar's fill: "1200 / 5000" toward the
-- next rank, else the points alone.
local function rankPoints(given: unknown, nextGiven: unknown): (string, number)
    local points = plainNumber(given) or 0
    local nextAt = plainNumber(nextGiven) or 0
    if nextAt > 0 then
        return points .. " / " .. nextAt, math.min(1, points / nextAt)
    end
    return tostring(points), 0
end

-- "Horde · 42 members" under the guild's name (the game's own formats).
local function guildLine(faction: unknown, members: unknown): string
    local line = secret.readable(faction) and INSPECT_GUILD_FACTION and INSPECT_GUILD_FACTION:format(faction) or ""
    local count = plainNumber(members)
    if count and count > 0 and INSPECT_GUILD_NUM_MEMBERS then
        line = line .. (line ~= "" and " · " or "") .. INSPECT_GUILD_NUM_MEMBERS:format(count)
    end
    return line
end

-- Why View Talents is off (nil: it's on).
local function talentsWhy(loading: boolean, moduleOn: boolean, hasData: boolean): string?
    if loading then
        return "Waiting for their gear."
    end
    if not moduleOn then
        return "SuuUI's Talents module is off."
    end
    if not hasData then
        return "Their talents aren't available."
    end
    return nil
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

-- One block of the side panel: a header and rows under it.
class SideBlock extends Frame
    readonly head: Text
    -- where the next row goes
    y: number

    constructor(parent: Frame, title: string)
        super(nil, parent)
        self.head = UI.Text(self, "header", "gilt-text")
        self.head:SetPoint("TOPLEFT")
        self.head:SetValue(title)
        self.y = T.type.header.lineHeight + S["space-3"]
    end

    -- A row: the label, and the value's text (returned).
    function Row(label: string): Text
        local l = UI.Text(self, "caption", "ink-muted")
        l:SetPoint("TOPLEFT", 0, -self.y)
        local v = UI.Text(self, "numeric", "ink")
        v:SetPoint("TOPRIGHT", 0, -self.y + 1)
        l:SetValue(label)
        self.y = self.y + T.type.numeric.lineHeight + S["space-3"]
        return v
    end
end

-- Item level: the big figure, a note under it.
class ItemLevelBlock extends SideBlock
    readonly big: Text
    readonly note: Text

    constructor(parent: Frame)
        super(parent, "Item level")
        self.big = UI.Text(self, "numeric", "ink")
        self.big:SetPoint("TOPLEFT", 0, -self.y)
        self.note = UI.Text(self, "caption", "ink-muted")
        self.note:SetPoint("TOPLEFT", 0, -(self.y + 34))
    end
end

-- Player vs. Player: the rank, its points and bar, the kills.
class PvpBlock extends SideBlock
    readonly rank: Text
    readonly points: Text
    readonly bar: Bar
    readonly today: Text
    readonly lifetime: Text

    constructor(parent: Frame)
        super(parent, "Player vs. Player")
        self.rank = self:Row("Rank")
        self.rank:SetStyle("label")
        self.points = self:Row("Rank points")
        self.bar = UI.StatusBar(self, { width = SIDE_W, height = 6, fill = "progress-fill" })
        self.bar:SetPoint("TOPLEFT", 0, -self.y)
        self.y = self.y + 6 + S["space-3"]
        self.today = self:Row("Honorable kills today")
        self.lifetime = self:Row("Lifetime")
        self:SetHeight(self.y)
    end
end

-- The guild: its tabard, name and line, or "Not in a guild".
class GuildBlock extends SideBlock
    readonly icon: Icon
    readonly name: Text
    readonly line: Text
    readonly none: Text

    constructor(parent: Frame)
        super(parent, "Guild")
        self.icon = UI.Icon(self, "icon-lg")
        self.icon:SetPoint("TOPLEFT", 0, -self.y)
        self.icon:SetArt("Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\tabard")
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.icon, "TOPRIGHT", S["space-4"], -2)
        self.line = UI.Text(self, "caption", "ink-muted")
        self.line:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -2)
        self.none = UI.Text(self, "caption", "ink-muted")
        self.none:SetPoint("TOPLEFT", 0, -self.y)
        self.none:SetValue("Not in a guild")
        self:SetHeight(self.y + 40)
    end
end

-- The identity: class diamond, the name in its class colour, the line, the guild.
class IdentityRow extends Frame
    readonly diamond: Texture
    readonly name: Text
    readonly line: Text
    readonly guild: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetPoint("TOPLEFT")
        self:SetPoint("TOPRIGHT")
        self:SetHeight(T.type["unit-name-lg"].lineHeight)
        self.diamond = UI.Diamond(self, 7, "ink", "OVERLAY")
        self.diamond:SetPoint("CENTER", self, "LEFT", 4, 0)
        self.name = UI.Text(self, "unit-name-lg", "ink")
        self.name:SetPoint("LEFT", 8 + S["space-3"], 0)
        self.line = UI.Text(self, "caption", "ink-muted")
        self.line:SetPoint("LEFT", self.name, "RIGHT", S["space-4"], -1)
        self.guild = UI.Text(self, "caption", "gilt-text")
        self.guild:SetPoint("LEFT", self.line, "RIGHT", S["space-4"], 0)
    end
end

-- The model: drag to turn, the wheel to zoom.
class InspectModel extends PlayerModel
    turning: number? = nil
    zoom: number = 0

    constructor(parent: Frame)
        super(nil, parent)
        self:SetPoint("TOPLEFT", 1, -1)
        self:SetPoint("BOTTOMRIGHT", -1, 1)
        self:EnableMouse(true)
        self:EnableMouseWheel(true)
        self:SetScript("OnMouseDown", function(_: Frame, button: string)
            if button == "LeftButton" then
                self.turning = (GetCursorPosition())
            end
        end)
        self:SetScript("OnMouseUp", function()
            self.turning = nil
        end)
        self:SetScript("OnUpdate", function()
            local turning = self.turning
            if not turning then
                return
            end
            local x = GetCursorPosition()
            self:SetFacing((self:GetFacing() or 0) + (x - turning) * 0.01)
            self.turning = x
        end)
        self:SetScript("OnMouseWheel", function(_: Frame, delta: number)
            self.zoom = math.max(0, math.min(0.8, self.zoom + delta * 0.1))
            self:SetPortraitZoom(self.zoom)
        end)
    end
end

-- The model's frame: the model, a note (why there's no model) and the
-- loading mark over it.
class ModelBox extends Frame
    readonly model: InspectModel
    readonly note: Text
    readonly loading: LoadingMark

    constructor(parent: Frame)
        super(nil, parent)
        self.model = InspectModel.new(self)
        self.note = UI.Text(self, "caption", "ink-muted", "OVERLAY")
        self.note:SetPoint("CENTER", 0, -30)
        self.loading = UI.LoadingMark(self, { size = 40 })
        self.loading:SetPoint("CENTER", 0, 10)
    end
end

-- The difference to yours, a chip at a slot's top right.
class DeltaChip extends Frame
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetFrameLevel(parent:GetFrameLevel() + 3)
        self:SetPoint("TOPRIGHT", 3, 4)
        self:SetSize(20, 12)
        UI.Fill(self, "surface-sunk"):SetAllPoints()
        UI.Border(self, "gilt-faint")
        self.text = UI.Text(self, "micro", "gilt-text", "OVERLAY")
        self.text:SetPoint("CENTER", 0, 0)
        self:Hide()
    end
end

-- One slot of the paper doll: the item, its level, the difference to yours.
class DollSlot extends ItemSlot
    readonly slotID: number
    readonly key: string
    readonly label: string
    -- the slot's initial, while it's empty
    readonly initial: Text
    -- the item level, bottom left
    readonly level: Text
    readonly delta: DeltaChip

    constructor(parent: Frame, key: string)
        super(parent, SLOT)
        self.slotID = GetInventorySlotInfo(key .. "Slot") or 0
        self.key = key
        self.label = assert(LABEL[key])
        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.initial = UI.Text(self, "micro", "ink-faint", "OVERLAY")
        self.initial:SetPoint("CENTER")
        self.initial:SetValue(self.label:sub(1, 1))
        self.level = UI.Text(self, "micro", "ink", "OVERLAY")
        self.level:SetPoint("BOTTOMLEFT", 2, 1)
        self.level:SetShadowed(true)
        self.delta = DeltaChip.new(self)
        self:SetScript("OnEnter", function()
            GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
            local unit = M.unit
            if not (unit and GameTooltip:SetInventoryItem(unit, self.slotID)) then
                GameTooltip:SetText(self.label)
            end
            GameTooltip:Show()
        end)
        self:SetScript("OnLeave", function()
            GameTooltip:Hide()
        end)
        self:SetScript("OnClick", function()
            local unit = M.unit
            local link = unit and GetInventoryItemLink(unit, self.slotID)
            if link then
                HandleModifiedItemClick(link)
            end
        end)
    end
end

-- The game's inspect frame, once its addon is loaded.
local function inspectFrame(): Frame?
    return frames.find("InspectFrame")
end
-- The unit it inspects.
local function inspectedUnit(f: Frame): string?
    local unit = tbl.field(f, "unit")
    if type(unit) == "string" then
        return unit
    end
    return nil
end

--------------------------------------------------------------------------------
-- With the game's inspect frame
--------------------------------------------------------------------------------

class InspectModule extends Module<typeof(DEFAULTS)>
    away: AwayHandle? = nil
    box: ModelBox? = nil
    compare: boolean? = nil
    compareToggle: Toggle? = nil
    dressButton: SuuButton? = nil
    guild: GuildBlock? = nil
    hooked: boolean? = nil
    idRow: IdentityRow? = nil
    ilvl: ItemLevelBlock? = nil
    loading: boolean? = nil
    model: InspectModel? = nil
    pvp: PvpBlock? = nil
    side: Frame? = nil
    slots: DollSlot[] = {}
    talentsButton: SuuButton? = nil
    -- the inspected unit
    unit: string? = nil
    window: WindowFrame? = nil

    constructor()
        super({
            id = "inspect",
            name = "Inspect",
            description = "SuuUI's inspect window: the player's gear with item levels, their model, item level, PvP and guild at a glance, and a comparison with your own gear.",
            api = "0.17",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function BuildSlot(parent: Frame, key: string): DollSlot
        local b = DollSlot.new(parent, key)
        self.slots[#self.slots + 1] = b
        return b
    end

    -- The item level's big figure and the block's height: from the text styles,
    -- so again when a theme changes them.
    function SizeItemLevel()
        local il = assert(self.ilvl)
        il.big:SetFont(T.type.numeric.file, 28, "")
        il:SetHeight(il.y + 34 + T.type.caption.lineHeight)
    end

    function Build()
        self.slots = {}
        local w = UI.WindowFrame(SuuUI.Root, {
            name = "SuuUIInspectWindow",
            title = "Inspect",
            width = WIDTH,
            height = HEIGHT,
            onClose = function(win: Panel)
                win:Hide()
            end,
        })
        w:SetPoint("TOPLEFT", UIParent, "TOPLEFT", 16, -116)
        w:Hide()
        w.scroll:Hide()
        self.window = w
        w:HookScript("OnHide", function()
            local f = inspectFrame()
            if f and f:IsShown() then
                HideUIPanel(f)
            end
            self.unit, self.loading = nil, nil
        end)
        local body = w.body

        local id = IdentityRow.new(body)
        self.idRow = id

        -- the tools: Compare with mine; View in Dressing Room and View Talents
        local tools = CreateFrame("Frame", nil, body)
        tools:SetPoint("TOPLEFT", id, "BOTTOMLEFT", 0, -S["space-4"])
        tools:SetPoint("TOPRIGHT", id, "BOTTOMRIGHT", 0, -S["space-4"])
        tools:SetHeight(TOOLS_H)
        local compare = UI.Toggle(tools, {
            value = self.compare,
            onChange = function(on: boolean)
                self.compare = on
                self:Draw()
            end,
        })
        self.compareToggle = compare
        compare:SetPoint("LEFT")
        local cl = CreateFrame("Button", nil, tools)
        local clText = UI.Text(cl, "label", "ink")
        clText:SetPoint("LEFT")
        clText:SetValue("Compare with mine")
        cl:SetSize(UI.MeasureText("label", "Compare with mine"), TOOLS_H)
        cl:SetPoint("LEFT", compare, "RIGHT", S["space-4"], 0)
        cl:SetScript("OnClick", function()
            compare:Click()
        end)
        local talents = UI.Button(tools, {
            text = "View Talents",
            icon = "tree",
            onClick = function()
                if self.unit then
                    SuuUI.ShowTalentsOf(self.unit)
                end
            end,
        })
        self.talentsButton = talents
        talents:SetHeight(TOOLS_H)
        talents:SetPoint("RIGHT")
        local dress = UI.Button(tools, {
            text = "View in Dressing Room",
            icon = "person",
            onClick = function()
                local ok, list = pcall(C_TransmogCollection.GetInspectItemTransmogInfoList)
                if ok and list then
                    DressUpItemTransmogInfoList(list)
                end
            end,
        })
        self.dressButton = dress
        dress:SetHeight(TOOLS_H)
        dress:SetPoint("RIGHT", talents, "LEFT", -S["space-4"], 0)

        -- the side panel: item level, Player vs. Player, guild
        local side = CreateFrame("Frame", nil, body)
        side:SetPoint("TOPRIGHT", tools, "BOTTOMRIGHT", 0, -S["space-5"])
        side:SetPoint("BOTTOMRIGHT")
        side:SetWidth(SIDE_W)
        self.side = side
        local il = ItemLevelBlock.new(side)
        il:SetPoint("TOPLEFT")
        il:SetPoint("TOPRIGHT")
        self.ilvl = il
        self:SizeItemLevel()
        local pvp = PvpBlock.new(side)
        pvp:SetPoint("TOPLEFT", il, "BOTTOMLEFT", 0, -S["space-6"])
        pvp:SetPoint("TOPRIGHT", il, "BOTTOMRIGHT", 0, -S["space-6"])
        self.pvp = pvp
        local guild = GuildBlock.new(side)
        guild:SetPoint("TOPLEFT", pvp, "BOTTOMLEFT", 0, -S["space-6"])
        guild:SetPoint("TOPRIGHT", pvp, "BOTTOMRIGHT", 0, -S["space-6"])
        self.guild = guild

        -- the paper doll: two slot columns, the model between, weapons under it
        local doll = CreateFrame("Frame", nil, body)
        doll:SetPoint("TOPLEFT", tools, "BOTTOMLEFT", 0, -S["space-5"])
        doll:SetPoint("BOTTOMRIGHT", side, "BOTTOMLEFT", -S["space-6"], 0)
        local prev: DollSlot? = nil
        for _, key in ipairs(LEFT) do
            local b = self:BuildSlot(doll, key)
            if prev then
                b:SetPoint("TOPLEFT", prev, "BOTTOMLEFT", 0, -S["space-2"])
            else
                b:SetPoint("TOPLEFT", doll, "TOPLEFT", 0, 0)
            end
            prev = b
        end
        prev = nil
        for _, key in ipairs(RIGHT) do
            local b = self:BuildSlot(doll, key)
            if prev then
                b:SetPoint("TOPRIGHT", prev, "BOTTOMRIGHT", 0, -S["space-2"])
            else
                b:SetPoint("TOPRIGHT", doll, "TOPRIGHT", 0, 0)
            end
            prev = b
        end
        local box = ModelBox.new(doll)
        box:SetPoint("TOPLEFT", SLOT + S["space-4"], 0)
        box:SetPoint("TOPRIGHT", -(SLOT + S["space-4"]), 0)
        box:SetHeight(COL_H)
        UI.Fill(box, "surface-sunk"):SetAllPoints()
        UI.Border(box, "gilt-faint")
        box:SetClipsChildren(true)
        self.model = box.model
        self.box = box
        local weapons = CreateFrame("Frame", nil, doll)
        weapons:SetSize(#WEAPONS * SLOT + (#WEAPONS - 1) * S["space-2"], SLOT)
        weapons:SetPoint("TOP", box, "BOTTOM", 0, -S["space-4"])
        prev = nil
        for _, key in ipairs(WEAPONS) do
            local b = self:BuildSlot(weapons, key)
            if prev then
                b:SetPoint("LEFT", prev, "RIGHT", S["space-2"], 0)
            else
                b:SetPoint("LEFT", weapons, "LEFT", 0, 0)
            end
            prev = b
        end
    end

    function DrawSlot(b: DollSlot)
        local unit, s = self.unit, b.skin
        local texture = unit and not self.loading and GetInventoryItemTexture(unit, b.slotID)
        b.delta:Hide()
        b.level:SetValue("")
        if not unit or not texture then
            s:SetItem(nil)
            b.initial:SetShown(not self.loading)
            b:SetAlpha(self.loading and 0.6 or 1)
            return
        end
        b:SetAlpha(1)
        b.initial:Hide()
        local quality = GetInventoryItemQuality(unit, b.slotID)
        s:SetItem({ icon = texture, quality = QUALITY[quality] })
        local level = itemLevel(GetInventoryItemLink(unit, b.slotID))
        if level then
            b.level:SetValue(level)
        end
        if self.compare and level then
            local text, color = deltaChip(level, itemLevel(GetInventoryItemLink("player", b.slotID)))
            if text then
                local chip = b.delta
                chip.text:SetValue(text)
                chip.text:SetColor(assert(color))
                chip:SetWidth(UI.MeasureText("micro", chip.text:GetText() or "") + 6)
                chip:Show()
            end
        end
    end

    function Draw()
        local unit, w = self.unit, self.window
        if not unit or not w then
            return
        end
        -- (built with the window)
        local id, box, model, il = assert(self.idRow), assert(self.box), assert(self.model), assert(self.ilvl)
        local pvp, g, dress, talents = assert(self.pvp),
            assert(self.guild),
            assert(self.dressButton),
            assert(self.talentsButton)
        -- who
        local name: unknown = GetUnitName(unit, true)
        local _, class = UnitClass(unit)
        local token = class and not isSecret(class) and "class-" .. (class :: string):lower()
        local colors: { [string]: unknown } = T.color
        if token and colors[token] then
            UI.Paint(id.diamond, token)
            id.name:SetColor(token)
        end
        id.name:SetValue(secret.readable(name) and type(name) == "string" and name or "")
        id.line:SetValue(identityLine(UnitLevel(unit), UnitRace(unit), (UnitClass(unit))))
        local okGuild: boolean, _: unknown, members: unknown, guildRead: unknown = pcall(
            C_PaperDollInfo.GetInspectGuildInfo,
            unit
        )
        local guildName: string? = nil
        if okGuild and not self.loading and secret.readable(guildRead) and type(guildRead) == "string" and
            guildRead ~= "" then
            guildName = guildRead
        end
        id.guild:SetValue(guildName and ("<" .. guildName .. ">") or "")
        -- gear
        for _, b in ipairs(self.slots) do
            self:DrawSlot(b)
        end
        -- the model, or why there's none
        if self.loading then
            model:Hide()
            box.loading:Show()
            box.loading:Start()
            box.note:SetValue("Reading their gear…")
        else
            box.loading:Stop()
            box.loading:Hide()
            -- SetUnit says nothing on Forever: whether the game has them in sight does
            local visible = UnitIsVisible(unit)
            local near = not secret.readable(visible) or visible == true
            if near then
                model:SetUnit(unit)
            end
            model:SetShown(near)
            box.note:SetValue(near and "" or "Too far away to show")
        end
        -- item level
        local avg: number? = nil
        if not self.loading then
            local ok: boolean, read: unknown = pcall(C_PaperDollInfo.GetInspectItemLevel, unit)
            avg = ok and plainNumber(read) or nil
        end
        il.big:SetValue((avg and avg > 0) and math.floor(avg + 0.5) or "—")
        local okMine: boolean, mineRead: unknown = pcall(GetAverageItemLevel)
        local mine = okMine and plainNumber(mineRead) or nil
        if self.compare and mine then
            il.note:SetValue("Yours: " .. math.floor(mine + 0.5))
        else
            il.note:SetValue("Average of what they wear")
        end
        -- Player vs. Player (Forever's honour data: today's kills first, the
        -- lifetime kills fifth, the rank, its points and the next rank's after)
        local today: unknown, lifetime: unknown, rank: unknown, points: unknown, nextAt: unknown = nil,
            nil,
            nil,
            nil,
            nil
        if not self.loading then
            local honor = GetInspectHonorData :: () -> ...unknown
            local ok, t, _, _, _, l, _, r, p, n = pcall(honor)
            if ok then
                today, lifetime, rank, points, nextAt = t, l, r, p, n
            end
        end
        pvp.rank:SetValue(rankName(unit, plainNumber(rank) or 0))
        local pointsText, fill = rankPoints(points, nextAt)
        pvp.points:SetValue(pointsText)
        pvp.bar:SetValueNow(fill)
        pvp.today:SetValue(plainNumber(today) or 0)
        pvp.lifetime:SetValue(plainNumber(lifetime) or 0)
        -- guild
        g.icon:SetShown(guildName ~= nil)
        g.name:SetValue(guildName or "")
        local _, faction = UnitFactionGroup(unit)
        g.line:SetValue(guildName and guildLine(faction, members) or "")
        g.none:SetShown(guildName == nil and not self.loading)
        -- the buttons wait for the gear
        dress:SetEnabledState(not self.loading)
        local module = SuuUI.GetModule("talents")
        local on = (module and module:IsEnabled()) and true or false
        local hasData = false
        if not self.loading and on then
            local ok, valid = pcall(C_Traits.HasValidInspectData)
            hasData = ok and valid == true
        end
        local why = talentsWhy(self.loading and true or false, on, hasData)
        talents:SetEnabledState(why == nil)
        talents.tooltip = why and { title = "View Talents", description = why } or nil
    end

    -- The game's frame out of sight while the module is on: see-through and
    -- off screen, still shown (wowlua:frames' keepAway).
    function Away(frame: Frame)
        if self.away then
            return
        end
        self.away = frames.keepAway(frame, {
            fade = true,
            when = function(): boolean
                return self:IsEnabled()
            end,
        })
    end

    -- Asked: the window opens at once, waiting for the gear.
    function Asked()
        local f = inspectFrame()
        local unit = f and inspectedUnit(f)
        local w = self.window
        if not f or not unit or not w then
            return
        end
        self.unit, self.loading = unit, true
        self:Away(f)
        w:Show()
        self:Draw()
        -- the answer comes with INSPECT_READY; if it never does, show what there is
        after(5, function()
            if self.loading and self.unit == unit and w:IsShown() then
                self.loading = false
                self:Draw()
            end
        end)
    end

    function Ready()
        local f = inspectFrame()
        local unit = f and inspectedUnit(f)
        local w = self.window
        if not f or not unit or not w then
            return
        end
        self.unit, self.loading = unit, false
        self:Away(f)
        if not w:IsShown() then
            w:Show()
        end
        self:Draw()
    end

    -- The window, while it's open.
    function Open(): WindowFrame?
        local w = self.window
        if w and w:IsShown() then
            return w
        end
        return nil
    end

    function HookInspect()
        local f = inspectFrame()
        if not f or self.hooked then
            return
        end
        self.hooked = true
        hook(_G, "InspectFrame_Show", function()
            if self:IsEnabled() then
                self:Asked()
            end
        end, { addon = "Blizzard_InspectUI" })
        hookScript(f, "OnShow", function()
            if self:IsEnabled() then
                self:Ready()
            end
        end)
        hookScript(f, "OnHide", function()
            local w = self:Open()
            if self:IsEnabled() and w and not self.loading then
                w:Hide()
            end
        end)
    end

    override function OnEnable()
        if not self.window then
            self:Build()
        end
        self:HookInspect()
        self:OnGameEvent("ADDON_LOADED", function(_, name)
            if name == "Blizzard_InspectUI" then
                self:HookInspect()
            end
        end)
        self:OnGameEvent("INSPECT_READY", function(_, guid)
            local g = self.unit and UnitGUID(self.unit)
            if self.unit and self:Open() and not isSecret(g) and g == guid then
                self.loading = false
                self:Draw()
            end
        end)
        -- a new target while waiting: the game drops the question, so does this
        self:OnGameEvent("PLAYER_TARGET_CHANGED", function()
            local w = self:Open()
            if self.unit == "target" and self.loading and w then
                w:Hide()
            end
        end)
        for _, e in ipairs({ "UNIT_INVENTORY_CHANGED", "UNIT_MODEL_CHANGED", "UNIT_LEVEL" }) do
            self:OnGameEvent(e, function(_, unit: unknown)
                if unit and unit == self.unit and self:Open() then
                    self:Draw()
                end
            end)
        end
        for _, e in ipairs({ "INSPECT_HONOR_UPDATE", "PLAYER_EQUIPMENT_CHANGED", "GET_ITEM_INFO_RECEIVED" }) do
            self:OnGameEvent(e, function()
                if self:Open() then
                    self:Draw()
                end
            end)
        end
        self:On("SUUUI_THEME_CHANGED", function()
            self:SizeItemLevel()
        end)
    end

    override function OnDisable()
        local w = self.window
        if w then
            w:Hide()
        end
    end
end

M = SuuUI.AddModule(InspectModule.new())
