-- Units/Mail.wowlua
-- SuuUI's own mail window (plan 3.6, design component MailWindow): the game's
-- MailFrame stays open (it holds the mailbox conversation) but out of sight,
-- and this window shows the whole inbox as one list with the open mail
-- beside it, Collect all and Collect money, a form to send, and the mails
-- this character sent. None of it is protected (/suu probe windows,
-- 2026-10-16); sending money goes through the game's own confirmation.
-- Mail/Inbox reads the inbox and finds a mail again after it moved (nothing
-- acts on an inbox index kept from before); Mail/Collect is Collect all.
-- Each character's inbox as last read is kept (its mails' money, COD,
-- expiry and items) and is SuuUI.Holdings' "mail" while this module is on
-- (the Ledger's "What it's worth", the bags' item counts). Turned off, the
-- kept inboxes stay in its data but nobody reads them: no mail shows there
-- until it is on again (and the inbox is read again on the next visit).
-- A built-in module written against the public API only.

import SuuUI, Module, ItemSlotClass from "/Core/API"
import type WindowFrame, ScrollArea, Text, SuuButton, TextField, Segmented, MoneyInput, Color, ItemSlot, ConfirmDialog, Holding from "/Core/API"
import type AwayHandle from "wowlua:frames"
import hook from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as frames from "wowlua:frames"
import * as format from "wowlua:format"
import * as mails from "./Mail/Inbox"
import Collector, nextTake from "./Mail/Collect"
import type Left from "./Mail/Collect"

local inlineMark = SuuUI.UI.InlineMark

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local colors: { [string]: Color } = T.color

local DEFAULTS = {}

local M: MailModule

local WIDTH, HEIGHT = 720, 560
local LIST_W = 300
local ROW_H = 44
local ATTACH_OUT = ATTACHMENTS_MAX_SEND or 12
local SENT_MAX = 50
local QUALITY: { [number]: string } = {
    [0] = "poor",
    "common",
    "uncommon",
    "rare",
    "epic",
    "legendary",
    "legendary",
    "legendary",
}

local function hex(token: string): string
    return assert(colors[token]).hex
end

local function coins(copper: number?): string
    local total = math.max(0, math.floor(copper or 0))
    local g, s, c = math.floor(total / 10000), math.floor(total / 100) % 100, total % 100
    local parts: string[] = {}
    local function part(v: number, unit: string, token: string)
        parts[#parts + 1] = v .. "|cff" .. hex(token) .. unit .. "|r"
    end
    if g > 0 then
        part(g, "g", "coin-gold")
    end
    if s > 0 or (g > 0 and c > 0) then
        part(s, "s", "coin-silver")
    end
    if c > 0 or #parts == 0 then
        part(c, "c", "coin-copper")
    end
    return table.concat(parts, " ")
end
local function tint(token: string, text: string): string
    return "|cff" .. hex(token) .. text .. "|r"
end

-- "12 d", "5 h", "under an hour" from the days a mail has left.
local function daysLeft(d: number?): string
    if not d then
        return ""
    end
    if d >= 1 then
        return math.floor(d) .. " d"
    end
    local h = math.floor(d * 24)
    return h >= 1 and (h .. " h") or "< 1 h"
end

-- "3 d ago" from a time() stamp.
local function ago(stamp: number?): string
    return format.ago(time() - (stamp or 0))
end

-- The game's mail functions, protected (an index past the inbox gives
-- nothing), their values read with wowlua:secret.
local try, asString, asNumber, flag = errors.try, secret.asString, secret.asNumber, secret.flag

--------------------------------------------------------------------------------
-- The inbox (read in Mail/Inbox; Collect all in Mail/Collect)
--------------------------------------------------------------------------------

export type Header = mails.Header
type MailId = mails.MailId
local header, inboxCount, ATTACH_IN, ENVELOPE = mails.header, mails.inboxCount, mails.ATTACH_IN, mails.ENVELOPE

-- A row of the inbox or of Sent: the item or envelope, who and what, the
-- time left or since, and what's attached.
export class MailRow extends Button
    readonly hl: Texture
    readonly rule: Texture
    readonly slot: ItemSlot
    readonly right: Text
    readonly right2: Text
    readonly sender: Text
    readonly subject: Text
    index: number? = nil
    -- the mail drawn on it (a click finds it again by this)
    mail: MailId? = nil
    selected: boolean = false

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(ROW_H)
        self.hl = UI.Fill(self, "arcane-soft", "BACKGROUND")
        self.hl:SetAllPoints()
        self.hl:Hide()
        self.rule = UI.Fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetPoint("BOTTOMLEFT")
        self.rule:SetPoint("BOTTOMRIGHT")
        self.rule:SetHeight(1)
        self.slot = UI.ItemSlot(self)
        SuuUI.Layout.Follow(self, function()
            self.slot:SetPoint("LEFT", S["space-2"], 0)
        end)
        self.slot:EnableMouse(false)
        self.right = UI.Text(self, "caption", "ink-muted")
        SuuUI.Layout.Follow(self, function()
            self.right:SetPoint("TOPRIGHT", -S["space-2"], -S["space-3"])
        end)
        self.right2 = UI.Text(self, "caption", "ink")
        SuuUI.Layout.Follow(self, function()
            self.right2:SetPoint("BOTTOMRIGHT", -S["space-2"], S["space-3"])
        end)
        self.sender = UI.Text(self, "label", "ink")
        SuuUI.Layout.Follow(self, function()
            self.sender:SetPoint("TOPLEFT", self.slot, "TOPRIGHT", S["space-4"], 0)
            self.sender:SetPoint("RIGHT", self.right, "LEFT", -S["space-2"], 0)
        end)
        self.sender:SetWordWrap(false)
        self.subject = UI.Text(self, "caption", "ink-muted")
        SuuUI.Layout.Follow(self, function()
            self.subject:SetPoint("BOTTOMLEFT", self.slot, "BOTTOMRIGHT", S["space-4"], 0)
            self.subject:SetPoint("RIGHT", self.right2, "LEFT", -S["space-2"], 0)
        end)
        self.subject:SetWordWrap(false)
        self:SetScript("OnEnter", function()
            if not self.selected then
                self.hl:Show()
                self.hl:SetAlpha(0.5)
            end
        end)
        self:SetScript("OnLeave", function()
            if not self.selected then
                self.hl:Hide()
            end
        end)
    end
end

-- An attachment's slot in the open mail.
class AttachSlot extends ItemSlotClass
    attachment: number = 0
end

-- The open mail beside the list.
export class OpenMail extends Frame
    readonly subject: Text
    readonly from: Text
    readonly delete: SuuButton
    readonly ret: SuuButton
    readonly reply: SuuButton
    readonly moneyRow: Frame
    readonly moneyText: Text
    readonly takeMoney: SuuButton
    readonly codRow: Frame
    readonly codText: Text
    readonly attach: Frame
    readonly slots: AttachSlot[] = {}
    readonly scroll: ScrollArea
    readonly body: Text

    constructor(m: MailModule, page: Frame)
        super(nil, page)
        self.subject = UI.Text(self, "unit-name-lg", "ink")
        self.subject:SetPoint("TOPLEFT")
        self.subject:SetPoint("RIGHT")
        self.subject:SetWordWrap(false)
        self.from = UI.Text(self, "caption", "ink-muted")
        SuuUI.Layout.Follow(self, function()
            self.from:SetPoint("TOPLEFT", self.subject, "BOTTOMLEFT", 0, -S["space-2"])
        end)
        -- the buttons at the foot of the pane
        self.delete = UI.Button(self, {
            text = "Delete",
            onClick = function()
                local i = m:OpenNow()
                if i then
                    m:TakeOver()
                    try(DeleteInboxItem, i)
                    m.openIndex, m.openId = nil, nil
                end
            end,
        })
        self.delete:SetPoint("BOTTOMRIGHT")
        self.ret = UI.Button(self, {
            text = "Return",
            onClick = function()
                local i = m:OpenNow()
                if i then
                    m:TakeOver()
                    try(ReturnInboxItem, i)
                    m.openIndex, m.openId = nil, nil
                end
            end,
        })
        SuuUI.Layout.Follow(self, function()
            self.ret:SetPoint("RIGHT", self.delete, "LEFT", -S["space-2"], 0)
        end)
        self.reply = UI.Button(self, {
            text = "Reply",
            onClick = function()
                local i = m:OpenNow()
                local h = i and header(i)
                if not h then
                    return
                end
                local send = assert(m.send)
                assert(m.window):SetTab("send")
                send.to:SetValue(h.sender)
                send.subject:SetValue((h.subject:find("^RE:") and "" or "RE: ") .. h.subject)
                send.body:SetFocus()
            end,
        })
        self.reply:SetPoint("BOTTOMLEFT")
        -- money and COD over the buttons
        self.moneyRow = CreateFrame("Frame", nil, self)
        self.moneyRow:SetHeight(30)
        SuuUI.Layout.Follow(self, function()
            self.moneyRow:SetPoint("BOTTOMLEFT", self.reply, "TOPLEFT", 0, S["space-4"])
        end)
        self.moneyRow:SetPoint("RIGHT")
        self.moneyText = UI.Text(self.moneyRow, "numeric", "ink")
        self.moneyText:SetPoint("LEFT")
        self.takeMoney = UI.Button(self.moneyRow, {
            text = "Take",
            width = 70,
            onClick = function()
                local i = m:OpenNow()
                if i then
                    m:TakeOver()
                    try(TakeInboxMoney, i)
                end
            end,
        })
        self.takeMoney:SetPoint("RIGHT")
        self.codRow = CreateFrame("Frame", nil, self)
        self.codRow:SetHeight(20)
        SuuUI.Layout.Follow(self, function()
            self.codRow:SetPoint("BOTTOMLEFT", self.moneyRow, "TOPLEFT", 0, S["space-2"])
        end)
        self.codRow:SetPoint("RIGHT")
        self.codText = UI.Text(self.codRow, "label", "ink")
        self.codText:SetPoint("LEFT")
        -- the attachments over the money
        self.attach = CreateFrame("Frame", nil, self)
        SuuUI.Layout.Follow(self, function()
            self.attach:SetPoint("BOTTOMLEFT", self.codRow, "TOPLEFT", 0, S["space-4"])
        end)
        self.attach:SetPoint("RIGHT")
        self.attach:SetHeight(1)
        for a = 1, ATTACH_IN do
            local b = AttachSlot.new(self.attach)
            b:SetScript("OnEnter", function()
                local i = m.openIndex
                if not i then
                    return
                end
                GameTooltip:SetOwner(b, "ANCHOR_RIGHT")
                GameTooltip:SetInboxItem(i, b.attachment)
                GameTooltip:Show()
            end)
            b:SetScript("OnLeave", function()
                GameTooltip:Hide()
            end)
            b:SetScript("OnClick", function()
                local i = m:OpenNow()
                if not i then
                    return
                end
                local link = asString(try(GetInboxItemLink, i, b.attachment))
                if link and IsModifiedClick() and HandleModifiedItemClick(link) then
                    return
                end
                m:Take(b.attachment)
            end)
            b:Hide()
            self.slots[a] = b
        end
        -- the message between the header and the attachments
        self.scroll = UI.ScrollArea(self, S["space-3"])
        SuuUI.Layout.Follow(self, function()
            self.scroll:SetPoint("TOPLEFT", self.from, "BOTTOMLEFT", 0, -S["space-5"])
            self.scroll:SetPoint("BOTTOMRIGHT", self.attach, "TOPRIGHT", -(S["space-3"] + 3), S["space-4"])
        end)
        self.body = UI.Text(self.scroll.child, "body", "ink")
        self.body:SetPoint("TOPLEFT")
        self.body:SetJustifyH("LEFT")
        self.body:SetWordWrap(true)
        self.scroll:HookScript("OnSizeChanged", function(scroll, w)
            scroll.child:SetWidth(w)
            self.body:SetWidth(w)
            scroll.child:SetHeight(math.max(1, self.body:GetStringHeight()))
        end)
        hook(self.body, "SetText", function()
            self.scroll.child:SetHeight(math.max(1, self.body:GetStringHeight()))
        end)
    end
end

-- The Inbox page: Collect all and Collect money, the list, the open mail.
export type Inbox = {
    rows: MailRow[],
    collect: SuuButton,
    money: SuuButton,
    count: Text,
    note: Text,
    list: ScrollArea,
    empty: Text,
    open: OpenMail,
    none: Text,
}

--------------------------------------------------------------------------------
-- Send
--------------------------------------------------------------------------------

-- The Send page: To, Subject, the message and its counter, the attachments,
-- money or COD, the postage and Send.
export type SendForm = {
    to: TextField,
    subject: TextField,
    body: EditBox,
    well: Frame,
    counter: Text,
    slots: ItemSlot[],
    mode: Segmented<string>,
    money: MoneyInput,
    postage: Text,
    go: SuuButton,
}

-- A mail on its way, then in Sent.
export type SentItem = { name?: string, icon?: number | string, count?: number }
export type SentMail = { to: string, subject: string, items: SentItem[], money: number, cod: number, at?: number }

-- What a character keeps: the mails it sent, and who it is (for the other
-- characters' suggestions).
export type MailChar = {
    sent?: SentMail[],
    -- the inbox as last read (0.48; Mail/Inbox keep)
    inbox?: mails.KeptInbox,
    name?: string,
    realm?: string,
    level?: number,
    class?: string,
    faction?: string,
}

--------------------------------------------------------------------------------
-- To's suggestions: your characters, the people you sent to lately, and the
-- guild members whose name matches what you typed
--------------------------------------------------------------------------------

local SUGGEST_ROW, SUGGEST_HEAD = 26, 20
local SUGGEST_MAX_H = 360 -- then the list scrolls
local GUILD_MAX = 30 -- guild members shown: online first, filtered by what's typed

local function classToken(file: unknown): string
    local f = asString(file)
    return f and colors["class-" .. f:lower()] and ("class-" .. f:lower()) or "ink"
end

-- "Online", or "last online 3 d" from the roster.
local function lastOnline(i: number): string
    local ry, rmo, rd, rh = try(GetGuildRosterLastOnline, i)
    local y, mo, d, h = asNumber(ry), asNumber(rmo), asNumber(rd), asNumber(rh)
    if not (y or mo or d or h) then
        return "Offline"
    end
    y, mo, d, h = y or 0, mo or 0, d or 0, h or 0
    if y > 0 then
        return "last online " .. y .. " y"
    end
    if mo > 0 then
        return "last online " .. mo .. " mo"
    end
    if d > 0 then
        return "last online " .. d .. " d"
    end
    if h > 0 then
        return "last online " .. h .. " h"
    end
    return "last online < 1 h"
end

-- The groups for what's typed.
export type SuggestRow = {
    name: string,
    color: string,
    note?: string,
    right?: string,
    diamond?: boolean,
    online?: boolean,
}
export type SuggestGroup = { title: string, rows: SuggestRow[] }

-- A suggestion's row in the list.
class SuggestButton extends Button
    readonly hl: Texture
    readonly dot: Texture
    readonly name: Text
    readonly note: Text
    readonly right: Text
    row: SuggestRow? = nil
    flatIndex: number = 0
    y: number = 0

    constructor(m: MailModule, list: SuggestList)
        super(nil, list.scroll.child)
        self:SetHeight(SUGGEST_ROW)
        self.hl = UI.Fill(self, "arcane-soft", "BACKGROUND")
        self.hl:SetAllPoints()
        self.dot = UI.Diamond(self, 5, "ink")
        SuuUI.Layout.Follow(self, function()
            self.dot:SetPoint("LEFT", S["space-4"], 0)
        end)
        self.name = UI.Text(self, "label", "ink")
        self.note = UI.Text(self, "caption", "ink-muted")
        self.right = UI.Text(self, "caption", "ink-muted")
        SuuUI.Layout.Follow(self, function()
            self.right:SetPoint("RIGHT", -S["space-4"], 0)
        end)
        self:SetScript("OnEnter", function()
            list.pick = self.flatIndex
            m:DrawSuggest(true)
        end)
        self:SetScript("OnClick", function()
            local row = self.row
            if row then
                m:PickSuggest(row)
            end
        end)
    end
end

-- The dropdown under To: the groups' heads and rows (a long list scrolls),
-- the highlighted one, what was last drawn.
export class SuggestList extends Frame
    readonly heads: Text[] = {}
    readonly rows: SuggestButton[] = {}
    readonly scroll: ScrollArea
    flat: SuggestRow[] = {}
    groups: SuggestGroup[] = {}
    pick: number = 1
    lastText: string? = nil

    constructor(window: Frame, field: TextField)
        super(nil, window)
        self:SetFrameStrata("FULLSCREEN_DIALOG")
        self:SetPoint("TOPLEFT", field, "BOTTOMLEFT", 0, -S["space-2"])
        self:SetPoint("TOPRIGHT", field, "BOTTOMRIGHT", 0, -S["space-2"])
        UI.Fill(self, "surface"):SetAllPoints()
        UI.Border(self, "gilt-line")
        UI.Shadow(self, "shadow-panel")
        self:Hide()
        -- a long list (the whole guild) scrolls: wheel, bar, or the arrow keys;
        -- the rows end before the bar's own lane inside the border
        self.scroll = UI.ScrollArea(self, S["space-2"])
        self.scroll:SetPoint("TOPLEFT", 1, -1)
        SuuUI.Layout.Follow(self, function()
            self.scroll:SetPoint("BOTTOMRIGHT", -(S["space-2"] * 2 + 3), 1)
        end)
        self.scroll:HookScript("OnSizeChanged", function(sc, w)
            sc.child:SetWidth(w)
        end)
    end
end

-- The Sent page.
export type Sent = { rows: MailRow[], list: ScrollArea, empty: Text }

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

class MailModule extends Module<typeof(DEFAULTS)>
    away: AwayHandle? = nil
    awayOpen: AwayHandle? = nil
    -- Collect all and Collect money (Mail/Collect)
    readonly collector: Collector
    inbox: Inbox? = nil
    open: boolean = false
    -- raised each time the mailbox opens or closes: a question asked on an
    -- earlier visit acts on nothing
    visit: number = 0
    -- the open mail: where it was, and what it was when last drawn (acting
    -- on it finds it again by this, see Mail/Inbox)
    openIndex: number? = nil
    openId: MailId? = nil
    -- the open question to pay a COD, and its answer (the dialog is shared:
    -- it is ours while it holds that answer)
    codAsk: ConfirmDialog? = nil
    codYes: (() -> ())? = nil
    readonly pages: { [string]: Frame } = {}
    pending: SentMail? = nil
    refreshPending: boolean? = nil
    send: SendForm? = nil
    -- the mail Send waits for (a later Send has another)
    sendMark: {}? = nil
    sending: boolean = false
    sent: Sent? = nil
    suggest: SuggestList? = nil
    tab: string? = nil
    window: WindowFrame? = nil
    -- the inbox kept, once the game's updates settle; each character's as a
    -- holding (InboxHolding), until read again or a mail expires
    keepQueued: boolean = false
    held: { [string]: { at: number, next?: number, h: Holding } } = {}

    constructor()
        super({
            id = "mail",
            name = "Mail",
            description = "SuuUI's mail window: the whole inbox with Collect all, sending with suggestions, and the mails you sent.",
            api = "0.17",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
        self.collector = Collector.new({
            open = function(): boolean
                return self.open
            end,
            after = function(seconds: number, fn: () -> ())
                self:After(seconds, fn)
            end,
            changed = function()
                self:Refresh()
            end,
            done = function(left: Left[], took: number)
                self:CollectDone(left, took)
            end,
        })
    end

    -- What this character keeps (its data, typed).
    function MailData(): MailChar
        return self:CharData() :: unknown :: MailChar
    end

    ----------------------------------------------------------------------------
    -- Each character's inbox as last read (SuuUI.Holdings' "mail")
    ----------------------------------------------------------------------------

    -- The inbox kept now, once the game's updates settle (Collect all
    -- tells one a take), while the mailbox is open; told to the holdings'
    -- readers.
    function QueueKeep()
        if self.keepQueued then
            return
        end
        self.keepQueued = true
        self:After(0.3, function()
            self.keepQueued = false
            if self.open then
                self:KeepInbox()
            end
        end)
    end

    function KeepInbox()
        local key = self:CharKey()
        if not key then
            return
        end
        self:MailData().inbox = mails.keep(time())
        self.held[key] = nil
        SuuUI.Holdings.Changed(self, "mail", key)
    end

    -- A character's inbox as a holding (nil: never read): made once until
    -- it is read again or one of its mails expires.
    function InboxHolding(key: string): Holding?
        local d = self:AllCharData()[key] :: unknown :: MailChar?
        local kept = d and d.inbox
        if not kept then
            self.held[key] = nil
            return nil
        end
        local now = time()
        local c = self.held[key]
        if c and c.at == kept.at and (not c.next or now < c.next) then
            return c.h
        end
        local h, nextEnd = mails.holdingOf(kept, now)
        if not h then
            return nil
        end
        self.held[key] = { at = kept.at, next = nextEnd, h = h }
        return h
    end

    -- Takes one thing at a time, each once the game has answered the last,
    -- until nothing it may take is left or the mailbox closes (Mail/Collect).
    function CollectAll(moneyOnly: boolean)
        if self.collector.running then
            return
        end
        self:Note("")
        self.collector:Start(moneyOnly)
    end

    function Collecting(): boolean
        return self.collector.running
    end

    -- The player acts on a mail: Collect all stops first (one request at a
    -- time, and the answer is the player's take, not the run's).
    function TakeOver()
        if self.collector.running then
            self.collector:Stop()
            self:Note("Collect all stopped.")
        end
    end

    -- A line by the inbox's count: what just happened.
    function Note(text: string)
        local inbox = self.inbox
        if inbox then
            inbox.note:SetValue(text)
        end
    end

    -- A run ended: what stayed in the mail, and why (the game's words when
    -- it gave any), by the count and in chat.
    function CollectDone(left: Left[], took: number)
        if #left == 0 then
            self:Note(took > 0 and "Collected." or "")
            return
        end
        local reasons: { [string]: boolean }, first: string? = {}, nil
        local count = 0
        for _, l in ipairs(left) do
            if not reasons[l.why] then
                reasons[l.why] = true
                count = count + 1
                first = first or l.why
            end
        end
        local what = #left == 1 and "1 thing" or (#left .. " things")
        self:Note(what .. " left in the mail: " .. (count == 1 and (first or "") or "see chat"))
        self:Print("Collect all left " .. what .. " in the mail:")
        local SHOWN = 10
        for k, l in ipairs(left) do
            if k > SHOWN then
                self:Print(("  and %d more"):format(#left - SHOWN))
                break
            end
            local thing = l.money and coins(l.count) or
                ((l.name ~= "" and l.name or "an item") .. (l.count > 1 and (" x" .. l.count) or ""))
            self:Print(("  %s from %s: %s"):format(thing, l.sender, l.why))
        end
    end

    -- The open mail's index if it is still exactly the mail the pane shows;
    -- else nil, nothing is to be done, and the pane is drawn again.
    function OpenNow(): number?
        local id = self.openId
        local j = id and mails.find(id, self.openIndex)
        if not j then
            if id then
                self:Note("That mail changed: nothing was done. Look at it again.")
            end
            self:Refresh()
            return nil
        end
        self.openIndex = j
        return j
    end

    -- Where the open mail is now: the mail last drawn, or the same mail with
    -- less in it (taken from since); nil when it is gone.
    function ResolveOpen(): number?
        local id = self.openId
        local j = id and (mails.find(id, self.openIndex) or mails.find(id, self.openIndex, mails.follows))
        self.openIndex = j
        if not j then
            self.openId = nil
        end
        return j
    end

    -- A row clicked: its mail opened, found again by what the row showed (a
    -- modified click loots it whole, never a COD).
    function OpenRow(r: MailRow)
        local id = r.mail
        local j = id and mails.find(id, r.index)
        if not id or not j then
            self:Refresh()
            return
        end
        if IsModifiedClick("AUTOLOOTTOGGLE") and id.cod == 0 then
            self:TakeOver()
            try(AutoLootMailItem, j)
        end
        self.openIndex, self.openId = j, id
        self:Refresh()
    end

    function DrawInbox()
        local inbox = assert(self.inbox)
        local n, total = inboxCount()
        local c = inbox.list.child
        inbox.count:SetValue(
            total > n and ("%d mails, %d more once these are gone"):format(n, total - n) or
                (n == 1 and "1 mail" or (n .. " mails"))
        )
        local collecting = self.collector.running
        inbox.collect:SetEnabledState(not collecting and nextTake(false) ~= nil)
        inbox.collect:SetLabel(collecting and "Collecting…" or "Collect all")
        inbox.money:SetEnabledState(not collecting and nextTake(true) ~= nil)
        local open = self:ResolveOpen()
        local rows = inbox.rows
        for i = 1, math.max(n, #rows) do
            local r = rows[i]
            if i <= n then
                if not r then
                    r = MailRow.new(c)
                    rows[i] = r
                    r:SetScript("OnClick", function(row)
                        self:OpenRow(row)
                    end)
                end
                local h = header(i)
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", 0, -(i - 1) * ROW_H)
                r:SetPoint("RIGHT", c, "RIGHT")
                r.index = i
                r.mail = mails.identify(i)
                r.slot.skin:SetItem({ icon = h and h.icon or ENVELOPE, quality = "common" })
                r.sender:SetValue(h and h.sender or "")
                r.sender:SetColor(h and not h.read and "gilt-text" or "ink")
                r.subject:SetValue(h and h.subject or "")
                local days = h and h.days
                r.right:SetValue(h and (days and days <= 3 and tint("amber", daysLeft(days)) or daysLeft(days)) or "")
                local what = ""
                if h then
                    if h.cod > 0 then
                        what = tint("amber", "COD " .. coins(h.cod))
                    elseif h.money > 0 then
                        what = coins(h.money)
                    elseif h.items > 0 then
                        what = h.items == 1 and "1 item" or (h.items .. " items")
                    end
                end
                r.right2:SetValue(what)
                r.selected = open == i
                r.hl:SetShown(r.selected)
                r.hl:SetAlpha(1)
                r.rule:SetShown(i < n)
                r:Show()
            elseif r then
                r:Hide()
            end
        end
        c:SetHeight(math.max(1, n * ROW_H))
        inbox.empty:SetShown(n == 0)
        self:DrawOpen()
    end

    -- The open mail beside the list.
    function DrawOpen()
        local inbox = assert(self.inbox)
        local p = inbox.open
        local i = self.openIndex
        local h = i and header(i)
        p:SetShown(h ~= nil)
        inbox.none:SetShown(h == nil)
        if not i or not h then
            self.openIndex, self.openId = nil, nil
            return
        end
        -- what the pane shows from here on: what acting on it must find again
        self.openId = mails.identify(i)
        local body, _, _, _, isInvoice = try(GetInboxText, i)
        p.subject:SetValue(h.subject ~= "" and h.subject or "(no subject)")
        p.from:SetValue("From " .. h.sender .. (h.returned and "  ·  returned" or ""))
        local text = asString(body) or ""
        if flag(isInvoice) then
            local kindR, itemR, playerR, bidR, buyoutR, depositR, cutR = try(GetInboxInvoiceInfo, i)
            local kind, itemName, playerName = asString(kindR), asString(itemR), asString(playerR)
            local bid, buyout, deposit, cut = asNumber(bidR), asNumber(buyoutR), asNumber(depositR), asNumber(cutR)
            local lines: string[] = {}
            if kind == "seller" then
                lines[#lines + 1] = "Item sold: " .. (itemName or "?")
                lines[#lines + 1] = "Buyer: " .. (playerName or "?")
                lines[#lines + 1] = "Sale price: " .. coins(bid or buyout or 0)
                lines[#lines + 1] = "Deposit: " .. coins(deposit or 0)
                lines[#lines + 1] = "Auction house cut: " .. coins(cut or 0)
                lines[#lines + 1] = "Amount received: " .. coins((bid or 0) + (deposit or 0) - (cut or 0))
            elseif kind == "buyer" then
                lines[#lines + 1] = "Item bought: " .. (itemName or "?")
                lines[#lines + 1] = "Seller: " .. (playerName or "?")
                lines[#lines + 1] = "Price: " .. coins(bid or buyout or 0)
            end
            if #lines > 0 then
                text = table.concat(lines, "\n") .. (text ~= "" and ("\n\n" .. text) or "")
            end
        end
        p.body:SetValue(text)
        -- attachments, then money and COD
        local used = 0
        for a = 1, ATTACH_IN do
            local _, _, texture, count, quality = try(GetInboxItem, i, a)
            local tex = asNumber(texture) or asString(texture)
            local b = p.slots[a]
            if tex then
                used = used + 1
                b:ClearAllPoints()
                local col, row = (used - 1) % 8, math.floor((used - 1) / 8)
                b:SetPoint("TOPLEFT", p.attach, "TOPLEFT", col * (36 + S["space-2"]), -row * (36 + S["space-2"]))
                b.skin:SetItem({
                    icon = tex,
                    count = asNumber(count),
                    quality = QUALITY[asNumber(quality) or 1] or "common",
                })
                b.attachment = a
                b:Show()
            else
                b:Hide()
            end
        end
        p.attach:SetHeight(used > 0 and (math.ceil(used / 8) * (36 + S["space-2"])) or 1)
        p.moneyRow:SetShown(h.money > 0)
        p.moneyText:SetValue(coins(h.money))
        p.codRow:SetShown(h.cod > 0)
        p.codText:SetValue(tint("amber", "Cash on delivery: " .. coins(h.cod)))
        p.reply:SetEnabledState(h.canReply)
        local canDelete = flag(try(InboxItemCanDelete, i))
        -- Delete only once nothing is attached; Return a player's mail
        p.delete:SetEnabledState(canDelete and h.items == 0 and h.money == 0)
        p.delete.tooltip = (h.items > 0 or h.money > 0) and
            { title = "Delete", description = "Take what's attached first." } or
            nil
        p.ret:SetShown(not canDelete and not h.returned)
    end

    -- Takes an attachment of the open mail; asks first for COD.
    function Take(a: number)
        local i = self:OpenNow()
        local id = self.openId
        local it = id and mails.attachmentAt(id, a)
        if not i or not id or not it then
            return
        end
        if id.cod > 0 then
            if id.cod > (GetMoney() or 0) then
                UI.Confirm({
                    title = "Not enough money",
                    text = "Cash on delivery: " .. coins(id.cod) .. ". You have " .. coins(GetMoney() or 0) .. ".",
                    confirm = "OK",
                    cancel = false,
                })
                return
            end
            local visit = self.visit
            local thing = (it.name ~= "" and it.name or "this") .. (it.count > 1 and (" x" .. it.count) or "")
            local onConfirm = function()
                self:TakeCod(visit, id, a)
            end
            self.codYes = onConfirm
            self.codAsk = UI.Confirm({
                title = "Pay cash on delivery?",
                text = ("Pay %s to %s for %s?"):format(coins(id.cod), id.sender, thing),
                confirm = "Pay",
                onConfirm = onConfirm,
            })
            return
        end
        self:TakeOver()
        try(TakeInboxItem, i, a)
    end

    -- The COD confirmed: taken (and paid) only from the very mail the
    -- question was about, on the same visit to the mailbox, with the money
    -- there; if it has gone or changed, nothing.
    function TakeCod(visit: number, id: MailId, a: number)
        self.codAsk, self.codYes = nil, nil
        if not self.open or self.visit ~= visit then
            self:Print("The mailbox closed: nothing was taken or paid.")
            return
        end
        local j = mails.find(id, self.openIndex)
        if not j then
            self:Note("That mail changed or is gone: nothing was taken or paid.")
            self:Refresh()
            return
        end
        if id.cod > (GetMoney() or 0) then
            self:Note("Not enough money for the cash on delivery: nothing was taken.")
            return
        end
        self:TakeOver()
        try(TakeInboxItem, j, a)
    end

    function BuildInbox(page: Frame)
        local collect = UI.Button(page, {
            text = "Collect all",
            variant = "primary",
            width = 120,
            onClick = function()
                self:CollectAll(false)
            end,
            tooltip = {
                title = "Collect all",
                description = "Every item and the money of every mail; mails with cash on delivery, and a game master's, stay for you to open.",
            },
        })
        collect:SetPoint("TOPLEFT")
        local money = UI.Button(page, {
            text = "Collect money",
            onClick = function()
                self:CollectAll(true)
            end,
        })
        money:SetPoint("LEFT", collect, "RIGHT", S["space-2"], 0)
        local count = UI.Text(page, "caption", "ink-muted")
        count:SetPoint("LEFT", money, "RIGHT", S["space-4"], 0)
        -- what just happened: what Collect all left, an act refused
        local note = UI.Text(page, "caption", "amber")
        SuuUI.Layout.Follow(page, function()
            note:SetPoint("LEFT", count, "RIGHT", S["space-4"], 0)
        end)
        note:SetPoint("RIGHT")
        note:SetJustifyH("LEFT")
        note:SetWordWrap(false)
        local BAR = S["space-3"]
        local list = UI.ScrollArea(page, BAR)
        list:SetPoint("TOPLEFT", 0, -(30 + S["space-4"]))
        list:SetPoint("BOTTOMLEFT")
        list:SetWidth(LIST_W)
        list.child:SetWidth(LIST_W)
        local empty = UI.Text(list.child, "body", "ink-muted")
        empty:SetPoint("TOPLEFT", 0, -S["space-4"])
        empty:SetValue("Your mailbox is empty.")
        -- the open mail
        local p = OpenMail.new(self, page)
        p:SetPoint("TOPLEFT", LIST_W + BAR + 3 + S["space-5"], -(30 + S["space-4"]))
        p:SetPoint("BOTTOMRIGHT")
        local none = UI.Text(page, "body", "ink-muted")
        none:SetPoint("TOPLEFT", p, "TOPLEFT")
        none:SetValue("Choose a mail to read it.")
        self.inbox = {
            rows = {},
            collect = collect,
            money = money,
            count = count,
            note = note,
            list = list,
            empty = empty,
            open = p,
            none = none,
        }
    end

    function BuildSend(page: Frame)
        local labelW = 70
        local function label(text: string, y: number)
            local l = UI.Text(page, "label", "ink-muted")
            l:SetValue(text)
            l:SetPoint("TOPLEFT", 0, y)
        end
        label("To", -7)
        -- as wide as Subject; its suggestions under it take its width
        local to = UI.TextField(page, {
            width = WIDTH - 2 * S["space-5"] - labelW,
            onTextChanged = function()
                self:DrawSendState()
            end,
        })
        to:SetPoint("TOPLEFT", labelW, 0)
        label("Subject", -(30 + S["space-4"] + 7))
        local subject = UI.TextField(page, {
            width = WIDTH - 2 * S["space-5"] - labelW,
            onTextChanged = function()
                self:DrawSendState()
            end,
        })
        subject:SetPoint("TOPLEFT", labelW, -(30 + S["space-4"]))
        subject.edit:SetMaxLetters(64)
        -- the message: a multi-line field in a sunk well, 500 characters
        local well = CreateFrame("Frame", nil, page)
        -- the message, attachments and money start where To and Subject do
        well:SetPoint("TOPLEFT", labelW, -2 * (30 + S["space-4"]))
        well:SetPoint("RIGHT")
        well:SetHeight(150)
        UI.Fill(well, "surface-sunk"):SetAllPoints()
        UI.Border(well, "gilt-line")
        local scroll = UI.ScrollArea(well, -S["space-3"])
        scroll:SetPoint("TOPLEFT", S["space-4"], -S["space-3"])
        scroll:SetPoint("BOTTOMRIGHT", -S["space-5"], S["space-3"])
        local counter = UI.Text(page, "caption", "ink-muted")
        counter:SetPoint("TOPRIGHT", well, "BOTTOMRIGHT", 0, -S["space-2"])
        counter:SetValue("0 / " .. (MAX_MAIL_TEXT_LENGTH or 500))
        local e = CreateFrame("EditBox", nil, scroll.child)
        e:SetMultiLine(true)
        e:SetAutoFocus(false)
        e:SetFontObject(subject.edit:GetFontObject())
        e:SetMaxLetters(MAX_MAIL_TEXT_LENGTH or 500)
        e:SetPoint("TOPLEFT")
        e:SetScript("OnEscapePressed", function(box)
            box:ClearFocus()
        end)
        e:SetScript("OnTextChanged", function(box)
            scroll.child:SetHeight(math.max(scroll:GetHeight(), box:GetHeight()))
            counter:SetValue(("%d / %d"):format(#(box:GetText() or ""), MAX_MAIL_TEXT_LENGTH or 500))
        end)
        scroll:HookScript("OnSizeChanged", function(s, w)
            s.child:SetWidth(w)
            e:SetWidth(w)
        end)
        well:EnableMouse(true)
        well:SetScript("OnMouseDown", function()
            e:SetFocus()
        end)
        -- the attachments: drop or click an item from your bags, right click takes it back
        -- (no hint line: everyone knows how to attach an item)
        local attachY = 2 * (30 + S["space-4"]) + 150 + S["space-5"] + 4
        local slots: ItemSlot[] = {}
        for a = 1, ATTACH_OUT do
            local b = UI.ItemSlot(page)
            b:SetPoint("TOPLEFT", labelW + (a - 1) * (36 + S["space-2"]), -attachY - 4)
            b:RegisterForClicks("LeftButtonUp", "RightButtonUp")
            b:RegisterForDrag("LeftButton")
            b:SetScript("OnClick", function(_, button)
                try(ClickSendMailItemButton, a, button == "RightButton")
            end)
            b:SetScript("OnReceiveDrag", function()
                try(ClickSendMailItemButton, a)
            end)
            b:SetScript("OnEnter", function(btn)
                if not flag(try(HasSendMailItem, a)) then
                    return
                end
                GameTooltip:SetOwner(btn, "ANCHOR_RIGHT")
                GameTooltip:SetSendMailItem(a)
                GameTooltip:Show()
            end)
            b:SetScript("OnLeave", function()
                GameTooltip:Hide()
            end)
            slots[a] = b
        end
        -- money: send it, or ask it on delivery
        local moneyY = attachY + 36 + S["space-5"] + 4
        local mode = UI.Segmented(page, {
            options = { { value = "send", label = "Send money" }, { value = "cod", label = "Cash on delivery" } },
            value = "send",
            onChange = function()
                self:DrawSendState()
            end,
        })
        mode:SetPoint("TOPLEFT", labelW, -moneyY)
        local money = UI.MoneyInput(page, {
            onChange = function()
                self:DrawSendState()
            end,
        })
        money:SetPoint("LEFT", mode, "RIGHT", S["space-5"], 0)
        -- the foot: postage and Send
        local postage = UI.Text(page, "label", "ink-muted")
        postage:SetPoint("BOTTOMLEFT", 0, 7)
        local go = UI.Button(page, {
            text = "Send",
            variant = "primary",
            width = 110,
            onClick = function()
                self:Send()
            end,
        })
        go:SetPoint("BOTTOMRIGHT")
        self.send = {
            to = to,
            subject = subject,
            body = e,
            well = well,
            counter = counter,
            slots = slots,
            mode = mode,
            money = money,
            postage = postage,
            go = go,
        }
        self:BuildSuggest(to)
    end

    -- The attachments, the postage and whether Send can go.
    function DrawSendState()
        local send = self.send
        if not send then
            return
        end
        local first: string? = nil
        for a = 1, ATTACH_OUT do
            local b = send.slots[a]
            if flag(try(HasSendMailItem, a)) then
                local name, _, texture, count, quality = try(GetSendMailItem, a)
                first = first or asString(name)
                b.skin:SetItem({
                    icon = asNumber(texture) or asString(texture),
                    count = asNumber(count),
                    quality = QUALITY[asNumber(quality) or 1] or "common",
                })
            else
                b.skin:SetItem(nil)
            end
        end
        -- an attachment names an empty subject, as the game does
        if first and (send.subject.edit:GetText() or "") == "" and not send.subject.edit:HasFocus() then
            send.subject:SetValue(first)
        end
        local postage = asNumber(try(GetSendMailPrice)) or 0
        local copper = send.money:GetCopper()
        local total = postage + ((send.mode.value or "send") == "send" and copper or 0)
        send.postage:SetValue(
            "Postage " .. coins(postage) .. (total > postage and ("  ·  in all " .. coins(total)) or "")
        )
        local to = strtrim(send.to.edit:GetText() or "")
        local subject = strtrim(send.subject.edit:GetText() or "")
        local cod = (send.mode.value or "send") == "cod"
        local ok, why = true, nil
        if to == "" then
            ok, why = false, "Who is it for?"
        end
        if ok and subject == "" then
            ok, why = false, "Give it a subject."
        end
        if ok and cod and (copper == 0 or not first) then
            ok, why = false, "Cash on delivery needs an amount and an attachment."
        end
        if ok and total > (GetMoney() or 0) then
            ok, why = false, "You don't have enough money."
        end
        if self.sending then
            why = "Waiting for the game: the mail is on its way, or its confirmation is open."
        end
        send.go:SetLabel(self.sending and "Sending…" or "Send")
        send.go:SetEnabledState(ok and not self.sending)
        send.go.tooltip = why and { title = "Send", description = why } or nil
    end

    function Send()
        local send = assert(self.send)
        local to = strtrim(send.to.edit:GetText() or "")
        local subject = strtrim(send.subject.edit:GetText() or "")
        local body = send.body:GetText() or ""
        local copper = send.money:GetCopper()
        local cod = (send.mode.value or "send") == "cod"
        try(SetSendMailCOD, 0)
        try(SetSendMailMoney, 0)
        if copper > 0 then
            if cod then
                try(SetSendMailCOD, copper)
            else
                try(SetSendMailMoney, copper)
            end
        end
        -- what goes out, for the Sent list once the game says it went
        local items: SentItem[] = {}
        for a = 1, ATTACH_OUT do
            if flag(try(HasSendMailItem, a)) then
                local name, _, texture, count = try(GetSendMailItem, a)
                items[#items + 1] = {
                    name = asString(name),
                    icon = asNumber(texture) or asString(texture),
                    count = asNumber(count),
                }
            end
        end
        self.pending = {
            to = to,
            subject = subject,
            items = items,
            money = cod and 0 or copper,
            cod = cod and copper or 0,
        }
        self.sending = true
        self:DrawSendState()
        SendMail(to, subject, body)
        -- never stuck: if neither success nor failure comes, Send comes back
        local mark = {}
        self.sendMark = mark
        self:After(30, function()
            if self.sending and self.sendMark == mark then
                self:SendDone(false)
            end
        end)
    end

    function SendDone(ok: boolean)
        self.sending = false
        local p = self.pending
        if ok and p then
            local data = self:MailData()
            local sent = data.sent or {}
            data.sent = sent
            p.at = time()
            table.insert(sent, 1, p)
            while #sent > SENT_MAX do
                table.remove(sent)
            end
            local send = assert(self.send)
            send.subject:SetValue("")
            send.body:SetText("")
            send.money:Clear()
            send.mode:SetValue("send")
        end
        self.pending = nil
        self:DrawSendState()
    end

    function Suggestions(text: string?): SuggestGroup[]
        local typed = strtrim(text or ""):lower()
        local seen: { [string]: boolean }, groups: SuggestGroup[] = {}, {}
        local function matches(name: string): number?
            if typed == "" then
                return 1
            end
            local low = name:lower()
            if low:sub(1, #typed) == typed then
                return 1
            end
            if low:find(typed, 1, true) then
                return 2
            end
            return nil
        end
        local function add(title: string, rows: SuggestRow[])
            local out: SuggestRow[] = {}
            for _, r in ipairs(rows) do
                local key = r.name:lower()
                if not seen[key] then
                    seen[key] = true
                    out[#out + 1] = r
                end
            end
            if #out > 0 then
                groups[#groups + 1] = { title = title, rows = out }
            end
        end
        -- your characters on this realm and side
        local me = self:MailData()
        local mine: SuggestRow[] = {}
        for key, raw in pairs(self:AllCharData()) do
            local d = raw :: unknown :: MailChar
            local name = d.name
            if key ~= self:CharKey() and name and d.realm == me.realm and d.faction == me.faction and matches(name) then
                mine[#mine + 1] = {
                    name = name,
                    color = classToken(d.class),
                    right = d.level and ("level " .. d.level) or nil,
                }
            end
        end
        table.sort(mine, function(a: SuggestRow, b: SuggestRow): boolean
            return a.name < b.name
        end)
        add("Your characters", mine)
        -- the people you sent to lately
        local recent: SuggestRow[], had: { [string]: boolean } = {}, {}
        for _, e in ipairs(me.sent or {}) do
            if e.to and not had[e.to:lower()] and matches(e.to) then
                had[e.to:lower()] = true
                recent[#recent + 1] = { name = e.to, color = "ink", right = ago(e.at) }
            end
        end
        add("Recent", recent)
        -- the guild: with nothing typed up to 30, online first; else the matches
        if IsInGuild() then
            local first: SuggestRow[], rest: SuggestRow[] = {}, {}
            local myName = Ambiguate(asString(SuuUI.FullName("player")) or "", "short")
            for i = 1, asNumber(try(GetNumGuildMembers)) or 0 do
                local fullR, rankR, _, _, _, _, _, _, onlineR, _, file = try(GetGuildRosterInfo, i)
                local full = asString(fullR)
                if full then
                    local name = Ambiguate(full, "mail")
                    local m = matches(name)
                    if m and Ambiguate(full, "short") ~= myName then
                        local online = flag(onlineR)
                        local row: SuggestRow = {
                            name = name,
                            color = classToken(file),
                            note = asString(rankR),
                            right = online and inlineMark("dot", "fel") .. " Online" or lastOnline(i),
                            diamond = true,
                            online = online,
                        }
                        if typed == "" then
                            if online then
                                first[#first + 1] = row
                            else
                                rest[#rest + 1] = row
                            end
                        elseif m == 1 then
                            first[#first + 1] = row
                        else
                            rest[#rest + 1] = row
                        end
                    end
                end
            end
            table.sort(first, function(a: SuggestRow, b: SuggestRow): boolean
                return a.name < b.name
            end)
            table.sort(rest, function(a: SuggestRow, b: SuggestRow): boolean
                return a.name < b.name
            end)
            local guild: SuggestRow[] = {}
            for _, list in ipairs({ first, rest }) do
                for _, r in ipairs(list) do
                    if #guild < GUILD_MAX then
                        guild[#guild + 1] = r
                    end
                end
            end
            add("Guild", guild)
        end
        return groups
    end

    function BuildSuggest(field: TextField)
        local d = SuggestList.new(assert(self.window), field)
        self.suggest = d
        local edit = field.edit
        edit:SetAltArrowKeyMode(false)
        -- (guarded: an error here is recorded under the module's name)
        -- any change of the text while you're in the field (not only the ones
        -- the game flags as typed)
        edit:HookScript(
            "OnTextChanged",
            self:Guard(function(box: EditBox)
                local text = box:GetText() or ""
                if text == d.lastText or not box:HasFocus() then
                    return
                end
                d.lastText = text
                d.pick = 1
                self:DrawSuggest()
            end)
        )
        edit:HookScript(
            "OnEditFocusGained",
            self:Guard(function()
                -- the roster comes a moment after it's asked for; an open list redraws then
                if IsInGuild() and C_GuildInfo and C_GuildInfo.GuildRoster then
                    try(C_GuildInfo.GuildRoster)
                end
                d.pick = 1
                self:DrawSuggest()
            end)
        )
        -- leaving the field closes the list, unless the mouse is on it (its bar)
        edit:HookScript("OnEditFocusLost", function()
            self:After(0.15, function()
                if not d:IsMouseOver() then
                    d:Hide()
                end
            end)
        end)
        d:SetScript("OnLeave", function()
            if not edit:HasFocus() and not d:IsMouseOver() then
                d:Hide()
            end
        end)
        edit:SetScript("OnArrowPressed", function(_, key)
            if not d:IsShown() or #d.flat == 0 then
                return
            end
            d.pick = (d.pick + (key == "DOWN" and 1 or (key == "UP" and -1 or 0)) - 1) % #d.flat + 1
            self:DrawSuggest(true)
            -- keep the highlighted row in view
            local r = d.rows[d.pick]
            if r then
                local top, viewH = d.scroll:GetVerticalScroll(), d.scroll:GetHeight()
                if r.y < top then
                    d.scroll:SetVerticalScroll(r.y)
                elseif r.y + SUGGEST_ROW > top + viewH then
                    d.scroll:SetVerticalScroll(r.y + SUGGEST_ROW - viewH)
                end
            end
        end)
        edit:HookScript("OnEnterPressed", function()
            local row = d.flat[d.pick]
            if d:IsShown() and row then
                self:PickSuggest(row)
            end
        end)
        edit:HookScript("OnTabPressed", function()
            local row = d.flat[d.pick]
            if d:IsShown() and row then
                self:PickSuggest(row)
            end
            assert(self.send).subject.edit:SetFocus()
        end)
    end

    function PickSuggest(row: SuggestRow)
        local d = assert(self.suggest)
        d.lastText = row.name
        assert(self.send).to:SetValue(row.name)
        d:Hide()
        self:DrawSendState()
    end

    -- The dropdown for what To says now (keep: only the highlight moved).
    function DrawSuggest(keep: boolean?)
        local d, send = self.suggest, self.send
        if not d or not send then
            return
        end
        local edit = send.to.edit
        if not edit:HasFocus() then
            d:Hide()
            return
        end
        if not keep then
            d.groups = self:Suggestions(edit:GetText())
        end
        d.flat = {}
        local y, nh, nr = S["space-2"], 0, 0
        for _, g in ipairs(d.groups) do
            nh = nh + 1
            local h = d.heads[nh]
            if not h then
                h = UI.Text(d.scroll.child, "caption", "ink-muted")
                d.heads[nh] = h
            end
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", S["space-4"], -(y + 4))
            h:SetValue(g.title)
            h:Show()
            y = y + SUGGEST_HEAD
            for _, row in ipairs(g.rows) do
                nr = nr + 1
                d.flat[#d.flat + 1] = row
                local r = d.rows[nr]
                if not r then
                    r = SuggestButton.new(self, d)
                    d.rows[nr] = r
                end
                r.row, r.flatIndex = row, #d.flat
                r:ClearAllPoints()
                r.y = y
                r:SetPoint("TOPLEFT", 0, -y)
                r:SetPoint("RIGHT", d.scroll.child, "RIGHT")
                r.dot:SetShown(row.diamond and true or false)
                if row.diamond then
                    UI.Paint(r.dot, row.color or "ink")
                end
                r.name:ClearAllPoints()
                r.name:SetPoint("LEFT", row.diamond and (S["space-4"] + 10) or S["space-4"], 0)
                r.name:SetValue(row.name)
                r.name:SetColor(row.color or "ink")
                r.note:ClearAllPoints()
                r.note:SetPoint("LEFT", r.name, "RIGHT", S["space-3"], 0)
                r.note:SetValue(row.note or "")
                r.right:SetValue(row.right or "")
                r.hl:SetShown(r.flatIndex == d.pick)
                r:Show()
                y = y + SUGGEST_ROW
            end
        end
        for i = nh + 1, #d.heads do
            d.heads[i]:Hide()
        end
        for i = nr + 1, #d.rows do
            d.rows[i]:Hide()
        end
        d.scroll.child:SetHeight(y + S["space-2"])
        d:SetHeight(math.min(SUGGEST_MAX_H, y + S["space-2"]) + 2)
        if not keep then
            d.scroll:SetVerticalScroll(0)
        end
        d:SetShown(nr > 0)
    end

    -- This character, for the other characters' suggestions.
    function RememberMe()
        local d = self:MailData()
        -- the whole name: Forever's characters have a surname, and mail needs it
        d.name = asString(SuuUI.FullName("player")) or asString(UnitName("player"))
        d.realm = SuuUI.Realm()
        d.level = UnitLevel("player")
        local _, file = UnitClass("player")
        d.class = asString(file)
        d.faction = UnitFactionGroup("player")
    end

    function BuildSent(page: Frame)
        local list = UI.ScrollArea(page, S["space-3"])
        list:SetPoint("TOPLEFT")
        list:SetPoint("BOTTOMRIGHT", -(S["space-3"] + 3), 0)
        list:HookScript("OnSizeChanged", function(s, w)
            s.child:SetWidth(w)
        end)
        local empty = UI.Text(list.child, "body", "ink-muted")
        empty:SetPoint("TOPLEFT", 0, -S["space-4"])
        empty:SetValue("Mails you send show here: the last " .. SENT_MAX .. ", for this character.")
        self.sent = { rows = {}, list = list, empty = empty }
    end

    function DrawSent()
        local sent = assert(self.sent)
        local list = self:MailData().sent or {}
        local c = sent.list.child
        local rows = sent.rows
        for i = 1, math.max(#list, #rows) do
            local r = rows[i]
            local e = list[i]
            if e then
                if not r then
                    r = MailRow.new(c)
                    r:EnableMouse(false)
                    rows[i] = r
                end
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", 0, -(i - 1) * ROW_H)
                r:SetPoint("RIGHT", c, "RIGHT")
                local first = e.items and e.items[1]
                r.slot.skin:SetItem({
                    icon = first and first.icon or ENVELOPE,
                    count = first and first.count,
                    quality = "common",
                })
                r.sender:SetValue("To " .. (e.to or "?"))
                r.sender:SetColor("ink")
                local what: string[] = {}
                if e.items and #e.items > 1 then
                    what[#what + 1] = #e.items .. " items"
                end
                if (e.money or 0) > 0 then
                    what[#what + 1] = coins(e.money)
                end
                if (e.cod or 0) > 0 then
                    what[#what + 1] = tint("amber", "COD " .. coins(e.cod))
                end
                r.subject:SetValue(e.subject or "")
                r.right:SetValue(ago(e.at))
                r.right2:SetValue(table.concat(what, "  "))
                r.hl:Hide()
                r.rule:SetShown(i < #list)
                r:Show()
            elseif r then
                r:Hide()
            end
        end
        c:SetHeight(math.max(1, #list * ROW_H))
        sent.empty:SetShown(#list == 0)
    end

    function Build()
        local w = UI.WindowFrame(SuuUI.Root, {
            name = "SuuUIMailWindow",
            title = "Mail",
            width = WIDTH,
            height = HEIGHT,
            onClose = function(win)
                win:Hide()
            end,
            tabs = {
                { key = "inbox", label = "Inbox" },
                { key = "send", label = "Send" },
                { key = "sent", label = "Sent" },
            },
            onTab = function(key: string)
                self.tab = key
                for k, page in pairs(self.pages) do
                    page:SetShown(k == key)
                end
                -- the game attaches a right-clicked bag item while its send page shows
                try(SetSendMailShowing, key == "send")
                self:Refresh()
            end,
        })
        w:SetPoint("TOPLEFT", UIParent, "TOPLEFT", 16, -116)
        w:Hide()
        w:HookScript("OnHide", function()
            try(SetSendMailShowing, false)
            if self.open then
                CloseMail()
            end
        end)
        w.scroll:Hide()
        self.window = w
        for _, key in ipairs({ "inbox", "send", "sent" }) do
            local page = CreateFrame("Frame", nil, w.body)
            page:SetAllPoints()
            page:Hide()
            self.pages[key] = page
        end
        self:BuildInbox(assert(self.pages.inbox))
        self:BuildSend(assert(self.pages.send))
        self:BuildSent(assert(self.pages.sent))
    end

    function Refresh()
        local window = self.window
        if not (window and window:IsShown()) then
            return
        end
        local tab = self.tab or "inbox"
        if tab == "inbox" then
            self:DrawInbox()
        elseif tab == "send" then
            self:DrawSendState()
        else
            self:DrawSent()
        end
    end

    function QueueRefresh()
        if self.refreshPending then
            return
        end
        self.refreshPending = true
        self:After(0.05, function()
            self.refreshPending = nil
            self:Refresh()
        end)
    end

    -- The game's mail frames out of sight while the module is on: see-through
    -- and off screen, still shown (they hold the mailbox conversation).
    function Away()
        local function enabled(): boolean
            return self:IsEnabled()
        end
        local mail = frames.find("MailFrame")
        if mail and not self.away then
            self.away = frames.keepAway(mail, { fade = true, when = enabled })
        end
        local open = frames.find("OpenMailFrame")
        if open and not self.awayOpen then
            self.awayOpen = frames.keepAway(open, { fade = true, when = enabled })
        end
    end

    -- The mailbox closed (walked away, or the game closed it): the window
    -- with it, collecting stopped.
    function Closed()
        self.open = false
        self.visit = self.visit + 1
        self.collector:Stop()
        -- a question to pay a COD goes with the mailbox
        local ask, yes = self.codAsk, self.codYes
        self.codAsk, self.codYes = nil, nil
        if ask and yes and ask:IsShown() and ask.onConfirm == yes then
            ask:Hide()
        end
        local window = self.window
        if window then
            window:Hide()
        end
    end

    override function OnEnable()
        if not self.window then
            self:Build()
        end
        self:RememberMe()
        -- what To would suggest for a text, and what the guild roster gives
        -- (also saved to SuuUIProbe.mailSuggest on /reload)
        self:RegisterCommand("mailsuggest", "test: what Send's To suggests for a text, and what the guild roster gives: /suu mailsuggest <text>", function(
            arg: string?
        )
            local lines: string[] = {}
            local function out(text: string)
                lines[#lines + 1] = text
                self:Print(text)
            end
            local n, online = try(GetNumGuildMembers)
            out(
                ("typed %q; in a guild %s, roster %s members (%s online)"):format(
                    arg or "",
                    tostring(IsInGuild()),
                    tostring(n),
                    tostring(online)
                )
            )
            for i = 1, math.min(3, asNumber(n) or 0) do
                local full, rank, _, _, _, _, _, _, isOnline, _, file = try(GetGuildRosterInfo, i)
                local name = asString(full)
                out(
                    ("  %d: %s, %s, %s, online %s, as To %s"):format(
                        i,
                        tostring(full),
                        tostring(rank),
                        tostring(file),
                        tostring(isOnline),
                        tostring(name and Ambiguate(name, "mail"))
                    )
                )
            end
            local ok, got = pcall(self.Suggestions, self, arg)
            local groups: SuggestGroup[] = ok and got or {}
            if not ok then
                out("suggestions failed: " .. tostring(got))
            end
            if #groups == 0 then
                out("no suggestions")
            end
            for _, g in ipairs(groups) do
                local names: string[] = {}
                for _, r in ipairs(g.rows) do
                    names[#names + 1] = r.name
                end
                out(g.title .. ": " .. table.concat(names, ", "))
            end
            local probe = (SuuUIProbe or {}) :: { [string]: unknown }
            SuuUIProbe = probe
            probe.mailSuggest = { at = date("%H:%M:%S"), lines = lines }
        end)
        self:OnGameEvent("PLAYER_LEVEL_UP", function()
            self:After(1, function()
                self:RememberMe()
            end)
        end)
        self:OnGameEvent("MAIL_SHOW", function()
            self.collector:Stop()
            self.open = true
            self.visit = self.visit + 1
            self.openIndex, self.openId = nil, nil
            self:Note("")
            self:Away()
            local window = assert(self.window)
            window:Show()
            window:SetTab("inbox")
            try(CheckInbox)
            -- the guild roster for To's suggestions
            if IsInGuild() and C_GuildInfo and C_GuildInfo.GuildRoster then
                try(C_GuildInfo.GuildRoster)
            end
        end)
        self:OnGameEvent("MAIL_CLOSED", function()
            self:Closed()
        end)
        -- the mailbox's interaction hidden: walked away from, or closed
        -- (WoW Forever's CloseMail tells no MAIL_CLOSED)
        self:OnGameEvent("PLAYER_INTERACTION_MANAGER_FRAME_HIDE", function(_, kind)
            if kind == Enum.PlayerInteractionType.MailInfo then
                self:Closed()
            end
        end)
        -- the game's answers to Collect all's takes (Mail/Collect); the
        -- inbox kept (SuuUI.Holdings' "mail")
        self:OnGameEvent("MAIL_INBOX_UPDATE", function()
            self.collector:OnInboxUpdate()
            self:QueueRefresh()
            if self.open then
                self:QueueKeep()
            end
        end)
        SuuUI.Holdings.Provide(self, "mail", function(key: string): Holding?
            return self:InboxHolding(key)
        end)
        self:OnGameEvent("MAIL_SUCCESS", function()
            self.collector:OnSuccess()
        end)
        self:OnGameEvent("UI_ERROR_MESSAGE", function(_, _, message)
            self.collector:OnError(asString(message))
        end)
        for _, e in ipairs({
            "MAIL_SEND_INFO_UPDATE",
            "CLOSE_INBOX_ITEM",
            "PLAYER_MONEY",
            "BAG_UPDATE_DELAYED",
        }) do
            self:OnGameEvent(e, function()
                self:QueueRefresh()
            end)
        end
        self:OnGameEvent("GUILD_ROSTER_UPDATE", function()
            local d, send = self.suggest, self.send
            if (d and d:IsShown()) or (send and send.to.edit:HasFocus()) then
                self:DrawSuggest()
            end
        end)
        -- amounts, COD and "Online" carry colour codes: drawn again
        self:On("SUUUI_THEME_CHANGED", function()
            self:Refresh()
            local d = self.suggest
            if d and d:IsShown() then
                self:DrawSuggest()
            end
        end)
        self:OnGameEvent("MAIL_SEND_SUCCESS", function()
            self:SendDone(true)
        end)
        self:OnGameEvent("MAIL_FAILED", function(_, itemID)
            local item = asNumber(itemID)
            self.collector:OnFailed(item, self.sending)
            -- (an item's failure is a take's, not the mail being sent)
            if self.sending and not item then
                self:SendDone(false)
            end
        end)
        -- money's confirmation (the game's secure dialog) cancelled
        self:OnGameEvent("SECURE_TRANSFER_CANCEL", function()
            if self.sending then
                self:SendDone(false)
            end
        end)
    end

    override function OnDisable()
        self.collector:Stop()
        local window = self.window
        if window then
            window:Hide()
        end
    end
end

M = SuuUI.AddModule(MailModule.new())
