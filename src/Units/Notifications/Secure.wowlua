-- Units/Notifications/Secure.wowlua
-- A note's secure macro or click button (MacroButton), placed over the
-- action's button on its card out of combat, and hidden as a fight starts.
-- The module's methods (SecureActions, HideSecureActions) call these with
-- the module (Units/Notifications.wowlua).

import type NotificationsModule from "/Units/Notifications"

-- A note's action with `macro` (0.13) or `click` (0.20): a secure button
-- over its button that runs the macro or clicks the game's button
-- (SecureActions); hovering it hovers the button under it, and the action's
-- onClick runs after it. `skip` says when the secure action is left out
-- (the map already open: its button would close it).
export class MacroButton extends Button
    over: Button? = nil
    after: (() -> ())? = nil
    kind: string? = nil
    skip: (() -> boolean)? = nil

    constructor()
        super(nil, UIParent, "SecureActionButtonTemplate")
        self:RegisterForClicks("LeftButtonDown", "LeftButtonUp")
        self:SetFrameStrata("DIALOG")
        self:SetScript("OnEnter", function(me)
            me:Pass("OnEnter")
        end)
        self:SetScript("OnLeave", function(me)
            me:Pass("OnLeave")
        end)
        self:SetScript("PreClick", function(me)
            local skip = me.skip
            if skip and skip() and not InCombatLockdown() then
                me:SetAttribute("type1", nil)
            end
        end)
        -- (a press and a release both come: once, on the release)
        self:SetScript("PostClick", function(me, _: string, down: boolean?)
            if down then
                return
            end
            local after = me.after
            if after then
                after()
            end
            local kind = me.kind
            if kind and not InCombatLockdown() then
                me:SetAttribute("type1", kind)
            end
        end)
    end

    -- The button under it gets the hover.
    function Pass(script: "OnEnter" | "OnLeave")
        local over = self.over
        local fn = over and over:GetScript(script)
        if over and fn then
            fn(over)
        end
    end

    function Release()
        self:Hide()
        self:ClearAllPoints()
        self.over, self.after, self.kind, self.skip = nil, nil, nil, nil
    end
end

-- A note's action with `macro` (0.13): a secure button over its button
-- that runs the macro, for what only a secure click may do (opening the
-- game's Group Finder at its listing panel: opened from addon code, the
-- panel's listing would be refused). Placed by screen position, never
-- anchored to the card (a secure frame anchored to it would make the
-- stack protected); out of combat only: hidden as a fight starts, the
-- button then says why it can't.
export function secureActions(m: NotificationsModule)
    local stack = m.stack
    if InCombatLockdown() or m.fighting or not stack then
        return
    end
    local used: { [string]: boolean } = {}
    local ui = UIParent:GetEffectiveScale()
    for id, d in pairs(m.notes) do
        for i, a in ipairs(d.actions or {}) do
            local macro, click = a.macro, a.click
            local target = click and click()
            local card = (macro or target) and stack:CardFor(id) or nil
            local pool = card and card.buttons[a.variant or "quiet"]
            local b = pool and pool[i]
            local left, bottom = b and b:GetLeft(), b and b:GetBottom()
            if (macro or target) and card and b and b:IsVisible() and left and bottom then
                local key = id .. "#" .. i
                local s = m.secure[key]
                if not s then
                    s = MacroButton.new()
                    m.secure[key] = s
                end
                local scale = b:GetEffectiveScale() / ui
                s:ClearAllPoints()
                s:SetPoint("BOTTOMLEFT", UIParent, "BOTTOMLEFT", left * scale, bottom * scale)
                s:SetSize(b:GetWidth() * scale, b:GetHeight() * scale)
                if target then
                    s.kind = "click"
                    s:SetAttribute("type1", "click")
                    s:SetAttribute("clickbutton1", target)
                elseif macro then
                    local text: string
                    if type(macro) == "function" then
                        text = macro()
                    else
                        text = macro
                    end
                    s.kind = "macro"
                    s:SetAttribute("type1", "macro")
                    s:SetAttribute("macrotext1", text)
                end
                s.skip = a.skipClick
                local onClick, clicked = a.onClick, card
                s.over, s.after = b,
                    onClick and
                        function()
                            onClick(clicked)
                        end or
                        nil
                s:Show()
                used[key] = true
            end
        end
    end
    for key, s in pairs(m.secure) do
        if not used[key] then
            s:Release()
        end
    end
end

export function hideSecureActions(m: NotificationsModule)
    for _, s in pairs(m.secure) do
        s:Release()
    end
end
