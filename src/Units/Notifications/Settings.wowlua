-- Units/Notifications/Settings.wowlua
-- The Notifications module's settings (Units/Notifications.wowlua): their
-- defaults, the section in the settings window and its preview (made-up
-- cards of each kind).

import SuuUI from "/Core/API"
import type SettingsSection, Position, NotificationData, NotificationStack from "/Core/API"
import classIcon from "./Presence"
import type NotificationsModule from "/Units/Notifications"

local UI = SuuUI.UI

export const DEFAULTS = {
    -- under the micro menu (28px down, 36px tall), space-5 clear
    position = { point = "TOPLEFT", x = 28, y = -76 } :: Position,
    max = 5,
    requests = true, -- Blizzard's popups as cards
    durability = true, -- a note while your gear is badly damaged or broken
    bagsFull = true, -- a note while your bags are full
    talentPoints = true, -- a note while you have talent points to spend
    legacyPoints = true, -- a note while you have Legacy points to spend
    -- friends and guild members coming online / going offline
    presenceBnetOnline = true,
    presenceBnetOffline = true,
    presenceFriendOnline = true,
    presenceFriendOffline = true,
    presenceGuildOnline = true,
    presenceGuildOffline = false,
    presenceHideChat = true, -- the game's own lines in chat hidden
}

