    {
        id = "p3",
        kind = "until",
        category = "Durability",
        title = "Your gear is badly damaged",
        icon = { glyph = "anvil" },
        tone = "warning",
        ["until"] = "Goes when you repair",
    },
    {
        id = "p4",
        kind = "timed",
        presence = {
            online = true,
            source = "Battle.net",
            people = {
                {
                    name = "Kaelith",
                    tag = "#1137",
                    color = "class-priest",
                    detail = "Kaelith · Eastern Plaguelands",
                    icon = classIcon("PRIEST"),
                },
