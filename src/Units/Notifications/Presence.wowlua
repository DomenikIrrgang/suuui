-- Units/Notifications/Presence.wowlua
-- Friends and guild members coming online and going offline, as the
-- Notifications module's cards (Units/Notifications.wowlua): the game's
-- online and offline lines read, who it is (a Battle.net friend, a friend,
-- a guild member) and what the card says about them, arrivals within a few
-- seconds on one card, the game's own lines in chat hidden, and /suu
-- presence's test cards. The module's methods (WhoIs, BnetPerson, Presence,
-- BnetCharacterSet, FlushPresence, BnetInfoChanged, SystemLine,
-- HookPresence, TestPresence) call these with the module.

import SuuUI from "/Core/API"
import type NotificationPerson, NotificationIcon from "/Core/API"
import hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import * as chat from "wowlua:chat"
import * as unit from "wowlua:unit"
import type NotificationsModule from "/Units/Notifications"

local T = SuuUI.Tokens

-- The game's values, read without trusting their types.
local try, field = errors.try, tbl.field
local asString, asNumber = secret.asString, secret.asNumber

--------------------------------------------------------------------------------
-- Friends and guild members coming online and going offline (design board
-- "Notifications · Friends"; probed 2026-10-14). Character friends and
-- guild members come as the game's system line ("[Name] has come online.",
-- "Name has gone offline."); Battle.net friends as their own events. Who it
-- is decides the card: a Battle.net friend, a friend, a guild member.
-- Arrivals within a few seconds share one card; in combat they wait. The
-- game's own lines in chat (and its Battle.net toast) can be hidden.
--------------------------------------------------------------------------------

-- A pattern from one of the game's format strings: "%s" a capture, the
-- rest literal.
local function patternOf(fmt: unknown): string?
    if type(fmt) ~= "string" then
        return nil
    end
    local parts: string[] = {}
    -- the text between the "%s"s (one more "%s" at the end closes the last)
    for piece in (fmt .. "%s"):gmatch("(.-)%%s") do
        parts[#parts + 1] = (piece:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1"))
    end
    return "^" .. table.concat(parts, "(.-)") .. "$"
end

local ONLINE = patternOf(ERR_FRIEND_ONLINE_SS) -- link, name
local OFFLINE = patternOf(ERR_FRIEND_OFFLINE_S) -- name
local BATCH = 2.5 -- seconds that share one card

-- A class's file name ("PRIEST") by its name as the game writes it.
local CLASS_FILES: { [string]: string } = {}
for _, key in ipairs({ "LOCALIZED_CLASS_NAMES_MALE", "LOCALIZED_CLASS_NAMES_FEMALE" }) do
    local names = field(_G, key)
    if type(names) == "table" and secret.readable(names) then
        for file, name in pairs(names :: { [unknown]: unknown }) do
            local f, n = asString(file), asString(name)
            if f and n then
                CLASS_FILES[n] = f
            end
        end
    end
end

local GAMES: { [string]: string } = {
    App = "Battle.net",
    BSAp = "Battle.net Mobile",
    WTCG = "Hearthstone",
    Hero = "Heroes of the Storm",
    Pro = "Overwatch",
    S2 = "StarCraft II",
    S1 = "StarCraft",
    D3 = "Diablo III",
    Fen = "Diablo IV",
    ANBS = "Diablo Immortal",
    VIPR = "Call of Duty",
    W3 = "Warcraft III",
    GRY = "Warcraft Rumble",
}

export function classIcon(file: string?): NotificationIcon?
    local c = file and field(_G, "CLASS_ICON_TCOORDS", file)
    if type(c) ~= "table" then
        return nil
    end
    local coords: number[] = {}
    for i, v in ipairs(tbl.list(c)) do
        coords[i] = asNumber(v) or 0
    end
    return { texture = "Interface\\Glues\\CharacterCreate\\UI-CharacterCreate-Classes", coords = coords }
end

local function classColor(file: string?): string?
    if not file then
        return nil
    end
    local token = "class-" .. file:lower()
    return field(T.color, token) ~= nil and token or nil
end

-- What a group invite by name does (a card's Invite).
local function inviting(name: string): () -> ()
    return function()
        unit.invite(name)
    end
end

-- Someone on a friends card, and what SuuUI knows besides: their
-- Battle.net account, the name they're invited by, their own Invite, the
-- character a Battle.net friend plays.
export type Person = NotificationPerson
    & { bnetID?: number, inviteName?: string, invite?: () -> (), character?: string }

-- The people as the card takes them.
local function cardPeople(people: Person[]): NotificationPerson[]
    local out: NotificationPerson[] = {}
    for i, p in ipairs(people) do
        out[i] = p
    end
    return out
end

-- Can you invite them: in Forever, on your realm and in your faction (the
-- game's own friends list asks the same).
-- Same game and side (no realm check: Forever's realms are rulesets, and a
-- friend on another realm ID still groups; the game says when it can't).
local function canCooperate(game: BNetGameAccountInfo): boolean
    if not (game.wowProjectID == asNumber(field(_G, "WOW_PROJECT_ID")) and game.gameAccountID) then
        return false
    end
    local side = asString(game.factionName)
    return side ~= nil and side == asString(UnitFactionGroup("player"))
end

-- the presence settings: a kind's setting, then Online or Offline
type PresenceKey = "presenceBnetOnline"
    | "presenceBnetOffline"
    | "presenceFriendOnline"
    | "presenceFriendOffline"
    | "presenceGuildOnline"
    | "presenceGuildOffline"

-- Who comes and goes: a Battle.net friend, a friend, a guild member.
export type PresenceKind = "bnet" | "friend" | "guild"
type PresenceStyle = { setting: string, source?: string, plural: string, glyph: string }

local KINDS_OF: { bnet: PresenceStyle, friend: PresenceStyle, guild: PresenceStyle } = {
    bnet = { setting = "presenceBnet", source = "Battle.net", plural = "Battle.net friends", glyph = "people" },
    friend = { setting = "presenceFriend", source = "Friend", plural = "friends", glyph = "people" },
    guild = { setting = "presenceGuild", plural = "guild members", glyph = "flag" },
}

-- The arrivals (or departures) of one kind waiting to share a card.
export type Arrivals = { kind: PresenceKind, online: boolean, people: Person[], held?: boolean }

-- A card waiting for a Battle.net friend's character, for its Invite.
export type AwaitInvite = { id: string, bnetID: number, refresh: (person: Person) -> () }

-- A character's whole name ("Frassilla Grim": Battle.net gives the surname
-- too, seen 2026-10-18), and its first name for a side that has none.
local function wholeName(name: string): string
    return Ambiguate(name, "short")
end
local function firstName(name: string): string
    return wholeName(name):match("^(%S+)") or name
end

-- Is this one of the game's online/offline lines (for the chat filter)?
local function isPresenceLine(msg: unknown): boolean
    local text = asString(msg)
    if not text then
        return false
    end
    return (ONLINE ~= nil and text:match(ONLINE) ~= nil) or (OFFLINE ~= nil and text:match(OFFLINE) ~= nil)
end

-- A character friend or guild member by name: kind and the card's person.
export function whoIs(m: NotificationsModule, name: string): (PresenceKind?, Person?)
    local short = Ambiguate(name, "short")
    local info = errors.tryValue(C_FriendList and C_FriendList.GetFriendInfo, short)
    if info and secret.readable(info.name) then
        local file: string? = nil
        if info.guid then
            local _, english = GetPlayerInfoByGUID(info.guid)
            file = asString(english)
        end
        file = file or CLASS_FILES[info.className or ""]
        local where: string[] = {}
        local level = asNumber(info.level)
        if level and level > 0 then
            where[#where + 1] = "Level " .. level
        end
        local area = asString(info.area)
        if area and area ~= "" then
            where[#where + 1] = area
        end
        return "friend",
            {
                name = short,
                color = classColor(file),
                icon = classIcon(file),
                detail = table.concat(where, " · "),
                whisper = function()
                    chat.whisper(name)
                end,
                inviteName = name,
            }
    end
    if IsInGuild() then
        for i = 1, (GetNumGuildMembers()) or 0 do
            local full, rank, _, level, _, zone, _, _, _, _, file = GetGuildRosterInfo(i)
            if full and Ambiguate(full, "short") == short then
                local where: string[] = {}
                if rank and rank ~= "" then
                    where[#where + 1] = rank
                end
                if level and level > 0 then
                    where[#where + 1] = "Level " .. level
                end
                if zone and zone ~= "" then
                    where[#where + 1] = zone
                end
                return "guild",
                    {
                        name = short,
                        color = classColor(file),
                        icon = classIcon(file),
                        detail = table.concat(where, " · "),
                        whisper = function()
                            chat.whisper(full)
                        end,
                        inviteName = full,
                    }
            end
        end
    end
    return nil, nil
end

-- A Battle.net friend's card person (their account name is protected text
-- the game draws; SuuUI never reads it).
export function bnetPerson(m: NotificationsModule, accountID: number): Person?
    local info = errors.tryValue(C_BattleNet and C_BattleNet.GetAccountInfoByID, accountID)
    if not info then
        return nil
    end
    local game: BNetGameAccountInfo? = info.gameAccountInfo
    local account = info.accountName
    local person: Person = { name = account or info.battleTag or "?", bnetID = accountID }
    local tag = asString(info.battleTag)
    if tag then
        person.tag = tag:match("(#%d+)$")
    end
    person.whisper = function()
        if account then
            chat.whisperBnet(account)
        end
    end
    -- the character they play, remembered so going offline matches too
    local character = game and asString(game.characterName)
    if character and character ~= "" then
        m.bnetCharacters[accountID] = character
    end
    person.character = m.bnetCharacters[accountID]
    if game and game.clientProgram == (BNET_CLIENT_WOW or "WoW") and character then
        local file = CLASS_FILES[game.className or ""]
        person.color = classColor(file)
        person.icon = classIcon(file)
        local presence = asString(game.richPresence)
        local where = (presence and presence ~= "" and presence) or asString(game.areaName) or "World of Warcraft"
        person.detail = character .. " · " .. where
        -- invited by their game account, as the game's friends list does (by
        -- name and realm the game didn't find them; found in game)
        if canCooperate(game) then
            local id = game.gameAccountID
            person.invite = function()
                unit.inviteBnet(id)
            end
        end
    else
        person.detail = GAMES[game and game.clientProgram or ""] or "Battle.net"
    end
    return person
end

-- One more arrival or departure; a card once the burst is over.
export function queuePresence(m: NotificationsModule, kind: PresenceKind, online: boolean, person: Person?)
    local k = KINDS_OF[kind]
    if not person then
        return
    end
    if not m:Get((k.setting .. (online and "Online" or "Offline")) :: PresenceKey) then
        return
    end
    local queue = m.presence or {}
    m.presence = queue
    local key = kind .. (online and "+" or "-")
    local q = queue[key]
    if not q then
        local fresh: Arrivals = { kind = kind, online = online, people = {} }
        q = fresh
        queue[key] = fresh
        m:After(BATCH, function()
            m:FlushPresence(key)
        end)
    end
    for _, x in ipairs(q.people) do
        if x.name == person.name then
            return
        end
    end
    q.people[#q.people + 1] = person
end

-- The characters your Battle.net friends play (now, or last seen): a
-- guild member or friend who is one of them gets the Battle.net card only.
export function bnetCharacterSet(m: NotificationsModule): { [string]: boolean }
    local out: { [string]: boolean } = {}
    local function add(name: string)
        out[wholeName(name)] = true
        -- a first name alone matches only a name without a surname
        out["first:" .. firstName(name)] = true
    end
    for _, name in pairs(m.bnetCharacters) do
        add(name)
    end
    for i = 1, asNumber((try(field(_G, "BNGetNumFriends")))) or 0 do
        local info = errors.tryValue(C_BattleNet and C_BattleNet.GetFriendAccountInfo, i)
        local name = info and info.gameAccountInfo and asString(info.gameAccountInfo.characterName)
        if name and name ~= "" then
            add(name)
        end
    end
    return out
end

export function flushPresence(m: NotificationsModule, key: string)
    local queue = m.presence
    local q = queue and queue[key]
    if not (queue and q) then
        return
    end
    -- in combat they wait for the fight's end
    if InCombatLockdown() then
        q.held = true
        return
    end
    queue[key] = nil
    -- someone who is a guild member (or friend) and a Battle.net friend: one
    -- card, the Battle.net one (asked 2026-10-18: two cards for one person)
    if q.kind ~= "bnet" then
        local bnet = m:BnetCharacterSet()
        local kept: Person[] = {}
        for _, p in ipairs(q.people) do
            local whole = wholeName(p.name)
            local same = bnet[whole] or (not whole:find(" ") and bnet["first:" .. firstName(p.name)])
            if not same then
                kept[#kept + 1] = p
            end
        end
        q.people = kept
    end
    if not m:IsEnabled() or #q.people == 0 then
        return
    end
    local k = KINDS_OF[q.kind]
    local source = k.source or asString((GetGuildInfo("player"))) or "Guild"
    -- Battle.net friends as they are now: by the event their character
    -- often wasn't there yet
    if q.kind == "bnet" then
        for i, p in ipairs(q.people) do
            local id = p.bnetID
            q.people[i] = id and m:BnetPerson(id) or p
        end
    end
    local single: Person? = #q.people == 1 and q.people[1] or nil
    m.presenceCount = m.presenceCount + 1
    local id = "suu:presence:" .. m.presenceCount
    local function show()
        local invite: (() -> ())? = nil
        local one = single
        if q.online and one then
            local name = one.inviteName
            invite = one.invite or (name and inviting(name)) or nil
        end
        m:Notify({
            id = id,
            kind = "timed",
            duration = q.online and 6 or 4,
            presence = {
                online = q.online,
                source = source,
                people = cardPeople(q.people),
                plural = k.plural,
                glyph = k.glyph,
                invite = invite,
            },
        })
    end
    show()
    -- one Battle.net friend still loading in: the card gains Invite when
    -- their character arrives on your realm and side, while it shows
    local waiting: number? = nil
    if q.online and single and not single.invite then
        waiting = single.bnetID
    end
    if waiting then
        m.awaitInvite = {
            id = id,
            bnetID = waiting,
            refresh = function(person: Person)
                q.people[1], single = person, person
                show()
            end,
        }
    end
end

-- A Battle.net friend's info changed: the card waiting for their character.
export function bnetInfoChanged(m: NotificationsModule)
    local w = m.awaitInvite
    if not w then
        return
    end
    if not m.notes[w.id] then
        m.awaitInvite = nil
        return
    end
    local person = m:BnetPerson(w.bnetID)
    if person and person.invite then
        m.awaitInvite = nil
        w.refresh(person)
    end
end

-- The game's system line: who, and whether it's theirs to show.
export function systemLine(m: NotificationsModule, msg: unknown)
    local text = asString(msg)
    if not text then
        return
    end
    local online = true
    local name: string? = nil
    if ONLINE then
        local _, n = text:match(ONLINE)
        name = n
    end
    if not name and OFFLINE then
        name = text:match(OFFLINE)
        online = false
    end
    if not name or Ambiguate(name, "short") == asString(SuuUI.FullName("player")) then
        return
    end
    -- a link's name keeps its colour codes out
    local plain = name:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", "")
    local kind, person = m:WhoIs(plain)
    if kind then
        m:Presence(kind, online, person)
    end
end

export function hookPresence(m: NotificationsModule)
    if m.presenceHooked then
        return
    end
    m.presenceHooked = true
    chat.filter("CHAT_MSG_SYSTEM", function(msg: unknown): boolean
        return m:IsEnabled() and m:Get("presenceHideChat") and isPresenceLine(msg)
    end)
    chat.filter("CHAT_MSG_BN_INLINE_TOAST_ALERT", function(process: unknown): boolean
        return m:IsEnabled() and m:Get("presenceHideChat") and
            (process == "FRIEND_ONLINE" or process == "FRIEND_OFFLINE")
    end)
    -- Battle.net's own toast (bottom right) for the same: away while SuuUI
    -- shows Battle.net friends
    local toast = frames.find("BNToastFrame")
    if toast then
        hookScript(toast, "OnShow", function(f: Frame)
            if not m:IsEnabled() then
                return
            end
            local t = asNumber(field(f, "toastType"))
            local online = t == (asNumber(field(_G, "BN_TOAST_TYPE_ONLINE")) or 1)
            local offline = t == (asNumber(field(_G, "BN_TOAST_TYPE_OFFLINE")) or 2)
            if (online and m:Get("presenceBnetOnline")) or (offline and m:Get("presenceBnetOffline")) then
                f:Hide()
            end
        end)
    end
end

-- Test: one card of each (no one has to log in). The single cards are your
-- own character, so Whisper and Invite really act (on you); the group card
-- is made up.
export function testPresence(m: NotificationsModule)
    -- the whole name: Forever's characters have a surname (UnitName's
    -- second value), which whispers need
    local full = asString(SuuUI.FullName("player")) or asString(UnitName("player")) or "?"
    local _, classFile = UnitClass("player")
    local file = asString(classFile)
    local zone = GetRealZoneText()
    local function mine(detail: string): Person
        return {
            name = full,
            color = classColor(file),
            icon = classIcon(file),
            detail = detail,
            whisper = function()
                chat.whisper(full)
            end,
            inviteName = full,
        }
    end
    local function sample(name: string, f: string): Person
        return {
            name = name,
            color = classColor(f),
            icon = classIcon(f),
            whisper = function()
                chat.whisper(name)
            end,
        }
    end
    local function card(kind: PresenceKind, online: boolean, people: Person[])
        local k = KINDS_OF[kind]
        local single: Person? = #people == 1 and people[1] or nil
        local name = single and single.inviteName
        m.presenceCount = m.presenceCount + 1
        m:Notify({
            id = "suu:presence:" .. m.presenceCount,
            kind = "timed",
            duration = online and 20 or 15,
            presence = {
                online = online,
                source = k.source or asString((GetGuildInfo("player"))) or "Guild",
                people = cardPeople(people),
                plural = k.plural,
                glyph = k.glyph,
                invite = online and name and inviting(name) or nil,
            },
        })
    end
    local bn = mine(full .. " · " .. zone)
    bn.tag = "#1137"
    card("bnet", true, { bn })
    card("friend", true, { mine("Level " .. UnitLevel("player") .. " · " .. zone) })
    local _, rank = GetGuildInfo("player")
    local ranked = asString(rank)
    card("guild", true, {
        mine((ranked and (ranked .. " · ") or "") .. "Level " .. UnitLevel("player") .. " · " .. zone),
    })
    card("guild", true, {
        sample("Lyra", "MAGE"),
        sample("Thorn", "ROGUE"),
        sample("Maelis", "PALADIN"),
        sample("Durn", "HUNTER"),
    })
    card("guild", false, { sample("Ysolde", "DRUID") })
end
