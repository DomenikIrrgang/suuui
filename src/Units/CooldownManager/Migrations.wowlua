-- Units/CooldownManager/Migrations.wowlua
-- The Cooldown Manager's settings migrations: each reshapes one profile's
-- stored values (`values`, the module's namespace in it) once. The module
-- registers them in this order (M:Migrate); tests call them directly.

import type Values from "/Core/Settings"
import type Entry from "./Lists"
import list, field from "wowlua:table"

-- A stored table to change in place (a list, an entry, a setup), when `v`
-- is one; nil otherwise.
local function tableOf(v: unknown): { [string]: unknown }?
    if type(v) == "table" then
        return v :: unknown :: { [string]: unknown }
    end
    return nil
end
-- A stored entry, when `v` is a table.
local function entryOf(v: unknown): Entry?
    if type(v) == "table" then
        return v :: unknown :: Entry
    end
    return nil
end
-- Every setup's lists: fn(lists, class, spec) for each, read from what is stored.
local function eachSetup(values: Values, fn: (lists: unknown, class: string, spec: string) -> ())
    local setups = tableOf(values.setups)
    if not setups then
        return
    end
    for class, specs in pairs(setups) do
        local bySpec = tableOf(specs)
        if bySpec then
            for spec, s in pairs(bySpec) do
                if type(s) == "table" then
                    fn(field(s, "lists"), tostring(class), tostring(spec))
                end
            end
        end
    end
end

-- Essential size became 30-52px (the design's 40 by default): a size you set
-- stays, moved into the range if it was outside.
export function essentialSize(values: Values)
    local v: unknown = values.essentialSize
    if type(v) == "number" then
        values.essentialSize = math.max(30, math.min(52, v))
    end
end

-- Shared slots (groups) saved before every one had a uid get one, so the
-- editor can follow them through moves and renames.
export function slotUids(values: Values)
    local function give(lists: unknown, tag: string)
        local byKey = tableOf(lists)
        if not byKey then
            return
        end
        for key, l in pairs(byKey) do
            for i, raw in ipairs(list(l)) do
                local e = entryOf(raw)
                if e and (e.group or e.collection) and not e.uid then
                    e.uid = tag .. tostring(key) .. i
                end
            end
        end
    end
    eachSetup(values, function(lists: unknown, class: string, spec: string)
        give(lists, "m" .. class .. spec)
    end)
    give(values.lists, "m")
end

-- "When missing" is each entry's own now: the list-wide Missing buffs and
-- Missing debuffs settings are gone. A choice made there goes onto every buff
-- or debuff that had none of its own (the defaults equal the old ones, so
-- untouched setups don't change).
export function missingPerEntry(values: Values)
    local old: { [string]: unknown } = { buffs = values.missingBuffs, debuffs = values.missingDebuffs }
    values.missingBuffs, values.missingDebuffs = nil, nil
    local function set(raw: unknown, mode: string)
        local e = entryOf(raw)
        if not e then
            return
        end
        if e.collection then
            for _, x in ipairs(list(e.entries)) do
                set(x, mode)
            end
        elseif e.missing == nil then
            e.missing = mode
        end
    end
    local function apply(lists: unknown)
        local byKey = tableOf(lists)
        if not byKey then
            return
        end
        for key, mode in pairs(old) do
            if type(mode) == "string" then
                for _, e in ipairs(list(byKey[key])) do
                    set(e, mode)
                end
            end
        end
    end
    eachSetup(values, function(lists: unknown)
        apply(lists)
    end)
    apply(values.lists)
end

-- The shaman presets' Shields slot had a fixed icon, so Restoration's
-- reminder showed Water Shield before it was learned. It picks the first
-- member you know now, the spec's shield leading: a saved copy of it follows
-- (one with the two shields, Water Shield's art fixed: Water Shield first).
export function shamanShieldsAuto(values: Values)
    local function fix(l: unknown)
        for _, raw in ipairs(list(l)) do
            local e = entryOf(raw)
            if e and e.collection then
                fix(e.entries)
            end
            local m = e and e.group and e.fixedIcon and e.name == "Shields" and e.members
            if e and m and #m == 2 and m[1].name == "Lightning Shield" and m[2].name == "Water Shield" then
                e.fixedIcon = nil
                if e.icon == m[2].icon then
                    m[1], m[2] = m[2], m[1]
                end
            end
        end
    end
    eachSetup(values, function(lists: unknown, class: string)
        if class == "SHAMAN" then
            fix(field(lists, "buffs"))
        end
    end)
end

-- Buffs of 3 minutes or less, or used up by charges, are fixed slots that
-- warn while missing (their time and stacks while up), no longer reminders:
-- the presets' shaman Shields, Battle Shout and Inner Fire, saved copies too.
export const SHORT_BUFFS: { [string]: string } = { SHAMAN = "Shields", WARRIOR = "Battle Shout", PRIEST = "Inner Fire" }

export function shortBuffsWarn(values: Values)
    local function fix(l: unknown, name: string)
        for _, raw in ipairs(list(l)) do
            local e = entryOf(raw)
            if e and e.collection then
                fix(e.entries, name)
            end
            if e and e.name == name and e.missing == "remind" then
                e.missing = "warn"
            end
        end
    end
    eachSetup(values, function(lists: unknown, class: string)
        local name = SHORT_BUFFS[class]
        if name then
            fix(field(lists, "buffs"), name)
        end
    end)
end
