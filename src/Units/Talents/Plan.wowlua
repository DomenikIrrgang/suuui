-- Units/Talents/Plan.wowlua
-- The build picker in the Talents window's head (its options, foot links
-- and buttons) and planning a build on its class's trees: a click adds the
-- next step, a right-click takes the last back, a dragged order line moves
-- its steps, a planned talent's tooltip. Functions of Units/Talents' module
-- (its Picker, FillPlan, PlanAdd, PlanRemove, MoveLine, ShowPlanTip … call
-- them with itself).

import SuuUI from "/Core/API"
import type TalentTree, TalentNode as PageTalent, TalentTreeData as PageTreeData, TalentLink, TalentBuilds, BuildButton, TalentStep, SelectOption, SelectFootLink from "/Core/API"
import type TalentsModule from "/Units/Talents"
import CLASS from "/Units/Talents/Trees"
import store, copySteps, plural from "/Units/Talents/Builds"
import type SavedBuild from "/Units/Talents/Builds"
import * as errors from "wowlua:errors"

local UI, T = SuuUI.UI, SuuUI.Tokens

-- A talent of a build planned on its trees (FillPlan).
export type PlanNode = {
    id: number,
    row: number,
    col: number,
    max: number,
    rank: number,
    pending: number,
    icon?: number | string,
    name: string,
    entryID?: number,
    canSpend: boolean,
    locked: boolean,
    problem?: string,
}

--------------------------------------------------------------------------------
-- The picker
--------------------------------------------------------------------------------

export function pickerOptions(m: TalentsModule): SelectOption<string>[]
    local classes = m:Classes().byFile
    local mine: SelectOption<string>[], others: SelectOption<string>[] = {}, {}
    local active = m:ActiveID()
    for id, b in pairs(store().builds) do
        local class = classes[b.class]
        local o: SelectOption<string> = {
            value = id,
            label = b.name or "?",
            diamond = "class-" .. b.class:lower(),
            search = class and class.name or b.class,
            note = (b.split or "") .. (active == id and " · Active" or ""),
        }
        if b.class == CLASS then
            mine[#mine + 1] = o
        else
            o.note = (class and class.name or "") .. " · " .. (b.split or "")
            others[#others + 1] = o
        end
    end
    local function byName(a: SelectOption<string>, b: SelectOption<string>): boolean
        return (a.label or ""):lower() < (b.label or ""):lower()
    end
    table.sort(mine, byName)
    table.sort(others, function(a: SelectOption<string>, b: SelectOption<string>): boolean
        if a.search ~= b.search then
            return (a.search or "") < (b.search or "")
        end
        return byName(a, b)
    end)
    local my = classes[CLASS]
    local out: SelectOption<string>[] = { { value = "", label = "Your talents", note = "no build" } }
    out[#out + 1] = { heading = my and my.name or "Your class" }
    for _, o in ipairs(mine) do
        out[#out + 1] = o
    end
    if #mine == 0 then
        out[#out + 1] = { value = "__none", label = "No builds yet", disabled = true }
    end
    if #others > 0 then
        out[#out + 1] = { heading = "Other classes" }
        for _, o in ipairs(others) do
            out[#out + 1] = o
        end
    end
    return out
end

export function pickerFoot(m: TalentsModule): SelectFootLink[]
    local foot: SelectFootLink[] = {
        {
            label = "New build…",
            onClick = function()
                m:AskNewBuild()
            end,
        },
        {
            label = "Import…",
            onClick = function()
                m:ShowShare("import")
            end,
        },
    }
    if m:Viewed() then
        foot[#foot + 1] = {
            label = "Copy this build as text",
            onClick = function()
                m:ShowShare("copy")
            end,
        }
    end
    return foot
end

-- The head's buttons for what the window shows.
export function headButtons(m: TalentsModule, b: SavedBuild?, planning: boolean): BuildButton[]
    local out: BuildButton[] = {}
    if not b then
        return out
    end
    if planning then
        if b.class == CLASS then
            local d = m.draft
            local dirty = d ~= nil and d.dirty
            if m:ActiveID() == b.id then
                out[#out + 1] = {
                    label = "Your talents",
                    onClick = function()
                        m:Leave(function()
                            m.planning = false
                            m:Render()
                        end)
                    end,
                }
            else
                out[#out + 1] = {
                    label = "Use build",
                    variant = "primary",
                    disabled = dirty,
                    reason = dirty and "Save it first." or
                        "Follow it on this character: what fits is planned, Apply learns it.",
                    onClick = function()
                        m:UseBuild(b.id)
                    end,
                }
            end
        end
        out[#out + 1] = {
            label = "Delete",
            onClick = function()
                UI.Confirm({
                    title = ("Delete %s?"):format(b.name or "this build"),
                    text = "Every character on this account loses it.",
                    confirm = "Delete",
                    onConfirm = function()
                        m:DeleteBuild(b.id)
                    end,
                })
            end,
        }
        out[#out + 1] = {
            label = "Rename",
            onClick = function()
                UI.Confirm({
                    title = "Rename build",
                    confirm = "Rename",
                    input = { label = "Name", value = b.name },
                    onConfirm = function(name: string?)
                        if not name then
                            return
                        end
                        local saved = store().builds[b.id]
                        if saved then
                            saved.name = name
                        end
                        local draft = m.draft
                        if draft and draft.id == b.id then
                            draft.name = name
                        end
                        m:Emit("SUUUI_TALENT_BUILD_CHANGED")
                        m:Render()
                    end,
                })
            end,
        }
    else
        out[#out + 1] = {
            label = "Plan",
            onClick = function()
                m.planning = true
                m:Render()
            end,
            reason = "Change the build's order or talents; your talents stay as they are.",
        }
    end
    return out
end

export function picker(m: TalentsModule, b: SavedBuild?, planning: boolean): TalentBuilds
    return {
        options = m:PickerOptions(),
        value = b and b.id or "",
        foot = m:PickerFoot(),
        diamond = b and ("class-" .. b.class:lower()) or nil,
        badge = (b and m:ActiveID() == b.id) and "Active" or nil,
        buttons = m:HeadButtons(b, planning),
        onChange = function(v: string)
            if v == "__none" then
                return
            end
            m:ShowBuild(v ~= "" and v or nil)
        end,
    }
end

--------------------------------------------------------------------------------
-- Planning a build on its trees
--------------------------------------------------------------------------------

export function fillPlan(m: TalentsModule, page: TalentTree)
    local d = m:Draft()
    local tree = d and m:BuildTree(d.class)
    if not (d and tree) then
        page:SetBuilds(m:Picker(m:Viewed(), true))
        page:SetOrder(nil)
        page:SetData({ hint = "This class's talents can't be read right now." })
        return
    end
    local count: { [number]: number } = {}
    for _, s in ipairs(d.steps) do
        count[s.node] = (count[s.node] or 0) + 1
    end
    local trees: PageTreeData[] = {}
    for i, c in ipairs(tree.trees) do
        local list: PageTalent[] = {}
        local made: { [number]: PlanNode } = {}
        local points = 0
        for _, n in ipairs(c.nodes) do
            local r = count[n.id] or 0
            local problem = UI.TalentNextProblem(d.steps, tree, n.id)
            local node: PlanNode = {
                id = n.id,
                row = n.row or 0,
                col = n.col or 0,
                max = n.max or 1,
                rank = r,
                pending = 0,
                icon = n.icon,
                name = n.name or "?",
                entryID = n.entryID,
                canSpend = problem == nil,
                locked = problem ~= nil and r == 0,
                problem = problem,
            }
            list[#list + 1] = node
            made[n.id] = node
            m.planNodes[node] = node
            points = points + r
        end
        local links: TalentLink[] = {}
        for _, l in ipairs(c.links) do
            local from, to = made[l.from.id], made[l.to.id]
            if from and to then
                links[#links + 1] = { from = from, to = to, met = from.rank >= from.max }
            end
        end
        trees[i] = { name = c.name, nodes = list, links = links, points = points }
    end
    m.planTree = tree
    page:SetBuilds(m:Picker(m:Viewed(), true))
    page:SetOrder(m:OrderLines(d.steps, tree))
    local left = UI.TALENT_MAX_POINTS - #d.steps
    local status: string
    local color: string? = nil
    if d.problem then
        status, color = "Needs a look: " .. d.problem, "ember"
    elseif d.dirty then
        status, color = "Not saved yet · click adds the next step, right-click takes the last back", "arcane"
    else
        status = "Click adds the next step, right-click takes the last back · drag a line to move it"
    end
    local saved = store().builds[d.id] ~= nil
    page:SetData({
        trees = trees,
        available = left,
        spentLabel = " planned",
        editable = true,
        unspent = ("|cff%s%d|r %s left"):format(T.color.ink.hex, left, plural(left, "point", "points")),
        status = status,
        statusColor = color,
        actions = {
            secondary = {
                label = "Discard",
                enabled = d.dirty,
                onClick = function()
                    m:DiscardDraft()
                end,
            },
            primary = {
                label = "Save build",
                enabled = d.dirty and saved,
                onClick = function()
                    m:SaveDraft()
                end,
            },
        },
    })
end

export function planAdd(m: TalentsModule, n: PlanNode)
    local d = m:Draft()
    local tree = d and m:BuildTree(d.class)
    if not (d and tree) then
        return
    end
    local why = UI.TalentNextProblem(d.steps, tree, n.id)
    if why then
        UIErrorsFrame:AddMessage(why, 1, 0.35, 0.21)
        return
    end
    local talent = tree.byID[n.id]
    d.steps[#d.steps + 1] = { node = n.id, entry = talent and talent.choice and n.entryID or nil }
    d.dirty, d.problem = true, nil
    m:Render()
end

export function planRemove(m: TalentsModule, n: PlanNode)
    local d = m:Draft()
    local tree = d and m:BuildTree(d.class)
    if not (d and tree) then
        return
    end
    local at: number? = nil
    for i = #d.steps, 1, -1 do
        if d.steps[i].node == n.id then
            at = i
            break
        end
    end
    if not at then
        return
    end
    local steps = copySteps(d.steps)
    table.remove(steps, at)
    local ok, _, why = UI.TalentOrderCheck(steps, tree)
    if not ok then
        UI.Confirm({ title = "That rank can't go", text = why, cancel = false })
        return
    end
    d.steps, d.dirty, d.problem = steps, true, nil
    m:Render()
end

-- A dragged line: its run of steps in front of line `before` (#lines + 1:
-- the end), if the rows and arrows allow it; else why not.
export function moveLine(m: TalentsModule, page: TalentTree, from: number, before: number)
    local lines = page.orderLines
    local line = lines and lines[from]
    local first, last = line and line.from, line and line.to
    if not (lines and line and first and last) then
        return
    end
    local planning = m:Planning()
    local d = planning and m:Draft() or nil
    local saved = not planning and m:Viewed() or nil
    local current: TalentStep[]? = d and d.steps or (saved and store().builds[saved.id] and saved.steps) or nil
    local class = d and d.class or (saved and saved.class)
    local tree = class and m:BuildTree(class)
    if not (current and tree) then
        return
    end
    local run: TalentStep[], rest: TalentStep[] = {}, {}
    for i, s in ipairs(current) do
        if i >= first and i <= last then
            run[#run + 1] = s
        else
            rest[#rest + 1] = s
        end
    end
    -- where it goes: in front of that line's first step, among the rest
    local target = lines[before]
    local at = target and target.from or (#current + 1)
    if at > last then
        at = at - #run
    end
    local steps: TalentStep[] = {}
    for i = 1, at - 1 do
        steps[#steps + 1] = rest[i]
    end
    for _, s in ipairs(run) do
        steps[#steps + 1] = s
    end
    for i = at, #rest do
        steps[#steps + 1] = rest[i]
    end
    local ok, _, why = UI.TalentOrderCheck(steps, tree)
    if not ok then
        UI.Confirm({
            title = ("%s can't go there"):format(line.name or "That talent"),
            text = why,
            cancel = false,
            onConfirm = function()
                m:Render()
            end,
            onCancel = function()
                m:Render()
            end,
        })
        return
    end
    if d then
        d.steps, d.dirty, d.problem = steps, true, nil
    elseif saved then
        -- your active build, shown on your talents: saved at once
        local b = store().builds[saved.id]
        if b then
            b.steps, b.updated = steps, time()
        end
        m:Emit("SUUUI_TALENT_BUILD_CHANGED")
    end
    m:Render()
end

-- A planned talent's tooltip: this build's rank, its text there, the
-- steps and levels it takes, what a click does or why it can't.
export function showPlanTip(m: TalentsModule, button: Frame, n: PlanNode)
    local d = m.draft
    local tree = d and m:BuildTree(d.class)
    if not (d and tree) then
        return
    end
    local tip = GameTooltip
    tip:SetOwner(button, "ANCHOR_RIGHT")
    GameTooltip_SetTitle(tip, n.name)
    GameTooltip_AddHighlightLine(tip, ("Rank %d/%d in this build"):format(n.rank, n.max))
    local entryID = n.entryID
    if entryID then
        GameTooltip_AddBlankLineToTooltip(tip)
        errors.tryMethod(tip, "AppendInfo", "GetTraitEntry", entryID, math.max(1, n.rank))
    end
    local at: number[] = {}
    for i, s in ipairs(d.steps) do
        if s.node == n.id then
            at[#at + 1] = i
        end
    end
    if #at > 0 then
        GameTooltip_AddBlankLineToTooltip(tip)
        local a, b = at[1], at[#at]
        local la, lb = m:StepLevel(a), m:StepLevel(b)
        GameTooltip_AddNormalLine(
            tip,
            ("%s %s · %s %s"):format(
                plural(#at, "Step", "Steps"),
                a == b and a or (a .. "–" .. b),
                plural(#at, "level", "levels"),
                la == lb and la or (la .. "–" .. lb)
            )
        )
    end
    GameTooltip_AddBlankLineToTooltip(tip)
    local problem = n.problem
    if problem then
        GameTooltip_AddErrorLine(tip, problem)
    else
        GameTooltip_AddInstructionLine(
            tip,
            ("Click: step %d, level %d"):format(#d.steps + 1, m:StepLevel(#d.steps + 1))
        )
    end
    if n.rank > 0 then
        GameTooltip_AddDisabledLine(tip, "Right-click takes its last step back")
    end
    tip:Show()
end
