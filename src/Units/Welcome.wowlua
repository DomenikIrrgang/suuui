-- Units/Welcome.wowlua
-- The first-run welcome (design board "First-run splash", direction B, Three
-- steps): once per account, at the first login with SuuUI, a panel over the
-- dimmed world asks two things and shows where things are, one step at a
-- time: 1 Role (Tank, Healer, DPS or Keep my layout), 2 Colours (colour
-- vision, each choice drawing its own signal colours), 3 Where things are
-- (the commands, Settings › Modules, the choices summed up). Back and Next
-- between steps, Skip on every one.
-- Start playing applies both: the role's preset profile (SuuTank, SuuHeal,
-- SuuDps), which this character switches to, and colour vision for the
-- account (it applies at once). Skip changes nothing. Both mark it seen for the account; Settings › General and /suu welcome open it
-- again.
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import after from "wowlua:timer"
import type SuuButton from "/UI/Controls"
import type Border from "/UI/Draw"
import type LoadingMark from "/UI/LoadingMark"
import type Panel, SectionHeader, KeyChip from "/UI/Panel"
import type Text from "/UI/Text"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {}

local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local CIRCLE = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga"
local SOFT = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleSoft.tga"

-- The board's measures: a 440 px panel whose body is 640 tall, padded
-- 10 / 6 / 2 inside the panel's own padding; 16 between the parts.
local PANEL_W, BODY_H = 440, 640
local PAD_TOP, PAD_SIDE, PAD_BOTTOM = 10, 6, 2
local GAP = 16
local INNER_W = PANEL_W - 2 * S["space-5"] - 2 * PAD_SIDE -- 404

-- A text style by name; its line height, read when used (a theme may change it).
type StyleName = keyof typeof(T.type)
local function lineOf(style: StyleName): number
    return T.type[style].lineHeight
end

type Role = { id: string, glyph: string, label: string, text: string, meta?: string }
local ROLES: Role[] = {
    {
        id = "TANK",
        glyph = "shield",
        label = "Tank",
        text = "Threat meter beside the damage meter, swing timer under your cast bar.",
    },
    {
        id = "HEALER",
        glyph = "plus",
        label = "Healer",
        text = "Your group in the middle, between your frame and your target’s.",
    },
    {
        id = "DAMAGER",
        glyph = "sword",
        label = "DPS",
        text = "You and your target either side of the centre, your group above the chat.",
    },
    {
        id = "keep",
        glyph = "pushpin",
        label = "Keep my layout",
        meta = "No change",
        text = "Nothing moves: SuuUI’s default layout stays as it is.",
    },
}

local VISION_TEXT: { [string]: string } = {
    normal = "The colours as designed",
    redgreen = "Protanopia, deuteranopia",
    blueyellow = "Tritanopia",
}

-- The six signals each colour choice draws in its own preset.
type SignalDef = { token: string, label: string }
local SIGNALS: SignalDef[] = {
    { token = "ember", label = "Danger" },
    { token = "unit-fill-low", label = "Low health" },
    { token = "fel", label = "Healing" },
    { token = "amber", label = "Warning" },
    { token = "dispel-magic", label = "Magic" },
    { token = "dispel-poison", label = "Poison" },
}

local STEPS = { "1 · Role", "2 · Colours", "3 · Where things are" }

local function glyph(parent: Frame, name: string, size: number, color: string, layer: DrawLayer?): Texture
    local t = parent:CreateTexture(nil, layer or "ARTWORK")
    t:SetTexture(GLYPHS .. name .. ".tga")
    t:SetSize(size, size)
    UI.Paint(t, color)
    return t
end

local function circle(parent: Frame, size: number, color: string, sublevel: number): Texture
    local t = parent:CreateTexture(nil, "ARTWORK", nil, sublevel)
    t:SetTexture(CIRCLE)
    t:SetSize(size, size)
    UI.Paint(t, color)
    return t
end

-- the wrapped texts and their styles, for a theme change
local wraps: { [Text]: StyleName } = {}
setmetatable(wraps, { __mode = "k" })

-- Caption text that wraps at `width`, 14 px a line as in the design.
local function wrapped(parent: Frame, style: StyleName, color: string, width: number): Text
    local fs = UI.Text(parent, style, color)
    fs:SetWordWrap(true)
    fs:SetJustifyH("LEFT")
    fs:SetJustifyV("TOP")
    fs:SetWidth(width)
    fs:SetSpacing(T.type[style].lineHeight - T.type[style].size)
    wraps[fs] = style
    return fs
end

-- The height a wrapped text takes in design lines.
local function linesHeight(fs: Text, style: StyleName): number
    local n = math.max(1, fs:GetNumLines() or 1)
    return n * lineOf(style)
end

-- A text set in its design line: `top` is the line box's top in `parent`.
local function placeLine(fs: Region, parent: Region, x: number, top: number, style: StyleName)
    fs:ClearAllPoints()
    fs:SetPoint("LEFT", parent, "TOPLEFT", x, -(top + lineOf(style) / 2))
end

--------------------------------------------------------------------------------
-- A choice tile: a radio, the choice and what it does; arcane once chosen.
--------------------------------------------------------------------------------

-- A signal of a colour tile: its swatch and its word.
type Signal = { swatch: Texture, text: Text, width: number }

export class WelcomeTile extends Button
    readonly bg: Texture
    readonly border: Border
    readonly inner: Border
    readonly ring: Texture
    readonly hole: Texture
    readonly dot: Texture
    readonly label: Text
    selected: boolean = false
    -- the choice (a role, a colour vision mode)
    value: string = ""
    -- a role's: its glyph, its preset's name, what it does
    icon: Texture? = nil
    meta: Text? = nil
    text: Text? = nil
    -- a colour vision's: what it is for, its signals
    hint: Text? = nil
    signals: Signal[] = {}

    constructor(parent: Frame, value: string, onClick: (tile: WelcomeTile) -> ())
        super(nil, parent)
        self.value = value
        self:SetWidth(INNER_W)
        self.bg = UI.Fill(self, "surface-raised")
        self.bg:SetAllPoints()
        self.border = UI.Border(self, "gilt-line")
        -- the chosen tile's border is two lines: its own and an inset one
        self.inner = UI.Border(self, "arcane", { inset = 1 })
        self.inner:SetShown(false)
        self.ring = circle(self, 12, "gilt-line", 1)
        self.hole = circle(self, 10, "surface-raised", 2)
        self.hole:SetPoint("CENTER", self.ring)
        self.dot = circle(self, 6, "arcane", 3)
        self.dot:SetPoint("CENTER", self.ring)
        self.label = UI.Text(self, "label", "ink")
        self:SetScript("OnEnter", function()
            if not self.selected then
                self.border:SetColor("gilt")
            end
        end)
        self:SetScript("OnLeave", function()
            if not self.selected then
                self.border:SetColor("gilt-line")
            end
        end)
        self:SetScript("OnClick", function()
            onClick(self)
        end)
    end

    function SetSelected(on: boolean)
        self.selected = on
        UI.PaintFill(self.bg, on and "arcane-soft" or "surface-raised")
        self.border:SetColor(on and "arcane" or "gilt-line")
        self.inner:SetShown(on)
        UI.Paint(self.ring, on and "arcane" or "gilt-line")
        UI.Paint(self.hole, on and "arcane-soft" or "surface-raised")
        self.dot:SetShown(on)
        if self.icon then
            UI.Paint(self.icon, on and "arcane" or "ink-muted")
        end
        if self.meta then
            self.meta:SetColor(on and "arcane" or "ink-faint")
        end
    end
end

--------------------------------------------------------------------------------
-- The steps
--------------------------------------------------------------------------------

-- A step mark of the head: done in gilt, this one arcane with its glow, the
-- rest outlined.
type StepDot = { line?: Texture, glow: Texture, edge: Texture, hole: Texture, fill: Texture, text: Text }

-- A line of the summary: its glyph, the choice, a note.
type Choice = { glyph: Texture, text: Text, meta: Text }

-- A place of step 3: a command's key or a glyph, its label and what it does.
type PlaceRow = { key?: KeyChip, glyph?: Texture, label: Text, text: Text }

-- A step's page (laid out on show: wrapped text measures once its font is in).
export class WelcomePage extends Frame
    readonly header: SectionHeader
    tiles: WelcomeTile[] = {}
    -- step 3's summary of the choices
    choices: Choice[] = {}

    constructor(parent: Frame, title: string, meta: string?)
        super(nil, parent)
        self.header = UI.SectionHeader(self, title, meta, INNER_W)
    end

    function Layout() end
end

-- Step 1: the role tiles.
class RolePage extends WelcomePage
    readonly note: Text

    constructor(parent: Frame, owner: WelcomeModule)
        super(parent, "Your role layout", "this character")
        for _, r in ipairs(ROLES) do
            local b = WelcomeTile.new(self, r.id, function(tile: WelcomeTile)
                owner.role = tile.value
                owner:DrawChoices()
            end)
            b.icon = glyph(b, r.glyph, 18, "ink-muted")
            b.label:SetValue(r.label)
            local meta = UI.Text(b, "caption", "ink-faint")
            meta:SetPoint("BOTTOMLEFT", b.label, "BOTTOMRIGHT", S["space-4"], 0)
            meta:SetValue(r.meta or SuuUI.RolePresetName(r.id) or "")
            b.meta = meta
            local text = wrapped(b, "caption", "ink-muted", INNER_W - 66 - S["space-5"])
            text:SetValue(r.text)
            b.text = text
            self.tiles[#self.tiles + 1] = b
        end
        self.note = wrapped(self, "caption", "ink-muted", INNER_W)
        self.note:SetValue("For dungeons and raids alike. Settings › Profiles changes it later.")
    end

    override function Layout()
        self.header:SetPoint("TOPLEFT", 0, 0)
        local y = T.type.header.lineHeight + S["space-5"]
        local label, caption = lineOf("label"), lineOf("caption")
        for _, b in ipairs(self.tiles) do
            local icon, text = assert(b.icon), assert(b.text)
            -- 9 / 12 padding; radio, glyph and text 12 apart
            b.ring:ClearAllPoints()
            b.ring:SetPoint("LEFT", S["space-5"], 0)
            icon:ClearAllPoints()
            icon:SetPoint("LEFT", S["space-5"] + 12 + S["space-5"], 0)
            placeLine(b.label, b, 66, 9, "label")
            text:ClearAllPoints()
            text:SetPoint("TOPLEFT", 66, -(9 + label + 2 + (caption - T.type.caption.size) / 2))
            local h = 9 + label + 2 + linesHeight(text, "caption") + 9
            b:SetHeight(h)
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", 0, -y)
            y = y + h + S["space-3"]
        end
        y = y - S["space-3"] + S["space-5"]
        self.note:ClearAllPoints()
        self.note:SetPoint("TOPLEFT", 0, -(y + (caption - T.type.caption.size) / 2))
    end
end

-- Step 2: the colour vision tiles, each with its six signals.
class ColoursPage extends WelcomePage
    readonly note: Text

    constructor(parent: Frame, owner: WelcomeModule)
        super(parent, "Colour vision", "every character")
        for _, mode in ipairs(SuuUI.ColorVisionModes()) do
            local b = WelcomeTile.new(self, mode.id, function(tile: WelcomeTile)
                owner.vision = tile.value
                owner:DrawChoices()
            end)
            b.label:SetValue(mode.label)
            local hint = UI.Text(b, "caption", "ink-muted")
            hint:SetPoint("LEFT", b.label, "RIGHT", S["space-5"], 0)
            hint:SetValue(VISION_TEXT[mode.id] or mode.hint or "")
            b.hint = hint
            for _, s in ipairs(SIGNALS) do
                local swatch = b:CreateTexture(nil, "ARTWORK")
                swatch:SetSize(16, 6)
                swatch:SetColorTexture(SuuUI.ColorVisionColor(mode.id, s.token))
                local text = UI.Text(b, "caption", "ink-muted")
                text:SetValue(s.label)
                b.signals[#b.signals + 1] = {
                    swatch = swatch,
                    text = text,
                    width = 16 + 5 + UI.MeasureText("caption", s.label),
                }
            end
            self.tiles[#self.tiles + 1] = b
        end
        self.note = wrapped(self, "caption", "ink-muted", INNER_W)
        self.note:SetValue("Only the signal colours change; shapes, badges and labels stay.")
    end

    override function Layout()
        self.header:SetPoint("TOPLEFT", 0, 0)
        local y = T.type.header.lineHeight + S["space-5"]
        local label, caption = lineOf("label"), lineOf("caption")
        for _, b in ipairs(self.tiles) do
            -- 10 / 12 padding: the choice on one line, the signals under it
            -- from the text's edge, wrapping 6 / 10 apart
            b.ring:ClearAllPoints()
            b.ring:SetPoint("CENTER", b, "TOPLEFT", S["space-5"] + 6, -(10 + label / 2))
            placeLine(b.label, b, S["space-5"] + 12 + S["space-5"], 10, "label")
            local left, maxW = S["space-5"] + 24, INNER_W - 2 * S["space-5"] - 24
            local x, top = 0, 10 + label + S["space-4"]
            for _, s in ipairs(b.signals) do
                if x > 0 and x + s.width > maxW then
                    x = 0
                    top = top + caption + S["space-3"]
                end
                s.swatch:ClearAllPoints()
                s.swatch:SetPoint("LEFT", b, "TOPLEFT", left + x, -(top + caption / 2))
                placeLine(s.text, b, left + x + 16 + 5, top, "caption")
                x = x + s.width + 10
            end
            local h = top + caption + 10
            b:SetHeight(h)
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", 0, -y)
            y = y + h + S["space-3"]
        end
        y = y - S["space-3"] + S["space-5"]
        self.note:ClearAllPoints()
        self.note:SetPoint("TOPLEFT", 0, -(y + (caption - T.type.caption.size) / 2))
    end
end

-- Step 3: where things are, the choices summed up.
type Place = { key?: string, glyph?: string, label: string, text: string }
local PLACES: Place[] = {
    { key = "/suu", label = "Settings", text = "or Esc › SuuUI settings" },
    { key = "/suu edit", label = "Move frames", text = "or Esc › Edit Mode" },
    { key = "/suu keybind", label = "Bind keys", text = "hover a button, press a key" },
    {
        glyph = "layers",
        label = "Turn a feature off",
        text = "Settings › Modules: every feature is a module; plugins add their own",
    },
}
local KEY_COL = 104

class PlacesPage extends WelcomePage
    readonly rows: PlaceRow[] = {}
    -- your choices, on surface-sunk
    readonly box: Frame
    readonly boxHead: Text

    constructor(parent: Frame)
        super(parent, "Where things are", nil)
        for _, p in ipairs(PLACES) do
            local key = p.key
            local chip: KeyChip?, mark: Texture? = nil, nil
            if key then
                chip = UI.KeyChip(self, key)
                chip:SetWidth(UI.MeasureText("micro", key) + 2 * S["space-3"])
            else
                mark = glyph(self, assert(p.glyph), 16, "gilt-text")
            end
            local label = UI.Text(self, "label", "ink")
            label:SetValue(p.label)
            local text = wrapped(self, "caption", "ink-muted", INNER_W - KEY_COL - 10)
            text:SetValue(p.text)
            self.rows[#self.rows + 1] = { key = chip, glyph = mark, label = label, text = text }
        end
        local box = CreateFrame("Frame", nil, self)
        UI.Fill(box, "surface-sunk"):SetAllPoints()
        UI.Border(box, "gilt-faint")
        self.boxHead = UI.Text(box, "caption", "ink-faint")
        self.boxHead:SetValue("Your choices")
        for i = 1, 2 do
            local text = UI.Text(box, "body", "ink")
            local meta = UI.Text(box, "caption", "ink-muted")
            meta:SetPoint("LEFT", text, "RIGHT", S["space-4"], 0)
            self.choices[i] = { glyph = glyph(box, "plus", 14, "arcane"), text = text, meta = meta }
        end
        self.box = box
    end

    override function Layout()
        self.header:SetPoint("TOPLEFT", 0, 0)
        local y = T.type.header.lineHeight + S["space-5"]
        local label, caption, bodyLine = lineOf("label"), lineOf("caption"), lineOf("body")
        for _, r in ipairs(self.rows) do
            -- the key on the label's line (baseline to baseline, near enough)
            local mark: Region = r.key or assert(r.glyph)
            mark:ClearAllPoints()
            mark:SetPoint("LEFT", self, "TOPLEFT", 0, -(y + label / 2))
            placeLine(r.label, self, KEY_COL + 10, y, "label")
            r.text:ClearAllPoints()
            r.text:SetPoint("TOPLEFT", KEY_COL + 10, -(y + label + 1 + (caption - T.type.caption.size) / 2))
            y = y + label + 1 + linesHeight(r.text, "caption") + 10
        end
        y = y - 10 + S["space-5"]
        local box = self.box
        box:SetSize(INNER_W, 10 + caption + S["space-3"] + bodyLine + S["space-3"] + bodyLine + 10)
        placeLine(self.boxHead, box, S["space-5"], 10, "caption")
        for i, c in ipairs(self.choices) do
            local top = 10 + caption + S["space-3"] + (i - 1) * (bodyLine + S["space-3"])
            c.glyph:ClearAllPoints()
            c.glyph:SetPoint("LEFT", box, "TOPLEFT", S["space-5"], -(top + bodyLine / 2))
            placeLine(c.text, box, S["space-5"] + 14 + S["space-4"], top, "body")
        end
        box:ClearAllPoints()
        box:SetPoint("TOPLEFT", 0, -y)
    end
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

class WelcomeModule extends Module<typeof(DEFAULTS)>
    back: SuuButton? = nil
    dim: Frame? = nil
    dotRow: Frame? = nil
    dots: StepDot[] = {}
    footTop: number = 0
    headSub: Text? = nil
    headTitle: Text? = nil
    mark: LoadingMark? = nil
    next: SuuButton? = nil
    pages: WelcomePage[] = {}
    panel: Panel? = nil
    play: SuuButton? = nil
    -- the choices: a role ("keep": your layout stays), a colour vision mode
    role: string = "keep"
    vision: string = "normal"
    skip: SuuButton? = nil
    step: number = 1

    constructor()
        super({
            id = "welcome",
            name = "Welcome",
            description = "The first-run welcome: your role layout, colour vision and where things are, once per account.",
            api = "0.17",
            defaults = DEFAULTS,
        })
    end

    function BuildHead(box: Frame): number
        -- the emblem, still
        local mark = UI.LoadingMark(box, { size = 30 })
        self.mark = mark
        mark:SetPoint("TOP", 0, 0)
        mark:Show()
        -- the title: the display face at 21 px on a 26 px line
        local title = UI.Text(box, "alert", "ink")
        self.headTitle = title
        title:SetValue("Welcome to SuuUI")
        local sub = UI.Text(box, "caption", "ink-muted")
        self.headSub = sub
        sub:SetValue("Quiet until it matters. Three short steps.")

        -- the step dots: done in gilt, this one arcane with its glow, the rest outlined
        local row = CreateFrame("Frame", nil, box)
        self.dotRow = row
        self.dots = {}
        for i, text in ipairs(STEPS) do
            local line: Texture? = nil
            if i > 1 then
                line = UI.Fill(row, "gilt-line", "ARTWORK")
                line:SetSize(20, 1)
            end
            local glow = row:CreateTexture(nil, "BACKGROUND")
            glow:SetTexture(SOFT)
            glow:SetSize(22, 22)
            UI.Paint(glow, "arcane-glow")
            local edge = UI.Diamond(row, 8, "gilt-line", "ARTWORK", 1)
            -- an outline: the panel's ground inside a 1 px edge
            local hole = UI.Diamond(row, 6, "surface", "ARTWORK", 2)
            hole:SetPoint("CENTER", edge)
            local fill = UI.Diamond(row, 8, "arcane", "ARTWORK", 3)
            fill:SetPoint("CENTER", edge)
            local label = UI.Text(row, "caption", "ink-faint")
            label:SetValue(text)
            self.dots[i] = { line = line, glow = glow, edge = edge, hole = hole, fill = fill, text = label }
        end
        return self:LayoutHead(box)
    end

    -- The head's lines from the text styles (again after a theme change);
    -- returns where the steps start.
    function LayoutHead(box: Frame): number
        local title, sub, row = assert(self.headTitle), assert(self.headSub), assert(self.dotRow)
        local caption = lineOf("caption")
        local y = assert(self.mark):GetHeight() + S["space-3"] + 2
        title:SetFont(T.type.alert.file, 21, "")
        title:ClearAllPoints()
        title:SetPoint("CENTER", box, "TOP", 0, -(y + 13))
        y = y + 26 + S["space-3"]
        sub:ClearAllPoints()
        sub:SetPoint("CENTER", box, "TOP", 0, -(y + caption / 2))
        y = y + caption + GAP
        row:SetHeight(caption)
        row:ClearAllPoints()
        row:SetPoint("TOP", 0, -y)
        local x = 0
        for i, d in ipairs(self.dots) do
            local line = d.line
            if line then
                line:ClearAllPoints()
                line:SetPoint("LEFT", row, "LEFT", x, 0)
                x = x + 20 + S["space-4"]
            end
            d.glow:ClearAllPoints()
            d.glow:SetPoint("CENTER", row, "LEFT", x + 4, 0)
            d.edge:ClearAllPoints()
            d.edge:SetPoint("CENTER", row, "LEFT", x + 4, 0)
            d.text:ClearAllPoints()
            d.text:SetPoint("LEFT", row, "LEFT", x + 8 + 7, 0)
            x = x + 8 + 7 + UI.MeasureText("caption", assert(STEPS[i])) + S["space-4"]
        end
        row:SetWidth(x - S["space-4"])
        return y + caption + GAP
    end

    function DrawDots()
        for i, d in ipairs(self.dots) do
            local now, done = i == self.step, i < self.step
            d.glow:SetShown(now)
            d.fill:SetShown(now or done)
            UI.Paint(d.fill, now and "arcane" or "gilt")
            d.edge:SetShown(not (now or done))
            d.hole:SetShown(not (now or done))
            d.text:SetColor(now and "ink" or (done and "ink-muted" or "ink-faint"))
        end
    end

    function DrawSummary(page: WelcomePage)
        local role, vision = assert(page.choices[1]), assert(page.choices[2])
        if self.role == "keep" then
            role.glyph:SetTexture(GLYPHS .. "pushpin.tga")
            role.text:SetValue("Your layout as it is")
            role.meta:SetValue("no change")
        else
            for _, r in ipairs(ROLES) do
                if r.id == self.role then
                    role.glyph:SetTexture(GLYPHS .. r.glyph .. ".tga")
                    role.text:SetValue(r.label .. " layout")
                    role.meta:SetValue((SuuUI.RolePresetName(r.id) or r.label) .. ", this character")
                end
            end
        end
        vision.glyph:SetTexture(GLYPHS .. "eye.tga")
        local label = self.vision
        for _, mode in ipairs(SuuUI.ColorVisionModes()) do
            if mode.id == self.vision then
                label = mode.label or mode.id
            end
        end
        vision.text:SetValue(label .. " colours")
        vision.meta:SetValue("every character")
    end

    function Build()
        -- the dimmed world under it, taking every click
        local dim = CreateFrame("Frame", nil, SuuUI.Root)
        dim:SetAllPoints(UIParent)
        dim:SetFrameStrata("DIALOG")
        dim:EnableMouse(true)
        local shade = dim:CreateTexture(nil, "BACKGROUND")
        shade:SetAllPoints()
        shade:SetColorTexture(8 / 255, 7 / 255, 10 / 255, 0.45)
        dim:Hide()
        self.dim = dim

        local p = UI.Panel(dim, { anchor = true, width = PANEL_W })
        p:SetPoint("CENTER", UIParent, "CENTER", 0, 0)
        p:SetFrameLevel(dim:GetFrameLevel() + 5)
        p.body:SetHeight(BODY_H)
        p:Fit()
        self.panel = p

        -- Esc skips, like Skip; other keys go on to the game
        p:EnableKeyboard(true)
        p:SetScript("OnKeyDown", function(frame: Frame, key: string)
            if InCombatLockdown() then
                return
            end
            if key == "ESCAPE" then
                frame:SetPropagateKeyboardInput(false)
                self:Close()
            else
                frame:SetPropagateKeyboardInput(true)
            end
        end)

        local box = CreateFrame("Frame", nil, p.body)
        box:SetPoint("TOPLEFT", PAD_SIDE, -PAD_TOP)
        box:SetPoint("BOTTOMRIGHT", -PAD_SIDE, PAD_BOTTOM)
        local top = self:BuildHead(box)

        -- the foot: Skip on the left; Back and Next (or Start playing) on the right
        local skip = UI.Button(box, {
            text = "Skip",
            onClick = function()
                self:Close()
            end,
        })
        self.skip = skip
        skip:SetPoint("BOTTOMLEFT")
        local nextButton = UI.Button(box, {
            text = "Next",
            variant = "primary",
            onClick = function()
                self:Go(self.step + 1)
            end,
        })
        self.next = nextButton
        nextButton:SetPoint("BOTTOMRIGHT")
        local play = UI.Button(box, {
            text = "Start playing",
            variant = "primary",
            onClick = function()
                self:Start()
            end,
        })
        self.play = play
        play:SetPoint("BOTTOMRIGHT")
        local back = UI.Button(box, {
            text = "Back",
            icon = "chevronLeft",
            onClick = function()
                self:Go(self.step - 1)
            end,
        })
        self.back = back
        back:SetPoint("BOTTOMRIGHT", nextButton, "BOTTOMLEFT", -S["space-4"], 0)
        local footTop = 30 + GAP
        self.footTop = footTop
        local rule = UI.Hairline(box, "gilt-line", "both")
        rule:SetPoint("BOTTOMLEFT", 0, footTop)
        rule:SetPoint("BOTTOMRIGHT", 0, footTop)
        local jewel = UI.Diamond(box, 6, "gilt")
        jewel:SetPoint("CENTER", rule, "CENTER", 0, 0)

        -- the steps, between the dots and the rule
        self.pages = { RolePage.new(box, self), ColoursPage.new(box, self), PlacesPage.new(box) }
        for _, page in ipairs(self.pages) do
            page:SetPoint("TOPLEFT", 0, -top)
            page:SetPoint("BOTTOMRIGHT", 0, footTop + 1 + GAP)
            page:Hide()
        end
    end

    function DrawChoices()
        for _, b in ipairs(assert(self.pages[1]).tiles) do
            b:SetSelected(b.value == self.role)
        end
        for _, b in ipairs(assert(self.pages[2]).tiles) do
            b:SetSelected(b.value == self.vision)
        end
    end

    function Go(step: number)
        self.step = math.max(1, math.min(3, step))
        for i, page in ipairs(self.pages) do
            page:SetShown(i == self.step)
            -- laid out on show: wrapped text measures once its font is in
            if i == self.step then
                page:Layout()
            end
        end
        self:DrawDots()
        local back, nextButton, play = assert(self.back), assert(self.next), assert(self.play)
        back:SetShown(self.step > 1)
        nextButton:SetShown(self.step < 3)
        play:SetShown(self.step == 3)
        back:ClearAllPoints()
        back:SetPoint("BOTTOMRIGHT", self.step == 3 and play or nextButton, "BOTTOMLEFT", -S["space-4"], 0)
        if self.step == 3 then
            self:DrawSummary(assert(self.pages[3]))
        end
        self:DrawStart()
    end

    -- Start playing waits for the end of a fight: the layout moves secure frames.
    -- (`starting`: the fight begins: its event comes before the lockdown)
    function DrawStart(starting: boolean?)
        local play = assert(self.play)
        local fighting = starting or InCombatLockdown()
        play:SetEnabledState(not fighting)
        play.tooltip = fighting and { title = "Start playing", description = "After the fight." } or nil
    end

    -- The welcome, while it shows.
    function Shown(): boolean
        local dim = self.dim
        return dim ~= nil and dim:IsShown()
    end

    function Show()
        if not self.panel then
            self:Build()
        end
        -- nothing chosen: your layout stays, the colours you have
        self.role = "keep"
        self.vision = (SuuUI.ColorVision())
        self:DrawChoices()
        assert(self.dim):Show()
        SuuUI.Motion.Enter(assert(self.panel), T.duration["dur-base"])
        self:Go(1)
    end

    function MarkSeen()
        SuuUI.AccountData("welcome").seen = true
    end

    function Close()
        local dim = self.dim
        if not (dim and dim:IsShown()) then
            return
        end
        self:MarkSeen()
        dim:Hide()
    end

    -- The choices made real: the role's preset (this character switches to it)
    -- and the account's colour vision. False when the preset couldn't be made.
    function Apply(): boolean
        if self.role ~= "keep" then
            local ok, err = SuuUI.ApplyRolePreset(self.role, true)
            if not ok then
                self:Print(("%s: %s"):format(SuuUI.RolePresetName(self.role) or self.role, tostring(err)))
                return false
            end
        end
        SuuUI.SetColorVision(self.vision)
        self:MarkSeen()
        return true
    end

    function Start()
        if InCombatLockdown() then
            return
        end
        if self:Apply() then
            self:Close()
        end
    end

    override function OnEnable()
        self:Provide("welcome", {
            Show = function()
                self:Show()
            end,
        })
        self:RegisterCommand("welcome", "Show the first-run welcome again: role layout, colour vision, where things are.", function()
            self:Show()
        end)
        -- Start playing waits for the end of a fight
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            if self:Shown() then
                self:DrawStart(true)
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if self:Shown() then
                self:DrawStart()
            end
        end)
        -- a theme change: the line heights and faces again, the open step laid out anew
        self:On("SUUUI_THEME_CHANGED", function()
            local title = self.headTitle
            if not self.panel or not title then
                return
            end
            for fs, style in pairs(wraps) do
                fs:SetSpacing(T.type[style].lineHeight - T.type[style].size)
            end
            local top = self:LayoutHead(assert(title:GetParent()))
            for _, page in ipairs(self.pages) do
                page:ClearAllPoints()
                page:SetPoint("TOPLEFT", 0, -top)
                page:SetPoint("BOTTOMRIGHT", 0, self.footTop + 1 + GAP)
            end
            if self:Shown() then
                self:Go(self.step)
            end
        end)
        -- once per account, at the first login with SuuUI: a moment after the
        -- world is in, and out of combat
        if not SuuUI.AccountData("welcome").seen then
            after(2, function()
                if not self:IsEnabled() or SuuUI.AccountData("welcome").seen then
                    return
                end
                self:RunOutOfCombat("first", function()
                    if self:IsEnabled() and not self:Shown() then
                        self:Show()
                    end
                end)
            end)
        end
    end

    override function OnDisable()
        local dim = self.dim
        if dim then
            dim:Hide()
        end
    end
end

-- (the tests read it)
export local M = SuuUI.AddModule(WelcomeModule.new())
