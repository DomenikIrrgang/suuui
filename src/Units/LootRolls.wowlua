-- Units/LootRolls.wowlua
-- Group loot rolls in the roll tray (design board "Loot roll · C · Roll
-- tray"), high in the middle of the screen and moved in edit mode. A row
-- per open roll, in the order the game started them: the item, the
-- seconds left (a bar along the row, amber under 10 s), Need / Greed /
-- Pass with how many chose each, who chose what under it (every name on
-- hovering the row), your choice pressed in arcane. A choice the game won't let you
-- take is dimmed with its reason. WoW Forever has no Disenchant: Need, Greed
-- and Pass only. "Pass on all" answers every roll you haven't; "Greed on
-- all" asks once first. Results under the rows show who won what, each
-- for 5 s once its roll is decided (or until you close them). The tray opens
-- by itself when a roll starts, in combat too, and folds into a one-line
-- tab. A built-in module written against the public API only.
--
-- Choosing is RollOnLoot (allowed to addons, in combat too). Bind on
-- Pickup: the game asks (CONFIRM_LOOT_ROLL) and the tray asks in the roll's
-- row. The game's own popup goes out of sight, its OK and Cancel buttons
-- laid see-through over the row's (only points, sizes, levels and the
-- popup's alpha change, all put back when it closes), so the answer is the
-- popup's own click and nothing of Blizzard's runs from SuuUI's code. A
-- row the popup isn't for (a second Bind on Pickup roll while it asks
-- about another) answers with ConfirmLootRoll. Votes and the results come
-- from the game's loot lines in chat and its loot history. Blizzard's roll
-- frames keep running off screen.
--
-- A roll is its game roll ID. The loot lines and the loot history name the
-- item, not the roll, and two open rolls of one item are common: which roll
-- such a line is about follows the rules in LootRolls/Rolls (your vote to
-- the roll you answered; another's to the oldest they haven't voted on; a
-- result to the roll it fits, ending a row only when that is certain). A
-- line that can't be put on a roll for certain never answers, locks or
-- removes a row you haven't answered. A row goes when the game ends its
-- roll ID or its time runs out.
--
-- Drawing: a vote line redraws only its roll's row (LootRollTray:SetRow),
-- once a frame at most, and nothing while the tray is folded or hidden
-- (drawn when it shows again). Names get their class colour from one map
-- of the group read once a roster change (LootRolls/Group).

import SuuUI, Module from "/Core/API"
import type SettingsSection, Position, LootRollTray, RollRowData, RollChoiceData, RollResultData, RollTrayData, SuuButton from "/Core/API"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as item from "wowlua:item"
import * as lines from "/Units/LootRolls/Lines"
import * as rolls from "/Units/LootRolls/Rolls"
import GroupNames, short from "/Units/LootRolls/Group"

local UI, T = SuuUI.UI, SuuUI.Tokens

local DEFAULTS = {
    -- the middle of the screen, high up: its top 80 px down (a value at
    -- its default isn't stored, so only a tray moved in edit mode keeps
    -- its own place when this changes)
    position = { point = "TOP", x = 0, y = -80 } :: Position,
    unfold = true, -- a new roll opens the folded tray
    results = true, -- who won what, each 5 s after its roll
}

local QUALITY: { [number]: string } = {
    [0] = "poor",
    "common",
    "uncommon",
    "rare",
    "epic",
    "legendary",
    "legendary",
    "legendary",
}

-- s each result stays after its roll was decided, on its own (asked
-- 2026-11-11: "a done roll should only stay 5 seconds after it was rolled
-- out, then disappear and not wait for other rolls")
local RESULTS_STAY = 5
-- results kept (the oldest go)
local RESULTS_KEPT = 8
-- s a roll stays past its time when the game hasn't said it's over
local ROLL_GRACE = 5
-- names per choice on a row's line of who chose what, at most; the
-- characters that line has room for (caption, about 5.5 px each)
local NAMES_SHOWN = 4
local WHO_CHARS = 84
local TICK = 0.1

--------------------------------------------------------------------------------
-- Rolls
--------------------------------------------------------------------------------

export type ChoiceKey = rolls.ChoiceKey
export type Roll = rolls.Roll
type Choice = { key: ChoiceKey, label: string, type: number }
-- (WoW Forever has no Disenchant)
local CHOICES: Choice[] = {
    { key = "need", label = "Need", type = LOOT_ROLL_TYPE_NEED or 1 },
    { key = "greed", label = "Greed", type = LOOT_ROLL_TYPE_GREED or 2 },
    { key = "pass", label = "Pass", type = LOOT_ROLL_TYPE_PASS or 0 },
}
local CHOICE_BY_TYPE: { [number]: Choice } = {}
local CHOICE_BY_KEY: { [string]: Choice } = {}
for _, c in ipairs(CHOICES) do
    CHOICE_BY_TYPE[c.type] = c
    CHOICE_BY_KEY[c.key] = c
end

-- Your vote on a drop as the loot history says it
-- (Enum.EncounterLootDropRollState: NeedMainSpec, NeedOffSpec, Transmog,
-- Greed, NoRoll, Pass).
local function mineOf(state: number?): rolls.Mine?
    if state == 0 or state == 1 then
        return "need"
    elseif state == 3 then
        return "greed"
    elseif state == 4 then
        return "none"
    elseif state == 5 then
        return "pass"
    end
    return nil
end

-- A decided roll: who won it (nil: everyone passed); the sources that told
-- (a decision comes as a chat line and as the loot history's drop: one
-- result for both).
export type Result = { roll: Roll, winner?: string, at: number, sources: { line?: boolean, drop?: boolean } }

-- s a roll stays among the ended ones for a line about it that comes late
local ENDED_KEPT = 30
-- s a result from one source waits for the same decision from the other
local SAME_DECISION = 10
-- s a decided drop of the loot history is known as told (its later updates)
local DROP_KEPT = 300

local COLORS: { [string]: { hex: string } } = T.color

local function colored(token: string, s: string): string
    local c = COLORS[token]
    return c and ("|cff" .. c.hex .. s .. "|r") or s
end

local function qualityName(roll: Roll): string
    return roll.quality ~= "common" and colored("quality-" .. roll.quality, roll.name) or roll.name
end

-- A name in its class colour (a test roll's own classes, else the group's).
local function classColored(name: string, roll: Roll, group: GroupNames): string
    local s = short(name)
    local known = roll.classes
    local class = (known and known[s]) or group:ClassOf(s)
    local c = class and COLORS["class-" .. class:lower()]
    return c and ("|cff" .. c.hex .. s .. "|r") or s
end

-- Everyone in your group but you, by name (the roll's own list in a test).
local function roster(roll: Roll, group: GroupNames): string[]
    return roll.roster or group:Others()
end

-- Who hasn't chosen yet (you aren't listed: your own row says whether you have).
local function waitingOn(roll: Roll, group: GroupNames): string[]
    local chose: { [string]: boolean } = {}
    for _, c in ipairs(CHOICES) do
        for _, name in ipairs(roll.votes[c.key]) do
            chose[short(name)] = true
        end
    end
    local out: string[] = {}
    for _, name in ipairs(roster(roll, group)) do
        if not chose[short(name)] then
            out[#out + 1] = name
        end
    end
    return out
end

-- Names in class colours, `most` at most (default all) and how many more.
local function nameList(roll: Roll, group: GroupNames, names: string[], most: number?): string
    local cap = most or #names
    local shown: string[] = {}
    for i = 1, math.min(#names, cap) do
        shown[i] = classColored(names[i], roll, group)
    end
    local s = table.concat(shown, ", ")
    if #names > cap then
        s = s .. (s ~= "" and " " or "") .. ("+%d"):format(#names - cap)
    end
    return s
end

-- One group of the line: "Need Brannoc, Ysolde +3" (the label muted).
type WhoGroup = { label: string, names: string[] }

-- Plain text's length (colour codes left out).
local function plainLength(s: string): number
    local plain = s:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", "")
    return #plain
end

-- The line of who chose what, in one row's width: as many names per
-- choice as fit (NAMES_SHOWN at most), the rest counted ("+12"). A raid
-- of 40 comes down to one name a choice, or only the counts.
local function whoLine(roll: Roll, group: GroupNames, groups: WhoGroup[]): string?
    if #groups == 0 then
        return nil
    end
    local line = ""
    for most = NAMES_SHOWN, 0, -1 do
        local parts: string[] = {}
        for i, g in ipairs(groups) do
            parts[i] = colored("ink-muted", g.label) .. " " .. nameList(roll, group, g.names, most)
        end
        line = table.concat(parts, colored("ink-faint", "  ·  "))
        if plainLength(line) <= WHO_CHARS then
            return line
        end
    end
    return line
end

-- "Binds when picked up · Sword": the bind, and the weapon's kind or the slot.
local function describe(roll: Roll): string
    local parts: string[] = {}
    local data = roll.link and item.get(roll.link) or nil
    if roll.bop then
        parts[1] = ITEM_BIND_ON_PICKUP or "Binds when picked up"
    elseif data and data.bindType == 2 then
        parts[1] = ITEM_BIND_ON_EQUIP or "Binds when equipped"
    elseif data and data.bindType == 3 then
        parts[1] = ITEM_BIND_ON_USE or "Binds when used"
    end
    if data then
        local loc = data.equipLoc
        local slot = loc and loc ~= "" and secret.asString(tbl.field(_G, loc)) or nil
        local kind = (data.classID == 2 and data.subType) or slot or nil
        if kind and kind ~= "" then
            parts[#parts + 1] = kind
        end
    end
    return table.concat(parts, " · ")
end

-- A roll's item read from the game (nil name: not readable yet, the item's
-- data not in or the name secret).
type ItemRead = {
    name?: string,
    icon?: number | string,
    quality: string,
    link?: string,
    bop: boolean,
    can: { [string]: boolean },
    reason: { [string]: string? },
}

local function readItem(rollID: number): ItemRead
    local icon, name, _, quality, bop, canNeed, canGreed, _, reasonNeed, reasonGreed = GetLootRollItemInfo(rollID)
    local function reason(r: unknown): string?
        local n = secret.asNumber(r)
        return n and n > 0 and secret.asString(tbl.field(_G, "LOOT_ROLL_INELIGIBLE_REASON" .. n)) or nil
    end
    return {
        name = secret.asString(name),
        icon = secret.readable(icon) and (secret.asNumber(icon) or secret.asString(icon)) or nil,
        quality = secret.readable(quality) and QUALITY[quality] or "common",
        link = secret.asString(GetLootRollItemLink(rollID)),
        bop = secret.readable(bop) and bop == true,
        can = {
            need = secret.readable(canNeed) and canNeed or false,
            greed = secret.readable(canGreed) and canGreed or false,
            pass = true,
        },
        reason = { need = reason(reasonNeed), greed = reason(reasonGreed) },
    }
end

-- What a roll shows while its item's name can't be read: the link's
-- name, else the game's own placeholder.
local function placeholder(link: string?): string
    local fromLink = link and link:match("|h%[(.-)%]|h")
    if fromLink and fromLink ~= "" then
        return fromLink
    end
    return secret.asString(tbl.field(_G, "RETRIEVING_ITEM_INFO")) or "Item"
end

