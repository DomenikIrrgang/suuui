-- Units/LootRolls.wowlua
-- Group loot rolls in the roll tray (design board "Loot roll · C · Roll
-- tray"), high in the middle of the screen and moved in edit mode. A row
-- per open roll, in the order the game started them: the item, the
-- seconds left (a bar along the row, amber under 10 s), Need / Greed /
-- Pass with how many chose each, who chose what under it (every name on
-- hovering the row), your choice pressed in arcane. A choice the game won't let you
-- take is dimmed with its reason. WoW Forever has no Disenchant: Need, Greed
-- and Pass only. "Pass on all" answers every roll you haven't; "Greed on
-- all" asks once first. Results under the rows keep who won what until
-- you close the tray, or 10 s after the last roll (held in combat). The tray opens
-- by itself when a roll starts, in combat too, and folds into a one-line
-- tab. A built-in module written against the public API only.
--
-- Choosing is RollOnLoot (allowed to addons, in combat too). Bind on
-- Pickup: the game asks (CONFIRM_LOOT_ROLL) and the tray asks in the roll's
-- row. The game's own popup goes out of sight, its OK and Cancel buttons
-- laid see-through over the row's (only points, sizes, levels and the
-- popup's alpha change, all put back when it closes), so the answer is the
-- popup's own click and nothing of Blizzard's runs from SuuUI's code. A
-- row the popup isn't for (a second Bind on Pickup roll while it asks
-- about another) answers with ConfirmLootRoll. Votes and the results come
-- from the game's loot lines in chat and its loot history. Blizzard's roll
-- frames keep running off screen.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type Position from "/EditMode/EditMode"
import type LootRollTray, RollRowData, RollChoiceData, RollResultData, RollTrayData from "/UI/LootRollTray"
import type SuuButton from "/UI/Controls"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as item from "wowlua:item"

local UI, T = SuuUI.UI, SuuUI.Tokens

local DEFAULTS = {
    -- the middle of the screen, high up: its top 80 px down (a value at
    -- its default isn't stored, so only a tray moved in edit mode keeps
    -- its own place when this changes)
    position = { point = "TOP", x = 0, y = -80 } :: Position,
    unfold = true, -- a new roll opens the folded tray
    results = true, -- who won what stays a moment after the last roll
}

local QUALITY: { [number]: string } = {
    [0] = "poor",
    "common",
    "uncommon",
    "rare",
    "epic",
    "legendary",
    "legendary",
    "legendary",
}

-- s results stay once no roll is open and you're out of combat
local RESULTS_STAY = 10
-- results kept (the oldest go)
local RESULTS_KEPT = 8
-- s a roll stays past its time when the game hasn't said it's over
local ROLL_GRACE = 5
-- names per choice on a row's line of who chose what, at most; the
-- characters that line has room for (caption, about 5.5 px each)
local NAMES_SHOWN = 4
local WHO_CHARS = 84
local TICK = 0.1

--------------------------------------------------------------------------------
-- Rolls
--------------------------------------------------------------------------------

export type ChoiceKey = "need" | "greed" | "pass"
type Choice = { key: ChoiceKey, label: string, type: number }
-- (WoW Forever has no Disenchant)
local CHOICES: Choice[] = {
    { key = "need", label = "Need", type = LOOT_ROLL_TYPE_NEED or 1 },
    { key = "greed", label = "Greed", type = LOOT_ROLL_TYPE_GREED or 2 },
    { key = "pass", label = "Pass", type = LOOT_ROLL_TYPE_PASS or 0 },
}
local CHOICE_BY_TYPE: { [number]: Choice } = {}
local CHOICE_BY_KEY: { [string]: Choice } = {}
for _, c in ipairs(CHOICES) do
    CHOICE_BY_TYPE[c.type] = c
    CHOICE_BY_KEY[c.key] = c
end

type Votes = { need: string[], greed: string[], pass: string[] }
-- A number someone rolled: the choice's label and the value.
type Rolled = { label: string, value?: number }
-- One group roll as the tray knows it (a test roll has `test`, its own
-- roster and classes). `confirm`: the game asks for your choice's
-- confirmation (Bind on Pickup; its roll type).
export type Roll = {
    id: number,
    seq: number,
    test?: boolean,
    icon?: number | string,
    name: string,
    quality: string,
    link?: string,
    duration: number,
    bop?: boolean,
    can: { [string]: boolean },
    reason: { [string]: string? },
    votes: Votes,
    rolled: { [string]: Rolled },
    remaining: () -> number,
    roster?: string[],
    classes?: { [string]: string },
    choice?: ChoiceKey,
    confirm?: number,
    endedAt?: number,
    reported?: boolean,
    -- the loot it's from (START_LOOT_ROLL's): LOOT_ROLLS_COMPLETE ends its rolls
    lootHandle?: number,
}

-- A decided roll: who won it (nil: everyone passed).
export type Result = { roll: Roll, winner?: string }

-- The game's loot line formats as patterns: the pattern and the order of
-- its captures.
type Pattern = { pattern: string, order: number[] }
-- What a loot line says: what, who, the item, the choice, the number.
type Captures = { [number]: string }
type LineFn = (c: Captures) -> (string, string?, string?, ChoiceKey?, number?)
type Line = { pattern: Pattern, fn: LineFn }
-- "%s has selected Need for: %s" → "^(.+) has selected Need for: (.+)$".
-- `shift`: numbered arguments (%2$s) counted from one later (the loot
-- history link, the first, taken off).
local function pattern(fmt: unknown, shift: number?): Pattern?
    if type(fmt) ~= "string" then
        return nil
    end
    local out: string[], order: number[], auto, i = { "^" }, {}, 0, 1
    while i <= #fmt do
        local c = fmt:sub(i, i)
        if c == "%" then
            local pos, typed = fmt:match("^%%(%d)%$([sd])", i)
            local t: string? = typed
            if pos then
                order[#order + 1] = (tonumber(pos) or 0) - (shift or 0)
                out[#out + 1] = t == "d" and "(%d+)" or "(.+)"
                i = i + 4
            else
                t = fmt:match("^%%([sd])", i)
                if t then
                    auto = auto + 1
                    order[#order + 1] = auto
                    out[#out + 1] = t == "d" and "(%d+)" or "(.+)"
                else
                    out[#out + 1] = "%%" -- "%%": a percent sign
                end
                i = i + 2
            end
        else
            out[#out + 1] = c:find("[%^%$%(%)%.%[%]%*%+%-%?]") and ("%" .. c) or c
            i = i + 1
        end
    end
    out[#out + 1] = "$"
    return { pattern = table.concat(out), order = order }
end

local function match(pat: Pattern?, text: string): Captures?
    if not pat then
        return nil
    end
    local caps = { text:match(pat.pattern) }
    if #caps == 0 then
        return nil
    end
    local out: Captures = {}
    for i, at in ipairs(pat.order) do
        out[at] = caps[i]
    end
    return out
end

-- This client's loot lines start with a link to the loot history
-- ("|HlootHistory:%d|h[Loot]|h: %s has selected Need for: %s"): it goes
-- from the formats and the lines, so the captures are who, the item, the
-- number (counted from the start, the history's number came first and no
-- vote, number or winner was ever matched).
local HISTORY_FORMAT = "^|HlootHistory:%%[%d%$]*d|h%[.-%]|h:%s*"
local HISTORY_LINE = "^|HlootHistory:%d+|h%[.-%]|h:%s*"

local LINES: Line[]?
local function lines(): Line[]
    if LINES then
        return LINES
    end
    -- the whole name (Forever's characters have surnames: SuuUI.FullName)
    local me = SuuUI.FullName("player") :: string -- yours: never secret
    me = me:match("^([^%-]+)") or me
    local list: Line[] = {}
    LINES = list
    local function add(global: string, fn: LineFn)
        local given = tbl.field(_G, global)
        -- (without the loot history link: HISTORY_FORMAT)
        local fmt: unknown, shift = given, 0
        if type(given) == "string" then
            fmt, shift = given:gsub(HISTORY_FORMAT, "")
        end
        local p = pattern(fmt, shift)
        if p then
            list[#list + 1] = { pattern = p, fn = fn }
        end
    end
    -- The specific lines before the general ones: "You passed on: X",
    -- "Everyone passed on: X" and "You won: X" fit "%s passed on: %s" and
    -- "%s won: %s" too, with "You" or "Everyone" as a player.
    -- the end, yours and everyone's
    add("LOOT_ROLL_ALL_PASSED", function(c: Captures)
        return "allPassed", nil, c[1]
    end)
    add("LOOT_ROLL_YOU_WON", function(c: Captures)
        return "won", me, c[1]
    end)
    -- your votes: (item)
    add("LOOT_ROLL_NEED_SELF", function(c: Captures)
        return "vote", me, c[1], "need"
    end)
    add("LOOT_ROLL_GREED_SELF", function(c: Captures)
        return "vote", me, c[1], "greed"
    end)
    add("LOOT_ROLL_PASSED_SELF", function(c: Captures)
        return "vote", me, c[1], "pass"
    end)
    add("LOOT_ROLL_PASSED_SELF_AUTO", function(c: Captures)
        return "vote", me, c[1], "pass"
    end)
    -- others' votes: (who, item)
    add("LOOT_ROLL_NEED", function(c: Captures)
        return "vote", c[1], c[2], "need"
    end)
    add("LOOT_ROLL_GREED", function(c: Captures)
        return "vote", c[1], c[2], "greed"
    end)
    add("LOOT_ROLL_PASSED", function(c: Captures)
        return "vote", c[1], c[2], "pass"
    end)
    add("LOOT_ROLL_PASSED_AUTO", function(c: Captures)
        return "vote", c[1], c[2], "pass"
    end)
    add("LOOT_ROLL_PASSED_AUTO_FEMALE", function(c: Captures)
        return "vote", c[1], c[2], "pass"
    end)
    -- the numbers: (value, item, who)
    add("LOOT_ROLL_ROLLED_NEED", function(c: Captures)
        return "rolled", c[3], c[2], "need", tonumber(c[1])
    end)
    add("LOOT_ROLL_ROLLED_GREED", function(c: Captures)
        return "rolled", c[3], c[2], "greed", tonumber(c[1])
    end)
    -- someone else won
    add("LOOT_ROLL_WON", function(c: Captures)
        return "won", c[1], c[2]
    end)
    return list
end

local function itemKey(link: string?): string?
    return link and (link:match("item:(%d+)") or link) or nil
end

-- A name without its realm ("" for none).
local function short(name: unknown): string
    if type(name) ~= "string" then
        return ""
    end
    return name:match("^([^%-]+)") or name
end

local function me(): string
    return short(SuuUI.FullName("player"))
end

-- A group member's class ("MAGE"), by name.
local function classOf(name: string): string?
    if short(name) == me() then
        local _, class = UnitClass("player")
        return secret.asString(class)
    end
    local prefix, n = IsInRaid() and "raid" or "party", GetNumGroupMembers()
    for i = 1, n do
        local unit = prefix .. i
        local un = SuuUI.FullName(unit)
        if secret.readable(un) and short(un) == short(name) then
            local _, class = UnitClass(unit)
            return secret.asString(class)
        end
    end
    return nil
end

local COLORS: { [string]: { hex: string } } = T.color
local function classColored(name: string, known: { [string]: string }?): string
    local class = (known and known[short(name)]) or classOf(name)
    local c = class and COLORS["class-" .. class:lower()]
    return c and ("|cff" .. c.hex .. short(name) .. "|r") or short(name)
end

local function colored(token: string, s: string): string
    local c = COLORS[token]
    return c and ("|cff" .. c.hex .. s .. "|r") or s
end

local function qualityName(roll: Roll): string
    return roll.quality ~= "common" and colored("quality-" .. roll.quality, roll.name) or roll.name
end

-- Everyone in your group but you, by name (the roll's own list in a test).
local function roster(roll: Roll): string[]
    local given = roll.roster
    if given then
        return given
    end
    local out: string[] = {}
    if IsInRaid() then
        for i = 1, GetNumGroupMembers() do
            local name = SuuUI.FullName("raid" .. i)
            if secret.readable(name) and name and not UnitIsUnit("raid" .. i, "player") then
                out[#out + 1] = short(name)
            end
        end
    else
        for i = 1, GetNumSubgroupMembers() do
            local name = SuuUI.FullName("party" .. i)
            if secret.readable(name) and name then
                out[#out + 1] = short(name)
            end
        end
    end
    return out
end

-- Who hasn't chosen yet (you aren't listed: your own row says whether you have).
local function waitingOn(roll: Roll): string[]
    local chose: { [string]: boolean } = {}
    for _, c in ipairs(CHOICES) do
        for _, name in ipairs(roll.votes[c.key]) do
            chose[short(name)] = true
        end
    end
    local out: string[] = {}
    for _, name in ipairs(roster(roll)) do
        if not chose[short(name)] then
            out[#out + 1] = name
        end
    end
    return out
end

-- Names in class colours, `most` at most (default all) and how many more.
local function nameList(roll: Roll, names: string[], most: number?): string
    local cap = most or #names
    local shown: string[] = {}
    for i = 1, math.min(#names, cap) do
        shown[i] = classColored(names[i], roll.classes)
    end
    local s = table.concat(shown, ", ")
    if #names > cap then
        s = s .. (s ~= "" and " " or "") .. ("+%d"):format(#names - cap)
    end
    return s
end

-- One group of the line: "Need Brannoc, Ysolde +3" (the label muted).
type WhoGroup = { label: string, names: string[] }

-- Plain text's length (colour codes left out).
local function plainLength(s: string): number
    local plain = s:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", "")
    return #plain
end

-- The line of who chose what, in one row's width: as many names per
-- choice as fit (NAMES_SHOWN at most), the rest counted ("+12"). A raid
-- of 40 comes down to one name a choice, or only the counts.
local function whoLine(roll: Roll, groups: WhoGroup[]): string?
    if #groups == 0 then
        return nil
    end
    local line = ""
    for most = NAMES_SHOWN, 0, -1 do
        local parts: string[] = {}
        for i, g in ipairs(groups) do
            parts[i] = colored("ink-muted", g.label) .. " " .. nameList(roll, g.names, most)
        end
        line = table.concat(parts, colored("ink-faint", "  ·  "))
        if plainLength(line) <= WHO_CHARS then
            return line
        end
    end
    return line
end

-- "Binds when picked up · Sword": the bind, and the weapon's kind or the slot.
local function describe(roll: Roll): string
    local parts: string[] = {}
    local data = roll.link and item.get(roll.link) or nil
    if roll.bop then
        parts[1] = ITEM_BIND_ON_PICKUP or "Binds when picked up"
    elseif data and data.bindType == 2 then
        parts[1] = ITEM_BIND_ON_EQUIP or "Binds when equipped"
    elseif data and data.bindType == 3 then
        parts[1] = ITEM_BIND_ON_USE or "Binds when used"
    end
    if data then
        local loc = data.equipLoc
        local slot = loc and loc ~= "" and secret.asString(tbl.field(_G, loc)) or nil
        local kind = (data.classID == 2 and data.subType) or slot or nil
        if kind and kind ~= "" then
            parts[#parts + 1] = kind
        end
    end
    return table.concat(parts, " · ")
end

