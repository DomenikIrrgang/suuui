--------------------------------------------------------------------------------
-- Blizzard's Bind on Pickup popup, hosted in the tray
--------------------------------------------------------------------------------

type Point = { point: FramePoint, rel: ScriptRegion?, relPoint: FramePoint, x: number, y: number }
type Saved = { points: Point[], width: number, height: number, strata: FrameStrata, level: number }
-- The popup while the tray hosts it: the roll it asks about, its OK and
-- Cancel, how they were.
type Host = {
    dialog: Frame,
    rollID: number,
    yes?: Button,
    no?: Button,
    clamped: boolean,
    alpha: number,
    points: Point[],
    buttons: { [Button]: Saved },
}

local function savePoints(f: Region): Point[]
    local pts: Point[] = {}
    for i = 1, f:GetNumPoints() do
        local point, rel, relPoint, x, y = f:GetPoint(i)
        pts[i] = { point = point, rel = rel, relPoint = relPoint, x = x, y = y }
    end
    return pts
end

local function restorePoints(f: Region, pts: Point[])
    f:ClearAllPoints()
    for _, p in ipairs(pts) do
        f:SetPoint(p.point, p.rel, p.relPoint, p.x, p.y)
    end
end

-- The game's popup asking about a roll, while it shows.
local function confirmDialog(): Frame?
    for i = 1, 4 do
        local d = frames.find("StaticPopup" .. i)
        if d and d:IsShown() and secret.asString(tbl.field(d, "which")) == "CONFIRM_LOOT_ROLL" then
            return d
        end
    end
    return nil
end

-- A popup's button by its number (the new popups' container, or by name).
local function popupButton(dialog: Frame, i: number): Button?
    local name = dialog:GetName()
    return frames.asButton(tbl.field(dialog, "ButtonContainer", "Button" .. i)) or
        (name and frames.asButton(tbl.field(_G, name .. "Button" .. i)) or nil)
end

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

local SECTION: SettingsSection = {
    id = "lootrolls",
    label = "Loot rolls",
    category = "General",
    order = 23,
    -- on the Loot page
    merge = "loot",
    groups = {
        {
            title = "Loot rolls",
            description = "Group rolls in a tray high in the middle of the screen (move it in edit mode), in combat too: Need, Greed or Pass with how many chose each (hover a row for who), the seconds left, Pass on all and Greed on all. /suu lootroll shows test rolls.",
            rows = {
                {
                    key = "unfold",
                    label = "Open on a new roll",
                    control = "toggle",
                    description = "A roll that starts while the tray is folded into its tab opens the tray again.",
                },
                {
                    key = "results",
                    label = "Keep the results",
                    control = "toggle",
                    description = "Who won what stays under the rolls until you close the tray, or 10 seconds after the last roll ends (while you're in combat, until 10 seconds after it).",
                },
            },
        },
    },
}

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

class LootRollsModule extends Module<typeof(DEFAULTS)>
    tray: LootRollTray? = nil
    driver: Frame? = nil
    -- the open rolls by ID (a test roll's is below zero); the ones just ended
    rolls: { [number]: Roll } = {}
    ended: Roll[] = {}
    results: Result[] = {}
    seq: number = 0
    testRolls: number = 0
    -- Greed on all asking; the tray folded into its tab
    asking: boolean = false
    folded: boolean = false
    -- since when no roll is open (out of combat): the results go after RESULTS_STAY
    idleSince: number? = nil
    host: Host? = nil
    -- the popup just closed: the roll it asked about and its OK
    lastHosted: number? = nil
    lastYes: Button? = nil
    hooked: { [Frame]: boolean } = {}
    rollsHooked: boolean? = nil
    movingRolls: boolean? = nil
    wired: boolean? = nil

    constructor()
        super({
            id = "lootrolls",
            name = "Loot rolls",
            description = "Group loot rolls in a tray: Need, Greed or Pass, who chose what, and who won.",
            api = "0.32",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    --------------------------------------------------------------------------------
    -- What the tray shows
    --------------------------------------------------------------------------------

    -- The open rolls in the order the game started them.
    function Open(): Roll[]
        local list: Roll[] = {}
        for _, roll in pairs(self.rolls) do
            list[#list + 1] = roll
        end
        table.sort(list, function(a: Roll, b: Roll): boolean
            return a.seq < b.seq
        end)
        return list
    end

    function Unanswered(): Roll[]
        local out: Roll[] = {}
        for _, roll in ipairs(self:Open()) do
            if not roll.choice then
                out[#out + 1] = roll
            end
        end
        return out
    end

    function Row(roll: Roll): RollRowData
        local choices: RollChoiceData[] = {}
        local note: string? = nil
        for _, c in ipairs(CHOICES) do
            local who = roll.votes[c.key]
            local can = roll.can[c.key] ~= false
            local reason = roll.reason[c.key]
            local names: string[] = {}
            for _, name in ipairs(who) do
                names[#names + 1] = classColored(name, roll.classes)
            end
            choices[#choices + 1] = {
                key = c.key,
                label = c.label,
                count = #who,
                unavailable = not can,
                reason = reason,
                tooltip = #who > 0 and { title = c.label .. " · " .. #who, description = table.concat(names, ", ") } or
                    nil,
            }
            if not can and reason and not note then
                note = c.label .. ": " .. reason
            end
        end
        -- who chose what, and who's still choosing: a line always shown
        -- (as many names as fit), every name on hovering the row
        local waiting = waitingOn(roll)
        local groups: WhoGroup[] = {}
        for _, c in ipairs(CHOICES) do
            local who = roll.votes[c.key]
            if #who > 0 then
                groups[#groups + 1] = { label = c.label, names = who }
            end
        end
        if #waiting > 0 then
            groups[#groups + 1] = { label = "Choosing", names = waiting }
        end
        local full: string[] = {}
        for i, g in ipairs(groups) do
            full[i] = colored("ink-muted", g.label .. " · " .. #g.names) .. "\n" .. nameList(roll, g.names)
        end
        local sub = describe(roll)
        if roll.choice and #waiting > 0 then
            sub = (sub ~= "" and (sub .. " · ") or "") .. #waiting .. " choosing"
        end
        local confirm: { text: string, accept: string }? = nil
        local asked = roll.confirm and CHOICE_BY_TYPE[roll.confirm]
        if asked then
            confirm = { text = roll.name .. " binds to you when you win it.", accept = "Roll " .. asked.label }
        end
        return {
            id = roll.id,
            icon = roll.icon,
            name = roll.name,
            quality = roll.quality,
            sub = sub,
            locked = roll.bop == true,
            duration = roll.duration,
            remaining = roll.remaining(),
            choices = choices,
            choice = roll.choice,
            confirm = confirm,
            who = whoLine(roll, groups),
            whoTip = #groups > 0 and
                { title = "Who chose what", description = table.concat(full, "\n\n"), maxWidth = 360 } or
                nil,
            note = note,
        }
    end

    function ResultRow(r: Result): RollResultData
        local roll = r.roll
        local name = qualityName(roll)
        local mine = roll.rolled[me()]
        local winner = r.winner
        if not winner then
            return {
                icon = roll.icon,
                quality = roll.quality,
                text = "Everyone passed on " .. name,
                right = "anyone can loot it",
                dim = true,
            }
        end
        local theirs = roll.rolled[short(winner)]
        if short(winner) == me() then
            return {
                icon = roll.icon,
                quality = roll.quality,
                text = "You won " .. name,
                right = mine and (mine.label .. " " .. tostring(mine.value)) or nil,
                won = true,
            }
        end
        local parts: string[] = {}
        if theirs then
            parts[#parts + 1] = theirs.label .. " " .. tostring(theirs.value)
        end
        if mine then
            parts[#parts + 1] = "you " .. tostring(mine.value)
        elseif roll.choice == "pass" then
            parts[#parts + 1] = "you passed"
        end
        return {
            icon = roll.icon,
            quality = roll.quality,
            text = classColored(winner, roll.classes) .. " won " .. name,
            right = #parts > 0 and table.concat(parts, " · ") or nil,
            dim = true,
        }
    end

    -- Where the rolls are: the instance's name, else the zone's.
    function Place(): string?
        local inside = secret.flag(IsInInstance())
        local name = inside and secret.asString((GetInstanceInfo())) or secret.asString(GetRealZoneText())
        return name ~= "" and name or nil
    end

    function Data(): RollTrayData
        local open = self:Open()
        local rows: RollRowData[] = {}
        local answered = #open > 0
        local waiting: { [string]: boolean } = {}
        local nWaiting = 0
        for i, roll in ipairs(open) do
            rows[i] = self:Row(roll)
            if not roll.choice or roll.confirm then
                answered = false
            end
            for _, name in ipairs(waitingOn(roll)) do
                if not waiting[name] then
                    waiting[name] = true
                    nWaiting = nWaiting + 1
                end
            end
        end
        local meta: string
        if #open == 0 then
            meta = "none open"
        elseif answered then
            meta = nWaiting > 0 and (("waiting on %d player%s"):format(nWaiting, nWaiting == 1 and "" or "s")) or
                "waiting on the rolls"
        else
            local place = self:Place()
            meta = #open .. " open" .. (place and (" · " .. place) or "")
        end
        local results: RollResultData[] = {}
        if self:Get("results") then
            for i, r in ipairs(self.results) do
                results[i] = self:ResultRow(r)
            end
        end
        local d: RollTrayData = { rolls = rows, results = results, meta = meta, answered = answered }
        if self.asking then
            local greed = self:GreedTargets()
            if #greed > 0 then
                local bound: string[] = {}
                for _, roll in ipairs(greed) do
                    if roll.bop then
                        bound[#bound + 1] = roll.name
                    end
                end
                d.ask = {
                    text = ("Greed on the %d roll%s you haven't answered?"):format(#greed, #greed == 1 and "" or "s"),
                    note = #bound > 0 and
                        (table.concat(bound, ", ") ..
                            (#bound == 1 and " binds" or " bind") ..
                                " when picked up: the game still asks about it on its own row.") or
                        nil,
                    confirm = "Greed on " .. #greed,
                }
            else
                self.asking = false
            end
        end
        return d
    end

    -- Whether the tray has anything to show.
    function HasContent(): boolean
        return next(self.rolls) ~= nil or (#self.results > 0 and self:Get("results"))
    end

    function Refresh()
        local tray = self.tray
        if not tray or not self:IsEnabled() then
            return
        end
        if not self:HasContent() then
            tray:Hide()
            self.asking = false
            if self.driver then
                self.driver:Hide()
            end
            return
        end
        tray:SetData(self:Data())
        if tray.folded ~= self.folded then
            tray:SetFolded(self.folded)
        end
        tray:Show()
        if self.driver then
            self.driver:Show()
        end
        self:SyncHost()
    end

    -- Every tick while the tray shows: the seconds, and the results going
    -- once no roll is open for a while out of combat.
    function Tick()
        local tray = self.tray
        if not tray then
            return
        end
        if next(self.rolls) ~= nil then
            self.idleSince = nil
            local times: { [number]: number } = {}
            for id, roll in pairs(self.rolls) do
                times[id] = roll.remaining()
            end
            tray:SetRemaining(times)
            return
        end
        if InCombatLockdown() then
            self.idleSince = nil
            return
        end
        local since = self.idleSince
        if not since then
            self.idleSince = GetTime()
        elseif GetTime() - since >= RESULTS_STAY then
            self:ClearResults()
        end
    end

    function ClearResults()
        self.results = {}
        self.idleSince = nil
        self:Refresh()
    end

    --------------------------------------------------------------------------------
    -- Choosing
    --------------------------------------------------------------------------------

    function Choose(roll: Roll, key: ChoiceKey)
        if roll.choice or self.rolls[roll.id] ~= roll then
            return
        end
        local choice = CHOICE_BY_KEY[key]
        if not choice or roll.can[key] == false then
            return
        end
        if roll.test then
            roll.choice = key
            if roll.bop and key ~= "pass" then
                roll.confirm = choice.type
            else
                table.insert(roll.votes[key], me())
            end
            self:Refresh()
            return
        end
        -- (chosen first: the game sends CANCEL_LOOT_ROLL from inside
        -- RollOnLoot, its own roll frame done with you; and a Bind on Pickup
        -- item asks from inside it, CONFIRM_LOOT_ROLL)
        roll.choice = key
        RollOnLoot(roll.id, choice.type)
        self:Refresh()
    end

    -- The question in a roll's row answered (Bind on Pickup).
    function Confirm(id: number, yes: boolean)
        local roll = self.rolls[id]
        if not roll or not roll.confirm then
            return
        end
        local h = self.host
        if h and h.rollID == id then
            -- (the popup's own buttons lie over the row's: a click there is
            -- the popup's; this one came from elsewhere, a test)
            self:ReleaseButtons(h)
        end
        if yes and not roll.test then
            ConfirmLootRoll(id, roll.confirm)
        end
        self:Answered(id, yes)
    end

    -- A roll's question answered: yes keeps your choice, no takes it back.
    function Answered(id: number, yes: boolean)
        local roll = self.rolls[id]
        if not roll or not roll.confirm then
            return
        end
        roll.confirm = nil
        if yes then
            if roll.test and roll.choice then
                table.insert(roll.votes[roll.choice], me())
            end
        else
            roll.choice = nil
        end
        self:Refresh()
    end

    function PassAll()
        for _, roll in ipairs(self:Unanswered()) do
            self:Choose(roll, "pass")
        end
        self.asking = false
        self:Refresh()
    end

    -- The rolls Greed on all would answer: unanswered, Greed allowed.
    function GreedTargets(): Roll[]
        local out: Roll[] = {}
        for _, roll in ipairs(self:Unanswered()) do
            if roll.can.greed ~= false then
                out[#out + 1] = roll
            end
        end
        return out
    end

    function GreedAll()
        if #self:GreedTargets() == 0 then
            return
        end
        self.asking = true
        self:Refresh()
    end

    function AskAnswered(yes: boolean)
        self.asking = false
        if yes then
            for _, roll in ipairs(self:GreedTargets()) do
                self:Choose(roll, "greed")
            end
        end
        self:Refresh()
    end

    -- The game asks to confirm your choice (Bind on Pickup): in the roll's
    -- row, the tray open; the popup's buttons over the row's.
    function ConfirmAsked(rollID: unknown, rollType: unknown)
        local id, kind = secret.asNumber(rollID), secret.asNumber(rollType)
        local roll = id and self.rolls[id]
        if not (id and kind and roll) then
            return
        end
        local choice = CHOICE_BY_TYPE[kind]
        roll.confirm = kind
        roll.choice = choice and choice.key or roll.choice
        self.folded = false
        self:Refresh()
        self:HostConfirm(id)
        -- (the popup shows from the game's own handler: maybe after this one)
        after(0, function()
            self:HostConfirm(id)
        end)
    end

    function HostConfirm(id: number)
        local roll, tray = self.rolls[id], self.tray
        if not (roll and roll.confirm and tray) then
            return
        end
        local dialog = confirmDialog()
        if not dialog or secret.asNumber(tbl.field(dialog, "data")) ~= id then
            return
        end
        local row = tray:RowFor(id)
        if not row then
            return
        end
        local h = self.host
        if h and h.dialog ~= dialog then
            self:Release(h)
            h = nil
        end
        if not h then
            h = {
                dialog = dialog,
                rollID = id,
                clamped = dialog:IsClampedToScreen() and true or false,
                alpha = dialog:GetAlpha(),
                points = savePoints(dialog),
                buttons = {},
            }
            self.host = h
            self:HookDialog(dialog)
            -- out of sight, see-through (its buttons too)
            dialog:SetClampedToScreen(false)
            dialog:SetAlpha(0)
            dialog:ClearAllPoints()
            dialog:SetPoint("BOTTOMRIGHT", UIParent, "TOPLEFT", -200, 200)
        else
            self:ReleaseButtons(h)
        end
        h.rollID = id
        h.yes, h.no = popupButton(dialog, 1), popupButton(dialog, 2)
        self:Lay(h, h.yes, row.yes)
        self:Lay(h, h.no, row.no)
    end

    -- The popup's buttons over its row only while the row shows (folded,
    -- scrolled away or gone: back in the out-of-sight popup, never lying
    -- see-through over another row).
    function SyncHost()
        local h, tray = self.host, self.tray
        if not (h and tray) then
            return
        end
        local row = tray:RowFor(h.rollID)
        local roll = self.rolls[h.rollID]
        if row and row:IsVisible() and roll and roll.confirm then
            if not h.yes then
                h.yes, h.no = popupButton(h.dialog, 1), popupButton(h.dialog, 2)
                self:Lay(h, h.yes, row.yes)
                self:Lay(h, h.no, row.no)
            end
        elseif h.yes then
            self:ReleaseButtons(h)
        end
    end

    -- One of the popup's buttons over one of the row's.
    function Lay(h: Host, b: Button?, over: SuuButton)
        if not b then
            return
        end
        if not h.buttons[b] then
            h.buttons[b] = {
                points = savePoints(b),
                width = b:GetWidth(),
                height = b:GetHeight(),
                strata = b:GetFrameStrata(),
                level = b:GetFrameLevel(),
            }
        end
        b:ClearAllPoints()
        b:SetAllPoints(over)
        b:SetFrameStrata(over:GetFrameStrata())
        b:SetFrameLevel(over:GetFrameLevel() + 10)
        self:HookButton(b)
    end

    -- The popup's buttons back in it.
    function ReleaseButtons(h: Host)
        for b in pairs(h.buttons) do
            b:ClearAllPoints()
        end
        for b, s in pairs(h.buttons) do
            restorePoints(b, s.points)
            b:SetSize(s.width, s.height)
            b:SetFrameStrata(s.strata)
            b:SetFrameLevel(s.level)
        end
        h.buttons = {}
        h.yes, h.no = nil, nil
    end

    -- The popup as it was.
    function Release(h: Host)
        self:ReleaseButtons(h)
        local dialog = h.dialog
        restorePoints(dialog, h.points)
        dialog:SetAlpha(h.alpha)
        dialog:SetClampedToScreen(h.clamped)
        if self.host == h then
            self.host = nil
        end
    end

    function HookDialog(dialog: Frame)
        if self.hooked[dialog] then
            return
        end
        self.hooked[dialog] = true
        hookScript(dialog, "OnHide", function()
            local h = self.host
            if not h or h.dialog ~= dialog then
                return
            end
            local id = h.rollID
            -- (OK's click hook runs after this hide: which roll it was for)
            self.lastHosted, self.lastYes = id, h.yes
            self:Release(h)
            -- closed without OK (Cancel, Esc): the choice taken back, a
            -- frame later (OK has answered by then)
            after(0, function()
                self.lastHosted, self.lastYes = nil, nil
                self:Answered(id, false)
            end)
        end)
    end

    function HookButton(b: Button)
        if self.hooked[b] then
            return
        end
        self.hooked[b] = true
        hookScript(b, "OnClick", function()
            local h, id = self.host, self.lastHosted
            if h and h.yes == b then
                self:Answered(h.rollID, true)
            elseif id and self.lastYes == b then
                self:Answered(id, true)
            end
        end)
        -- the row's button lights up under the mouse
        hookScript(b, "OnEnter", function()
            local over = self:Under(b)
            local fn = over and over:GetScript("OnEnter")
            if over and fn then
                fn(over, false)
            end
        end)
        hookScript(b, "OnLeave", function()
            local over = self:Under(b)
            local fn = over and over:GetScript("OnLeave")
            if over and fn then
                fn(over, false)
            end
        end)
    end

    -- The row's button a popup button lies over.
    function Under(b: Button): SuuButton?
        local h, tray = self.host, self.tray
        local row = h and tray and tray:RowFor(h.rollID)
        if not (h and row) then
            return nil
        end
        if h.yes == b then
            return row.yes
        elseif h.no == b then
            return row.no
        end
        return nil
    end

    --------------------------------------------------------------------------------
    -- The game's flow
    --------------------------------------------------------------------------------

    function StartRoll(rollID: unknown, rollTime: unknown, lootHandle: unknown)
        if not secret.readable(rollID) or type(rollID) ~= "number" then
            return
        end
        local icon, name, _, quality, bop, canNeed, canGreed, _, reasonNeed, reasonGreed = GetLootRollItemInfo(rollID)
        local itemName = secret.asString(name)
        if not itemName then
            return
        end
        local function reason(r: unknown): string?
            local n = secret.asNumber(r)
            return n and n > 0 and secret.asString(tbl.field(_G, "LOOT_ROLL_INELIGIBLE_REASON" .. n)) or nil
        end
        local start, duration = GetTime(), (secret.asNumber(rollTime) or 60000) / 1000
        self.seq = self.seq + 1
        local roll: Roll = {
            id = rollID,
            seq = self.seq,
            icon = secret.readable(icon) and (secret.asNumber(icon) or secret.asString(icon)) or nil,
            name = itemName,
            quality = secret.readable(quality) and QUALITY[quality] or "common",
            link = secret.asString(GetLootRollItemLink(rollID)),
            duration = duration,
            bop = secret.readable(bop) and bop == true,
            can = {
                need = secret.readable(canNeed) and canNeed or false,
                greed = secret.readable(canGreed) and canGreed or false,
                pass = true,
            },
            reason = { need = reason(reasonNeed), greed = reason(reasonGreed) },
            votes = { need = {}, greed = {}, pass = {} },
            rolled = {},
            remaining = function(): number
                local left = secret.asNumber(GetLootRollTimeLeft(rollID))
                if left then
                    return math.max(0, left / 1000)
                end
                return math.max(0, duration - (GetTime() - start))
            end,
        }
        roll.lootHandle = secret.asNumber(lootHandle)
        self:Add(roll)
        -- (the game says it's over: LOOT_ROLLS_COMPLETE, the loot history's
        -- drop decided, the result line; this only if none of them comes)
        -- its time up and still open (no word from the game, no result line):
        -- gone a moment later (found in game: the card stayed at 0). Timed on
        -- SuuUI's own clock from the roll's start: once you've rolled the game
        -- sends no CANCEL_LOOT_ROLL (its own roll frame hides as you choose),
        -- and its time left can't be trusted for a roll that's over
        local function overdue()
            if self.rolls[rollID] ~= roll then
                return
            end
            local left = duration - (GetTime() - start)
            if left > 0 then
                after(left + ROLL_GRACE, overdue)
                return
            end
            self:EndRoll(rollID)
        end
        after(duration + ROLL_GRACE, overdue)
    end

    -- A roll in the tray (the folded tray opens, as the setting says).
    function Add(roll: Roll)
        self.rolls[roll.id] = roll
        if self.folded and self:Get("unfold") then
            self.folded = false
        end
        -- the item's kind and bind, once the game has its data
        local link = roll.link
        if link and not item.get(link) then
            item.load(link, function()
                if self.rolls[roll.id] == roll then
                    self:Refresh()
                end
            end)
        end
        self:Refresh()
    end

    -- Every open roll of a loot that's done (LOOT_ROLLS_COMPLETE).
    function RollsComplete(lootHandle: unknown)
        local handle = secret.asNumber(lootHandle)
        if not handle then
            return
        end
        for id, roll in pairs(self.rolls) do
            if roll.lootHandle == handle then
                self:EndRoll(id)
            end
        end
    end

    -- One item's drop in the loot history: decided (a winner, or everyone
    -- passed), its open roll ends, its result kept if the loot line hasn't.
    function DropDecided(encounterID: unknown, lootListKey: unknown)
        local enc, key = secret.asNumber(encounterID), secret.asNumber(lootListKey)
        if not (enc and key and C_LootHistory and C_LootHistory.GetSortedInfoForDrop) then
            return
        end
        local ok, info = pcall(C_LootHistory.GetSortedInfoForDrop, enc, key)
        if not ok or type(info) ~= "table" or not secret.readable(info) then
            return
        end
        local drop = info :: { itemHyperlink?: unknown, winner?: { playerName?: unknown }, allPassed?: unknown }
        local winner = drop.winner
        local passed = drop.allPassed == true
        if not (winner or passed) then
            return
        end
        local roll = self:RollFor(secret.asString(drop.itemHyperlink))
        if not roll then
            return
        end
        if not roll.reported then
            roll.reported = true
            self:Result(roll, winner and secret.asString(winner.playerName) or nil)
        end
        if self.rolls[roll.id] == roll then
            self:EndRoll(roll.id)
        end
    end

    function EndRoll(rollID: number)
        local roll = self.rolls[rollID]
        if not roll then
            return
        end
        self.rolls[rollID] = nil
        local h = self.host
        if h and h.rollID == rollID then
            -- (its popup stays out of sight until the game closes it)
            self:ReleaseButtons(h)
        end
        -- kept a moment for the result line, which can come after
        self.ended[#self.ended + 1] = roll
        roll.endedAt = GetTime()
        while #self.ended > 10 do
            table.remove(self.ended, 1)
        end
        self:Refresh()
    end

    -- The roll a chat line is about: the oldest open one for that item (else
    -- one just ended, for the result).
    function RollFor(link: string?): Roll?
        local key = itemKey(link)
        local best: Roll? = nil
        for _, roll in pairs(self.rolls) do
            if itemKey(roll.link) == key then
                if not best or roll.seq < best.seq then
                    best = roll
                end
            end
        end
        if best then
            return best
        end
        for i = #self.ended, 1, -1 do
            local roll = self.ended[i]
            if itemKey(roll.link) == key and GetTime() - (roll.endedAt or 0) < 30 then
                return roll
            end
        end
        return nil
    end

    -- A roll decided: under the rows, with who won.
    function Result(roll: Roll, winner: string?)
        for _, r in ipairs(self.results) do
            if r.roll == roll then
                return
            end
        end
        self.results[#self.results + 1] = { roll = roll, winner = winner }
        while #self.results > RESULTS_KEPT do
            table.remove(self.results, 1)
        end
        self:Refresh()
    end

    function OnLootLine(given: unknown)
        if not secret.readable(given) or type(given) ~= "string" then
            return
        end
        local text = given:gsub(HISTORY_LINE, "")
        for _, line in ipairs(lines()) do
            local caps = match(line.pattern, text)
            if caps then
                local what, who, link, choice, value = line.fn(caps)
                if what == "vote" and choice then
                    local roll = self:RollFor(link)
                    if roll then
                        for _, c in ipairs(CHOICES) do
                            local list = roll.votes[c.key]
                            for i = #list, 1, -1 do
                                if list[i] == short(who) then
                                    table.remove(list, i)
                                end
                            end
                        end
                        table.insert(roll.votes[choice], short(who))
                        if short(who) == me() then
                            roll.choice = choice
                            roll.confirm = nil
                        end
                        if self.rolls[roll.id] then
                            self:Refresh()
                        end
                    end
                elseif what == "rolled" then
                    local roll = self:RollFor(link)
                    if roll then
                        local c = choice and CHOICE_BY_KEY[choice]
                        roll.rolled[short(who)] = { label = c and c.label or choice or "", value = value }
                    end
                elseif what == "won" or what == "allPassed" then
                    local roll = self:RollFor(link)
                    if roll and not roll.reported then
                        roll.reported = true
                        self:Result(roll, what == "won" and who or nil)
                    end
                    -- decided: its row goes (the game doesn't always say,
                    -- CANCEL_LOOT_ROLL missing once you've rolled: found in game)
                    if roll and self.rolls[roll.id] == roll then
                        self:EndRoll(roll.id)
                    end
                end
                return
            end
        end
    end

    -- The item's tooltip: the game's for an open roll, else from its link.
    function ItemTip(owner: Frame, roll: Roll, ended: boolean?)
        GameTooltip:SetOwner(owner, "ANCHOR_LEFT")
        if not ended and not roll.test and self.rolls[roll.id] and GameTooltip.SetLootRollItem then
            GameTooltip:SetLootRollItem(roll.id)
        else
            local link = roll.link
            local ref = link and (link:match("|H(item:[^|]+)|h") or link)
            if not ref then
                GameTooltip:Hide()
                return
            end
            GameTooltip:SetHyperlink(ref)
        end
        GameTooltip:Show()
    end

    -- Blizzard's roll frames off screen while the tray shows the rolls.
    function HideBlizzardRolls()
        local f = frames.find("GroupLootContainer")
        if not f or self.rollsHooked then
            return
        end
        self.rollsHooked = true
        local function away()
            f:SetAlpha(0)
            self.movingRolls = true
            f:ClearAllPoints()
            f:SetPoint("BOTTOMRIGHT", UIParent, "TOPLEFT", -200, 200)
            self.movingRolls = false
        end
        f:SetClampedToScreen(false)
        hook(f, "SetPoint", function()
            if self.movingRolls then
                return
            end
            f:SetAlpha(0)
            after(0, away)
        end)
        hookScript(f, "OnShow", away)
        away()
    end

    --------------------------------------------------------------------------------
    -- Test rolls (/suu lootroll)
    --------------------------------------------------------------------------------

    function TestRoll(
        def: {
            name: string,
            item: number,
            quality: string,
            duration: number,
            bop?: boolean,
            need?: boolean,
            votes?: { [string]: string[] },
        }
    ): Roll
        self.testRolls = self.testRolls + 1
        self.seq = self.seq + 1
        local id = -self.testRolls
        local start = GetTime()
        local duration = def.duration
        local reasonNeed = secret.asString(tbl.field(_G, "LOOT_ROLL_INELIGIBLE_REASON1")) or
            "Your class can't use this item."
        local votes = def.votes or {}
        local roll: Roll = {
            id = id,
            seq = self.seq,
            test = true,
            icon = C_Item.GetItemIconByID(def.item) or 134400,
            name = def.name,
            quality = def.quality,
            link = "item:" .. def.item,
            classes = TEST_CLASSES,
            roster = TEST_ROSTER,
            duration = duration,
            bop = def.bop,
            can = { need = def.need ~= false, greed = true, pass = true },
            reason = { need = def.need == false and reasonNeed or nil },
            votes = { need = votes.need or {}, greed = votes.greed or {}, pass = votes.pass or {} },
            rolled = {},
            remaining = function(): number
                return math.max(0, duration - (GetTime() - start))
            end,
        }
        self:Add(roll)
        after(duration, function()
            if self.rolls[id] ~= roll then
                return
            end
            -- decided: you, on Need (or Greed with no Need); else the first
            -- who chose Need, else Greed
            local mine = roll.choice
            local need = #roll.votes.need > 0
            local winner: string? = nil
            if mine == "need" or (mine == "greed" and not need) then
                winner = me()
            else
                winner = roll.votes.need[1] or roll.votes.greed[1]
            end
            local label = need and "Need" or "Greed"
            if winner then
                roll.rolled[winner] = { label = label, value = 87 }
            end
            if roll.choice and roll.choice ~= "pass" and winner ~= me() then
                local c = CHOICE_BY_KEY[roll.choice]
                roll.rolled[me()] = { label = c and c.label or "", value = 42 }
            end
            self:EndRoll(id)
            self:Result(roll, winner)
        end)
        return roll
    end

    function TestRaidRoll()
        local names: string[], classes: { [string]: string } = {}, {}
        for i, name in ipairs(RAID_NAMES) do
            names[i] = name
            classes[name] = assert(RAID_CLASSES[(i * 7) % #RAID_CLASSES + 1])
        end
        local roll = self:TestRoll({
            name = "Plans: Protector's Silvered Chain Helm",
            item = 251382,
            quality = "rare",
            duration = 30,
            bop = true,
        })
        roll.roster, roll.classes = names, classes
        local id = roll.id
        -- a shuffled order, most choose within 25 s, a few never do
        local order: string[] = {}
        for i, name in ipairs(RAID_NAMES) do
            order[i] = name
        end
        for i = #order, 2, -1 do
            local j = math.random(i)
            order[i], order[j] = order[j], order[i]
        end
        local picks: ChoiceKey[] = { "pass", "pass", "pass", "greed", "greed", "need" }
        for i = 1, #order - 3 do
            after(1 + i * 0.6, function()
                if self.rolls[id] ~= roll then
                    return
                end
                table.insert(roll.votes[assert(picks[math.random(#picks)])], order[i])
                self:Refresh()
            end)
        end
        self:Refresh()
    end

    -- /suu lootroll [raid]: rolls that aren't (made-up votes; "raid": 40 players).
    function TestRolls(arg: string?)
        if arg == "raid" then
            self:TestRaidRoll()
            return
        end
        local helm = self:TestRoll({
            name = "Plans: Protector's Silvered Chain Helm",
            item = 251382,
            quality = "rare",
            duration = 40,
            bop = true,
            votes = { need = { "Ysolde" }, greed = { "Brannoc", "Morrow" } },
        })
        self:TestRoll({
            name = "Blackwater Cutlass",
            item = 1951,
            quality = "uncommon",
            duration = 30,
            need = false,
            votes = { greed = { "Brannoc", "Kaelith" } },
        })
        self:TestRoll({
            name = "Smelting Pants",
            item = 5199,
            quality = "rare",
            duration = 14,
            votes = { need = { "Morrow" }, pass = { "Ysolde" } },
        })
        -- someone makes up their mind, to see the counts change
        after(8, function()
            if self.rolls[helm.id] == helm then
                table.insert(helm.votes.greed, "Kaelith")
                self:Refresh()
            end
        end)
    end

    --------------------------------------------------------------------------------
    -- Lifecycle
    --------------------------------------------------------------------------------

    function Build(): LootRollTray
        local known = self.tray
        if known then
            return known
        end
        local tray = UI.LootRollTray(SuuUI.Root, { name = "SuuUILootRolls" })
        -- over open windows, in combat too
        tray:SetFrameStrata("DIALOG")
        tray:SetClampedToScreen(true)
        tray:Hide()
        local function rollOf(id: number): Roll?
            return self.rolls[id]
        end
        tray.onChoose = self:Guard(function(id: number, key: string)
            local roll, c = rollOf(id), CHOICE_BY_KEY[key]
            if roll and c then
                self:Choose(roll, c.key)
            end
        end)
        tray.onConfirm = self:Guard(function(id: number, yes: boolean)
            self:Confirm(id, yes)
        end)
        tray.onPassAll = self:Guard(function()
            self:PassAll()
        end)
        tray.onGreedAll = self:Guard(function()
            self:GreedAll()
        end)
        tray.onAsk = self:Guard(function(yes: boolean)
            self:AskAnswered(yes)
        end)
        tray.onFold = function(folded: boolean)
            self.folded = folded
            self:Refresh()
        end
        tray.onClose = function()
            self:ClearResults()
        end
        -- (scrolled: the hosted popup's buttons follow their row, or go)
        tray.onLayout = function()
            self:SyncHost()
        end
        tray.onItemEnter = function(id: number, owner: Frame)
            local roll = rollOf(id)
            if roll then
                self:ItemTip(owner, roll)
            end
        end
        tray.onItemLeave = function()
            GameTooltip:Hide()
        end
        tray.onItemClick = function(id: number, _: string)
            local roll = rollOf(id)
            local link = roll and roll.link
            if link and IsModifiedClick() then
                HandleModifiedItemClick(link)
            end
        end
        tray.onResultEnter = function(index: number, owner: Frame)
            local r = self.results[index]
            if r then
                self:ItemTip(owner, r.roll, true)
            end
        end
        local driver = CreateFrame("Frame")
        driver:Hide()
        local wait = 0
        driver:SetScript("OnUpdate", function(_: Frame, elapsed: number)
            wait = wait - elapsed
            if wait > 0 then
                return
            end
            wait = TICK
            self:Tick()
        end)
        self.driver = driver
        self.tray = tray
        return tray
    end

    override function OnEnable()
        local tray = self:Build()
        self:RegisterMover(tray, { key = "position", label = "Loot rolls", managedShow = true })
        self:RegisterSettings(SECTION)
        self:Watch("results", function()
            self:Refresh()
        end)
        self:RegisterCommand("lootroll", "Test loot rolls in the tray; \"/suu lootroll raid\": one in a 40-player raid.", function(
            arg: string
        )
            self:TestRolls(arg ~= "" and arg or nil)
        end)
        -- (again on every enable: turning the module off dropped its events)
        self.wired = nil
        self:Wire()
        self:Refresh()
    end

    -- The game's roll events (once a session).
    function Wire()
        if self.wired then
            return
        end
        self.wired = true
        self:HideBlizzardRolls()
        self:OnGameEvent("START_LOOT_ROLL", function(_, rollID, rollTime, lootHandle)
            self:StartRoll(rollID, rollTime, lootHandle)
        end)
        self:OnGameEvent("CONFIRM_LOOT_ROLL", function(_, rollID, rollType)
            self:ConfirmAsked(rollID, rollType)
        end)
        -- the game says rolls are over: every roll of that loot done; one
        -- item's drop decided in the loot history (once you've rolled no
        -- CANCEL_LOOT_ROLL comes: found in game)
        self:OnGameEvent("LOOT_ROLLS_COMPLETE", function(_, lootHandle)
            self:RollsComplete(lootHandle)
        end)
        self:OnGameEvent("LOOT_HISTORY_UPDATE_DROP", function(_, encounterID, lootListKey)
            self:DropDecided(encounterID, lootListKey)
        end)
        -- the game done with you on a roll: ended unless you rolled on it (then
        -- it goes once it's decided: you see the others' choices till then)
        self:OnGameEvent("CANCEL_LOOT_ROLL", function(_, rollID)
            if not secret.readable(rollID) then
                return
            end
            local roll = self.rolls[rollID]
            if roll and roll.choice then
                return
            end
            self:EndRoll(rollID)
        end)
        self:OnGameEvent("CANCEL_ALL_LOOT_ROLLS", function()
            for id in pairs(self.rolls) do
                if id > 0 then
                    self:EndRoll(id)
                end
            end
        end)
        self:OnGameEvent("CHAT_MSG_LOOT", function(_, text)
            self:OnLootLine(text)
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            self.idleSince = nil
        end)
        -- rolls already running (a /reload mid-roll)
        if GetActiveLootRollIDs then
            local ok: boolean, ids: unknown = pcall(GetActiveLootRollIDs)
            if ok and type(ids) == "table" then
                for _, id in ipairs(ids :: number[]) do
                    local left = GetLootRollTimeLeft(id)
                    self:StartRoll(id, secret.readable(left) and left or nil)
                end
            end
        end
    end

    override function OnDisable()
        local tray = self.tray
        if tray then
            tray:Hide()
        end
        if self.driver then
            self.driver:Hide()
        end
    end
end

export local M = SuuUI.AddModule(LootRollsModule.new())
