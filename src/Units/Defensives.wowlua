-- Units/Defensives.wowlua
-- Which buffs count as defensives on party and raid frames. For another
-- player's auras the game hides who cast them, and its own defensive filters
-- then let almost every buff through, so SuuUI goes by this list: the
-- engine matches its spell IDs, in combat too. One list per profile (not
-- per class: you watch everyone's defensives), handed to the group frames
-- through SuuUI.UI.SetGroupDefensives. It drives the defensive icons on
-- party and raid frames (externals first) and the Warded badge and border
-- (the entries with Warded on). Turned off, the frames show
-- none of them.

import SuuUI from "/Core/API"
import * as secret from "wowlua:secret"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

-- An entry of the list: a spell group by what it drives (`custom`: added by
-- the player).
type Entry = { name: string, kind: string, ward?: boolean, on: boolean, ids: number[], note?: string, custom?: boolean }
type DefensiveList = { entries?: Entry[] }

local M = SuuUI.RegisterModule({
    id = "defensives",
    name = "Defensives",
    description = "Which buffs count as defensives on party and raid frames, and which make a frame Warded.",
    api = "0.16",
    defaults = {
        -- { entries = { { name, kind, ward, on, ids, note, custom } … } } once
        -- the profile has its own; without entries, SuuUI's list. (It was
        -- false or the entries themselves: Settings keeps a value of its
        -- default's type, so no change could be saved.)
        list = {} :: DefensiveList,
    },
})

local isSecret = secret.isSecret

local function copy(t: any): any
    if type(t) ~= "table" then return t end
    local out = {}
    for k, v in pairs(t) do out[k] = copy(v) end
    return out
end

function M:List()
    local own = self:Get("list").entries
    if type(own) == "table" then return own end
    local out = {}
    for _, d in ipairs(SuuUI.Defensives()) do
        out[#out + 1] = { name = d.name, kind = d.kind, ward = d.ward, on = true, ids = copy(d.ids), note = d.note }
    end
    return out
end

function M:IsDefault() return type(self:Get("list").entries) ~= "table" end

local function mutate(fn: (list: Entry[]) -> ())
    local list = copy(M:List())
    fn(list)
    M:Set("list", { entries = list })
end

-- The spell IDs by what they drive, from the entries switched on.
function M:Publish()
    local d = { external = {}, defensive = {}, warded = {}, all = {} }
    for _, e in ipairs(self:List()) do
        if e.on ~= false then
            local slot = d[e.kind == "external" and "external" or "defensive"]
            for _, id in ipairs(e.ids or {}) do
                slot[#slot + 1] = id
                d.all[#d.all + 1] = id
                if e.ward then d.warded[#d.warded + 1] = id end
            end
        end
    end
    UI.SetGroupDefensives(d)
end

--------------------------------------------------------------------------------
-- The editor: Externals, then Defensives, each a well of rows; "+ Add" and
-- Reset at the foot
--------------------------------------------------------------------------------

local WIDTH = 560
local ROW_H = 32
local GROUPS = {
    { kind = "external", title = "Externals", note = "Someone else puts it on them; shown first." },
    { kind = "defensive", title = "Defensives", note = "Their own; after the externals." },
}
local KIND_OPTIONS = { { value = "external", label = "External" }, { value = "defensive", label = "Defensive" } }

-- What a typed number finds: "Name · ID 123" (value "id:123").
local function spellLookup(query: string?)
    local id = tonumber((query or ""):match("^%s*(%d+)%s*$"))
    if not id then return nil end
    local name = C_Spell.GetSpellName(id)
    if isSecret(name) or not name then return nil end
    return { { value = "id:" .. id, label = ("%s · ID %d"):format(name, id) } }
end

-- Warded: a small chip with the shield glyph; on, it takes the ward colour
-- and glow.
local function wardChip(parent: Frame, onClick: (self: any) -> ())
    local b = CreateFrame("Button", nil, parent)
    b:SetSize(76, 20)
    UI.Fill(b, "surface-sunk"):SetAllPoints()
    b.edge = UI.Border(b, "gilt-line")
    b.glow = UI.Shadow(b, "glow-ward")
    b.glyph = b:CreateTexture(nil, "ARTWORK")
    b.glyph:SetTexture("Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleTank.tga")
    b.glyph:SetSize(10, 10)
    b.glyph:SetPoint("LEFT", 8, 0)
    b.label = UI.Text(b, "caption", "ink-faint")
    b.label:SetPoint("LEFT", b.glyph, "RIGHT", 4, 0)
    b.label:SetValue("Warded")
    function b:SetValue(on: any)
        self.value = on and true or false
        local token = self.value and "ward" or "ink-faint"
        self.edge:SetColor(self.value and "ward" or "gilt-line")
        self.glow:SetShown(self.value)
        UI.Paint(self.label, token)
        UI.Paint(self.glyph, token)
    end
    b:SetScript("OnClick", onClick)
    b:SetScript("OnEnter", function(self)
        GameTooltip:SetOwner(self, "ANCHOR_TOP")
        GameTooltip:SetText("Warded")
        GameTooltip:AddLine("While it's up, the frame shows the Warded badge and border.", 1, 1, 1, true)
        GameTooltip:Show()
    end)
    b:SetScript("OnLeave", function() GameTooltip:Hide() end)
    return b
end

local function buildRow(parent: Frame)
    local r = CreateFrame("Frame", nil, parent)
    r:SetSize(WIDTH - 12, ROW_H)
    r.rule = UI.Fill(r, "gilt-faint", "ARTWORK")
    r.rule:SetPoint("BOTTOMLEFT")
    r.rule:SetPoint("BOTTOMRIGHT")
    r.rule:SetHeight(1)
    r.icon = UI.Icon(r, "icon-md")
    r.icon:SetPoint("LEFT", 4, 0)
    r.remove = UI.Button(r, { text = "×", width = 28, onClick = function()
        mutate(function(l) table.remove(l, r.index) end)
    end })
    r.remove:SetPoint("RIGHT", -2, 0)
    r.toggle = UI.Toggle(r, { onChange = function(v: boolean)
        mutate(function(l) if l[r.index] then l[r.index].on = v end end)
    end })
    r.toggle:SetPoint("RIGHT", r.remove, "LEFT", -S["space-2"], 0)
    r.ward = wardChip(r, function(self)
        mutate(function(l) if l[r.index] then l[r.index].ward = not self.value end end)
    end)
    r.ward:SetPoint("RIGHT", r.toggle, "LEFT", -S["space-2"], 0)
    r.kind = UI.Segmented(r, { options = KIND_OPTIONS, onChange = function(v: string)
        mutate(function(l) if l[r.index] then l[r.index].kind = v end end)
    end })
    r.kind:SetPoint("RIGHT", r.ward, "LEFT", -S["space-2"], 0)
    r.name = UI.Text(r, "label", "ink")
    r.name:SetPoint("TOPLEFT", r.icon, "TOPRIGHT", 8, 1)
    r.name:SetPoint("RIGHT", r.kind, "LEFT", -8, 0)
    r.name:SetWordWrap(false)
    r.note = UI.Text(r, "caption", "ink-muted")
    r.note:SetPoint("TOPLEFT", r.name, "BOTTOMLEFT", 0, -2)
    r.note:SetPoint("RIGHT", r.kind, "LEFT", -8, 0)
    r.note:SetWordWrap(false)
    return r
end

local function buildEditor(parent: Frame)
    local f = CreateFrame("Frame", nil, parent)
    f:SetSize(WIDTH, 100)
    f.rows, f.groups = {}, {}
    for i, g in ipairs(GROUPS) do
        local h = CreateFrame("Frame", nil, f)
        h:SetSize(WIDTH, 20)
        h.title = UI.Text(h, "header", "gilt-text")
        h.title:SetPoint("LEFT")
        h.count = UI.Text(h, "caption", "ink-muted")
        h.count:SetPoint("LEFT", h.title, "RIGHT", 8, 0)
        h.note = UI.Text(h, "caption", "ink-muted")
        h.note:SetPoint("RIGHT")
        h.note:SetValue(g.note)
        h.title:SetValue(g.title)
        h.well = CreateFrame("Frame", nil, f)
        UI.Fill(h.well, "surface-sunk"):SetAllPoints()
        UI.Border(h.well, "gilt-faint")
        h.empty = UI.Text(h.well, "caption", "ink-muted")
        h.empty:SetPoint("LEFT", 12, 0)
        h.empty:SetValue("None. Add one below, or move one here with its kind.")
        f.groups[i] = h
    end
    f.add = UI.Select(f, { width = 300, placeholder = "+ Add… (name or spell ID)", lookup = spellLookup,
        onChange = function(v: any)
            if not v then return end
            local id = tonumber(tostring(v):match("^id:(%d+)$"))
            local e
            if id then
                e = { name = C_Spell.GetSpellName(id), ids = { id } }
            elseif f.catalog and f.catalog[v] then
                e = { name = v, ids = copy(f.catalog[v].ids) }
            end
            if e and e.name then
                e.kind, e.ward, e.on, e.custom = "defensive", false, true, true
                mutate(function(l) table.insert(l, e) end)
            end
        end })
    f.reset = UI.Button(f, { text = "Reset to SuuUI's list", icon = "reset", tooltip = { title = "Reset to SuuUI's list", description = "Your changes go; SuuUI's list comes back (new spells SuuUI adds later come with it)." },
        onClick = function() M:Reset("list") end })

    function f:Refresh()
        for _, r in ipairs(self.rows) do r:Hide() end
        local list = M:List()
        local used, y = 0, 0
        for gi, g in ipairs(GROUPS) do
            local h = self.groups[gi]
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", 0, -y)
            y = y + 20 + S["space-2"]
            h.well:ClearAllPoints()
            h.well:SetPoint("TOPLEFT", 0, -y)
            local n, ry = 0, 4
            local last
            for i, e in ipairs(list) do
                if (e.kind == "external" and "external" or "defensive") == g.kind then
                    used = used + 1
                    local r = self.rows[used] or buildRow(h.well)
                    self.rows[used] = r
                    r:SetParent(h.well)
                    r.index = i
                    local on = e.on ~= false
                    r.icon:SetArt(e.ids and e.ids[1] and C_Spell.GetSpellTexture(e.ids[1]))
                    r.icon:SetAlpha(on and 1 or T.opacity["opacity-disabled"])
                    r.name:SetValue(e.name or "?")
                    UI.Paint(r.name, on and "ink" or "ink-faint")
                    r.note:SetValue(e.custom and "Added by you" or (e.note or ""))
                    r.kind:SetValue(e.kind == "external" and "external" or "defensive")
                    r.ward:SetValue(e.ward)
                    r.toggle:SetValue(on)
                    r:ClearAllPoints()
                    r:SetPoint("TOPLEFT", 6, -ry)
                    r.rule:Show()
                    r:Show()
                    last = r
                    n = n + 1
                    ry = ry + ROW_H
                end
            end
            if last then last.rule:Hide() end
            h.count:SetValue(tostring(n))
            h.empty:SetShown(n == 0)
            local wellH = n == 0 and 40 or (ry + 4)
            h.well:SetSize(WIDTH, wellH)
            y = y + wellH + S["space-4"]
        end
        -- "+ Add": every aura SuuUI's presets know, by name, not on the list yet
        self.catalog = SuuUI.AuraCatalog()
        local present, options = {}, {}
        for _, e in ipairs(list) do present[e.name or ""] = true end
        for name in pairs(self.catalog) do
            if not present[name] then options[#options + 1] = { value = name, label = name } end
        end
        table.sort(options, function(a, b) return a.label < b.label end)
        self.add:SetOptions(options)
        self.add:SetValue(nil)
        self.add:ClearAllPoints()
        self.add:SetPoint("TOPLEFT", 0, -y)
        self.reset:ClearAllPoints()
        self.reset:SetPoint("RIGHT", self, "TOPRIGHT", 0, -(y + 15))
        self.reset:SetEnabledState(not M:IsDefault())
        self:SetHeight(y + 30)
    end
    M.editor = f
    f:Refresh()
    f:HookScript("OnShow", function() f:Refresh() end)
    return f
end

--------------------------------------------------------------------------------
-- The preview: a made-up party at the party frames' size, then the same
-- people as raid frames, every aura as the list makes it look
--------------------------------------------------------------------------------

-- auras: spell IDs (debuffs with their type)
type Person = {
    name: string, class: string, role: string, health: number, max: number, power: number,
    aggro?: boolean, debuff?: string, auras: any[],
}
local PEOPLE: Person[] = {
    { name = "Veyra", class = "SHAMAN", role = "HEALER", health = 0.92, max = 3800, power = 0.7, auras = { { 324 } } },
    { name = "Brannoc", class = "WARRIOR", role = "TANK", health = 0.58, max = 8800, power = 0.4, auras = { { 10901 }, { 871 } } },
    { name = "Ysolde", class = "PRIEST", role = "HEALER", health = 0.81, max = 3900, power = 0.66, auras = { { 10901 } } },
    { name = "Kaelith", class = "MAGE", role = "DAMAGER", health = 0.34, max = 3600, power = 0.55, aggro = true,
      auras = { { 1022 }, { 11426 } } },
    { name = "Morrow", class = "ROGUE", role = "DAMAGER", health = 0.7, max = 4600, power = 0.8, debuff = "Poison",
      auras = { { 2818, "Poison" }, { 5277 } } },
}
local function person(unit: string) return PEOPLE[tonumber(unit:match("(%d)$")) or 1] end
local STAND_IN = UI.UnitStandIn(person)
-- a power line for tanks and healers, as on the group frames
local function powerFor(unit: string) return person(unit).role ~= "DAMAGER" end

local function partySize()
    local party = SuuUI.GetModule("party")
    local w = party and party:Get("width")
    local h = party and party:Get("height")
    return type(w) == "number" and w or 200, type(h) == "number" and h or 28
end

local function previewFrame(view: Frame, unit: string, size: string, w: number, h: number, iconSize: any, count: number)
    local f = UI.UnitFrame(view, unit, { size = size, width = w, height = h, secure = false, api = STAND_IN,
        powerFor = powerFor, textOnSmall = size == "sm" })
    f:SetScript("OnEnter", nil)
    f:SetScript("OnLeave", nil)
    f:EnableMouse(false)
    f.dispelDecos = {}
    for _, kind in ipairs(UI.DEBUFF_TYPES) do
        local deco = f:DispelDecoration(f, kind)
        deco:Hide()
        f.dispelDecos[kind] = deco
    end
    f.wardDeco = f:WardDecoration(f)
    f.icons = {}
    for k = 1, count do
        local icon = UI.Icon(size == "sm" and f.over or view, iconSize)
        icon:Hide()
        f.icons[k] = icon
    end
    return f
end

function M:PreviewView(parent: Frame)
    if not self.previewView then
        local view = CreateFrame("Frame", nil, parent)
        view:SetSize(1, 1)
        self.previewView, self.previewParty, self.previewRaid = view, {}, {}
        local w, h = partySize()
        for i = 1, #PEOPLE do
            self.previewParty[i] = previewFrame(view, "defparty" .. i, "md", w, h, h, 2)
            self.previewRaid[i] = previewFrame(view, "defraid" .. i, "sm", 108, 20, 14, 2)
        end
        view:HookScript("OnShow", function() self:DrawPreview() end)
    end
    self.previewView:SetParent(parent)
    self:DrawPreview()
    return self.previewView
end

-- One frame: its state, Warded, and its icons as the group frames show
-- them: listed defensives (externals first) and debuffs, each a set; other
-- buffs don't show. place(icon, set, k) positions an icon.
local function drawPerson(f: any, d: Person, listed: { [number]: string }, warding: { [number]: boolean },
        place: (icon: any, set: string, k: number, nBuffs: number) -> boolean?)
    f:Refresh()
    f:SetState(d.aggro and "danger" or nil, d.aggro and "Aggro" or nil)
    for kind, deco in pairs(f.dispelDecos) do deco:SetShown(d.debuff == kind) end
    local warded = false
    for _, a in ipairs(d.auras) do warded = warded or warding[a[1]] == true end
    f.wardDeco:SetWarded(warded)
    local sets = { buffs = {}, debuffs = {} }
    for _, a in ipairs(d.auras) do
        if a[2] then sets.debuffs[#sets.debuffs + 1] = a
        elseif listed[a[1]] then sets.buffs[#sets.buffs + 1] = a end
    end
    table.sort(sets.buffs, function(a, b) return (listed[a[1]] == "external" and 0 or 1) < (listed[b[1]] == "external" and 0 or 1) end)
    local used = 0
    for _, key in ipairs({ "buffs", "debuffs" }) do
        for k, a in ipairs(sets[key]) do
            used = used + 1
            local icon = f.icons[used]
            if not icon then break end
            icon:SetArt(C_Spell.GetSpellTexture(a[1]))
            icon:SetBorder(a[2] and ("dispel-" .. a[2]:lower()) or "ward")
            icon:SetGlow(a[2] == nil and "glow-ward" or nil)
            icon:ClearAllPoints()
            -- place returns false for an icon the frame has no room for
            icon:SetShown(place(icon, key, k, #sets.buffs) ~= false)
        end
    end
    for k = used + 1, #f.icons do f.icons[k]:Hide() end
end

function M:DrawPreview()
    if not self.previewView then return end
    local d = UI.GroupDefensives()
    local listed, warding = {}, {}
    for _, id in ipairs(d.defensive) do listed[id] = "defensive" end
    for _, id in ipairs(d.external) do listed[id] = "external" end
    for _, id in ipairs(d.warded) do warding[id] = true end
    local w, h = partySize()
    local y, maxW = 0, 0
    for i, f in ipairs(self.previewParty) do
        f:Resize(w, h)
        f:ClearAllPoints()
        f:SetPoint("TOPLEFT", self.previewView, "TOPLEFT", 0, -y)
        -- beside the bar: defensives, space-4, then debuffs
        drawPerson(f, PEOPLE[i], listed, warding, function(icon, set, k, nBuffs)
            icon:SetSize(h, h)
            local x = S["space-2"] + (k - 1) * (h + S["space-2"])
            if set == "debuffs" and nBuffs > 0 then x = x + nBuffs * (h + S["space-2"]) - S["space-2"] + S["space-4"] end
            icon:SetPoint("TOPLEFT", f, "TOPRIGHT", x, 0)
        end)
        maxW = math.max(maxW, w + S["space-2"] + 3 * h + S["space-2"] + S["space-4"])
        y = y + h + S["space-2"]
    end
    y = y + S["space-6"]
    for i, f in ipairs(self.previewRaid) do
        f:ClearAllPoints()
        f:SetPoint("TOPLEFT", self.previewView, "TOPLEFT", 0, -y)
        -- inside the right end: debuffs at the very end, defensives before
        -- them (one of each, as the raid defaults)
        drawPerson(f, PEOPLE[i], listed, warding, function(icon, set, k)
            if k > 1 then return false end
            icon:SetSize(14, 14)
            local hasDebuff = #PEOPLE[i].auras > 0 and PEOPLE[i].debuff ~= nil
            local x = S["space-1"] + 1
            if set == "buffs" and hasDebuff then x = x + 14 + S["space-2"] end
            icon:SetPoint("RIGHT", f, "RIGHT", -x, 0)
        end)
        y = y + 20 + S["space-1"]
    end
    self.previewView:SetSize(math.max(maxW, 108), y)
end

--------------------------------------------------------------------------------
-- Settings and lifecycle
--------------------------------------------------------------------------------

local SECTION = {
    id = "defensives", label = "Defensives", category = "Frames", order = 19,
    preview = function(parent: Frame) return M:PreviewView(parent) end,
    groups = {
        { title = "Defensives", description = "Which buffs count as defensives on your party and raid frames. The game doesn't tell which of another player's buffs are defensives, so SuuUI goes by this list: one list for this profile, for everyone's frames, yours included, in combat too. It drives the defensive icons on party and raid frames (externals first, then their own defensives) and the Warded badge and border (the spells with Warded on). Every rank counts.", rows = {
            { label = "Defensives", control = "custom", build = buildEditor, stacked = true },
        } },
    },
}

function M:OnEnable()
    self:RegisterSettings(SECTION)
    self:Publish()
    self:Watch("list", function()
        self:Publish()
        if self.editor then self.editor:Refresh() end
        self:DrawPreview()
    end)
end

function M:OnDisable()
    UI.SetGroupDefensives(nil)
end
