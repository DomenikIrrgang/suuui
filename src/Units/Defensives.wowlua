-- Units/Defensives.wowlua
-- Which buffs count as defensives on party and raid frames. For another
-- player's auras the game hides who cast them, and its own defensive filters
-- then let almost every buff through, so SuuUI goes by this list: the
-- engine matches its spell IDs, in combat too. One list per profile (not
-- per class: you watch everyone's defensives), handed to the group frames
-- through SuuUI.UI.SetGroupDefensives. It drives the defensive icons on
-- party and raid frames (externals first) and the Warded badge and border
-- (the entries with Warded on). Turned off, the frames show
-- none of them.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type SelectOption, Select from "/UI/Select"
import type SegmentedOption, Segmented, Toggle from "/UI/Inputs"
import type SuuButton from "/UI/Controls"
import type Border, SoftEdge from "/UI/Draw"
import type Text from "/UI/Text"
import type Icon from "/UI/Icon"
import type UnitFrame, StandInPerson, GroupDefensives from "/UI/UnitFrame"
import type AuraCatalog from "/Data/AuraCatalog"
import * as secret from "wowlua:secret"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

-- An entry of the list: a spell group by what it drives (`custom`: added by
-- the player).
export type Entry = { name: string, kind: string, ward?: boolean, on: boolean, ids: number[], note?: string, custom?: boolean }
type DefensiveList = { entries?: Entry[] }

local DEFAULTS = {
    -- { entries = { { name, kind, ward, on, ids, note, custom } … } } once
    -- the profile has its own; without entries, SuuUI's list. (It was
    -- false or the entries themselves: Settings keeps a value of its
    -- default's type, so no change could be saved.)
    list = {} :: DefensiveList,
}

local M: DefensivesModule



-- A copy of entries (their IDs copied too).
local function copyEntries(list: Entry[]): Entry[]
    local out: Entry[] = {}
    for i, e in ipairs(list) do
        out[i] = { name = e.name, kind = e.kind, ward = e.ward, on = e.on, ids = { unpack(e.ids) }, note = e.note, custom = e.custom }
    end
    return out
end

local function mutate(fn: (list: Entry[]) -> ())
    local list = copyEntries(M:List())
    fn(list)
    M:Set("list", { entries = list })
end

--------------------------------------------------------------------------------
-- The editor: Externals, then Defensives, each a well of rows; "+ Add" and
-- Reset at the foot
--------------------------------------------------------------------------------

local WIDTH = 560
local ROW_H = 32
type Group = { kind: string, title: string, note: string }
local GROUPS: Group[] = {
    { kind = "external", title = "Externals", note = "Someone else puts it on them; shown first." },
    { kind = "defensive", title = "Defensives", note = "Their own; after the externals." },
}
local KIND_OPTIONS: SegmentedOption<string>[] = { { value = "external", label = "External" }, { value = "defensive", label = "Defensive" } }

-- What a typed number finds: "Name · ID 123" (value "id:123").
local function spellLookup(query: string): SelectOption<string>[]?
    local id = tonumber((query or ""):match("^%s*(%d+)%s*$"))
    if not id then return nil end
    local name = C_Spell.GetSpellName(id)
    if secret.isSecret(name) or not name then return nil end
    return { { value = "id:" .. id, label = ("%s · ID %d"):format(name, id) } }
end

-- Warded: a small chip with the shield glyph; on, it takes the ward colour
-- and glow.
export class WardChip extends Button
    readonly edge: Border
    readonly glow: SoftEdge
    readonly glyph: Texture
    readonly label: Text
    value: boolean = false

    constructor(parent: Frame, onClick: (chip: WardChip) -> ())
        super(nil, parent)
        self:SetSize(76, 20)
        UI.Fill(self, "surface-sunk"):SetAllPoints()
        self.edge = UI.Border(self, "gilt-line")
        self.glow = UI.Shadow(self, "glow-ward")
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture("Interface\\AddOns\\SuuUI\\Media\\Textures\\RoleTank.tga")
        self.glyph:SetSize(10, 10)
        self.glyph:SetPoint("LEFT", 8, 0)
        self.label = UI.Text(self, "caption", "ink-faint")
        self.label:SetPoint("LEFT", self.glyph, "RIGHT", 4, 0)
        self.label:SetValue("Warded")
        self:SetScript("OnClick", function() onClick(self) end)
        self:SetScript("OnEnter", function()
            GameTooltip:SetOwner(self, "ANCHOR_TOP")
            GameTooltip:SetText("Warded")
            GameTooltip:AddLine("While it's up, the frame shows the Warded badge and border.", 1, 1, 1, true)
            GameTooltip:Show()
        end)
        self:SetScript("OnLeave", function() GameTooltip:Hide() end)
    end

    function SetOn(on: boolean?)
        self.value = on == true
        local token = self.value and "ward" or "ink-faint"
        self.edge:SetColor(self.value and "ward" or "gilt-line")
        self.glow:SetShown(self.value)
        UI.Paint(self.label, token)
        UI.Paint(self.glyph, token)
    end
end

-- An entry's row: its spell, kind, Warded, on and remove.
export class EntryRow extends Frame
    readonly rule: Texture
    readonly icon: Icon
    readonly remove: SuuButton
    readonly toggle: Toggle
    readonly ward: WardChip
    readonly kind: Segmented<string>
    readonly name: Text
    readonly note: Text
    -- the entry's place in the list
    index: number = 0

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(WIDTH - 12, ROW_H)
        self.rule = UI.Fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetPoint("BOTTOMLEFT")
        self.rule:SetPoint("BOTTOMRIGHT")
        self.rule:SetHeight(1)
        self.icon = UI.Icon(self, "icon-md")
        self.icon:SetPoint("LEFT", 4, 0)
        self.remove = UI.Button(self, { text = "×", width = 28, onClick = function()
            mutate(function(l: Entry[]) table.remove(l, self.index) end)
        end })
        self.remove:SetPoint("RIGHT", -2, 0)
        self.toggle = UI.Toggle(self, { onChange = function(v: boolean)
            mutate(function(l: Entry[]) local e = l[self.index]; if e then e.on = v end end)
        end })
        self.toggle:SetPoint("RIGHT", self.remove, "LEFT", -S["space-2"], 0)
        self.ward = WardChip.new(self, function(chip: WardChip)
            mutate(function(l: Entry[]) local e = l[self.index]; if e then e.ward = not chip.value end end)
        end)
        self.ward:SetPoint("RIGHT", self.toggle, "LEFT", -S["space-2"], 0)
        self.kind = UI.Segmented(self, { options = KIND_OPTIONS, onChange = function(v: string)
            mutate(function(l: Entry[]) local e = l[self.index]; if e then e.kind = v end end)
        end })
        self.kind:SetPoint("RIGHT", self.ward, "LEFT", -S["space-2"], 0)
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.icon, "TOPRIGHT", 8, 1)
        self.name:SetPoint("RIGHT", self.kind, "LEFT", -8, 0)
        self.name:SetWordWrap(false)
        self.note = UI.Text(self, "caption", "ink-muted")
        self.note:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -2)
        self.note:SetPoint("RIGHT", self.kind, "LEFT", -8, 0)
        self.note:SetWordWrap(false)
    end
end

-- A group's head (title, count, note) and the well its rows sit in.
export class GroupHead extends Frame
    readonly title: Text
    readonly count: Text
    readonly note: Text
    readonly well: Frame
    readonly empty: Text

    constructor(parent: Frame, g: Group)
        super(nil, parent)
        self:SetSize(WIDTH, 20)
        self.title = UI.Text(self, "header", "gilt-text")
        self.title:SetPoint("LEFT")
        self.count = UI.Text(self, "caption", "ink-muted")
        self.count:SetPoint("LEFT", self.title, "RIGHT", 8, 0)
        self.note = UI.Text(self, "caption", "ink-muted")
        self.note:SetPoint("RIGHT")
        self.note:SetValue(g.note)
        self.title:SetValue(g.title)
        self.well = CreateFrame("Frame", nil, parent)
        UI.Fill(self.well, "surface-sunk"):SetAllPoints()
        UI.Border(self.well, "gilt-faint")
        self.empty = UI.Text(self.well, "caption", "ink-muted")
        self.empty:SetPoint("LEFT", 12, 0)
        self.empty:SetValue("None. Add one below, or move one here with its kind.")
    end
end

-- The editor: the groups, "+ Add" and Reset.
export class ListEditor extends Frame
    readonly rows: EntryRow[] = {}
    readonly groups: GroupHead[] = {}
    readonly add: Select<string>
    readonly reset: SuuButton
    -- the auras "+ Add" offers by name
    catalog: AuraCatalog = {}

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(WIDTH, 100)
        for i, g in ipairs(GROUPS) do self.groups[i] = GroupHead.new(self, g) end
        self.add = UI.Select(self, { width = 300, placeholder = "+ Add… (name or spell ID)", lookup = spellLookup,
            onChange = function(v: string) self:Add(v) end })
        self.reset = UI.Button(self, { text = "Reset to SuuUI's list", icon = "reset", tooltip = { title = "Reset to SuuUI's list", description = "Your changes go; SuuUI's list comes back (new spells SuuUI adds later come with it)." },
            onClick = function() M:Reset("list") end })
        self:Refresh()
        self:HookScript("OnShow", function() self:Refresh() end)
    end

    -- "+ Add"'s choice: an aura SuuUI knows by name, or a spell by its ID ("id:123").
    function Add(v: string)
        local id = tonumber(v:match("^id:(%d+)$"))
        local e: Entry? = nil
        if id then
            local name = C_Spell.GetSpellName(id)
            if not secret.isSecret(name) and name then e = { name = name, kind = "defensive", ward = false, on = true, ids = { id }, custom = true } end
        else
            local known = self.catalog[v]
            if known then e = { name = v, kind = "defensive", ward = false, on = true, ids = { unpack(known.ids) }, custom = true } end
        end
        if e then
            local added = e
            mutate(function(l: Entry[]) table.insert(l, added) end)
        end
    end

    function Refresh()
        for _, r in ipairs(self.rows) do r:Hide() end
        local list = M:List()
        local used, y = 0, 0
        for gi, g in ipairs(GROUPS) do
            local h = self.groups[gi]
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", 0, -y)
            y = y + 20 + S["space-2"]
            h.well:ClearAllPoints()
            h.well:SetPoint("TOPLEFT", 0, -y)
            local n, ry = 0, 4
            local last: EntryRow? = nil
            for i, e in ipairs(list) do
                if (e.kind == "external" and "external" or "defensive") == g.kind then
                    used = used + 1
                    local r = self.rows[used] or EntryRow.new(h.well)
                    self.rows[used] = r
                    r:SetParent(h.well)
                    r.index = i
                    local on = e.on ~= false
                    local first = e.ids[1]
                    r.icon:SetArt(first and (C_Spell.GetSpellTexture(first)) or nil)
                    r.icon:SetAlpha(on and 1 or T.opacity["opacity-disabled"])
                    r.name:SetValue(e.name or "?")
                    UI.Paint(r.name, on and "ink" or "ink-faint")
                    r.note:SetValue(e.custom and "Added by you" or (e.note or ""))
                    r.kind:SetValue(e.kind == "external" and "external" or "defensive")
                    r.ward:SetOn(e.ward)
                    r.toggle:SetValue(on)
                    r:ClearAllPoints()
                    r:SetPoint("TOPLEFT", 6, -ry)
                    r.rule:Show()
                    r:Show()
                    last = r
                    n = n + 1
                    ry = ry + ROW_H
                end
            end
            if last then last.rule:Hide() end
            h.count:SetValue(tostring(n))
            h.empty:SetShown(n == 0)
            local wellH = n == 0 and 40 or (ry + 4)
            h.well:SetSize(WIDTH, wellH)
            y = y + wellH + S["space-4"]
        end
        -- "+ Add": every aura SuuUI's presets know, by name, not on the list yet
        self.catalog = SuuUI.AuraCatalog()
        local present: { [string]: boolean }, options: SelectOption<string>[] = {}, {}
        for _, e in ipairs(list) do present[e.name or ""] = true end
        for name in pairs(self.catalog) do
            if not present[name] then options[#options + 1] = { value = name, label = name } end
        end
        table.sort(options, function(a: SelectOption<string>, b: SelectOption<string>): boolean return (a.label or "") < (b.label or "") end)
        self.add:SetOptions(options)
        self.add:SetValue(nil)
        self.add:ClearAllPoints()
        self.add:SetPoint("TOPLEFT", 0, -y)
        self.reset:ClearAllPoints()
        self.reset:SetPoint("RIGHT", self, "TOPRIGHT", 0, -(y + 15))
        self.reset:SetEnabledState(not M:IsDefault())
        self:SetHeight(y + 30)
    end
end

local function buildEditor(parent: Frame): ListEditor
    local f = ListEditor.new(parent)
    M.editor = f
    return f
end

--------------------------------------------------------------------------------
-- The preview: a made-up party at the party frames' size, then the same
-- people as raid frames, every aura as the list makes it look
--------------------------------------------------------------------------------

-- An aura on a made-up person: its spell, and a debuff's type.
type Aura = { id: number, debuff?: string }
type Person = StandInPerson & { name: string, class: string, role: string, aggro?: boolean, debuff?: string, auras: Aura[] }
local PEOPLE: Person[] = {
    { name = "Veyra", class = "SHAMAN", role = "HEALER", health = 0.92, max = 3800, power = 0.7, auras = { { id = 324 } } },
    { name = "Brannoc", class = "WARRIOR", role = "TANK", health = 0.58, max = 8800, power = 0.4, auras = { { id = 10901 }, { id = 871 } } },
    { name = "Ysolde", class = "PRIEST", role = "HEALER", health = 0.81, max = 3900, power = 0.66, auras = { { id = 10901 } } },
    { name = "Kaelith", class = "MAGE", role = "DAMAGER", health = 0.34, max = 3600, power = 0.55, aggro = true,
      auras = { { id = 1022 }, { id = 11426 } } },
    { name = "Morrow", class = "ROGUE", role = "DAMAGER", health = 0.7, max = 4600, power = 0.8, debuff = "Poison",
      auras = { { id = 2818, debuff = "Poison" }, { id = 5277 } } },
}
local function person(unit: string): Person return PEOPLE[tonumber(unit:match("(%d)$")) or 1] end
local STAND_IN = UI.UnitStandIn(person)
-- a power line for tanks and healers, as on the group frames
local function powerFor(unit: string): boolean return person(unit).role ~= "DAMAGER" end

local function partySize(): (number, number)
    local party = SuuUI.GetModule("party")
    local w = party and party:Get("width")
    local h = party and party:Get("height")
    return type(w) == "number" and w or 200, type(h) == "number" and h or 28
end

-- A preview frame: the unit frame, its debuff-type looks and its icons.
export type PreviewFrame = { frame: UnitFrame, decos: { [string]: Frame }, icons: Icon[] }

local function previewFrame(view: Frame, unit: string, size: string, w: number, h: number, iconSize: number, count: number): PreviewFrame
    local f = UI.UnitFrame(view, unit, { size = size, width = w, height = h, secure = false, api = STAND_IN,
        powerFor = powerFor, textOnSmall = size == "sm" })
    f:SetScript("OnEnter", nil)
    f:SetScript("OnLeave", nil)
    f:EnableMouse(false)
    local decos: { [string]: Frame } = {}
    for _, kind in ipairs(UI.DEBUFF_TYPES) do
        local deco = f:DispelDecoration(f, kind)
        deco:Hide()
        decos[kind] = deco
    end
    f.wardDeco = f:WardDecoration(f)
    local icons: Icon[] = {}
    for k = 1, count do
        local icon = UI.Icon(size == "sm" and f.over or view, iconSize)
        icon:Hide()
        icons[k] = icon
    end
    return { frame = f, decos = decos, icons = icons }
end

-- One frame: its state, Warded, and its icons as the group frames show
-- them: listed defensives (externals first) and debuffs, each a set; other
-- buffs don't show. place(icon, set, k) positions an icon.
local function drawPerson(p: PreviewFrame, d: Person, listed: { [number]: string }, warding: { [number]: boolean },
        place: (icon: Icon, set: string, k: number, nBuffs: number) -> boolean?)
    local f = p.frame
    f:Refresh()
    f:SetState(d.aggro and "danger" or nil, d.aggro and "Aggro" or nil)
    for kind, deco in pairs(p.decos) do deco:SetShown(d.debuff == kind) end
    local warded = false
    for _, a in ipairs(d.auras) do warded = warded or warding[a.id] == true end
    local ward = f.wardDeco
    if ward then ward:SetWarded(warded) end
    local buffs: Aura[], debuffs: Aura[] = {}, {}
    for _, a in ipairs(d.auras) do
        if a.debuff then debuffs[#debuffs + 1] = a
        elseif listed[a.id] then buffs[#buffs + 1] = a end
    end
    table.sort(buffs, function(a: Aura, b: Aura): boolean
        return (listed[a.id] == "external" and 0 or 1) < (listed[b.id] == "external" and 0 or 1)
    end)
    local used = 0
    for _, set in ipairs({ { key = "buffs", list = buffs }, { key = "debuffs", list = debuffs } }) do
        local key = set.key
        for k, a in ipairs(set.list) do
            used = used + 1
            local icon = p.icons[used]
            if not icon then break end
            icon:SetArt((C_Spell.GetSpellTexture(a.id)))
            local debuff = a.debuff
            icon:SetBorder(debuff and ("dispel-" .. debuff:lower()) or "ward")
            icon:SetGlow(debuff == nil and "glow-ward" or nil)
            icon:ClearAllPoints()
            -- place returns false for an icon the frame has no room for
            icon:SetShown(place(icon, key, k, #buffs) ~= false)
        end
    end
    for k = used + 1, #p.icons do p.icons[k]:Hide() end
end

--------------------------------------------------------------------------------
-- Settings and lifecycle
--------------------------------------------------------------------------------

local SECTION: SettingsSection = {
    id = "defensives", label = "Defensives", category = "Frames", order = 19,
    preview = function(parent: Frame): Frame return M:PreviewView(parent) end,
    groups = {
        { title = "Defensives", description = "Which buffs count as defensives on your party and raid frames. The game doesn't tell which of another player's buffs are defensives, so SuuUI goes by this list: one list for this profile, for everyone's frames, yours included, in combat too. It drives the defensive icons on party and raid frames (externals first, then their own defensives) and the Warded badge and border (the spells with Warded on). Every rank counts.", rows = {
            { label = "Defensives", control = "custom", build = buildEditor, stacked = true },
        } },
    },
}

class DefensivesModule extends Module<typeof(DEFAULTS)>
    editor: ListEditor? = nil
    previewParty: PreviewFrame[] = {}
    previewRaid: PreviewFrame[] = {}
    previewView: Frame? = nil

    constructor()
        super({
            id = "defensives",
            name = "Defensives",
            description = "Which buffs count as defensives on party and raid frames, and which make a frame Warded.",
            api = "0.16",
            defaults = DEFAULTS,
        })
    end

    function List(): Entry[]
        local own = self:Get("list").entries
        if type(own) == "table" then return own end
        local out: Entry[] = {}
        for _, d in ipairs(SuuUI.Defensives()) do
            out[#out + 1] = { name = d.name, kind = d.kind, ward = d.ward, on = true, ids = { unpack(d.ids) }, note = d.note }
        end
        return out
    end

    function IsDefault(): boolean return type(self:Get("list").entries) ~= "table" end

    -- The spell IDs by what they drive, from the entries switched on.
    function Publish()
        local d: GroupDefensives = { external = {}, defensive = {}, warded = {}, all = {} }
        for _, e in ipairs(self:List()) do
            if e.on ~= false then
                local slot = e.kind == "external" and d.external or d.defensive
                for _, id in ipairs(e.ids or {}) do
                    slot[#slot + 1] = id
                    d.all[#d.all + 1] = id
                    if e.ward then d.warded[#d.warded + 1] = id end
                end
            end
        end
        UI.SetGroupDefensives(d)
    end

    function PreviewView(parent: Frame): Frame
        local view = self.previewView
        if not view then
            view = CreateFrame("Frame", nil, parent)
            view:SetSize(1, 1)
            self.previewView = view
            local w, h = partySize()
            for i = 1, #PEOPLE do
                self.previewParty[i] = previewFrame(view, "defparty" .. i, "md", w, h, h, 2)
                self.previewRaid[i] = previewFrame(view, "defraid" .. i, "sm", 108, 20, 14, 2)
            end
            view:HookScript("OnShow", function() self:DrawPreview() end)
        end
        view:SetParent(parent)
        self:DrawPreview()
        return view
    end

    function DrawPreview()
        local view = self.previewView
        if not view then return end
        local d = UI.GroupDefensives()
        local listed: { [number]: string }, warding: { [number]: boolean } = {}, {}
        for _, id in ipairs(d.defensive) do listed[id] = "defensive" end
        for _, id in ipairs(d.external) do listed[id] = "external" end
        for _, id in ipairs(d.warded) do warding[id] = true end
        local w, h = partySize()
        local y, maxW = 0, 0
        for i, p in ipairs(self.previewParty) do
            local f = p.frame
            f:Resize(w, h)
            f:ClearAllPoints()
            f:SetPoint("TOPLEFT", view, "TOPLEFT", 0, -y)
            -- beside the bar: defensives, space-4, then debuffs
            drawPerson(p, PEOPLE[i], listed, warding, function(icon: Icon, set: string, k: number, nBuffs: number): boolean?
                icon:SetSize(h, h)
                local x = S["space-2"] + (k - 1) * (h + S["space-2"])
                if set == "debuffs" and nBuffs > 0 then x = x + nBuffs * (h + S["space-2"]) - S["space-2"] + S["space-4"] end
                icon:SetPoint("TOPLEFT", f, "TOPRIGHT", x, 0)
                return true
            end)
            maxW = math.max(maxW, w + S["space-2"] + 3 * h + S["space-2"] + S["space-4"])
            y = y + h + S["space-2"]
        end
        y = y + S["space-6"]
        for i, p in ipairs(self.previewRaid) do
            local f = p.frame
            f:ClearAllPoints()
            f:SetPoint("TOPLEFT", view, "TOPLEFT", 0, -y)
            -- inside the right end: debuffs at the very end, defensives before
            -- them (one of each, as the raid defaults)
            drawPerson(p, PEOPLE[i], listed, warding, function(icon: Icon, set: string, k: number): boolean?
                if k > 1 then return false end
                icon:SetSize(14, 14)
                local hasDebuff = #PEOPLE[i].auras > 0 and PEOPLE[i].debuff ~= nil
                local x = S["space-1"] + 1
                if set == "buffs" and hasDebuff then x = x + 14 + S["space-2"] end
                icon:SetPoint("RIGHT", f, "RIGHT", -x, 0)
                return true
            end)
            y = y + 20 + S["space-1"]
        end
        view:SetSize(math.max(maxW, 108), y)
    end

    override function OnEnable()
        self:RegisterSettings(SECTION)
        self:Publish()
        self:Watch("list", function()
            self:Publish()
            if self.editor then self.editor:Refresh() end
            self:DrawPreview()
        end)
    end

    override function OnDisable()
        UI.SetGroupDefensives(nil)
    end
end

M = SuuUI.AddModule(DefensivesModule.new())
