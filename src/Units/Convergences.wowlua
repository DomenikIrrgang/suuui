-- Units/Convergences.wowlua
-- The Convergences of Elements (design "Convergences of Elements", B: a
-- Skyborne layer): the tornadoes where a Skyborne's Skysight gives the long
-- Elemental Blessing. The game marks them nowhere (no vignette, no area
-- POI; /suu probe skysight), so SuuUI learns each one from your casts and
-- keeps them for the whole account. Probed 2026-10-19:
--   Skysight (1259686) next to a convergence  → Elemental Blessing 1270893,
--                                               15 min or more, +10% speed
--   anywhere else                             → Elemental Blessing 1259688, 30 s
--   in combat the blessing reads as secret: the cast's place is kept and
--   the blessing read once combat ends (it outlasts any fight)
-- A cast within 40 yards of a known one is that one. One is seeded, from
-- the quest data SuuUI carries (Zephra's Isle).
--
-- Shared with your group and guild (asked 2026-10-19): a convergence you
-- find or use goes to both by addon message, and Share all in the settings
-- sends every one you know. Every character with SuuUI saves what it's
-- sent, whatever its race, so your Skyborne alts have them; a shared one
-- reads "Shared by" until you use Skysight there yourself. Taken (0.47)
-- from the group's channels and the guild only (never a whisper), checked,
-- 30 per sender a session, and never at the cost of one you found or
-- confirmed; a burst from one sender is told once.
--
-- Only Skyborne characters see them: the world map's Skyborne filters
-- (through the convergences service), and the minimap when near.
-- A built-in module written against the public API only.
--
-- A spot: { map (uiMapID), x, y (0-1), by (who found it), at (time()),
-- from (who shared it with you; nil: found here or seeded), confirmed (you
-- used Skysight there), seed (SuuUI's data) }.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import CONVERGENCES from "/Core/ServiceKeys"
import type ConvergenceOnMap from "/Core/ServiceKeys"
import type TooltipData, TooltipLine from "/UI/Tooltip"
import type MapPinData from "/UI/MapPin"
import * as secret from "wowlua:secret"

local DEFAULTS = { send = true, receive = true, minimap = true }

local M: ConvergencesModule

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

-- A convergence, as saved (see the header).
export type Spot = {
    map: number,
    x: number,
    y: number,
    by?: string,
    at?: number,
    from?: string,
    confirmed?: boolean,
    seed?: boolean,
}
-- A spot's place in the world.
type World = { continent: number, north: number, west: number }
-- A Skysight cast waiting to be read.
type Pending = { map: number, x: number, y: number, cast: number }
-- A spot in the minimap's range, its offset from the centre.
type Place = { spot: Spot, x: number, y: number }

local SKYSIGHT = 1259686
local BLESSING = 1270893 -- the long one, at a convergence
local SKYBORNE_RACES: { [number]: boolean } = { [95] = true, [96] = true }
local SAME_SPOT = 40 -- yards
local PENDING_FOR = 20 * 60 -- seconds a cast waits to be read
local MAX_SPOTS = 200
local MAX_PER_SENDER = 30 -- shared spots taken from one sender a session
local TAG = "CONV"
-- where they're taken from: the group's channels and the guild
local CHANNELS = { "PARTY", "RAID", "INSTANCE_CHAT", "GUILD" }

local SEED: Spot = { map = 2521, x = 0.4828, y = 0.2062, seed = true, confirmed = true }

--------------------------------------------------------------------------------
-- The spots
--------------------------------------------------------------------------------

-- The saved spots (for the whole account), the seed put in once.
local function store(): Spot[]
    local d: { [string]: unknown } = SuuUI.AccountData("convergences")
    local saved = d.spots
    local spots: Spot[]
    if type(saved) == "table" then
        spots = saved :: Spot[]
    else
        spots = {}
        d.spots = spots
    end
    if not d.seeded then
        d.seeded = true
        table.insert(spots, 1, { map = SEED.map, x = SEED.x, y = SEED.y, seed = SEED.seed, confirmed = SEED.confirmed })
    end
    return spots
end

-- A spot's place in the world, cached (false: it has none).
local worldCache: { [Spot]: World | false } = {}
setmetatable(worldCache, { __mode = "k" })
local function worldOf(spot: Spot): World?
    local w: World | false | nil = worldCache[spot]
    if w == nil then
        w = false
        if C_Map.GetWorldPosFromMapPos and CreateVector2D then
            local ok, continent, pos = pcall(C_Map.GetWorldPosFromMapPos, spot.map, CreateVector2D(spot.x, spot.y))
            if ok and secret.readable(continent) and pos then
                local n, wv = pos:GetXY()
                if secret.readable(n) and secret.readable(wv) then
                    w = { continent = continent, north = n, west = wv }
                end
            end
        end
        worldCache[spot] = w
    end
    return w or nil
end

-- Yards between two spots; nil when they can't be compared.
local function yards(a: Spot, b: Spot): number?
    local wa, wb = worldOf(a), worldOf(b)
    if wa and wb then
        if wa.continent ~= wb.continent then
            return nil
        end
        local dn, dw = wa.north - wb.north, wa.west - wb.west
        return math.sqrt(dn * dn + dw * dw)
    end
    if a.map ~= b.map then
        return nil
    end
    local ok, w, h = pcall(C_Map.GetMapWorldSize, a.map)
    if not (ok and secret.readable(w) and secret.readable(h) and w > 0 and h > 0) then
        return nil
    end
    local dx, dy = (a.x - b.x) * w, (a.y - b.y) * h
    return math.sqrt(dx * dx + dy * dy)
end

local function changed(self: ConvergencesModule)
    self:Emit("SUUUI_CONVERGENCES_CHANGED")
    self:UpdateMinimap()
end

-- Room for one more: the oldest shared one not confirmed goes first, then
-- (for one you found) the oldest that isn't SuuUI's data. A shared one never
-- pushes out one you found or confirmed: false then (GRP-24).
local function makeRoom(list: Spot[], shared: boolean?): boolean
    if #list < MAX_SPOTS then
        return true
    end
    for i, s in ipairs(list) do
        if s.from and not s.confirmed then
            table.remove(list, i)
            return true
        end
    end
    if shared then
        return false
    end
    for i, s in ipairs(list) do
        if not s.seed then
            table.remove(list, i)
            return true
        end
    end
    return true
end

--------------------------------------------------------------------------------
-- The blessing
--------------------------------------------------------------------------------

-- The long blessing on you: the aura, nil without it, false when it can't
-- be read (combat).
local function blessing(): AuraData | false | nil
    local ok, a = pcall(C_UnitAuras.GetPlayerAuraBySpellID, BLESSING)
    if not ok or issecretvalue(a) then
        return false
    end
    if a == nil then
        if InCombatLockdown() then
            return false
        end
        return nil
    end
    if not (secret.readable(a.expirationTime) and secret.readable(a.duration)) then
        return false
    end
    return a
end

local function readBlessing(self: ConvergencesModule)
    local a = blessing()
    if a == false then
        return
    end
    local now = a ~= nil
    if now ~= self.blessed then
        self.blessed = now
        changed(self)
    end
end

--------------------------------------------------------------------------------
-- Learning: a Skysight cast's place, kept until the blessing can be read
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- Sharing: your group and your guild
--------------------------------------------------------------------------------

-- (names can't break the message, nor carry the UI's escapes: no tabs,
-- newlines or "|"; 40 bytes at most)
local function clean(s: unknown): string
    return SuuUI.Comm.Name(type(s) == "string" and s or "", 40) or ""
end

-- A spot's message after its tag: "CONV\t1\t<map>\t<x>\t<y>\t<by>\t<at>".
local function payloadOf(spot: Spot): string
    return ("1\t%d\t%.4f\t%.4f\t%s\t%d"):format(spot.map, spot.x, spot.y, clean(spot.by), spot.at or 0)
end

--------------------------------------------------------------------------------
-- The look: the map pin, its tooltip
--------------------------------------------------------------------------------

local function day(at: number): string
    return ("%d %s"):format(tonumber(date("%d", at)), date("%b", at))
end

--------------------------------------------------------------------------------
-- The minimap, when near: the tornado where it is, in range only
--------------------------------------------------------------------------------

class ConvergencePin extends Frame
    readonly glow: Texture
    readonly glyph: Texture
    spot: Spot? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(16, 16)
        self.glow = self:CreateTexture(nil, "BACKGROUND")
        UI.Skin(self.glow, "circle-soft")
        self.glow:SetPoint("CENTER")
        self.glow:SetSize(28, 28)
        UI.Paint(self.glow, "arcane-glow")
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        UI.Glyph(self.glyph, "tornado")
        self.glyph:SetAllPoints()
        UI.Paint(self.glyph, "arcane")
        self:EnableMouse(true)
        self:SetScript("OnEnter", function()
            -- (a pin keeps a spot once it has one)
            if self.spot then
                UI.ShowTooltip(self, function(): TooltipData
                    return M:Tip(assert(self.spot))
                end)
            end
        end)
        self:SetScript("OnLeave", function()
            UI.HideTooltip()
        end)
    end
end

--------------------------------------------------------------------------------
-- Settings › Convergences of Elements
--------------------------------------------------------------------------------

local function shareReason(): (boolean?, string?)
    if #M:Channels() == 0 then
        return true, "You're in no group or guild."
    end
end

local SECTION: SettingsSection = {
    id = "convergences",
    label = "Convergences of Elements",
    category = "World",
    order = 14,
    groups = {
        {
            title = "On the map",
            description = "Skyborne characters see the convergences on the world map (Map filters › Skyborne) and, near one, on the minimap. They glow while you don't have the long Elemental Blessing.",
            rows = {
                {
                    key = "minimap",
                    label = "On the minimap when near",
                    control = "toggle",
                    disabled = function()
                        if not M:IsSkyborne() then
                            return true, "Only Skyborne characters see the convergences."
                        end
                    end,
                    description = "A convergence within the minimap's range shows there, glowing while you don't have the blessing.",
                },
            },
        },
        {
            title = "Sharing",
            description = "Your group and your guild, for players with SuuUI. Every character saves what it's sent, whatever its race, so your Skyborne characters have them.",
            rows = {
                {
                    key = "send",
                    label = "Send the ones you find",
                    control = "toggle",
                    description = "A convergence you find, or use Skysight at, goes to your group and guild.",
                },
                {
                    key = "receive",
                    label = "Save shared ones",
                    control = "toggle",
                    description = "Convergences your group or guild sends are saved for all your characters, marked with who shared them until you use Skysight there yourself.",
                },
                {
                    label = "Share all",
                    control = "button",
                    text = "Share all",
                    disabled = shareReason,
                    description = function()
                        local n = #M:Spots()
                        return ("Sends every convergence you know (%d) to your group and guild."):format(n)
                    end,
                    onClick = function()
                        M:ShareAll()
                    end,
                },
            },
        },
    },
}

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

class ConvergencesModule extends Module<typeof(DEFAULTS)>
    -- whether you have the long blessing (the last known while it can't be read)
    blessed: boolean? = nil
    mmLayer: Frame? = nil
    mmPins: ConvergencePin[] = {}
    pending: Pending? = nil
    -- shared spots taken this session, by sender (only group and guild
    -- members can send: it stays small)
    taken: { [string]: number }? = nil
    -- Share all under way (a newer one stops it)
    shareTicker: TickerHandle? = nil
    -- shared spots not told yet: one sender's burst, told once
    burst: { from: string, count: number, last: Spot }? = nil

    constructor()
        super({
            id = "convergences",
            name = "Convergences of Elements",
            description = "The tornadoes where a Skyborne's Skysight gives the long Elemental Blessing: learned from your casts, shared with your group and guild, on the world map and minimap.",
            api = "0.17",
            defaults = DEFAULTS,
        })
    end

    function Spots(): Spot[]
        return store()
    end

    -- Skyborne: by race, or by Skysight in the spellbook.
    function IsSkyborne(): boolean
        local _, _, race = UnitRace("player")
        if secret.readable(race) and SKYBORNE_RACES[race] then
            return true
        end
        local ok, known = pcall(IsPlayerSpell, SKYSIGHT)
        return ok and secret.readable(known) and known == true
    end

    -- Whether this character sees them (Skyborne, the module on).
    function Shown(): boolean
        return self:IsEnabled() and self:IsSkyborne()
    end

    function Near(spot: Spot): Spot?
        for _, s in ipairs(self:Spots()) do
            local d = yards(s, spot)
            if d and d <= SAME_SPOT then
                return s
            end
        end
    end

    function Add(spot: Spot): Spot
        local list = self:Spots()
        makeRoom(list, false)
        list[#list + 1] = spot
        changed(self)
        return spot
    end

    -- A spot's place on another map (a zone's on its continent).
    function PlaceOn(spot: Spot, mapID: number): (number?, number?)
        if spot.map == mapID then
            return spot.x, spot.y
        end
        local w = worldOf(spot)
        if not (w and C_Map.GetMapPosFromWorldPos and CreateVector2D) then
            return nil, nil
        end
        local ok, onMap, pos = pcall(C_Map.GetMapPosFromWorldPos, w.continent, CreateVector2D(w.north, w.west), mapID)
        if not (ok and onMap == mapID and pos) then
            return nil, nil
        end
        local x, y = pos:GetXY()
        if secret.readable(x) and secret.readable(y) and x >= 0 and x <= 1 and y >= 0 and y <= 1 then
            return x, y
        end
        return nil, nil
    end

    -- The convergences a map shows (the world map's pins): place, where,
    -- tooltip.
    function OnMap(mapID: number): ConvergenceOnMap[]
        local out: ConvergenceOnMap[] = {}
        for _, spot in ipairs(self:Spots()) do
            local x, y = self:PlaceOn(spot, mapID)
            if x and y then
                out[#out + 1] = {
                    x = x,
                    y = y,
                    where = self:Where(spot),
                    tip = function(): TooltipData
                        return self:Tip(spot)
                    end,
                }
            end
        end
        return out
    end

    function MapName(map: number?): string?
        local info = map and C_Map.GetMapInfo(map)
        return info and info.name
    end

    function Where(spot: Spot): string
        return ("%s %.1f, %.1f"):format(self:MapName(spot.map) or "", spot.x * 100, spot.y * 100)
    end

    -- Whether you have it (the last known while it can't be read).
    function Blessed(): boolean
        return self.blessed and true or false
    end

    -- Seconds of it left, or nil.
    function BlessingLeft(): number?
        local a = blessing()
        if a and a.expirationTime > 0 then
            return math.max(0, a.expirationTime - GetTime())
        end
    end

    function OnCast()
        local map = C_Map.GetBestMapForUnit("player")
        if not secret.readable(map) then
            return
        end
        local pos = C_Map.GetPlayerMapPosition(map, "player")
        local x: number?, y: number? = nil, nil
        if pos then
            x, y = pos:GetXY()
        end
        if not (secret.readable(x) and secret.readable(y)) then
            return
        end
        self.pending = { map = map, x = x, y = y, cast = GetTime() }
        self:After(0.5, function()
            self:Resolve()
        end)
    end

    -- Which blessing the cast gave, once it can be read: the long one begun at
    -- the cast means a convergence (one from an earlier cast began before).
    function Resolve()
        local p = self.pending
        if not p then
            return
        end
        if GetTime() - p.cast > PENDING_FOR then
            self.pending = nil
            return
        end
        local a = blessing()
        if a == false then
            return
        end -- combat: after it
        self.pending = nil
        if not (a and a.duration > 0 and math.abs((a.expirationTime - a.duration) - p.cast) < 3) then
            return
        end
        self:AtConvergence({ map = p.map, x = p.x, y = p.y })
    end

    function AtConvergence(here: Spot)
        local known = self:Near(here)
        if known then
            if not known.confirmed then
                known.confirmed = true
                changed(self)
            end
            self:Send(known)
            return
        end
        local name = UnitName("player")
        local spot = self:Add({
            map = here.map,
            x = here.x,
            y = here.y,
            by = secret.readable(name) and name or nil,
            at = time(),
            confirmed = true,
        })
        self:Send(spot)
        if self:Shown() then
            SuuUI.Notify({
                id = "suu:convergence:found",
                kind = "timed",
                category = "Skysight",
                icon = { glyph = "tornado", color = "arcane" },
                title = "Convergence of Elements found",
                body = self:Where(spot) .. ". Saved for all your characters.",
            })
        end
    end

    function Channels(): string[]
        return SuuUI.Comm.GroupAndGuild()
    end

    -- One spot, when you find or use it (Sharing › Send on).
    function Send(spot: Spot)
        if not self:Get("send") then
            return
        end
        for _, ch in ipairs(self:Channels()) do
            self:SendAddonMessage(TAG, payloadOf(spot), ch)
        end
    end

    -- Every spot you know (the settings' Share all), four a second, to where
    -- you are at each send (X-4.4: before, to where you were at the click,
    -- also after leaving the group or turning the module off); a second
    -- click starts over.
    function ShareAll()
        if #self:Channels() == 0 then
            return
        end
        local was = self.shareTicker
        if was then
            was:Cancel()
        end
        local spots: Spot[] = {}
        for i, spot in ipairs(self:Spots()) do
            spots[i] = spot
        end
        local i = 0
        local function nextOne(ticker: TickerHandle?)
            i += 1
            local spot = spots[i]
            local channels = self:Channels()
            if not spot or #channels == 0 then
                if ticker then
                    ticker:Cancel()
                end
                self.shareTicker = nil
                return
            end
            for _, ch in ipairs(channels) do
                self:SendAddonMessage(TAG, payloadOf(spot), ch)
            end
        end
        nextOne(nil)
        if spots[2] then
            self.shareTicker = self:Every(0.25, nextOne)
        end
    end

    -- A spot from someone else's SuuUI (the receiver took it from the group
    -- or the guild, held to a rate; your own was dropped there): untrusted,
    -- so checked before it's kept.
    function OnSpot(payload: string, sender: string)
        local version, mapText, xText, yText, byText, atText = strsplit("\t", payload)
        if version ~= "1" or not self:Get("receive") then
            return
        end
        local map, x, y = SuuUI.Comm.Map(mapText), SuuUI.Comm.Fraction(xText), SuuUI.Comm.Fraction(yText)
        if not (map and x and y) then
            return
        end
        local taken = self.taken or {}
        self.taken = taken
        if (taken[sender] or 0) >= MAX_PER_SENDER then
            return
        end
        local spot: Spot = { map = map, x = x, y = y }
        if self:Near(spot) or not makeRoom(self:Spots(), true) then
            return
        end
        taken[sender] = (taken[sender] or 0) + 1
        local now = time()
        spot.at = SuuUI.Comm.Int(atText, 1.6e9, now + 86400) or now
        local by = clean(byText)
        spot.by = by ~= "" and by or nil
        local from = clean(sender)
        spot.from = from
        self:Add(spot)
        self:TellShared(spot, from)
    end

    -- A shared spot told: one notice for a sender's burst (Share all sends
    -- every spot one after another), a second after the last.
    function TellShared(spot: Spot, from: string)
        if not self:Shown() then
            return
        end
        local burst = self.burst
        if burst and burst.from == from then
            burst.count += 1
            burst.last = spot
        else
            if burst then
                self:Told()
            end
            burst = { from = from, count = 1, last = spot }
            self.burst = burst
        end
        local mine = burst
        self:After(1, function()
            if self.burst == mine and mine.last == spot then
                self:Told()
            end
        end)
    end

    function Told()
        local burst = self.burst
        self.burst = nil
        if not burst then
            return
        end
        local one = burst.count == 1
        SuuUI.Notify({
            id = "suu:convergence:shared",
            kind = "timed",
            category = "Skysight",
            icon = { glyph = "tornado", color = "arcane" },
            title = one and "Convergence of Elements shared" or "Convergences of Elements shared",
            body = one and (self:Where(burst.last) .. ". Shared by " .. burst.from .. ", saved for all your characters.") or
                ("%d convergences, the last at %s. Shared by %s, saved for all your characters."):format(
                    burst.count,
                    self:Where(burst.last),
                    burst.from
                ),
        })
    end

    -- The world map's pin: the tornado in arcane on an arcane edge, glowing
    -- while you lack the blessing (a nudge to cast there), resting with it.
    function PinLook(): MapPinData
        return {
            glyph = "tornado",
            color = "arcane",
            edge = "arcane",
            glow = not self:Blessed() and "arcane-glow" or nil,
        }
    end

    function Tip(spot: Spot): TooltipData
        local muted = "|cff" .. T.color["ink-muted"].hex
        local left = self:BlessingLeft()
        local lines: TooltipLine[] = {
            { "Elemental Blessing", left and (("%d min left"):format(math.ceil(left / 60))) or "not active" },
            { "Gives", "+10% speed, 15 min", gap = S["space-3"] },
        }
        if spot.seed then
            lines[#lines + 1] = { "Found", "SuuUI's data", gap = S["space-3"] }
        else
            local by, at, from = spot.by, spot.at, spot.from
            if by then
                lines[#lines + 1] = { "Found", by .. (at and (", " .. day(at)) or ""), gap = S["space-3"] }
            end
            if from and not spot.confirmed then
                lines[#lines + 1] = { muted .. "Shared by " .. from .. "|r", gap = S["space-3"] }
            end
        end
        local subtitle = ("%s · %.1f, %.1f"):format(self:MapName(spot.map) or "", spot.x * 100, spot.y * 100)
        return {
            title = "Convergence of Elements",
            subtitle = subtitle,
            lines = lines,
            meta = not left and "Use Skysight here for the long blessing" or nil,
        }
    end

    function MinimapPlaces(): Place[]
        local mm = Minimap
        if not (mm and C_Minimap and C_Minimap.GetViewRadius) then
            return {}
        end
        local okP, north, west, _, instance = pcall(UnitPosition, "player")
        if not (okP and secret.readable(north) and secret.readable(west) and secret.readable(instance)) then
            return {}
        end
        local range = C_Minimap.GetViewRadius()
        if not (secret.readable(range) and range > 0) then
            return {}
        end
        local half = mm:GetWidth() / 2
        local turn = 0
        if GetCVar("rotateMinimap") == "1" and GetPlayerFacing then
            local f = GetPlayerFacing()
            if secret.readable(f) then
                turn = -f
            end
        end
        local out: Place[] = {}
        for _, spot in ipairs(self:Spots()) do
            local w = worldOf(spot)
            if w and w.continent == instance then
                local east, up = west - w.west, w.north - north
                if turn ~= 0 then
                    local c, sn = math.cos(turn), math.sin(turn)
                    east, up = east * c - up * sn, east * sn + up * c
                end
                -- (inside the ring, the pin whole)
                if math.sqrt(east * east + up * up) <= range * 0.9 then
                    out[#out + 1] = { spot = spot, x = east / range * half, y = up / range * half }
                end
            end
        end
        return out
    end

    function UpdateMinimap()
        local mm = Minimap
        if not mm then
            return
        end
        local layer = self.mmLayer
        if not layer then
            if not self:Shown() then
                return
            end
            layer = CreateFrame("Frame", nil, mm)
            layer:SetAllPoints()
            layer:SetFrameLevel(mm:GetFrameLevel() + 5)
            local wait = 0
            layer:SetScript("OnUpdate", function(_: Frame, elapsed: number)
                wait = wait - elapsed
                if wait > 0 then
                    return
                end
                wait = 0.1
                self:PlaceMinimapPins()
            end)
            self.mmLayer = layer
        end
        layer:SetShown(self:Shown() and self:Get("minimap") and true or false)
        self:PlaceMinimapPins()
    end

    function PlaceMinimapPins()
        local layer = self.mmLayer
        if not (layer and layer:IsShown()) then
            return
        end
        local places = self:MinimapPlaces()
        local glow = not self:Blessed()
        local pins = self.mmPins
        for i, p in ipairs(places) do
            local pin = pins[i]
            if not pin then
                pin = ConvergencePin.new(layer)
                pins[i] = pin
            end
            pin.spot = p.spot
            pin.glow:SetShown(glow)
            pin:ClearAllPoints()
            pin:SetPoint("CENTER", layer, "CENTER", p.x, p.y)
            pin:Show()
        end
        for i = #places + 1, #pins do
            pins[i]:Hide()
        end
    end

    override function OnEnable()
        store()
        self:ProvideService(CONVERGENCES, {
            Shown = function(): boolean
                return self:Shown()
            end,
            OnMap = function(mapID: number): ConvergenceOnMap[]
                return self:OnMap(mapID)
            end,
            PinLook = function(): MapPinData
                return self:PinLook()
            end,
        })
        self:RegisterSettings(SECTION)
        -- (Share all sends four a second: room for it, not for a flood)
        self:OnAddonMessage(TAG, { channels = CHANNELS, rate = { count = 24, seconds = 5 } }, function(payload, sender)
            self:OnSpot(payload, sender)
        end)
        self:OnUnitEvent("UNIT_SPELLCAST_SUCCEEDED", { "player" }, function(_, _, _, spellID)
            if secret.readable(spellID) and spellID == SKYSIGHT then
                self:OnCast()
            end
        end)
        self:OnUnitEvent("UNIT_AURA", { "player" }, function()
            readBlessing(self)
            if self.pending and not InCombatLockdown() then
                self:Resolve()
            end
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self:After(0.5, function()
                readBlessing(self)
                self:Resolve()
            end)
        end)
        self:Watch("minimap", function()
            self:UpdateMinimap()
        end)
        self:After(1, function()
            readBlessing(self)
            self:UpdateMinimap()
        end)
        changed(self)
    end

    override function OnDisable()
        -- (its timers are cancelled: Share all stops, a burst isn't told)
        self.pending, self.shareTicker, self.burst = nil, nil, nil
        local layer = self.mmLayer
        if layer then
            layer:Hide()
        end
        self:Emit("SUUUI_CONVERGENCES_CHANGED")
    end
end

M = SuuUI.AddModule(ConvergencesModule.new())
