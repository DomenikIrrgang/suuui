-- Units/RankUpgrade.wowlua
-- A new rank onto your bars (Action bars' "Upgrade spell ranks", asked for
-- 2026-11-09): when you learn a rank of a spell, every action slot holding
-- the best rank you had of it before (on any bar, page, stance or form)
-- takes the new one; lower ranks you put there on purpose (a Rank 1 for
-- its low cost) stay. One chat line per spell says what changed. Macros
-- stay as written.
--
-- Your best rank of each spell is kept from the spellbook: read when the
-- module starts and a moment after the book changes, so a learned rank
-- still finds the one before it (the game tells SPELLS_CHANGED with it).
-- A slot is changed by picking the new rank up (C_Spell.PickupSpell) and
-- placing it (PlaceAction), which puts the old one on the cursor, dropped
-- after. Out of combat only, with an empty cursor: else it waits.
--
-- Dual spec (asked 2026-11-14): each spec has its own bars, and a rank
-- learned in one upgrades only those. Each spec's best ranks are kept while
-- it is active (Remember); switching to the other, its slots still holding
-- the best rank of then (Stale) are offered in a popup (Action bars).

import after from "wowlua:timer"

local BANK = Enum.SpellBookSpellBank and Enum.SpellBookSpellBank.Player or 0
local SPELL = Enum.SpellBookItemType and Enum.SpellBookItemType.Spell or 1
-- the action slots: six pages, the stance and form bars, bars 5 to 8 and more
local SLOTS = 180

local function rankOf(sub: unknown): number?
    return type(sub) == "string" and tonumber(sub:match("(%d+)")) or nil
end

local function spellName(id: number): string?
    local ok, name = pcall(C_Spell.GetSpellName, id)
    return ok and type(name) == "string" and name or nil
end

local function spellRank(id: number): number?
    local ok, sub = pcall(C_Spell.GetSpellSubtext, id)
    return ok and rankOf(sub) or nil
end

-- One learned rank waiting to go onto the bars.
type Upgrade = { name: string, from: number, to: number, id: number }

-- Each spec group's best ranks as they were while it was last active (a
-- character's saved data: "1", "2" -> spell name -> rank).
export type SpecRanks = { [string]: { [string]: number } }

-- A slot of the spec just switched to that holds an older rank.
export type StaleSlot = { slot: number, name: string, from: number, to: number, id: number }

export class RankUpgrader
    -- your best rank of each spell, by name
    best: { [string]: number } = {}
    -- the spell ID of that best rank
    bestID: { [string]: number } = {}
    -- learned ranks not yet on the bars (in combat, the cursor busy)
    waiting: Upgrade[] = {}
    -- tells what changed (the module's Print)
    say: (text: string) -> ()
    -- whether to upgrade at all (the setting)
    on: () -> boolean
    rereading: boolean = false
    retrying: boolean = false

    constructor(say: (text: string) -> (), on: () -> boolean)
        self.say = say
        self.on = on
        self:Read()
    end

    -- Your best rank of each spell, from the spellbook.
    function Read()
        local best: { [string]: number } = {}
        local ids: { [string]: number } = {}
        for i = 1, C_SpellBook.GetNumSpellBookSkillLines() do
            local line = C_SpellBook.GetSpellBookSkillLineInfo(i)
            if line then
                for slot = line.itemIndexOffset + 1, line.itemIndexOffset + line.numSpellBookItems do
                    local info = C_SpellBook.GetSpellBookItemInfo(slot, BANK)
                    local rank = info and info.itemType == SPELL and rankOf(info.subName)
                    if info and rank and type(info.name) == "string" and rank > (best[info.name] or 0) then
                        best[info.name] = rank
                        if type(info.spellID) == "number" then
                            ids[info.name] = info.spellID
                        end
                    end
                end
            end
        end
        self.best = best
        self.bestID = ids
    end

    -- The ranks you know now, kept as this spec group's (while it is active:
    -- what its bars were upgraded to).
    function Remember(specs: SpecRanks, group: number)
        local kept: { [string]: number } = {}
        for name, rank in pairs(self.best) do
            kept[name] = rank
        end
        specs[tostring(group)] = kept
    end

    -- After switching to `group`: its slots that hold the rank that was your
    -- best when it was last active, of a spell you now know a higher rank
    -- of (as learning a rank upgrades the active bars: lower ranks placed on
    -- purpose stay). A group never seen: every lower rank (the popup asks).
    function Stale(specs: SpecRanks, group: number): StaleSlot[]
        local was = specs[tostring(group)]
        local out: StaleSlot[] = {}
        for slot = 1, SLOTS do
            local kind, actionID = GetActionInfo(slot)
            if kind == "spell" and type(actionID) == "number" then
                local name, rank = spellName(actionID), spellRank(actionID)
                local best = name and self.best[name]
                local id = name and self.bestID[name]
                if name and rank and best and id and rank < best and (was == nil or was[name] == rank) then
                    out[#out + 1] = { slot = slot, name = name, from = rank, to = best, id = id }
                end
            end
        end
        return out
    end

    -- The stale slots given their new ranks (out of combat, an empty
    -- cursor: false when that's not so, nothing changed); one chat line
    -- per spell.
    function Place(list: StaleSlot[]): boolean
        if InCombatLockdown() or GetCursorInfo() ~= nil then
            return false
        end
        local counts: { [string]: number } = {}
        local order: StaleSlot[] = {}
        for _, s in ipairs(list) do
            C_Spell.PickupSpell(s.id)
            PlaceAction(s.slot)
            ClearCursor()
            if not counts[s.name] then
                order[#order + 1] = s
            end
            counts[s.name] = (counts[s.name] or 0) + 1
        end
        for _, s in ipairs(order) do
            local count = counts[s.name] or 0
            local okLink, link = pcall(C_Spell.GetSpellLink, s.id)
            local shown = okLink and type(link) == "string" and link or s.name
            self.say(
                ("%s: Rank %d replaced Rank %d on %d %s."):format(
                    shown,
                    s.to,
                    s.from,
                    count,
                    count == 1 and "button" or "buttons"
                )
            )
        end
        return true
    end

    -- The book changed: read it again a moment later (a learned rank's
    -- event comes with the change and still needs the rank before it).
    function BookChanged()
        if self.rereading then
            return
        end
        self.rereading = true
        after(1, function()
            self.rereading = false
            self:Read()
        end)
    end

    -- A spell learned: its rank onto the bars in place of your best before it.
    function Learned(id: number)
        local name, rank = spellName(id), spellRank(id)
        if not name or not rank then
            return
        end
        local before = self.best[name]
        if not before or before < rank then
            self.best[name] = rank
            self.bestID[name] = id
        end
        if not before or before >= rank or not self.on() then
            return
        end
        self.waiting[#self.waiting + 1] = { name = name, from = before, to = rank, id = id }
        self:Apply()
    end

    -- The waiting ranks onto the bars, when nothing stands in the way.
    function Apply()
        if #self.waiting == 0 then
            return
        end
        if InCombatLockdown() then
            -- (PLAYER_REGEN_ENABLED calls Apply again)
            return
        end
        if GetCursorInfo() ~= nil then
            if not self.retrying then
                self.retrying = true
                after(1, function()
                    self.retrying = false
                    self:Apply()
                end)
            end
            return
        end
        local list = self.waiting
        self.waiting = {}
        for _, u in ipairs(list) do
            local count = 0
            for slot = 1, SLOTS do
                local kind, actionID = GetActionInfo(slot)
                if kind == "spell" and type(actionID) == "number" and actionID ~= u.id then
                    if spellName(actionID) == u.name and spellRank(actionID) == u.from then
                        C_Spell.PickupSpell(u.id)
                        PlaceAction(slot)
                        ClearCursor()
                        count = count + 1
                    end
                end
            end
            if count > 0 then
                local okLink, link = pcall(C_Spell.GetSpellLink, u.id)
                local shown = okLink and type(link) == "string" and link or u.name
                self.say(
                    ("%s: Rank %d replaced Rank %d on %d %s."):format(
                        shown,
                        u.to,
                        u.from,
                        count,
                        count == 1 and "button" or "buttons"
                    )
                )
            end
        end
    end
end
