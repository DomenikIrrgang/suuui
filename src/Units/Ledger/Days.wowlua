-- Units/Ledger/Days.wowlua
-- The Ledger's calendar (Units/Ledger): the price store's (SuuUI.Calendar,
-- 0.48), under the names the Ledger's files use. A day is a number (days
-- since 1 January 1970 by the computer's own calendar, so "today" turns at
-- the player's midnight), the time of day one of four periods by the
-- computer's clock (Night 0–6, Morning 6–10, Noon 10–16, Evening 16–24),
-- the day of the week 1 Monday … 7 Sunday. One calendar for the prices and
-- the Ledger's books and gold, so a day is the same day everywhere.

import SuuUI from "/Core/API"

local C = SuuUI.Calendar

export const NIGHT: number = C.NIGHT
export const MORNING: number = C.MORNING
export const NOON: number = C.NOON
export const EVENING: number = C.EVENING
export const PERIODS: string[] = C.PERIODS
export const WEEKDAYS: string[] = C.WEEKDAYS

local dayOfFn, dateOfFn, dayNumberFn, weekdayFn, periodOfHourFn = C.DayOf,
    C.DateOf,
    C.DayNumber,
    C.Weekday,
    C.PeriodOfHour

-- The period an hour (0-23) falls in.
export function periodOfHour(hour: number): number
    return periodOfHourFn(hour)
end

-- A date's day number (month 1-12).
export function dayNumber(year: number, month: number, day: number): number
    return dayNumberFn(year, month, day)
end

-- A day number's date: year, month (1-12), day of the month.
export function dateOf(dayNum: number): (number, number, number)
    return dateOfFn(dayNum)
end

-- A day's weekday: 1 Monday … 7 Sunday.
export function weekday(dayNum: number): number
    return weekdayFn(dayNum)
end

-- The day and period of a time (time()'s seconds; nil: now).
export function dayOf(at: number?): (number, number)
    return dayOfFn(at)
end
