-- Units/BuffIndicators.wowlua
-- Buff indicators on party and raid frames: your heals over time and shields
-- (or anyone's buffs) as an icon, a coloured square, a border or a tint over
-- the health fill. The engine filters them by spell, so they work in combat.
-- A built-in module written against the public API only: it keeps a list
-- per class and spec (the talent tree with the most points, 0 unspecced) in
-- the profile, so one profile serves every character, and hands the active
-- spec's list to the group frames through SuuUI.UI.SetGroupIndicators;
-- turned off, the frames show none.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SelectOption, Select from "/UI/Select"
import type Indicator, UnitFrame from "/UI/UnitFrame"
import type SuuButton from "/UI/Controls"
import type Segmented, SegmentedOption, Stepper from "/UI/Inputs"
import type AnchorPicker, SwatchRow, ToggleChips, ChipOption from "/UI/Pickers"
import type Icon from "/UI/Icon"
import type Text from "/UI/Text"
import Panel from "/UI/Panel"
import * as secret from "wowlua:secret"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

-- The saved lists: by class, then spec ("0"-"3").
type SavedLists = { [string]: { [string]: Indicator[] } }

local DEFAULTS = {
    -- lists[CLASS][spec] = { { name, ids, kind, point, size, color, source } … },
    -- spec "0"-"3"; a spec without one starts from its class's defaults
    lists = {} :: SavedLists,
}

local M: BuffIndicatorsModule

local _, classFile = UnitClass("player")
local CLASS: string = secret.known(classFile, "")

-- Each class's starting set, by name (every rank's IDs come from the
-- Cooldown Manager's presets): one list for every spec, or one per spec
-- ("0"-"3"; a spec not named starts empty). Your own source unless said.
-- Classes not here start empty.
local STARTING_ALL: { [string]: Indicator[] } = {
    PRIEST = {
        { name = "Renew", kind = "icon", point = "TOPRIGHT", size = 14 },
        { name = "Power Word: Shield", kind = "square", point = "TOPLEFT", size = 8, color = "ward" },
    },
}
local STARTING_BY_SPEC: { [string]: { [string]: Indicator[] } } = {
    DRUID = {
        ["0"] = {
            { name = "Rejuvenation", kind = "icon", point = "BOTTOMLEFT", size = 10 },
            { name = "Regrowth", kind = "icon", point = "TOPLEFT", size = 10, color = "fel" },
        },
        ["1"] = {
            { name = "Rejuvenation", kind = "icon", point = "BOTTOMLEFT", size = 10 },
            { name = "Regrowth", kind = "icon", point = "TOPLEFT", size = 10, color = "fel" },
        },
        ["2"] = {
            { name = "Regrowth", kind = "icon", point = "BOTTOMRIGHT", size = 12, color = "fel" },
            { name = "Rejuvenation", kind = "icon", point = "TOPRIGHT", size = 12, color = "fel" },
            { name = "Mark of the Wild", kind = "icon", point = "CENTER", size = 18, color = "fel", show = "missing" },
        },
    },
    WARRIOR = {
        ["3"] = {
            { name = "Battle Shout", kind = "icon", point = "CENTER", size = 24, color = "fel", show = "missing",
              on = "group", source = "any" },
        },
    },
}

local KINDS: SegmentedOption<string>[] = { { value = "icon", label = "Icon" }, { value = "square", label = "Square" },
                { value = "border", label = "Border" }, { value = "fill", label = "Bar colour" } }
local POINT_LABEL: { [string]: string } = { TOPLEFT = "Top left", TOP = "Top", TOPRIGHT = "Top right", LEFT = "Left", CENTER = "Centre",
                      RIGHT = "Right", BOTTOMLEFT = "Bottom left", BOTTOM = "Bottom", BOTTOMRIGHT = "Bottom right" }
local COLORS: ChipOption[] = { { value = "fel", label = "Green" }, { value = "arcane", label = "Blue" }, { value = "ward", label = "Pale gold" },
                 { value = "amber", label = "Amber" }, { value = "ember", label = "Red" }, { value = "gilt", label = "Gilt" },
                 { value = "ink", label = "White" } }

local SIZE_OPTIONS: ChipOption[] = { { value = "5", label = "Party" }, { value = "10", label = "10" },
                       { value = "20", label = "20" }, { value = "40", label = "40" } }

local MISSING_COLORS: ChipOption[] = { { value = "ember", label = "Red" }, { value = "amber", label = "Amber" },
                         { value = "ink-faint", label = "Grey" }, { value = "arcane", label = "Blue" } }

-- An indicator, its spells and group sizes its own (an edit leaves the saved one alone).
local function copyIndicator(e: Indicator): Indicator
    local sizes: { [string]: boolean }? = nil
    local given = e.sizes
    if given then
        local set: { [string]: boolean } = {}
        for k, v in pairs(given) do set[k] = v end
        sizes = set
    end
    local ids = e.ids
    return { name = e.name, ids = ids and { unpack(ids) } or nil, kind = e.kind, point = e.point, size = e.size,
             color = e.color, source = e.source, show = e.show, missingColor = e.missingColor, on = e.on,
             missingOn = e.missingOn, sizes = sizes }
end
local function copyList(list: Indicator[]): Indicator[]
    local out: Indicator[] = {}
    for i, e in ipairs(list) do out[i] = copyIndicator(e) end
    return out
end

-- Every buff the Cooldown Manager's presets know for your class, by name.
local function knownBuffs(): { [string]: number[] }
    local byName: { [string]: number[] } = {}
    local presets = SuuUI.CooldownPresets and SuuUI.CooldownPresets() or {}
    for _, p in ipairs(presets) do
        for _, entries in ipairs({ p.lists.buffs, p.lists.procs }) do
            for _, e in ipairs(entries or {}) do
                local ids = e.ids
                if not e.group and not e.enchant and e.name and ids then byName[e.name] = byName[e.name] or ids end
            end
        end
    end
    return byName
end

-- The spec whose list the frames use, and the one the editor shows.
local function specKey(spec: number?): string return tostring(spec or 0) end

-- A spec's name from the presets' trees ("Holy"), or Unspecced.
local function specName(spec: number): string
    if spec == 0 then return "Unspecced" end
    for _, p in ipairs(SuuUI.CooldownPresets and SuuUI.CooldownPresets() or {}) do
        if p.tree == spec then return (p.name:gsub("%s*%b()", "")) end
    end
    return "Tree " .. spec
end

-- A class's lists by spec. Lists saved before specs (lists[CLASS] = {
-- indicator, … }): every spec starts from it.
local function migrated(byClass: unknown): { [string]: Indicator[] }?
    if type(byClass) ~= "table" then return nil end
    local old = (byClass :: { [number]: unknown })[1]
    if old == nil then return byClass :: { [string]: Indicator[] } end
    local list = byClass :: Indicator[]
    local out: { [string]: Indicator[] } = {}
    for spec = 0, 3 do out[specKey(spec)] = copyList(list) end
    return out
end

-- Edits go to the spec the editor shows.
local function mutate(fn: (list: Indicator[]) -> ())
    local spec = M:EditSpec()
    local list = copyList(M:List(spec))
    fn(list)
    M:SetList(list, spec)
end

--------------------------------------------------------------------------------
-- The editor: one block per indicator, then "+ Add"
--------------------------------------------------------------------------------

local WIDTH = 560
local ROW_H = 46

-- What a typed number finds: "Name · ID 123" (value "id:123").
local function spellLookup(query: string): SelectOption<string>[]?
    local id = tonumber((query or ""):match("^%s*(%d+)%s*$"))
    if not id then return nil end
    local name = C_Spell.GetSpellName(id)
    if secret.isSecret(name) or not name then return nil end
    return { { value = "id:" .. id, label = ("%s · ID %d"):format(name, id) } }
end

local KIND_LABEL: { [string]: string }, COLOR_LABEL: { [string]: string }, MISSING_LABEL: { [string]: string } = {}, {}, {}
for _, o in ipairs(KINDS) do KIND_LABEL[o.value] = o.label end
for _, o in ipairs(COLORS) do COLOR_LABEL[o.value] = o.label end
for _, o in ipairs(MISSING_COLORS) do MISSING_LABEL[o.value] = o.label:lower() end

local function placed(e: Indicator): boolean return e.kind == "icon" or e.kind == "square" or e.kind == nil end

-- The effective show mode (a bar colour has no "both").
local function showOf(e: Indicator): string
    local show = e.show or "up"
    if e.kind == "fill" and show == "both" then show = "up" end
    return show
end

-- One caption line, in the modal's order: "Square · Top left · 8px · Pale
-- gold · Up or missing (red) · My group · Party, 10".
local function summary(e: Indicator): string
    local parts: string[] = { KIND_LABEL[e.kind or "icon"] or "Icon" }
    if placed(e) then
        parts[#parts + 1] = POINT_LABEL[e.point or "TOPRIGHT"] or ""
        parts[#parts + 1] = (e.size or 10) .. "px"
    end
    if e.kind ~= "icon" and e.kind ~= nil then parts[#parts + 1] = COLOR_LABEL[e.color or "fel"] or e.color or "" end
    local show = showOf(e)
    local missing = (e.kind ~= "icon" and e.kind ~= nil) and (" (" .. (MISSING_LABEL[e.missingColor or "ember"] or "red") .. ")") or ""
    if show == "up" then parts[#parts + 1] = "While up"
    elseif show == "missing" then parts[#parts + 1] = "While missing" .. missing
    else parts[#parts + 1] = "Up or missing" .. missing end
    if (e.on or e.missingOn) == "group" then parts[#parts + 1] = "My group" end
    if e.source == "any" then parts[#parts + 1] = "Anyone's" end
    local sizes = e.sizes
    if sizes and next(sizes) then
        local on: string[] = {}
        for _, o in ipairs(SIZE_OPTIONS) do if sizes[o.value] then on[#on + 1] = o.label end end
        if #on < #SIZE_OPTIONS then parts[#parts + 1] = table.concat(on, ", ") end
    end
    return table.concat(parts, " · ")
end

--------------------------------------------------------------------------------
-- The Edit indicator modal: a live mini preview, then Look, When it shows
-- and Where in two columns. What doesn't apply stays, dimmed, with why.
--------------------------------------------------------------------------------

local EP_W, COL_W = 720, 320
local SHOW_NOTE: { [string]: string } = {
    up = "Shows while the aura is up. In combat too.",
    missing = "Shows while none of its spells is up. Out of combat only: in combat the game hides auras, so it hides.",
    both = "The missing look sits underneath; the live one covers it while the aura is up. In combat too.",
}
local SHOW_OPTIONS: SegmentedOption<string>[] = { { value = "up", label = "While up" }, { value = "missing", label = "While missing" },
                       { value = "both", label = "Up or missing", reason = "Two tints would blend." } }

-- What the panel dims while it doesn't apply: the reason under it, what it
-- says while it does, and how its control turns off.
type Applies = { reason: Text, note?: string, disable: (off: boolean) -> () }
-- A field of the panel: its control and the above.
type Field<C> = { control: C, reason: Text, note?: string, disable: (off: boolean) -> () }

-- A field: its label (caption) over its control, a reason under it while
-- it doesn't apply. Returns it and the next y.
local function field<C extends Frame>(col: Frame, y: number, label: string, control: C, disable: (off: boolean) -> (), h: number?): (Field<C>, number)
    local t = UI.Text(col, "caption", "ink-muted")
    t:SetPoint("TOPLEFT", 0, -y)
    t:SetValue(label)
    control:SetPoint("TOPLEFT", 0, -(y + 18))
    local reason = UI.Text(col, "caption", "ink-faint")
    reason:SetPoint("TOPLEFT", 0, -(y + 18 + (h or 30) + 4))
    reason:SetWidth(COL_W)
    reason:SetWordWrap(true)
    return { control = control, reason = reason, disable = disable }, y + 18 + (h or 30) + 4 + 16 + 8
end

local function setApplies(f: Applies, applies: boolean, why: string?)
    f.disable(not applies)
    f.reason:SetValue(applies and (f.note or "") or (why or ""))
    UI.Paint(f.reason, applies and "ink-muted" or "ink-faint")
end

local PREVIEW_PERSON = { name = "Ysolde", class = "PRIEST", role = "HEALER", health = 0.62, max = 3900, power = 0.7 }
local EDIT_STAND_IN = UI.UnitStandIn(function(_: string) return PREVIEW_PERSON end)

-- One of the mini preview's frames: Up or Missing.
type EditPreview = { holder: Frame, caption: Text, frame: UnitFrame }

export class IndicatorEditPanel extends Panel
    -- the indicator it edits, by its place in the list
    index: number = 1
    readonly previews: EditPreview[] = {}
    readonly kind: Field<Segmented<string>>
    readonly point: Field<AnchorPicker>
    readonly size: Stepper
    readonly sizeLabel: Text
    readonly color: Field<SwatchRow>
    readonly show: Field<Segmented<string>>
    readonly missingColor: Field<SwatchRow>
    readonly source: Field<Segmented<string>>
    readonly on: Field<Segmented<string>>
    readonly sizes: Field<ToggleChips>
    readonly reset: SuuButton
    readonly done: SuuButton

    constructor(owner: BuffIndicatorsModule)
        super(SuuUI.Root, { title = "Edit indicator", width = EP_W, height = 640, solid = true })
        UI.MakeModal(self)
        local body = self.body
        local function edit(fn: (e: Indicator) -> ())
            local index = self.index
            mutate(function(l: Indicator[]) local e = l[index] if e then fn(e) end end)
        end

        -- the live mini preview: this one indicator, up and missing
        local well = CreateFrame("Frame", nil, body)
        well:SetPoint("TOPLEFT")
        well:SetSize(EP_W - 40, 64)
        UI.Fill(well, "surface-sunk"):SetAllPoints()
        UI.Border(well, "gilt-faint")
        for i = 1, 2 do
            local holder = CreateFrame("Frame", nil, well)
            holder:SetSize(120, 46)
            local caption = UI.Text(holder, "caption", "ink-muted")
            caption:SetPoint("TOPLEFT")
            local f = UI.UnitFrame(holder, "indedit" .. i, { size = "sm", width = 120, height = 26, secure = false, api = EDIT_STAND_IN, power = false })
            f:SetScript("OnEnter", nil)
            f:SetScript("OnLeave", nil)
            f:EnableMouse(false)
            f:SetPoint("TOPLEFT", 0, -18)
            self.previews[i] = { holder = holder, caption = caption, frame = f }
        end

        local left = CreateFrame("Frame", nil, body)
        left:SetPoint("TOPLEFT", 0, -(64 + 16))
        left:SetSize(COL_W, 420)
        local right = CreateFrame("Frame", nil, body)
        right:SetPoint("TOPLEFT", COL_W + 40, -(64 + 16))
        right:SetSize(COL_W, 420)

        -- Look
        UI.SectionHeader(left, "Look", nil, COL_W):SetPoint("TOPLEFT")
        local y = 30
        local kind = UI.Segmented(left, { options = KINDS, onChange = function(v: string) edit(function(e: Indicator) e.kind = v end) end })
        self.kind, y = field(left, y, "Kind", kind, function(off: boolean) kind:SetDisabled(off) end)
        local point = UI.AnchorPicker(left, { onChange = function(v: FramePoint) edit(function(e: Indicator) e.point = v end) end })
        local yPos = y
        self.point, y = field(left, y, "Position", point, function(off: boolean) point:SetDisabled(off) end, 68)
        self.size = UI.Stepper(left, { min = 6, max = 24, step = 1, unit = "px", onChange = function(v: number) edit(function(e: Indicator) e.size = v end) end })
        self.sizeLabel = UI.Text(left, "caption", "ink-muted")
        self.sizeLabel:SetPoint("TOPLEFT", 100, -yPos)
        self.sizeLabel:SetValue("Size")
        self.size:SetPoint("TOPLEFT", 100, -(yPos + 18))
        local color = UI.SwatchRow(left, { options = COLORS, onChange = function(v: string) edit(function(e: Indicator) e.color = v end) end })
        self.color = (field(left, y, "Colour", color, function(off: boolean) color:SetDisabled(off) end, 20))

        -- When it shows
        UI.SectionHeader(right, "When it shows", nil, COL_W):SetPoint("TOPLEFT")
        y = 30
        local show = UI.Segmented(right, { options = SHOW_OPTIONS, onChange = function(v: string) edit(function(e: Indicator) e.show = v ~= "up" and v or nil end) end })
        self.show, y = field(right, y, "Show", show, function(off: boolean) show:SetDisabled(off) end)
        local missingColor = UI.SwatchRow(right, { options = MISSING_COLORS, onChange = function(v: string)
            edit(function(e: Indicator) e.missingColor = v ~= "ember" and v or nil end) end })
        self.missingColor, y = field(right, y, "Missing colour", missingColor, function(off: boolean) missingColor:SetDisabled(off) end, 20)

        -- Where
        local where = UI.SectionHeader(right, "Where", nil, COL_W)
        where:SetPoint("TOPLEFT", 0, -y)
        y = y + 30
        local source: Segmented<string> = UI.Segmented(right, { options = { { value = "mine", label = "Yours" }, { value = "any", label = "Anyone's" } },
            onChange = function(v: string) edit(function(e: Indicator) e.source = v end) end })
        self.source, y = field(right, y, "Whose", source, function(off: boolean) source:SetDisabled(off) end)
        local on: Segmented<string> = UI.Segmented(right, { options = { { value = "all", label = "Everyone" }, { value = "group", label = "My group" } },
            onChange = function(v: string) edit(function(e: Indicator) e.on = v ~= "all" and v or nil; e.missingOn = nil end) end })
        self.on, y = field(right, y, "Show on", on, function(off: boolean) on:SetDisabled(off) end)
        self.on.note = "My group: only your own raid group (in a party, everyone), e.g. Battle Shout."
        local sizes = UI.ToggleChips(right, { options = SIZE_OPTIONS, onChange = function(values: string[])
            edit(function(e: Indicator)
                local set: { [string]: boolean }, n = {}, 0
                for _, t in ipairs(values) do set[t] = true; n = n + 1 end
                e.sizes = (n > 0 and n < #SIZE_OPTIONS) and set or nil
            end)
        end })
        self.sizes = (field(right, y, "Group sizes", sizes, function(off: boolean) sizes:SetDisabled(off) end, 26))
        self.sizes.note = "All on: every size. A party (or no group) is Party; a raid the smallest size it fits."

        -- foot
        self.reset = UI.Button(body, { text = "Reset", width = 90, onClick = function()
            edit(function(e: Indicator)
                e.kind, e.point, e.size, e.color, e.source = "icon", "TOPRIGHT", 12, "fel", "mine"
                e.show, e.missingColor, e.missingOn, e.on, e.sizes = nil, nil, nil, nil, nil
            end)
        end })
        self.reset:SetPoint("BOTTOMLEFT", 0, 0)
        self.done = UI.Button(body, { text = "Done", variant = "primary", width = 90, onClick = function() self:Hide() end })
        self.done:SetPoint("BOTTOMRIGHT", 0, 0)
        -- closed: the edits made in it go to the live frames (ListsChanged)
        self:HookScript("OnHide", function() if owner.publishPending then owner:Publish() end end)
    end
end

--------------------------------------------------------------------------------
-- The list: compact rows in a well (grip, icon, name, summary, Edit, ×),
-- dragged by the grip to reorder (later ones draw over earlier ones)
--------------------------------------------------------------------------------

local function grip(parent: Frame): Frame
    local g = CreateFrame("Frame", nil, parent)
    g:SetSize(10, 18)
    for row = 0, 2 do
        for col = 0, 1 do
            local dot = UI.Fill(g, "ink-faint", "ARTWORK")
            dot:SetSize(2, 2)
            dot:SetPoint("TOPLEFT", 2 + col * 4, -3 - row * 5)
        end
    end
    g:EnableMouse(true)
    return g
end

-- An indicator's row.
export class IndicatorRow extends Frame
    readonly rule: Texture
    readonly grip: Frame
    readonly icon: Icon
    readonly name: Text
    readonly summary: Text
    readonly remove: SuuButton
    readonly edit: SuuButton
    -- its place in the list
    index: number = 0

    constructor(parent: Frame, editor: IndicatorEditor)
        super(nil, parent)
        self:SetSize(WIDTH - 12, ROW_H)
        self.rule = UI.Fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetPoint("BOTTOMLEFT")
        self.rule:SetPoint("BOTTOMRIGHT")
        self.rule:SetHeight(1)
        self.grip = grip(self)
        self.grip:SetPoint("LEFT", 4, 0)
        self.grip:SetScript("OnMouseDown", function() editor:StartDrag(self) end)
        self.grip:SetScript("OnMouseUp", function() editor:StopDrag() end)
        self.icon = UI.Icon(self, 24)
        self.icon:SetPoint("LEFT", self.grip, "RIGHT", 8, 0)
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.icon, "TOPRIGHT", 10, 2)
        self.summary = UI.Text(self, "caption", "ink-muted")
        self.summary:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -3)
        self.remove = UI.Button(self, { text = "×", width = 28, onClick = function() mutate(function(l: Indicator[]) table.remove(l, self.index) end) end })
        self.remove:SetPoint("RIGHT", -6, 0)
        self.edit = UI.Button(self, { text = "Edit", width = 64, onClick = function() M:OpenEdit(self.index) end })
        self.edit:SetPoint("RIGHT", self.remove, "LEFT", -6, 0)
        self.summary:SetPoint("RIGHT", self.edit, "LEFT", -10, 0)
        self.summary:SetWordWrap(false)
    end
end

local function specOptions(): SelectOption<number>[]
    local active, out = M:ActiveSpec(), {}
    for spec = 0, 3 do
        out[#out + 1] = { value = spec, label = specName(spec) .. (spec == active and " (active)" or "") }
    end
    return out
end

-- The settings' editor: the spec, the list, "+ Add".
export class IndicatorEditor extends Frame
    readonly rows: IndicatorRow[] = {}
    readonly spec: Select<number>
    readonly specNote: Text
    readonly well: Frame
    -- where a dragged row lands
    readonly line: Texture
    readonly add: Select<string>
    readonly hint: Text
    readonly empty: Text
    buffs: { [string]: number[] } = {}
    count: number = 0
    dragFrom: number? = nil
    dropTo: number? = nil
    dragRow: IndicatorRow? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(WIDTH, 100)
        -- which spec's list this shows (your active one by default)
        self.spec = UI.Select(self, { width = 220, options = specOptions(), onChange = function(v: number)
            M.editSpec = v
            local panel = M.editPanel
            if panel then panel:Hide() end
            self:Refresh()
            M:DrawPreview()
        end })
        self.spec:SetPoint("TOPLEFT")
        self.specNote = UI.Text(self, "caption", "ink-muted")
        self.specNote:SetPoint("LEFT", self.spec, "RIGHT", 12, 0)
        self.well = CreateFrame("Frame", nil, self)
        UI.Fill(self.well, "surface-sunk"):SetAllPoints()
        UI.Border(self.well, "gilt-faint")
        self.line = self:CreateTexture(nil, "OVERLAY")
        UI.PaintFill(self.line, "arcane")
        self.line:SetHeight(2)
        self.line:Hide()
        self.add = UI.Select(self, { width = 300, placeholder = "+ Add… (name or spell ID)", lookup = spellLookup,
            onChange = function(v: string)
                if not v then return end
                local id = tonumber(tostring(v):match("^id:(%d+)$"))
                local e: Indicator? = nil
                local ids = self.buffs[v]
                if id then
                    local name = C_Spell.GetSpellName(id)
                    e = { name = not secret.isSecret(name) and name or nil, ids = { id } }
                elseif ids then
                    e = { name = v, ids = { unpack(ids) } }
                end
                if e then
                    e.kind, e.point, e.size, e.color, e.source = "icon", "TOPRIGHT", 12, "fel", "mine"
                    local added = e
                    mutate(function(l: Indicator[]) table.insert(l, added) end)
                end
            end })
        self.hint = UI.Text(self, "caption", "ink-muted")
        self.hint:SetPoint("LEFT", self.add, "RIGHT", 12, 0)
        self.hint:SetValue("Drag to reorder: later ones draw over earlier ones.")
        self.empty = UI.Text(self.well, "caption", "ink-muted")
        self.empty:SetPoint("LEFT", 12, 0)
        self.empty:SetValue("No indicators for this spec yet. Add your heals over time and shields.")
    end

    -- dragging by the grip: an arcane line marks where the row lands
    function DropIndex(): number
        local _, given = GetCursorPosition()
        local cy = given / self:GetEffectiveScale()
        local index = 1
        for _, r in ipairs(self.rows) do
            local top, bottom = r:GetTop(), r:GetBottom()
            if r:IsShown() and top and bottom and cy < (top + bottom) / 2 then index = index + 1 end
        end
        return index
    end

    function StartDrag(row: IndicatorRow)
        self.dragFrom = row.index
        row:SetAlpha(0.4)
        self.dragRow = row
        self:SetScript("OnUpdate", function()
            local to = self:DropIndex()
            self.dropTo = to
            local anchor = self.rows[to]
            self.line:ClearAllPoints()
            self.line:SetPoint("LEFT", self.well, "LEFT", 6, 0)
            self.line:SetPoint("RIGHT", self.well, "RIGHT", -6, 0)
            if anchor and anchor:IsShown() then
                self.line:SetPoint("BOTTOM", anchor, "TOP", 0, 0)
            else
                local last = self.rows[self.count]
                if last then self.line:SetPoint("TOP", last, "BOTTOM", 0, 0) end
            end
            self.line:Show()
        end)
    end

    function StopDrag()
        self:SetScript("OnUpdate", nil)
        self.line:Hide()
        local dragged = self.dragRow
        if dragged then dragged:SetAlpha(1) end
        local from, to = self.dragFrom, self.dropTo
        self.dragFrom, self.dropTo, self.dragRow = nil, nil, nil
        if not (from and to) then return end
        if to > from then to = to - 1 end
        if to == from then return end
        local target = to
        mutate(function(l: Indicator[])
            local e = table.remove(l, from)
            if e then table.insert(l, math.min(target, #l + 1), e) end
        end)
    end

    function Refresh()
        for _, r in ipairs(self.rows) do r:Hide() end
        local spec = M:EditSpec()
        self.spec:SetOptions(specOptions())
        self.spec:SetValue(spec)
        self.specNote:SetValue(spec == M:ActiveSpec() and "Shown on your frames now." or "Shown when you switch to this spec.")
        local list = M:List(spec)
        self.count = #list
        local top = 30 + 12
        self.well:ClearAllPoints()
        self.well:SetPoint("TOPLEFT", 0, -top)
        local y = 6
        for i, e in ipairs(list) do
            local r = self.rows[i] or IndicatorRow.new(self.well, self)
            self.rows[i] = r
            r.index = i
            local ids = e.ids
            local first = ids and ids[1]
            r.icon:SetArt(first and C_Spell.GetSpellTexture(first) or nil)
            r.name:SetValue(e.name or "?")
            r.summary:SetValue(summary(e))
            r.rule:SetShown(i < #list)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 6, -y)
            r:Show()
            y = y + ROW_H
        end
        self.empty:SetShown(#list == 0)
        local wellH = #list == 0 and 40 or (y + 6)
        self.well:SetSize(WIDTH, wellH)
        -- "+ Add": the presets' buffs not on the list yet
        self.buffs = knownBuffs()
        local present: { [string]: boolean }, options: SelectOption<string>[] = {}, {}
        for _, e in ipairs(list) do present[e.name or ""] = true end
        for name in pairs(self.buffs) do
            if not present[name] then options[#options + 1] = { value = name, label = name } end
        end
        table.sort(options, function(a: SelectOption<string>, b: SelectOption<string>): boolean return (a.label or "") < (b.label or "") end)
        self.add:SetOptions(options)
        self.add:SetValue(nil)
        self.add:ClearAllPoints()
        self.add:SetPoint("TOPLEFT", 0, -(top + wellH + 10))
        self.hint:SetShown(#list >= 2)
        self:SetHeight(top + wellH + 10 + 40)
        M:RefreshEdit()
    end
end

local function buildEditor(parent: Frame): IndicatorEditor
    local f = IndicatorEditor.new(parent)
    M.editor = f
    f:Refresh()
    M:Watch("lists", function() f:Refresh() end)
    f:HookScript("OnShow", function() f:Refresh() end)
    f:HookScript("OnHide", function()
        local panel = M.editPanel
        if panel then panel:Hide() end
    end)
    return f
end

--------------------------------------------------------------------------------
-- The preview: three made-up people at the healer size, every indicator up
--------------------------------------------------------------------------------

local PEOPLE = {
    { name = "Brannoc", class = "WARRIOR", role = "TANK", health = 0.64, max = 8800, power = 0.4 },
    { name = "Ysolde", class = "PRIEST", role = "HEALER", health = 0.83, max = 3900, power = 0.7 },
    { name = "Kaelith", class = "MAGE", role = "DAMAGER", health = 0.42, max = 3600, power = 0.55 },
}
local STAND_IN = UI.UnitStandIn(function(unit: string)
    return PEOPLE[tonumber(unit:match("(%d)$")) or 1] or PEOPLE[1]
end)

local SECTION = {
    id = "indicators", label = "Buff indicators", category = "Frames", order = 18,
    preview = function(parent: Frame): Frame return M:PreviewView(parent) end,
    groups = {
        { title = "Indicators", description = "Your heals over time and shields on party and raid frames, in combat too: an icon, a coloured square, a border or a tint over the health. Saved per class and spec in this profile, so one profile serves all your characters. Edit one for its look, when it shows and where.", rows = {
            { label = "Indicators", control = "custom", build = buildEditor, stacked = true },
        } },
    },
}

class BuffIndicatorsModule extends Module<typeof(DEFAULTS)>
    -- the spec the editor shows (nil: your active one)
    editSpec: number? = nil
    editor: IndicatorEditor? = nil
    editPanel: IndicatorEditPanel? = nil
    previewFrames: UnitFrame[] = {}
    previewView: Frame? = nil
    publishPending: boolean? = nil

    constructor()
        super({
            id = "indicators",
            name = "Buff indicators",
            description = "Your heals over time and shields on party and raid frames, in combat too.",
            api = "0.9",
            defaults = DEFAULTS,
        })
    end

    function ActiveSpec(): number return (SuuUI.Spec()) end

    function EditSpec(): number return self.editSpec or self:ActiveSpec() end

    function List(given: number?): Indicator[]
        local spec = given or self:ActiveSpec()
        local byClass = migrated(self:Get("lists")[CLASS])
        local saved = byClass and byClass[specKey(spec)]
        if saved then return saved end
        -- first time for this spec: the class's defaults, with their spells
        local buffs: { [string]: number[] }, list: Indicator[] = knownBuffs(), {}
        local bySpec = STARTING_BY_SPEC[CLASS]
        for _, d in ipairs(STARTING_ALL[CLASS] or (bySpec and bySpec[specKey(spec)]) or {}) do
            local ids = d.name and buffs[d.name]
            if ids then
                local e = copyIndicator(d)
                e.ids, e.source = { unpack(ids) }, d.source or "mine"
                list[#list + 1] = e
            end
        end
        return list
    end

    function SetList(list: Indicator[], spec: number?)
        local all: SavedLists = {}
        for class, bySpec in pairs(self:Get("lists")) do
            local lists: { [string]: Indicator[] } = {}
            for key, l in pairs(migrated(bySpec) or {}) do lists[key] = copyList(l) end
            all[class] = lists
        end
        local mine = all[CLASS] or {}
        all[CLASS] = mine
        mine[specKey(spec or self:ActiveSpec())] = list
        self:Set("lists", all)
    end

    function Publish()
        self.publishPending = nil
        UI.SetGroupIndicators(self:List(self:ActiveSpec()))
    end

    -- A change to the lists. While the Edit indicator modal is open, the live
    -- party and raid frames wait for it to close (Done, or the settings window
    -- closing hides it): each look (size, colour, position…) is an engine aura
    -- container on every group frame, which the engine never frees, so the
    -- steps on the way to a look mustn't each leave one behind. The previews
    -- (this section's and the modal's) follow every step.
    function ListsChanged()
        local panel = self.editPanel
        if panel and panel:IsShown() then
            self.publishPending = true
        else
            self:Publish()
        end
    end

    function RefreshEdit()
        local p = self.editPanel
        if not (p and p:IsShown()) then return end
        local e = self:List(self:EditSpec())[p.index]
        if not e then p:Hide(); return end
        local ids = e.ids
        local first = ids and ids[1]
        local art = first and C_Spell.GetSpellTexture(first)
        p:SetTitle((art and ("|T%s:16:16:0:0|t "):format(art) or "") .. (e.name or "Indicator"))
        local show, kind = showOf(e), e.kind or "icon"

        -- the mini preview: Up and/or Missing
        local shown: { preview: EditPreview, mode: string, label: string }[] = {}
        local up, missing = assert(p.previews[1]), assert(p.previews[2])
        if show ~= "missing" then shown[#shown + 1] = { preview = up, mode = "up", label = "Up" } end
        if show ~= "up" then shown[#shown + 1] = { preview = missing, mode = "missing", label = show == "missing" and "Missing · out of combat" or "Missing" } end
        for _, h in ipairs(p.previews) do h.holder:Hide() end
        local x = (EP_W - 40 - (#shown * 120 + (#shown - 1) * 40)) / 2
        for _, s in ipairs(shown) do
            local h = s.preview
            h.holder:ClearAllPoints()
            h.holder:SetPoint("TOPLEFT", assert(h.holder:GetParent()), "TOPLEFT", x, -9)
            h.caption:SetValue(s.label)
            local view = copyIndicator(e)
            view.show = s.mode
            h.frame:Refresh()
            h.frame:SetPreviewIndicators({ view })
            h.holder:Show()
            x = x + 160
        end

        -- Look
        p.kind.control:SetValue(kind)
        p.point.control:SetValue(e.point or "TOPRIGHT")
        p.size:SetValue(e.size or 10)
        p.color.control:SetValue(e.color or "fel")
        p.point.note = kind == "icon" and "Its time shows from 16px." or ""
        local why = kind == "border" and "A border goes around the whole frame." or "A bar colour tints the whole health fill."
        setApplies(p.point, placed(e), why)
        p.size:SetDisabled(not placed(e))
        setApplies(p.color, kind ~= "icon", "An icon shows the spell's own art.")

        -- When it shows
        assert(SHOW_OPTIONS[3]).disabled = kind == "fill"
        p.show.control:SetValue(show)
        p.show.note = SHOW_NOTE[show]
        setApplies(p.show, true)
        p.missingColor.control:SetValue(e.missingColor or "ember")
        if show == "up" then
            setApplies(p.missingColor, false, "Only for While missing and Up or missing.")
        else
            setApplies(p.missingColor, kind ~= "icon", "An icon shows grey while it's missing.")
        end

        -- Where
        p.source.control:SetValue(e.source or "mine")
        setApplies(p.source, true)
        p.on.control:SetValue(e.on or e.missingOn or "all")
        setApplies(p.on, true)
        local sizes: string[] = {}
        local chosen = e.sizes
        for _, o in ipairs(SIZE_OPTIONS) do if not chosen or chosen[o.value] then sizes[#sizes + 1] = o.value end end
        p.sizes.control:SetValue(sizes)
        setApplies(p.sizes, true)
    end

    function OpenEdit(index: number)
        local panel = self.editPanel or IndicatorEditPanel.new(self)
        self.editPanel = panel
        panel.index = index
        panel:Show()
        self:RefreshEdit()
    end

    function PreviewView(parent: Frame): Frame
        local view = self.previewView
        if not view then
            view = CreateFrame("Frame", nil, parent)
            view:SetSize(120, 3 * 26 + 2 * S["space-1"])
            self.previewView, self.previewFrames = view, {}
            for i = 1, #PEOPLE do
                local f = UI.UnitFrame(view, "indpreview" .. i, { size = "sm", width = 120, height = 26, secure = false, api = STAND_IN, power = false })
                f:SetScript("OnEnter", nil)
                f:SetScript("OnLeave", nil)
                f:EnableMouse(false)
                f:SetPoint("TOPLEFT", 0, -(i - 1) * (26 + S["space-1"]))
                self.previewFrames[i] = f
            end
        end
        view:SetParent(parent)
        self:DrawPreview()
        return view
    end

    function DrawPreview()
        if #self.previewFrames == 0 then return end
        local list = self:List(self:EditSpec())
        for _, f in ipairs(self.previewFrames) do
            f:Refresh()
            f:SetPreviewIndicators(list)
        end
    end

    override function OnEnable()
        self:RegisterSettings(SECTION)
        self:Publish()
        self:Watch("lists", function() self:ListsChanged(); self:DrawPreview() end)
        -- another spec: its list goes on the frames, and the editor follows
        self:On("SUUUI_SPEC_CHANGED", function()
            self.editSpec = nil
            self:Publish()
            local editor = self.editor
            if editor then editor:Refresh() end
            self:DrawPreview()
        end)
    end

    override function OnDisable()
        self.publishPending = nil
        UI.SetGroupIndicators({})
    end
end

M = SuuUI.AddModule(BuffIndicatorsModule.new())
