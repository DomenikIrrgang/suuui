-- Units/Minimap.wowlua
-- The minimap (step 2.1, design board "Minimap"): top right, 28px from the
-- edges. The zone (header, gilt) and subzone (caption, ink) above; the map
-- itself, round, `minimap` across, in a 1px gilt ring with the inset-anchor
-- band and a panel shadow, two gilt diamonds at its corners and the north
-- marker on top; on the ring the SuuUI Jewel lower left (settings), the mail
-- marker upper left while mail waits, zoom lower right; the clock below.
-- A built-in module written against the public API only.
--
-- The game's Minimap is moved into SuuUI's frame (one frame later, out of
-- combat: moving it while a panel opens taints map pins) and kept there;
-- MinimapCluster stays shown but invisible with its mouse off (Edit Mode
-- keeps working), its art hidden. MinimapBackdrop stays: encounter addons
-- read your facing from its compass texture, which is hidden, not its frame.
-- Left click pings as always; right click opens the tracking menu; the mouse
-- wheel zooms (an overlay passes the clicks through). Turned off: a /reload
-- hands it all back.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type Position from "/EditMode/EditMode"
import isSecret from "wowlua:secret"
import hook from "wowlua:hooks"
import after, every from "wowlua:timer"
import defer from "wowlua:combat"
import type Text from "/UI/Text"
import type TooltipData, TooltipLine from "/UI/Tooltip"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {
    -- the frame's top: the zone lines above it end 28px from the screen's top
    position = { point = "TOPRIGHT", x = -28, y = -65 } :: Position,
    size = 176,
    zone = true,
    clock = true,
    wheelZoom = true,
}

local M: MinimapModule


local TEX = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local GLYPHS = TEX .. "Glyphs\\"
local ROUND_MASK = 186178
local function readable(v: unknown): v is number return not isSecret(v) and type(v) == "number" end
-- the zone lines (zone, subzone, the instance line) end this far above the
-- disc: the north marker's 8px over the ring, plus space-3
local ZONE_GAP = 8 + S["space-3"]

--------------------------------------------------------------------------------
-- Round buttons and decorations (shared by the real map and the preview)
--------------------------------------------------------------------------------

local function circleTex(parent: Frame, file: string, color: string, layer: DrawLayer?, sublevel: number?): Texture
    local t = parent:CreateTexture(nil, layer or "ARTWORK", nil, sublevel or 0)
    t:SetTexture(TEX .. file)
    UI.Paint(t, color)
    return t
end

-- A round button: surface, a gilt-line edge (gilt on hover), a glyph.
export class RoundButton extends Button
    readonly fill: Texture
    readonly edge: Texture
    readonly icon: Texture
    tip: (() -> TooltipData)? = nil

    constructor(parent: Frame, size: number, glyph: string?, glyphSize: number)
        super(nil, parent)
        self:SetSize(size, size)
        self.fill = circleTex(self, "CircleFill.tga", "surface", "BACKGROUND")
        self.fill:SetAllPoints()
        self.edge = circleTex(self, "CircleEdge.tga", "gilt-line", "BORDER")
        self.edge:SetAllPoints()
        self.icon = self:CreateTexture(nil, "ARTWORK")
        self.icon:SetSize(glyphSize, glyphSize)
        self.icon:SetPoint("CENTER")
        if glyph then
            self.icon:SetTexture(GLYPHS .. glyph .. ".tga")
            UI.Paint(self.icon, "ink")
        end
        self:SetScript("OnEnter", function()
            UI.Paint(self.edge, "gilt")
            local tip = self.tip
            if tip then UI.ShowTooltip(self, tip()) end
        end)
        self:SetScript("OnLeave", function()
            UI.Paint(self.edge, "gilt-line")
            UI.HideTooltip()
        end)
    end
end

-- The "N": 9.5 px in header's face (again when a theme changes it).
local function northFace(text: Text)
    text:SetFont(SuuUI.Fonts.Get("header"):GetFont(), 9.5, "")
end

-- What the block's buttons do (the real map's or the preview's).
type Click = (button: Button, mouse: string) -> ()
type Handlers = { jewel: Click, zoom: (delta: number) -> (), clock: Click, mailTip: () -> TooltipData }

-- The ring, ornaments, north marker and the ring's buttons around a disc.
export class Ring
    readonly over: Frame
    readonly shadow: Texture
    readonly band: Texture
    readonly inner: Texture
    readonly ring: Texture
    readonly ornTL: Texture
    readonly ornBR: Texture
    readonly north: Frame
    readonly northText: Text
    readonly jewel: RoundButton
    readonly mail: RoundButton
    readonly zoomIn: RoundButton
    readonly zoomOut: RoundButton

    constructor(disc: Frame, handlers: Handlers)
        local over = CreateFrame("Frame", nil, disc)
        over:SetAllPoints()
        over:SetFrameLevel(disc:GetFrameLevel() + 20)
        self.over = over
        -- the panel shadow under the disc (round)
        self.shadow = circleTex(disc, "CircleSoft.tga", "surface", "BACKGROUND", -8)
        self.shadow:SetVertexColor(0, 0, 0, 0.45)
        self.shadow:SetPoint("TOPLEFT", -22, 22 - 12)
        self.shadow:SetPoint("BOTTOMRIGHT", 22, -22 - 12)
        -- inset-anchor: the dark band inside, a faint gilt line inside that; the gilt ring outside
        self.band = circleTex(over, "CircleBand.tga", "surface", "OVERLAY", 1)
        self.band:SetVertexColor(0, 0, 0, 0.55)
        self.band:SetAllPoints()
        self.inner = circleTex(over, "CircleEdge.tga", "gilt-faint", "OVERLAY", 2)
        self.inner:SetPoint("TOPLEFT", 4, -4)
        self.inner:SetPoint("BOTTOMRIGHT", -4, 4)
        self.ring = circleTex(over, "CircleEdge.tga", "gilt-line", "OVERLAY", 3)
        self.ring:SetAllPoints()
        -- two gilt diamonds at the disc's square corners, 22px in
        self.ornTL = UI.Diamond(over, 7, "gilt")
        self.ornTL:SetPoint("CENTER", over, "TOPLEFT", 22, -22)
        self.ornBR = UI.Diamond(over, 7, "gilt")
        self.ornBR:SetPoint("CENTER", over, "BOTTOMRIGHT", -22, 22)
        -- the north marker: a 16px surface disc with a gilt ring and "N"
        local north = CreateFrame("Frame", nil, over)
        north:SetSize(16, 16)
        north:SetPoint("CENTER", over, "TOP", 0, 0)
        north:SetFrameLevel(over:GetFrameLevel() + 2)
        circleTex(north, "CircleFill.tga", "surface", "BACKGROUND"):SetAllPoints()
        circleTex(north, "CircleEdge.tga", "gilt", "BORDER"):SetAllPoints()
        local text = UI.Text(north, "micro", "gilt-text")
        northFace(text)
        text:SetPoint("CENTER", 0.5, 0)
        text:SetValue("N")
        self.north, self.northText = north, text
        -- the Jewel: lower left on the ring
        local jewel = RoundButton.new(over, 24, nil, 16)
        jewel.icon:SetTexture(TEX .. "Mark.tga")
        jewel:SetPoint("BOTTOMLEFT", over, "BOTTOMLEFT", -4, 26)
        jewel:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        jewel:SetScript("OnClick", handlers.jewel)
        jewel.tip = function(): TooltipData
            return { title = "SuuUI", lines = { { "Click", "Settings (open or close)" }, { "Right-click", "Edit layout" } } }
        end
        self.jewel = jewel
        -- mail: upper left while it waits
        self.mail = RoundButton.new(over, 24, "mail", 14)
        self.mail:SetPoint("TOPLEFT", over, "TOPLEFT", -4, -26)
        self.mail.tip = handlers.mailTip
        self.mail:Hide()
        -- zoom: lower right
        self.zoomIn = RoundButton.new(over, 22, "plus", 12)
        self.zoomOut = RoundButton.new(over, 22, "minus", 12)
        self.zoomOut:SetPoint("BOTTOMRIGHT", over, "BOTTOMRIGHT", 6, 6)
        self.zoomIn:SetPoint("BOTTOM", self.zoomOut, "TOP", 0, S["space-2"])
        self.zoomIn:SetScript("OnClick", function() handlers.zoom(1) end)
        self.zoomOut:SetScript("OnClick", function() handlers.zoom(-1) end)
    end
end

-- The whole block: zone above, the disc, the clock below.
export class MapBlock extends Frame
    readonly zone: Text
    readonly sub: Text
    readonly instance: Text
    readonly disc: Frame
    readonly time: Text
    readonly timeButton: Button
    readonly deco: Ring

    constructor(parent: Frame, name: string?, handlers: Handlers)
        super(name, parent)
        self.zone = UI.Text(self, "header", "gilt-text")
        self.zone:SetShadowed(true)
        self.zone:SetJustifyH("CENTER")
        self.zone:SetWordWrap(false)
        self.sub = UI.Text(self, "caption", "ink")
        self.sub:SetShadowed(true)
        self.sub:SetJustifyH("CENTER")
        self.sub:SetWordWrap(false)
        -- inside an instance: "Dungeon · 5 players" (the kind in ink, the rest muted)
        self.instance = UI.Text(self, "caption", "ink-muted")
        self.instance:SetShadowed(true)
        self.instance:SetJustifyH("CENTER")
        self.instance:SetWordWrap(false)
        self.disc = CreateFrame("Frame", nil, self)
        self.time = UI.Text(self, "caption", "ink")
        self.time:SetShadowed(true)
        self.time:SetPoint("TOP", self.disc, "BOTTOM", 0, -S["space-3"])
        -- the clock opens the game's clock; right click, the calendar
        self.timeButton = CreateFrame("Button", nil, self)
        self.timeButton:SetAllPoints(self.time)
        self.timeButton:RegisterForClicks("LeftButtonUp", "RightButtonUp")
        self.timeButton:SetScript("OnClick", handlers.clock)
        self.deco = Ring.new(self.disc, handlers)
    end

    -- The zone lines stack upward from the disc (the map never moves when a
    -- line comes or goes): the instance line lowest, the subzone, the zone.
    function StackZone()
        local below: Text? = nil
        for _, line in ipairs({ self.instance, self.sub, self.zone }) do
            line:ClearAllPoints()
            if line:IsShown() and line.value and line.value ~= "" then
                if below then line:SetPoint("BOTTOM", below, "TOP", 0, 0)
                else line:SetPoint("BOTTOM", self.disc, "TOP", 0, ZONE_GAP) end
                below = line
            else
                line:SetPoint("BOTTOM", self.disc, "TOP", 0, ZONE_GAP)
            end
        end
    end

    function Layout(size: number, zone: boolean, clock: boolean)
        self.disc:SetSize(size, size)
        for _, line in ipairs({ self.zone, self.sub, self.instance }) do
            line:SetWidth(size + 40)
            line:SetVisible(zone)
        end
        self.time:SetVisible(clock)
        self.timeButton:SetShown(clock)
        self.disc:ClearAllPoints()
        -- the placed frame is the map and the clock (8px on top for the north
        -- marker); the zone lines hang above it, so neither an empty line nor a
        -- new one moves the map
        local top = 8
        self.disc:SetPoint("TOP", 0, -top)
        self:SetSize(size, top + size + (clock and (S["space-3"] + T.type.caption.lineHeight) or 0))
        self:StackZone()
    end
end

--------------------------------------------------------------------------------
-- Live parts: zone, clock, mail, zoom
--------------------------------------------------------------------------------

local function mailTip(): TooltipData
    local lines: TooltipLine[] = {}
    if GetLatestThreeSenders then
        local senders = { GetLatestThreeSenders() }
        for _, s in ipairs(senders) do
            if not isSecret(s) and s then lines[#lines + 1] = { s } end
        end
    end
    return { title = "New mail", subtitle = #lines > 0 and "From" or nil, lines = lines }
end

--------------------------------------------------------------------------------
-- Taking over the game's minimap
--------------------------------------------------------------------------------

local hidden = CreateFrame("Frame")
hidden:Hide()

local function alphaOff(v: unknown)
    local f = frames.asRegion(v)
    if not f then return end
    f:SetAlpha(0)
    local frame = tbl.field(v, "EnableMouse") and v :: Frame or nil
    if frame then frame:EnableMouse(false) end
end

-- Inside a dungeon or raid, a line under the zone: "Dungeon · 5 players",
-- "Raid · 20 players" (Forever has no heroic modes: the kind and the size
-- are what there is to say). Blizzard's difficulty badge stays in the
-- invisible cluster.
local function instanceLine(kind: string, size: string): string
    local inkHex = T.color["ink"].hex
    return ("|cff%s%s|r · %s players"):format(inkHex, kind, size)
end

--------------------------------------------------------------------------------
-- Settings and the preview
--------------------------------------------------------------------------------

local function noClick(_: Button, _: string) end

local SECTION = {
    id = "minimap", label = "Minimap", category = "World", order = 10,
    preview = function(parent: Frame): Frame return M:PreviewView(parent) end,
    groups = {
        { title = "Minimap", description = "Left click pings, right click picks what the map tracks, the wheel zooms. The SuuUI button on the ring opens these settings (right click: edit layout).", rows = {
            { key = "size", label = "Size", control = "slider", min = 140, max = 260, step = 2, unit = "px", combat = true,
              description = "The map's diameter; the design's is 176." },
            { key = "zone", label = "Zone name", control = "toggle", description = "The zone and the subzone above the map." },
            { key = "clock", label = "Clock", control = "toggle", description = "The time below the map (the game's clock settings: server or local, 24 hours). Click: the clock; right click: the calendar." },
            { key = "wheelZoom", label = "Zoom with the wheel", control = "toggle" },
        } },
    },
}

class MinimapModule extends Module<typeof(DEFAULTS)>
    block: MapBlock? = nil
    guarded: boolean? = nil
    overlay: Frame? = nil
    pendingPlace: boolean? = nil
    pendingTheme: boolean? = nil
    placing: boolean? = nil
    preview: MapBlock? = nil
    ticker: TickerHandle? = nil

    constructor()
        super({
            id = "minimap",
            name = "Minimap",
            description = "SuuUI's round minimap with the zone, the clock, mail, zoom and the SuuUI button.",
            api = "0.10",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    function UpdateZone()
        local block = self.block
        if not block then return end
        local zone, sub = GetZoneText(), GetSubZoneText()
        if isSecret(zone) or isSecret(sub) then return end
        block.zone:SetValue(zone or "")
        block.sub:SetValue((sub and sub ~= "" and sub ~= zone) and sub or "")
        block:StackZone()
    end

    function UpdateClock()
        local block = self.block
        if not block or not self:Get("clock") then return end
        local h: number, m: number
        if C_CVar.GetCVarBool("timeMgrUseLocalTime") then
            local t = date("*t") :: { hour: number, min: number }
            h, m = t.hour, t.min
        else
            h, m = GetGameTime()
        end
        if C_CVar.GetCVarBool("timeMgrUseMilitaryTime") then
            block.time:SetValue(("%02d:%02d"):format(h, m))
        else
            local suffix = h >= 12 and "PM" or "AM"
            block.time:SetValue(("%d:%02d %s"):format((h - 1) % 12 + 1, m, suffix))
        end
    end

    function UpdateMail()
        local block = self.block
        if not block then return end
        local ok: boolean, has: unknown = pcall(HasNewMail)
        local mail = ok and not isSecret(has) and has == true
        block.deco.mail:SetShown(mail)
    end

    function Zoom(delta: number)
        -- (GetZoom and GetZoomLevels are declared without returns in 0.9.1)
        local zoom: number, max: number = Minimap:GetZoom(), Minimap:GetZoomLevels() - 1
        zoom = math.max(0, math.min(max, zoom + delta))
        Minimap:SetZoom(zoom)
    end

    function StripBlizzard()
        for _, name in ipairs({ "MinimapBorder", "MinimapBorderTop", "MinimapNorthTag", "MinimapCompassTexture",
                                "TimeManagerClockButton", "MinimapZoneTextButton", "MinimapZoneText" }) do
            local f = frames.asRegion(_G[name])
            if f then f:Hide() end
        end
        alphaOff(MinimapCompassTextureUnderlay)
        local cluster: unknown = MinimapCluster
        if cluster then
            alphaOff(cluster)
            alphaOff(tbl.field(cluster, "Selection"))
            local zoneButton = frames.asRegion(tbl.field(cluster, "ZoneTextButton"))
            if zoneButton then zoneButton:Hide() end
            local tracking = tbl.field(cluster, "Tracking")
            alphaOff(tracking)
            alphaOff(tbl.field(tracking, "Button"))
            local indicators = tbl.field(cluster, "IndicatorFrame")
            alphaOff(tbl.field(indicators, "MailFrame"))
            alphaOff(tbl.field(indicators, "CraftingOrderFrame"))
        end
        alphaOff(GameTimeFrame)
        -- the group finder's eye can live in the (invisible) cluster: it stays seen
        if QueueStatusButton and QueueStatusButton.SetIgnoreParentAlpha then QueueStatusButton:SetIgnoreParentAlpha(true) end
        -- Blizzard's zoom buttons: ours instead
        for _, v in ipairs({ tbl.field(Minimap, "ZoomIn"), tbl.field(Minimap, "ZoomOut"), _G.MinimapZoomIn, _G.MinimapZoomOut }) do
            local b = frames.asRegion(v)
            if b then b:SetParent(hidden) end
        end
    end

    -- Into SuuUI's disc, round, at the set size.
    function PlaceMinimap()
        if InCombatLockdown() then self.pendingPlace = true return end
        self.pendingPlace = nil
        local block = self.block
        if not block then return end
        local size = self:Get("size")
        local disc = block.disc
        self.placing = true
        if Minimap:GetParent() ~= disc then Minimap:SetParent(disc) end
        Minimap:ClearAllPoints()
        Minimap:SetPoint("CENTER", disc, "CENTER")
        Minimap:SetScale(1)
        Minimap:SetSize(size, size)
        Minimap:SetMaskTexture(ROUND_MASK)
        if Minimap.SetArchBlobRingScalar then Minimap:SetArchBlobRingScalar(1) end
        if Minimap.SetQuestBlobRingScalar then Minimap:SetQuestBlobRingScalar(1) end
        Minimap:SetFrameLevel(disc:GetFrameLevel() + 1)
        self.placing = nil
        self:StripBlizzard()
        -- a zoom nudge redraws the render at the new size
        local zoom = Minimap:GetZoom()
        Minimap:SetZoom(zoom > 0 and 0 or 1)
        Minimap:SetZoom(zoom)
    end

    function UpdateDifficulty()
        local f = self.block
        if not f then return end
        local _, kind, _, _, maxPlayers = GetInstanceInfo()
        local inside = not isSecret(kind) and (kind == "party" or kind == "raid")
        if inside then
            local size = readable(maxPlayers) and maxPlayers > 0 and tostring(maxPlayers) or "?"
            f.instance:SetValue(instanceLine(kind == "raid" and "Raid" or "Dungeon", size))
        else
            f.instance:SetValue("")
        end
        f:StackZone()
    end

    -- The map put back in the disc whenever something else takes it.
    function GuardParent()
        if self.guarded then return end
        self.guarded = true
        hook(Minimap, "SetParent", function()
            local block = self.block
            if self.placing or not self:IsEnabled() or not block then return end
            if Minimap:GetParent() ~= block.disc then
                after(0, function() if self:IsEnabled() then self:PlaceMinimap() end end)
            end
        end)
    end

    -- Clicks: left pings (passed through), right opens tracking, the wheel zooms.
    function Overlay()
        local disc = assert(self.block).disc
        local o = CreateFrame("Frame", nil, disc)
        o:SetAllPoints()
        o:SetFrameLevel(disc:GetFrameLevel() + 15)
        o:EnableMouse(true)
        -- left clicks (pings) and hovering pass through to the map; these two
        -- are refused in combat, even on SuuUI's own frame (found in game after
        -- a reload in combat): then they wait for its end
        local function passThrough()
            if o.SetPassThroughButtons then o:SetPassThroughButtons("LeftButton") end
            if o.SetPropagateMouseMotion then o:SetPropagateMouseMotion(true) end
        end
        defer(passThrough)
        o:EnableMouseWheel(self:Get("wheelZoom"))
        Minimap:EnableMouseWheel(false)
        o:SetScript("OnMouseWheel", function(_: Frame, delta: number) self:Zoom(delta > 0 and 1 or -1) end)
        o:SetScript("OnMouseUp", function(_: Frame, button: string)
            if button ~= "RightButton" then return end
            local trackingButton = tbl.field(tbl.field(MinimapCluster, "Tracking"), "Button")
            local tracking = frames.asRegion(trackingButton)
            local open = tbl.field(trackingButton, "OpenMenu")
            if tracking and type(open) == "function" then
                tracking:ClearAllPoints()
                tracking:SetPoint("CENTER", o, "CENTER")
                pcall(open :: (b: unknown) -> (), trackingButton)
            end
        end)
        self.overlay = o
    end

    function PreviewView(parent: Frame): MapBlock
        local preview = self.preview
        if not preview then
            local f = MapBlock.new(parent, nil, { jewel = noClick, zoom = function(_: number) end, clock = noClick, mailTip = mailTip })
            -- a stand-in map: the world's dark, a few roads
            local map = f.disc:CreateTexture(nil, "BACKGROUND", nil, 1)
            map:SetTexture(TEX .. "CircleFill.tga")
            map:SetVertexColor(0.11, 0.14, 0.12, 1)
            map:SetAllPoints()
            local you = f.deco.over:CreateTexture(nil, "OVERLAY", nil, 4)
            you:SetTexture("Interface\\Minimap\\MinimapArrow")
            you:SetSize(24, 24)
            you:SetPoint("CENTER")
            f.zone:SetValue("Wailing Caverns")
            f.sub:SetValue("")
            f.time:SetValue("21:40")
            f.deco.mail:Show()
            f.instance:SetValue(instanceLine("Dungeon", "5"))
            preview = f
            self.preview = f
        end
        preview:SetParent(parent)
        preview:Layout(self:Get("size"), self:Get("zone"), self:Get("clock"))
        return preview
    end

    function Relayout()
        local block = self.block
        if block then block:Layout(self:Get("size"), self:Get("zone"), self:Get("clock")) end
        self:PlaceMinimap()
        self:UpdateZone()
        self:UpdateClock()
    end

    -- A theme changed: the "N"'s face, the instance line's colour code, the
    -- clock's line height (the block holds the map: after combat).
    function ApplyTheme()
        local preview = self.preview
        if preview then
            northFace(preview.deco.northText)
            preview.instance:SetValue(instanceLine("Dungeon", "5"))
            local shownIn = preview:IsVisible() and preview:GetParent()
            if shownIn then self:PreviewView(shownIn) end
        end
        local block = self.block
        if not block then return end
        northFace(block.deco.northText)
        self:UpdateDifficulty()
        if InCombatLockdown() then self.pendingTheme = true return end
        self.pendingTheme = nil
        block:Layout(self:Get("size"), self:Get("zone"), self:Get("clock"))
    end

    override function OnEnable()
        if not Minimap then return end
        local block = self.block
        if not block then
            local handlers: Handlers = {
                jewel = function(_: Button, button: string)
                    if button == "RightButton" then SuuUI.EditMode.Enter() else SuuUI.ToggleSettings() end
                end,
                zoom = function(delta: number) self:Zoom(delta) end,
                clock = function(_: Button, button: string)
                    if button == "RightButton" then
                        if ToggleCalendar then ToggleCalendar() end
                    else
                        if not (TimeManagerFrame) then C_AddOns.LoadAddOn("Blizzard_TimeManager") end
                        if ToggleTimeManager then ToggleTimeManager() end
                    end
                end,
                mailTip = mailTip,
            }
            block = MapBlock.new(SuuUI.Root, "SuuUIMinimap", handlers)
            block:SetFrameStrata("LOW")
            block:Layout(self:Get("size"), self:Get("zone"), self:Get("clock"))
            self.block = block
        end
        -- the game's clock code (GameTimeFrame, the calendar) loaded
        if not C_AddOns.IsAddOnLoaded("Blizzard_TimeManager") then pcall(C_AddOns.LoadAddOn, "Blizzard_TimeManager") end
        -- LibDBIcon and others place their buttons by this
        _G.GetMinimapShape = function(): string return "ROUND" end
        self:RegisterMover(block, { key = "position", label = "Minimap" })
        self:RegisterSettings(SECTION)
        -- one frame later: moving it during a panel opening taints map pins
        after(0, function()
            if not self:IsEnabled() then return end
            self:PlaceMinimap()
            self:GuardParent()
            if not self.overlay then self:Overlay() end
        end)
        self:UpdateZone()
        self:UpdateClock()
        self:UpdateMail()
        for _, e in ipairs({ "ZONE_CHANGED", "ZONE_CHANGED_INDOORS", "ZONE_CHANGED_NEW_AREA", "PLAYER_ENTERING_WORLD" }) do
            self:OnGameEvent(e, function() self:UpdateZone() end)
        end
        for _, e in ipairs({ "UPDATE_PENDING_MAIL", "MAIL_CLOSED", "PLAYER_ENTERING_WORLD" }) do
            self:OnGameEvent(e, function() self:UpdateMail() end)
        end
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if self.pendingTheme then self:ApplyTheme() end
            if self.pendingPlace then self:PlaceMinimap() end
        end)
        self:On("SUUUI_THEME_CHANGED", function() self:ApplyTheme() end)
        local valid = C_EventUtils and C_EventUtils.IsEventValid
        for _, e in ipairs({ "PLAYER_ENTERING_WORLD", "ZONE_CHANGED_NEW_AREA", "PLAYER_DIFFICULTY_CHANGED", "GROUP_ROSTER_UPDATE" }) do
            if not valid or valid(e) then self:OnGameEvent(e, function() self:UpdateDifficulty() end) end
        end
        self:UpdateDifficulty()
        self:OnGameEvent("CVAR_UPDATE", function() self:UpdateClock() end)
        if not self.ticker then
            self.ticker = every(10, function() if self:IsEnabled() then self:UpdateClock() end end)
        end
        self:WatchAll({ "size", "zone", "clock" }, function()
            self:Relayout()
            local preview = self.preview
            local shownIn = preview and preview:IsVisible() and preview:GetParent()
            if shownIn then self:PreviewView(shownIn) end
        end)
        self:Watch("wheelZoom", function()
            local overlay = self.overlay
            if overlay then overlay:EnableMouseWheel(self:Get("wheelZoom")) end
        end)
    end
end

M = SuuUI.AddModule(MinimapModule.new())
