-- Units/Professions/RecipeLabel.wowlua
-- What the recipe list shows for a recipe's name. Every enchanting recipe
-- starts with "Enchant " ("Enchant 2H Weapon - Greater Impact"), which the
-- list's narrow rows would spend on the same word each time and then cut
-- off the enchant itself; the list leaves it out. The full name stays the
-- recipe's: search, sorting and the recipe's page use it.

export const ENCHANTING = 333 -- the skill line

-- The list's label for a recipe of a skill line, or nil when it is the name
-- itself (other professions; a name that doesn't start with the prefix).
export function recipeLabel(skillLine: number?, name: string?): string?
    if skillLine ~= ENCHANTING or not name then
        return nil
    end
    return (name:match("^Enchant (.+)$"))
end
