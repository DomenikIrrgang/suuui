-- Units/RaidPlanner.wowlua
-- The raid planner (asked 2026-10-19, design "Raid planner", A1 "Workbench"):
-- a setup is a saved raid layout made of slots, each asking for a class (or
-- any), maybe a spec and a role, in one of the eight groups. Load a setup and
-- the people in the raid fill their slots by themselves, out of combat,
-- whenever the raid changes; a player placed by hand stays (pinned). What
-- doesn't fit shows as open slots and players without a slot. Arrange
-- groups moves the real raid into the slots' groups (the leader or an
-- assistant, out of combat). Coverage: raid-wide (counted once) and
-- party-wide (per group of five), only what Settings › Raid planner tracks
-- (the catalog: SuuUI.RaidCatalog(), Data/RaidPlanner.lua).
-- Opens from Social › Raid › Plan and /suu raid.
--
-- Probed on Forever (/suu probe raid, 2026-10-19): the roster reads out of
-- combat (GetRaidRosterInfo, 12 values); SetRaidSubgroup and SwapRaidSubgroup
-- work for the leader from a click or a command, the roster update follows
-- 0.4-0.7 s later, three moves in one frame all land, a full group needs a
-- swap; an inspect answers in about half a second with the talent groups'
-- points (the spec). Specs: from an inspect (one player at a time, out of
-- combat), or from a raid member's own SuuUI (addon message, prefix "SuuUI":
-- "RPSPEC\t<tree>", "RPSPECQ" asks everyone). Until known a player fills
-- provisionally, spec "?" (shown with their class's icon, not a spec's).
-- Setups are account-wide (SuuUI.AccountData); what's tracked follows the
-- profile. A built-in module written against the public API only.
--
-- This file is the module: its state, its methods (each one calls the part
-- that does the work, with the module), its lifecycle and migration. The
-- parts, in Units/RaidPlanner/:
--   Catalog   the catalog (classes, items, families) and the rules of roles
--   Setups    the setups and their saved data, the slots
--   Text      a setup shared as text, the Export and Import dialogs
--   Fill      the raid read, and filled into the slots
--   Specs     specs: known, inspected, the addon messages; the trees' icons
--   Coverage  raid-wide and party-wide coverage
--   Arrange   Arrange groups: the moves, run as raid moves
--   View      what the window shows (its data), and drawing it
--   Window    the window, the slot editor and the menus
--   Settings  Settings › Raid planner, what's tracked

import SuuUI, Module from "/Core/API"
import type SettingsSection, RaidPlanner as PlannerWindow, PlannerData, PlannerId, PlannerArt, PlannerListItem, PlannerChip, PlannerMove, DragWhat, DropWhere, SlotChanges from "/Core/API"
import type RaidItem from "/Data/RaidPlanner"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import after from "wowlua:timer"
import loadCatalog from "/Units/RaidPlanner/Catalog"
import * as Setups from "/Units/RaidPlanner/Setups"
import type Slot, Setup, Store, Requirement from "/Units/RaidPlanner/Setups"
import * as Text from "/Units/RaidPlanner/Text"
import * as Fill from "/Units/RaidPlanner/Fill"
import inRaidNow from "/Units/RaidPlanner/Fill"
import type Member, Filled from "/Units/RaidPlanner/Fill"
import * as Specs from "/Units/RaidPlanner/Specs"
import SPEC_FRESH from "/Units/RaidPlanner/Specs"
import type InspectJob from "/Units/RaidPlanner/Specs"
import * as Coverage from "/Units/RaidPlanner/Coverage"
import type Person, ItemCount from "/Units/RaidPlanner/Coverage"
import * as Arrange from "/Units/RaidPlanner/Arrange"
import * as View from "/Units/RaidPlanner/View"
import * as Window from "/Units/RaidPlanner/Window"
import * as Settings from "/Units/RaidPlanner/Settings"

-- A family's items as checkboxes (Settings › Raid planner).
export type FamilyChecks = Settings.FamilyChecks

local RAID_PLANNER = SuuUI.Services.RAID_PLANNER

local try, field = errors.try, tbl.field

local DEFAULTS = {
    preset = "essentials", -- "all" | "essentials" | "custom"
    tracked = {} :: { [string]: boolean }, -- custom: { [item key] = true }
    fill = "instant", -- "instant" (as the raid changes) | "review" (Fill slots)
    inspect = "auto", -- "auto" (while the planner is open) | "click"
    flagDoubled = true,
    shareSpec = true,
}

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

export class RaidPlannerModule extends Module<typeof(DEFAULTS)>
    window: PlannerWindow? = nil
    -- the raid as last read (out of combat), by key, you in it
    roster: Member[] = {}
    byKey: { [string]: Member } = {}
    me: Member? = nil
    inRaid: boolean = false
    wasInRaid: boolean = false
    -- the slots filled; players let go by hand (no slot for them)
    fill: Filled? = nil
    letGo: { [string]: boolean } = {}
    -- the tracked set while the window is drawn
    trackCache: { [string]: boolean }? = nil
    refillQueued: boolean = false
    retryQueued: boolean = false
    shareQueued: boolean = false
    -- inspecting: the one asked, the Inspect button's round, who failed when
    inspecting: InspectJob? = nil
    inspectRound: boolean = false
    inspectFailed: { [string]: number } = {}
    askedAt: number? = nil
    ownIconsRead: boolean = false

    constructor()
        super({
            id = "raidplanner",
            name = "Raid planner",
            description = "Plan raids as setups of slots: the raid fills them, Arrange groups moves everyone, and coverage shows the buffs, debuffs and dispels you track.",
            api = "0.17",
            combatSafe = true,
            defaults = DEFAULTS,
        })
    end

    ----------------------------------------------------------------------------
    -- What's tracked
    ----------------------------------------------------------------------------

    function TrackedSet(): { [string]: boolean }
        return Settings.trackedSet(self)
    end

    function IsTracked(itemKey: string): boolean
        return Settings.isTracked(self, itemKey)
    end

    function SetTrackedSet(set: { [string]: boolean })
        Settings.setTrackedSet(self, set)
    end

    function SetTracked(itemKey: string, on: boolean)
        Settings.setTracked(self, itemKey, on)
    end

    function TrackedCount(): number
        return Settings.trackedCount(self)
    end

    ----------------------------------------------------------------------------
    -- Setups
    ----------------------------------------------------------------------------

    function Data(): Store
        return Setups.data()
    end

    function Work(): Setup
        return Setups.currentWork(self)
    end

    function UniqueName(base: string): string
        return Setups.uniqueName(self, base)
    end

    function Changed(): boolean
        return Setups.changed(self)
    end

    function SlotById(id: PlannerId?): Slot?
        return Setups.slotById(self, id)
    end

    function SlotsIn(g: number): Slot[]
        return Setups.slotsIn(self, g)
    end

    function SlotsInOf(w: Setup, g: number): Slot[]
        return Setups.slotsInOf(w, g)
    end

    function Load(id: PlannerId)
        Setups.loadSetup(self, id)
    end

    function Save()
        Setups.save(self)
    end

    function SaveAsNew()
        Setups.saveAsNew(self)
    end

    function AddSetup(s: Setup)
        Setups.addSetup(self, s)
    end

    function Duplicate(id: PlannerId?)
        Setups.duplicate(self, id)
    end

    function Delete(id: PlannerId?)
        Setups.delete(self, id)
    end

    function Rename(id: PlannerId, name: string?)
        Setups.rename(self, id, name)
    end

    function New(fromRaid: boolean)
        Setups.create(self, fromRaid)
    end

    ----------------------------------------------------------------------------
    -- Sharing as text
    ----------------------------------------------------------------------------

    function ExportText(setup: Setup): string
        return Text.exportText(setup)
    end

    function ImportText(text: string?): (Setup?, string?)
        return Text.importText(self, text)
    end

    function Export(id: PlannerId?)
        Text.exportDialog(self, id)
    end

    function Import()
        Text.importDialog(self)
    end

    ----------------------------------------------------------------------------
    -- Slots
    ----------------------------------------------------------------------------

    function AddSlot(g: number, req: Requirement?, pin: string?): Slot?
        return Setups.addSlot(self, g, req, pin)
    end

    function RemoveSlot(id: PlannerId)
        Setups.removeSlot(self, id)
    end

    function Unpin(name: string)
        Setups.unpin(self, name)
    end

    function SetRequirement(s: Slot, req: Requirement)
        Setups.setRequirement(self, s, req)
    end

    function ChangeSlot(id: PlannerId, changes: SlotChanges)
        Setups.changeSlot(self, id, changes)
    end

    function Drop(what: DragWhat, where: DropWhere)
        Setups.drop(self, what, where)
    end

    ----------------------------------------------------------------------------
    -- The raid
    ----------------------------------------------------------------------------

    function KnownTree(name: string, you: boolean): number?
        return Specs.knownTree(self, name, you)
    end

    function ReadRoster(): Member[]
        return Fill.readRoster(self)
    end

    function RunFill(keepOnly: boolean)
        Fill.runFill(self, keepOnly)
    end

    function Refill(force: boolean?)
        Fill.refill(self, force)
    end

    function RefillSoon()
        Fill.refillSoon(self)
    end

    ----------------------------------------------------------------------------
    -- Spec icons
    ----------------------------------------------------------------------------

    function TreeIcon(class: string?, tree: number?): PlannerArt?
        return Specs.treeIcon(self, class, tree)
    end

    function NoteTreeIcons(class: string, displays: unknown)
        Specs.noteTreeIcons(self, class, displays)
    end

    function NoteOwnTreeIcons()
        Specs.noteOwnTreeIcons(self)
    end

    ----------------------------------------------------------------------------
    -- Specs: inspecting, one player at a time
    ----------------------------------------------------------------------------

    function InspectedTree(unit: string, class: string): number?
        return Specs.inspectedTree(self, unit, class)
    end

    function NoteSpec(name: string, tree: number?, from: string)
        Specs.noteSpec(self, name, tree, from)
    end

    function SpecQueue(): Member[]
        return Specs.specQueue(self)
    end

    function UnknownSpecs(): number
        return Specs.unknownSpecs(self)
    end

    function InspectNext()
        Specs.inspectNext(self)
    end

    function OnInspectReady(guid: unknown)
        Specs.onInspectReady(self, guid)
    end

    ----------------------------------------------------------------------------
    -- Specs from raid members' own SuuUI
    ----------------------------------------------------------------------------

    function Send(verb: string, payload: string?)
        Specs.send(self, verb, payload)
    end

    function ShareSpec()
        Specs.shareSpec(self)
    end

    function ShareSoon(delay: number?)
        Specs.shareSoon(self, delay)
    end

    function AskSpecs()
        Specs.askSpecs(self)
    end

    function OnSpec(payload: string, sender: string)
        Specs.onSpec(self, payload, sender)
    end

    ----------------------------------------------------------------------------
    -- Coverage
    ----------------------------------------------------------------------------

    function People(): (Person[], Person[], boolean)
        return Coverage.countedPeople(self)
    end

    function RaidItem(item: RaidItem, people: Person[], open: Person[]): ItemCount
        return Coverage.raidItem(item, people, open)
    end

    function RaidWide(people: Person[], open: Person[]): PlannerListItem[]
        return Coverage.raidWide(self, people, open)
    end

    function PartyChips(g: number, people: Person[], open: Person[]): PlannerChip[]
        return Coverage.partyChips(self, g, people, open)
    end

    ----------------------------------------------------------------------------
    -- What the window shows
    ----------------------------------------------------------------------------

    function CanArrange(): (boolean, string?)
        return Arrange.canArrange(self)
    end

    function Moves(): PlannerMove[]
        return Arrange.moves(self)
    end

    function ViewData(): PlannerData
        return View.viewData(self)
    end

    function Render()
        View.render(self)
    end

    ----------------------------------------------------------------------------
    -- The slot editor and the menus
    ----------------------------------------------------------------------------

    function OpenEditor(id: PlannerId, card: Frame?)
        Window.openEditor(self, id, card)
    end

    function SlotMenu(id: PlannerId, owner: Frame)
        Window.slotMenu(self, id, owner)
    end

    function SetupMenu(id: PlannerId, owner: Frame)
        Window.setupMenu(self, id, owner)
    end

    function NewMenu(owner: Frame)
        Window.newMenu(self, owner)
    end

    function PersonMenu(name: string, owner: Frame)
        Window.personMenu(self, name, owner)
    end

    ----------------------------------------------------------------------------
    -- Arrange groups
    ----------------------------------------------------------------------------

    function Arrange()
        Arrange.arrange(self)
    end

    function RunMoves(round: number)
        Arrange.runMoves(self, round)
    end

    ----------------------------------------------------------------------------
    -- The window
    ----------------------------------------------------------------------------

    function Build(): PlannerWindow
        return Window.build(self)
    end

    function Toggle()
        Window.toggle(self)
    end

    ----------------------------------------------------------------------------
    -- Settings › Raid planner
    ----------------------------------------------------------------------------

    function FamilyCounts(family: string): (number, number)
        return Settings.familyCounts(self, family)
    end

    function FamilyIsDefault(family: string): boolean
        return Settings.familyIsDefault(self, family)
    end

    function ResetFamily(family: string)
        Settings.resetFamily(self, family)
    end

    function Section(): SettingsSection
        return Settings.section(self)
    end

    ----------------------------------------------------------------------------
    -- Lifecycle
    ----------------------------------------------------------------------------

    override function OnEnable()
        loadCatalog()
        -- specs older than a day are forgotten (a respec)
        local specs = self:Data().specs
        for k, e in pairs(specs) do
            local raw: unknown = e
            if type(raw) ~= "table" or time() - (e.at or 0) > SPEC_FRESH then
                specs[k] = nil
            end
        end
        self:RegisterSettings(self:Section())
        self:ProvideService(RAID_PLANNER, {
            Toggle = function()
                self:Toggle()
            end,
            Show = function()
                (self.window or self:Build()):Show()
            end,
            IsShown = function(): boolean
                local window = self.window
                return window ~= nil and window:IsShown()
            end,
        })
        self:RegisterCommand("raid", "The raid planner: setups of slots the raid fills, and Arrange groups.", function()
            self:Toggle()
        end)
        -- specs from the raid's SuuUI: the raid's channel only; a question
        -- answered at most once per 30 s, whoever asks (as asking is held)
        self:OnAddonMessage("RPSPECQ", { channels = { "RAID" }, replyEvery = 30 }, function()
            self:ShareSoon()
        end)
        self:OnAddonMessage("RPSPEC", { channels = { "RAID" }, rate = { count = 5, seconds = 10 } }, function(
            payload,
            sender
        )
            self:OnSpec(payload, sender)
        end)
        local valid = field(C_EventUtils, "IsEventValid")
        local function known(event: string): boolean
            return not valid or secret.flag(try(valid, event))
        end
        self.wasInRaid = inRaidNow()
        if known("GROUP_ROSTER_UPDATE") then
            self:OnGameEvent("GROUP_ROSTER_UPDATE", function()
                self:RefillSoon()
                local inRaid = inRaidNow()
                -- your spec to the raid once, as you join (later only when asked)
                if inRaid and not self.wasInRaid then
                    self:ShareSoon(3)
                end
                self.wasInRaid = inRaid
                local window = self.window
                if inRaid and window and window:IsShown() then
                    after(1, function()
                        if self:IsEnabled() then
                            self:AskSpecs()
                            self:InspectNext()
                        end
                    end)
                end
            end)
        end
        if known("PLAYER_ROLES_ASSIGNED") then
            self:OnGameEvent("PLAYER_ROLES_ASSIGNED", function()
                self:RefillSoon()
            end)
        end
        if known("PARTY_LEADER_CHANGED") then
            self:OnGameEvent("PARTY_LEADER_CHANGED", function()
                self:RefillSoon()
            end)
        end
        if known("UNIT_CONNECTION") then
            self:OnGameEvent("UNIT_CONNECTION", function()
                self:RefillSoon()
            end)
        end
        if known("INSPECT_READY") then
            self:OnGameEvent("INSPECT_READY", function(_, guid)
                self:OnInspectReady(guid)
            end)
        end
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            self:Render()
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            after(1, function()
                if not self:IsEnabled() then
                    return
                end
                self:Render()
                self:InspectNext()
            end)
        end)
        self:On("SUUUI_SPEC_CHANGED", function()
            self:ShareSoon()
            self:RefillSoon()
        end)
        -- tracking, fill mode and doubled flags: drawn again
        self:WatchAll({ "preset", "tracked", "flagDoubled" }, function()
            self:Render()
        end)
        self:Watch("fill", function()
            self:Refill(true)
        end)
        self:Watch("inspect", function()
            self:InspectNext()
            self:Render()
        end)
        self:Watch("shareSpec", function(share)
            if share then
                self:ShareSoon()
            end
        end)
        self:Refill()
    end

    override function OnDisable()
        if self.window then
            self.window:Hide()
        end
        self.inspecting, self.inspectRound = nil, false
    end
end

local M: RaidPlannerModule = SuuUI.AddModule(RaidPlannerModule.new())

-- Strength of Earth and Grace of Air were one item ("earth"); Grace of Air
-- is its own now, tracked wherever the pair was
M:Migrate("graceOfAir", function(values)
    local t: unknown = values.tracked
    if type(t) == "table" then
        local set = t :: unknown :: { [string]: boolean? }
        if set.earth and set.graceOfAir == nil then
            set.graceOfAir = true
        end
    end
end)
