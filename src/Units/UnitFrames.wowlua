--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

class UnitFramesModule extends Module<typeof(DEFAULTS)>
    frames: Frames? = nil
    -- every unit frame (the single ones and the bosses), by key
    allFrames: { [string]: UnitFrame } = {}
    bosses: UnitFrame[] = {}
    bossHolder: Frame? = nil
    combo: ComboPips? = nil
    restedSign: RestedSign? = nil
    previewView: UnitFramesPreview? = nil
    inCombat: boolean = false
    -- frames whose meta is the level (the setting turns it off)
    levelMeta: { [UnitFrame]: boolean } = {}
    -- frames at a secret alpha (it can't be faded from)
    secretAlpha: { [UnitFrame]: boolean } = {}

    constructor()
        super({
            id = "unitframes",
            name = "Unit frames",
            description = "Player, target, target of target, focus, pet and boss frames: the bar is the frame.",
            api = "0.5",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- A single frame by its key.
    function FrameOf(key: string): UnitFrame
        return assert(self.allFrames[key])
    end

    -- Out of combat and not hovered, the frames rest (at full health only).
    -- Boss frames exist only in encounters and never fade.
    function UpdateFade()
        local hovered = false
        for _, d in ipairs(FRAMES) do
            local f = self:FrameOf(d.key)
            if f:IsVisible() and f:IsMouseOver() then
                hovered = true
            end
        end
        local resting = self:Get("fadeOutOfCombat") and not secret.flag(UnitAffectingCombat("player")) and not hovered
        local alpha = resting and restingAlpha() or 1
        for _, d in ipairs(FRAMES) do
            local f = self:FrameOf(d.key)
            if isSecret(alpha) then
                -- (a running fade would set its own alpha over it)
                Motion.Stop(f)
                f:SetAlpha(alpha)
                self.secretAlpha[f] = true
            elseif self.secretAlpha[f] then
                -- a secret alpha can't be faded from: at once
                self.secretAlpha[f] = nil
                Motion.Stop(f)
                f:SetAlpha(alpha)
            else
                Motion.AlphaTo(f, alpha, T.duration["dur-slow"])
            end
        end
    end

    -- Danger: a non-tank holding aggro in a group. Solo, everyone tanks their own.
    function UpdateThreat()
        local status = UnitThreatSituation("player")
        local role = UnitGroupRolesAssigned and UnitGroupRolesAssigned("player")
        -- issecretvalue first: a truth test on a secret value would error.
        local danger = secret.flag(IsInGroup()) and not issecretvalue(status) and status ~= nil and status >= 2 and
            not (not issecretvalue(role) and role == "TANK")
        self:FrameOf("player"):SetState(danger and "danger" or nil, danger and "Aggro" or nil)
    end

    -- The sign's look now ("earn", "rest", "full", "carry" or nil, as
    -- UI.RestedSign takes it); `anyCombat` leaves Hide in combat out.
    function RestedLook(anyCombat: boolean?): string?
        if not self:Get("restedSign") then
            return nil
        end
        local capped = noXP()
        if capped and self:Get("restedHideMax") then
            return nil
        end
        if not anyCombat and self:Get("restedHideCombat") and self.inCombat then
            return nil
        end
        local pool, _, full = restedPool()
        if IsResting() then
            if capped then
                return "rest"
            end
            return full and "full" or "earn"
        end
        if not capped and pool > 0 and self:Get("restedShow") == "carrying" then
            return "carry"
        end
        return nil
    end

    -- `fade`: the seconds a change takes (nil: at once). In edit mode the sign
    -- stands still wherever it could show, so you see where it sits.
    function UpdateRested(fade: number?)
        local sign = self.restedSign
        if not sign then
            return
        end
        local look, still = self:RestedLook(), self:Get("restedAnimation") == "still"
        if SuuUI.EditMode.IsActive() then
            local can = self:Get("restedSign") and not (self:Get("restedHideMax") and noXP())
            look, still = can and (self:RestedLook(true) or "rest") or nil, true
        end
        sign:SetLook(look, { still = still, fade = fade })
    end

    -- Your frame's tooltip: the rested lines after the unit's, while the sign shows.
    function AddRestedLines(tooltip: GameTooltip)
        local look = self:RestedLook()
        if not look then
            return
        end
        local ink, muted, fill = { UI.RGBA("ink") }, { UI.RGBA("ink-muted") }, { UI.RGBA("progress-fill") }
        local function line(text: string, c: number[])
            tooltip:AddLine(text, c[1], c[2], c[3])
        end
        tooltip:AddLine(" ")
        line(tooltipIcon(look == "full") .. (look == "carry" and "Rested" or "Resting"), ink)
        if look ~= "rest" then
            local pool, share = restedPool()
            local amount = BreakUpLargeNumbers and BreakUpLargeNumbers(pool) or tostring(pool)
            tooltip:AddDoubleLine(
                "Rested XP",
                ("%s · %d%% of a level"):format(amount, math.floor(share * 100 + 0.5)),
                ink[1],
                ink[2],
                ink[3],
                muted[1],
                muted[2],
                muted[3]
            )
        end
        if look == "earn" then
            line("Earning rested XP", muted)
        elseif look == "full" then
            line("Rested XP full", fill)
            line("Resting longer adds nothing.", muted)
        elseif look == "carry" then
            line("Kills give double XP until it's spent.", muted)
            line("Rest in an inn or a city to earn more.", muted)
        end
        if look ~= "carry" then
            line("Logging out here is instant.", muted)
        end
    end

    function PreviewView(parent: Frame): UnitFramesPreview
        local v = self.previewView or UnitFramesPreview.new(parent, self)
        self.previewView = v
        v:SetParent(parent)
        self:DrawPreview()
        return v
    end

    function DrawPreview()
        local v = self.previewView
        if not v then
            return
        end
        local f = v.frame
        local w, h = self:Get("width"), self:Get("height")
        f.opts.power = self:Get("showPower")
        f.opts.healthText = self:Get("healthText")
        f.opts.nameColor = self:Get("nameColor")
        f:Resize(w, h)
        f:Refresh()
        -- centred with room for the sign on both sides; where the column is too
        -- narrow for that, the frame's left end gives way, never the sign
        local want = w + 2 * SIGN_REACH
        local parent = v:GetParent()
        local room = parent and parent:GetWidth()
        local width = (room and room >= 1) and math.min(want, room) or want
        v:SetSize(width, h + 2 * SIGN_RISE)
        f:ClearAllPoints()
        if width >= want then
            f:SetPoint("CENTER", v, "CENTER", 0, 0)
        else
            f:SetPoint("RIGHT", v, "RIGHT", -SIGN_REACH, 0)
        end
        local reason: string? = nil
        if not self:Get("restedSign") then
            reason = "The rested sign is off."
        elseif self:Get("restedHideMax") and noXP() then
            reason = "Hidden at the level cap: there is no XP to rest for."
        end
        f:SetAlpha(reason and T.opacity["opacity-disabled"] or 1)
        v.reason:SetWidth(width)
        v.reason:ClearAllPoints()
        v.reason:SetPoint("TOP", v, "TOP", 0, -(SIGN_RISE + h + S["space-5"]))
        v.reason:SetValue(reason or "")
        v.sign:SetLook("earn", { still = self:Get("restedAnimation") == "still" })
    end

    function UpdateVisibility()
        for _, d in ipairs(FRAMES) do
            if d.watch then
                local pos = self:Get(d.position)
                local show = d.show
                follow(self, self:FrameOf(d.key), not pos.hidden and (not show or self:Get(show)))
            end
        end
        local bossOn = self:Get("showBoss") and not self:Get("bossPosition").hidden
        for i = 1, BOSSES do
            follow(self, assert(self.bosses[i]), bossOn)
        end
    end

    function ApplyOptions()
        for _, f in pairs(self.allFrames) do
            f.opts.power = (f.opts.size ~= "sm") and self:Get("showPower")
            f.opts.healthText = self:Get("healthText")
            f.opts.nameColor = self:Get("nameColor")
            f.opts.raidMarker = self:Get("raidMarkers")
            if self.levelMeta[f] then
                f.opts.meta = self:Get("showMeta")
            end
            if f.opts.crest then
                f.opts.dragon = self:Get("eliteDragon")
            end
            if f.active then
                f:Refresh()
            end
        end
        local combo = self.combo
        if combo then
            combo:Update()
        end
        self:UpdateFade()
        self:DrawPreview()
    end

    -- The player and target frames' size, out of combat (secure buttons). The
    -- combo points, auras and edit-mode outlines hang off the frames and follow.
    function ApplySize()
        self:RunOutOfCombat("size", function()
            local w, h = self:Get("width"), self:Get("height")
            for _, key in ipairs({ "player", "target" }) do
                self:FrameOf(key):Resize(w, h)
            end
            SuuUI.EditMode.Refresh()
            self:DrawPreview()
        end)
    end

    function Build(): Frames
        local made: { [string]: UnitFrame } = {}
        for _, d in ipairs(FRAMES) do
            local f = UI.UnitFrame(SuuUI.Root, d.unit, d.opts)
            SuuUI.TagInstance(f, { module = self.id, role = d.key })
            if d.opts.meta == true then
                self.levelMeta[f] = true
            end
            made[d.key] = f
            self.allFrames[d.key] = f
        end
        local frames: Frames = {
            player = assert(made.player),
            target = assert(made.target),
            tot = assert(made.tot),
            focus = assert(made.focus),
            pet = assert(made.pet),
        }
        self.frames = frames
        -- The boss stack: one holder, moved as one in edit mode.
        local holder = CreateFrame("Frame", "SuuUIBossFrames", SuuUI.Root)
        local w, h = UI.Size("bar-md"), UI.Size("unit-md")
        -- each boss leaves room under its bar for its cast (space-1, cast-sm)
        local pitch = h + S["space-1"] + UI.Size("cast-sm") + S["space-5"]
        holder:SetSize(w, BOSSES * pitch - S["space-5"])
        self.bossHolder, self.bosses = holder, {}
        for i = 1, BOSSES do
            local f = UI.UnitFrame(holder, "boss" .. i, {
                size = "md",
                meta = true,
                name = "SuuUIBoss" .. i .. "Frame",
            })
            self.levelMeta[f] = true
            SuuUI.TagInstance(f, { module = self.id, role = "boss" })
            f:SetPoint("TOPRIGHT", holder, "TOPRIGHT", 0, -(i - 1) * pitch)
            self.bosses[i] = f
            self.allFrames["boss" .. i] = f
        end
        self.combo = ComboPips.new(frames.target)
        self.restedSign = UI.RestedSign(frames.player)
        return frames
    end

    override function OnEnable()
        standDownBlizzard()
        local frames = self.frames or self:Build()
        local holder, combo = assert(self.bossHolder), assert(self.combo)

        frames.player:Show()
        for _, f in pairs(self.allFrames) do
            f:Activate()
        end
        -- A frame turned off in the settings gets no mover in edit mode;
        -- the ones that follow their unit are shown by it (managedShow).
        for _, d in ipairs(FRAMES) do
            local show = d.show
            self:RegisterMover(self:FrameOf(d.key), {
                key = d.position,
                label = d.label,
                managedShow = d.watch or nil,
                enabled = show and
                    function()
                        return self:Get(show)
                    end or
                    nil,
            })
            if show then
                self:Watch(show, SuuUI.EditMode.Refresh)
            end
        end
        self:RegisterMover(holder, {
            key = "bossPosition",
            label = "Boss frames",
            managedShow = true,
            enabled = function()
                return self:Get("showBoss")
            end,
        })
        self:Watch("showBoss", SuuUI.EditMode.Refresh)
        -- Published, so other modules (cast bars, auras) and plugins can attach to them.
        for _, d in ipairs(FRAMES) do
            SuuUI.PublishAnchor(d.unit, self:FrameOf(d.key))
        end
        for i = 1, BOSSES do
            SuuUI.PublishAnchor("boss" .. i, self.bosses[i])
        end
        self:RegisterSettings(SECTION)
        self:UpdateVisibility()
        self:ApplySize()
        self:ApplyOptions()

        local player = frames.player
        player.onHealth = function()
            self:UpdateFade()
        end
        for _, e in ipairs({ "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED" }) do
            self:OnGameEvent(e, function()
                self:UpdateFade()
            end)
        end
        for _, d in ipairs(FRAMES) do
            local f = self:FrameOf(d.key)
            f:HookScript("OnEnter", function()
                self:UpdateFade()
            end)
            f:HookScript("OnLeave", function()
                self:UpdateFade()
            end)
        end

        self:OnUnitEvent("UNIT_THREAT_SITUATION_UPDATE", "player", function()
            self:UpdateThreat()
        end)
        self:OnGameEvent("GROUP_ROSTER_UPDATE", function()
            self:UpdateThreat()
        end)
        self:OnUnitEvent("UNIT_POWER_UPDATE", "player", function()
            combo:Update()
        end)
        self:OnUnitEvent("UNIT_DISPLAYPOWER", "player", function()
            combo:Update()
        end)
        self:OnGameEvent("PLAYER_TARGET_CHANGED", function()
            combo:Update()
        end)

        self:WatchAll({
            "fadeOutOfCombat",
            "showPower",
            "healthText",
            "nameColor",
            "showMeta",
            "eliteDragon",
            "raidMarkers",
            "comboPoints",
        }, function()
            self:ApplyOptions()
        end)
        self:WatchAll({
            "showToT",
            "showFocus",
            "showPet",
            "showBoss",
            "targetPosition",
            "totPosition",
            "focusPosition",
            "petPosition",
            "bossPosition",
        }, function()
            self:UpdateVisibility()
        end)
        self:WatchAll({ "width", "height" }, function()
            self:ApplySize()
        end)
        self:UpdateThreat()
        self:RunOutOfCombat("debuffBadges", function()
            player:SetDispelBadges(self:Get("debuffBadges"))
        end)
        self:Watch("debuffBadges", function()
            self:RunOutOfCombat("debuffBadges", function()
                player:SetDispelBadges(self:Get("debuffBadges"))
            end)
        end)

        -- rested: the sign and the tooltip's lines
        local base, fast = T.duration["dur-base"], T.duration["dur-fast"]
        self.inCombat = InCombatLockdown() or secret.flag(UnitAffectingCombat("player"))
        player.onTooltip = self:Guard(function(_: UnitFrame, tooltip: GameTooltip)
            self:AddRestedLines(tooltip)
        end)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            self.inCombat = true
            self:UpdateRested(fast)
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self.inCombat = false
            self:UpdateRested(base)
        end)
        for _, e in ipairs({
            "PLAYER_UPDATE_RESTING",
            "UPDATE_EXHAUSTION",
            "PLAYER_XP_UPDATE",
            "PLAYER_LEVEL_UP",
            "PLAYER_ENTERING_WORLD",
        }) do
            self:OnGameEvent(e, function()
                self:UpdateRested(base)
            end)
        end
        self:On("SUUUI_EDITMODE_CHANGED", function()
            self:UpdateRested()
        end)
        self:On("SUUUI_SETTING_CHANGED", function(_, namespace, key)
            if namespace == "ui" and key == "reducedMotion" then
                self:UpdateRested()
                self:DrawPreview()
            end
        end)
        self:WatchAll({ "restedSign", "restedShow", "restedAnimation", "restedHideCombat", "restedHideMax" }, function()
            self:UpdateRested(base)
            self:DrawPreview()
        end)
        self:UpdateRested()
    end

    override function OnDisable()
        -- Only reached when the module errors: the module toggles on reload.
        local frames = self.frames
        if frames then
            -- Withdraw the anchors, so nothing stays attached to frames that are gone.
            for _, d in ipairs(FRAMES) do
                SuuUI.PublishAnchor(d.unit, nil)
            end
            for i = 1, BOSSES do
                SuuUI.PublishAnchor("boss" .. i, nil)
            end
            local sign = self.restedSign
            if sign then
                sign:SetLook(nil)
            end
            frames.player.onTooltip = nil
            for _, f in pairs(self.allFrames) do
                f:Deactivate()
                UnregisterUnitWatch(f)
                f:Hide()
            end
        end
    end
end

M = SuuUI.AddModule(UnitFramesModule.new())
