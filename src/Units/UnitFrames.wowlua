}

local BOSSES = 5

-- The single frames, by their key.
type Frames = { player: UnitFrame, target: UnitFrame, tot: UnitFrame, focus: UnitFrame, pet: UnitFrame }

--------------------------------------------------------------------------------
-- Blizzard's frames
--------------------------------------------------------------------------------

local function standDownBlizzard()
    SuuUI.SuppressBlizzard("PlayerFrame", { children = children({ "powerBarAlt", "PowerBarAlt" }) })
    -- Blizzard's target of target is left alone while ours is off; it is a
    -- child of the target frame, though, which stays stood down, so it
    -- hides with it (the setting's description says so)
    local targetChildren = { "spellbar", "castBar", "BuffFrame", "AurasFrame", "DebuffFrame", "CcRemoverFrame" }
    if M:Get("showToT") then
        targetChildren[#targetChildren + 1] = "totFrame"
        SuuUI.SuppressBlizzard("TargetFrameToT", { keepParent = true })
    end
    SuuUI.SuppressBlizzard("TargetFrame", { children = children(targetChildren) })
    SuuUI.SuppressBlizzard("ComboFrame", { keepParent = true })
    if M:Get("showFocus") then
        SuuUI.SuppressBlizzard("FocusFrame", {
            children = children({ "spellbar", "castBar", "BuffFrame", "AurasFrame", "totFrame" }),
        })
    end
    if M:Get("showPet") then
        SuuUI.SuppressBlizzard("PetFrame", { children = children() })
    end
    if M:Get("showBoss") then
        SuuUI.SuppressBlizzard("BossTargetFrameContainer")
        for i = 1, BOSSES do
            SuuUI.SuppressBlizzard("Boss" .. i .. "TargetFrame", {
                children = children({ "spellbar", "castBar", "BuffFrame", "AurasFrame" }),
            })
        end
    end
end

-- A curve's answer as an amount: a number (the curves here give numbers),
-- or the secret it is. A colour (never, with these curves) is 0.
type CurveResult = LuaCurveEvaluatedResult | Secret<LuaCurveEvaluatedResult> | nil
local function curveAmount(r: CurveResult): number | Secret<number>
    if isSecret(r) then
        return r :: Secret<number>
    end
    return type(r) == "number" and r or 0
end

--------------------------------------------------------------------------------
-- Combo points: five diamonds over the target frame's right end. Forever's
-- combo points belong to the target, and Blizzard's own display sits on its
-- TargetFrame, so SuuUI draws them. (Not in the design yet.)
--------------------------------------------------------------------------------

local function comboClass(): boolean
    local _, cls = UnitClass("player")
    local class = cls :: string? -- your own class reads plain (compared unguarded, as before)
    if class == "ROGUE" then
        return true
    end
    if class == "DRUID" then
        local _, token = UnitPowerType("player")
        return token == "ENERGY"
    end
    return false
end

-- Step curves: pip i is lit from i points up (UnitPowerPercent's 0-1 input).
local pipCurves: { [number]: LuaCurveObject } = {}
local function pipCurve(i: number): LuaCurveObject
    local c = pipCurves[i]
    if not c then
        c = C_CurveUtil.CreateCurve()
        c:SetType(Enum.LuaCurveType.Step)
        c:AddPoint(0, 0)
        c:AddPoint((i - 0.5) / 5, 1)
        pipCurves[i] = c
    end
    return c
end

-- A combo point: its outline, its hole and its light.
type Pip = { outer: Texture, inner: Texture, lit: Texture }

export class ComboPips extends Frame
    readonly pips: Pip[] = {}

    constructor(target: Frame)
        super(nil, target)
        self:SetSize(5 * 12, 12)
        self:SetPoint("BOTTOMRIGHT", target, "TOPRIGHT", -2, S["space-3"])
        for i = 1, 5 do
            local outer = UI.Diamond(self, 9, "gilt-line", "ARTWORK", 1)
            outer:SetPoint("CENTER", self, "LEFT", 6 + (i - 1) * 12, 0)
            local inner = UI.Diamond(self, 6, "surface-sunk", "ARTWORK", 2)
            inner:SetPoint("CENTER", outer, "CENTER")
            local lit = UI.Diamond(self, 6, "ink", "ARTWORK", 3)
            lit:SetPoint("CENTER", outer, "CENTER")
            self.pips[i] = { outer = outer, inner = inner, lit = lit }
        end
    end

    function Update()
        local shown = M:Get("comboPoints") and comboClass() and UnitExists("target") and
            secret.flag(UnitCanAttack("player", "target"))
        self:SetShown(shown and true or false)
        if not shown then
            return
        end
        local given = GetComboPoints and GetComboPoints("player", "target")
        if issecretvalue(given) then
            -- Hidden in combat: each pip's alpha comes from an engine step curve.
            local cp = Enum.PowerType.ComboPoints
            for i, p in ipairs(self.pips) do
                UI.Paint(p.outer, "gilt-line")
                UI.Paint(p.inner, "surface-sunk")
                UI.Paint(p.lit, "ink")
                p.lit:SetAlpha(curveAmount(UnitPowerPercent("player", cp, false, pipCurve(i))))
            end
            return
        end
        local n = given or 0
        local full = n >= 5
        for i, p in ipairs(self.pips) do
            local on = i <= n
            UI.Paint(p.outer, full and "arcane" or "gilt-line")
            UI.Paint(p.inner, "surface-sunk")
            UI.Paint(p.lit, full and "arcane" or "ink")
            p.lit:SetAlpha(on and 1 or 0)
        end
    end
end

--------------------------------------------------------------------------------
-- Combat-reactive fade and the aggro state
--------------------------------------------------------------------------------

-- Out of combat the frames rest at opacity-ooc, but only at full health.
-- Your health is secret to addons (always, on Forever: found in game, the
-- frames dimmed hurt or not), so the game itself picks the alpha from it
-- through a step curve: full health rests, anything less shows in full.
-- That alpha is secret too, so it is set at once, not faded.
local restCurve: LuaCurveObject? = nil
local restAt: number? = nil
local function restingAlpha(): number | Secret<number>
    local ooc = T.opacity["opacity-ooc"]
    if not (C_CurveUtil and Enum.LuaCurveType and UnitHealthPercent) then
        return ooc
    end
    local curve = restCurve
    if not curve or restAt ~= ooc then
        curve = C_CurveUtil.CreateCurve()
        curve:SetType(Enum.LuaCurveType.Step)
        curve:AddPoint(0, 1)
        curve:AddPoint(1, ooc)
        restCurve, restAt = curve, ooc
    end
    return curveAmount(UnitHealthPercent("player", true, curve))
end

--------------------------------------------------------------------------------
-- Rested (design "Rested on the player frame", option A "Drift"): the sign
-- over your frame's top-right corner while you rest, and its lines in your
-- frame's tooltip. IsResting, GetXPExhaustion and UnitXPMax are plain
-- values on Forever, in combat too (probed).
--------------------------------------------------------------------------------

local MOON = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\markMoon.tga"
local DISC = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga"

-- No XP to earn: the account's level cap, or XP turned off.
local function noXP(): boolean
    local cap = GetMaxLevelForPlayerExpansion and GetMaxLevelForPlayerExpansion() or
        GetMaxPlayerLevel and GetMaxPlayerLevel() or
        MAX_PLAYER_LEVEL or
        60
    return UnitLevel("player") >= cap or (IsXPUserDisabled and IsXPUserDisabled()) or false
end

-- The rested pool in XP, as a share of the level (0 to 1.5), and whether
-- it is full (150% of a level).
local function restedPool(): (number, number, boolean)
    local pool, max = GetXPExhaustion() or 0, UnitXPMax("player") or 0
    if max <= 0 then
        return pool, 0, false
    end
    return pool, pool / max, pool >= math.floor(max * 1.5)
end

local function tooltipIcon(full: boolean): string
    local r, g, b = UI.RGBA("progress-fill")
    return ("|T%s:10:10:0:0:64:64:0:64:0:64:%d:%d:%d|t "):format(full and DISC or MOON, r * 255, g * 255, b * 255)
end

--------------------------------------------------------------------------------
-- The settings preview: your frame at its real size, resting and earning,
-- with the current options; dimmed, with the reason under it, while the
-- sign wouldn't show.
--------------------------------------------------------------------------------

-- How far the sign reaches past the frame's right end and over its top.
local SIGN_REACH, SIGN_RISE = 36, 44

local previewPerson: StandInPerson? = nil
local function person(_: string): StandInPerson
    local made = previewPerson
    if not made then
        local _, class = UnitClass("player")
        local name = UnitName("player")
        made = {
            name = type(name) == "string" and name or nil,
            class = type(class) == "string" and class or nil,
            health = 1,
            power = 1,
        }
        previewPerson = made
    end
    return made
end

-- The preview: your frame, its sign, why it wouldn't show.
export class UnitFramesPreview extends Frame
    readonly frame: UnitFrame
    readonly sign: RestedSign
    readonly reason: Text

    constructor(parent: Frame, owner: UnitFramesModule)
        super(nil, parent)
        self.frame = UI.UnitFrame(self, "preview", {
            size = "lg",
            anchor = true,
            secure = false,
            api = UI.UnitStandIn(person),
        })
        self.frame:SetScript("OnEnter", nil)
        self.frame:SetScript("OnLeave", nil)
        self.frame:EnableMouse(false)
        self.sign = UI.RestedSign(self.frame)
        self.reason = UI.Text(self, "caption", "ink-muted")
        self.reason:SetWordWrap(true)
        self.reason:SetJustifyH("CENTER")
        self:HookScript("OnShow", function()
            owner:DrawPreview()
        end)
    end
end

-- A unit frame follows its unit (RegisterUnitWatch) unless it is turned off
-- in the settings or hidden in edit mode.
local function follow(self: UnitFramesModule, frame: UnitFrame, on: boolean)
    self:RunOutOfCombat("watch:" .. (frame:GetName() or ""), function()
        if on then
            RegisterUnitWatch(frame)
        else
            UnregisterUnitWatch(frame)
            frame:Hide()
        end
    end)
end

