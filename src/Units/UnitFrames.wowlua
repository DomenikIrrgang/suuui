-- Units/UnitFrames.wowlua
-- The unit frames: player and target (step 1.1), target of target, focus,
-- pet and boss frames (step 1.2). A built-in module written against the
-- public API only.
--
-- Placement follows the cockpit on the 2560x1440 reference (tanks and DPS;
-- the healer profile moves the player and target in step 1.8):
--   player   right edge 200px left of the centre line, top 340px above the bottom
--   target   mirrors it on the right
--   target of target  space-5 right of the target, centred on it
--   focus    in that column, its top 520px above the bottom
--   pet      under the player frame (space-5), right-aligned to it
--   bosses   top right, left of the objective tracker (300px from the right
--            edge, 260px down, level with the tracker), stacked space-5 apart
--
-- Blizzard's frames are stood down; only a reload brings them back, so this
-- module turns off or on after a reload.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type Position from "/EditMode/EditMode"
import type UnitFrame, UnitFrameOptions, StandInPerson from "/UI/UnitFrame"
import type RestedSign from "/UI/RestedSign"
import type Text from "/UI/Text"
import isSecret as isSecretValue from "wowlua:secret"
import * as secret from "wowlua:secret"

local UI, Motion, T = SuuUI.UI, SuuUI.Motion, SuuUI.Tokens
local S = T.space

-- isSecret with its type: strict mode reads a named stdlib import as `any`
-- while the project has an import cycle (Core has some), so the stdlib's own
-- predicate wouldn't narrow here (Docs/port-notes/units-hud.md).
local function isSecret(v: unknown): v is Secret<unknown>
    return isSecretValue(v)
end

local BAR_CHILDREN = { "healthbar", "healthBar", "HealthBar", "HealthBarsContainer.healthBar", "manabar", "ManaBar" }
local function children(extra: string[]?): string[]
    local list = { unpack(BAR_CHILDREN) }
    for _, c in ipairs(extra or {}) do
        list[#list + 1] = c
    end
    return list
end

local DEFAULTS = {
    playerPosition = { point = "BOTTOM", x = -350, y = 308 } :: Position,
    targetPosition = { point = "BOTTOM", x = 350, y = 308 } :: Position,
    totPosition = { point = "BOTTOM", x = 582, y = 312 } :: Position,
    -- under the boss frames, their right edges in line (asked for in
    -- game: from the bottom centre it ran under the tracker at 1920 wide)
    focusPosition = { point = "TOPRIGHT", x = -300, y = -560 } :: Position,
    petPosition = { point = "BOTTOM", x = -300, y = 268 } :: Position,
    bossPosition = { point = "TOPRIGHT", x = -300, y = -260 } :: Position,
    showToT = true,
    showFocus = true,
    showPet = true,
    showBoss = true,
    fadeOutOfCombat = true,
    showPower = true,
    healthText = "percent",
    nameColor = "game",
    showMeta = true,
    eliteDragon = false,
    raidMarkers = true,
    comboPoints = true,
    -- the player and target frames' size (the others keep their tokens);
    -- the defaults are the design's bar-lg and unit-lg
    width = UI.Size("bar-lg"),
    height = UI.Size("unit-lg"),
    debuffBadges = "all", -- your frame: "all" debuff types, "removable", "off"
    -- the rested sign over your frame's top-right corner
    restedSign = true,
    restedShow = "resting", -- or "carrying": also out in the world with rested XP left
    restedAnimation = "animated", -- or "still"
    restedHideCombat = true,
    restedHideMax = true,
}

local M: UnitFramesModule

-- Every frame this module draws. `show` names the setting that turns it off.
-- the single frames: their position setting and the setting that shows them
type FrameDef = {
    key: string,
    unit: UnitToken,
    label: string,
    position: "playerPosition" | "targetPosition" | "totPosition" | "focusPosition" | "petPosition",
    watch?: boolean,
    show?: "showToT" | "showFocus" | "showPet",
    opts: UnitFrameOptions,
}
local FRAMES: FrameDef[] = {
    {
        key = "player",
        unit = "player",
        label = "Player",
        position = "playerPosition",
        -- No "you" badge here (the design has one): the player frame is always you.
        -- Target of target keeps it, where it tells you a mob is on you.
        opts = { size = "lg", anchor = true, name = "SuuUIPlayerFrame" },
    },
    {
        key = "target",
        unit = "target",
        label = "Target",
        position = "targetPosition",
        watch = true,
        opts = { size = "lg", meta = true, crest = true, name = "SuuUITargetFrame" },
    },
    {
        key = "tot",
        unit = "targettarget",
        label = "Target of target",
        position = "totPosition",
        watch = true,
        show = "showToT",
        opts = {
            size = "sm",
            width = "bar-tot",
            power = false,
