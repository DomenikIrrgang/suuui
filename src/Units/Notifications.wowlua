-- Units/Notifications.wowlua
-- Notifications (step 2.4): a stack at the top left under the micro menu.
-- Requests are Blizzard's own popups (party invite, resurrection, summon,
-- duel, trade, release spirit, delete item, logout, battleground entry …)
-- and its battleground-ready and ready-check windows
-- shown as SuuUI cards; notes come from SuuUI.Notify (timed, sticky, or
-- until something happens). At most five show (the rest behind "+N more"),
-- requests first; in combat only requests and conditions.
-- A built-in module written against the public API only.
--
-- What lives where: this file is the module (SuuUI.Notify's notes, the
-- stack, the tick that counts them down, the lifecycle); its parts are in
-- Units/Notifications/: Popups (Blizzard's popups and request windows as
-- data: their kinds and where their parts are), Hosting (hosting them on
-- the cards, and why SuuUI never answers one itself), Presence (friends and
-- guild members coming online and going offline), GameNotes (SuuUI's own
-- notes about the game: gear, bags, talent and Legacy points), Secure (a
-- note's secure macro button) and Settings (the defaults, the settings
-- section and its preview). The module's methods of the same names call
-- into them with the module.

import SuuUI, Module from "/Core/API"
import type NotificationData, Notification, NotificationStack from "/Core/API"
import hook from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
-- the module's parts, beside it
import * as popups from "./Notifications/Popups"
import * as hosting from "./Notifications/Hosting"
import * as presenceNotes from "./Notifications/Presence"
import * as gameNotes from "./Notifications/GameNotes"
import * as secureButtons from "./Notifications/Secure"
import * as notificationSettings from "./Notifications/Settings"
import type Kind as PopupKind, Shown as PopupShown, Parts from "./Notifications/Popups"
import type Host as HostedWindow, Saved, ButtonArt, RoleArt from "./Notifications/Hosting"
import type Person, PresenceKind, Arrivals, AwaitInvite from "./Notifications/Presence"
import type MacroButton from "./Notifications/Secure"

local NOTIFICATIONS = SuuUI.Services.NOTIFICATIONS

local UI, T = SuuUI.UI, SuuUI.Tokens

-- The game's values, read without trusting their types.
local try, field = errors.try, tbl.field
local asString, asNumber = secret.asString, secret.asNumber

local DEFAULTS = notificationSettings.DEFAULTS

local M: NotificationsModule

local OFF_SCREEN = hosting.OFF_SCREEN
local coinString = popups.coinString

-- A popup SuuUI shows as a card (Notifications/Popups).
export type Kind = PopupKind
-- A button a hosted window shows, and its place among the window's buttons.
export type Shown = PopupShown
-- A hosted window (Notifications/Hosting).
export type Host = HostedWindow

--------------------------------------------------------------------------------
-- Notes (SuuUI.Notify)
--------------------------------------------------------------------------------

local nextNote = 0

-- A note as SuuUI.Notify was given it (its fields in Docs/API.md; a
-- plugin's passed on as it gave it, as before).
local function noteOf(def: unknown): NotificationData?
    if type(def) ~= "table" or not secret.readable(def) then
        return nil
    end
    return def :: NotificationData
end

local SECTION = notificationSettings.section(function(parent: Frame): Frame
    return M:PreviewView(parent)
end)

export class NotificationsModule extends Module<typeof(DEFAULTS)>
    frame: Frame? = nil
    stack: NotificationStack? = nil
    preview: NotificationStack? = nil
    -- SuuUI.Notify's notes by id, and their order
    readonly notes: { [string]: NotificationData } = {}
    readonly noteOrder: string[] = {}
    -- when a timed or counting note ends, by id
    readonly endsAt: { [string]: number } = {}
    -- the hosted windows, by window; the windows whose hiding is hooked
    readonly hosts: { [Frame]: Host } = {}
    readonly hookedHide: { [Frame]: boolean } = {}
    -- SuuUI's art behind the game's buttons and role buttons, by button
    readonly arts: { [Frame]: ButtonArt } = {}
    readonly roleArts: { [Frame]: RoleArt } = {}
    -- the widths kept on the game's buttons, and which are hooked for it
    readonly widths: { [Frame]: number } = {}
    readonly widthHooked: { [Frame]: boolean } = {}
    sizing: boolean = false
    hooked: boolean = false
    -- in a fight from its event on (the lockdown comes a moment later)
    fighting: boolean = false
    -- the notes' secure macro buttons, by note id and action
    readonly secure: { [string]: MacroButton } = {}
    readyDuration: number? = nil
    readyEndsAt: number? = nil
    -- what the notes about the game last said
    durabilityState: string? = nil
    talentPointsShown: string? = nil
    legacyPointsShown: number? = nil
    -- conditions' notes closed with their x: away while the condition holds
    readonly closedConditions: { [string]: boolean } = {}
    -- friends coming and going, waiting to share a card, by kind and way
    presence: { [string]: Arrivals }? = nil
    presenceCount: number = 0
    presenceHooked: boolean = false
    awaitInvite: AwaitInvite? = nil
    -- the characters Battle.net friends play, by account
    readonly bnetCharacters: { [number]: string } = {}

    constructor()
        super({
            id = "notifications",
            name = "Notifications",
            description = "Requests (invites, resurrection, summons, duels, trades, deleting items, logging out) and notes as SuuUI cards at the top left.",
            api = "0.11",
            combatSafe = true,
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    --------------------------------------------------------------------------------
    -- Notes (SuuUI.Notify)
    --------------------------------------------------------------------------------

    -- def: { id?, kind = "timed"|"sticky"|"until"|"roll", category, title, body,
    -- icon, tone, duration (timed, default 8), ["until"] (the text), actions }
    -- → id. A request (roll) with duration and remaining counts down on its own
    -- and stays until it is dismissed.
    function Notify(def: NotificationData?): string?
        if type(def) ~= "table" then
            return nil
        end
        nextNote = nextNote + 1
        local given = def.id
        local id = given and tostring(given) or ("note:" .. nextNote)
        local d = tbl.shallowCopy(def)
        d.id = id
        local kind = d.kind or "timed"
        d.kind = kind
        local remaining = d.remaining
        self.endsAt[id] = nil
        if kind == "timed" then
            local duration = d.duration or 8
            d.duration, d.remaining = duration, duration
            self.endsAt[id] = GetTime() + duration
        elseif d.duration and remaining then
            self.endsAt[id] = GetTime() + remaining
        end
        local given = d.onClose
        d.onClose = function(card: Notification)
            self:Dismiss(id)
            if given then
                given(card)
            end
        end
        -- the same id again: replaced in place
        if not self.notes[id] then
            self.noteOrder[#self.noteOrder + 1] = id
        end
        self.notes[id] = d
        self:Rebuild()
        return id
    end

    function Dismiss(id: string)
        if not self.notes[id] then
            return
        end
        self.notes[id] = nil
        self.endsAt[id] = nil
        for i, x in ipairs(self.noteOrder) do
            if x == id then
                table.remove(self.noteOrder, i)
                break
            end
        end
        self:Rebuild()
    end

    -- A condition's note (up while the condition holds: gear to repair, full
    -- bags, points to spend), or nil when it no longer holds. Closed with its
    -- x, it stays away until the condition clears (asked 2026-11-12).
    function ShowCondition(id: string, def: NotificationData?)
        if not def then
            self.closedConditions[id] = nil
            if self.notes[id] then
                self:Dismiss(id)
            end
            return
        end
        if self.closedConditions[id] then
            return
        end
        def.id = id
        def.onClose = function()
            self.closedConditions[id] = true
        end
        self:Notify(def)
    end

    function DismissAll()
        for id, d in pairs(self.notes) do
            if d.kind == "sticky" then
                self:Dismiss(id)
            end
        end
    end

    --------------------------------------------------------------------------------
    -- SuuUI's own notes about the game (Notifications/GameNotes)
    --------------------------------------------------------------------------------

    function CheckDurability()
        gameNotes.checkDurability(self)
    end

    function CheckBags()
        gameNotes.checkBags(self)
    end

    function CheckTalents()
        gameNotes.checkTalents(self)
    end

    function CheckLegacy()
        gameNotes.checkLegacy(self)
    end

    --------------------------------------------------------------------------------
    -- Friends and guild members coming online and going offline (Notifications/Presence)
    --------------------------------------------------------------------------------

    function WhoIs(name: string): (PresenceKind?, Person?)
        return presenceNotes.whoIs(self, name)
    end

    function BnetPerson(accountID: number): Person?
        return presenceNotes.bnetPerson(self, accountID)
    end

    function Presence(kind: PresenceKind, online: boolean, person: Person?)
        presenceNotes.queuePresence(self, kind, online, person)
    end

    function BnetCharacterSet(): { [string]: boolean }
        return presenceNotes.bnetCharacterSet(self)
    end

    function FlushPresence(key: string)
        presenceNotes.flushPresence(self, key)
    end

    function BnetInfoChanged()
        presenceNotes.bnetInfoChanged(self)
    end

    function SystemLine(msg: unknown)
        presenceNotes.systemLine(self, msg)
    end

    function HookPresence()
        presenceNotes.hookPresence(self)
    end

    function TestPresence()
        presenceNotes.testPresence(self)
    end

    --------------------------------------------------------------------------------
    -- Hosting Blizzard's popups (Notifications/Hosting)
    --------------------------------------------------------------------------------

    function Remember(h: Host, f: Frame): Saved
        return hosting.remember(self, h, f)
    end

    function Undo(h: Host)
        hosting.undo(self, h)
    end

    function ArtFor(b: Button, stack: NotificationStack): ButtonArt
        return hosting.artFor(self, b, stack)
    end

    function StyleButton(h: Host, b: Button, variant: string, stack: NotificationStack): number
        return hosting.styleButton(self, h, b, variant, stack)
    end

    function StyleEditBox(h: Host, eb: EditBox, box: Frame)
        hosting.styleEditBox(self, h, eb, box)
    end

    function CardData(h: Host): NotificationData
        return hosting.cardData(self, h)
    end

    function Attach(h: Host)
        hosting.attach(self, h)
    end

    function RoleArtFor(b: Button, cb: CheckButton?, stack: NotificationStack): RoleArt
        return hosting.roleArtFor(self, b, cb, stack)
    end

    function HostRole(h: Host, card: Notification, b: Button, i: number, stack: NotificationStack)
        hosting.hostRole(self, h, card, b, i, stack)
    end

    function Host(dialog: Frame, which: string)
        hosting.host(self, dialog, which)
    end

    function HostFrame(dialog: Frame, which: string, kind: Kind, parts: Parts)
        hosting.hostFrame(self, dialog, which, kind, parts)
    end

    function Release(dialog: Frame)
        hosting.release(self, dialog)
    end

    function HookWindows()
        hosting.hookWindows(self)
    end

    --------------------------------------------------------------------------------
    -- The stack
    --------------------------------------------------------------------------------

    function Items(): NotificationData[]
        local list: NotificationData[] = {}
        local hosts: Host[] = {}
        for _, h in pairs(self.hosts) do
            hosts[#hosts + 1] = h
        end
        table.sort(hosts, function(a: Host, b: Host): boolean
            return a.order < b.order
        end)
        for _, h in ipairs(hosts) do
            list[#list + 1] = h.data
        end
        for _, id in ipairs(self.noteOrder) do
            local n = self.notes[id]
            if n then
                list[#list + 1] = n
            end
        end
        return list
    end

    function Rebuild()
        local stack = self.stack
        if not stack then
            return
        end
        -- (in a fight from its event on: the lockdown itself comes a moment later)
        stack:SetItems(self:Items(), InCombatLockdown() or self.fighting)
        self:CardAhead()
        for _, h in pairs(self.hosts) do
            self:Attach(h)
        end
        self:SecureActions()
    end

    -- A spare card kept ready (Core/Ahead: made out of combat), so the next
    -- one, a wipe's Release Spirit among them, is only filled in (made then
    -- it cost 110 KB in one frame).
    function CardAhead()
        local stack = self.stack
        if not stack then
            return
        end
        SuuUI.BuildAhead("notifications: a card", function(): boolean
            return stack:BuildAhead()
        end)
    end

    --------------------------------------------------------------------------------
    -- A note's secure macro button (Notifications/Secure)
    --------------------------------------------------------------------------------

    function SecureActions()
        secureButtons.secureActions(self)
    end

    function HideSecureActions()
        secureButtons.hideSecureActions(self)
    end

    -- A few times a second: counting titles (logging out in 12 s), time left,
    -- timed notes going, hosted parts kept on their cards (Blizzard lays its
    -- popups out again now and then), popups anchored to a hosted one put back
    -- on screen.
    function Tick()
        local stack = self.stack
        -- notes hide while an open window covers them (requests stay)
        if stack then
            stack:SetNotesHidden(UI.IsCoveredByWindow(stack))
        end
        local now = GetTime()
        local changed = false
        for id, d in pairs(self.notes) do
            local ends = self.endsAt[id]
            if d.kind ~= "timed" and ends then
                local remaining = math.max(0, ends - now)
                d.remaining = remaining
                local card = stack and stack:CardFor(id)
                if card then
                    card:SetRemaining(remaining)
                end
            elseif d.kind == "timed" and ends then
                local remaining = ends - now
                d.remaining = remaining
                if remaining <= 0 then
                    self.notes[id] = nil
                    self.endsAt[id] = nil
                    for i, x in ipairs(self.noteOrder) do
                        if x == id then
                            table.remove(self.noteOrder, i)
                            break
                        end
                    end
                    changed = true
                else
                    local card = stack and stack:CardFor(id)
                    if card then
                        card:SetRemaining(remaining)
                    end
                end
            end
        end
        if changed then
            self:Rebuild()
        else
            self:SecureActions()
        end
        for dialog, h in pairs(self.hosts) do
            local card = h.card
            if card then
                local text = h.text()
                if text and text ~= h.data.title then
                    h.data.title = text
                    card:SetTitle(text)
                end
                if h.data.duration then
                    local _, remaining = h.time()
                    if remaining then
                        card:SetRemaining(remaining)
                    end
                end
                local point, rel = dialog:GetPoint(1)
                if point ~= "BOTTOMRIGHT" or rel ~= UIParent then
                    dialog:ClearAllPoints()
                    dialog:SetPoint("BOTTOMRIGHT", UIParent, "TOPLEFT", -OFF_SCREEN, OFF_SCREEN)
                end
                local list = h.buttons()
                local last = list[#list]
                if last then
                    local _, brel = last.button:GetPoint(1)
                    if brel ~= card.actionsRow then
                        self:Attach(h)
                    end
                end
                -- disabled until typed (delete): Blizzard's own rule, shown dim
                for _, x in ipairs(list) do
                    local art = self.arts[x.button]
                    if art then
                        art:SetAlpha(x.button:IsEnabled() and 1 or T.opacity["opacity-disabled"])
                    end
                end
            end
        end
        -- a popup Blizzard anchored under a hosted one would be off screen too
        for i = 1, 4 do
            local d = frames.find("StaticPopup" .. i)
            if d and d:IsShown() and not self.hosts[d] then
                local _, rel = d:GetPoint(1)
                local under = frames.asFrame(rel)
                if under and self.hosts[under] then
                    d:ClearAllPoints()
                    d:SetPoint("TOP", UIParent, "TOP", 0, -135)
                end
            end
        end
    end

    --------------------------------------------------------------------------------
    -- Settings (Notifications/Settings)
    --------------------------------------------------------------------------------

    function PreviewView(parent: Frame): NotificationStack
        return notificationSettings.previewView(self, parent)
    end

    --------------------------------------------------------------------------------
    -- Lifecycle
    --------------------------------------------------------------------------------

    override function OnEnable()
        self:ProvideService(NOTIFICATIONS, {
            Notify = function(def: { [string]: unknown }): string?
                return self:Notify(noteOf(def))
            end,
            Dismiss = function(id: string)
                self:Dismiss(id)
            end,
        })
        local frame = self.frame
        if not frame then
            frame = CreateFrame("Frame", "SuuUINotifications", SuuUI.Root)
            -- under open windows (HIGH): notes; requests raise themselves
            frame:SetFrameStrata("MEDIUM")
            frame:SetSize(T.size["notice-w"], 200)
            local stack = UI.NotificationStack(frame, { max = self:Get("max") })
            stack:SetPoint("TOPLEFT")
            stack.onExpand = function()
                self:Rebuild()
            end
            stack.onClearAll = function()
                self:DismissAll()
            end
            self.frame, self.stack = frame, stack
            self:CardAhead()
            local wait = 0
            frame:SetScript("OnUpdate", function(_, elapsed)
                wait = wait - elapsed
                if wait > 0 then
                    return
                end
                wait = 0.1
                self:Tick()
            end)
        end
        self:RegisterMover(frame, { key = "position", label = "Notifications" })
        self:RegisterSettings(SECTION)
        self:Watch("max", function(v)
            local stack = self.stack
            if stack then
                stack.max = v
            end
            self:Rebuild()
        end)
        self:Watch("requests", function(on)
            if not on then
                for dialog in pairs(self.hosts) do
                    self:Release(dialog)
                end
            end
        end)
        if not self.hooked and type(StaticPopup_Show) == "function" then
            self.hooked = true
            hook("StaticPopup_Show", function(which: unknown, _: unknown, _: unknown, data: unknown)
                if not self:IsEnabled() then
                    return
                end
                local name = asString(which)
                local dialog = name and frames.asFrame(try(field(_G, "StaticPopup_FindVisible"), name, data))
                if name and dialog then
                    self:Host(dialog, name)
                end
            end)
        end
        self:HookWindows()
        -- request windows whose addon loads later
        self:OnGameEvent("ADDON_LOADED", function()
            self:HookWindows()
        end)
        -- notes about the game
        for _, e in ipairs({ "UPDATE_INVENTORY_DURABILITY", "PLAYER_ENTERING_WORLD" }) do
            self:OnGameEvent(e, function()
                self:CheckDurability()
            end)
        end
        for _, e in ipairs({ "BAG_UPDATE_DELAYED", "PLAYER_ENTERING_WORLD" }) do
            self:OnGameEvent(e, function()
                self:CheckBags()
            end)
        end
        self:Watch("durability", function()
            self:CheckDurability()
        end)
        -- the Durability module's reading (its line, the pieces' names)
        self:On("SUUUI_DURABILITY_CHANGED", function()
            self:CheckDurability()
        end)
        self:On("SUUUI_SERVICE_CHANGED", function(_, name)
            if name == "durability" then
                self:CheckDurability()
            end
        end)
        self:Watch("bagsFull", function()
            self:CheckBags()
        end)
        for _, e in ipairs({
            "TRAIT_CONFIG_UPDATED",
            "TRAIT_TREE_CURRENCY_INFO_UPDATED",
            "PLAYER_TALENT_UPDATE",
            "CHARACTER_POINTS_CHANGED",
            "PLAYER_LEVEL_UP",
            "PLAYER_ENTERING_WORLD",
        }) do
            -- a moment later: the points read right only after the change has landed
            self:OnGameEvent(e, function()
                self:After(0.2, function()
                    self:CheckTalents()
                    self:CheckLegacy()
                end)
            end)
        end
        self:OnGameEvent("MAJOR_FACTION_RENOWN_LEVEL_CHANGED", function()
            self:After(0.2, function()
                self:CheckLegacy()
            end)
        end)
        self:Watch("talentPoints", function()
            self:CheckTalents()
        end)
        -- a talent build followed, changed or learned along
        self:On("SUUUI_TALENT_BUILD_CHANGED", function()
            self:After(0.2, function()
                self:CheckTalents()
            end)
        end)
        self:Watch("legacyPoints", function()
            self:CheckLegacy()
        end)
        -- the ready check's time
        self:OnGameEvent("READY_CHECK", function(_, _, timeLeft)
            local seconds = asNumber(timeLeft)
            if seconds and seconds > 0 then
                self.readyDuration, self.readyEndsAt = seconds, GetTime() + seconds
            end
        end)
        self:OnGameEvent("READY_CHECK_FINISHED", function()
            self.readyEndsAt = nil
        end)
        -- a theme change: the coins' colours in a cost, and the game's button
        -- text (StyleButton through Rebuild)
        self:On("SUUUI_THEME_CHANGED", function()
            for _, h in pairs(self.hosts) do
                local cost = h.cost
                if cost then
                    h.data.body = "Costs " .. coinString(cost)
                end
            end
            self:Rebuild()
        end)
        -- in combat notes wait; out of it they come back
        -- (the event comes before the lockdown: drawn as in combat from here)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            self.fighting = true
            self:HideSecureActions()
            self:Rebuild()
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self.fighting = false
            self:Rebuild()
            -- online/offline held in the fight
            for key, q in pairs(self.presence or {}) do
                if q.held then
                    self:FlushPresence(key)
                end
            end
        end)
        -- friends and guild members coming and going (handlers take the event
        -- first, then its values: these read one value too far, the companion
        -- app flag and the sender, and no note ever came; found with /suu probe
        -- social)
        self:HookPresence()
        self:OnGameEvent("CHAT_MSG_SYSTEM", function(_, msg)
            self:SystemLine(msg)
        end)
        self:OnGameEvent("BN_FRIEND_ACCOUNT_ONLINE", function(_, id)
            local account = asNumber(id)
            if account then
                self:Presence("bnet", true, self:BnetPerson(account))
            end
        end)
        self:OnGameEvent("BN_FRIEND_INFO_CHANGED", function()
            self:BnetInfoChanged()
        end)
        self:OnGameEvent("BN_FRIEND_ACCOUNT_OFFLINE", function(_, id)
            local account = asNumber(id)
            if account then
                self:Presence("bnet", false, self:BnetPerson(account))
            end
        end)
        -- the roster asked for now and then, so a guild member's line finds them
        if IsInGuild() then
            try(field(C_GuildInfo, "GuildRoster"))
        end
        self:RegisterCommand("presence", "test: shows a card for each kind of friend coming online and going offline", function()
            self:TestPresence()
        end)
        self:RegisterCommand("notify", "test: shows one notification of each kind", function()
            self:Notify({
                kind = "timed",
                category = "Test",
                title = "A timed note",
                body = "It goes by itself after 8 seconds.",
                icon = { glyph = "bell" },
            })
            self:Notify({
                kind = "sticky",
                category = "Test",
                title = "A sticky note",
                body = "It stays until you close it.",
                icon = { glyph = "mail" },
            })
            self:Notify({
                kind = "until",
                category = "Test",
                title = "A condition",
                ["until"] = "Goes when the test ends",
                icon = { glyph = "hourglass" },
                tone = "warning",
            })
        end)
    end

    override function OnDisable()
        for dialog in pairs(self.hosts) do
            self:Release(dialog)
        end
        local frame = self.frame
        if frame then
            frame:Hide()
        end
    end
end

M = SuuUI.AddModule(NotificationsModule.new())
