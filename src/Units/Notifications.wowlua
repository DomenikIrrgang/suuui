-- "1g 20s 5c", each in its coin's colour (zero coins left out).
local function coinString(copper: number): string
    local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local out: string[] = {}
    local function add(n: number, suffix: string, token: ColorToken)
        out[#out + 1] = ("|cff%s%d%s|r"):format(T.color[token].hex, n, suffix)
    end
    if g > 0 then add(g, "g", "coin-gold") end
    if s > 0 then add(s, "s", "coin-silver") end
    if c > 0 or #out == 0 then add(c, "c", "coin-copper") end
    return table.concat(out, " ")
end

--------------------------------------------------------------------------------
-- Notes (SuuUI.Notify)
--------------------------------------------------------------------------------

local nextNote = 0

-- A note as SuuUI.Notify was given it (its fields in Docs/API.md; a
-- plugin's passed on as it gave it, as before).
local function noteOf(def: unknown): NotificationData?
    if type(def) ~= "table" or not secret.readable(def) then return nil end
    return def :: NotificationData
end

--------------------------------------------------------------------------------
-- SuuUI's own notes about the game
--------------------------------------------------------------------------------

-- Your gear: the worst piece's durability (0 broken, nil nothing to wear out).
local function worstDurability(): number?
    local worst: number? = nil
    for slot = 1, 19 do
        local c, m = GetInventoryItemDurability(slot)
        local cur, max = asNumber(c), asNumber(m)
        if cur and max and max > 0 then
            local r = cur / max
            if not worst or r < worst then worst = r end
        end
    end
    return worst
end

-- The world map, for its Repair pins (the World map pins module's filter:
-- Map filters › Services › Repair).
local function showRepairers()
    -- SuuUI's world map with its Repair pins on; else the game's map
    local map = SuuUI.UseService(WORLD_MAP)
    local openWith = map and map.OpenWith
    if openWith then
        openWith("services", "repair")
        return
    end
    local shown = frames.find("WorldMapFrame")
    if shown and shown:IsShown() then return end
    ToggleWorldMap()
end

-- "Legs 15% · Chest 18%": the worn pieces that aren't broken, lowest first.
local function wornList(d: DurabilityInfo): string
    local out: string[] = {}
    for _, p in ipairs(d.pieces) do
        if p.state == "damaged" then out[#out + 1] = p.label .. " " .. p.percent .. "%" end
    end
    return table.concat(out, " · ")
end

-- With the Durability module's "Name the pieces in the note" (design board
-- "Durability" D): which pieces, and Show repairers. Its line too.
local function namedNote(d: DurabilityInfo): (string, string)
    local worn = wornList(d)
    if d.state == "broken" then
        local broken: string[], names: string[] = {}, {}
        for _, p in ipairs(d.pieces) do
            if p.state == "broken" then
                broken[#broken + 1] = p.label
                names[#names + 1] = p.name
            end
        end
        local title, gives
        if #broken == 1 then
            title = "Your " .. broken[1] .. " is broken"
            gives = names[1] .. " gives no stats until repaired"
        else
            title = #broken .. " pieces are broken"
            gives = table.concat(broken, ", ") .. " give no stats until repaired"
        end
        return title, worn ~= "" and (gives .. " · " .. worn) or gives
    end
    return "Your gear is badly damaged", worn
end

-- Free slots in your general bags (backpack and bags 1-4; special bags
-- hold only their own kind).
local function freeSlots(): number
    local free = 0
    for bag = 0, (NUM_BAG_SLOTS or 4) do
        local n, family = C_Container.GetContainerNumFreeSlots(bag)
        local slots, kind = asNumber(n), asNumber(family)
        if slots and (kind == nil or kind == 0) then free = free + slots end
    end
    return free
end

-- Talent points not spent yet (the active talent config's points to spend).
local function unspentTalents(): number
    if not (C_ClassTalents and C_Traits) then return 0 end
    local configID = asNumber(errors.tryValue(C_ClassTalents.GetActiveConfigID))
    if not configID then return 0 end
    local info = errors.tryValue(C_Traits.GetConfigInfo, configID)
    local treeID = info and info.treeIDs and info.treeIDs[1]
    if not treeID then return 0 end
    local currency = errors.tryValue(C_Traits.GetTreeCurrencyInfo, configID, treeID, false)
    return asNumber(currency and currency[1] and currency[1].quantity) or 0
end

-- Legacy points this character can still spend (the Legacy trees' currency;
-- one config for all three trees: 1187 is Professions).
local LEGACY_TREE = 1187
local function unspentLegacy(): number
    if not C_Traits then return 0 end
    local configID = asNumber(errors.tryValue(C_Traits.GetConfigIDByTreeID, LEGACY_TREE))
    if not configID then return 0 end
    local currency = errors.tryValue(C_Traits.GetTreeCurrencyInfo, configID, LEGACY_TREE, false)
    return asNumber(currency and currency[1] and currency[1].quantity) or 0
end

-- Open Legacy: Blizzard's own key (ToggleLegacySystemUI) only shows the
-- window, which isn't one of the panels Blizzard's window manager places,
-- so showing it from here taints nothing Esc relies on (checked in
-- Blizzard's code, 2026-10-14).
local function openLegacy()
    if not frames.find("LegacySystemFrame") then try(field(C_AddOns, "LoadAddOn"), "Blizzard_LegacySystem") end
    local f = frames.find("LegacySystemFrame")
    if f and not f:IsShown() then f:Show() end
end

--------------------------------------------------------------------------------
-- Friends and guild members coming online and going offline (design board
-- "Notifications · Friends"; probed 2026-10-14). Character friends and
-- guild members come as the game's system line ("[Name] has come online.",
-- "Name has gone offline."); Battle.net friends as their own events. Who it
-- is decides the card: a Battle.net friend, a friend, a guild member.
-- Arrivals within a few seconds share one card; in combat they wait. The
-- game's own lines in chat (and its Battle.net toast) can be hidden.
--------------------------------------------------------------------------------

-- A pattern from one of the game's format strings: "%s" a capture, the
-- rest literal.
local function patternOf(fmt: unknown): string?
    if type(fmt) ~= "string" then return nil end
    local parts: string[] = {}
    -- the text between the "%s"s (one more "%s" at the end closes the last)
    for piece in (fmt .. "%s"):gmatch("(.-)%%s") do
        parts[#parts + 1] = (piece:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1"))
    end
    return "^" .. table.concat(parts, "(.-)") .. "$"
end

local ONLINE = patternOf(ERR_FRIEND_ONLINE_SS)    -- link, name
local OFFLINE = patternOf(ERR_FRIEND_OFFLINE_S)   -- name
local BATCH = 2.5                                  -- seconds that share one card

-- A class's file name ("PRIEST") by its name as the game writes it.
local CLASS_FILES: { [string]: string } = {}
for _, key in ipairs({ "LOCALIZED_CLASS_NAMES_MALE", "LOCALIZED_CLASS_NAMES_FEMALE" }) do
    local names = field(_G, key)
    if type(names) == "table" and secret.readable(names) then
        for file, name in pairs(names :: { [unknown]: unknown }) do
            local f, n = asString(file), asString(name)
            if f and n then CLASS_FILES[n] = f end
        end
    end
end

local GAMES: { [string]: string } = {
    App = "Battle.net", BSAp = "Battle.net Mobile", WTCG = "Hearthstone", Hero = "Heroes of the Storm",
    Pro = "Overwatch", S2 = "StarCraft II", S1 = "StarCraft", D3 = "Diablo III", Fen = "Diablo IV",
    ANBS = "Diablo Immortal", VIPR = "Call of Duty", W3 = "Warcraft III", GRY = "Warcraft Rumble",
}

local function classIcon(file: string?): NotificationIcon?
    local c = file and field(_G, "CLASS_ICON_TCOORDS", file)
    if type(c) ~= "table" then return nil end
    local coords: number[] = {}
    for i, v in ipairs(tbl.list(c)) do coords[i] = asNumber(v) or 0 end
    return { texture = "Interface\\Glues\\CharacterCreate\\UI-CharacterCreate-Classes", coords = coords }
end

local function classColor(file: string?): string?
    if not file then return nil end
    local token = "class-" .. file:lower()
    return field(T.color, token) ~= nil and token or nil
end

-- What a group invite by name does (a card's Invite).
local function inviting(name: string): () -> ()
    return function() unit.invite(name) end
end

-- Someone on a friends card, and what SuuUI knows besides: their
-- Battle.net account, the name they're invited by, their own Invite, the
-- character a Battle.net friend plays.
type Person = NotificationPerson & { bnetID?: number, inviteName?: string, invite?: () -> (), character?: string }

-- The people as the card takes them.
local function cardPeople(people: Person[]): NotificationPerson[]
    local out: NotificationPerson[] = {}
    for i, p in ipairs(people) do out[i] = p end
    return out
end

-- Can you invite them: in Forever, on your realm and in your faction (the
-- game's own friends list asks the same).
-- Same game and side (no realm check: Forever's realms are rulesets, and a
-- friend on another realm ID still groups; the game says when it can't).
local function canCooperate(game: BNetGameAccountInfo): boolean
    if not (game.wowProjectID == asNumber(field(_G, "WOW_PROJECT_ID")) and game.gameAccountID) then return false end
    local side = asString(game.factionName)
    return side ~= nil and side == asString(UnitFactionGroup("player"))
end

-- the presence settings: a kind's setting, then Online or Offline
type PresenceKey = "presenceBnetOnline" | "presenceBnetOffline" | "presenceFriendOnline" | "presenceFriendOffline"
    | "presenceGuildOnline" | "presenceGuildOffline"

-- Who comes and goes: a Battle.net friend, a friend, a guild member.
type PresenceKind = "bnet" | "friend" | "guild"
type PresenceStyle = { setting: string, source?: string, plural: string, glyph: string }

local KINDS_OF: { bnet: PresenceStyle, friend: PresenceStyle, guild: PresenceStyle } = {
    bnet = { setting = "presenceBnet", source = "Battle.net", plural = "Battle.net friends", glyph = "people" },
    friend = { setting = "presenceFriend", source = "Friend", plural = "friends", glyph = "people" },
    guild = { setting = "presenceGuild", plural = "guild members", glyph = "flag" },
}

-- The arrivals (or departures) of one kind waiting to share a card.
type Arrivals = { kind: PresenceKind, online: boolean, people: Person[], held?: boolean }

-- A card waiting for a Battle.net friend's character, for its Invite.
type AwaitInvite = { id: string, bnetID: number, refresh: (person: Person) -> () }

-- A character's whole name ("Frassilla Grim": Battle.net gives the surname
-- too, seen 2026-10-18), and its first name for a side that has none.
local function wholeName(name: string): string
    return Ambiguate(name, "short")
end
local function firstName(name: string): string
    return wholeName(name):match("^(%S+)") or name
end

-- Is this one of the game's online/offline lines (for the chat filter)?
local function isPresenceLine(msg: unknown): boolean
    local text = asString(msg)
    if not text then return false end
    return (ONLINE ~= nil and text:match(ONLINE) ~= nil) or (OFFLINE ~= nil and text:match(OFFLINE) ~= nil)
end

--------------------------------------------------------------------------------
-- Hosting Blizzard's popups
--------------------------------------------------------------------------------

-- A button a hosted window shows, and its place among the window's buttons
-- (which one is primary or dangerous).
export type Shown = { button: Button, index: number }

-- Where a Blizzard request window's parts are: its buttons (in order), text,
-- time (duration, remaining), edit box, role buttons and queue warning.
type Parts = {
    buttons: () -> Shown[],
    text: () -> string?,
    time?: () -> (number?, number?),
    editBox?: EditBox,
    roles?: () -> Button[],
    warning?: () -> string?,
}

-- A point of a part SuuUI moved, as it was.
type Point = { point: FramePoint, rel: ScriptRegion?, relPoint: FramePoint, x: number, y: number }

-- How a part of the game's window was before SuuUI moved and styled it.
type Saved = {
    points: Point[], width: number, height: number, strata: FrameStrata, level: number,
    alphas: { [Texture]: number }, font?: Font, fs?: FontString, color?: number[],
}

-- A hosted window: its parts, its card's data and card, what was changed.
export type Host = {
    dialog: Frame, order: number, which: string, kind: Kind, id: string,
    buttons: () -> Shown[], text: () -> string?, time: () -> (number?, number?),
    editBox?: EditBox, roles?: () -> Button[], warning?: () -> string?,
    clamped?: boolean, data: NotificationData, card?: Notification, cost?: number,
    saved?: { [Frame]: Saved },
}

local function noTime(): (number?, number?) return nil, nil end

-- A font string's text, when it is one and readable.
local function textOf(v: unknown): string?
    local fs = frames.asFontString(v)
    return fs and asString(fs:GetText()) or nil
end

local function buttonsOf(dialog: Frame): Shown[]
    local out: Shown[] = {}
    local name = dialog:GetName()
    for i = 1, 4 do
        local b = frames.asButton(field(dialog, "ButtonContainer", "Button" .. i))
            or (name and frames.asButton(field(_G, name .. "Button" .. i)) or nil)
        if b and b:IsShown() then out[#out + 1] = { button = b, index = i } end
    end
    return out
end

local function savePoints(f: Frame): Point[]
    local pts: Point[] = {}
    for i = 1, f:GetNumPoints() do
        local point, rel, relPoint, x, y = f:GetPoint(i)
        pts[i] = { point = point, rel = rel, relPoint = relPoint, x = x, y = y }
    end
    return pts
end

local function restorePoints(f: Frame, pts: Point[])
    f:ClearAllPoints()
    for _, p in ipairs(pts) do f:SetPoint(p.point, p.rel, p.relPoint, p.x, p.y) end
end

-- SuuUI's look behind a Blizzard button: quiet (surface-raised, gilt-line),
-- primary (arcane) or danger (ember edge); hover brightens the edge.
class ButtonArt extends Frame
    readonly fill: Texture
    readonly edge: Border
    readonly glow: SoftEdge
    variant: string = "quiet"

    constructor(parent: Frame)
        super(nil, parent)
        self.fill = UI.Fill(self, "surface-raised", "BACKGROUND")
        self.fill:SetAllPoints()
        self.edge = UI.Border(self, "gilt-line")
        self.glow = UI.Shadow(self, "glow-arcane")
        self.glow:SetShown(false)
    end
end

-- A group invite's role buttons (the game's, with their checkboxes, clicks
-- and tooltips) as SuuUI's round role toggles on the card: the icon in a
-- circle, the role's name under it, a 14px box on its corner. On: arcane;
-- one the game has disabled (your class can't, or the group has no room;
-- its tooltip says which) at opacity-disabled.
local ROLE_TEX: { [string]: string } = { TANK = "RoleTank.tga", HEALER = "RoleHealer.tga", DAMAGER = "RoleDamage.tga" }
local ROLE_WORD: { [string]: string } = { TANK = TANK or "Tank", HEALER = HEALER or "Healer", DAMAGER = DAMAGER or "Damage" }
local TEXTURES = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"

local function circle(owner: Frame, file: string, layer: DrawLayer): Texture
    local t = owner:CreateTexture(nil, layer)
    t:SetTexture(TEXTURES .. file)
    t:SetAllPoints()
    return t
end

class RoleArt extends Frame
    readonly fill: Texture
    readonly edge: Texture
    readonly glyph: Texture
    readonly word: Text
    readonly box: Frame
    readonly boxFill: Texture
    readonly boxEdge: Border
    readonly tick: Texture
    hover: boolean = false

    constructor(parent: Frame, readonly button: Button, readonly check: CheckButton?)
        super(nil, parent)
        self:EnableMouse(false)
        self.fill = circle(self, "CircleFill.tga", "BACKGROUND")
        self.edge = circle(self, "CircleBand.tga", "BORDER")
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetSize(18, 18)
        self.glyph:SetPoint("CENTER")
        self.word = UI.Text(self, "caption", "ink-muted")
        self.word:SetPoint("TOP", self, "BOTTOM", 0, -S["space-2"])
        self.box = CreateFrame("Frame", nil, self)
        self.box:SetSize(14, 14)
        self.box:EnableMouse(false)
        self.boxFill = UI.Fill(self.box, "surface-sunk")
        self.boxFill:SetAllPoints()
        self.boxEdge = UI.Border(self.box, "gilt-line")
        self.tick = self.box:CreateTexture(nil, "OVERLAY")
        self.tick:SetTexture(TEXTURES .. "Glyphs\\check.tga")
        self.tick:SetSize(10, 10)
        self.tick:SetPoint("CENTER")
        UI.Paint(self.tick, "on-signal")
    end

    function Draw()
        if not self:IsShown() then return end
        local cb = self.check
        local on = cb ~= nil and cb:GetChecked() and true or false
        UI.Paint(self.edge, on and "arcane" or (self.hover and "gilt" or "gilt-line"))
        UI.Paint(self.fill, on and "surface-raised" or "surface-sunk")
        UI.Paint(self.glyph, on and "ink" or "ink-faint")
        self.word:SetColor(on and "ink" or "ink-muted")
        self.box:SetShown(cb ~= nil and cb:IsShown() and true or false)
        UI.PaintFill(self.boxFill, on and "arcane" or "surface-sunk")
        self.boxEdge:SetColor(on and "arcane" or "gilt-line")
        self.tick:SetShown(on)
        self:SetAlpha(self.button:IsEnabled() and 1 or T.opacity["opacity-disabled"])
    end
end

-- A popup's kind: SuuUI's own, else one a plugin added (0.17,
-- M:AddNotificationKind(which, def), def as above), read field by field.
local function kindFrom(def: NotificationKind): Kind
    local cost = def.cost
    return {
        category = asString(def.category), glyph = asString(def.glyph), tone = asString(def.tone),
        title = asString(def.title), primary = asNumber(def.primary), danger = asNumber(def.danger),
        item = secret.flag(def.item), confirm = secret.flag(def.confirm),
        cost = type(cost) == "function" and function(dialog: Frame): number? return asNumber((try(cost, dialog))) end or nil,
    }
end

local function kindOf(which: string): Kind?
    local own = KINDS[which]
    if own then return own end
    for _, added in ipairs(SuuUI.Additions("notificationkinds")) do
        -- M:AddNotificationKind's table, with `which` set
        local def = added :: NotificationKind
        if def.which == which then return kindFrom(def) end
    end
    return nil
end

-- Blizzard's request windows that aren't popups: the battleground's "enter"
-- (its answer is forbidden to addons: hosted like the popups) and the ready
-- check (hosted the same way, so it sits with the rest).
local function shownButtons(...: unknown): Shown[]
    local out: Shown[] = {}
    for i = 1, select("#", ...) do
        local b = frames.asButton((select(i, ...)))
        if b and b:IsShown() then out[#out + 1] = { button = b, index = i } end
    end
    return out
end

-- The battleground waiting for you to enter.
local function battlefieldReady(): number?
    for i = 1, asNumber((try(field(_G, "GetMaxBattlefieldID")))) or 0 do
        if asString((try(field(_G, "GetBattlefieldStatus"), i))) == "confirm" then return i end
    end
    return nil
end

-- A request window SuuUI hosts: its global name, its kind, its parts.
type Window = { name: string, kind: Kind, parts: (f: Frame) -> Parts }

local WINDOWS: Window[] = {
    -- a group invite that asks for your role (the group finder's; not a
    -- shared popup): its role buttons come onto the card too
    {
        name = "LFGInvitePopup",
        kind = { category = "Party invite", glyph = "people", primary = 1 },
        parts = function(f: Frame): Parts
            return {
                buttons = function(): Shown[]
                    return shownButtons(field(_G, "LFGInvitePopupAcceptButton"), field(_G, "LFGInvitePopupDeclineButton"))
                end,
                text = function(): string? return textOf(field(_G, "LFGInvitePopupText")) end,
                time = function(): (number?, number?)
                    local total, left = asNumber(field(_G, "StaticPopupTimeoutSec")), asNumber(field(f, "timeOut"))
                    if total and left and total > 0 then return total, math.max(0, left) end
                    return nil, nil
                end,
                roles = function(): Button[]
                    local out: Button[] = {}
                    for _, b in ipairs(tbl.list(field(f, "RoleButtons"))) do
                        local button = frames.asButton(b)
                        if button then out[#out + 1] = button end
                    end
                    return out
                end,
                warning = function(): string?
                    local w = frames.asFontString(field(f, "QueueWarningText"))
                    if w and w:IsShown() then return asString(w:GetText()) end
                    return nil
                end,
            }
        end,
    },
    {
        name = "PVPReadyDialog",
        kind = { category = "Battleground", glyph = "flag", primary = 1, title = "Your battleground is ready" },
        parts = function(f: Frame): Parts
            local total: number? = nil -- the first reading: the whole time to enter
            return {
                buttons = function(): Shown[] return shownButtons(field(f, "enterButton"), field(f, "leaveButton")) end,
                text = function(): string? return textOf(field(f, "label")) end,
                time = function(): (number?, number?)
                    local i = battlefieldReady()
                    local t = i and asNumber((try(field(_G, "GetBattlefieldPortExpiration"), i)))
                    if t and t > 0 then
                        -- seconds on some clients, milliseconds on others
                        local left = t > 1000 and t / 1000 or t
                        local whole = total or left
                        total = whole
                        return whole, left
                    end
                    return nil, nil
                end,
            }
        end,
    },
    {
        name = "ReadyCheckFrame",
        kind = { category = "Ready check", glyph = "flag", primary = 1, title = "Are you ready?" },
        parts = function(f: Frame): Parts
            local l = frames.find("ReadyCheckListenerFrame") or f
            return {
                buttons = function(): Shown[] return shownButtons(field(l, "YesButton"), field(l, "NoButton")) end,
                text = function(): string? return textOf(field(l, "Text")) end,
                time = function(): (number?, number?)
                    local ends = M.readyEndsAt
                    if ends then return M.readyDuration, math.max(0, ends - GetTime()) end
                    return nil, nil
                end,
            }
        end,
    },
}

--------------------------------------------------------------------------------
-- A note's secure macro button
--------------------------------------------------------------------------------

-- A note's action with `macro` (0.13): a secure button over its button
-- that runs the macro (SecureActions); hovering it hovers the button under
-- it, and the action's onClick runs after the macro.
class MacroButton extends Button
    over: Button? = nil
    after: (() -> ())? = nil

    constructor()
        super(nil, UIParent, "SecureActionButtonTemplate")
        self:RegisterForClicks("LeftButtonDown", "LeftButtonUp")
        self:SetFrameStrata("DIALOG")
        self:SetScript("OnEnter", function(me) me:Pass("OnEnter") end)
        self:SetScript("OnLeave", function(me) me:Pass("OnLeave") end)
        self:SetScript("PostClick", function(me) local after = me.after if after then after() end end)
    end

    -- The button under it gets the hover.
    function Pass(script: "OnEnter" | "OnLeave")
        local over = self.over
        local fn = over and over:GetScript(script)
        if over and fn then fn(over) end
    end

    function Release()
        self:Hide()
        self:ClearAllPoints()
        self.over, self.after = nil, nil
    end
end

