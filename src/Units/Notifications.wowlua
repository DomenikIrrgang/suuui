class NotificationsModule extends Module<typeof(DEFAULTS)>
    frame: Frame? = nil
    stack: NotificationStack? = nil
    preview: NotificationStack? = nil
    -- SuuUI.Notify's notes by id, and their order
    readonly notes: { [string]: NotificationData } = {}
    readonly noteOrder: string[] = {}
    -- when a timed or counting note ends, by id
    readonly endsAt: { [string]: number } = {}
    -- the hosted windows, by window; the windows whose hiding is hooked
    readonly hosts: { [Frame]: Host } = {}
    readonly hookedHide: { [Frame]: boolean } = {}
    -- SuuUI's art behind the game's buttons and role buttons, by button
    readonly arts: { [Frame]: ButtonArt } = {}
    readonly roleArts: { [Frame]: RoleArt } = {}
    -- the widths kept on the game's buttons, and which are hooked for it
    readonly widths: { [Frame]: number } = {}
    readonly widthHooked: { [Frame]: boolean } = {}
    sizing: boolean = false
    hooked: boolean = false
    -- in a fight from its event on (the lockdown comes a moment later)
    fighting: boolean = false
    -- the notes' secure macro buttons, by note id and action
    readonly secure: { [string]: MacroButton } = {}
    readyDuration: number? = nil
    readyEndsAt: number? = nil
    -- what the notes about the game last said
    durabilityState: string? = nil
    talentPointsShown: string? = nil
    legacyPointsShown: number? = nil
    -- friends coming and going, waiting to share a card, by kind and way
    presence: { [string]: Arrivals }? = nil
    presenceCount: number = 0
    presenceHooked: boolean = false
    awaitInvite: AwaitInvite? = nil
    -- the characters Battle.net friends play, by account
    readonly bnetCharacters: { [number]: string } = {}

    constructor()
        super({
            id = "notifications",
            name = "Notifications",
            description = "Requests (invites, resurrection, summons, duels, trades, deleting items, logging out) and notes as SuuUI cards at the top left.",
            api = "0.11",
            combatSafe = true,
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    --------------------------------------------------------------------------------
    -- Notes (SuuUI.Notify)
    --------------------------------------------------------------------------------

    -- def: { id?, kind = "timed"|"sticky"|"until"|"roll", category, title, body,
    -- icon, tone, duration (timed, default 8), ["until"] (the text), actions }
    -- → id. A request (roll) with duration and remaining counts down on its own
    -- and stays until it is dismissed.
    function Notify(def: NotificationData?): string?
        if type(def) ~= "table" then return nil end
        nextNote = nextNote + 1
        local given = def.id
        local id = given and tostring(given) or ("note:" .. nextNote)
        local d = tbl.shallowCopy(def)
        d.id = id
        local kind = d.kind or "timed"
        d.kind = kind
        local remaining = d.remaining
        self.endsAt[id] = nil
        if kind == "timed" then
            local duration = d.duration or 8
            d.duration, d.remaining = duration, duration
            self.endsAt[id] = GetTime() + duration
        elseif d.duration and remaining then
            self.endsAt[id] = GetTime() + remaining
        end
        d.onClose = function() self:Dismiss(id) end
        -- the same id again: replaced in place
        if not self.notes[id] then self.noteOrder[#self.noteOrder + 1] = id end
        self.notes[id] = d
        self:Rebuild()
        return id
    end

    function Dismiss(id: string)
        if not self.notes[id] then return end
        self.notes[id] = nil
        self.endsAt[id] = nil
        for i, x in ipairs(self.noteOrder) do
            if x == id then table.remove(self.noteOrder, i) break end
        end
        self:Rebuild()
    end

    function DismissAll()
        for id, d in pairs(self.notes) do
            if d.kind == "sticky" then self:Dismiss(id) end
        end
    end

    --------------------------------------------------------------------------------
    -- SuuUI's own notes about the game
    --------------------------------------------------------------------------------

    function CheckDurability()
        local d = SuuUI.Durability()
        local state: string
        local title: string?, body: string? = nil, nil
        local actions: NotificationAction[]? = nil
        if not self:Get("durability") then
            state = "fine"
        elseif d then
            -- the Durability module's line and reading
            state = d.state
            if state ~= "fine" and d.parts.note then
                title, body = namedNote(d)
                actions = { { label = "Show repairers", variant = "primary", icon = "map", onClick = showRepairers } }
            end
        else
            local worst = worstDurability()
            state = (worst and worst <= 0 and "broken") or (worst and worst <= 0.2 and "damaged") or "fine"
        end
        -- only when it changes (durability moves with every hit in combat)
        local key = state .. "|" .. (title or "") .. "|" .. (body or "")
        if key == self.durabilityState then return end
        self.durabilityState = key
        if state == "broken" then
            self:Notify({ id = "suu:durability", kind = "until", tone = "danger", category = "Durability",
                title = title or "Some of your gear is broken", body = body, icon = { glyph = "anvil" },
                ["until"] = "Goes when you repair", actions = actions })
        elseif state == "damaged" then
            self:Notify({ id = "suu:durability", kind = "until", tone = "warning", category = "Durability",
                title = title or "Your gear is badly damaged", body = body, icon = { glyph = "anvil" },
                ["until"] = "Goes when you repair", actions = actions })
        elseif self.notes["suu:durability"] then
            self:Dismiss("suu:durability")
        end
    end

    function CheckBags()
        if self:Get("bagsFull") and freeSlots() == 0 then
            if not self.notes["suu:bags"] then
                self:Notify({ id = "suu:bags", kind = "until", tone = "warning", category = "Bags",
                    title = "Your bags are full", icon = { glyph = "bag" }, ["until"] = "Goes when you free a slot" })
            end
        elseif self.notes["suu:bags"] then
            self:Dismiss("suu:bags")
        end
    end

    function CheckTalents()
        local n = self:Get("talentPoints") and unspentTalents() or 0
        -- with a talent build followed, the note names its next talent (design I)
        local nextTalent = n > 0 and SuuUI.TalentBuildNext() or nil
        local key = n .. (nextTalent and (":" .. nextTalent.node .. ":" .. nextTalent.rank) or "")
        if key == self.talentPointsShown then return end
        self.talentPointsShown = key
        if n > 0 then
            local talents = SuuUI.GetModule("talents")
            local actions: NotificationAction[]? = nil
            if talents and talents:IsEnabled() then
                actions = { { label = "Open talents", variant = "primary", onClick = function()
                    if not SuuUI.TalentsShown() then SuuUI.ToggleTalents() end
                end } }
            end
            local title = n == 1 and "1 talent point to spend" or (n .. " talent points to spend")
            local body: string? = nil
            local icon: NotificationIcon = { glyph = "tree" }
            if nextTalent then
                title = ("%d talent %s · next: %s"):format(n, n == 1 and "point" or "points", nextTalent.name)
                body = ("Rank %d of %d · %s"):format(nextTalent.rank, nextTalent.max, nextTalent.build)
                if nextTalent.icon then icon = { texture = nextTalent.icon } end
            end
            self:Notify({ id = "suu:talents", kind = "until", tone = "info", category = "Talents",
                title = title, body = body, icon = icon,
                ["until"] = n == 1 and "Goes when you spend it" or "Goes when you spend them", actions = actions })
        elseif self.notes["suu:talents"] then
            self:Dismiss("suu:talents")
        end
    end

    function CheckLegacy()
        local n = self:Get("legacyPoints") and unspentLegacy() or 0
        if n == self.legacyPointsShown then return end
        self.legacyPointsShown = n
        if n > 0 then
            self:Notify({ id = "suu:legacy", kind = "until", tone = "info", category = "Legacy",
                title = n == 1 and "1 Legacy point to spend" or (n .. " Legacy points to spend"),
                icon = { glyph = "trophy" }, ["until"] = "Goes when you spend them",
                actions = { { label = "Open Legacy", variant = "primary", onClick = openLegacy } } })
        elseif self.notes["suu:legacy"] then
            self:Dismiss("suu:legacy")
        end
    end

    --------------------------------------------------------------------------------
    -- Friends and guild members coming online and going offline
    --------------------------------------------------------------------------------

    -- A character friend or guild member by name: kind and the card's person.
    function WhoIs(name: string): (PresenceKind?, Person?)
        local short = Ambiguate(name, "short")
        local info = errors.tryValue(C_FriendList and C_FriendList.GetFriendInfo, short)
        if info and secret.readable(info.name) then
            local file: string? = nil
            if info.guid then
                local _, english = GetPlayerInfoByGUID(info.guid)
                file = asString(english)
            end
            file = file or CLASS_FILES[info.className or ""]
            local where: string[] = {}
            local level = asNumber(info.level)
            if level and level > 0 then where[#where + 1] = "Level " .. level end
            local area = asString(info.area)
            if area and area ~= "" then where[#where + 1] = area end
            return "friend", { name = short, color = classColor(file), icon = classIcon(file),
                detail = table.concat(where, " · "), whisper = function() chat.whisper(name) end, inviteName = name }
        end
        if IsInGuild() then
            for i = 1, (GetNumGuildMembers()) or 0 do
                local full, rank, _, level, _, zone, _, _, _, _, file = GetGuildRosterInfo(i)
                if full and Ambiguate(full, "short") == short then
                    local where: string[] = {}
                    if rank and rank ~= "" then where[#where + 1] = rank end
                    if level and level > 0 then where[#where + 1] = "Level " .. level end
                    if zone and zone ~= "" then where[#where + 1] = zone end
                    return "guild", { name = short, color = classColor(file), icon = classIcon(file),
                        detail = table.concat(where, " · "), whisper = function() chat.whisper(full) end, inviteName = full }
                end
            end
        end
        return nil, nil
    end

    -- A Battle.net friend's card person (their account name is protected text
    -- the game draws; SuuUI never reads it).
    function BnetPerson(accountID: number): Person?
        local info = errors.tryValue(C_BattleNet and C_BattleNet.GetAccountInfoByID, accountID)
        if not info then return nil end
        local game: BNetGameAccountInfo? = info.gameAccountInfo
        local account = info.accountName
        local person: Person = { name = account or info.battleTag or "?", bnetID = accountID }
        local tag = asString(info.battleTag)
        if tag then person.tag = tag:match("(#%d+)$") end
        person.whisper = function()
            if account then chat.whisperBnet(account) end
        end
        -- the character they play, remembered so going offline matches too
        local character = game and asString(game.characterName)
        if character and character ~= "" then self.bnetCharacters[accountID] = character end
        person.character = self.bnetCharacters[accountID]
        if game and game.clientProgram == (BNET_CLIENT_WOW or "WoW") and character then
            local file = CLASS_FILES[game.className or ""]
            person.color = classColor(file)
            person.icon = classIcon(file)
            local presence = asString(game.richPresence)
            local where = (presence and presence ~= "" and presence) or asString(game.areaName) or "World of Warcraft"
            person.detail = character .. " · " .. where
            -- invited by their game account, as the game's friends list does (by
            -- name and realm the game didn't find them; found in game)
            if canCooperate(game) then
                local id = game.gameAccountID
                person.invite = function() unit.inviteBnet(id) end
            end
        else
            person.detail = GAMES[game and game.clientProgram or ""] or "Battle.net"
        end
        return person
    end

    -- One more arrival or departure; a card once the burst is over.
    function Presence(kind: PresenceKind, online: boolean, person: Person?)
        local k = KINDS_OF[kind]
        if not person then return end
        if not self:Get((k.setting .. (online and "Online" or "Offline")) :: PresenceKey) then return end
        local queue = self.presence or {}
        self.presence = queue
        local key = kind .. (online and "+" or "-")
        local q = queue[key]
        if not q then
            local fresh: Arrivals = { kind = kind, online = online, people = {} }
            q = fresh
            queue[key] = fresh
            timer.after(BATCH, function() self:FlushPresence(key) end)
        end
        for _, x in ipairs(q.people) do if x.name == person.name then return end end
        q.people[#q.people + 1] = person
    end

    -- The characters your Battle.net friends play (now, or last seen): a
    -- guild member or friend who is one of them gets the Battle.net card only.
    function BnetCharacterSet(): { [string]: boolean }
        local out: { [string]: boolean } = {}
        local function add(name: string)
            out[wholeName(name)] = true
            -- a first name alone matches only a name without a surname
            out["first:" .. firstName(name)] = true
        end
        for _, name in pairs(self.bnetCharacters) do add(name) end
        for i = 1, asNumber((try(field(_G, "BNGetNumFriends")))) or 0 do
            local info = errors.tryValue(C_BattleNet and C_BattleNet.GetFriendAccountInfo, i)
            local name = info and info.gameAccountInfo and asString(info.gameAccountInfo.characterName)
            if name and name ~= "" then add(name) end
        end
        return out
    end

    function FlushPresence(key: string)
        local queue = self.presence
        local q = queue and queue[key]
        if not (queue and q) then return end
        -- in combat they wait for the fight's end
        if InCombatLockdown() then q.held = true return end
        queue[key] = nil
        -- someone who is a guild member (or friend) and a Battle.net friend: one
        -- card, the Battle.net one (asked 2026-10-18: two cards for one person)
        if q.kind ~= "bnet" then
            local bnet = self:BnetCharacterSet()
            local kept: Person[] = {}
            for _, p in ipairs(q.people) do
                local whole = wholeName(p.name)
                local same = bnet[whole] or (not whole:find(" ") and bnet["first:" .. firstName(p.name)])
                if not same then kept[#kept + 1] = p end
            end
            q.people = kept
        end
        if not self:IsEnabled() or #q.people == 0 then return end
        local k = KINDS_OF[q.kind]
        local source = k.source or asString((GetGuildInfo("player"))) or "Guild"
        -- Battle.net friends as they are now: by the event their character
        -- often wasn't there yet
        if q.kind == "bnet" then
            for i, p in ipairs(q.people) do
                local id = p.bnetID
                q.people[i] = id and self:BnetPerson(id) or p
            end
        end
        local single: Person? = #q.people == 1 and q.people[1] or nil
        self.presenceCount = self.presenceCount + 1
        local id = "suu:presence:" .. self.presenceCount
        local function show()
            local invite: (() -> ())? = nil
            local one = single
            if q.online and one then
                local name = one.inviteName
                invite = one.invite or (name and inviting(name)) or nil
            end
            self:Notify({ id = id, kind = "timed", duration = q.online and 6 or 4,
                presence = { online = q.online, source = source, people = cardPeople(q.people), plural = k.plural,
                             glyph = k.glyph, invite = invite } })
        end
        show()
        -- one Battle.net friend still loading in: the card gains Invite when
        -- their character arrives on your realm and side, while it shows
        local waiting: number? = nil
        if q.online and single and not single.invite then waiting = single.bnetID end
        if waiting then
            self.awaitInvite = { id = id, bnetID = waiting, refresh = function(person: Person)
                q.people[1], single = person, person
                show()
            end }
        end
    end

    -- A Battle.net friend's info changed: the card waiting for their character.
    function BnetInfoChanged()
        local w = self.awaitInvite
        if not w then return end
        if not self.notes[w.id] then self.awaitInvite = nil return end
        local person = self:BnetPerson(w.bnetID)
        if person and person.invite then
            self.awaitInvite = nil
            w.refresh(person)
        end
    end

    -- The game's system line: who, and whether it's theirs to show.
    function SystemLine(msg: unknown)
        local text = asString(msg)
        if not text then return end
        local online = true
        local name: string? = nil
        if ONLINE then
            local _, n = text:match(ONLINE)
            name = n
        end
        if not name and OFFLINE then
            name = text:match(OFFLINE)
            online = false
        end
        if not name or Ambiguate(name, "short") == asString(SuuUI.FullName("player")) then return end
        -- a link's name keeps its colour codes out
        local plain = name:gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", "")
        local kind, person = self:WhoIs(plain)
        if kind then self:Presence(kind, online, person) end
    end

    function HookPresence()
        if self.presenceHooked then return end
        self.presenceHooked = true
        chat.filter("CHAT_MSG_SYSTEM", function(msg: unknown): boolean
            return self:IsEnabled() and self:Get("presenceHideChat") and isPresenceLine(msg)
        end)
        chat.filter("CHAT_MSG_BN_INLINE_TOAST_ALERT", function(process: unknown): boolean
            return self:IsEnabled() and self:Get("presenceHideChat") and (process == "FRIEND_ONLINE" or process == "FRIEND_OFFLINE")
        end)
        -- Battle.net's own toast (bottom right) for the same: away while SuuUI
        -- shows Battle.net friends
        local toast = frames.find("BNToastFrame")
        if toast then
            hookScript(toast, "OnShow", function(f: Frame)
                if not self:IsEnabled() then return end
                local t = asNumber(field(f, "toastType"))
                local online = t == (asNumber(field(_G, "BN_TOAST_TYPE_ONLINE")) or 1)
                local offline = t == (asNumber(field(_G, "BN_TOAST_TYPE_OFFLINE")) or 2)
                if (online and self:Get("presenceBnetOnline")) or (offline and self:Get("presenceBnetOffline")) then f:Hide() end
            end)
        end
    end

    -- Test: one card of each (no one has to log in). The single cards are your
    -- own character, so Whisper and Invite really act (on you); the group card
    -- is made up.
    function TestPresence()
        -- the whole name: Forever's characters have a surname (UnitName's
        -- second value), which whispers need
        local full = asString(SuuUI.FullName("player")) or asString(UnitName("player")) or "?"
        local _, classFile = UnitClass("player")
        local file = asString(classFile)
        local zone = GetRealZoneText()
        local function mine(detail: string): Person
            return { name = full, color = classColor(file), icon = classIcon(file), detail = detail,
                     whisper = function() chat.whisper(full) end, inviteName = full }
        end
        local function sample(name: string, f: string): Person
            return { name = name, color = classColor(f), icon = classIcon(f), whisper = function() chat.whisper(name) end }
        end
        local function card(kind: PresenceKind, online: boolean, people: Person[])
            local k = KINDS_OF[kind]
            local single: Person? = #people == 1 and people[1] or nil
            local name = single and single.inviteName
            self.presenceCount = self.presenceCount + 1
            self:Notify({ id = "suu:presence:" .. self.presenceCount, kind = "timed", duration = online and 20 or 15,
                presence = { online = online, source = k.source or asString((GetGuildInfo("player"))) or "Guild",
                             people = cardPeople(people), plural = k.plural, glyph = k.glyph,
                             invite = online and name and inviting(name) or nil } })
        end
        local bn = mine(full .. " · " .. zone)
        bn.tag = "#1137"
        card("bnet", true, { bn })
        card("friend", true, { mine("Level " .. UnitLevel("player") .. " · " .. zone) })
        local _, rank = GetGuildInfo("player")
        local ranked = asString(rank)
        card("guild", true, { mine((ranked and (ranked .. " · ") or "") .. "Level " .. UnitLevel("player") .. " · " .. zone) })
        card("guild", true, { sample("Lyra", "MAGE"), sample("Thorn", "ROGUE"), sample("Maelis", "PALADIN"), sample("Durn", "HUNTER") })
        card("guild", false, { sample("Ysolde", "DRUID") })
    end

    --------------------------------------------------------------------------------
    -- Hosting Blizzard's popups
    --------------------------------------------------------------------------------

    -- What we change on a Blizzard button or edit box, and how it was.
    function Remember(h: Host, f: Frame): Saved
        local saved = h.saved or {}
        h.saved = saved
        local known = saved[f]
        if known then return known end
        local s: Saved = { points = savePoints(f), width = f:GetWidth(), height = f:GetHeight(), alphas = {},
            strata = f:GetFrameStrata(), level = f:GetFrameLevel() }
        for _, r in ipairs(frames.textures(f)) do s.alphas[r] = r:GetAlpha() end
        local b = frames.asButton(f)
        if b then
            -- a button's state textures (not always among its regions)
            for _, t in ipairs(frames.stateTextures(b)) do
                if s.alphas[t] == nil then s.alphas[t] = t:GetAlpha() end
            end
            local fs = b:GetFontString()
            if fs then s.font, s.fs, s.color = fs:GetFontObject(), fs, { fs:GetTextColor() } end
        end
        local eb = frames.asEditBox(f)
        if eb then s.font = eb:GetFontObject() end
        saved[f] = s
        return s
    end

    function Undo(h: Host)
        local saved = h.saved
        if not saved then return end
        -- every part loose first: the buttons hang off each other here (each
        -- beside the next) and in Blizzard's layout the other way round, so
        -- restoring one by one anchored a button to one depending on it (an
        -- error, found in game)
        for f in pairs(saved) do f:ClearAllPoints() end
        for f, s in pairs(saved) do
            self.widths[f] = nil
            restorePoints(f, s.points)
            f:SetSize(s.width, s.height)
            f:SetFrameStrata(s.strata)
            f:SetFrameLevel(s.level)
            for r, a in pairs(s.alphas) do r:SetAlpha(a) end
            local fs, font, color = s.fs, s.font, s.color
            if fs and font then fs:SetFontObject(font) end
            if fs and color then fs:SetTextColor(color[1], color[2], color[3], color[4]) end
            local eb = frames.asEditBox(f)
            if eb and font then eb:SetFontObject(font) end
            local art = self.arts[f]
            if art then art:Hide() end
            local roleArt = self.roleArts[f]
            if roleArt then roleArt:Hide() end
        end
        h.saved = nil
    end

    -- SuuUI's look behind a Blizzard button (ButtonArt).
    function ArtFor(b: Button, stack: NotificationStack): ButtonArt
        local known = self.arts[b]
        if known then return known end
        local art = ButtonArt.new(stack)
        self.arts[b] = art
        hookScript(b, "OnEnter", function()
            if not art:IsShown() then return end
            if art.variant == "primary" then art.glow:SetShown(true) else art.edge:SetColor(art.variant == "danger" and "ember" or "gilt") end
        end)
        hookScript(b, "OnLeave", function()
            if not art:IsShown() then return end
            art.glow:SetShown(false)
            art.edge:SetColor(art.variant == "primary" and "arcane" or art.variant == "danger" and "ember" or "gilt-line")
        end)
        return art
    end

    function StyleButton(h: Host, b: Button, variant: string, stack: NotificationStack): number
        local s = self:Remember(h, b)
        for r in pairs(s.alphas) do r:SetAlpha(0) end
        local fs = b:GetFontString()
        if fs then
            fs:SetFontObject(SuuUI.Fonts.Get("label"))
            -- the game's own text: set plainly, again by Rebuild after a theme change
            fs:SetTextColor(UI.RGBA(variant == "primary" and "on-signal" or variant == "danger" and "ember-text" or "ink"))
        end
        local w = math.max(64, math.ceil((fs and fs:GetUnboundedStringWidth() or 40) + S["space-4"] * 2))
        -- and kept: Blizzard sizes its popup buttons again after showing them
        -- (both 120 wide on the death popup, found in game: Release Spirit
        -- over Recap)
        self.widths[b] = w
        if not self.widthHooked[b] then
            self.widthHooked[b] = true
            local function keep()
                local want = self.widths[b]
                if not want or self.sizing or math.abs(b:GetWidth() - want) < 0.5 then return end
                self.sizing = true
                b:SetSize(want, ACTION_H)
                self.sizing = false
            end
            hook(b, "SetWidth", keep)
            hook(b, "SetSize", keep)
        end
        b:SetSize(w, ACTION_H)
        local art = self:ArtFor(b, stack)
        art.variant = variant
        art:SetFrameStrata(b:GetFrameStrata())
        art:SetFrameLevel(math.max(0, b:GetFrameLevel() - 1))
        art:ClearAllPoints()
        art:SetAllPoints(b)
        UI.PaintFill(art.fill, variant == "primary" and "arcane" or "surface-raised")
        art.edge:SetColor(variant == "primary" and "arcane" or variant == "danger" and "ember" or "gilt-line")
        art.glow:SetShown(false)
        art:Show()
        return w
    end

    function StyleEditBox(h: Host, eb: EditBox, box: Frame)
        local s = self:Remember(h, eb)
        for r in pairs(s.alphas) do r:SetAlpha(0) end
        eb:SetFontObject(SuuUI.Fonts.Get("body"))
        eb:ClearAllPoints()
        eb:SetPoint("TOPLEFT", box, "TOPLEFT", S["space-4"], 0)
        eb:SetPoint("BOTTOMRIGHT", box, "BOTTOMRIGHT", -S["space-4"], 0)
    end

    -- The card's data for a hosted popup.
    function CardData(h: Host): NotificationData
        local kind = h.kind
        local roles, warn = h.roles, h.warning
        local d: NotificationData = {
            id = h.id, kind = "action", tone = kind.tone, category = kind.category,
            title = h.text() or kind.title or "", icon = { glyph = kind.glyph },
            host = { buttons = #h.buttons(), roles = roles and #roles() or nil },
        }
        local warning = warn and warn()
        if warning and warning ~= "" then d.warning = warning end
        local duration, remaining = h.time()
        if duration then d.duration, d.remaining = duration, remaining end
        if kind.item then
            local what = GetCursorInfo()
            local link = asString((select(3, GetCursorInfo())))
            if what == "item" and link then
                local data = item.get(link)
                local qualities: { [number]: string } = { [0] = "poor", "common", "uncommon", "rare", "epic", "legendary" }
                d.item = { icon = data and data.icon, label = data and data.name or link,
                           quality = qualities[data and data.quality or 1] or "common" }
            end
        end
        -- a cost the game's popup shows in its money frame, on its own line
        local costOf = kind.cost
        local cost = costOf and costOf(h.dialog)
        h.cost = cost
        if cost then d.body = "Costs " .. coinString(cost) end
        local eb = h.editBox
        if kind.confirm and eb and eb:IsShown() then
            d.confirmText = DELETE_ITEM_CONFIRM_STRING or "DELETE"
        end
        return d
    end

    -- The popup's own buttons and edit box onto its card.
    function Attach(h: Host)
        local stack = self.stack
        local card = stack and stack:CardFor(h.id)
        if not (stack and card) then
            -- not among the shown cards: its parts back in the (off screen) popup
            self:Undo(h)
            h.card = nil
            return
        end
        h.card = card
        local kind = h.kind
        -- right to left, each beside the one after it: a width Blizzard sets
        -- later can't make them overlap
        local list = h.buttons()
        local prev: Button? = nil
        for k = #list, 1, -1 do
            local b, index = list[k].button, list[k].index
            local variant = (index == kind.primary and "primary") or (index == kind.danger and "danger") or "quiet"
            -- over their card, which is on the dialog layer now
            self:Remember(h, b)
            b:SetFrameStrata(card:GetFrameStrata())
            b:SetFrameLevel(card:GetFrameLevel() + 10)
            self:StyleButton(h, b, variant, stack)
            b:ClearAllPoints()
            if prev then
                b:SetPoint("RIGHT", prev, "LEFT", -S["space-3"], 0)
            else
                b:SetPoint("RIGHT", card.actionsRow, "RIGHT", 0, 0)
            end
            prev = b
        end
        local eb = h.editBox
        local data = card.data
        if data and data.confirmText and eb then
            self:Remember(h, eb)
            eb:SetFrameStrata(card:GetFrameStrata())
            eb:SetFrameLevel(card:GetFrameLevel() + 10)
            self:StyleEditBox(h, eb, card.confirmBox)
        end
        local roles = h.roles
        if roles then
            for i, b in ipairs(roles()) do self:HostRole(h, card, b, i, stack) end
        end
    end

    -- A role button's toggle (RoleArt), drawn again whenever the game changes
    -- the button or its checkbox.
    function RoleArtFor(b: Button, cb: CheckButton?, stack: NotificationStack): RoleArt
        local known = self.roleArts[b]
        if known then return known end
        local art = RoleArt.new(stack, b, cb)
        local function draw() art:Draw() end
        for _, m in ipairs({ "Enable", "Disable", "SetEnabled" }) do hook(b, m, draw) end
        if cb then
            for _, m in ipairs({ "SetChecked", "Show", "Hide" }) do hook(cb, m, draw) end
            hookScript(cb, "OnClick", draw)
        end
        hookScript(b, "OnEnter", function() art.hover = true; art:Draw() end)
        hookScript(b, "OnLeave", function() art.hover = false; art:Draw() end)
        self.roleArts[b] = art
        return art
    end

    function HostRole(h: Host, card: Notification, b: Button, i: number, stack: NotificationStack)
        local cb = frames.asCheckButton(field(b, "checkButton"))
        local s = self:Remember(h, b)
        for r in pairs(s.alphas) do r:SetAlpha(0) end
        b:SetFrameStrata(card:GetFrameStrata())
        b:SetFrameLevel(card:GetFrameLevel() + 10)
        b:SetSize(36, 36)
        b:ClearAllPoints()
        b:SetPoint("TOP", card.rolesRow, "TOPLEFT", 30 + (i - 1) * 60, 0)
        if cb then
            local cs = self:Remember(h, cb)
            for r in pairs(cs.alphas) do r:SetAlpha(0) end
            -- 14px on screen (the game draws it at 0.7)
            local scale = cb:GetScale() > 0 and cb:GetScale() or 1
            cb:SetSize(14 / scale, 14 / scale)
            cb:ClearAllPoints()
            cb:SetPoint("BOTTOMRIGHT", b, "BOTTOMRIGHT", 3 / scale, -3 / scale)
        end
        local art = self:RoleArtFor(b, cb, stack)
        art:SetFrameStrata(card:GetFrameStrata())
        art:SetFrameLevel(card:GetFrameLevel() + 9)
        art:ClearAllPoints()
        art:SetAllPoints(b)
        local role = asString(field(b, "role")) or ""
        art.glyph:SetTexture(TEXTURES .. (ROLE_TEX[role] or "RoleDamage.tga"))
        art.word:SetValue(ROLE_WORD[role] or "")
        if cb then
            art.box:ClearAllPoints()
            art.box:SetPoint("BOTTOMRIGHT", art, "BOTTOMRIGHT", 3, -3)
        end
        art:Show()
        art:Draw()
    end

    -- A Blizzard popup: its buttons, text, time left and edit box.
    function Host(dialog: Frame, which: string)
        local kind = kindOf(which)
        if not kind then return end
        local info = field(_G, "StaticPopupDialogs", which)
        self:HostFrame(dialog, which, kind, {
            buttons = function(): Shown[] return buttonsOf(dialog) end,
            text = function(): string? return textOf(field(dialog, "Text")) end,
            time = function(): (number?, number?)
                local timeout, left = asNumber(field(info, "timeout")), asNumber(field(dialog, "timeleft"))
                if timeout and timeout > 0 and left then return timeout, left end
                return nil, nil
            end,
            editBox = frames.asEditBox(field(dialog, "EditBox")),
        })
    end

    -- Any Blizzard request window: `parts` says where its buttons ({ button,
    -- index } in order), text, time (duration, remaining) and edit box are.
    function HostFrame(dialog: Frame, which: string, kind: Kind, parts: Parts)
        if not self:Get("requests") then return end
        local known = self.hosts[dialog]
        if known and known.which ~= which then self:Undo(known) end
        local h: Host = known or { dialog = dialog, order = GetTime(), which = which, kind = kind, id = "",
            buttons = parts.buttons, text = parts.text, time = noTime, data = {} }
        if not known then
            self.hosts[dialog] = h
            if not self.hookedHide[dialog] then
                self.hookedHide[dialog] = true
                hookScript(dialog, "OnHide", function() self:Release(dialog) end)
            end
        end
        h.which, h.kind = which, kind
        h.buttons, h.text, h.time, h.editBox = parts.buttons, parts.text, parts.time or noTime, parts.editBox
        h.roles, h.warning = parts.roles, parts.warning
        h.id = "popup:" .. (dialog:GetName() or tostring(dialog))
        -- the popup itself out of sight (its parts come onto the card); kept on
        -- screen by its clamp otherwise
        if h.clamped == nil then h.clamped = dialog:IsClampedToScreen() and true or false end
        dialog:SetClampedToScreen(false)
        dialog:ClearAllPoints()
        dialog:SetPoint("BOTTOMRIGHT", UIParent, "TOPLEFT", -OFF_SCREEN, OFF_SCREEN)
        h.data = self:CardData(h)
        self:Rebuild()
    end

    function Release(dialog: Frame)
        local h = self.hosts[dialog]
        if not h then return end
        self:Undo(h)
        local clamped = h.clamped
        if clamped ~= nil then dialog:SetClampedToScreen(clamped) end
        self.hosts[dialog] = nil
        self:Rebuild()
    end

    function HookWindows()
        for _, w in ipairs(WINDOWS) do
            local f = frames.find(w.name)
            if f and not self.hookedHide[f] then
                self.hookedHide[f] = true
                hookScript(f, "OnShow", function(frame: Frame)
                    if self:IsEnabled() then self:HostFrame(frame, w.name, w.kind, w.parts(frame)) end
                end)
                hookScript(f, "OnHide", function(frame: Frame) self:Release(frame) end)
                if f:IsShown() then self:HostFrame(f, w.name, w.kind, w.parts(f)) end
            end
        end
    end

    --------------------------------------------------------------------------------
    -- The stack
    --------------------------------------------------------------------------------

    function Items(): NotificationData[]
        local list: NotificationData[] = {}
        local hosts: Host[] = {}
        for _, h in pairs(self.hosts) do hosts[#hosts + 1] = h end
        table.sort(hosts, function(a: Host, b: Host): boolean return a.order < b.order end)
        for _, h in ipairs(hosts) do list[#list + 1] = h.data end
        for _, id in ipairs(self.noteOrder) do
            local n = self.notes[id]
            if n then list[#list + 1] = n end
        end
        return list
    end

    function Rebuild()
        local stack = self.stack
        if not stack then return end
        -- (in a fight from its event on: the lockdown itself comes a moment later)
        stack:SetItems(self:Items(), InCombatLockdown() or self.fighting)
        for _, h in pairs(self.hosts) do self:Attach(h) end
        self:SecureActions()
    end

    -- A note's action with `macro` (0.13): a secure button over its button
    -- that runs the macro, for what only a secure click may do (opening the
    -- game's Group Finder at its listing panel: opened from addon code, the
    -- panel's listing would be refused). Placed by screen position, never
    -- anchored to the card (a secure frame anchored to it would make the
    -- stack protected); out of combat only: hidden as a fight starts, the
    -- button then says why it can't.
    function SecureActions()
        local stack = self.stack
        if InCombatLockdown() or self.fighting or not stack then return end
        local used: { [string]: boolean } = {}
        local ui = UIParent:GetEffectiveScale()
        for id, d in pairs(self.notes) do
            for i, a in ipairs(d.actions or {}) do
                local macro = a.macro
                local card = macro and stack:CardFor(id) or nil
                local pool = card and card.buttons[a.variant or "quiet"]
                local b = pool and pool[i]
                local left, bottom = b and b:GetLeft(), b and b:GetBottom()
                if macro and card and b and b:IsVisible() and left and bottom then
                    local key = id .. "#" .. i
                    local s = self.secure[key]
                    if not s then
                        s = MacroButton.new()
                        self.secure[key] = s
                    end
                    local scale = b:GetEffectiveScale() / ui
                    s:ClearAllPoints()
                    s:SetPoint("BOTTOMLEFT", UIParent, "BOTTOMLEFT", left * scale, bottom * scale)
                    s:SetSize(b:GetWidth() * scale, b:GetHeight() * scale)
                    local text: string
                    if type(macro) == "function" then text = macro() else text = macro end
                    s:SetAttribute("type1", "macro")
                    s:SetAttribute("macrotext1", text)
                    local onClick, clicked = a.onClick, card
                    s.over, s.after = b, onClick and function() onClick(clicked) end or nil
                    s:Show()
                    used[key] = true
                end
            end
        end
        for key, s in pairs(self.secure) do
            if not used[key] then s:Release() end
        end
    end

    function HideSecureActions()
        for _, s in pairs(self.secure) do s:Release() end
    end

    -- A few times a second: counting titles (logging out in 12 s), time left,
    -- timed notes going, hosted parts kept on their cards (Blizzard lays its
    -- popups out again now and then), popups anchored to a hosted one put back
    -- on screen.
    function Tick()
        local stack = self.stack
        -- notes hide while an open window covers them (requests stay)
        if stack then stack:SetNotesHidden(UI.IsCoveredByWindow(stack)) end
        local now = GetTime()
        local changed = false
        for id, d in pairs(self.notes) do
            local ends = self.endsAt[id]
            if d.kind ~= "timed" and ends then
                local remaining = math.max(0, ends - now)
                d.remaining = remaining
                local card = stack and stack:CardFor(id)
                if card then card:SetRemaining(remaining) end
            elseif d.kind == "timed" and ends then
                local remaining = ends - now
                d.remaining = remaining
                if remaining <= 0 then
                    self.notes[id] = nil
                    self.endsAt[id] = nil
                    for i, x in ipairs(self.noteOrder) do if x == id then table.remove(self.noteOrder, i) break end end
                    changed = true
                else
                    local card = stack and stack:CardFor(id)
                    if card then card:SetRemaining(remaining) end
                end
            end
        end
        if changed then self:Rebuild() else self:SecureActions() end
        for dialog, h in pairs(self.hosts) do
            local card = h.card
            if card then
                local text = h.text()
                if text and text ~= h.data.title then
                    h.data.title = text
                    card:SetTitle(text)
                end
                if h.data.duration then
                    local _, remaining = h.time()
                    if remaining then card:SetRemaining(remaining) end
                end
                local point, rel = dialog:GetPoint(1)
                if point ~= "BOTTOMRIGHT" or rel ~= UIParent then
                    dialog:ClearAllPoints()
                    dialog:SetPoint("BOTTOMRIGHT", UIParent, "TOPLEFT", -OFF_SCREEN, OFF_SCREEN)
                end
                local list = h.buttons()
                local last = list[#list]
                if last then
                    local _, brel = last.button:GetPoint(1)
                    if brel ~= card.actionsRow then self:Attach(h) end
                end
                -- disabled until typed (delete): Blizzard's own rule, shown dim
                for _, x in ipairs(list) do
                    local art = self.arts[x.button]
                    if art then art:SetAlpha(x.button:IsEnabled() and 1 or T.opacity["opacity-disabled"]) end
                end
            end
        end
        -- a popup Blizzard anchored under a hosted one would be off screen too
        for i = 1, 4 do
            local d = frames.find("StaticPopup" .. i)
            if d and d:IsShown() and not self.hosts[d] then
                local _, rel = d:GetPoint(1)
                local under = frames.asFrame(rel)
                if under and self.hosts[under] then
                    d:ClearAllPoints()
                    d:SetPoint("TOP", UIParent, "TOP", 0, -135)
                end
            end
        end
    end

    --------------------------------------------------------------------------------
    -- Settings
    --------------------------------------------------------------------------------

    function PreviewView(parent: Frame): NotificationStack
        local view = self.preview
        if not view then
            view = UI.NotificationStack(parent, { max = 5 })
            view:SetItems(PREVIEW, false)
            self.preview = view
        end
        view:SetParent(parent)
        return view
    end

    --------------------------------------------------------------------------------
    -- Lifecycle
    --------------------------------------------------------------------------------

    override function OnEnable()
        self:ProvideService(NOTIFICATIONS, {
            Notify = function(def: { [string]: unknown }): string? return self:Notify(noteOf(def)) end,
            Dismiss = function(id: string) self:Dismiss(id) end,
        })
        local frame = self.frame
        if not frame then
            frame = CreateFrame("Frame", "SuuUINotifications", SuuUI.Root)
            -- under open windows (HIGH): notes; requests raise themselves
            frame:SetFrameStrata("MEDIUM")
            frame:SetSize(T.size["notice-w"], 200)
            local stack = UI.NotificationStack(frame, { max = self:Get("max") })
            stack:SetPoint("TOPLEFT")
            stack.onExpand = function() self:Rebuild() end
            stack.onClearAll = function() self:DismissAll() end
            self.frame, self.stack = frame, stack
            local wait = 0
            frame:SetScript("OnUpdate", function(_, elapsed)
                wait = wait - elapsed
                if wait > 0 then return end
                wait = 0.1
                self:Tick()
            end)
        end
        self:RegisterMover(frame, { key = "position", label = "Notifications" })
        self:RegisterSettings(SECTION)
        self:Watch("max", function(v)
            local stack = self.stack
            if stack then stack.max = v end
            self:Rebuild()
        end)
        self:Watch("requests", function(on)
            if not on then for dialog in pairs(self.hosts) do self:Release(dialog) end end
        end)
        if not self.hooked and type(StaticPopup_Show) == "function" then
            self.hooked = true
            hook("StaticPopup_Show", function(which: unknown, _: unknown, _: unknown, data: unknown)
                if not self:IsEnabled() then return end
                local name = asString(which)
                local dialog = name and frames.asFrame(try(field(_G, "StaticPopup_FindVisible"), name, data))
                if name and dialog then self:Host(dialog, name) end
            end)
        end
        self:HookWindows()
        -- request windows whose addon loads later
        self:OnGameEvent("ADDON_LOADED", function() self:HookWindows() end)
        -- notes about the game
        for _, e in ipairs({ "UPDATE_INVENTORY_DURABILITY", "PLAYER_ENTERING_WORLD" }) do
            self:OnGameEvent(e, function() self:CheckDurability() end)
        end
        for _, e in ipairs({ "BAG_UPDATE_DELAYED", "PLAYER_ENTERING_WORLD" }) do
            self:OnGameEvent(e, function() self:CheckBags() end)
        end
        self:Watch("durability", function() self:CheckDurability() end)
        -- the Durability module's reading (its line, the pieces' names)
        self:On("SUUUI_DURABILITY_CHANGED", function() self:CheckDurability() end)
        self:On("SUUUI_SERVICE_CHANGED", function(_, name) if name == "durability" then self:CheckDurability() end end)
        self:Watch("bagsFull", function() self:CheckBags() end)
        for _, e in ipairs({ "TRAIT_CONFIG_UPDATED", "TRAIT_TREE_CURRENCY_INFO_UPDATED", "PLAYER_TALENT_UPDATE",
                             "CHARACTER_POINTS_CHANGED", "PLAYER_LEVEL_UP", "PLAYER_ENTERING_WORLD" }) do
            -- a moment later: the points read right only after the change has landed
            self:OnGameEvent(e, function() timer.after(0.2, function() if self:IsEnabled() then self:CheckTalents(); self:CheckLegacy() end end) end)
        end
        self:OnGameEvent("MAJOR_FACTION_RENOWN_LEVEL_CHANGED", function() timer.after(0.2, function() if self:IsEnabled() then self:CheckLegacy() end end) end)
        self:Watch("talentPoints", function() self:CheckTalents() end)
        -- a talent build followed, changed or learned along
        self:On("SUUUI_TALENT_BUILD_CHANGED", function()
            timer.after(0.2, function() if self:IsEnabled() then self:CheckTalents() end end)
        end)
        self:Watch("legacyPoints", function() self:CheckLegacy() end)
        -- the ready check's time
        self:OnGameEvent("READY_CHECK", function(_, _, timeLeft)
            local seconds = asNumber(timeLeft)
            if seconds and seconds > 0 then
                self.readyDuration, self.readyEndsAt = seconds, GetTime() + seconds
            end
        end)
        self:OnGameEvent("READY_CHECK_FINISHED", function() self.readyEndsAt = nil end)
        -- a theme change: the coins' colours in a cost, and the game's button
        -- text (StyleButton through Rebuild)
        self:On("SUUUI_THEME_CHANGED", function()
            for _, h in pairs(self.hosts) do
                local cost = h.cost
                if cost then h.data.body = "Costs " .. coinString(cost) end
            end
            self:Rebuild()
        end)
        -- in combat notes wait; out of it they come back
        -- (the event comes before the lockdown: drawn as in combat from here)
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function() self.fighting = true; self:HideSecureActions(); self:Rebuild() end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self.fighting = false
            self:Rebuild()
            -- online/offline held in the fight
            for key, q in pairs(self.presence or {}) do if q.held then self:FlushPresence(key) end end
        end)
        -- friends and guild members coming and going (handlers take the event
        -- first, then its values: these read one value too far, the companion
        -- app flag and the sender, and no note ever came; found with /suu probe
        -- social)
        self:HookPresence()
        self:OnGameEvent("CHAT_MSG_SYSTEM", function(_, msg) self:SystemLine(msg) end)
        self:OnGameEvent("BN_FRIEND_ACCOUNT_ONLINE", function(_, id)
            local account = asNumber(id)
            if account then self:Presence("bnet", true, self:BnetPerson(account)) end
        end)
        self:OnGameEvent("BN_FRIEND_INFO_CHANGED", function() self:BnetInfoChanged() end)
        self:OnGameEvent("BN_FRIEND_ACCOUNT_OFFLINE", function(_, id)
            local account = asNumber(id)
            if account then self:Presence("bnet", false, self:BnetPerson(account)) end
        end)
        -- the roster asked for now and then, so a guild member's line finds them
        if IsInGuild() then try(field(C_GuildInfo, "GuildRoster")) end
        self:RegisterCommand("presence", "test: shows a card for each kind of friend coming online and going offline", function()
            self:TestPresence()
        end)
        self:RegisterCommand("notify", "test: shows one notification of each kind", function()
            self:Notify({ kind = "timed", category = "Test", title = "A timed note", body = "It goes by itself after 8 seconds.", icon = { glyph = "bell" } })
            self:Notify({ kind = "sticky", category = "Test", title = "A sticky note", body = "It stays until you close it.", icon = { glyph = "mail" } })
            self:Notify({ kind = "until", category = "Test", title = "A condition", ["until"] = "Goes when the test ends", icon = { glyph = "hourglass" }, tone = "warning" })
        end)
    end

    override function OnDisable()
        for dialog in pairs(self.hosts) do self:Release(dialog) end
        local frame = self.frame
        if frame then frame:Hide() end
    end
end

M = SuuUI.AddModule(NotificationsModule.new())
