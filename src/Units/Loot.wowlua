-- Units/Loot.wowlua
-- The loot window (step 2.6a, design board "Loot window and loot rolls"):
-- what a corpse (a chest, a fishing catch) holds, beside the cursor with
-- the first item under it, or at its own place (edit mode). Click a row to
-- take it, shift-click to link; the tooltip is the game's.
-- A built-in module written against the public API only.
--
-- Blizzard's loot frame keeps opening and closing (Esc, bind confirmations
-- and auto loot stay the game's), off screen and see-through; SuuUI's
-- window follows LOOT_OPENED / LOOT_SLOT_CLEARED / LOOT_CLOSED. Taking an
-- item is LootSlot, which the game lets an addon call (probed 2026-10-13).
-- With auto loot on, the window shows only if something stays behind (bags
-- full, a bind confirmation).
--
-- Group loot rolls are their own module, in the roll tray (Units/LootRolls).

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type Position from "/EditMode/EditMode"
import type LootWindow, LootItem, LootRow from "/UI/Loot"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"

local UI = SuuUI.UI

local DEFAULTS = { position = { point = "CENTER", x = -320, y = 60 } :: Position, atCursor = true }

local M: LootModule

-- a value that is there and not secret (narrows: no longer nil or Secret)
type Plain = string | number | boolean | table
local QUALITY: { [number]: string } = {
    [0] = "poor",
    "common",
    "uncommon",
    "rare",
    "epic",
    "legendary",
    "legendary",
    "legendary",
}
local SLOT_MONEY = (Enum.LootSlotType and Enum.LootSlotType.Money) or 2

-- "42 Silver\n3 Copper" (the game's money slot name) → copper, or nil.
local function copperOf(text: unknown): number?
    if type(text) ~= "string" then
        return nil
    end
    local units: { [string]: number } = {
        [(GOLD or "Gold"):lower()] = 10000,
        [(SILVER or "Silver"):lower()] = 100,
        [(COPPER or "Copper"):lower()] = 1,
    }
    local total, found = 0, false
    for n, unit in text:gmatch("(%d+)%s+(%a+)") do
        local mult = units[unit:lower()]
        if mult then
            total, found = total + (tonumber(n) or 0) * mult, true
        end
    end
    return found and total or nil
end

-- Whose loot: the dead target's name, "Fishing", or nothing.
local function sourceName(): string
    if IsFishingLoot and IsFishingLoot() then
        return "Fishing"
    end
    local guid = GetLootSourceInfo and GetLootSourceInfo(1)
    local target = UnitGUID("target")
    if secret.readable(guid) and guid and secret.readable(target) and target == guid then
        local name = secret.asString(UnitName("target"))
        if name then
            return name
        end
    end
    return ""
end

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

local SECTION: SettingsSection = {
    id = "loot",
    label = "Loot",
    category = "General",
    order = 22,
    preview = function(parent: Frame): Frame
        return M:PreviewView(parent)
    end,
    groups = {
        {
            title = "Loot window",
            description = "What a corpse, chest or catch holds. Click a row to take it, shift-click to link it. Auto loot works as always: the window shows only when something stays behind.",
            rows = {
                {
                    key = "atCursor",
                    label = "Beside the cursor",
                    control = "toggle",
                    description = "The first item opens under your cursor. Off: at its own place, which you move in edit mode.",
                },
            },
        },
    },
}

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

class LootModule extends Module<typeof(DEFAULTS)>
    window: LootWindow? = nil
    preview: LootWindow? = nil
    -- between the game's LOOT_OPENED and LOOT_CLOSED
    open: boolean? = nil
    hooked: boolean? = nil
    moving: boolean? = nil

    constructor()
        super({
            id = "loot",
            name = "Loot",
            description = "SuuUI's loot window, beside the cursor.",
            api = "0.12",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    --------------------------------------------------------------------------------
    -- What the corpse holds
    --------------------------------------------------------------------------------

    function Items(): LootItem[]
        local items: LootItem[] = {}
        local n = GetNumLootItems()
        if not secret.readable(n) then
            return items
        end
        for slot = 1, n do
            local icon, name, count, _, quality, locked = GetLootSlotInfo(slot)
            if secret.readable(icon) and icon then
                local item: LootItem = {
                    index = slot,
                    icon = icon,
                    label = secret.asString(name) or "",
                    count = secret.readable(count) and count or 1,
                    quality = secret.readable(quality) and QUALITY[quality] or "common",
                    locked = secret.readable(locked) and locked or false,
                }
                if GetLootSlotType(slot) == SLOT_MONEY then
                    item.copper = copperOf(name)
                    item.count = nil
                    if not item.copper then
                        item.label = (item.label or ""):gsub("\n", " ")
                    end
                end
                items[#items + 1] = item
            end
        end
        return items
    end

    function Update(): number
        local items = self:Items()
        assert(self.window):SetItems(items)
        return #items
    end

    -- Beside the cursor with the first item under it, or at its place.
    function Place()
        local w = assert(self.window)
        w:ClearAllPoints()
        if self:Get("atCursor") then
            local x, y = GetCursorPosition()
            local scale = w:GetEffectiveScale()
            local dx, dy = w:FirstSlotOffset()
            w:SetPoint("TOPLEFT", UIParent, "BOTTOMLEFT", x / scale - dx, y / scale + dy)
        else
            local pos = self:Get("position")
            w:SetPoint(pos.point or "CENTER", SuuUI.Root, pos.point or "CENTER", pos.x or 0, pos.y or 0)
        end
    end

    function Open()
        if self:Update() == 0 then
            return
        end
        local w = assert(self.window)
        w:SetSource(sourceName())
        self:Place()
        w:Show()
    end

    --------------------------------------------------------------------------------
    -- Blizzard's loot frame, off screen
    --------------------------------------------------------------------------------

    function Away()
        local f = frames.find("LootFrame")
        if not f then
            return
        end
        f:SetAlpha(0)
        self.moving = true
        f:ClearAllPoints()
        f:SetPoint("BOTTOMRIGHT", UIParent, "TOPLEFT", -200, 200)
        self.moving = false
    end

    function HideBlizzardLoot()
        local f = frames.find("LootFrame")
        if not f or self.hooked then
            return
        end
        self.hooked = true
        f:SetClampedToScreen(false)
        hook(f, "SetPoint", function()
            if self.moving or not self:IsEnabled() then
                return
            end
            f:SetAlpha(0)
            after(0, function()
                if self:IsEnabled() then
                    self:Away()
                end
            end)
        end)
        hookScript(f, "OnShow", function()
            if self:IsEnabled() then
                self:Away()
            end
        end)
        self:Away()
    end

    function PreviewView(parent: Frame): LootWindow
        local preview = self.preview
        if not preview then
            preview = UI.LootWindow(parent)
            preview.onClose = function() end
            preview:SetSource("Ember Hound")
            preview:SetItems({
                { icon = 133784, copper = 4203 },
                { icon = 134367, label = "Ember-touched Pelt", count = 2 },
                { icon = 135033, label = "Duskwater Mantle", quality = "uncommon" },
                { icon = 133722, label = "Broken Boar Tusk", quality = "poor" },
            })
            self.preview = preview
        end
        preview:SetParent(parent)
        return preview
    end

    -- The window, while it's open.
    function Shown(): boolean
        local w = self.window
        return w ~= nil and w:IsShown()
    end

    override function OnEnable()
        local w = self.window
        if not w then
            w = UI.LootWindow(SuuUI.Root, { name = "SuuUILoot" })
            w:SetFrameStrata("HIGH")
            w:SetToplevel(true)
            w:EnableMouse(true)
            w:SetClampedToScreen(true)
            w:Hide()
            w.onClose = function()
                CloseLoot()
            end
            w.onClick = self:Guard(function(slot: number, _: string)
                if IsModifiedClick() then
                    local link = GetLootSlotLink(slot)
                    if link and HandleModifiedItemClick(link) then
                        return
                    end
                end
                LootSlot(slot)
            end)
            w.onEnter = function(slot: number, row: LootRow)
                GameTooltip:SetOwner(row, "ANCHOR_RIGHT")
                local kind = GetLootSlotType(slot)
                if kind == SLOT_MONEY then
                    GameTooltip:Hide()
                    return
                end
                if kind == ((Enum.LootSlotType and Enum.LootSlotType.Currency) or 3) and
                    GameTooltip.SetLootCurrency then
                    GameTooltip:SetLootCurrency(slot)
                else
                    GameTooltip:SetLootItem(slot)
                end
                GameTooltip:Show()
            end
            w.onLeave = function()
                GameTooltip:Hide()
            end
            self.window = w
        end
        local window = w
        self:HideBlizzardLoot()
        -- shown while you loot
        self:RegisterMover(window, { key = "position", label = "Loot", managedShow = true })
        self:RegisterSettings(SECTION)
        self:OnGameEvent("LOOT_OPENED", function(_, autoLoot)
            self.open = true
            if secret.readable(autoLoot) and autoLoot then
                -- auto loot: only what stays behind
                after(0.3, function()
                    if self.open and not window:IsShown() then
                        self:Open()
                    end
                end)
            else
                self:Open()
            end
        end)
        for _, e in ipairs({ "LOOT_SLOT_CLEARED", "LOOT_SLOT_CHANGED" }) do
            self:OnGameEvent(e, function()
                if window:IsShown() then
                    self:Update()
                end
            end)
        end
        self:OnGameEvent("LOOT_CLOSED", function()
            self.open = false
            window:Hide()
            GameTooltip:Hide()
        end)
    end

    override function OnDisable()
        local w = self.window
        if w then
            w:Hide()
        end
    end
end

M = SuuUI.AddModule(LootModule.new())

-- The rolls moved to their own module (Loot rolls): its toggle replaces
-- "Rolls in the notification stack". Switched off, the module starts off.
M:Migrate("rolls", function(values, profile)
    if values.rolls == false and profile then
        local rolls = profile.lootrolls or {}
        rolls.enabled = false
        profile.lootrolls = rolls
    end
    values.rolls = nil
end)
