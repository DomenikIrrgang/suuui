-- Units/Trainer.wowlua
-- SuuUI's own trainer window (plan 3.6, design component TrainerWindow):
-- the game's ClassTrainerFrame stays open (it holds the conversation) but out
-- of sight, and this window shows the trainer's services from the game's
-- data: the profession's rank, Filters (Available, Unavailable, Used) and
-- Categorize, the services under their categories, money and Train. Train
-- is the game's BuyTrainerService; learning a profession asks first, as the
-- game does. Asked for in game (2026-10-16): the design, not the game's
-- layout restyled.
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SuuButton from "/UI/Controls"
import type FilterMenu from "/UI/FilterMenu"
import type Checkbox from "/UI/Inputs"
import type Money from "/UI/Inventory"
import type ScrollArea, WindowFrame, Panel from "/UI/Panel"
import type Icon from "/UI/Icon"
import asFrame, named from "/UI/Reskin"
import type Text from "/UI/Text"
import filterList from "/UI/FilterMenu"
import type FilterOption, FilterValue, FilterValues from "/UI/FilterMenu"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {}

local M: TrainerModule

-- One of the game's trainer functions, its results as they come (Forever's
-- differ from the declarations: read each with `str` or `num`).
local function call(fn: unknown, ...: unknown): ...unknown
    if type(fn) ~= "function" then return nil end
    local ok, a, b, c, d, e, f, g, h = pcall(fn :: (...unknown) -> ...unknown, ...)
    if ok then return a, b, c, d, e, f, g, h end
    return nil
end
local function str(v: unknown): string? if type(v) == "string" then return v end return nil end
local function num(v: unknown): number? if type(v) == "number" then return v end return nil end

local WIDTH, HEIGHT = 380, 560
local ROW_H, HEAD_H = 47, 28
local TYPES: FilterOption[] = { { value = "available", label = "Available" }, { value = "unavailable", label = "Unavailable" }, { value = "used", label = "Used" } }

local function isPetTrainer(): boolean
    return C_Trainer and C_Trainer.GetTrainerType and Enum.TrainerType and C_Trainer.GetTrainerType() == Enum.TrainerType.Pet or false
end
local function canCategorize() return not isPetTrainer() end

--------------------------------------------------------------------------------
-- The services
--------------------------------------------------------------------------------

-- A service as the window draws it.
export type Service = { index: number, name: string, kind: string, texture: (string | number)?, sub: string, category: string?,
                 cost: number, profession: boolean }

local function service(i: number): Service?
    local nameR, kindR, textureR, reqLevelR, rankTextR, categoryR = call(GetTrainerServiceInfo, i)
    local name = str(nameR)
    if not name then return nil end
    local kind, reqLevel, rankText, category = str(kindR), num(reqLevelR), str(rankTextR), str(categoryR)
    local unit = isPetTrainer() and "pet" or "player"
    local parts: string[] = {}
    if rankText and rankText ~= "" then parts[#parts + 1] = "(" .. rankText .. ")" end
    if kind ~= "used" then
        if reqLevel and reqLevel > 1 and (UnitLevel(unit) or 0) < reqLevel then parts[#parts + 1] = "Requires level " .. reqLevel end
        local skillR, rank = call(GetTrainerServiceSkillReq, i)
        local skill = str(skillR)
        if skill then parts[#parts + 1] = ("Requires %s %s"):format(skill, tostring(rank or "")) end
        for k = 1, (num(call(GetTrainerServiceNumAbilityReq, i)) or 0) do
            local abilityR, has = call(GetTrainerServiceAbilityReq, i, k)
            local ability = str(abilityR)
            if ability and not has then parts[#parts + 1] = "Requires " .. ability end
        end
    end
    local cost, isProfession = call(GetTrainerServiceCost, i)
    local texture: (string | number)? = str(textureR) or num(textureR)
    return { index = i, name = name, kind = kind or "available", texture = texture, sub = table.concat(parts, " · "),
             category = category ~= "" and category or nil, cost = num(cost) or 0, profession = not not isProfession }
end

-- A pet's training points left.
local function trainingPoints(): number
    local total, used = call(C_PetInfo.GetPetTrainingPoints)
    return (num(total) or 0) - (num(used) or 0)
end

-- Whether a service can be learned now, and why not.
local function learnable(e: Service?): (boolean, string?)
    if not e then return false, nil end
    if e.kind == "used" then return false, "You know this." end
    if e.kind ~= "available" then return false, e.sub ~= "" and e.sub or "You can't learn this yet." end
    if isPetTrainer() then
        if e.cost > trainingPoints() then return false, "Your pet doesn't have the training points." end
    elseif e.cost > (GetMoney() or 0) then
        return false, "You can't afford it."
    end
    return true, nil
end

-- An amount of money as SuuUI writes it: "1g 20s 5c", each in its coin's
-- colour (the game's coin icons sat above the line in the question).
local function coins(copper: number): string
    local g, sv, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local out: string[] = {}
    local function add(n: number, unit: string, hex: string) out[#out + 1] = ("|cff%s%d%s|r"):format(hex, n, unit) end
    if g > 0 then add(g, "g", T.color["coin-gold"].hex) end
    if sv > 0 then add(sv, "s", T.color["coin-silver"].hex) end
    if c > 0 or #out == 0 then add(c, "c", T.color["coin-copper"].hex) end
    return table.concat(out, " ")
end

-- Your professions' names (a trainer's service names its skill line).
local function yourProfessions(): { [string]: boolean }
    local out: { [string]: boolean } = {}
    for _, index in pairs({ GetProfessions and GetProfessions() }) do
        local name = str(call(GetProfessionInfo, index))
        if name then out[name] = true end
    end
    return out
end

-- The cheapest first while the money lasts: what of `list` (sorted by cost
-- in place) `money` pays for together, and what that costs.
local function pickAffordable(list: Service[], money: number): ({ Service }, number)
    table.sort(list, function(a: Service, b: Service) return a.cost < b.cost end)
    local out: Service[], total = {}, 0
    for _, e in ipairs(list) do
        if total + e.cost <= money then
            out[#out + 1] = e
            total = total + e.cost
        end
    end
    return out, total
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

-- A category's head: the chevron, the name and how many; a click folds it.
class TrainerHead extends Button
    readonly chev: Texture
    readonly name: Text
    readonly count: Text
    readonly rule: Texture
    category: string = ""

    constructor(parent: Frame, owner: TrainerModule)
        super(nil, parent)
        self:SetHeight(HEAD_H)
        self.chev = self:CreateTexture(nil, "ARTWORK")
        self.chev:SetSize(12, 12)
        self.chev:SetPoint("LEFT", S["space-2"], 0)
        UI.Paint(self.chev, "ink-muted")
        self.name = UI.Text(self, "header", "gilt-text")
        self.name:SetPoint("LEFT", self.chev, "RIGHT", S["space-3"], 0)
        self.count = UI.Text(self, "caption", "ink-muted")
        self.count:SetPoint("LEFT", self.name, "RIGHT", S["space-3"], 0)
        self.rule = UI.Fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetPoint("BOTTOMLEFT")
        self.rule:SetPoint("BOTTOMRIGHT")
        self.rule:SetHeight(1)
        self:SetScript("OnClick", function()
            owner.collapsed[self.category] = not owner.collapsed[self.category] or nil
            owner:Refresh()
        end)
        self:SetScript("OnEnter", function() self.name:SetColor("ink") end)
        self:SetScript("OnLeave", function() self.name:SetColor("gilt-text") end)
    end
end

-- A service's row: icon, name, what it needs, the cost.
class TrainerRow extends Button
    readonly sel: Texture
    readonly hover: Texture
    readonly rule: Texture
    readonly icon: Icon
    readonly money: Money
    -- a pet's training points
    readonly tp: Text
    readonly name: Text
    readonly sub: Text
    index: number = 0

    constructor(parent: Frame, owner: TrainerModule)
        super(nil, parent)
        self:SetHeight(ROW_H)
        self.sel = UI.Fill(self, "arcane-soft", "BACKGROUND")
        self.sel:SetAllPoints()
        self.hover = UI.Fill(self, "surface-raised", "BACKGROUND", 1)
        self.hover:SetAllPoints()
        self.hover:SetAlpha(0.6)
        self.hover:Hide()
        self.rule = UI.Fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetPoint("BOTTOMLEFT", S["space-2"], 0)
        self.rule:SetPoint("BOTTOMRIGHT", -S["space-2"], 0)
        self.rule:SetHeight(1)
        self.icon = UI.Icon(self, "icon-lg")
        self.icon:SetPoint("LEFT", S["space-3"], 0)
        self.money = UI.Money(self)
        self.money:SetPoint("TOPRIGHT", -S["space-4"], -S["space-4"])
        self.tp = UI.Text(self, "caption", "ink-muted")
        self.tp:SetPoint("TOPRIGHT", self.money, "BOTTOMRIGHT", 0, -3)
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.icon, "TOPRIGHT", S["space-4"], 0)
        self.name:SetPoint("RIGHT", self.money, "LEFT", -S["space-4"], 0)
        self.name:SetWordWrap(false)
        self.sub = UI.Text(self, "caption", "ink-muted")
        self.sub:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -4)
        self.sub:SetPoint("RIGHT", -S["space-4"], 0)
        self.sub:SetWordWrap(false)
        self:SetScript("OnEnter", function()
            self.hover:Show()
            GameTooltip:SetOwner(self, "ANCHOR_RIGHT")
            GameTooltip:SetTrainerService(self.index)
            GameTooltip:Show()
        end)
        self:SetScript("OnLeave", function() self.hover:Hide(); GameTooltip:Hide() end)
        self:SetScript("OnClick", function()
            owner.selected = self.index
            call(SelectTrainerService, self.index)
            owner:Refresh()
        end)
        self:SetScript("OnDoubleClick", function()
            owner.selected = self.index
            owner:Train()
        end)
    end
end

-- The profession's rank (profession trainers): the line's name, a bar, the numbers.
class RankRow extends Frame
    readonly label: Text
    readonly n: Text
    readonly track: Frame
    readonly fill: Texture

    constructor(parent: Frame)
        super(nil, parent)
        self:SetPoint("TOPLEFT")
        self:SetPoint("TOPRIGHT")
        self:SetHeight(20)
        self.label = UI.Text(self, "label", "ink")
        self.label:SetPoint("LEFT")
        self.n = UI.Text(self, "caption", "ink-muted")
        self.n:SetPoint("RIGHT")
        self.track = CreateFrame("Frame", nil, self)
        self.track:SetHeight(10)
        self.track:SetPoint("LEFT", self.label, "RIGHT", S["space-4"], 0)
        self.track:SetPoint("RIGHT", self.n, "LEFT", -S["space-4"], 0)
        UI.Fill(self.track, "track"):SetAllPoints()
        UI.Border(self.track, "gilt-hairline")
        self.fill = UI.Fill(self.track, "progress-fill", "ARTWORK")
        self.fill:SetPoint("TOPLEFT", 1, -1)
        self.fill:SetPoint("BOTTOMLEFT", 1, 1)
    end
end

-- The NPC's title under its name ("Warrior Trainer"), from its tooltip.
local function npcTitle(): string?
    local ok, data = pcall(C_TooltipInfo.GetUnit, "npc")
    if not ok or not data or issecretvalue(data) then return nil end
    local line = data.lines and data.lines[2]
    local text = line and line.leftText
    if type(text) == "string" and not issecretvalue(text) and not text:find("^Level") then return text end
    return nil
end

-- The services as the list shows them: the profession's next rank (`step`)
-- first, then the uncategorized, and with `categorize` the rest under their
-- categories (sorted by name). A service without a category takes its
-- spellbook line by name, else by icon (`schoolOf`, `schoolOfIcon`).
type Group = { name: string, rows: Service[] }
local function arrange(services: Service[], step: number?, categorize: boolean, schoolOf: { [string]: string },
                       schoolOfIcon: { [string | number]: string }): (Service[], Group[])
    local list: Service[], groups: Group[], byName: { [string]: Group } = {}, {}, {}
    for _, e in ipairs(services) do
        local texture = e.texture
        local category = e.category or schoolOf[e.name] or (texture and schoolOfIcon[texture])
        e.category = category
        if e.index == step then
            table.insert(list, 1, e)
        elseif categorize and category then
            local g = byName[category]
            if not g then
                g = { name = category, rows = {} }
                byName[category] = g
                groups[#groups + 1] = g
            end
            g.rows[#g.rows + 1] = e
        else
            list[#list + 1] = e
        end
    end
    table.sort(groups, function(a: Group, b: Group) return a.name < b.name end)
    return list, groups
end

-- Train all's tooltip: the first six names, how many more; or why nothing.
local function trainAllText(all: Service[]): string
    local names: string[] = {}
    for i = 1, math.min(6, #all) do names[i] = all[i].name end
    return #all > 0 and (table.concat(names, ", ") .. (#all > 6 and (" and " .. (#all - 6) .. " more") or ""))
        or "Nothing you can learn and afford right now."
end

class TrainerModule extends Module<typeof(DEFAULTS)>
    away: boolean? = nil
    categorize: Checkbox? = nil
    -- categories folded, by name
    collapsed: { [string]: boolean } = {}
    empty: Text? = nil
    filters: FilterMenu? = nil
    heads: TrainerHead[] = {}
    list: ScrollArea? = nil
    money: Money? = nil
    -- between the game's TRAINER_SHOW and TRAINER_CLOSED
    open: boolean? = nil
    points: Text? = nil
    rank: RankRow? = nil
    refreshPending: boolean? = nil
    rows: TrainerRow[] = {}
    -- the service chosen (its index)
    selected: number? = nil
    tools: Frame? = nil
    train: SuuButton? = nil
    trainAll: SuuButton? = nil
    window: WindowFrame? = nil

    constructor()
        super({
            id = "trainer",
            name = "Trainer",
            description = "SuuUI's trainer window: the services under their categories, filters, the profession's rank, money and Train.",
            api = "0.16",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- The chosen service, read again.
    function Selected(): Service?
        local selected = self.selected
        return selected and service(selected) or nil
    end

    function Train()
        local e = self:Selected()
        if not e or not learnable(e) then return end
        if e.profession and IsTradeskillTrainer and IsTradeskillTrainer() then
            local line = str(call(GetTrainerServiceSkillLine, e.index)) or e.name
            UI.Confirm({ title = "Learn " .. line .. "?", text = ("You'll have %s as a profession."):format(line), confirm = "Learn",
                onConfirm = function() BuyTrainerService(e.index) end })
            return
        end
        BuyTrainerService(e.index)
    end

    -- Everything you can learn now and afford together (asked 2026-10-18): the
    -- cheapest first while the money lasts. Never a profession you don't have
    -- yet (that one asks, one at a time); a profession trainer marks its own
    -- ranks and recipes as the profession too, and those count (found in game:
    -- leaving every marked one out left nothing at a profession trainer).
    function TrainAllList(): (Service[], number)
        local list: Service[], money = {}, GetMoney() or 0
        if isPetTrainer() then money = trainingPoints() end
        local mine = yourProfessions()
        for i = 1, (num(call(GetNumTrainerServices)) or 0) do
            local e = service(i)
            if e and e.kind == "available" and learnable(e) then
                local line = e.profession and str(call(GetTrainerServiceSkillLine, i))
                if not e.profession or (line and mine[line]) then list[#list + 1] = e end
            end
        end
        return pickAffordable(list, money)
    end

    -- Learns them one at a time: the trainer's list changes after each one, so
    -- the next is looked up again once it has.
    function TrainAll()
        local steps = 0
        local function next()
            steps = steps + 1
            local w = self.window
            if steps > 60 or not (w and w:IsShown()) then return end
            local list = self:TrainAllList()
            local e = list[1]
            if not e then return end
            BuyTrainerService(e.index)
            after(0.35, next)
        end
        next()
    end

    function DrawRow(r: TrainerRow, e: Service)
        r.index = e.index
        r.icon:SetArt(e.texture)
        r.icon.art:SetDesaturated(e.kind == "unavailable")
        r.name:SetValue(e.name)
        r.sub:SetValue(e.sub)
        r.sub:SetColor(e.kind == "unavailable" and "ember-text" or "ink-muted")
        local pet = isPetTrainer()
        if e.kind ~= "used" and e.cost > 0 and not pet then
            r.money:SetCopper(e.cost)
            UI.Paint(r.money.text, (GetMoney() or 0) >= e.cost and "ink" or "ember-text")
            r.money:Show()
        else
            r.money:Hide()
        end
        r.tp:SetShown(pet and e.cost > 0)
        if pet then r.tp:SetValue(e.cost .. " TP") end
        r:SetAlpha(e.kind == "used" and T.opacity["opacity-disabled"] or 1)
        r.sel:SetShown(self.selected == e.index)
    end

    function Build()
        local w = UI.WindowFrame(SuuUI.Root, { name = "SuuUITrainerWindow", title = "Trainer", width = WIDTH, height = HEIGHT,
            footer = true, onClose = function(win: Panel) win:Hide() end })
        w:SetPoint("TOPLEFT", UIParent, "TOPLEFT", 16, -116)
        w:Hide()
        w:HookScript("OnHide", function() if self.open then call(CloseTrainer) end end)
        w.scroll:Hide()
        self.window = w
        local body = w.body
        local rank = RankRow.new(body)
        self.rank = rank
        -- the tools: Filters, Categorize, a pet's training points
        local tools = CreateFrame("Frame", nil, body)
        tools:SetHeight(30)
        self.tools = tools
        local filters = UI.FilterMenu(tools, {
            groups = { { key = "show", label = "Show", kind = "many", options = TYPES } },
            defaults = { show = { "available", "unavailable" } }, placeholder = "Filters", width = 130,
            onChange = function(value: FilterValues)
                local on: { [FilterValue]: boolean } = {}
                for _, v in ipairs(filterList(value.show)) do on[v] = true end
                for _, t in ipairs(TYPES) do call(SetTrainerServiceTypeFilter, t.value, on[t.value] and true or false) end
            end })
        self.filters = filters
        filters:SetPoint("LEFT")
        local categorize = UI.Checkbox(tools, { label = "Categorize", onChange = function(on: boolean)
            if C_Trainer and C_Trainer.SetCategorizeTrainerUI then C_Trainer.SetCategorizeTrainerUI(on) end
            self:Refresh()
        end })
        self.categorize = categorize
        categorize:SetPoint("LEFT", filters, "RIGHT", S["space-5"], 0)
        local points = UI.Text(tools, "caption", "ink-muted")
        self.points = points
        points:SetPoint("RIGHT")
        -- the list
        local BAR = S["space-3"]
        local list = UI.ScrollArea(body, BAR)
        self.list = list
        list:SetPoint("TOPLEFT", tools, "BOTTOMLEFT", 0, -S["space-4"])
        list:SetPoint("BOTTOMRIGHT", -(BAR + 3), 0)
        list:HookScript("OnSizeChanged", function(_: Frame, width: number) list.child:SetWidth(width) end)
        self.heads, self.rows, self.collapsed = {}, {}, {}
        local empty = UI.Text(list.child, "body", "ink-muted")
        self.empty = empty
        empty:SetPoint("TOPLEFT", 0, -S["space-4"])
        -- the foot: your money, Train
        local footer = assert(w.footer)
        local money = UI.Money(footer)
        self.money = money
        money:SetPoint("LEFT")
        local train = UI.Button(footer, { text = "Train", variant = "primary", width = 110, onClick = function() self:Train() end })
        self.train = train
        train:SetPoint("RIGHT")
        local trainAll = UI.Button(footer, { text = "Train all", width = 110, onClick = self:Guard(function()
            local all, total = self:TrainAllList()
            if #all == 0 then return end
            local cost = isPetTrainer() and (total .. " training points") or coins(total)
            UI.Confirm({ title = "Train all?", text = ("Learn %d %s for %s."):format(#all, #all == 1 and "skill" or "skills", cost),
                confirm = "Train all", onConfirm = function() self:TrainAll() end })
        end) })
        self.trainAll = trainAll
        trainAll:SetPoint("RIGHT", train, "LEFT", -S["space-3"], 0)
    end

    function Refresh()
        local w = self.window
        if not (w and w:IsShown() and self.open) then return end
        -- (built with the window)
        local rankRow, tools, filters, categorizeBox = assert(self.rank), assert(self.tools), assert(self.filters), assert(self.categorize)
        local points, scroll, empty, money = assert(self.points), assert(self.list), assert(self.empty), assert(self.money)
        local train, trainAll = assert(self.train), assert(self.trainAll)
        local name = UnitName("npc")
        w:SetTitle(type(name) == "string" and not issecretvalue(name) and name or "Trainer", npcTitle())
        -- the rank row
        local rankR, maxRankR = call(GetTrainerTradeskillRankValues)
        local rank, maxRank = num(rankR), num(maxRankR)
        local hasRank = false
        if rank and maxRank and rank > 0 and maxRank > 0 then
            hasRank = true
            local stepIndex = num(call(GetTrainerServiceStepIndex))
            rankRow.label:SetValue(str(call(GetTrainerServiceSkillLine, stepIndex or 1)) or "Rank")
            rankRow.n:SetValue(rank .. " / " .. maxRank)
            local width = math.max(1, rankRow.track:GetWidth() - 2)
            rankRow.fill:SetWidth(math.max(1, width * math.min(1, rank / maxRank)))
        end
        rankRow:SetShown(hasRank)
        tools:ClearAllPoints()
        tools:SetPoint("TOPLEFT", 0, hasRank and -(20 + S["space-4"]) or 0)
        tools:SetPoint("RIGHT")
        -- the tools
        local shown: FilterValue[] = {}
        for _, t in ipairs(TYPES) do if call(GetTrainerServiceTypeFilter, t.value) then shown[#shown + 1] = t.value end end
        filters:SetValue({ show = shown })
        local categorize = canCategorize() and C_Trainer and C_Trainer.GetCategorizeTrainerUI and C_Trainer.GetCategorizeTrainerUI()
        categorizeBox:SetShown(canCategorize())
        categorizeBox:SetValue(categorize and true or false)
        local pet = isPetTrainer()
        points:SetShown(pet)
        if pet then points:SetValue("Training points: " .. trainingPoints()) end
        -- the services: the profession's next rank first, then by category. The
        -- game gives a class trainer's spells none: their spellbook line instead
        -- (SuuUI's trainer data, as the spellbook groups them)
        -- (a spell the data doesn't know by name, new or renamed on Forever:
        -- by its icon, which a renamed spell keeps)
        local schoolOf: { [string]: string }, schoolOfIcon: { [string | number]: string } = {}, {}
        if not pet and not (IsTradeskillTrainer and IsTradeskillTrainer()) then
            for _, sp in ipairs(SuuUI.TrainerSpells and SuuUI.TrainerSpells() or {}) do
                if sp.name and sp.school then schoolOf[sp.name] = sp.school end
                if sp.icon and sp.school then schoolOfIcon[sp.icon] = schoolOfIcon[sp.icon] or sp.school end
            end
        end
        local services: Service[] = {}
        for i = 1, (num(call(GetNumTrainerServices)) or 0) do
            local e = service(i)
            if e then services[#services + 1] = e end
        end
        local list, groups = arrange(services, num(call(GetTrainerServiceStepIndex)), categorize and true or false, schoolOf, schoolOfIcon)
        -- uncategorized first (as the game does), then each category
        local c = scroll.child
        local y, nh, nr = 0, 0, 0
        local function row(e: Service)
            nr = nr + 1
            local r = self.rows[nr] or TrainerRow.new(c, self)
            self.rows[nr] = r
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", 0, -y)
            r:SetPoint("RIGHT", c, "RIGHT")
            self:DrawRow(r, e)
            r:Show()
            y = y + ROW_H
        end
        for _, e in ipairs(list) do row(e) end
        for _, g in ipairs(groups) do
            nh = nh + 1
            local h = self.heads[nh] or TrainerHead.new(c, self)
            self.heads[nh] = h
            h.category = g.name
            h:ClearAllPoints()
            h:SetPoint("TOPLEFT", 0, -y)
            h:SetPoint("RIGHT", c, "RIGHT")
            local folded = self.collapsed[g.name]
            h.chev:SetTexture("Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\" .. (folded and "chevronRight" or "chevronDown") .. ".tga")
            h.name:SetValue(g.name)
            h.count:SetValue(tostring(#g.rows))
            h:Show()
            y = y + HEAD_H
            if not folded then for _, e in ipairs(g.rows) do row(e) end end
        end
        for i = nh + 1, #self.heads do self.heads[i]:Hide() end
        for i = nr + 1, #self.rows do self.rows[i]:Hide() end
        empty:SetShown(nr == 0 and nh == 0)
        empty:SetValue("Nothing to show with these filters.")
        c:SetHeight(math.max(1, y))
        -- the foot
        money:SetCopper(GetMoney() or 0)
        local ok, why = learnable(self:Selected())
        train:SetEnabledState(ok)
        train.tooltip = (not ok) and { title = "Train", description = self.selected and why or "Choose what to learn." } or nil
        local all = self:TrainAllList()
        trainAll:SetEnabledState(#all > 0)
        trainAll.tooltip = { title = "Train all", description = trainAllText(all) }
    end

    function QueueRefresh()
        if self.refreshPending then return end
        self.refreshPending = true
        after(0.05, function()
            self.refreshPending = nil
            self:Refresh()
        end)
    end

    -- The game's frame out of sight: see-through and off screen, still shown,
    -- and back off screen whenever the game places it again.
    function Away(frame: Frame?)
        if not frame or self.away then return end
        self.away = true
        local placing = false
        local function away()
            if not self:IsEnabled() then return end
            placing = true
            frame:SetAlpha(0)
            frame:ClearAllPoints()
            frame:SetPoint("TOPLEFT", UIParent, "TOPRIGHT", 5000, 0)
            placing = false
        end
        away()
        hook(frame, "SetPoint", function() if not placing then after(0, away) end end)
        hookScript(frame, "OnShow", function() after(0, away) end)
    end

    -- "/suu trainall": at an open trainer, each service and whether Train all
    -- takes it, and why not (it did nothing at a blacksmithing trainer,
    -- 2026-10-18).
    function ExplainTrainAll()
        local mine = yourProfessions()
        local names: string[] = {}
        for n in pairs(mine) do names[#names + 1] = n end
        local count = num(call(GetNumTrainerServices)) or 0
        self:Print(("%d services; your professions: %s; money %s"):format(count, table.concat(names, ", "), tostring(GetMoney())))
        for i = 1, math.min(25, count) do
            local e = service(i)
            if e then
                local ok, why = learnable(e)
                local line = call(GetTrainerServiceSkillLine, i)
                self:Print(("%d %s: kind=%s cost=%s profession=%s line=%s learnable=%s %s"):format(i, tostring(e.name), tostring(e.kind),
                    tostring(e.cost), tostring(e.profession), tostring(line), tostring(ok), why or ""))
            end
        end
        local list, total = self:TrainAllList()
        self:Print(("Train all would learn %d for %s."):format(#list, tostring(total)))
    end

    override function OnEnable()
        self:RegisterCommand("trainall", "At a trainer: what Train all would learn, and why it leaves something out.", function()
            self:ExplainTrainAll()
        end)
        if not self.window then self:Build() end
        self:OnGameEvent("TRAINER_SHOW", function()
            self.open = true
            self.selected = nil
            after(0, function() self:Away(asFrame(named("ClassTrainerFrame"))) end)
            assert(self.window):Show()
            assert(self.list):SetVerticalScroll(0)
            self:Refresh()
        end)
        self:OnGameEvent("TRAINER_CLOSED", function()
            self.open = false
            assert(self.window):Hide()
        end)
        for _, e in ipairs({ "TRAINER_UPDATE", "TRAINER_SERVICE_INFO_NAME_UPDATE", "PLAYER_MONEY", "UNIT_PET_TRAINING_POINTS",
                             "SKILL_LINES_CHANGED" }) do
            self:OnGameEvent(e, function() self:QueueRefresh() end)
        end
    end

    override function OnDisable()
        local w = self.window
        if w then w:Hide() end
    end
end

M = SuuUI.AddModule(TrainerModule.new())
