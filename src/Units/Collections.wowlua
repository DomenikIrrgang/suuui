-- Units/Collections.wowlua
-- SuuUI's own collections window (plan 3.6; asked 2026-10-16: our own
-- window instead of the restyle; design: direction A, "Stage", on the board
-- "Collections · own window"). The game's journal stays closed. Probed
-- (/suu probe collown, colltiles): every mount, toy and appearance can be
-- read, the ones you lack too; SuuUI draws the models itself (a ModelScene
-- fitted to the stage by the game (a PlayerModel), DressUpModels framed by the appearance
-- cameras); summoning and toys go through SuuUI's own secure buttons.
-- Where something comes from is SuuUI's generated data
-- (SuuUI.CollectionSources(): the game gives no source for mounts, only the
-- kind for appearances, and won't list the toys you lack).
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import COLLECTIONS from "/Core/ServiceKeys"
import type CollectionSource, CollectionSources from "/Data/CollectionSources"
import type WindowFrame from "/UI/Panel"
import type ScrollArea from "/UI/Panel"
import type SuuButton from "/UI/Controls"
import type Text from "/UI/Text"
import type TextField, Segmented from "/UI/Inputs"
import type Select, SelectOption from "/UI/Select"
import type Border from "/UI/Draw"
import type ModelStage from "/UI/Stage"
import type TooltipLine from "/UI/Tooltip"
import after, every from "wowlua:timer"
import hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"

-- A secure handler frame (SecureHandler*Template): SetFrameRef from its template.
type FrameRefs = { SetFrameRef: (self: Frame, id: string, frame: Region) -> () }

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local try, tryMethod, field, list = errors.try, errors.tryMethod, tbl.field, tbl.list
local asNumber, asString, flag, isSecret = secret.asNumber, secret.asString, secret.flag, secret.isSecret

local M: CollectionsModule

--------------------------------------------------------------------------------
-- Where something comes from: the best source as one line, all of it as a
-- card (design: vendor, quest, world drop, drop, object, container,
-- crafted, the game's own text, the item that teaches it; then the game's
-- source kind, then "Source unknown")
--------------------------------------------------------------------------------

local WORLD = 12

-- An entry the strip, the stage and the shelf show: a mount, a toy or an
-- appearance, yours or not, with its source (a CollectionSources entry).
type Entry = {
    kind: string, id: number, name: string, icon?: number, collected: boolean, favourite?: boolean,
    usable?: boolean, learned?: number, source?: CollectionSource, sourceType?: number,
    -- a mount's
    spellID?: number, active?: boolean, faction?: number, display?: number, scene?: number, isSelf?: boolean,
    -- a toy's
    itemID?: number,
    -- an appearance's
    visualID?: number, sourceID?: number, quality?: number, worn?: boolean, camera?: number,
}
-- A source card's section.
type CardSection = { title: string, lines: string[] }

local function data(): CollectionSources return SuuUI.CollectionSources() end

-- "Name|Zone|Level|Faction" -> name, zone, level, faction
local function npc(id: number): (string?, string?, string?, string?)
    local s = data().npc[id]
    if not s then return nil end
    local name, zone, level, faction = s:match("^(.-)|(.-)|(.-)|(.*)$")
    return name, zone ~= "" and zone or nil, level ~= "" and level or nil, faction ~= "" and faction or nil
end
local function object(id: number): (string?, string?)
    local s = data().obj[id]
    if not s then return nil end
    local name, zone = s:match("^(.-)|(.*)$")
    return name, zone ~= "" and zone or nil
end
local function itemName(id: number?): string?
    return asString(try(field(C_Item, "GetItemNameByID"), id))
end
local function questTitle(id: number): string?
    local t = asString(try(field(C_QuestLog, "GetTitleForQuestID"), id))
    return t ~= "" and t or nil
end

local function place(name: string, zone: string?): string return zone and (name .. ", " .. zone) or name end
local function more(ids: number[]): string return (#ids > 1) and (" +" .. (#ids - 1)) or "" end

-- The game's own word for a source kind (its numbers: mounts use the pet
-- journal's, appearances the transmog ones).
local function kindName(kind: string, number: number?): string?
    if not number or number < 0 then return nil end
    local g = asString(field(_G, kind == "appearance" and ("TRANSMOG_SOURCE_" .. number) or ("BATTLE_PET_SOURCE_" .. (number + 1))))
    return g ~= "" and g or nil
end

-- src: a CollectionSources entry (or nil); kind/number: the game's source
-- kind as the fallback. -> "Vendor · Name, Zone +1" or nil
local function sourceLine(src: CollectionSource?, kind: string, number: number?): string
    if src then
        local v, q, d, o, c = src.v, src.q, src.d, src.o, src.c
        if v and v[1] then
            local name, zone = npc(v[1])
            if name then return "Vendor · " .. place(name, zone) .. more(v) end
        end
        if q and q[1] then
            local title = questTitle(q[1])
            return "Quest" .. (title and (" · " .. title) or "") .. more(q)
        end
        local dn = src.dn or 0
        if dn > WORLD then return "World drop" end
        if d and d[1] then
            local name, zone, level = npc(d[1])
            if name then
                local extra = dn > 1 and (" +" .. (dn - 1)) or more(d)
                return "Drop · " .. place(name, zone) .. (level and (" · " .. level) or "") .. extra
            end
        end
        if o and o[1] then
            local name, zone = object(o[1])
            if name then return "Found in · " .. place(name, zone) .. more(o) end
        end
        if c and c[1] then return "Inside · " .. (itemName(c[1]) or "a container") end
        if src.p then return "Crafted · " .. src.p end
        if src.x then return src.x end
        if src.i then return "Taught by · " .. (itemName(src.i) or "an item") end
    end
    return kindName(kind, number) or "Source unknown"
end

-- The full card: { { title, lines = { … } }, … } (empty: nothing known).
local function sourceCard(src: CollectionSource?, kind: string, number: number?): CardSection[]
    local card: CardSection[] = {}
    local function section(title: string, lines: string[]) if lines[1] then card[#card + 1] = { title = title, lines = lines } end end
    if src then
        local lines: string[] = {}
        for _, id in ipairs(src.v or {}) do
            local name, zone, _, faction = npc(id)
            if name then lines[#lines + 1] = place(name, zone) .. (faction and (" (" .. faction .. ")") or "") end
        end
        section("Sold by", lines)
        lines = {}
        for _, id in ipairs(src.q or {}) do lines[#lines + 1] = questTitle(id) or ("Quest " .. id) end
        section("Quest", lines)
        lines = {}
        local dn = src.dn or 0
        if dn > WORLD then
            section("World drop", { ("Dropped by %d creatures across the world"):format(dn) })
        else
            local d = src.d or {}
            for _, id in ipairs(d) do
                local name, zone, level = npc(id)
                if name then lines[#lines + 1] = place(name, zone) .. (level and (" · level " .. level) or "") end
            end
            if dn > #d then lines[#lines + 1] = ("and %d more"):format(dn - #d) end
            section("Dropped by", lines)
        end
        lines = {}
        for _, id in ipairs(src.o or {}) do
            local name, zone = object(id)
            if name then lines[#lines + 1] = place(name, zone) end
        end
        section("Found in", lines)
        lines = {}
        for _, id in ipairs(src.c or {}) do lines[#lines + 1] = itemName(id) or ("Item " .. id) end
        section("Inside", lines)
        if src.p then section("Crafted by", { src.p }) end
        if src.x then section("In the game", { src.x }) end
        local taught = src.i
        if taught and not card[1] then section("Taught by", { itemName(taught) or ("Item " .. taught) }) end
    end
    if not card[1] then
        local word = kindName(kind, number)
        if word then card[1] = { title = word, lines = { "Nothing more is known." } } end
    end
    return card
end

--------------------------------------------------------------------------------
-- What there is: mounts, toys, appearances, the ones you lack too
--------------------------------------------------------------------------------

-- The paper doll's slots (the game's armor categories 1-11; weapons by kind).
type SlotDef = { slot: string, label: string, category?: number, weapon?: string }
local SLOTS: SlotDef[] = {
    { slot = "HEADSLOT", label = "Head", category = 1 }, { slot = "SHOULDERSLOT", label = "Shoulder", category = 2 },
    { slot = "BACKSLOT", label = "Back", category = 3 }, { slot = "CHESTSLOT", label = "Chest", category = 4 },
    { slot = "SHIRTSLOT", label = "Shirt", category = 5 }, { slot = "TABARDSLOT", label = "Tabard", category = 6 },
    { slot = "WRISTSLOT", label = "Wrist", category = 7 }, { slot = "HANDSSLOT", label = "Hands", category = 8 },
    { slot = "WAISTSLOT", label = "Waist", category = 9 }, { slot = "LEGSSLOT", label = "Legs", category = 10 },
    { slot = "FEETSLOT", label = "Feet", category = 11 },
    { slot = "MAINHANDSLOT", label = "Main hand", weapon = "main" }, { slot = "SECONDARYHANDSLOT", label = "Off hand", weapon = "off" },
    { slot = "RANGEDSLOT", label = "Ranged", weapon = "ranged" },
}

local function slotDef(slot: string?): SlotDef?
    for _, d in ipairs(SLOTS) do if d.slot == slot then return d end end
    return nil
end

-- A weapon kind: the game's category and its name.
type WeaponKind = { category: number, name: string }
-- A slot's yours of all; a slot with no kind for this class: why.
type SlotCount = { have: number, all: number, reason?: string }

-- The slot's transmog location (the game asks for armor with it).
local function location(slot: string): unknown
    local get = field(_G, "TransmogUtil", "GetTransmogLocation")
    local appearance = field(Enum, "TransmogType", "Appearance")
    if not (get and appearance) then return nil end
    local loc = try(get, slot, appearance, false)
    return loc and (tryMethod(loc, "GetData")) or nil
end

-- A toy's cooldown: when it started and how long (0 when ready).
local function toyCooldown(itemID: number): (number, number)
    local startR, durationR = try(field(C_Container, "GetItemCooldown"), itemID)
    local start, duration = asNumber(startR), asNumber(durationR)
    if not (start and duration) then return 0, 0 end
    if duration > 1.5 and start > 0 then return start, duration end
    return 0, 0
end

-- "Ready in 41 min", "Ready in 1 h 5 min", "Ready in 30 s"
local function readyIn(start: number, duration: number, now: number?): string
    local left = math.max(0, start + duration - (now or GetTime()))
    if left >= 3600 then return ("Ready in %d h %d min"):format(math.floor(left / 3600), math.floor(left % 3600 / 60)) end
    if left >= 60 then return ("Ready in %d min"):format(math.ceil(left / 60)) end
    return ("Ready in %d s"):format(math.ceil(left))
end

-- What SuuUI keeps per character: the day it first saw each of yours (by
-- kind: `first` the first look), the last collected.
type Seen = { [number]: number, first: number }
type CharStore = { learned?: { [string]: Seen }, last?: { name: string, at: number } }

--------------------------------------------------------------------------------
-- The window (design CollectionsWindow, direction A "Stage"): the stage on
-- top, the strip's tools, the strip; the overview in the foot.
--------------------------------------------------------------------------------

local WIDTH, HEIGHT = 960, 700
local CELL, COLS, ROWS = 40, 18, 2
local TILES = 10 -- Appearances: framed 3D tiles a page
local DOLL_L, DOLL_R = 320, 210 -- Appearances: the slot columns' insets
local CARD_W, SHADE_W = 270, 340
-- The mount: a model frame the game fits each model into, whatever its
-- size (seen in game: the mount scene's camera, tuned by hand, fit some
-- mounts and left others too big, too low or cut off; the first probe's
-- PlayerModel framed them whole). It sizes the model by its frame's width
-- and centres it in the frame, and cuts it at the frame's edges (seen in
-- game: 560 wide drew the mount about 300 high, a 300-high frame cut it).
-- So MODEL_W sets the size (a mount about 0.53 of it high), and the frame,
-- from the stage's top, is MODEL_H high so the middle of a mount that high
-- sits half its height above the floor glow: its feet stand there. Centred
-- on the stage, the card over its left.
-- The game centres each mount by its whole size, so where the feet show
-- differs per mount (seen in game: some stood on the floor shadow, some
-- floated). The frame's camera says where it stands and aims relative to
-- the model, whose origin is the ground under it: how far below the
-- frame's middle that shows follows from it, times FEET_K * the frame's
-- width (calibrated with /suu probe mountframe in a 440 by 470 frame: a
-- Swift Stormsaber's 165px). Each mount is lifted by the frame's own
-- SetPosition until it shows FEET_BELOW under the middle (the camera and
-- the model's size untouched: tested with /suu probe mountframe place, the
-- feet of every mount within about 20px), and the frame sits so that point
-- is FEET_Y above the stage's bottom, the floor shadow's middle.
-- FEET_DROP: the feet a mount shows stand above the ground under its body
-- (seen in game: a raptor's 60px, a kodo's 30px above the shadow's
-- middle), so every mount goes down by about that much.
-- The frame is wide so long mounts turned side on fit (seen in game: 440
-- wide cut them); the game sizes the model by the frame's larger side, so
-- the camera moves back by that side over the calibrated 470 (tested with
-- the placement probe: a kodo the same size in 760 wide, its feet the same
-- 40px above the ground point; scaling the model instead misplaced it).
-- The projection follows the larger side too.
local FLOOR, MODEL_W, MODEL_H, SIZE_REF = 40, 760, 470, 470
local FEET_K, FEET_Y, FEET_BELOW = 2.739 * 440 / SIZE_REF, 72, 165
-- How far each mount model's feet show above the ground under its body, by
-- model file (stood on the floor by hand with /suu probe mountfeet,
-- 2026-10-17, at the stage's facing); a model not here: FEET_DROP.
local FEET_DROP = 64
local FEET_DROPS: { [number]: number } = {
    [123410] = 56, -- Black War Wolf
    [123418] = 56, -- Brown Wolf
    [124038] = 94, -- Black War Tiger
    [124052] = 90, -- Golden Sabercat
    [124696] = 46, -- Black War Kodo
    [124711] = 46, -- Brown Kodo
    [124872] = 74, -- Blue Mechanostrider
    [124880] = 72, -- Black Battlestrider
    [125009] = 64, -- Green Skeletal Warhorse
    [125223] = 70, -- Summon Dreadsteed
    [125227] = 70, -- Summon Felsteed
    [125522] = 70, -- Black War Ram
    [125546] = 54, -- White Ram
    [125614] = 74, -- Black Stallion
    [125620] = 56, -- Black War Steed
    [125649] = 76, -- Black War Raptor
    [125680] = 76, -- Emerald Raptor
    [125687] = 80, -- Summon Blue Qiraji Battle Tank
    [126304] = 66, -- Black Skeletal Horse
    [126306] = 62, -- Dark Skeletal Horse
    [126403] = 62, -- Summon Charger
    [126407] = 66, -- Summon Warhorse
    [7704354] = 64, -- Empyrean Galestrider
    [7704356] = 64, -- Swift Empyrean Galestrider
    [7704362] = 52, -- Spectral Bear
    [7780798] = 94, -- Summon Forsaken Charger
    [7935081] = 48, -- Pack Kodo
    [7958137] = 94, -- Summon Warhorse
}
local FACING = 0.6
local CAM_SCALE = math.max(MODEL_W, MODEL_H) / SIZE_REF
local ZOOM_MIN, ZOOM_MAX = 0.6, 2.5

local TOOLS_H = 30
local STRIP_H = CELL * ROWS + S["space-5"] + 8
local MEDIA = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local GLYPHS = MEDIA .. "Glyphs\\"
local SOFT = MEDIA .. "CircleSoft.tga"
local DISC = MEDIA .. "CircleFill.tga"

local function day(at: number?): string?
    if not at then return nil end
    if at == 0 then return "before SuuUI" end
    return (date("%d %b", at):gsub("^0", ""))
end

local function status(e: Entry): (string, string)
    if not e.collected then return "Not collected", "ink-faint" end
    local when = day(e.learned)
    return "Collected" .. (when and (" · " .. when) or ""), "gilt-text"
end

-- A small round button (the stage's star, turn and zoom): a disc, a glyph.
class RoundButton extends Button
    readonly disc: Texture
    readonly glyph: Texture
    on: boolean = false

    constructor(parent: Frame, glyph: string, tip: string | ((b: RoundButton) -> string), onClick: (b: RoundButton) -> ())
        super(nil, parent)
        self:SetSize(26, 26)
        self.disc = self:CreateTexture(nil, "BACKGROUND")
        self.disc:SetTexture(DISC)
        self.disc:SetAllPoints()
        UI.Paint(self.disc, "surface-raised")
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. glyph .. ".tga")
        self.glyph:SetSize(12, 12)
        self.glyph:SetPoint("CENTER")
        UI.Paint(self.glyph, "ink-muted")
        self:SetScript("OnEnter", function()
            self:Draw(true)
            local title: string
            if type(tip) == "function" then title = tip(self) else title = tip end
            UI.ShowTooltip(self, { title = title })
        end)
        self:SetScript("OnLeave", function() self:Draw(false); UI.HideTooltip() end)
        self:SetScript("OnClick", function() onClick(self) end)
    end

    function Draw(hover: boolean)
        UI.Paint(self.glyph, self.on and "gilt" or hover and "ink" or "ink-muted")
    end
end

local function favouriteTip(b: RoundButton): string return b.on and "Remove from favourites" or "Add to favourites" end

-- A secure action button (Summon, a toy's Use): the look a SuuUI button
-- under it, its tooltip why it's off.
class SecureAction extends Button
    readonly look: SuuButton
    why: string? = nil

    constructor(name: string, parent: Frame, text: string, width: number, variant: string?)
        super(name, parent, "SecureActionButtonTemplate")
        self:RegisterForClicks("AnyUp", "AnyDown")
        self.look = UI.Button(self, { text = text, variant = variant, width = width })
        self.look:SetAllPoints()
        self.look:EnableMouse(false)
        self:HookScript("OnEnter", function()
            local why = self.why
            if why then UI.ShowTooltip(self, { title = self.look.label:GetText() or "", description = why }) end
        end)
        self:HookScript("OnLeave", function() UI.HideTooltip() end)
    end
end

--------------------------------------------------------------------------------
-- The card on the stage: name, status, a rule, the full source card
--------------------------------------------------------------------------------

class StageCard extends Frame
    readonly name: Text
    readonly status: Text
    readonly extra: Text
    readonly rule: Frame
    readonly texts: Text[] = {}

    constructor(stage: Frame)
        super(nil, stage)
        self:SetPoint("TOPLEFT", S["space-6"], -S["space-6"])
        self:SetPoint("BOTTOMLEFT", S["space-6"], 52)
        self:SetWidth(CARD_W)
        self:SetFrameLevel(stage:GetFrameLevel() + 10)
        self.name = UI.Text(self, "alert", "ink")
        self.name:SetPoint("TOPLEFT")
        self.name:SetWidth(CARD_W)
        self.name:SetJustifyH("LEFT")
        self.name:SetWordWrap(true)
        self.status = UI.Text(self, "caption", "gilt-text")
        self.status:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -S["space-3"])
        self.extra = UI.Text(self, "caption", "arcane")
        self.extra:SetPoint("LEFT", self.status, "RIGHT", S["space-4"], 0)
        self.rule = UI.Hairline(self, "gilt-line", "out")
        self.rule:SetPoint("TOPLEFT", self.status, "BOTTOMLEFT", 0, -S["space-4"])
        self.rule:SetWidth(CARD_W)
    end

    function Draw(e: Entry, extra: string?)
        self.name:SetValue(e.name)
        local text, color = status(e)
        self.status:SetValue(text)
        self.status:SetColor(color)
        self.extra:SetValue(extra or "")
        for _, t in ipairs(self.texts) do t:Hide() end
        local card = sourceCard(e.source, e.kind == "appearance" and "appearance" or "mount", e.sourceType)
        if not card[1] then card = { { title = "Source unknown", lines = {} } } end
        local n = 0
        local prev: Region = self.rule
        local prevIndent = 0
        local function addText(style: string, tone: string, indent: number, gap: number): Text
            n = n + 1
            local t = self.texts[n]
            if not t then
                t = UI.Text(self, style, tone)
                t:SetJustifyH("LEFT")
                t:SetWordWrap(true)
                self.texts[n] = t
            end
            t:SetStyle(style)
            t:SetColor(tone)
            t:ClearAllPoints()
            t:SetPoint("TOPLEFT", prev, "BOTTOMLEFT", indent - prevIndent, -gap)
            t:SetWidth(CARD_W - indent)
            t:Show()
            prev, prevIndent = t, indent
            return t
        end
        for i, section in ipairs(card) do
            addText("micro", "gilt-text", 0, i == 1 and S["space-4"] or S["space-5"]):SetValue(section.title)
            for _, line in ipairs(section.lines) do addText("body", "ink", 15, S["space-2"]):SetValue(line) end
        end
    end
end

--------------------------------------------------------------------------------
-- The strip: 40px cells, 2 rows of 18 a page
--------------------------------------------------------------------------------

class Cell extends Button
    readonly icon: Texture
    readonly edge: Border
    readonly star: Texture
    readonly fresh: Texture
    readonly jewel: Texture
    hover: boolean = false
    entry: Entry? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(CELL, CELL)
        UI.Fill(self, "surface-sunk", "BACKGROUND"):SetAllPoints()
        self.icon = self:CreateTexture(nil, "ARTWORK")
        self.icon:SetPoint("TOPLEFT", 1, -1)
        self.icon:SetPoint("BOTTOMRIGHT", -1, 1)
        self.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        self.edge = UI.Border(self, "gilt-hairline", { layer = "OVERLAY" })
        self.star = self:CreateTexture(nil, "OVERLAY", nil, 2)
        self.star:SetTexture(GLYPHS .. "star.tga")
        self.star:SetSize(11, 11)
        self.star:SetPoint("TOPRIGHT", -1, -1)
        UI.Paint(self.star, "gilt-text")
        self.fresh = UI.Diamond(self, 6, "ink", "OVERLAY", 3)
        self.fresh:SetPoint("CENTER", self, "TOPLEFT", 1, -1)
        self.jewel = UI.Diamond(self, 5, "gilt", "OVERLAY", 3)
        self.jewel:SetPoint("CENTER", self, "BOTTOM", 0, -4)
        self:SetScript("OnEnter", function()
            self.hover = true
            M:DrawCell(self)
            local e = self.entry
            if not e then return end
            UI.ShowTooltip(self, { title = e.name, subtitle = e.collected and (status(e)) or nil,
                description = sourceLine(e.source, e.kind == "appearance" and "appearance" or "mount", e.sourceType) })
        end)
        self:SetScript("OnLeave", function() self.hover = false; M:DrawCell(self); UI.HideTooltip() end)
        self:SetScript("OnClick", function() M:Choose(self.entry) end)
        self:EnableMouseWheel(true)
        self:SetScript("OnMouseWheel", function(_: Frame, delta: number) M:Page(-delta) end)
    end
end

--------------------------------------------------------------------------------
-- Appearances (design: the paper doll): you in the middle of the stage, the
-- 14 slots in two columns around you with yours of all, the class and the
-- weapon kind at the top right; the strip is 10 framed 3D tiles of the
-- slot's appearances; the chosen one tried on you, its card at the left,
-- the star and Undress at the bottom right.
--------------------------------------------------------------------------------

local QUALITY: { [number]: string } = { [0] = "poor", "common", "uncommon", "rare", "epic", "legendary", "legendary", "legendary" }
local SLOT = 30
local SLOTS_L = { "HEADSLOT", "SHOULDERSLOT", "BACKSLOT", "CHESTSLOT", "SHIRTSLOT", "TABARDSLOT", "WRISTSLOT" }
local SLOTS_R = { "HANDSSLOT", "WAISTSLOT", "LEGSSLOT", "FEETSLOT", "MAINHANDSLOT", "SECONDARYHANDSLOT", "RANGEDSLOT" }
local SLOT_ATLAS: { [string]: string } = {
    HEADSLOT = "transmog-nav-slot-head", SHOULDERSLOT = "transmog-nav-slot-shoulder", BACKSLOT = "transmog-nav-slot-back",
    CHESTSLOT = "transmog-nav-slot-chest", SHIRTSLOT = "transmog-nav-slot-shirt", TABARDSLOT = "transmog-nav-slot-tabard",
    WRISTSLOT = "transmog-nav-slot-wrist", HANDSSLOT = "transmog-nav-slot-hands", WAISTSLOT = "transmog-nav-slot-waist",
    LEGSSLOT = "transmog-nav-slot-legs", FEETSLOT = "transmog-nav-slot-feet", MAINHANDSLOT = "transmog-nav-slot-mainhand",
    SECONDARYHANDSLOT = "transmog-nav-slot-secondaryhand", RANGEDSLOT = "transmog-nav-slot-ranged",
}

local function qualityToken(quality: number?): string?
    return quality and quality ~= 1 and ("quality-" .. (QUALITY[quality] or "common")) or nil
end

-- The classes the game has, for the class choice.
local function classes(): SelectOption<number>[]
    local out: SelectOption<number>[] = {}
    for id = 1, 13 do
        local name = asString(try(field(_G, "GetClassInfo"), id))
        if name then out[#out + 1] = { value = id, label = name } end
    end
    return out
end

-- One round slot: the game's slot art in a disc, the arcane glow under the
-- chosen one, yours of all under it.
class SlotButton extends Button
    readonly glow: Texture
    readonly ring: Texture
    readonly disc: Texture
    readonly art: Texture
    readonly n: Text
    readonly slot: string
    hover: boolean = false

    constructor(parent: Frame, slot: string)
        super(nil, parent)
        self.slot = slot
        self:SetSize(SLOT, SLOT)
        self.glow = self:CreateTexture(nil, "BACKGROUND", nil, 1)
        self.glow:SetTexture(SOFT)
        self.glow:SetSize(50, 50)
        self.glow:SetPoint("CENTER")
        UI.Paint(self.glow, "arcane")
        self.glow:SetAlpha(0.55)
        self.ring = self:CreateTexture(nil, "BACKGROUND", nil, 2)
        self.ring:SetTexture(DISC)
        self.ring:SetAllPoints()
        self.disc = self:CreateTexture(nil, "BACKGROUND", nil, 3)
        self.disc:SetTexture(DISC)
        self.disc:SetPoint("TOPLEFT", 1, -1)
        self.disc:SetPoint("BOTTOMRIGHT", -1, 1)
        UI.Paint(self.disc, "surface-sunk")
        local art = self:CreateTexture(nil, "ARTWORK")
        self.art = art
        art:SetPoint("TOPLEFT", 2, -2)
        art:SetPoint("BOTTOMRIGHT", -2, 2)
        if not pcall(art.SetAtlas, art, SLOT_ATLAS[slot] or "") then art:SetTexture(GLYPHS .. "shield.tga") end
        local mask = self:CreateMaskTexture()
        mask:SetTexture(DISC, "CLAMPTOBLACKADDITIVE", "CLAMPTOBLACKADDITIVE")
        mask:SetAllPoints(art)
        art:AddMaskTexture(mask)
        self.n = UI.Text(self, "micro", "ink-muted")
        self.n:SetPoint("TOP", self, "BOTTOM", 0, -1)
        self:SetScript("OnEnter", function()
            self.hover = true
            M:DrawSlot(self)
            local def = assert(slotDef(self.slot))
            local counts = M.slotCounts
            local c = counts and counts[self.slot]
            UI.ShowTooltip(self, { title = def.label,
                description = (c and c.reason) or ("%d of %d collected"):format(c and c.have or 0, c and c.all or 0) })
        end)
        self:SetScript("OnLeave", function() self.hover = false; M:DrawSlot(self); UI.HideTooltip() end)
        self:SetScript("OnClick", function()
            local counts = M.slotCounts
            local c = counts and counts[self.slot]
            if c and c.reason then return end
            M.slot, M.chosen, M.page = self.slot, nil, 1
            M:Refresh()
        end)
    end
end

-- A tile: a framed preview of you wearing only that piece (the game's
-- appearance camera), its icon until the model has loaded.
class Tile extends Button
    readonly bg: Texture
    readonly model: DressUpModel
    readonly dim: Texture
    readonly icon: Texture
    readonly edge: Border
    readonly worn: Text
    readonly star: Texture
    readonly jewel: Texture
    hover: boolean = false
    entry: Entry? = nil
    shownID: number? = nil
    loading: boolean = false
    sizedW: number? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self.bg = self:CreateTexture(nil, "BACKGROUND", nil, -8)
        self.bg:SetAllPoints()
        self.bg:SetColorTexture(1, 1, 1, 1)
        self.bg:SetGradient("VERTICAL", CreateColor(0.051, 0.043, 0.035, 1), CreateColor(0.102, 0.09, 0.075, 1))
        self.model = CreateFrame("DressUpModel", nil, self)
        self.model:SetPoint("TOPLEFT", 1, -1)
        self.model:SetPoint("BOTTOMRIGHT", -1, 1)
        self.model:SetScript("OnModelLoaded", function()
            if self.loading then
                self.loading = false
                self.icon:Hide()
                self.model:SetAlpha(1)
                SuuUI.Motion.FadeIn(self.model, T.duration["dur-base"])
            end
        end)
        self.dim = self:CreateTexture(nil, "OVERLAY", nil, 1)
        self.dim:SetAllPoints()
        self.dim:SetColorTexture(0, 0, 0, 0.45)
        self.icon = self:CreateTexture(nil, "OVERLAY", nil, 2)
        self.icon:SetSize(32, 32)
        self.icon:SetPoint("CENTER")
        self.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        self.edge = UI.Border(self, "gilt-faint", { layer = "OVERLAY", sublevel = 3 })
        self.worn = UI.Text(self, "micro", "gilt-text")
        self.worn:SetPoint("BOTTOM", 0, 2)
        self.worn:SetValue("Worn")
        self.star = self:CreateTexture(nil, "OVERLAY", nil, 4)
        self.star:SetTexture(GLYPHS .. "star.tga")
        self.star:SetSize(11, 11)
        self.star:SetPoint("TOPRIGHT", -2, -2)
        UI.Paint(self.star, "gilt-text")
        self.jewel = UI.Diamond(self, 5, "gilt", "OVERLAY", 5)
        self.jewel:SetPoint("CENTER", self, "BOTTOM", 0, -4)
        self:SetScript("OnEnter", function()
            self.hover = true
            M:DrawTileState(self)
            local e = self.entry
            if not e then return end
            UI.ShowTooltip(self, { title = e.name, titleColor = qualityToken(e.quality),
                subtitle = e.worn and "Worn" or (e.collected and "Collected" or "Not collected"),
                description = sourceLine(e.source, "appearance", e.sourceType) })
        end)
        self:SetScript("OnLeave", function() self.hover = false; M:DrawTileState(self); UI.HideTooltip() end)
        self:SetScript("OnClick", function() M:Choose(self.entry) end)
        self:EnableMouseWheel(true)
        self:SetScript("OnMouseWheel", function(_: Frame, delta: number) M:Page(-delta) end)
    end
end

-- The strip: its cells (Mounts) or tiles (Appearances), the page arrows.
class Strip extends Frame
    readonly prev: SuuButton
    readonly next: SuuButton
    readonly pageText: Text
    readonly grid: Frame
    readonly cells: Cell[] = {}
    readonly empty: Text
    readonly tileGrid: Frame
    readonly tiles: Tile[] = {}

    constructor(body: Frame)
        super(nil, body)
        self:SetPoint("BOTTOMLEFT")
        self:SetPoint("BOTTOMRIGHT")
        self:SetHeight(STRIP_H)
        self:EnableMouseWheel(true)
        self:SetScript("OnMouseWheel", function(_: Frame, delta: number) M:Page(-delta) end)
        self.prev = UI.Button(self, { icon = "chevronLeft", width = 30, onClick = function() M:Page(-1) end })
        self.prev:SetPoint("LEFT", 0, S["space-2"])
        self.next = UI.Button(self, { icon = "chevronRight", width = 30, onClick = function() M:Page(1) end })
        self.next:SetPoint("RIGHT", 0, S["space-2"] + 8)
        self.pageText = UI.Text(self, "micro", "ink-muted")
        self.pageText:SetPoint("TOP", self.next, "BOTTOM", 0, -S["space-2"])
        self.grid = CreateFrame("Frame", nil, self)
        self.grid:SetPoint("TOPLEFT", self, "TOPLEFT", 30 + S["space-5"], 0)
        self.grid:SetPoint("BOTTOMRIGHT", self, "BOTTOMRIGHT", -(30 + S["space-5"]), 0)
        for i = 1, COLS * ROWS do self.cells[i] = Cell.new(self.grid) end
        self.empty = UI.Text(self, "body", "ink-muted")
        self.empty:SetPoint("CENTER")
        self.grid:HookScript("OnSizeChanged", function() M:LayoutCells() end)
        -- the tiles, in the cells' place
        self.tileGrid = CreateFrame("Frame", nil, self)
        self.tileGrid:SetPoint("TOPLEFT", self.grid, "TOPLEFT")
        self.tileGrid:SetPoint("BOTTOMRIGHT", self.grid, "BOTTOMRIGHT")
        self.tileGrid:Hide()
        for i = 1, TILES do self.tiles[i] = Tile.new(self.tileGrid) end
        self.tileGrid:HookScript("OnSizeChanged", function() M:LayoutTiles() end)
    end
end

-- The strip's tools: the search, the filters, the count; Appearances' title.
class Tools extends Frame
    readonly search: TextField
    readonly have: Segmented<string>
    readonly list: Segmented<string>
    readonly count: Text
    readonly track: Texture
    readonly fill: Texture
    readonly title: Text

    constructor(body: Frame, strip: Frame)
        super(nil, body)
        self:SetPoint("BOTTOMLEFT", strip, "TOPLEFT", 0, S["space-5"])
        self:SetPoint("BOTTOMRIGHT", strip, "TOPRIGHT", 0, S["space-5"])
        self:SetHeight(TOOLS_H)
        local function changed() M.page = 1; M:Refresh() end
        self.search = UI.TextField(self, { width = 190, placeholder = "Search", onTextChanged = function() changed() end })
        self.search:SetPoint("LEFT")
        self.have = UI.Segmented(self, { value = "all", options = { { value = "all", label = "All" }, { value = "have", label = "Collected" },
            { value = "missing", label = "Not collected" } }, onChange = function() changed() end })
        self.have:SetPoint("LEFT", self.search, "RIGHT", S["space-4"], 0)
        self.list = UI.Segmented(self, { value = "all", options = { { value = "all", label = "Mounts" }, { value = "fav", label = "Favourites" },
            { value = "recent", label = "Recent" } }, onChange = function() changed() end })
        self.list:SetPoint("LEFT", self.have, "RIGHT", S["space-4"], 0)
        self.count = UI.Text(self, "numeric", "ink")
        self.count:SetPoint("RIGHT", -70, 0)
        self.track = UI.Fill(self, "track", "ARTWORK")
        self.track:SetSize(60, 2)
        self.track:SetPoint("RIGHT")
        self.fill = UI.Fill(self, "gilt", "OVERLAY")
        self.fill:SetHeight(2)
        self.fill:SetPoint("LEFT", self.track, "LEFT")
        -- the title (Appearances: the slot and kind)
        self.title = UI.Text(self, "header", "gilt-text")
        self.title:SetPoint("LEFT")
    end
end

-- The mount: fitted by the game, turned by drag, zoomed by the wheel.
class MountModel extends PlayerModel
    dragX: number? = nil

    constructor(stage: Frame)
        super(nil, stage)
        self:SetSize(MODEL_W, MODEL_H)
        self:SetPoint("BOTTOM", stage, "BOTTOM", 0, FEET_Y - FEET_DROP + FEET_BELOW - MODEL_H / 2)
        self:SetFrameLevel(stage:GetFrameLevel() + 2)
        self:EnableMouse(true)
        self:EnableMouseWheel(true)
        self:SetScript("OnMouseDown", function(_: Frame, button: string)
            if button == "LeftButton" then self.dragX = (GetCursorPosition()) end
        end)
        self:SetScript("OnMouseUp", function() self.dragX = nil end)
        self:SetScript("OnUpdate", function()
            local from = self.dragX
            if not from then return end
            local x = GetCursorPosition()
            local delta = (x - from) / (self:GetEffectiveScale() * 100)
            self.dragX = x
            if delta ~= 0 then try(self.SetFacing, self, (asNumber(try(self.GetFacing, self)) or 0) + delta) end
        end)
        self:SetScript("OnMouseWheel", function(_: Frame, delta: number) M:Zoom(-delta) end)
        self:SetScript("OnModelLoaded", function() M:ModelLoaded() end)
    end
end

-- You on the Appearances stage: turned by drag, zoomed by the wheel.
class Doll extends DressUpModel
    dragX: number? = nil
    dressed: boolean = false

    constructor(parent: Frame)
        super(nil, parent)
        self:SetPoint("TOPLEFT", DOLL_L + 40, -S["space-4"])
        self:SetPoint("BOTTOMRIGHT", -(DOLL_R + 40), S["space-4"])
        self:EnableMouse(true)
        self:EnableMouseWheel(true)
        self:SetScript("OnMouseDown", function(_: Frame, button: string)
            if button == "LeftButton" then self.dragX = (GetCursorPosition()) end
        end)
        self:SetScript("OnMouseUp", function() self.dragX = nil end)
        self:SetScript("OnUpdate", function()
            local from = self.dragX
            if not from then return end
            local x = GetCursorPosition()
            local delta = (x - from) / (self:GetEffectiveScale() * 100)
            self.dragX = x
            if delta ~= 0 then try(self.SetFacing, self, (asNumber(try(self.GetFacing, self)) or 0) + delta) end
        end)
        self:SetScript("OnMouseWheel", function(_: Frame, delta: number) M:Zoom(-delta) end)
    end
end

-- The stage's icon while a model loads.
class Loading extends Frame
    readonly icon: Texture
    readonly text: Text

    constructor(stage: Frame)
        super(nil, stage)
        self:SetSize(200, 120)
        self:SetPoint("CENTER", stage, "CENTER", 0, FLOOR / 2)
        self:SetFrameLevel(stage:GetFrameLevel() + 3)
        self.icon = self:CreateTexture(nil, "ARTWORK")
        self.icon:SetSize(80, 80)
        self.icon:SetPoint("TOP")
        self.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        self.text = UI.Text(self, "caption", "ink-muted")
        self.text:SetPoint("TOP", self.icon, "BOTTOM", 0, -S["space-4"])
        self.text:SetValue("Loading the model…")
        self:Hide()
    end
end

-- The empty stage: what the search left.
class EmptyStage extends Frame
    readonly title: Text
    readonly text: Text

    constructor(stage: Frame)
        super(nil, stage)
        self:SetAllPoints()
        self:SetFrameLevel(stage:GetFrameLevel() + 4)
        self.title = UI.Text(self, "alert", "ink")
        self.title:SetPoint("TOP", 0, -S["space-7"])
        self.text = UI.Text(self, "body", "ink-muted")
        self.text:SetPoint("TOP", self.title, "BOTTOM", 0, -S["space-3"])
        self.text:SetWidth(420)
        self.text:SetWordWrap(true)
        self.text:SetJustifyH("CENTER")
        self:Hide()
    end
end

-- The stage: the model's art, what loads, the empty stage, the star, the
-- turn and zoom buttons, the hint.
class Stage extends Frame
    readonly art: ModelStage
    readonly loading: Loading
    readonly empty: EmptyStage
    readonly star: RoundButton
    readonly ctl: Frame
    readonly buttons: RoundButton[] = {}
    readonly hint: Text

    constructor(body: Frame, tools: Frame)
        super(nil, body)
        self:SetPoint("TOPLEFT")
        self:SetPoint("TOPRIGHT")
        self:SetPoint("BOTTOM", tools, "TOP", 0, S["space-5"])
        self:SetClipsChildren(true)
        self.art = UI.ModelStage(self, { floor = FLOOR, shade = SHADE_W })
        self.loading = Loading.new(self)
        self.empty = EmptyStage.new(self)
        self.star = RoundButton.new(self, "star", favouriteTip, function() M:ToggleFavourite() end)
        self.star:SetFrameLevel(self:GetFrameLevel() + 12)
        -- bottom centre of the model's area: turn left, zoom out, zoom in, turn right
        local ctl = CreateFrame("Frame", nil, self)
        ctl:SetSize(4 * 26 + 3 * S["space-3"], 26)
        ctl:SetPoint("BOTTOM", self, "BOTTOM", 0, S["space-4"])
        ctl:SetFrameLevel(self:GetFrameLevel() + 12)
        local x = 0
        local buttons: { glyph: string, tip: string, click: () -> () }[] = {
            { glyph = "turnLeft", tip = "Turn left", click = function() M:Turn(-1) end },
            { glyph = "minus", tip = "Zoom out", click = function() M:Zoom(1) end },
            { glyph = "plus", tip = "Zoom in", click = function() M:Zoom(-1) end },
            { glyph = "turnRight", tip = "Turn right", click = function() M:Turn(1) end },
        }
        for _, def in ipairs(buttons) do
            local b = RoundButton.new(ctl, def.glyph, def.tip, function() def.click() end)
            if not (def.glyph == "minus" or def.glyph == "plus") then
                -- turn arrows: the reset glyph, mirrored for the right
                b.glyph:SetTexture(GLYPHS .. "reset.tga")
                if def.glyph == "turnRight" then b.glyph:SetTexCoord(1, 0, 0, 1) end
            end
            b:SetPoint("LEFT", x, 0)
            self.buttons[#self.buttons + 1] = b
            x = x + 26 + S["space-3"]
        end
        self.ctl = ctl
        self.art.ctl = ctl
        self.hint = UI.Text(self, "caption", "ink-faint")
        self.hint:SetPoint("BOTTOMRIGHT", -S["space-5"], S["space-5"])
        self.hint:SetValue("Drag to turn · Wheel to zoom")
    end

    function CentreOn(x: number) self.art:CentreOn(x) end
    function Tint(token: string) self.art:Tint(token) end
end

-- Appearances' stage: the doll, the slots, the class and the weapon kind,
-- the star and Undress.
class Wardrobe extends Frame
    readonly doll: Doll
    readonly slots: SlotButton[] = {}
    readonly class: Select<number>
    readonly kind: Select<number>
    readonly star: RoundButton
    readonly undress: SuuButton

    constructor(stage: Frame)
        super(nil, stage)
        self:SetAllPoints()
        self:SetFrameLevel(stage:GetFrameLevel() + 2)
        self:Hide()
        -- you, between the two columns of slots
        self.doll = Doll.new(self)
        -- the slots
        local function column(names: string[], x: number, fromRight: boolean)
            local top, bottom = S["space-6"], S["space-6"] + 14
            local height = stage:GetHeight()
            local span = height > 0 and height or 410
            local step = (span - top - bottom - SLOT) / (#names - 1)
            for i, slot in ipairs(names) do
                local b = SlotButton.new(self, slot)
                if fromRight then b:SetPoint("TOPRIGHT", self, "TOPRIGHT", -x, -(top + (i - 1) * step))
                else b:SetPoint("TOPLEFT", self, "TOPLEFT", x, -(top + (i - 1) * step)) end
                self.slots[#self.slots + 1] = b
            end
        end
        column(SLOTS_L, DOLL_L, false)
        column(SLOTS_R, DOLL_R, true)
        -- the class and the weapon kind
        local classID = asNumber((select(3, UnitClass("player"))))
        self.class = UI.Select(self, { options = classes(), value = classID, width = 140,
            onChange = function(id: number)
                try(field(C_TransmogCollection, "SetClassFilter"), id)
                M.weaponKind, M.chosen, M.page, M.slotCounts = {}, nil, 1, nil
                M:Refresh()
            end })
        self.class:SetPoint("TOPRIGHT", -S["space-6"], -S["space-6"])
        self.class:SetFrameLevel(self:GetFrameLevel() + 10)
        self.kind = UI.Select(self, { options = {}, width = 180, onChange = function(cat: number)
            local weapon = slotDef(M.slot)?.weapon
            if weapon then M.weaponKind[weapon] = cat end
            M.chosen, M.page = nil, 1
            M:Refresh()
        end })
        self.kind:SetPoint("TOPRIGHT", self.class, "BOTTOMRIGHT", 0, -S["space-3"])
        self.kind:SetFrameLevel(self:GetFrameLevel() + 10)
        -- bottom right: the star and Undress
        self.star = RoundButton.new(self, "star", favouriteTip, function() M:ToggleFavourite() end)
        self.star:SetFrameLevel(self:GetFrameLevel() + 10)
        self.undress = UI.Button(self, { text = "Undress", icon = "reset", width = 110, onClick = function()
            try(self.doll.Dress, self.doll)
            M.tried = nil
        end })
        self.undress.tooltip = { title = "Undress", description = "Back to what you wear." }
        self.undress:SetPoint("BOTTOMRIGHT", -S["space-6"], S["space-6"])
        self.undress:SetFrameLevel(self:GetFrameLevel() + 10)
        self.star:SetPoint("RIGHT", self.undress, "LEFT", -S["space-4"], 0)
    end
end

--------------------------------------------------------------------------------
-- Toys (design: A, the toy shelf; asked in game: no toy has a 3D model, so
-- no stage): every toy as a card in four columns under the tools, what it
-- does, where it comes from or when it is ready, the star and Use (each
-- card's own secure button). Hovering a card: all of it.
--------------------------------------------------------------------------------

local CARD_H, SHELF_COLS = 88, 4

-- What a toy does: the "Use:" line of its tooltip (kept once known).
local useText: { [number]: string } = {}
local function toyUse(itemID: number?): string?
    if not itemID then return nil end
    local known = useText[itemID]
    if known then return known end
    local tip = try(field(C_TooltipInfo, "GetToyByItemID"), itemID)
    for _, l in ipairs(list(field(tip, "lines"))) do
        local t = asString(field(l, "leftText"))
        if t and t:find("^Use:") then
            local text = (t:gsub("^Use:%s*", ""))
            useText[itemID] = text
            return text
        end
    end
    return nil
end

-- Why a toy's Use is off (nil: on).
local function toyWhy(e: Entry, start: number, duration: number): string?
    if not e.collected then return "You don't have this toy yet." end
    if duration > 0 then return readyIn(start, duration) .. "." end
    if e.usable == false then return "You can't use this toy here." end
    return nil
end

class ToyCard extends Frame
    readonly bg: Texture
    readonly edge: Border
    readonly plate: Frame
    readonly icon: Texture
    readonly plateEdge: Border
    readonly cd: Cooldown
    readonly star: RoundButton
    readonly name: Text
    readonly check: Texture
    readonly use: Text
    readonly src: Text
    readonly act: SecureAction
    hover: boolean = false
    entry: Entry? = nil

    constructor(parent: Frame, i: number)
        super(nil, parent)
        self:SetHeight(CARD_H)
        self:EnableMouse(true)
        self.bg = UI.Fill(self, "surface-sunk", "BACKGROUND")
        self.bg:SetAllPoints()
        self.edge = UI.Border(self, "gilt-faint")
        self.plate = CreateFrame("Frame", nil, self)
        self.plate:SetSize(40, 40)
        self.plate:SetPoint("TOPLEFT", S["space-4"], -S["space-4"])
        UI.Fill(self.plate, "surface-sunk", "BACKGROUND"):SetAllPoints()
        self.icon = self.plate:CreateTexture(nil, "ARTWORK")
        self.icon:SetPoint("TOPLEFT", 1, -1)
        self.icon:SetPoint("BOTTOMRIGHT", -1, 1)
        self.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
        self.plateEdge = UI.Border(self.plate, "gilt-hairline", { layer = "OVERLAY" })
        self.cd = CreateFrame("Cooldown", nil, self.plate, "CooldownFrameTemplate")
        self.cd:SetAllPoints(self.icon)
        self.star = RoundButton.new(self, "star", favouriteTip, function() M:ToggleToyFavourite(self.entry) end)
        self.star:SetSize(20, 20)
        self.star.disc:Hide()
        self.star:SetPoint("TOPRIGHT", -S["space-3"], -S["space-3"])
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT", self.plate, "TOPRIGHT", S["space-4"], 0)
        self.name:SetPoint("RIGHT", self.star, "LEFT", -18, 0)
        self.name:SetWordWrap(false)
        self.check = self:CreateTexture(nil, "OVERLAY")
        self.check:SetTexture(GLYPHS .. "check.tga")
        self.check:SetSize(11, 11)
        UI.Paint(self.check, "gilt-text")
        self.use = UI.Text(self, "caption", "ink-muted")
        self.use:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -1)
        self.use:SetPoint("RIGHT", -S["space-4"], 0)
        self.use:SetJustifyH("LEFT")
        self.use:SetWordWrap(true)
        self.use:SetMaxLines(2)
        self.src = UI.Text(self, "caption", "ink-muted")
        self.src:SetPoint("BOTTOMLEFT", S["space-4"], S["space-3"] + 4)
        self.src:SetPoint("RIGHT", -(S["space-4"] + 64), 0)
        self.src:SetJustifyH("LEFT")
        self.src:SetWordWrap(false)
        -- Use: the card's own secure button, the look a small SuuUI button under it
        self.act = SecureAction.new("SuuUIToyUse" .. i, self, "Use", 56)
        self.act:SetSize(56, 22)
        self.act:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-3"])
        self:SetScript("OnEnter", function()
            self.hover = true
            self:DrawState()
            local e = self.entry
            if not e then return end
            local lines: TooltipLine[] = {}
            for _, sec in ipairs(sourceCard(e.source, "toy", nil)) do
                lines[#lines + 1] = { sec.title }
                for _, l in ipairs(sec.lines) do lines[#lines + 1] = { "   " .. l } end
            end
            UI.ShowTooltip(self, { title = e.name, subtitle = e.collected and "Collected" or "Not collected",
                description = toyUse(e.itemID), lines = lines[1] and lines or { { "Source unknown" } } })
        end)
        self:SetScript("OnLeave", function() self.hover = false; self:DrawState(); UI.HideTooltip() end)
    end

    function DrawState()
        if not self.entry then return end
        self.edge:SetColor(self.hover and "gilt" or "gilt-faint")
        UI.PaintFill(self.bg, self.hover and "surface-raised" or "surface-sunk")
    end

    -- Its cooldown, its foot line and its Use.
    function DrawCooldown()
        local e = self.entry
        if not e then return end
        local start, duration = 0, 0
        local itemID = e.itemID
        if e.collected and itemID then start, duration = toyCooldown(itemID) end
        if duration > 0 then
            self.cd:SetCooldown(start, duration)
            self.src:SetValue(readyIn(start, duration))
            self.src:SetColor("arcane")
        else
            self.cd:Clear()
            self.src:SetValue(sourceLine(e.source, "toy", nil))
            self.src:SetColor(e.collected and "ink-muted" or "ink")
        end
        local why = toyWhy(e, start, duration)
        self.act.look:SetEnabledState(why == nil)
        self.act.why = why
    end
end

-- The toy shelf: the cards in a scroll area.
class Shelf extends Frame
    readonly list: ScrollArea
    readonly cards: ToyCard[] = {}
    readonly empty: Text

    constructor(body: Frame)
        super(nil, body)
        self:SetAllPoints()
        self:Hide()
        local BAR = S["space-3"]
        self.list = UI.ScrollArea(self, BAR)
        self.list:SetPoint("TOPLEFT", 0, -(TOOLS_H + S["space-5"]))
        self.list:SetPoint("BOTTOMRIGHT", -(BAR + 3), 0)
        self.list:HookScript("OnSizeChanged", function(_: Frame, w: number) self.list.child:SetWidth(w); M:LayoutShelf() end)
        self.empty = UI.Text(self.list.child, "body", "ink-muted")
        self.empty:SetPoint("TOP", 0, -S["space-7"])
        self.empty:SetValue("No toys match.")
    end
end

-- The window's parts, built once.
type Parts = {
    window: WindowFrame, strip: Strip, tools: Tools, stage: Stage, model: MountModel, card: StageCard,
    act: SecureAction, wardrobe: Wardrobe, shelf: Shelf, foot: Text, last: Text,
}

--------------------------------------------------------------------------------
-- What the strip shows: the tab's entries through the search and filters
--------------------------------------------------------------------------------

-- The entries a search (lower case) and the filters keep: have "all",
-- "have", "missing"; list "all", "fav", "recent" (newest first, what you
-- had before SuuUI last).
local function filterEntries(all: Entry[], search: string, have: string, kind: string): Entry[]
    local out: Entry[] = {}
    for _, e in ipairs(all) do
        local ok = (search == "" or e.name:lower():find(search, 1, true))
            and (have == "all" or (have == "have") == (e.collected and true or false))
            and (kind ~= "fav" or e.favourite)
            and (kind ~= "recent" or e.learned ~= nil)
        if ok then out[#out + 1] = e end
    end
    if kind == "recent" then
        table.sort(out, function(a: Entry, b: Entry): boolean
            local x, y = a.learned or -1, b.learned or -1
            if x == 0 then x = -1 end
            if y == 0 then y = -1 end
            if x ~= y then return x > y end
            return a.name < b.name
        end)
    end
    return out
end

-- how far below the frame's middle the ground under the model shows, with
-- the camera at P aiming at T and the model lifted by `lift`
local function dot(a: number[], b: number[]): number return a[1] * b[1] + a[2] * b[2] + a[3] * b[3] end
local function norm(x: number, y: number, z: number): number[]?
    local l = math.sqrt(x * x + y * y + z * z)
    if l == 0 then return nil end
    return { x / l, y / l, z / l }
end
local function groundBelow(P: number[], aim: number[], lift: number): number?
    local f = norm(aim[1] - P[1], aim[2] - P[2], aim[3] - P[3])
    if not f then return nil end
    local right = norm(f[2], -f[1], 0)
    if not right then return nil end
    local u = { right[2] * f[3] - right[3] * f[2], right[3] * f[1] - right[1] * f[3], right[1] * f[2] - right[2] * f[1] }
    if u[3] < 0 then u = { -u[1], -u[2], -u[3] } end
    local r = { -P[1], -P[2], lift - P[3] }
    local depth = dot(r, f)
    if depth <= 0 then return nil end
    return -FEET_K * math.max(MODEL_W, MODEL_H) * dot(r, u) / depth
end

-- The stage's action: its label and why it's off (nil: on).
local function actionLabel(mounted: boolean, e: Entry?): (string, string?)
    if mounted then return "Dismiss", nil end
    if not e then return "Summon", "Choose a mount." end
    if not e.collected then return "Summon", "You don't have this mount yet." end
    if not e.usable then return "Summon", "You can't ride this mount here." end
    return "Summon", nil
end

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

class CollectionsModule extends Module<{}>
    ui: Parts? = nil
    tab: string = "mounts"
    slot: string = "CHESTSLOT"
    -- the strip: its entries (and all of the tab's), the page, the chosen one
    entries: Entry[] = {}
    all: Entry[] = {}
    page: number = 1
    pages: number = 1
    chosen: Entry? = nil
    -- the mount on the stage: shown, waited for, the camera's distance
    showing: number? = nil
    waiting: number? = nil
    camScale: number = CAM_SCALE
    -- Appearances: the weapon kinds chosen and offered, the slots' counts,
    -- what is tried on, the doll's zoom, the title
    weaponKind: { [string]: number } = {}
    kinds: WeaponKind[] = {}
    slotCounts: { [string]: SlotCount }? = nil
    tried: number? = nil
    dollScale: number = 1
    slotTitle: string = ""
    -- names the game hasn't sent yet
    namesPending: boolean = false
    namesTimer: TimerHandle? = nil
    -- what waits for the end of combat
    bindAfterCombat: boolean = false
    actionAfterCombat: boolean = false
    shelfAfterCombat: boolean = false
    layoutAfterCombat: boolean = false
    bindOwner: Frame? = nil
    toggleButton: Button? = nil
    closeOverlay: Button? = nil
    journalHooked: boolean = false
    ticker: TickerHandle? = nil

    constructor()
        super({
            id = "collections",
            name = "Collections",
            description = "SuuUI's collections window: mounts, toys and appearances on a model stage, what you lack and where to get it.",
            api = "0.17",
            reloadToToggle = true,
            defaults = {},
        })
    end

    function SourceLine(src: CollectionSource?, kind: string, number: number?): string return sourceLine(src, kind, number) end
    function SourceCard(src: CollectionSource?, kind: string, number: number?): CardSection[] return sourceCard(src, kind, number) end

    -- What SuuUI keeps for this character.
    function Saved(): CharStore return self:CharData() :: unknown :: CharStore end

    ----------------------------------------------------------------------------
    -- What there is
    ----------------------------------------------------------------------------

    -- Every mount this character can see (the rest: the other faction's, or no
    -- model in Forever's data: probed, 49 of 139), favourites and yours first.
    function Mounts(): Entry[]
        local MJ = C_MountJournal
        local out: Entry[] = {}
        for _, idR in ipairs(list(try(field(MJ, "GetMountIDs")))) do
            local id = asNumber(idR)
            local nameR, spellID, icon, active, usable, sourceType, favourite, _, faction, hidden, collectedR = try(field(MJ, "GetMountInfoByID"), id)
            local name = asString(nameR)
            if id and name and not flag(hidden) then
                local display, _, _, isSelf, _, scene = try(field(MJ, "GetMountInfoExtraByID"), id)
                local collected = flag(collectedR)
                out[#out + 1] = {
                    kind = "mount", id = id, name = name, spellID = asNumber(spellID), icon = asNumber(icon), active = flag(active),
                    usable = flag(usable), favourite = flag(favourite), collected = collected, sourceType = asNumber(sourceType),
                    faction = asNumber(faction), display = asNumber(display), scene = asNumber(scene), isSelf = flag(isSelf),
                    source = data().mount[id], learned = self:Learned("mount", id, collected),
                }
            end
        end
        table.sort(out, function(a: Entry, b: Entry): boolean
            if a.collected ~= b.collected then return a.collected end
            if a.favourite ~= b.favourite then return a.favourite and true or false end
            return a.name < b.name
        end)
        return out
    end

    -- Every toy of Forever (from the client's own list: the game won't list the
    -- ones you lack), yours first.
    function Toys(): Entry[]
        local out: Entry[] = {}
        for _, itemID in ipairs(data().toys) do
            local _, nameR, icon, favourite = try(field(C_ToyBox, "GetToyInfo"), itemID)
            local name = asString(nameR) or itemName(itemID) or ("Toy " .. itemID)
            local has = flag(try(PlayerHasToy, itemID))
            out[#out + 1] = {
                kind = "toy", id = itemID, itemID = itemID, name = name,
                icon = asNumber(icon) or asNumber(try(field(C_Item, "GetItemIconByID"), itemID)),
                favourite = flag(favourite), collected = has, usable = has and try(field(C_ToyBox, "IsToyUsable"), itemID) ~= false,
                source = data().toy[itemID], learned = self:Learned("toy", itemID, has),
            }
            if name:find("^Toy %d") then self.namesPending = true end
        end
        table.sort(out, function(a: Entry, b: Entry): boolean
            if a.collected ~= b.collected then return a.collected end
            if (a.favourite and true or false) ~= (b.favourite and true or false) then return a.favourite and true or false end
            return a.name < b.name
        end)
        return out
    end

    -- The weapon kinds this class can use for a hand (the game names only those).
    function WeaponKinds(hand: string?): WeaponKind[]
        local out: WeaponKind[] = {}
        for cat = 12, 30 do
            local nameR, isWeapon, _, canMain, canOff, canRanged = try(field(C_TransmogCollection, "GetCategoryInfo"), cat)
            local name = asString(nameR)
            if name and flag(isWeapon) and ((hand == "main" and flag(canMain)) or (hand == "off" and flag(canOff)) or (hand == "ranged" and flag(canRanged))) then
                out[#out + 1] = { category = cat, name = name }
            end
        end
        return out
    end

    -- Each slot's yours and all (a weapon slot: over the kinds this class can
    -- use for it); a slot with no kind for this class: its reason.
    function SlotCounts(className: string?): { [string]: SlotCount }
        local out: { [string]: SlotCount } = {}
        for _, def in ipairs(SLOTS) do
            local cats: number[] = {}
            if def.category then cats[1] = def.category
            else for _, k in ipairs(self:WeaponKinds(def.weapon)) do cats[#cats + 1] = k.category end end
            local have, all = 0, 0
            for _, cat in ipairs(cats) do
                for _, a in ipairs(list(try(field(C_TransmogCollection, "GetCategoryAppearances"), cat, location(def.slot)))) do
                    if not flag(field(a, "isHideVisual")) then
                        all = all + 1
                        if flag(field(a, "isCollected")) then have = have + 1 end
                    end
                end
            end
            out[def.slot] = { have = have, all = all,
                reason = (not def.category and #cats == 0) and ("No " .. def.label:lower() .. " weapons for " .. (className or "this class")) or nil }
        end
        return out
    end

    -- What you wear in a slot: its appearance (visual) ID.
    function Worn(slot: string): number?
        local id = asNumber(try(GetInventorySlotInfo, slot))
        local itemID = id and asNumber(try(GetInventoryItemID, "player", id))
        if not itemID then return nil end
        return asNumber(try(field(C_TransmogCollection, "GetItemInfo"), itemID))
    end

    -- A category's appearances (yours first), each with its first source's item
    -- and that item's source data.
    function Appearances(category: number, slot: string?): Entry[]
        local TC = C_TransmogCollection
        local worn = slot and self:Worn(slot)
        local out: Entry[] = {}
        for _, a in ipairs(list(try(field(TC, "GetCategoryAppearances"), category, slot and location(slot)))) do
            local visualID = asNumber(field(a, "visualID"))
            if visualID and not flag(field(a, "isHideVisual")) then
                local first: unknown = nil
                for _, s in ipairs(list(try(field(TC, "GetAppearanceSources"), visualID))) do
                    if flag(field(s, "isCollected")) then first = s break end
                    first = first or s
                end
                if first then
                    local itemID = asNumber(field(first, "itemID"))
                    local name = asString(field(first, "name")) or itemName(itemID)
                    if not name then self.namesPending = true end
                    out[#out + 1] = {
                        kind = "appearance", id = visualID, visualID = visualID, sourceID = asNumber(field(first, "sourceID")), itemID = itemID,
                        name = name or "…", quality = asNumber(field(first, "quality")), collected = flag(field(a, "isCollected")),
                        favourite = flag(field(a, "isFavorite")), worn = worn == visualID, sourceType = asNumber(field(first, "sourceType")),
                        icon = asNumber(try(field(C_Item, "GetItemIconByID"), itemID)),
                        source = itemID and data().item[itemID] or nil,
                        camera = asNumber(try(field(TC, "GetAppearanceCameraID"), visualID)),
                    }
                end
            end
        end
        table.sort(out, function(a: Entry, b: Entry): boolean
            if a.worn ~= b.worn then return a.worn and true or false end
            if a.collected ~= b.collected then return a.collected end
            return (a.visualID or 0) < (b.visualID or 0)
        end)
        return out
    end

    ----------------------------------------------------------------------------
    -- Recently collected: the game keeps no dates, so SuuUI notes the day it
    -- first sees something yours (what you had before SuuUI: 0, "Before SuuUI")
    ----------------------------------------------------------------------------

    function Learned(kind: string, id: number, collected: boolean?): number?
        if not collected then return nil end
        local d = self:Saved()
        local learned = d.learned or {}
        d.learned = learned
        local seen: Seen? = learned[kind]
        if not seen then
            -- the first look at this kind: everything yours is from before SuuUI
            seen = { first = time() }
            learned[kind] = seen
        end
        local at = seen[id]
        if at == nil then
            at = (time() - seen.first < 5) and 0 or time()
            seen[id] = at
        end
        return at
    end

    -- what you collected last (any kind), for the foot
    function NoteLast(name: string?, at: number?)
        if not (name and at and at > 0) then return end
        local d = self:Saved()
        local last = d.last
        if not last or (last.at or 0) < at then d.last = { name = name, at = at } end
    end

    ----------------------------------------------------------------------------
    -- Building it
    ----------------------------------------------------------------------------

    function Build(): Parts
        local w = UI.WindowFrame(SuuUI.Root, { name = "SuuUICollectionsWindow", title = "Collections", width = WIDTH, height = HEIGHT,
            footer = true, onClose = function(win: Frame) win:Hide() end,
            tabs = {
                { key = "mounts", label = "Mounts" },
                { key = "pets", label = "Pets", disabled = true, reason = "No pets on Forever yet" },
                { key = "toys", label = "Toys" },
                { key = "heirlooms", label = "Heirlooms", disabled = true, reason = "No heirlooms on Forever yet" },
                { key = "wardrobe", label = "Appearances" },
            },
            onTab = function(key: string)
                if key ~= self.tab then self.chosen, self.page = nil, 1 end
                self.tab = key
                local ui = self.ui
                local first = ui and ui.tools.list.buttons[1]
                if first then first.label:SetValue(key == "toys" and "Toys" or key == "wardrobe" and "All" or "Mounts") end
                self:Refresh()
            end })
        w:SetPoint("CENTER", UIParent, "CENTER", 0, 30)
        w:Hide()
        w.scroll:Hide()
        -- on opening the frames aren't laid out yet when the first mount loads,
        -- so its camera read wrong (seen in game: wrong on opening, right after
        -- choosing another and back): shown once more a frame later
        w:HookScript("OnShow", function()
            self:Refresh()
            after(0, function()
                self.showing = nil
                self:Refresh()
            end)
        end)
        local body = w.body
        -- the strip at the foot of the body, its tools above it, the stage on top
        local strip = Strip.new(body)
        local tools = Tools.new(body, strip)
        local stage = Stage.new(body, tools)
        local model = MountModel.new(stage)
        local card = StageCard.new(stage)
        -- Summon / Dismiss: SuuUI's own secure button; the look is a SuuUI button under it
        local act = SecureAction.new("SuuUICollectionsAction", stage, "Summon", 120, "primary")
        act:SetSize(120, 30)
        act:SetPoint("TOPRIGHT", -S["space-6"], -S["space-6"])
        act:SetFrameLevel(stage:GetFrameLevel() + 12)
        stage.star:SetPoint("RIGHT", act, "LEFT", -S["space-4"], 0)
        local wardrobe = Wardrobe.new(stage)
        local shelf = Shelf.new(body)
        -- the foot: the overview
        local footer = assert(w.footer)
        local foot = UI.Text(footer, "caption", "ink-muted")
        foot:SetPoint("LEFT")
        local last = UI.Text(footer, "caption", "ink-muted")
        last:SetPoint("RIGHT")
        local ui: Parts = { window = w, strip = strip, tools = tools, stage = stage, model = model, card = card, act = act,
            wardrobe = wardrobe, shelf = shelf, foot = foot, last = last }
        self.ui = ui
        return ui
    end

    -- The window, when built.
    function Window(): WindowFrame?
        local ui = self.ui
        return ui and ui.window
    end

    function Shown(): boolean
        local ui = self.ui
        return ui ~= nil and ui.window:IsShown()
    end

    ----------------------------------------------------------------------------
    -- What the strip shows
    ----------------------------------------------------------------------------

    function Entries(): (Entry[], Entry[])
        local all: Entry[]
        if self.tab == "wardrobe" then all = self:WardrobeEntries()
        elseif self.tab == "toys" then all = self:Toys()
        else all = self:Mounts() end
        local ui = self.ui
        if not ui then return all, all end
        local tools = ui.tools
        local search = (tools.search.edit:GetText() or ""):lower()
        return filterEntries(all, search, tools.have.value or "all", tools.list.value or "all"), all
    end

    -- The cells across the grid's width (18 a row, the space shared out between).
    function LayoutCells()
        local ui = self.ui
        if not ui then return end
        local w = ui.strip.grid:GetWidth()
        if not w or isSecret(w) or w <= 0 then return end
        local gap = math.max(2, (w - COLS * CELL) / (COLS - 1))
        for i, b in ipairs(ui.strip.cells) do
            local col, row = (i - 1) % COLS, math.floor((i - 1) / COLS)
            b:ClearAllPoints()
            b:SetPoint("TOPLEFT", col * (CELL + gap), -row * (CELL + S["space-5"]))
        end
    end

    function Page(step: number)
        self.page = math.max(1, math.min(self.pages, self.page + step))
        self:DrawStrip()
    end

    function DrawCell(b: Cell)
        local e = b.entry
        if not e then
            b:Hide()
            return
        end
        b.icon:SetTexture(e.icon)
        local missing = not e.collected
        b.icon:SetDesaturated(missing)
        local v = missing and (b.hover and 0.8 or 0.55) or 1
        b.icon:SetVertexColor(v, v, v)
        local chosen = self.chosen ~= nil and self.chosen.id == e.id
        b.edge:SetColor((chosen or b.hover) and "gilt" or missing and "gilt-faint" or "gilt-hairline")
        b.star:SetShown(e.favourite and true or false)
        local learned = e.learned
        b.fresh:SetShown(learned ~= nil and learned > 0 and time() - learned < 7 * 86400)
        b.jewel:SetShown(chosen)
        b:Show()
    end

    function DrawStrip()
        local ui = self.ui
        if not ui then return end
        local strip, entries = ui.strip, self.entries
        local tiles = self.tab == "wardrobe"
        strip.grid:SetShown(not tiles)
        strip.tileGrid:SetShown(tiles)
        local per = tiles and TILES or COLS * ROWS
        self.pages = math.max(1, math.ceil(#entries / per))
        self.page = math.max(1, math.min(self.pages, self.page))
        local first = (self.page - 1) * per
        if tiles then
            for i, b in ipairs(strip.tiles) do
                b.entry = entries[first + i]
                self:DrawTile(b)
            end
        else
            for i, b in ipairs(strip.cells) do
                b.entry = entries[first + i]
                self:DrawCell(b)
            end
        end
        local paged = self.pages > 1
        strip.prev:SetShown(paged)
        strip.next:SetShown(paged)
        strip.pageText:SetShown(paged)
        strip.prev:SetEnabledState(self.page > 1)
        strip.next:SetEnabledState(self.page < self.pages)
        strip.pageText:SetValue(self.page .. " / " .. self.pages)
        strip.empty:SetShown(#entries == 0)
        strip.empty:SetValue(self.tab == "toys" and "No toys match." or tiles and "No appearances match." or "No mounts match.")
    end

    function Refresh()
        local ui = self.ui
        if not (ui and ui.window:IsShown()) then return end
        local entries, all = self:Entries()
        self.entries, self.all = entries, all
        local have = 0
        for _, e in ipairs(all) do if e.collected then have = have + 1 end end
        local tools = ui.tools
        local titled = self.tab == "wardrobe"
        tools.title:SetShown(titled)
        tools.title:SetValue(titled and self.slotTitle or "")
        tools.search:ClearAllPoints()
        tools.search:SetPoint("LEFT", titled and (tools.title:GetUnboundedStringWidth() + S["space-5"]) or 0, 0)
        tools.count:SetValue(("%d |cff%sof %d|r"):format(have, T.color["ink-muted"].hex, #all))
        tools.fill:SetWidth(math.max(1, 60 * (#all > 0 and have / #all or 0)))
        self:LayoutTab()
        if self.tab == "toys" then
            self:DrawShelf()
            self:DrawFoot()
            return
        end
        -- the chosen one stays while it is listed; else the first (also with
        -- none of your own: asked in game, the stage is never empty then)
        local still = false
        local chosen = self.chosen
        for _, e in ipairs(entries) do if chosen and e.id == chosen.id then self.chosen = e; still = true end end
        if not still then self.chosen = entries[1] end
        self:DrawStrip()
        self:DrawStage()
        self:DrawFoot()
    end

    function Choose(e: Entry?)
        if not e then return end
        self.chosen = e
        self:DrawStrip()
        self:DrawStage()
    end

    ----------------------------------------------------------------------------
    -- The stage
    ----------------------------------------------------------------------------

    function DrawStage()
        local ui = self.ui
        if not ui then return end
        local stage, e = ui.stage, self.chosen
        local wardrobe = self.tab == "wardrobe"
        ui.wardrobe:SetShown(wardrobe)
        if wardrobe then
            ui.model:Hide()
            self.showing, self.waiting = nil, nil
            stage.loading:Hide()
            stage.star:Hide()
            stage.empty:Hide()
            stage.ctl:Show()
            -- no hint here (the design: it would run under Undress)
            stage.hint:Hide()
            -- the doll stands between the columns, off the stage's middle
            stage:CentreOn((DOLL_L - DOLL_R) / 2)
            if not InCombatLockdown() then ui.act:Hide() end
            stage:Tint("gilt")
            self:DrawWardrobe()
            return
        end
        stage:CentreOn(0)
        local none = e == nil
        stage.empty:SetShown(none)
        ui.card:SetShown(not none)
        stage.star:SetShown(not none)
        stage.ctl:SetShown(not none)
        stage.hint:SetShown(not none)
        stage:Tint("gilt")
        if not e then
            -- only when a search or filter leaves nothing (the first entry is
            -- chosen otherwise, also with none of your own)
            stage.empty.title:SetValue("No mounts match")
            stage.empty.text:SetValue("Clear the search or show All.")
            ui.model:Hide()
            self.showing, self.waiting = nil, nil
            stage.loading:Hide()
            self:DrawAction()
            return
        end
        stage.star.on = e.favourite and true or false
        stage.star:Draw(false)
        self:ShowMount(e)
        ui.card:Draw(e)
        self:DrawAction()
    end

    -- The toys' cooldowns on the shelf: again every second while it shows
    -- (the time counts down) and when the game says a cooldown changed.
    function DrawCooldowns()
        if self.tab == "toys" then self:DrawShelfCooldowns() end
    end

    -- The mount fitted to the stage; its icon until the model has loaded, then
    -- the model fades in. The same mount again is left as it is (seen in game:
    -- shown twice on opening, the second load sent no signal and the icon
    -- stayed).
    function ShowMount(e: Entry)
        local ui = self.ui
        if not ui then return end
        local model, stage = ui.model, ui.stage
        if self.showing == e.id and model:IsShown() then return end
        self.showing, self.waiting = e.id, e.id
        model:SetAlpha(0)
        model:Show()
        stage.loading.icon:SetTexture(e.icon)
        stage.loading:Show()
        try(model.ClearModel, model)
        try(model.SetDisplayInfo, model, e.display or 0)
        self.camScale = CAM_SCALE
        try(model.SetCamDistanceScale, model, self.camScale)
        try(model.SetPosition, model, 0, 0, 0)
        try(model.SetFacing, model, FACING)
        -- no answer from the game in two seconds: shown anyway
        local id = e.id
        after(2, function() if self.waiting == id then self:ModelLoaded() end end)
    end

    -- The mount lifted so the ground under it shows FEET_BELOW under the
    -- frame's middle (on the floor shadow). Nothing when the camera can't be read.
    function PlaceModel()
        local ui = self.ui
        if not ui then return end
        local m = ui.model
        local pxR, pyR, pzR = try(m.GetCameraPosition, m)
        local txR, tyR, tzR = try(m.GetCameraTarget, m)
        local px, py, pz, tx, ty, tz = asNumber(pxR), asNumber(pyR), asNumber(pzR), asNumber(txR), asNumber(tyR), asNumber(tzR)
        if not (px and py and pz and tx and ty and tz) then return end
        local P, aim = { px, py, pz }, { tx, ty, tz }
        if not groundBelow(P, aim, 0) then return end
        local lo, hi = -3, 3
        for _ = 1, 40 do
            local mid = (lo + hi) / 2
            local b = groundBelow(P, aim, mid)
            if not b then return end
            if b > FEET_BELOW then lo = mid else hi = mid end
        end
        try(m.SetPosition, m, 0, 0, (lo + hi) / 2)
        -- down by this model's own gap between its feet and the ground point
        local file = asNumber(try(m.GetModelFileID, m))
        local drop = (file and FEET_DROPS[file]) or FEET_DROP
        m:ClearAllPoints()
        m:SetPoint("BOTTOM", ui.stage, "BOTTOM", 0, FEET_Y - drop + FEET_BELOW - MODEL_H / 2)
    end

    -- Loaded: the camera back (CAM_SCALE), then placed on the floor once the
    -- camera has moved (read a moment later), then shown.
    function ModelLoaded()
        local ui = self.ui
        local id = self.waiting
        if not (ui and id) then return end
        local model = ui.model
        self.waiting = nil
        try(model.SetCamDistanceScale, model, self.camScale)
        after(0.1, function()
            if self.showing ~= id then return end
            self:PlaceModel()
            ui.stage.loading:Hide()
            model:SetAlpha(1)
            SuuUI.Motion.FadeIn(model, T.duration["dur-base"])
        end)
    end

    function Turn(dir: number)
        local ui = self.ui
        if not ui then return end
        local m: PlayerModel = self.tab == "wardrobe" and ui.wardrobe.doll or ui.model
        try(m.SetFacing, m, (asNumber(try(m.GetFacing, m)) or 0) + dir * 0.35)
    end

    function Zoom(dir: number)
        local ui = self.ui
        if not ui then return end
        if self.tab == "wardrobe" then
            local d = ui.wardrobe.doll
            self.dollScale = math.max(0.6, math.min(2.5, self.dollScale * (dir > 0 and 1.12 or 0.89)))
            try(d.SetCamDistanceScale, d, self.dollScale)
            return
        end
        local m = ui.model
        self.camScale = math.max(ZOOM_MIN * CAM_SCALE, math.min(ZOOM_MAX * CAM_SCALE, self.camScale * (dir > 0 and 1.12 or 0.89)))
        try(m.SetCamDistanceScale, m, self.camScale)
        -- on the floor again at the new distance
        after(0.05, function() self:PlaceModel() end)
    end

    -- A mount's favourite: the game keeps it by the mount's place in its own
    -- list, so the place is looked up first.
    function ToggleFavourite()
        local e = self.chosen
        if e and e.kind == "appearance" then
            try(field(C_TransmogCollection, "SetIsAppearanceFavorite"), e.visualID, not e.favourite)
            after(0.1, function() self:Refresh() end)
            return
        end
        if e and e.kind == "toy" then
            try(field(C_ToyBox, "SetIsFavorite"), e.itemID, not e.favourite)
            after(0.1, function() self:Refresh() end)
            return
        end
        if not (e and e.kind == "mount") then return end
        local MJ = C_MountJournal
        for i = 1, asNumber(try(field(MJ, "GetNumDisplayedMounts"))) or 0 do
            if asNumber(try(field(MJ, "GetDisplayedMountID"), i)) == e.id then
                try(field(MJ, "SetIsFavorite"), i, not e.favourite)
                after(0.1, function() self:Refresh() end)
                return
            end
        end
    end

    -- Summon or Dismiss: the secure button's job, set out of combat (in one it
    -- waits; its look says why).
    function DrawAction()
        local ui = self.ui
        if not ui then return end
        local act, e = ui.act, self.chosen
        if self.tab == "wardrobe" then
            if not InCombatLockdown() then act:Hide() end
            return
        end
        local mounted = flag(try(field(_G, "IsMounted")))
        local label, why = actionLabel(mounted, e)
        act.look.label:SetValue(label)
        act.look:SetEnabledState(why == nil)
        act.why = why
        if InCombatLockdown() then
            self.actionAfterCombat = true
            return
        end
        act:SetShown(e ~= nil or mounted)
        if mounted then
            act:SetAttribute("type", "macro")
            act:SetAttribute("macrotext", "/dismount")
        elseif why or not e then
            act:SetAttribute("type", nil)
        else
            act:SetAttribute("type", "spell")
            act:SetAttribute("spell", e.spellID)
        end
    end

    function DrawFoot()
        local ui = self.ui
        if not ui then return end
        local muted, ink = "|cff" .. T.color["ink-muted"].hex, T.color["ink"].hex
        local parts: string[] = {}
        local kinds: { label: string, entries: Entry[] }[] = { { label = "Mounts", entries = self:Mounts() }, { label = "Toys", entries = self:Toys() } }
        for _, kind in ipairs(kinds) do
            local have = 0
            for _, e in ipairs(kind.entries) do if e.collected then have = have + 1 end end
            parts[#parts + 1] = ("%s |cff%s%d|r%s of %d|r"):format(kind.label, ink, have, muted, #kind.entries)
        end
        ui.foot:SetValue(table.concat(parts, "  ·  "))
        local last = self:Saved().last
        ui.last:SetValue(last and ("Last collected: |cff%s%s|r, %s"):format(T.color["ink"].hex, last.name, day(last.at) or "") or "Nothing collected yet")
    end

    ----------------------------------------------------------------------------
    -- Opening it: the micro menu (SuuUI.ToggleCollections), the game's
    -- Collections key (an override binding onto SuuUI's button), and the game's
    -- journal when something else opens it (closed again, ours instead)
    ----------------------------------------------------------------------------

    function Toggle(tab: string?)
        local w = self:Window()
        if not w then return end
        if w:IsShown() and not tab then
            w:Hide()
            return
        end
        w:Show()
        w:SetTab(tab or self.tab)
    end

    function BindKeys()
        local owner = self.bindOwner
        if not owner then return end
        if InCombatLockdown() then
            self.bindAfterCombat = true
            return
        end
        ClearOverrideBindings(owner)
        for _, key in ipairs({ GetBindingKey("TOGGLECOLLECTIONS") }) do
            if key then SetOverrideBindingClick(owner, false, key, "SuuUICollectionsToggle") end
        end
    end

    function HookJournal()
        local f = frames.find("CollectionsJournal")
        if not f or self.journalHooked then return end
        self.journalHooked = true
        hookScript(f, "OnShow", function()
            if not self:IsEnabled() or InCombatLockdown() then return end
            HideUIPanel(f)
            self:Toggle("mounts")
        end)
    end

    ----------------------------------------------------------------------------
    -- Appearances
    ----------------------------------------------------------------------------

    function DrawSlot(b: SlotButton)
        local counts = self.slotCounts
        local c = counts and counts[b.slot]
        local on = self.slot == b.slot
        local off = c ~= nil and c.reason ~= nil
        b.glow:SetShown(on)
        UI.Paint(b.ring, on and "arcane" or (b.hover and not off) and "gilt" or off and "gilt-faint" or "gilt-line")
        b:SetAlpha(off and T.opacity["opacity-disabled"] or 1)
        b.art:SetDesaturated(off)
        b.n:SetValue(off and "—" or ((c and c.have or 0) .. "/" .. (c and c.all or 0)))
    end

    function DrawTileState(b: Tile)
        local e = b.entry
        if not e then return end
        local chosen = self.chosen ~= nil and self.chosen.id == e.id
        b.edge:SetColor((chosen or b.hover) and "gilt" or e.worn and "gilt" or e.collected and "gilt-line" or "gilt-faint")
        b.dim:SetShown(not e.collected and not b.hover)
        b.jewel:SetShown(chosen)
    end

    -- One tile with its entry (or hidden).
    function DrawTile(b: Tile)
        local e = b.entry
        if not e then
            b:Hide()
            return
        end
        b:Show()
        b.worn:SetShown(e.worn and true or false)
        b.star:SetShown(e.favourite and true or false)
        local w = b:GetWidth()
        if not w or w < 2 then return end
        if b.shownID ~= e.id then
            b.shownID = e.id
            b.loading = true
            b.icon:SetTexture(e.icon)
            b.icon:Show()
            local m = b.model
            m:SetAlpha(0)
            try(m.SetUnit, m, "player")
            try(m.Undress, m)
            local apply = field(_G, "Model_ApplyUICamera")
            if e.camera and apply then try(apply, m, e.camera) end
            try(m.TryOn, m, e.sourceID)
            -- no answer in two seconds: shown anyway
            local id = e.id
            after(2, function()
                if b.shownID == id and b.loading then
                    b.loading = false
                    b.icon:Hide()
                    m:SetAlpha(1)
                end
            end)
        end
        self:DrawTileState(b)
    end

    function LayoutTiles()
        local ui = self.ui
        if not ui then return end
        local grid = ui.strip.tileGrid
        local w, h = grid:GetWidth(), grid:GetHeight()
        if not (w and h) or isSecret(w) or isSecret(h) or w <= 0 then return end
        local gap = S["space-4"]
        local tw = (w - (TILES - 1) * gap) / TILES
        for i, b in ipairs(ui.strip.tiles) do
            b:ClearAllPoints()
            b:SetSize(tw, h - 6)
            b:SetPoint("TOPLEFT", (i - 1) * (tw + gap), 0)
            -- a tile drawn before it had its size showed nothing (seen in game:
            -- empty on opening the tab): loaded again at its size
            if b.entry and b.sizedW ~= tw then
                b.sizedW = tw
                b.shownID = nil
                self:DrawTile(b)
            end
        end
    end

    -- The slot's appearances (the chosen weapon kind for a weapon slot).
    function WardrobeEntries(): Entry[]
        local def = slotDef(self.slot) or assert(slotDef("CHESTSLOT"))
        local cat, kindLabel = def.category, nil
        local weapon = def.weapon
        if weapon then
            local kinds = self:WeaponKinds(weapon)
            local chosen = self.weaponKind[weapon]
            local found: WeaponKind? = nil
            for _, k in ipairs(kinds) do if k.category == chosen then found = k end end
            found = found or kinds[1]
            cat, kindLabel = found and found.category, found and found.name
            self.kinds = kinds
            if found then self.weaponKind[weapon] = found.category end
        end
        self.slotTitle = def.label .. (kindLabel and (" · " .. kindLabel) or "")
        if not cat then return {} end
        return self:Appearances(cat, def.slot)
    end

    -- The stage for Appearances: the doll, the slots, the picks, the card.
    function DrawWardrobe()
        local ui = self.ui
        if not ui then return end
        local w, e = ui.wardrobe, self.chosen
        if not self.slotCounts then
            local classID = w.class.value
            local className = classID and asString(try(field(_G, "GetClassInfo"), classID))
            self.slotCounts = self:SlotCounts(className and (className .. "s"))
        end
        for _, b in ipairs(w.slots) do self:DrawSlot(b) end
        local weapon = slotDef(self.slot)?.weapon
        w.kind:SetShown(weapon ~= nil)
        if weapon then
            local opts: SelectOption<number>[] = {}
            for _, k in ipairs(self.kinds) do opts[#opts + 1] = { value = k.category, label = k.name } end
            w.kind:SetOptions(opts)
            w.kind:SetValue(self.weaponKind[weapon])
        end
        if not w.doll.dressed then
            w.doll.dressed = true
            try(w.doll.SetUnit, w.doll, "player")
        end
        ui.card:SetShown(e ~= nil)
        w.star:SetShown(e ~= nil)
        if e then
            ui.card:Draw(e, e.worn and "Worn" or nil)
            local quality = qualityToken(e.quality)
            if quality then ui.card.name:SetColor(quality) end
            w.star.on = e.favourite and true or false
            w.star:Draw(false)
            if self.tried ~= e.sourceID then
                self.tried = e.sourceID
                try(w.doll.TryOn, w.doll, e.sourceID)
            end
        end
    end

    ----------------------------------------------------------------------------
    -- Toys
    ----------------------------------------------------------------------------

    function DrawToyCard(c: ToyCard)
        local e = c.entry
        -- (a card holds its secure Use: shown or hidden out of combat only, the
        -- game refuses even an unchanged Show in a fight)
        if not e then
            if c:IsShown() then
                if InCombatLockdown() then self.shelfAfterCombat = true else c:Hide() end
            end
            return
        end
        if not c:IsShown() then
            if InCombatLockdown() then self.shelfAfterCombat = true else c:Show() end
        end
        c.icon:SetTexture(e.icon)
        c.icon:SetDesaturated(not e.collected)
        local v = e.collected and 1 or 0.55
        c.icon:SetVertexColor(v, v, v)
        c.plateEdge:SetColor(e.collected and "gilt-hairline" or "gilt-faint")
        c.name:SetValue(e.name)
        c.name:SetColor(e.collected and "ink" or "ink-muted")
        c.check:ClearAllPoints()
        c.check:SetPoint("LEFT", c.name, "LEFT", math.min(c.name:GetUnboundedStringWidth(), c.name:GetWidth() or 0) + 4, 0)
        c.check:SetShown(e.collected)
        c.use:SetValue(toyUse(e.itemID) or "")
        c.use:SetColor(e.collected and "ink-muted" or "ink-faint")
        c.star.on = e.favourite and true or false
        c.star:Draw(false)
        c:DrawState()
        c:DrawCooldown()
        -- the secure part: out of combat only
        if InCombatLockdown() then
            self.shelfAfterCombat = true
        elseif e.collected then
            c.act:SetAttribute("type", "toy")
            c.act:SetAttribute("toy", e.itemID)
        else
            c.act:SetAttribute("type", nil)
        end
    end

    function LayoutShelf()
        local ui = self.ui
        if not ui then return end
        local shelf = ui.shelf
        -- (the cards hold secure buttons: laid out out of combat only)
        if InCombatLockdown() then
            self.shelfAfterCombat = true
            return
        end
        local w = shelf.list.child:GetWidth()
        if not w or isSecret(w) or w <= 0 then return end
        local gap = S["space-4"]
        local cw = (w - (SHELF_COLS - 1) * gap) / SHELF_COLS
        for i, c in ipairs(shelf.cards) do
            local col, row = (i - 1) % SHELF_COLS, math.floor((i - 1) / SHELF_COLS)
            c:ClearAllPoints()
            c:SetWidth(cw)
            c:SetPoint("TOPLEFT", col * (cw + gap), -row * (CARD_H + gap))
        end
    end

    function DrawShelf()
        local ui = self.ui
        if not ui then return end
        local shelf, entries = ui.shelf, self.entries
        -- in a fight the cards keep their places (they hold secure buttons):
        -- only what they show changes; new cards and the layout after it
        local combat = InCombatLockdown()
        if combat then
            if #entries > #shelf.cards then self.shelfAfterCombat = true end
        else
            for i = #shelf.cards + 1, #entries do shelf.cards[i] = ToyCard.new(shelf.list.child, i) end
        end
        for i, c in ipairs(shelf.cards) do
            c.entry = entries[i]
            self:DrawToyCard(c)
        end
        self:LayoutShelf()
        if not combat then
            local rows = math.ceil(#entries / SHELF_COLS)
            shelf.list.child:SetHeight(math.max(1, rows * CARD_H + math.max(0, rows - 1) * S["space-4"]))
        end
        shelf.empty:SetShown(#entries == 0)
    end

    function DrawShelfCooldowns()
        local ui = self.ui
        if not (ui and ui.shelf:IsShown()) then return end
        for _, c in ipairs(ui.shelf.cards) do if c:IsShown() then c:DrawCooldown() end end
    end

    function ToggleToyFavourite(e: Entry?)
        if not (e and e.collected) then return end
        try(field(C_ToyBox, "SetIsFavorite"), e.itemID, not e.favourite)
        after(0.1, function() self:Refresh() end)
    end

    -- The tab's layout: Toys the shelf with the tools on top; the others the
    -- stage, the tools above the strip.
    function LayoutTab()
        local ui = self.ui
        if not ui then return end
        local toys = self.tab == "toys"
        local tools = ui.tools
        -- (the shelf and the stage hold secure buttons: shown or hidden out of
        -- combat only, and only when it changes: the game refuses even an
        -- unchanged SetShown in a fight)
        local shown: { f: Frame, on: boolean }[] = { { f = ui.shelf, on = toys }, { f = ui.stage, on = not toys }, { f = ui.strip, on = not toys } }
        for _, pair in ipairs(shown) do
            if pair.f:IsShown() ~= pair.on then
                if InCombatLockdown() then self.layoutAfterCombat = true else pair.f:SetShown(pair.on) end
            end
        end
        tools:ClearAllPoints()
        if toys then
            tools:SetPoint("TOPLEFT", ui.window.body, "TOPLEFT")
            tools:SetPoint("TOPRIGHT", ui.window.body, "TOPRIGHT")
        else
            tools:SetPoint("BOTTOMLEFT", ui.strip, "TOPLEFT", 0, S["space-5"])
            tools:SetPoint("BOTTOMRIGHT", ui.strip, "TOPRIGHT", 0, S["space-5"])
        end
        if toys and not InCombatLockdown() then ui.act:Hide() end
    end

    ----------------------------------------------------------------------------
    -- Lifecycle
    ----------------------------------------------------------------------------

    override function OnEnable()
        local ui = self.ui or self:Build()
        local window = ui.window
        self:ProvideService(COLLECTIONS, {
            Toggle = function(tab: string?) self:Toggle(tab) end,
            IsShown = function(): boolean return self:Shown() end,
        })
        if not self.toggleButton then
            -- the key shows and hides the window through the game's secure code:
            -- the window holds secure buttons, so it is protected, and SuuUI's
            -- own code can't show it in a fight (found in tests: nothing opened)
            local b = CreateFrame("Button", "SuuUICollectionsToggle", UIParent, "SecureHandlerClickTemplate") :: Button & FrameRefs
            b:SetFrameRef("window", window)
            b:SetAttribute("_onclick", [=[
                local w = self:GetFrameRef("window")
                if w:IsShown() then w:Hide() else w:Show() end
            ]=])
            self.toggleButton = b
            -- its close button too: a secure one over it (passing the hover on
            -- to the button under it)
            local close = window.close
            if close then
                local o = CreateFrame("Button", nil, close, "SecureHandlerClickTemplate") :: Button & FrameRefs
                o:SetAllPoints(close)
                o:SetFrameRef("window", window)
                o:SetAttribute("_onclick", [=[ self:GetFrameRef("window"):Hide() ]=])
                o:SetScript("OnEnter", function(_: Frame, motion: boolean)
                    local fn = close:GetScript("OnEnter")
                    if fn then fn(close, motion) end
                end)
                o:SetScript("OnLeave", function(_: Frame, motion: boolean)
                    local fn = close:GetScript("OnLeave")
                    if fn then fn(close, motion) end
                end)
                self.closeOverlay = o
            end
            self.bindOwner = CreateFrame("Frame")
            -- (the tab chosen before the first open, which may be in a fight)
            window:SetTab(self.tab)
        end
        self:BindKeys()
        self:OnGameEvent("UPDATE_BINDINGS", function() self:BindKeys() end)
        -- the counts carry colour codes: drawn again in the new colours
        self:On("SUUUI_THEME_CHANGED", function() self:Refresh() end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if self.bindAfterCombat then self.bindAfterCombat = false; self:BindKeys() end
            if self.actionAfterCombat then self.actionAfterCombat = false; self:DrawAction() end
            if self.shelfAfterCombat then self.shelfAfterCombat = false; if self.tab == "toys" then self:Refresh() end end
            if self.layoutAfterCombat then self.layoutAfterCombat = false; self:LayoutTab() end
        end)
        self:OnGameEvent("PLAYER_MOUNT_DISPLAY_CHANGED", function() self:DrawAction() end)
        self:OnGameEvent("COMPANION_UPDATE", function() self:DrawAction() end)
        -- something new: noted with today's date, the window redrawn
        self:OnGameEvent("NEW_MOUNT_ADDED", function(_, id)
            local name = id and asString(try(field(C_MountJournal, "GetMountInfoByID"), id))
            self:NoteLast(name, time())
            self:Refresh()
        end)
        self:OnGameEvent("MOUNT_JOURNAL_USABILITY_CHANGED", function() self:DrawAction() end)
        -- toys: new ones, their cooldowns, their names as the game sends them
        self:OnGameEvent("NEW_TOY_ADDED", function(_, itemID)
            local _, name = try(field(C_ToyBox, "GetToyInfo"), itemID)
            self:NoteLast(asString(name), time())
            self:Refresh()
        end)
        self:OnGameEvent("TOYS_UPDATED", function() if self:Shown() then self:Refresh() end end)
        self:OnGameEvent("SPELL_UPDATE_COOLDOWN", function() if self:Shown() then self:DrawCooldowns() end end)
        self:OnGameEvent("BAG_UPDATE_COOLDOWN", function() if self:Shown() then self:DrawCooldowns() end end)
        self:OnGameEvent("GET_ITEM_INFO_RECEIVED", function()
            if not (self.namesPending and self:Shown()) then return end
            self.namesPending = false
            if self.namesTimer then return end
            self.namesTimer = after(0.3, function() self.namesTimer = nil; self:Refresh() end)
        end)
        -- appearances: new ones, what you wear
        self:OnGameEvent("TRANSMOG_COLLECTION_UPDATED", function()
            self.slotCounts = nil
            if self.tab == "wardrobe" and self:Shown() then self:Refresh() end
        end)
        self:OnGameEvent("PLAYER_EQUIPMENT_CHANGED", function()
            ui.wardrobe.doll.dressed = false
            self.tried = nil
            if self.tab == "wardrobe" and self:Shown() then self:Refresh() end
        end)
        if not self.ticker then
            self.ticker = every(1, function()
                if self.tab == "toys" and self:Shown() then self:DrawCooldowns() end
            end)
        end
        self:HookJournal()
        self:OnGameEvent("ADDON_LOADED", function(_, name) if name == "Blizzard_Collections" then self:HookJournal() end end)
    end

    override function OnDisable()
        local window = self:Window()
        if window then window:Hide() end
        local owner = self.bindOwner
        if owner and not InCombatLockdown() then ClearOverrideBindings(owner) end
    end
end

M = SuuUI.AddModule(CollectionsModule.new())
