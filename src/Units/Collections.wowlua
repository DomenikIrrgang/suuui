-- Units/Collections.wowlua
-- SuuUI's own collections window (plan 3.6; asked 2026-10-16: our own
-- window instead of the restyle; design: direction A, "Stage", on the board
-- "Collections · own window"). The game's journal stays closed. Probed
-- (/suu probe collown, colltiles): every mount, toy and appearance can be
-- read, the ones you lack too; SuuUI draws the models itself (a ModelScene
-- fitted to the stage by the game (a PlayerModel), DressUpModels framed by the appearance
-- cameras); summoning and toys go through SuuUI's own secure buttons.
-- Where something comes from is SuuUI's generated data
-- (SuuUI.CollectionSources(): the game gives no source for mounts, only the
-- kind for appearances, and won't list the toys you lack).
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import after, every from "wowlua:timer"
import hookScript from "wowlua:hooks"
import isSecret from "wowlua:secret"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local M = SuuUI.RegisterModule({
    id = "collections",
    name = "Collections",
    description = "SuuUI's collections window: mounts, toys and appearances on a model stage, what you lack and where to get it.",
    api = "0.17",
    reloadToToggle = true,
    defaults = {},
})

local function call(fn: any, ...: any): (any, any, any, any, any, any, any, any, any, any, any, any, any)
    if type(fn) ~= "function" then return nil end
    local ok, a, b, c, d, e, f, g, h, i, j, k, l, m = pcall(fn, ...)
    if ok then return a, b, c, d, e, f, g, h, i, j, k, l, m end
end
local function plain(v: any): boolean return v ~= nil and not isSecret(v) end

--------------------------------------------------------------------------------
-- Where something comes from: the best source as one line, all of it as a
-- card (design: vendor, quest, world drop, drop, object, container,
-- crafted, the game's own text, the item that teaches it; then the game's
-- source kind, then "Source unknown")
--------------------------------------------------------------------------------

local WORLD = 12

-- an entry the strip, the stage and the shelf show; a CollectionSources entry
type Entry = { [string]: any }
type Source = { [string]: any }

local function data(): { [string]: any } return SuuUI.CollectionSources() or {} end

-- "Name|Zone|Level|Faction" -> name, zone, level, faction
local function npc(id: number): (string?, string?, string?, string?)
    local s = data().npc and data().npc[id]
    if not s then return nil end
    local name, zone, level, faction = s:match("^(.-)|(.-)|(.-)|(.*)$")
    return name, zone ~= "" and zone or nil, level ~= "" and level or nil, faction ~= "" and faction or nil
end
local function object(id: number): (string?, string?)
    local s = data().obj and data().obj[id]
    if not s then return nil end
    local name, zone = s:match("^(.-)|(.*)$")
    return name, zone ~= "" and zone or nil
end
local function itemName(id: number?): string?
    local name = C_Item and C_Item.GetItemNameByID and call(C_Item.GetItemNameByID, id)
    return plain(name) and name or nil
end
local function questTitle(id: number): string?
    local t = C_QuestLog and C_QuestLog.GetTitleForQuestID and call(C_QuestLog.GetTitleForQuestID, id)
    return plain(t) and t ~= "" and t or nil
end

local function place(name: string, zone: string?): string return zone and (name .. ", " .. zone) or name end
local function more(list: any[]): string return (#list > 1) and (" +" .. (#list - 1)) or "" end

-- The game's own word for a source kind (its numbers: mounts use the pet
-- journal's, appearances the transmog ones).
local function kindName(kind: string, number: number?): string?
    if not number or number < 0 then return nil end
    local g = kind == "appearance" and _G["TRANSMOG_SOURCE_" .. number] or _G["BATTLE_PET_SOURCE_" .. (number + 1)]
    return type(g) == "string" and g ~= "" and g or nil
end

-- src: a CollectionSources entry (or nil); kind/number: the game's source
-- kind as the fallback. -> "Vendor · Name, Zone +1" or nil
function M:SourceLine(src: Source?, kind: string, number: number?): string
    if src then
        if src.v and src.v[1] then
            local name, zone = npc(src.v[1])
            if name then return "Vendor · " .. place(name, zone) .. more(src.v) end
        end
        if src.q and src.q[1] then
            local title = questTitle(src.q[1])
            return "Quest" .. (title and (" · " .. title) or "") .. more(src.q)
        end
        if (src.dn or 0) > WORLD then return "World drop" end
        if src.d and src.d[1] then
            local name, zone, level = npc(src.d[1])
            if name then
                local extra = (src.dn and src.dn > 1) and (" +" .. (src.dn - 1)) or more(src.d)
                return "Drop · " .. place(name, zone) .. (level and (" · " .. level) or "") .. extra
            end
        end
        if src.o and src.o[1] then
            local name, zone = object(src.o[1])
            if name then return "Found in · " .. place(name, zone) .. more(src.o) end
        end
        if src.c and src.c[1] then return "Inside · " .. (itemName(src.c[1]) or "a container") end
        if src.p then return "Crafted · " .. src.p end
        if src.x then return src.x end
        if src.i then return "Taught by · " .. (itemName(src.i) or "an item") end
    end
    local word = kindName(kind, number)
    return word and word or "Source unknown"
end

-- The full card: { { title, lines = { … } }, … } (empty: nothing known).
function M:SourceCard(src: Source?, kind: string, number: number?): { title: string, lines: string[] }[]
    local card: { title: string, lines: string[] }[] = {}
    local function section(title: string, lines: string[]) if lines[1] then card[#card + 1] = { title = title, lines = lines } end end
    if src then
        local lines = {}
        for _, id in ipairs(src.v or {}) do
            local name, zone, _, faction = npc(id)
            if name then lines[#lines + 1] = place(name, zone) .. (faction and (" (" .. faction .. ")") or "") end
        end
        section("Sold by", lines)
        lines = {}
        for _, id in ipairs(src.q or {}) do lines[#lines + 1] = questTitle(id) or ("Quest " .. id) end
        section("Quest", lines)
        lines = {}
        if (src.dn or 0) > WORLD then
            section("World drop", { ("Dropped by %d creatures across the world"):format(src.dn) })
        else
            for _, id in ipairs(src.d or {}) do
                local name, zone, level = npc(id)
                if name then lines[#lines + 1] = place(name, zone) .. (level and (" · level " .. level) or "") end
            end
            if src.dn and src.dn > #(src.d or {}) then lines[#lines + 1] = ("and %d more"):format(src.dn - #(src.d or {})) end
            section("Dropped by", lines)
        end
        lines = {}
        for _, id in ipairs(src.o or {}) do
            local name, zone = object(id)
            if name then lines[#lines + 1] = place(name, zone) end
        end
        section("Found in", lines)
        lines = {}
        for _, id in ipairs(src.c or {}) do lines[#lines + 1] = itemName(id) or ("Item " .. id) end
        section("Inside", lines)
        if src.p then section("Crafted by", { src.p }) end
        if src.x then section("In the game", { src.x }) end
        if src.i and not card[1] then section("Taught by", { itemName(src.i) or ("Item " .. src.i) }) end
    end
    if not card[1] then
        local word = kindName(kind, number)
        if word then card[1] = { title = word, lines = { "Nothing more is known." } } end
    end
    return card
end

--------------------------------------------------------------------------------
-- What there is: mounts, toys, appearances, the ones you lack too
--------------------------------------------------------------------------------

-- Every mount this character can see (the rest: the other faction's, or no
-- model in Forever's data: probed, 49 of 139), favourites and yours first.
function M:Mounts()
    local MJ = C_MountJournal
    local out = {}
    for _, id in ipairs(MJ and call(MJ.GetMountIDs) or {}) do
        local name, spellID, icon, active, usable, sourceType, favourite, _, faction, hidden, collected = call(MJ.GetMountInfoByID, id)
        if name and not hidden then
            local display, _, _, isSelf, _, scene = call(MJ.GetMountInfoExtraByID, id)
            out[#out + 1] = {
                kind = "mount", id = id, name = name, spellID = spellID, icon = icon, active = active, usable = usable,
                favourite = favourite, collected = collected, sourceType = sourceType, faction = faction,
                display = display, scene = scene, isSelf = isSelf, source = data().mount and data().mount[id],
                learned = self:Learned("mount", id, collected),
            }
        end
    end
    table.sort(out, function(a, b)
        if a.collected ~= b.collected then return a.collected and true or false end
        if a.favourite ~= b.favourite then return a.favourite and true or false end
        return a.name < b.name
    end)
    return out
end

-- Every toy of Forever (from the client's own list: the game won't list the
-- ones you lack), yours first.
function M:Toys()
    local TB = C_ToyBox
    local out = {}
    for _, itemID in ipairs(data().toys or {}) do
        local _, name, icon, favourite = call(TB and TB.GetToyInfo, itemID)
        name = plain(name) and name or itemName(itemID) or ("Toy " .. itemID)
        local has = call(PlayerHasToy, itemID) and true or false
        out[#out + 1] = {
            kind = "toy", id = itemID, itemID = itemID, name = name, icon = icon or (C_Item and call(C_Item.GetItemIconByID, itemID)),
            favourite = favourite, collected = has, usable = has and call(TB and TB.IsToyUsable, itemID) ~= false,
            source = data().toy and data().toy[itemID], learned = self:Learned("toy", itemID, has),
        }
        if not plain(name) or name:find("^Toy %d") then self.namesPending = true end
    end
    table.sort(out, function(a, b)
        if a.collected ~= b.collected then return a.collected end
        if (a.favourite and true or false) ~= (b.favourite and true or false) then return a.favourite and true or false end
        return a.name < b.name
    end)
    return out
end

-- The paper doll's slots (the game's armor categories 1-11; weapons by kind).
M.SLOTS = {
    { slot = "HEADSLOT", label = "Head", category = 1 }, { slot = "SHOULDERSLOT", label = "Shoulder", category = 2 },
    { slot = "BACKSLOT", label = "Back", category = 3 }, { slot = "CHESTSLOT", label = "Chest", category = 4 },
    { slot = "SHIRTSLOT", label = "Shirt", category = 5 }, { slot = "TABARDSLOT", label = "Tabard", category = 6 },
    { slot = "WRISTSLOT", label = "Wrist", category = 7 }, { slot = "HANDSSLOT", label = "Hands", category = 8 },
    { slot = "WAISTSLOT", label = "Waist", category = 9 }, { slot = "LEGSSLOT", label = "Legs", category = 10 },
    { slot = "FEETSLOT", label = "Feet", category = 11 },
    { slot = "MAINHANDSLOT", label = "Main hand", weapon = "main" }, { slot = "SECONDARYHANDSLOT", label = "Off hand", weapon = "off" },
    { slot = "RANGEDSLOT", label = "Ranged", weapon = "ranged" },
}

-- The weapon kinds this class can use for a hand (the game names only those).
function M:WeaponKinds(hand: string?): { category: number, name: string }[]
    local TC = C_TransmogCollection
    local out = {}
    for cat = 12, 30 do
        local name, isWeapon, _, canMain, canOff, canRanged = call(TC and TC.GetCategoryInfo, cat)
        if name and isWeapon and ((hand == "main" and canMain) or (hand == "off" and canOff) or (hand == "ranged" and canRanged)) then
            out[#out + 1] = { category = cat, name = name }
        end
    end
    return out
end

-- The slot's transmog location (the game asks for armor with it).
local function location(slot: string): any
    if not (TransmogUtil and TransmogUtil.GetTransmogLocation and Enum.TransmogType) then return nil end
    local loc = call(TransmogUtil.GetTransmogLocation, slot, Enum.TransmogType.Appearance, false)
    return loc and loc.GetData and loc:GetData() or nil
end

-- Each slot's yours and all (a weapon slot: over the kinds this class can
-- use for it); a slot with no kind for this class: its reason.
function M:SlotCounts(className: string?): { [string]: { have: number, all: number, reason: string? } }
    local TC = C_TransmogCollection
    local out = {}
    for _, def in ipairs(self.SLOTS) do
        local cats = {}
        if def.category then cats[1] = def.category
        else for _, k in ipairs(self:WeaponKinds(def.weapon)) do cats[#cats + 1] = k.category end end
        local have, all = 0, 0
        for _, cat in ipairs(cats) do
            for _, a in ipairs(call(TC.GetCategoryAppearances, cat, location(def.slot)) or {}) do
                if not a.isHideVisual then
                    all = all + 1
                    if a.isCollected then have = have + 1 end
                end
            end
        end
        out[def.slot] = { have = have, all = all,
            reason = (not def.category and #cats == 0) and ("No " .. def.label:lower() .. " weapons for " .. (className or "this class")) or nil }
    end
    return out
end

-- What you wear in a slot: its appearance (visual) ID.
function M:Worn(slot: string): any
    local id = call(GetInventorySlotInfo, slot)
    local itemID = id and call(GetInventoryItemID, "player", id)
    if not itemID then return nil end
    local visual = call(C_TransmogCollection.GetItemInfo, itemID)
    return visual
end

-- A category's appearances (yours first), each with its first source's item
-- and that item's source data.
function M:Appearances(category: number, slot: string?): Entry[]
    local TC = C_TransmogCollection
    local worn = slot and self:Worn(slot)
    local out = {}
    for _, a in ipairs(call(TC.GetCategoryAppearances, category, slot and location(slot)) or {}) do
        if not a.isHideVisual then
            local sources = call(TC.GetAppearanceSources, a.visualID) or {}
            local first
            for _, s in ipairs(sources) do
                if s.isCollected then first = s break end
                first = first or s
            end
            if first then
                local name = plain(first.name) and first.name or itemName(first.itemID)
                if not name then self.namesPending = true end
                out[#out + 1] = {
                    kind = "appearance", id = a.visualID, visualID = a.visualID, sourceID = first.sourceID, itemID = first.itemID,
                    name = name or "…", quality = first.quality, collected = a.isCollected, favourite = a.isFavorite,
                    worn = worn == a.visualID, sourceType = first.sourceType,
                    icon = C_Item and call(C_Item.GetItemIconByID, first.itemID),
                    source = data().item and data().item[first.itemID],
                    camera = call(TC.GetAppearanceCameraID, a.visualID),
                }
            end
        end
    end
    table.sort(out, function(a, b)
        if a.worn ~= b.worn then return a.worn end
        if a.collected ~= b.collected then return a.collected end
        return a.visualID < b.visualID
    end)
    return out
end

--------------------------------------------------------------------------------
-- Recently collected: the game keeps no dates, so SuuUI notes the day it
-- first sees something yours (what you had before SuuUI: 0, "Before SuuUI")
--------------------------------------------------------------------------------

function M:Learned(kind: string, id: number, collected: any): number?
    if not collected then return nil end
    local d = self:CharData()
    d.learned = d.learned or {}
    local list = d.learned[kind]
    if not list then
        -- the first look at this kind: everything yours is from before SuuUI
        list = { first = time() }
        d.learned[kind] = list
    end
    if list[id] == nil then
        list[id] = (time() - list.first < 5) and 0 or time()
    end
    return list[id]
end

-- A toy's cooldown: when it started and how long (0 when ready).
local function toyCooldown(itemID: number): (number, number)
    local start, duration = call(C_Container and C_Container.GetItemCooldown, itemID)
    if not (plain(start) and plain(duration)) then return 0, 0 end
    if duration and duration > 1.5 and start and start > 0 then return start, duration end
    return 0, 0
end
M.toyCooldown = toyCooldown

-- "Ready in 41 min", "Ready in 1 h 5 min", "Ready in 30 s"
local function readyIn(start: number, duration: number, now: number?): string
    local left = math.max(0, start + duration - (now or GetTime()))
    if left >= 3600 then return ("Ready in %d h %d min"):format(math.floor(left / 3600), math.floor(left % 3600 / 60)) end
    if left >= 60 then return ("Ready in %d min"):format(math.ceil(left / 60)) end
    return ("Ready in %d s"):format(math.ceil(left))
end

-- what you collected last (any kind), for the foot
function M:NoteLast(name: string?, at: number?)
    if not (name and at and at > 0) then return end
    local d = self:CharData()
    if not d.last or (d.last.at or 0) < at then d.last = { name = name, at = at } end
end

--------------------------------------------------------------------------------
-- The window (design CollectionsWindow, direction A "Stage"): the stage on
-- top, the strip's tools, the strip; the overview in the foot. This step:
-- Mounts (Toys and Appearances follow).
--------------------------------------------------------------------------------

local WIDTH, HEIGHT = 960, 700
local CELL, COLS, ROWS = 40, 18, 2
local TILES = 10 -- Appearances: framed 3D tiles a page
local DOLL_L, DOLL_R = 320, 210 -- Appearances: the slot columns' insets
local CARD_W, SHADE_W = 270, 340
-- The mount: a model frame the game fits each model into, whatever its
-- size (seen in game: the mount scene's camera, tuned by hand, fit some
-- mounts and left others too big, too low or cut off; the first probe's
-- PlayerModel framed them whole). It sizes the model by its frame's width
-- and centres it in the frame, and cuts it at the frame's edges (seen in
-- game: 560 wide drew the mount about 300 high, a 300-high frame cut it).
-- So MODEL_W sets the size (a mount about 0.53 of it high), and the frame,
-- from the stage's top, is MODEL_H high so the middle of a mount that high
-- sits half its height above the floor glow: its feet stand there. Centred
-- on the stage, the card over its left.
-- The game centres each mount by its whole size, so where the feet show
-- differs per mount (seen in game: some stood on the floor shadow, some
-- floated). The frame's camera says where it stands and aims relative to
-- the model, whose origin is the ground under it: how far below the
-- frame's middle that shows follows from it, times FEET_K * the frame's
-- width (calibrated with /suu probe mountframe in a 440 by 470 frame: a
-- Swift Stormsaber's 165px). Each mount is lifted by the frame's own
-- SetPosition until it shows FEET_BELOW under the middle (the camera and
-- the model's size untouched: tested with /suu probe mountframe place, the
-- feet of every mount within about 20px), and the frame sits so that point
-- is FEET_Y above the stage's bottom, the floor shadow's middle.
-- FEET_DROP: the feet a mount shows stand above the ground under its body
-- (seen in game: a raptor's 60px, a kodo's 30px above the shadow's
-- middle), so every mount goes down by about that much.
-- The frame is wide so long mounts turned side on fit (seen in game: 440
-- wide cut them); the game sizes the model by the frame's larger side, so
-- the camera moves back by that side over the calibrated 470 (tested with
-- the placement probe: a kodo the same size in 760 wide, its feet the same
-- 40px above the ground point; scaling the model instead misplaced it).
-- The projection follows the larger side too.
local FLOOR, MODEL_W, MODEL_H, SIZE_REF = 40, 760, 470, 470
local FEET_K, FEET_Y, FEET_BELOW = 2.739 * 440 / SIZE_REF, 72, 165
-- How far each mount model's feet show above the ground under its body, by
-- model file (stood on the floor by hand with /suu probe mountfeet,
-- 2026-10-17, at the stage's facing); a model not here: FEET_DROP.
local FEET_DROP = 64
local FEET_DROPS = {
    [123410] = 56, -- Black War Wolf
    [123418] = 56, -- Brown Wolf
    [124038] = 94, -- Black War Tiger
    [124052] = 90, -- Golden Sabercat
    [124696] = 46, -- Black War Kodo
    [124711] = 46, -- Brown Kodo
    [124872] = 74, -- Blue Mechanostrider
    [124880] = 72, -- Black Battlestrider
    [125009] = 64, -- Green Skeletal Warhorse
    [125223] = 70, -- Summon Dreadsteed
    [125227] = 70, -- Summon Felsteed
    [125522] = 70, -- Black War Ram
    [125546] = 54, -- White Ram
    [125614] = 74, -- Black Stallion
    [125620] = 56, -- Black War Steed
    [125649] = 76, -- Black War Raptor
    [125680] = 76, -- Emerald Raptor
    [125687] = 80, -- Summon Blue Qiraji Battle Tank
    [126304] = 66, -- Black Skeletal Horse
    [126306] = 62, -- Dark Skeletal Horse
    [126403] = 62, -- Summon Charger
    [126407] = 66, -- Summon Warhorse
    [7704354] = 64, -- Empyrean Galestrider
    [7704356] = 64, -- Swift Empyrean Galestrider
    [7704362] = 52, -- Spectral Bear
    [7780798] = 94, -- Summon Forsaken Charger
    [7935081] = 48, -- Pack Kodo
    [7958137] = 94, -- Summon Warhorse
}
local FACING = 0.6
local CAM_SCALE = math.max(MODEL_W, MODEL_H) / SIZE_REF
local ZOOM_MIN, ZOOM_MAX = 0.6, 2.5

local TOOLS_H = 30
local STRIP_H = CELL * ROWS + S["space-5"] + 8
local MEDIA = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local GLYPHS = MEDIA .. "Glyphs\\"
local SOFT = MEDIA .. "CircleSoft.tga"
local DISC = MEDIA .. "CircleFill.tga"

local function day(at: number?): string?
    if not at then return nil end
    if at == 0 then return "before SuuUI" end
    return date("%d %b", at):gsub("^0", "")
end

local function status(e: Entry): (string, string)
    if not e.collected then return "Not collected", "ink-faint" end
    local when = day(e.learned)
    return "Collected" .. (when and (" · " .. when) or ""), "gilt-text"
end

-- A small round button (the stage's star, turn and zoom): a disc, a glyph.
local function roundButton(parent: Frame, glyph: string, tip: any, onClick: any): any
    local b = CreateFrame("Button", nil, parent) :: any
    b:SetSize(26, 26)
    b.disc = b:CreateTexture(nil, "BACKGROUND")
    b.disc:SetTexture(DISC)
    b.disc:SetAllPoints()
    UI.Paint(b.disc, "surface-raised")
    b.glyph = b:CreateTexture(nil, "ARTWORK")
    b.glyph:SetTexture(GLYPHS .. glyph .. ".tga")
    b.glyph:SetSize(12, 12)
    b.glyph:SetPoint("CENTER")
    UI.Paint(b.glyph, "ink-muted")
    b.on = false
    function b:Draw(hover: boolean)
        UI.Paint(self.glyph, self.on and "gilt" or hover and "ink" or "ink-muted")
    end
    b:SetScript("OnEnter", function(self) self:Draw(true); if tip then UI.ShowTooltip(self, { title = type(tip) == "function" and tip(self) or tip }) end end)
    b:SetScript("OnLeave", function(self) self:Draw(false); UI.HideTooltip() end)
    b:SetScript("OnClick", onClick)
    return b
end

--------------------------------------------------------------------------------
-- The card on the stage: name, status, a rule, the full source card
--------------------------------------------------------------------------------

local function buildCard(stage: Frame): any
    local c = CreateFrame("Frame", nil, stage) :: any
    c:SetPoint("TOPLEFT", S["space-6"], -S["space-6"])
    c:SetPoint("BOTTOMLEFT", S["space-6"], 52)
    c:SetWidth(CARD_W)
    c:SetFrameLevel(stage:GetFrameLevel() + 10)
    c.name = UI.Text(c, "alert", "ink")
    c.name:SetPoint("TOPLEFT")
    c.name:SetWidth(CARD_W)
    c.name:SetJustifyH("LEFT")
    c.name:SetWordWrap(true)
    c.status = UI.Text(c, "caption", "gilt-text")
    c.status:SetPoint("TOPLEFT", c.name, "BOTTOMLEFT", 0, -S["space-3"])
    c.extra = UI.Text(c, "caption", "arcane")
    c.extra:SetPoint("LEFT", c.status, "RIGHT", S["space-4"], 0)
    c.rule = UI.Hairline(c, "gilt-line", "out")
    c.rule:SetPoint("TOPLEFT", c.status, "BOTTOMLEFT", 0, -S["space-4"])
    c.rule:SetWidth(CARD_W)
    c.texts = {}
    return c
end

function M:DrawCard(c: any, e: Entry, extra: string?)
    c.name:SetValue(e.name or "")
    local text, color = status(e)
    c.status:SetValue(text)
    c.status:SetColor(color)
    c.extra:SetValue(extra or "")
    for _, t in ipairs(c.texts) do t:Hide() end
    local card = self:SourceCard(e.source, e.kind == "appearance" and "appearance" or "mount", e.sourceType)
    if not card[1] then card = { { title = "Source unknown", lines = {} } } end
    local n, prev = 0, c.rule
    local function text(style: string, tone: string, indent: number, gap: number): any
        n = n + 1
        local t = c.texts[n]
        if not t then
            t = UI.Text(c, style, tone)
            t:SetJustifyH("LEFT")
            t:SetWordWrap(true)
            c.texts[n] = t
        end
        t:SetStyle(style)
        t:SetColor(tone)
        t:ClearAllPoints()
        t:SetPoint("TOPLEFT", prev, "BOTTOMLEFT", indent - (prev.suuIndent or 0), -gap)
        t:SetWidth(CARD_W - indent)
        t.suuIndent = indent
        t:Show()
        prev = t
        return t
    end
    for i, section in ipairs(card) do
        text("micro", "gilt-text", 0, i == 1 and S["space-4"] or S["space-5"]):SetValue(section.title)
        for _, line in ipairs(section.lines) do text("body", "ink", 15, S["space-2"]):SetValue(line) end
    end
end

--------------------------------------------------------------------------------
-- The strip: 40px cells, 2 rows of 18 a page
--------------------------------------------------------------------------------

local function buildCell(parent: Frame, owner: any): any
    local b = CreateFrame("Button", nil, parent) :: any
    b:SetSize(CELL, CELL)
    UI.Fill(b, "surface-sunk", "BACKGROUND"):SetAllPoints()
    b.icon = b:CreateTexture(nil, "ARTWORK")
    b.icon:SetPoint("TOPLEFT", 1, -1)
    b.icon:SetPoint("BOTTOMRIGHT", -1, 1)
    b.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
    b.edge = UI.Border(b, "gilt-hairline", { layer = "OVERLAY" })
    b.star = b:CreateTexture(nil, "OVERLAY", nil, 2)
    b.star:SetTexture(GLYPHS .. "star.tga")
    b.star:SetSize(11, 11)
    b.star:SetPoint("TOPRIGHT", -1, -1)
    UI.Paint(b.star, "gilt-text")
    b.new = UI.Diamond(b, 6, "ink", "OVERLAY", 3)
    b.new:SetPoint("CENTER", b, "TOPLEFT", 1, -1)
    b.jewel = UI.Diamond(b, 5, "gilt", "OVERLAY", 3)
    b.jewel:SetPoint("CENTER", b, "BOTTOM", 0, -4)
    b:SetScript("OnEnter", function(self)
        self.hover = true
        owner:DrawCell(self)
        local e = self.entry
        if not e then return end
        UI.ShowTooltip(self, { title = e.name, subtitle = e.collected and (status(e)) or nil,
            description = owner:SourceLine(e.source, e.kind == "appearance" and "appearance" or "mount", e.sourceType) })
    end)
    b:SetScript("OnLeave", function(self) self.hover = false; owner:DrawCell(self); UI.HideTooltip() end)
    b:SetScript("OnClick", function(self) owner:Choose(self.entry) end)
    b:EnableMouseWheel(true)
    b:SetScript("OnMouseWheel", function(_, delta) owner:Page(-delta) end)
    return b
end

function M:DrawCell(b: any)
    local e = b.entry
    if not e then b:Hide() return end
    b.icon:SetTexture(e.icon)
    local missing = not e.collected
    b.icon:SetDesaturated(missing)
    local v = missing and (b.hover and 0.8 or 0.55) or 1
    b.icon:SetVertexColor(v, v, v)
    local chosen = self.chosen and self.chosen.id == e.id
    b.edge:SetColor((chosen or b.hover) and "gilt" or missing and "gilt-faint" or "gilt-hairline")
    b.star:SetShown(e.favourite and true or false)
    b.new:SetShown(e.learned and e.learned > 0 and time() - e.learned < 7 * 86400 or false)
    b.jewel:SetShown(chosen)
    b:Show()
end

--------------------------------------------------------------------------------
-- Building it
--------------------------------------------------------------------------------

function M:Build()
    local w = UI.WindowFrame(SuuUI.Root, { name = "SuuUICollectionsWindow", title = "Collections", width = WIDTH, height = HEIGHT,
        footer = true, onClose = function(win: any) win:Hide() end,
        tabs = {
            { key = "mounts", label = "Mounts" },
            { key = "pets", label = "Pets", disabled = true, reason = "No pets on Forever yet" },
            { key = "toys", label = "Toys" },
            { key = "heirlooms", label = "Heirlooms", disabled = true, reason = "No heirlooms on Forever yet" },
            { key = "wardrobe", label = "Appearances" },
        },
        onTab = function(key: string)
            if key ~= self.tab then self.chosen, self.page = nil, 1 end
            self.tab = key
            local first = self.tools and self.tools.list.buttons[1]
            if first then first.label:SetValue(key == "toys" and "Toys" or key == "wardrobe" and "All" or "Mounts") end
            self:Refresh()
        end })
    w:SetPoint("CENTER", UIParent, "CENTER", 0, 30)
    w:Hide()
    w.scroll:Hide()
    -- on opening the frames aren't laid out yet when the first mount loads,
    -- so its camera read wrong (seen in game: wrong on opening, right after
    -- choosing another and back): shown once more a frame later
    w:HookScript("OnShow", function()
        self:Refresh()
        after(0, function()
            self.showing = nil
            self:Refresh()
        end)
    end)
    self.window = w
    local body = w.body

    -- the strip at the foot of the body, its tools above it, the stage on top
    local strip = CreateFrame("Frame", nil, body)
    strip:SetPoint("BOTTOMLEFT")
    strip:SetPoint("BOTTOMRIGHT")
    strip:SetHeight(STRIP_H)
    strip:EnableMouseWheel(true)
    strip:SetScript("OnMouseWheel", function(_, delta) self:Page(-delta) end)
    self.strip = strip
    strip.prev = UI.Button(strip, { icon = "chevronLeft", width = 30, onClick = function() self:Page(-1) end })
    strip.prev:SetPoint("LEFT", 0, S["space-2"])
    strip.next = UI.Button(strip, { icon = "chevronRight", width = 30, onClick = function() self:Page(1) end })
    strip.next:SetPoint("RIGHT", 0, S["space-2"] + 8)
    strip.pageText = UI.Text(strip, "micro", "ink-muted")
    strip.pageText:SetPoint("TOP", strip.next, "BOTTOM", 0, -S["space-2"])
    strip.grid = CreateFrame("Frame", nil, strip)
    strip.grid:SetPoint("TOPLEFT", strip, "TOPLEFT", 30 + S["space-5"], 0)
    strip.grid:SetPoint("BOTTOMRIGHT", strip, "BOTTOMRIGHT", -(30 + S["space-5"]), 0)
    strip.cells = {}
    for i = 1, COLS * ROWS do strip.cells[i] = buildCell(strip.grid, self) end
    strip.empty = UI.Text(strip, "body", "ink-muted")
    strip.empty:SetPoint("CENTER")
    strip.grid:HookScript("OnSizeChanged", function() self:LayoutCells() end)

    local tools = CreateFrame("Frame", nil, body)
    tools:SetPoint("BOTTOMLEFT", strip, "TOPLEFT", 0, S["space-5"])
    tools:SetPoint("BOTTOMRIGHT", strip, "TOPRIGHT", 0, S["space-5"])
    tools:SetHeight(TOOLS_H)
    self.tools = tools
    tools.search = UI.TextField(tools, { width = 190, placeholder = "Search", onTextChanged = function() self.page = 1; self:Refresh() end })
    tools.search:SetPoint("LEFT")
    tools.have = UI.Segmented(tools, { value = "all", options = { { value = "all", label = "All" }, { value = "have", label = "Collected" },
        { value = "missing", label = "Not collected" } }, onChange = function() self.page = 1; self:Refresh() end })
    tools.have:SetPoint("LEFT", tools.search, "RIGHT", S["space-4"], 0)
    tools.list = UI.Segmented(tools, { value = "all", options = { { value = "all", label = "Mounts" }, { value = "fav", label = "Favourites" },
        { value = "recent", label = "Recent" } }, onChange = function() self.page = 1; self:Refresh() end })
    tools.list:SetPoint("LEFT", tools.have, "RIGHT", S["space-4"], 0)
    tools.count = UI.Text(tools, "numeric", "ink")
    tools.count:SetPoint("RIGHT", -70, 0)
    tools.track = UI.Fill(tools, "track", "ARTWORK")
    tools.track:SetSize(60, 2)
    tools.track:SetPoint("RIGHT")
    tools.fill = UI.Fill(tools, "gilt", "OVERLAY")
    tools.fill:SetHeight(2)
    tools.fill:SetPoint("LEFT", tools.track, "LEFT")

    -- the stage
    local stage = CreateFrame("Frame", nil, body)
    stage:SetPoint("TOPLEFT")
    stage:SetPoint("TOPRIGHT")
    stage:SetPoint("BOTTOM", tools, "TOP", 0, S["space-5"])
    stage:SetClipsChildren(true)
    UI.ModelStage(stage, { floor = FLOOR, shade = SHADE_W })
    self.stage = stage
    -- the mount: fitted by the game, turned by drag, zoomed by the wheel
    local model = CreateFrame("PlayerModel", nil, stage)
    model:SetSize(MODEL_W, MODEL_H)
    model:SetPoint("BOTTOM", stage, "BOTTOM", 0, FEET_Y - FEET_DROP + FEET_BELOW - MODEL_H / 2)
    model:SetFrameLevel(stage:GetFrameLevel() + 2)
    model:EnableMouse(true)
    model:EnableMouseWheel(true)
    model:SetScript("OnMouseDown", function(m, button)
        if button == "LeftButton" then m.dragX = GetCursorPosition() end
    end)
    model:SetScript("OnMouseUp", function(m) m.dragX = nil end)
    model:SetScript("OnUpdate", function(m)
        if not m.dragX then return end
        local x = GetCursorPosition()
        local delta = (x - m.dragX) / (m:GetEffectiveScale() * 100)
        m.dragX = x
        if delta ~= 0 then call(m.SetFacing, m, (call(m.GetFacing, m) or 0) + delta) end
    end)
    model:SetScript("OnMouseWheel", function(_, delta) self:Zoom(-delta) end)
    model:SetScript("OnModelLoaded", function() self:ModelLoaded() end)
    self.model = model
    -- loading: the icon first
    stage.loading = CreateFrame("Frame", nil, stage)
    stage.loading:SetSize(200, 120)
    stage.loading:SetPoint("CENTER", stage, "CENTER", 0, FLOOR / 2)
    stage.loading:SetFrameLevel(stage:GetFrameLevel() + 3)
    stage.loading.icon = stage.loading:CreateTexture(nil, "ARTWORK")
    stage.loading.icon:SetSize(80, 80)
    stage.loading.icon:SetPoint("TOP")
    stage.loading.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
    stage.loading.text = UI.Text(stage.loading, "caption", "ink-muted")
    stage.loading.text:SetPoint("TOP", stage.loading.icon, "BOTTOM", 0, -S["space-4"])
    stage.loading.text:SetValue("Loading the model…")
    stage.loading:Hide()
    -- the empty stage
    stage.empty = CreateFrame("Frame", nil, stage)
    stage.empty:SetAllPoints()
    stage.empty:SetFrameLevel(stage:GetFrameLevel() + 4)
    stage.empty.title = UI.Text(stage.empty, "alert", "ink")
    stage.empty.title:SetPoint("TOP", 0, -S["space-7"])
    stage.empty.text = UI.Text(stage.empty, "body", "ink-muted")
    stage.empty.text:SetPoint("TOP", stage.empty.title, "BOTTOM", 0, -S["space-3"])
    stage.empty.text:SetWidth(420)
    stage.empty.text:SetWordWrap(true)
    stage.empty.text:SetJustifyH("CENTER")
    stage.empty:Hide()
    self.card = buildCard(stage)
    -- top right: the favourite star and the primary action
    stage.star = roundButton(stage, "star", function(b) return b.on and "Remove from favourites" or "Add to favourites" end,
        function() self:ToggleFavourite() end)
    stage.star:SetFrameLevel(stage:GetFrameLevel() + 12)
    -- Summon / Dismiss: SuuUI's own secure button; the look is a SuuUI button under it
    local act = CreateFrame("Button", "SuuUICollectionsAction", stage, "SecureActionButtonTemplate")
    act:SetSize(120, 30)
    act:SetPoint("TOPRIGHT", -S["space-6"], -S["space-6"])
    act:RegisterForClicks("AnyUp", "AnyDown")
    act:SetFrameLevel(stage:GetFrameLevel() + 12)
    act.look = UI.Button(act, { text = "Summon", variant = "primary", width = 120 })
    act.look:SetAllPoints()
    act.look:EnableMouse(false)
    act:HookScript("OnEnter", function(b) if b.why then UI.ShowTooltip(b, { title = b.look.label and b.look.label:GetText() or "", description = b.why }) end end)
    act:HookScript("OnLeave", function() UI.HideTooltip() end)
    self.act = act
    stage.star:SetPoint("RIGHT", act, "LEFT", -S["space-4"], 0)
    -- bottom centre of the model's area: turn left, zoom out, zoom in, turn right
    local ctl = CreateFrame("Frame", nil, stage)
    ctl:SetSize(4 * 26 + 3 * S["space-3"], 26)
    ctl:SetPoint("BOTTOM", stage, "BOTTOM", 0, S["space-4"])
    ctl:SetFrameLevel(stage:GetFrameLevel() + 12)
    local x = 0
    for _, def in ipairs({ { "turnLeft", "Turn left", function() self:Turn(-1) end }, { "minus", "Zoom out", function() self:Zoom(1) end },
                           { "plus", "Zoom in", function() self:Zoom(-1) end }, { "turnRight", "Turn right", function() self:Turn(1) end } }) do
        local glyph = def[1] :: string
        local b = roundButton(ctl, glyph, def[2], def[3])
        if not (glyph == "minus" or glyph == "plus") then
            -- turn arrows: the reset glyph, mirrored for the right
            b.glyph:SetTexture(GLYPHS .. "reset.tga")
            if glyph == "turnRight" then b.glyph:SetTexCoord(1, 0, 0, 1) end
        end
        b:SetPoint("LEFT", x, 0)
        x = x + 26 + S["space-3"]
    end
    stage.ctl = ctl
    stage.hint = UI.Text(stage, "caption", "ink-faint")
    stage.hint:SetPoint("BOTTOMRIGHT", -S["space-5"], S["space-5"])
    stage.hint:SetValue("Drag to turn · Wheel to zoom")

    self:BuildWardrobe()
    self:BuildShelf()

    -- the foot: the overview
    self.foot = UI.Text(assert(w.footer), "caption", "ink-muted")
    self.foot:SetPoint("LEFT")
    self.last = UI.Text(assert(w.footer), "caption", "ink-muted")
    self.last:SetPoint("RIGHT")
end

--------------------------------------------------------------------------------
-- What the strip shows: the tab's entries through the search and filters
--------------------------------------------------------------------------------

-- The entries a search (lower case) and the filters keep: have "all",
-- "have", "missing"; list "all", "fav", "recent" (newest first, what you
-- had before SuuUI last).
local function filterEntries(all: Entry[], search: string, have: string, list: string): Entry[]
    local out: Entry[] = {}
    for _, e in ipairs(all) do
        local ok = (search == "" or e.name:lower():find(search, 1, true))
            and (have == "all" or (have == "have") == (e.collected and true or false))
            and (list ~= "fav" or e.favourite)
            and (list ~= "recent" or e.learned ~= nil)
        if ok then out[#out + 1] = e end
    end
    if list == "recent" then
        table.sort(out, function(a, b)
            local x, y = a.learned or -1, b.learned or -1
            if x == 0 then x = -1 end
            if y == 0 then y = -1 end
            if x ~= y then return x > y end
            return a.name < b.name
        end)
    end
    return out
end

function M:Entries()
    local all
    if self.tab == "wardrobe" then all = self:WardrobeEntries()
    elseif self.tab == "toys" then all = self:Toys()
    else all = self:Mounts() end
    local tools = self.tools
    local search = (tools.search.edit:GetText() or ""):lower()
    return filterEntries(all, search, tools.have.value or "all", tools.list.value or "all"), all
end

-- The cells across the grid's width (18 a row, the space shared out between).
function M:LayoutCells()
    local grid = self.strip.grid
    local w = grid:GetWidth()
    if not w or isSecret(w) or w <= 0 then return end
    local gap = math.max(2, (w - COLS * CELL) / (COLS - 1))
    for i, b in ipairs(self.strip.cells) do
        local col, row = (i - 1) % COLS, math.floor((i - 1) / COLS)
        b:ClearAllPoints()
        b:SetPoint("TOPLEFT", col * (CELL + gap), -row * (CELL + S["space-5"]))
    end
end

function M:Page(step: number)
    local pages = self.pages or 1
    self.page = math.max(1, math.min(pages, (self.page or 1) + step))
    self:DrawStrip()
end

function M:DrawStrip()
    local strip, list = self.strip, self.entries or {}
    local tiles = self.tab == "wardrobe"
    strip.grid:SetShown(not tiles)
    strip.tileGrid:SetShown(tiles)
    local per = tiles and TILES or COLS * ROWS
    self.pages = math.max(1, math.ceil(#list / per))
    self.page = math.max(1, math.min(self.pages, self.page or 1))
    local first = (self.page - 1) * per
    if tiles then
        for i, b in ipairs(strip.tiles) do
            b.entry = list[first + i]
            self:DrawTile(b)
        end
    else
        for i, b in ipairs(strip.cells) do
            b.entry = list[first + i]
            self:DrawCell(b)
        end
    end
    local paged = self.pages > 1
    strip.prev:SetShown(paged)
    strip.next:SetShown(paged)
    strip.pageText:SetShown(paged)
    strip.prev:SetEnabledState(self.page > 1)
    strip.next:SetEnabledState(self.page < self.pages)
    strip.pageText:SetValue(self.page .. " / " .. self.pages)
    strip.empty:SetShown(#list == 0)
    strip.empty:SetValue(self.tab == "toys" and "No toys match." or tiles and "No appearances match." or "No mounts match.")
end

function M:Refresh()
    if not (self.window and self.window:IsShown()) then return end
    local entries, all = self:Entries()
    self.entries, self.all = entries, all
    local have = 0
    for _, e in ipairs(all) do if e.collected then have = have + 1 end end
    local tools = self.tools
    local titled = self.tab == "wardrobe"
    tools.title:SetShown(titled)
    tools.title:SetValue(titled and self.slotTitle or "")
    tools.search:ClearAllPoints()
    tools.search:SetPoint("LEFT", titled and (tools.title:GetUnboundedStringWidth() + S["space-5"]) or 0, 0)
    tools.count:SetValue(("%d |cff%sof %d|r"):format(have, T.color["ink-muted"].hex, #all))
    tools.fill:SetWidth(math.max(1, 60 * (#all > 0 and have / #all or 0)))
    self:LayoutTab()
    if self.tab == "toys" then
        self:DrawShelf()
        self:DrawFoot()
        return
    end
    -- the chosen one stays while it is listed; else the first (also with
    -- none of your own: asked in game, the stage is never empty then)
    local still = false
    for _, e in ipairs(entries) do if self.chosen and e.id == self.chosen.id then self.chosen = e; still = true end end
    if not still then self.chosen = entries[1] end
    self:DrawStrip()
    self:DrawStage()
    self:DrawFoot()
end

function M:Choose(e: Entry?)
    if not e then return end
    self.chosen = e
    self:DrawStrip()
    self:DrawStage()
end

--------------------------------------------------------------------------------
-- The stage
--------------------------------------------------------------------------------

function M:DrawStage()
    local stage, e = self.stage, self.chosen
    local wardrobe = self.tab == "wardrobe"
    self.wardrobe:SetShown(wardrobe)
    if wardrobe then
        if self.model then self.model:Hide() end
        self.showing, self.waiting = nil, nil
        stage.loading:Hide()
        stage.star:Hide()
        stage.empty:Hide()
        stage.ctl:Show()
        -- no hint here (the design: it would run under Undress)
        stage.hint:Hide()
        -- the doll stands between the columns, off the stage's middle
        stage:CentreOn((DOLL_L - DOLL_R) / 2)
        if not InCombatLockdown() then self.act:Hide() end
        stage:Tint("gilt")
        self:DrawWardrobe()
        return
    end
    stage:CentreOn(0)
    local none = e == nil
    stage.empty:SetShown(none)
    self.card:SetShown(not none)
    stage.star:SetShown(not none)
    stage.ctl:SetShown(not none)
    stage.hint:SetShown(not none)
    stage:Tint("gilt")
    if none then
        -- only when a search or filter leaves nothing (the first entry is
        -- chosen otherwise, also with none of your own)
        stage.empty.title:SetValue("No mounts match")
        stage.empty.text:SetValue("Clear the search or show All.")
        if self.model then self.model:Hide() end
        self.showing, self.waiting = nil, nil
        stage.loading:Hide()
        self:DrawAction()
        return
    end
    stage.star.on = e.favourite and true or false
    stage.star:Draw(false)
    self:ShowMount(e)
    self:DrawCard(self.card, e)
    self:DrawAction()
end

-- The toys' cooldowns on the shelf: again every second while it shows
-- (the time counts down) and when the game says a cooldown changed.
function M:DrawCooldowns()
    if self.tab == "toys" then self:DrawShelfCooldowns() end
end

-- The mount fitted to the stage; its icon until the model has loaded, then
-- the model fades in. The same mount again is left as it is (seen in game:
-- shown twice on opening, the second load sent no signal and the icon
-- stayed).
function M:ShowMount(e: Entry)
    local model, stage = self.model, self.stage
    if not model then return end
    if self.showing == e.id and model:IsShown() then return end
    self.showing, self.waiting = e.id, e.id
    model:SetAlpha(0)
    model:Show()
    stage.loading.icon:SetTexture(e.icon)
    stage.loading:Show()
    call(model.ClearModel, model)
    call(model.SetDisplayInfo, model, e.display or 0)
    self.camScale = CAM_SCALE
    call(model.SetCamDistanceScale, model, self.camScale)
    call(model.SetPosition, model, 0, 0, 0)
    call(model.SetFacing, model, FACING)
    -- no answer from the game in two seconds: shown anyway
    local id = e.id
    after(2, function() if self.waiting == id then self:ModelLoaded() end end)
end

-- how far below the frame's middle the ground under the model shows, with
-- the camera at P aiming at T and the model lifted by `lift`
local function dot(a: number[], b: number[]): number return a[1] * b[1] + a[2] * b[2] + a[3] * b[3] end
local function norm(x: number, y: number, z: number): number[]?
    local l = math.sqrt(x * x + y * y + z * z)
    if l == 0 then return nil end
    return { x / l, y / l, z / l }
end
local function groundBelow(P: number[], aim: number[], lift: number): number?
    local f = norm(aim[1] - P[1], aim[2] - P[2], aim[3] - P[3])
    if not f then return nil end
    local right = norm(f[2], -f[1], 0)
    if not right then return nil end
    local u = { right[2] * f[3] - right[3] * f[2], right[3] * f[1] - right[1] * f[3], right[1] * f[2] - right[2] * f[1] }
    if u[3] < 0 then u = { -u[1], -u[2], -u[3] } end
    local r = { -P[1], -P[2], lift - P[3] }
    local depth = dot(r, f)
    if depth <= 0 then return nil end
    return -FEET_K * math.max(MODEL_W, MODEL_H) * dot(r, u) / depth
end

-- The mount lifted so the ground under it shows FEET_BELOW under the
-- frame's middle (on the floor shadow). Nothing when the camera can't be read.
function M:PlaceModel()
    local m = self.model
    if not m then return end
    local px, py, pz = call(m.GetCameraPosition, m)
    local tx, ty, tz = call(m.GetCameraTarget, m)
    for _, v in ipairs({ px, py, pz, tx, ty, tz }) do
        if type(v) ~= "number" or isSecret(v) then return end
    end
    local P, aim = { px, py, pz }, { tx, ty, tz }
    if not groundBelow(P, aim, 0) then return end
    local lo, hi = -3, 3
    for _ = 1, 40 do
        local mid = (lo + hi) / 2
        local b = groundBelow(P, aim, mid)
        if not b then return end
        if b > FEET_BELOW then lo = mid else hi = mid end
    end
    call(m.SetPosition, m, 0, 0, (lo + hi) / 2)
    -- down by this model's own gap between its feet and the ground point
    local file = call(m.GetModelFileID, m)
    local drop = (type(file) == "number" and not isSecret(file) and FEET_DROPS[file]) or FEET_DROP
    m:ClearAllPoints()
    m:SetPoint("BOTTOM", self.stage, "BOTTOM", 0, FEET_Y - drop + FEET_BELOW - MODEL_H / 2)
end

-- Loaded: the camera back (CAM_SCALE), then placed on the floor once the
-- camera has moved (read a moment later), then shown.
function M:ModelLoaded()
    local model = self.model
    if not (model and self.waiting) then return end
    local id = self.waiting
    self.waiting = nil
    call(model.SetCamDistanceScale, model, self.camScale or CAM_SCALE)
    after(0.1, function()
        if self.showing ~= id then return end
        self:PlaceModel()
        self.stage.loading:Hide()
        model:SetAlpha(1)
        SuuUI.Motion.FadeIn(model, T.duration["dur-base"])
    end)
end

function M:Turn(dir: number)
    local m = self.tab == "wardrobe" and self.wardrobe.doll or self.model
    if not m then return end
    call(m.SetFacing, m, (call(m.GetFacing, m) or 0) + dir * 0.35)
end

function M:Zoom(dir: number)
    if self.tab == "wardrobe" then
        local d = self.wardrobe.doll
        self.dollScale = math.max(0.6, math.min(2.5, (self.dollScale or 1) * (dir > 0 and 1.12 or 0.89)))
        call(d.SetCamDistanceScale, d, self.dollScale)
        return
    end
    local m = self.model
    if not m then return end
    self.camScale = math.max(ZOOM_MIN * CAM_SCALE, math.min(ZOOM_MAX * CAM_SCALE, (self.camScale or CAM_SCALE) * (dir > 0 and 1.12 or 0.89)))
    call(m.SetCamDistanceScale, m, self.camScale)
    -- on the floor again at the new distance
    after(0.05, function() self:PlaceModel() end)
end

-- A mount's favourite: the game keeps it by the mount's place in its own
-- list, so the place is looked up first.
function M:ToggleFavourite()
    local e = self.chosen
    if e and e.kind == "appearance" then
        call(C_TransmogCollection.SetIsAppearanceFavorite, e.visualID, not e.favourite)
        after(0.1, function() self:Refresh() end)
        return
    end
    if e and e.kind == "toy" then
        call(C_ToyBox.SetIsFavorite, e.itemID, not e.favourite)
        after(0.1, function() self:Refresh() end)
        return
    end
    if not (e and e.kind == "mount") then return end
    local MJ = C_MountJournal
    for i = 1, (call(MJ.GetNumDisplayedMounts) or 0) do
        if call(MJ.GetDisplayedMountID, i) == e.id then
            call(MJ.SetIsFavorite, i, not e.favourite)
            after(0.1, function() self:Refresh() end)
            return
        end
    end
end

-- The stage's action: its label and why it's off (nil: on).
local function actionLabel(mounted: boolean, e: Entry?): (string, string?)
    if mounted then return "Dismiss", nil end
    if not e then return "Summon", "Choose a mount." end
    if not e.collected then return "Summon", "You don't have this mount yet." end
    if not e.usable then return "Summon", "You can't ride this mount here." end
    return "Summon", nil
end

-- Summon or Dismiss: the secure button's job, set out of combat (in one it
-- waits; its look says why).
function M:DrawAction()
    local act, e = self.act, self.chosen
    if not act then return end
    if self.tab == "wardrobe" then
        if not InCombatLockdown() then act:Hide() end
        return
    end
    local mounted = IsMounted and IsMounted() or false
    local label, why = actionLabel(mounted, e)
    act.look.label:SetValue(label)
    act.look:SetEnabledState(why == nil)
    act.why = why
    if InCombatLockdown() then
        self.actionAfterCombat = true
        return
    end
    act:SetShown(e ~= nil or mounted)
    if mounted then
        act:SetAttribute("type", "macro")
        act:SetAttribute("macrotext", "/dismount")
    elseif why then
        act:SetAttribute("type", nil)
    else
        act:SetAttribute("type", "spell")
        act:SetAttribute("spell", e.spellID)
    end
end

function M:DrawFoot()
    local muted, ink = "|cff" .. T.color["ink-muted"].hex, T.color["ink"].hex
    local parts = {}
    for _, kind in ipairs({ { "Mounts", self:Mounts() }, { "Toys", self:Toys() } }) do
        local have = 0
        for _, e in ipairs(kind[2]) do if e.collected then have = have + 1 end end
        parts[#parts + 1] = ("%s |cff%s%d|r%s of %d|r"):format(kind[1], ink, have, muted, #kind[2])
    end
    self.foot:SetValue(table.concat(parts, "  ·  "))
    local last = self:CharData().last
    self.last:SetValue(last and ("Last collected: |cff%s%s|r, %s"):format(T.color["ink"].hex, last.name, day(last.at)) or "Nothing collected yet")
end

--------------------------------------------------------------------------------
-- Opening it: the micro menu (SuuUI.ToggleCollections), the game's
-- Collections key (an override binding onto SuuUI's button), and the game's
-- journal when something else opens it (closed again, ours instead)
--------------------------------------------------------------------------------

function M:Toggle(tab: string?)
    if not self.window then return end
    if self.window:IsShown() and not tab then self.window:Hide() return end
    self.window:Show()
    self.window:SetTab(tab or self.tab or "mounts")
end

function M:BindKeys()
    if not self.bindOwner then return end
    if InCombatLockdown() then self.bindAfterCombat = true return end
    ClearOverrideBindings(self.bindOwner)
    for _, key in ipairs({ GetBindingKey("TOGGLECOLLECTIONS") }) do
        if key then SetOverrideBindingClick(self.bindOwner, false, key, "SuuUICollectionsToggle") end
    end
end

function M:HookJournal()
    local f = _G.CollectionsJournal
    if not f or self.journalHooked then return end
    self.journalHooked = true
    hookScript(f, "OnShow", function()
        if not self:IsEnabled() or InCombatLockdown() then return end
        HideUIPanel(f)
        self:Toggle("mounts")
    end)
end

function M:OnEnable()
    if not self.window then self:Build() end
    self:Provide("collections", {
        Toggle = function(tab: string?) self:Toggle(tab) end,
        IsShown = function() return self.window and self.window:IsShown() or false end,
    })
    self.tab = self.tab or "mounts"
    self.slot = self.slot or "CHESTSLOT"
    if not self.toggleButton then
        -- the key shows and hides the window through the game's secure code:
        -- the window holds secure buttons, so it is protected, and SuuUI's
        -- own code can't show it in a fight (found in tests: nothing opened)
        local b = CreateFrame("Button", "SuuUICollectionsToggle", UIParent, "SecureHandlerClickTemplate")
        b:SetFrameRef("window", self.window)
        b:SetAttribute("_onclick", [=[
            local w = self:GetFrameRef("window")
            if w:IsShown() then w:Hide() else w:Show() end
        ]=])
        self.toggleButton = b
        -- its close button too: a secure one over it (passing the hover on
        -- to the button under it)
        local close: any = (self.window :: any).close
        if close then
            local o = CreateFrame("Button", nil, close, "SecureHandlerClickTemplate")
            o:SetAllPoints(close)
            o:SetFrameRef("window", self.window)
            o:SetAttribute("_onclick", [=[ self:GetFrameRef("window"):Hide() ]=])
            for _, script in ipairs({ "OnEnter", "OnLeave" }) do
                o:SetScript(script, function(_: any, ...: any)
                    local fn = close:GetScript(script)
                    if fn then fn(close, ...) end
                end)
            end
            self.closeOverlay = o
        end
        self.bindOwner = CreateFrame("Frame")
        -- (the tab chosen before the first open, which may be in a fight)
        self.window:SetTab(self.tab)
    end
    self:BindKeys()
    self:OnGameEvent("UPDATE_BINDINGS", function() self:BindKeys() end)
    -- the counts carry colour codes: drawn again in the new colours
    self:On("SUUUI_THEME_CHANGED", function() self:Refresh() end)
    self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
        if self.bindAfterCombat then self.bindAfterCombat = nil; self:BindKeys() end
        if self.actionAfterCombat then self.actionAfterCombat = nil; self:DrawAction() end
        if self.shelfAfterCombat then self.shelfAfterCombat = nil; if self.tab == "toys" then self:Refresh() end end
        if self.layoutAfterCombat then self.layoutAfterCombat = nil; self:LayoutTab() end
    end)
    for _, e in ipairs({ "PLAYER_MOUNT_DISPLAY_CHANGED", "COMPANION_UPDATE" }) do
        self:OnGameEvent(e, function() self:DrawAction() end)
    end
    -- something new: noted with today's date, the window redrawn
    self:OnGameEvent("NEW_MOUNT_ADDED", function(_, id)
        local name = id and call(C_MountJournal.GetMountInfoByID, id)
        self:NoteLast(name, time())
        self:Refresh()
    end)
    self:OnGameEvent("MOUNT_JOURNAL_USABILITY_CHANGED", function() self:DrawAction() end)
    -- toys: new ones, their cooldowns, their names as the game sends them
    self:OnGameEvent("NEW_TOY_ADDED", function(_, itemID)
        local _, name = call(C_ToyBox.GetToyInfo, itemID)
        self:NoteLast(plain(name) and name or nil, time())
        self:Refresh()
    end)
    self:OnGameEvent("TOYS_UPDATED", function() if self.window and self.window:IsShown() then self:Refresh() end end)
    for _, e in ipairs({ "SPELL_UPDATE_COOLDOWN", "BAG_UPDATE_COOLDOWN" }) do
        self:OnGameEvent(e, function() if self.window and self.window:IsShown() then self:DrawCooldowns() end end)
    end
    self:OnGameEvent("GET_ITEM_INFO_RECEIVED", function()
        if not (self.namesPending and self.window and self.window:IsShown()) then return end
        self.namesPending = nil
        if self.namesTimer then return end
        self.namesTimer = after(0.3, function() self.namesTimer = nil; self:Refresh() end)
    end)
    -- appearances: new ones, what you wear
    self:OnGameEvent("TRANSMOG_COLLECTION_UPDATED", function()
        self.slotCounts = nil
        if self.tab == "wardrobe" and self.window and self.window:IsShown() then self:Refresh() end
    end)
    self:OnGameEvent("PLAYER_EQUIPMENT_CHANGED", function()
        if self.wardrobe then self.wardrobe.doll.dressed = false; self.tried = nil end
        if self.tab == "wardrobe" and self.window and self.window:IsShown() then self:Refresh() end
    end)
    if not self.ticker then
        self.ticker = every(1, function()
            if self.tab == "toys" and self.window and self.window:IsShown() then self:DrawCooldowns() end
        end)
    end
    self:HookJournal()
    self:OnGameEvent("ADDON_LOADED", function(_, name) if name == "Blizzard_Collections" then self:HookJournal() end end)
end

function M:OnDisable()
    if self.window then self.window:Hide() end
    if self.bindOwner and not InCombatLockdown() then ClearOverrideBindings(self.bindOwner) end
end

--------------------------------------------------------------------------------
-- Appearances (design: the paper doll): you in the middle of the stage, the
-- 14 slots in two columns around you with yours of all, the class and the
-- weapon kind at the top right; the strip is 10 framed 3D tiles of the
-- slot's appearances; the chosen one tried on you, its card at the left,
-- the star and Undress at the bottom right.
--------------------------------------------------------------------------------

local QUALITY = { [0] = "poor", "common", "uncommon", "rare", "epic", "legendary", "legendary", "legendary" }
local SLOT = 30
local SLOTS_L = { "HEADSLOT", "SHOULDERSLOT", "BACKSLOT", "CHESTSLOT", "SHIRTSLOT", "TABARDSLOT", "WRISTSLOT" }
local SLOTS_R = { "HANDSSLOT", "WAISTSLOT", "LEGSSLOT", "FEETSLOT", "MAINHANDSLOT", "SECONDARYHANDSLOT", "RANGEDSLOT" }
local SLOT_ATLAS = {
    HEADSLOT = "transmog-nav-slot-head", SHOULDERSLOT = "transmog-nav-slot-shoulder", BACKSLOT = "transmog-nav-slot-back",
    CHESTSLOT = "transmog-nav-slot-chest", SHIRTSLOT = "transmog-nav-slot-shirt", TABARDSLOT = "transmog-nav-slot-tabard",
    WRISTSLOT = "transmog-nav-slot-wrist", HANDSSLOT = "transmog-nav-slot-hands", WAISTSLOT = "transmog-nav-slot-waist",
    LEGSSLOT = "transmog-nav-slot-legs", FEETSLOT = "transmog-nav-slot-feet", MAINHANDSLOT = "transmog-nav-slot-mainhand",
    SECONDARYHANDSLOT = "transmog-nav-slot-secondaryhand", RANGEDSLOT = "transmog-nav-slot-ranged",
}

local function slotDef(slot: string?): { [string]: any }?
    for _, d in ipairs(M.SLOTS) do if d.slot == slot then return d end end
end

-- The classes the game has, for the class choice.
local function classes()
    local out = {}
    for id = 1, 13 do
        local name = GetClassInfo and call(GetClassInfo, id)
        if plain(name) and name then out[#out + 1] = { value = id, label = name } end
    end
    return out
end

-- One round slot: the game's slot art in a disc, the arcane glow under the
-- chosen one, yours of all under it.
local function buildSlot(parent: Frame, owner: any, slot: string): any
    local b = CreateFrame("Button", nil, parent) :: any
    b:SetSize(SLOT, SLOT)
    b.glow = b:CreateTexture(nil, "BACKGROUND", nil, 1)
    b.glow:SetTexture(SOFT)
    b.glow:SetSize(50, 50)
    b.glow:SetPoint("CENTER")
    UI.Paint(b.glow, "arcane")
    b.glow:SetAlpha(0.55)
    b.ring = b:CreateTexture(nil, "BACKGROUND", nil, 2)
    b.ring:SetTexture(DISC)
    b.ring:SetAllPoints()
    b.disc = b:CreateTexture(nil, "BACKGROUND", nil, 3)
    b.disc:SetTexture(DISC)
    b.disc:SetPoint("TOPLEFT", 1, -1)
    b.disc:SetPoint("BOTTOMRIGHT", -1, 1)
    UI.Paint(b.disc, "surface-sunk")
    b.art = b:CreateTexture(nil, "ARTWORK")
    b.art:SetPoint("TOPLEFT", 2, -2)
    b.art:SetPoint("BOTTOMRIGHT", -2, 2)
    if not pcall(b.art.SetAtlas, b.art, SLOT_ATLAS[slot]) then b.art:SetTexture(GLYPHS .. "shield.tga") end
    local mask = b:CreateMaskTexture()
    mask:SetTexture(DISC, "CLAMPTOBLACKADDITIVE", "CLAMPTOBLACKADDITIVE")
    mask:SetAllPoints(b.art)
    b.art:AddMaskTexture(mask)
    b.n = UI.Text(b, "micro", "ink-muted")
    b.n:SetPoint("TOP", b, "BOTTOM", 0, -1)
    b.slot = slot
    b:SetScript("OnEnter", function(self)
        self.hover = true
        owner:DrawSlot(self)
        local def, c = assert(slotDef(self.slot)), owner.slotCounts and owner.slotCounts[self.slot] or {}
        UI.ShowTooltip(self, { title = def.label, description = c.reason or ("%d of %d collected"):format(c.have or 0, c.all or 0) })
    end)
    b:SetScript("OnLeave", function(self) self.hover = false; owner:DrawSlot(self); UI.HideTooltip() end)
    b:SetScript("OnClick", function(self)
        local c = owner.slotCounts and owner.slotCounts[self.slot]
        if c and c.reason then return end
        owner.slot, owner.chosen, owner.page = self.slot, nil, 1
        owner:Refresh()
    end)
    return b
end

function M:DrawSlot(b: any)
    local c = self.slotCounts and self.slotCounts[b.slot] or {}
    local on = self.slot == b.slot
    local off = c.reason ~= nil
    b.glow:SetShown(on)
    UI.Paint(b.ring, on and "arcane" or (b.hover and not off) and "gilt" or off and "gilt-faint" or "gilt-line")
    b:SetAlpha(off and T.opacity["opacity-disabled"] or 1)
    b.art:SetDesaturated(off)
    b.n:SetValue(off and "—" or ((c.have or 0) .. "/" .. (c.all or 0)))
end

-- A tile: a framed preview of you wearing only that piece (the game's
-- appearance camera), its icon until the model has loaded.
local function buildTile(parent: Frame, owner: any): any
    local b = CreateFrame("Button", nil, parent) :: any
    b.bg = b:CreateTexture(nil, "BACKGROUND", nil, -8)
    b.bg:SetAllPoints()
    b.bg:SetColorTexture(1, 1, 1, 1)
    b.bg:SetGradient("VERTICAL", CreateColor(0.051, 0.043, 0.035, 1), CreateColor(0.102, 0.09, 0.075, 1))
    b.model = CreateFrame("DressUpModel", nil, b)
    b.model:SetPoint("TOPLEFT", 1, -1)
    b.model:SetPoint("BOTTOMRIGHT", -1, 1)
    b.model:SetScript("OnModelLoaded", function(m)
        if b.loading then
            b.loading = false
            b.icon:Hide()
            m:SetAlpha(1)
            SuuUI.Motion.FadeIn(m, T.duration["dur-base"])
        end
    end)
    b.dim = b:CreateTexture(nil, "OVERLAY", nil, 1)
    b.dim:SetAllPoints()
    b.dim:SetColorTexture(0, 0, 0, 0.45)
    b.icon = b:CreateTexture(nil, "OVERLAY", nil, 2)
    b.icon:SetSize(32, 32)
    b.icon:SetPoint("CENTER")
    b.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
    b.edge = UI.Border(b, "gilt-faint", { layer = "OVERLAY", sublevel = 3 })
    b.worn = UI.Text(b, "micro", "gilt-text")
    b.worn:SetPoint("BOTTOM", 0, 2)
    b.worn:SetValue("Worn")
    b.star = b:CreateTexture(nil, "OVERLAY", nil, 4)
    b.star:SetTexture(GLYPHS .. "star.tga")
    b.star:SetSize(11, 11)
    b.star:SetPoint("TOPRIGHT", -2, -2)
    UI.Paint(b.star, "gilt-text")
    b.jewel = UI.Diamond(b, 5, "gilt", "OVERLAY", 5)
    b.jewel:SetPoint("CENTER", b, "BOTTOM", 0, -4)
    b:SetScript("OnEnter", function(self)
        self.hover = true
        owner:DrawTileState(self)
        local e = self.entry
        if not e then return end
        UI.ShowTooltip(self, { title = e.name, titleColor = e.quality and e.quality ~= 1 and ("quality-" .. (QUALITY[e.quality] or "common")) or nil,
            subtitle = e.worn and "Worn" or (e.collected and "Collected" or "Not collected"),
            description = owner:SourceLine(e.source, "appearance", e.sourceType) })
    end)
    b:SetScript("OnLeave", function(self) self.hover = false; owner:DrawTileState(self); UI.HideTooltip() end)
    b:SetScript("OnClick", function(self) owner:Choose(self.entry) end)
    b:EnableMouseWheel(true)
    b:SetScript("OnMouseWheel", function(_, delta) owner:Page(-delta) end)
    return b
end

function M:DrawTileState(b: any)
    local e = b.entry
    if not e then return end
    local chosen = self.chosen and self.chosen.id == e.id
    b.edge:SetColor((chosen or b.hover) and "gilt" or e.worn and "gilt" or e.collected and "gilt-line" or "gilt-faint")
    b.dim:SetShown(not e.collected and not b.hover)
    b.jewel:SetShown(chosen)
end

-- One tile with its entry (or hidden).
function M:DrawTile(b: any)
    local e = b.entry
    if not e then b:Hide() return end
    b:Show()
    b.worn:SetShown(e.worn)
    b.star:SetShown(e.favourite and true or false)
    local w = b:GetWidth()
    if not w or w < 2 then return end
    if b.shownID ~= e.id then
        b.shownID = e.id
        b.loading = true
        b.icon:SetTexture(e.icon)
        b.icon:Show()
        local m = b.model
        m:SetAlpha(0)
        call(m.SetUnit, m, "player")
        call(m.Undress, m)
        if e.camera and _G.Model_ApplyUICamera then pcall(_G.Model_ApplyUICamera, m, e.camera) end
        call(m.TryOn, m, e.sourceID)
        -- no answer in two seconds: shown anyway
        local id = e.id
        after(2, function()
            if b.shownID == id and b.loading then
                b.loading = false
                b.icon:Hide()
                m:SetAlpha(1)
            end
        end)
    end
    self:DrawTileState(b)
end

function M:LayoutTiles()
    local grid = self.strip.tileGrid
    local w, h = grid:GetWidth(), grid:GetHeight()
    if not (w and h) or isSecret(w) or isSecret(h) or w <= 0 then return end
    local gap = S["space-4"]
    local tw = (w - (TILES - 1) * gap) / TILES
    for i, b in ipairs(self.strip.tiles) do
        b:ClearAllPoints()
        b:SetSize(tw, h - 6)
        b:SetPoint("TOPLEFT", (i - 1) * (tw + gap), 0)
        -- a tile drawn before it had its size showed nothing (seen in game:
        -- empty on opening the tab): loaded again at its size
        if b.entry and b.sizedW ~= tw then
            b.sizedW = tw
            b.shownID = nil
            self:DrawTile(b)
        end
    end
end

function M:BuildWardrobe()
    local stage, strip = self.stage, self.strip
    local w = CreateFrame("Frame", nil, stage)
    w:SetAllPoints()
    w:SetFrameLevel(stage:GetFrameLevel() + 2)
    w:Hide()
    self.wardrobe = w
    -- you, between the two columns of slots
    local doll = CreateFrame("DressUpModel", nil, w)
    doll:SetPoint("TOPLEFT", DOLL_L + 40, -S["space-4"])
    doll:SetPoint("BOTTOMRIGHT", -(DOLL_R + 40), S["space-4"])
    doll:EnableMouse(true)
    doll:EnableMouseWheel(true)
    doll:SetScript("OnMouseDown", function(m, button) if button == "LeftButton" then m.dragX = GetCursorPosition() end end)
    doll:SetScript("OnMouseUp", function(m) m.dragX = nil end)
    doll:SetScript("OnUpdate", function(m)
        if not m.dragX then return end
        local x = GetCursorPosition()
        local delta = (x - m.dragX) / (m:GetEffectiveScale() * 100)
        m.dragX = x
        if delta ~= 0 then call(m.SetFacing, m, (call(m.GetFacing, m) or 0) + delta) end
    end)
    doll:SetScript("OnMouseWheel", function(_, delta) self:Zoom(-delta) end)
    w.doll = doll
    -- the slots
    w.slots = {}
    local function column(list: string[], x: number, fromRight: boolean)
        local top, bottom = S["space-6"], S["space-6"] + 14
        local span = stage:GetHeight() > 0 and stage:GetHeight() or 410
        local step = (span - top - bottom - SLOT) / (#list - 1)
        for i, slot in ipairs(list) do
            local b = buildSlot(w, self, slot)
            if fromRight then b:SetPoint("TOPRIGHT", w, "TOPRIGHT", -x, -(top + (i - 1) * step))
            else b:SetPoint("TOPLEFT", w, "TOPLEFT", x, -(top + (i - 1) * step)) end
            w.slots[#w.slots + 1] = b
        end
    end
    column(SLOTS_L, DOLL_L, false)
    column(SLOTS_R, DOLL_R, true)
    -- the class and the weapon kind
    w.class = UI.Select(w, { options = classes(), value = select(3, UnitClass("player")), width = 140,
        onChange = function(id: number)
            call(C_TransmogCollection.SetClassFilter, id)
            self.weaponKind, self.chosen, self.page, self.slotCounts = {}, nil, 1, nil
            self:Refresh()
        end })
    w.class:SetPoint("TOPRIGHT", -S["space-6"], -S["space-6"])
    w.class:SetFrameLevel(w:GetFrameLevel() + 10)
    w.kind = UI.Select(w, { options = {}, width = 180, onChange = function(cat: number)
        local def = slotDef(self.slot)
        self.weaponKind = self.weaponKind or {}
        if def and def.weapon then self.weaponKind[def.weapon] = cat end
        self.chosen, self.page = nil, 1
        self:Refresh()
    end })
    w.kind:SetPoint("TOPRIGHT", w.class, "BOTTOMRIGHT", 0, -S["space-3"])
    w.kind:SetFrameLevel(w:GetFrameLevel() + 10)
    -- bottom right: the star and Undress
    w.star = roundButton(w, "star", function(b) return b.on and "Remove from favourites" or "Add to favourites" end,
        function() self:ToggleFavourite() end)
    w.star:SetFrameLevel(w:GetFrameLevel() + 10)
    w.undress = UI.Button(w, { text = "Undress", icon = "reset", width = 110, onClick = function()
        call(doll.Dress, doll)
        self.tried = nil
    end })
    w.undress.tooltip = { title = "Undress", description = "Back to what you wear." }
    w.undress:SetPoint("BOTTOMRIGHT", -S["space-6"], S["space-6"])
    w.undress:SetFrameLevel(w:GetFrameLevel() + 10)
    w.star:SetPoint("RIGHT", w.undress, "LEFT", -S["space-4"], 0)
    -- the strip's tiles, in the cells' place
    local grid = CreateFrame("Frame", nil, strip)
    grid:SetPoint("TOPLEFT", strip.grid, "TOPLEFT")
    grid:SetPoint("BOTTOMRIGHT", strip.grid, "BOTTOMRIGHT")
    grid:Hide()
    strip.tileGrid = grid
    strip.tiles = {}
    for i = 1, TILES do strip.tiles[i] = buildTile(grid, self) end
    grid:HookScript("OnSizeChanged", function() self:LayoutTiles() end)
    -- the tools' title (the slot and kind)
    self.tools.title = UI.Text(self.tools, "header", "gilt-text")
    self.tools.title:SetPoint("LEFT")
end

-- The slot's appearances (the chosen weapon kind for a weapon slot).
function M:WardrobeEntries()
    local def = slotDef(self.slot) or assert(slotDef("CHESTSLOT"))
    local cat, kindLabel = def.category, nil
    if def.weapon then
        local kinds = self:WeaponKinds(def.weapon)
        self.weaponKind = self.weaponKind or {}
        local chosen = self.weaponKind[def.weapon]
        local found
        for _, k in ipairs(kinds) do if k.category == chosen then found = k end end
        found = found or kinds[1]
        cat, kindLabel = found and found.category, found and found.name
        self.kinds = kinds
        if found then self.weaponKind[def.weapon] = found.category end
    end
    self.slotTitle = def.label .. (kindLabel and (" · " .. kindLabel) or "")
    if not cat then return {} end
    return self:Appearances(cat, def.slot)
end

-- The stage for Appearances: the doll, the slots, the picks, the card.
function M:DrawWardrobe()
    local w, e = self.wardrobe, self.chosen
    if not self.slotCounts then
        local className = w.class.value and GetClassInfo and call(GetClassInfo, w.class.value)
        self.slotCounts = self:SlotCounts(className and (className .. "s"))
    end
    for _, b in ipairs(w.slots) do self:DrawSlot(b) end
    local def = slotDef(self.slot)
    local weapon = def and def.weapon
    w.kind:SetShown(weapon and true or false)
    if weapon then
        local opts = {}
        for _, k in ipairs(self.kinds or {}) do opts[#opts + 1] = { value = k.category, label = k.name } end
        w.kind:SetOptions(opts)
        w.kind:SetValue(self.weaponKind and self.weaponKind[weapon])
    end
    if not w.doll.dressed then
        w.doll.dressed = true
        call(w.doll.SetUnit, w.doll, "player")
    end
    self.card:SetShown(e ~= nil)
    w.star:SetShown(e ~= nil)
    if e then
        self:DrawCard(self.card, e, e.worn and "Worn" or nil)
        if e.quality and e.quality ~= 1 then self.card.name:SetColor("quality-" .. (QUALITY[e.quality] or "common")) end
        w.star.on = e.favourite and true or false
        w.star:Draw(false)
        if self.tried ~= e.sourceID then
            self.tried = e.sourceID
            call(w.doll.TryOn, w.doll, e.sourceID)
        end
    end
end

--------------------------------------------------------------------------------
-- Toys (design: A, the toy shelf; asked in game: no toy has a 3D model, so
-- no stage): every toy as a card in four columns under the tools, what it
-- does, where it comes from or when it is ready, the star and Use (each
-- card's own secure button). Hovering a card: all of it.
--------------------------------------------------------------------------------

local CARD_H, SHELF_COLS = 88, 4

-- What a toy does: the "Use:" line of its tooltip (kept once known).
local useText = {}
local function toyUse(itemID: number): string?
    if useText[itemID] then return useText[itemID] end
    local tip = C_TooltipInfo and C_TooltipInfo.GetToyByItemID and call(C_TooltipInfo.GetToyByItemID, itemID)
    for _, l in ipairs(tip and tip.lines or {}) do
        local t = l.leftText
        if plain(t) and t and t:find("^Use:") then
            useText[itemID] = t:gsub("^Use:%s*", "")
            return useText[itemID]
        end
    end
    return nil
end

local function buildToyCard(parent: Frame, owner: any, i: number): any
    local c = CreateFrame("Frame", nil, parent) :: any
    c:SetHeight(CARD_H)
    c:EnableMouse(true)
    c.bg = UI.Fill(c, "surface-sunk", "BACKGROUND")
    c.bg:SetAllPoints()
    c.edge = UI.Border(c, "gilt-faint")
    c.plate = CreateFrame("Frame", nil, c)
    c.plate:SetSize(40, 40)
    c.plate:SetPoint("TOPLEFT", S["space-4"], -S["space-4"])
    UI.Fill(c.plate, "surface-sunk", "BACKGROUND"):SetAllPoints()
    c.icon = c.plate:CreateTexture(nil, "ARTWORK")
    c.icon:SetPoint("TOPLEFT", 1, -1)
    c.icon:SetPoint("BOTTOMRIGHT", -1, 1)
    c.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
    c.plateEdge = UI.Border(c.plate, "gilt-hairline", { layer = "OVERLAY" })
    c.cd = CreateFrame("Cooldown", nil, c.plate, "CooldownFrameTemplate")
    c.cd:SetAllPoints(c.icon)
    c.star = roundButton(c, "star", function(b) return b.on and "Remove from favourites" or "Add to favourites" end,
        function(b) owner:ToggleToyFavourite(b:GetParent().entry) end)
    c.star:SetSize(20, 20)
    c.star.disc:Hide()
    c.star:SetPoint("TOPRIGHT", -S["space-3"], -S["space-3"])
    c.name = UI.Text(c, "label", "ink")
    c.name:SetPoint("TOPLEFT", c.plate, "TOPRIGHT", S["space-4"], 0)
    c.name:SetPoint("RIGHT", c.star, "LEFT", -18, 0)
    c.name:SetWordWrap(false)
    c.check = c:CreateTexture(nil, "OVERLAY")
    c.check:SetTexture(GLYPHS .. "check.tga")
    c.check:SetSize(11, 11)
    UI.Paint(c.check, "gilt-text")
    c.use = UI.Text(c, "caption", "ink-muted")
    c.use:SetPoint("TOPLEFT", c.name, "BOTTOMLEFT", 0, -1)
    c.use:SetPoint("RIGHT", -S["space-4"], 0)
    c.use:SetJustifyH("LEFT")
    c.use:SetWordWrap(true)
    c.use:SetMaxLines(2)
    c.src = UI.Text(c, "caption", "ink-muted")
    c.src:SetPoint("BOTTOMLEFT", S["space-4"], S["space-3"] + 4)
    c.src:SetPoint("RIGHT", -(S["space-4"] + 64), 0)
    c.src:SetJustifyH("LEFT")
    c.src:SetWordWrap(false)
    -- Use: the card's own secure button, the look a small SuuUI button under it
    local act = CreateFrame("Button", "SuuUIToyUse" .. i, c, "SecureActionButtonTemplate")
    act:SetSize(56, 22)
    act:SetPoint("BOTTOMRIGHT", -S["space-4"], S["space-3"])
    act:RegisterForClicks("AnyUp", "AnyDown")
    act.look = UI.Button(act, { text = "Use", width = 56 })
    act.look:SetAllPoints()
    act.look:EnableMouse(false)
    act:HookScript("OnEnter", function(b) if b.why then UI.ShowTooltip(b, { title = "Use", description = b.why }) end end)
    act:HookScript("OnLeave", function() UI.HideTooltip() end)
    c.act = act
    c:SetScript("OnEnter", function(self)
        self.hover = true
        owner:DrawCardState(self)
        local e = self.entry
        if not e then return end
        local lines = {}
        for _, sec in ipairs(owner:SourceCard(e.source, "toy", nil)) do
            lines[#lines + 1] = { sec.title }
            for _, l in ipairs(sec.lines) do lines[#lines + 1] = { "   " .. l } end
        end
        UI.ShowTooltip(self, { title = e.name, subtitle = e.collected and "Collected" or "Not collected",
            description = toyUse(e.itemID), lines = lines[1] and lines or { { "Source unknown" } } })
    end)
    c:SetScript("OnLeave", function(self) self.hover = false; owner:DrawCardState(self); UI.HideTooltip() end)
    return c
end

function M:DrawCardState(c: any)
    local e = c.entry
    if not e then return end
    c.edge:SetColor(c.hover and "gilt" or "gilt-faint")
    UI.PaintFill(c.bg, c.hover and "surface-raised" or "surface-sunk")
end

-- Why a toy's Use is off (nil: on).
local function toyWhy(e: Entry, start: number, duration: number): string?
    if not e.collected then return "You don't have this toy yet." end
    if duration > 0 then return readyIn(start, duration) .. "." end
    if e.usable == false then return "You can't use this toy here." end
    return nil
end

-- A card's cooldown, its foot line and its Use.
function M:DrawCardCooldown(c: any)
    local e = c.entry
    if not e then return end
    local start, duration = 0, 0
    if e.collected then start, duration = toyCooldown(e.itemID) end
    if duration > 0 then
        c.cd:SetCooldown(start, duration)
        c.src:SetValue(readyIn(start, duration))
        c.src:SetColor("arcane")
    else
        c.cd:Clear()
        c.src:SetValue(self:SourceLine(e.source, "toy", nil))
        c.src:SetColor(e.collected and "ink-muted" or "ink")
    end
    local why = toyWhy(e, start, duration)
    c.act.look:SetEnabledState(why == nil)
    c.act.why = why
end

function M:DrawCard_Toy(c: any)
    local e = c.entry
    -- (a card holds its secure Use: shown or hidden out of combat only, the
    -- game refuses even an unchanged Show in a fight)
    if not e then
        if c:IsShown() then
            if InCombatLockdown() then self.shelfAfterCombat = true else c:Hide() end
        end
        return
    end
    if not c:IsShown() then
        if InCombatLockdown() then self.shelfAfterCombat = true else c:Show() end
    end
    c.icon:SetTexture(e.icon)
    c.icon:SetDesaturated(not e.collected)
    local v = e.collected and 1 or 0.55
    c.icon:SetVertexColor(v, v, v)
    c.plateEdge:SetColor(e.collected and "gilt-hairline" or "gilt-faint")
    c.name:SetValue(e.name)
    c.name:SetColor(e.collected and "ink" or "ink-muted")
    c.check:ClearAllPoints()
    c.check:SetPoint("LEFT", c.name, "LEFT", math.min(c.name:GetUnboundedStringWidth(), c.name:GetWidth() or 0) + 4, 0)
    c.check:SetShown(e.collected)
    c.use:SetValue(toyUse(e.itemID) or "")
    c.use:SetColor(e.collected and "ink-muted" or "ink-faint")
    c.star.on = e.favourite and true or false
    c.star:Draw(false)
    self:DrawCardState(c)
    self:DrawCardCooldown(c)
    -- the secure part: out of combat only
    if InCombatLockdown() then
        self.shelfAfterCombat = true
    elseif e.collected then
        c.act:SetAttribute("type", "toy")
        c.act:SetAttribute("toy", e.itemID)
    else
        c.act:SetAttribute("type", nil)
    end
end

function M:BuildShelf()
    local body = self.window.body
    local shelf = CreateFrame("Frame", nil, body)
    shelf:SetAllPoints()
    shelf:Hide()
    self.shelf = shelf
    local BAR = S["space-3"]
    shelf.list = UI.ScrollArea(shelf, BAR)
    shelf.list:SetPoint("TOPLEFT", 0, -(TOOLS_H + S["space-5"]))
    shelf.list:SetPoint("BOTTOMRIGHT", -(BAR + 3), 0)
    shelf.list:HookScript("OnSizeChanged", function(sc, w) sc.child:SetWidth(w); self:LayoutShelf() end)
    shelf.cards = {}
    shelf.empty = UI.Text(shelf.list.child, "body", "ink-muted")
    shelf.empty:SetPoint("TOP", 0, -S["space-7"])
    shelf.empty:SetValue("No toys match.")
end

function M:LayoutShelf()
    local shelf = self.shelf
    -- (the cards hold secure buttons: laid out out of combat only)
    if InCombatLockdown() then self.shelfAfterCombat = true return end
    local w = shelf.list.child:GetWidth()
    if not w or isSecret(w) or w <= 0 then return end
    local gap = S["space-4"]
    local cw = (w - (SHELF_COLS - 1) * gap) / SHELF_COLS
    for i, c in ipairs(shelf.cards) do
        local col, row = (i - 1) % SHELF_COLS, math.floor((i - 1) / SHELF_COLS)
        c:ClearAllPoints()
        c:SetWidth(cw)
        c:SetPoint("TOPLEFT", col * (cw + gap), -row * (CARD_H + gap))
    end
end

function M:DrawShelf()
    local shelf, list = self.shelf, self.entries or {}
    -- in a fight the cards keep their places (they hold secure buttons):
    -- only what they show changes; new cards and the layout after it
    local combat = InCombatLockdown()
    if combat then
        if #list > #shelf.cards then self.shelfAfterCombat = true end
    else
        for i = #shelf.cards + 1, #list do shelf.cards[i] = buildToyCard(shelf.list.child, self, i) end
    end
    for i, c in ipairs(shelf.cards) do
        c.entry = list[i]
        self:DrawCard_Toy(c)
    end
    self:LayoutShelf()
    if not combat then
        local rows = math.ceil(#list / SHELF_COLS)
        shelf.list.child:SetHeight(math.max(1, rows * CARD_H + math.max(0, rows - 1) * S["space-4"]))
    end
    shelf.empty:SetShown(#list == 0)
end

function M:DrawShelfCooldowns()
    if not (self.shelf and self.shelf:IsShown()) then return end
    for _, c in ipairs(self.shelf.cards) do if c:IsShown() then self:DrawCardCooldown(c) end end
end

function M:ToggleToyFavourite(e: Entry?)
    if not (e and e.collected) then return end
    call(C_ToyBox.SetIsFavorite, e.itemID, not e.favourite)
    after(0.1, function() self:Refresh() end)
end

-- The tab's layout: Toys the shelf with the tools on top; the others the
-- stage, the tools above the strip.
function M:LayoutTab()
    local toys = self.tab == "toys"
    local tools = self.tools
    -- (the shelf and the stage hold secure buttons: shown or hidden out of
    -- combat only, and only when it changes: the game refuses even an
    -- unchanged SetShown in a fight)
    for _, pair in ipairs({ { self.shelf, toys }, { self.stage, not toys }, { self.strip, not toys } }) do
        local f, on = pair[1], pair[2]
        if f:IsShown() ~= on then
            if InCombatLockdown() then self.layoutAfterCombat = true else f:SetShown(on) end
        end
    end
    tools:ClearAllPoints()
    if toys then
        tools:SetPoint("TOPLEFT", self.window.body, "TOPLEFT")
        tools:SetPoint("TOPRIGHT", self.window.body, "TOPRIGHT")
    else
        tools:SetPoint("BOTTOMLEFT", self.strip, "TOPLEFT", 0, S["space-5"])
        tools:SetPoint("BOTTOMRIGHT", self.strip, "TOPRIGHT", 0, S["space-5"])
    end
    if toys and not InCombatLockdown() then self.act:Hide() end
end
