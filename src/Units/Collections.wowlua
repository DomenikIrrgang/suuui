-- Units/Collections.wowlua
-- SuuUI's own collections window (plan 3.6; asked 2026-10-16: our own
-- window instead of the restyle; design: direction A, "Stage", on the board
-- "Collections · own window"). The game's journal stays closed. Probed
-- (/suu probe collown, colltiles): every mount, toy and appearance can be
-- read, the ones you lack too; SuuUI draws the models itself (a ModelScene
-- fitted to the stage by the game (a PlayerModel), DressUpModels framed by the appearance
-- cameras); summoning and toys go through SuuUI's own secure buttons.
-- Where something comes from is SuuUI's generated data
-- (SuuUI.CollectionSources(): the game gives no source for mounts, only the
-- kind for appearances, and won't list the toys you lack).
-- Gifts: a mount, toy or pet bought or given comes wrapped (the game's
-- fanfare); it shows as the game's gift until opened the game's way, the
-- wrapped present on the stage or the toy's card unwrapping (asked
-- 2026-11-05: the look and the opening as the game's, counts on the tabs and
-- the micro menu, a notification when one arrives, pets ready for a tab).
-- Pets (asked 2026-11-06: Forever has companion pets): a tab as Mounts, from
-- the game's pet journal (C_PetJournal: every pet, yours first), one entry a
-- kind of pet with how many you have, Summon / Dismiss (not protected: no
-- secure button needed), the game's own source text and description on the
-- card, a random favourite, a shift-click links it in chat; gifts as mounts.
-- A built-in module written against the public API only.
--
-- Where it lives (each part a file of its own, the module's methods
-- calling into them under their old names):
--   Collections/Sources   where something comes from: SuuUI's generated
--                         sources, a source as a line or a card
--   Collections/Catalog   the entries and the lists from the game's
--                         journals; what is wrapped; the search and filters
--   Collections/Actions   Summon / Dismiss and Use (the secure buttons), the
--                         pets' actions, the star, picking up for a bar
--   Collections/Stage     the stage: the model, its card, turn and zoom
--   Collections/Gifts     the wrapped present, unwrapping, the gift counts
--   Collections/Strip     the strip's cells, paging, the tools above it
--   Collections/Wardrobe  Appearances: the doll, the slots, the tiles
--   Collections/Shelf     Toys: the cards on the shelf
-- This file: the module, its window (built, laid out per tab, its secure
-- tabs, toggle and keys), what the strip shows, the foot, what SuuUI keeps
-- per character, and the game's news.

import SuuUI, Module from "/Core/API"
import type WindowFrame, SuuButton, Text from "/Core/API"
import type CollectionSource from "/Data/CollectionSources"
import hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import type CardSection from "./Collections/Sources"
import sourceLine, sourceCard, itemName, onSourcesReady from "./Collections/Sources"
import type Entry, WeaponKind, SlotCount from "./Collections/Catalog"
import filterEntries, day from "./Collections/Catalog"
import * as catalogPart from "./Collections/Catalog"
import SecureAction from "./Collections/Actions"
import * as actionsPart from "./Collections/Actions"
import Stage, MountModel, StageCard, MODEL_W, MODEL_H, CAM_SCALE from "./Collections/Stage"
import * as stagePart from "./Collections/Stage"
import * as giftsPart from "./Collections/Gifts"
import Strip, Tools from "./Collections/Strip"
import type Cell from "./Collections/Strip"
import * as stripPart from "./Collections/Strip"
import Wardrobe from "./Collections/Wardrobe"
import type SlotButton, Tile from "./Collections/Wardrobe"
import * as wardrobePart from "./Collections/Wardrobe"
import Shelf from "./Collections/Shelf"
import type ToyCard from "./Collections/Shelf"
import * as shelfPart from "./Collections/Shelf"

local COLLECTIONS = SuuUI.Services.COLLECTIONS

-- A secure handler frame (SecureHandler*Template): SetFrameRef from its template.
type FrameRefs = { SetFrameRef: (self: Frame, id: string, frame: Region) -> () }

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space
local try, field = errors.try, tbl.field
local asNumber, asString, flag = secret.asNumber, secret.asString, secret.flag

local M: CollectionsModule

-- The sources built (Collections/Sources): the window drawn again.
onSourcesReady(function()
    if M and M:IsEnabled() then
        M:Refresh()
    end
end)

-- (still exported here: they moved to Collections/Catalog and Actions)
export local GIFT_ICON = catalogPart.GIFT_ICON
export local wrapped = catalogPart.wrapped
export local clearWrapped = catalogPart.clearWrapped
export type GiftCounts = catalogPart.GiftCounts
export local giftCounts = catalogPart.giftCounts
export local petSourceLines = catalogPart.petSourceLines
export local petActionLabel = actionsPart.petActionLabel

-- What SuuUI keeps per character: the day it first saw each of yours (by
-- kind: `first` the first look), the last collected.
type Seen = { [number]: number, first: number }
type CharStore = { learned?: { [string]: Seen }, last?: { name: string, at: number } }

--------------------------------------------------------------------------------
-- The window (design CollectionsWindow, direction A "Stage"): the stage on
-- top, the strip's tools, the strip; the overview in the foot.
--------------------------------------------------------------------------------

local WIDTH, HEIGHT = 960, 700

-- The window's parts, built once.
type Parts = {
    window: WindowFrame,
    strip: Strip,
    tools: Tools,
    stage: Stage,
    model: MountModel,
    -- the wrapped present over the model while the mount is a gift
    gift: ModelScene,
    card: StageCard,
    act: SecureAction,
    -- Pets: a random favourite summoned
    random: SuuButton,
    wardrobe: Wardrobe,
    shelf: Shelf,
    foot: Text,
    last: Text,
}

--------------------------------------------------------------------------------
-- The module
--------------------------------------------------------------------------------

export class CollectionsModule extends Module<{}>
    ui: Parts? = nil
    tab: string = "mounts"
    slot: string = "CHESTSLOT"
    -- the strip: its entries (and all of the tab's), the page, the chosen one
    entries: Entry[] = {}
    all: Entry[] = {}
    page: number = 1
    pages: number = 1
    chosen: Entry? = nil
    -- the mount on the stage: shown, waited for, the camera's distance
    showing: number? = nil
    waiting: number? = nil
    camScale: number = CAM_SCALE
    -- Appearances: the weapon kinds chosen and offered, the slots' counts,
    -- what is tried on, the doll's zoom, the title
    weaponKind: { [string]: number } = {}
    kinds: WeaponKind[] = {}
    slotCounts: { [string]: SlotCount }? = nil
    tried: number? = nil
    dollScale: number = 1
    slotTitle: string = ""
    -- names the game hasn't sent yet
    namesPending: boolean = false
    -- pets: the journal's filters opened this session; a list update queued
    petListOpen: boolean = false
    -- a mount's model scene, for a gift whose own scene has no present
    mountScene: number? = nil
    -- the present's fit in each scene (scale, position), once it settled;
    -- the present being settled now
    presentFits: { [number]: { number } } = {}
    presentToken: number = 0
    -- the present being placed; the scale it was given and its scene (a
    -- scene resetting it is seen by the change)
    presentSettling: boolean = false
    presentK: number? = nil
    presentScene: number? = nil
    petRefreshQueued: boolean = false
    namesTimer: TimerHandle? = nil
    -- what waits for the end of combat
    bindAfterCombat: boolean = false
    actionAfterCombat: boolean = false
    shelfAfterCombat: boolean = false
    layoutAfterCombat: boolean = false
    -- where the tools stand: over the shelf (Toys) or the strip (nil: not yet)
    toolsFor: boolean? = nil
    bindOwner: Frame? = nil
    toggleButton: Button? = nil
    closeOverlay: Button? = nil
    journalHooked: boolean = false
    ticker: TickerHandle? = nil
    -- the gift being unwrapped (its animation runs 3 seconds)
    unwrapping: Entry? = nil

    constructor()
        super({
            id = "collections",
            name = "Collections",
            description = "SuuUI's collections window: mounts, toys and appearances on a model stage, what you lack and where to get it.",
            api = "0.17",
            reloadToToggle = true,
            defaults = {},
        })
    end

    function SourceLine(src: CollectionSource?, kind: string, number: number?): string
        return sourceLine(src, kind, number)
    end
    function SourceCard(src: CollectionSource?, kind: string, number: number?): CardSection[]
        return sourceCard(src, kind, number)
    end

    -- What SuuUI keeps for this character.
    function Saved(): CharStore
        return self:CharData() :: unknown :: CharStore
    end

    ----------------------------------------------------------------------------
    -- What there is
    ----------------------------------------------------------------------------

    -- (Collections/Catalog)
    function Mounts(): Entry[]
        return catalogPart.mountEntries(self)
    end
    function OpenPetList()
        catalogPart.openPetList(self)
    end
    function Pets(): Entry[]
        return catalogPart.petEntries(self)
    end
    function MountScene(): number?
        return catalogPart.mountScene(self)
    end
    -- (Collections/Actions)
    function LinkPet(e: Entry)
        actionsPart.linkPet(e)
    end
    function PetAction()
        actionsPart.petAction(self)
    end
    function RandomPet()
        actionsPart.randomPet()
    end
    -- (Collections/Catalog)
    function Toys(): Entry[]
        return catalogPart.toyEntries(self)
    end
    function WeaponKinds(hand: string?): WeaponKind[]
        return catalogPart.weaponKinds(hand)
    end
    function SlotCounts(className: string?): { [string]: SlotCount }
        return catalogPart.slotCounts(self, className)
    end
    function Worn(slot: string): number?
        return catalogPart.wornVisual(slot)
    end
    function Appearances(category: number, slot: string?): Entry[]
        return catalogPart.appearanceEntries(self, category, slot)
    end

    ----------------------------------------------------------------------------
    -- Recently collected: the game keeps no dates, so SuuUI notes the day it
    -- first sees something yours (what you had before SuuUI: 0, "Before SuuUI")
    ----------------------------------------------------------------------------

    function Learned(kind: string, id: number, collected: boolean?): number?
        if not collected then
            return nil
        end
        local d = self:Saved()
        local learned = d.learned or {}
        d.learned = learned
        local seen: Seen? = learned[kind]
        if not seen then
            -- the first look at this kind: everything yours is from before SuuUI
            seen = { first = time() }
            learned[kind] = seen
        end
        local at = seen[id]
        if at == nil then
            at = (time() - seen.first < 5) and 0 or time()
            seen[id] = at
        end
        return at
    end

    -- what you collected last (any kind), for the foot
    function NoteLast(name: string?, at: number?)
        if not (name and at and at > 0) then
            return
        end
        local d = self:Saved()
        local last = d.last
        if not last or (last.at or 0) < at then
            d.last = { name = name, at = at }
        end
    end

    ----------------------------------------------------------------------------
    -- Building it
    ----------------------------------------------------------------------------

    function Build(): Parts
        local w = UI.WindowFrame(SuuUI.Root, {
            name = "SuuUICollectionsWindow",
            title = "Collections",
            -- (it holds secure buttons: Escape through the game's secure code)
            secure = true,
            width = WIDTH,
            height = HEIGHT,
            footer = true,
            onClose = function(win: Frame)
                win:Hide()
            end,
            tabs = {
                { key = "mounts", label = "Mounts" },
                { key = "pets", label = "Pets", disabled = C_PetJournal == nil, reason = "No pets on this client" },
                { key = "toys", label = "Toys" },
                { key = "heirlooms", label = "Heirlooms", disabled = true, reason = "No heirlooms on Forever yet" },
                { key = "wardrobe", label = "Appearances" },
            },
            onTab = function(key: string)
                if key ~= self.tab then
                    self.chosen, self.page = nil, 1
                end
                self.tab = key
                local ui = self.ui
                local first = ui and ui.tools.list.buttons[1]
                if first then
                    first.label:SetValue(
                        key == "toys" and "Toys" or key == "wardrobe" and "All" or key == "pets" and "Pets" or "Mounts"
                    )
                end
                self:Refresh()
            end,
        })
        w:SetPoint("CENTER", UIParent, "CENTER", 0, 30)
        w:Hide()
        w.scroll:Hide()
        -- on opening the frames aren't laid out yet when the first mount loads,
        -- so its camera read wrong (seen in game: wrong on opening, right after
        -- choosing another and back): shown once more a frame later
        w:HookScript("OnShow", function()
            self:Refresh()
            self:UpdateGifts()
            self:After(0, function()
                self.showing = nil
                self:Refresh()
            end)
        end)
        local body = w.body
        -- the strip at the foot of the body, its tools above it, the stage on top
        local strip = Strip.new(body, self)
        local tools = Tools.new(body, strip, self)
        local stage = Stage.new(body, tools, self)
        local model = MountModel.new(stage, self)
        -- the game's wrapped present: a click unwraps it
        local gift = CreateFrame("ModelScene", nil, stage, "WrappedModelSceneTemplate") :: ModelScene
        gift:SetSize(MODEL_W, MODEL_H)
        gift:SetPoint("CENTER", model, "CENTER")
        gift:SetFrameLevel(stage:GetFrameLevel() + 3)
        gift:EnableMouse(true)
        gift:HookScript("OnMouseUp", function()
            self:Unwrap()
        end)
        -- (the scene loaded late resets the box: placed again)
        gift:HookScript("OnUpdate", function()
            self:WatchPresent()
        end)
        gift:Hide()
        local card = StageCard.new(stage)
        -- Summon / Dismiss: SuuUI's own secure button; the look is a SuuUI button under it
        local act = SecureAction.new("SuuUICollectionsAction", stage, "Summon", 120, "primary")
        act:SetSize(120, 30)
        act:SetPoint("TOPRIGHT", -S["space-6"], -S["space-6"])
        act:SetFrameLevel(stage:GetFrameLevel() + 12)
        -- a gift: Unwrap (its secure action left out)
        act:HookScript("PostClick", function(_: Frame, _button: string, down: boolean?)
            local e = self.chosen
            if down or not e then
                return
            end
            if e.kind == "pet" then
                self:PetAction()
            elseif e.wrapped then
                self:Unwrap()
            end
        end)
        stage.star:SetPoint("RIGHT", act, "LEFT", -S["space-4"], 0)
        -- Pets: a random favourite (not protected: a plain button)
        local random = UI.Button(stage, {
            text = "Random favourite",
            tooltip = { title = "Random favourite", description = "Summon one of your favourite pets at random." },
            onClick = function()
                self:RandomPet()
            end,
        })
        random:SetPoint("TOPRIGHT", act, "BOTTOMRIGHT", 0, -S["space-3"])
        random:SetFrameLevel(stage:GetFrameLevel() + 12)
        random:Hide()
        local wardrobe = Wardrobe.new(stage, self)
        local shelf = Shelf.new(body, self)
        -- the foot: the overview
        local footer = assert(w.footer)
        local foot = UI.Text(footer, "caption", "ink-muted")
        foot:SetPoint("LEFT")
        local last = UI.Text(footer, "caption", "ink-muted")
        last:SetPoint("RIGHT")
        local ui: Parts = {
            window = w,
            strip = strip,
            tools = tools,
            stage = stage,
            model = model,
            gift = gift,
            card = card,
            act = act,
            random = random,
            wardrobe = wardrobe,
            shelf = shelf,
            foot = foot,
            last = last,
        }
        self.ui = ui
        return ui
    end

    -- The window, when built.
    function Window(): WindowFrame?
        local ui = self.ui
        return ui and ui.window
    end

    function Shown(): boolean
        local ui = self.ui
        return ui ~= nil and ui.window:IsShown()
    end

    ----------------------------------------------------------------------------
    -- What the strip shows
    ----------------------------------------------------------------------------

    function Entries(): (Entry[], Entry[])
        local all: Entry[]
        if self.tab == "wardrobe" then
            all = self:WardrobeEntries()
        elseif self.tab == "toys" then
            all = self:Toys()
        elseif self.tab == "pets" then
            all = self:Pets()
        else
            all = self:Mounts()
        end
        local ui = self.ui
        if not ui then
            return all, all
        end
        local tools = ui.tools
        local search = (tools.search.edit:GetText() or ""):lower()
        return filterEntries(all, search, tools.have.value or "all", tools.list.value or "all"), all
    end

    -- (Collections/Strip)
    function LayoutCells()
        stripPart.layoutCells(self)
    end
    function Page(step: number)
        stripPart.page(self, step)
    end
    function DrawCell(b: Cell)
        stripPart.drawCell(self, b)
    end
    function DrawStrip()
        stripPart.drawStrip(self)
    end

    function Refresh()
        local ui = self.ui
        if not (ui and ui.window:IsShown()) then
            return
        end
        local entries, all = self:Entries()
        self.entries, self.all = entries, all
        local have = 0
        for _, e in ipairs(all) do
            if e.collected then
                have = have + 1
            end
        end
        local tools = ui.tools
        local titled = self.tab == "wardrobe"
        tools.title:SetShown(titled)
        tools.title:SetValue(titled and self.slotTitle or "")
        tools.search:ClearAllPoints()
        tools.search:SetPoint("LEFT", titled and (tools.title:GetUnboundedStringWidth() + S["space-5"]) or 0, 0)
        tools.count:SetValue(("%d |cff%sof %d|r"):format(have, T.color["ink-muted"].hex, #all))
        tools.fill:SetWidth(math.max(1, 60 * (#all > 0 and have / #all or 0)))
        self:LayoutTab()
        if self.tab == "toys" then
            self:DrawShelf()
            self:DrawFoot()
            return
        end
        -- the chosen one stays while it is listed; else the first (also with
        -- none of your own: asked in game, the stage is never empty then)
        local still = false
        local chosen = self.chosen
        for _, e in ipairs(entries) do
            if chosen and e.id == chosen.id then
                self.chosen = e
                still = true
            end
        end
        if not still then
            self.chosen = entries[1]
        end
        self:DrawStrip()
        self:DrawStage()
        self:DrawFoot()
    end

    function Choose(e: Entry?)
        if not e then
            return
        end
        self.chosen = e
        self:DrawStrip()
        self:DrawStage()
    end

    ----------------------------------------------------------------------------
    -- The stage
    ----------------------------------------------------------------------------

    -- (Collections/Stage)
    function DrawStage()
        stagePart.drawStage(self)
    end
    -- (Collections/Gifts)
    function ShowGift(e: Entry)
        giftsPart.showGift(self, e)
    end
    function WatchPresent()
        giftsPart.watchPresent(self)
    end
    function SettlePresent(token: number, scene: number?, tries: number)
        giftsPart.settlePresent(self, token, scene, tries)
    end
    function PlacePresent()
        giftsPart.placePresent(self)
    end
    function Unwrap(given: Entry?)
        giftsPart.unwrap(self, given)
    end
    function UnwrapToy(c: ToyCard)
        giftsPart.unwrapToy(self, c)
    end
    function GiftCount(): number
        return giftsPart.giftCount()
    end
    function UpdateGifts()
        giftsPart.updateGifts(self)
    end
    function GiftArrived(kind: string, id: number, name: string?)
        giftsPart.giftArrived(self, kind, id, name)
    end
    function ShowGiftIn(tab: string, id: number)
        giftsPart.showGiftIn(self, tab, id)
    end

    -- The toys' cooldowns on the shelf: again every second while it shows
    -- (the time counts down) and when the game says a cooldown changed.
    function DrawCooldowns()
        if self.tab == "toys" then
            self:DrawShelfCooldowns()
        end
    end

    -- (Collections/Stage)
    function ShowMount(e: Entry)
        stagePart.showMount(self, e)
    end
    function PlaceModel()
        stagePart.placeModel(self)
    end
    function ModelLoaded()
        stagePart.modelLoaded(self)
    end
    function Turn(dir: number)
        stagePart.turn(self, dir)
    end
    function Zoom(dir: number)
        stagePart.zoom(self, dir)
    end
    -- (Collections/Actions)
    function ToggleFavourite()
        actionsPart.toggleFavourite(self)
    end
    function MountIndex(id: number): number?
        return actionsPart.mountIndex(id)
    end
    function Pickup(e: Entry?)
        actionsPart.pickup(self, e)
    end
    function DrawAction()
        actionsPart.drawAction(self)
    end

    function DrawFoot()
        local ui = self.ui
        if not ui then
            return
        end
        local muted, ink = "|cff" .. T.color["ink-muted"].hex, T.color["ink"].hex
        local parts: string[] = {}
        local kinds: { label: string, entries: Entry[] }[] = {
            { label = "Mounts", entries = self:Mounts() },
            { label = "Pets", entries = self:Pets() },
            { label = "Toys", entries = self:Toys() },
        }
        for _, kind in ipairs(kinds) do
            local have = 0
            for _, e in ipairs(kind.entries) do
                if e.collected then
                    have = have + 1
                end
            end
            parts[#parts + 1] = ("%s |cff%s%d|r%s of %d|r"):format(kind.label, ink, have, muted, #kind.entries)
        end
        ui.foot:SetValue(table.concat(parts, "  ·  "))
        local last = self:Saved().last
        ui.last:SetValue(
            last and ("Last collected: |cff%s%s|r, %s"):format(T.color["ink"].hex, last.name, day(last.at) or "") or
                "Nothing collected yet"
        )
    end

    ----------------------------------------------------------------------------
    -- Opening it: the micro menu (SuuUI.ToggleCollections), the game's
    -- Collections key (an override binding onto SuuUI's button), and the game's
    -- journal when something else opens it (closed again, ours instead)
    ----------------------------------------------------------------------------

    function Toggle(tab: string?)
        local w = self:Window()
        if not w then
            return
        end
        if w:IsShown() and not tab then
            w:Hide()
            return
        end
        w:Show()
        w:SetTab(tab or self.tab)
    end

    function BindKeys()
        local owner = self.bindOwner
        if not owner then
            return
        end
        if InCombatLockdown() then
            self.bindAfterCombat = true
            return
        end
        ClearOverrideBindings(owner)
        for _, key in ipairs({ GetBindingKey("TOGGLECOLLECTIONS") }) do
            if key then
                SetOverrideBindingClick(owner, false, key, "SuuUICollectionsToggle")
            end
        end
    end

    function HookJournal()
        local f = frames.find("CollectionsJournal")
        if not f or self.journalHooked then
            return
        end
        self.journalHooked = true
        hookScript(f, "OnShow", function()
            if not self:IsEnabled() or InCombatLockdown() then
                return
            end
            HideUIPanel(f)
            self:Toggle("mounts")
        end)
    end

    ----------------------------------------------------------------------------
    -- Appearances
    ----------------------------------------------------------------------------

    -- (Collections/Wardrobe)
    function DrawSlot(b: SlotButton)
        wardrobePart.drawSlot(self, b)
    end
    function DrawTileState(b: Tile)
        wardrobePart.drawTileState(self, b)
    end
    function DrawTile(b: Tile)
        wardrobePart.drawTile(self, b)
    end
    function LayoutTiles()
        wardrobePart.layoutTiles(self)
    end
    function WardrobeEntries(): Entry[]
        return wardrobePart.wardrobeEntries(self)
    end
    function DrawWardrobe()
        wardrobePart.drawWardrobe(self)
    end

    ----------------------------------------------------------------------------
    -- Toys
    ----------------------------------------------------------------------------

    -- (Collections/Shelf)
    function DrawToyCard(c: ToyCard)
        shelfPart.drawToyCard(self, c)
    end
    function LayoutShelf()
        shelfPart.layoutShelf(self)
    end
    function DrawShelf()
        shelfPart.drawShelf(self)
    end
    function DrawShelfCooldowns()
        shelfPart.drawShelfCooldowns(self)
    end
    function ToggleToyFavourite(e: Entry?)
        shelfPart.toggleToyFavourite(self, e)
    end

    -- The tab's layout: Toys the shelf with the tools on top; the others the
    -- stage, the tools above the strip.
    -- The tabs in a fight: Toys' shelf and the others' stage hold secure
    -- buttons, so SuuUI's code can't swap them then and the tab changed while
    -- the page stayed (found in game: Pets to Toys in a fight). A secure
    -- button over each tab swaps them through the game's secure code, in a
    -- fight too; then the tab is chosen as before (its layout finds the page
    -- already right; the tools follow once the fight is over). Hover goes on
    -- to the tab.
    secureTabs: { [string]: Button } = {}

    function SecureTabs()
        local ui = self.ui
        local window = ui and ui.window
        if not (ui and window and window.tabButtons) then
            return
        end
        for _, tab in ipairs(window.tabButtons or {}) do
            local key = tab.key
            if not tab:IsOff() and not self.secureTabs[key] then
                local o = CreateFrame("Button", nil, tab, "SecureHandlerClickTemplate") :: Button & FrameRefs
                o:SetAllPoints(tab)
                o:SetFrameLevel(tab:GetFrameLevel() + 3)
                o:SetFrameRef("shelf", ui.shelf)
                o:SetFrameRef("stage", ui.stage)
                o:SetFrameRef("strip", ui.strip)
                o:SetAttribute("toys", key == "toys")
                -- (the strip too when the game counts it protected, in game it
                -- stayed over Toys in a fight; else the layout shows it at once.
                -- The tools move as before, after a fight: moved from here they
                -- lost their anchors in game)
                -- (each only while the game counts it protected: Toys' shelf
                -- has no secure button till Toys was opened, and touching an
                -- unprotected frame from here in a fight is an error, found
                -- in game; the layout shows those at once instead)
                o:SetAttribute("_onclick", [=[
                    local toys = self:GetAttribute("toys")
                    local shelf, stage, strip = self:GetFrameRef("shelf"), self:GetFrameRef("stage"), self:GetFrameRef("strip")
                    if shelf:IsProtected() then
                        if toys then shelf:Show() else shelf:Hide() end
                    end
                    if stage:IsProtected() then
                        if toys then stage:Hide() else stage:Show() end
                    end
                    if strip:IsProtected() then
                        if toys then strip:Hide() else strip:Show() end
                    end
                ]=])
                o:HookScript("PostClick", function()
                    window:SetTab(key)
                end)
                o:SetScript("OnEnter", function(_: Frame, motion: boolean)
                    local fn = tab:GetScript("OnEnter")
                    if fn then
                        fn(tab, motion)
                    end
                end)
                o:SetScript("OnLeave", function(_: Frame, motion: boolean)
                    local fn = tab:GetScript("OnLeave")
                    if fn then
                        fn(tab, motion)
                    end
                end)
                self.secureTabs[key] = o
            end
        end
    end

    function LayoutTab()
        local ui = self.ui
        if not ui then
            return
        end
        local toys = self.tab == "toys"
        local tools = ui.tools
        -- (the shelf and the stage hold secure buttons: shown or hidden out of
        -- combat only, and only when it changes: the game refuses even an
        -- unchanged SetShown in a fight)
        local shown: { f: Frame, on: boolean }[] = {
            { f = ui.shelf, on = toys },
            { f = ui.stage, on = not toys },
            { f = ui.strip, on = not toys },
        }
        for _, pair in ipairs(shown) do
            if pair.f:IsShown() ~= pair.on then
                -- (one without secure buttons, the strip: at once, in a fight too)
                if InCombatLockdown() and pair.f:IsProtected() then
                    self.layoutAfterCombat = true
                else
                    pair.f:SetShown(pair.on)
                end
            end
        end
        -- the tools too (secure buttons hang on them: moved out of combat
        -- only, and only when their place changes; found in game: opened in
        -- a fight, the game refused)
        if self.toolsFor ~= toys then
            if InCombatLockdown() then
                self.layoutAfterCombat = true
                -- (out of their place till the fight ends: unseen, rather than
                -- over the shelf or the stage, found in game)
                tools:SetAlpha(0)
            else
                self.toolsFor = toys
                tools:ClearAllPoints()
                if toys then
                    tools:SetPoint("TOPLEFT", ui.window.body, "TOPLEFT")
                    tools:SetPoint("TOPRIGHT", ui.window.body, "TOPRIGHT")
                else
                    tools:SetPoint("BOTTOMLEFT", ui.strip, "TOPLEFT", 0, S["space-5"])
                    tools:SetPoint("BOTTOMRIGHT", ui.strip, "TOPRIGHT", 0, S["space-5"])
                end
            end
        end
        -- (seen again once in their place)
        if self.toolsFor == toys then
            tools:SetAlpha(1)
        end
        if toys and not InCombatLockdown() then
            ui.act:Hide()
        end
    end

    ----------------------------------------------------------------------------
    -- Lifecycle
    ----------------------------------------------------------------------------

    override function OnEnable()
        local ui = self.ui or self:Build()
        local window = ui.window
        if not self.toggleButton then
            -- the key shows and hides the window through the game's secure code:
            -- the window holds secure buttons, so it is protected, and SuuUI's
            -- own code can't show it in a fight (found in tests: nothing opened)
            local b = CreateFrame("Button", "SuuUICollectionsToggle", UIParent, "SecureHandlerClickTemplate") :: Button
                & FrameRefs
            b:SetFrameRef("window", window)
            b:SetAttribute("_onclick", [=[
                local w = self:GetFrameRef("window")
                if w:IsShown() then w:Hide() else w:Show() end
            ]=])
            self.toggleButton = b
            -- its close button too: a secure one over it (passing the hover on
            -- to the button under it)
            local close = window.close
            if close then
                local o = CreateFrame("Button", nil, close, "SecureHandlerClickTemplate") :: Button & FrameRefs
                o:SetAllPoints(close)
                o:SetFrameRef("window", window)
                o:SetAttribute("_onclick", [=[ self:GetFrameRef("window"):Hide() ]=])
                o:SetScript("OnEnter", function(_: Frame, motion: boolean)
                    local fn = close:GetScript("OnEnter")
                    if fn then
                        fn(close, motion)
                    end
                end)
                o:SetScript("OnLeave", function(_: Frame, motion: boolean)
                    local fn = close:GetScript("OnLeave")
                    if fn then
                        fn(close, motion)
                    end
                end)
                self.closeOverlay = o
            end
            self.bindOwner = CreateFrame("Frame")
            self:SecureTabs()
            -- (the tab chosen before the first open, which may be in a fight)
            window:SetTab(self.tab)
        end
        -- (after its toggle: the micro menu clicks it)
        self:ProvideService(COLLECTIONS, {
            Toggle = function(tab: string?)
                self:Toggle(tab)
            end,
            IsShown = function(): boolean
                return self:Shown()
            end,
        })
        self:BindKeys()
        self:OnGameEvent("UPDATE_BINDINGS", function()
            self:BindKeys()
        end)
        -- the counts carry colour codes: drawn again in the new colours
        self:On("SUUUI_THEME_CHANGED", function()
            self:Refresh()
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            if self.bindAfterCombat then
                self.bindAfterCombat = false
                self:BindKeys()
            end
            if self.actionAfterCombat then
                self.actionAfterCombat = false
                self:DrawAction()
            end
            if self.shelfAfterCombat then
                self.shelfAfterCombat = false
                if self.tab == "toys" then
                    self:Refresh()
                end
            end
            if self.layoutAfterCombat then
                self.layoutAfterCombat = false
                self:LayoutTab()
            end
        end)
        self:OnGameEvent("PLAYER_MOUNT_DISPLAY_CHANGED", function()
            self:DrawAction()
        end)
        self:OnGameEvent("COMPANION_UPDATE", function()
            -- (a pet summoned or dismissed: the action says it)
            if self.tab == "pets" and self:Shown() then
                self:Refresh()
            else
                self:DrawAction()
            end
        end)
        -- pets: a new one (noted, a gift said), the journal's list changed
        self:OnGameEvent("NEW_PET_ADDED", function(_, guid)
            local g = asString(guid)
            local species, _, _, _, _, _, _, nameR = try(field(C_PetJournal, "GetPetInfoByPetID"), g)
            local name = asString(nameR)
            self:NoteLast(name, time())
            if self:Shown() then
                self:Refresh()
            end
            local id = asNumber(species)
            if g and id and wrapped("pet", g) then
                self:GiftArrived("pet", id, name)
            end
        end)
        self:OnGameEvent("PET_JOURNAL_LIST_UPDATE", function()
            if self.tab == "pets" and self:Shown() and not self.petRefreshQueued then
                self.petRefreshQueued = true
                self:After(0.1, function()
                    self.petRefreshQueued = false
                    self:Refresh()
                end)
            end
        end)
        -- something new: noted with today's date, the window redrawn
        self:OnGameEvent("NEW_MOUNT_ADDED", function(_, id)
            local name = id and asString(try(field(C_MountJournal, "GetMountInfoByID"), id))
            self:NoteLast(name, time())
            self:Refresh()
            local mountID = asNumber(id)
            if mountID and wrapped("mount", mountID) then
                self:GiftArrived("mount", mountID, name)
            end
        end)
        self:OnGameEvent("MOUNT_JOURNAL_USABILITY_CHANGED", function()
            self:DrawAction()
        end)
        -- toys: new ones, their cooldowns, their names as the game sends them
        self:OnGameEvent("NEW_TOY_ADDED", function(_, itemID)
            local _, name = try(field(C_ToyBox, "GetToyInfo"), itemID)
            self:NoteLast(asString(name), time())
            self:Refresh()
        end)
        -- (a toy arriving wrapped says so here: its item, new, fanfare)
        self:OnGameEvent("TOYS_UPDATED", function(_, itemID, _new, fanfare)
            if self:Shown() then
                self:Refresh()
            end
            local id = asNumber(itemID)
            if id and flag(fanfare) then
                local _, name = try(field(C_ToyBox, "GetToyInfo"), id)
                self:GiftArrived("toy", id, asString(name) or itemName(id))
            end
        end)
        -- the gifts waiting, on the tabs and the micro menu: once the game has
        -- the journals
        self:OnGameEvent("PLAYER_ENTERING_WORLD", function()
            self:After(1, function()
                self:UpdateGifts()
            end)
        end)
        self:OnGameEvent("SPELL_UPDATE_COOLDOWN", function()
            if self:Shown() then
                self:DrawCooldowns()
            end
        end)
        self:OnGameEvent("BAG_UPDATE_COOLDOWN", function()
            if self:Shown() then
                self:DrawCooldowns()
            end
        end)
        self:OnGameEvent("GET_ITEM_INFO_RECEIVED", function()
            if not (self.namesPending and self:Shown()) then
                return
            end
            self.namesPending = false
            if self.namesTimer then
                return
            end
            self.namesTimer = self:After(0.3, function()
                self.namesTimer = nil
                self:Refresh()
            end)
        end)
        -- appearances: new ones, what you wear
        self:OnGameEvent("TRANSMOG_COLLECTION_UPDATED", function()
            self.slotCounts = nil
            if self.tab == "wardrobe" and self:Shown() then
                self:Refresh()
            end
        end)
        self:OnGameEvent("PLAYER_EQUIPMENT_CHANGED", function()
            ui.wardrobe.doll.dressed = false
            self.tried = nil
            if self.tab == "wardrobe" and self:Shown() then
                self:Refresh()
            end
        end)
        -- (the module's own: turning it off stops it, so each OnEnable starts one)
        self.ticker = self:Every(1, function()
            if self.tab == "toys" and self:Shown() then
                self:DrawCooldowns()
            end
        end)
        self:HookJournal()
        self:OnGameEvent("ADDON_LOADED", function(_, name)
            if name == "Blizzard_Collections" then
                self:HookJournal()
            end
        end)
    end

    override function OnDisable()
        local window = self:Window()
        if window then
            window:Hide()
        end
        local owner = self.bindOwner
        if owner and not InCombatLockdown() then
            ClearOverrideBindings(owner)
        end
    end
end

M = SuuUI.AddModule(CollectionsModule.new())
