-- Units/ChatCommands.wowlua
-- The command palette (design C on the board "Chat command suggestions"):
-- typing a / in the chat input opens a panel over the chat, every command
-- that starts with what you typed, by category (chips: All, Chat, Group,
-- Emotes, SuuUI, Addons), each with its aliases, what it does and where it
-- comes from. A / alone lists them all. After a command and a space it shows
-- what goes there: names for /invite, channels for /join, /suu's commands
-- and /suu probe's topics. Up and Down mark a row, Tab (or a click) puts it
-- into the input, Shift-Tab (or a click) steps to the next category, round
-- the end. (Ctrl-Tab, Ctrl-Left/Right and Option-Tab never reach the game on
-- a Mac; /suu probe chatpalette keys, 2026-10-19.)
-- Enter always sends what you typed: nothing picks on Enter.
--
-- What the client allows (/suu probe chatpalette, 2026-10-19):
--   - writing: SetText on the open, focused input leaves the game's own
--     fields alone and /camp working; opening the input with text
--     (ChatFrameUtil.OpenChat) writes them as SuuUI's, so it is never used.
--     A command goes in without a space after it: a space lets the game's
--     text parsing run (as SuuUI's, inside the write) and turn /p, /g or
--     /w Name into its header, the path that made recall taint the input.
--     After a chat type (/p, /w …) no arguments are offered: the game turns
--     the line into its header there, and its own name list shows for /w.
--   - keys: HookScript("OnKeyDown") and ("OnArrowPressed") on the inputs
--     (the chat's history uses both too), and ChatEdit_CustomTabPressed,
--     the global the game calls through securecall for addons' Tab
--     completion: true from it skips the game's own. While the list shows,
--     Up and Down are the palette's and the chat's recall waits.
--   - a click on the palette takes the focus from the input (it stays open
--     with its text): the palette stays while the pointer is over it and the
--     click gives the focus back (SetFocus, as clicking the input does).
--   - typing hooks waiting for userInput never fire on this client: the
--     text is compared each frame while an input has focus (EventRegistry
--     ChatFrame.OnEditBoxFocusGained / FocusLost).
--   - the commands: SlashCmdList (emptied by the game into a proxy behind
--     its metatable), hash_ChatTypeInfoList (every alias the game has read,
--     secure commands and chat types too), SLASH_<KEY>1…n for the aliases,
--     EMOTE<n>_TOKEN / EMOTE<n>_CMD<m> for the emotes. Who registered one:
--     issecurevariable on its SLASH_<KEY>1 (the game's are secure).
-- The game has no descriptions: SuuUI writes one line for its common
-- commands; others show their aliases only.

import SuuUI from "/Core/API"
import isSecret from "wowlua:secret"
import hookScript from "wowlua:hooks"
-- the matching (what's typed against the catalog) in a module of its own
import * as match from "./ChatCommands/Match"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local M = SuuUI.RegisterModule({
    id = "chatcommands",
    name = "Command palette",
    description = "Typing a / in chat lists the commands that fit, by category, with what they do; Tab puts one in.",
    api = "0.17",
    defaults = {
        suggest = true, -- the palette at all
        args = true,    -- names, channels and topics after a command
        emotes = true,  -- emotes among the commands
        tab = true,     -- Tab and a click put the marked row in (Up and Down mark)
    },
})

-- what plain() lets through: a value that's there and not a secret
type Readable = string | number | boolean | table | (...any) -> ...any
local function plain(v: unknown): v is Readable return v ~= nil and not isSecret(v) end
local function call(fn: any, ...: any): ...any
    if type(fn) ~= "function" then return nil end
    local ok, a, b, c, d, e, f, g, h, i, j, k = pcall(fn, ...)
    if ok then return a, b, c, d, e, f, g, h, i, j, k end
end
type Color = number[] & { hex: string }
local colors: { [string]: any } = T.color
local tint = match.tint

-- A command in the catalog.
type Item = match.Item
-- What a row in the command list shows (a catalog item, or one of /suu's commands).
type Shown = match.Shown
type Match = match.Match
-- A suggestion after a command: a name, a channel.
type Row = { value: string, color?: string, diamond?: boolean, note?: string, right?: string, online?: boolean }
type Group = { title: string, rows: Row[] }
type SubCommand = match.SubCommand
type Query = match.Query
-- A row in the drawn list, in order (Up and Down step through them).
type Entry = { put: string, frame: any, y: number, h: number }

local PAD = S["space-5"]
local ABOVE = 72 -- the palette reaches this far above the chat's box
local CHIP_H, ROW_H, HEAD_H, MORE_H, NONE_H, TOPIC_H, USAGE_H, FOOT_H = 20, 24, 21, 18, 22, 22, 26, 32
local CMD_W, ALIAS_W, NAME_W = 96, 64, 120
local CHIPS_H = S["space-2"] + S["space-2"] + CHIP_H + S["space-3"] -- the chip row and its padding
local TOPIC_COLS = 3

--------------------------------------------------------------------------------
-- The commands
--------------------------------------------------------------------------------

local CATEGORIES, ALL_ORDER, LABEL, NOUN = match.CATEGORIES, match.ALL_ORDER, match.LABEL, match.NOUN

