-- "join" the channels you can join, "leave" the ones you're in); usage: the
-- argument as the usage line shows it.
-- a command: its key, category and what it does; its main slash command,
-- what it takes and how it's written
type InfoEntry = { [number]: string, main?: string, arg?: string, usage?: string }
