-- Units/WorldMap/Filters.wowlua
-- Map filters of the world map (Units/WorldMap): its groups and their
-- options, the saved choice (an earlier layout's carried over, new options
-- on once), the game's own quest settings among them, and the quests to
-- pick up this character hid, listed in it to show again. Offers the
-- defaults and the menu's values, and the module's filter and hidden-quest
-- methods as functions taking the module.

import SuuUI from "/Core/API"
import type MarkFilters, FilterValue, FilterValues, FilterGroup, FilterOption from "/Core/API"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import questName from "/Units/WorldMap/Quests"
import quest from "/Units/WorldMap/Rows"
import groupQuests from "/Units/WorldMap/Tips"
import NO_STARTS from "/Units/WorldMap/Collect"
import type WorldPin from "/Units/WorldMap/Canvas"
import type WorldMapModule from "/Units/WorldMap"

local CONVERGENCES = SuuUI.Services.CONVERGENCES

local UI = SuuUI.UI

-- What Map filters chose: each group's values on.
export type FilterChoice = { [string]: string[] }
-- The saved filters: each group's values (an earlier layout's groups too)
-- and the layout's version.
export type SavedFilters = { v?: number, [string]: string[] | number | nil }
-- Each group's values on, as sets.
export type On = { [string]: boolean }
export type Layers = { quests: On, places: On, services: On, trading: On, trainers: On, rares: On, marks: On, skyborne: On }

-- Map filters' values from the choice, and back (its values: strings).
export function menuValues(f: FilterChoice): FilterValues
    local out: FilterValues = {}
    for k, list in pairs(f) do
        local l: FilterValue[] = {}
        for i, v in ipairs(list) do
            l[i] = v
        end
        out[k] = l
    end
    return out
end
-- The saved filters' groups (their version left out).
export function choiceOf(f: SavedFilters): FilterChoice
    local out: FilterChoice = {}
    for k, list in pairs(f) do
        if type(list) == "table" then
            out[k] = list
        end
    end
    return out
end
export function chosen(v: FilterValues): FilterChoice
    local out: FilterChoice = {}
    for k, c in pairs(v) do
        local l: string[] = {}
        if type(c) == "table" then
            for _, x in ipairs(c) do
                if type(x) == "string" then
                    l[#l + 1] = x
                end
            end
        end
        out[k] = l
    end
    return out
end

--------------------------------------------------------------------------------
-- The filter menu
--------------------------------------------------------------------------------

-- A group of Map filters: its options' values are strings.
type FilterSpec = {
    key: string,
    label: string,
    kind: "one" | "many" | "toggles",
    column?: boolean,
    options: { value: string, label: string, color?: string }[],
}

local GROUPS: FilterSpec[] = {
    {
        key = "quests",
        label = "Quests",
        kind = "toggles",
        options = {
            { value = "objectives", label = "Quest objectives" },
            { value = "levels", label = "Quest levels" },
            { value = "colours", label = "Difficulty colours" },
            { value = "available", label = "Quests to pick up" },
            { value = "repeatable", label = "Repeatable and daily" },
            { value = "items", label = "Quests from items" },
            { value = "trivial", label = "Trivial quests" },
        },
    },
    {
        key = "places",
        label = "Places",
        kind = "toggles",
        options = {
            { value = "unexplored", label = "Unexplored areas" },
            { value = "dungeons", label = "Dungeon and raid entrances" },
            { value = "battlegrounds", label = "Battleground entrances" },
            { value = "flight", label = "Flight masters" },
            { value = "campfires", label = "Campfires you found" },
        },
    },
    {
        key = "services",
        label = "Services",
        kind = "toggles",
        column = true,
        options = {
            { value = "inn", label = "Innkeepers" },
            { value = "repair", label = "Repair" },
            { value = "goods", label = "General goods" },
            { value = "food", label = "Food and drink" },
            { value = "vendor", label = "Other vendors" },
            { value = "stable", label = "Stable masters" },
            { value = "battlemaster", label = "Battlemasters" },
            { value = "guild", label = "Guild masters" },
            { value = "tabard", label = "Tabard designers" },
            { value = "spirit", label = "Spirit healers" },
        },
    },
    {
        key = "trading",
        label = "Trading",
        kind = "toggles",
        options = {
            { value = "auction", label = "Auctioneers" },
            { value = "mail", label = "Mailboxes" },
            { value = "bank", label = "Bankers" },
        },
    },
    {
        key = "trainers",
        label = "Trainers",
        kind = "toggles",
        column = true,
        options = {
            { value = "class", label = "Your class trainer" },
            { value = "professions", label = "Profession trainers" },
            { value = "weapon", label = "Weapon masters" },
            { value = "riding", label = "Riding and pet trainers" },
        },
    },
