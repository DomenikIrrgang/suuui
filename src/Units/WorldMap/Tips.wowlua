-- Units/WorldMap/Tips.wowlua
-- The world map pins' tooltips: one pin's card, a merged pin's list (one
-- line per name, "Mailbox ×2"), and with Shift over a quest pin what each
-- quest asks of you (its objectives, the game's placeholders filled in).
-- Apart from the map's frames, so it's tested on its own.

import SuuUI from "/Core/API"
import questName from "/Units/WorldMap/Quests"
import quest from "/Units/WorldMap/Rows"
import type Group, MapTip, TipLine from "/Units/WorldMap/Arrange"
import type TooltipData, TooltipLine from "/UI/Tooltip"
import * as secret from "wowlua:secret"

local T = SuuUI.Tokens
local S = T.space

-- A quest's objectives text with the game's placeholders filled in: $N
-- your name, $C your class, $R your race, $Gmale:female; by your sex.
export function fillText(text: string): string
    local name = secret.asString(UnitName("player")) or "you"
    local class = secret.asString(UnitClass("player")) or "adventurer"
    local race = secret.asString(UnitRace("player")) or "adventurer"
    -- (a secret sex reads as not female)
    local female = secret.asNumber(UnitSex("player")) == 3
    local gendered = text:gsub("%$[Gg]%s*([^:;]*):([^;]*);", function(m: string, f: string): string return female and f or m end)
    return (gendered:gsub("%$(%a)", function(letter: string): string?
        local c = letter:upper()
        if c == "N" then return name end
        if c == "C" then return class end
        if c == "R" then return race end
        return nil
    end))
end

-- The quests a pin's group holds (givers' and item drops'), once each.
export function groupQuests(g: Group): number[]
    local ids: number[], seen: { [number]: boolean } = {}, {}
    for _, it in ipairs(g.items) do
        for _, id in ipairs(it.quests or {}) do
            if not seen[id] then seen[id] = true; ids[#ids + 1] = id end
        end
    end
    return ids
end

-- Shift on a quest pin (asked 2026-10-18): what each quest asks of you,
-- from the quest data's objectives text, added under what the tooltip
-- already says (nothing goes; a drop's source stays): one quest's as its
-- description, several each under its name.
local MAX_OBJECTIVES = 6
-- space before each entry of a tooltip that lists several, and before its
-- first (under the title)
local ENTRY_GAP = S["space-5"]
local FIRST_GAP = S["space-4"]
local MAP_TIP_W = 360

-- One line of a merged pin's list: a name, how many, what they teach,
-- their quests.
type Entry = { name: string, detail: string, n: number, uids: { [string]: boolean }, teaches?: string, quests?: number[] }
export function addObjectives(tip: MapTip, ids: number[]): MapTip
    local starts = SuuUI.QuestStarts()
    local texts = starts.objectives
    local muted = "|cff" .. T.color["ink-muted"].hex
    local function text(id: number): string
        local given = texts[id]
        return muted .. (given and fillText(given) or "The quest data doesn't say what this quest asks.") .. "|r"
    end
    if #ids == 1 and not tip.lines then
        tip.description = text(ids[1])
        return tip
    end
    -- each objective under its own quest: the title's first, then after
    -- each line that names a quest (a giver's others, a merged pin's)
    local out: TipLine[] = {}
    local titleQuest = tip.titleQuest
    if titleQuest then out[1] = { text(titleQuest), gap = not tip.subtitle and FIRST_GAP or nil } end
    local shown = 0
    for _, l in ipairs(tip.lines or {}) do
        out[#out + 1] = l
        local one, several = l.quest, l.quests
        if one then
            out[#out + 1] = { text(one) }
        elseif several then
            for k, id in ipairs(several) do
                if k > 1 then
                    local row = starts.quests[id]
                    out[#out + 1] = { questName(row and quest(row), id), gap = S["space-2"] }
                end
                shown = shown + 1
                if shown > MAX_OBJECTIVES * 2 then break end
                out[#out + 1] = { text(id) }
            end
        end
    end
    tip.lines = out
    return tip
end

-- A tooltip of the game's own, as the map's.
local function asMapTip(t: TooltipData): MapTip
    local lines: TipLine[]? = nil
    local given = t.lines
    if given then
        local list: TipLine[] = {}
        for i, l in ipairs(given) do list[i] = l end
        lines = list
    end
    return { title = t.title, titleColor = t.titleColor, subtitle = t.subtitle, lines = lines,
             description = t.description, meta = t.meta, maxWidth = t.maxWidth }
end

export function tipBase(g: Group, hint: string?): MapTip
    local first = g.items[1]
    local own = first.tip
    if g.distinct == 1 and own then return asMapTip(own()) end
    if g.distinct == 1 then
        local lines: TipLine[] = {}
        for _, l in ipairs(first.more or {}) do lines[#lines + 1] = l end
        local detail = first.detail
        local kindName = first.kindName
        -- a vendor who also repairs reads "Repair" when its title doesn't say
        if kindName and first.small and detail and not detail:lower():find(kindName:lower(), 1, true) then
            detail = detail .. " · " .. kindName
        elseif kindName and first.small and not detail then
            detail = kindName
        end
        local difficulty, quests = first.difficulty, first.quests
        return { title = first.name, titleColor = difficulty and ("quest-" .. difficulty) or nil,
                 subtitle = detail, lines = #lines > 0 and lines or nil, meta = hint, titleQuest = quests and quests[1] }
    end
    -- one line per name: the same NPC's spawn points, mailboxes, a chest
    -- kind read once with how many ("Mailbox ×2"; found in game)
    local seen: { [string]: Entry } = {}
    local order: Entry[] = {}
    for _, it in ipairs(g.items) do
        local key = it.name .. "\0" .. (it.detail or "")
        local e = seen[key]
        if not e then
            local made: Entry = { name = it.name, detail = it.listDetail or it.detail or "", n = 0, uids = {},
                                  teaches = it.teaches, quests = it.quests }
            seen[key] = made
            order[#order + 1] = made
            e = made
        end
        -- (one NPC's spawn points once: "Mailbox ×2" is two mailboxes)
        local uid = it.uid
        if not (uid and e.uids[uid]) then e.n = e.n + 1 end
        if uid then e.uids[uid] = true end
    end
    -- one line each, the title after the name in muted ink (two columns
    -- overlapped once titles ran long; found in game)
    local muted = "|cff" .. T.color["ink-muted"].hex
    local lines: TipLine[]? = nil
    local list: TipLine[] = {}
    for i, e in ipairs(order) do
        if i > 12 then list[#list + 1] = { ("and %d more"):format(#order - 12) } break end
        local name = e.name .. (e.n > 1 and (" ×" .. e.n) or "")
        -- a gap before each next one: which lines are whose (asked 2026-10-18)
        list[#list + 1] = { e.detail ~= "" and (name .. "  " .. muted .. e.detail .. "|r") or name,
                            gap = i > 1 and ENTRY_GAP or FIRST_GAP, quests = e.quests }
        -- a weapon master's weapons under his name
        local teaches = e.teaches
        if teaches then list[#list + 1] = { muted .. "Teaches " .. teaches .. "|r" } end
    end
    lines = list
    -- all one name: the title says it all
    if #order == 1 and order[1].detail == "" then lines = nil end
    local kind = first.kindName or (first.repeatable and "Repeatable quests") or (first.key == "available" and "Quests to pick up")
        or first.detail or ""
    return { title = kind .. " · " .. g.distinct, lines = lines, meta = "Click to zoom in" .. (hint and (" · " .. hint) or "") }

end

-- A map tip as the tooltip takes it.
local function shown(tip: MapTip): TooltipData
    local lines: TooltipLine[]? = nil
    local given = tip.lines
    if given then
        local list: TooltipLine[] = {}
        for i, l in ipairs(given) do list[i] = l end
        lines = list
    end
    return { title = tip.title, titleColor = tip.titleColor, subtitle = tip.subtitle, lines = lines,
             description = tip.description, meta = tip.meta, maxWidth = tip.maxWidth }
end

export function tipFor(g: Group): TooltipData
    local ids = groupQuests(g)
    local tip = tipBase(g, #ids > 0 and not IsShiftKeyDown() and "Shift: what to do" or nil)
    -- the map's tooltips a bit wider (objectives and lists wrapped early; asked)
    tip.maxWidth = MAP_TIP_W
    if #ids > 0 and IsShiftKeyDown() then addObjectives(tip, ids) end
    return shown(tip)
end
