-- Units/WorldMap/Collect.wowlua
-- What's on a world map (Units/WorldMap): every pin the map would show
-- before merging (quests to pick up and from items, entrances, flight
-- masters, campfires, services and trainers, mailboxes, rares, treasures,
-- marks, convergences), each quest judged once until something it depends
-- on changes, its group tag (the game's, told late), and the flight masters
-- this character has found. Offers the module's Player, RecordTaxiNodes and
-- Collect as functions taking the module, and what the other parts share:
-- isGroupQuest, judge, forgetQuests, NO_STARTS.

import SuuUI from "/Core/API"
import type MapPinData, TooltipData from "/Core/API"
import after from "wowlua:timer"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import QUEST_RANK, questPin, raceBit, completedSet, eventOn, questName, questState from "/Units/WorldMap/Quests"
import type Me, Offer from "/Units/WorldMap/Quests"
import quest, npc, entrance, instanceLevels from "/Units/WorldMap/Rows"
import type Item, TipLine from "/Units/WorldMap/Arrange"
import type QuestStarts from "/Data/QuestStarts"
import type MapPlaces from "/Data/MapPlaces"
import type WorldMapModule from "/Units/WorldMap"

local MARKS = SuuUI.Services.MARKS
local CONVERGENCES = SuuUI.Services.CONVERGENCES
local CAMPFIRES = SuuUI.Services.CAMPFIRES

local T = SuuUI.Tokens

local asNumber, asString, field = secret.asNumber, secret.asString, tbl.field

-- A campfire's time left: m:ss, or out.
export function fireLeft(s: number): string
    if s <= 0 then
        return "going out"
    end
    s = math.floor(s)
    return ("%d:%02d"):format(s / 60, s % 60)
end

