    inn = { filter = "inn", glyph = "inn" },
    bank = { filter = "bank", glyph = "bank" },
    auction = { filter = "auction", glyph = "gavel" },
    battlemaster = { filter = "battlemaster", glyph = "flag" },
    guild = { filter = "guild", glyph = "scroll" },
    tabard = { filter = "tabard", glyph = "tabard" },
    stable = { filter = "stable", glyph = "paw" },
    repair = { filter = "repair", glyph = "anvil" },
    food = { filter = "food", glyph = "mug" },
    goods = { filter = "goods", glyph = "bag" },
    vendor = { filter = "vendor", glyph = "coin" },
}
