-- Units/RaidFrames.wowlua
-- Raid frames (step 1.9): up to forty unit frames, a secure group header per
-- raid group (1-8), so the game fills and re-sorts them in combat. A
-- built-in module written against the public API only.
--
-- One layout per profile (roles pick profiles, General > Profiles > By role):
--   groups as rows     each group a row of five, group 1 on top (the healer
--                      layout, centred between your frame and the target's)
--   groups as columns  each group a column of five, wrapping into bands (the
--                      side layout, bottom left above the chat)
-- Raids of 21-40 can use a shorter bar so the grid stays clear of the dock.
--
-- The headers make their buttons out of combat, all forty at once (the
-- startingIndex trick): aura containers can't be made in combat. Each button
-- is SuuUI's unit frame; the header sets its unit, the frame follows.
-- Inside the bar: role icon, name, the state badge at the row's end (debuff
-- types in combat too, as on the party frames), up to three aura icons at
-- the bar's right end (debuffs you can remove, externals, defensives, other
-- important debuffs; buffs come through buff indicators). Out of range fades
-- the frame.


import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import UnitFrame from "/UI/UnitFrame"
import type StandInPerson, UnitApi, UnitFrameOptions, GroupDefensives from "/UI/UnitFrame"
import type UnitAuras, AuraGroup from "/UI/Auras"
import type Icon from "/UI/Icon"
import type Position from "/EditMode/EditMode"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import after, every from "wowlua:timer"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {
    position = { point = "BOTTOMLEFT", x = 28, y = 300 } :: Position,
    arrangement = "columns",   -- "columns" (side layout) or "rows" (healer layout)
    sort = "group",            -- within each group: "group" (raid order) or "role"
    perBand = 4,               -- columns: groups side by side before the next band
    width = 108,
    height = 19,
    heightLarge = 20,          -- raids of 21-40
    gap = 8,
    groupGap = 4,
    showSolo = false,          -- your own frame while not in a group (to try them)
    power = "roles",
    healthText = "none",
    nameColor = "game",        -- "game" (class colour) or "ink", as on the unit frames
    raidMarkers = true,
    lowHealth = true,
    incoming = true,
    buffIcons = 1,             -- defensives (the Defensives list), inside the bar's right end
    debuffIcons = 2,           -- debuffs at the very end, the ones you can remove first
    debuffBadges = "all",      -- "all" debuff types, "removable" or "off"
    rangeAlpha = 0.25,
}

local M: RaidFramesModule

local GROUPS = 8
local HEALER_CLASS: { [string]: boolean } = { PRIEST = true, DRUID = true, PALADIN = true, SHAMAN = true }

export function powerFor(unit: string, A: UnitApi): boolean
    local mode = M:Get("power")
    if mode == "all" then return true end
    if mode == "none" then return false end
    local role = A.UnitGroupRolesAssigned and A.UnitGroupRolesAssigned(unit)
    if not secret.isSecret(role) and role and role ~= "NONE" then return role == "TANK" or role == "HEALER" end
    local _, class = A.UnitClass(unit)
    return not secret.isSecret(class) and class and HEALER_CLASS[class] == true or false
end

-- The bar height for the raid's size: the shorter one from 21 players up.
local function barHeight(): number
    local n = GetNumGroupMembers and GetNumGroupMembers() or 0
    return (n > 20) and M:Get("heightLarge") or M:Get("height")
end

local function iconSize(h: number): number return math.max(8, h - 6) end

-- Inside the bar's right end, one row the engine lays out leftward:
-- debuffs at the very end (the ones you can remove first), then right before
-- them however many defensives show (the Defensives list's spells, Frames ›
-- Defensives: the game hides who cast another player's buffs, and its own
-- defensive filters then let every buff through), `space-2` apart. On your
-- own frame the debuffs you can remove come first; on everyone else's
-- they're one list (the game hides who cast another player's auras, and
-- those then pass both "removable" and "not removable": each showed twice).
local GAP_SETS = S["space-2"]
-- The first group serves whoever the frame shows (its filter follows: the
-- debuffs you can remove on yours, all of them on everyone else's), so a
-- frame keeps two groups (the engine makes ten buttons for each, whatever
-- its count) and the second, your other debuffs, comes only on a frame
-- that has shown you.
type RaidGroup = { key: string, set: "buffIcons" | "debuffIcons", who?: string, filter?: string[], filters?: { me: string[], others: string[] },
    list?: keyof GroupDefensives, border?: string, drain?: string, dispel?: boolean, harmfulEdge?: boolean, gap?: number }
local AURA_GROUPS: RaidGroup[] = {
    { key = "debuffs", set = "debuffIcons", filters = { me = { "HARMFUL", "RAID_PLAYER_DISPELLABLE" }, others = { "HARMFUL" } },
      dispel = true, harmfulEdge = true },
    -- every other debuff on yours (Forbearance, Weakened Soul…); buffs come
    -- only through buff indicators (you pick them)
    { key = "rest", set = "debuffIcons", who = "me", filter = { "HARMFUL", "!RAID_PLAYER_DISPELLABLE" }, dispel = true, harmfulEdge = true,
      gap = GAP_SETS - S["space-1"] },
    { key = "defensives", set = "buffIcons", filter = { "HELPFUL" }, list = "all", border = "ward", drain = "ward",
      gap = GAP_SETS - S["space-1"] },
}

-- The row's width at a bar height: both sets' icons, and the gap when both
-- have room.
local function rowWidth(h: number): number
    local size = iconSize(h)
    local buffs, debuffs = M:Get("buffIcons"), M:Get("debuffIcons")
    local n = buffs + debuffs
    if n == 0 then return 0 end
    return n * size + (n - 1) * S["space-1"] + ((buffs > 0 and debuffs > 0) and (GAP_SETS - S["space-1"]) or 0)
end

local function auraReserve(h: number): number
    local w = rowWidth(h)
    return w > 0 and (w + 2 * S["space-1"] + 1) or 0
end

-- The selected border (your target): its own frame, so a secret "is it the
-- target?" can set its alpha through the engine.
local function selectedBorder(f: Frame): Frame
    local sel = CreateFrame("Frame", nil, f)
    sel:SetAllPoints()
    sel:SetFrameLevel(f:GetFrameLevel() + 10)
    UI.Border(sel, "arcane", { inset = 0 })
    sel:SetAlpha(0)
    return sel
end

--------------------------------------------------------------------------------
-- A header's button, styled once when the header makes it
--------------------------------------------------------------------------------

-- A raid button: SuuUI's unit frame on the button the group header made, the
-- row of auras inside its bar (a clip as wide as the settings' icons: the
-- engine fills its groups to their counts; the clip cuts off the rest) and
-- the selected border. Whether its unit is you is read when the unit changes
-- and after a fight (UnitIsUnit may be secret in combat: a secret answer
-- keeps the last one).
export class RaidButton extends UnitFrame
    readonly auraClip: Frame
    readonly selected: Frame
    auras: UnitAuras? = nil
    isMe: boolean = false

    constructor(parent: Frame?, unit: string?, opts: UnitFrameOptions)
        super(parent, unit, opts)
        self.auraClip = CreateFrame("Frame", nil, self)
        self.auraClip:SetClipsChildren(true)
        self.auraClip:SetFrameLevel(self.over:GetFrameLevel() + 1)
        self.selected = selectedBorder(self)
    end

    -- A group's count on this button: its setting, on the frames it is for.
    function GroupMax(g: RaidGroup): number
        if g.who and g.who ~= (self.isMe and "me" or "others") then return 0 end
        return M:Get(g.set)
    end

    -- A group's filter for whoever it shows now.
    function GroupFilter(g: RaidGroup): string[]?
        local filters = g.filters
        return filters and (self.isMe and filters.me or filters.others) or g.filter
    end

    -- The engine's row, filled group by group.
    function BuildAuras(h: number)
        local defensives = UI.GroupDefensives()
        local groups: AuraGroup[] = {}
        for i, g in ipairs(AURA_GROUPS) do
            local list = g.list
            groups[i] = { key = g.key, filter = self:GroupFilter(g) or {}, max = self:GroupMax(g), dispel = g.dispel, drain = g.drain,
                digits = false, harmfulEdge = g.harmfulEdge, border = g.border, gap = g.gap, include = list and defensives[list] }
        end
        local auras = UI.AuraContainer(self.auraClip, "none", { size = iconSize(h), spacing = S["space-1"], anchor = "TOPRIGHT",
            growth = { "LEFT", "DOWN" }, groups = groups, lazy = true })
        self.auras = auras
        if auras then
            auras.container:SetPoint("TOPRIGHT", self.auraClip, "TOPRIGHT")
            self:ApplyAuraCount()
        end
    end

    function UpdateIsMe()
        local unit = self.unit
        local me = unit and UnitIsUnit(unit, "player")
        if not secret.isSecret(me) then self.isMe = me and true or false end
    end

    -- Which debuff groups it uses, and their filters, for whoever it shows now.
    function ApplyWho()
        local auras = self.auras
        if not auras then return end
        for _, g in ipairs(AURA_GROUPS) do
            local filter = g.filters and self:GroupFilter(g)
            if filter then auras:SetGroupFilter(g.key, filter) end
            if g.who then auras:SetGroupMax(g.key, self:GroupMax(g)) end
        end
    end

    -- Each group's count, and the clip: the row at the bar's right end,
    -- centred on its height.
    function ApplyAuraCount()
        local auras = self.auras
        if not auras then return end
        local h = self:GetHeight()
        local size = iconSize(h)
        for _, g in ipairs(AURA_GROUPS) do
            auras:SetGroupMax(g.key, self:GroupMax(g))
            -- the icons follow the bar's height (from 21 players too); the height
            -- only changes out of combat, where the engine's buttons take a resize
            if not InCombatLockdown() then auras:SetGroupSize(g.key, size) end
        end
        local w = rowWidth(h)
        self.auraClip:ClearAllPoints()
        self.auraClip:SetPoint("RIGHT", self, "RIGHT", -S["space-1"] - 1, 0)
        self.auraClip:SetSize(math.max(1, w), size)
        self.auraClip:SetShown(w > 0)
    end
end

--------------------------------------------------------------------------------
-- Headers
--------------------------------------------------------------------------------

-- Sorting within each group. groupBy only orders the units the header's
-- groupFilter (its group number) lets in: the header filters first, then
-- sorts what passed by groupingOrder, and anyone whose role isn't listed
-- goes last. groupingOrder goes first: a header with groupBy and no
-- groupingOrder errors on its next update.
local ROLE_ORDER = "TANK,HEALER,DAMAGER,NONE"

-- Run by each header for each button it makes (restricted code): size and
-- click actions, then SuuUI's styling.
local INIT = [[
    local header = self:GetParent()
    self:SetWidth(header:GetAttribute("unitWidth"))
    self:SetHeight(header:GetAttribute("unitHeight"))
    self:SetAttribute("*type1", "target")
    self:SetAttribute("*type2", "togglemenu")
    header:CallMethod("SuuStyle", self:GetName())
]]

-- A raid group's secure header: it makes its group's buttons and asks SuuUI
-- to style each (its SuuStyle, called from the restricted code).
class GroupHeader extends Frame
    private readonly module: RaidFramesModule

    constructor(m: RaidFramesModule, holder: Frame, g: number)
        super("SuuUIRaidGroup" .. g, holder, "SecureGroupHeaderTemplate")
        self.module = m
        self:SetAttribute("template", "SecureUnitButtonTemplate")
        self:SetAttribute("templateType", "Button")
        self:SetAttribute("groupFilter", tostring(g))
        self:SetAttribute("showRaid", true)
        self:SetAttribute("showPlayer", true)
        self:SetAttribute("showParty", false)
        self:SetAttribute("sortMethod", "INDEX")
        self:SetAttribute("unitsPerColumn", 5)
        self:SetAttribute("maxColumns", 1)
        self:SetAttribute("initialConfigFunction", INIT)
    end

    -- (called by INIT, from the restricted code, for each button made)
    function SuuStyle(name: string)
        local button = frames.asButton(tbl.field(_G, name))
        if button then self.module:StyleButton(button) end
    end
end

--------------------------------------------------------------------------------
-- Layout and options (out of combat)
--------------------------------------------------------------------------------

-- The layout's numbers: frame width and height, the gap between frames and
-- between groups, groups side by side (columns), rows or columns.
type Grid = { w: number, h: number, gap: number, groupGap: number, perBand: number, rows: boolean }

-- Group g's top left in the grid (x right, y down, from the top left).
local function groupOrigin(g: number, grid: Grid): (number, number)
    if grid.rows then return 0, (g - 1) * (grid.h + grid.groupGap) end
    local col, band = (g - 1) % grid.perBand, math.floor((g - 1) / grid.perBand)
    return col * (grid.w + grid.groupGap), band * (5 * grid.h + 4 * grid.gap + grid.groupGap * 2)
end

-- A frame's top left in its group: slot 0 first (raid order or by role).
local function slotOffset(slot: number, grid: Grid): (number, number)
    if grid.rows then return slot * (grid.w + grid.gap), 0 end
    return 0, slot * (grid.h + grid.gap)
end

-- The holder's size for eight groups. Rows: as tall as eight groups at
-- `tall` (heightLarge) whatever the raid's size.
local function holderSize(grid: Grid, tall: number): (number, number)
    if grid.rows then
        return 5 * grid.w + 4 * grid.gap, GROUPS * tall + (GROUPS - 1) * grid.groupGap
    end
    local bands = math.ceil(GROUPS / grid.perBand)
    return grid.perBand * grid.w + (grid.perBand - 1) * grid.groupGap, bands * (5 * grid.h + 4 * grid.gap) + (bands - 1) * grid.groupGap * 2
end

-- The settings' grid at bar height h.
local function gridAt(h: number): Grid
    return { w = M:Get("width"), h = h, gap = M:Get("gap"), groupGap = M:Get("groupGap"),
        perBand = math.max(1, M:Get("perBand")), rows = M:Get("arrangement") == "rows" }
end

--------------------------------------------------------------------------------
-- The preview: a made-up raid (10, 20 or 40) in the settings window's
-- preview column, drawn by the same unit frames from stand-in data.
--------------------------------------------------------------------------------

-- An aura on a made-up person: a spell texture with the edge the engine
-- would give it (a debuff's; a defensive has none).
type Aura = { spell: number, edge?: string }
-- What makes the preview show every state.
type Extras = {
    incoming?: number, absorb?: number, marker?: number, aggro?: boolean, debuff?: string, removable?: boolean,
    dead?: boolean, far?: boolean, selected?: boolean, power?: number, offline?: boolean, auras?: Aura[],
}
type Person = {
    name: string, class: string, role: string, health: number, max: number, power: number, incoming?: number,
    absorb?: number, marker?: number, aggro?: boolean, debuff?: string, removable?: boolean, dead?: boolean,
    far?: boolean, selected?: boolean, offline?: boolean, auras?: Aura[],
}

type Member = { name: string, class: string, role?: string }
local ROSTER: Member[] = {}
for _, r in ipairs({
    { "Brannoc", "WARRIOR", "TANK" }, { "Ysolde", "PRIEST", "HEALER" }, { "Kaelith", "MAGE" }, { "Morrow", "ROGUE" }, { "Veyra", "SHAMAN", "HEALER" },
    { "Aldric", "PALADIN" }, { "Thessaly", "DRUID" }, { "Grimbolt", "WARLOCK" }, { "Sylva", "HUNTER" }, { "Oren", "PRIEST", "HEALER" },
    { "Hadrin", "WARRIOR", "TANK" }, { "Lisset", "MAGE" }, { "Corvane", "ROGUE" }, { "Tamsin", "DRUID" }, { "Eldra", "SHAMAN", "HEALER" },
    { "Vosk", "WARRIOR" }, { "Nimra", "PRIEST" }, { "Quell", "WARLOCK" }, { "Arlo", "HUNTER" }, { "Seraphe", "PALADIN", "HEALER" },
    { "Dagny", "WARRIOR" }, { "Fenn", "ROGUE" }, { "Ilsa", "MAGE" }, { "Rook", "HUNTER" }, { "Maelis", "PRIEST", "HEALER" },
    { "Torvald", "WARRIOR" }, { "Wren", "DRUID" }, { "Cassian", "MAGE" }, { "Ysra", "WARLOCK" }, { "Bellamy", "PALADIN", "HEALER" },
    { "Garrick", "ROGUE" }, { "Odessa", "SHAMAN", "HEALER" }, { "Pell", "HUNTER" }, { "Juna", "PRIEST", "HEALER" }, { "Thorne", "WARRIOR", "TANK" },
    { "Liora", "MAGE" }, { "Brask", "WARLOCK" }, { "Sefa", "DRUID" }, { "Halden", "PALADIN" }, { "Mirelle", "PRIEST", "HEALER" },
}) do
    ROSTER[#ROSTER + 1] = { name = r[1], class = r[2], role = r[3] }
end
local HEALTH = { 64, 92, 31, 83, 88, 18, 100, 0, 76, 64, 97, 100, 58, 100, 91, 100, 85, 100, 72, 100,
                 44, 100, 100, 89, 100, 100, 67, 100, 100, 93, 100, 100, 81, 100, 100, 26, 100, 100, 100, 86 }
local SPECIAL: { [string]: Extras } = {
    Brannoc = { incoming = 0.18, absorb = 0.1, marker = 8, auras = { { spell = 871 } } },
    Kaelith = { aggro = true, incoming = 0.12, auras = { { spell = 10060 } } },
    Morrow = { debuff = "Poison", auras = { { spell = 2818, edge = "dispel-poison" } } },
    Oren = { debuff = "Disease", removable = true, auras = { { spell = 18278, edge = "dispel-disease" } } },
    Grimbolt = { dead = true }, Sylva = { far = true }, Aldric = { aggro = true },
    Thessaly = { auras = { { spell = 1022 } } }, Corvane = { incoming = 0.2 },
    Dagny = { absorb = 0.14 }, Nimra = { debuff = "Magic", removable = true, auras = { { spell = 122, edge = "dispel-magic" } } },
    Liora = { debuff = "Curse", auras = { { spell = 980, edge = "dispel-curse" } } },
    Ysolde = { selected = true, power = 0.14 },
    Hadrin = { marker = 7 }, Veyra = { offline = true },
}

local ROLE_RANK: { [string]: number } = { TANK = 1, HEALER = 2, DAMAGER = 3 }

local people: { [number]: Person } = {}
local function person(unit: string): Person
    local i = tonumber(unit:match("^raidpreview(%d+)$")) or 1
    local d = people[i]
    if not d then
        local r = assert(ROSTER[i])
        local health = assert(HEALTH[i]) / 100
        local x = SPECIAL[r.name] or {}
        d = { name = r.name, class = r.class, role = r.role or "DAMAGER", health = health, max = 4200,
              power = x.power or (0.4 + (i * 13 % 60) / 100), incoming = x.incoming, absorb = x.absorb, marker = x.marker,
              aggro = x.aggro, debuff = x.debuff, removable = x.removable, dead = x.dead or health == 0, far = x.far,
              selected = x.selected, offline = x.offline, auras = x.auras }
        people[i] = d
    end
    return d
end

local STAND_IN = UI.UnitStandIn(function(u: string): StandInPerson return person(u) end)

-- The group preview's "with buffs and debuffs": everyone carries a
-- defensive or two from the Defensives list and a debuff of every type.
local function fullAuras(): Aura[]
    local out: Aura[] = {}
    local list = UI.GroupDefensives().all or {}
    for i = 1, math.min(4, #list) do out[#out + 1] = { spell = list[i] } end
    local debuffs: Aura[] = { { spell = 122, edge = "dispel-magic" }, { spell = 980, edge = "dispel-curse" },
        { spell = 2818, edge = "dispel-poison" }, { spell = 18278, edge = "dispel-disease" } }
    for _, a in ipairs(debuffs) do out[#out + 1] = a end
    return out
end

-- A preview's frame: icons drawn where the engine's would be, the debuff
-- types' looks, Warded, the selected border.
export class PreviewRaidFrame extends UnitFrame
    readonly icons: Icon[] = {}
    readonly dispelDecos: { [string]: Frame } = {}
    readonly selected: Frame
    indicatorVersion: string? = nil

    constructor(parent: Frame, unit: string, opts: UnitFrameOptions)
        super(parent, unit, opts)
        self:SetScript("OnEnter", nil)
        self:SetScript("OnLeave", nil)
        self:EnableMouse(false)
        self.selected = selectedBorder(self)
        for k = 1, 4 do
            local icon = UI.Icon(self.over, 12)
            icon:Hide()
            self.icons[k] = icon
        end
        for _, kind in ipairs(UI.DEBUFF_TYPES) do
            local deco = self:DispelDecoration(self, kind)
            deco:Hide()
            self.dispelDecos[kind] = deco
        end
        local ward = self:WardDecoration(self)
        ward:SetWarded(false)
        self.wardDeco = ward
    end
end

-- 40 made-up frames on a view: the settings window's, and edit mode's group
-- preview (on the real frames' place): how many show, everyone's auras when
-- "with buffs and debuffs".
type PreviewSet = { view: Frame, frames: PreviewRaidFrame[], count?: number, allAuras?: Aura[] }

local function hasNoArrangement(): (boolean?, string?)
    if M:Get("arrangement") ~= "columns" then return true, "Only for groups as columns." end
    return nil, nil
end

