-- Units/RaidPlanner/View.wowlua
-- What the raid planner's window shows (Units/RaidPlanner): the window's
-- data (the setups listed, the palette, the groups' cards, open slots,
-- players without a slot, coverage, the status line and the buttons) and
-- drawing it; the texts it is made of (what a slot asks for, how long ago,
-- a setup's summary, a group's caption). The module's ViewData and Render
-- call these.

import type PlannerData, PlannerSlot, PlannerSetup, PaletteClass, PaletteSpec, PlannerGroup, PlannerListItem, PlannerPerson, PlannerStat from "/Core/API"
import CLASSES, CLASS, ITEMS, MAX_GROUP, ROLE_WORD, ROLE_NAME, treeRole from "/Units/RaidPlanner/Catalog"
import roleOf from "/Units/RaidPlanner/Fill"
import type Filled from "/Units/RaidPlanner/Fill"
import provides, shortSpec from "/Units/RaidPlanner/Coverage"
import type Slot, Setup from "/Units/RaidPlanner/Setups"
import type RaidPlannerModule from "/Units/RaidPlanner"

--------------------------------------------------------------------------------
-- What the window shows
--------------------------------------------------------------------------------

export function reqText(s: Slot): string
    local parts: string[] = {}
    local c = s.class and CLASS[s.class]
    if c then
        parts[1] = c.name
        local role = s.role
        if s.spec then
            parts[2] = c.specs[s.spec]
        elseif role then
            parts[2] = ROLE_NAME[role] or role
        end
    else
        local role = s.role
        parts[1] = role and ("Any " .. (ROLE_WORD[role] or role)) or "Any"
    end
    if s.label and s.label ~= "" then
        parts[#parts + 1] = s.label
    end
    return table.concat(parts, " · ")
end

export function ago(t: number?): string
    if not t then
        return ""
    end
    local s = math.max(0, time() - t)
    if s < 120 then
        return "just now"
    end
    if s < 3600 then
        return math.floor(s / 60) .. "m ago"
    end
    if s < 86400 then
        return math.floor(s / 3600) .. "h ago"
    end
    if s < 14 * 86400 then
        return math.floor(s / 86400) .. "d ago"
    end
    return math.floor(s / (7 * 86400)) .. "w ago"
end

-- What a setup asks for: "2 tanks · 10 healers".
export function summary(setup: Setup): string
    local tanks, healers = 0, 0
    for _, s in ipairs(setup.slots) do
        local role = s.role or (s.spec and treeRole(s.class, s.spec))
        if role == "TANK" then
            tanks = tanks + 1
        elseif role == "HEALER" then
            healers = healers + 1
        end
    end
    return ("%d slots · %d tank%s · %d healer%s"):format(
        #setup.slots,
        tanks,
        tanks == 1 and "" or "s",
        healers,
        healers == 1 and "" or "s"
    )
end

-- A group's caption from what its slots ask for.
export function groupKind(slots: Slot[]): string
    if #slots == 0 then
        return ""
    end
    local count: { [string]: number } = {}
    local anyone = 0
    for _, s in ipairs(slots) do
        local c = s.class and CLASS[s.class]
        local role = s.role or (s.spec and c and c.roles[s.spec])
        local kind: string? = nil
        if role == "TANK" then
            kind = "tanks"
        elseif role == "HEALER" then
            kind = "healers"
        elseif s.class == "HUNTER" then
            kind = "hunters"
        elseif c and ((s.spec and c.melee[s.spec]) or (not s.spec and c.melee[1] and c.melee[2])) then
            kind = "melee"
        elseif c then
            kind = "casters"
        else
            anyone = anyone + 1
        end
        if kind then
            count[kind] = (count[kind] or 0) + 1
        end
    end
    if count.tanks then
        return "tanks"
    end
    local best: string? = nil
    local n = 0
    for k, v in pairs(count) do
        if v > n then
            best, n = k, v
        end
    end
    if best and n >= 3 then
        return best
    end
    return anyone >= 3 and "flex" or "mixed"
end

export function viewData(self: RaidPlannerModule): PlannerData
    local d = self:Data()
    local w = self:Work()
    local fill: Filled = self.fill or { slot = {}, conflict = {}, unplaced = {}, placed = {} }
    local roster = self.roster
    local inRaid = self.inRaid
    local changed = self:Changed()
    local people, open = self:People()
    local v: PlannerData = {}

    v.meta = w.name .. (not w.id and " · not saved" or (changed and " · changed" or ""))
    v.size = d.size

    -- setups of the chosen size, the loaded one marked
    local setups: PlannerSetup[] = {}
    if not w.id and w.size == d.size then
        setups[1] = { id = "work", name = w.name, meta = "loaded · not saved", loaded = true, changed = true }
    end
    local stored: { id: number, s: Setup }[] = {}
    for id, s in pairs(d.setups) do
        if s.size == d.size then
            stored[#stored + 1] = { id = id, s = s }
        end
    end
    table.sort(stored, function(a: { id: number, s: Setup }, b: { id: number, s: Setup }): boolean
        return a.s.name:lower() < b.s.name:lower()
    end)
    for _, e in ipairs(stored) do
        local loaded = w.id == e.id
        local meta = loaded and ("loaded" .. (changed and " · changed" or "") .. " · saved " .. ago(e.s.saved)) or
            (summary(e.s) .. " · " .. ago(e.s.saved))
        setups[#setups + 1] = {
            id = e.id,
            name = loaded and w.name or e.s.name,
            meta = meta,
            loaded = loaded,
            changed = loaded and changed,
        }
    end
    v.setups = setups

    -- the palette
    local palette: PaletteClass[] = {}
    for _, c in ipairs(CLASSES) do
        local specs: PaletteSpec[] = {}
        for t = 1, 3 do
            specs[t] = {
                spec = t,
                label = c.short[t],
                name = c.specs[t],
                role = c.roles[t],
                icon = self:TreeIcon(c.file, t),
            }
        end
        palette[#palette + 1] = { class = c.file, name = c.name, specs = specs }
    end
    v.palette = palette

    -- the groups and their slots
    local nOpen, nConflict = 0, 0
    local openList: PlannerListItem[] = {}
    local groups: PlannerGroup[] = {}
    for g = 1, w.size / 5 do
        local slots = self:SlotsIn(g)
        local cards: PlannerSlot[] = {}
        for i, s in ipairs(slots) do
            local f = fill.slot[s.id]
            local req = reqText(s)
            -- open or away: the icon of what the slot asks for (drawn dimmed)
            local card: PlannerSlot = {
                id = s.id,
                req = req,
                icon = self:TreeIcon(s.class, s.spec),
                iconClass = s.class,
            }
            if f then
                local m = f.m
                card.who, card.class, card.player = m.name, m.class, m.name
                card.spec = shortSpec(m.class, m.tree) or "?"
                -- their spec's icon; their class's while the spec isn't known
                card.icon, card.iconClass = self:TreeIcon(m.class, m.tree), m.class
                card.pinned = f.how == "pinned"
                card.state = f.how == "provisional" and "provisional" or "filled"
                if card.pinned then
                    card.req = "Pinned · " .. req
                end
                local tips: string[] = {}
                if not m.tree then
                    tips[#tips + 1] = "Spec not known yet: filled provisionally until inspected."
                end
                if card.pinned then
                    tips[#tips + 1] = "Placed by hand: stays here until you move them."
                end
                local role, from = roleOf(m)
                if s.role and from == "likely" then
                    tips[#tips + 1] = ("Role: likely %s (the class's usual role)."):format(
                        role and ROLE_WORD[role] or "?"
                    )
                end
                local other = fill.conflict[s.id]
                if other then
                    card.state = "conflict"
                    card.req = req .. " · 2 fit: " .. m.name .. ", " .. other.name
                    tips[#tips + 1] = ("%s fits too: drag them here to swap."):format(other.name)
                    nConflict = nConflict + 1
                end
                card.tip = table.concat(tips, " ")
            elseif s.pin then
                card.who, card.state, card.pinned = s.pin, "away", true
                card.req = "Pinned · not in the raid · " .. req
                card.tip = s.pin .. " is pinned here but isn't in the raid."
                nOpen = nOpen + 1
                openList[#openList + 1] = {
                    label = ("Group %d · %s"):format(g, req),
                    detail = s.pin .. " (pinned) isn't in the raid",
                }
            else
                card.state = "open"
                card.tip = inRaid and "Nobody in the raid fits: " .. req or "Fills with the raid."
                if inRaid then
                    nOpen = nOpen + 1
                    local brings: string[] = {}
                    local class = s.class
                    for _, item in ipairs(ITEMS) do
                        if self:IsTracked(item.key) and class and
                            provides(item, { class = class, tree = s.spec }) == "yes" then
                            brings[#brings + 1] = item.short
                        end
                    end
                    openList[#openList + 1] = {
                        label = ("Group %d · %s"):format(g, req),
                        detail = #brings > 0 and table.concat(brings, ", ", 1, math.min(#brings, 4)) or
                            "nobody in the raid fits",
                    }
                end
            end
            cards[i] = card
        end
        groups[g] = {
            n = g,
            kind = groupKind(slots),
            slots = cards,
            canAdd = #slots < MAX_GROUP,
            chips = self:PartyChips(g, people, open),
        }
    end
    v.groups = groups
    v.open = openList

    -- players without a slot, and why
    local unplaced: PlannerPerson[] = {}
    for _, m in ipairs(fill.unplaced) do
        local c = CLASS[m.class]
        local spec = m.tree and c and c.specs[m.tree] or "spec ?"
        local why: string? = nil
        for _, s in ipairs(w.slots) do
            local other = fill.conflict[s.id] == m and fill.slot[s.id]
            if other then
                why = ("fits group %d's \"%s\" with %s: drag to swap"):format(s.g, reqText(s), other.m.name)
                break
            end
        end
        if not why then
            if self.letGo[m.key] then
                why = "let go by hand: drag onto a slot"
            else
                local asks = 0
                for _, s in ipairs(w.slots) do
                    if s.class == m.class then
                        asks = asks + 1
                    end
                end
                why = asks > 0 and
                    ("the %d %s slot%s %s full: drag onto a slot or add one"):format(
                        asks,
                        c and c.name:lower() or "",
                        asks == 1 and "" or "s",
                        asks == 1 and "is" or "are"
                    ) or
                    ("no slot asks for a %s: drag onto a slot or add one"):format(c and c.name:lower() or "player")
            end
        end
        unplaced[#unplaced + 1] = {
            name = m.name,
            class = m.class,
            icon = self:TreeIcon(m.class, m.tree),
            known = m.tree ~= nil,
            detail = (c and c.name or "") .. " · " .. spec .. " · " .. why,
        }
    end
    v.unplaced = unplaced

    -- coverage
    v.raidWide = self:RaidWide(people, open)
    v.raidWideMeta = inRaid and "tracked only" or "from the slots"
    v.raidWideEmpty = "Nothing raid-wide is tracked (Settings › Raid planner)."

    -- the status line
    local tracked = self:TrackedCount()
    if inRaid then
        local placed = 0
        for _ in pairs(fill.placed) do
            placed = placed + 1
        end
        local unknown = self:UnknownSpecs()
        local stats: PlannerStat[] = {
            { n = #roster, label = "in raid" },
            { n = placed, label = "placed" },
            { n = unknown, label = self.inspecting and "spec ? (inspecting)" or "spec ? (inspect pending)" },
            { n = nOpen, label = "open slots", warn = nOpen > 0 },
            { n = nConflict, label = "two fit one slot", warn = nConflict > 0 },
            { n = #fill.unplaced, label = "without a slot" },
        }
        v.stats = stats
    else
        v.stats = { { n = #w.slots, label = "slots" }, { n = 0, label = "in raid" } }
    end
    local how = self:Get("fill") == "review" and "Fills when you click Fill slots" or "Fills as the raid changes"
    if InCombatLockdown() then
        how = "In combat: fills when it ends"
    end
    if not inRaid then
        how = "Not in a raid: coverage from what the slots ask for"
    end
    v.note = ("%s · %d tracked"):format(how, tracked)

    v.hint = "Click a slot to edit it; right-click for actions. Drag a spec onto a slot, a player onto another to swap."
    local canArrange, why = self:CanArrange()
    v.arrange = { enabled = canArrange, reason = why }
    local unknown = inRaid and #self:SpecQueue() or 0
    local inspectWhy: string? = nil
    if InCombatLockdown() then
        inspectWhy = "Not in combat."
    elseif self.inspecting or self.inspectRound then
        inspectWhy = "Inspecting, one player at a time."
    end
    v.inspect = {
        shown = unknown > 0,
        label = ("Inspect the %d"):format(unknown),
        enabled = inspectWhy == nil,
        reason = inspectWhy,
    }
    v.fill = {
        shown = self:Get("fill") == "review" and inRaid,
        enabled = not InCombatLockdown(),
        reason = "Not in combat.",
    }
    return v
end

export function render(self: RaidPlannerModule)
    local window = self.window
    if not (window and window:IsShown()) then
        return
    end
    self.trackCache = self:TrackedSet()
    local v = self:ViewData()
    self.trackCache = nil
    window:SetData(v)
    local editing = window:EditingSlot()
    if editing then
        if self:SlotById(editing) then
            self:OpenEditor(editing)
        else
            window:CloseEditor()
        end
    end
end
