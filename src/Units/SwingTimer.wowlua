-- Units/SwingTimer.wowlua
-- The swing timer (step 1.3b), directly under your cast bar and exactly as
-- wide: main hand, then off hand; the ranged bar while you shoot. A built-in
-- module written against the public API only.
--
-- Placement (2560x1440 reference): as wide as your cast bar (340px unless set
-- in the cast bars' settings), centred, its top space-2 under the cast bar
-- (288px above the bottom edge). Healers have none by default. Its settings
-- merge into the "Cast & swing bars" section.

import SuuUI from "/Core/API"

local UI, T = SuuUI.UI, SuuUI.Tokens

local M = SuuUI.RegisterModule({
    id = "swingtimer",
    name = "Swing timer",
    description = "When your next swing or shot lands, from the game's own swing timer.",
    api = "0.9",
    combatSafe = true,
    defaults = {
        position = { point = "BOTTOM", x = 0, y = 271 },
        shows = "combat", -- "off", "combat" or "always"
        hideForHealers = true,
        autoShotWindow = true,
        autoShotNoCast = false, -- learned: this client's Auto Shot fires while moving
    },
})

-- The toggle "In combat only" became the choice Show: Off / In combat / Always.
M:Migrate("shows", function(values)
    if type(values.inCombatOnly) == "boolean" then
        values.shows = values.inCombatOnly and "combat" or "always"
    end
    values.inCombatOnly = nil
end)

-- Your cast bar's width (the cast bars module's setting), or the design's.
local function castWidth()
    local cast = SuuUI.GetModule("castbars")
    return cast and cast:Get("playerWidth") or 340
end

function M:ApplyAutoShot()
    self.timer:SetAutoShotWindow(self:Get("autoShotWindow") and not self:Get("autoShotNoCast"))
end

function M:UpdateVisibility()
    local f = self.timer
    local pos = self:Get("position")
    local shows = self:Get("shows")
    -- Off: no events either
    if shows == "off" then f:Deactivate() else f:Activate() end
    -- SuuUI's role (chosen, assigned or from talents), in a group only
    local healer = IsInGroup() and SuuUI.Role() == "HEALER"
    local shown = shows ~= "off" and not pos.hidden
        and not (self:Get("hideForHealers") and healer)
        and not (shows == "combat" and not UI.Flag(UnitAffectingCombat("player")))
    f:SetShown(shown and true or false)
end

local function isOff()
    return M:Get("shows") == "off", "Turn the swing timer on first."
end

-- Shown inside the cast bars' section, after its own groups (on its own while
-- the cast bars module is off).
local SECTION = {
    id = "swingtimer", label = "Swing timer", category = "Frames", order = 25, merge = "castbars",
    groups = {
        { title = "Swing timer", description = "Drawn from the game's own swing timer. Without the combat log SuuUI can't see parry haste or clipped swings, so it shows neither.", rows = {
            { key = "shows", label = "Show", control = "segmented",
              stacked = true, options = { { value = "off", label = "Off" }, { value = "combat", label = "In combat" }, { value = "always", label = "Always" } },
              description = "Off: no swing timer at all. In combat: out of combat it's gone." },
            { key = "hideForHealers", label = "Hide when you heal", control = "toggle", disabled = isOff,
              description = "With the healer role in a group, there is no swing timer." },
            { key = "autoShotWindow", label = "Auto Shot window", control = "toggle",
              description = "The last half second of a shot, when you must stand still, hatched at the end of the ranged bar; it turns amber while you move. It switches itself off if this client's Auto Shot fires while moving.",
              disabled = function()
                  if M:Get("autoShotNoCast") then return true, "This client's Auto Shot fires while you move, so there is no window." end
                  return isOff()
              end },
        } },
    },
}

function M:OnEnable()
    self.timer = self.timer or UI.SwingTimer(SuuUI.Root, { width = castWidth(), name = "SuuUISwingTimer",
        onNoAutoShotCast = function()
            self:Set("autoShotNoCast", true)
            self:Print("Auto Shot fired on time while you ran, so this client has no stand-still cast: the Auto Shot window is off.")
        end })
    self:ApplyAutoShot()
    self.timer.suuManagedShow = true
    self.timer:SetBarWidth(castWidth())
    self:RegisterMover(self.timer, { key = "position", label = "Swing timer",
        enabled = function() return self:Get("shows") ~= "off" end })
    self:Watch("shows", SuuUI.EditMode.Refresh)
    self:RegisterSettings(SECTION)
    -- as wide as your cast bar, live
    self:On("SUUUI_SETTING_CHANGED", function(_, namespace, key)
        if namespace == "castbars" and key == "playerWidth" then self.timer:SetBarWidth(castWidth()) end
    end)
    for _, e in ipairs({ "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED", "GROUP_ROSTER_UPDATE" }) do
        self:OnGameEvent(e, function() self:UpdateVisibility() end)
    end
    self:On("SUUUI_ROLE_CHANGED", function() self:UpdateVisibility() end)
    for _, key in ipairs({ "shows", "hideForHealers", "position" }) do
        self:Watch(key, function() self:UpdateVisibility() end)
    end
    self:Watch("autoShotWindow", function() self:ApplyAutoShot() end)
    self:UpdateVisibility()
end

function M:OnDisable()
    if self.timer then
        self.timer:Deactivate()
        self.timer:Hide()
    end
end
