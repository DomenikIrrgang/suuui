                    },
                    description = "Compact adds the per-second value (or the total, on DPS and HPS). Complete adds each player's share of the total. In combat the client hides the numbers' sums, so the share appears when combat ends.",
                },
                {
                    key = "rows",
                    label = "Rows",
                    control = "slider",
                    min = 4,
