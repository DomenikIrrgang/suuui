}
PREVIEW.dps, PREVIEW.hps = PREVIEW.damage, PREVIEW.healing
-- A value of one of the game's enums, if this client has it.
local function enumValue(enum: unknown, key: string): number?
    if type(enum) ~= "table" then
        return nil
    end
    local v = (enum :: { [string]: unknown })[key]
    return type(v) == "number" and v or nil
end

-- the preview's key of a meter type (the game's enum value, or the type's name)
local PREVIEW_TYPE: { [number | string]: string } = {}
for _, t in ipairs(UI.DAMAGE_METER_TYPES) do
    local value, enum = t.value, t.enum
    local id = enum and enumValue(Enum.DamageMeterType, enum)
    if value then
        PREVIEW_TYPE[id or value] = value
    end
end
-- a source's spells: the spell and its share
type PreviewSpell = { id: number, share: number }
local PREVIEW_SPELLS: PreviewSpell[] = {
    { id = 116, share = 0.42 },
    { id = 2136, share = 0.18 },
    { id = 120, share = 0.13 },
    { id = 1449, share = 0.11 },
    { id = 122, share = 0.09 },
    { id = 6603, share = 0.07 },
}
local PREVIEW_HEALS: PreviewSpell[] = {
    { id = 2060, share = 0.38 },
    { id = 139, share = 0.24 },
    { id = 2061, share = 0.2 },
    { id = 17, share = 0.12 },
    { id = 596, share = 0.06 },
}

-- A made-up source, as the game gives one.
local function previewSource(i: number, p: PreviewRow, myName: string, myClass: string): DamageMeterCombatSourceSecret
    local isYou = p.name == nil
    return {
        sourceGUID = "Preview-" .. i,
        name = isYou and myName or p.name or "",
        classFilename = isYou and myClass or p.class or "",
        specIconID = 0,
        totalAmount = p.amount,
        amountPerSecond = p.amount / PREVIEW_DURATION,
        isLocalPlayer = isYou,
        deathRecapID = p.recap or 0,
        deathTimeSeconds = p.died or 0,
        classification = "normal",
        sourceDisplayType = 0,
    }
end

local function previewSession(meterType: number): DamageMeterCombatSessionSecret
    local key = PREVIEW_TYPE[meterType] or "damage"
    local _, class = UnitClass("player")
    local name = UnitName("player")
    local myName = not issecretvalue(name) and name or ""
    local myClass = not issecretvalue(class) and class or ""
    local sources: DamageMeterCombatSourceSecret[], total, max = {}, 0, 0
    for i, p in ipairs(PREVIEW[key] or {}) do
        sources[i] = previewSource(i, p, myName, myClass)
        total, max = total + p.amount, math.max(max, p.amount)
    end
    return { combatSources = sources, totalAmount = total, maxAmount = max, durationSeconds = PREVIEW_DURATION }
end

-- A made-up source's spells (by its GUID; yours by your own too).
local function previewSpells(meterType: number, guid: string?): DamageMeterCombatSessionSourceSecret
    local key = PREVIEW_TYPE[meterType] or "damage"
    local guidOf = UnitGUID("player")
    local mine = not issecretvalue(guidOf) and guidOf or nil
    local amount: number? = nil
    for i, p in ipairs(PREVIEW[key] or {}) do
        if guid == "Preview-" .. i or (guid ~= nil and guid == mine and p.name == nil) then
            amount = p.amount
        end
    end
    if not amount then
        return { combatSpells = {}, totalAmount = 0, maxAmount = 0 }
    end
    local heals = key == "healing" or key == "hps"
    local spells: DamageMeterCombatSpellSecret[] = {}
    for i, sp in ipairs(heals and PREVIEW_HEALS or PREVIEW_SPELLS) do
        local part = math.floor(amount * sp.share)
        spells[i] = {
            spellID = sp.id,
            totalAmount = part,
            amountPerSecond = part / PREVIEW_DURATION,
            creatureName = "",
            overkillAmount = 0,
            isAvoidable = false,
            isDeadly = false,
            combatSpellDetails = {
                unitName = "",
                unitClassFilename = "",
                classification = "normal",
                isPet = false,
                isMob = false,
                amount = part,
                specIconID = 0,
            },
        }
    end
    return {
        combatSpells = spells,
        totalAmount = amount,
        maxAmount = math.floor(amount * (heals and PREVIEW_HEALS or PREVIEW_SPELLS)[1].share),
    }
end

local PREVIEW_API: MeterApi = {
    GetCombatSessionFromType = function(_: number, meterType: number): DamageMeterCombatSessionSecret
        return previewSession(meterType)
    end,
    GetCombatSessionFromID = function(_: number, meterType: number): DamageMeterCombatSessionSecret
        return previewSession(meterType)
    end,
    GetCombatSessionSourceFromType = function(
        _: number,
        meterType: number,
        guid: string?,
        _: number?
    ): DamageMeterCombatSessionSourceSecret
        return previewSpells(meterType, guid)
    end,
    GetCombatSessionSourceFromID = function(
        _: number,
        meterType: number,
        guid: string?,
        _: number?
    ): DamageMeterCombatSessionSourceSecret
        return previewSpells(meterType, guid)
    end,
    GetAvailableCombatSessions = function(): DamageMeterAvailableCombatSession[]
        return {
            { sessionID = 29, name = "Flamewaker Elite", durationSeconds = 38 },
            { sessionID = 30, name = "Majordomo Executus", durationSeconds = 96 },
            { sessionID = 31, name = "Ragnaros", durationSeconds = 151 },
        }
    end,
    GetSessionDurationSeconds = function(sessionType: number): number?
        return sessionType == enumValue(Enum.DamageMeterSessionType, "Overall") and 385 or PREVIEW_DURATION
    end,
}

-- one recap for every death: oldest first here, newest first as returned
-- (hp: the percent left after it; ago: seconds before the death)
type RecapStep = {
    spell: number,
    name: string,
    event: string,
    amount: number,
    hp: number,
    ago: number,
    overkill?: number,
}
local RECAP: RecapStep[] = {
    { spell = 21158, name = "Lava Burst", event = "SPELL_DAMAGE", amount = 1180, hp = 71, ago = 5.8 },
    { spell = 20566, name = "Wrath of Ragnaros", event = "SPELL_DAMAGE", amount = 1460, hp = 52, ago = 4.1 },
    { spell = 139, name = "Renew", event = "SPELL_HEAL", amount = 410, hp = 57, ago = 3.0 },
    { spell = 6603, name = "Melee", event = "SWING_DAMAGE", amount = 640, hp = 49, ago = 2.2 },
    { spell = 21158, name = "Lava Burst", event = "SPELL_DAMAGE", amount = 1240, hp = 32, ago = 1.0 },
    { spell = 20565, name = "Magma Blast", event = "SPELL_DAMAGE", amount = 2960, hp = 0, ago = 0, overkill = 1018 },
}
local PREVIEW_RECAP: RecapApi = {
    GetRecapEvents = function(_: number?): unknown
        local out: RecapEvent[] = {}
        for i = #RECAP, 1, -1 do
            local e = RECAP[i]
            out[#out + 1] = {
                spellId = e.spell,
                spellName = e.name,
                event = e.event,
                amount = e.amount,
                currentHP = e.hp * 40,
                timestamp = 1000 - e.ago,
                overkill = e.overkill or 0,
            }
        end
        return out
    end,
    GetRecapMaxHealth = function(_: number?): number?
        return 4000
    end,
}

local function meterHidden(): (boolean, string)
    return M:Get("shows") == "hidden", "Show the damage meter first."
end

