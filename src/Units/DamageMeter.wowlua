-- Units/DamageMeter.wowlua
-- The damage meter (step 1.12): Blizzard's own meter data (C_DamageMeter) in
-- SuuUI windows, bottom right (28px from the corner), the threat meter to
-- their left. Up to three windows stacked upward, each with its own type and
-- fight. Blizzard's meter is switched off (CVar damageMeterEnabled) while
-- this module runs and handed back when it stops. A built-in module written
-- against the public API only.
--
-- Updates: once a second in combat (the API fires its events constantly
-- then), on the meter's events out of combat, and again half a second and
-- a second and a half after combat (the values turn readable a moment
-- after combat ends).

import SuuUI from "/Core/API"
import type Position from "/EditMode/EditMode"
import after from "wowlua:timer"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local M = SuuUI.RegisterModule({
    id = "damagemeter",
    name = "Damage meter",
    description = "Blizzard's own damage meter, restyled: damage, healing, interrupts, deaths, per fight.",
    api = "0.10",
    combatSafe = true,
    defaults = {
        position = { point = "BOTTOMRIGHT", x = -28, y = 28 } :: Position,
        shows = "always",      -- "always" | "group" | "combat" | "hidden"
        numbers = "compact",   -- "minimal" | "compact" | "complete"
        rows = 9,
        barColor = "class",    -- "neutral" | "class"
        marker = "icon",       -- "icon" | "diamond" | "none"
        nameColor = "class",   -- "class" | "ink"
        pinYou = true,
        windowCount = 1,
        views = { { type = "damage" }, { type = "healing" }, { type = "deaths" } },
        blizzardWas = "",      -- Blizzard's damageMeterEnabled before SuuUI turned it off
    },
})

local TICK = 1
local GAP = S["space-4"]

local function inCombat() return InCombatLockdown() or UI.Flag(UnitAffectingCombat("player")) end

--------------------------------------------------------------------------------
-- Blizzard's meter
--------------------------------------------------------------------------------

function M:BlizzardOff()
    local ok, was = pcall(C_CVar.GetCVar, "damageMeterEnabled")
    if not ok or was == nil then return end
    if self:Get("blizzardWas") == "" then self:Set("blizzardWas", was) end
    if was ~= "0" then pcall(C_CVar.SetCVar, "damageMeterEnabled", "0") end
end

function M:BlizzardBack()
    local was = self:Get("blizzardWas")
    if was ~= "" then
        pcall(C_CVar.SetCVar, "damageMeterEnabled", was)
        self:Set("blizzardWas", "")
    end
end

--------------------------------------------------------------------------------
-- Windows
--------------------------------------------------------------------------------

function M:ViewOf(i: number): { [string]: any }
    local views = self:Get("views")
    return views[i] or { type = "damage" }
end

function M:SaveView(i: number, typeValue: any, session: any)
    local views = self:Get("views")
    local copy = {}
    for k, v in ipairs(views) do copy[k] = { type = v.type, session = v.session } end
    copy[i] = copy[i] or {}
    copy[i].type = typeValue
    -- past fights don't outlive the session: only Current and Overall are kept
    copy[i].session = (session == "overall") and "overall" or nil
    self:Set("views", copy)
end

function M:Window(i: number): any
    self.windows = self.windows or {}
    local w = self.windows[i]
    if not w then
        w = UI.DamageMeter(self.frame, {
            rows = self:Get("rows"),
            onView = function(typeValue: any, session: any) self:SaveView(i, typeValue, session) end,
            onNewWindow = function() self:Set("windowCount", math.min(3, self:Get("windowCount") + 1)) end,
            onClose = i > 1 and function() self:CloseWindow(i) end or nil,
            onReset = function()
                if C_DamageMeter and C_DamageMeter.ResetAllCombatSessions then C_DamageMeter.ResetAllCombatSessions() end
            end,
            onSettings = function() SuuUI.OpenSettings("damagemeter") end,
        })
        self.windows[i] = w
        local view = self:ViewOf(i)
        w:SetView(view.type, view.session or "current")
    end
    return w
end

-- Closing window i: the windows above it move down a place (their views too).
function M:CloseWindow(i: number)
    local views = self:Get("views")
    local copy = {}
    for k, v in ipairs(views) do
        if k ~= i then copy[#copy + 1] = { type = v.type, session = v.session } end
    end
    copy[#copy + 1] = { type = "damage" }
    self:Set("views", copy)
    for j = i, 3 do
        local w = self.windows and self.windows[j]
        if w then w:SetView(copy[j].type, copy[j].session or "current") end
    end
    self:Set("windowCount", math.max(1, self:Get("windowCount") - 1))
end

function M:MeterOptions()
    return { numbers = self:Get("numbers"), barColor = self:Get("barColor"), marker = self:Get("marker"),
             nameColor = self:Get("nameColor"), pinYou = self:Get("pinYou") }
end

-- The stack: window 1 at the bottom, the others above it.
function M:Layout()
    local n = math.max(1, math.min(3, self:Get("windowCount")))
    local y = 0
    local width = UI.Size("meter-w")
    for i = 1, 3 do
        local w = (i <= n or (self.windows and self.windows[i])) and self:Window(i)
        if w then
            if i <= n then
                w:SetMaxRows(self:Get("rows"))
                w:SetOptions(self:MeterOptions())
                w:SetCanAddWindow(n < 3)
                w:ClearAllPoints()
                w:SetPoint("BOTTOMRIGHT", self.frame, "BOTTOMRIGHT", 0, y)
                w:Show()
                y = y + w:GetHeight() + GAP
            else
                w:Hide()
            end
        end
    end
    self.frame:SetSize(width, math.max(1, y - GAP))
end

function M:Refresh()
    for i = 1, math.min(3, self:Get("windowCount")) do
        local w = self.windows and self.windows[i]
        if w and w:IsShown() then w:Refresh() end
    end
end

function M:UpdateVisibility()
    local shows = self:Get("shows")
    local shown = not self:Get("position").hidden and (shows == "always"
        or (shows == "group" and UI.Flag(IsInGroup()))
        or (shows == "combat" and inCombat()))
    self.frame:SetShown(shown and true or false)
    -- the ticker: in combat while shown
    self.driver:SetShown(shown and inCombat() and true or false)
    if shown then self:Refresh() end
end

-- Out of combat: one refresh shortly after a burst of events.
function M:Soon(delay: number?)
    if self.pending then return end
    self.pending = true
    after(delay or 0.2, function()
        self.pending = nil
        if self:IsEnabled() and self.frame:IsShown() then self:Refresh() end
    end)
end

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

-- The preview's stand-ins for C_DamageMeter and C_DeathRecap: a made-up
-- raid fight with you in it (your name and class), the same shapes the game
-- returns, so the preview behaves like the meter (types, fights, breakdowns,
-- the death recap).
local PREVIEW_DURATION = 102
local PREVIEW = {
    damage = { { "Morrow", "ROGUE", 98412 }, { "Lisset", "MAGE", 91870 }, { "Quell", "WARLOCK", 88240 }, { "Vosk", "WARRIOR", 84903 },
        { "Corvane", "ROGUE", 80115 }, { "Arlo", "HUNTER", 77402 }, { "Grimbolt", "WARLOCK", 74950 }, { "Sylva", "HUNTER", 71288 },
        { "Brannoc", "WARRIOR", 64130 }, { true, nil, 61775 }, { "Tamsin", "DRUID", 52004 }, { "Hadrin", "WARRIOR", 39410 } },
    damageTaken = { { "Brannoc", "WARRIOR", 84210 }, { "Hadrin", "WARRIOR", 51230 }, { true, nil, 18420 }, { "Morrow", "ROGUE", 9310 }, { "Lisset", "MAGE", 6120 } },
    avoidable = { { true, nil, 4120 }, { "Arlo", "HUNTER", 2980 }, { "Quell", "WARLOCK", 1210 } },
    enemyDamageTaken = { { "Flamewaker Elite", "", 151200 }, { "Lava Surger", "", 98400 }, { "Ember Hound", "", 61200 } },
    healing = { { "Ysolde", "PRIEST", 182440 }, { "Veyra", "SHAMAN", 171210 }, { "Aldric", "PALADIN", 160880 }, { "Thessaly", "DRUID", 120300 },
        { "Oren", "PRIEST", 98500 }, { "Brannoc", "WARRIOR", 3020 }, { true, nil, 1840 } },
    interrupts = { { "Morrow", "ROGUE", 7 }, { "Corvane", "ROGUE", 5 }, { "Vosk", "WARRIOR", 4 }, { true, nil, 3 }, { "Brannoc", "WARRIOR", 2 } },
    dispels = { { "Ysolde", "PRIEST", 6 }, { "Aldric", "PALADIN", 4 }, { "Veyra", "SHAMAN", 3 } },
    -- newest first, as the game returns them
    deaths = { { "Arlo", "HUNTER", 0, 140, 3 }, { true, nil, 0, 124, 2 }, { "Grimbolt", "WARLOCK", 0, 72, 1 } },
}
PREVIEW.dps, PREVIEW.hps = PREVIEW.damage, PREVIEW.healing
local PREVIEW_TYPE = {}
for _, t in ipairs(UI.DAMAGE_METER_TYPES) do if t.value then PREVIEW_TYPE[Enum.DamageMeterType and Enum.DamageMeterType[t.enum] or t.value] = t.value end end
local PREVIEW_SPELLS = { { 116, 0.42 }, { 2136, 0.18 }, { 120, 0.13 }, { 1449, 0.11 }, { 122, 0.09 }, { 6603, 0.07 } }
local PREVIEW_HEALS = { { 2060, 0.38 }, { 139, 0.24 }, { 2061, 0.2 }, { 17, 0.12 }, { 596, 0.06 } }

local function previewSession(meterType: any): { [string]: any }
    local key = PREVIEW_TYPE[meterType] or "damage"
    local _, myClass = UnitClass("player")
    local sources, total, max = {}, 0, 0
    for i, p in ipairs(PREVIEW[key] or {}) do
        local you = p[1] == true
        local amount = p[3]
        sources[i] = {
            name = you and UnitName("player") or p[1], classFilename = you and myClass or p[2],
            totalAmount = amount, amountPerSecond = amount / PREVIEW_DURATION, isLocalPlayer = you,
            sourceGUID = "Preview-" .. i, deathTimeSeconds = p[4] or 0, deathRecapID = p[5] or 0,
        }
        total, max = total + amount, math.max(max, amount)
    end
    return { combatSources = sources, totalAmount = total, maxAmount = max, durationSeconds = PREVIEW_DURATION }
end

local PREVIEW_API = {
    GetCombatSessionFromType = function(_: any, meterType: any) return previewSession(meterType) end,
    GetCombatSessionFromID = function(_: any, meterType: any) return previewSession(meterType) end,
    GetCombatSessionSourceFromType = function(_: any, meterType: any, guid: any)
        local s = previewSession(meterType)
        local src
        for _, x in ipairs(s.combatSources) do if x.sourceGUID == guid or (guid == (UnitGUID("player") :: string?) and x.isLocalPlayer) then src = x end end
        if not src then return { combatSpells = {}, totalAmount = 0, maxAmount = 0 } end
        local heals = PREVIEW_TYPE[meterType] == "healing" or PREVIEW_TYPE[meterType] == "hps"
        local spells = {}
        for i, sp in ipairs(heals and PREVIEW_HEALS or PREVIEW_SPELLS) do
            local amount = math.floor(src.totalAmount * sp[2])
            spells[i] = { spellID = sp[1], totalAmount = amount, amountPerSecond = amount / PREVIEW_DURATION, creatureName = "" }
        end
        return { combatSpells = spells, totalAmount = src.totalAmount, maxAmount = spells[1] and spells[1].totalAmount or 0 }
    end,
    GetAvailableCombatSessions = function()
        return { { sessionID = 29, name = "Flamewaker Elite", durationSeconds = 38 }, { sessionID = 30, name = "Majordomo Executus", durationSeconds = 96 },
                 { sessionID = 31, name = "Ragnaros", durationSeconds = 151 } }
    end,
    GetSessionDurationSeconds = function(sessionType: any)
        return sessionType == (Enum.DamageMeterSessionType and Enum.DamageMeterSessionType.Overall) and 385 or PREVIEW_DURATION
    end,
}
PREVIEW_API.GetCombatSessionSourceFromID = PREVIEW_API.GetCombatSessionSourceFromType

-- one recap for every death: oldest first here, newest first as returned
local RECAP: any[][] = {
    { 21158, "Lava Burst", "SPELL_DAMAGE", 1180, 71, 5.8 }, { 20566, "Wrath of Ragnaros", "SPELL_DAMAGE", 1460, 52, 4.1 },
    { 139, "Renew", "SPELL_HEAL", 410, 57, 3.0 }, { 6603, "Melee", "SWING_DAMAGE", 640, 49, 2.2 },
    { 21158, "Lava Burst", "SPELL_DAMAGE", 1240, 32, 1.0 }, { 20565, "Magma Blast", "SPELL_DAMAGE", 2960, 0, 0, 1018 },
}
local PREVIEW_RECAP = {
    GetRecapEvents = function()
        local out = {}
        for i = #RECAP, 1, -1 do
            local e = RECAP[i]
            out[#out + 1] = { spellId = e[1], spellName = e[2], event = e[3], amount = e[4], currentHP = e[5] * 40,
                              timestamp = 1000 - e[6], overkill = e[7] or 0 }
        end
        return out
    end,
    GetRecapMaxHealth = function() return 4000 end,
}

function M:PreviewView(parent: any): any
    if not self.preview then
        local view = CreateFrame("Frame", nil, parent)
        self.preview = view
        self.previewMeter = UI.DamageMeter(view, { rows = self:Get("rows"), api = PREVIEW_API, recapApi = PREVIEW_RECAP })
        self.previewMeter:SetView("damage", "current")
    end
    local view = self.preview
    view:SetParent(parent)
    local meter = self.previewMeter
    meter:SetMaxRows(self:Get("rows"))
    meter:SetOptions(self:MeterOptions())
    meter:ClearAllPoints()
    -- the threat meter above, as in game (its module's preview)
    local threat = SuuUI.GetModule("threat")
    local tv = threat and threat:IsEnabled() and threat.PreviewView and threat:PreviewView(view)
    local h = meter:GetHeight()
    if tv then
        tv:ClearAllPoints()
        tv:SetPoint("TOP", view, "TOP", 0, 0)
        meter:SetPoint("TOP", tv, "BOTTOM", 0, -S["space-4"])
        h = h + tv:GetHeight() + S["space-4"]
    else
        meter:SetPoint("TOP", view, "TOP", 0, 0)
    end
    view:SetSize(UI.Size("meter-w") + 10, h)
    return view
end

local function meterHidden()
    return M:Get("shows") == "hidden", "Show the damage meter first."
end

local SECTION = {
    id = "damagemeter", label = "Damage & threat", category = "Insights", order = 50,
    preview = function(parent: any) return M:PreviewView(parent) end,
    previewTitle = "Live preview · Damage & threat",
    groups = {
        { title = "Damage meter", description = "Blizzard's own meter, restyled. Blizzard's meter window stays off while this one is on.", rows = {
            { key = "shows", label = "Show", control = "segmented", stacked = true,
              options = { { value = "always", label = "Always" }, { value = "group", label = "In a group" },
                          { value = "combat", label = "In combat" }, { value = "hidden", label = "Hidden" } } },
            { key = "numbers", label = "Numbers", control = "segmented", disabled = meterHidden,
              options = { { value = "minimal", label = "Minimal" }, { value = "compact", label = "Compact" }, { value = "complete", label = "Complete" } },
              description = "Compact adds the per-second value (or the total, on DPS and HPS). Complete adds each player's share of the total. In combat the client hides the numbers' sums, so the share appears when combat ends." },
            { key = "rows", label = "Rows", control = "slider", min = 4, max = 15, step = 1, disabled = meterHidden,
              description = "The meter keeps this height; the threat meter matches it." },
            { key = "barColor", label = "Bars", control = "segmented", disabled = meterHidden,
              options = { { value = "neutral", label = "Neutral" }, { value = "class", label = "Class colour" } },
              description = "Class colours are identity: SuuUI keeps them on names and icons unless you ask. On class-coloured bars, names are ink." },
            { key = "marker", label = "Before the name", control = "segmented", disabled = meterHidden,
              options = { { value = "icon", label = "Class icon" }, { value = "diamond", label = "Diamond" }, { value = "none", label = "None" } } },
            { key = "nameColor", label = "Names", control = "segmented", disabled = meterHidden,
              options = { { value = "class", label = "Class colour" }, { value = "ink", label = "Ink" } } },
            { key = "pinYou", label = "Keep my row in view", control = "toggle", disabled = meterHidden,
              description = "Below the visible rows, your row takes the last slot." },
            { key = "windowCount", label = "Windows", control = "stepper", min = 1, max = 3, step = 1, disabled = meterHidden,
              description = "Up to three, stacked, each with its own type and fight (pick them in the window's head)." },
        } },
    },
}

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

function M:OnEnable()
    if not C_DamageMeter then
        self:Print("This client has no damage meter API.")
        return
    end
    if not self.frame then
        self.frame = CreateFrame("Frame", "SuuUIDamageMeter", SuuUI.Root)
        self.frame:SetFrameStrata("MEDIUM")
        self.driver = CreateFrame("Frame")
        self.driver:Hide()
        local wait = 0
        self.driver:SetScript("OnUpdate", function(_, elapsed)
            wait = wait - elapsed
            if wait > 0 then return end
            wait = TICK
            self:Refresh()
        end)
    end
    self.frame.suuManagedShow = true
    self:BlizzardOff()
    self:Layout()
    self:RegisterMover(self.frame, { key = "position", label = "Damage meter",
        enabled = function() return self:Get("shows") ~= "hidden" end })
    self:RegisterSettings(SECTION)
    self:Watch("shows", function() SuuUI.EditMode.Refresh(); self:UpdateVisibility() end)
    self:Watch("position", function() self:UpdateVisibility() end)
    self:WatchAll({ "numbers", "barColor", "marker", "nameColor", "pinYou" }, function()
        local o = self:MeterOptions()
        for _, w in ipairs(self.windows or {}) do w:SetOptions(o) end
        if self.previewMeter then self.previewMeter:SetOptions(o) end
    end)
    self:WatchAll({ "rows", "windowCount" }, function()
        self:Layout()
        if self.previewMeter then self.previewMeter:SetMaxRows(self:Get("rows")) end
        SuuUI.EditMode.Refresh()
    end)
    for _, e in ipairs({ "DAMAGE_METER_COMBAT_SESSION_UPDATED", "DAMAGE_METER_CURRENT_SESSION_UPDATED", "DAMAGE_METER_RESET" }) do
        self:OnGameEvent(e, function()
            if not inCombat() then self:Soon(0.2) end
        end)
    end
    self:OnGameEvent("PLAYER_REGEN_DISABLED", function() self:UpdateVisibility() end)
    self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
        self:UpdateVisibility()
        -- the numbers turn readable a moment after combat
        after(0.5, function() if self:IsEnabled() then self:Refresh() end end)
        after(1.5, function() if self:IsEnabled() then self:Refresh() end end)
    end)
    self:OnGameEvent("GROUP_ROSTER_UPDATE", function() self:UpdateVisibility() end)
    local valid = C_EventUtils and C_EventUtils.IsEventValid
    if not valid or valid("ADDON_RESTRICTION_STATE_CHANGED") then
        self:OnGameEvent("ADDON_RESTRICTION_STATE_CHANGED", function() self:Soon(0.2) end)
    end
    self:UpdateVisibility()
end

function M:OnDisable()
    if self.driver then self.driver:Hide() end
    if self.frame then self.frame:Hide() end
    self:BlizzardBack()
end
