        row("Morrow", "ROGUE", 98412),
        row("Lisset", "MAGE", 91870),
        row("Quell", "WARLOCK", 88240),
        row("Vosk", "WARRIOR", 84903),
        row("Corvane", "ROGUE", 80115),
