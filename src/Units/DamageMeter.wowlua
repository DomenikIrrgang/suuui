-- The preview's stand-ins for C_DamageMeter and C_DeathRecap: a made-up
-- raid fight with you in it (your name and class), the same shapes the game
-- returns, so the preview behaves like the meter (types, fights, breakdowns,
-- the death recap).
local PREVIEW_DURATION = 102

-- A made-up player of the preview's fight (no name: you), what they did,
-- and (deaths) when they died and their recap.
type PreviewRow = { name?: string, class?: string, amount: number, died?: number, recap?: number }
local function row(name: string, class: string, amount: number): PreviewRow
    return { name = name, class = class, amount = amount }
end
local function you(amount: number): PreviewRow
    return { amount = amount }
end
local function death(name: string?, class: string?, died: number, recap: number): PreviewRow
    return { name = name, class = class, amount = 0, died = died, recap = recap }
end

