--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

class DamageMeterModule extends Module<typeof(DEFAULTS)>
    driver: Frame? = nil
    frame: Frame? = nil
    pending: boolean? = nil
    preview: Frame? = nil
    previewMeter: DamageMeter? = nil
    -- the windows made so far (1 to 3), shown or not
    windows: DamageMeter[] = {}

    constructor()
        super({
            id = "damagemeter",
            name = "Damage meter",
            description = "Blizzard's own damage meter, restyled: damage, healing, interrupts, deaths, per fight.",
            api = "0.10",
            combatSafe = true,
            defaults = DEFAULTS,
        })
    end

    function BlizzardOff()
        local ok, was = pcall(C_CVar.GetCVar, "damageMeterEnabled")
        if not ok or was == nil then
            return
        end
        if self:Get("blizzardWas") == "" then
            self:Set("blizzardWas", was)
        end
        if was ~= "0" then
            pcall(C_CVar.SetCVar, "damageMeterEnabled", "0")
        end
    end

    function BlizzardBack()
        local was = self:Get("blizzardWas")
        if was ~= "" then
            pcall(C_CVar.SetCVar, "damageMeterEnabled", was)
            self:Set("blizzardWas", "")
        end
    end

    function ViewOf(i: number): View
        local views = self:Get("views")
        return views[i] or { type = "damage" }
    end

    function SaveView(i: number, typeValue: string, session: MeterSession)
        local views = self:Get("views")
        local copy: View[] = {}
        for k, v in ipairs(views) do
            copy[k] = { type = v.type, session = v.session }
        end
        -- past fights don't outlive the session: only Current and Overall are kept
        copy[i] = { type = typeValue, session = (session == "overall") and "overall" or nil }
        self:Set("views", copy)
    end

    -- Window i (made the first time; the module's frame must be made).
    function Window(i: number): DamageMeter
        local w = self.windows[i]
        if not w then
            w = UI.DamageMeter(assert(self.frame), {
                rows = self:Get("rows"),
                onView = function(typeValue: string, session: MeterSession)
                    self:SaveView(i, typeValue, session)
                end,
                onNewWindow = function()
                    self:Set("windowCount", math.min(3, self:Get("windowCount") + 1))
                end,
                onClose = i > 1 and
                    function()
                        self:CloseWindow(i)
                    end or
                    nil,
                onReset = function()
                    if C_DamageMeter and C_DamageMeter.ResetAllCombatSessions then
                        C_DamageMeter.ResetAllCombatSessions()
                    end
                end,
                onSettings = function()
                    SuuUI.OpenSettings("damagemeter")
                end,
            })
            self.windows[i] = w
            local view = self:ViewOf(i)
            w:SetView(view.type, view.session or "current")
        end
        return w
    end

    -- Closing window i: the windows above it move down a place (their views too).
    function CloseWindow(i: number)
        local views = self:Get("views")
        local copy: View[] = {}
        for k, v in ipairs(views) do
            if k ~= i then
                copy[#copy + 1] = { type = v.type, session = v.session }
            end
        end
        copy[#copy + 1] = { type = "damage" }
        self:Set("views", copy)
        for j = i, 3 do
            local w = self.windows[j]
            if w then
                w:SetView(copy[j].type, copy[j].session or "current")
            end
        end
        self:Set("windowCount", math.max(1, self:Get("windowCount") - 1))
    end

    function MeterOptions(): MeterView
        return {
            numbers = self:Get("numbers"),
            barColor = self:Get("barColor"),
            marker = self:Get("marker"),
            nameColor = self:Get("nameColor"),
            pinYou = self:Get("pinYou"),
        }
    end

    -- The stack: window 1 at the bottom, the others above it.
    function Layout()
        local frame = self.frame
        if not frame then
            return
        end
        local n = math.max(1, math.min(3, self:Get("windowCount")))
        local y = 0
        local width = UI.Size("meter-w")
        for i = 1, 3 do
            local w = (i <= n or self.windows[i]) and self:Window(i)
            if w then
                if i <= n then
                    w:SetMaxRows(self:Get("rows"))
                    w:SetOptions(self:MeterOptions())
                    w:SetCanAddWindow(n < 3)
                    w:ClearAllPoints()
                    w:SetPoint("BOTTOMRIGHT", frame, "BOTTOMRIGHT", 0, y)
                    w:Show()
                    y = y + w:GetHeight() + GAP
                else
                    w:Hide()
                end
            end
        end
        frame:SetSize(width, math.max(1, y - GAP))
    end

    function Refresh()
        for i = 1, math.min(3, self:Get("windowCount")) do
            local w = self.windows[i]
            if w and w:IsShown() then
                w:Refresh()
            end
        end
    end

    function UpdateVisibility()
        local frame, driver = self.frame, self.driver
        if not (frame and driver) then
            return
        end
        local shows = self:Get("shows")
        local shown = not self:Get("position").hidden and
            (shows == "always" or (shows == "group" and secret.flag(IsInGroup())) or (shows == "combat" and inCombat()))
        frame:SetShown(shown and true or false)
        -- the ticker: in combat while shown
        driver:SetShown(shown and inCombat() and true or false)
        if shown then
            self:Refresh()
        end
    end

    -- Out of combat: one refresh shortly after a burst of events.
    function Soon(delay: number?)
        if self.pending then
            return
        end
        self.pending = true
        after(delay or 0.2, function()
            self.pending = nil
            local frame = self.frame
            if self:IsEnabled() and frame and frame:IsShown() then
                self:Refresh()
            end
        end)
    end

    function PreviewView(parent: Frame): Frame
        local view, meter = self.preview, self.previewMeter
        if not (view and meter) then
            view = CreateFrame("Frame", nil, parent)
            self.preview = view
            meter = UI.DamageMeter(view, { rows = self:Get("rows"), api = PREVIEW_API, recapApi = PREVIEW_RECAP })
            meter:SetView("damage", "current")
            self.previewMeter = meter
        end
        view:SetParent(parent)
        meter:SetMaxRows(self:Get("rows"))
        meter:SetOptions(self:MeterOptions())
        meter:ClearAllPoints()
        -- the threat meter above, as in game (its module's preview)
        local threat = SuuUI.GetModule("threat")
        local previewView = threat and threat:IsEnabled() and threat.PreviewView
        local tv = type(previewView) == "function" and frames.asFrame(previewView(threat, view)) or nil
        local h = meter:GetHeight()
        if tv then
            tv:ClearAllPoints()
            tv:SetPoint("TOP", view, "TOP", 0, 0)
            meter:SetPoint("TOP", tv, "BOTTOM", 0, -S["space-4"])
            h = h + tv:GetHeight() + S["space-4"]
        else
            meter:SetPoint("TOP", view, "TOP", 0, 0)
        end
        view:SetSize(UI.Size("meter-w") + 10, h)
        return view
    end

    override function OnEnable()
        if not C_DamageMeter then
            self:Print("This client has no damage meter API.")
            return
        end
        local frame = self.frame
        if not frame then
            frame = CreateFrame("Frame", "SuuUIDamageMeter", SuuUI.Root)
            frame:SetFrameStrata("MEDIUM")
            self.frame = frame
            local driver = CreateFrame("Frame")
            driver:Hide()
            local wait = 0
            driver:SetScript("OnUpdate", function(_: Frame, elapsed: number)
                wait = wait - elapsed
                if wait > 0 then
                    return
                end
                wait = TICK
                self:Refresh()
            end)
            self.driver = driver
        end
        self:BlizzardOff()
        self:Layout()
        self:RegisterMover(frame, {
            key = "position",
            label = "Damage meter",
            managedShow = true,
            enabled = function()
                return self:Get("shows") ~= "hidden"
            end,
        })
        self:RegisterSettings(SECTION)
        self:Watch("shows", function()
            SuuUI.EditMode.Refresh()
            self:UpdateVisibility()
        end)
        self:Watch("position", function()
            self:UpdateVisibility()
        end)
        self:WatchAll({ "numbers", "barColor", "marker", "nameColor", "pinYou" }, function()
            local o = self:MeterOptions()
            for _, w in ipairs(self.windows) do
                w:SetOptions(o)
            end
            local preview = self.previewMeter
            if preview then
                preview:SetOptions(o)
            end
        end)
        self:WatchAll({ "rows", "windowCount" }, function()
            self:Layout()
            local preview = self.previewMeter
            if preview then
                preview:SetMaxRows(self:Get("rows"))
            end
            SuuUI.EditMode.Refresh()
        end)
        for _, e in ipairs({
            "DAMAGE_METER_COMBAT_SESSION_UPDATED",
            "DAMAGE_METER_CURRENT_SESSION_UPDATED",
            "DAMAGE_METER_RESET",
        }) do
            self:OnGameEvent(e, function()
                if not inCombat() then
                    self:Soon(0.2)
                end
            end)
        end
        self:OnGameEvent("PLAYER_REGEN_DISABLED", function()
            self:UpdateVisibility()
        end)
        self:OnGameEvent("PLAYER_REGEN_ENABLED", function()
            self:UpdateVisibility()
            -- the numbers turn readable a moment after combat
            after(0.5, function()
                if self:IsEnabled() then
                    self:Refresh()
                end
            end)
            after(1.5, function()
                if self:IsEnabled() then
                    self:Refresh()
                end
            end)
        end)
        self:OnGameEvent("GROUP_ROSTER_UPDATE", function()
            self:UpdateVisibility()
        end)
        self:OnGameEvent("ADDON_RESTRICTION_STATE_CHANGED", function()
            self:Soon(0.2)
        end)
        self:UpdateVisibility()
    end

    override function OnDisable()
        if self.driver then
            self.driver:Hide()
        end
        if self.frame then
            self.frame:Hide()
        end
        self:BlizzardBack()
    end
end

M = SuuUI.AddModule(DamageMeterModule.new())
