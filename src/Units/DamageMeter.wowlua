    previewTitle = "Live preview · Damage & threat",
    groups = {
        {
            title = "Damage meter",
            description = "Blizzard's own meter, restyled. Blizzard's meter window stays off while this one is on.",
            rows = {
                {
                    key = "shows",
                    label = "Show",
                    control = "segmented",
                    stacked = true,
                    options = {
                        { value = "always", label = "Always" },
                        { value = "group", label = "In a group" },
                        { value = "combat", label = "In combat" },
                        { value = "hidden", label = "Hidden" },
                    },
                },
                {
                    key = "numbers",
                    label = "Numbers",
                    control = "segmented",
                    disabled = meterHidden,
                    options = {
                        { value = "minimal", label = "Minimal" },
                        { value = "compact", label = "Compact" },
