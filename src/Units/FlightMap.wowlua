-- Units/FlightMap.wowlua
-- The flight map (design "Flight paths", D: one map for flying): no window
-- of its own. At a flight master SuuUI's world map becomes the taxi map:
-- the continent with every flight master of yours (the ones you haven't
-- found faint, their edge dashed), the routes between those you have as
-- faint lines, each destination's flight time beside it, and the
-- destinations listed in the side panel over the quest log. Hovering one
-- draws its route; clicking it flies there, or (Confirm before flying) puts
-- where it stops, the cost, the time and Fly in a bar at the map's bottom.
-- In the air the same map shows your flight: the part flown solid, the rest
-- dashed, the time left at the destination; with the map closed, the flight
-- bar at the top of the screen does (the time left, the stops passed and
-- ahead, when you land), with Land at to come down at the next stop.
-- Every route is drawn the way
-- the game flies it (SuuUI.FlightPaths: its waypoints, put on the shown map
-- through world coordinates), else straight from master to master.
--
-- The game's own flight map (TaxiFrame) stays open underneath, unseen and
-- without the mouse: hiding it ends the flight master's session, alpha 0
-- keeps it, and TakeTaxiNode from SuuUI's click flies (probed 2026-10-19).
-- The world map is shown outside the game's panel manager: through it, it
-- would take TaxiFrame's place (both are "left" panels) and close it.
-- Closing the map closes the flight master too. In combat the game's own
-- flight map opens as it would.
--
-- Flight times: each flight is timed, from losing control to getting it
-- back, and kept per route (the nodes it passes) for the whole account; a
-- route not flown yet is estimated from its length (SuuUI.FlightRoutes) at
-- the character's speed. That starts at 30.3 yards a second (fitted to
-- Classic's measured flight times; three flights on Forever came within
-- 0.4% of it, 2026-10-19), and each flight moves it a quarter of the way
-- toward what it measured. A flight far off its estimate (an early landing)
-- or begun before a reload teaches nothing; one set down at a stop by Land
-- at is timed as the route to that stop. The speed is kept per
-- character, should Forever give one a faster flight; a route's time
-- carries the speed of whoever flew it and is scaled to yours when the two
-- differ by more than 3%.
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"

local M = SuuUI.RegisterModule({
    id = "flightmap",
    name = "Flight map",
    description = "The world map as the flight master's map: routes, costs and flight times, and your flight on the map while you fly.",
    api = "0.17",
    combatSafe = true,
    defaults = { atMaster = true, inFlight = true, confirm = false, timer = true,
                 -- the flight bar: top centre, at the screen-edge inset
                 timerPosition = { point = "TOP", x = 0, y = -28 } },
})

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

-- A flight master on the flight master's map (M:ReadSession).
type TaxiNode = { slot: number, id: number, name: string, kind: string, cost: number, path?: number[] }
type Session = { nodes: TaxiNode[], byID: { [number]: TaxiNode }, current?: TaxiNode }
-- A map to draw on: its masters' places (0-1) and its size in px (M:Way).
type View = { map: number, pos: { [number]: number[] }, w: number, h: number }
-- A flight's route for the flight bar (M:FlightRoute).
-- (placed on the continent's map; else only each master's share, at)
type Route = { at: { [number]: number }, map?: number, w?: number, h?: number, points?: number[][], run?: number[], total?: number }
type PlacedRoute = { at: { [number]: number }, map: number, w: number, h: number, points: number[][], run: number[], total: number }

-- (the secret test first: a secret isn't compared, not even with nil)
local function plain(v: unknown): v is string | number | boolean | table
    return not issecretvalue(v) and v ~= nil
end

local TEXTURES = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local GLYPHS = TEXTURES .. "Glyphs\\"
local DISC = TEXTURES .. "CircleFill.tga"
local DASHED = TEXTURES .. "CircleDash.tga"

local SPEED = 30.3 -- yards a second, before a character has flown (see the header)
local LEARN = 0.25 -- how far one flight moves the speed toward what it measured
local TRUST = 0.2  -- a flight further than this off its expected time teaches nothing
local BOOST = 0.03 -- speeds further apart than this: another character's time is scaled
local KEEP = 5     -- a route's time: the mean of its last flights, up to this many
local MAX_FLIGHT = 1800 -- s: a flight kept over a reload longer than this is stale

local ROW_H = 36
local PIN = 26 -- UI.MapPin's size
local MAX_DASHES = 120 -- on one dashed line

--------------------------------------------------------------------------------
-- What the game gives
--------------------------------------------------------------------------------

-- "4:12"
local function clock(s: number): string
    s = math.max(0, math.floor(s + 0.5))
    return ("%d:%02d"):format(s / 60, s % 60)
end

-- "1s 10c" in coin colours (a tooltip's line; built as it shows)
local function coins(copper: number?): string
    copper = math.max(0, math.floor(copper or 0))
    local g, s, c = math.floor(copper / 10000), math.floor(copper / 100) % 100, copper % 100
    local parts: string[] = {}
    local function part(v: number, unit: string, token: string) parts[#parts + 1] = v .. "|cff" .. T.color[token].hex .. unit .. "|r" end
    if g > 0 then part(g, "g", "coin-gold") end
    if s > 0 or (g > 0 and c > 0) then part(s, "s", "coin-silver") end
    if c > 0 or #parts == 0 then part(c, "c", "coin-copper") end
    return table.concat(parts, " ")
end

-- "Crossroads, The Barrens" → "Crossroads"
local function short(name: any): string
    return name and name:match("^([^,]+)") or name or "?"
end

-- Taxi nodes the client still lists that no one flies to (an old copy of
-- Powderfuse Port, transports, quest flights)
local function junk(name: any): boolean
    return type(name) ~= "string" or issecretvalue(name) or name:find("^zzOLD") ~= nil or name:find("^Transport,") ~= nil
        or name:find("^Quest Path") ~= nil
end

local function continentOf(mapID: number?): number?
    local info = mapID and C_Map.GetMapInfo(mapID)
    local guard = 0
    while info and guard < 8 do
        if info.mapType == (Enum.UIMapType and Enum.UIMapType.Continent or 2) then return info.mapID end
        info = info.parentMapID and info.parentMapID > 0 and C_Map.GetMapInfo(info.parentMapID)
        guard = guard + 1
    end
end

-- Every flight master's place on a map, by nodeID (anywhere, a flight
-- master or not; a zone's map gives its continent's too, outside 0-1).
local function positions(mapID: number?): { [number]: number[] }
    local out: { [number]: number[] } = {}
    local ok, list = pcall(C_TaxiMap.GetTaxiNodesForMap, mapID :: any)
    for _, n in ipairs(ok and type(list) == "table" and list or {}) do
        local x, y
        if n.position and n.position.GetXY then x, y = n.position:GetXY() end
        if plain(n.nodeID) and plain(x) and plain(y) then out[n.nodeID] = { x, y } end
    end
    return out
end

local function hopYards(a: number, b: number): number?
    local routes = SuuUI.FlightRoutes()
    local ra, rb = routes[a], routes[b]
    return (ra and ra[b]) or (rb and rb[a])
end

-- A flight's length: its hops added up; nil when one isn't known.
local function pathYards(path: number[]): number?
    local total = 0
    for i = 1, #path - 1 do
        local y = hopYards(path[i], path[i + 1])
        if not y then return nil end
        total = total + y
    end
    return total
end

-- A hop's way on a map: its waypoints (SuuUI.FlightPaths(); the reverse
-- hop's backwards when only that one is there) as the map's positions, kept
-- per map; false when there's none, or when the map puts its ends away from
-- the two masters (pa, pb: their places on it), then it's drawn straight.
local ways: { [number]: { [string]: number[][] | false } } = {}

local function hopWay(mapID: number, a: number, b: number, pa: number[], pb: number[]): number[][] | false
    local mine = ways[mapID] or {}
    ways[mapID] = mine
    local key = a .. ">" .. b
    local got: number[][] | false | nil = mine[key]
    if got ~= nil then return got end
    got = false
    local paths = SuuUI.FlightPaths()
    local fromA, fromB = paths[a], paths[b]
    local data, back = fromA and fromA[b], false
    if not data then data, back = fromB and fromB[a], true end
    if data and C_Map.GetMapPosFromWorldPos and CreateVector2D then
        local points: number[][] = {}
        local way: number[][]? = points
        for i = 2, #data - 1, 2 do
            -- (the world's x, y as the client tables give them: x north, y west)
            local ok, onMap, pos = pcall(C_Map.GetMapPosFromWorldPos, data[1], CreateVector2D(data[i], data[i + 1]), mapID)
            local x, y
            if ok and onMap == mapID and pos and pos.GetXY then x, y = pos:GetXY() end
            if issecretvalue(x) or issecretvalue(y) or x == nil or y == nil then way = nil break end
            points[#points + 1] = { x, y }
        end
        if way and back then
            for i = 1, math.floor(#way / 2) do way[i], way[#way + 1 - i] = way[#way + 1 - i], way[i] end
        end
        if way and #way >= 2 then
            -- each end near its master: within a quarter of the hop
            local far = 0.25 * math.sqrt((pb[1] - pa[1]) ^ 2 + (pb[2] - pa[2]) ^ 2)
            local s, e = way[1], way[#way]
            if math.sqrt((s[1] - pa[1]) ^ 2 + (s[2] - pa[2]) ^ 2) <= far
                and math.sqrt((e[1] - pb[1]) ^ 2 + (e[2] - pb[2]) ^ 2) <= far then
                got = way
            end
        end
    end
    mine[key] = got
    return got
end

local function call(fn: any, ...: any): (any, any)
    if type(fn) ~= "function" then return nil end
    local ok, a, b = pcall(fn, ...)
    if ok then return a, b end
end

-- The flight master's map as the game gives it: { nodes (by slot), byID,
-- current } with each node { slot, id, name, kind ("CURRENT", "REACHABLE",
-- "DISTANT"), cost, path (the nodeIDs a flight there passes, from here) };
-- nil while there's none.
function M:ReadSession()
    local n = call(NumTaxiNodes)
    if not (plain(n) and n and n > 0) then return nil end
    -- nodeIDs by slot (C_TaxiMap's nodes carry both), by name to be sure
    local ids: { [number]: number }, byName: { [string]: number } = {}, {}
    local zone = C_Map.GetBestMapForUnit("player")
    for _, m in ipairs({ zone, continentOf(zone), call(_G.GetTaxiMapID) }) do
        local list = call(C_TaxiMap.GetAllTaxiNodes, m)
        for _, node in ipairs(type(list) == "table" and (list :: any[]) or {}) do
            if plain(node.nodeID) and plain(node.slotIndex) and node.slotIndex then ids[node.slotIndex] = ids[node.slotIndex] or node.nodeID end
            if plain(node.nodeID) and plain(node.name) and node.name then byName[node.name] = byName[node.name] or node.nodeID end
        end
        if next(ids) then break end
    end
    local s: Session = { nodes = {}, byID = {} }
    for slot = 1, n do
        local name, kind = call(TaxiNodeName, slot), call(TaxiNodeGetType, slot)
        local id = ids[slot]
        if not id and plain(name) then id = byName[name] end
        if plain(kind) and kind ~= "NONE" and not junk(name) and id then
            local cost = call(TaxiNodeCost, slot)
            local node: TaxiNode = { slot = slot, id = id, name = name, kind = kind, cost = plain(cost) and cost or 0 }
            s.nodes[#s.nodes + 1] = node
            s.byID[id] = node
            if kind == "CURRENT" then s.current = node end
        end
    end
    -- each destination's hops, slot to slot, as nodeIDs
    local slotID: { [number]: number } = {}
    for _, node in ipairs(s.nodes) do slotID[node.slot] = node.id end
    for _, node in ipairs(s.nodes) do
        if node.kind == "REACHABLE" then
            local hops = call(GetNumRoutes, node.slot)
            if plain(hops) and hops and hops > 0 then
                local first = slotID[call(TaxiGetNodeSlot, node.slot, 1, true)]
                local path: number[] = {}
                if first then path[1] = first end
                local whole = first ~= nil
                for r = 1, hops do
                    local id = slotID[call(TaxiGetNodeSlot, node.slot, r, false)]
                    if not id then whole = false break end
                    path[r + 1] = id
                end
                if whole then node.path = path end
            end
            -- (a route the game can't trace: straight there)
            if not node.path and s.current then node.path = { s.current.id, node.id } end
        end
    end
    if not s.current then return nil end
    return s
end

--------------------------------------------------------------------------------
-- Flight times
--------------------------------------------------------------------------------

-- the routes timed, for the account: [nodeID>nodeID>…] = { t (s), n, v (the
-- flyer's speed) }
local function timed(): { [string]: any }
    local data = SuuUI.AccountData("flightmap")
    data.routes = data.routes or {}
    return data.routes
end

function M:Speed()
    return self:CharData().speed or SPEED
end

-- A flight's time in seconds and whether it was measured: one flown on
-- this route before (scaled to your speed when its flyer's differed by
-- more than BOOST), else its length at your speed; nil when neither is
-- known.
function M:FlightTime(path: number[]?): (number?, boolean?)
    if not path then return nil end
    local mine = self:Speed()
    local r = timed()[table.concat(path, ">")]
    if r and r.t then
        local t = r.t
        if r.v and math.abs(r.v / mine - 1) > BOOST then t = t * r.v / mine end
        return t, true
    end
    local yards = pathYards(path)
    if yards then return yards / mine, false end
end

-- A flight landed after `seconds`: its route's time, and the character's
-- speed a step toward what it flew.
function M:Learn(flight: { path: number[], expected: number?, reloaded: boolean? }, seconds: number)
    local expected = flight.expected
    if flight.reloaded or seconds < 5 then return end
    if expected and math.abs(seconds / expected - 1) > TRUST then return end
    local data = self:CharData()
    local yards = pathYards(flight.path)
    if yards then
        local speed = self:Speed()
        data.speed = speed + LEARN * (yards / seconds - speed)
        data.flights = (data.flights or 0) + 1
    end
    local key = table.concat(flight.path, ">")
    local r = timed()[key] or {}
    r.n = math.min((r.n or 0) + 1, KEEP)
    r.t = r.t and (r.t + (seconds - r.t) / r.n) or seconds
    r.v = self:Speed()
    timed()[key] = r
end

--------------------------------------------------------------------------------
-- A flight: taken, in the air, landed
--------------------------------------------------------------------------------

-- TakeTaxiNode ran (SuuUI's Fly or the game's own map): the route it asked for.
function M:Taking(slot: number)
    local s = self.last or self:ReadSession()
    local node
    for _, n in ipairs(s and s.nodes or {}) do if n.slot == slot then node = n end end
    if not (node and node.path) then return end
    -- (the stops' names for the flight bar: in the air there's no session)
    local names: { [number]: string } = {}
    for _, id in ipairs(node.path) do
        local n = s.byID[id]
        if n then names[id] = short(n.name) end
    end
    self.pending = { path = node.path, at = GetTime(), names = names }
end

function M:FlightStarted(at: number)
    local p = self.pending
    if not (p and GetTime() - p.at < 15 and UnitOnTaxi("player")) then return end
    self.pending = nil
    local expected, measured = self:FlightTime(p.path)
    self.flight = { path = p.path, started = at, expected = expected, measured = measured, names = p.names }
    -- kept over a reload, to show (not to time: the start isn't exact then)
    self:CharData().flight = { path = p.path, wall = time() - (GetTime() - at), names = p.names }
    self:QueueLayout()
    self:UpdateTimer()
end

-- Landed: at the destination, its time is learned; set down by Land at at
-- the stop it asked for, the time of the route that far (the game flies it
-- as that route: probed 2026-10-19, Ratchet to Crossroads of a longer
-- flight landed in the hop's time); landed early elsewhere, nothing.
function M:FlightEnded(at: number)
    local f = self.flight
    if not f then return end
    self.flight = nil
    self:CharData().flight = nil
    local seconds = at - f.started
    local continent = continentOf(C_Map.GetBestMapForUnit("player"))
    local spots = continent and positions(continent)
    local me = continent and call(C_Map.GetPlayerMapPosition, continent, "player")
    local x, y
    if me and me.GetXY then x, y = me:GetXY() end
    -- (where the game doesn't say, taken as there)
    local function landedAt(id: number): boolean
        local p = spots and spots[id]
        if not (p and plain(x) and plain(y)) then return true end
        return math.sqrt((p[1] - x) ^ 2 + (p[2] - y) ^ 2) < 0.03
    end
    if f.early and landedAt(f.path[f.early]) then
        local path: number[] = {}
        for i = 1, f.early do path[i] = f.path[i] end
        self:Learn({ path = path, expected = self:FlightTime(path), reloaded = f.reloaded }, seconds)
    elseif landedAt(f.path[#f.path]) then
        self:Learn(f, seconds)
    end
    self:QueueLayout()
    self:UpdateTimer()
end

-- After a reload in the air: the flight kept, shown but not timed.
function M:ResumeFlight()
    local data = self:CharData()
    local kept = data.flight
    if not (kept and kept.path and kept.wall) then return end
    local ago = time() - kept.wall
    if not UnitOnTaxi("player") or ago > MAX_FLIGHT or ago < 0 then data.flight = nil return end
    local expected, measured = self:FlightTime(kept.path)
    self.flight = { path = kept.path, started = GetTime() - ago, expected = expected, measured = measured,
                    names = kept.names, early = kept.early, reloaded = true }
end

--------------------------------------------------------------------------------
-- The game's flight map, kept open underneath
--------------------------------------------------------------------------------

-- Unseen, and neither it nor anything on it takes the mouse (an unseen
-- node button would still fly where it was clicked). Only alpha and the
-- mouse: hidden, it closes the flight master.
function M:HideGameMap()
    local tf = _G.TaxiFrame
    if not tf then return false end
    self.gameQuiet = self.gameQuiet or {}
    tf:SetAlpha(0)
    local function quiet(f: any, depth: number)
        if f:IsMouseEnabled() then
            f:EnableMouse(false)
            self.gameQuiet[#self.gameQuiet + 1] = f
        end
        if depth < 3 then for _, c in ipairs({ f:GetChildren() }) do quiet(c, depth + 1) end end
    end
    quiet(tf, 0)
    return true
end

function M:ShowGameMap()
    local tf = _G.TaxiFrame
    if not (tf and self.gameQuiet) then return end
    tf:SetAlpha(1)
    for _, f in ipairs(self.gameQuiet) do f:EnableMouse(true) end
    self.gameQuiet = nil
end

--------------------------------------------------------------------------------
-- At the flight master: the world map as the flight map
--------------------------------------------------------------------------------

function M:AtMaster()
    return self.session ~= nil
end

-- The world map module's pins away while the flight map shows, back after.
local function refreshPins()
    local wm = SuuUI.GetModule("worldmap")
    if wm and wm:IsEnabled() and wm.map then wm:Refresh() end
end

function M:OnTaxiOpened()
    self.last = self:ReadSession()
    if self.session then self:LeaveMaster(false) end
    if not (self:Get("atMaster") and self.map) or InCombatLockdown() then return end
    -- unseen at once (no flicker); the world map a frame later, once the
    -- game has put its own map up (it would close the world map if that
    -- showed first)
    if not self:HideGameMap() then return end
    after(0, function() self:EnterMaster(true) end)
end

function M:EnterMaster(retry: boolean)
    if not self.gameQuiet then return end
    local s = self:ReadSession()
    if not s then
        -- (the nodes a moment later; else the game's own map after all)
        if retry then after(0.2, function() self:EnterMaster(false) end) else self:ShowGameMap() end
        return
    end
    self.last = s
    -- its new buttons, made as it showed, without the mouse too
    self:HideGameMap()
    self.session, self.selected, self.hovered = s, nil, nil
    local f = self.map
    if not f:IsShown() then f:Show() end
    local continent = continentOf(C_Map.GetBestMapForUnit("player"))
    if continent and f:GetMapID() ~= continent then f:SetMapID(continent) end
    self:FillSide()
    self:PlaceSide()
    self.side:Show()
    self:UpdateBar()
    self:SetTitle(true)
    self:QuietHeader(true)
    refreshPins()
    self:QueueLayout()
end

-- The flight master closed (walked away, flown, or the map closed):
-- the game's map back as it was; the world map closed with it.
function M:LeaveMaster(closeMap: boolean)
    local was = self.session ~= nil
    self.session, self.selected, self.hovered = nil, nil, nil
    self:ShowGameMap()
    if self.side then self.side:Hide() end
    if self.bar then self.bar:Hide() end
    if not was then return end
    self:SetTitle(false)
    self:QuietHeader(false)
    local f = self.map
    if closeMap and f and f:IsShown() then
        self.closing = true
        f:Hide()
        self.closing = false
    end
    refreshPins()
    self:QueueLayout()
end

-- the map's header: "Flight master · Thunder Bluff" while it's the flight
-- map, its usual "Kalimdor › Mulgore" after
function M:SetTitle(master: boolean)
    local chrome = self.map and self.map.suuChrome
    if not chrome then return end
    if master and self.session then
        chrome:SetTitle("Flight master · " .. short(self.session.current.name))
        return
    end
    local mapID = self.map:GetMapID()
    local info = mapID and C_Map.GetMapInfo(mapID)
    if not info then return end
    local continent = continentOf(mapID)
    local c
    if continent and continent ~= mapID then c = C_Map.GetMapInfo(continent) end
    chrome:SetTitle(c and (c.name .. " › " .. info.name) or info.name)
end

-- The header row's quest log controls (its search, count and settings) and
-- the waypoint pin: nothing to do at a flight master (asked 2026-10-19);
-- unseen and out of the mouse's way, back after. (The world map module
-- puts its own Map filters away.)
local function headerControls()
    local list = _G.QuestScrollFrame
    local f = _G.WorldMapFrame
    return { list and list.SearchBox, _G.QuestLogCount, list and list.SettingsDropdown, f and f.WorldMapTrackingPinButton }
end

function M:QuietHeader(on: boolean)
    for _, c in pairs(headerControls()) do
        if c then
            c:SetAlpha(on and 0 or 1)
            if c.EnableMouse then c:EnableMouse(not on) end
        end
    end
end

function M:Select(node: TaxiNode?)
    if not (self.session and node and node.kind == "REACHABLE") then return end
    self.selected = node
    self:UpdateBar()
    self:UpdateRows()
    self:QueueInk()
end

function M:Fly(node: TaxiNode?)
    node = node or self.selected
    if not (self.session and node) then return end
    TakeTaxiNode(node.slot)
end

-- A destination clicked (its pin or its row): flown to at once; with
-- Confirm before flying, chosen for the bar's Fly.
function M:Choose(node: TaxiNode?)
    if not (self.session and node and node.kind == "REACHABLE") then return end
    if self:Get("confirm") then self:Select(node) return end
    self:Fly(node)
end

-- a destination's time: "4:12" when timed, "~3:30" estimated; and a word
-- for its tooltip
local function timeText(t: number?, measured: boolean?, long: boolean?): string
    if not t then return long and "Not timed yet" or "–" end
    if measured then return clock(t) end
    return (long and "about " or "~") .. clock(t)
end

local function viaText(path: number[]?, s: Session): string
    if not path or #path <= 2 then return "Direct" end
    local names: string[] = {}
    for i = 2, #path - 1 do
        local n = s.byID[path[i]]
        names[#names + 1] = n and short(n.name) or "?"
    end
    return "via " .. table.concat(names, ", ")
end

local function stopsText(path: number[]?): string
    local stops = path and (#path - 2) or 0
    if stops <= 0 then return "Direct" end
    return stops == 1 and "1 stop" or (stops .. " stops")
end

-- Your quests' next steps (asked 2026-10-19): where the game's quest pins
-- put each quest in your log, its objectives' area or, done, where it's
-- turned in; each counted for the flight master nearest to it, within
-- NEAR yards. { [nodeID] = { questID, ... } } for the session's masters.
local NEAR = 800

local function worldXY(mapID: number, x: number, y: number): (number?, number?)
    local ok, _, pos = pcall(C_Map.GetWorldPosFromMapPos, mapID, CreateVector2D(x, y))
    if ok and pos then return pos:GetXY() end
end

function M:QuestSteps(s: Session?): { [number]: number[] }
    local out: { [number]: number[] } = {}
    local continent = continentOf(C_Map.GetBestMapForUnit("player"))
    if not (s and continent and C_Map.GetWorldPosFromMapPos and CreateVector2D) then return out end
    -- the masters you can fly to, and the one you're at, in yards
    local at = positions(continent)
    local masters: { node: TaxiNode, x: number, y: number }[] = {}
    for _, n in ipairs(s.nodes) do
        local p = at[n.id]
        local x, y
        if p then x, y = worldXY(continent, p[1], p[2]) end
        if x and y and n.kind ~= "DISTANT" then masters[#masters + 1] = { node = n, x = x, y = y } end
    end
    -- each quest once: on its zone's map, else the continent's
    local maps = { continent }
    local children = call(C_Map.GetMapChildrenInfo, continent, nil, true)
    for _, c in ipairs(type(children) == "table" and (children :: any[]) or {}) do
        if c.mapType == Enum.UIMapType.Zone then table.insert(maps, 1, c.mapID) end
    end
    local seen: { [number]: boolean } = {}
    for _, map in ipairs(maps) do
        local quests = call(C_QuestLog.GetQuestsOnMap, map)
        for _, q in ipairs(type(quests) == "table" and (quests :: any[]) or {}) do
            local id = q.questID
            if plain(id) and plain(q.x) and plain(q.y) and not seen[id] then
                seen[id] = true
                local x, y = worldXY(map, q.x, q.y)
                local best: TaxiNode?, far = nil, NEAR * NEAR
                if x and y then
                    for _, m in ipairs(masters) do
                        local d = (m.x - x) ^ 2 + (m.y - y) ^ 2
                        if d < far then best, far = m.node, d end
                    end
                end
                -- (nearest the master you're at: not a reason to fly)
                if best and best.kind == "REACHABLE" then
                    local steps = out[best.id] or {}
                    out[best.id] = steps
                    table.insert(steps, id)
                end
            end
        end
    end
    return out
end

local function stepsText(steps: number[]?): string?
    local n = steps and #steps or 0
    if n == 0 then return nil end
    return n == 1 and "1 quest step nearby" or (n .. " quest steps nearby")
end

-- A flight master's tooltip on the flight map.
function M:Tip(node: TaxiNode): { [string]: any }
    local s = self.session
    if not s then return {} end
    if node.kind == "CURRENT" then
        return { title = node.name, subtitle = "Flight master · you are here" }
    end
    if node.kind ~= "REACHABLE" then
        return { title = node.name, subtitle = "Flight master · not found yet",
                 description = "Talk to its flight master once to fly there." }
    end
    local t, measured = self:FlightTime(node.path)
    local lines = { { "Cost", coins(node.cost) }, { "Time", timeText(t, measured, true) } }
    -- the quests with a step near it
    for _, id in ipairs(self.steps and self.steps[node.id] or {}) do
        local title = call(C_QuestLog.GetTitleForQuestID, id)
        if plain(title) and title then
            lines[#lines + 1] = { title, call(C_QuestLog.IsComplete, id) and "turn in" or "objective" }
        end
    end
    return {
        title = node.name, subtitle = viaText(node.path, s),
        lines = lines,
        meta = not self:Get("confirm") and "Click to fly"
            or (self.selected == node and "Fly in the bar below" or "Click to choose"),
    }
end

--------------------------------------------------------------------------------
-- The side panel: the destinations
--------------------------------------------------------------------------------

function M:BuildSide()
    if self.side then return end
    local f = self.map
    local side = CreateFrame("Frame", nil, f)
    side:EnableMouse(true)
    side:Hide()
    UI.Fill(side, "surface", "BACKGROUND"):SetAllPoints()
    side.edge = UI.Border(side, "gilt-line")
    side.head = UI.SectionHeader(side, "Destinations", "")
    side.head:SetPoint("TOPLEFT", S["space-5"], -S["space-5"])
    side.head:SetPoint("TOPRIGHT", -S["space-5"], -S["space-5"])
    side.scroll = UI.ScrollArea(side, 2)
    side.scroll:SetPoint("TOPLEFT", side.head, "BOTTOMLEFT", 0, -S["space-4"])
    side.scroll:SetPoint("BOTTOMRIGHT", -S["space-5"] - S["space-3"], S["space-5"])
    side.rows = {}
    self.side = side
end

function M:Row(i: number): any
    local side = self.side
    local row = side.rows[i]
    if row then return row end
    row = CreateFrame("Button", nil, side.scroll.child)
    row:SetHeight(ROW_H)
    row.fill = UI.Fill(row, "surface-raised", "BACKGROUND")
    row.fill:SetAllPoints()
    row.fill:Hide()
    row.edge = UI.Border(row, "gilt-line")
    row.edge:SetShown(false)
    row.glyph = row:CreateTexture(nil, "ARTWORK")
    row.glyph:SetTexture(GLYPHS .. "wing.tga")
    row.glyph:SetSize(14, 14)
    row.glyph:SetPoint("LEFT", S["space-4"], 0)
    UI.Paint(row.glyph, "gilt-text")
    row.time = UI.Text(row, "numeric", "ink")
    row.time:SetPoint("RIGHT", -S["space-4"], 0)
    -- the name over the row's middle, its stops under it; the time's
    -- room kept on the right
    local x = S["space-4"] + 14 + S["space-4"]
    row.name = UI.Text(row, "label", "ink")
    row.name:SetPoint("BOTTOMLEFT", row, "LEFT", x, 0)
    row.name:SetPoint("BOTTOMRIGHT", row, "RIGHT", -64, 0)
    row.name:SetJustifyH("LEFT")
    row.stops = UI.Text(row, "caption", "ink-muted")
    row.stops:SetPoint("TOPLEFT", row, "LEFT", x, 0)
    row:SetScript("OnEnter", function(r)
        r.hover = true
        self:PaintRow(r)
        if r.node then
            self.hovered = r.node
            self:QueueInk()
            UI.ShowTooltip(r, function() return r.node and self:Tip(r.node) or {} end)
        end
    end)
    row:SetScript("OnLeave", function(r)
        r.hover = false
        self:PaintRow(r)
        self.hovered = nil
        self:QueueInk()
        UI.HideTooltip()
    end)
    row:SetScript("OnClick", function(r) self:Choose(r.node) end)
    side.rows[i] = row
    return row
end

function M:PaintRow(row: any)
    local chosen = row.node and row.node == self.selected
    row.fill:SetShown(row.hover or chosen)
    row.edge:SetShown(chosen)
end

-- The destinations, by name.
function M:FillSide()
    self:BuildSide()
    local s = self.session
    local list: TaxiNode[] = {}
    for _, n in ipairs(s and s.nodes or {}) do
        if n.kind == "REACHABLE" then list[#list + 1] = n end
    end
    table.sort(list, function(a, b) return a.name < b.name end)
    -- (the list shows whatever the quests say)
    local ok, steps = pcall(self.QuestSteps, self, s)
    self.steps = ok and steps or {}
    local side = self.side
    side.head:SetLabel("Destinations", tostring(#list))
    local width = math.max(1, side.scroll:GetWidth())
    for i, node in ipairs(list) do
        local row = self:Row(i)
        row.node = node
        row:ClearAllPoints()
        row:SetPoint("TOPLEFT", side.scroll.child, "TOPLEFT", 0, -(i - 1) * ROW_H)
        row:SetWidth(width)
        row.name:SetValue(short(node.name))
        local steps = stepsText(self.steps[node.id])
        row.stops:SetValue(stopsText(node.path) .. (steps and (" · " .. steps) or ""))
        row:Show()
    end
    for i = #list + 1, #side.rows do side.rows[i]:Hide(); side.rows[i].node = nil end
    side.scroll.child:SetSize(width, math.max(1, #list * ROW_H))
    self:UpdateRows()
end

-- the rows' times and which one is chosen
function M:UpdateRows()
    if not self.side then return end
    for _, row in ipairs(self.side.rows) do
        if row.node then
            local t, measured = self:FlightTime(row.node.path)
            row.time:SetValue(timeText(t, measured))
            row.time:SetColor(measured and "ink" or "ink-muted")
            self:PaintRow(row)
        end
    end
end

-- Over the quest log while it's open (it's the map's side panel); beside
-- the window, as wide, while it's closed.
function M:PlaceSide()
    local f, side = self.map, self.side
    if not side then return end
    local log = f.QuestLog or _G.QuestMapFrame
    side:ClearAllPoints()
    if log and log:IsShown() then
        side:SetPoint("TOPLEFT", log, "TOPLEFT", 0, 0)
        side:SetPoint("BOTTOMRIGHT", log, "BOTTOMRIGHT", 0, 0)
        side:SetFrameStrata(log:GetFrameStrata())
        side:SetFrameLevel(log:GetFrameLevel() + 100)
        side.edge:SetShown(false)
    else
        side:SetPoint("TOPLEFT", f, "TOPRIGHT", S["space-3"], 0)
        side:SetPoint("BOTTOMLEFT", f, "BOTTOMRIGHT", S["space-3"], 0)
        side:SetWidth(f.questLogWidth or 333)
        side:SetFrameLevel(f:GetFrameLevel() + 100)
        side.edge:SetShown(true)
    end
    -- the rows as wide as the list, laid out again
    after(0, function() if self.session and self.side:IsShown() then self:FillSide() end end)
end

--------------------------------------------------------------------------------
-- The bar at the map's bottom: the chosen destination and Fly
--------------------------------------------------------------------------------

function M:BuildBar()
    if self.bar then return end
    local f = self.map
    local bar = UI.Panel(f, { ornament = true })
    -- (over the map's pins, the game's and SuuUI's, as the status line)
    bar:SetFrameLevel(4000)
    bar.body:SetFrameLevel(4001)
    bar:EnableMouse(true)
    bar:Hide()
    local body = bar.body
    bar.glyph = body:CreateTexture(nil, "ARTWORK")
    bar.glyph:SetTexture(GLYPHS .. "wing.tga")
    bar.glyph:SetSize(15, 15)
    UI.Paint(bar.glyph, "gilt-text")
    bar.name = UI.Text(body, "unit-name", "ink")
    bar.via = UI.Text(body, "caption", "ink-muted")
    bar.rule = UI.Fill(body, "gilt-faint", "ARTWORK")
    bar.rule:SetWidth(1)
    bar.money = UI.Money(body)
    bar.clock = body:CreateTexture(nil, "ARTWORK")
    bar.clock:SetTexture(GLYPHS .. "hourglass.tga")
    bar.clock:SetSize(11, 11)
    UI.Paint(bar.clock, "ink-faint")
    bar.time = UI.Text(body, "numeric", "ink-muted")
    bar.fly = UI.Button(body, { text = "Fly", variant = "primary", icon = "wing", onClick = function() self:Fly() end,
                                tooltip = { title = "Fly", description = "Take this flight (the cost is paid at once)." } })
    self.bar = bar
end

-- The bar for the chosen destination, sized to what it says.
function M:UpdateBar()
    local s, node = self.session, self.selected
    if not (s and node) then
        if self.bar then self.bar:Hide() end
        return
    end
    self:BuildBar()
    local bar = self.bar
    local t, measured = self:FlightTime(node.path)
    bar.name:SetValue(short(node.name))
    bar.via:SetValue(viaText(node.path, s))
    bar.money:SetCopper(node.cost)
    bar.time:SetValue(timeText(t, measured, true))
    bar.fly:Remeasure()
    local gap = S["space-5"]
    local h = math.max(T.type["unit-name"].lineHeight + T.type.caption.lineHeight, 30)
    local x = 0
    bar.glyph:ClearAllPoints()
    bar.glyph:SetPoint("LEFT", bar.body, "LEFT", x, 0)
    x = x + 15 + S["space-4"]
    local textW = math.ceil(math.max(bar.name:GetUnboundedStringWidth(), bar.via:GetUnboundedStringWidth()))
    bar.name:ClearAllPoints()
    bar.name:SetPoint("BOTTOMLEFT", bar.body, "LEFT", x, 0)
    bar.via:ClearAllPoints()
    bar.via:SetPoint("TOPLEFT", bar.body, "LEFT", x, 0)
    x = x + textW + gap
    bar.rule:ClearAllPoints()
    bar.rule:SetPoint("TOPLEFT", bar.body, "TOPLEFT", x, 0)
    bar.rule:SetPoint("BOTTOMLEFT", bar.body, "BOTTOMLEFT", x, 0)
    x = x + 1 + gap
    bar.money:ClearAllPoints()
    bar.money:SetPoint("LEFT", bar.body, "LEFT", x, 0)
    x = x + bar.money:GetWidth() + gap
    bar.clock:ClearAllPoints()
    bar.clock:SetPoint("LEFT", bar.body, "LEFT", x, 0)
    x = x + 11 + S["space-2"]
    bar.time:ClearAllPoints()
    bar.time:SetPoint("LEFT", bar.body, "LEFT", x, 0)
    x = x + math.ceil(bar.time:GetUnboundedStringWidth()) + gap
    bar.fly:ClearAllPoints()
    bar.fly:SetPoint("LEFT", bar.body, "LEFT", x, 0)
    x = x + bar.fly:GetWidth()
    bar.body:SetSize(x, h)
    bar:ClearAllPoints()
    bar:SetPoint("BOTTOM", self.map.ScrollContainer or self.map, "BOTTOM", 0, S["space-5"])
    bar:Show()
end

--------------------------------------------------------------------------------
-- On the map's canvas: pins, routes, times
--------------------------------------------------------------------------------

function M:Pin()
    self.free = self.free or {}
    local pin = table.remove(self.free)
    if not pin then
        pin = UI.MapPin(self.layer)
        pin:RegisterForClicks("LeftButtonUp")
        -- the time (or "You are here") right of it, on glass
        local tag = CreateFrame("Frame", nil, pin)
        tag:SetPoint("LEFT", pin, "RIGHT", 3, 0)
        UI.Fill(tag, "surface-glass"):SetAllPoints()
        UI.Border(tag, "gilt-hairline")
        tag.text = UI.Text(tag, "micro", "ink")
        tag.text:SetPoint("CENTER", 0, 0)
        pin.tag = tag
        pin:SetScript("OnEnter", function(p)
            if not p.node then return end
            if p.node.kind == "REACHABLE" then self.hovered = p.node; self:QueueInk() end
            UI.ShowTooltip(p, function() return p.node and self:Tip(p.node) or {} end)
        end)
        pin:SetScript("OnLeave", function()
            self.hovered = nil
            self:QueueInk()
            UI.HideTooltip()
        end)
        pin:SetScript("OnClick", function(p) self:Choose(p.node) end)
        -- a right-click goes through to the map (it zooms out)
        if pin.SetPassThroughButtons then pcall(pin.SetPassThroughButtons, pin, "RightButton") end
    end
    pin:Show()
    self.pins[#self.pins + 1] = pin
    return pin
end

local function setTag(tag: any, text: string, color: string)
    tag.text:SetValue(text)
    tag.text:SetColor(color)
    tag:SetSize(math.ceil(tag.text:GetUnboundedStringWidth()) + 10, T.type.micro.lineHeight + 2)
    tag:Show()
end

-- one line of the drawing (pooled per layer: the dark underlay under the gilt)
function M:Line(layer: string, x1: number, y1: number, x2: number, y2: number, thickness: number, token: string, alpha: number?)
    local pool = self.ink.pools[layer]
    pool.n = pool.n + 1
    local line = pool[pool.n]
    if not line then
        line = self.ink:CreateLine(nil, layer)
        pool[pool.n] = line
    end
    line:SetThickness(thickness)
    UI.PaintFill(line, token, alpha)
    line:SetStartPoint("TOPLEFT", self.ink, x1, -y1)
    line:SetEndPoint("TOPLEFT", self.ink, x2, -y2)
    line:Show()
end

local function span(a: number[], b: number[]): number return math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2) end

-- dashes along a route's points: dash px drawn, gap px left out, the
-- pattern carried on round its bends
function M:Dashes(layer: string, points: number[][], dash: number, gap: number, thickness: number, token: string, alpha: number?)
    local total = 0
    for i = 1, #points - 1 do total = total + span(points[i], points[i + 1]) end
    if total < 0.5 then return end
    -- (zoomed far in, longer dashes: no more than MAX_DASHES on a line)
    local stretch = math.max(1, total / (dash + gap) / MAX_DASHES)
    dash, gap = dash * stretch, gap * stretch
    local run = 0
    for i = 1, #points - 1 do
        local a, b = points[i], points[i + 1]
        local len = span(a, b)
        if len > 0 then
            local ux, uy = (b[1] - a[1]) / len, (b[2] - a[2]) / len
            -- where the pattern stands at this bend: a dash may go on round it
            local t = -(run % (dash + gap))
            while t < len do
                local s, e = math.max(0, t), math.min(len, t + dash)
                if e > s then self:Line(layer, a[1] + ux * s, a[2] + uy * s, a[1] + ux * e, a[2] + uy * e, thickness, token, alpha) end
                t = t + dash + gap
            end
        end
        run = run + len
    end
end

-- A route on the shown map (or `view`: { map, pos, w, h }), in px: its hops
-- the way they fly (or straight) one after another, and where each master
-- on it falls among the points; nil when one isn't on this map.
function M:Way(path: number[], view: View?): (number[][]?, number[]?)
    local v: View = view or self.view
    local points: number[][], stops: number[] = {}, {}
    for i, id in ipairs(path) do
        local p = v.pos[id]
        if not p then return nil end
        if i > 1 then
            -- (the hop's own ends left out: it runs from pin to pin)
            local way = hopWay(v.map, path[i - 1], id, v.pos[path[i - 1]] :: number[], p)
            for k = 2, way and #way - 1 or 0 do points[#points + 1] = { way[k][1] * v.w, way[k][2] * v.h } end
        end
        points[#points + 1] = { p[1] * v.w, p[2] * v.h }
        stops[#stops + 1] = #points
    end
    return points, stops
end

-- A route solid: the gilt line on a dark underlay, so it reads on any art.
function M:Solid(points: number[][], width: number, token: string)
    for i = 1, #points - 1 do
        local a, b = points[i], points[i + 1]
        self:Line("BORDER", a[1], a[2], b[1], b[2], width + 3, "surface", 0.65)
        self:Line("ARTWORK", a[1], a[2], b[1], b[2], width, token)
    end
end

-- a stop on a route in flight: a small gilt disc on a surface rim
function M:Dot(x: number, y: number)
    local n = self.ink.dotN + 1
    self.ink.dotN = n
    local d = self.ink.dots[n]
    if not d then
        d = { rim = self.ink:CreateTexture(nil, "OVERLAY", nil, 1), fill = self.ink:CreateTexture(nil, "OVERLAY", nil, 2) }
        d.rim:SetTexture(DISC)
        d.rim:SetSize(9, 9)
        UI.Paint(d.rim, "surface")
        d.fill:SetTexture(DISC)
        d.fill:SetSize(6, 6)
        UI.Paint(d.fill, "gilt-text")
        self.ink.dots[n] = d
    end
    for _, t in ipairs({ d.rim, d.fill }) do
        t:ClearAllPoints()
        t:SetPoint("CENTER", self.ink, "TOPLEFT", x, -y)
        t:Show()
    end
end

function M:ClearDrawing()
    for _, pin in ipairs(self.pins or {}) do
        pin:Hide()
        pin:ClearAllPoints()
        pin:SetHighlight(nil)
        pin.tag:Hide()
        pin.node = nil
        table.insert(self.free, pin)
    end
    self.pins = {}
    self.view = nil
    self:ClearInk()
end

function M:ClearInk()
    local ink = self.ink
    if not ink then return end
    for _, pool in pairs(ink.pools) do
        for i = 1, #pool do pool[i]:Hide() end
        pool.n = 0
    end
    for _, d in ipairs(ink.dots) do d.rim:Hide(); d.fill:Hide() end
    ink.dotN = 0
    ink.left:Hide()
end

local function inside(p: number[]): boolean return p[1] >= -0.01 and p[1] <= 1.01 and p[2] >= -0.01 and p[2] <= 1.01 end

-- The flight master's map: a pin for every node of yours on this map,
-- the time beside each destination.
function M:DrawMaster(pos: { [number]: number[] }, w: number, h: number, cs: number)
    local s: Session = self.session
    local base = self.layer:GetFrameLevel()
    for _, n in ipairs(s.nodes) do
        local p = pos[n.id]
        if p and inside(p) then
            local pin = self:Pin()
            pin.node = n
            if n.kind == "DISTANT" then
                pin:SetData({ glyph = "wing", color = "ink-faint", edge = "ink-faint" })
                pin.edge:SetTexture(DASHED)
                pin:SetBaseAlpha(0.8)
                pin.tag:Hide()
            else
                local here = n.kind == "CURRENT"
                pin:SetData({ glyph = "wing", color = "gilt-text", edge = here and "arcane" or "gilt-line", ring = here and "arcane" or nil })
                pin.edge:SetTexture(DISC)
                pin:SetBaseAlpha(1)
                if here then
                    setTag(pin.tag, "You are here", "arcane")
                else
                    local t, measured = self:FlightTime(n.path)
                    setTag(pin.tag, timeText(t, measured), measured and "ink" or "ink-muted")
                end
            end
            pin:SetScale(1 / cs)
            pin:SetFrameLevel(base + (n.kind == "DISTANT" and 2 or 5))
            pin.tag:SetFrameLevel(base + 7)
            pin:SetPoint("CENTER", self.layer, "TOPLEFT", p[1] * w, -p[2] * h)
        end
    end
end

-- Its lines: the routes between the ones you know faint, the hovered (else
-- the chosen) destination's route solid; that one's pin ringed.
function M:InkMaster(pos: { [number]: number[] }, _w: number?, _h: number?)
    local s: Session = self.session
    local known: TaxiNode[] = {}
    for _, n in ipairs(s.nodes) do
        if n.kind ~= "DISTANT" and pos[n.id] then known[#known + 1] = n end
    end
    -- the network: each hop between two you know, once
    for i = 1, #known do
        for j = i + 1, #known do
            local a, b = known[i], known[j]
            if hopYards(a.id, b.id) then
                local points = self:Way({ a.id, b.id })
                if points then self:Dashes("ARTWORK", points, 4, 4, 1.5, "gilt-line") end
            end
        end
    end
    -- the route of the one hovered, else the one chosen
    local shown = self.hovered or self.selected
    if shown and shown.path then
        local points = self:Way(shown.path)
        if points then self:Solid(points, 2.5, "gilt-text") end
    end
    for _, pin in ipairs(self.pins) do
        local n = pin.node
        pin:SetHighlight(n and (n == self.selected or n == self.hovered) and true or nil)
    end
end

-- The point on a route nearest x, y: the segment it's on, and the point.
local function nearest(points: number[][], x: number, y: number): (number?, number?, number?)
    local best, bk, bx, by
    for k = 1, #points - 1 do
        local a, b = points[k], points[k + 1]
        local dx, dy = b[1] - a[1], b[2] - a[2]
        local l2 = dx * dx + dy * dy
        local t = l2 > 0 and math.max(0, math.min(1, ((x - a[1]) * dx + (y - a[2]) * dy) / l2)) or 0
        local px, py = a[1] + dx * t, a[2] + dy * t
        local d = (px - x) ^ 2 + (py - y) ^ 2
        if not best or d < best then best, bk, bx, by = d, k, px, py end
    end
    return bk, bx, by
end

-- Your place on a map (0-1), nil while the game doesn't give it.
local function myPlace(mapID: number?): (number?, number?)
    local me = call(C_Map.GetPlayerMapPosition, mapID, "player")
    local x, y
    if me and me.GetXY then x, y = me:GetXY() end
    if plain(x) and plain(y) and (x > 0 or y > 0) then return x, y end
end

-- How far along the flight you are: the point on the route nearest you
-- (the game gives your place in flight), else by the time flown along the
-- route's length. -> the segment it's on, and the point.
function M:Along(points: number[][], w: number, h: number): (number, number, number)
    local x, y = myPlace(self.map:GetMapID())
    if x and y then
        local bk, bx, by = nearest(points, x * w, y * h)
        if bk then return bk, bx :: number, by :: number end
    end
    local fl = self.flight
    local total = fl.expected
    if not total then return 1, points[1][1], points[1][2] end
    local frac = math.min(1, (GetTime() - fl.started) / total)
    local lengths: number[], sum = {}, 0
    for k = 1, #points - 1 do
        lengths[k] = span(points[k], points[k + 1])
        sum = sum + lengths[k]
    end
    local want, run = frac * sum, 0
    for k = 1, #points - 1 do
        if run + lengths[k] >= want then
            local t = lengths[k] > 0 and (want - run) / lengths[k] or 0
            local a, b = points[k], points[k + 1]
            return k, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t
        end
        run = run + lengths[k]
    end
    local last = points[#points]
    return #points - 1, last[1], last[2]
end

-- In the air: the route flown solid, the rest dashed, a dot at each stop,
-- the time left at the destination (landing early: up to that stop).
function M:DrawFlight(w: number, h: number)
    local fl = self.flight
    local points, stops = self:Way(fl.path)
    if not points then return end
    local last, share = #points, 1
    local route = fl.early and self:FlightRoute(fl)
    if route and stops[fl.early] and route.at[fl.early] then last, share = stops[fl.early], route.at[fl.early] end
    local k, qx, qy = self:Along(points, w, h)
    local flown: number[][] = {}
    for i = 1, k do flown[i] = points[i] end
    flown[#flown + 1] = { qx, qy }
    self:Solid(flown, 3, "gilt")
    local rest: number[][] = { { qx, qy } }
    for i = k + 1, last do rest[#rest + 1] = points[i] end
    self:Dashes("BORDER", rest, 5, 5, 5, "surface", 0.65)
    self:Dashes("ARTWORK", rest, 5, 5, 2, "gilt-text")
    for _, i in ipairs(stops) do if i <= last then self:Dot(points[i][1], points[i][2]) end end
    local dest = points[last]
    if fl.expected then
        local left = fl.expected * share - (GetTime() - fl.started)
        local tag = self.ink.left
        setTag(tag, (fl.measured and "" or "~") .. clock(math.max(0, left)) .. " left", "ink")
        tag:ClearAllPoints()
        tag:SetPoint("LEFT", self.ink, "TOPLEFT", dest[1] + 10, -dest[2] + PIN / 2)
    end
end

-- Everything again (the map, its zoom, the flight master): the pins, then
-- the lines.
function M:Layout()
    self.layoutQueued = false
    self:ClearDrawing()
    local f = self.map
    if not (f and f:IsShown() and self:IsEnabled()) then return end
    local flying = not self.session and self.flight and self:Get("inFlight")
    if not (self.session or flying) then return end
    local canvas = f:GetCanvas()
    local cs = f:GetCanvasScale()
    if not (cs and cs > 0) then return end
    local w, h = canvas:GetWidth() * cs, canvas:GetHeight() * cs
    if w <= 0 or h <= 0 then return end
    local ink = self.ink
    ink:SetScale(1 / cs)
    ink:ClearAllPoints()
    ink:SetPoint("TOPLEFT", self.layer, "TOPLEFT")
    ink:SetSize(w, h)
    self.view = { map = f:GetMapID(), pos = positions(f:GetMapID()), w = w, h = h }
    if self.session then self:DrawMaster(self.view.pos, w, h, cs) end
    self:DrawInk()
end

-- The lines alone (a hover, a choice, the clock in flight): the pins under
-- the mouse stay (made again, they'd lose and regain it, over and over).
function M:DrawInk()
    self.inkQueued = false
    self:ClearInk()
    local v = self.view
    if not v then return end
    if self.session then
        self:InkMaster(v.pos, v.w, v.h)
    elseif self.flight and self:Get("inFlight") then
        self:DrawFlight(v.w, v.h)
    end
end

function M:QueueLayout()
    if self.layoutQueued then return end
    self.layoutQueued = true
    after(0, function() self:Layout() end)
end

function M:QueueInk()
    if self.inkQueued or self.layoutQueued then return end
    self.inkQueued = true
    after(0, function() if self.inkQueued then self:DrawInk() end end)
end

--------------------------------------------------------------------------------
-- In the air with the map closed: the flight bar
--------------------------------------------------------------------------------

-- The flight bar (board option B, "In flight"): top centre, as wide as a
-- cast bar, from take-off to landing while the world map is closed (open,
-- the map shows the route instead). The destination and the time left over
-- a thin bar, a diamond at each stop (placed by its distance along the
-- route, gilt once passed), the next stop and when you land under it. A
-- route never flown says so: estimated (its time marked ~, the fill
-- hatched), or with no estimate either, the time flown so far over a
-- sweep. While a stop is ahead, Land at under them asks the game to set you
-- down there (its early landing, as its own leave button does; from SuuUI's
-- click it isn't blocked, probed 2026-10-19): the bar then shows that stop
-- as the destination, the time to it its share of the route. The button is
-- the bar's only part that takes the mouse. The text once a second, the
-- fill every frame; with Reduce motion the fill once a second and the sweep
-- still. Its height is its lines' (the button's row only while it shows).

local TIMER_W = 300  -- a cast bar's width (the board's)
local TRACK_H = 6
local STOP = 8       -- a stop's diamond
local GLYPH = 13
local SWEEP = 0.22   -- the sweep, of the bar's width
local SWEEP_T = 1.8  -- s for the sweep to cross
local WHITE = "Interface\\Buttons\\WHITE8X8"
local HATCH = TEXTURES .. "Hatch.tga"

-- "18:42" (or "6:42 PM", as the game's clock is set): the local time
-- `seconds` from now
local function clockAt(seconds: number): string
    local t = date("*t", time() + math.floor(math.max(0, seconds) + 0.5))
    if C_CVar.GetCVarBool("timeMgrUseMilitaryTime") then return ("%02d:%02d"):format(t.hour, t.min) end
    return ("%d:%02d %s"):format((t.hour - 1) % 12 + 1, t.min, t.hour >= 12 and "PM" or "AM")
end

-- A stop's name: kept from the flight master's map as the flight was taken,
-- else (a reload from before they were kept) from the continent's masters.
function M:StopName(fl: any, id: number): string
    fl.names = fl.names or {}
    if not fl.names[id] and not fl.namesRead then
        fl.namesRead = true
        local continent = continentOf(C_Map.GetBestMapForUnit("player"))
        local ok, list = pcall(C_TaxiMap.GetTaxiNodesForMap, continent :: any)
        for _, n in ipairs(ok and type(list) == "table" and list or {}) do
            if plain(n.nodeID) and plain(n.name) and n.name and not fl.names[n.nodeID] then fl.names[n.nodeID] = short(n.name) end
        end
    end
    return fl.names[id] or "?"
end

-- The flight's route for the bar, worked out once a flight: its points on
-- the continent's map in yards across and down (so a stop's place is its
-- distance along the way it's flown), the length run to each point, and
-- each master's share of the whole (at[i] for path[i]). When the map can't
-- place it, the shares by the hops' lengths alone (the progress then by
-- the time flown); false when those aren't known either.
function M:FlightRoute(fl: any): Route | false
    if fl.route ~= nil then return fl.route end
    local route: Route | false = false
    local continent = continentOf(C_Map.GetBestMapForUnit("player"))
    local x0, y0, x1, y1, x2, y2
    if continent and C_Map.GetWorldPosFromMapPos and CreateVector2D then
        x0, y0 = worldXY(continent, 0, 0)
        x1, y1 = worldXY(continent, 1, 0)
        x2, y2 = worldXY(continent, 0, 1)
    end
    if x0 and y0 and x1 and y1 and x2 and y2 then
        local view: View = { map = continent :: number, pos = positions(continent),
                       w = span({ x0, y0 }, { x1, y1 }), h = span({ x0, y0 }, { x2, y2 }) }
        local points, stops
        if view.w > 0 and view.h > 0 then points, stops = self:Way(fl.path, view) end
        if points and stops and #points >= 2 then
            local run: number[] = { 0 }
            for k = 2, #points do run[k] = run[k - 1] + span(points[k - 1], points[k]) end
            local total = run[#points]
            if total > 0 then
                route = { map = continent, w = view.w, h = view.h, points = points, run = run, total = total, at = {} }
                for i, k in ipairs(stops) do route.at[i] = run[k] / total end
            end
        end
    end
    if not route then
        local hops: number[] = { 0 }
        local run: number[]?, total = hops, 0
        for i = 1, #fl.path - 1 do
            local yards = hopYards(fl.path[i], fl.path[i + 1])
            if not yards then run = nil break end
            total = total + yards
            hops[i + 1] = total
        end
        if run and total > 0 then
            local shares: Route = { at = {} }
            for i = 1, #fl.path do shares.at[i] = run[i] / total end
            route = shares
        end
    end
    fl.route = route
    return route
end

-- How far along the flight you are (0-1): your place projected onto the
-- route, else the time flown of the time expected; nil with neither.
function M:Flown(fl: any, route: Route | false): number?
    if route and route.points then
        local placed = route :: PlacedRoute
        local x, y = myPlace(placed.map)
        if x and y then
            local k, px, py = nearest(placed.points, x * placed.w, y * placed.h)
            if k then return (placed.run[k] + span(placed.points[k], { px :: number, py :: number })) / placed.total end
        end
    end
    if fl.expected and fl.expected > 0 then return math.min(1, (GetTime() - fl.started) / fl.expected) end
end

function M:BuildTimer()
    if self.timer then return end
    local f = UI.Panel(SuuUI.Root, { name = "SuuUIFlightTimer", width = TIMER_W, ornament = true })
    f:SetFrameStrata("LOW")
    f.suuManagedShow = true -- shown only in the air (and in edit mode)
    f:Hide()
    local body = f.body
    f.glyph = body:CreateTexture(nil, "ARTWORK")
    f.glyph:SetTexture(GLYPHS .. "wing.tga")
    f.glyph:SetSize(GLYPH, GLYPH)
    UI.Paint(f.glyph, "gilt-text")
    f.name = UI.Text(body, "unit-name-sm", "ink")
    f.name:SetJustifyH("LEFT")
    f.time = UI.Text(body, "numeric", "ink")
    -- the bar: the fill (hatched while estimated), the sweep while there's
    -- no telling, the stops over both
    f.track = UI.StatusBar(body, { width = TIMER_W, height = TRACK_H, track = "track", fill = "gilt", border = false })
    local fill = f.track.bar:GetStatusBarTexture()
    f.hatch = f.track.bar:CreateTexture(nil, "OVERLAY")
    f.hatch:SetTexture(HATCH, "REPEAT", "REPEAT")
    f.hatch:SetHorizTile(true)
    f.hatch:SetVertTile(true)
    f.hatch:SetPoint("TOPLEFT", fill, "TOPLEFT")
    f.hatch:SetPoint("BOTTOMRIGHT", fill, "BOTTOMRIGHT")
    UI.Paint(f.hatch, "gilt")
    f.clip = CreateFrame("Frame", nil, f.track)
    f.clip:SetAllPoints()
    f.clip:SetClipsChildren(true)
    f.clip:SetFrameLevel(f.track.bar:GetFrameLevel() + 1)
    f.sweep = CreateFrame("Frame", nil, f.clip)
    for i, from in ipairs({ 0, 1 }) do
        local t = f.sweep:CreateTexture(nil, "ARTWORK")
        t:SetTexture(WHITE)
        t:SetPoint("TOPLEFT", f.sweep, i == 1 and "TOPLEFT" or "TOP")
        t:SetPoint("BOTTOMRIGHT", f.sweep, i == 1 and "BOTTOM" or "BOTTOMRIGHT")
        UI.PaintGradient(t, "HORIZONTAL", "gilt", "gilt", from, 1 - from)
    end
    f.marks = CreateFrame("Frame", nil, f.track)
    f.marks:SetAllPoints()
    f.marks:SetFrameLevel(f.track.bar:GetFrameLevel() + 2)
    f.stops = {}
    f.next = UI.Text(body, "caption", "ink-muted")
    f.next:SetJustifyH("LEFT")
    f.lands = UI.Text(body, "caption", "ink-faint")
    f.land = UI.Button(body, { variant = "quiet", onClick = function() self:LandEarly() end })
    f.land:Hide()
    local wait = 0
    f:SetScript("OnUpdate", function(_, elapsed)
        wait = wait - elapsed
        if wait <= 0 then
            wait = 1
            self:TickTimer()
        end
        self:MoveTimer()
    end)
    self.timer = f
    self:LayoutTimer()
    self:SampleTimer()
end

-- The lines from the text styles' line heights (a theme can change them):
-- the name and time, the bar, the next stop and landing, Land at while it
-- shows; the panel fits.
function M:LayoutTimer()
    local f = self.timer
    if not f then return end
    local body, gap = f.body, S["space-3"]
    local head = math.max(T.type["unit-name-sm"].lineHeight, T.type.numeric.lineHeight, GLYPH)
    local foot = T.type.caption.lineHeight
    for _, r in ipairs({ f.glyph, f.name, f.time, f.track, f.next, f.lands, f.land }) do r:ClearAllPoints() end
    f.glyph:SetPoint("LEFT", body, "TOPLEFT", 0, -head / 2)
    f.time:SetPoint("RIGHT", body, "TOPRIGHT", 0, -head / 2)
    f.name:SetPoint("LEFT", body, "TOPLEFT", GLYPH + S["space-3"], -head / 2)
    f.name:SetPoint("RIGHT", f.time, "LEFT", -S["space-4"], 0)
    f.track:SetPoint("TOPLEFT", body, "TOPLEFT", 0, -(head + gap))
    f.track:SetPoint("TOPRIGHT", body, "TOPRIGHT", 0, -(head + gap))
    local y = -(head + gap + TRACK_H + gap)
    f.lands:SetPoint("TOPRIGHT", body, "TOPRIGHT", 0, y)
    f.next:SetPoint("TOPLEFT", body, "TOPLEFT", 0, y)
    f.next:SetPoint("TOPRIGHT", f.lands, "TOPLEFT", -S["space-4"], 0)
    f.land:SetPoint("TOPLEFT", body, "TOPLEFT", 0, y - foot - S["space-4"])
    f.sweep:SetSize(math.max(1, (TIMER_W - S["space-5"] * 2) * SWEEP), TRACK_H)
    local height = head + gap + TRACK_H + gap + foot
    if f.landAt then height = height + S["space-4"] + f.land:GetHeight() end
    body:SetHeight(height)
end

-- a stop's diamond: gilt-text rim, gilt once passed, surface ahead
function M:Stop(i: number): any
    local f = self.timer
    local d = f.stops[i]
    if not d then
        d = { rim = UI.Diamond(f.marks, STOP, "gilt-text", "OVERLAY", 6), dot = UI.Diamond(f.marks, STOP - 2, "surface", "OVERLAY", 7) }
        f.stops[i] = d
    end
    return d
end

-- What the bar shows: { name, time, timeColor, left, right, fill ("solid",
-- "hatch" or nil: the sweep), frac, rate (of the bar a second, for the
-- fill between ticks), stops = { { at, passed } }, land (the stop Land at
-- names; nil: no button) }.
function M:PaintTimer(v: { [string]: any })
    local f = self.timer
    if f.landAt ~= v.land then
        f.landAt = v.land
        if v.land then f.land:SetLabel("Land at " .. v.land) end
        f.land:SetShown(v.land ~= nil)
        self:LayoutTimer()
    end
    f.name:SetValue(v.name)
    f.time:SetValue(v.time)
    f.time:SetColor(v.timeColor)
    f.next:SetValue(v.left)
    f.lands:SetValue(v.right)
    local token = v.fill == "hatch" and "progress-fill" or "gilt"
    if f.fillToken ~= token then
        f.fillToken = token
        f.track:SetFill(token)
    end
    f.hatch:SetShown(v.fill == "hatch")
    f.track.bar:SetShown(v.fill ~= nil)
    f.sweep:SetShown(v.fill == nil)
    f.still = SuuUI.Motion.Reduced()
    -- the fill on from here at the flight's pace until the next tick: never
    -- more than a second ahead, never back
    local shown = f.drive and f.drive.flight == v.flight and f.drive.shown or 0
    local frac = math.max(0, math.min(1, v.frac or 0))
    if frac >= shown then
        f.drive = { flight = v.flight, base = frac, rate = v.rate or 0, at = GetTime(), shown = frac }
    else
        f.drive = { flight = v.flight, base = shown, rate = 0, at = GetTime(), shown = shown }
    end
    local width = f.track:GetWidth()
    if not (width and width > 0) then width = TIMER_W - S["space-5"] * 2 end
    for i, s in ipairs(v.stops or {}) do
        local d = self:Stop(i)
        local x = s.at * width
        for _, t in ipairs({ d.rim, d.dot }) do
            t:ClearAllPoints()
            t:SetPoint("CENTER", f.marks, "LEFT", x, 0)
            t:Show()
        end
        UI.Paint(d.dot, s.passed and "gilt" or "surface")
    end
    for i = #(v.stops or {}) + 1, #f.stops do f.stops[i].rim:Hide(); f.stops[i].dot:Hide() end
    self:MoveTimer()
end

-- Every frame: the fill, and the sweep across (still with Reduce motion).
function M:MoveTimer()
    local f = self.timer
    local d = f and f.drive
    if not d then return end
    local now = GetTime()
    if not f.still then
        d.shown = math.min(1, d.base + math.min(now - d.at, 1) * d.rate)
    end
    f.track:SetValueNow(d.shown)
    if f.sweep:IsShown() then
        local width = f.track:GetWidth() or 0
        local sw = f.sweep:GetWidth()
        local x = f.still and width * 0.3 or ((now % SWEEP_T) / SWEEP_T) * (width + sw) - sw
        f.sweep:ClearAllPoints()
        f.sweep:SetPoint("LEFT", f.clip, "LEFT", x, 0)
    end
end

-- Once a second in the air: the flight as it stands. Landing early, it ends
-- at that stop: the bar is the route up to it (its share, at, of the whole).
function M:TickTimer()
    local f, fl = self.timer, self.flight
    if not (f and fl) then return end
    local route = self:FlightRoute(fl)
    local frac = self:Flown(fl, route)
    local flown = GetTime() - fl.started
    local to, share = #fl.path, 1
    if fl.early and route and (route.at[fl.early] or 0) > 0 then to, share = fl.early, route.at[fl.early] end
    local expected = fl.expected and fl.expected * share
    local left = expected and math.max(0, expected - flown)
    local v = { flight = fl, name = self:StopName(fl, fl.path[to]), frac = frac and frac / share,
                rate = expected and expected > 0 and 1 / expected or 0, stops = {} }
    -- the stops between, by their place along the route (where you are
    -- tells the next one even untimed; the diamonds show with a time)
    local ahead
    if route and frac then
        for i = 2, to - 1 do
            local at = route.at[i]
            local passed = frac >= at
            if expected then v.stops[#v.stops + 1] = { at = at / share, passed = passed } end
            if not passed and not ahead then ahead = i end
        end
    end
    fl.ahead = ahead
    if fl.measured then
        v.time, v.timeColor, v.fill = clock(left), "ink", "solid"
        if ahead then
            v.left = ("Next stop %s · %s"):format(self:StopName(fl, fl.path[ahead]), clock(math.max(0, route.at[ahead] * fl.expected - flown)))
        elseif to < #fl.path then
            v.left = "Landing early"
        else
            -- (stops it can't place: how many)
            v.left = route and (#fl.path > 2 and "No more stops" or "Direct") or stopsText(fl.path)
        end
        v.right = "lands " .. clockAt(left)
    elseif expected then
        v.time, v.timeColor, v.fill = "~" .. clock(left), "ink-muted", "hatch"
        v.left = (to < #fl.path and "Landing early" or "Not timed yet") .. " · estimated · " .. clock(flown) .. " so far"
        v.right = "about " .. clockAt(left)
    else
        v.time, v.timeColor, v.fill, v.frac, v.rate = clock(flown), "ink-muted", nil, 0, 0
        -- (a flight resumed after a reload isn't timed: its start isn't exact)
        v.left = to < #fl.path and "Landing early" or fl.reloaded and "Not timed yet" or "Not timed yet · timing this flight"
        v.right = "so far"
    end
    -- Land at: the next stop, while the game still flies you on past it
    if ahead and not fl.early and TaxiRequestEarlyLanding and UnitOnTaxi("player") then
        v.land = self:StopName(fl, fl.path[ahead])
    end
    self:PaintTimer(v)
end

-- Land at (the flight bar): the game asked to set you down at the next
-- stop; the flight now ends there, kept over a reload as well.
function M:LandEarly()
    local fl = self.flight
    -- (the next stop as it stands now: the tick may be a second old)
    if fl then self:TickTimer() end
    if not (fl and fl.ahead and not fl.early and UnitOnTaxi("player")) then return end
    if not pcall(TaxiRequestEarlyLanding) then return end
    fl.early = fl.ahead
    local kept = self:CharData().flight
    if kept then kept.early = fl.early end
    self:TickTimer()
    self:QueueInk()
end

-- In edit mode on the ground: the board's timed flight, to place it by.
function M:SampleTimer()
    self:PaintTimer({ name = "Crossroads", time = clock(95), timeColor = "ink", fill = "solid", frac = 0.4,
                      left = "Next stop Camp Taurajo · " .. clock(18), right = "lands " .. clockAt(95),
                      stops = { { at = 0.51, passed = false } }, land = "Camp Taurajo" })
end

-- Shown in the air while the world map is closed (and the setting is on);
-- in edit mode to be moved, a sample on the ground.
function M:UpdateTimer()
    local f = self.timer
    if not f then return end
    local editing = SuuUI.EditMode.IsActive()
    local flying = self.flight ~= nil and not (self.map and self.map:IsShown())
    local shown = self:IsEnabled() and self:Get("timer") and not self:Get("timerPosition").hidden
        and (flying or editing) or false
    f:SetShown(shown)
    if not shown then return end
    if self.flight then self:TickTimer() else self:SampleTimer() end
end

--------------------------------------------------------------------------------
-- The map
--------------------------------------------------------------------------------

function M:Attach()
    local f = _G.WorldMapFrame
    if not f or self.map then return end
    self.map = f
    -- over the map's art, under the game's own pins (as the world map
    -- module's pins)
    self.layer = CreateFrame("Frame", nil, f:GetCanvas())
    self.layer:SetAllPoints(f:GetCanvas())
    local levels = f.GetPinFrameLevelsManager and f:GetPinFrameLevelsManager()
    local above = levels and levels.GetFrameLevelStart and levels:GetFrameLevelStart("PIN_FRAME_LEVEL_MAP_HIGHLIGHT")
    self.layer:SetFrameLevel(above and (above + 1) or (f:GetCanvas():GetFrameLevel() + 2))
    self.pins, self.free = {}, {}
    local ink = CreateFrame("Frame", nil, self.layer)
    ink:SetFrameLevel(self.layer:GetFrameLevel())
    ink.pools = { BORDER = { n = 0 }, ARTWORK = { n = 0 } }
    ink.dots, ink.dotN = {}, 0
    -- the time left in flight, by the destination
    ink.left = CreateFrame("Frame", nil, ink)
    ink.left:SetFrameLevel(ink:GetFrameLevel() + 8)
    UI.Fill(ink.left, "surface-glass"):SetAllPoints()
    UI.Border(ink.left, "gilt-hairline")
    ink.left.text = UI.Text(ink.left, "micro", "ink")
    ink.left.text:SetPoint("CENTER", 0, 0)
    ink.left:Hide()
    self.ink = ink
    -- the clock in flight: the time left and where you are, every second
    local wait = 0
    ink:SetScript("OnUpdate", function(_, elapsed)
        wait = wait - elapsed
        if wait > 0 then return end
        wait = 1
        if self.flight and not self.session and self:Get("inFlight") then self:DrawInk() end
    end)
    local provider = CreateFromMixins(MapCanvasDataProviderMixin)
    provider.RefreshAllData = function() self:QueueLayout() end
    provider.RemoveAllData = function() self:ClearDrawing() end
    provider.OnCanvasScaleChanged = function() self:QueueLayout() end
    provider.OnCanvasSizeChanged = function() self:QueueLayout() end
    self.provider = provider
    -- the map closed at the flight master: the flight master too; in the
    -- air the flight bar comes back
    hookScript(f, "OnHide", function()
        if self.session and not self.closing then
            self:LeaveMaster(false)
            if CloseTaxiMap then CloseTaxiMap() end
        end
        self:UpdateTimer()
    end)
    -- opened in the air: the continent, where the route shows (the flight
    -- bar away meanwhile)
    hookScript(f, "OnShow", function()
        if self:IsEnabled() and self.flight and not self.session and self:Get("inFlight") then
            after(0, function()
                local continent = continentOf(C_Map.GetBestMapForUnit("player"))
                if continent and f:IsShown() and f:GetMapID() ~= continent then f:SetMapID(continent) end
            end)
        end
        self:UpdateTimer()
    end)
    -- the quest log opened or closed: the destinations go with it
    if f.SetQuestLogPanelShown then
        hook(f, "SetQuestLogPanelShown", function() if self.session then self:PlaceSide() end end)
    end
    -- the header keeps "Flight master" over map changes (the window skin
    -- names the map on each)
    EventRegistry:RegisterCallback("MapCanvas.MapSet", function()
        if self.session then after(0, function() self:SetTitle(true) end) end
    end, self)
end

-- Settings › Flight map
local SECTION = {
    id = "flightmap", label = "Flight map", category = "World", order = 13,
    groups = {
        { title = "At a flight master", rows = {
            { key = "atMaster", label = "The world map as the flight map", control = "toggle",
              description = "At a flight master SuuUI's world map shows where you can fly: every flight master, the routes between the ones you've found, and each flight's time and cost. Click a destination to fly there. Off: the game's own flight map." },
            { key = "confirm", label = "Confirm before flying", control = "toggle", disabled = function() return not M:Get("atMaster"), "The world map as the flight map is off." end,
              description = "A click on a destination chooses it, and Fly in the bar at the map's bottom takes the flight. Off: the click flies there at once (hovering still shows the route, the cost and the time)." },
        } },
        { title = "While flying", rows = {
            { key = "inFlight", label = "Your flight on the map", control = "toggle",
              description = "Open the map in the air to see your route: the part flown solid, the rest dashed, the time left at your destination." },
            { key = "timer", label = "Flight timer on screen", control = "toggle",
              description = "While you fly with the map closed: a bar at the top of the screen with your destination and the time left, a diamond for each stop (gilt once passed), the next stop and when you land, and Land at to come down at the next stop instead of flying on. A route not flown yet shows an estimate, marked ~. Move it in edit mode." },
        } },
        { title = "Flight times", rows = {
            { label = "Timed flights", control = "button", text = "Forget",
              description = function() return M:TimesSummary() end,
              onClick = function()
                  UI.Confirm({ title = "Forget flight times?",
                      text = "Every route's measured time, for all your characters, and this character's flight speed. Times are estimated from the routes' lengths again until you fly them.",
                      confirm = "Forget", onConfirm = function() M:ForgetTimes() end })
              end },
        } },
    },
}

function M:TimesSummary()
    local n = 0
    for _ in pairs(timed()) do n = n + 1 end
    local flights = self:CharData().flights or 0
    local speed = ("%.1f yards a second"):format(self:Speed())
    local learned = flights > 0 and (" (from " .. flights .. (flights == 1 and " flight)" or " flights)")) or " (not flown yet)"
    return ("Each flight is timed; a route you've flown shows its time, others an estimate from their length at this character's speed: %s%s. Routes timed for the account: %d."):format(speed, learned, n)
end

function M:ForgetTimes()
    SuuUI.AccountData("flightmap").routes = {}
    local data = self:CharData()
    data.speed, data.flights = nil, nil
    if self.session then self:UpdateRows(); self:UpdateBar() end
    self:QueueLayout()
end

function M:OnEnable()
    self:Attach()
    if not self.map then
        self:OnGameEvent("ADDON_LOADED", function()
            if not self.map and _G.WorldMapFrame then self:Attach(); self:OnEnable() end
        end)
        return
    end
    self:RegisterSettings(SECTION)
    self:BuildTimer()
    self:RegisterMover(self.timer, { key = "timerPosition", label = "Flight timer",
        enabled = function() return self:Get("timer") end })
    self.map:AddDataProvider(self.provider)
    self.layer:Show()
    -- every flight's route, whichever map took it (the hook stays; it
    -- does nothing while the module is off)
    if not self.takeHooked and TakeTaxiNode then
        self.takeHooked = true
        hook("TakeTaxiNode", function(slot) if self:IsEnabled() then self:Taking(slot) end end)
    end
    self:OnGameEvent("TAXIMAP_OPENED", function() self:OnTaxiOpened() end)
    self:OnGameEvent("TAXIMAP_CLOSED", function() self:LeaveMaster(true) end)
    -- on a taxi a moment after control goes; landed when it comes back
    self:OnGameEvent("PLAYER_CONTROL_LOST", function()
        local at = GetTime()
        after(0.5, function() self:FlightStarted(at) end)
    end)
    self:OnGameEvent("PLAYER_CONTROL_GAINED", function()
        local at = GetTime()
        after(0.3, function() if not UnitOnTaxi("player") then self:FlightEnded(at) end end)
    end)
    self:OnGameEvent("PLAYER_ENTERING_WORLD", function()
        if not self.flight then self:ResumeFlight() end
        self:QueueLayout()
        self:UpdateTimer()
    end)
    self:Watch("atMaster", function() if not self:Get("atMaster") and self.session then self:LeaveMaster(false) end end)
    self:Watch("inFlight", function() self:QueueLayout() end)
    self:Watch("timer", function()
        SuuUI.EditMode.Refresh()
        self:UpdateTimer()
    end)
    self:Watch("timerPosition", function() self:UpdateTimer() end)
    self:On("SUUUI_EDITMODE_CHANGED", function() self:UpdateTimer() end)
    -- (a destination chosen to confirm: let go when clicks fly at once)
    self:Watch("confirm", function()
        if self.session and not self:Get("confirm") and self.selected then
            self.selected = nil
            self:UpdateBar()
            self:UpdateRows()
            self:QueueInk()
        end
    end)
    -- a theme: the tags, the bar and the flight bar measured again
    self:On("SUUUI_THEME_CHANGED", function()
        if self.session then self:UpdateBar() end
        self:LayoutTimer()
        self:UpdateTimer()
        self:QueueLayout()
    end)
    -- (once the module counts as on)
    after(0, function() self:UpdateTimer() end)
end

function M:OnDisable()
    -- (at a flight master: the game's own map back, the session open)
    self:LeaveMaster(false)
    self.flight, self.pending = nil, nil
    if self.timer then self.timer:Hide() end
    if not self.map then return end
    self.map:RemoveDataProvider(self.provider)
    self:ClearDrawing()
    self.layer:Hide()
    refreshPins()
end
