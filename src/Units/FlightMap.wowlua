-- Units/FlightMap.wowlua
-- The flight map (design "Flight paths", D: one map for flying): no window
-- of its own. At a flight master SuuUI's world map becomes the taxi map:
-- the continent with every flight master of yours (the ones you haven't
-- found faint, their edge dashed), the routes between those you have as
-- faint lines, each destination's flight time beside it, and the
-- destinations listed in the side panel over the quest log. Hovering one
-- draws its route; clicking it flies there, or (Confirm before flying) puts
-- where it stops, the cost, the time and Fly in a bar at the map's bottom.
-- In the air the same map shows your flight: the part flown solid, the rest
-- dashed, the time left at the destination; with the map closed, the flight
-- bar at the top of the screen does (the time left, the stops passed and
-- ahead, when you land), with Land at to come down at the next stop.
-- Every route is drawn the way
-- the game flies it (SuuUI.FlightPaths: its waypoints, put on the shown map
-- through world coordinates), else straight from master to master.
--
-- The game's own flight map (TaxiFrame) stays open underneath, unseen and
-- without the mouse: hiding it ends the flight master's session, alpha 0
-- keeps it, and TakeTaxiNode from SuuUI's click flies (probed 2026-10-19).
-- The world map is shown outside the game's panel manager: through it, it
-- would take TaxiFrame's place (both are "left" panels) and close it.
-- Closing the map closes the flight master too. In combat the game's own
-- flight map opens as it would.
--
-- Flight times: each flight is timed, from losing control to getting it
-- back, and kept per route (the nodes it passes) for the whole account; a
-- route not flown yet is estimated from its length (SuuUI.FlightRoutes) at
-- the character's speed. That starts at 30.3 yards a second (fitted to
-- Classic's measured flight times; three flights on Forever came within
-- 0.4% of it, 2026-10-19), and each flight moves it a quarter of the way
-- toward what it measured. A flight far off its estimate (an early landing)
-- or begun before a reload teaches nothing; one set down at a stop by Land
-- at is timed as the route to that stop. The speed is kept per
-- character, should Forever give one a faster flight; a route's time
-- carries the speed of whoever flew it and is scaled to yours when the two
-- differ by more than 3%.
-- A built-in module written against the public API only.
-- (The game's map canvas and taxi functions declare their results `any`:
-- each is read through wowlua:secret and wowlua:frames where it's used.)

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import WORLD_MAP, FLIGHT_MAP from "/Core/ServiceKeys"
import chromeOf from "/UI/WindowSkin"
import Panel from "/UI/Panel"
import type ScrollArea, SectionHeader from "/UI/Panel"
import MapPin from "/UI/MapPin"
import type Border from "/UI/Draw"
import type Text from "/UI/Text"
import type SuuButton from "/UI/Controls"
import type Money from "/UI/Inventory"
import type Bar from "/UI/Bar"
import type TooltipData, TooltipLine from "/UI/Tooltip"
import type Position from "/EditMode/EditMode"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import * as events from "wowlua:events"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import clock, coins, short, junk, fitWay, span, dashes, nearest, alongByShare, shares, hopShares, flightTime, timeText,
    viaText, stopsText, stepsText, nearestMaster from "/Units/FlightMap/Route"
import type TaxiNode, RouteRecord from "/Units/FlightMap/Route"
import * as maths from "/Units/FlightMap/Route"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local try, field = errors.try, tbl.field
local asNumber, asString, flag = secret.asNumber, secret.asString, secret.flag

local DEFAULTS = {
    atMaster = true, inFlight = true, confirm = false, timer = true,
    -- the flight bar: top centre, at the screen-edge inset
    timerPosition = { point = "TOP", x = 0, y = -28 } :: Position,
}

local M: FlightMapModule

-- A flight master on the flight master's map (M:ReadSession).
type Session = { nodes: TaxiNode[], byID: { [number]: TaxiNode }, current?: TaxiNode }
-- A map to draw on: its masters' places (0-1) and its size in px (M:Way).
type View = { map: number, pos: { [number]: number[] }, w: number, h: number }
-- A flight's route for the flight bar (M:FlightRoute).
-- (placed on the continent's map; else only each master's share, at)
type Route = { at: { [number]: number }, map?: number, w?: number, h?: number, points?: number[][], run?: number[], total?: number }
type PlacedRoute = { at: { [number]: number }, map: number, w: number, h: number, points: number[][], run: number[], total: number }
-- A flight in the air: its route (nodeIDs), when it started, its expected
-- time and whether that was measured, its stops' names, the stop Land at
-- set it down at, whether it began before a reload; worked out on the way:
-- its route for the bar, the next stop ahead.
type Flight = {
    path: number[], started: number, expected?: number, measured?: boolean, names: { [number]: string },
    early?: number, reloaded?: boolean, route?: Route | false, namesRead?: boolean, ahead?: number,
}
-- A flight taken and not yet in the air (TakeTaxiNode ran).
type Pending = { path: number[], at: number, names: { [number]: string } }
-- What a character keeps: its speed, how many flights taught it, its flight
-- over a reload.
type Kept = { path: number[], wall?: number, names?: { [number]: string }, early?: number }
type FlightChar = { speed?: number, flights?: number, flight?: Kept }
-- What the account keeps: the routes timed.
type FlightAccount = { routes?: { [string]: RouteRecord } }

local TEXTURES = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local GLYPHS = TEXTURES .. "Glyphs\\"
local DISC = TEXTURES .. "CircleFill.tga"
local DASHED = TEXTURES .. "CircleDash.tga"

local SPEED = 30.3 -- yards a second, before a character has flown (see the header)
local LEARN = 0.25 -- how far one flight moves the speed toward what it measured
local TRUST = 0.2  -- a flight further than this off its expected time teaches nothing
local BOOST = 0.03 -- speeds further apart than this: another character's time is scaled
local KEEP = 5     -- a route's time: the mean of its last flights, up to this many
local MAX_FLIGHT = 1800 -- s: a flight kept over a reload longer than this is stale

local ROW_H = 36
local PIN = 26 -- UI.MapPin's size
local MAX_DASHES = 120 -- on one dashed line

--------------------------------------------------------------------------------
-- What the game gives
--------------------------------------------------------------------------------

local function continentOf(mapID: number?): number?
    local info = mapID and errors.tryValue(C_Map.GetMapInfo, mapID) or nil
    local continent = asNumber(field(Enum, "UIMapType", "Continent")) or 2
    local guard = 0
    while info and guard < 8 do
        if info.mapType == continent then return info.mapID end
        local parent = info.parentMapID
        info = parent and parent > 0 and errors.tryValue(C_Map.GetMapInfo, parent) or nil
        guard = guard + 1
    end
    return nil
end

local function bestMap(): number?
    return errors.tryValue(C_Map.GetBestMapForUnit, "player")
end

-- A position's x, y as the game gives it (a Vector2D), read.
local function xyOf(pos: unknown): (number?, number?)
    local x, y = errors.tryMethod(pos, "GetXY")
    return asNumber(x), asNumber(y)
end

-- Every flight master's place on a map, by nodeID (anywhere, a flight
-- master or not; a zone's map gives its continent's too, outside 0-1).
local function positions(mapID: number?): { [number]: number[] }
    local out: { [number]: number[] } = {}
    if not mapID then return out end
    for _, n in ipairs(errors.tryValue(C_TaxiMap.GetTaxiNodesForMap, mapID) or {}) do
        local x, y = xyOf(n.position)
        local id = asNumber(n.nodeID)
        if id and x and y then out[id] = { x, y } end
    end
    return out
end

local function hopYards(a: number, b: number): number?
    return maths.hopYards(SuuUI.FlightRoutes(), a, b)
end

-- A flight's length: its hops added up; nil when one isn't known.
local function pathYards(path: number[]): number?
    return maths.pathYards(SuuUI.FlightRoutes(), path)
end

-- A hop's way on a map: its waypoints (SuuUI.FlightPaths(); the reverse
-- hop's backwards when only that one is there) as the map's positions, kept
-- per map; false when there's none, or when the map puts its ends away from
-- the two masters (pa, pb: their places on it), then it's drawn straight.
local ways: { [number]: { [string]: number[][] | false } } = {}

local function hopWay(mapID: number, a: number, b: number, pa: number[], pb: number[]): number[][] | false
    local mine = ways[mapID] or {}
    ways[mapID] = mine
    local key = a .. ">" .. b
    local cached = mine[key]
    if cached ~= nil then return cached end
    local got: number[][] | false = false
    local paths = SuuUI.FlightPaths()
    local fromA, fromB = paths[a], paths[b]
    local data, back = fromA and fromA[b], false
    if not data then data, back = fromB and fromB[a], true end
    if data and C_Map.GetMapPosFromWorldPos and CreateVector2D then
        local points: number[][] = {}
        local whole = true
        for i = 2, #data - 1, 2 do
            -- (the world's x, y as the client tables give them: x north, y west)
            local onMap, pos = try(C_Map.GetMapPosFromWorldPos, data[1], CreateVector2D(data[i], data[i + 1]), mapID)
            local x, y = nil, nil
            if asNumber(onMap) == mapID then x, y = xyOf(pos) end
            if x == nil or y == nil then whole = false break end
            points[#points + 1] = { x, y }
        end
        -- each end near its master: within a quarter of the hop
        if whole then got = fitWay(points, back, pa, pb) end
    end
    mine[key] = got
    return got
end

-- The world's yards at a map's place, nil when the game doesn't say.
local function worldXY(mapID: number, x: number, y: number): (number?, number?)
    local _, pos = try(C_Map.GetWorldPosFromMapPos, mapID, CreateVector2D(x, y))
    return xyOf(pos)
end

-- Your place on a map (0-1), nil while the game doesn't give it.
local function myPlace(mapID: number?): (number?, number?)
    if not mapID then return nil, nil end
    local x, y = xyOf((try(C_Map.GetPlayerMapPosition, mapID, "player")))
    if x and y and (x > 0 or y > 0) then return x, y end
    return nil, nil
end

-- One of the game's taxi functions by name, called quietly; its first value.
local function taxi(name: string, ...: unknown): unknown
    return (try(field(_G, name), ...))
end

--------------------------------------------------------------------------------
-- Flight times
--------------------------------------------------------------------------------

-- the routes timed, for the account: [nodeID>nodeID>…] = { t (s), n, v (the
-- flyer's speed) }
local function timed(): { [string]: RouteRecord }
    local data = SuuUI.AccountData("flightmap") :: unknown :: FlightAccount
    local routes = data.routes or {}
    data.routes = routes
    return routes
end

--------------------------------------------------------------------------------
-- The header row's quest log controls (its search, count and settings) and
-- the waypoint pin: nothing to do at a flight master (asked 2026-10-19);
-- unseen and out of the mouse's way, back after. (The world map module
-- puts its own Map filters away.)
--------------------------------------------------------------------------------

local function headerControls(): Region[]
    local out: Region[] = {}
    local found = { field(_G, "QuestScrollFrame", "SearchBox"), field(_G, "QuestLogCount"),
                    field(_G, "QuestScrollFrame", "SettingsDropdown"), field(_G, "WorldMapFrame", "WorldMapTrackingPinButton") }
    for i = 1, 4 do
        local r = frames.asRegion(found[i])
        if r then out[#out + 1] = r end
    end
    return out
end

-- Your quests' next steps (asked 2026-10-19): where the game's quest pins
-- put each quest in your log, its objectives' area or, done, where it's
-- turned in; each counted for the flight master nearest to it, within
-- NEAR yards. { [nodeID] = { questID, ... } } for the session's masters.
local NEAR = 800

local function inside(p: number[]): boolean return p[1] >= -0.01 and p[1] <= 1.01 and p[2] >= -0.01 and p[2] <= 1.01 end

--------------------------------------------------------------------------------
-- The parts
--------------------------------------------------------------------------------

-- A tag beside a pin or a destination: its text on glass.
class Tag extends Frame
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        UI.Fill(self, "surface-glass"):SetAllPoints()
        UI.Border(self, "gilt-hairline")
        self.text = UI.Text(self, "micro", "ink")
        self.text:SetPoint("CENTER", 0, 0)
    end
end

local function setTag(tag: Tag, text: string, color: string)
    tag.text:SetValue(text)
    tag.text:SetColor(color)
    tag:SetSize(math.ceil(tag.text:GetUnboundedStringWidth()) + 10, T.type.micro.lineHeight + 2)
    tag:Show()
end

-- A flight master's pin: the time (or "You are here") right of it.
class FlightPin extends MapPin
    readonly tag: Tag
    node: TaxiNode? = nil

    constructor(parent: Frame)
        super(parent)
        self.tag = Tag.new(self)
        self.tag:SetPoint("LEFT", self, "RIGHT", 3, 0)
    end
end

-- The lines of one draw layer, pooled (n in use).
type LinePool = { n: number, [number]: Line }
-- A stop on a route in flight: a small gilt disc on a surface rim.
type Dot = { rim: Texture, fill: Texture }

-- The drawing on the map's canvas: lines (the dark underlay under the
-- gilt), stops' dots, the time left in flight by the destination.
class Ink extends Frame
    readonly pools: { BORDER: LinePool, ARTWORK: LinePool } = { BORDER = { n = 0 }, ARTWORK = { n = 0 } }
    readonly dots: Dot[] = {}
    dotN: number = 0
    readonly left: Tag

    constructor(parent: Frame)
        super(nil, parent)
        self.left = Tag.new(self)
        self.left:SetFrameLevel(self:GetFrameLevel() + 8)
        self.left:Hide()
    end
end

-- A destination's row in the side panel.
class DestRow extends Button
    readonly fill: Texture
    readonly edge: Border
    readonly glyph: Texture
    readonly time: Text
    readonly name: Text
    readonly stops: Text
    hover: boolean = false
    node: TaxiNode? = nil

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(ROW_H)
        self.fill = UI.Fill(self, "surface-raised", "BACKGROUND")
        self.fill:SetAllPoints()
        self.fill:Hide()
        self.edge = UI.Border(self, "gilt-line")
        self.edge:SetShown(false)
        self.glyph = self:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. "wing.tga")
        self.glyph:SetSize(14, 14)
        self.glyph:SetPoint("LEFT", S["space-4"], 0)
        UI.Paint(self.glyph, "gilt-text")
        self.time = UI.Text(self, "numeric", "ink")
        self.time:SetPoint("RIGHT", -S["space-4"], 0)
        -- the name over the row's middle, its stops under it; the time's
        -- room kept on the right
        local x = S["space-4"] + 14 + S["space-4"]
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("BOTTOMLEFT", self, "LEFT", x, 0)
        self.name:SetPoint("BOTTOMRIGHT", self, "RIGHT", -64, 0)
        self.name:SetJustifyH("LEFT")
        self.stops = UI.Text(self, "caption", "ink-muted")
        self.stops:SetPoint("TOPLEFT", self, "LEFT", x, 0)
    end
end

-- The side panel: the destinations.
class Side extends Frame
    readonly edge: Border
    readonly head: SectionHeader
    readonly scroll: ScrollArea
    readonly rows: DestRow[] = {}

    constructor(parent: Frame)
        super(nil, parent)
        self:EnableMouse(true)
        self:Hide()
        UI.Fill(self, "surface", "BACKGROUND"):SetAllPoints()
        self.edge = UI.Border(self, "gilt-line")
        self.head = UI.SectionHeader(self, "Destinations", "")
        self.head:SetPoint("TOPLEFT", S["space-5"], -S["space-5"])
        self.head:SetPoint("TOPRIGHT", -S["space-5"], -S["space-5"])
        self.scroll = UI.ScrollArea(self, 2)
        self.scroll:SetPoint("TOPLEFT", self.head, "BOTTOMLEFT", 0, -S["space-4"])
        self.scroll:SetPoint("BOTTOMRIGHT", -S["space-5"] - S["space-3"], S["space-5"])
    end
end

-- The bar at the map's bottom: the chosen destination and Fly.
class FlyBar extends Panel
    readonly glyph: Texture
    readonly name: Text
    readonly via: Text
    readonly rule: Texture
    readonly money: Money
    readonly clock: Texture
    readonly time: Text
    readonly fly: SuuButton

    constructor(parent: Frame, onFly: () -> ())
        super(parent, { ornament = true })
        -- (over the map's pins, the game's and SuuUI's, as the status line)
        self:SetFrameLevel(4000)
        self.body:SetFrameLevel(4001)
        self:EnableMouse(true)
        self:Hide()
        local body = self.body
        self.glyph = body:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. "wing.tga")
        self.glyph:SetSize(15, 15)
        UI.Paint(self.glyph, "gilt-text")
        self.name = UI.Text(body, "unit-name", "ink")
        self.via = UI.Text(body, "caption", "ink-muted")
        self.rule = UI.Fill(body, "gilt-faint", "ARTWORK")
        self.rule:SetWidth(1)
        self.money = UI.Money(body)
        self.clock = body:CreateTexture(nil, "ARTWORK")
        self.clock:SetTexture(GLYPHS .. "hourglass.tga")
        self.clock:SetSize(11, 11)
        UI.Paint(self.clock, "ink-faint")
        self.time = UI.Text(body, "numeric", "ink-muted")
        self.fly = UI.Button(body, { text = "Fly", variant = "primary", icon = "wing", onClick = onFly,
                                     tooltip = { title = "Fly", description = "Take this flight (the cost is paid at once)." } })
    end
end

--------------------------------------------------------------------------------
-- In the air with the map closed: the flight bar
--------------------------------------------------------------------------------

-- The flight bar (board option B, "In flight"): top centre, as wide as a
-- cast bar, from take-off to landing while the world map is closed (open,
-- the map shows the route instead). The destination and the time left over
-- a thin bar, a diamond at each stop (placed by its distance along the
-- route, gilt once passed), the next stop and when you land under it. A
-- route never flown says so: estimated (its time marked ~, the fill
-- hatched), or with no estimate either, the time flown so far over a
-- sweep. While a stop is ahead, Land at under them asks the game to set you
-- down there (its early landing, as its own leave button does; from SuuUI's
-- click it isn't blocked, probed 2026-10-19): the bar then shows that stop
-- as the destination, the time to it its share of the route. The button is
-- the bar's only part that takes the mouse. The text once a second, the
-- fill every frame; with Reduce motion the fill once a second and the sweep
-- still. Its height is its lines' (the button's row only while it shows).

local TIMER_W = 300  -- a cast bar's width (the board's)
local TRACK_H = 6
local STOP = 8       -- a stop's diamond
local GLYPH = 13
local SWEEP = 0.22   -- the sweep, of the bar's width
local SWEEP_T = 1.8  -- s for the sweep to cross
local WHITE = "Interface\\Buttons\\WHITE8X8"
local HATCH = TEXTURES .. "Hatch.tga"

-- A stop's diamond on the bar: its rim, and its middle (gilt once passed).
type StopMark = { rim: Texture, dot: Texture }
-- The fill between ticks: from `base` at `at`, `rate` of the bar a second.
type Drive = { flight?: Flight, base: number, rate: number, at: number, shown: number }
-- What the bar shows (M:TimerView): the destination, the time and its
-- colour, the lines under the bar, the fill ("solid", "hatch" or none: the
-- sweep), how far and how fast, the stops, the stop Land at names.
type TimerView = {
    flight?: Flight, name: string, time: string, timeColor: string, fill?: string, frac?: number, rate?: number,
    left: string, right: string, stops: { at: number, passed: boolean }[], land?: string,
}

class FlightTimer extends Panel
    readonly glyph: Texture
    readonly name: Text
    readonly time: Text
    readonly track: Bar
    readonly hatch: Texture
    readonly clip: Frame
    readonly sweep: Frame
    readonly marks: Frame
    readonly stops: StopMark[] = {}
    readonly next: Text
    readonly lands: Text
    readonly land: SuuButton
    landAt: string? = nil
    fillToken: string? = nil
    drive: Drive? = nil
    still: boolean = false

    constructor(parent: Frame, onLand: () -> ())
        super(parent, { name = "SuuUIFlightTimer", width = TIMER_W, ornament = true })
        self:SetFrameStrata("LOW")
        self:Hide()
        local body = self.body
        self.glyph = body:CreateTexture(nil, "ARTWORK")
        self.glyph:SetTexture(GLYPHS .. "wing.tga")
        self.glyph:SetSize(GLYPH, GLYPH)
        UI.Paint(self.glyph, "gilt-text")
        self.name = UI.Text(body, "unit-name-sm", "ink")
        self.name:SetJustifyH("LEFT")
        self.time = UI.Text(body, "numeric", "ink")
        -- the bar: the fill (hatched while estimated), the sweep while there's
        -- no telling, the stops over both
        self.track = UI.StatusBar(body, { width = TIMER_W, height = TRACK_H, track = "track", fill = "gilt", border = false })
        local fill = self.track.bar:GetStatusBarTexture()
        self.hatch = self.track.bar:CreateTexture(nil, "OVERLAY")
        self.hatch:SetTexture(HATCH, "REPEAT", "REPEAT")
        self.hatch:SetHorizTile(true)
        self.hatch:SetVertTile(true)
        self.hatch:SetPoint("TOPLEFT", fill, "TOPLEFT")
        self.hatch:SetPoint("BOTTOMRIGHT", fill, "BOTTOMRIGHT")
        UI.Paint(self.hatch, "gilt")
        self.clip = CreateFrame("Frame", nil, self.track)
        self.clip:SetAllPoints()
        self.clip:SetClipsChildren(true)
        self.clip:SetFrameLevel(self.track.bar:GetFrameLevel() + 1)
        self.sweep = CreateFrame("Frame", nil, self.clip)
        for i, from in ipairs({ 0, 1 }) do
            local t = self.sweep:CreateTexture(nil, "ARTWORK")
            t:SetTexture(WHITE)
            t:SetPoint("TOPLEFT", self.sweep, i == 1 and "TOPLEFT" or "TOP")
            t:SetPoint("BOTTOMRIGHT", self.sweep, i == 1 and "BOTTOM" or "BOTTOMRIGHT")
            UI.PaintGradient(t, "HORIZONTAL", "gilt", "gilt", from, 1 - from)
        end
        self.marks = CreateFrame("Frame", nil, self.track)
        self.marks:SetAllPoints()
        self.marks:SetFrameLevel(self.track.bar:GetFrameLevel() + 2)
        self.next = UI.Text(body, "caption", "ink-muted")
        self.next:SetJustifyH("LEFT")
        self.lands = UI.Text(body, "caption", "ink-faint")
        self.land = UI.Button(body, { variant = "quiet", onClick = onLand })
        self.land:Hide()
    end

    -- a stop's diamond: gilt-text rim, gilt once passed, surface ahead
    function Stop(i: number): StopMark
        local d = self.stops[i]
        if not d then
            d = { rim = UI.Diamond(self.marks, STOP, "gilt-text", "OVERLAY", 6), dot = UI.Diamond(self.marks, STOP - 2, "surface", "OVERLAY", 7) }
            self.stops[i] = d
        end
        return d
    end
end

-- "18:42" (or "6:42 PM", as the game's clock is set): the local time
-- `seconds` from now
local function clockAt(seconds: number): string
    local stamp = time() + math.floor(math.max(0, seconds) + 0.5)
    local hour, min = tonumber(date("%H", stamp)) or 0, tonumber(date("%M", stamp)) or 0
    if C_CVar.GetCVarBool("timeMgrUseMilitaryTime") then return ("%02d:%02d"):format(hour, min) end
    return ("%d:%02d %s"):format((hour - 1) % 12 + 1, min, hour >= 12 and "PM" or "AM")
end

