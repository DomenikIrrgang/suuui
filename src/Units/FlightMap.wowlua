-- Units/FlightMap.wowlua
-- The flight map (design "Flight paths", D: one map for flying). At a
-- flight master a window of its own, made like SuuUI's world map (its
-- chrome, its size, the game's map canvas in it), is the taxi map: the
-- continent with every flight master of yours (the ones you haven't
-- found faint, their edge dashed), the routes between those you have as
-- faint lines, each destination's flight time beside it, and the
-- destinations listed in the side panel on its right. Hovering one
-- draws its route; clicking it flies there, or (Confirm before flying) puts
-- where it stops, the cost, the time and Fly in a bar at the map's bottom.
-- In the air the world map shows your flight, on whichever map it shows:
-- the part flown solid, the rest dashed, the time left at the destination; with the map closed, the flight
-- bar at the top of the screen does (the time left, the stops passed and
-- ahead, when you land), with Land at to come down at the next stop.
-- Every route is drawn the way
-- the game flies it (SuuUI.FlightPaths: its waypoints, put on the shown map
-- through world coordinates), else straight from master to master.
--
-- The game's own flight map (TaxiFrame) stays open underneath, unseen and
-- without the mouse: hiding it ends the flight master's session, alpha 0
-- keeps it, and TakeTaxiNode from SuuUI's click flies (probed 2026-10-19).
-- The flight master's window is SuuUI's own, not the world map: the world
-- map opened and switched to the continent from SuuUI's code kept its zoom
-- tainted, and opened in combat later the game refused it ("Blocked:
-- SetPassThroughButtons", found in game; asked 2026-11-06). Nor is the
-- world map switched in the air any more. Closing the window closes the
-- flight master too. In combat the game's own flight map opens as it would.
--
-- Flight times: each flight is timed, from losing control to getting it
-- back, and kept per route (the nodes it passes) for the whole account; a
-- route not flown yet is estimated from its length (SuuUI.FlightRoutes) at
-- the character's speed. That starts at 30.3 yards a second (fitted to
-- Classic's measured flight times; three flights on Forever came within
-- 0.4% of it, 2026-10-19), and each flight moves it a quarter of the way
-- toward what it measured. A flight far off its estimate (an early landing)
-- or begun before a reload teaches nothing; one set down at a stop by Land
-- at is timed as the route to that stop. The speed is kept per
-- character, should Forever give one a faster flight; a route's time
-- carries the speed of whoever flew it and is scaled to yours when the two
-- differ by more than 3%.
-- A built-in module written against the public API only.
-- (The game's map canvas and taxi functions declare their results `any`:
-- each is read through wowlua:secret and wowlua:frames where it's used.)
--
-- What lives where: this file is the module (its settings, its lifecycle,
-- the flight master's session: entering and leaving it, the game's flight
-- map kept open underneath, choosing and flying) and keeps every method by
-- its name; the rest of the work is in Units/FlightMap/, the methods
-- forwarding to it, each function taking the module:
--   Route    the maths and texts, pure (lengths, waypoints, dashes, shares, texts)
--   Taxi     what the game gives (places, a hop's way on a map, the session read, quest steps)
--   Flights  a flight taken, in the air, landed and timed; the speed learned
--   Parts    the widgets (tags, pins, the drawing, the destinations' rows and panel, the Fly bar)
--   Window   the flight master's window, its tooltips, side panel and Fly bar
--   Canvas   the surfaces on a map canvas and what's drawn on them
--   Timer    the flight bar in the air with the map closed

import SuuUI, Module from "/Core/API"
import type SettingsSection, TooltipData, Position from "/Core/API"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import short from "/Units/FlightMap/Route"
import type TaxiNode from "/Units/FlightMap/Route"
import continentOf, bestMap from "/Units/FlightMap/Taxi"
import type Session from "/Units/FlightMap/Taxi"
import * as flightTaxi from "/Units/FlightMap/Taxi"
import type Flight, Pending, FlightChar, Route from "/Units/FlightMap/Flights"
import * as flights from "/Units/FlightMap/Flights"
import type Ink, FlightPin, DestRow, Side, FlyBar from "/Units/FlightMap/Parts"
import type Surface, View from "/Units/FlightMap/Canvas"
import * as flightCanvas from "/Units/FlightMap/Canvas"
import type FlightTimer, TimerView from "/Units/FlightMap/Timer"
import * as flightTimer from "/Units/FlightMap/Timer"
import * as flightWindow from "/Units/FlightMap/Window"

local WORLD_MAP = SuuUI.Services.WORLD_MAP
local FLIGHT_MAP = SuuUI.Services.FLIGHT_MAP
local chromeOf = SuuUI.UI.WindowChrome

local UI = SuuUI.UI

local field = tbl.field
local asNumber = secret.asNumber

local DEFAULTS = {
    atMaster = true,
    inFlight = true,
    confirm = false,
    timer = true,
    -- the flight bar: top centre, at the screen-edge inset
    timerPosition = { point = "TOP", x = 0, y = -28 } :: Position,
}

local M: FlightMapModule

-- Settings › Flight map
local SECTION: SettingsSection = {
    id = "flightmap",
    label = "Flight map",
    category = "World",
    order = 13,
    groups = {
        {
            title = "At a flight master",
            rows = {
                {
                    key = "atMaster",
                    label = "The world map as the flight map",
                    control = "toggle",
                    description = "At a flight master SuuUI's world map shows where you can fly: every flight master, the routes between the ones you've found, and each flight's time and cost. Click a destination to fly there. Off: the game's own flight map.",
                },
                {
                    key = "confirm",
                    label = "Confirm before flying",
                    control = "toggle",
                    disabled = function(): (boolean, string)
                        return not M:Get("atMaster"), "The world map as the flight map is off."
                    end,
                    description = "A click on a destination chooses it, and Fly in the bar at the map's bottom takes the flight. Off: the click flies there at once (hovering still shows the route, the cost and the time).",
                },
            },
        },
        {
            title = "While flying",
            rows = {
                {
                    key = "inFlight",
                    label = "Your flight on the map",
                    control = "toggle",
                    description = "Open the map in the air to see your route: the part flown solid, the rest dashed, the time left at your destination.",
                },
                {
                    key = "timer",
                    label = "Flight timer on screen",
                    control = "toggle",
                    description = "While you fly with the map closed: a bar at the top of the screen with your destination and the time left, a diamond for each stop (gilt once passed), the next stop and when you land, and Land at to come down at the next stop instead of flying on. A route not flown yet shows an estimate, marked ~. Move it in edit mode.",
                },
            },
        },
        {
            title = "Flight times",
            rows = {
                {
                    label = "Timed flights",
                    control = "button",
                    text = "Forget",
                    description = function(): string
                        return M:TimesSummary()
                    end,
                    onClick = function()
                        UI.Confirm({
                            title = "Forget flight times?",
                            text = "Every route's measured time, for all your characters, and this character's flight speed. Times are estimated from the routes' lengths again until you fly them.",
                            confirm = "Forget",
                            onConfirm = function()
                                M:ForgetTimes()
                            end,
                        })
                    end,
                },
            },
        },
    },
}

export class FlightMapModule extends Module<typeof(DEFAULTS)>
    -- the map drawn on now (the surface's), and the surfaces
    map: typeof(WorldMapFrame)? = nil
    surface: Surface? = nil
    world: Surface? = nil
    own: Surface? = nil
    -- the flight master's window (its canvas: own.map)
    window: Frame? = nil
    layer: Frame? = nil
    ink: Ink? = nil
    provider: { [string]: unknown }? = nil
    pins: FlightPin[] = {}
    free: FlightPin[] = {}
    -- pins made in combat, their right-click through after it
    passLater: Frame[] = {}
    -- the map drawn on at the last layout
    view: View? = nil
    -- at a flight master: the session, the last one read, the destination
    -- chosen and hovered, the quests' steps by master
    session: Session? = nil
    last: Session? = nil
    selected: TaxiNode? = nil
    hovered: TaxiNode? = nil
    steps: { [number]: number[] } = {}
    side: Side? = nil
    bar: FlyBar? = nil
    timer: FlightTimer? = nil
    -- in the air, and a flight taken
    flight: Flight? = nil
    pending: Pending? = nil
    -- the game's flight map's frames that took the mouse
    gameQuiet: Frame[]? = nil
    closing: boolean = false
    layoutQueued: boolean = false
    inkQueued: boolean = false
    takeHooked: boolean = false

    constructor()
        super({
            id = "flightmap",
            name = "Flight map",
            description = "The world map as the flight master's map: routes, costs and flight times, and your flight on the map while you fly.",
            api = "0.17",
            combatSafe = true,
            defaults = DEFAULTS,
        })
    end

    -- What this character keeps (its data, typed).
    function Char(): FlightChar
        return self:CharData() :: unknown :: FlightChar
    end

    -- The flight master's map as the game gives it (Units/FlightMap/Taxi).
    function ReadSession(): Session?
        return flightTaxi.readSession()
    end

    --------------------------------------------------------------------------------
    -- Flight times (Units/FlightMap/Flights)
    --------------------------------------------------------------------------------

    function Speed(): number
        return flights.speedOf(self)
    end

    function FlightTime(path: number[]?): (number?, boolean?)
        return flights.flightTimeOf(self, path)
    end

    function Learn(flight: { path: number[], expected?: number, reloaded?: boolean }, seconds: number)
        flights.learn(self, flight, seconds)
    end

    --------------------------------------------------------------------------------
    -- A flight: taken, in the air, landed (Units/FlightMap/Flights)
    --------------------------------------------------------------------------------

    function Taking(slot: number)
        flights.taking(self, slot)
    end

    function FlightStarted(at: number)
        flights.flightStarted(self, at)
    end

    function FlightEnded(at: number)
        flights.flightEnded(self, at)
    end

    function ResumeFlight()
        flights.resumeFlight(self)
    end

    --------------------------------------------------------------------------------
    -- The game's flight map, kept open underneath
    --------------------------------------------------------------------------------

    -- Unseen, and neither it nor anything on it takes the mouse (an unseen
    -- node button would still fly where it was clicked). Only alpha and the
    -- mouse: hidden, it closes the flight master.
    function HideGameMap(): boolean
        local tf = frames.find("TaxiFrame")
        if not tf then
            return false
        end
        local quiet = self.gameQuiet or {}
        self.gameQuiet = quiet
        tf:SetAlpha(0)
        local function mute(f: Frame, depth: number)
            if f:IsMouseEnabled() then
                f:EnableMouse(false)
                quiet[#quiet + 1] = f
            end
            if depth < 3 then
                for _, c in ipairs(frames.children(f)) do
                    mute(c, depth + 1)
                end
            end
        end
        mute(tf, 0)
        return true
    end

    function ShowGameMap()
        local tf, quiet = frames.find("TaxiFrame"), self.gameQuiet
        if not (tf and quiet) then
            return
        end
        tf:SetAlpha(1)
        for _, f in ipairs(quiet) do
            f:EnableMouse(true)
        end
        self.gameQuiet = nil
    end

    --------------------------------------------------------------------------------
    -- At the flight master: the world map as the flight map
    --------------------------------------------------------------------------------

    function AtMaster(): boolean
        return self.session ~= nil
    end

    -- The world map module's pins away while the flight map shows, back after.
    function RefreshPins()
        local wm = SuuUI.UseService(WORLD_MAP)
        local refresh = wm and wm.Refresh
        if refresh then
            refresh()
        end
    end

    function OnTaxiOpened()
        self.last = self:ReadSession()
        if self.session then
            self:LeaveMaster(false)
        end
        if not (self:Get("atMaster") and self.map) or InCombatLockdown() then
            return
        end
        -- unseen at once (no flicker); the world map a frame later, once the
        -- game has put its own map up (it would close the world map if that
        -- showed first)
        if not self:HideGameMap() then
            return
        end
        self:After(0, function()
            self:EnterMaster(true)
        end)
    end

    function EnterMaster(retry: boolean)
        if not self.gameQuiet then
            return
        end
        local s = self:ReadSession()
        if not s then
            -- (the nodes a moment later; else the game's own map after all)
            if retry then
                self:After(0.2, function()
                    self:EnterMaster(false)
                end)
            else
                self:ShowGameMap()
            end
            return
        end
        local own, win = self:BuildWindow(), self.window
        if not (own and win) then
            self:ShowGameMap()
            return
        end
        self.last = s
        -- its new buttons, made as it showed, without the mouse too
        self:HideGameMap()
        self.session, self.selected, self.hovered = s, nil, nil
        self:Use(own)
        self:FitWindow()
        win:Show()
        win:Raise()
        local f = own.map
        local continent = continentOf(bestMap())
        if continent and asNumber(f:GetMapID()) ~= continent then
            f:SetMapID(continent)
        end
        local side = self:FillSide()
        self:PlaceSide()
        side:Show()
        self:UpdateBar()
        self:SetTitle(true)
        self:RefreshPins()
        self:QueueLayout()
    end

    -- The flight master closed (walked away, flown, or the window closed):
    -- the game's map back as it was, the window closed, the drawing back on
    -- the world map. (`closeMap`: kept for the callers; the window closes
    -- either way.)
    function LeaveMaster(_closeMap: boolean)
        local was = self.session ~= nil
        self.session, self.selected, self.hovered = nil, nil, nil
        self:ShowGameMap()
        local side, bar = self.side, self.bar
        if side then
            side:Hide()
        end
        if bar then
            bar:Hide()
        end
        if not was then
            return
        end
        local win = self.window
        if win and win:IsShown() then
            self.closing = true
            win:Hide()
            self.closing = false
        end
        local world = self.world
        if world then
            self:Use(world)
        end
        self:RefreshPins()
        self:QueueLayout()
    end

    -- The window's header: "Flight master · Thunder Bluff".
    function SetTitle(master: boolean)
        local chrome = chromeOf(self.window)
        local current = self.session and self.session.current
        if master and chrome and current then
            chrome:SetTitle("Flight master · " .. short(current.name))
        end
    end

    --------------------------------------------------------------------------------
    -- The flight master's window: SuuUI's window chrome round the game's map
    -- canvas (MapCanvasMixin, as the game's own flight map), the world map's
    -- size; the destinations on its right (Units/FlightMap/Window)
    --------------------------------------------------------------------------------

    function BuildWindow(): Surface?
        return flightWindow.buildWindow(self)
    end

    function FitWindow()
        flightWindow.fitWindow(self)
    end

    function Select(node: TaxiNode?)
        if not (self.session and node and node.kind == "REACHABLE") then
            return
        end
        self.selected = node
        self:UpdateBar()
        self:UpdateRows()
        self:QueueInk()
    end

    function Fly(node: TaxiNode?)
        local to = node or self.selected
        if not (self.session and to) then
            return
        end
        TakeTaxiNode(to.slot)
    end

    -- A destination clicked (its pin or its row): flown to at once; with
    -- Confirm before flying, chosen for the bar's Fly.
    function Choose(node: TaxiNode?)
        if not (self.session and node and node.kind == "REACHABLE") then
            return
        end
        if self:Get("confirm") then
            self:Select(node)
            return
        end
        self:Fly(node)
    end

    -- (Units/FlightMap/Taxi)
    function QuestSteps(s: Session?): { [number]: number[] }
        return flightTaxi.questSteps(s)
    end

    -- (Units/FlightMap/Window)
    function Tip(node: TaxiNode): TooltipData
        return flightWindow.tip(self, node)
    end

    --------------------------------------------------------------------------------
    -- The side panel: the destinations (Units/FlightMap/Window)
    --------------------------------------------------------------------------------

    function BuildSide(): Side
        return flightWindow.buildSide(self)
    end

    function Row(i: number): DestRow
        return flightWindow.makeRow(self, i)
    end

    function PaintRow(row: DestRow)
        flightWindow.paintRow(self, row)
    end

    function FillSide(): Side
        return flightWindow.fillSide(self)
    end

    function UpdateRows()
        flightWindow.updateRows(self)
    end

    function PlaceSide()
        flightWindow.placeSide(self)
    end

    --------------------------------------------------------------------------------
    -- The bar at the map's bottom: the chosen destination and Fly (Units/FlightMap/Window)
    --------------------------------------------------------------------------------

    function UpdateBar()
        flightWindow.updateBar(self)
    end

    --------------------------------------------------------------------------------
    -- On the map's canvas: pins, routes, times (Units/FlightMap/Canvas)
    --------------------------------------------------------------------------------

    function PassThrough(pin: Frame)
        flightCanvas.passThrough(self, pin)
    end

    function Pin(layer: Frame): FlightPin
        return flightCanvas.makePin(self, layer)
    end

    function Line(
        layer: "BORDER" | "ARTWORK",
        x1: number,
        y1: number,
        x2: number,
        y2: number,
        thickness: number,
        token: string,
        alpha: number?
    )
        flightCanvas.drawLine(self, layer, x1, y1, x2, y2, thickness, token, alpha)
    end

    function Dashes(
        layer: "BORDER" | "ARTWORK",
        points: number[][],
        dash: number,
        gap: number,
        thickness: number,
        token: string,
        alpha: number?
    )
        flightCanvas.drawDashes(self, layer, points, dash, gap, thickness, token, alpha)
    end

    function Way(path: number[], view: View?): (number[][]?, number[]?)
        return flightCanvas.routeWay(self, path, view)
    end

    function Solid(points: number[][], width: number, token: string)
        flightCanvas.drawSolid(self, points, width, token)
    end

    function Dot(x: number, y: number)
        flightCanvas.drawDot(self, x, y)
    end

    function ClearDrawing()
        flightCanvas.clearDrawing(self)
    end

    function ClearInk()
        flightCanvas.clearInk(self)
    end

    function DrawMaster(pos: { [number]: number[] }, w: number, h: number, cs: number)
        flightCanvas.drawMaster(self, pos, w, h, cs)
    end

    function InkMaster(pos: { [number]: number[] })
        flightCanvas.inkMaster(self, pos)
    end

    function Along(points: number[][], w: number, h: number): (number, number, number)
        return flightCanvas.along(self, points, w, h)
    end

    function DrawFlight(w: number, h: number)
        flightCanvas.drawFlight(self, w, h)
    end

    function Layout()
        flightCanvas.layout(self)
    end

    function DrawInk()
        flightCanvas.drawInk(self)
    end

    function QueueLayout()
        flightCanvas.queueLayout(self)
    end

    function QueueInk()
        flightCanvas.queueInk(self)
    end

    --------------------------------------------------------------------------------
    -- In the air with the map closed: the flight bar (Units/FlightMap/Timer)
    --------------------------------------------------------------------------------

    function StopName(fl: Flight, id: number): string
        return flightTimer.stopName(self, fl, id)
    end

    function FlightRoute(fl: Flight): Route | false
        return flightTimer.flightRoute(self, fl)
    end

    function Flown(fl: Flight, route: Route | false): number?
        return flightTimer.flownShare(self, fl, route)
    end

    function BuildTimer(): FlightTimer
        return flightTimer.buildTimer(self)
    end

    function LayoutTimer()
        flightTimer.layoutTimer(self)
    end

    function PaintTimer(v: TimerView)
        flightTimer.paintTimer(self, v)
    end

    function MoveTimer()
        flightTimer.moveTimer(self)
    end

    function TickTimer()
        flightTimer.tickTimer(self)
    end

    function TimerView(fl: Flight): TimerView
        return flightTimer.timerView(self, fl)
    end

    function LandEarly()
        flightTimer.landEarly(self)
    end

    function SampleTimer()
        flightTimer.sampleTimer(self)
    end

    function UpdateTimer()
        flightTimer.updateTimer(self)
    end

    --------------------------------------------------------------------------------
    -- The map (the surfaces: Units/FlightMap/Canvas)
    --------------------------------------------------------------------------------

    function MakeSurface(f: typeof(WorldMapFrame)): Surface?
        return flightCanvas.makeSurface(self, f)
    end

    function Surfaces(): Surface[]
        return flightCanvas.surfaces(self)
    end

    function Use(s: Surface)
        flightCanvas.useSurface(self, s)
    end

    -- The world map: the flight drawn on it in the air, on the map it shows
    -- (no longer switched to the continent: from SuuUI's code that kept the
    -- map tainted, asked 2026-11-06); the flight bar away while it's open.
    function Attach()
        if self.world or not frames.find("WorldMapFrame") then
            return
        end
        local f = WorldMapFrame
        local s = self:MakeSurface(f)
        if not s then
            return
        end
        self.world = s
        self:Use(s)
        hookScript(f, "OnHide", function()
            self:UpdateTimer()
        end)
        hookScript(f, "OnShow", function()
            self:UpdateTimer()
        end)
    end

    -- (Units/FlightMap/Flights)
    function TimesSummary(): string
        return flights.timesSummary(self)
    end

    function ForgetTimes()
        flights.forgetTimes(self)
    end

    override function OnEnable()
        -- whether it's open at a flight master, for the world map
        self:ProvideService(FLIGHT_MAP, {
            AtMaster = function(): boolean
                return self:AtMaster()
            end,
        })
        self:Attach()
        if self.world then
            self:Start()
            return
        end
        -- (where the world map loads later: the rest once it's there; the
        -- listener goes then, X-11.a5)
        self:OnGameEvent("ADDON_LOADED", function()
            if not self.world and frames.find("WorldMapFrame") then
                self:Attach()
                if self.world then
                    self:Off("ADDON_LOADED")
                    self:Start()
                end
            end
        end)
    end

    -- Everything else, once the world map is attached.
    function Start()
        self:RegisterSettings(SECTION)
        local timer = self:BuildTimer()
        -- (shown only in the air, and in edit mode)
        self:RegisterMover(timer, {
            key = "timerPosition",
            label = "Flight timer",
            managedShow = true,
            apartFrom = "timeline.position",
            enabled = function(): boolean
                return self:Get("timer")
            end,
        })
        -- (the flight master window's surface, made before a disable, too)
        for _, s in ipairs(self:Surfaces()) do
            s.map:AddDataProvider(s.provider)
            s.layer:Show()
        end
        -- every flight's route, whichever map took it (the hook stays; it
        -- does nothing while the module is off)
        if not self.takeHooked and type(field(_G, "TakeTaxiNode")) == "function" then
            self.takeHooked = true
            hook("TakeTaxiNode", function(slot: unknown)
                local s = asNumber(slot)
                if s and self:IsEnabled() then
                    self:Taking(s)
                end
            end)
        end
        self:OnGameEvent("TAXIMAP_OPENED", function()
            self:OnTaxiOpened()
        end)
        self:OnGameEvent("TAXIMAP_CLOSED", function()
            self:LeaveMaster(true)
        end)
        -- on a taxi a moment after control goes; landed when it comes back
        self:OnGameEvent("PLAYER_CONTROL_LOST", function()
            local at = GetTime()
            self:After(0.5, function()
                self:FlightStarted(at)
            end)
        end)
        self:OnGameEvent("PLAYER_CONTROL_GAINED", function()
            local at = GetTime()
            self:After(0.3, function()
                if not UnitOnTaxi("player") then
                    self:FlightEnded(at)
                end
            end)
        end)
        self:OnGameEvent("PLAYER_ENTERING_WORLD", function()
            if not self.flight then
                self:ResumeFlight()
            end
            self:QueueLayout()
            self:UpdateTimer()
        end)
        self:Watch("atMaster", function()
            if not self:Get("atMaster") and self.session then
                self:LeaveMaster(false)
            end
        end)
        self:Watch("inFlight", function()
            self:QueueLayout()
        end)
        self:Watch("timer", function()
            SuuUI.EditMode.Refresh()
            self:UpdateTimer()
        end)
        self:Watch("timerPosition", function()
            self:UpdateTimer()
        end)
        self:On("SUUUI_EDITMODE_CHANGED", function()
            self:UpdateTimer()
        end)
        -- (a destination chosen to confirm: let go when clicks fly at once)
        self:Watch("confirm", function()
            if self.session and not self:Get("confirm") and self.selected then
                self.selected = nil
                self:UpdateBar()
                self:UpdateRows()
                self:QueueInk()
            end
        end)
        -- a theme: the tags, the bar and the flight bar measured again
        self:On("SUUUI_THEME_CHANGED", function()
            if self.session then
                self:UpdateBar()
            end
            self:LayoutTimer()
            self:UpdateTimer()
            self:QueueLayout()
        end)
        -- (0.47: the module counts as on inside OnEnable)
        self:UpdateTimer()
    end

    override function OnDisable()
        -- (at a flight master: the game's own map back, the session open)
        self:LeaveMaster(false)
        self.flight, self.pending = nil, nil
        -- (0.47) the registry cancels the module's timers: a layout or
        -- drawing still queued never runs, so let the next one queue
        self.layoutQueued, self.inkQueued = false, false
        local timer = self.timer
        if timer then
            timer:Hide()
        end
        self:ClearDrawing()
        for _, s in ipairs(self:Surfaces()) do
            s.map:RemoveDataProvider(s.provider)
            s.layer:Hide()
        end
        self:RefreshPins()
    end
end

M = SuuUI.AddModule(FlightMapModule.new())
