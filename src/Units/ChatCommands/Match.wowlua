-- Units/ChatCommands/Match.wowlua
-- The command palette's matching (Units/ChatCommands): which commands of
-- the catalog start with what's typed, by category; the closest ones when
-- none does; what the input's text asks for; the categories and their
-- order; the matched part in gilt. Pure: the catalog, the settings and
-- /suu's commands come in as arguments.

import SuuUI from "/Core/API"

local T = SuuUI.Tokens

type Color = number[] & { hex: string }
local colors: { [string]: Color } = T.color
export function tint(token: string, text: string): string return "|cff" .. assert(colors[token]).hex .. text .. "|r" end

-- A command in the catalog.
export type Item = {
    cmd: string, aliases: string[], names: string[], key?: string, cat: string, src: string,
    desc?: string, arg?: string, usage?: string, rank: number, chatType?: boolean,
}
-- What a row in the command list shows (a catalog item, or one of /suu's commands).
export type Shown = { cmd: string, aliases: string[], desc?: string, src: string }
export type Match = { item: Item, score: number, alias?: string }
export type SubCommand = { name: string, help: string, args?: string[] }
export type Query = {
    mode: string, typed: string, item?: Item, kind?: string, prefix?: string, sub?: SubCommand,
}

export const CATEGORIES: { value: string, label: string }[] = {
    { value = "all", label = "All" }, { value = "chat", label = "Chat" }, { value = "group", label = "Group" },
    { value = "emote", label = "Emotes" }, { value = "suuui", label = "SuuUI" }, { value = "addon", label = "Addons" },
}
-- under All, the groups in this order (the game's commands that are neither
-- chat nor group show there only)
export const ALL_ORDER: string[] = { "group", "chat", "game", "suuui", "addon", "emote" }
export const LABEL: { [string]: string } = { chat = "Chat", group = "Group", game = "Game", suuui = "SuuUI", addon = "Addons", emote = "Emotes" }
export const NOUN: { [string]: string } = { all = "command", chat = "chat command", group = "group command", emote = "emote",
    suuui = "SuuUI command", addon = "addon command" }

-- How far apart two words are (edits), for "Closest"; 99 when their
-- lengths differ by more than 3.
export function distance(a: string, b: string): number
    local la, lb = #a, #b
    if math.abs(la - lb) > 3 then return 99 end
    local prev: number[], cur: number[] = {}, {}
    for j = 0, lb do prev[j] = j end
    for i = 1, la do
        cur[0] = i
        local ca = a:byte(i)
        for j = 1, lb do
            local cost = ca == b:byte(j) and 0 or 1
            cur[j] = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
        end
        prev, cur = cur, prev
    end
    return prev[lb]
end

-- Which of an item's names starts with what's typed: 1 its main name, 2 an
-- alias (and which), nil none.
export function matchOf(item: Shown, typed: string): (number?, string?)
    if item.cmd:sub(1, #typed) == typed then return 1 end
    for _, a in ipairs(item.aliases) do
        if a:sub(1, #typed) == typed then return 2, a end
    end
end

-- The commands that start with `typed`: by category, and in all (emotes
-- only with `emotes`). A command whose own name fits comes before one that
-- fits by an alias, then by rank and name.
export function matches(catalog: Item[], typed: string, emotes: boolean): ({ [string]: Match[] }, number)
    local byCat: { [string]: Match[] }, total = {}, 0
    for _, item in ipairs(catalog) do
        if emotes or item.cat ~= "emote" then
            local m, alias = matchOf(item, typed)
            if m then
                local list = byCat[item.cat]
                if not list then
                    list = {}
                    byCat[item.cat] = list
                end
                list[#list + 1] = { item = item, score = m, alias = alias }
                total = total + 1
            end
        end
    end
    for _, list in pairs(byCat) do
        table.sort(list, function(a: Match, b: Match): boolean
            if a.score ~= b.score then return a.score < b.score end
            if a.item.rank ~= b.item.rank then return a.item.rank < b.item.rank end
            return a.item.cmd < b.item.cmd
        end)
    end
    return byCat, total
end

-- The (at most three) closest commands to a typed word nothing starts
-- with: three edits away at most, the nearest first, then by rank.
export function closest(catalog: Item[], typed: string, emotes: boolean): Match[]
    local best: { item: Item, d: number }[] = {}
    for _, item in ipairs(catalog) do
        if emotes or item.cat ~= "emote" then
            local d = 99
            for _, n in ipairs(item.names) do d = math.min(d, distance(typed, n)) end
            if d <= 3 then best[#best + 1] = { item = item, d = d } end
        end
    end
    table.sort(best, function(a: { item: Item, d: number }, b: { item: Item, d: number }): boolean
        if a.d ~= b.d then return a.d < b.d end
        return a.item.rank < b.item.rank
    end)
    local out: Match[] = {}
    for i = 1, math.min(3, #best) do out[i] = { item = best[i].item, score = 1 } end
    return out
end

-- What's typed in gilt where a name starts with it (two letters or more).
export function hit(name: string, typed: string): string
    if typed ~= "" and #typed > 1 and name:sub(1, #typed) == typed then
        return tint("gilt-text", name:sub(1, #typed)) .. name:sub(#typed + 1)
    end
    return name
end

-- A row's aliases: the first two, the typed part in gilt.
export function aliasText(item: Shown, typed: string): string
    local out: string[] = {}
    for i, a in ipairs(item.aliases) do
        if i > 2 then break end
        out[#out + 1] = hit(a, typed)
    end
    return table.concat(out, " ")
end

-- "In Chat: /reply, /raid, /rw · Emotes: 7": the matches in the other
-- categories.
export function elsewhere(byCat: { [string]: Match[] }, except: string): string
    local parts: string[] = {}
    for _, c in ipairs(ALL_ORDER) do
        local list = byCat[c]
        if c ~= except and list and #list > 0 then
            if c == "emote" then
                parts[#parts + 1] = (LABEL[c] or c) .. ": " .. #list
            else
                local names: string[] = {}
                for i = 1, math.min(3, #list) do names[i] = list[i].item.cmd end
                parts[#parts + 1] = "In " .. (LABEL[c] or c) .. ": " .. table.concat(names, ", ") .. (#list > 3 and " …" or "")
            end
        end
    end
    return table.concat(parts, " · ")
end

-- The chosen category as kept (`saved`), "all" for none or for Emotes while
-- emotes are off.
export function category(saved: string?, emotes: boolean): string
    local c = saved or "all"
    if c == "emote" and not emotes then c = "all" end
    return c
end

-- The category `step` after `current` among those shown, round the end.
export function stepCategory(current: string, step: number, emotes: boolean): string
    local list: string[] = {}
    for _, c in ipairs(CATEGORIES) do
        if c.value ~= "emote" or emotes then list[#list + 1] = c.value end
    end
    local at = 1
    for i, v in ipairs(list) do if v == current then at = i end end
    return list[(at - 1 + step) % #list + 1]
end

-- The key hints without Tab's and the arrows' (Tab puts nothing in).
export function withoutTab(keys: string[][]): string[][]
    for i = #keys, 1, -1 do
        if keys[i][1] == "Tab" or keys[i][1] == "↑↓" then table.remove(keys, i) end
    end
    return keys
end

-- What the input's text asks for: { mode = "commands", typed } or
-- { mode = "args", item, prefix, typed, kind } or nil (no palette).
-- `args`: the setting for what follows a command; `byName`: the catalog's
-- items by each of their names; `commands`: /suu's commands.
export function parse(text: unknown, args: boolean, byName: () -> { [string]: Item }, commands: () -> SubCommand[])
    : Query?
    if type(text) ~= "string" or text:sub(1, 1) ~= "/" then return nil end
    local cmd, rest = text:match("^(/%S*)(.*)$")
    if not (cmd and rest) then return nil end
    cmd = cmd:lower()
    if rest == "" then return { mode = "commands", typed = cmd } end
    if not args then return nil end
    local item = byName()[cmd]
    if not (item and item.arg) or item.chatType then return nil end
    local arg = rest:gsub("^%s+", "")
    if item.arg == "suu" then
        local sub, after = arg:match("^(%S*)(.*)$")
        if not (sub and after) then return nil end
        if after == "" then return { mode = "args", item = item, kind = "suu", prefix = cmd .. " ", typed = sub } end
        local found
        for _, c in ipairs(commands()) do if c.name == sub:lower() then found = c end end
        if not (found and found.args) then return nil end
        local word = after:gsub("^%s+", "")
        if word:find("%s") then return nil end
        return { mode = "args", item = item, kind = "words", sub = found, prefix = cmd .. " " .. found.name .. " ",
                 typed = word }
    end
    return { mode = "args", item = item, kind = item.arg, prefix = cmd .. " ", typed = arg }
end
