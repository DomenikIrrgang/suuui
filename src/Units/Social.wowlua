-- Units/Social.wowlua
-- SuuUI's Social pages (step 3.4, design component SocialWindow) over
-- Forever's own social window (SocialUIFrame, O: not the classic
-- FriendsFrame, which it no longer shows; found with /suu probe social
-- mouse, 2026-10-14), the way the Legacy and Professions pages sit over
-- theirs: the key, the micro menu and Esc stay Blizzard's, the window is in
-- SuuUI's look (the windows module), and Blizzard's own friends list and
-- Battle.net bar are off screen (still shown: they drive it). The window:
-- the Battle.net bar, the friends list (search, filter, Add New Friend),
-- Recent Allies, Friend Requests, Raid, four tabs down its right side;
-- the ignored in a small window of its own. None of it protected.
--   Contacts  Battle.net and character friends, online first, with their
--             notes; Whisper, Invite, Add friend; the ignored; your status
-- A built-in module written against the public API only.


import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type Panel from "/UI/Panel"
import type Text from "/UI/Text"
import type Contacts, PeopleList, RaidGroups, Friend, RaidMember, PeopleRowData, PeopleAction from "/UI/Social"
import type Color from "/Core/Tokens"
import RAID_PLANNER from "/Core/ServiceKeys"
import * as secret from "wowlua:secret"
import after from "wowlua:timer"
import hookScript from "wowlua:hooks"
import * as errors from "wowlua:errors"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as format from "wowlua:format"
import * as chat from "wowlua:chat"
import invite as groupInvite, inviteBnet from "wowlua:unit"

local UI, T = SuuUI.UI, SuuUI.Tokens

local DEFAULTS = {}

local M: SocialModule


-- A errors.try that may fail or not exist: its results (every value:
-- GetSavedInstanceInfo gives twelve, and the lockouts' difficulty and
-- progress are its last ones), or nothing.
-- One of the game's functions by its global name, or a table's.
local function global(name: string): unknown return tbl.field(_G, name) end

local colors: { [string]: Color } = T.color
local CLASS_FILES: { [string]: string } = {}
for _, name in ipairs({ "LOCALIZED_CLASS_NAMES_MALE", "LOCALIZED_CLASS_NAMES_FEMALE" }) do
    local list = global(name)
    if type(list) == "table" then
        for file, className in pairs(list :: { [string]: string }) do CLASS_FILES[className] = file end
    end
end
local function classToken(file: string?): string?
    return file and colors["class-" .. file:lower()] and ("class-" .. file:lower()) or nil
end
local function classColor(className: string?): string?
    return classToken(CLASS_FILES[className or ""])
end

local GAMES: { [string]: string } = { App = "the Battle.net app", BSAp = "Battle.net mobile", WTCG = "Hearthstone", Hero = "Heroes of the Storm",
                Pro = "Overwatch", S2 = "StarCraft II", S1 = "StarCraft", D3 = "Diablo III", Fen = "Diablo IV",
                ANBS = "Diablo Immortal", VIPR = "Call of Duty", W3 = "Warcraft III", GRY = "Warcraft Rumble" }

-- "3 days ago" from a time() stamp (`now`: the clock's).
local function ago(stamp: unknown, now: number?): string?
    local at = secret.asNumber(stamp)
    if not at or at == 0 then return nil end
    return format.ago((now or time()) - at, { long = true, from = "hour" })
end

--------------------------------------------------------------------------------
-- The game's data
--------------------------------------------------------------------------------

-- A Battle.net friend's row (C_BattleNet.GetFriendAccountInfo's info);
-- `faction`: yours.
local function bnetRow(info: BNetAccountInfo, faction: string?): Friend
    local game = info.gameAccountInfo
    local isOnline = game.isOnline and true or false
    local row: Friend = { key = "bn:" .. tostring(info.bnetAccountID), bnet = true, bnetID = info.bnetAccountID,
                  name = info.accountName or info.battleTag or "?", sort = (secret.asString(info.battleTag) or ""):lower(),
                  online = isOnline, note = secret.readable(info.note) and info.note ~= "" and info.note or nil,
                  away = (info.isAFK or game.isGameAFK) and true or false, busy = (info.isDND or game.isGameBusy) and true or false,
                  whisper = isOnline }
    local character = secret.asString(game.characterName)
    if isOnline and game.clientProgram == (BNET_CLIENT_WOW or "WoW") and character then
        row.character = character
        local className = secret.asString(game.className)
        row.color = classColor(className)
        local where: string[] = {}
        local level = game.characterLevel
        if level and level > 0 then where[#where + 1] = "Level " .. level end
        if className then where[#where + 1] = className end
        local zone = secret.asString(game.areaName)
        local detail = table.concat(where, " ")
        row.detail = zone and zone ~= "" and (detail .. " · " .. zone) or detail
        if game.wowProjectID == WOW_PROJECT_ID and game.gameAccountID then
            -- by their game account, as the game's friends list does
            -- (by name and realm the game didn't find them: the realm
            -- is the server's own name; found in game); on your side.
            -- No realm check: Forever's realms are rulesets, and a
            -- realm ID that differs still groups (asked 2026-10-18:
            -- "the realm doesn't match" for a friend you could invite)
            if not (secret.readable(game.factionName) and game.factionName == faction) then
                row.why = "They're in the other faction."
            else
                row.invite, row.gameAccountID = true, game.gameAccountID
            end
        else
            row.why = "They're playing another version of World of Warcraft."
            row.detail = "Playing World of Warcraft"
        end
    elseif isOnline then
        row.detail = "Playing " .. (GAMES[game.clientProgram or ""] or "on Battle.net")
        row.why = "They aren't in World of Warcraft Forever."
    else
        local when = ago(info.lastOnlineTime)
        row.detail = when and ("Last online " .. when) or "Offline"
        row.why = "They're offline."
    end
    return row
end

-- A character friend's row (C_FriendList.GetFriendInfoByIndex's info).
local function characterRow(f: FriendInfo): Friend
    local isOnline = f.connected and true or false
    local row: Friend = { key = "c:" .. f.name, name = f.name, sort = f.name:lower(), online = isOnline,
                  color = classColor(f.className), note = secret.readable(f.notes) and f.notes ~= "" and f.notes or nil,
                  away = f.afk, busy = f.dnd, whisper = isOnline, invite = isOnline, inviteName = f.name }
    if isOnline then
        local detail = (f.level and f.level > 0 and ("Level " .. f.level .. " ") or "") .. (f.className or "")
        local area = secret.asString(f.area)
        row.detail = (area and area ~= "") and (detail .. " · " .. area) or detail
    else
        row.detail = "Offline"
        row.why = "They're offline."
    end
    return row
end

-- Online first, then by name.
local function friendOrder(a: Friend, b: Friend): boolean
    if a.online ~= b.online then return a.online == true end
    return (a.sort or "") < (b.sort or "")
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

-- A whisper to a character (the chat's own, ChatFrameUtil on newer clients).
local function tellTo(name: string?)
    if not name then return end
    chat.whisper(name)
end

local function whisper(row: Friend)
    if row.bnet then
        if row.name then chat.whisperBnet(row.name) end
    else
        tellTo(row.name)
    end
end

-- A party invite by name (C_PartyInfo's on newer clients).
local function inviteName(name: string?)
    if not name then return end
    groupInvite(name)
end

local function invite(row: Friend)
    local id = row.gameAccountID
    if id then
        inviteBnet(id)
        return
    end
    inviteName(row.inviteName)
end

--------------------------------------------------------------------------------
-- Recent allies and friend requests (probed 2026-10-14: C_RecentAllies'
-- characterData, stateData, interactionData; pins and notes; Battle.net
-- invites through BNGetFriendInviteInfo)
--------------------------------------------------------------------------------

local function classFileOf(classID: number?): string?
    if not classID then return nil end
    local info = C_CreatureInfo and C_CreatureInfo.GetClassInfo and C_CreatureInfo.GetClassInfo(classID)
    if info and info.classFile then return info.classFile end
    if not GetClassInfo then return nil end
    local _, file = GetClassInfo(classID)
    return file
end

-- How you met them: the first interaction's own words, when it has any.
local function metBy(a: RecentAllyData): string?
    local list = a.interactionData and a.interactionData.interactions
    local first = list and list[1]
    if type(first) ~= "table" then return nil end
    for _, key in ipairs({ "description", "text", "contextName", "name" }) do
        local v = secret.asString(tbl.field(first, key))
        if v and v ~= "" then return v end
    end
    return nil
end

--------------------------------------------------------------------------------
-- The Raid page
--------------------------------------------------------------------------------

local TEST_NAMES = { { "Kaelith Dawnmere", "PRIEST", "HEALER" }, { "Brannoc Ironvale", "WARRIOR", "TANK" },
    { "Lyra Sunwhisper", "MAGE", "DAMAGER" }, { "Thorn Blackmoor", "ROGUE", "DAMAGER" }, { "Maelis Brightforge", "PALADIN", "HEALER" },
    { "Durn Stonehoof", "HUNTER", "DAMAGER" }, { "Ysolde Thornvale", "DRUID", "DAMAGER" }, { "Ardent Stormcall", "SHAMAN", "HEALER" },
    { "Vesh Nightfall", "WARLOCK", "DAMAGER" }, { "Corwin Hale", "WARRIOR", "DAMAGER" }, { "Sable Ashgrove", "MAGE", "DAMAGER" },
    { "Mira Quell", "PRIEST", "HEALER" }, { "Torvald Grim", "WARRIOR", "TANK" }, { "Elric Vane", "ROGUE", "DAMAGER" },
    { "Nessa Brook", "HUNTER", "DAMAGER" }, { "Ulric Moss", "DRUID", "HEALER" } }

-- A saved instance: its name, difficulty, seconds to its reset, whether
-- extended, a raid, its size, its bosses and how many are down.
export type Lockout = {
    name: string, difficulty?: string, reset?: number, extended?: boolean, raid?: boolean, size?: number,
    bosses?: number, done?: number,
}

-- A lockout's progress ("3 / 8") and its detail line (difficulty, reset,
-- extended).
local function lockoutProgress(l: Lockout): string
    local bosses = l.bosses
    return (bosses and bosses > 0) and ((l.done or 0) .. " / " .. bosses) or ""
end

local function lockoutDetail(l: Lockout): string
    local detail: string[] = {}
    local difficulty = secret.asString(l.difficulty)
    if difficulty and difficulty ~= "" then detail[#detail + 1] = difficulty end
    local reset = l.reset
    if reset and reset > 0 then detail[#detail + 1] = "resets in " .. (SecondsToTime and SecondsToTime(reset, true) or (math.ceil(reset / 3600) .. " h")) end
    if l.extended then detail[#detail + 1] = "extended" end
    return table.concat(detail, " · ")
end

-- A lockout's row in the panel.
class LockoutRow extends Frame
    readonly name: Text
    readonly progress: Text
    readonly detail: Text

    constructor(parent: Frame)
        super(nil, parent)
        self.name = UI.Text(self, "label", "ink")
        self.name:SetPoint("TOPLEFT")
        self.progress = UI.Text(self, "numeric", "ink")
        self.progress:SetPoint("TOPRIGHT")
        self.detail = UI.Text(self, "caption", "ink-muted")
        self.detail:SetPoint("TOPLEFT", self.name, "BOTTOMLEFT", 0, -2)
    end
end

-- The Raid lockouts panel, its rows and its "none" line.
type LockoutPanel = { panel: Panel, rows: LockoutRow[], empty: Text }

--------------------------------------------------------------------------------
-- Over Blizzard's window
--------------------------------------------------------------------------------

-- Blizzard's window and its parts: the friends list (the content frame with
-- a filter bar that is neither Recent Allies nor Friend Requests), the
-- Raid, Recent Allies and Friend Requests lists, the Battle.net bar.
type Window = { frame: Frame, list: Frame, raid?: Frame, allies?: Frame, requests?: Frame, bar?: Frame }

local function windowOf(f: Frame): Window?
    local allies, requests = frames.asFrame(tbl.field(f, "RecentAlliesList")), frames.asFrame(tbl.field(f, "FriendRequestsList"))
    for _, c in ipairs(frames.children(f)) do
        if tbl.field(c, "FilterBar") and c ~= allies and c ~= requests then
            return { frame = f, list = c, raid = frames.asFrame(tbl.field(f, "RaidFrame")), allies = allies, requests = requests,
                     bar = frames.asFrame(tbl.field(f, "BattleNetBar")) }
        end
    end
    return nil
end

class SocialModule extends Module<typeof(DEFAULTS)>
    alliesPage: PeopleList? = nil
    window: Window? = nil
    friends: Friend[]? = nil
    lockouts: LockoutPanel? = nil
    mode: string? = nil
    -- a pin chosen, until the game's own data agrees
    pinWanted: { [string]: boolean }? = nil
    raidPage: RaidGroups? = nil
    raidTest: RaidMember[]? = nil
    renderQueued: boolean? = nil
    requestsPage: PeopleList? = nil
    selected: string? = nil
    view: Contacts? = nil

    constructor()
        super({
            id = "social",
            name = "Social",
            description = "SuuUI's Social window: your Battle.net and character friends, the ignored, your status.",
            api = "0.13",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- Blizzard's friends list (while the pages are built).
    function FriendsList(): Frame?
        local w = self.window
        return w and w.list
    end

    -- The lockout panel (while it was opened once).
    function LockoutPanel(): Panel?
        local l = self.lockouts
        return l and l.panel
    end

    function Friends(): (Friend[], number)
        local out: Friend[], online = {}, 0
        -- Battle.net friends (their account name is protected text the game
        -- draws; never read)
        local faction = UnitFactionGroup("player")
        for i = 1, secret.asNumber(errors.try(BNGetNumFriends)) or 0 do
            local info = C_BattleNet and C_BattleNet.GetFriendAccountInfo and errors.try(C_BattleNet.GetFriendAccountInfo, i)
            if type(info) == "table" then
                local row = bnetRow(info :: BNetAccountInfo, faction)
                if row.online then online = online + 1 end
                out[#out + 1] = row
            end
        end
        -- character friends
        local fl = C_FriendList
        for i = 1, (fl and secret.asNumber(errors.try(fl.GetNumFriends))) or 0 do
            local f = errors.try(fl.GetFriendInfoByIndex, i)
            if type(f) == "table" and secret.asString((f :: FriendInfo).name) then
                local row = characterRow(f :: FriendInfo)
                if row.online then online = online + 1 end
                out[#out + 1] = row
            end
        end
        table.sort(out, friendOrder)
        return out, online
    end

    function Ignored(): string[]
        local out: string[] = {}
        local fl = C_FriendList
        for i = 1, (fl and secret.asNumber(errors.try(fl.GetNumIgnores))) or 0 do
            local name = secret.asString(errors.try(fl.GetIgnoreName, i))
            if name then out[#out + 1] = name end
        end
        return out
    end

    function BattleTag(): string?
        local _, tag = errors.try(BNGetInfo)
        return secret.asString(tag)
    end

    function Status(): string
        local _, _, _, _, afk, dnd = errors.try(BNGetInfo)
        if dnd then return "busy" elseif afk then return "away" end
        return "available"
    end

    function Render()
        local view = self.view
        if not (view and view:IsVisible()) then return end
        local friends, online = self:Friends()
        self.friends = friends
        view:SetData({ view = self.mode or "friends", status = self:Status(), me = self:BattleTag(), online = online, total = #friends,
                       friends = friends, ignored = self:Ignored(), selected = self.selected })
    end

    function QueueRender()
        if self.renderQueued then return end
        self.renderQueued = true
        after(0.1, function()
            self.renderQueued = nil
            if self:IsEnabled() then self:Render() end
        end)
    end

    function SetNote(row: Friend)
        UI.Confirm({ title = "Note", text = "A note about this friend: only you see it.",
            input = { label = "Note", value = row.note or "" }, confirm = "Save",
            onConfirm = function(text: string?)
                if not text then return end
                if row.bnet then
                    errors.try(global("BNSetFriendNote") or tbl.field(C_BattleNet, "SetFriendNote"), row.bnetID, text)
                else
                    pcall(C_FriendList.SetFriendNotes, row.name or "", text)
                end
                self:QueueRender()
            end })
    end

    function Remove(row: Friend)
        UI.Confirm({ title = "Remove friend?", text = "They leave your friends list. You can add them again any time.",
            confirm = "Remove", onConfirm = function()
                if row.bnet then
                    errors.try(global("BNRemoveFriend") or tbl.field(C_BattleNet, "RemoveFriend"), row.bnetID)
                else
                    pcall(C_FriendList.RemoveFriend, row.name or "")
                end
                self.selected = nil
                self:QueueRender()
            end })
    end

    function Wire(view: Contacts)
        view.onView = function(v: string) self.mode = v; self:Render() end
        view.onSelect = function(key: string?) self.selected = key; self:Render() end
        view.onWhisper = whisper
        view.onInvite = invite
        view.onStatus = function(v: string)
            local bn = C_BattleNet
            errors.try((bn and bn.SetAFK) or global("BNSetAFK"), v == "away")
            errors.try((bn and bn.SetDND) or global("BNSetDND"), v == "busy")
            after(0.3, function() self:QueueRender() end)
        end
        view.onAdd = function()
            UI.Confirm({ title = "Add a friend", text = "Their character's whole name (first and last), or their BattleTag such as Kaelith#1234.",
                input = { label = "Name or BattleTag", placeholder = "Name or BattleTag" }, confirm = "Add",
                onConfirm = function(text: string?)
                    if not text then return end
                    if text:find("#") then
                        local send = global("BNSendFriendInvite") or tbl.field(C_BattleNet, "SendFriendInvite")
                        if send then errors.try(send, text) else self:Print("Battle.net friend requests aren't available here.") end
                    else
                        self:AddFriend(text)
                    end
                    self:QueueRender()
                end })
        end
        view.onIgnore = function()
            UI.Confirm({ title = "Ignore a player", text = "You won't see their messages, invites or trades.",
                input = { label = "Their whole name", placeholder = "Name" }, confirm = "Ignore",
                onConfirm = function(text: string?) if not text then return end pcall(C_FriendList.AddIgnore, text); self:QueueRender() end })
        end
        view.onUnignore = function(name: string) pcall(C_FriendList.DelIgnore, name); self:QueueRender() end
        view.onMenu = function(row: Friend, owner: Frame)
            UI.ContextMenuFrom(owner, function(_, root)
                root:CreateTitle(row.character or row.name or "")
                if row.whisper then root:CreateButton("Whisper", function() whisper(row) end) end
                if row.invite then root:CreateButton("Invite", function() invite(row) end) end
                root:CreateButton("Set note", function() self:SetNote(row) end)
                root:CreateDivider()
                if not row.bnet then root:CreateButton("Ignore", function() self:Ignore(row.name) end) end
                root:CreateButton("Remove friend", function() self:Remove(row) end)
            end, "friend", { row = row })
        end
    end

    -- Pinned: what was just chosen until the game's own data agrees (it comes
    -- back a moment later: a pin seemed to need two clicks, found in game).
    function Pinned(guid: string?): boolean
        if not guid then return false end
        local ra = C_RecentAllies
        local actual = (ra and errors.try(ra.IsRecentAllyPinned, guid)) and true or false
        local wanted = self.pinWanted
        local want = wanted and wanted[guid]
        if want == nil then return actual end
        if wanted and want == actual then wanted[guid] = nil end
        return want
    end

    function Allies(): PeopleRowData[]
        local ra = C_RecentAllies
        local out: PeopleRowData[] = {}
        local got = ra and errors.try(ra.GetRecentAllies)
        for _, a in ipairs(type(got) == "table" and got :: RecentAllyData[] or {}) do
            local cd, sd = a.characterData, a.stateData
            local name = secret.asString(cd.fullName) or secret.asString(cd.name)
            if name then
                local file = classFileOf(cd.classID)
                local online = sd.isOnline and true or false
                local detail: string[] = {}
                local level = cd.level
                if level and level > 0 then detail[#detail + 1] = "Level " .. level end
                detail[#detail + 1] = online and (secret.asString(sd.currentLocation) or "Online") or "Offline"
                local met = metBy(a)
                if met then detail[#detail + 1] = met end
                local guid = secret.asString(cd.guid)
                local interaction = a.interactionData
                local note = interaction and secret.asString(interaction.note)
                local row: PeopleRowData = { key = guid or name, guid = guid, name = name, online = online,
                              color = classToken(file),
                              detail = table.concat(detail, " · "),
                              note = note ~= "" and note or nil,
                              pinned = self:Pinned(guid),
                              friend = guid and C_FriendList.IsFriend and errors.try(C_FriendList.IsFriend, guid) == true or false,
                              sent = sd.friendRequestSentThisSession }
                local actions: PeopleAction[] = {}
                if online then actions[#actions + 1] = { label = "Whisper", onClick = function(r: PeopleRowData) self:Whisper(r.name) end } end
                if not row.friend then
                    actions[#actions + 1] = { label = row.sent and "Requested" or "Add friend", disabled = row.sent,
                        onClick = function(r: PeopleRowData)
                            local who = r.name
                            if who then self:AddFriend(who) end
                            after(0.5, function() self:RenderLists() end)
                        end }
                end
                row.actions = actions
                out[#out + 1] = row
            end
        end
        table.sort(out, function(a: PeopleRowData, b: PeopleRowData): boolean
            if (a.pinned and true or false) ~= (b.pinned and true or false) then return a.pinned and true or false end
            if a.online ~= b.online then return a.online == true end
            return (a.name or "") < (b.name or "")
        end)
        return out
    end

    function Requests(): PeopleRowData[]
        local out: PeopleRowData[] = {}
        for i = 1, secret.asNumber(errors.try(BNGetNumFriendInvites)) or 0 do
            local id, accountName, _, _, sent = errors.try(BNGetFriendInviteInfo, i)
            if id then
                local when = ago(sent)
                out[#out + 1] = { key = "inv:" .. tostring(id), glyph = true, online = true, name = secret.asString(accountName) or "?",
                    detail = when and ("Sent " .. when) or "Wants to be your Battle.net friend",
                    actions = {
                        { label = "Decline", onClick = function() errors.try(global("BNDeclineFriendInvite"), id); self:QueueRender() end },
                        { label = "Accept", variant = "primary", onClick = function() errors.try(global("BNAcceptFriendInvite"), id); self:QueueRender() end },
                    } }
            end
        end
        return out
    end

    -- A friend request by a character's whole name. Forever's classic friends
    -- list is off (IsLegacyFriendSystemEnabled false: C_FriendList.AddFriend did
    -- nothing, found in game); its own window sends a title friend invite
    -- (C_BattleNet.SendTitleFriendInviteByName, watched with /suu probe social
    -- friends, 2026-10-14).
    function AddFriend(name: string)
        if SuuUI.AddFriend(name) then self:Print("Friend request sent to " .. name .. ".") end
    end

    -- Ignore a player by their whole name (a confirmation first).
    function Ignore(name: string?)
        if not name or name == "" then return end
        UI.Confirm({ title = "Ignore " .. name .. "?", text = "You won't see their messages, invites or trades. Unignore them on the Ignored list.",
            confirm = "Ignore", onConfirm = function()
                pcall(C_FriendList.AddIgnore, name)
                after(0.3, function() self:QueueRender() end)
            end })
    end

    function Whisper(name: string?)
        tellTo(name)
    end

    function RenderLists()
        local allies, requests = self.alliesPage, self.requestsPage
        if allies and allies:IsVisible() then
            allies:SetData({ title = "Recent allies", rows = self:Allies(),
                empty = "No one yet: the people you group with show up here." })
        end
        if requests and requests:IsVisible() then
            requests:SetData({ title = "Friend requests", rows = self:Requests(), empty = "No friend requests." })
        end
    end

    function AllyMenu(row: PeopleRowData, owner: Frame)
        local ra = C_RecentAllies
        local guid = row.guid
        UI.ContextMenuFrom(owner, function(_, root)
            root:CreateTitle(row.name or "")
            if row.online then
                root:CreateButton("Whisper", function() self:Whisper(row.name) end)
                root:CreateButton("Invite", function() inviteName(row.name) end)
            end
            if guid and ra and ra.SetRecentAllyPinned then
                root:CreateButton(row.pinned and "Unpin" or "Pin", function()
                    local want = not row.pinned
                    pcall(ra.SetRecentAllyPinned, guid, want)
                    local wanted = self.pinWanted or {}
                    self.pinWanted = wanted
                    wanted[guid] = want
                    self:RenderLists()
                    -- and again once the game has it
                    after(1, function() self:RenderLists() end)
                end)
            end
            root:CreateButton("Ignore", function() self:Ignore(row.name) end)
            if guid and ra and ra.SetRecentAllyNote and (not ra.CanSetRecentAllyNote or errors.try(ra.CanSetRecentAllyNote)) then
                root:CreateButton("Set note", function()
                    UI.Confirm({ title = "Note", text = "A note about this ally: only you see it.",
                        input = { label = "Note", value = row.note or "" }, confirm = "Save",
                        onConfirm = function(text: string?)
                            if not text then return end
                            pcall(ra.SetRecentAllyNote, guid, text)
                            after(0.2, function() self:RenderLists() end)
                        end })
                end)
            end
        end, "recentAlly", { row = row })
    end

    function TestRaid()
        if self.raidTest then self.raidTest = nil; self:RenderRaid(); return end
        local _, class = UnitClass("player")
        local name = SuuUI.FullName("player")
        local members: RaidMember[] = { { index = 1, name = secret.asString(name), class = secret.asString(class), role = "DAMAGER",
                            group = 1, leader = true, online = true, you = true } }
        for i, t in ipairs(TEST_NAMES) do
            members[#members + 1] = { index = i + 1, name = t[1], class = t[2], role = t[3], group = math.floor(i / 5) + 1,
                                      assistant = i == 3, online = i ~= 9, level = 60 }
        end
        self.raidTest = members
        self:Print("Raid test: 17 made-up members; drag them between groups. /suu raidtest again to end it.")
        self:RenderRaid()
    end

    -- Raid Info: your lockouts in a SuuUI panel beside the window (Blizzard's
    -- own box wasn't in SuuUI's look, found in game): each saved instance, its
    -- difficulty, how far you got and when it resets.
    function Lockouts(): Lockout[]
        local out: Lockout[] = {}
        for i = 1, secret.asNumber(errors.try(GetNumSavedInstances)) or 0 do
            local name, _, reset, _, locked, extended, _, isRaid, maxPlayers, difficultyName, numEncounters, progress = errors.try(GetSavedInstanceInfo, i)
            local title = secret.asString(name)
            if title and (locked or extended) then
                out[#out + 1] = { name = title, difficulty = secret.asString(difficultyName), reset = secret.asNumber(reset), extended = extended == true,
                                  raid = isRaid == true, size = secret.asNumber(maxPlayers), bosses = secret.asNumber(numEncounters), done = secret.asNumber(progress) }
            end
        end
        return out
    end

    function DrawLockouts()
        local l = self.lockouts
        if not (l and l.panel:IsShown()) then return end
        local p = l.panel
        local list = self:Lockouts()
        local y = 0
        for i, lockout in ipairs(list) do
            local r = l.rows[i]
            if not r then
                r = LockoutRow.new(p.body)
                l.rows[i] = r
            end
            -- set each time: a theme can change the text styles
            r:SetHeight(T.type.label.lineHeight + T.type.caption.lineHeight + 2)
            r:ClearAllPoints()
            r:SetPoint("TOPLEFT", p.body, "TOPLEFT", 0, -y)
            r:SetPoint("RIGHT", p.body, "RIGHT")
            r.name:SetValue(lockout.name)
            r.progress:SetValue(lockoutProgress(lockout))
            r.detail:SetValue(lockoutDetail(lockout))
            r:Show()
            y = y + r:GetHeight() + T.space["space-4"]
        end
        for i = #list + 1, #l.rows do l.rows[i]:Hide() end
        l.empty:SetShown(#list == 0)
        p.body:SetHeight(math.max(T.type.body.lineHeight, y))
        p:Fit()
    end

    function ToggleLockouts()
        local w = self.window
        if not w then return end
        local f = w.frame
        local l = self.lockouts
        if not l then
            local p = UI.Panel(f, { title = "Raid lockouts", width = 300, closable = true, solid = true })
            p:SetFrameLevel(f:GetFrameLevel() + 200)
            local empty = UI.Text(p.body, "body", "ink-muted")
            empty:SetPoint("TOPLEFT")
            empty:SetValue("No active lockouts.")
            p:Hide()
            l = { panel = p, rows = {}, empty = empty }
            self.lockouts = l
        end
        local p = l.panel
        p:ClearAllPoints()
        -- beside the window, past its tabs down the right side
        p:SetPoint("TOPLEFT", f, "TOPRIGHT", 72, 0)
        p:SetShown(not p:IsShown())
        if p:IsShown() then
            if RequestRaidInfo then RequestRaidInfo() end
            self:DrawLockouts()
        end
    end

    function RaidMembers(): RaidMember[]
        local test = self.raidTest
        if test then return test end
        local out: RaidMember[] = {}
        if not secret.flag(IsInRaid()) then return out end
        for i = 1, GetNumGroupMembers() do
            local name, rank, group, level, className, file, zone, online, dead, _, _, combatRole = GetRaidRosterInfo(i)
            if secret.readable(name) and name then
                local unit = "raid" .. i
                local role = (secret.readable(combatRole) and combatRole ~= "NONE" and combatRole) or secret.known(UnitGroupRolesAssigned(unit), "NONE")
                out[#out + 1] = { index = i, unit = unit, name = name, class = file, className = className, level = level, zone = zone,
                                  role = role ~= "NONE" and role or nil, group = group, leader = rank == 2, assistant = rank == 1,
                                  online = online and true or false, dead = dead, you = secret.flag(UnitIsUnit(unit, "player")) }
            end
        end
        return out
    end

    function RenderRaid()
        local page = self.raidPage
        if not (page and page:IsVisible()) then return end
        local test = self.raidTest ~= nil
        local canLead = test or secret.flag(UnitIsGroupLeader("player")) or secret.flag(UnitIsGroupAssistant("player"))
        local inRaid = secret.flag(IsInRaid())
        page:SetData({ inRaid = test or inRaid, inParty = secret.flag(IsInGroup()) and not inRaid, canLead = canLead and true or false,
                       reason = InCombatLockdown() and "Not in combat." or nil, size = 40, members = self:RaidMembers(),
                       plan = SuuUI.UseService(RAID_PLANNER) ~= nil })
    end

    function WireRaid(page: RaidGroups)
        page.onReadyCheck = function() errors.try(global("DoReadyCheck")) end
        page.onRoleCheck = function() errors.try(global("InitiateRolePoll")) end
        page.onRaidInfo = function() self:ToggleLockouts() end
        -- the raid planner (its own module), while it's on
        page.onPlan = function()
            local planner = SuuUI.UseService(RAID_PLANNER)
            if planner and planner.Toggle then planner.Toggle() end
        end
        page.onConvert = function()
            errors.try((C_PartyInfo and C_PartyInfo.ConvertToRaid) or global("ConvertToRaid"))
        end
        page.onMove = function(index: number, group: number)
            local test = self.raidTest
            if test then
                for _, m in ipairs(test) do if m.index == index then m.group = group end end
                return self:RenderRaid()
            end
            if InCombatLockdown() then return end
            pcall(SetRaidSubgroup, index, group)
        end
        page.onSwap = function(a: number, b: number)
            local test = self.raidTest
            if test then
                local ma: RaidMember?, mb: RaidMember? = nil, nil
                for _, m in ipairs(test) do
                    if m.index == a then ma = m elseif m.index == b then mb = m end
                end
                if ma and mb then ma.group, mb.group = mb.group, ma.group end
                return self:RenderRaid()
            end
            if InCombatLockdown() then return end
            pcall(SwapRaidSubgroup, a, b)
        end
        page.onMember = function(m: RaidMember, button: string, owner: Frame)
            if button ~= "RightButton" then return end
            local lead = UnitIsGroupLeader("player")
            UI.ContextMenuFrom(owner, function(_, root)
                root:CreateTitle(m.name or "")
                if not m.you then
                    root:CreateButton("Whisper", function() tellTo(m.name) end)
                    root:CreateButton("Ignore", function() self:Ignore(m.name) end)
                end
                local unit = m.unit
                if lead and not m.you and unit then
                    root:CreateDivider()
                    if m.assistant then
                        root:CreateButton("Demote from assistant", function() errors.try(global("DemoteAssistant"), unit) end)
                    else
                        root:CreateButton("Promote to assistant", function() errors.try(global("PromoteToAssistant"), unit) end)
                    end
                    root:CreateButton("Make leader", function() errors.try(global("PromoteToLeader"), unit) end)
                    root:CreateButton("Remove from group", function()
                        errors.try((C_PartyInfo and C_PartyInfo.UninviteUnit) or global("UninviteUnit"), unit)
                    end)
                end
            end, "groupMember", { member = m })
        end
    end

    -- The Contacts page while the window shows its friends list.
    function Follow()
        local w, view = self.window, self.view
        if not (w and view) then return end
        local f = w.frame
        -- a probe asked SuuUI's pages to step aside (the game's own in use)
        if SuuUI.ProbeShowsBlizzardSocial and SuuUI.ProbeShowsBlizzardSocial() then
            for _, page in ipairs({ view, self.raidPage, self.alliesPage, self.requestsPage }) do if page then page:Hide() end end
            for _, p in ipairs({ w.list, w.raid, w.allies, w.requests, w.bar }) do if p then p:SetAlpha(1) end end
            w.list:ClearAllPoints()
            w.list:SetAllPoints(w.allies or f)
            return
        end
        local onContacts = f:IsShown() and w.list:IsShown()
        view:SetShown(onContacts)
        -- the Raid page over Blizzard's (see-through, in place: Raid Info hangs
        -- off it)
        local raid, allies, requests = w.raid, w.allies, w.requests
        local onRaid = f:IsShown() and raid and raid:IsShown() or false
        -- Recent allies and Requests over Blizzard's lists (see-through, in place)
        local onAllies = f:IsShown() and allies and allies:IsShown() or false
        local onRequests = f:IsShown() and requests and requests:IsShown() or false
        local alliesPage, requestsPage = self.alliesPage, self.requestsPage
        if alliesPage and allies then
            alliesPage:SetShown(onAllies)
            allies:SetAlpha(onAllies and 0 or 1)
        end
        if requestsPage and requests then
            requestsPage:SetShown(onRequests)
            requests:SetAlpha(onRequests and 0 or 1)
        end
        if onAllies or onRequests then self:RenderLists() end
        -- the Battle.net bar see-through under SuuUI's pages (it sat over the
        -- Raid page's head, found in game), and the pages above its buttons
        local bar = w.bar
        if bar then
            local ours = onContacts or onRaid or onAllies or onRequests
            bar:SetAlpha(ours and 0 or 1)
            local level = math.max(f:GetFrameLevel() + 100, bar:GetFrameLevel() + 30)
            for _, page in ipairs({ view, self.raidPage, self.alliesPage, self.requestsPage }) do
                if page then page:SetFrameLevel(level) end
            end
        end
        local raidPage = self.raidPage
        if raidPage then
            raidPage:SetShown(onRaid)
            if raid then raid:SetAlpha(onRaid and 0 or 1) end
            if onRaid then self:RenderRaid() end
        end
        if onContacts then
            if C_FriendList and C_FriendList.ShowFriends then pcall(C_FriendList.ShowFriends) end
            self:QueueRender()
        end
    end

    function Build()
        local f = frames.find("SocialUIFrame")
        if not f or self.view then return end
        local w = windowOf(f)
        if not w then return end
        self.window = w
        local view = UI.Contacts(f)
        -- 18px higher than the other pages: your name's row sat far under the
        -- header's divider (asked for in game)
        view:SetPoint("TOPLEFT", f, "TOPLEFT", 20, -26)
        view:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -20, 16)
        view:SetFrameLevel(f:GetFrameLevel() + 100)
        view:EnableMouse(true)
        view:Hide()
        self.view = view
        self:Wire(view)
        -- Recent allies and Requests
        local function listPage(): PeopleList
            local page = UI.PeopleList(f)
            page:SetPoint("TOPLEFT", f, "TOPLEFT", 20, -44)
            page:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -20, 16)
            page:EnableMouse(true)
            page:Hide()
            return page
        end
        if w.allies then
            local page = listPage()
            page.onMenu = function(row: PeopleRowData, owner: Frame) self:AllyMenu(row, owner) end
            self.alliesPage = page
        end
        if w.requests then self.requestsPage = listPage() end
        -- the Raid page
        if w.raid then
            local page = UI.RaidGroups(f)
            page:SetPoint("TOPLEFT", f, "TOPLEFT", 20, -44)
            page:SetPoint("BOTTOMRIGHT", f, "BOTTOMRIGHT", -20, 16)
            page:SetFrameLevel(f:GetFrameLevel() + 100)
            page:EnableMouse(true)
            page:Hide()
            self.raidPage = page
            self:WireRaid(page)
        end
        -- Blizzard's friends list out of sight (the page has its own); the
        -- Battle.net bar stays where it is (the other tabs hang under it: moved
        -- away, they went with it, found in game), only see-through while the
        -- page covers it. Recent Allies, Friend Requests and Raid stay
        -- Blizzard's for now.
        frames.keepAway(w.list, { fade = true })
        -- the page follows the window's content
        hookScript(f, "OnShow", function() self:Follow() end)
        hookScript(f, "OnHide", function() GameTooltip:Hide() end)
        for _, c in ipairs({ w.list, w.allies, w.requests, w.raid }) do
            if c then
                hookScript(c, "OnShow", function() self:Follow() end)
                hookScript(c, "OnHide", function() self:Follow() end)
            end
        end
        self:Follow()
    end

    override function OnEnable()
        self:Build()
        -- the window may load on demand
        self:OnGameEvent("ADDON_LOADED", function() self:Build() end)
        for _, e in ipairs({ "FRIENDLIST_UPDATE", "BN_FRIEND_INFO_CHANGED", "BN_FRIEND_ACCOUNT_ONLINE",
                             "BN_FRIEND_ACCOUNT_OFFLINE", "BN_FRIEND_LIST_SIZE_CHANGED", "IGNORELIST_UPDATE",
                             "BN_INFO_CHANGED", "PLAYER_FLAGS_CHANGED", "BN_CONNECTED", "BN_DISCONNECTED" }) do
            self:OnGameEvent(e, function()
                local view = self.view
                if view and view:IsVisible() then self:QueueRender() end
            end)
        end
        -- requests and allies
        for _, e in ipairs({ "BN_FRIEND_INVITE_ADDED", "BN_FRIEND_INVITE_REMOVED", "BN_FRIEND_INVITE_LIST_INITIALIZED",
                             "FRIENDLIST_UPDATE" }) do
            self:OnGameEvent(e, function() self:RenderLists() end)
        end
        -- the raid's changes
        for _, e in ipairs({ "GROUP_ROSTER_UPDATE", "PARTY_LEADER_CHANGED", "PLAYER_ROLES_ASSIGNED", "UNIT_CONNECTION",
                             "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED" }) do
            self:OnGameEvent(e, function()
                local page = self.raidPage
                if page and page:IsVisible() then after(0.1, function() self:RenderRaid() end) end
            end)
        end
        -- the lockouts as they come in
        self:OnGameEvent("UPDATE_INSTANCE_INFO", function() self:DrawLockouts() end)
        -- their rows' heights come from the text styles
        self:On("SUUUI_THEME_CHANGED", function() self:DrawLockouts() end)
        -- Plan follows the raid planner turned on or off
        self:On("SUUUI_SERVICE_CHANGED", function(_, name) if name == "raidplanner" then self:RenderRaid() end end)
        self:RegisterCommand("raidtest", "test: the Raid page with 17 made-up members to drag around", function() self:TestRaid() end)
    end
end

M = SuuUI.AddModule(SocialModule.new())
