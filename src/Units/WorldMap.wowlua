        local samples: MapPinData[] = {
            { char = "!", color = "quest-standard" },
            { glyph = "swirl" },
            { glyph = "mail", small = true },
            { glyph = "markStar", color = "mark-star", edge = "mark-star", edgeWidth = 2 },
        }
        for i, d in ipairs(samples) do
            local pin = UI.MapPin(self)
            pin:SetData(d)
            pin:EnableMouse(false)
            pin:SetPoint("CENTER", self, "LEFT", 32 + (i - 1) * 45, 0)
            self.pins[i] = pin
        end
    end
end

export const SECTION: SettingsSection = {
    id = "worldmap",
    label = "World map",
    category = "World",
    order = 12,
    preview = function(parent: Frame): PinsPreview
        return M:PreviewView(parent)
    end,
    groups = {
        {
            title = "Map pins",
            description = "What shows is in the map's own Map filters.",
            rows = {
                {
                    key = "pinAlpha",
                    label = "Pin opacity",
                    control = "slider",
                    min = 20,
                    max = 100,
                    step = 5,
                    unit = "%",
                    description = "How solid SuuUI's pins on the world map are. Hovering one shows the pins that belong with it at full opacity.",
                },
            },
        },
        {
            title = "Enlarged map",
            description = "The maximize button in the map's header enlarges the map in the middle of the screen.",
            rows = {
                {
                    key = "enlargedSize",
                    label = "Size",
                    control = "slider",
                    min = 50,
                    max = 100,
                    step = 5,
                    unit = "%",
                    description = "How tall the enlarged map is, its header included, as a share of the screen's height. It stays narrower than the screen.",
                },
            },
        },
    },
}

export class WorldMapModule extends Module<typeof(DEFAULTS)>
    map: typeof(WorldMapFrame)? = nil
    -- the unexplored areas, and the pins above them
    reveal: Frame? = nil
    layer: Frame? = nil
    revealFree: Texture[] = {}
    revealUsed: Texture[] = {}
    revealLayer: number? = nil
    provider: { [string]: unknown }? = nil
    menu: FilterMenu? = nil
    skyborneMenu: boolean = false
    -- the pins a map shows, before merging, and the pins drawn
    items: Item[]? = nil
    pins: WorldPin[] = {}
    free: WorldPin[] = {}
    hoveredPin: WorldPin? = nil
    routes: RouteLayer? = nil
    -- the canvas at the last layout: its size in px and its scale
    lw: number? = nil
    lh: number? = nil
    lcs: number? = nil
    layoutQueued: boolean = false
    questHooked: boolean = false
    -- SuuUI's look in the game's quest pins, and which of them are the
    -- quest log's
    readonly looks: { [Frame]: QuestLook } = tbl.weakKeys()
    readonly logPins: { [Frame]: boolean } = tbl.weakKeys()
    preview: PinsPreview? = nil

    constructor()
        super({
            id = "worldmap",
            name = "World map pins",
            description = "Pins on the world map: quests to pick up, entrances, flight masters, services, rares and treasures.",
            api = "0.14",
            defaults = DEFAULTS,
        })
    end

    -- What this character keeps (its data, typed).
    function Char(): WorldMapChar
        return self:CharData() :: unknown :: WorldMapChar
    end

    --------------------------------------------------------------------------------
    -- The filters
    --------------------------------------------------------------------------------

    function Saved(): FilterChoice
        local saved = self:Get("filters")
        local owner: { [string]: string } = {}
        for _, g in ipairs(GROUPS) do
            for _, o in ipairs(g.options) do
                owner[o.value] = g.key
            end
        end
        local out: FilterChoice = {}
        for _, g in ipairs(GROUPS) do
            out[g.key] = {}
        end
        for key, entry in pairs(saved) do
            if type(entry) == "table" then
                for _, v in ipairs(entry) do
                    local legacy = key == "services" and LEGACY[v] or nil
                    local group = legacy and legacy.group or owner[v]
                    local value = legacy and legacy.value or v
                    local list = group and out[group]
                    if list and not tbl.contains(list, value) then
                        list[#list + 1] = value
                    end
                end
            end
        end
        local version = saved.v
        for _, new in ipairs(ADDED) do
            if (version or 1) < new.since then
                local list = out[new.group]
                if list and not tbl.contains(list, new.value) then
                    list[#list + 1] = new.value
                end
            end
        end
        return out
    end

    -- on[group][value] from the saved filters
    function Layers(): Layers
        local saved = self:Saved()
        local function set(key: string): On
            local s: On = {}
            for _, v in ipairs(saved[key] or {}) do
                s[v] = true
            end
            return s
        end
        return {
            quests = set("quests"),
            places = set("places"),
            services = set("services"),
            trading = set("trading"),
            trainers = set("trainers"),
            rares = set("rares"),
            marks = set("marks"),
            skyborne = set("skyborne"),
        }
    end

    -- The Marks filters, for the marks module's minimap too: { yours, shared }.
    function MarksShown(): MarkFilters
        local marks = self:Layers().marks
        return { yours = marks.yours, shared = marks.shared }
    end

    function MenuValue(): FilterChoice
        local saved = self:Saved()
        local value: FilterChoice = {}
        for _, g in ipairs(GROUPS) do
            local list: string[] = {}
            if g.key == "quests" then
                for _, o in ipairs(GAME_SETTINGS) do
                    if settingOn(o.cvar) then
                        list[#list + 1] = o.value
                    end
                end
            end
            for _, v in ipairs(saved[g.key] or {}) do
                if not (g.key == "quests" and gameSetting[v]) then
                    list[#list + 1] = v
                end
            end
            value[g.key] = list
        end
        return value
    end

    function OnFilters(value: FilterChoice)
        -- (a character without the Skyborne group keeps its saved choice)
        if value.skyborne == nil then
            value.skyborne = self:Saved().skyborne
        end
        local want: { [string]: boolean } = {}
        for _, v in ipairs(value.quests or {}) do
            want[v] = true
        end
        local changed = false
        if not InCombatLockdown() then
            for _, o in ipairs(GAME_SETTINGS) do
                if (want[o.value] or false) ~= settingOn(o.cvar) then
                    errors.try(SetCVar, o.cvar, want[o.value] and "1" or "0")
                    changed = true
                end
            end
        end
        -- the quest log and the map drawn again with them (the log redraws
        -- itself only for some of them)
        if changed then
            errors.try(field(_G, "QuestMapFrame_UpdateAll"))
            local map = self.map
            if map then
                errors.tryMethod(map, "RefreshAllDataProviders")
            end
        end
        local saved: SavedFilters = { v = FILTERS_VERSION }
        for group, list in pairs(value) do
            saved[group] = list
        end
        self:Set("filters", saved)
        self:Refresh()
    end

    -- The map open with one filter on (another module's "show me": the Damaged
    -- gear note's Show repairers turns Services › Repair on, asked 2026-10-19),
    -- at your zone; the menu shows it ticked. ("services", "repair")
    function OpenWith(group: string, item: string)
        local value = self:MenuValue()
        local list = value[group]
        if list and not tbl.contains(list, item) then
            list[#list + 1] = item
            self:OnFilters(value)
            local menu = self.menu
            if menu then
                menu:SetValue(menuValues(self:MenuValue()))
            end
        end
        local map = self.map
        if map and not map:IsShown() then
            ToggleWorldMap()
        end
    end

    --------------------------------------------------------------------------------
    -- What's on a map
    --------------------------------------------------------------------------------

    -- who you are, for what you can pick up and who serves you
    function Player(): Me
        local _, _, race = UnitRace("player")
        local _, class, classID = UnitClass("player")
        local raceID, classNumber = asNumber(race), asNumber(classID)
        local faction = asString(UnitFactionGroup("player"))
        return {
            level = asNumber(UnitLevel("player")) or 1,
            raceBit = raceID and raceBit(raceID) or 0,
            classBit = classNumber and 2 ^ (classNumber - 1) or 0,
            class = asString(class),
            faction = faction == "Horde" and "H" or faction == "Alliance" and "A" or nil,
        }
    end

    -- The flight masters this character has found, saved whenever a flight
    -- master's map opens: the game marks none undiscovered away from one on
    -- Forever (isUndiscovered is always false; probed 2026-10-19), but there it
    -- lists each node of the continent with its state (0 where you are, 1 one
    -- you can fly to, 2 not found). A continent no flight master's map has
    -- opened on yet is "not checked".
    function RecordTaxiNodes()
        if not C_TaxiMap then
            return
        end
        local zone = errors.tryValue(C_Map.GetBestMapForUnit, "player")
        local data = self:Char()
        local taxi = data.taxi or { known = {}, checked = {} }
        local function record(m: number): boolean
            local seen = false
            for _, n in ipairs(errors.tryValue(C_TaxiMap.GetAllTaxiNodes, m) or {}) do
                local id, state = asNumber(n.nodeID), asNumber(n.state)
                if id and (state == 0 or state == 1) and not junkTaxiNode(n.name) then
                    taxi.known[id] = true
                    seen = true
                end
            end
            return seen
        end
        -- where you are, its continent, the flight map's (each while the one before is known)
        local continent = continentOf(zone)
        local taxiMap = asNumber((errors.try(field(_G, "GetTaxiMapID"))))
        local seen = zone ~= nil and record(zone)
        if not seen and zone and continent then
            seen = record(continent)
        end
        if not seen and zone and continent and taxiMap then
            seen = record(taxiMap)
        end
        if not seen then
            return
        end
        if continent then
            taxi.checked[continent] = true
        end
        data.taxi = taxi
        local map = self.map
        if map and map:IsShown() then
            self:Refresh()
        end
    end

    -- What an NPC should offer you now (for /suu probe givers, which
    -- compares it with what the NPC does offer): every quest the data has
    -- it giving, with the state the map would show it in (nil: the map
    -- wouldn't), whether you're on it or have done it.
    function QuestsFor(npcID: number): (QuestOffer[], { [number]: boolean })
        local starts = SuuUI.QuestStarts()
        local me, done = self:Player(), completedSet()
        local out: QuestOffer[] = {}
        local seen: { [number]: boolean } = {}
        for mapID, rows in pairs(starts.maps) do
            for _, row in ipairs(rows) do
                if row[3] == npcID then
                    me.mapID = mapID
                    for i = 4, #row do
                        local id = row[i]
                        if not seen[id] then
                            seen[id] = true
                            local qrow = starts.quests[id]
                            local q = qrow and quest(qrow)
                            local state: string? = nil
                            local difficulty: string? = nil
                            if q then
                                state, difficulty = questState(q, id, me, done)
                            end
                            out[#out + 1] = {
                                id = id,
                                name = q and questName(q, id) or nil,
                                state = state,
                                difficulty = difficulty,
                                onQuest = onQuest(id),
                                done = done[id] or false,
                            }
                        end
                    end
                end
            end
        end
        return out, done
    end

    -- every pin the map would show, before merging (Item)
    function Collect(mapID: number): Item[]
        local items: Item[] = {}
        local on = self:Layers()
        local me = self:Player()
        me.mapID = mapID
        local starts = SuuUI.QuestStarts()
        local info = errors.tryValue(C_Map.GetMapInfo, mapID)
        local mapName = info and info.name
        local places = SuuUI.MapPlaces()
        local muted = "|cff" .. T.color["ink-muted"].hex
        local walks = muted .. "Walks a route" .. (mapName and (" through " .. mapName) or "") .. ", shown on the map|r"

        -- quests to pick up: a pin per giver's place
        if on.quests.available or on.quests.repeatable then
            local done = completedSet()
            for _, row in ipairs(starts.maps[mapID] or {}) do
                local best: { rank: number, difficulty: string, state: string }? = nil
                local list: Offer[], ids: number[] = {}, {}
                local giver = starts.givers[row[3]]
                for i = 4, #row do
                    local id = row[i]
                    local qrow = starts.quests[id]
                    if qrow then
                        local q = quest(qrow)
                        local state, difficulty, level = questState(q, id, me, done)
                        if state and difficulty and level and on.quests[state] and
                            (difficulty ~= "trivial" or on.quests.trivial) then
                            list[#list + 1] = {
                                name = questName(q, id),
                                level = level,
                                difficulty = difficulty,
                                state = state,
                                group = isGroupQuest(id),
                            }
                            ids[#ids + 1] = id
                            local rank = QUEST_RANK[difficulty] or 9
                            if not best or rank < best.rank then
                                best = { rank = rank, difficulty = difficulty, state = state }
                            end
                        end
                    end
                end
                if best then
                    local repeatable = best.state == "repeatable"
                    local lines: TipLine[] = {}
                    for i, o in ipairs(list) do
                        if i > 1 then
                            lines[#lines + 1] = {
                                o.name .. "  " .. muted .. "Level " .. o.level .. "|r",
                                quest = ids[i],
                            }
                        end
                    end
                    -- who gives it, after its level ("Level 15 · Gorrik")
                    local from = giver and (" · " .. giver) or ""
                    -- one who walks: his route, drawn while you hover the pin
                    local route = routeOf(starts.routes, row[3], mapID)
                    if route then
                        table.insert(lines, 1, { walks })
                    end
                    local look: MapPinData = repeatable and { char = "!", color = "mana", edge = "mana" } or
                        questPin(list, best)
                    items[#items + 1] = {
                        x = row[1] / 100,
                        y = row[2] / 100,
                        key = repeatable and "repeatable" or "available",
                        rank = best.rank,
                        pin = look,
                        name = list[1].name,
                        detail = (repeatable and "Repeatable · " or "") .. "Level " .. list[1].level .. from,
                        more = lines,
                        difficulty = best.difficulty,
                        repeatable = repeatable,
                        uid = "g" .. row[3],
                        quests = ids,
                        route = route,
                    }
                end
            end
        end

        -- quests started by an item: where the mobs that drop it live
        if on.quests.items then
            local done = completedSet()
            for _, row in ipairs(starts.drops[mapID] or {}) do
                local source = starts.givers[row[3]] or "?"
                local itemName = starts.items[row[4]] or "an item"
                local best: { rank: number, difficulty: string }? = nil
                local list: Offer[], ids: number[] = {}, {}
                for i = 5, #row do
                    local id = row[i]
                    local qrow = starts.quests[id]
                    if qrow then
                        local q = quest(qrow)
                        local state, difficulty, level = questState(q, id, me, done)
                        if state and difficulty and level and (difficulty ~= "trivial" or on.quests.trivial) then
                            list[#list + 1] = {
                                name = questName(q, id),
                                level = level,
                                difficulty = difficulty,
                                group = isGroupQuest(id),
                            }
                            ids[#ids + 1] = id
                            local rank = QUEST_RANK[difficulty] or 9
                            if not best or rank < best.rank then
                                best = { rank = rank, difficulty = difficulty }
                            end
                        end
                    end
                end
                if best then
                    local lines: TipLine[] = {
                        { "Starts from " .. itemName },
                        { muted .. (row[3] < 0 and "Found in " or "Dropped by ") .. source .. "|r" },
                    }
                    for i = 2, #list do
                        lines[#lines + 1] = {
                            list[i].name .. "  " .. muted .. "Level " .. list[i].level .. "|r",
                            quest = ids[i],
                        }
                    end
                    items[#items + 1] = {
                        x = row[1] / 100,
                        y = row[2] / 100,
                        key = "itemQuest",
                        rank = best.rank,
                        pin = questPin(list, best),
                        name = list[1].name,
                        detail = "Level " .. list[1].level,
                        listDetail = "Level " .. list[1].level .. " · " .. itemName .. " · " .. source,
                        more = lines,
                        difficulty = best.difficulty,
                        uid = "d" .. row[3] .. ":" .. row[4],
                        kindName = "Quests from items",
                        quests = ids,
                    }
                end
            end
        end

        -- entrances, with their recommended levels (the group finder's) and
        -- the wings' own; one whose door isn't known yet is in its area's middle
        local levels = SuuUI.InstanceLevels()
        local function range(lo: number, hi: number): string
            return lo == hi and ("level " .. lo) or ("level " .. lo .. "–" .. hi)
        end
        for _, raw in ipairs(starts.entrances[mapID] or {}) do
            local e = entrance(raw)
            local kind = e.kind
            local show = (kind == "battleground" and on.places.battlegrounds) or
                (kind ~= "battleground" and on.places.dungeons)
            if show and (not e.faction or e.faction == me.faction) then
                local detail = kind == "raid" and "Raid" or kind == "battleground" and "Battleground" or "Dungeon"
                local ofKind = levels[kind]
                local lvRow = ofKind and ofKind[e.name]
                local lines: TipLine[] = {}
                if lvRow then
                    local lv = instanceLevels(lvRow)
                    detail = detail .. " · " .. range(lv.min, lv.max)
                    for _, wing in ipairs(lv.wings) do
                        lines[#lines + 1] = { wing.name .. "  " .. muted .. range(wing.min, wing.max) .. "|r" }
                    end
                end
                if e.approx then
                    lines[#lines + 1] = { muted .. "Approximate: its door isn't known yet|r" }
                end
                -- entrances on one spot merge (Blackrock Mountain's four stacked,
                -- only the top one's card to read); one place's doors count once
                local look: MapPinData = kind == "battleground" and { glyph = "swords" } or
                    { glyph = "swirl", spin = true, ring = kind == "raid" and "gilt" or nil }
                items[#items + 1] = {
                    x = e.x / 100,
                    y = e.y / 100,
                    fixed = true,
                    uid = "e" .. e.name,
                    key = kind == "battleground" and "battleground" or "entrance",
                    kindName = kind == "battleground" and "Battlegrounds" or "Entrances",
                    pin = look,
                    name = e.name,
                    detail = detail,
                    more = #lines > 0 and lines or nil,
                }
            end
        end

        -- flight masters: the game's taxi nodes for this map (yours and
        -- neutral), found or not by this character's own record (the game's
        -- isUndiscovered is always false on Forever; see RecordTaxiNodes)
        if on.places.flight and C_TaxiMap then
            local nodes = errors.tryValue(C_TaxiMap.GetTaxiNodesForMap, mapID)
            local mine = me.faction == "H" and 1 or me.faction == "A" and 2 or -1
            local taxi = self:Char().taxi
            local continent = continentOf(mapID)
            local checked = taxi ~= nil and
                ((continent ~= nil and taxi.checked[continent] == true) or
                    (continent == nil and next(taxi.checked) ~= nil))
            for _, n in ipairs(nodes or {}) do
                local gx, gy = errors.tryMethod(n.position, "GetXY")
                local x, y = asNumber(gx), asNumber(gy)
                local side = asNumber(n.faction)
                if x and y and x >= 0 and x <= 1 and y >= 0 and y <= 1 and (side == 0 or side == mine) and
                    not junkTaxiNode(n.name) then
                    local id = asNumber(n.nodeID)
                    local known = taxi ~= nil and id ~= nil and taxi.known[id] == true
                    items[#items + 1] = {
                        x = x,
                        y = y,
                        fixed = true,
                        pin = { glyph = "wing", color = known and "gilt-text" or "ink-muted" },
                        name = asString(n.name) or "?",
                        detail = known and "Flight master" or checked and "Flight master · not found yet" or
                            "Flight master · not checked yet",
                        more = not (known or checked) and
                            {
                                {
                                    muted ..
                                        "Open any flight master's map on this continent: SuuUI notes which ones this character has found|r",
                                },
                            } or
                            nil,
                    }
                end
            end
        end

        -- campfires you found (the campsite module's memory)
        if on.places.campfires then
            local camp = SuuUI.UseService(CAMPFIRES)
            local fires = camp and camp.Fires
            for _, f in ipairs(fires and fires() or {}) do
                if f.map == mapID then
                    items[#items + 1] = {
                        x = f.x,
                        y = f.y,
                        key = "campfire",
                        fixed = true,
                        pin = { glyph = "campfire", color = "ember-text" },
                        name = "Campfire",
                        detail = "One you found",
                    }
                end
            end
        end

        -- services: one pin per NPC, the first of its services whose filter is on
        local npcs = places.npcs
        local svc = places.services[mapID] or {}
        for i = 1, #svc, 3 do
            local id = svc[i + 2]
            local row = npcs[id]
            local n = row and npc(row)
            local services, friendly, faction = n and n.services, n and n.friendly, me.faction
            -- (a holiday's NPC only while it's on)
            local event = n and n.event
            if n and services and friendly and faction and friendly:find(faction, 1, true) and
                (not event or eventOn(event, mapID)) then
                for kind in services:gmatch("[^,]+") do
                    local found: ServicePin? = nil
                    local never = false
                    local class = kind:match("^class:(.+)$")
                    local prof = kind:match("^trainer:(.+)$")
                    if class then
                        if class == me.class and on.trainers.class then
                            local token = "class-" .. class:lower()
                            found = {
                                key = "classTrainer",
                                pin = { glyph = "book", color = token, edge = token, small = true },
                                kindName = SERVICE_NAMES.classTrainer or "Class trainer",
                            }
                        elseif class ~= me.class then
                            never = true -- another class's trainer: never
                        end
                    elseif prof then
                        local layer = (prof == "weapon" and "weapon") or
                            ((prof == "riding" or prof == "pet") and "riding") or
                            "professions"
                        if on.trainers[layer] then
                            found = {
                                key = "trainer:" .. prof,
                                pin = { glyph = PROFESSION_GLYPH[prof] or "book", small = true },
                                kindName = PROFESSION_NAMES[prof] or "Trainer",
                            }
                        end
                    else
                        local s = SERVICE[kind]
                        local group = (kind == "bank" or kind == "auction") and on.trading or on.services
                        if s and group[s.filter] then
                            found = {
                                key = kind,
                                pin = { glyph = s.glyph, color = s.color, small = true },
                                kindName = SERVICE_NAMES[kind] or kind,
                            }
                        end
                    end
                    if never then
                        break
                    end
                    if found then
                        local it: Item = {
                            x = svc[i] / 100,
                            y = svc[i + 1] / 100,
                            small = true,
                            uid = "n" .. id,
                            key = found.key,
                            pin = found.pin,
                            kindName = found.kindName,
                            name = n.name,
                            detail = n.title,
                        }
                        -- one who walks his round (Zixil, Kira Songshine): his
                        -- route while you hover, like a walking rare's
                        local route = routeOf(places.routes, id, mapID)
                        if route then
                            it.route = route
                            it.more = { { walks } }
                        end
                        -- a weapon master: the weapons he teaches
                        local teaches = WEAPON_MASTERS[id]
                        if prof == "weapon" and teaches then
                            it.teaches = teaches
                            local more = it.more or {}
                            table.insert(more, 1, { "Teaches " .. teaches })
                            it.more = more
                        end
                        items[#items + 1] = it
                        break
                    end
                end
            end
        end
        if on.trading.mail then
            local mail = places.mailboxes[mapID] or {}
            for i = 1, #mail, 2 do
                items[#items + 1] = {
                    x = mail[i] / 100,
                    y = mail[i + 1] / 100,
                    key = "mail",
                    small = true,
                    pin = { glyph = "mail", small = true },
                    name = "Mailbox",
                    kindName = "Mailbox",
                }
            end
        end

        -- rares and treasures
        if on.rares.rares then
            local rares = places.rares[mapID] or {}
            -- how many spots each spawns at here (hovering one rings them all)
            local spots: { [number]: number } = {}
            for i = 3, #rares, 3 do
                spots[rares[i]] = (spots[rares[i]] or 0) + 1
            end
            for i = 1, #rares, 3 do
                local id = rares[i + 2]
                local row = npcs[id]
                local n = row and npc(row)
                local event = n and n.event
                if n and (not event or eventOn(event, mapID)) then
                    local elite = n.rank == "rareElite"
                    local lo, hi = n.minLevel, n.maxLevel
                    local level = lo and (hi and hi ~= lo and (lo .. "-" .. hi) or tostring(lo)) or nil
                    local route = routeOf(places.routes, id, mapID)
                    local lines: TipLine[] = {}
                    local count = spots[id] or 1
                    if count > 1 then
                        lines[#lines + 1] = { muted .. "Spawns at one of " .. count .. " spots, ringed on the map|r" }
                    end
                    if route then
                        lines[#lines + 1] = { walks }
                    end
                    local look: MapPinData = elite and
                        { glyph = "skull", color = "gilt-text", edge = "gilt", ring = "gilt" } or
                        { glyph = "skull", color = "ink", edge = "coin-silver" }
                    items[#items + 1] = {
                        x = rares[i] / 100,
                        y = rares[i + 1] / 100,
                        key = elite and "rareElite" or "rare",
                        pin = look,
                        name = n.name,
                        detail = (elite and "Rare elite" or "Rare") .. (level and (" · level " .. level) or ""),
                        kindName = elite and "Rare elite" or "Rare",
                        uid = "n" .. id,
                        rare = id,
                        route = route,
                        more = #lines > 0 and lines or nil,
                    }
                end
            end
        end
        if on.rares.treasures then
            local chests = places.treasures[mapID] or {}
            for i = 1, #chests, 3 do
                local x, y = asNumber(chests[i]), asNumber(chests[i + 1])
                if x and y then
                    items[#items + 1] = {
                        x = x / 100,
                        y = y / 100,
                        key = "treasure",
                        pin = { glyph = "chest", color = "coin-gold" },
                        name = asString(chests[i + 2]) or "Treasure",
                        detail = "Treasure (when it's there)",
                        kindName = "Treasure chest",
                    }
                end
            end
        end
        -- your marks and shared ones (the marks module's), on their map and the
        -- maps above it; they keep their spot, and a click opens their card
        local marks = SuuUI.UseService(MARKS)
        local list, placeOn, mapNameOf, pinLook = marks and marks.Marks,
            marks and marks.PlaceOn,
            marks and marks.MapName,
            marks and marks.PinLook
        if list and placeOn and mapNameOf and pinLook and (on.marks.yours or on.marks.shared) then
            for _, mark in ipairs(list()) do
                local from = mark.from
                if (from and on.marks.shared) or (not from and on.marks.yours) then
                    local x, y = placeOn(mark, mapID)
                    if x and y then
                        local where = ("%s %.1f, %.1f"):format(mapNameOf(mark.map) or "", mark.x * 100, mark.y * 100)
                        items[#items + 1] = {
                            x = x,
                            y = y,
                            fixed = true,
                            uid = "m" .. mark.id,
                            mark = mark.id,
                            pin = pinLook(mark),
                            name = mark.name ~= "" and mark.name or "Mark",
                            detail = where,
                            kindName = "Marks",
                            more = from and { { muted .. "Shared by " .. from .. "|r" } } or nil,
                        }
                    end
                end
            end
        end
        -- the Convergences of Elements (a Skyborne's): glowing while you lack
        -- the blessing; their tooltip read when shown (the blessing's time left)
        local conv = on.skyborne.convergences and SuuUI.UseService(CONVERGENCES) or nil
        local shown, onMap, lookOf = conv and conv.Shown, conv and conv.OnMap, conv and conv.PinLook
        if shown and onMap and lookOf and shown() then
            local look = lookOf()
            for i, c in ipairs(onMap(mapID)) do
                items[#items + 1] = {
                    x = c.x,
                    y = c.y,
                    fixed = true,
                    key = "convergence",
                    uid = "c" .. i,
                    pin = look,
                    name = "Convergence of Elements",
                    kindName = "Convergences of Elements",
                    detail = c.where,
                    tip = c.tip,
                }
            end
        end
        return items
    end

    --------------------------------------------------------------------------------
    -- The pins on the canvas
    --------------------------------------------------------------------------------

    function Pin(layer: Frame): WorldPin
        local pin = table.remove(self.free)
        if not pin then
            local made = WorldPin.new(layer)
            made:RegisterForClicks("LeftButtonUp")
            made:SetScript("OnEnter", function(p)
                local g = p.group
                if not g then
                    return
                end
                self.hoveredPin = p
                UI.ShowTooltip(p, function(): TooltipData
                    local now = p.group
                    return now and tipFor(now) or {}
                end)
                self:HighlightQuests(g)
                self:ShowRoutes(g)
            end)
            made:SetScript("OnLeave", function()
                self.hoveredPin = nil
                UI.HideTooltip()
                self:HighlightQuests(nil)
                self:ShowRoutes(nil)
            end)
            made:SetScript("OnClick", function(p)
                local g = p.group
                local first = g and g.items[1]
                -- a mark: its card
                local mark = g and g.distinct == 1 and first and first.mark or nil
                if mark then
                    local marks = SuuUI.UseService(MARKS)
                    local open = marks and marks.OpenCard
                    if open then
                        open(mark, p)
                    end
                    return
                end
                local map = self.map
                if not (g and g.distinct > 1 and map) then
                    return
                end
                local cx, cy = 0, 0
                for _, it in ipairs(g.items) do
                    cx, cy = cx + it.x, cy + it.y
                end
                map:PanAndZoomTo(cx / #g.items, cy / #g.items)
            end)
            -- a right-click goes through to the map (it zooms out)
            errors.tryMethod(made, "SetPassThroughButtons", "RightButton")
            pin = made
        end
        pin:Show()
        return pin
    end

    function HighlightQuests(group: Group?)
        local set = group and relatedOf(group)
        for _, pin in ipairs(self.pins) do
            if not set then
                pin:SetHighlight(nil)
            else
                local related = false
                local g = pin.group
                for _, it in ipairs(g and g.items or {}) do
                    local rare = it.rare
                    if rare and set.rares[rare] then
                        related = true
                        break
                    end
                    for _, id in ipairs(it.quests or {}) do
                        if set.quests[id] then
                            related = true
                            break
                        end
                    end
                    if related then
                        break
                    end
                end
                pin:SetHighlight(related and true or "dim")
            end
        end
    end

    function ShowRoutes(group: Group?)
        local layer = self.layer
        if not layer then
            return
        end
        local r = self.routes
        if not r then
            r = RouteLayer.new(layer)
            r:SetFrameLevel(layer:GetFrameLevel())
            self.routes = r
        end
        for _, d in ipairs(r.dots) do
            d.rim:Hide()
            d.fill:Hide()
        end
        r:Hide()
        local w, h, cs = self.lw, self.lh, self.lcs
        if not (group and w and h and cs) then
            return
        end
        local n = 0
        local routes = r
        local function dot(x: number, y: number, color: string)
            n = n + 1
            local d = routes.dots[n]
            if not d then
                local made: Dot = {
                    rim = routes:CreateTexture(nil, "ARTWORK", nil, 1),
                    fill = routes:CreateTexture(nil, "ARTWORK", nil, 2),
                }
                made.rim:SetTexture(DISC)
                made.rim:SetSize(ROUTE_DOT + 2, ROUTE_DOT + 2)
                UI.Paint(made.rim, "surface")
                made.fill:SetTexture(DISC)
                made.fill:SetSize(ROUTE_DOT, ROUTE_DOT)
                routes.dots[n] = made
                d = made
            end
            UI.Paint(d.fill, color)
            for _, t in ipairs({ d.rim, d.fill }) do
                t:ClearAllPoints()
                t:SetPoint("CENTER", routes, "TOPLEFT", x, -y)
                t:Show()
            end
        end
        local drawn: { [number[][]]: boolean } = {}
        for _, it in ipairs(group.items) do
            local color = it.pin.color or "ink"
            local route = it.route
            if route and not drawn[route] then
                for _, path in ipairs(route) do
                    -- walk the path, a dot each ROUTE_STEP px of it
                    local left = 0
                    for i = 1, #path - 3, 2 do
                        local ax, ay = path[i] / 100 * w, path[i + 1] / 100 * h
                        local bx, by = path[i + 2] / 100 * w, path[i + 3] / 100 * h
                        local len = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
                        local t = left
                        while t <= len do
                            local k = len > 0 and t / len or 0
                            dot(ax + (bx - ax) * k, ay + (by - ay) * k, color)
                            t = t + ROUTE_STEP
                        end
                        left = t - len
                    end
                end
            end
            if route then
                drawn[route] = true
            end
        end
        if n == 0 then
            return
        end
        r:SetScale(1 / cs)
        r:ClearAllPoints()
        r:SetPoint("TOPLEFT", layer, "TOPLEFT")
        r:SetSize(w, h)
        r:Show()
    end

    function ClearPins()
        self:ShowRoutes(nil)
        for _, pin in ipairs(self.pins) do
            pin:Hide()
            pin:ClearAllPoints()
            pin:SetHighlight(nil)
            pin.group = nil
            table.insert(self.free, pin)
        end
        self.pins = {}
    end

    function Layout()
        self.layoutQueued = false
        local f, layer, items = self.map, self.layer, self.items
        if not (f and layer and items and f:IsShown()) then
            return
        end
        self:ClearPins()
        local canvas = frames.asFrame(f:GetCanvas())
        local cs = asNumber(f:GetCanvasScale())
        if not (canvas and cs and cs > 0) then
            return
        end
        local w, h = canvas:GetWidth() * cs, canvas:GetHeight() * cs
        if w <= 0 or h <= 0 then
            return
        end
        self.lw, self.lh, self.lcs = w, h, cs
        -- zoomed all the way in (on a map that zooms), every pin stays on its
        -- exact spot, so you find it there: none move, and only those on one
        -- spot merge (they'd hide each other)
        local groups, grow = arrange(items, w, h, flag(f:IsAtMaxZoom()) and not flag(f:IsAtMinZoom()))
        local base = layer:GetFrameLevel()
        for _, g in ipairs(groups) do
            local pin = self:Pin(layer)
            local data = g.items[1].pin
            if g.distinct > 1 then
                -- a merged quest pin takes its most useful quest's colour
                if g.key == "available" or g.key == "itemQuest" or g.key == "repeatable" then
                    local best = g.items[1]
                    for _, it in ipairs(g.items) do
                        if (it.rank or 9) < (best.rank or 9) then
                            best = it
                        end
                    end
                    data = best.pin
                end
                data = {
                    glyph = data.glyph,
                    char = data.char,
                    color = data.color,
                    edge = data.edge,
                    small = data.small,
                    ring = data.ring,
                    spin = data.spin,
                    edgeWidth = data.edgeWidth,
                    glow = data.glow,
                    count = g.distinct,
                }
            end
            pin:SetData(data)
            pin:SetBaseAlpha(self:Get("pinAlpha") / 100)
            pin.group = g
            pin:SetScale(grow / cs)
            -- (three tiers in a few levels, under the game's own pins: small ones,
            -- then the rest, then places and marks; a count tab just above its pin)
            local tier = g.small and 1 or (g.fixed and 5 or 3)
            pin:SetFrameLevel(base + tier)
            pin.countTab:SetFrameLevel(base + tier + 1)
            pin:ClearAllPoints()
            pin:SetPoint("CENTER", layer, "TOPLEFT", g.x / grow, -g.y / grow)
            self.pins[#self.pins + 1] = pin
        end
        -- a mark's open card follows its pin
        local marks = SuuUI.UseService(MARKS)
        local cardOf, anchor = marks and marks.CardMark, marks and marks.AnchorCard
        local cardMark = cardOf and cardOf()
        if cardMark and anchor then
            anchor(self:PinForMark(cardMark))
        end
        -- the game's quest markers sized again for the zoom (it scales its own)
        for _, pin in ipairs(frames.mapPins(f, "QuestPinTemplate")) do
            if self.looks[pin] then
                self:FitQuestPin(pin)
            end
        end
    end

    -- The pin showing a mark (the marks module's card sits under it).
    function PinForMark(id: number): WorldPin?
        for _, pin in ipairs(self.pins) do
            local g = pin.group
            if g and g.distinct == 1 and g.items[1].mark == id then
                return pin
            end
        end
        return nil
    end

    function QueueLayout()
        if self.layoutQueued then
            return
        end
        self.layoutQueued = true
        after(0, function()
            self:Layout()
        end)
    end

    --------------------------------------------------------------------------------
    -- The game's quest markers in SuuUI's look
    --------------------------------------------------------------------------------

    -- The game's look back (the module off).
    function Unstyle(pin: Frame)
        local o = self.looks[pin]
        if o then
            o:Hide()
        end
        setArtAlpha(pin, 1)
        errors.tryMethod(pin, "UpdateButtonAlpha")
    end

    function UnstyleQuest()
        local f = self.map
        if not f then
            return
        end
        for _, pin in ipairs(frames.mapPins(f, "QuestPinTemplate")) do
            self:Unstyle(pin)
        end
        for _, pin in ipairs(logButtons()) do
            self:Unstyle(pin)
        end
    end

    function StyleQuestPin(pin: Frame)
        if not self:IsEnabled() then
            self:Unstyle(pin)
            return
        end
        local kind = questStyle(pin)
        local o = self.looks[pin]
        if not kind then
            if o then
                o:Hide()
            end
            return
        end
        if not o then
            local made = QuestLook.new(pin)
            self.looks[pin] = made
            -- ours follows the game's changes
            local function restyle()
                self:StyleQuestPin(pin)
            end
            for _, fn in ipairs({ "UpdateButtonStyle", "SetSelected", "EvaluateManagedHighlight", "SetStyle" }) do
                if type(field(pin, fn)) == "function" then
                    hook(pin, fn, restyle)
                end
            end
            hookScript(pin, "OnEnter", function()
                made.hovered = true
                restyle()
            end)
            hookScript(pin, "OnLeave", function()
                made.hovered = false
                restyle()
            end)
            o = made
        end
        -- the game's look away
        setArtAlpha(pin, 0)
        if kind == "disabled" then
            o:Hide()
            return
        end
        o:Show()
        local tracked = flag(errors.tryMethod(pin, "IsSelected"))
        local highlight = frames.asRegion(field(pin, "HighlightTexture"))
        local lit = highlight ~= nil and highlight:IsShown()
        local data: MapPinData
        if kind == "complete" then
            -- a group quest to turn in: the arcane bar under it (design D)
            local questID = asNumber(field(pin, "questID"))
            local group = questID ~= nil and isGroupQuest(questID)
            data = { char = "?", color = "arcane", edge = "arcane", bar = group and "arcane" or nil }
        elseif kind == "waypoint" then
            data = { glyph = "dash", color = "ink", edge = "ink-muted" }
        else
            data = { glyph = "questDots", color = "ink", edge = "ink-muted" }
        end
        o.pin:SetData(data)
        -- the next step on another map: a dashed edge
        o.pin.edge:SetTexture(kind == "waypoint" and (TEXTURES .. "CircleDash.tga") or (TEXTURES .. "CircleFill.tga"))
        -- (Pin opacity is the map's: the log's stay solid)
        local inLog = self.logPins[pin] == true
        o.pin:SetBaseAlpha(inLog and 1 or self:Get("pinAlpha") / 100)
        o.pin:SetHighlight((tracked or lit) and true or nil)
        -- glow: arcane under a turn-in, ink at 40% while super-tracked (not in
        -- the quest log: it would spill over the titles)
        local size = o.pin:PinSize()
        if inLog then
            o.glow:Hide()
        elseif tracked then
            UI.Paint(o.glow, "ink", 0.4)
            o.glow:SetSize(size + 24, size + 24)
            o.glow:Show()
        elseif kind == "complete" then
            UI.Paint(o.glow, "arcane-glow")
            o.glow:SetSize(size + 16, size + 16)
            o.glow:Show()
        else
            o.glow:Hide()
        end
        -- SuuUI's pin size at every zoom (the game scales its own), a tenth
        -- larger while tracked or hovered
        self:FitQuestPin(pin, (tracked or o.hovered) and 1.1 or 1)
    end

    function FitQuestPin(pin: Frame, grow: number?)
        local o = self.looks[pin]
        if not o then
            return
        end
        o.grow = grow or o.grow
        -- in the quest log: as large as the game's button, whatever the zoom
        if self.logPins[pin] then
            local h = pin:GetHeight()
            o:SetScale(o.grow * (h > 0 and h or 20) / o.pin:PinSize())
            return
        end
        local f, layer = self.map, self.layer
        if not (f and layer) then
            return
        end
        local cs = asNumber(f:GetCanvasScale())
        local pe = pin:GetEffectiveScale()
        if not (cs and cs > 0 and pe > 0) then
            return
        end
        local closest = flag(f:IsAtMaxZoom()) and not flag(f:IsAtMinZoom()) and CLOSEST_GROW or 1
        -- (SuuUI's pins: the layer's scale × grow / canvas scale; this sits in
        -- the game's pin, whose own scale it takes out)
        o:SetScale(layer:GetEffectiveScale() * closest * o.grow / cs / pe)
    end

    function StyleQuestPins()
        local f = self.map
        if not f then
            return
        end
        for _, pin in ipairs(frames.mapPins(f, "QuestPinTemplate")) do
            self:StyleQuestPin(pin)
        end
    end

    function StyleLogQuestPins()
        for _, pin in ipairs(logButtons()) do
            self.logPins[pin] = true
            self:StyleQuestPin(pin)
            -- the marker in the middle of its quest's entry, title and
            -- objectives (the game puts it at the title's top left; the row
            -- is the entry, and it follows when the row is measured again
            -- for SuuUI's fonts), space-4 left of the title (the game's 5 px
            -- had them touching; found in game). The title stays where the
            -- game put it: moved, it wrapped where the game hadn't measured.
            -- The button with it, so the click goes where it shows.
            local row = frames.asRegion(field(pin, "parent"))
            if row then
                pin:ClearAllPoints()
                pin:SetPoint("RIGHT", row, "LEFT", LOG_TITLE_X - S["space-4"], 0)
            end
        end
    end

    -- The game's quest pins' provider: after each of its refreshes, the look.
    function HookQuestProviders()
        local f = self.map
        if not f or self.questHooked then
            return
        end
        self.questHooked = true
        local questRefresh = field(_G, "QuestDataProviderMixin", "RefreshAllData")
        local areaRefresh = field(_G, "AreaPOIDataProviderMixin", "RefreshAllData")
        local providers = field(f, "dataProviders")
        if type(providers) ~= "table" then
            return
        end
        for provider in pairs(providers :: { [unknown]: unknown }) do
            local refresh = field(provider, "RefreshAllData")
            if questRefresh ~= nil and refresh == questRefresh then
                hook(provider, "RefreshAllData", function()
                    if self:IsEnabled() then
                        self:StyleQuestPins()
                    end
                end)
            elseif areaRefresh ~= nil and refresh == areaRefresh then
                hook(provider, "RefreshAllData", function()
                    if self:IsEnabled() then
                        self:HideTownPins()
                    end
                end)
            end
        end
    end

    -- The game's little houses for the cities (asked 2026-10-19): area POIs
    -- drawn from its old POI icon sheet, no atlas (probed: Darnassus,
    -- Orgrimmar, Thunder Bluff on Kalimdor). Hidden outside instances; a
    -- battleground's bases are area POIs from the same sheet.
    function HideTownPins()
        local f = self.map
        if not f or IsInInstance() then
            return
        end
        for _, pin in ipairs(frames.mapPins(f, "AreaPOIPinTemplate")) do
            local info = field(pin, "poiInfo")
            if type(info) == "table" and field(info, "atlasName") == nil then
                pin:Hide()
            end
        end
    end

    -- Your arrow: SuuUI's (the design's, made for the minimap, whose arrow
    -- Forever won't let go: no Minimap:SetPlayerTexture), on the game's group
    -- members pin, as the game sets its own; the game's again when off.
    function StyleArrow(on: boolean)
        local f = self.map
        if not f then
            return
        end
        for _, pin in ipairs(frames.mapPins(f, "GroupMembersPinTemplate")) do
            errors.tryMethod(
                pin,
                "SetPinTexture",
                "player",
                on and (TEXTURES .. "PlayerArrow.tga") or "UI-WorldMapArrow"
            )
        end
    end

    --------------------------------------------------------------------------------
    -- Unexplored areas
    --------------------------------------------------------------------------------

    function Reveal(mapID: number?)
        for _, t in ipairs(self.revealUsed) do
            t:Hide()
            table.insert(self.revealFree, t)
        end
        self.revealUsed = {}
        local f, reveal = self.map, self.reveal
        if not (mapID and f and reveal and self:Layers().places.unexplored) then
            return
        end
        -- the overlays are the base layer's: drawn only on it
        local layerIndex = asNumber(errors.tryMethod(f:GetCanvasContainer(), "GetCurrentLayerIndex")) or 1
        self.revealLayer = layerIndex
        if layerIndex ~= 1 then
            return
        end
        local art = errors.tryValue(C_Map.GetMapArtID, mapID)
        local overlays = art and SuuUI.MapOverlays()[art]
        local layers = errors.tryValue(C_Map.GetMapArtLayers, mapID)
        local layer = layers and layers[1]
        if not (overlays and layer) then
            return
        end
        local explored = errors.tryValue(C_MapExplorationInfo.GetExploredMapTextures, mapID) or {}
        for _, tile in ipairs(unexploredTiles(overlays, explored, layer.tileWidth, layer.tileHeight)) do
            local t = table.remove(self.revealFree) or reveal:CreateTexture(nil, "ARTWORK")
            t:SetTexture(tile.file, nil, nil, "TRILINEAR")
            t:SetSize(tile.w, tile.h)
            t:SetTexCoord(0, tile.u, 0, tile.v)
            t:ClearAllPoints()
            t:SetPoint("TOPLEFT", reveal, "TOPLEFT", tile.x, -tile.y)
            t:SetVertexColor(TINT[1], TINT[2], TINT[3])
            t:Show()
            self.revealUsed[#self.revealUsed + 1] = t
        end
    end

    function Refresh()
        local f = self.map
        if not (f and self:IsEnabled()) then
            return
        end
        -- the flight master's map (the flight map module) has its own pins:
        -- quests, services and marks stay off until it closes, and Map filters
        -- with them
        local flight = SuuUI.UseService(FLIGHT_MAP)
        local atMasterOf = flight and flight.AtMaster
        local atMaster = atMasterOf ~= nil and atMasterOf()
        local menu = self.menu
        if menu then
            menu:SetShown(not atMaster)
        end
        if not f:IsShown() then
            self.items = nil
            self:ClearPins()
            return
        end
        local mapID = asNumber(f:GetMapID())
        readCalendar()
        self:Reveal(mapID)
        if atMaster then
            self.items = {}
        else
            self.items = mapID and self:Collect(mapID) or {}
        end
        self:Layout()
    end

    --------------------------------------------------------------------------------
    -- The map
    --------------------------------------------------------------------------------

    -- "Map filters" in the map's header (SuuUI's, when the window skin is on),
    -- else over the map's top left; the game's own filter button goes.
    function PlaceFilters()
        local f, menu = self.map, self.menu
        if not (f and menu) then
            return
        end
        menu:ClearAllPoints()
        local chrome = chromeOf(f)
        local head = chrome and chrome.head
        if chrome and head then
            menu:SetParent(head)
            -- (by its middle, on the line the row's controls share)
            menu:SetPoint("LEFT", head, "BOTTOMLEFT", S["space-5"], chrome.rowMid or (S["space-1"] + 11))
            menu:SetFrameLevel(head:GetFrameLevel() + 4)
        else
            menu:SetParent(f)
            menu:SetPoint(
                "TOPLEFT",
                frames.asFrame(f:GetCanvasContainer()) or f,
                "TOPLEFT",
                S["space-3"],
                -S["space-3"]
            )
            menu:SetFrameLevel(f:GetFrameLevel() + 450)
        end
        local track = frames.asFrame(field(f, "WorldMapTrackingOptionsButton"))
        if track then
            track:SetAlpha(0)
            track:EnableMouse(false)
        end
        -- the waypoint pin (when the game has one) moves to the menu's right
        local pin = frames.asFrame(field(f, "WorldMapTrackingPinButton"))
        if pin and chrome then
            pin:ClearAllPoints()
            pin:SetPoint("LEFT", menu, "RIGHT", S["space-2"], 0)
        end
    end

    function Attach()
        if self.map or not frames.find("WorldMapFrame") then
            return
        end
        local f = WorldMapFrame
        local canvas = frames.asFrame(f:GetCanvas())
        if not canvas then
            return
        end
        self.map = f
        -- the unexplored areas, then the pins above them
        local reveal = CreateFrame("Frame", nil, canvas)
        reveal:SetAllPoints(canvas)
        reveal:SetFrameLevel(canvas:GetFrameLevel() + 1)
        self.reveal = reveal
        local layer = CreateFrame("Frame", nil, canvas)
        layer:SetAllPoints(canvas)
        -- above the game's map art (its explored areas, fog, quest areas and the
        -- map highlight, frame levels from 2000 up), under its own pins (quests,
        -- group members, you): just over the canvas the explored areas covered
        -- pins where the game draws them (a mark in lower Mulgore hovered but
        -- unseen; found in game)
        local levels = errors.tryMethod(f, "GetPinFrameLevelsManager")
        local above = asNumber(errors.tryMethod(levels, "GetFrameLevelStart", "PIN_FRAME_LEVEL_MAP_HIGHLIGHT"))
        layer:SetFrameLevel(above and (above + 1) or (canvas:GetFrameLevel() + 2))
        self.layer = layer
        self.pins = {}
        -- the pins' data provider: Blizzard's base, and ours on it
        local provider: { [string]: unknown } = {}
        local base = field(_G, "MapCanvasDataProviderMixin")
        if type(base) == "table" then
            for k, v in pairs(base :: { [string]: unknown }) do
                provider[k] = v
            end
        end
        provider.RefreshAllData = function()
            self:Refresh()
        end
        provider.RemoveAllData = function()
            self.items = nil
            self:ClearPins()
            self:Reveal(nil)
        end
        provider.OnCanvasScaleChanged = function()
            self:QueueLayout()
            -- a map with zoom layers: the overlays only on the base one
            local index = asNumber(errors.tryMethod(f:GetCanvasContainer(), "GetCurrentLayerIndex")) or 1
            if index ~= self.revealLayer then
                self:Reveal(asNumber(f:GetMapID()))
            end
        end
        provider.OnCanvasSizeChanged = function()
            self:QueueLayout()
        end
        self.provider = provider
        self.menu = UI.FilterMenu(f, {
            groups = menuGroups(),
            defaults = menuValues(choiceOf(DEFAULT_FILTERS)),
            value = menuValues(self:MenuValue()),
            placeholder = "Map filters",
            style = "button",
            height = 22,
            done = true,
            onChange = function(value: FilterValues)
                self:OnFilters(chosen(value))
            end,
        })
        -- every time the map opens: the game's place for its filter comes back
        self.skyborneMenu = seesConvergences()
        hookScript(f, "OnShow", function()
            if not self:IsEnabled() then
                return
            end
            self:StyleArrow(true)
            -- (the convergences module may come up after the map's menu)
            local skyborne = seesConvergences()
            local menu = self.menu
            if skyborne ~= self.skyborneMenu then
                self.skyborneMenu = skyborne
                if menu then
                    menu:SetGroups(menuGroups())
                end
            end
            if menu then
                menu:SetValue(menuValues(self:MenuValue()))
            end
            self:PlaceFilters()
        end)
        -- (a frame later: the window skin lays its row out on the same change)
        hook(f, "OnMapChanged", function()
            if self:IsEnabled() then
                after(0, function()
                    self:PlaceFilters()
                end)
            end
        end)
    end

    -- Settings › World map: how solid the pins are.
    function PreviewView(parent: Frame): PinsPreview
        local v = self.preview
        if not v then
            v = PinsPreview.new(parent)
            self.preview = v
        end
        v:SetParent(parent)
        for _, pin in ipairs(v.pins) do
            pin:SetBaseAlpha(self:Get("pinAlpha") / 100)
        end
        return v
    end

    -- The game's Quest objectives (questPOI) on once per character: off, the
    -- game draws no quest markers at all, on the map or in the log (Forever
    -- had it off on newer characters; found in game). After that it's the
    -- player's, in Map filters.
    function QuestObjectivesOnce()
        local data = self:Char()
        if data.questPOIOnce or InCombatLockdown() then
            return
        end
        if not settingOn("questPOI") then
            errors.try(SetCVar, "questPOI", "1")
        end
        data.questPOIOnce = true
    end

    override function OnEnable()
        -- the Marks filters and the marks' pins, for the marks module; the
        -- pins drawn again and a filter turned on, for the others
        self:ProvideService(WORLD_MAP, {
            MarksShown = function(): MarkFilters
                return self:MarksShown()
            end,
            PinForMark = function(id: number): Region?
                return self:PinForMark(id)
            end,
            Refresh = function()
                self:Refresh()
            end,
            OpenWith = function(group: string, item: string)
                self:OpenWith(group, item)
            end,
        })
        self:QuestObjectivesOnce()
        self:Attach()
        local f, layer, reveal, menu, provider = self.map, self.layer, self.reveal, self.menu, self.provider
        if not (f and layer and reveal and menu and provider) then
            self:OnGameEvent("ADDON_LOADED", function()
                if not self.map and frames.find("WorldMapFrame") then
                    self:Attach()
                    if self.map then
                        self:OnEnable()
                    end
                end
            end)
            return
        end
        -- (here, past the wait for the map: this runs once)
        self:RegisterSettings(SECTION)
        -- Shift pressed or let go over a quest pin: its objectives, or not
        self:OnGameEvent("MODIFIER_STATE_CHANGED", function(_, key)
            local hovered = self.hoveredPin
            local name = asString(key)
            if hovered and name and name:find("SHIFT") then
                UI.RefreshTooltip(hovered)
            end
        end)
        self:HookQuestProviders()
        self:StyleQuestPins()
        self:StyleArrow(true)
        -- (the log lays its quests out again on every change)
        if type(field(_G, "QuestLogQuests_Update")) == "function" then
            hook("QuestLogQuests_Update", function()
                if self:IsEnabled() then
                    self:StyleLogQuestPins()
                end
            end)
        end
        self:StyleLogQuestPins()
        self:Watch("pinAlpha", function()
            if f:IsShown() then
                self:Layout()
            end
            local preview = self.preview
            if preview then
                for _, pin in ipairs(preview.pins) do
                    pin:SetBaseAlpha(self:Get("pinAlpha") / 100)
                end
            end
        end)
        f:AddDataProvider(provider)
        layer:Show()
        reveal:Show()
        menu:Show()
        menu:SetValue(menuValues(self:MenuValue()))
        self:PlaceFilters()
        -- what you can pick up changes as you level and turn quests in
        for _, event in ipairs({
            "QUEST_TURNED_IN",
            "QUEST_ACCEPTED",
            "QUEST_REMOVED",
            "PLAYER_LEVEL_UP",
            "SKILL_LINES_CHANGED",
            "UPDATE_FACTION",
            "MAP_EXPLORATION_UPDATED",
        }) do
            self:OnGameEvent(event, function()
                if f:IsShown() then
                    after(0.2, function()
                        self:Refresh()
                    end)
                end
            end)
        end
        -- the holidays on today: the calendar loads its events after
        -- OpenCalendar (it tells with CALENDAR_UPDATE_EVENT_LIST); read again
        -- when the map opens, so a holiday that starts while you play shows
        -- marks made, renamed, shared or removed
        self:On("SUUUI_MARKS_CHANGED", function()
            if f:IsShown() then
                self:Refresh()
            end
        end)
        -- convergences learned or shared, the blessing gained or lost
        self:On("SUUUI_CONVERGENCES_CHANGED", function()
            if f:IsShown() then
                self:Refresh()
            end
        end)
        -- the flight masters this character has found (the game's list at a
        -- flight master; its nodes are in a moment after it opens)
        self:OnGameEvent("TAXIMAP_OPENED", function()
            after(0.2, function()
                self:RecordTaxiNodes()
            end)
        end)
        -- a theme: the pins' tooltip lines carry its colour codes, gathered again
        self:On("SUUUI_THEME_CHANGED", function()
            if f:IsShown() then
                self:Refresh()
            end
        end)
        self:OnGameEvent("CALENDAR_UPDATE_EVENT_LIST", function()
            if readCalendar() and f:IsShown() then
                self:Refresh()
            end
        end)
        errors.try(field(C_Calendar, "OpenCalendar"))
        readCalendar()
    end

    override function OnDisable()
        local f, provider = self.map, self.provider
        if not f then
            return
        end
        self:UnstyleQuest()
        self:StyleArrow(false)
        if provider then
            f:RemoveDataProvider(provider)
        end
        self.items = nil
        self:ClearPins()
        local layer, reveal, menu = self.layer, self.reveal, self.menu
        if layer then
            layer:Hide()
        end
        self:Reveal(nil)
        if reveal then
            reveal:Hide()
        end
        if menu then
            menu:Hide()
        end
        local track = frames.asFrame(field(f, "WorldMapTrackingOptionsButton"))
        if track then
            track:SetAlpha(1)
            track:EnableMouse(true)
        end
    end
end

M = SuuUI.AddModule(WorldMapModule.new())
