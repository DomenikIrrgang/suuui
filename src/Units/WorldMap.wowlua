-- Whether this character sees the Convergences of Elements (Skyborne).
local function seesConvergences(): boolean
    local conv = SuuUI.UseService(CONVERGENCES)
    local shown = conv and conv.Shown
    return shown ~= nil and shown()
end

-- The menu's groups: Skyborne only for a Skyborne character.
local function menuGroups(): FilterGroup[]
    local sky = seesConvergences()
    local out: FilterGroup[] = {}
    for _, g in ipairs(GROUPS) do
        if sky or g.key ~= "skyborne" then
            local options: FilterOption[] = {}
            for i, o in ipairs(g.options) do
                options[i] = { value = o.value, label = o.label, color = o.color }
            end
            out[#out + 1] = { key = g.key, label = g.label, kind = g.kind, options = options, column = g.column }
        end
    end
    return out
end

