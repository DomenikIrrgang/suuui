-- What Map filters chose: each group's values on.
type FilterChoice = { [string]: string[] }
-- The saved filters: each group's values (an earlier layout's groups too)
-- and the layout's version.
type SavedFilters = { v?: number, [string]: string[] | number | nil }
-- Each group's values on, as sets.
type On = { [string]: boolean }
type Layers = { quests: On, places: On, services: On, trading: On, trainers: On, rares: On, marks: On, skyborne: On }

-- Map filters' values from the choice, and back (its values: strings).
local function menuValues(f: FilterChoice): FilterValues
    local out: FilterValues = {}
    for k, list in pairs(f) do
        local l: FilterValue[] = {}
        for i, v in ipairs(list) do
            l[i] = v
        end
        out[k] = l
    end
    return out
end
-- The saved filters' groups (their version left out).
local function choiceOf(f: SavedFilters): FilterChoice
    local out: FilterChoice = {}
    for k, list in pairs(f) do
        if type(list) == "table" then
            out[k] = list
        end
    end
    return out
end
local function chosen(v: FilterValues): FilterChoice
    local out: FilterChoice = {}
    for k, c in pairs(v) do
        local l: string[] = {}
        if type(c) == "table" then
            for _, x in ipairs(c) do
                if type(x) == "string" then
                    l[#l + 1] = x
                end
            end
        end
        out[k] = l
    end
    return out
end

