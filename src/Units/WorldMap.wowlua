-- The convergences module, while this character sees them (Skyborne).
local function convergences()
    local c = SuuUI.GetModule and SuuUI.GetModule("convergences")
    return c and c.Shown and c:Shown() and c or nil
end

-- The menu's groups: Skyborne only for a Skyborne character.
local function menuGroups(): FilterGroup[]
    local sky = convergences() ~= nil
    local out: FilterGroup[] = {}
    for _, g in ipairs(GROUPS) do
        if sky or g.key ~= "skyborne" then
            local options: FilterOption[] = {}
            for i, o in ipairs(g.options) do options[i] = { value = o.value, label = o.label, color = o.color } end
            local kind: "one" | "many" | "toggles" = g.kind == "one" and "one" or g.kind == "many" and "many" or "toggles"
            out[#out + 1] = { key = g.key, label = g.label, kind = kind, options = options, column = g.column }
        end
    end
    return out
end

-- The saved filters in the current groups: each saved choice goes to the
-- group that has it now (mailboxes, bankers and auctioneers moved from
-- Services to Trading, the trainers to Trainers), so an earlier layout's
-- choices carry over; new options start off.
local LEGACY = { classTrainer = { "trainers", "class" }, trainers = { "trainers", "professions" } }
local FILTERS_VERSION = 5 -- 2: quests from items, 3: unexplored areas, 4: marks, 5: convergences (each on for everyone once)
function M:Saved()
    local saved = self:Get("filters") or DEFAULT_FILTERS
    local owner = {}
    for _, g in ipairs(GROUPS) do for _, o in ipairs(g.options) do owner[o.value] = g.key end end
    local out = {}
    for _, g in ipairs(GROUPS) do out[g.key] = {} end
    for key, entry in pairs(saved) do
        local list: string[] = type(entry) == "table" and entry or {}
        for _, v in ipairs(list) do
            local legacy = key == "services" and LEGACY[v]
            local group, value = legacy and legacy[1] or owner[v], legacy and legacy[2] or v
            if group then
                local has = false
                for _, x in ipairs(out[group]) do if x == value then has = true end end
                if not has then table.insert(out[group], value) end
            end
        end
    end
    -- options each layout version added, on for everyone once
    local added: { since: number, group: string, value: string }[] = {
        { since = 2, group = "quests", value = "items" }, { since = 3, group = "places", value = "unexplored" },
        { since = 4, group = "marks", value = "yours" }, { since = 4, group = "marks", value = "shared" },
        { since = 5, group = "skyborne", value = "convergences" },
    }
    local version = saved.v
    for _, new in ipairs(added) do
        if (type(version) == "number" and version or 1) < new.since then
            local has = false
            for _, v in ipairs(out[new.group]) do if v == new.value then has = true end end
            if not has then table.insert(out[new.group], new.value) end
        end
    end
    return out
end

-- on[group][value] from the saved filters
function M:Layers()
    local saved = self:Saved()
    local on = {}
    for _, g in ipairs(GROUPS) do
        local set = {}
        for _, v in ipairs(saved[g.key] or {}) do set[v] = true end
        on[g.key] = set
    end
    return on
end

-- The Marks filters, for the marks module's minimap too: { yours, shared }.
function M:MarksShown()
    return self:Layers().marks or {}
end

-- Quests' options that are the game's own settings, not saved by SuuUI:
-- its quest objectives on the map, and the quest log's levels ("[15]"
-- before a title) and difficulty colours (its filter menu had them; SuuUI's
-- Map filters takes its place)
local GAME_SETTINGS = {
    { value = "objectives", cvar = "questPOI" },
    { value = "levels", cvar = "showQuestLevel" },
    { value = "colours", cvar = "showQuestDifficultyColor" },
}
local gameSetting = {}
for _, o in ipairs(GAME_SETTINGS) do gameSetting[o.value] = o.cvar end

local function settingOn(cvar: string): boolean?
    local ok, v = pcall(GetCVarBool, cvar)
    return not ok or v
end

function M:MenuValue(): FilterChoice
    local saved = self:Saved()
    local value: FilterChoice = {}
    for _, g in ipairs(GROUPS) do
        local list: string[] = {}
        if g.key == "quests" then
            for _, o in ipairs(GAME_SETTINGS) do
                if settingOn(o.cvar) then list[#list + 1] = o.value end
            end
        end
        for _, v in ipairs(saved[g.key] or {}) do
            if not (g.key == "quests" and gameSetting[v]) then list[#list + 1] = v end
        end
        value[g.key] = list
    end
    return value
end

function M:OnFilters(value: FilterChoice)
    -- (a character without the Skyborne group keeps its saved choice)
    if value.skyborne == nil then value.skyborne = self:Saved().skyborne end
    local want = {}
    for _, v in ipairs(value.quests or {}) do want[v] = true end
    local changed = false
    if not InCombatLockdown() then
        for _, o in ipairs(GAME_SETTINGS) do
            if (want[o.value] or false) ~= settingOn(o.cvar) then
                pcall(SetCVar, o.cvar, want[o.value] and "1" or "0")
                changed = true
            end
        end
    end
    -- the quest log and the map drawn again with them (the log redraws
    -- itself only for some of them)
    if changed then
        if _G.QuestMapFrame_UpdateAll then pcall(QuestMapFrame_UpdateAll) end
        if self.map and self.map.RefreshAllDataProviders then self.map:RefreshAllDataProviders() end
    end
    local saved: SavedFilters = { v = FILTERS_VERSION }
    for group, list in pairs(value) do saved[group] = list end
    self:Set("filters", saved)
    self:Refresh()
end

-- The map open with one filter on (another module's "show me": the Damaged
-- gear note's Show repairers turns Services › Repair on, asked 2026-10-19),
-- at your zone; the menu shows it ticked. ("services", "repair")
function M:OpenWith(group: string, item: string)
    local value = self:MenuValue()
    local list = value[group]
    if list then
        local has = false
        for _, v in ipairs(list) do if v == item then has = true end end
        if not has then
            list[#list + 1] = item
            self:OnFilters(value)
            if self.menu then self.menu:SetValue(menuValues(self:MenuValue())) end
        end
    end
    if self.map and not self.map:IsShown() then ToggleWorldMap() end
end

