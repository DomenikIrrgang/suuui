-- Units/WorldMap.wowlua
-- The world map's pins (step 3.5, stage 2; design components MapPin and
-- WorldMap): what the game doesn't draw on Forever's map (probed
-- 2026-10-15: no flight masters, no dungeon entrances, no quests to pick
-- up), and one filter menu for them, "Map filters" in the map's header:
--   Quests     quest objectives, quest levels and difficulty colours in the
--              quest log (the game's own settings: questPOI,
--              showQuestLevel, showQuestDifficultyColor), quests to pick
--              up, repeatable and daily, trivial quests
--   Places     dungeon and raid entrances, battleground entrances, flight
--              masters (the game's taxi nodes; which ones you've found,
--              from SuuUI's own record), campfires you found (the Campfire
--              module remembers them)
--   Services   innkeepers, repair (on); vendors, stable masters,
--              battlemasters, guild masters, tabard designers, spirit
--              healers (off)
--   Trading    mailboxes (on); auctioneers, bankers (off)
--   Trainers   your class trainer (on); profession trainers, weapon
--              masters, riding and pet trainers (off)
--   Rares and treasures
--   Skyborne   the Convergences of Elements (the convergences module's),
--              for Skyborne characters only
-- Quests to pick up, entrances, services, rares and chests come from
-- SuuUI's generated data (SuuUI.QuestStarts, SuuUI.MapPlaces).
-- Where pins crowd: services are small and drawn under the rest; pins of
-- one kind closer than 32 px merge into one with a count (its hover lists
-- them, a click zooms to it); merged and small pins that still overlap are
-- pushed apart; entrances, flight masters and campfires never move.
-- The pins sit on the map's canvas through a data provider and keep their
-- size at every zoom. A built-in module written against the public API only.

import SuuUI from "/Core/API"
import chromeOf from "/UI/WindowSkin"
import after from "wowlua:timer"
import hook, hookScript from "wowlua:hooks"
import QUEST_RANK, questPin, raceBit, completedSet, onQuest, readCalendar, eventOn, questName, questState
    from "/Units/WorldMap/Quests"
import type Me from "/Units/WorldMap/Quests"
import CLOSEST_GROW, arrange from "/Units/WorldMap/Arrange"
import type Item, Group from "/Units/WorldMap/Arrange"
import tipFor from "/Units/WorldMap/Tips"
import type FilterValue, FilterValues, FilterGroup, FilterOption from "/UI/FilterMenu"
import unexploredTiles from "/Units/WorldMap/Overlays"

-- What Map filters chose: each group's values on.
type FilterChoice = { [string]: string[] }
-- The saved filters: each group's values (an earlier layout's groups too)
-- and the layout's version.
type SavedFilters = { v?: number, [string]: string[] | number | nil }

-- Map filters' values from the choice, and back (its values: strings).
local function menuValues(f: SavedFilters): FilterValues
    local out: FilterValues = {}
    for k, list in pairs(f) do
        if type(list) == "table" then
            local l: FilterValue[] = {}
            for i, v in ipairs(list) do l[i] = v end
            out[k] = l
        end
    end
    return out
end
local function chosen(v: FilterValues): FilterChoice
    local out: FilterChoice = {}
    for k, c in pairs(v) do
        local l: string[] = {}
        if type(c) == "table" then
            for _, x in ipairs(c) do if type(x) == "string" then l[#l + 1] = x end end
        end
        out[k] = l
    end
    return out
end

local DEFAULT_FILTERS: SavedFilters = {
    -- (objectives, levels and colours: the game's own settings)
    quests = { "objectives", "colours", "available", "repeatable", "items" },
    places = { "unexplored", "dungeons", "battlegrounds", "flight", "campfires" },
    services = { "inn" },
    trading = { "mail", "auction", "bank" },
    trainers = { "class" },
    rares = {},
    marks = { "yours", "shared" },
    skyborne = { "convergences" },
}

local M = SuuUI.RegisterModule({
    id = "worldmap",
    name = "World map pins",
    description = "Pins on the world map: quests to pick up, entrances, flight masters, services, rares and treasures.",
    api = "0.14",
    defaults = { filters = DEFAULT_FILTERS, pinAlpha = 100, enlargedSize = 80 },
})

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

-- (the secret test first: a secret isn't compared, not even with nil)
local function plain(v: unknown): v is string | number | boolean | table
    return not issecretvalue(v) and v ~= nil
end

local DISC = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga"

