    name?: string,
    state?: string,
    difficulty?: string,
    onQuest: boolean,
    done: boolean,
}

-- A service NPC's pin before its place: its key, look and kind.
type ServicePin = { key: string, pin: MapPinData, kindName: string }

--------------------------------------------------------------------------------
-- The pins on the canvas
--------------------------------------------------------------------------------

-- One of SuuUI's pins on the map: the pins merged into it.
class WorldPin extends MapPin
    group: Group? = nil

    constructor(parent: Frame)
        super(parent)
    end
end

-- Hovering a quest's pin rings every pin of the same quest (its giver, all
-- the places its item drops), a rare's every spot it spawns at, and fades
-- the rest, so they show at a glance.
type Related = { quests: { [number]: boolean }, rares: { [number]: boolean } }
local function relatedOf(g: Group): Related?
    local quests: { [number]: boolean }, rares: { [number]: boolean } = {}, {}
    local found = false
    for _, it in ipairs(g.items) do
        for _, id in ipairs(it.quests or {}) do
            quests[id] = true
            found = true
        end
        local rare = it.rare
        if rare then
            rares[rare] = true
            found = true
        end
    end
    return found and { quests = quests, rares = rares } or nil
end

-- A walking giver's route while you hover his pin: a dotted line in his
-- pin's colour, a dot every 9 px on a surface rim, under the pins.
local ROUTE_STEP, ROUTE_DOT = 9, 4
type Dot = { rim: Texture, fill: Texture }
class RouteLayer extends Frame
    readonly dots: Dot[] = {}

    constructor(parent: Frame)
        super(nil, parent)
    end
end

--------------------------------------------------------------------------------
-- The game's quest markers in SuuUI's look (design: MapPin types objective
-- / turn-in / waypoint, states tracked and highlighted), restyled in
-- place: the game's pins keep
-- their clicks, tooltips and super-tracking; a SuuUI pin without the mouse
-- sits in each, the game's art hidden, kept up to date after each of the
-- game's style, selection and highlight changes, and sized like SuuUI's pins
-- at every zoom. The objective areas stay the game's: its area drawing
-- takes no addon texture (SuuUI's hatch and edge showed its missing-texture
-- green, with or without the extension; found in game), and their shapes
-- aren't given to addons to draw otherwise.
--------------------------------------------------------------------------------

local TEXTURES = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"
local SOFT = TEXTURES .. "CircleSoft.tga"

-- SuuUI's look in one of the game's quest pins (or the quest log's
-- markers): a pin without the mouse, a glow under it.
class QuestLook extends Frame
    readonly glow: Texture
    readonly pin: MapPin
    hovered: boolean = false
    grow: number = 1

    constructor(owner: Frame)
        super(nil, owner)
        self:SetPoint("CENTER")
        self:SetSize(1, 1)
        self.glow = self:CreateTexture(nil, "BACKGROUND", nil, -1)
        self.glow:SetTexture(SOFT)
        self.glow:SetPoint("CENTER")
        self.pin = UI.MapPin(self)
        self.pin:EnableMouse(false)
        self.pin:SetPoint("CENTER")
    end
end

-- the game's art in its quest pins (and the underlays the log's have)
local ART = { "NormalTexture", "PushedTexture", "HighlightTexture", "Glow", "Display" }
local UNDERLAYS = { "UnderlayAtlas", "UnderlayBannerAtlas", "UnderlayBannerAtlasHighlight" }

local function setArtAlpha(pin: Frame, alpha: number)
    for _, list in ipairs({ ART, UNDERLAYS }) do
        for _, key in ipairs(list) do
            local r = frames.asRegion(field(pin, key))
            if r then
                r:SetAlpha(alpha)
            end
        end
    end
end

-- A quest pin's kind by the game's style: "complete", "progress",
-- "waypoint", "disabled", or nil.
local function questStyle(pin: Frame): string?
    local styles = field(_G, "POIButtonUtil", "Style")
    if styles == nil then
        return nil
    end
    local style = errors.tryMethod(pin, "GetStyle")
    if style == nil then
        return nil
    end
    if style == field(styles, "QuestComplete") then
        return "complete"
    end
    if style == field(styles, "QuestInProgress") then
        return "progress"
    end
    if style == field(styles, "Waypoint") then
        return "waypoint"
    end
    if style == field(styles, "QuestDisabled") then
        return "disabled"
    end
    return nil
end

-- The quest log's markers (one before each quest's title, the game's
-- buttons from its list's pool) in the same look
-- (see StyleLogQuestPins).
local function logButtons(): Frame[]
    return frames.rows(field(_G, "QuestScrollFrame", "Contents", "buttonPool"))
end

