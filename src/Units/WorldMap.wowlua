-- Whether a quest needs a group, as Questie decides it: its corrections
-- where the game's tag is wrong (SuuUI's data), else the game's tag. The
-- game knows a quest it hasn't loaded only a moment after it's first asked
-- (probe questgroup: nil at first, the tag 2 to 6 s later): until it has
-- told, SuuUI's own guess (Classic's elite, dungeon and raid quests, and
-- those set in one), and the map is drawn again once the answers are in.
local GROUP_TAGS: { [number]: boolean } = { [1] = true, [62] = true, [81] = true } -- elite, raid, dungeon
local told: { [number]: number | false } = {}
local waiting: { [number]: number }? = nil
local guessed: { [number]: boolean } = {}

local function askTag(id: number): number?
    local t = errors.tryValue(C_QuestLog.GetQuestTagInfo, id)
    return t and asNumber(t.tagID) or nil
end

local function groupTag(tag: number?): boolean
    return tag ~= nil and GROUP_TAGS[tag] == true
end

-- the quests asked and not told yet (when each was first asked): again
-- after 2 s, and after 6 s (no tag 5 s after the first ask is the game's
-- answer; a quest asked later waits for the next round); the map again
-- when one turned out otherwise than guessed
local askAgain: (final: boolean) -> ()
local function startRound()
    after(2, function()
        askAgain(false)
    end)
    after(6, function()
        askAgain(true)
    end)
end
askAgain = function(final: boolean)
    local w = waiting
    if not w then
        return
    end
    local changed, now = false, GetTime()
    for id, since in pairs(w) do
        local tag = askTag(id)
        if tag or (final and now - since >= 5) then
            told[id] = tag or false
            w[id] = nil
            if groupTag(tag) ~= (guessed[id] or false) then
                changed = true
            end
        end
    end
    if final then
        if next(w) then
            startRound()
        else
            waiting = nil
        end
    end
    local map = M.map
    if changed and map and map:IsShown() then
        M:Refresh()
    end
end

local function isGroupQuest(id: number): boolean
    local starts = SuuUI.QuestStarts()
    local fixed = starts.tags[id]
    if fixed then
        return groupTag(fixed)
    end
    if told[id] == nil then
        local tag = askTag(id)
        if tag then
            told[id] = tag
        elseif not (waiting and waiting[id]) then
            local w = waiting
            if not w then
                w = {}
                waiting = w
                startRound()
            end
            w[id] = GetTime()
            errors.try(field(C_QuestLog, "RequestLoadQuestByID"), id)
        end
    end
    local known = told[id]
    if known ~= nil then
        return known ~= false and groupTag(known)
    end
    local guess = starts.group[id] ~= nil
    guessed[id] = guess
    return guess
end

-- The continent a map lies on (itself for a continent), or nil (the world).
local function continentOf(mapID: number?): number?
    local info = mapID and errors.tryValue(C_Map.GetMapInfo, mapID) or nil
    local continent = asNumber(field(Enum, "UIMapType", "Continent")) or 2
    local guard = 0
    while info and guard < 8 do
        if info.mapType == continent then
            return info.mapID
        end
        local parent = info.parentMapID
        info = parent and parent > 0 and errors.tryValue(C_Map.GetMapInfo, parent) or nil
        guard = guard + 1
    end
    return nil
end

-- Taxi nodes the client still lists that no one flies to (an old copy of
-- Powderfuse Port, transports, quest flights)
local function junkTaxiNode(name: unknown): boolean
    local s = asString(name)
    return not s or s:find("^zzOLD") ~= nil or s:find("^Transport,") ~= nil or s:find("^Quest Path") ~= nil
end

-- A walker's route on a map, from the data's routes by NPC.
local function routeOf(routes: { [number]: { [number]: number[][] } }, id: number, mapID: number): number[][]?
    local byMap = routes[id]
    return byMap and byMap[mapID] or nil
end

