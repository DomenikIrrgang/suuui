-- Units/WorldMap.wowlua
-- The world map's pins (step 3.5, stage 2; design components MapPin and
-- WorldMap): what the game doesn't draw on Forever's map (probed
-- 2026-10-15: no flight masters, no dungeon entrances, no quests to pick
-- up), and one filter menu for them, "Map filters" in the map's header:
--   Quests     quest objectives, quest levels and difficulty colours in the
--              quest log (the game's own settings: questPOI,
--              showQuestLevel, showQuestDifficultyColor), quests to pick
--              up, repeatable and daily, trivial quests
--   Places     dungeon and raid entrances, battleground entrances, flight
--              masters (the game's taxi nodes; which ones you've found,
--              from SuuUI's own record), campfires you found (the Campfire
--              module remembers them)
--   Services   innkeepers, repair (on); vendors, stable masters,
--              battlemasters, guild masters, tabard designers, spirit
--              healers (off)
--   Trading    mailboxes (on); auctioneers, bankers (off)
--   Trainers   your class trainer (on); profession trainers, weapon
--              masters, riding and pet trainers (off)
--   Rares and treasures
--   Skyborne   the Convergences of Elements (the convergences service),
--              for Skyborne characters only
--   Hidden quests  the quests to pick up this character hid (a right-click
--              on a quest giver's pin: "Hide this quest"), ticked; unticked
--              or Show all, their pins are back. Only while it lists any.
-- Quests to pick up, entrances, services, rares and chests come from
-- SuuUI's generated data (SuuUI.QuestStarts, SuuUI.MapPlaces), read
-- through Units/WorldMap/Rows.
-- Where pins crowd: services are small and drawn under the rest; pins of
-- one kind closer than 32 px merge into one with a count (its hover lists
-- them, a click zooms to it); merged and small pins that still overlap are
-- pushed apart; entrances, flight masters and campfires never move.
-- The pins sit on the map's canvas through a data provider and keep their
-- size at every zoom. A built-in module written against the public API only.
-- (The game's map canvas declares its methods' results `any`: each is read
-- through wowlua:secret and wowlua:frames where it's used.)
--
-- This file is the module: its settings, its state, its lifecycle, the
-- map's data provider and Map filters' place in the header. The module's
-- methods keep their names here; the work is in its parts, each a
-- function taking the module:
--   Units/WorldMap/Filters    Map filters: the groups, the saved choice,
--                             the game's quest settings, hidden quests
--   Units/WorldMap/Collect    what's on a map: every pin before merging,
--                             quests judged, group tags, flight masters found
--   Units/WorldMap/GiverTips  the quest givers' index and NPC tooltips
--   Units/WorldMap/Canvas     the pins on the canvas, the routes, the
--                             unexplored areas
--   Units/WorldMap/QuestLook  the game's quest markers and your arrow in
--                             SuuUI's look
--   Units/WorldMap/Arrange, Overlays, Quests, Rows, Tips  pure logic

import SuuUI, Module from "/Core/API"
import type SettingsSection, MarkFilters, MapPinData, FilterMenu, FilterValues, FilterGroup, MapPin from "/Core/API"
import hook, hookScript from "wowlua:hooks"
import * as secret from "wowlua:secret"
import * as errors from "wowlua:errors"
import * as tbl from "wowlua:table"
import * as frames from "wowlua:frames"
import markCompleted, readCalendar from "/Units/WorldMap/Quests"
import type Me from "/Units/WorldMap/Quests"
import type Item, Group from "/Units/WorldMap/Arrange"
import type QuestStarts from "/Data/QuestStarts"
import * as filters from "/Units/WorldMap/Filters"
import menuValues, choiceOf, chosen, seesConvergences, menuGroups, settingOn from "/Units/WorldMap/Filters"
import type FilterChoice, SavedFilters, Layers from "/Units/WorldMap/Filters"
import * as collect from "/Units/WorldMap/Collect"
import forgetQuests from "/Units/WorldMap/Collect"
import * as giverTips from "/Units/WorldMap/GiverTips"
import type GiverPlaces from "/Units/WorldMap/GiverTips"
import * as mapCanvas from "/Units/WorldMap/Canvas"
import type WorldPin, RouteLayer from "/Units/WorldMap/Canvas"
import * as questLook from "/Units/WorldMap/QuestLook"
import type QuestLook from "/Units/WorldMap/QuestLook"

local WORLD_MAP = SuuUI.Services.WORLD_MAP
local FLIGHT_MAP = SuuUI.Services.FLIGHT_MAP

-- A campfire's time left: m:ss, or out (Units/WorldMap/Collect).
export function fireLeft(s: number): string
    return collect.fireLeft(s)
end

-- What an NPC should offer you now (Units/WorldMap/GiverTips).
export type QuestOffer = giverTips.QuestOffer

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local asNumber, asString, field = secret.asNumber, secret.asString, tbl.field

local DEFAULT_FILTERS: SavedFilters = {
    -- (objectives, levels and colours: the game's own settings)
    quests = { "objectives", "colours", "available", "repeatable", "items" },
    places = { "unexplored", "dungeons", "battlegrounds", "flight", "campfires" },
    services = { "inn" },
    trading = { "mail", "auction", "bank" },
    trainers = { "class" },
    rares = {},
    marks = { "yours", "shared" },
    skyborne = { "convergences" },
}

local DEFAULTS = { filters = DEFAULT_FILTERS, pinAlpha = 100, enlargedSize = 80 }

local M: WorldMapModule


-- What this character keeps: the flight masters it has found (by node, and
-- the continents a flight master's map has listed), whether the game's
-- quest objectives were turned on for it once, and the quests to pick up
-- whose pins it hid (by quest ID; none: nil).
type Taxi = { known: { [number]: boolean }, checked: { [number]: boolean } }
type WorldMapChar = { taxi?: Taxi, questPOIOnce?: boolean, hiddenQuests?: { [number]: boolean } }

-- Settings › World map: the pins at the setting's opacity.
export class PinsPreview extends Frame
    readonly pins: MapPin[] = {}

    constructor(parent: Frame)
        super(nil, parent)
        self:SetSize(200, 60)
        UI.Fill(self, "surface-sunk"):SetAllPoints()
        UI.Border(self, "gilt-line")
        local samples: MapPinData[] = {
            { char = "!", color = "quest-standard" },
            { glyph = "swirl" },
            { glyph = "mail", small = true },
            { glyph = "markStar", color = "mark-star", edge = "mark-star", edgeWidth = 2 },
        }
        for i, d in ipairs(samples) do
            local pin = UI.MapPin(self)
            pin:SetData(d)
            pin:EnableMouse(false)
            pin:SetPoint("CENTER", self, "LEFT", 32 + (i - 1) * 45, 0)
            self.pins[i] = pin
        end
    end
end

export const SECTION: SettingsSection = {
    id = "worldmap",
    label = "World map",
    category = "World",
    order = 12,
    preview = function(parent: Frame): PinsPreview
        return M:PreviewView(parent)
    end,
    groups = {
        {
            title = "Map pins",
            description = "What shows is in the map's own Map filters.",
            rows = {
                {
                    key = "pinAlpha",
                    label = "Pin opacity",
                    control = "slider",
                    min = 20,
                    max = 100,
                    step = 5,
                    unit = "%",
                    description = "How solid SuuUI's pins on the world map are. Hovering one shows the pins that belong with it at full opacity.",
                },
            },
        },
        {
            title = "Enlarged map",
            description = "The maximize button in the map's header enlarges the map in the middle of the screen.",
            rows = {
                {
                    key = "enlargedSize",
                    label = "Size",
                    control = "slider",
                    min = 50,
                    max = 100,
                    step = 5,
                    unit = "%",
                    description = "How tall the enlarged map is, its header included, as a share of the screen's height. It stays narrower than the screen.",
                },
            },
        },
    },
}

export class WorldMapModule extends Module<typeof(DEFAULTS)>
    map: typeof(WorldMapFrame)? = nil
    -- the unexplored areas, and the pins above them
    reveal: Frame? = nil
    layer: Frame? = nil
    revealFree: Texture[] = {}
    revealUsed: Texture[] = {}
    revealLayer: number? = nil
    provider: { [string]: unknown }? = nil
    menu: FilterMenu? = nil
    skyborneMenu: boolean = false
    -- the pins a map shows, before merging, and the pins drawn
    items: Item[]? = nil
    pins: WorldPin[] = {}
    free: WorldPin[] = {}
    -- quest givers' pins, kept apart: they never let right-clicks through
    -- (a pin's pass-through can't change in combat)
    freeGivers: WorldPin[] = {}
    -- the hidden quests Map filters lists (an unticked one stays until the
    -- map opens again), and whether their names were read from the data
    hiddenListed: number[] = {}
    hiddenNamed: boolean = false
    -- pins made in combat, their right-click through after it
    passLater: Frame[] = {}
    hoveredPin: WorldPin? = nil
    routes: RouteLayer? = nil
    -- the canvas at the last layout: its size in px and its scale
    lw: number? = nil
    lh: number? = nil
    lcs: number? = nil
    layoutQueued: boolean = false
    questHooked: boolean = false
    -- SuuUI's look in the game's quest pins, and which of them are the
    -- quest log's
    readonly looks: { [Frame]: QuestLook } = tbl.weakKeys()
    readonly logPins: { [Frame]: boolean } = tbl.weakKeys()
    preview: PinsPreview? = nil

    constructor()
        super({
            id = "worldmap",
            name = "World map pins",
            description = "Pins on the world map: quests to pick up, entrances, flight masters, services, rares and treasures.",
            api = "0.14",
            defaults = DEFAULTS,
        })
    end

    -- What this character keeps (its data, typed).
    function Char(): WorldMapChar
        return self:CharData() :: unknown :: WorldMapChar
    end

    --------------------------------------------------------------------------------
    -- The filters (Units/WorldMap/Filters)
    --------------------------------------------------------------------------------

    -- (the saved filters read once for each saved table: the marks' minimap
    -- asked on every update, 11 KB of tables each, 30 MB of SuuUI's garbage
    -- in a 5-minute recording)
    savedFor: unknown = nil
    savedCache: FilterChoice? = nil
    layersCache: Layers? = nil

    function Saved(): FilterChoice
        return filters.readSaved(self)
    end

    function Layers(): Layers
        return filters.readLayers(self)
    end

    -- The Marks filters, for the marks module's minimap too: { yours, shared }
    -- (the same table while the filters stay).
    marksShown: MarkFilters? = nil
    marksFor: Layers? = nil

    function MarksShown(): MarkFilters
        return filters.marksShown(self)
    end

    function MenuValue(): FilterChoice
        return filters.menuValue(self)
    end

    function OnFilters(value: FilterChoice)
        filters.onFilters(self, value)
    end

    function OpenWith(group: string, item: string)
        filters.openWith(self, group, item)
    end

    --------------------------------------------------------------------------------
    -- Hidden quests: quests to pick up whose pins this character hid (a
    -- right-click on a giver's pin), listed in Map filters to show again
    -- (Units/WorldMap/Filters)
    --------------------------------------------------------------------------------

    function IsQuestHidden(id: number): boolean
        return filters.isQuestHidden(self, id)
    end

    function QuestTitle(id: number): string
        return filters.questTitle(self, id)
    end

    function HiddenQuests(): number[]
        return filters.hiddenQuests(self)
    end

    function HideQuests(ids: number[])
        filters.hideQuests(self, ids)
    end

    function ShowAllQuests()
        filters.showAllQuests(self)
    end

    function MenuGroups(): FilterGroup[]
        return filters.groupsWithHidden(self)
    end

    function ListHidden(force: boolean?)
        filters.listHidden(self, force)
    end

    function QuestMenu(pin: WorldPin)
        filters.questMenu(self, pin)
    end

    --------------------------------------------------------------------------------
    -- What's on a map (Units/WorldMap/Collect; the givers and their
    -- tooltips: Units/WorldMap/GiverTips)
    --------------------------------------------------------------------------------

    function Player(): Me
        return collect.player(self)
    end

    function RecordTaxiNodes()
        collect.recordTaxiNodes(self)
    end

    function QuestsFor(npcID: number): (QuestOffer[], { [number]: boolean })
        return giverTips.questsFor(self, npcID)
    end

    -- Where each giver stands in the data, made once (QuestsFor runs for
    -- every NPC's tooltip): its rows, each with its map. Made a few maps a
    -- frame from the frame after the quest data is there, whoever built it
    -- (2026-11-13: made at once on the first NPC's tooltip, it was the
    -- heaviest frame of a crowd, a city or a zone: 29,000 instructions);
    -- whatever isn't made yet when a tooltip asks is made then.
    giverIndex: { [number]: GiverPlaces }? = nil
    -- (while it's made: the part so far, the last map done, whether the
    -- frames make it, and the data it's made from)
    giverMade: { [number]: GiverPlaces }? = nil
    giverAt: number? = nil
    giverStarted: boolean = false
    giverFrom: QuestStarts? = nil

    function IndexGivers(rows: number): boolean
        return giverTips.indexGivers(self, rows)
    end

    function IndexGiversSoon()
        giverTips.indexGiversSoon(self)
    end

    function GiverPlaces(npcID: number): GiverPlaces
        return giverTips.giverPlaces(self, npcID)
    end

    -- An NPC's tooltip: the quests it gives that you can pick up now, as the
    -- map's quest pins would show them (asked 2026-11-07), in their
    -- difficulty's colour with their level.
    questTipsHooked: boolean = false

    function HookQuestTips()
        giverTips.hookQuestTips(self)
    end

    function QuestTip(tooltip: GameTooltip)
        giverTips.questTip(self, tooltip)
    end

    function Collect(mapID: number): Item[]
        return collect.collect(self, mapID)
    end

    --------------------------------------------------------------------------------
    -- The pins on the canvas (Units/WorldMap/Canvas)
    --------------------------------------------------------------------------------

    function PassThrough(pin: Frame)
        mapCanvas.passThrough(self, pin)
    end

    function Pin(layer: Frame, giver: boolean?): WorldPin
        return mapCanvas.poolPin(self, layer, giver)
    end

    function HighlightQuests(group: Group?)
        mapCanvas.highlightQuests(self, group)
    end

    function ShowRoutes(group: Group?)
        mapCanvas.showRoutes(self, group)
    end

    function ClearPins()
        mapCanvas.clearPins(self)
    end

    function Layout()
        mapCanvas.layout(self)
    end

    function PinForMark(id: number): WorldPin?
        return mapCanvas.pinForMark(self, id)
    end

    function QueueLayout()
        mapCanvas.queueLayout(self)
    end

    --------------------------------------------------------------------------------
    -- The game's quest markers in SuuUI's look (Units/WorldMap/QuestLook)
    --------------------------------------------------------------------------------

    function Unstyle(pin: Frame)
        questLook.unstyle(self, pin)
    end

    function UnstyleQuest()
        questLook.unstyleQuest(self)
    end

    function StyleQuestPin(pin: Frame)
        questLook.styleQuestPin(self, pin)
    end

    function FitQuestPin(pin: Frame, grow: number?)
        questLook.fitQuestPin(self, pin, grow)
    end

    function StyleQuestPins()
        questLook.styleQuestPins(self)
    end

    function StyleLogQuestPins()
        questLook.styleLogQuestPins(self)
    end

    function HookQuestProviders()
        questLook.hookQuestProviders(self)
    end

    function HideTownPins()
        questLook.hideTownPins(self)
    end

    function StyleArrow(on: boolean)
        questLook.styleArrow(self, on)
    end

    --------------------------------------------------------------------------------
    -- Unexplored areas (Reveal: Units/WorldMap/Canvas), the map's data
    --------------------------------------------------------------------------------

    function Reveal(mapID: number?)
        mapCanvas.revealUnexplored(self, mapID)
    end

    -- Whether the map's data is built (Core/Data).
    function DataReady(): boolean
        return SuuUI.Data.QuestStarts:Ready() and SuuUI.Data.MapPlaces:Ready() and SuuUI.Data.MapOverlays:Ready()
    end

    -- The map's data built a step a frame, then the map drawn again.
    function PrepareData()
        local function done()
            local f = self.map
            if self:IsEnabled() and f and f:IsShown() and self:DataReady() then
                self:Refresh()
            end
        end
        SuuUI.Data.MapOverlays:Prepare(done, "worldmap")
        SuuUI.Data.MapPlaces:Prepare(done, "worldmap")
        SuuUI.Data.QuestStarts:Prepare(done, "worldmap")
    end

    function Refresh()
        local f = self.map
        if not (f and self:IsEnabled()) then
            return
        end
        -- the flight master's map (the flight map module) has its own pins:
        -- quests, services and marks stay off until it closes, and Map filters
        -- with them
        local flight = SuuUI.UseService(FLIGHT_MAP)
        local atMasterOf = flight and flight.AtMaster
        local atMaster = atMasterOf ~= nil and atMasterOf()
        local menu = self.menu
        if menu then
            menu:SetShown(not atMaster)
        end
        if not f:IsShown() then
            self.items = nil
            self:ClearPins()
            return
        end
        -- the quest and place data, built a step a frame the first time
        -- (3 MB in one frame was a stutter): their pins once it's there,
        -- the others (marks, flight masters, …) now
        if not self:DataReady() then
            self:PrepareData()
        end
        -- Hidden quests listed before the quest data was built: their names
        -- from it now (not under an open Map filters: it would close)
        local menu = self.menu
        if menu and not self.hiddenNamed and #self.hiddenListed > 0 and SuuUI.Data.QuestStarts:Ready() then
            local panel = menu.panel
            if not (panel and panel:IsShown()) then
                self:ListHidden(true)
            end
        end
        local mapID = asNumber(f:GetMapID())
        readCalendar()
        self:Reveal(mapID)
        if atMaster then
            self.items = {}
        else
            self.items = mapID and self:Collect(mapID) or {}
        end
        self:Layout()
    end

    --------------------------------------------------------------------------------
    -- The map
    --------------------------------------------------------------------------------

    -- "Map filters" in the map's header (SuuUI's, when the window skin is on),
    -- else over the map's top left; the game's own filter button goes.
    function PlaceFilters()
        local f, menu = self.map, self.menu
        if not (f and menu) then
            return
        end
        menu:ClearAllPoints()
        local chrome = SuuUI.UI.WindowChrome(f)
        local head = chrome and chrome.head
        if chrome and head then
            menu:SetParent(head)
            -- (by its middle, on the line the row's controls share)
            menu:SetPoint("LEFT", head, "BOTTOMLEFT", S["space-5"], chrome.rowMid or (S["space-1"] + 11))
            menu:SetFrameLevel(head:GetFrameLevel() + 4)
        else
            menu:SetParent(f)
            menu:SetPoint(
                "TOPLEFT",
                frames.asFrame(f:GetCanvasContainer()) or f,
                "TOPLEFT",
                S["space-3"],
                -S["space-3"]
            )
            menu:SetFrameLevel(f:GetFrameLevel() + 450)
        end
        -- (made under the scaled map: its edge laid again for where it shows,
        -- else under a pixel, its right side gone; found in game 2026-11-14)
        SuuUI.Pixel.Relayout(menu)
        local track = frames.asFrame(field(f, "WorldMapTrackingOptionsButton"))
        if track then
            track:SetAlpha(0)
            track:EnableMouse(false)
        end
        -- the waypoint pin (when the game has one) moves to the menu's right
        local pin = frames.asFrame(field(f, "WorldMapTrackingPinButton"))
        if pin and chrome then
            pin:ClearAllPoints()
            pin:SetPoint("LEFT", menu, "RIGHT", S["space-2"], 0)
        end
    end

    function Attach()
        if self.map or not frames.find("WorldMapFrame") then
            return
        end
        local f = WorldMapFrame
        local canvas = frames.asFrame(f:GetCanvas())
        if not canvas then
            return
        end
        self.map = f
        -- the unexplored areas, then the pins above them
        local reveal = CreateFrame("Frame", nil, canvas)
        reveal:SetAllPoints(canvas)
        reveal:SetFrameLevel(canvas:GetFrameLevel() + 1)
        self.reveal = reveal
        local layer = CreateFrame("Frame", nil, canvas)
        layer:SetAllPoints(canvas)
        -- above the game's map art (its explored areas, fog, quest areas and the
        -- map highlight, frame levels from 2000 up), under its own pins (quests,
        -- group members, you): just over the canvas the explored areas covered
        -- pins where the game draws them (a mark in lower Mulgore hovered but
        -- unseen; found in game)
        local levels = errors.tryMethod(f, "GetPinFrameLevelsManager")
        local above = asNumber(errors.tryMethod(levels, "GetFrameLevelStart", "PIN_FRAME_LEVEL_MAP_HIGHLIGHT"))
        layer:SetFrameLevel(above and (above + 1) or (canvas:GetFrameLevel() + 2))
        self.layer = layer
        self.pins = {}
        -- the pins' data provider: Blizzard's base, and ours on it
        local provider: { [string]: unknown } = {}
        local base = field(_G, "MapCanvasDataProviderMixin")
        if type(base) == "table" then
            for k, v in pairs(base :: { [string]: unknown }) do
                provider[k] = v
            end
        end
        provider.RefreshAllData = function()
            self:Refresh()
        end
        provider.RemoveAllData = function()
            self.items = nil
            self:ClearPins()
            self:Reveal(nil)
        end
        provider.OnCanvasScaleChanged = function()
            self:QueueLayout()
            -- a map with zoom layers: the overlays only on the base one
            local index = asNumber(errors.tryMethod(f:GetCanvasContainer(), "GetCurrentLayerIndex")) or 1
            if index ~= self.revealLayer then
                self:Reveal(asNumber(f:GetMapID()))
            end
        end
        provider.OnCanvasSizeChanged = function()
            self:QueueLayout()
        end
        self.provider = provider
        self.menu = UI.FilterMenu(f, {
            groups = menuGroups(),
            defaults = menuValues(choiceOf(DEFAULT_FILTERS)),
            value = menuValues(self:MenuValue()),
            placeholder = "Map filters",
            style = "button",
            height = 22,
            done = true,
            onChange = function(value: FilterValues)
                self:OnFilters(chosen(value))
            end,
        })
        -- (the quests this character hid: their group in it)
        self:ListHidden()
        -- every time the map opens: the game's place for its filter comes back
        self.skyborneMenu = seesConvergences()
        hookScript(f, "OnShow", function()
            if not self:IsEnabled() then
                return
            end
            self:StyleArrow(true)
            -- (the convergences module may come up after the map's menu)
            local skyborne = seesConvergences()
            local menu = self.menu
            if skyborne ~= self.skyborneMenu then
                self.skyborneMenu = skyborne
                if menu then
                    menu:SetGroups(self:MenuGroups())
                end
            end
            -- the hidden quests listed afresh: those shown again leave it
            self:ListHidden()
            if menu then
                menu:SetValue(menuValues(self:MenuValue()))
            end
            self:PlaceFilters()
        end)
        -- (a frame later: the window skin lays its row out on the same change)
        hook(f, "OnMapChanged", function()
            if self:IsEnabled() then
                self:After(0, function()
                    self:PlaceFilters()
                end)
            end
        end)
    end

    -- Settings › World map: how solid the pins are.
    function PreviewView(parent: Frame): PinsPreview
        local v = self.preview
        if not v then
            v = PinsPreview.new(parent)
            self.preview = v
        end
        v:SetParent(parent)
        for _, pin in ipairs(v.pins) do
            pin:SetBaseAlpha(self:Get("pinAlpha") / 100)
        end
        return v
    end

    -- The game's Quest objectives (questPOI) on once per character: off, the
    -- game draws no quest markers at all, on the map or in the log (Forever
    -- had it off on newer characters; found in game). After that it's the
    -- player's, in Map filters.
    function QuestObjectivesOnce()
        local data = self:Char()
        if data.questPOIOnce or InCombatLockdown() then
            return
        end
        if not settingOn("questPOI") then
            errors.try(SetCVar, "questPOI", "1")
        end
        data.questPOIOnce = true
    end

    override function OnEnable()
        self:HookQuestTips()
        -- (the givers' index for the NPCs' tooltips, made over frames once
        -- the quest data is there)
        SuuUI.Data.QuestStarts:Then(function()
            self:IndexGiversSoon()
        end, "givers")
        -- the Marks filters and the marks' pins, for the marks module; the
        -- pins drawn again and a filter turned on, for the others
        self:ProvideService(WORLD_MAP, {
            MarksShown = function(): MarkFilters
                return self:MarksShown()
            end,
            PinForMark = function(id: number): Region?
                return self:PinForMark(id)
            end,
            Refresh = function()
                self:Refresh()
            end,
            OpenWith = function(group: string, item: string)
                self:OpenWith(group, item)
            end,
        })
        self:QuestObjectivesOnce()
        self:Attach()
        if not self:OnMap() then
            -- the map not there yet (it loads with an addon): the rest once
            -- it is (X-11.b4: OnEnable itself ran again from here, its
            -- service and data callback registered twice)
            self:OnGameEvent("ADDON_LOADED", function()
                if not self.map and frames.find("WorldMapFrame") then
                    self:Attach()
                    self:OnMap()
                end
            end)
        end
    end

    -- The part of OnEnable that needs the world map (made by Attach): false
    -- while it isn't there yet.
    function OnMap(): boolean
        local f, layer, reveal, menu, provider = self.map, self.layer, self.reveal, self.menu, self.provider
        if not (f and layer and reveal and menu and provider) then
            return false
        end
        -- (here, past the wait for the map: this runs once per enable)
        self:RegisterSettings(SECTION)
        -- Shift pressed or let go over a quest pin: its objectives, or not
        self:OnGameEvent("MODIFIER_STATE_CHANGED", function(_, key)
            local hovered = self.hoveredPin
            local name = asString(key)
            if hovered and name and name:find("SHIFT") then
                UI.RefreshTooltip(hovered)
            end
        end)
        self:HookQuestProviders()
        self:StyleQuestPins()
        self:StyleArrow(true)
        -- (the log lays its quests out again on every change; the module's
        -- own hook: installed once, re-armed on each enable, silent while off)
        if type(field(_G, "QuestLogQuests_Update")) == "function" then
            self:SecureHook("QuestLogQuests_Update", function()
                self:StyleLogQuestPins()
            end)
        end
        self:StyleLogQuestPins()
        self:Watch("pinAlpha", function()
            if f:IsShown() then
                self:Layout()
            end
            local preview = self.preview
            if preview then
                for _, pin in ipairs(preview.pins) do
                    pin:SetBaseAlpha(self:Get("pinAlpha") / 100)
                end
            end
        end)
        f:AddDataProvider(provider)
        layer:Show()
        reveal:Show()
        menu:Show()
        menu:SetValue(menuValues(self:MenuValue()))
        self:PlaceFilters()
        -- what each quest is for you: judged again after any of these
        for _, event in ipairs({
            "QUEST_TURNED_IN",
            "QUEST_ACCEPTED",
            "QUEST_REMOVED",
            "QUEST_LOG_UPDATE",
            "PLAYER_LEVEL_UP",
            "SKILL_LINES_CHANGED",
            "UPDATE_FACTION",
        }) do
            self:OnGameEvent(event, forgetQuests)
        end
        self:OnGameEvent("QUEST_TURNED_IN", function(_, questID)
            markCompleted(questID)
        end)
        -- what you can pick up changes as you level and turn quests in
        for _, event in ipairs({
            "QUEST_TURNED_IN",
            "QUEST_ACCEPTED",
            "QUEST_REMOVED",
            "PLAYER_LEVEL_UP",
            "SKILL_LINES_CHANGED",
            "UPDATE_FACTION",
            "MAP_EXPLORATION_UPDATED",
        }) do
            self:OnGameEvent(event, function()
                if f:IsShown() then
                    self:After(0.2, function()
                        self:Refresh()
                    end)
                end
            end)
        end
        -- the holidays on today: the calendar loads its events after
        -- OpenCalendar (it tells with CALENDAR_UPDATE_EVENT_LIST); read again
        -- when the map opens, so a holiday that starts while you play shows
        -- marks made, renamed, shared or removed
        self:On("SUUUI_MARKS_CHANGED", function()
            if f:IsShown() then
                self:Refresh()
            end
        end)
        -- convergences learned or shared, the blessing gained or lost
        self:On("SUUUI_CONVERGENCES_CHANGED", function()
            if f:IsShown() then
                self:Refresh()
            end
        end)
        -- a campfire passed, by you or someone in your group or guild
        self:On("SUUUI_CAMPFIRES_CHANGED", function()
            if f:IsShown() then
                self:Refresh()
            end
        end)
        -- the flight masters this character has found (the game's list at a
        -- flight master; its nodes are in a moment after it opens)
        self:OnGameEvent("TAXIMAP_OPENED", function()
            self:After(0.2, function()
                self:RecordTaxiNodes()
            end)
        end)
        -- a theme: the pins' tooltip lines carry its colour codes, gathered again
        self:On("SUUUI_THEME_CHANGED", function()
            if f:IsShown() then
                self:Refresh()
            end
        end)
        self:OnGameEvent("CALENDAR_UPDATE_EVENT_LIST", function()
            if readCalendar() and f:IsShown() then
                self:Refresh()
            end
        end)
        errors.try(field(C_Calendar, "OpenCalendar"))
        readCalendar()
        return true
    end

    override function OnDisable()
        -- (its layout timer went with the module: queued afresh when on again)
        self.layoutQueued = false
        local f, provider = self.map, self.provider
        if not f then
            return
        end
        self:UnstyleQuest()
        self:StyleArrow(false)
        if provider then
            f:RemoveDataProvider(provider)
        end
        self.items = nil
        self:ClearPins()
        local layer, reveal, menu = self.layer, self.reveal, self.menu
        if layer then
            layer:Hide()
        end
        self:Reveal(nil)
        if reveal then
            reveal:Hide()
        end
        if menu then
            menu:Hide()
        end
        local track = frames.asFrame(field(f, "WorldMapTrackingOptionsButton"))
        if track then
            track:SetAlpha(1)
            track:EnableMouse(true)
        end
    end
end

M = SuuUI.AddModule(WorldMapModule.new())
