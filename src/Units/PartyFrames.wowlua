-- Units/PartyFrames.wowlua
-- Party frames (step 1.8): you and up to four party members, one unit frame
-- each. A built-in module written against the public API only.
--
-- One layout per profile: SuuUI switches profiles by role (General >
-- Profiles > By role), so a healer profile can put the party in the middle
-- of the screen with the low-health tint, and a tank or DPS profile bottom
-- left above the chat, without the frames knowing about roles themselves.
--
-- The frames show in a party and hide in a raid (raid frames are step 1.9)
-- and solo. The settings window's preview column shows a made-up party,
-- so every setting can be tried solo. Each follows its unit (RegisterUnitWatch); party units fill from
-- party1 up, so the slots never have gaps. Placement and size change only
-- out of combat: the frames are secure buttons (click to target).
--
-- Auras are the engine's (aura containers): debuffs you can remove first
-- (dispel-coloured edge), then defensives, then the other debuffs raid
-- frames show; buffs come only through buff indicators. Debuff types (Magic, Curse, Poison,
-- Disease) are slots: per type a one-aura container
-- filtered to that type, whose button carries that type's border and badge
-- across the whole frame. The engine shows and hides it, so it works in
-- combat, where addon code can't read auras. Aggro comes from the threat
-- state, which stays readable.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SettingsSection from "/Core/Modules"
import type Position from "/EditMode/EditMode"
import UnitFrame from "/UI/UnitFrame"
import type StandInPerson, UnitApi, UnitFrameOptions, GroupDefensives from "/UI/UnitFrame"
import type UnitAuras, AuraGroup from "/UI/Auras"
import type Icon from "/UI/Icon"
import * as secret from "wowlua:secret"
import after, every from "wowlua:timer"
import * as tbl from "wowlua:table"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {
    position = { point = "BOTTOMLEFT", x = 28, y = 300 } :: Position,
    showSelf = true,
    showSolo = false,       -- your own frame while not in a group
    direction = "up",       -- "up", "down", "right"
    width = 200,
    height = 28,
    gap = 6,
    power = "roles",        -- "roles" (tanks and healers), "all", "none"
    healthText = "percent",
    nameColor = "game",     -- "game" (class colour) or "ink", as on the unit frames
    raidMarkers = true,
    lowHealth = true,
    incoming = true,
    buffIcons = 2,          -- defensives on them (the Defensives list)
    debuffIcons = 3,        -- debuffs, the ones you can remove first
    auraSide = "right",     -- "right", "left" or "inside" (the bar's right end; for a row)
    debuffBadges = "all",   -- "all" debuff types, "removable" or "off"
    rangeAlpha = 0.25,
}

local M: PartyFramesModule

local SLOTS = { "player", "party1", "party2", "party3", "party4" }

-- Healing classes, for the power line when the group gives no roles.
local HEALER_CLASS: { [string]: boolean } = { PRIEST = true, DRUID = true, PALADIN = true, SHAMAN = true }

local function powerFor(unit: string, A: UnitApi): boolean
    local mode = M:Get("power")
    if mode == "all" then return true end
    if mode == "none" then return false end
    local role = A.UnitGroupRolesAssigned and A.UnitGroupRolesAssigned(unit)
    if not secret.isSecret(role) and role and role ~= "NONE" then return role == "TANK" or role == "HEALER" end
    local _, class = A.UnitClass(unit)
    return not secret.isSecret(class) and class and HEALER_CLASS[class] == true or false
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

-- Auras after the bar, clipped to the number the settings allow: the engine
-- fills its groups in order, and what doesn't fit is cut off.
-- Beside the bar, one row the engine lays out: defensives (the Defensives
-- list's spells, Frames › Defensives: the game hides who cast another
-- player's buffs, and its own defensive filters then let every buff
-- through), then debuffs, the ones you can remove first, right after
-- however many defensives show, `space-4` apart. On your own frame the
-- debuffs you can remove come first; on everyone else's they're one list
-- (the game hides who cast another player's auras, and those then pass both
-- "removable" and "not removable", so each showed twice). Defensives are always left
-- of debuffs: on the left side the debuffs come first from the bar. No
-- other buffs: those come through buff indicators.
local GAP_SETS = S["space-4"]
type PartyGroup = { key: string, set: "buffIcons" | "debuffIcons", who?: string, filter: string[], list?: keyof GroupDefensives, border?: string, glow?: string,
    drain?: string, dispel?: boolean, harmfulEdge?: boolean }
local AURA_GROUPS: PartyGroup[] = {
    { key = "defensives", set = "buffIcons", filter = { "HELPFUL" }, list = "all", border = "ward", glow = "glow-ward", drain = "ward" },
    { key = "dispel", set = "debuffIcons", who = "me", filter = { "HARMFUL", "RAID_PLAYER_DISPELLABLE" }, dispel = true, harmfulEdge = true },
    -- every other debuff (Forbearance, Weakened Soul…)
    { key = "debuffs", set = "debuffIcons", who = "me", filter = { "HARMFUL", "!RAID_PLAYER_DISPELLABLE" }, dispel = true, harmfulEdge = true },
    -- everyone else's frames: all their debuffs, once
    { key = "all", set = "debuffIcons", who = "others", filter = { "HARMFUL" }, dispel = true, harmfulEdge = true },
}
-- each group's place from the bar: defensives first on the right, last on the left
local ORDER: { [string]: { [string]: number } } = {
    right = { defensives = 1, dispel = 2, debuffs = 3, all = 4 },
    left = { dispel = 1, debuffs = 2, all = 3, defensives = 4 },
}

-- A group's count on a frame: its setting, on the frames it is for.
local function groupMax(f: UnitFrame, g: PartyGroup): number
    if g.who and g.who ~= (f.unit == "player" and "me" or "others") then return 0 end
    return M:Get(g.set)
end

-- The row's width: both sets' icons, and the gap when both have room.
local function rowWidth(h: number, buffs: number, debuffs: number): number
    local n = buffs + debuffs
    if n == 0 then return 0 end
    return n * h + (n - 1) * S["space-2"] + ((buffs > 0 and debuffs > 0) and (GAP_SETS - S["space-2"]) or 0)
end

-- A party frame: the unit frame, the row of auras beside it (clipped to the
-- number the settings allow) and the selected border (your target: its own
-- frame, so a secret "is it the target?" can set its alpha through the engine).
export class PartyFrame extends UnitFrame
    readonly auraClip: Frame
    readonly selected: Frame
    -- the engine's aura row (the live frames')
    auras: UnitAuras? = nil

    constructor(parent: Frame, unit: string, opts: UnitFrameOptions)
        super(parent, unit, opts)
        self.auraClip = CreateFrame("Frame", nil, self)
        self.auraClip:SetClipsChildren(true)
        local sel = CreateFrame("Frame", nil, self)
        sel:SetAllPoints()
        sel:SetFrameLevel(self:GetFrameLevel() + 10)
        UI.Border(sel, "arcane", { inset = 0 })
        sel:SetAlpha(0)
        self.selected = sel
    end

    -- The engine's aura row, filled group by group.
    function BuildAuras()
        local defensives = UI.GroupDefensives()
        local groups: AuraGroup[] = {}
        for i, g in ipairs(AURA_GROUPS) do
            local list = g.list
            groups[i] = { key = g.key, filter = g.filter, max = groupMax(self, g), dispel = g.dispel, drain = g.drain,
                harmfulEdge = g.harmfulEdge, border = g.border, glow = g.glow,
                include = list and defensives[list] }
        end
        local auras = UI.AuraContainer(self.auraClip, assert(self.unit), { size = M:Get("height"), anchor = "TOPLEFT", growth = { "RIGHT", "DOWN" }, groups = groups, lazy = true })
        self.auras = auras
        if auras then auras.container:SetPoint("TOPLEFT", self.auraClip, "TOPLEFT") end
    end
end

-- A preview's frame: the row as the live frames have it, icons drawn
-- instead of the engine's; the debuff types' looks.
export class PreviewPartyFrame extends PartyFrame
    readonly icons: Icon[] = {}
    readonly dispelDecos: { [string]: Frame } = {}
    indicatorVersion: number? = nil

    constructor(parent: Frame, unit: string, opts: UnitFrameOptions)
        super(parent, unit, opts)
        self:SetScript("OnEnter", nil)
        self:SetScript("OnLeave", nil)
        self:EnableMouse(false)
        for k = 1, 8 do
            local icon = UI.Icon(self.auraClip, 24)
            icon:Hide()
            self.icons[k] = icon
        end
        for _, kind in ipairs(UI.DEBUFF_TYPES) do
            local deco = self:DispelDecoration(self, kind)
            deco:Hide()
            self.dispelDecos[kind] = deco
        end
        local ward = self:WardDecoration(self)
        ward:SetWarded(false)
        self.wardDeco = ward
    end
end

--------------------------------------------------------------------------------
-- The preview (the settings window's preview column): a made-up party drawn
-- by the same unit frames, from stand-in data instead of the game
-- (UnitFrame's opts.api). Not secure, so it follows every setting at once.
--------------------------------------------------------------------------------

-- Five people: you, then a tank, a healer, a mage with aggro, a rogue out of
-- range. Auras are spell textures with the edge the engine would give them
-- (a debuff's; a defensive has none).
type Aura = { spell: number, edge?: string }
type Person = {
    name?: string, class?: string, role?: string, health: number, max?: number, power?: number, incoming?: number,
    absorb?: number, marker?: number, you?: boolean, auras: Aura[], selected?: boolean, aggro?: boolean,
    debuff?: string, removable?: boolean, far?: boolean,
}
local PEOPLE: Person[] = {
    { you = true, health = 0.92, power = 0.7, auras = {} },
    { name = "Brannoc", class = "WARRIOR", role = "TANK", health = 0.64, max = 8800, power = 0.4, incoming = 0.18, absorb = 0.1,
      marker = 8, auras = { { spell = 871 } } },
    { name = "Ysolde", class = "PRIEST", role = "HEALER", health = 0.83, max = 3900, power = 0.14, selected = true,
      debuff = "Magic", removable = true, auras = { { spell = 122, edge = "dispel-magic" } } },
    { name = "Kaelith", class = "MAGE", role = "DAMAGER", health = 0.28, max = 3600, power = 0.55, incoming = 0.12, aggro = true,
      auras = { { spell = 1022 } } },
    { name = "Morrow", class = "ROGUE", role = "DAMAGER", health = 0.76, max = 4600, power = 0.8, far = true,
      debuff = "Poison", removable = false, auras = { { spell = 2818, edge = "dispel-poison" } } },
}

local function person(unit: string): Person
    local i = tonumber(unit:match("^preview(%d)$"))
    local d = PEOPLE[i or 1] or PEOPLE[1]
    if d.you and not d.name then
        local name = UnitName("player")
        d.name = not secret.isSecret(name) and name or nil
        local _, class = UnitClass("player")
        d.class = not secret.isSecret(class) and class or nil
        d.role = SuuUI.Role()
        local max = UnitHealthMax("player")
        d.max = (not secret.isSecret(max) and max and max > 0) and max or 4200
    end
    return d
end

local STAND_IN = UI.UnitStandIn(function(u: string): StandInPerson return person(u) end)

-- The group preview's "with buffs and debuffs": everyone carries a
-- defensive or two from the Defensives list and a debuff of every type.
local function fullAuras(): Aura[]
    local out: Aura[] = {}
    local list = UI.GroupDefensives().all or {}
    for i = 1, math.min(4, #list) do out[#out + 1] = { spell = list[i] } end
    local debuffs: Aura[] = { { spell = 122, edge = "dispel-magic" }, { spell = 980, edge = "dispel-curse" },
        { spell = 2818, edge = "dispel-poison" }, { spell = 18278, edge = "dispel-disease" } }
    for _, a in ipairs(debuffs) do out[#out + 1] = a end
    return out
end

-- A made-up party on a view: its holder and frames (on the screen: the real
-- frames' place), and everyone's auras when "with buffs and debuffs".
type PreviewSet = { view: Frame, holder: Frame, frames: PreviewPartyFrame[], screen?: boolean, allAuras?: Aura[] }

local function build(self: PartyFramesModule): Frame
    local holder = CreateFrame("Frame", "SuuUIPartyFrames", SuuUI.Root, "SecureHandlerStateTemplate")
    holder:SetSize(1, 1)
    self.holder, self.frames = holder, {}
    for i, unit in ipairs(SLOTS) do
        local f = PartyFrame.new(holder, unit, {
            size = "md", name = "SuuUIParty" .. (i == 1 and "Player" or (i - 1)) .. "Frame",
            youWhenPlayer = false, powerFor = powerFor,
        })
        SuuUI.TagInstance(f, { module = M.id, role = "party" })
        f:BuildAuras()
        self.frames[i] = f
    end
    return holder
end

--------------------------------------------------------------------------------
-- Layout and options (out of combat)
--------------------------------------------------------------------------------

-- The holder's size for `count` frames of w by h, `gap` apart, going
-- "right" (a row) or up or down (a column).
local function holderSize(count: number, dir: string, w: number, h: number, gap: number): (number, number)
    if dir == "right" then return count * w + (count - 1) * gap, h end
    return w, count * h + (count - 1) * gap
end

-- Where the frame in `slot` (0-based) goes in its holder: its point and
-- offsets ("up" grows from the bottom).
local function slotPoint(slot: number, dir: string, w: number, h: number, gap: number): (FramePoint, number, number)
    if dir == "right" then return "TOPLEFT", slot * (w + gap), 0 end
    if dir == "down" then return "TOPLEFT", 0, -slot * (h + gap) end
    return "BOTTOMLEFT", 0, slot * (h + gap)
end

