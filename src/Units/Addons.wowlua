-- Units/Addons.wowlua
-- SuuUI's own AddOns window (plan 3.7, design component AddonsWindow):
-- the character select (this character or all), a search, Enable all and
-- Disable all; a performance strip (memory, the addons' share of the CPU,
-- the busiest addon, how many are on); "Load out of date addons"; every
-- addon as a row (a toggle, its icon in a slot of its own or SuuUI's
-- emblem on SuuUI and its plugins, the title, version, memory, a status chip,
-- "Enables on reload" / "Disables on reload" on what changed), a suite's
-- modules under it, folded or not; a row opens to its notes, author, memory
-- and what it needs. The foot counts the changes: Cancel, and Reload to
-- apply. Every C_AddOns errors.try is free (/suu probe windows, 2026-10-17);
-- the game's AddonList is closed and this one opens instead.
-- A built-in module written against the public API only.

import SuuUI from "/Core/API"
import Module from "/Core/Modules"
import type SuuButton from "/UI/Controls"
import type TextField, Toggle from "/UI/Inputs"
import type ScrollArea, WindowFrame from "/UI/Panel"
import type Select from "/UI/Select"
import type Text from "/UI/Text"
import type Border from "/UI/Draw"
import type Panel from "/UI/Panel"
import known from "wowlua:secret"
import hookScript from "wowlua:hooks"
import every from "wowlua:timer"
import * as errors from "wowlua:errors"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as secure from "wowlua:secure"
import type Overlay from "wowlua:secure"

local UI, T = SuuUI.UI, SuuUI.Tokens
local S = T.space

local DEFAULTS = {}

local M: AddonsModule

local WIDTH, HEIGHT = 820, 640
local LINE_H, MODULE_H = 36, 30
local ICON = 16
local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
local A = C_AddOns
local STATUS: { [string]: string[] } = {
    loaded = { "Loaded", "gilt-text", "gilt-line" },
    lod = { "Load on demand", "ink-muted", "gilt-faint" },
    disabled = { "Disabled", "ink-faint", "gilt-faint" },
    waiting = { "Not loaded", "ink-muted", "gilt-faint" },
    dependency = { "Missing dependency", "ember-text", "ember" },
    outdated = { "Out of date", "ember-text", "ember" },
}

-- "1.2 MB", "340 KB"
local function memory(given: unknown): string?
    local kb = secret.asNumber(given)
    if not kb or kb <= 0 then
        return nil
    end
    if kb >= 1024 then
        return ("%.1f MB"):format(kb / 1024)
    end
    return ("%d KB"):format(math.floor(kb + 0.5))
end

-- A title's leading icon, taken out to show in the row's icon slot (inline,
-- it sits on the text's baseline, not in the middle of the row).
local function splitIcon(text: string): (string, (string | number)?)
    local path, rest = text:match("^%s*|T([^:|]+)[^|]*|t%s*(.*)$")
    if path then
        return rest :: string, tonumber(path) or path
    end
    return text, nil
end

-- a title without its colour codes and icons, for the search
local function bare(text: string?): (string, number)
    return (text or ""):gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", ""):gsub("|T.-|t", ""):gsub("|A.-|a", "")
end

--------------------------------------------------------------------------------
-- Data
--------------------------------------------------------------------------------

-- An addon as the window lists it.
-- (its icon: a texture, or an atlas)
export type AddonIcon = string | number | { atlas: string }
export type Addon = {
    index: number,
    name: string,
    title: string,
    icon?: AddonIcon,
    notes?: string,
    reason: unknown,
    deps: string[],
    parent?: Addon,
    children?: Addon[],
    suuui?: boolean,
    memory?: unknown,
}

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

-- A row's status chip: the word in its ink, framed in its edge.
class StatusChip extends Frame
    readonly border: Border
    readonly text: Text

    constructor(parent: Frame)
        super(nil, parent)
        self:SetHeight(16)
        self.border = UI.Border(self, "gilt-faint")
        self.text = UI.Text(self, "micro", "ink-muted")
        self.text:SetPoint("CENTER", 0, 0)
    end

    function Set(label: string, ink: string, edge: string)
        self.text:SetValue(label)
        self.text:SetColor(ink)
        self.border:SetColor(edge)
        self:SetWidth(UI.MeasureText("micro", label) + 2 * S["space-3"])
    end
end

-- An addon's row: its line (toggle, fold, icon, title, what it is, memory,
-- status) and, open, the details under it.
export class AddonRow extends Frame
    readonly line: Button
    readonly bg: Texture
    -- changed: an arcane edge
    readonly edge: Texture
    readonly rule: Texture
    -- a module's indent: a gilt-faint line where its suite's toggle is
    readonly indent: Texture
    readonly toggle: Toggle
    -- the icon slot, in the middle of the line: the addon's own icon, or
    -- SuuUI's emblem on SuuUI and its plugins; empty keeps the titles in line
    readonly icon: Texture
    readonly fold: Button
    readonly foldGlyph: Texture
    readonly title: Text
    readonly sub: Text
    readonly more: Texture
    readonly chip: StatusChip
    readonly mem: Text
    readonly pending: Text
    -- the open row's details
    readonly detail: Frame
    readonly notes: Text
    readonly facts: Text
    readonly deps: Text
    addon: Addon? = nil

    constructor(parent: Frame, owner: AddonsModule)
        super(nil, parent)
        local line = CreateFrame("Button", nil, self)
        line:SetPoint("TOPLEFT")
        line:SetPoint("TOPRIGHT")
        self.line = line
        self.bg = UI.Fill(line, "surface-raised", "BACKGROUND")
        self.bg:SetAllPoints()
        self.bg:Hide()
        self.edge = UI.Fill(self, "arcane", "ARTWORK")
        self.edge:SetPoint("TOPLEFT")
        self.edge:SetPoint("BOTTOMLEFT")
        self.edge:SetWidth(2)
        self.rule = UI.Fill(self, "gilt-faint", "ARTWORK")
        self.rule:SetPoint("BOTTOMLEFT")
        self.rule:SetPoint("BOTTOMRIGHT")
        self.rule:SetHeight(1)
        self.indent = UI.Fill(line, "gilt-faint", "ARTWORK")
        self.indent:SetPoint("TOPLEFT", S["space-3"] + 10, 0)
        self.indent:SetPoint("BOTTOMLEFT", S["space-3"] + 10, 0)
        self.indent:SetWidth(1)
        self.toggle = UI.Toggle(line, {
            onChange = function(on: boolean)
                owner:SetEnabled(self.addon, on)
            end,
        })
        self.icon = line:CreateTexture(nil, "ARTWORK")
        self.icon:SetSize(ICON, ICON)
        self.fold = CreateFrame("Button", nil, line)
        self.fold:SetSize(18, 18)
        self.foldGlyph = self.fold:CreateTexture(nil, "ARTWORK")
        self.foldGlyph:SetSize(11, 11)
        self.foldGlyph:SetPoint("CENTER")
        UI.Paint(self.foldGlyph, "ink-muted")
        self.fold:SetScript("OnClick", function()
            local name = assert(self.addon).name
            owner.folded[name] = not owner.folded[name]
            owner:Draw()
        end)
        self.title = UI.Text(line, "label", "ink")
        self.title:SetWordWrap(false)
        self.sub = UI.Text(line, "caption", "ink-muted")
        self.more = line:CreateTexture(nil, "ARTWORK")
        self.more:SetSize(12, 12)
        self.more:SetPoint("RIGHT", -S["space-3"], 0)
        UI.Paint(self.more, "ink-muted")
        self.chip = StatusChip.new(line)
        self.chip:SetPoint("RIGHT", self.more, "LEFT", -S["space-4"], 0)
        self.mem = UI.Text(line, "numeric", "ink-muted")
        self.mem:SetPoint("RIGHT", self.chip, "LEFT", -S["space-4"], 0)
        self.pending = UI.Text(line, "micro", "arcane")
        self.pending:SetPoint("RIGHT", self.mem, "LEFT", -S["space-4"], 0)
        self.sub:SetPoint("RIGHT", self.pending, "LEFT", -S["space-4"], 0)
        self.detail = CreateFrame("Frame", nil, self)
        self.detail:SetPoint("TOPLEFT", line, "BOTTOMLEFT")
        self.detail:SetPoint("TOPRIGHT", line, "BOTTOMRIGHT")
        UI.Fill(self.detail, "surface-raised", "BACKGROUND"):SetAllPoints()
        self.notes = UI.Text(self.detail, "body", "ink")
        self.notes:SetWordWrap(true)
        self.notes:SetJustifyH("LEFT")
        self.notes:SetPoint("TOPLEFT", 90, -S["space-3"])
        self.notes:SetPoint("RIGHT", -S["space-5"], 0)
        self.facts = UI.Text(self.detail, "caption", "ink")
        self.deps = UI.Text(self.detail, "caption", "ink")
        self.deps:SetWordWrap(true)
        self.deps:SetJustifyH("LEFT")
        self.deps:SetPoint("RIGHT", -S["space-5"], 0)
        line:SetScript("OnEnter", function()
            self.bg:Show()
        end)
        line:SetScript("OnLeave", function()
            if owner.open ~= assert(self.addon).name then
                self.bg:Hide()
            end
        end)
        line:SetScript("OnClick", function()
            local name = assert(self.addon).name
            owner.open = owner.open ~= name and name or nil
            owner:Draw()
        end)
    end
end

--------------------------------------------------------------------------------
-- Drawing
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- Opening: instead of the game's list
--------------------------------------------------------------------------------

class AddonsModule extends Module<typeof(DEFAULTS)>
    -- every addon, a suite's modules after it
    addons: Addon[] = {}
    apply: SuuButton? = nil
    byName: { [string]: Addon } = {}
    changes: Text? = nil
    close: SuuButton? = nil
    countText: Text? = nil
    cpuText: Text? = nil
    -- suites folded, by name
    folded: { [string]: boolean } = {}
    hooked: boolean? = nil
    list: ScrollArea? = nil
    memText: Text? = nil
    none: Text? = nil
    -- the addon whose row is open, by name
    open: string? = nil
    outdated: Toggle? = nil
    perChar: boolean? = nil
    perf: Frame? = nil
    reloadOver: Overlay? = nil
    rows: AddonRow[] = {}
    saving: boolean? = nil
    search: TextField? = nil
    -- what the window started with: each addon on or off, the version check
    start: { [number]: boolean } = {}
    startCheck: unknown = nil
    topText: Text? = nil
    who: Select<string>? = nil
    window: WindowFrame? = nil

    constructor()
        super({
            id = "addons",
            name = "AddOns",
            description = "SuuUI's AddOns window: search, suites with their modules, status, memory and CPU, and what changes on reload.",
            api = "0.17",
            reloadToToggle = true,
            defaults = DEFAULTS,
        })
    end

    -- the character the toggles are for: this one, or nil for all
    function Character(): string?
        return self.perChar and secret.asString(UnitGUID("player")) or nil
    end

    function Enabled(i: number): boolean
        return (secret.asNumber(errors.try(A.GetAddOnEnableState, i, self:Character())) or 0) > 0
    end

    -- Every addon, its suite's modules after it.
    function Collect(): Addon[]
        local n = secret.asNumber(errors.try(A.GetNumAddOns)) or 0
        local byName: { [string]: Addon }, list: Addon[] = {}, {}
        for i = 1, n do
            local nameR, titleR, notesR, _, reason = errors.try(A.GetAddOnInfo, i)
            local name = secret.asString(nameR)
            if name then
                local deps: string[] = {}
                for _, d in ipairs({ errors.try(A.GetAddOnDependencies, i) }) do
                    if type(d) == "string" then
                        deps[#deps + 1] = d
                    end
                end
                local title = secret.asString(titleR)
                local shownTitle, iconPath = splitIcon(title and title ~= "" and title or name)
                local icon: AddonIcon? = iconPath
                if not icon then
                    local tex = secret.asString(errors.try(A.GetAddOnMetadata, i, "IconTexture"))
                    local atlas = secret.asString(errors.try(A.GetAddOnMetadata, i, "IconAtlas"))
                    if tex and tex ~= "" then
                        icon = tonumber(tex) or tex
                    elseif atlas and atlas ~= "" then
                        icon = { atlas = atlas }
                    end
                end
                local e: Addon = {
                    index = i,
                    name = name,
                    title = shownTitle,
                    icon = icon,
                    notes = secret.asString(notesR),
                    reason = reason,
                    deps = deps,
                }
                byName[name] = e
                list[#list + 1] = e
            end
        end
        -- a module: needs an addon its name starts with
        for _, e in ipairs(list) do
            for _, d in ipairs(e.deps) do
                local p = byName[d]
                if p and p ~= e and e.name:sub(1, #d) == d then
                    e.parent = p
                    local children = p.children or {}
                    p.children = children
                    children[#children + 1] = e
                    break
                end
            end
            e.suuui = e.name == "SuuUI" or tContains(e.deps, "SuuUI")
        end
        local ordered: Addon[] = {}
        local function add(e: Addon)
            ordered[#ordered + 1] = e
            for _, c in ipairs(e.children or {}) do
                add(c)
            end
        end
        for _, e in ipairs(list) do
            if not e.parent then
                add(e)
            end
        end
        self.byName = byName
        return ordered
    end

    function Status(e: Addon): string
        if errors.try(A.IsAddOnLoaded, e.index) then
            return "loaded"
        end
        local _, reason: unknown = errors.try(A.IsAddOnLoadable, e.index, self:Character())
        if reason == "INTERFACE_VERSION" then
            return "outdated"
        end
        if reason == "MISSING" or reason == "DEP_MISSING" or reason == "DEP_DISABLED" or
            reason == "DEP_INTERFACE_VERSION" then
            return self:Enabled(e.index) and "dependency" or "disabled"
        end
        if not self:Enabled(e.index) then
            return "disabled"
        end
        if errors.try(A.IsAddOnLoadOnDemand, e.index) then
            return "lod"
        end
        return "waiting"
    end

    -- What the window started with, to tell what changed.
    function Snapshot()
        local start: { [number]: boolean } = {}
        for _, e in ipairs(self.addons) do
            start[e.index] = self:Enabled(e.index)
        end
        self.start = start
        self.startCheck = errors.try(A.IsAddonVersionCheckEnabled)
    end

    function Changes(): number
        local n = 0
        for _, e in ipairs(self.addons) do
            if self:Enabled(e.index) ~= self.start[e.index] then
                n = n + 1
            end
        end
        if errors.try(A.IsAddonVersionCheckEnabled) ~= self.startCheck then
            n = n + 1
        end
        return n
    end

    function BuildRow(parent: Frame): AddonRow
        return AddonRow.new(parent, self)
    end

    function Build()
        self.folded, self.rows = {}, {}
        local w = UI.WindowFrame(SuuUI.Root, {
            name = "SuuUIAddonsWindow",
            title = "AddOns",
            width = WIDTH,
            height = HEIGHT,
            footer = true,
            onClose = function(win: Panel)
                win:Hide()
            end,
        })
        w:SetPoint("CENTER", UIParent, "CENTER", 0, 30)
        w:Hide()
        w.scroll:Hide()
        -- closed without Reload to apply: nothing changes
        w:HookScript("OnHide", function()
            self:PlaceReload()
            if self.saving then
                return
            end
            errors.try(A.ResetAddOns)
            if self.startCheck ~= nil and errors.try(A.IsAddonVersionCheckEnabled) ~= self.startCheck then
                errors.try(A.SetAddonVersionCheck, self.startCheck)
            end
        end)
        self.window = w
        local body = w.body

        -- the bar: whose addons, search, all on, all off
        local bar = CreateFrame("Frame", nil, body)
        bar:SetPoint("TOPLEFT")
        bar:SetPoint("TOPRIGHT")
        bar:SetHeight(30)
        local who = UI.Select(bar, {
            width = 200,
            value = "me",
            options = {
                { value = "me", label = known(UnitName("player"), "This character") },
                { value = "all", label = "All characters" },
            },
            onChange = function(v: string)
                self.perChar = v == "me"
                self:Draw()
            end,
        })
        self.who = who
        who:SetPoint("LEFT")
        local disable = UI.Button(bar, {
            text = "Disable all",
            onClick = function()
                errors.try(A.DisableAllAddOns, self:Character())
                -- SuuUI stays: the window you're in
                errors.try(A.EnableAddOn, "SuuUI", self:Character())
                self:Draw()
            end,
        })
        disable:SetPoint("RIGHT")
        local enable = UI.Button(bar, {
            text = "Enable all",
            onClick = function()
                errors.try(A.EnableAllAddOns, self:Character())
                self:Draw()
            end,
        })
        enable:SetPoint("RIGHT", disable, "LEFT", -S["space-4"], 0)
        local search = UI.TextField(bar, {
            placeholder = "Search addons",
            onTextChanged = function()
                self:Draw()
            end,
        })
        self.search = search
        search:SetPoint("LEFT", who, "RIGHT", S["space-4"], 0)
        search:SetPoint("RIGHT", enable, "LEFT", -S["space-4"], 0)

        -- the performance strip
        local perf = CreateFrame("Frame", nil, body)
        perf:SetPoint("TOPLEFT", bar, "BOTTOMLEFT", 0, -S["space-4"])
        perf:SetPoint("TOPRIGHT", bar, "BOTTOMRIGHT", 0, -S["space-4"])
        perf:SetHeight(48)
        UI.Fill(perf, "surface-sunk"):SetAllPoints()
        UI.Border(perf, "gilt-faint")
        local x = S["space-5"]
        local function metric(label: string, w2: number): Text
            local l = UI.Text(perf, "caption", "ink-muted")
            l:SetPoint("TOPLEFT", x, -S["space-3"])
            l:SetValue(label)
            local v = UI.Text(perf, "numeric", "ink")
            v:SetFont(T.type.numeric.file, 16, "")
            v:SetPoint("TOPLEFT", l, "BOTTOMLEFT", 0, -1)
            x = x + w2
            return v
        end
        self.memText = metric("Memory", 120)
        self.cpuText = metric("CPU", 120)
        local top = metric("Busiest", 260)
        top:SetStyle("label")
        self.topText = top
        local count = UI.Text(perf, "caption", "ink-muted")
        count:SetPoint("RIGHT", -S["space-5"], 0)
        self.countText = count
        self.perf = perf

        -- load out of date addons
        local sub = CreateFrame("Frame", nil, body)
        sub:SetPoint("TOPLEFT", perf, "BOTTOMLEFT", 0, -S["space-4"])
        sub:SetPoint("TOPRIGHT", perf, "BOTTOMRIGHT", 0, -S["space-4"])
        sub:SetHeight(20)
        local outdated = UI.Toggle(sub, {
            onChange = function(on: boolean)
                errors.try(A.SetAddonVersionCheck, not on)
                self:Draw()
            end,
        })
        self.outdated = outdated
        outdated:SetPoint("LEFT")
        local ol = UI.Text(sub, "label", "ink")
        ol:SetPoint("LEFT", outdated, "RIGHT", S["space-4"], 0)
        ol:SetValue("Load out of date addons")

        -- the list: its own sunk, framed well, apart from the controls above
        local well = CreateFrame("Frame", nil, body)
        well:SetPoint("TOPLEFT", sub, "BOTTOMLEFT", 0, -S["space-5"])
        well:SetPoint("BOTTOMRIGHT")
        UI.Fill(well, "surface-sunk"):SetAllPoints()
        UI.Border(well, "gilt-line")
        local BAR = S["space-3"]
        local list = UI.ScrollArea(well, BAR)
        self.list = list
        list:SetPoint("TOPLEFT", 1, -1)
        list:SetPoint("BOTTOMRIGHT", -(BAR + 4), 1)
        list:HookScript("OnSizeChanged", function(_: Frame, width: number)
            list.child:SetWidth(width)
        end)
        local none = UI.Text(body, "body", "ink-muted")
        self.none = none
        none:SetPoint("TOP", list, "TOP", 0, -S["space-6"])
        none:SetValue("No addons match.")

        -- the foot
        local foot = assert(w.footer)
        local changes = UI.Text(foot, "caption", "ink-muted")
        self.changes = changes
        changes:SetPoint("LEFT")
        local close = UI.Button(foot, {
            text = "Close",
            width = 140,
            onClick = function()
                w:Hide()
            end,
        })
        self.close = close
        close:SetPoint("RIGHT")
        -- the reload itself is a secure button on top (/reload: the game blocks
        -- a reload from addon code, found in game); the click saves first
        local apply = UI.Button(foot, { text = "Reload to apply", icon = "reset", variant = "primary", width = 160 })
        self.apply = apply
        apply:SetPoint("RIGHT")
        local cancel = UI.Button(foot, {
            text = "Cancel",
            onClick = function()
                w:Hide()
            end,
        })
        cancel:SetPoint("RIGHT", apply, "LEFT", -S["space-4"], 0)
    end

    -- The secure /reload button over Reload to apply: there while it shows
    -- (out of combat).
    function PlaceReload()
        if InCombatLockdown() then
            return
        end
        local over, apply = self.reloadOver, assert(self.apply)
        local on = assert(self.window):IsShown() and apply:IsShown()
        if not over then
            if not on then
                return
            end
            -- (hovering it is hovering the button: its tooltip, why it's off)
            over = secure.overlay(apply)
            over.set("type1", "macro")
            over.set("macrotext1", "/reload")
            over.button:SetScript("PreClick", function()
                self.saving = true
                errors.try(A.SaveAddOns)
            end)
            self.reloadOver = over
        end
        if on then
            over.show()
        else
            over.hide()
        end
    end

    function SetEnabled(e: Addon?, on: boolean)
        if not e then
            return
        end
        if on then
            errors.try(A.EnableAddOn, e.index, self:Character())
        else
            errors.try(A.DisableAddOn, e.index, self:Character())
        end
        self:Draw()
    end

    function DrawPerf()
        errors.try(UpdateAddOnMemoryUsage)
        local total, enabled = 0, 0
        for _, e in ipairs(self.addons) do
            e.memory = errors.try(GetAddOnMemoryUsage, e.index)
            local kb = secret.asNumber(e.memory)
            if kb then
                total = total + kb
            end
            if self:Enabled(e.index) then
                enabled = enabled + 1
            end
        end
        assert(self.memText):SetValue(memory(total) or "0 KB")
        local P, metric = C_AddOnProfiler, Enum.AddOnProfilerMetric and Enum.AddOnProfilerMetric.RecentAverageTime
        local cpu: number?, top: Addon? = nil, nil
        if P and metric and errors.try(P.IsEnabled) then
            local app, overall = secret.asNumber(errors.try(P.GetApplicationMetric, metric)),
                secret.asNumber(errors.try(P.GetOverallMetric, metric))
            if app and overall and app > 0 then
                cpu = overall / app * 100
            end
            local best = 0
            for _, e in ipairs(self.addons) do
                local v = secret.asNumber(errors.try(P.GetAddOnMetric, e.name, metric))
                if v and v > best then
                    best, top = v, e
                end
            end
        end
        assert(self.cpuText):SetValue(cpu and ("%.1f%%"):format(cpu) or "—")
        assert(self.topText):SetValue(top and top.title or "—")
        assert(self.countText):SetValue(("%d addons · %d enabled"):format(#self.addons, enabled))
    end

    function Draw()
        local w = self.window
        if not (w and w:IsShown()) then
            return
        end
        -- (built with the window)
        local list, none, changes, apply, close = assert(self.list),
            assert(self.none),
            assert(self.changes),
            assert(self.apply),
            assert(self.close)
        assert(self.outdated):SetValue(not errors.try(A.IsAddonVersionCheckEnabled))
        local query = strtrim(assert(self.search):GetValue() or ""):lower()
        -- what shows: matches (and their suites); a folded suite hides its modules
        local shown: { [Addon]: boolean } = {}
        for _, e in ipairs(self.addons) do
            local match = query == "" or e.name:lower():find(query, 1, true) or
                bare(e.title):lower():find(query, 1, true)
            if match then
                shown[e] = true
                if e.parent then
                    shown[e.parent] = true
                end
            end
        end
        local c = list.child
        local y, used = 0, 0
        for _, e in ipairs(self.addons) do
            local parent = e.parent
            local visible = shown[e] and not (query == "" and parent and self.folded[parent.name])
            if visible then
                used = used + 1
                local r = self.rows[used] or self:BuildRow(c)
                self.rows[used] = r
                r.addon = e
                self:DrawRow(r, e)
                r:ClearAllPoints()
                r:SetPoint("TOPLEFT", 0, -y)
                r:SetPoint("RIGHT")
                r:Show()
                y = y + r:GetHeight()
            end
        end
        for i = used + 1, #self.rows do
            self.rows[i]:Hide()
        end
        c:SetHeight(math.max(1, y))
        none:SetShown(used == 0)
        -- the foot
        local n = self:Changes()
        changes:SetValue(
            n > 0 and (("%d %s · they apply after a reload"):format(n, n == 1 and "change" or "changes")) or
                "Changes apply after a reload"
        )
        changes:SetColor(n > 0 and "arcane" or "ink-muted")
        apply:SetShown(n > 0)
        close:SetShown(n == 0)
        self:PlaceReload()
        -- no secure button on it (it showed in combat): wait for the fight's end
        local over = self.reloadOver
        local ready = over and over.button:IsShown()
        apply:SetEnabledState(ready and true or false)
        apply.tooltip = not ready and { title = "Reload to apply", description = "After the fight." } or nil
    end

    function DrawRow(r: AddonRow, e: Addon)
        local module = e.parent ~= nil
        local h = module and MODULE_H or LINE_H
        r.line:SetHeight(h)
        local enabled = self:Enabled(e.index)
        local changed = enabled ~= self.start[e.index]
        r.edge:SetShown(changed)
        r.indent:SetShown(module)
        r.toggle:ClearAllPoints()
        r.toggle:SetPoint("LEFT", module and (S["space-3"] + 32) or S["space-3"], 0)
        r.toggle:SetValue(enabled)
        local children = e.children
        local suite = children and #children > 0
        r.fold:SetShown(suite and true or false)
        r.fold:ClearAllPoints()
        r.fold:SetPoint("LEFT", r.toggle, "RIGHT", S["space-2"], 0)
        r.foldGlyph:SetTexture(GLYPHS .. (self.folded[e.name] and "chevronRight" or "chevronDown"))
        r.icon:ClearAllPoints()
        r.icon:SetPoint("LEFT", r.fold, "RIGHT", S["space-2"], 0)
        r.icon:SetTexCoord(0, 1, 0, 1)
        r.icon:SetVertexColor(1, 1, 1)
        local icon = e.icon
        if type(icon) == "table" then
            r.icon:SetAtlas(icon.atlas)
        elseif icon then
            r.icon:SetTexture(icon)
            -- the game's item icons: without their border
            if type(icon) == "string" and icon:lower():find("^interface\\icons\\") then
                r.icon:SetTexCoord(0.08, 0.92, 0.08, 0.92)
            end
        elseif e.suuui then
            r.icon:SetTexture(GLYPHS .. "markDiamond")
            UI.Paint(r.icon, "gilt-text")
        end
        r.icon:SetShown(icon ~= nil or e.suuui == true)
        r.title:ClearAllPoints()
        r.title:SetPoint("LEFT", r.icon, "RIGHT", S["space-4"], 0)
        r.title:SetValue(e.title)
        local version = secret.asString(errors.try(A.GetAddOnMetadata, e.index, "Version"))
        local subText: string[] = {}
        if suite and children then
            subText[#subText + 1] = #children .. " modules"
        end
        if version and version ~= "" then
            subText[#subText + 1] = version
        end
        r.sub:SetValue(table.concat(subText, " · "))
        local open = self.open == e.name
        r.more:SetTexture(GLYPHS .. (open and "chevronDown" or "chevronRight"))
        local status = assert(STATUS[self:Status(e)])
        r.chip:Set(assert(status[1]), assert(status[2]), assert(status[3]))
        r.mem:SetValue(not open and memory(e.memory) or "")
        r.pending:SetValue(changed and (enabled and "Enables on reload" or "Disables on reload") or "")
        -- the title gives way to what's on the right
        r.title:SetPoint("RIGHT", r.sub, "LEFT", -S["space-5"], 0)
        r.bg:SetShown(open)
        -- details
        if open then
            r.notes:SetValue(e.notes or "No notes.")
            local facts: string[] = {}
            local author = secret.asString(errors.try(A.GetAddOnMetadata, e.index, "Author"))
            if author and author ~= "" then
                facts[#facts + 1] = "|cff" .. T.color["ink-muted"].hex .. "By|r " .. author
            end
            local mem = memory(e.memory)
            if mem then
                facts[#facts + 1] = "|cff" .. T.color["ink-muted"].hex .. "Memory|r " .. mem
            end
            r.facts:ClearAllPoints()
            r.facts:SetPoint("TOPLEFT", r.notes, "BOTTOMLEFT", 0, -S["space-3"])
            r.facts:SetValue(table.concat(facts, "      "))
            local deps: string[] = {}
            for _, d in ipairs(e.deps) do
                local exists = errors.try(A.DoesAddOnExist, d)
                deps[#deps + 1] = exists == false and ("|cff" .. T.color["ember-text"].hex .. d .. " · missing|r") or d
            end
            r.deps:ClearAllPoints()
            r.deps:SetPoint("TOPLEFT", r.facts, "BOTTOMLEFT", 0, -S["space-3"])
            r.deps:SetValue(
                #deps > 0 and ("|cff" .. T.color["ink-muted"].hex .. "Needs|r  " .. table.concat(deps, ", ")) or ""
            )
            local dh = S["space-3"] + r.notes:GetStringHeight() + S["space-3"] + T.type.caption.lineHeight +
                (#deps > 0 and (S["space-3"] + r.deps:GetStringHeight()) or 0) +
                S["space-4"]
            r.detail:SetHeight(dh)
            r.detail:Show()
            r:SetHeight(h + dh + 1)
        else
            r.detail:Hide()
            r:SetHeight(h + 1)
        end
    end

    function Open()
        self.addons = self:Collect()
        if self.perChar == nil then
            self.perChar = true
        end
        assert(self.who):SetValue(self.perChar and "me" or "all")
        self.saving = false
        self:Snapshot()
        assert(self.window):Show()
        self:DrawPerf()
        self:Draw()
    end

    -- The window, while it's open.
    function Shown(): boolean
        local w = self.window
        return w ~= nil and w:IsShown()
    end

    override function OnEnable()
        if not self.window then
            self:Build()
        end
        local list = frames.find("AddonList")
        if list and not self.hooked then
            self.hooked = true
            hookScript(list, "OnShow", function()
                if not self:IsEnabled() then
                    return
                end
                HideUIPanel(list)
                self:Open()
            end)
        end
        -- the secure reload button is placed out of combat only
        for _, e in ipairs({ "PLAYER_REGEN_DISABLED", "PLAYER_REGEN_ENABLED" }) do
            self:OnGameEvent(e, function()
                if self:Shown() then
                    self:Draw()
                end
            end)
        end
        -- the memory and CPU while it shows, every 15 seconds (the memory count is dear)
        every(15, function()
            if self:Shown() then
                self:DrawPerf()
                self:Draw()
            end
        end)
        -- the theme: the 16px numbers' face (set apart from their style) and
        -- the details' colour codes
        self:On("SUUUI_THEME_CHANGED", function()
            for _, v in ipairs({ assert(self.memText), assert(self.cpuText) }) do
                v:SetFont(T.type.numeric.file, 16, "")
            end
            if self:Shown() then
                self:DrawPerf()
                self:Draw()
            end
        end)
    end

    override function OnDisable()
        local w = self.window
        if w then
            w:Hide()
        end
    end
end

M = SuuUI.AddModule(AddonsModule.new())
