## Interface: 20504
## Title: SuuUI
## Notes: Modular UI replacement framework
## Version: 0.1.0
## Author: Suu
## SavedVariables: SuuUIProfiles, SuuUIItemCache
## SavedVariablesPerCharacter: SuuUIConfig

# Embedded third-party libraries. The ONLY external code in this addon, and the exception
# to "everything is built from scratch": a minimap button has to be findable by the button
# collectors and LDB displays the player already runs, and that interop IS the library.
# LibStub version-arbitrates, so a player carrying a newer copy makes ours a no-op.
# Load first — Core/Fonts.lua already probes LibStub, and LibDBIcon errors without its deps.
Libs/LibStub/LibStub.lua
Libs/CallbackHandler-1.0/CallbackHandler-1.0.lua
Libs/LibDataBroker-1.1/LibDataBroker-1.1.lua
Libs/LibDBIcon-1.0/LibDBIcon-1.0.lua

# Core (load order matters — no cross-requires)
Core/Init.lua
Core/Game.lua
Core/EventBus.lua
Core/UISignals.lua
Core/Pool.lua
Core/Profile.lua
Core/Settings.lua
Core/Fonts.lua
Core/Theme.lua
Core/Pixel.lua
Core/Plugin.lua
Core/AttachPoints.lua
Core/DataBar.lua
Core/ReloadGuard.lua
Core/ToggleUI.lua
Core/KeybindMode.lua
Core/MoveableFrame.lua
Core/SnapGrid.lua
Core/EditPanel.lua
Core/KeybindPanel.lua
Core/UIRoot.lua
Core/Dock.lua
Core/Readout.lua
Core/Icons.lua
Core/ItemCache.lua

# Themes (must load before Theme:Init runs, i.e. before ADDON_LOADED fires — all files load first)
