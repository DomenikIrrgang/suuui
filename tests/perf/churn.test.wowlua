-- Perf scenario: a long session's churn, the leak check. Over 10,000
-- players come into nameplate range and leave it again (twelve a frame for
-- 900 frames, each a new unit with its own GUID and name, a buff with it),
-- as at launch where new players load in and out all the time. The memory
-- after a full collection before, midway and after: what SuuUI keeps per
-- player it has seen (tables keyed by GUID, name or unit, caches, closures,
-- hooks) shows as memory growing from one record to the next. Then the
-- player runs on in a normal crowd: the garbage and work per frame after a
-- long session.

import test, config from "wowlua:test"
import features from "wowlua:meta"
import * as mock from "wowlua:mock"
import * as perf from "./util"
import * as world from "./world"

config({ profile = "perf" })

const PER_FRAME = 12
local crowd = world.Crowd.new({ seed = 51, prefix = "Churn", hostile = 10, creatures = 10 })

local function seen(frames: number, from: number)
    perf.run(frames, function(n: number)
        crowd:Tick(from + n)
        for _ = 1, PER_FRAME do
            crowd:Arrive()
        end
        while #crowd.people > 40 do
            crowd:LeaveOldest()
        end
    end)
end

@if(features.perf)
@test("setup: login, a first crowd")
local function setup()
    mock.moveTo({ mapID = 1429, zone = "Elwynn Forest", subZone = "Northshire Valley", x = 0.4, y = 0.5 })
    perf.settle(perf.AFTER_LOGIN)
    seen(20, 0)
    perf.settle(30)
    perf.record("memory before the churn", { kb = perf.memoryKB() })
    perf.record("addon memory before the churn", { kb = world.addonKB() })
end

@if(features.perf)
@test("setup: 3,600 players seen")
local function first()
    seen(300, 100)
    perf.settle(30)
    perf.record("memory after 3600 players", { kb = perf.memoryKB() })
    perf.record("addon memory after 3600 players", { kb = world.addonKB() })
end

@if(features.perf)
@test("setup: 10,800 players seen")
local function second()
    seen(600, 500)
    perf.settle(30)
    perf.record("memory after 10800 players", { kb = perf.memoryKB() })
    perf.record("addon memory after 10800 players", { kb = world.addonKB() })
end

@if(features.perf)
@test("running on after 10,800 players")
local function running()
    perf.run(480, function(n: number)
        crowd:Tick(1200 + n)
        mock.moveTo({ mapID = 1429, zone = "Elwynn Forest", x = 0.4 + n * 0.0000334, y = 0.5 })
        if n % 3 == 0 then
            crowd:Arrive()
            crowd:LeaveOldest()
        end
        if n % 4 == 0 then
            crowd:Cast()
        end
        if n % 20 == 10 then
            crowd:Hover()
        end
    end)
end
