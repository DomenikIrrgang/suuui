-- Perf scenario: idle out of combat, the baseline. After the login's
-- warm-ups (the nameplate pool, the windows built a frame later), ten
-- seconds with nothing happening: what SuuUI costs every frame on its own.

import test, config from "wowlua:test"
import features from "wowlua:meta"
import * as perf from "./util"

config({ profile = "perf" })

@if(features.perf)
@test("setup: login, warm-up")
local function setup()
    perf.record("memory after login", { kb = perf.memoryKB() })
    perf.settle(60)
    perf.record("memory after warm-up", { kb = perf.memoryKB() })
end

@if(features.perf)
@test("idle")
local function idle()
    perf.settle(480)
end

@if(features.perf)
@test("setup: memory after idle")
local function memoryAfter()
    perf.record("memory after idle", { kb = perf.memoryKB() })
end
