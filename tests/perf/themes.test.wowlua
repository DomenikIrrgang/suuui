-- Perf scenario: the themes. SuuUI's own look, then themes with art on the
-- frames (Pink Cat; Stranglethorn Ruins and Canopy): each picked (one frame:
-- every frame repainted, the dress put on, then 9 more), then a moment (70
-- frames: the profile keeps 600) with a target and the character window open
-- (the art swaying, the motes drifting, the bars' repeated art following
-- them).

import test, config from "wowlua:test"
import features from "wowlua:meta"
import * as mock from "wowlua:mock"
import * as settings from "/Core/Settings"
import * as themes from "/Core/Themes"
import * as perf from "./util"

config({ profile = "perf" })

local function pick(id: string)
    perf.run(1, function()
        settings.setAccount("theme", id ~= "suuui" and id or nil)
        themes.apply()
    end)
    perf.settle(9)
end

local function shown(id: string)
    perf.settle(70)
    perf.record("memory with " .. id, { kb = perf.memoryKB() })
end

@if(features.perf)
@test("setup: login, a target, the character window")
local function setup()
    perf.settle(90)
    local mob = mock.spawnUnit({ name = "Bloodscalp Hunter", level = 40, reaction = "hostile", distance = 12, health = 62, healthMax = 100 })
    mock.player:target(mob)
    mock.pressBinding("TOGGLECHARACTER0")
    perf.settle(30)
    perf.record("memory after login", { kb = perf.memoryKB() })
end

@if(features.perf)
@test("suuui: picked")
local function pickedSuuui()
    pick("suuui")
end

@if(features.perf)
@test("suuui: shown")
local function shownSuuui()
    shown("suuui")
end

@if(features.perf)
@test("pinkcat: picked")
local function pickedPinkcat()
    pick("pinkcat")
end

@if(features.perf)
@test("pinkcat: shown")
local function shownPinkcat()
    shown("pinkcat")
end

@if(features.perf)
@test("stvruins: picked")
local function pickedStvruins()
    pick("stvruins")
end

@if(features.perf)
@test("stvruins: shown")
local function shownStvruins()
    shown("stvruins")
end

@if(features.perf)
@test("stvcanopy: picked")
local function pickedStvcanopy()
    pick("stvcanopy")
end

@if(features.perf)
@test("stvcanopy: shown")
local function shownStvcanopy()
    shown("stvcanopy")
end

@if(features.perf)
@test("suuui again: picked")
local function pickedSuuuiAgain()
    pick("suuui")
end

@if(features.perf)
@test("suuui again: shown")
local function shownSuuuiAgain()
    shown("suuui again")
end
