-- Every /suu command, typed without arguments (each answers with its usage,
-- a listing or its default action).

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import errorsSoFar from "./helpers"

-- commands whose bare form starts something that runs on (perf's sampler)
-- or reloads; they're typed with a harmless argument instead
const ARGS: { [string]: string } = { perf = "stop" }

@test("every /suu command runs without errors")
local function everyCommand()
    local failed: string[] = {}
    for _, c in ipairs(SuuUI.Commands()) do
        local before = #errorsSoFar()
        mock.slash(("/suu %s %s"):format(c.name, ARGS[c.name] or ""))
        local after = errorsSoFar()
        if #after > before then failed[#failed + 1] = `/suu {c.name}: {after[#after]}` end
    end
    expect(failed).toEqual({})
end

@test("/suu alone opens and closes the settings window")
local function settingsWindow()
    mock.slash("/suu")
    mock.slash("/suu")
    expect(errorsSoFar()).toEqual({})
end
