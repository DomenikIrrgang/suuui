-- Every module turned off and on again, and the edit and keybind modes.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import errorsSoFar from "./helpers"

@test("every module turns off and on without errors")
local function toggleAll()
    local failed: string[] = {}
    for _, m in ipairs(SuuUI.ListModules()) do
        if m.state ~= "enabled" then continue end
        local before = #errorsSoFar()
        mock.slash("/suu disable " .. m.id)
        mock.slash("/suu enable " .. m.id)
        mock.advanceFrames(2)
        local after = errorsSoFar()
        if #after > before then failed[#failed + 1] = `{m.id}: {after[#after]}` end
    end
    expect(failed).toEqual({})
end

@test("edit mode and keybind mode open and close")
local function modes()
    SuuUI.EditMode.Enter()
    mock.advanceFrames(2)
    SuuUI.EditMode.Exit()
    SuuUI.KeybindMode.Enter()
    mock.advanceFrames(2)
    SuuUI.KeybindMode.Exit()
    expect(errorsSoFar()).toEqual({})
end
