-- A small world: a target, a group, a fight with auras and casts, a reload.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import errorsSoFar from "./helpers"

@test("a target, a group and a fight")
local function fight()
    local boar = mock.spawnUnit({ name = "Mottled Boar", level = 3, reaction = "hostile", health = 80 })
    mock.player:target(boar)
    local friend = mock.spawnUnit({ name = "Tamsin Ashford", level = 10, reaction = "friendly", class = "PRIEST", player = true })
    mock.group:add(friend)
    mock.advanceFrames(5)
    mock.player:enterCombat()
    boar:castSpell(6268)
    boar:damage(30)
    friend:applyAura({ spellId = 17, name = "Power Word: Shield", duration = 30 })
    mock.advanceFrames(30)
    boar:kill()
    mock.player:leaveCombat()
    mock.advanceFrames(30)
    expect(errorsSoFar()).toEqual({})
end
