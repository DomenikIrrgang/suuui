-- Blizzard's own windows opened and closed with their key bindings, as a
-- player does (SuuUI restyles or replaces many of them when they show).

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import errorsSoFar from "../helpers"

const BINDINGS: string[] = {
    "TOGGLECHARACTER0",
    "TOGGLECHARACTER2",
    "TOGGLEWORLDMAP",
    "TOGGLESOCIAL",
    "TOGGLEGUILDTAB",
    "TOGGLECOLLECTIONS",
    "TOGGLEQUESTLOG",
    "OPENALLBAGS",
    "TOGGLETALENTS",
    "TOGGLESPELLBOOK",
    "TOGGLEGROUPFINDER",
    "TOGGLEGAMEMENU",
}

@test("Blizzard's windows open and close with their bindings")
local function windows()
    local failed: string[] = {}
    local ran = 0
    for _, b in ipairs(BINDINGS) do
        local before = #errorsSoFar()
        local ok1: boolean, e1: unknown = pcall(mock.pressBinding, b)
        mock.advanceFrames(3)
        local ok2: boolean, e2: unknown = pcall(mock.pressBinding, b)
        mock.advanceFrames(3)
        if ok1 and ok2 then
            ran += 1
        else
            failed[#failed + 1] = `{b}: {tostring(e1 or e2)}`
        end
        local after = errorsSoFar()
        if #after > before then
            failed[#failed + 1] = `{b}: {after[#after]}`
        end
    end
    expect({ failed = failed, ran = ran }).toEqual({ failed = {}, ran = #BINDINGS })
end
