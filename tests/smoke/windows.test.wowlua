-- SuuUI's windows opened and closed through the public API.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import errorsSoFar from "../helpers"

@test("the windows open and close")
local function windows()
    for _ = 1, 2 do
        SuuUI.ToggleBags()
        SuuUI.ToggleTalents()
        SuuUI.ToggleCollections()
        SuuUI.ToggleSettings()
        mock.advanceFrames(2)
    end
    expect(errorsSoFar()).toEqual({})
end

@test("a fight starts and ends")
local function fight()
    mock.player:enterCombat()
    mock.advanceFrames(10)
    mock.player:leaveCombat()
    mock.advanceFrames(10)
    expect(errorsSoFar()).toEqual({})
end
