-- Loading SuuUI into the emulated client with Blizzard's UI and logging in.

import test, expect from "wowlua:test"
import SuuUI from "/Core/API"
import expectNoErrors from "../helpers"

@test("loads and logs in without errors")
local function loads()
    expect(_G.SuuUI).toBe(SuuUI)
    expectNoErrors()
end

@test("every module that is on by default starts")
local function modulesStart()
    local errored: string[] = {}
    for _, m in ipairs(SuuUI.ListModules()) do
        if m.state == "errored" or m.state == "incompatible" then
            errored[#errored + 1] = `{m.id}: {m.state} {m.error or ""}`
        end
    end
    expect(errored).toEqual({})
    expectNoErrors()
end
