-- Every section of the settings window opened in turn, and the edit mode's
-- settings for each mover.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as registry from "/SettingsUI/Registry"
import errorsSoFar from "../helpers"

@test("every settings section opens")
local function sections()
    local failed: string[] = {}
    for _, s in ipairs(registry.list()) do
        local before = #errorsSoFar()
        SuuUI.OpenSettings(s.id)
        mock.advanceFrames(2)
        local after = errorsSoFar()
        if #after > before then
            failed[#failed + 1] = `{s.id}: {after[#after]}`
        end
    end
    SuuUI.ToggleSettings()
    expect(failed).toEqual({})
    expect(#registry.list() > 10).toBe(true)
end
