-- Units/Bags' sort plan with two special bags (a regression: bag IDs 1-4
-- collided with the list slots of the special bags, so bag 1's slots joined
-- bag 2's list and its own item went to the general bags).

import test, expect from "wowlua:test"
import SuuUI from "/Core/API"

const HERBS = 32
const SHARDS = 4

@test("each special bag keeps its own slots")
local function twoSpecialBags()
    local bags: any = assert(SuuUI.GetModule("bags"))
    local slots = {
        { bag = 0, slot = 1, family = 0, item = { id = "cloth", count = 1, classID = 7 } },
        { bag = 0, slot = 2, family = 0 },
        { bag = 2, slot = 1, family = HERBS, item = { id = "shard", count = 1, classID = 7, family = SHARDS } },
        { bag = 1, slot = 1, family = SHARDS, item = { id = "herb", count = 1, classID = 7, family = HERBS } },
    }
    local target = assert(bags:SortTarget(slots, "type", false))
    expect(target[3] and target[3].id).toBe("herb")
    expect(target[4] and target[4].id).toBe("shard")
    expect(target[1] and target[1].id).toBe("cloth")
end
