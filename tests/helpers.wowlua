-- tests/helpers.wowlua
-- Shared by every test file.
--
--   errorsSoFar()     every error so far: what reached the game's error
--                     handler (mock.errors) and what SuuUI's Fault caught
--                     and logged (it keeps module errors away from the
--                     handler)
--   expectNoErrors()  none of either
--   newParent()       a fresh, shown frame on UIParent to build a component in

import expect from "wowlua:test"
import * as mock from "wowlua:mock"
import * as fault from "/Core/Fault"

export function errorsSoFar(): string[]
    local out: string[] = {}
    for _, e in ipairs(mock.errors()) do out[#out + 1] = tostring(e) end
    for _, e in ipairs(fault.entries()) do
        out[#out + 1] = `{e.source}: {e.message}` .. (e.stack and ("\n" .. e.stack) or "")
    end
    return out
end

export function expectNoErrors()
    expect(errorsSoFar()).toEqual({})
end

export function newParent(width: number = 400, height: number = 300): Frame
    local f = CreateFrame("Frame", nil, UIParent)
    f:SetSize(width, height)
    f:SetPoint("CENTER")
    f:Show()
    return f
end
