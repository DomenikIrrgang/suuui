-- tests/helpers.wowlua
-- Shared by every test file.
--
--   errorsSoFar()     every error so far: what reached the game's error
--                     handler (mock.errors) and what SuuUI's Fault caught
--                     and logged (it keeps module errors away from the
--                     handler)
--   expectNoErrors()  none of either
--   newParent()       a fresh, shown frame on UIParent to build a component in
--   captureMenus()    SuuUI's context menus caught: their buttons by label
--   choose(menu, l)   runs the caught button with that label
--   captureConfirm()  UI.Confirm caught: its options, last one first
--   expectPingable(f, unit)  a ping over f pings that unit, as over the
--                     game's unit frames (PingableUnitFrameTemplate)
--   useTheme(id)      the theme `id` applied, as when the player picks it
--                     (nil: SuuUI's again)
--   layoutThemes()    COMPACT and ROOMY registered (once): themes with
--                     tighter spacing and smaller sizes, and the other way
--   recordGradients(t)  each SetGradient on t from now on: its colours
--   expectRGB(c, r, g, b[, within])  a colour's r, g, b within 1/255 (8 bits
--                     a channel), or within `within` 255ths

import expect from "wowlua:test"
import type RowDef from "/SettingsUI/Registry"
import * as mock from "wowlua:mock"
import * as fault from "/Core/Fault"
import SuuUI from "/Core/API"
import type MenuDescription from "/UI/ContextMenu"
import type ConfirmOptions from "/UI/Panel"
import * as themes from "/Core/Themes"
import * as settings from "/Core/Settings"

export function errorsSoFar(): string[]
    local out: string[] = {}
    for _, e in ipairs(mock.errors()) do
        out[#out + 1] = tostring(e)
    end
    for _, e in ipairs(fault.entries()) do
        out[#out + 1] = `{e.source}: {e.message}` ..
            (e.stack and ("\n" .. e.stack) or "")
    end
    return out
end

export function expectNoErrors()
    expect(errorsSoFar()).toEqual({})
end

export function newParent(width: number = 400, height: number = 300): Frame
    local f = CreateFrame("Frame", nil, UIParent)
    f:SetSize(width, height)
    f:SetPoint("CENTER")
    f:Show()
    return f
end

-- What a context menu offered: its buttons by label (cleared at each menu;
-- a button turned off with SetEnabled(false) is left out).
export function captureMenus(): { [string]: () -> () }
    local menu: { [string]: () -> () } = {}
    mock.stub(SuuUI.UI, "ContextMenuFrom", function<O>(owner: O, describe: (owner: O, root: MenuDescription) -> ())
        for k in pairs(menu) do
            menu[k] = nil
        end
        local root = {
            CreateTitle = function(_: unknown, _: string) end,
            CreateDivider = function(_: unknown) end,
            CreateButton = function(_: unknown, label: string, fn: () -> ()): {
                SetEnabled: (self: unknown, on: boolean) -> (),
            }
                menu[label] = fn
                return {
                    SetEnabled = function(_: unknown, on: boolean)
                        if not on then
                            menu[label] = nil
                        end
                    end,
                }
            end,
        }
        describe(owner, root :: unknown :: MenuDescription)
    end)
    return menu
end

-- Runs the menu button with this label (it must be there).
export function choose(menu: { [string]: () -> () }, label: string)
    local fn = menu[label]
    assert(fn, "no menu button " .. label)
    fn()
end

-- UI.Confirm's options as asked (the dialog never shows): `last()` the latest.
export type Confirms = { last: () -> ConfirmOptions }
export function captureConfirm(): Confirms
    local asked: ConfirmOptions[] = {}
    mock.stub(SuuUI.UI, "Confirm", function(opts: ConfirmOptions): nil
        asked[#asked + 1] = opts
        return nil
    end)
    return {
        last = function(): ConfirmOptions
            return (assert(asked[#asked], "no confirm asked"))
        end,
    }
end

-- A settings row as a test uses it: its callbacks typed as there (a test of
-- a row without one fails where it calls it).
export type TestRow = {
    key?: string,
    label?: string,
    build: (parent: Frame, onChange: (value: unknown) -> (), def: RowDef) -> Frame,
    onClick: () -> (),
    disabled: () -> (boolean?, string?),
    description: () -> string,
    get: () -> unknown,
    set: (value: unknown) -> (boolean?, string?),
    isDefault: () -> boolean,
    reset: () -> (),
    format: (v: number) -> string,
}
export function testRow(row: RowDef): TestRow
    return row :: unknown :: TestRow
end

-- A ping over the frame pings the unit (PingableUnitFrameTemplate, as the
-- game's unit frames): the frame is a ping receiver and names the unit's GUID.
export function expectPingable(f: Frame, unit: string)
    expect(f:GetAttribute("ping-receiver")).toBe(true)
    local info = ((f :: unknown) :: PingableType_UnitFrameMixin):GetTargetInfo() :: unknown :: { guid: unknown }
    expect(info.guid).toBe(UnitGUID(unit))
    expect(info.guid).never.toBeNil()
end

export function useTheme(id: string?)
    settings.setAccount("theme", id)
    themes.apply()
end

-- A denser UI and a roomier one: every spacing token, and the sizes the
-- covered areas lay out by.
export const COMPACT = "test-compact"
export const ROOMY = "test-roomy"
export function layoutThemes()
    if themes.get(COMPACT) then
        return
    end
    themes.register({
        id = COMPACT,
        name = "Compact",
        space = {
            ["space-1"] = 1,
            ["space-2"] = 2,
            ["space-3"] = 4,
            ["space-4"] = 5,
            ["space-5"] = 8,
            ["space-6"] = 14,
            ["space-7"] = 18,
        },
        sizes = {
            ["icon-sm"] = 14,
            ["icon-md"] = 20,
            ["icon-lg"] = 26,
            ["slot"] = 30,
            ["menu-button"] = 24,
            ["unit-lg"] = 28,
            ["unit-md"] = 24,
            ["unit-sm"] = 20,
            ["bar-lg"] = 260,
            ["bar-md"] = 180,
            ["bar-tot"] = 120,
            ["minimap"] = 150,
            ["notice-w"] = 270,
            ["settings-nav"] = 170,
        },
    })
    themes.register({
        id = ROOMY,
        name = "Roomy",
        space = {
            ["space-1"] = 3,
            ["space-2"] = 6,
            ["space-3"] = 9,
            ["space-4"] = 12,
            ["space-5"] = 18,
            ["space-6"] = 28,
            ["space-7"] = 40,
        },
        sizes = {
            ["icon-sm"] = 18,
            ["icon-md"] = 28,
            ["icon-lg"] = 36,
            ["slot"] = 42,
            ["menu-button"] = 32,
            ["unit-lg"] = 38,
            ["unit-md"] = 32,
            ["unit-sm"] = 28,
            ["bar-lg"] = 330,
            ["bar-md"] = 220,
            ["bar-tot"] = 160,
            ["minimap"] = 200,
            ["notice-w"] = 340,
            ["settings-nav"] = 230,
        },
    })
end

export type GradientCall = { from: number[], to: number[] }

export function recordGradients(t: Texture): GradientCall[]
    local calls: GradientCall[] = {}
    hooksecurefunc(t, "SetGradient", function(_: Texture, _o: string, from: ColorMixin, to: ColorMixin)
        local r1, g1, b1, a1 = from:GetRGBA()
        local r2, g2, b2, a2 = to:GetRGBA()
        calls[#calls + 1] = { from = { r1, g1, b1, a1 or 1 }, to = { r2, g2, b2, a2 or 1 } }
    end)
    return calls
end

export function expectRGB(c: number[], r: number, g: number, b: number, within: number?)
    local d = (within or 1.01) / 255
    if math.abs(c[1] - r) > d or math.abs(c[2] - g) > d or math.abs(c[3] - b) > d then
        -- (fails, showing both)
        expect({ c[1], c[2], c[3] }).toEqual({ r, g, b })
    end
end
