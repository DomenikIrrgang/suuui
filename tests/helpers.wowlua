-- tests/helpers.wowlua
-- Shared by every test file.
--
--   errorsSoFar()     every error so far: what reached the game's error
--                     handler (mock.errors) and what SuuUI's Fault caught
--                     and logged (it keeps module errors away from the
--                     handler)
--   expectNoErrors()  none of either
--   newParent()       a fresh, shown frame on UIParent to build a component in
--   captureMenus()    SuuUI's context menus caught: their buttons by label
--   choose(menu, l)   runs the caught button with that label
--   captureConfirm()  UI.Confirm caught: its options, last one first

import expect from "wowlua:test"
import * as mock from "wowlua:mock"
import * as fault from "/Core/Fault"
import SuuUI from "/Core/API"
import type MenuDescription from "/UI/ContextMenu"
import type ConfirmOptions from "/UI/Panel"

export function errorsSoFar(): string[]
    local out: string[] = {}
    for _, e in ipairs(mock.errors()) do out[#out + 1] = tostring(e) end
    for _, e in ipairs(fault.entries()) do
        out[#out + 1] = `{e.source}: {e.message}` .. (e.stack and ("\n" .. e.stack) or "")
    end
    return out
end

export function expectNoErrors()
    expect(errorsSoFar()).toEqual({})
end

export function newParent(width: number = 400, height: number = 300): Frame
    local f = CreateFrame("Frame", nil, UIParent)
    f:SetSize(width, height)
    f:SetPoint("CENTER")
    f:Show()
    return f
end

-- What a context menu offered: its buttons by label (cleared at each menu).
export function captureMenus(): { [string]: () -> () }
    local menu: { [string]: () -> () } = {}
    mock.stub(SuuUI.UI, "ContextMenuFrom", function<O>(owner: O, describe: (owner: O, root: MenuDescription) -> ())
        for k in pairs(menu) do menu[k] = nil end
        local root = {
            CreateTitle = function(_: unknown, _: string) end,
            CreateDivider = function(_: unknown) end,
            CreateButton = function(_: unknown, label: string, fn: () -> ()) menu[label] = fn end,
        }
        describe(owner, root :: unknown :: MenuDescription)
    end)
    return menu
end

-- Runs the menu button with this label (it must be there).
export function choose(menu: { [string]: () -> () }, label: string)
    local fn = menu[label]
    assert(fn, "no menu button " .. label)
    fn()
end

-- UI.Confirm's options as asked (the dialog never shows): `last()` the latest.
export type Confirms = { last: () -> ConfirmOptions }
export function captureConfirm(): Confirms
    local asked: ConfirmOptions[] = {}
    mock.stub(SuuUI.UI, "Confirm", function(opts: ConfirmOptions): nil asked[#asked + 1] = opts; return nil end)
    return { last = function(): ConfirmOptions return (assert(asked[#asked], "no confirm asked")) end }
end
