-- The Collections window first opened in a fight (never opened before it):
-- SuuUI's look on it, nothing refused. Its own file: no earlier test may
-- open it first.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import expectNoErrors from "../../helpers"
import internal M from "/Units/Collections"



@test("first opened in a fight: SuuUI's look, nothing refused")
local function firstInCombat()
    mock.advanceTime(2)
    mock.pressKey("ESCAPE") -- (SuuUI's welcome, as at a first login, gone)
    mock.advanceFrames(2)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    -- (its key, as the player presses it: SuuUI may take it over)
    local key = GetBindingKey("TOGGLECOLLECTIONS")
    if key then mock.pressKey(key) else mock.pressBinding("TOGGLECOLLECTIONS") end
    mock.advanceFrames(3)
    -- (SuuUI's own Collections window takes the key)
    local f = M.window
    expect(f ~= nil and f:IsShown()).toBe(true)
    expect(#mock.refusals()).toBe(0)
    -- closed in the fight: the key again, Escape, its close button
    mock.pressKey(key :: string)
    mock.advanceFrames(2)
    expect(f:IsShown()).toBe(false)
    mock.pressKey(key :: string)
    mock.advanceFrames(2)
    mock.pressKey("ESCAPE")
    mock.advanceFrames(2)
    expect(f:IsShown()).toBe(false)
    mock.pressKey(key :: string)
    mock.advanceFrames(2)
    -- (the secure button over its close button takes the click)
    mock.click(M.closeOverlay)
    mock.advanceFrames(2)
    expect(f:IsShown()).toBe(false)
    expect(#mock.refusals()).toBe(0)
    mock.player:leaveCombat()
    expectNoErrors()
end
