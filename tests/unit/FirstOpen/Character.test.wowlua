-- The Character window first opened in a fight (never opened before it):
-- SuuUI's look on it, nothing refused. Its own file: no earlier test may
-- open it first.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import expectNoErrors from "../../helpers"

local G: any = _G

@test("first opened in a fight: SuuUI's look, nothing refused")
local function firstInCombat()
    mock.advanceTime(2)
    mock.pressKey("ESCAPE") -- (SuuUI's welcome, as at a first login, gone)
    mock.advanceFrames(2)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    -- (its key, as the player presses it: SuuUI may take it over)
    local key = GetBindingKey("TOGGLECHARACTER0")
    if key then mock.pressKey(key) else mock.pressBinding("TOGGLECHARACTER0") end
    mock.advanceFrames(3)
    local f = G.CharacterFrame
    expect(f ~= nil and f:IsShown()).toBe(true)
    expect(f.suuChrome ~= nil).toBe(true)
    expect(#mock.refusals()).toBe(0)
    mock.player:leaveCombat()
    expectNoErrors()
end
