-- SuuUI's Talents window first opened in a fight (never opened before it),
-- and closed in it again: nothing refused. Its own file: no earlier test
-- may open it first.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import expectNoErrors from "../../helpers"
import * as frames from "wowlua:frames"

@test("first opened in a fight, then closed in it: nothing refused")
local function firstInCombat()
    mock.advanceTime(2)
    mock.pressKey("ESCAPE") -- (SuuUI's welcome, as at a first login, gone)
    mock.advanceFrames(2)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    local key = GetBindingKey("TOGGLETALENTS") :: string
    mock.pressKey(key)
    mock.advanceFrames(3)
    local f = assert(frames.find("SuuUITalents"))
    expect(f:IsShown()).toBe(true)
    mock.pressKey(key)
    mock.advanceFrames(2)
    expect(f:IsShown()).toBe(false)
    mock.pressKey(key)
    mock.advanceFrames(2)
    mock.pressKey("ESCAPE")
    mock.advanceFrames(2)
    expect(f:IsShown()).toBe(false)
    expect(#mock.refusals()).toBe(0)
    mock.player:leaveCombat()
    expectNoErrors()
end
