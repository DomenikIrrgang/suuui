-- UI/Text: a design text's style and colour, values (readable and secret),
-- the shadow, fixed widths, visibility, what it tells its layout, flag(),
-- measureText() and the theme change.

import test, expect, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import * as fonts from "/Core/Fonts"
import text, flag, measureText, Text from "/UI/Text"
import expectNoErrors, newParent from "../../helpers"
import tokenOf, themeChanged from "./PrimitivesHelpers"

local parent: Frame? = nil

local function make(style: string?, color: string?): Text
    parent = newParent()
    return text(parent :: Frame, style, color)
end

-- a stand-in layout that counts what it is told
type FakeLayout = { Invalidate: () -> () }
local function watched(t: Text): () -> ()
    local s = mock.spy()
    local fake: FakeLayout = { Invalidate = s }
    t.layout = fake
    return s
end

@afterEach
local function cleanup()
    if parent then parent:Hide() end
    parent = nil
    expectNoErrors()
end

@test("a new text is body in ink, one line, on the overlay layer")
local function defaults()
    local t = make()
    expect(t.style).toBe("body")
    expect(t:GetFontObject()).toBe(fonts.get("body"))
    expect(tokenOf(t)).toBe("ink")
    expect(t:CanWordWrap()).toBe(false)
    expect(t:GetDrawLayer()).toBe("OVERLAY")
    expect(t:GetParent()).toBe(parent)
end

@test("a text's style, colour and layer as asked")
local function options()
    parent = newParent()
    local t = text(parent :: Frame, "caption", "ink-muted", "ARTWORK")
    expect(t.style).toBe("caption")
    expect(t:GetFontObject()).toBe(fonts.get("caption"))
    expect(tokenOf(t)).toBe("ink-muted")
    expect(t:GetDrawLayer()).toBe("ARTWORK")
end

@test("SetStyle sets the font and tells the layout")
local function setStyle()
    local t = make()
    local s = watched(t)
    t:SetStyle("header")
    expect(t.style).toBe("header")
    expect(t:GetFontObject()).toBe(fonts.get("header"))
    expect(s).toHaveBeenCalledTimes(1)
end

@test("SetColor keeps a token, or sets raw r, g, b, a")
local function setColor()
    local t = make()
    t:SetColor("arcane", 0.5)
    expect(tokenOf(t)).toBe("arcane")
    t:SetColor(1, 0, 0, 1)
    expect(tokenOf(t)).toBeNil()
    local r, g, b, a = t:GetTextColor()
    expect({ r, g, b, a }).toEqual({ 1, 0, 0, 1 })
end

@test("SetValue sets the text and tells the layout only when it changes")
local function setValue()
    local t = make()
    local s = watched(t)
    t:SetValue("Hello")
    expect(t).toHaveText("Hello")
    expect(t.value).toBe("Hello")
    expect(s).toHaveBeenCalledTimes(1)
    t:SetValue("Hello")
    expect(s).toHaveBeenCalledTimes(1)
    t:SetValue(42)
    expect(t.value).toBe(42)
    expect(t).toHaveText("42")
    expect(s).toHaveBeenCalledTimes(2)
end

@test("a secret value goes straight to the engine and is never compared")
local function secretValue()
    local t = make()
    local s = watched(t)
    t:SetValue("Brannoc Ironhand")
    t:SetValue(mock.secret("Brannoc Ironhand"))
    expect(t.value).toBeNil()
    expect(s).toHaveBeenCalledTimes(2)
    -- the same secret again: still set (it can't be compared)
    t:SetValue(mock.secret("Brannoc Ironhand"))
    expect(s).toHaveBeenCalledTimes(3)
    -- and a readable value after it counts as a change
    t:SetValue("Brannoc Ironhand")
    expect(t.value).toBe("Brannoc Ironhand")
    expect(s).toHaveBeenCalledTimes(4)
end

@test("SetShadowed casts the world shadow, or none")
local function shadowed()
    local t = make()
    t:SetShadowed(true)
    local x, y = t:GetShadowOffset()
    expect({ x, y }).toEqual({ 0, -1 })
    local _, _, _, a = t:GetShadowColor()
    expect(a).toBeCloseTo(0.9, 2)
    t:SetShadowed(false)
    x, y = t:GetShadowOffset()
    expect({ x, y }).toEqual({ 0, 0 })
    t:SetShadowed(nil)
    x, y = t:GetShadowOffset()
    expect({ x, y }).toEqual({ 0, 0 })
end

@test("SetFixedWidth fixes the width and tells the layout")
local function fixedWidth()
    local t = make()
    local s = watched(t)
    t:SetFixedWidth(120)
    expect(t.fixedWidth).toBe(120)
    expect(t:GetWidth()).toBe(120)
    expect(s).toHaveBeenCalledTimes(1)
end

@test("SetVisible shows or hides, telling the layout only on a change")
local function visible()
    local t = make()
    local s = watched(t)
    t:SetVisible(1)
    expect(t).toBeShown()
    expect(s).never.toHaveBeenCalled()
    t:SetVisible(nil)
    expect(t).never.toBeShown()
    expect(s).toHaveBeenCalledTimes(1)
    t:SetVisible(false)
    expect(s).toHaveBeenCalledTimes(1)
    t:SetVisible("yes")
    expect(t).toBeShown()
    expect(s).toHaveBeenCalledTimes(2)
end

@test("Changed without a layout does nothing")
local function changedAlone()
    local t = make()
    t:Changed()
    t:SetValue("x")
end

@test("flag reads a yes/no as a plain boolean, a secret as false")
@cases({ { true, true }, { 1, true }, { "x", true }, { false, false }, { nil, false } })
local function flags(v: any, expected: boolean)
    expect(flag(v)).toBe(expected)
end

@test("flag of a secret is false")
local function flagSecret()
    expect(flag(mock.secret(true))).toBe(false)
end

@test("measureText measures in a style, whatever the text sits in")
local function measures()
    expect(measureText("body", nil)).toBe(0)
    expect(measureText("body", "")).toBe(0)
    local t = make("header")
    t:SetValue("Gilt and arcane")
    local w = measureText("header", "Gilt and arcane")
    expect(w > 0).toBe(true)
    expect(w).toBe(t:GetUnboundedStringWidth())
    expect(measureText("header", "Gilt and arcane and more") > w).toBe(true)
end

@test("a theme change tells the layouts holding texts")
local function themeChange()
    local t = make()
    local s = watched(t)
    local other = text(parent :: Frame)
    themeChanged()
    expect(s).toHaveBeenCalledTimes(1)
    expect(other.layout).toBeNil()
end
