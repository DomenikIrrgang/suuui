-- The message of the day
--------------------------------------------------------------------------------

@test("motd: no message, no banner")
local function motdNone()
    local b = guildMotdBanner(host(700, 100))
    expect(b).never.toBeShown()
    b:SetData(nil)
    expect(b).never.toBeShown()
    expect(b:Height()).toBe(0)
    b:SetData({ text = "" })
    expect(b).never.toBeShown()
    expect(b.has).toBe(false)
    b:Layout()
    expectNoErrors()
end

@test("motd: the message, Edit when allowed, as tall as its text")
local function motd()
    local p = host(700, 100)
    local b = guildMotdBanner(p)
    b:SetPoint("TOPLEFT")
    b:SetPoint("TOPRIGHT")
    local onEdit = mock.spy()
    b.onEdit = onEdit
    b:SetData({ text = "Raid at eight.", canEdit = true })
    expect(b).toBeShown()
    expect(b.head).toHaveText("Message of the day")
    expect(b.message).toHaveText("Raid at eight.")
    expect(b.edit).toBeShown()
    local th = math.max(b.message:GetStringHeight(), b.head:GetStringHeight(), 14)
    expect(b:GetHeight()).toBe(math.ceil(2 * 8 + th))
    expect(b:Height()).toBe(b:GetHeight())
    local withEdit = b.message:GetWidth()
    mock.click(b.edit)
    expect(onEdit).toHaveBeenCalledTimes(1)
    b:SetData({ text = "Raid at eight." })
    expect(b.edit).never.toBeShown()
    expect(b.message:GetWidth() > withEdit).toBe(true)
    b.onEdit = nil
    b.edit:Show()
    mock.click(b.edit)
    expect(onEdit).toHaveBeenCalledTimes(1)
    -- too narrow to lay out: left as it was
    local narrow = guildMotdBanner(host(50, 100))
    narrow:SetAllPoints()
    local h0 = narrow:GetHeight()
    narrow:SetData({ text = "x" })
    -- (its width still its text's: Layout set none)
    expect(narrow.message:GetWidth()).toBe(narrow.message:GetStringWidth())
    expect(narrow:GetHeight()).toBe(h0)
    expectNoErrors()
end

@test("motd: cut short, the whole message on hover")
local function motdTooltip()
    local b = guildMotdBanner(host(700, 100))
    b:SetAllPoints()
    b:SetData({ text = "A very long message." })
    mock.hover(b)
    expect(GameTooltip:IsShown()).toBe(false)
    mock.hover(nil)
    -- (a font string: stub takes it as the table it is)
    mock.stub(b.message, "IsTruncated", function(): boolean
        return true
    end)
    mock.hover(b)
    expect(GameTooltip).toHaveLines({ "Message of the day", "A very long message." })
    mock.hover(nil)
    expect(GameTooltip:IsShown()).toBe(false)
    expectNoErrors()
end

@test("motd: laid out again on a new size")
local function motdResize()
    local p = host(700, 100)
    local b = guildMotdBanner(p)
    b:SetAllPoints()
    b:SetData({ text = "x" })
    local w = b.message:GetWidth()
    p:SetWidth(900)
    mock.script(b, "OnSizeChanged", 900, 100)
    expect(b.message:GetWidth()).toBe(w + 200)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- A theme change
--------------------------------------------------------------------------------

@test("a theme change draws the live pages again")
local function theme()
    local i = guildInfo(host(800, 400))
    i:SetAllPoints()
    i:SetData({ info = "x" })
    local idle = guildInfo(host(800, 400))
    local l = guildLog(host(600, 300))
    l:SetAllPoints()
    l:SetData({ lines = { { text = "a" } } })
    local quiet = guildLog(host(600, 300))
    local b = guildMotdBanner(host(700, 100))
    b:SetAllPoints()
    b:SetData({ text = "x" })
    i.info.text:SetText("changed")
    l.rows[1].text:SetText("changed")
    i.info.text.value, l.rows[1].text.value = nil, nil
    themeChanged()
    expect(i.info.text).toHaveText("x")
    expect(l.rows[1].text).toHaveText("a")
    expect(idle.data).toBeNil()
    expect(quiet.data).toBeNil()
    expectNoErrors()
end
