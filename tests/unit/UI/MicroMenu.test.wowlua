-- UI/MicroMenu: the micro menu's buttons (secure ones clicking Blizzard's
-- micro buttons, plain ones), hover and press, the active look, alerts,
-- counts in pills, tooltip lines and a theme change.

import test, expect, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import tokens as T from "/Core/Tokens"
import * as extend from "/Core/Extend"
import * as draw from "/UI/Draw"
import * as tooltip from "/UI/Tooltip"
import microMenu from "/UI/MicroMenu"
import internal keyOf, pill from "/UI/MicroMenu"
import expectNoErrors, newParent from "../../helpers"
import tokenOf, themeChanged from "./WindowsHelpers"

local S = T.space
local GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"

local showSpy = mock.spy()
local hideSpy = mock.spy()
mock.module(tooltip, {
    showTooltip = function(owner: any, data: any) showSpy(owner, data) end,
    hideTooltip = function() hideSpy() end,
})

local parent: Frame? = nil

local function make(name: string?)
    parent = newParent()
    return microMenu(parent, name and { name = name } or nil)
end

@afterEach
local function cleanup()
    mock.hover(nil)
    if parent then parent:Hide() end
    parent = nil
    mock.resetSpies()
    expectNoErrors()
end

-- A stand-in for one of Blizzard's micro buttons, with the tooltip text the
-- game gives them ("Character Info |cffffd200(C)|r").
local function blizzardButton(name: string, tip: any): Button
    local b = CreateFrame("Button", name, UIParent)
    ;(b :: any).tooltipText = tip
    return b
end

@test("keyOf: the key in brackets at the end of Blizzard's tooltip, colours away")
@cases({
    { "Character Info |cffffd200(C)|r", "C" },
    { "Spellbook (SHIFT-P)  ", "SHIFT-P" },
    { "Talents", "nil" },
    { "(A) in the middle (B)", "B" },
})
local function keys(tip: string, want: string)
    blizzardButton("SuuUITestMicroKey", tip)
    expect(keyOf("SuuUITestMicroKey") ?? "nil").toBe(want)
end

@test("keyOf: no name, no such frame, or no text: nil")
local function noKey()
    expect(keyOf(nil)).toBeNil()
    expect(keyOf("SuuUITestNoSuchFrame")).toBeNil()
    blizzardButton("SuuUITestMicroNoTip", nil)
    expect(keyOf("SuuUITestMicroNoTip")).toBeNil()
    blizzardButton("SuuUITestMicroNumber", 5)
    expect(keyOf("SuuUITestMicroNumber")).toBeNil()
end

@test("pill: two half discs and a middle, inset, painted together")
local function pills()
    local f = newParent(40, 14)
    parent = f
    local p = pill(f, 1, "ARTWORK")
    expect(p.left:GetWidth()).toBe(6)
    expect(p.left:GetHeight()).toBe(12)
    expect(p.right:GetWidth()).toBe(6)
    local point, _, _, x = p.left:GetPoint(1)
    expect(point).toBe("LEFT")
    expect(x).toBe(1)
    p.Paint("arcane")
    expect(tokenOf(p.left)).toBe("arcane")
    expect(tokenOf(p.right)).toBe("arcane")
    expect(tokenOf(p.mid)).toBe("arcane")
end

@test("a new menu: empty, 1 px, registered for plugins, named")
local function fresh()
    local m = make("SuuUITestMicroMenu")
    expect(m:GetWidth()).toBe(1)
    expect(m:GetHeight()).toBe(1)
    expect(_G["SuuUITestMicroMenu"]).toBe(m)
    expect(m.name).toBe("SuuUITestMicroMenu")
    expect(extend.list("micromenu")).toContain(m)
    local unnamed = microMenu(parent)
    expect(unnamed.name).toBeNil()
end

@test("SetItems lays the buttons out in a row and sizes the menu")
local function layout()
    local m = make("SuuUITestMicroRow")
    local onClick = mock.spy()
    expect(m:SetItems({
        { key = "char", glyph = "person", label = "Character", click = "CharacterMicroButton" },
        { key = "bags", glyph = "bag", label = "Bags", onClick = onClick },
    })).toBe(true)
    local px = draw.size("menu-button")
    local pad, gap = S["space-2"], S["space-2"]
    expect(m:GetWidth()).toBe(pad + px + gap + px + pad)
    expect(m:GetHeight()).toBe(px + pad * 2)
    local char, bags = m.buttons.char, m.buttons.bags
    expect(char:GetName()).toBe("SuuUITestMicroRowchar")
    expect(char).toHaveSize(px, px)
    local _, _, _, x1, y1 = char:GetPoint(1)
    local _, _, _, x2 = bags:GetPoint(1)
    expect(x1).toBe(pad)
    expect(y1).toBe(-pad)
    expect(x2).toBe(pad + px + gap)
    expect(char.glyph:GetTexture()).toBe(GLYPHS .. "person.tga")
    expect(tokenOf(char.glyph)).toBe("ink")
    expect(char.hover).never.toBeShown()
    expect(char.alert).never.toBeShown()
    expect(char.badge).never.toBeShown()
end

@test("an item with click is a secure button clicking Blizzard's")
local function secure()
    local m = make()
    m:SetItems({ { key = "char", glyph = "person", label = "Character", click = "CharacterMicroButton" } })
    local b = m.buttons.char
    expect(b:GetAttribute("type")).toBe("click")
    expect(b:GetAttribute("clickbutton")).toBe(CharacterMicroButton)
    expect(b:GetName()).toBeNil()
end

@test("a secure button's click opens Blizzard's window, untainted")
local function secureClick()
    local m = make("SuuUITestMicroSecure")
    m:SetItems({ { key = "char", glyph = "person", label = "Character", click = "CharacterMicroButton" } })
    -- (the click the key-down CVar acts on: mock.click sends only the up
    -- click; see the notes)
    mock.script(m.buttons.char, "OnClick", "LeftButton", true)
    expect(CharacterFrame).toBeShown()
    mock.script(m.buttons.char, "OnClick", "LeftButton", true)
    expect(CharacterFrame).never.toBeShown()
end

@test("an item with onClick is a plain button calling it")
local function plain()
    local m = make()
    local onClick = mock.spy()
    m:SetItems({ { key = "bags", glyph = "bag", label = "Bags", onClick = onClick }, { key = "none", glyph = "bag", label = "None" } })
    expect(m.buttons.bags:GetAttribute("type")).toBeNil()
    mock.click(m.buttons.bags)
    expect(onClick).toHaveBeenCalledTimes(1)
    -- neither click nor onClick: a click does nothing
    mock.click(m.buttons.none)
end

@test("SetItems again reuses the buttons and hides the ones left out")
local function again()
    local m = make()
    m:SetItems({ { key = "a", glyph = "bag", label = "A" }, { key = "b", glyph = "bag", label = "B" } })
    local a = m.buttons.a
    m:SetItems({ { key = "a", glyph = "bag", label = "A" } })
    expect(m.buttons.a).toBe(a)
    expect(a).toBeShown()
    expect(m.buttons.b).never.toBeShown()
    m:SetItems({})
    expect(a).never.toBeShown()
    expect(m:GetWidth()).toBe(S["space-2"])
end

@test("in combat SetItems does nothing (secure buttons) and says so")
local function combat()
    local m = make()
    mock.player:enterCombat()
    expect(m:SetItems({ { key = "a", glyph = "bag", label = "A" } })).toBe(false)
    expect(m.buttons.a).toBeNil()
    mock.player:leaveCombat()
    expect(m:SetItems({ { key = "a", glyph = "bag", label = "A" } })).toBe(true)
end

@test("hovering: the raised look and the tooltip with the key, lines and alert")
local function hovering()
    local m = make()
    blizzardButton("SuuUITestMicroChar", "Character Info |cffffd200(C)|r")
    m:SetItems({ { key = "char", glyph = "person", label = "Character", click = "SuuUITestMicroChar" },
        { key = "bags", glyph = "bag", label = "Bags", onClick = function() end } })
    local b = m.buttons.char
    mock.hover(b)
    expect(b.hover).toBeShown()
    expect(b.edge.top).toBeShown()
    expect(showSpy).toHaveBeenCalledWith(b, { title = "Character", subtitle = "Key: C" })
    -- lines and an alert's text join it
    m:SetLines("bags", { { "Free", "12" } })
    m:SetAlert("bags", "Your bags are full")
    mock.hover(m.buttons.bags)
    expect(showSpy).toHaveBeenCalledWith(m.buttons.bags, { title = "Bags", lines = { { "Free", "12" } }, maxWidth = 320,
        description = "Your bags are full" })
    expect(b.hover).never.toBeShown()
    expect(b.edge.top).never.toBeShown()
    expect(hideSpy).toHaveBeenCalled()
    m:SetLines("bags", nil)
    expect(m.buttons.bags.lines).toBeNil()
end

@test("pressing moves the glyph a pixel down, letting go back")
local function pressing()
    local m = make()
    m:SetItems({ { key = "a", glyph = "bag", label = "A" } })
    local b = m.buttons.a
    mock.script(b, "OnMouseDown", "LeftButton")
    local _, _, _, _, y = b.glyph:GetPoint(1)
    expect(y).toBe(-1)
    mock.script(b, "OnMouseUp", "LeftButton")
    _, _, _, _, y = b.glyph:GetPoint(1)
    expect(y).toBe(0)
end

@test("SetActive keeps the hover look while its window is open")
local function active()
    local m = make()
    m:SetItems({ { key = "a", glyph = "bag", label = "A" } })
    local b = m.buttons.a
    m:SetActive("a", true)
    expect(b.active).toBe(true)
    expect(b.hover).toBeShown()
    expect(b.edge.top).toBeShown()
    -- leaving keeps it
    mock.hover(b)
    mock.hover(nil)
    expect(b.hover).toBeShown()
    m:SetActive("a", nil)
    expect(b.active).toBe(false)
    expect(b.hover).never.toBeShown()
    -- unchanged, or an unknown key: nothing
    m:SetActive("a", false)
    m:SetActive("nope", true)
end

@test("SetActive under the mouse leaves the look to the hover")
local function activeHovered()
    local m = make()
    m:SetPoint("CENTER") -- (placed: the mouse is measured against it)
    m:SetItems({ { key = "a", glyph = "bag", label = "A" } })
    local b = m.buttons.a
    mock.hover(b)
    m:SetActive("a", false)
    m:SetActive("a", true)
    expect(b.active).toBe(true)
    m:SetActive("a", false)
    expect(b.active).toBe(false)
    -- still hovered: the look stays until the mouse leaves
    expect(b.hover).toBeShown()
    mock.hover(nil)
    expect(b.hover).never.toBeShown()
end

@test("SetAlert shows the arcane diamond, nil takes it away")
local function alerts()
    local m = make()
    m:SetItems({ { key = "a", glyph = "bag", label = "A" } })
    local b = m.buttons.a
    m:SetAlert("a", "Something to do")
    expect(b.alert).toBeShown()
    expect(b.alertText).toBe("Something to do")
    expect(tokenOf(b.alertDot)).toBe("arcane")
    m:SetAlert("a", nil)
    expect(b.alert).never.toBeShown()
    expect(b.alertText).toBeNil()
    m:SetAlert("nope", "x")
    m:SetLines("nope", {})
end

@test("SetCount: a count in a pill, its colours, as wide as its text")
local function counts()
    local m = make()
    m:SetItems({ { key = "bags", glyph = "bag", label = "Bags" } })
    local b = m.buttons.bags
    m:SetCount("bags", "12")
    expect(b.badge).toBeShown()
    expect(b.count:GetText()).toBe("12")
    expect(tokenOf(b.count)).toBe("ink")
    expect(tokenOf(b.badge.fill.mid)).toBe("surface")
    expect(tokenOf(b.badge.edge.mid)).toBe("gilt-line")
    expect(b.badge:GetWidth()).toBe(math.max(14, math.ceil(b.count:GetStringWidth()) + 6))
    m:SetCount("bags", "0", "ember-text", "ember-soft")
    expect(tokenOf(b.count)).toBe("ember-text")
    expect(tokenOf(b.badge.fill.left)).toBe("ember-soft")
    m:SetCount("bags", "1234567")
    expect(b.badge:GetWidth()).toBe(math.ceil(b.count:GetStringWidth()) + 6)
    m:SetCount("bags", "")
    expect(b.badge).never.toBeShown()
    m:SetCount("bags", "3")
    m:SetCount("bags", nil)
    expect(b.badge).never.toBeShown()
    m:SetCount("nope", "1")
end

@test("a theme change fits the pills again")
local function theme()
    local m = make()
    m:SetItems({ { key = "bags", glyph = "bag", label = "Bags" } })
    local b = m.buttons.bags
    m:SetCount("bags", "12")
    b.badge:SetWidth(99)
    themeChanged()
    expect(b.badge:GetWidth()).toBe(math.max(14, math.ceil(b.count:GetStringWidth()) + 6))
end
