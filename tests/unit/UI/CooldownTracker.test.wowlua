-- UI/CooldownTracker: the tracker itself (cells, fixed slots, reminders,
-- enchants, live conditions, layout, the driver and its events), and the
-- names it exports again from its parts. Each part's own logic is tested
-- beside it, in tests/unit/UI/CooldownTracker/.

import test, expect, beforeAll, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import tokens as T from "/Core/Tokens"
import * as roles from "/Core/Roles"
import * as events from "/Core/Events"
import cooldownTracker, cooldownConditionMet, CooldownTracker, trackerSound, trackerSoundFiles, trackerAuraSounds, TrackerEnchant, TrackerEntry, TrackerCondition, TrackerWhen, TrackerLists, TrackerOptions from "/UI/CooldownTracker"
import * as conditionsPart from "/UI/CooldownTracker/Conditions"
import * as soundsPart from "/UI/CooldownTracker/Sounds"
import mixins from "/Core/Init"
import * as weaponEnchants from "/UI/WeaponEnchants"
import expectNoErrors, newParent from "../../helpers"

-- Test spells: known ones and an unknown one.
const KNOWN_LOW = 900001
const KNOWN_HIGH = 900002
const UNKNOWN = 900003
const OTHER = 900004

local role = "DAMAGER"
local enchantable = true
local forgotHigh = false

@beforeAll
local function world()
    mock.defineSpell(KNOWN_LOW, { name = "Test Strike", iconID = 1001, known = true })
    mock.defineSpell(KNOWN_HIGH, { name = "Test Strike", iconID = 1002, known = true })
    mock.defineSpell(UNKNOWN, { name = "Test Unknown", iconID = 1003, known = false })
    mock.defineSpell(OTHER, { name = "Overpower", iconID = 1004, known = true })
    mock.setPlayer({ class = "MAGE" })
    mock.module(roles, {
        current = function(): (roles.Role, roles.RoleSource)
            return role :: roles.Role, roles.RoleSource.Chosen
        end,
    })
    mock.module(weaponEnchants, {
        weaponEnchantable = function(_: string): boolean
            return enchantable
        end,
    })
end

-- The trackers a test made, and the cooldown world it fakes.
local trackers: CooldownTracker[] = {}
local parent: Frame? = nil
local cooldowns: { [number]: { active: unknown, gcd?: unknown } } = {}
local usable: { [number]: { unknown } } = {}

local function fakeSpells()
    mock.fake("C_Spell.GetSpellCooldown", function(id: number): unknown
        local c = cooldowns[id]
        return {
            startTime = 0,
            duration = 0,
            isEnabled = true,
            modRate = 1,
            isActive = c and c.active or false,
            isOnGCD = c and c.gcd or false,
        }
    end)
    mock.fake("C_Spell.GetSpellCooldownDuration", function(id: number): unknown
        return cooldowns[id] and { duration = true } or nil
    end)
    mock.fake("C_Spell.IsSpellUsable", function(id: number): (unknown, unknown)
        local u = usable[id]
        if u then
            return u[1], u[2]
        end
        return true, false
    end)
end

-- A running tracker with these lists and options, built (the driver's frame).
local function tracker(lists: TrackerLists, opts: TrackerOptions?): CooldownTracker
    fakeSpells()
    local p = parent or newParent(600, 400)
    parent = p
    local t: CooldownTracker = cooldownTracker(p, { name = "SuuUITestTracker" .. (#trackers + 1) })
    trackers[#trackers + 1] = t
    t:SetOptions(opts or {})
    t:SetLists(lists)
    mock.advanceFrames(1)
    return t
end

local function strike(extra: TrackerEntry?): TrackerEntry
    local e: { [string]: unknown } = { name = "Test Strike", ids = { KNOWN_LOW, KNOWN_HIGH } }
    local more: { [string]: unknown } = extra or {}
    for k, v in pairs(more) do
        e[k] = v
    end
    return e :: TrackerEntry
end

local function cond(c: TrackerCondition, match: string?): TrackerWhen
    return { match = match, conditions = { c } }
end

@afterEach
local function reset()
    role = "DAMAGER"
    enchantable = true
    if forgotHigh then
        mock.defineSpell(KNOWN_HIGH, { name = "Test Strike", iconID = 1002, known = true })
        forgotHigh = false
    end
    for _, t in ipairs(trackers) do
        t:Stop()
        t:Hide()
    end
    trackers = {}
    if parent then
        parent:Hide()
    end
    parent = nil
    cooldowns, usable = {}, {}
end

--------------------------------------------------------------------------------
-- Entries and ranks
--------------------------------------------------------------------------------

-- Consecration as the client has it: Rank 1 is the highest ID (the recorded
-- C_Spell.GetSpellSubtext answers of WoW Forever).
local CONSECRATION = { 20116, 20922, 20923, 20924, 26573 }
local CONSECRATION_RANKS: { [number]: string } = {
    [26573] = "Rank 1",
    [20116] = "Rank 2",
    [20922] = "Rank 3",
    [20923] = "Rank 4",
    [20924] = "Rank 5",
}
local function consecration(knownUpTo: number)
    for id, rank in pairs(CONSECRATION_RANKS) do
        local n = assert(tonumber(rank:match("%d+")))
        mock.defineSpell(id, { name = "Consecration", iconID = 135926, subtext = rank, known = n <= knownUpTo })
    end
end

@test("a cell checks the mana of the highest rank you know, not of Rank 1")
local function manaOfTopRank()
    consecration(5)
    local t = tracker({ essential = { { name = "Consecration", ids = CONSECRATION, unusable = "hide" } } })
    local cell = t.built.essential[1]
    expect(cell.spellID).toBe(20924)
    -- Rank 1 is cheap enough, Rank 5 isn't: the cell is unusable
    usable[26573] = { true, false }
    usable[20924] = { false, true }
    t:UpdateCooldowns()
    expect(cell).never.toBeShown()
    usable[20924] = { true, false }
    t:UpdateCooldowns()
    expect(cell).toBeShown()
end

--------------------------------------------------------------------------------
-- The tracker: cooldown cells
--------------------------------------------------------------------------------

const ESS = T.size["cdm-essential"]
const LG = T.size["icon-lg"]
const SP = T.space

@test("cells: the rank you know, unknown and hidden entries left out")
local function cells()
    local t = tracker({
        essential = { strike(), { name = "Nope", ids = { UNKNOWN } }, strike({ hidden = true }) },
        utility = { { name = "Overpower", ids = { OTHER } } },
    })
    expect(#t.built.essential).toBe(1)
    expect(#t.built.utility).toBe(1)
    local c = t.built.essential[1]
    expect(c.spellID).toBe(KNOWN_HIGH)
    expect(c:GetWidth()).toBe(ESS)
    expect(t.built.utility[1]:GetWidth()).toBe(LG)
    expect(t.built.utility[1].reactive).toBe(true)
    expect(#t.cells).toBe(2)
    -- utility on its own row under essential
    expect(t:GetWidth()).toBe(math.max(ESS, LG))
    expect(t:GetHeight()).toBe(LG + SP["space-3"] + ESS + SP["space-3"])
    expect(t.divider).never.toBeShown()
    expectNoErrors()
end

@test("utility inline: one row with a divider; the essential size option")
local function inline()
    local t = tracker({ essential = { strike() }, utility = { { name = "Overpower", ids = { OTHER } } } }, {
        utilityInline = true,
        essentialSize = 30,
    })
    expect(t.built.essential[1]:GetWidth()).toBe(30)
    expect(t.built.utility[1]:GetWidth()).toBe(30)
    expect(t.divider).toBeShown()
    expect(t:GetWidth()).toBe(30 + SP["space-4"] * 2 + 1 + 30)
    expect(t:GetHeight()).toBe(30 + SP["space-3"])
    -- inline with no essential cells
    local u = tracker({ utility = { { name = "Overpower", ids = { OTHER } } } }, { utilityInline = true })
    expect(u.divider).toBeShown()
end

@test("a group in a cooldown list: the last member you know; none: nothing")
local function groupCell()
    local t = tracker({
        essential = {
            {
                group = true,
                name = "G",
                ids = { KNOWN_LOW, OTHER },
                members = { { name = "A", ids = { KNOWN_LOW } }, { name = "B", ids = { OTHER } } },
            },
            { group = true, name = "None", ids = { UNKNOWN }, members = { { name = "X", ids = { UNKNOWN } } } },
            { group = true, name = "No IDs", members = { { name = "A", ids = { KNOWN_LOW } } } },
        },
    })
    expect(#t.built.essential).toBe(1)
    expect(t.built.essential[1].spellID).toBe(OTHER)
end

@test("a collection in a cooldown list (Racials): a cell for each one you know, with its effect; hidden ones left out")
local function cooldownCollection()
    local t = tracker({
        essential = { { name = "Overpower", ids = { OTHER } } },
        utility = {
            {
                collection = true,
                name = "Racials",
                entries = {
                    strike({ effect = "you" }),
                    { name = "Not mine", ids = { UNKNOWN }, effect = "you" },
                    { name = "Overpower", ids = { OTHER }, hidden = true },
                },
            },
        },
    })
    expect(#t.built.utility).toBe(1)
    local cell = t.built.utility[1]
    expect(cell.spellID).toBe(KNOWN_HIGH)
    -- its buff covers the icon while up, as a single entry's does
    expect(cell.container).never.toBeNil()
    -- a hidden collection: none of it; one whose conditions aren't met: none
    local u = tracker({
        utility = {
            { collection = true, name = "Racials", hidden = true, entries = { strike() } },
            {
                collection = true,
                name = "Grouped",
                when = cond({ type = "group", value = "raid" }),
                entries = { strike() },
            },
        },
    })
    expect(#u.built.utility).toBe(0)
    expectNoErrors()
end

@test("cell states: cooldown dims, GCD keeps it ready, coming ready pops and plays")
local function cellStates()
    local played: { unknown } = {}
    mock.fake("PlaySoundFile", function(file: unknown, _: string): unknown
        played[#played + 1] = file
        return true
    end)
    local t = tracker({ essential = { strike({ sound = "chime" }) } })
    local c = t.built.essential[1]
    expect(c.icon.state).toBe("rest")
    expect(c.icon.borderToken).toBe("arcane")
    cooldowns[KNOWN_HIGH] = { active = true, gcd = true }
    t:UpdateCooldowns()
    expect(c.onCooldown).toBe(false)
    expect(c.cooldown:GetHideCountdownNumbers()).toBe(true)
    cooldowns[KNOWN_HIGH] = { active = true, gcd = false }
    t:UpdateCooldowns()
    expect(c.onCooldown).toBe(true)
    expect(c.icon.state).toBe("dim")
    expect(c.icon.borderToken).toBeNil()
    cooldowns[KNOWN_HIGH] = nil
    t:UpdateCooldowns()
    expect(c.onCooldown).toBe(false)
    expect(c.flash:GetAlpha() > 0.9).toBe(true)
    expect(played).toEqual({ 567409 })
    expectNoErrors()
end

@test("cell options: dim on cooldown, no pop, glow and pulse, borders")
local function cellOptions()
    local t = tracker({
        essential = { strike({ onCooldown = "dim", pop = false, ready = "pulse", border = "gilt" }) },
    }, { readyPop = true })
    local c = t.built.essential[1]
    expect(c.icon.borderToken).toBe("gilt")
    expect(c.icon.glowToken).toBe("glow-arcane")
    expect(c.pulse:IsPlaying()).toBe(true)
    t:UpdateCooldowns() -- keeps breathing
    expect(c.pulse:IsPlaying()).toBe(true)
    cooldowns[KNOWN_HIGH] = { active = true, gcd = false }
    t:UpdateCooldowns()
    expect(c.pulse:IsPlaying()).toBe(false)
    expect(c.icon.state).toBe("rest")
    expect(c:GetAlpha()).toBeCloseTo(T.opacity["opacity-oor"])
    cooldowns[KNOWN_HIGH] = nil
    t:UpdateCooldowns()
    expect(c.flash:GetAlpha()).toBe(0) -- no pop
    -- the global readyPop off
    local u = tracker({ essential = { strike({ ready = "glow" }) } }, { readyPop = false })
    local d = u.built.essential[1]
    expect(d.icon.glowToken).toBe("glow-arcane")
    cooldowns[KNOWN_HIGH] = { active = true }
    u:UpdateCooldowns()
    cooldowns[KNOWN_HIGH] = nil
    u:UpdateCooldowns()
    expect(d.flash:GetAlpha()).toBe(0)
end

@test("reactive abilities light up while usable; a secret answer is neutral")
local function reactive()
    local t = tracker({ essential = { { name = "Overpower", ids = { OTHER } } } })
    local c = t.built.essential[1]
    expect(c.reactive).toBe(true)
    expect(c.icon.state).toBe("ready")
    expect(c.ring.top).toBeShown()
    usable[OTHER] = { mock.secret(true), false }
    t:UpdateCooldowns()
    expect(c.icon.state).toBe("rest")
    expect(c.ring.top).never.toBeShown()
    usable[OTHER] = { false, false }
    t:UpdateCooldowns()
    expect(c:GetAlpha()).toBeCloseTo(T.opacity["opacity-disabled"])
end

@test("show only when ready, only on cooldown; hide on cooldown or unusable")
local function showModes()
    local t = tracker({
        essential = { strike({ show = "ready" }), { name = "Overpower", ids = { OTHER }, show = "cooldown" } },
    })
    local ready, cd = t.built.essential[1], t.built.essential[2]
    expect(ready).toBeShown()
    expect(cd).never.toBeShown()
    local w = t:GetWidth()
    cooldowns[KNOWN_HIGH] = { active = true }
    cooldowns[OTHER] = { active = true }
    t:UpdateCooldowns()
    expect(ready).never.toBeShown()
    expect(cd).toBeShown()
    expect(t:GetWidth()).toBe(w)
    local u = tracker({
        essential = { strike({ onCooldown = "hide" }), { name = "Overpower", ids = { OTHER }, unusable = "hide" } },
    })
    expect(u.built.essential[1]).never.toBeShown()
    usable[OTHER] = { false, true }
    u:UpdateCooldowns()
    expect(u.built.essential[2]).toBeShown() -- on cooldown: not "unusable"
    cooldowns[OTHER] = nil
    u:UpdateCooldowns()
    expect(u.built.essential[2]).never.toBeShown()
end

@test("the driver: events mark it dirty; a finished sweep marks its cell")
local function driver()
    local t = tracker({ essential = { strike() } })
    local c = t.built.essential[1]
    local reads = 0 -- (the Cooldown Manager's own tracker reads its spells too)
    mock.fake("C_Spell.GetSpellCooldown", function(id: number): unknown
        if id == KNOWN_HIGH then
            reads = reads + 1
        end
        return nil
    end)
    mock.advanceFrames(2)
    expect(reads).toBe(0)
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    mock.advanceFrames(1)
    expect(reads).toBe(1)
    mock.script(c.cooldown, "OnCooldownDone")
    expect(c.dirty).toBe(true)
    mock.advanceFrames(1)
    expect(reads).toBe(2)
    expect(c.dirty).toBe(false)
end

@test("power, usability and the target change only what is usable: no cooldown is read (garbage in combat)")
local function lightUpdates()
    local t = tracker({ essential = { strike() } })
    local c = t.built.essential[1]
    local reads = 0
    mock.fake("C_Spell.GetSpellCooldown", function(id: number): unknown
        if id == KNOWN_HIGH then
            reads = reads + 1
        end
        local cd = cooldowns[id]
        return {
            startTime = 0,
            duration = 0,
            isEnabled = true,
            modRate = 1,
            isActive = cd and cd.active or false,
            isOnGCD = false,
        }
    end)
    cooldowns[KNOWN_HIGH] = { active = true }
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    mock.advanceFrames(1)
    expect(reads).toBe(1)
    expect(c.onCooldown).toBe(true)
    -- out of mana while on cooldown: the cooldown stays as it was read
    usable[KNOWN_HIGH] = { false, true }
    mock.fireEvent("UNIT_POWER_FREQUENT", "player", "MANA")
    mock.advanceFrames(1)
    mock.fireEvent("SPELL_UPDATE_USABLE")
    mock.fireEvent("ACTIONBAR_UPDATE_USABLE")
    mock.advanceFrames(1)
    mock.fireEvent("PLAYER_TARGET_CHANGED")
    mock.advanceFrames(1)
    expect(reads).toBe(1)
    expect(c.onCooldown).toBe(true)
    -- ready again (the sweep ends): read, and the missing mana shows
    cooldowns[KNOWN_HIGH] = nil
    mock.script(c.cooldown, "OnCooldownDone")
    mock.advanceFrames(1)
    expect(reads).toBe(2)
    expect(c.onCooldown).toBe(false)
    expect(c:GetAlpha()).toBeCloseTo(T.opacity["opacity-disabled"])
    -- mana back: no read either
    usable[KNOWN_HIGH] = nil
    mock.fireEvent("UNIT_POWER_FREQUENT", "player", "MANA")
    mock.advanceFrames(1)
    expect(reads).toBe(2)
    expect(c:GetAlpha()).toBe(1)
    -- charges come back: read
    mock.fireEvent("SPELL_UPDATE_CHARGES")
    mock.advanceFrames(1)
    expect(reads).toBe(3)
end

@test("learning a rank rebuilds; the same ranks don't")
local function learn()
    local t = tracker({ essential = { strike() } })
    local sig = t.knownSig
    mock.fireEvent("SPELLS_CHANGED")
    expect(t.rebuild).toBeFalsy()
    forgotHigh = true
    mock.defineSpell(KNOWN_HIGH, { name = "Test Strike", iconID = 1002, known = false })
    mock.fireEvent("SPELLS_CHANGED")
    expect(t.rebuild).toBe(true)
    mock.advanceFrames(1)
    expect(t.knownSig).never.toBe(sig)
    expect(t.built.essential[1].spellID).toBe(KNOWN_LOW)
end

@test("a static condition's change rebuilds half a second later")
local function staticChange()
    local t = tracker({ essential = { strike({ when = cond({ type = "role", roles = { "TANK" } }) }) } })
    expect(#t.built.essential).toBe(0)
    expect(t.condSig).toBe("u")
    role = "TANK"
    -- (game events like GROUP_ROSTER_UPDATE fired by a test run Blizzard's
    -- handlers as SuuUI's code: the role message stands in for them)
    events.emit("SUUUI_ROLE_CHANGED", roles.Role.Tank)
    events.emit("SUUUI_ROLE_CHANGED", roles.Role.Tank) -- one look for the burst
    expect(t.rebuild).toBeFalsy()
    mock.advanceTime(0.6)
    expect(t.rebuild).toBe(true)
    mock.advanceFrames(1)
    expect(#t.built.essential).toBe(1)
    -- nothing changed: no rebuild
    events.emit("SUUUI_ROLE_CHANGED", roles.Role.Tank)
    mock.advanceTime(0.6)
    expect(t.rebuild).toBeFalsy()
    -- talents: read again
    mock.fireEvent("TRAIT_CONFIG_UPDATED", 1)
    mock.advanceTime(0.6)
    expect(t.rebuild).toBeFalsy()
    -- stopped meanwhile: no rebuild
    events.emit("SUUUI_ROLE_CHANGED", roles.Role.Tank)
    role = "DAMAGER"
    t:Stop()
    mock.advanceTime(0.6)
    expect(t.rebuild).toBeFalsy()
end

@test("a rebuild waits for the end of combat, except the first")
local function combatRebuild()
    local t = tracker({ essential = { strike() } })
    mock.player:enterCombat()
    expect(t.inFight).toBe(true)
    t:SetLists({ essential = {} })
    mock.advanceFrames(2)
    expect(#t.built.essential).toBe(1)
    mock.player:leaveCombat()
    expect(t.inFight).toBe(false)
    mock.advanceFrames(2)
    expect(#t.built.essential).toBe(0)
    -- a new tracker builds even in combat
    mock.player:enterCombat()
    local u = tracker({ essential = { strike() } })
    expect(#u.built.essential).toBe(1)
    mock.player:leaveCombat()
end

@test("Stop hands everything back and goes quiet; Start builds again, reusing cells")
local function stopStart()
    local t = tracker({ essential = { strike() } })
    local c = t.built.essential[1]
    t:Stop()
    t:Stop()
    expect(t.running).toBe(false)
    expect(c).never.toBeShown()
    expect(#t.cells).toBe(0)
    expect(t.knownSig).toBeNil()
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    expect(t.dirty).toBeFalsy()
    t:Start()
    t:Start()
    mock.advanceFrames(1)
    expect(t.built.essential[1]).toBe(c)
    expect(c).toBeShown()
    -- Start without lists: nothing to build
    local p = parent :: Frame
    local bare: CooldownTracker = cooldownTracker(p, nil)
    trackers[#trackers + 1] = bare
    mock.advanceFrames(1)
    expect(#bare.cells).toBe(0)
end

@test("live conditions: a cell shows only in its stance, in place")
local function liveCell()
    local index = 0
    mock.fake("GetShapeshiftForm", function(): unknown
        return index
    end)
    mock.fake("GetShapeshiftFormInfo", function(_: number): (unknown, unknown, unknown, unknown)
        return 1, true, true, 768
    end)
    local t = tracker({
        essential = {
            strike({ when = cond({ type = "stance", stances = { "cat" } }) }),
            { name = "Overpower", ids = { OTHER } },
        },
    })
    local c = t.built.essential[1]
    expect(c.condOK).toBe(false)
    expect(c).never.toBeShown()
    expect(t:GetWidth()).toBe(ESS)
    index = 1
    mock.fireEvent("UPDATE_SHAPESHIFT_FORM")
    expect(c.condOK).toBe(true)
    expect(c).toBeShown()
    expect(t:GetWidth()).toBe(ESS * 2 + SP["space-3"])
    expect(t.condSig).toBe("l")
end

@test("a live member's condition in a cooldown group watches the cell")
local function liveMember()
    local t = tracker({
        essential = {
            {
                group = true,
                name = "G",
                members = { { name = "B", ids = { OTHER }, when = cond({ type = "combat" }) } },
            },
        },
    })
    local c = t.built.essential[1]
    expect(c.condOK).toBe(false)
    mock.player:enterCombat()
    expect(c.condOK).toBe(true)
    mock.player:leaveCombat()
    expect(c.condOK).toBe(false)
end

@test("signatures: known ranks and static conditions, in list order")
local function signatures()
    local t = tracker({
        essential = { strike(), { group = true, members = { { ids = { UNKNOWN } }, { ids = { KNOWN_LOW } }, {} } } },
        buffs = {
            {
                collection = true,
                when = cond({ type = "combat" }),
                entries = { { ids = { OTHER }, when = cond({ type = "group", value = "raid" }) } },
            },
            { enchant = "main" },
        },
        procs = { { ids = { 1 } } },
    })
    expect(t:KnownSignature()).toBe(KNOWN_HIGH .. ",0," .. KNOWN_LOW .. ",0," .. OTHER)
    expect(t:ConditionSignature()).toBe("lu")
end

@test("SetFooter: the bar under the rows, the block at least as wide")
local function footer()
    local t = tracker({ essential = { strike() } })
    local bar = CreateFrame("Frame", nil, UIParent)
    bar:SetSize(300, 10)
    t:SetFooter(bar)
    expect(bar:GetParent()).toBe(t)
    expect(t:GetWidth()).toBe(300)
    expect(t:GetHeight()).toBe(10 + SP["space-4"] + ESS + SP["space-3"])
    local other = CreateFrame("Frame", nil, UIParent)
    other:SetSize(1, 1)
    t:SetFooter(other)
    expect(bar).never.toBeShown()
    t:SetFooter(nil)
    expect(t:GetWidth()).toBe(ESS)
end

--------------------------------------------------------------------------------
-- The tracker: aura slots, reminders, enchants, sounds
--------------------------------------------------------------------------------

@test("buffs: grey slots, packed ones, reminders; debuffs on the right")
local function auraRows()
    local t = tracker({
        buffs = {
            strike(),
            strike({ missing = "hide" }),
            { name = "U", ids = { UNKNOWN } },
            strike({ missing = "remind" }),
        },
        procs = { { name = "P", ids = { OTHER } } },
        debuffs = {
            strike(),
            { name = "U", ids = { UNKNOWN } },
            strike({ missing = "remind" }),
            { group = true, name = "G", ids = { UNKNOWN }, members = { { ids = { UNKNOWN } } } },
            strike({ missing = "hide" }),
        },
    })
    expect(#t.built.buffs).toBe(1)
    expect(#t.built.remindBuffs).toBe(1)
    expect(#t.built.debuffs).toBe(2)
    expect(#t.built.remindDebuffs).toBe(1)
    expect(t.hasLeft).toBe(true)
    expect(t.hasRight).toBe(true)
    expect(t.auraDivider).toBeShown()
    expect(t.built.debuffs[1].withTarget).toBe(true)
    expect(t.rowH).toBe(LG)
    -- debuff slots wait for a hostile target (as an alpha from the boolean:
    -- the VM stores SetAlphaFromBoolean's arguments without applying them)
    local slot = t.built.debuffs[1]
    local shown: unknown = nil
    mock.stub(slot, "SetAlphaFromBoolean", function(_: unknown, on: unknown, _: number, _: number)
        shown = on
    end)
    t:UpdateMissing()
    expect(shown).toBe(false)
    local mob = mock.spawnUnit({ name = "Mob", reaction = "hostile" })
    mock.player:target(mob)
    expect(shown).toBe(true)
    -- a frame without it: a plain alpha
    local plain = t.built.debuffs[2]
    plain.withTarget = true
    rawset(plain, "SetAlphaFromBoolean", false) -- (shadows the widget method)
    t:UpdateMissing()
    expect(plain:GetAlpha()).toBe(1)
    mock.player:target(nil)
    t:UpdateMissing()
    expect(plain:GetAlpha()).toBe(0)
    mock.player:target(nil)
    mob:despawn()
    expectNoErrors()
end

@test("warn slots and target-less grey debuffs; a large aura makes the row taller")
local function warnSlots()
    local t = tracker({
        buffs = { strike({ missing = "warn", size = "large" }) },
        debuffs = { strike({ missing = "grey" }) },
    })
    expect(t.rowH).toBe(ESS)
    expect(t.built.debuffs[1].withTarget).toBe(false)
    expect(t.built.debuffs[1]:GetAlpha()).toBe(1)
    expect(t.sepRight.withTarget).toBe(false)
    expect(t.auraDivider:GetHeight()).toBe(ESS)
end

@test("reminders: shown while the aura isn't up, out of combat")
local function reminders()
    local t = tracker({ buffs = { strike({ missing = "remind" }) } })
    local r = t.built.remindBuffs[1]
    expect(r).toBeShown()
    local id = mock.player:applyAura({ spellId = KNOWN_LOW, name = "Test Strike", sourceUnit = "player" })
    expect(r).never.toBeShown()
    mock.player:removeAura(id)
    expect(r).toBeShown()
    mock.player:enterCombat()
    expect(r).never.toBeShown()
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(r).toBeShown()
end

@test("debuff reminders need a hostile target")
local function debuffReminders()
    local t = tracker({ debuffs = { strike({ missing = "remind" }) } })
    local r = t.built.remindDebuffs[1]
    expect(r).never.toBeShown()
    local mob = mock.spawnUnit({ name = "Mob", reaction = "hostile" })
    mock.player:target(mob)
    expect(r).toBeShown()
    mock.player:target(nil)
    expect(r).never.toBeShown()
    mob:despawn()
end

@test("collections: their entries in place, a hairline apart; hidden ones left out")
local function collections()
    local t = tracker({
        buffs = {
            strike(),
            {
                collection = true,
                uid = "c",
                entries = { strike(), strike(), { collection = true, entries = { strike() } } },
            },
            { collection = true, hidden = true, entries = { strike() } },
            { collection = true, when = cond({ type = "group", value = "raid" }), entries = { strike() } },
            strike({ hidden = true }),
        },
    })
    expect(#t.built.buffs).toBe(3)
    expect(t.built.buffs[2].coll).never.toBeNil()
    expect(t.sepLeft.used).toBe(1)
    expect(t.sepLeft.lines[1]).toBeShown()
    local d = tracker({
        debuffs = { { collection = true, entries = { strike({ missing = "grey" }) } }, strike({ missing = "grey" }) },
    })
    expect(d.sepRight.used).toBe(1)
end

@test("weapon enchants: shown by their mode, gone without a weapon")
local function enchants()
    local t = tracker({
        buffs = {
            { enchant = "main", name = "MH" },
            { enchant = "off", missing = "hide" },
            { enchant = "ranged", missing = "grey" },
        },
    })
    local main, off, ranged = t.built.buffs[1] :: TrackerEnchant,
        t.built.buffs[2] :: TrackerEnchant,
        t.built.buffs[3] :: TrackerEnchant
    expect(main.enchant).toBe(true)
    expect(main.missing).toBe("warn")
    expect(main).toBeShown()
    expect(off.wantShown).toBe(false)
    expect(off).never.toBeShown()
    expect(ranged.missing).toBe("grey")
    -- in combat a warning greys unless it warns in combat
    mock.player:enterCombat()
    expect(main.missing).toBe("grey")
    mock.player:leaveCombat()
    expect(main.missing).toBe("warn")
    -- no weapon to enchant
    enchantable = false
    events.emit("SUUUI_WEAPON_ENCHANTS_CHANGED")
    expect(main).never.toBeShown()
    local w = tracker({ buffs = { { enchant = "main", warnCombat = true } } })
    mock.player:enterCombat()
    expect((w.built.buffs[1] :: TrackerEnchant).missing).toBe("warn")
    mock.player:leaveCombat()
end

@test("aura sounds: registered per spell and unit, taken back on Stop")
local function auraSounds()
    local nextID = 0
    local removed: { unknown } = {}
    mock.fake("C_UnitAuras.AddAuraSound", function(_: unknown, data: unknown): unknown
        if data.spellID == UNKNOWN then
            error("refused")
        end
        nextID = nextID + 1
        return nextID
    end)
    mock.fake("C_UnitAuras.RemoveAuraSound", function(id: unknown)
        removed[#removed + 1] = id
    end)
    local t = tracker({
        buffs = { strike({ soundAppear = "chime", soundDrop = "nope" }) },
        procs = { { name = "P", ids = { OTHER }, soundStack = "proc" } },
        debuffs = { { name = "D", ids = { UNKNOWN }, soundAppear = "warning" } },
    })
    local ids, what = trackerAuraSounds()
    expect(#ids).toBe(3)
    expect(what[1]).toBe("Test Strike soundAppear " .. KNOWN_LOW .. " (player)")
    expect(what.error).never.toBeNil()
    t:Stop()
    expect(removed).toEqual({ 1, 2, 3 })
    local after, _ = trackerAuraSounds()
    expect(#after).toBe(0)
end

@test("a packed entry with a live condition: its engine group's max follows it")
local function liveGroup()
    local t = tracker({ buffs = { strike({ missing = "hide", when = cond({ type = "combat" }) }) } })
    expect(#t.liveGroups).toBe(1)
    local g = t.liveGroups[1]
    expect(g.applied).toBe(0)
    mock.player:enterCombat()
    expect(g.applied).toBe(1)
    mock.player:leaveCombat()
    expect(g.applied).toBe(0)
end

@test("an effect: the aura over the cell, hidden with the cell's conditions")
local function effect()
    local t = tracker({
        essential = {
            strike({ effect = "you", when = cond({ type = "combat" }) }),
            { name = "Overpower", ids = { OTHER }, effect = "target", effectIDs = { 7 } },
            { name = "X", ids = { KNOWN_LOW }, effect = "nope" },
        },
    })
    expect(t.built.essential[1].container).never.toBeNil()
    expect(t.built.essential[2].container).never.toBeNil()
    expect(t.built.essential[3].container).toBeNil()
    expect(#t.liveGroups).toBe(1)
    -- on cooldown and hidden, the cell keeps its place for its effect
    mock.player:enterCombat()
    local u = tracker({ essential = { { name = "Overpower", ids = { OTHER }, effect = "you", onCooldown = "hide" } } })
    cooldowns[OTHER] = { active = true }
    u:UpdateCooldowns()
    expect(u.built.essential[1]).never.toBeShown()
    expect(u:GetWidth()).toBe(ESS)
    mock.player:leaveCombat()
end

@test("a slot's live member: its own engine group, watched")
local function liveSlotMember()
    local t = tracker({
        buffs = {
            {
                group = true,
                name = "G",
                max = 2,
                ids = { KNOWN_LOW, OTHER },
                members = {
                    { name = "A", ids = { KNOWN_LOW } },
                    { name = "B", ids = { OTHER }, when = cond({ type = "combat" }) },
                },
            },
        },
    })
    expect(#t.built.buffs).toBe(1)
    expect(#t.liveGroups).toBe(1)
    expect(t.built.buffs[1]:GetWidth()).toBe(LG * 2 + SP["space-2"])
    -- a slot with a live condition of its own shows in place
    local u = tracker({ buffs = { strike({ when = cond({ type = "combat" }) }) } })
    expect(u.built.buffs[1]).never.toBeShown()
    mock.player:enterCombat()
    expect(u.built.buffs[1]).toBeShown()
    mock.player:leaveCombat()
end

@test("a rebuild takes back the slots, cells and containers it made")
local function reuse()
    local lists: TrackerLists = {
        essential = { strike() },
        buffs = { strike() },
        procs = { { name = "P", ids = { OTHER } } },
        debuffs = { strike({ missing = "remind" }) },
    }
    local t = tracker(lists)
    local cell, slot, reminder, flow = t.built.essential[1], t.built.buffs[1], t.built.remindDebuffs[1], t.leftFlow
    t:SetLists(lists)
    mock.advanceFrames(1)
    expect(t.built.essential[1]).toBe(cell)
    expect(t.built.buffs[1]).toBe(slot)
    expect(t.built.remindDebuffs[1]).toBe(reminder)
    expect(t.leftFlow).toBe(flow)
    expect(slot).toBeShown()
end

