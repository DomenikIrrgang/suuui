@test("SetFooter: the bar under the rows, the block at least as wide")
local function footer()
    local t = tracker({ essential = { strike() } })
    local bar = CreateFrame("Frame", nil, UIParent)
    bar:SetSize(300, 10)
    t:SetFooter(bar)
    expect(bar:GetParent()).toBe(t)
    expect(t:GetWidth()).toBe(300)
    expect(t:GetHeight()).toBe(10 + SP["space-4"] + ESS + SP["space-3"])
    local other = CreateFrame("Frame", nil, UIParent)
    other:SetSize(1, 1)
    t:SetFooter(other)
    expect(bar).never.toBeShown()
    t:SetFooter(nil)
    expect(t:GetWidth()).toBe(ESS)
end

