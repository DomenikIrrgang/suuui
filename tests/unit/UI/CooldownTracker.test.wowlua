-- UI/CooldownTracker: the conditions ("Show only when"), the aura parts and
-- filters, sounds, and the tracker itself (cells, fixed slots, reminders,
-- enchants, live conditions, layout, the driver and its events).

import test, cases, expect, beforeAll, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import tokens as T from "/Core/Tokens"
import * as roles from "/Core/Roles"
import * as events from "/Core/Events"
import cooldownTracker, cooldownConditionMet, CooldownTracker, trackerSound, trackerSoundFiles, trackerAuraSounds, TrackerEnchant, TrackerEntry, TrackerCondition, TrackerWhen, TrackerLists, TrackerOptions from "/UI/CooldownTracker"
import internal knownRank, knowsEntry, cooldownMember, iconFor, currentStance, targetKind, instanceKind, rosterClasses, hasRank, readTalents, lookUp, listHas, counts, conditionMet, staticState, chain, stateOf, allMet, withMetMembers, auraSize, auraLook, slotArt, sourceFilter, auraParts, containerKey, cooldownFlags, formByName, TEST from "/UI/CooldownTracker"
import * as weaponEnchants from "/UI/WeaponEnchants"
import expectNoErrors, newParent from "../../helpers"

-- Test spells: known ones and an unknown one.
const KNOWN_LOW = 900001
const KNOWN_HIGH = 900002
const UNKNOWN = 900003
const OTHER = 900004

local role = "DAMAGER"
local enchantable = true
local forgotHigh = false

@beforeAll
local function world()
    mock.defineSpell(KNOWN_LOW, { name = "Test Strike", iconID = 1001, known = true })
    mock.defineSpell(KNOWN_HIGH, { name = "Test Strike", iconID = 1002, known = true })
    mock.defineSpell(UNKNOWN, { name = "Test Unknown", iconID = 1003, known = false })
    mock.defineSpell(OTHER, { name = "Overpower", iconID = 1004, known = true })
    mock.setPlayer({ class = "MAGE" })
    mock.module(roles, {
        current = function(): (roles.Role, roles.RoleSource)
            return role :: roles.Role, roles.RoleSource.Chosen
        end,
    })
    mock.module(weaponEnchants, {
        weaponEnchantable = function(_: string): boolean
            return enchantable
        end,
    })
end

-- The trackers a test made, and the cooldown world it fakes.
local trackers: CooldownTracker[] = {}
local parent: Frame? = nil
local cooldowns: { [number]: { active: unknown, gcd?: unknown } } = {}
local usable: { [number]: { unknown } } = {}

local function fakeSpells()
    mock.fake("C_Spell.GetSpellCooldown", function(id: number): unknown
        local c = cooldowns[id]
        return {
            startTime = 0,
            duration = 0,
            isEnabled = true,
            modRate = 1,
            isActive = c and c.active or false,
            isOnGCD = c and c.gcd or false,
        }
    end)
    mock.fake("C_Spell.GetSpellCooldownDuration", function(id: number): unknown
        return cooldowns[id] and { duration = true } or nil
    end)
    mock.fake("C_Spell.IsSpellUsable", function(id: number): (unknown, unknown)
        local u = usable[id]
        if u then
            return u[1], u[2]
        end
        return true, false
    end)
end

-- A running tracker with these lists and options, built (the driver's frame).
local function tracker(lists: TrackerLists, opts: TrackerOptions?): CooldownTracker
    fakeSpells()
    local p = parent or newParent(600, 400)
    parent = p
    local t: CooldownTracker = cooldownTracker(p, { name = "SuuUITestTracker" .. (#trackers + 1) })
    trackers[#trackers + 1] = t
    t:SetOptions(opts or {})
    t:SetLists(lists)
    mock.advanceFrames(1)
    return t
end

local function strike(extra: TrackerEntry?): TrackerEntry
    local e: { [string]: unknown } = { name = "Test Strike", ids = { KNOWN_LOW, KNOWN_HIGH } }
    local more: { [string]: unknown } = extra or {}
    for k, v in pairs(more) do
        e[k] = v
    end
    return e :: TrackerEntry
end

local function cond(c: TrackerCondition, match: string?): TrackerWhen
    return { match = match, conditions = { c } }
end

@afterEach
local function reset()
    role = "DAMAGER"
    enchantable = true
    if forgotHigh then
        mock.defineSpell(KNOWN_HIGH, { name = "Test Strike", iconID = 1002, known = true })
        forgotHigh = false
    end
    for _, t in ipairs(trackers) do
        t:Stop()
        t:Hide()
    end
    trackers = {}
    if parent then
        parent:Hide()
    end
    parent = nil
    cooldowns, usable = {}, {}
end

--------------------------------------------------------------------------------
-- Entries and ranks
--------------------------------------------------------------------------------

@test("knownRank: the highest rank you know")
local function ranks()
    expect(knownRank({ ids = { KNOWN_LOW, KNOWN_HIGH, UNKNOWN } })).toBe(KNOWN_HIGH)
    expect(knownRank({ ids = { KNOWN_LOW, UNKNOWN } })).toBe(KNOWN_LOW)
    expect(knownRank({ ids = { UNKNOWN } })).toBeNil()
    expect(knownRank({ ids = {} })).toBeNil()
end

@test("knowsEntry: a single entry's rank, or any group member's")
local function knows()
    expect(knowsEntry({ ids = { KNOWN_LOW } })).toBe(true)
    expect(knowsEntry({ ids = { UNKNOWN } })).toBe(false)
    expect(knowsEntry({ group = true, members = { { ids = { UNKNOWN } }, { ids = { KNOWN_LOW } } } })).toBe(true)
    expect(knowsEntry({ group = true, members = { { ids = { UNKNOWN } } } })).toBe(false)
    expect(knowsEntry({ group = true })).toBe(false)
end

@test("cooldownMember: the last member you know, with the group's behaviour")
local function member()
    local g: TrackerEntry = {
        group = true,
        name = "G",
        icon = 5,
        show = "ready",
        effect = "you",
        members = {
            { name = "A", ids = { KNOWN_LOW } },
            { name = "B", ids = { UNKNOWN } },
            { name = "C", ids = {} },
            { name = "D", ids = { OTHER }, when = cond({ type = "combat" }) },
        },
    }
    local e = assert(cooldownMember(g))
    expect(e.name).toBe("D")
    expect(e.show).toBe("ready")
    expect(e.group).toBeNil()
    expect(e.icon).toBeNil()
    expect(e.memberWhen).toBe(assert(g.members)[4].when)
    expect(cooldownMember({ group = true, members = { { name = "B", ids = { UNKNOWN } } } })).toBeNil()
    expect(cooldownMember({ group = true })).toBeNil()
end

@test("iconFor: the entry's icon, the known rank's, else the first ID's")
local function icons()
    expect(iconFor({ icon = KNOWN_LOW, ids = { OTHER } })).toBe(1001)
    expect(iconFor({ ids = { KNOWN_LOW, KNOWN_HIGH } })).toBe(1002)
    expect(iconFor({ ids = { UNKNOWN } })).toBe(1003)
end

@test("cooldownFlags: unknown reads as not active")
local function flags()
    -- (a secret isOnGCD, which the declarations don't allow for)
    local onGCD: unknown = mock.secret(true)
    local info: SpellCooldownInfoSecret = {
        startTime = 0,
        duration = 0,
        isEnabled = true,
        isActive = true,
        modRate = 1,
        isOnGCD = onGCD :: boolean,
    }
    local a, g = cooldownFlags(info)
    expect(a).toBe(true)
    expect(g).toBe(false)
    a, g = cooldownFlags(nil)
    expect(a).toBe(false)
    expect(g).toBe(false)
    local plain: SpellCooldownInfo = { startTime = 0, duration = 0, isEnabled = true, isActive = true, modRate = 1 }
    a, g = cooldownFlags(mock.secret(plain))
    expect(a).toBe(false)
    expect(g).toBe(false)
end

--------------------------------------------------------------------------------
-- Conditions
--------------------------------------------------------------------------------

@test("no conditions, or nothing chosen: always met")
local function always()
    expect(cooldownConditionMet(nil)).toBe(true)
    expect(cooldownConditionMet({})).toBe(true)
    expect(cooldownConditionMet({ conditions = {} })).toBe(true)
    expect(cooldownConditionMet(cond({ type = "classes", classes = {} }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "nonsense" }))).toBe(true)
    expect(cooldownConditionMet({ match = "any", conditions = { { type = "role", roles = {} } } })).toBe(true)
    expect(counts("x")).toBe(false)
    expect(counts({ type = "combat" })).toBe(true)
    expect(counts({ type = "role", roles = "TANK" })).toBe(false)
end

@test("group: solo, group, raid; the classes in it")
local function groupCond()
    -- (faked: the mock can't leave a group again, and the other tests are solo)
    local inGroup, inRaid = false, false
    mock.fake("IsInGroup", function(): boolean
        return inGroup
    end)
    mock.fake("IsInRaid", function(): boolean
        return inRaid
    end)
    mock.fake("UnitIsUnit", function(a: string, b: string): unknown
        return a == "party2" and b == "player"
    end)
    mock.fake("UnitClass", function(unit: string): (unknown, unknown)
        if unit == "player" then
            return "Mage", "MAGE"
        end
        if unit == "party1" or unit == "raid3" then
            return "Druid", "DRUID"
        end
        if unit == "party3" then
            return "x", mock.secret("PRIEST")
        end
        return nil, nil
    end)
    expect(cooldownConditionMet(cond({ type = "group", value = "solo" }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "group", value = "group" }))).toBe(false)
    expect(cooldownConditionMet(cond({ type = "group", value = "raid" }))).toBe(false)
    inGroup = true
    expect(cooldownConditionMet(cond({ type = "group", value = "group" }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "group", value = "solo" }))).toBe(false)
    expect(cooldownConditionMet(cond({ type = "classes", classes = { "DRUID" } }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "classes", classes = { "MAGE" } }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "classes", classes = { "MAGE" }, others = true }))).toBe(false)
    expect(cooldownConditionMet(cond({ type = "classes", classes = { "PRIEST" } }))).toBe(false)
    expect(rosterClasses(false)).toEqual({ MAGE = true, DRUID = true })
    expect(rosterClasses(true)).toEqual({ DRUID = true })
    inRaid = true
    expect(cooldownConditionMet(cond({ type = "group", value = "raid" }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "group", value = "group" }))).toBe(true)
    expect(rosterClasses(true)).toEqual({ DRUID = true })
end

@test("role, with not")
local function roleCond()
    role = "TANK"
    expect(cooldownConditionMet(cond({ type = "role", roles = { "TANK", "HEALER" } }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "role", roles = { "TANK" }, ["not"] = true }))).toBe(false)
    role = "DAMAGER"
    expect(cooldownConditionMet(cond({ type = "role", roles = { "TANK" } }))).toBe(false)
end

@test("instance kinds and their aliases")
local function instanceCond()
    expect(instanceKind()).toBe("none")
    expect(cooldownConditionMet(cond({ type = "instance", kinds = { "world" } }))).toBe(true)
    mock.enterInstance("party")
    expect(instanceKind()).toBe("party")
    expect(cooldownConditionMet(cond({ type = "instance", kinds = { "dungeon" } }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "instance", kinds = { "raid" } }))).toBe(false)
    mock.leaveInstance()
    mock.fake("IsInInstance", function(): (boolean, string)
        return true, "arena"
    end)
    expect(instanceKind()).toBe("pvp")
    mock.fake("IsInInstance", function(): (boolean, string)
        return true, "weird"
    end)
    expect(instanceKind()).toBe("none")
end

@test("combat: the tracker's own idea first")
local function combatCond()
    local c = cond({ type = "combat" })
    expect(conditionMet(c, { combat = true })).toBe(true)
    expect(conditionMet(c, { combat = false })).toBe(false)
    expect(conditionMet(c, nil)).toBe(false)
    mock.player:enterCombat()
    expect(cooldownConditionMet(c)).toBe(true)
    mock.player:leaveCombat()
end

@test("target kinds: player, boss, elite, normal, none")
local function targetCond()
    expect(targetKind()).toBeNil()
    local mob = mock.spawnUnit({ name = "Mob", reaction = "hostile", level = 10 })
    mock.player:target(mob)
    expect(targetKind()).toBe("normal")
    mock.fake("UnitClassification", function(_: string): string
        return "rareelite"
    end)
    expect(targetKind()).toBe("elite")
    mock.fake("UnitClassification", function(_: string): string
        return "worldboss"
    end)
    expect(targetKind()).toBe("boss")
    expect(cooldownConditionMet(cond({ type = "target", kinds = { "boss" } }))).toBe(true)
    mock.fake("UnitClassification", function(_: string): string
        return "normal"
    end)
    mock.fake("UnitLevel", function(_: string): number
        return -1
    end)
    expect(targetKind()).toBe("boss")
    mock.fake("UnitLevel", function(_: string): number
        return 10
    end)
    mock.fake("UnitIsBossMob", function(_: string): unknown
        return true
    end)
    expect(targetKind()).toBe("boss")
    mock.fake("UnitIsPlayer", function(_: string): unknown
        return true
    end)
    expect(targetKind()).toBe("player")
    mock.player:target(nil)
    mob:despawn()
end

@test("stance: caster, forms by spell, by name, a rogue's stealth")
local function stanceCond()
    local index = 0
    local spell: unknown = 768
    mock.fake("GetShapeshiftForm", function(): unknown
        return index
    end)
    mock.fake("GetShapeshiftFormInfo", function(_: number): (unknown, unknown, unknown, unknown)
        return 1, true, true, spell
    end)
    expect(currentStance()).toBe("caster")
    index = 1
    expect(currentStance()).toBe("cat")
    expect(cooldownConditionMet(cond({ type = "stance", stances = { "cat", "bear" } }))).toBe(true)
    spell = nil
    expect(currentStance()).toBeNil()
    spell = mock.secret(768)
    expect(currentStance()).toBeNil()
    -- another rank of a form: by its name
    mock.defineSpell(2458, { name = "Berserker Stance" })
    mock.defineSpell(900010, { name = "Berserker Stance" })
    spell = 900010
    expect(currentStance()).toBe("berserker")
    expect(formByName("Nothing")).toBeNil()
    spell = OTHER
    expect(currentStance()).toBeNil()
    spell = 999999 -- no name at all
    expect(currentStance()).toBeNil()
    index = mock.secret(1)
    expect(currentStance()).toBeNil()
    mock.fake("UnitClass", function(_: string): (string, string)
        return "Rogue", "ROGUE"
    end)
    index = 1
    expect(currentStance()).toBe("stealth")
end

@test("talent: learned in the active config, or a spell you know")
local function talentCond()
    -- a known spell counts
    expect(cooldownConditionMet(cond({ type = "talent", talents = { KNOWN_LOW } }))).toBe(true)
    expect(cooldownConditionMet(cond({ type = "talent", talents = { UNKNOWN, "x" } }))).toBe(false)
    -- from the talent config
    expect(assert(TEST.talent)({ talents = { 4242 } }, { talents = { [4242] = true } })).toBe(true)
end

@test("readTalents: ranked nodes' chosen entry, else every entry")
local function talents()
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): unknown
        return 7
    end)
    mock.fake("C_Traits.GetConfigInfo", function(_: number): unknown
        return { treeIDs = { 1 } }
    end)
    mock.fake("C_Traits.GetTreeNodes", function(_: number): unknown
        return { 10, 11, 12, 13 }
    end)
    mock.fake("C_Traits.GetNodeInfo", function(_: number, node: number): unknown
        if node == 10 then
            return { ranksPurchased = 1, activeEntry = { entryID = 100 }, entryIDs = { 100 } }
        end
        if node == 11 then
            return { activeRank = 2, entryIDs = { 110, 111, mock.secret(1) } }
        end
        if node == 12 then
            return { currentRank = 0, entryIDs = { 120 } }
        end
        return { ranksPurchased = mock.secret(1), entryIDs = { 130 } }
    end)
    mock.fake("C_Traits.GetEntryInfo", function(_: number, entry: number): unknown
        if entry == 111 then
            return { definitionID = mock.secret(5) }
        end
        return { definitionID = entry * 10 }
    end)
    mock.fake("C_Traits.GetDefinitionInfo", function(def: number): unknown
        if def == 1000 then
            return { spellID = 5000, overriddenSpellID = 5001 }
        end
        if def == 1100 then
            return { spellID = mock.secret(1) }
        end
        return nil
    end)
    local set = readTalents() :: { [number]: boolean }
    expect(set[5000]).toBe(true)
    expect(set[5001]).toBe(true)
    expect(set[1200]).toBeNil()
    expect(hasRank({ ranksPurchased = 0, activeRank = 0 })).toBe(false)
    expect(hasRank({ currentRank = 3 })).toBe(true)
    -- no config, a secret one, no tree list
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): unknown
        return nil
    end)
    expect(readTalents()).toBeNil()
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): unknown
        return mock.secret(7)
    end)
    expect(readTalents()).toBeNil()
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): unknown
        return 7
    end)
    mock.fake("C_Traits.GetConfigInfo", function(_: number): unknown
        return {}
    end)
    expect(readTalents()).toBeNil()
end

@test("lookUp keeps what it read, false for nothing")
local function lookups()
    local ctx: { [string]: unknown } = {}
    local n = 0
    local function read(): unknown
        n = n + 1
        return nil
    end
    expect(lookUp(ctx, "k", read)).toBe(false)
    expect(lookUp(ctx, "k", read)).toBe(false)
    expect(n).toBe(1)
    expect(listHas({ "a" }, "b", { a = "b" })).toBe(true)
    expect(listHas({ "a" }, "b", nil)).toBe(false)
end

@test("all and any")
local function matching()
    local yes = { type = "combat" }
    local no = { type = "combat", ["not"] = true }
    local ctx = { combat = true }
    expect(conditionMet({ conditions = { yes, no } }, ctx)).toBe(false)
    expect(conditionMet({ match = "any", conditions = { no, yes } }, ctx)).toBe(true)
    expect(conditionMet({ match = "any", conditions = { no } }, ctx)).toBe(false)
    expect(conditionMet({ conditions = { yes } }, ctx)).toBe(true)
end

@test("staticState: met, unmet, live")
local function static()
    local solo = { type = "group", value = "solo" }
    local inGroup = { type = "group", value = "group" }
    local live = { type = "combat" }
    expect(staticState(nil, {})).toBe("met")
    expect(staticState({ conditions = { solo } }, {})).toBe("met")
    expect(staticState({ conditions = { inGroup } }, {})).toBe("unmet")
    expect(staticState({ conditions = { solo, live } }, {})).toBe("live")
    expect(staticState({ conditions = { inGroup, live } }, {})).toBe("unmet")
    expect(staticState({ match = "any", conditions = { inGroup, solo } }, {})).toBe("met")
    expect(staticState({ match = "any", conditions = { inGroup } }, {})).toBe("unmet")
    expect(staticState({ match = "any", conditions = { inGroup, live } }, {})).toBe("live")
    expect(staticState({ conditions = { { type = "role", roles = {} } } }, {})).toBe("met")
end

@test("chain, stateOf, allMet")
local function chains()
    local a, b = cond({ type = "combat" }), cond({ type = "group", value = "group" })
    expect(chain(nil, a)).toEqual({ a })
    expect(chain({ a }, nil)).toEqual({ a })
    expect(#chain({ a }, b)).toBe(2)
    expect(stateOf({}, {})).toBe("met")
    expect(stateOf({ a }, {})).toBe("live")
    expect(stateOf({ a, b }, {})).toBe("unmet")
    expect(allMet({ a }, { combat = true })).toBe(true)
    expect(allMet({ a }, { combat = false })).toBe(false)
end

@test("withMetMembers: a group without the members that can't show")
local function metMembers()
    local single: TrackerEntry = { ids = { 1 } }
    expect(withMetMembers(single, {})).toBe(single)
    local plain: TrackerEntry = { group = true, members = { { ids = { 1 } } } }
    expect(withMetMembers(plain, {})).toBe(plain)
    local g: TrackerEntry = {
        group = true,
        name = "G",
        members = {
            { ids = { 3, 1 } },
            { ids = { 2 }, when = cond({ type = "group", value = "raid" }) },
            { ids = { 1, 4 }, when = cond({ type = "combat" }) },
            { when = cond({ type = "combat" }) },
        },
    }
    local e = withMetMembers(g, {})
    expect(e).never.toBe(g)
    expect(#assert(e.members)).toBe(3)
    expect(e.ids).toEqual({ 1, 3, 4 })
    expect(e.name).toBe("G")
end

--------------------------------------------------------------------------------
-- Aura looks, parts and filters
--------------------------------------------------------------------------------

@test("auraSize and auraLook")
local function looks()
    expect(auraSize({})).toBe(T.size["icon-lg"])
    expect(auraSize({ size = "small" })).toBe(T.size["icon-md"])
    expect(auraSize({ size = "large" })).toBe(T.size["cdm-essential"])
    expect(auraSize({ size = "huge" })).toBe(T.size["icon-lg"])
    local look = auraLook({ border = "gilt", glow = true, digits = false, stacks = true, expiring = 5 }, {
        border = "arcane",
        drain = "drain-arcane",
    })
    expect(look.border).toBe("gilt")
    expect(look.glow).toBe("glow-arcane")
    expect(look.drain).toBe("drain-arcane")
    expect(look.digits).toBe(false)
    expect(look.expiring).toBe(5)
    expect(auraLook({ border = "nope" }, nil).border).toBeNil()
end

@test("slotArt: a single aura's art; a group's fixed icon, known member, met member")
local function art()
    expect(slotArt({ ids = { KNOWN_LOW } }, {})).toBe(1001)
    expect(slotArt({ group = true, fixedIcon = true, icon = OTHER, ids = { KNOWN_LOW } }, {})).toBe(1004)
    local g: TrackerEntry = {
        group = true,
        icon = OTHER,
        ids = { UNKNOWN },
        members = {
            { ids = { UNKNOWN }, icon = KNOWN_HIGH, when = cond({ type = "combat" }) },
            { ids = { UNKNOWN } },
            { ids = { KNOWN_LOW } },
        },
    }
    expect(slotArt(g, {})).toBe(1001) -- the member you know
    table.remove(assert(g.members), 3)
    expect(slotArt(g, { combat = true })).toBe(1002) -- the first met: its own icon
    expect(slotArt(g, { combat = false })).toBe(1003) -- the second: its first ID
    expect(slotArt({ group = true, icon = OTHER, ids = { UNKNOWN }, members = { { ids = {} } } }, {})).toBe(1004)
end

@test("sourceFilter: the entry's, a group's mine, the list's default")
@cases({
    { "mine", "nil", "any", "HELPFUL|PLAYER" },
    { "others", "nil", "any", "HELPFUL|!PLAYER" },
    { "any", "nil", "mine", "HELPFUL" },
    { "nil", "group", "any", "HELPFUL|PLAYER" },
    { "nil", "mine", "any", "HELPFUL|PLAYER" },
    { "nil", "nil", "others", "HELPFUL|!PLAYER" },
})
local function filters(source: string, flag: string, default: string, out: string)
    local e: TrackerEntry = {}
    if source ~= "nil" then
        e.source = source
    end
    if flag == "group" then
        e.group = true
    elseif flag == "mine" then
        e.mine = true
    end
    expect(table.concat(sourceFilter("HELPFUL", e, default), "|")).toBe(out)
end

@test("auraParts: one part, or one per source, a live member apart")
local function parts()
    local single = auraParts("HARMFUL", { ids = { 1 } }, "mine", {})
    expect(#single).toBe(1)
    expect(single[1].filter).toEqual({ "HARMFUL", "PLAYER" })
    -- a group whose members share a source: one part with the group's IDs
    local same = auraParts("HELPFUL", {
        group = true,
        ids = { 9 },
        members = { { ids = { 1 } }, { ids = { 2 } } },
    }, "any", {})
    expect(#same).toBe(1)
    expect(same[1].ids).toEqual({ 9 })
    -- different sources
    local mixed = auraParts(
        "HELPFUL",
        {
            group = true,
            ids = { 1, 2, 3 },
            source = "others",
            members = {
                { ids = { 1, 1 } },
                { ids = { 2 }, source = "mine" },
                { ids = { 3 } },
                { ids = {}, source = "any" },
            },
        },
        "any",
        nil
    )
    expect(#mixed).toBe(2)
    expect(mixed[1].ids).toEqual({ 1, 3 })
    expect(mixed[1].filter).toEqual({ "HELPFUL", "!PLAYER" })
    expect(mixed[2].filter).toEqual({ "HELPFUL", "PLAYER" })
    -- a live member: its own part with its when
    local live = cond({ type = "combat" })
    local lp = auraParts("HELPFUL", {
        group = true,
        ids = { 1, 2 },
        members = { { ids = { 1 }, when = live }, { ids = { 2 } } },
    }, "any", {})
    expect(#lp).toBe(2)
    expect(lp[1].when).toBe(live)
    local only = auraParts("HELPFUL", {
        group = true,
        ids = { 1 },
        members = { { ids = { 1 }, when = live } },
    }, "any", {})
    expect(#only).toBe(1)
    expect(only[1].when).toBe(live)
end

@test("containerKey: everything fixed at creation")
local function keys()
    local k = containerKey("player", {
        size = 30,
        anchor = "TOPLEFT",
        growth = { "RIGHT", "DOWN" },
        groups = { { key = "e", filter = { "HELPFUL", "PLAYER" }, max = 1, include = { 1, 2 } } },
    })
    expect(k).toBe("player;30;TOPLEFT;RIGHT,DOWN;e/HELPFUL,PLAYER/1/1,2//nil/nil/nil/nil/nil/nil/nil")
    local k2 = containerKey("target", { groups = {} })
    expect(k2).toBe("target;nil;nil;")
end

