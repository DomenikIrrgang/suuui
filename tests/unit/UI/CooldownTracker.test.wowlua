-- The tracker: aura slots, reminders, enchants, sounds
--------------------------------------------------------------------------------

@test("buffs: grey slots, packed ones, reminders; debuffs on the right")
local function auraRows()
    local t = tracker({
        buffs = {
            strike(),
            strike({ missing = "hide" }),
            { name = "U", ids = { UNKNOWN } },
            strike({ missing = "remind" }),
        },
        procs = { { name = "P", ids = { OTHER } } },
        debuffs = {
            strike(),
            { name = "U", ids = { UNKNOWN } },
            strike({ missing = "remind" }),
            { group = true, name = "G", ids = { UNKNOWN }, members = { { ids = { UNKNOWN } } } },
            strike({ missing = "hide" }),
        },
    })
    expect(#t.built.buffs).toBe(1)
    expect(#t.built.remindBuffs).toBe(1)
    expect(#t.built.debuffs).toBe(2)
    expect(#t.built.remindDebuffs).toBe(1)
    expect(t.hasLeft).toBe(true)
    expect(t.hasRight).toBe(true)
    expect(t.auraDivider).toBeShown()
    expect(t.built.debuffs[1].withTarget).toBe(true)
    expect(t.rowH).toBe(LG)
    -- debuff slots wait for a hostile target (as an alpha from the boolean:
    -- the VM stores SetAlphaFromBoolean's arguments without applying them)
    local slot = t.built.debuffs[1]
    local shown: unknown = nil
    mock.stub(slot, "SetAlphaFromBoolean", function(_: unknown, on: unknown, _: number, _: number)
        shown = on
    end)
    t:UpdateMissing()
    expect(shown).toBe(false)
    local mob = mock.spawnUnit({ name = "Mob", reaction = "hostile" })
    mock.player:target(mob)
    expect(shown).toBe(true)
    -- a frame without it: a plain alpha
    local plain = t.built.debuffs[2]
    plain.withTarget = true
    rawset(plain, "SetAlphaFromBoolean", false) -- (shadows the widget method)
    t:UpdateMissing()
    expect(plain:GetAlpha()).toBe(1)
    mock.player:target(nil)
    t:UpdateMissing()
    expect(plain:GetAlpha()).toBe(0)
    mock.player:target(nil)
    mob:despawn()
    expectNoErrors()
end

@test("warn slots and target-less grey debuffs; a large aura makes the row taller")
