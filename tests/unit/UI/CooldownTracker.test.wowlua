end

@test("weapon enchants: shown by their mode, gone without a weapon")
local function enchants()
    local t = tracker({
        buffs = {
            { enchant = "main", name = "MH" },
            { enchant = "off", missing = "hide" },
            { enchant = "ranged", missing = "grey" },
        },
    })
    local main, off, ranged = t.built.buffs[1] :: TrackerEnchant,
        t.built.buffs[2] :: TrackerEnchant,
        t.built.buffs[3] :: TrackerEnchant
    expect(main.enchant).toBe(true)
    expect(main.missing).toBe("warn")
    expect(main).toBeShown()
    expect(off.wantShown).toBe(false)
    expect(off).never.toBeShown()
    expect(ranged.missing).toBe("grey")
    -- in combat a warning greys unless it warns in combat
    mock.player:enterCombat()
    expect(main.missing).toBe("grey")
    mock.player:leaveCombat()
    expect(main.missing).toBe("warn")
    -- no weapon to enchant
    enchantable = false
    events.emit("SUUUI_WEAPON_ENCHANTS_CHANGED")
    expect(main).never.toBeShown()
    local w = tracker({ buffs = { { enchant = "main", warnCombat = true } } })
    mock.player:enterCombat()
    expect((w.built.buffs[1] :: TrackerEnchant).missing).toBe("warn")
    mock.player:leaveCombat()
end

@test("aura sounds: registered per spell and unit, taken back on Stop")
local function auraSounds()
    local nextID = 0
    local removed: { unknown } = {}
    mock.fake("C_UnitAuras.AddAuraSound", function(_: unknown, data: unknown): unknown
        if data.spellID == UNKNOWN then
            error("refused")
        end
        nextID = nextID + 1
        return nextID
    end)
    mock.fake("C_UnitAuras.RemoveAuraSound", function(id: unknown)
        removed[#removed + 1] = id
    end)
    local t = tracker({
        buffs = { strike({ soundAppear = "chime", soundDrop = "nope" }) },
        procs = { { name = "P", ids = { OTHER }, soundStack = "proc" } },
        debuffs = { { name = "D", ids = { UNKNOWN }, soundAppear = "warning" } },
    })
    local ids, what = trackerAuraSounds()
    expect(#ids).toBe(3)
    expect(what[1]).toBe("Test Strike soundAppear " .. KNOWN_LOW .. " (player)")
    expect(what.error).never.toBeNil()
    t:Stop()
    expect(removed).toEqual({ 1, 2, 3 })
    local after, _ = trackerAuraSounds()
    expect(#after).toBe(0)
end

