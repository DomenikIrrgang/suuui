@test("a slot's live member: its own engine group, watched")
local function liveSlotMember()
    local t = tracker({
        buffs = {
            {
                group = true,
                name = "G",
                max = 2,
                ids = { KNOWN_LOW, OTHER },
                members = {
                    { name = "A", ids = { KNOWN_LOW } },
                    { name = "B", ids = { OTHER }, when = cond({ type = "combat" }) },
                },
            },
        },
    })
    expect(#t.built.buffs).toBe(1)
    expect(#t.liveGroups).toBe(1)
    expect(t.built.buffs[1]:GetWidth()).toBe(LG * 2 + SP["space-2"])
    -- a slot with a live condition of its own shows in place
    local u = tracker({ buffs = { strike({ when = cond({ type = "combat" }) }) } })
    expect(u.built.buffs[1]).never.toBeShown()
    mock.player:enterCombat()
    expect(u.built.buffs[1]).toBeShown()
    mock.player:leaveCombat()
end

@test("a rebuild takes back the slots, cells and containers it made")
local function reuse()
    local lists: TrackerLists = {
        essential = { strike() },
        buffs = { strike() },
        procs = { { name = "P", ids = { OTHER } } },
        debuffs = { strike({ missing = "remind" }) },
    }
    local t = tracker(lists)
    local cell, slot, reminder, flow = t.built.essential[1], t.built.buffs[1], t.built.remindDebuffs[1], t.leftFlow
    t:SetLists(lists)
    mock.advanceFrames(1)
    expect(t.built.essential[1]).toBe(cell)
    expect(t.built.buffs[1]).toBe(slot)
    expect(t.built.remindDebuffs[1]).toBe(reminder)
    expect(t.leftFlow).toBe(flow)
    expect(slot).toBeShown()
end
