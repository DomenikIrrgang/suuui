@test("the parts' functions, exported again: the same values")
local function reexports()
    expect(cooldownConditionMet).toBe(conditionsPart.cooldownConditionMet)
    expect(trackerSound).toBe(soundsPart.trackerSound)
    expect(trackerSoundFiles).toBe(soundsPart.trackerSoundFiles)
    expect(trackerAuraSounds).toBe(soundsPart.trackerAuraSounds)
    expect(mixins.CooldownTracker).never.toBeNil()
    expectNoErrors()
end
