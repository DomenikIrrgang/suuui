            strike(),
            {
                collection = true,
                uid = "c",
                entries = { strike(), strike(), { collection = true, entries = { strike() } } },
            },
            { collection = true, hidden = true, entries = { strike() } },
            { collection = true, when = cond({ type = "group", value = "raid" }), entries = { strike() } },
            strike({ hidden = true }),
        },
    })
