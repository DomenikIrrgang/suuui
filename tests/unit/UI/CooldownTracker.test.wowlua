@test("trackerSound: the file, else the sound kit; unknown plays nothing")
local function sounds()
    local played: { unknown } = {}
    mock.fake("PlaySoundFile", function(file: unknown, _: string): unknown
        played[#played + 1] = file
        return true
    end)
    mock.fake("PlaySound", function(kit: unknown, _: string): unknown
        played[#played + 1] = "kit" .. kit
        return true
    end)
    trackerSound("chime")
    expect(played).toEqual({ 567409 })
    mock.fake("PlaySoundFile", function(_: unknown, _: string): unknown
        return false
    end)
    trackerSound("ping")
    expect(played[2]).toBe("kit" .. SOUNDKIT.MAP_PING)
    trackerSound("nope")
    expect(#played).toBe(2)
    expect(assert(trackerSoundFiles().warning).file).toBe(567397)
end

--------------------------------------------------------------------------------
-- The tracker: cooldown cells
--------------------------------------------------------------------------------

const ESS = T.size["cdm-essential"]
const LG = T.size["icon-lg"]
const SP = T.space

@test("cells: the rank you know, unknown and hidden entries left out")
local function cells()
    local t = tracker({
        essential = { strike(), { name = "Nope", ids = { UNKNOWN } }, strike({ hidden = true }) },
        utility = { { name = "Overpower", ids = { OTHER } } },
    })
    expect(#t.built.essential).toBe(1)
    expect(#t.built.utility).toBe(1)
    local c = t.built.essential[1]
    expect(c.spellID).toBe(KNOWN_HIGH)
    expect(c:GetWidth()).toBe(ESS)
    expect(t.built.utility[1]:GetWidth()).toBe(LG)
    expect(t.built.utility[1].reactive).toBe(true)
    expect(#t.cells).toBe(2)
    -- utility on its own row under essential
    expect(t:GetWidth()).toBe(math.max(ESS, LG))
    expect(t:GetHeight()).toBe(LG + SP["space-3"] + ESS + SP["space-3"])
    expect(t.divider).never.toBeShown()
    expectNoErrors()
end

@test("utility inline: one row with a divider; the essential size option")
local function inline()
    local t = tracker({ essential = { strike() }, utility = { { name = "Overpower", ids = { OTHER } } } }, {
        utilityInline = true,
        essentialSize = 30,
    })
    expect(t.built.essential[1]:GetWidth()).toBe(30)
    expect(t.built.utility[1]:GetWidth()).toBe(30)
    expect(t.divider).toBeShown()
    expect(t:GetWidth()).toBe(30 + SP["space-4"] * 2 + 1 + 30)
    expect(t:GetHeight()).toBe(30 + SP["space-3"])
    -- inline with no essential cells
    local u = tracker({ utility = { { name = "Overpower", ids = { OTHER } } } }, { utilityInline = true })
    expect(u.divider).toBeShown()
end

@test("a group in a cooldown list: the last member you know; none: nothing")
local function groupCell()
    local t = tracker({
        essential = {
            {
                group = true,
                name = "G",
                ids = { KNOWN_LOW, OTHER },
                members = { { name = "A", ids = { KNOWN_LOW } }, { name = "B", ids = { OTHER } } },
            },
            { group = true, name = "None", ids = { UNKNOWN }, members = { { name = "X", ids = { UNKNOWN } } } },
            { group = true, name = "No IDs", members = { { name = "A", ids = { KNOWN_LOW } } } },
        },
    })
    expect(#t.built.essential).toBe(1)
    expect(t.built.essential[1].spellID).toBe(OTHER)
end

@test("cell states: cooldown dims, GCD keeps it ready, coming ready pops and plays")
local function cellStates()
    local played: { unknown } = {}
    mock.fake("PlaySoundFile", function(file: unknown, _: string): unknown
        played[#played + 1] = file
        return true
    end)
    local t = tracker({ essential = { strike({ sound = "chime" }) } })
    local c = t.built.essential[1]
    expect(c.icon.state).toBe("rest")
    expect(c.icon.borderToken).toBe("arcane")
    cooldowns[KNOWN_HIGH] = { active = true, gcd = true }
    t:UpdateCooldowns()
    expect(c.onCooldown).toBe(false)
    expect(c.cooldown:GetHideCountdownNumbers()).toBe(true)
    cooldowns[KNOWN_HIGH] = { active = true, gcd = false }
    t:UpdateCooldowns()
    expect(c.onCooldown).toBe(true)
    expect(c.icon.state).toBe("dim")
    expect(c.icon.borderToken).toBeNil()
    cooldowns[KNOWN_HIGH] = nil
    t:UpdateCooldowns()
    expect(c.onCooldown).toBe(false)
    expect(c.flash:GetAlpha() > 0.9).toBe(true)
    expect(played).toEqual({ 567409 })
    expectNoErrors()
end

@test("cell options: dim on cooldown, no pop, glow and pulse, borders")
local function cellOptions()
    local t = tracker({
        essential = { strike({ onCooldown = "dim", pop = false, ready = "pulse", border = "gilt" }) },
    }, { readyPop = true })
    local c = t.built.essential[1]
    expect(c.icon.borderToken).toBe("gilt")
    expect(c.icon.glowToken).toBe("glow-arcane")
    expect(c.pulse:IsPlaying()).toBe(true)
    t:UpdateCooldowns() -- keeps breathing
    expect(c.pulse:IsPlaying()).toBe(true)
    cooldowns[KNOWN_HIGH] = { active = true, gcd = false }
    t:UpdateCooldowns()
    expect(c.pulse:IsPlaying()).toBe(false)
    expect(c.icon.state).toBe("rest")
    expect(c:GetAlpha()).toBeCloseTo(T.opacity["opacity-oor"])
    cooldowns[KNOWN_HIGH] = nil
    t:UpdateCooldowns()
    expect(c.flash:GetAlpha()).toBe(0) -- no pop
    -- the global readyPop off
    local u = tracker({ essential = { strike({ ready = "glow" }) } }, { readyPop = false })
    local d = u.built.essential[1]
    expect(d.icon.glowToken).toBe("glow-arcane")
    cooldowns[KNOWN_HIGH] = { active = true }
    u:UpdateCooldowns()
    cooldowns[KNOWN_HIGH] = nil
    u:UpdateCooldowns()
    expect(d.flash:GetAlpha()).toBe(0)
end

@test("reactive abilities light up while usable; a secret answer is neutral")
local function reactive()
    local t = tracker({ essential = { { name = "Overpower", ids = { OTHER } } } })
    local c = t.built.essential[1]
    expect(c.reactive).toBe(true)
    expect(c.icon.state).toBe("ready")
    expect(c.ring.top).toBeShown()
    usable[OTHER] = { mock.secret(true), false }
    t:UpdateCooldowns()
    expect(c.icon.state).toBe("rest")
    expect(c.ring.top).never.toBeShown()
    usable[OTHER] = { false, false }
    t:UpdateCooldowns()
    expect(c:GetAlpha()).toBeCloseTo(T.opacity["opacity-disabled"])
end

@test("show only when ready, only on cooldown; hide on cooldown or unusable")
local function showModes()
    local t = tracker({
        essential = { strike({ show = "ready" }), { name = "Overpower", ids = { OTHER }, show = "cooldown" } },
    })
    local ready, cd = t.built.essential[1], t.built.essential[2]
    expect(ready).toBeShown()
    expect(cd).never.toBeShown()
    local w = t:GetWidth()
    cooldowns[KNOWN_HIGH] = { active = true }
    cooldowns[OTHER] = { active = true }
    t:UpdateCooldowns()
    expect(ready).never.toBeShown()
    expect(cd).toBeShown()
    expect(t:GetWidth()).toBe(w)
    local u = tracker({
        essential = { strike({ onCooldown = "hide" }), { name = "Overpower", ids = { OTHER }, unusable = "hide" } },
    })
    expect(u.built.essential[1]).never.toBeShown()
    usable[OTHER] = { false, true }
    u:UpdateCooldowns()
    expect(u.built.essential[2]).toBeShown() -- on cooldown: not "unusable"
    cooldowns[OTHER] = nil
    u:UpdateCooldowns()
    expect(u.built.essential[2]).never.toBeShown()
end

@test("the driver: events mark it dirty; a finished sweep marks its cell")
local function driver()
    local t = tracker({ essential = { strike() } })
    local c = t.built.essential[1]
    local reads = 0 -- (the Cooldown Manager's own tracker reads its spells too)
    mock.fake("C_Spell.GetSpellCooldown", function(id: number): unknown
        if id == KNOWN_HIGH then
            reads = reads + 1
        end
        return nil
    end)
    mock.advanceFrames(2)
    expect(reads).toBe(0)
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    mock.advanceFrames(1)
    expect(reads).toBe(1)
    mock.script(c.cooldown, "OnCooldownDone")
    expect(c.dirty).toBe(true)
    mock.advanceFrames(1)
    expect(reads).toBe(2)
    expect(c.dirty).toBe(false)
end

@test("learning a rank rebuilds; the same ranks don't")
local function learn()
    local t = tracker({ essential = { strike() } })
    local sig = t.knownSig
    mock.fireEvent("SPELLS_CHANGED")
    expect(t.rebuild).toBeFalsy()
    forgotHigh = true
    mock.defineSpell(KNOWN_HIGH, { name = "Test Strike", iconID = 1002, known = false })
    mock.fireEvent("SPELLS_CHANGED")
    expect(t.rebuild).toBe(true)
    mock.advanceFrames(1)
    expect(t.knownSig).never.toBe(sig)
    expect(t.built.essential[1].spellID).toBe(KNOWN_LOW)
end

@test("a static condition's change rebuilds half a second later")
local function staticChange()
    local t = tracker({ essential = { strike({ when = cond({ type = "role", roles = { "TANK" } }) }) } })
    expect(#t.built.essential).toBe(0)
    expect(t.condSig).toBe("u")
    role = "TANK"
    -- (game events like GROUP_ROSTER_UPDATE fired by a test run Blizzard's
    -- handlers as SuuUI's code: the role message stands in for them)
    events.emit("SUUUI_ROLE_CHANGED", roles.Role.Tank)
    events.emit("SUUUI_ROLE_CHANGED", roles.Role.Tank) -- one look for the burst
    expect(t.rebuild).toBeFalsy()
    mock.advanceTime(0.6)
    expect(t.rebuild).toBe(true)
    mock.advanceFrames(1)
    expect(#t.built.essential).toBe(1)
    -- nothing changed: no rebuild
    events.emit("SUUUI_ROLE_CHANGED", roles.Role.Tank)
    mock.advanceTime(0.6)
    expect(t.rebuild).toBeFalsy()
    -- talents: read again
    mock.fireEvent("TRAIT_CONFIG_UPDATED", 1)
    mock.advanceTime(0.6)
    expect(t.rebuild).toBeFalsy()
    -- stopped meanwhile: no rebuild
    events.emit("SUUUI_ROLE_CHANGED", roles.Role.Tank)
    role = "DAMAGER"
    t:Stop()
    mock.advanceTime(0.6)
    expect(t.rebuild).toBeFalsy()
end

@test("a rebuild waits for the end of combat, except the first")
local function combatRebuild()
    local t = tracker({ essential = { strike() } })
    mock.player:enterCombat()
    expect(t.inFight).toBe(true)
    t:SetLists({ essential = {} })
    mock.advanceFrames(2)
    expect(#t.built.essential).toBe(1)
    mock.player:leaveCombat()
    expect(t.inFight).toBe(false)
    mock.advanceFrames(2)
    expect(#t.built.essential).toBe(0)
    -- a new tracker builds even in combat
    mock.player:enterCombat()
    local u = tracker({ essential = { strike() } })
    expect(#u.built.essential).toBe(1)
    mock.player:leaveCombat()
end

@test("Stop hands everything back and goes quiet; Start builds again, reusing cells")
local function stopStart()
    local t = tracker({ essential = { strike() } })
    local c = t.built.essential[1]
    t:Stop()
    t:Stop()
    expect(t.running).toBe(false)
    expect(c).never.toBeShown()
    expect(#t.cells).toBe(0)
    expect(t.knownSig).toBeNil()
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    expect(t.dirty).toBeFalsy()
    t:Start()
    t:Start()
    mock.advanceFrames(1)
    expect(t.built.essential[1]).toBe(c)
    expect(c).toBeShown()
    -- Start without lists: nothing to build
    local p = parent :: Frame
    local bare: CooldownTracker = cooldownTracker(p, nil)
    trackers[#trackers + 1] = bare
    mock.advanceFrames(1)
    expect(#bare.cells).toBe(0)
end

