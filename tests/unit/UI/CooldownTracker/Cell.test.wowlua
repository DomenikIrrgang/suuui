-- UI/CooldownTracker/Cell: a cooldown cell's reads. (The cell's states,
-- options and reactive look are driven through the tracker:
-- UI/CooldownTracker's tests.)

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import internal cooldownFlags from "/UI/CooldownTracker/Cell"
import expectNoErrors from "../../../helpers"

@test("cooldownFlags: unknown reads as not active")
local function flags()
    -- (a secret isOnGCD, which the declarations don't allow for)
    local onGCD: unknown = mock.secret(true)
    local info: SpellCooldownInfoSecret = {
        startTime = 0,
        duration = 0,
        isEnabled = true,
        isActive = true,
        modRate = 1,
        isOnGCD = onGCD :: boolean,
    }
    local a, g = cooldownFlags(info)
    expect(a).toBe(true)
    expect(g).toBe(false)
    a, g = cooldownFlags(nil)
    expect(a).toBe(false)
    expect(g).toBe(false)
    local plain: SpellCooldownInfo = { startTime = 0, duration = 0, isEnabled = true, isActive = true, modRate = 1 }
    a, g = cooldownFlags(mock.secret(plain))
    expect(a).toBe(false)
    expect(g).toBe(false)
    expectNoErrors()
end
