-- UI/DealMark: a deal's mark: micro text in arcane on arcane-soft with a
-- 1px arcane edge, sized to its text with space-2 either side; a new text
-- sizes it again, as does a theme's spacing.

import test, expect, afterEach from "wowlua:test"
import tokens as T from "/Core/Tokens"
import dealMark from "/UI/DealMark"
import expectNoErrors, newParent, layoutThemes, useTheme, COMPACT from "../../helpers"
import tokenOf from "./WindowsHelpers"

local S = T.space
local parent: Frame? = nil

@afterEach
local function cleanup()
    useTheme(nil)
    if parent then
        parent:Hide()
    end
    parent = nil
    expectNoErrors()
end

@test("the look: arcane micro text on arcane-soft, an arcane edge; sized to its text")
local function look()
    parent = newParent()
    local mark = dealMark(assert(parent), "26% under")
    expect(mark.label:GetText()).toBe("26% under")
    expect(tokenOf(mark.label)).toBe("arcane")
    expect(tokenOf(mark.bg)).toBe("arcane-soft")
    expect(mark.edge.top).toBeShown()
    local w = math.ceil(mark.label:GetUnboundedStringWidth())
    expect(mark:GetWidth()).toBe(w + S["space-2"] * 2 + 2)
    expect(mark:GetHeight()).toBe(T.type.micro.lineHeight + 4)
    -- another text: its own width
    mark:SetValue("Under vendor")
    expect(mark.value).toBe("Under vendor")
    expect(mark:GetWidth()).toBe(math.ceil(mark.label:GetUnboundedStringWidth()) + S["space-2"] * 2 + 2)
    -- none given: empty, still a frame to place
    expect(dealMark(assert(parent)).label:GetText()).toBe("")
end

@test("a theme's spacing: sized again; SuuUI's again exactly")
local function spacing()
    layoutThemes()
    parent = newParent()
    local mark = dealMark(assert(parent), "Under vendor")
    local design = mark:GetWidth()
    useTheme(COMPACT)
    expect(mark:GetWidth()).toBe(math.ceil(mark.label:GetUnboundedStringWidth()) + T.space["space-2"] * 2 + 2)
    useTheme(nil)
    expect(mark:GetWidth()).toBe(design)
end
