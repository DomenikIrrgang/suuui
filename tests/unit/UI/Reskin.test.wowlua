@test("Blizzard's scrolling text: measured again a frame after the pass and each text")
local function scrollingFont()
    -- (the character window's side pane holds one, its font named)
    local pane = CreateFrame("Frame", nil, host(), "CharacterFrameSidePaneTemplate") :: any
    pane:SetSize(220, 200)
    pane:SetPoint("CENTER")
    local f = pane.Description
    f:SetHeight(60)
    f:SetText("A description long enough to wrap onto a few lines in the box.")
    reskin(f)
    mock.advanceFrames(2)
    local container = f:GetFontStringContainer()
    expect(container:GetHeight()).toBeCloseTo(f:GetFontString():GetStringHeight())
    f:SetText("Shorter")
    mock.advanceFrames(2)
    expect(container:GetHeight()).toBeCloseTo(f:GetFontString():GetStringHeight())
    -- a second pass: one hook
    reskin(f)
    expect(f.suuScrollingFont).toBe(true)
end

