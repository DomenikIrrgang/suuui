@test("reskinDialog: Blizzard's small dialog as a SuuUI panel; its close as the cross")
local function dialogPanel()
    local f = CreateFrame("Frame", "SuuUITestDialog", host(), "BasicFrameTemplate") :: any
    f:SetSize(300, 200)
    f:SetPoint("CENTER")
    f.TitleText:SetText("Guild Information")
    local box = CreateFrame("Frame", nil, f) :: any
    box:SetSize(260, 120)
    box:SetPoint("CENTER")
    box.NineSlice = CreateFrame("Frame", nil, box)
    local edit = CreateFrame("EditBox", nil, CreateFrame("ScrollFrame", nil, box)) :: any
    edit:SetAutoFocus(false)
    local small = CreateFrame("Frame", nil, f) :: any
    small:SetSize(20, 20)
    reskinDialog(f)
    expect(f.suuDialog).toBe(true)
    expect(f.TitleBg:GetAlpha()).toBe(0)
    expect(tokenOf(f.TitleText)).toBe("gilt-text")
    expect(f.TitleText.suuSkip).toBe(true)
    expect(f.CloseButton).toHaveSize(22, 22)
    expect(f.CloseButton).toBeAnchoredTo(f, "TOPRIGHT", "TOPRIGHT")
    expect(box.suuBox).toBe(true)
    expect(box.NineSlice:GetAlpha()).toBe(0)
    expect(edit.suuEdit).toBe(true)
    expect(tokenOf(edit)).toBe("ink")
    expect(small.suuBox).toBeNil()
    mock.hover(f.CloseButton)
    mock.hover(nil)
    -- again: the pass only; the close still Blizzard's
    reskinDialog(f)
    mock.click(f.CloseButton)
    expect(f).never.toBeShown()
    reskinDialog(nil)
end

local POPUP = "SUUUI_TEST_POPUP"

@test("reskinPopup: the shared popup in SuuUI's look while it shows; undone after")
local function popup()
    local accepted = mock.spy()
    StaticPopupDialogs[POPUP] = { text = "Set the note for %s", button1 = ACCEPT, button2 = CANCEL, hasEditBox = true,
        OnAccept = function() accepted() end, timeout = 0, whileDead = true, hideOnEscape = true }
    local dialog = StaticPopup_Show(POPUP, "Tamsin Ashford") :: any
    expect(dialog).never.toBeNil()
    local text = dialog.Text
    local r0, g0, b0 = text:GetTextColor()
    reskinPopup(dialog)
    expect(sameColor("ink", text:GetTextColor())).toBe(true)
    reskinPopup(dialog) -- again while shown: from the game's look
    expect(sameColor("ink", text:GetTextColor())).toBe(true)
    local container = dialog.ButtonContainer
    local accept = (container and container.Button1) or dialog.button1
    expect(sameColor("on-signal", accept:GetFontString():GetTextColor())).toBe(true)
    local cancel = (container and container.Button2) or dialog.button2
    mock.hover(cancel)
    mock.hover(nil)
    mock.click(accept)
    expect(accepted).toHaveBeenCalledTimes(1)
    expect(dialog).never.toBeShown()
    -- hidden: the game's look again
    local r, g, b = text:GetTextColor()
    expect({ r, g, b }).toEqual({ r0, g0, b0 })
    reskinPopup(nil)
end

@test("the game's parts by name or key: only widgets of the asked type")
local function readers()
    local f = CreateFrame("Frame", nil, host())
    local b = CreateFrame("Button", nil, f)
    local tex, fs = f:CreateTexture(), f:CreateFontString()
    expect(named("UIParent")).toBe(UIParent)
    expect(part(nil, "x")).toBeNil()
    expect(part({ x = 1 }, "x")).toBe(1)
    expect(asFrame(nil)).toBeNil()
    expect(asFrame({})).toBeNil()
    expect(asFrame({ IsObjectType = function() error("forbidden") end })).toBeNil()
    expect(asFrame(b)).toBe(b)
    expect(asButton(f)).toBeNil()
    expect(asButton(b)).toBe(b)
    local cb = CreateFrame("CheckButton", nil, f)
    expect(asCheckButton(cb)).toBe(cb)
    local e = CreateFrame("EditBox", nil, f)
    expect(asEditBox(e)).toBe(e)
    local sf = CreateFrame("ScrollFrame", nil, f)
    expect(asScrollFrame(sf)).toBe(sf)
    expect(asFontString(fs)).toBe(fs)
    expect(asTexture(tex)).toBe(tex)
    expect(asTexture(fs)).toBeNil()
    expect(asRegion(tex)).toBe(tex)
end

@test("SuuUI's own frames and textures: marked, or a plugin's suuOwn")
local function marks()
    local f = CreateFrame("Frame", nil, host())
    local t = f:CreateTexture()
    expect(isOwn(nil)).toBe(false)
    expect(isOwn(f)).toBe(false)
    markOwn(f)
    expect(isOwn(f)).toBe(true)
    expect(isOwn({ suuOwn = true })).toBe(true)
    expect(isArt(nil)).toBe(false)
    expect(isArt(t)).toBe(false)
    markArt(t)
    expect(isArt(t)).toBe(true)
end
