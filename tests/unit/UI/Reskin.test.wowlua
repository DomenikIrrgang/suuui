end

@test("reskin: the parts inside a frame, by kind; SuuUI's own frames left out")
local function passChildren()
    local f = CreateFrame("Frame", nil, host()) :: any
    f:SetSize(300, 200)
    local status = CreateFrame("StatusBar", nil, f) :: any
    status:SetStatusBarTexture(WHITE)
    local cb = CreateFrame("CheckButton", nil, f, "UICheckButtonTemplate") :: any
    local noCheck = CreateFrame("CheckButton", nil, f, "UICheckButtonTemplate") :: any
    noCheck.suuNoCheck = true
    local eb = CreateFrame("EditBox", nil, f, "InputBoxTemplate") :: any
    eb:SetAutoFocus(false)
    local dd = CreateFrame("DropdownButton", nil, f, "WowStyle1DropdownTemplate") :: any
    local fill = CreateFrame("Frame", nil, f, "ColoredProgressBarTemplate") :: any
    local ownFill = CreateFrame("Frame", nil, f) :: any
    ownFill.Fill = ownFill:CreateTexture()
    ownFill.Fill:SetAtlas("ui-stat-bar-blue")
    local collapse = CreateFrame("Button", nil, f) :: any
    f.CollapseButton = collapse
    collapse:SetNormalTexture("Interface\\Buttons\\UI-MinusButton-Up")
    local panel = CreateFrame("Button", nil, f, "UIPanelButtonTemplate") :: any
    local noButton = CreateFrame("Button", nil, f, "UIPanelButtonTemplate") :: any
    noButton.suuNoButton = true
    local scroll = CreateFrame("EventFrame", nil, f, "MinimalScrollBar") :: any
    local own = CreateFrame("Frame", nil, f) :: any
    own.suuOwn = true
    local ownText = own:CreateFontString(nil, "OVERLAY", "GameFontNormal")
    ownText:SetTextColor(1, 0.82, 0)
    local arrowButton = CreateFrame("Button", nil, f) :: any
    arrowButton.Arrow = arrowButton:CreateTexture()
    arrowButton.Text = arrowButton:CreateFontString(nil, "OVERLAY", "GameFontNormal")
    reskin(f)
    expect(status.suuTrack).never.toBeNil()
    expect(cb.suuCheck).never.toBeNil()
    expect(noCheck.suuCheck).toBeNil()
    expect(eb.suuEdit).toBe(true)
    expect(dd.suuDropdown).toBe(true)
    expect(arrowButton.suuDropdown).toBe(true)
    expect(fill.suuFillBar).toBe(true)
    expect(ownFill.suuFillBar).toBe(true)
    expect(collapse.suuCollapse).never.toBeNil()
    expect(collapse:GetParentKey()).toBe("CollapseButton")
    expect(panel.suuButton).never.toBeNil()
    expect(noButton.suuButton).toBeNil()
    expect(scroll.suuReskinned).toBe(true)
    expect(tokenOf(ownText)).toBeNil()
    -- again: the buttons drawn again
    panel:Disable()
    reskin(f)
    expect(panel:GetAlpha()).toBeCloseTo(T.opacity["opacity-disabled"], 2)
end

@test("reskin: seven levels deep at most")
local function depth()
    local f = CreateFrame("Frame", nil, host()) :: any
    local cur = f
    local texts: any[] = {}
    for i = 1, 8 do
        cur = CreateFrame("Frame", nil, cur)
        local s = cur:CreateFontString(nil, "OVERLAY", "GameFontNormal")
        s:SetTextColor(1, 0.82, 0)
        texts[i] = s
    end
    reskin(f)
    expect(tokenOf(texts[6])).toBe("ink")
    expect(tokenOf(texts[7])).toBeNil()
end

@test("reskinScrollBox: Blizzard's list, its rows now and after each update")
local function scrollBox()
    local p = host()
    local box = CreateFrame("Frame", nil, p, "WowScrollBoxList") :: any
    box:SetSize(200, 200)
    box:SetPoint("CENTER")
    local bar = CreateFrame("EventFrame", nil, p, "MinimalScrollBar")
    local view = CreateScrollBoxListLinearView()
    view:SetElementExtent(20)
    view:SetElementInitializer("Button", function(row: any, data: any)
        row.label = row.label or row:CreateFontString(nil, "OVERLAY", "GameFontNormal")
        row.label:SetAllPoints()
        row.label:SetTextColor(1, 0.82, 0)
        row.label:SetText(data.name)
    end)
    ScrollUtil.InitScrollBoxListWithScrollBar(box, bar, view)
    local provider = CreateDataProvider({ { name = "Alpha" }, { name = "Beta" } })
    box:SetDataProvider(provider)
    reskinScrollBox(box)
    expect(box.suuReskinBox).toBe(true)
    local seen = 0
    box:ForEachFrame(function(row: any)
        seen = seen + 1
        expect(tokenOf(row.label)).toBe("ink")
    end)
    expect(seen).toBe(2)
    -- an update: the new rows too
    provider:Insert({ name = "Gamma" })
    mock.advanceFrames(2)
    box:ForEachFrame(function(row: any) expect(tokenOf(row.label)).toBe("ink") end)
    -- shown again: a frame later
    box:Hide()
    box:Show()
    mock.advanceFrames(1)
    reskinScrollBox(box)
    reskinScrollBox(nil)
end

@test("reskinScrollBox: a box without ForEachFrame walks its target's children")
local function scrollBoxPlain()
    local box = CreateFrame("Frame", nil, host()) :: any
    box.ScrollTarget = CreateFrame("Frame", nil, box)
    local row = CreateFrame("Frame", nil, box.ScrollTarget)
    local bar = row:CreateTexture()
    bar:SetAtlas("Options_ListExpand_Right-collapseexpand")
    local s = row:CreateFontString(nil, "OVERLAY", "GameFontNormal")
    s:SetText("Category")
    box.Shadows = CreateFrame("Frame", nil, box)
    reskinScrollBox(box)
    expect(tokenOf(s)).toBe("gilt-text")
    expect(box.Shadows:GetAlpha()).toBe(0)
end

@test("a pass over a frame with a ScrollBox reskins the box's rows")
local function passScrollBox()
    local f = CreateFrame("Frame", nil, host()) :: any
    local box = CreateFrame("Frame", nil, f, "WowScrollBoxList") :: any
    box:Init(CreateScrollBoxListLinearView())
    reskin(f)
    expect(box.suuReskinBox).toBe(true)
