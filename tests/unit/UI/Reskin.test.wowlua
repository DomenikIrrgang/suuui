-- UI/Reskin: Blizzard's parts in SuuUI's look. Each part has its own tests
-- (tests/unit/UI/Reskin/: Registry, Pieces, Menu, Pass, Popup); here what
-- spans them: the entry point's names are its parts' own, and the game's
-- shared frames (its menus, its StaticPopups) are left without hooks.

import test, expect, afterEach from "wowlua:test"
import * as frames from "wowlua:frames"
import * as reskinModule from "/UI/Reskin"
import reskinMenu, reskinPopup from "/UI/Reskin"
import * as registry from "/UI/Reskin/Registry"
import * as pieces from "/UI/Reskin/Pieces"
import * as menuPart from "/UI/Reskin/Menu"
import * as passes from "/UI/Reskin/Pass"
import * as popupPart from "/UI/Reskin/Popup"
import expectNoErrors from "../../helpers"
import host, resetHost, openMenu, PopupParts from "./Reskin/ReskinHelpers"

@afterEach
local function cleanup()
    resetHost()
    expectNoErrors()
end

@test("the entry point's names are its parts' own functions and class")
local function reexports()
    expect(reskinModule.markOwn).toBe(registry.markOwn)
    expect(reskinModule.isOwn).toBe(registry.isOwn)
    expect(reskinModule.markArt).toBe(registry.markArt)
    expect(reskinModule.isArt).toBe(registry.isArt)
    expect(reskinModule.leave).toBe(registry.leave)
    expect(reskinModule.reskinScrollBar).toBe(pieces.reskinScrollBar)
    expect(reskinModule.reskinStatusBar).toBe(pieces.reskinStatusBar)
    expect(reskinModule.reskinFillBar).toBe(pieces.reskinFillBar)
    expect(reskinModule.reskinIconButton).toBe(pieces.reskinIconButton)
    expect(reskinModule.reskinCheckButton).toBe(pieces.reskinCheckButton)
    expect(reskinModule.reskinButton).toBe(pieces.reskinButton)
    expect(reskinModule.reskinEditBox).toBe(pieces.reskinEditBox)
    expect(reskinModule.reskinCollapseButton).toBe(pieces.reskinCollapseButton)
    expect(reskinModule.openRoot).toBe(menuPart.openRoot)
    expect(reskinModule.reskinMenu).toBe(menuPart.reskinMenu)
    expect(reskinModule.reskinDropdown).toBe(menuPart.reskinDropdown)
    expect(reskinModule.reskin).toBe(passes.reskin)
    expect(reskinModule.reskinPart).toBe(passes.reskinPart)
    expect(reskinModule.reskinScrollBox).toBe(passes.reskinScrollBox)
    expect(reskinModule.reskinDialog).toBe(passes.reskinDialog)
    expect(reskinModule.PopupSkin).toBe(popupPart.PopupSkin)
    expect(reskinModule.reskinPopup).toBe(popupPart.reskinPopup)
    -- the class through the entry point makes the same skins
    local skin = reskinModule.PopupSkin.new(host(), "surface", "gilt-line")
    expect(skin).never.toBeShown()
    expect(skin:GetParent()).toBe(host())
    -- the reskin pass reaches its parts' work (a piece by kind)
    local f = CreateFrame("Frame", nil, host())
    local cb = CreateFrame("CheckButton", nil, f, "UICheckButtonTemplate")
    reskinModule.reskin(f)
    local made = 0
    for _, c in ipairs(frames.children(cb)) do
        if c:GetWidth() == 16 then
            made = made + 1
        end
    end
    expect(made).toBe(1)
end

local POPUP = "SUUUI_TEST_POPUP"

@test("reskinMenu and reskinPopup leave the game's shared frames as they are: no hooks on their own functions")
local function noHooksOnShared()
    -- (hooks on the game's shared menu frames made its menus SuuUI's: a
    -- choice doing a protected thing was refused, "Forbidden:
    -- GuildControlSetRank()", found in game)
    local owner = host()
    MenuUtil.CreateContextMenu(owner, function(_, root)
        root:CreateButton("Whisper", function() end)
        root:CreateButton("Invite", function() end)
    end)
    local menu = assert(openMenu())
    local reinit = rawget(menu :: {}, "ReinitializeAll")
    reskinMenu(menu)
    expect(rawget(menu :: {}, "SetScript")).toBeNil()
    expect(rawget(menu :: {}, "ReinitializeAll")).toBe(reinit)
    for _, c in ipairs(frames.children(menu)) do
        if c:GetObjectType() == "Button" then
            expect(rawget(c :: {}, "SetScript")).toBeNil()
        end
    end
    -- closed: the game's look back (SuuUI's panel hides with it)
    Menu.GetManager():CloseMenus()
    expect(openMenu()).toBeNil()
    StaticPopupDialogs[POPUP] = { text = "Sure?", button1 = ACCEPT, button2 = CANCEL, timeout = 0, whileDead = true }
    local dialog = assert(StaticPopup_Show(POPUP) :: PopupParts?)
    reskinPopup(dialog)
    expect(rawget(dialog :: {}, "SetScript")).toBeNil()
    StaticPopup_Hide(POPUP)
end
