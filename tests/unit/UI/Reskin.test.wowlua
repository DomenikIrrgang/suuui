    expect(child.NineSlice:GetAlpha()).toBe(0)
    expect(art:GetAlpha()).toBe(0)
    expect(e.NineSlice:GetAlpha()).toBe(0)
end

@test("reskinCollapseButton: SuuUI's minus or plus, following Blizzard's texture")
local function collapseButton()
    local b = CreateFrame("Button", nil, host()) :: any
    b:SetSize(16, 16)
    b:SetNormalTexture("Interface\\Buttons\\UI-MinusButton-Up")
    b:SetPushedTexture("Interface\\Buttons\\UI-MinusButton-Down")
    -- Blizzard's own click (set before SuuUI hooks it): the texture changed
    -- without a hooked method, so only the redraw after the click sees it
    b:SetScript("OnClick", function(self: any) self:GetNormalTexture():SetAtlas("ui-hud-minus") end)
    reskinCollapseButton(b)
    local glyph: any = nil
    for _, t in ipairs(texturesOf(b)) do if tokenOf(t) == "gilt-text" then glyph = t end end
    expect(glyph:GetTexture()).toBe(GLYPHS .. "minus.tga")
    expect(b:GetNormalTexture():GetAlpha()).toBe(0)
    b:SetNormalTexture("Interface\\Buttons\\UI-PlusButton-Up")
    expect(glyph:GetTexture()).toBe(GLYPHS .. "plus.tga")
    b:SetNormalAtlas("campaign-questlog-collapse-expanded")
    expect(glyph:GetTexture()).toBe(GLYPHS .. "minus.tga")
    b:SetNormalAtlas("ui-questtrackerbutton-expand")
    expect(glyph:GetTexture()).toBe(GLYPHS .. "plus.tga")
    -- a click: drawn again a frame later
    mock.click(b)
    mock.advanceFrames(1)
    expect(glyph:GetTexture()).toBe(GLYPHS .. "minus.tga")
    reskinCollapseButton(b)
    reskinCollapseButton(nil)
end

@test("isPanelButton: Left/Middle/Right art, a button atlas, a panel button texture")
local function panelButtons()
    local p = host()
    local a = CreateFrame("Button", nil, p, "UIPanelButtonTemplate")
    expect(isPanelButton(a) and true or false).toBe(true)
    local b = CreateFrame("Button", nil, p) :: any
    b:CreateTexture():SetAtlas("common-button-square-gray-up")
    expect(isPanelButton(b) and true or false).toBe(true)
    local c = CreateFrame("Button", nil, p) :: any
    c:CreateTexture():SetAtlas("ui-list-button-minus")
    expect(isPanelButton(c)).toBe(false)
    local d = CreateFrame("Button", nil, p) :: any
    d:SetNormalTexture("Interface\\Buttons\\UI-Panel-Button-Up")
    expect(isPanelButton(d) and true or false).toBe(true)
    local e = CreateFrame("Button", nil, p) :: any
    e:SetNormalTexture("Interface\\Icons\\INV_Misc_QuestionMark")
    expect(isPanelButton(e) and true or false).toBe(false)
end

--------------------------------------------------------------------------------
-- A pass over a frame
--------------------------------------------------------------------------------

@test("reskin: textures by atlas, texts by colour and size, a category row's head")
local function passTextures()
    local f = CreateFrame("Frame", nil, host()) :: any
    f:SetSize(200, 100)
    local hide = f:CreateTexture()
    hide:SetAtlas("Options_List_Active-scrollline")
    local check = f:CreateTexture()
    check:SetAtlas("common-icon-checkmark")
    local minimal = f:CreateTexture()
    minimal:SetAtlas("checkmark-minimal")
    local plus = f:CreateTexture()
    plus:SetAtlas("ui-hud-minus")
    local sel = f:CreateTexture(nil, "ARTWORK")
    sel:SetAtlas("pvpqueue-button-select")
    local hl = f:CreateTexture(nil, "HIGHLIGHT")
    local hover = f:CreateTexture()
    hover:SetAtlas("talents-hover")
    local plain = f:CreateTexture()
    local function fs(font: string, r: number, g: number, b: number, text: string): any
        local s = f:CreateFontString(nil, "OVERLAY", font)
        s:SetTextColor(r, g, b)
        s:SetText(text)
        return s
    end
    local yellow = fs("GameFontNormal", 1, 0.82, 0, "Strength")
    local grey = fs("GameFontNormalSmall", 0.5, 0.5, 0.5, "small grey")
    local purple = fs("GameFontNormal", 0.64, 0.21, 0.93, "Epic thing")
    local big = fs("GameFontNormalLarge", 1, 1, 1, "Title")
    local long = fs("GameFontNormalLarge", 1, 1, 1, string.rep("long text ", 6))
    local number = fs("NumberFontNormal", 1, 1, 1, "42")
    reskin(f)
    expect(hide:GetAlpha()).toBe(0)
    expect(check.suuMoved).toBe(true)
    expect(check).toHaveSize(12, 12)
    expect(minimal.suuMoved).toBeNil()
    expect(tokenOf(plus)).toBe("gilt-text")
    expect(plus:IsDesaturated()).toBe(true)
    expect(tokenOf(sel)).toBe("arcane-soft")
    expect(select(1, sel:GetDrawLayer())).toBe("BACKGROUND")
    expect(tokenOf(hl)).toBe("surface-raised")
    expect(hl:GetAlpha()).toBeCloseTo(0.6, 2)
    expect(tokenOf(hover)).toBe("surface-raised")
    expect(tokenOf(plain)).toBeNil()
    expect(tokenOf(yellow)).toBe("ink")
    expect(tokenOf(grey)).toBe("ink-muted")
    expect(tokenOf(purple)).toBeNil()
    expect({ purple:GetTextColor() }).toEqual({ purple:GetTextColor() })
    expect(tokenOf(big)).toBe("gilt-text")
    expect(tokenOf(long)).toBe("ink")
    expect(tokenOf(number)).toBe("ink")
    -- a second pass keeps a coloured text's token
    reskin(f)
    expect(tokenOf(yellow)).toBe("ink")
    expect(check.suuMoved).toBe(true)
    reskin(nil)
end

