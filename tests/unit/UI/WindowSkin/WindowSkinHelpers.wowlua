-- tests/unit/UI/WindowSkin/WindowSkinHelpers.wowlua
-- Shared by the WindowSkin tests (UI/WindowSkin and its parts Chrome, Row,
-- SecurePlacement): Blizzard's own window and tab templates to skin.
--
--   window(width)    a ButtonFrameTemplate frame, shown, `width` (400) wide
--   tab(f, i)        a PanelTabButtonTemplate button on f, the i-th
--   closeWindows()   hides every window made (each test's cleanup)
--   headH()          the design's header height (title line and tab row)

import tokens as T from "/Core/Tokens"

local S = T.space

export function headH(): number
    return S["space-5"] + T.type.header.lineHeight + S["space-3"] + S["space-2"] + T.type.header.lineHeight +
        S["space-3"]
end

-- The parts of Blizzard's ButtonFrameTemplate and PanelTabButtonTemplate the
-- tests reach.
export type ButtonWindow = Frame & { CloseButton: Button, NineSlice: Frame, PortraitContainer: Frame }
export type TabParts = Button & { Left: Texture, LeftActive: Texture }

local made: Frame[] = {}
local count = 0

-- One of Blizzard's windows: a ButtonFrameTemplate frame, shown, 400 wide.
export function window(width: number?): ButtonWindow
    count = count + 1
    local f = CreateFrame("Frame", "SuuUITestWindow" .. count, UIParent, "ButtonFrameTemplate") :: ButtonWindow
    f:SetSize(width or 400, 300)
    f:SetPoint("CENTER")
    f:Show()
    made[#made + 1] = f
    return f
end

export function tab(f: Frame, i: number): TabParts
    local b = CreateFrame("Button", (f:GetName() or "") .. "Tab" .. i, f, "PanelTabButtonTemplate") :: TabParts
    b:SetPoint("TOPLEFT", f, "BOTTOMLEFT", (i - 1) * 80, 0)
    return b
end

export function closeWindows()
    for _, f in ipairs(made) do
        f:Hide()
    end
    made = {}
end
