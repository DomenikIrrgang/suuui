-- UI/Notification: the entry the rest of SuuUI imports (the card and the
-- stack re-exported from UI/Notification/Card and UI/Notification/Stack),
-- and a theme's width and spacing on cards and stacks together.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import tokens as T from "/Core/Tokens"
import * as entry from "/UI/Notification"
import * as card from "/UI/Notification/Card"
import * as stackPart from "/UI/Notification/Stack"
import notification, notificationStack from "/UI/Notification"
import expectNoErrors, newParent, layoutThemes, useTheme, COMPACT, ROOMY from "../../helpers"

local S = T.space
local WIDTH = T.size["notice-w"]
local PAD = S["space-4"]

local parent: Frame? = nil

local function make()
    parent = parent or newParent()
    return notification(assert(parent))
end

local function stack(max: number?)
    parent = parent or newParent()
    return notificationStack(assert(parent), max and { max = max } or nil)
end

@afterEach
local function cleanup()
    mock.hover(nil)
    if parent then
        parent:Hide()
    end
    parent = nil
    mock.resetSpies()
    expectNoErrors()
end

@test("the entry re-exports the parts' own functions and classes")
local function reexports()
    expect(entry.notification).toBe(card.notification)
    expect(entry.Notification).toBe(card.Notification)
    expect(entry.notificationStack).toBe(stackPart.notificationStack)
    expect(entry.NotificationStack).toBe(stackPart.NotificationStack)
    expect(make():GetWidth()).toBe(WIDTH)
    expect(stack():CardFor("none")).toBeNil()
end

@test("a theme's width and spacing: cards and stacks laid out again live; SuuUI's again exactly")
local function themeLayout()
    layoutThemes()
    local n = make()
    n:SetData({
        category = "Loot",
        title = "You received an item",
        body = "A line of text under it.",
        duration = 10,
        remaining = 5,
    })
    local s = stack()
    local function look(): { w: number, h: number, pad: number, stack: number }
        local _, _, _, pad = n.head:GetPoint(1)
        return { w = n:GetWidth(), h = n:GetHeight(), pad = pad :: number, stack = s:GetWidth() }
    end
    local design = look()
    expect(design.w).toBe(WIDTH)
    expect(design.pad).toBe(PAD)
    useTheme(COMPACT)
    local compact = look()
    expect(compact.w).toBe(270)
    expect(compact.pad).toBe(5)
    expect(compact.stack).toBe(270)
    expect(compact.h < design.h).toBe(true)
    useTheme(ROOMY)
    expect(look().w).toBe(340)
    expect(look().pad).toBe(12)
    useTheme(nil)
    expect(look()).toEqual(design)
end
