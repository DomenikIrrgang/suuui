-- UI/WindowSkin: the entry the rest of SuuUI imports (the chrome, the
-- window row and secure placement re-exported from UI/WindowSkin/Chrome,
-- Row and SecurePlacement), SuuUI's Character window wearing the whole of
-- it, and a theme's spacing on a skinned window.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as entry from "/UI/WindowSkin"
import * as chromePart from "/UI/WindowSkin/Chrome"
import * as rowPart from "/UI/WindowSkin/Row"
import * as placementPart from "/UI/WindowSkin/SecurePlacement"
import skinWindow, chromeOf from "/UI/WindowSkin"
import internal tabSkins from "/UI/WindowSkin/Chrome"
import expectNoErrors, layoutThemes, useTheme, COMPACT from "../../helpers"
import tokenOf from "./WindowsHelpers"
import window, closeWindows from "./WindowSkin/WindowSkinHelpers"

@afterEach
local function cleanup()
    closeWindows()
    mock.hover(nil)
    mock.resetSpies()
    mock.advanceFrames(2)
    expectNoErrors()
end

@test("the entry re-exports the parts' own functions, classes and values")
local function reexports()
    expect(entry.skinWindow).toBe(chromePart.skinWindow)
    expect(entry.chromeOf).toBe(chromePart.chromeOf)
    expect(entry.isCoveredByWindow).toBe(chromePart.isCoveredByWindow)
    expect(entry.WindowChrome).toBe(chromePart.WindowChrome)
    expect(entry.WINDOW_HEAD_H).toBe(chromePart.WINDOW_HEAD_H)
    expect(entry.windowRow).toBe(rowPart.windowRow)
    expect(entry.layout).toBe(rowPart.layout)
    expect(entry.queue).toBe(rowPart.queue)
    expect(entry.centerWindow).toBe(rowPart.centerWindow)
    expect(entry.add).toBe(rowPart.add)
    expect(entry.SecurePlacer).toBe(placementPart.SecurePlacer)
    expect(entry.securePlacement).toBe(placementPart.securePlacement)
    local f = window()
    expect(chromeOf(f)).toBeNil()
    expect(chromePart.chromeOf(f)).toBeNil()
    local chrome = skinWindow(f, {})
    expect(chromePart.chromeOf(f)).toBe(chrome)
end

--------------------------------------------------------------------------------
-- A real one: SuuUI's Character window
--------------------------------------------------------------------------------

@test("CharacterFrame wears the chrome: header, tabs from its mode tabs, in the row")
local function characterFrame()
    local cf = CharacterFrame :: Frame & { NineSlice: Frame }
    local chrome = assert(chromeOf(cf))
    expect(chrome).never.toBeNil()
    expect(chrome.title).toHaveText("Character")
    expect(chrome.under).toBe("microMenu")
    expect(cf:GetFrameStrata()).toBe("HIGH")
    expect(cf.NineSlice:GetAlpha()).toBe(0)
    local tabs = assert(chrome.tabs)
    expect(#tabs > 0).toBe(true)
    -- opened the player's way (a click on SuuUI's micro menu, a secure
    -- click of Blizzard's micro button): from addon code Blizzard's status
    -- bars meet secret values tainted
    local button = _G["SuuUIMicroMenucharacter"] :: Button
    mock.script(button, "OnClick", "LeftButton", true)
    expect(cf).toBeShown()
    local chosen = 0
    for _, def in ipairs(tabs) do
        if tokenOf(assert(tabSkins[def.button]).label) == "gilt-text" then
            chosen = chosen + 1
        end
    end
    expect(chosen).toBe(1)
    mock.script(button, "OnClick", "LeftButton", true)
    expect(cf).never.toBeShown()
end

@test("a theme's spacing: a skinned window's header, title, rule and tabs laid out again; SuuUI's again exactly")
local function themeLayout()
    layoutThemes()
    local f = window()
    local chrome = skinWindow(f, { title = "Test", icon = "person", close = f.CloseButton, topInset = 20 })
    local function look(): { titleX: number, rule: number, rowMid: number, headH: number }
        local _, _, _, titleX = chrome.title:GetPoint(1)
        local _, _, _, rule = chrome.rule:GetPoint(1)
        return {
            titleX = titleX :: number,
            rule = rule :: number,
            rowMid = chrome.rowMid,
            headH = chrome.head:GetHeight(),
        }
    end
    local design = look()
    expect(design.titleX).toBe(12 + 15 + 8)
    useTheme(COMPACT)
    local compact = look()
    expect(compact.titleX).toBe(8 + 15 + 5)
    expect(compact.rule).toBe(8)
    expect(compact.rowMid).toBe(1 + 11)
    expect(compact.headH < design.headH).toBe(true)
    useTheme(nil)
    expect(look()).toEqual(design)
end
