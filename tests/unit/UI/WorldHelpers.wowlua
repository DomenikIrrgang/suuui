-- Helpers for the ui-world tests (map pins, tracker, professions, raid
-- planner, inventory, legacy).
--
--   tokenOf(region)    the colour token Draw last painted the region with
--                      (paint, paintFill, a Text's SetColor), nil if none
--   alphaOf(region)    the alpha multiplier it was painted with, nil if none
--   borderToken(b)     a Draw border's token (its top part's)
--   borderAlpha(b)     and its alpha multiplier

import internal paints from "/UI/Draw"
import Border from "/UI/Draw"

type Painted = { token?: string, alpha?: number }

export function tokenOf(region: Region): string?
    local p = ((paints :: any) :: { [Region]: Painted })[region]
    return p and p.token or nil
end

export function alphaOf(region: Region): number?
    local p = ((paints :: any) :: { [Region]: Painted })[region]
    return p and p.alpha or nil
end

export function borderToken(b: Border): string?
    return tokenOf(b.top)
end

export function borderAlpha(b: Border): number?
    return alphaOf(b.top)
end
