-- tests/unit/UI/Reskin/ReskinHelpers.wowlua
-- Shared by the Reskin tests (UI/Reskin and its parts in UI/Reskin/).
--
--   host()          a parent frame for a test's parts (made once per test)
--   resetHost()     what each test's @afterEach does before expectNoErrors:
--                   the mouse off, the game's menus closed, the parent hidden
--   skin(r)         what Reskin did to a part (empty: nothing)
--   openMenu()      the game's open root menu
--   GLYPHS, WHITE   the glyph folder and the white square
--   PopupParts      the parts of the game's StaticPopup these tests reach

import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import internal skins from "/UI/Reskin/Registry"
import type Skin from "/UI/Reskin/Registry"
import newParent from "../../../helpers"

export const GLYPHS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Glyphs\\"
export const WHITE = "Interface\\Buttons\\WHITE8X8"

local parent: Frame? = nil

export function host(): Frame
    local p = parent
    if not p then
        p = newParent(400, 300)
        parent = p
    end
    return p
end

export function resetHost()
    mock.hover(nil)
    local manager = Menu.GetManager()
    local open = manager:GetOpenMenu()
    if open then
        manager:CloseMenus()
    end
    if parent then
        parent:Hide()
    end
    parent = nil
    mock.advanceFrames(2)
end

-- What Reskin did to a part (empty: nothing).
export function skin(r: unknown): Skin
    local region = frames.asRegion(r)
    return region and skins[region] or {}
end

export function openMenu(): MenuProxy?
    return Menu.GetManager():GetOpenMenu()
end

export type PopupParts = Frame
    & {
        Text: FontString,
        button1: Button,
        button2: Button,
        ButtonContainer?: Frame & { Button1: Button, Button2: Button },
    }
