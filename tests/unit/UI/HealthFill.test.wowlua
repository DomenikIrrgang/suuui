-- UI/HealthFill: a health bar's fill: the unit-fill, a class colour, or a
-- tagged mob's slate with its stripes (made once, shown and hidden with the
-- look, following the fill, from the theme's "tapped" texture and stripe
-- colour).

import test, expect, afterEach from "wowlua:test"
import tokens as T from "/Core/Tokens"
import * as healthFill from "/UI/HealthFill"
import * as draw from "/UI/Draw"
import * as themes from "/Core/Themes"
import * as settings from "/Core/Settings"
import internal paints from "/UI/Draw"
import expectNoErrors, newParent from "../../helpers"

local parent: Frame? = nil

local function healthBar(): StatusBar
    local p = newParent(200, 40)
    parent = p
    local b = CreateFrame("StatusBar", nil, p)
    b:SetAllPoints()
    draw.skinBar(b, "health-bar")
    b:SetMinMaxValues(0, 100)
    b:SetValue(40)
    return b
end

-- the gradient a texture was last given, as { r1, g1, b1, r2, g2, b2 }
local gradients: { [Texture]: number[] } = setmetatable({}, { __mode = "k" })
local function watchGradient(t: Texture)
    hooksecurefunc(t, "SetGradient", function(_: Texture, _: string, from: ColorMixin, to: ColorMixin)
        local r1, g1, b1 = from:GetRGB()
        local r2, g2, b2 = to:GetRGB()
        gradients[t] = { r1, g1, b1, r2, g2, b2 }
    end)
end

local function near(a: number?, b: number): boolean
    return a ~= nil and math.abs(a - b) < 0.002
end

@afterEach
local function cleanup()
    settings.setAccount("castColor", nil)
    settings.setAccount("theme", nil)
    themes.apply()
    if parent then
        (parent :: Frame):Hide()
    end
    parent = nil
end

@test("tapped: the slate gradient, with the stripes over the fill in their colour")
local function tapped()
    local b = healthBar()
    local fill = b:GetStatusBarTexture()
    watchGradient(fill)
    healthFill.paint(b, "tapped")
    expect(healthFill.lookOf(b)).toBe("tapped")
    local g = assert(gradients[fill])
    -- #2b384a, deep, left; #5c738f, right
    expect(near(g[1], 0x2b / 255) and near(g[2], 0x38 / 255) and near(g[3], 0x4a / 255)).toBe(true)
    expect(near(g[4], 0x5c / 255) and near(g[5], 0x73 / 255) and near(g[6], 0x8f / 255)).toBe(true)
    local s = assert(healthFill.stripesOf(b))
    expect(s:IsShown()).toBe(true)
    expect(s:GetTextureFilePath()).toBe(T.texture.tapped)
    expect(s:GetHorizTile()).toBe(true)
    expect(s:GetVertTile()).toBe(true)
    local p = assert(paints[s])
    expect(p.token).toBe("unit-fill-tapped-stripe")
    local _, _, _, a = s:GetVertexColor()
    expect(near(a, 0.22)).toBe(true)
    -- it follows the fill: 40% of the bar
    expect((s:GetRight() or 0) - (s:GetLeft() or 0)).toBeCloseTo(80, 1)
    b:SetValue(10)
    expect((s:GetRight() or 0) - (s:GetLeft() or 0)).toBeCloseTo(20, 1)
    expectNoErrors()
end

@test("the stripes go with the look: the fill or a class colour hides them; tapped again shows the same ones")
local function stripesFollowLook()
    local b = healthBar()
    healthFill.paint(b, nil)
    expect(healthFill.stripesOf(b)).toBeNil()
    healthFill.paint(b, "tapped")
    local s = assert(healthFill.stripesOf(b))
    healthFill.paint(b, false)
    expect(s:IsShown()).toBe(false)
    healthFill.paint(b, "tapped")
    expect(healthFill.stripesOf(b)).toBe(s)
    expect(s:IsShown()).toBe(true)
    healthFill.paint(b, "class-mage")
    expect(s:IsShown()).toBe(false)
end

@test("a theme changes the stripes' texture and colour on a striped bar at once")
local function themed()
    local b = healthBar()
    healthFill.paint(b, "tapped")
    local s = assert(healthFill.stripesOf(b))
    themes.register({
        id = "test-stripes",
        colors = { ["unit-fill-tapped-stripe"] = { 1, 0, 0, 0.5 } },
        textures = { tapped = "Interface\\AddOns\\SuuUI\\Media\\Textures\\RingArc3.tga" },
    })
    settings.setAccount("theme", "test-stripes")
    themes.apply()
    expect(s:GetTextureFilePath()).toBe("Interface\\AddOns\\SuuUI\\Media\\Textures\\RingArc3.tga")
    expect(s:GetHorizTile()).toBe(true)
    local r, g, _, a = s:GetVertexColor()
    expect(near(r, 1) and near(g, 0) and near(a, 0.5)).toBe(true)
    settings.setAccount("theme", nil)
    themes.apply()
    expect(s:GetTextureFilePath()).toBe(T.texture.tapped)
    expectNoErrors()
end

-- the gradient with its alphas: { r1, g1, b1, a1, r2, g2, b2, a2 }
local castGradients: { [Texture]: number[] } = setmetatable({}, { __mode = "k" })
local function watchCast(t: Texture)
    hooksecurefunc(t, "SetGradient", function(_: Texture, _: string, from: ColorMixin, to: ColorMixin)
        local r1, g1, b1, a1 = from:GetRGBA()
        local r2, g2, b2, a2 = to:GetRGBA()
        castGradients[t] = { r1, g1, b1, a1 or 1, r2, g2, b2, a2 or 1 }
    end)
end

local function castDrawn(t: Texture, want: number[]): boolean
    local g = castGradients[t]
    if not g then
        return false
    end
    for i = 1, 8 do
        if not near(g[i], want[i]) then
            return false
        end
    end
    return true
end

-- the player's class colour, toned (both ends opaque)
local function classLook(): number[]
    local _, class = UnitClass("player")
    local r1, g1, b1, r2, g2, b2 = healthFill.classColors(assert(healthFill.classToken(class)))
    return { r1, g1, b1, 1, r2, g2, b2, 1 }
end

@test(
    "your cast fill: your class colour by default; the setting's The theme's: the pale gradient from before, or the theme's cast = \"class\""
)
local function castFill()
    local b = healthBar()
    local tex = b:GetStatusBarTexture()
    watchCast(tex)
    healthFill.paintCast(tex)
    expect(castDrawn(tex, classLook())).toBe(true)
    -- The theme's: SuuUI's own is the damage ghost's colour, clear to half
    settings.setAccount("castColor", "theme")
    themes.apply()
    expect(healthFill.castLook()).toBeNil()
    local gr, gg, gb = draw.rgba("ghost")
    expect(castDrawn(tex, { gr, gg, gb, 0, gr, gg, gb, 0.5 })).toBe(true)
    -- a theme's cast = "class": class colours under The theme's too
    themes.register({ id = "test-cast-class", cast = "class" })
    settings.setAccount("theme", "test-cast-class")
    themes.apply()
    expect(castDrawn(tex, classLook())).toBe(true)
    settings.setAccount("castColor", nil)
    themes.apply()
    expect(castDrawn(tex, classLook())).toBe(true)
    expectNoErrors()
end

@test("your cast fill under The theme's: a theme's cast-fill colours; without them its ghost and ink still reach it")
local function castThemed()
    local b = healthBar()
    local tex = b:GetStatusBarTexture()
    watchCast(tex)
    healthFill.paintCast(tex)
    settings.setAccount("castColor", "theme")
    -- its own cast colours
    themes.register({
        id = "test-cast-own",
        colors = { ["cast-fill-deep"] = { 0, 0, 1, 1 }, ["cast-fill"] = { 1, 0, 0, 0.8 } },
    })
    settings.setAccount("theme", "test-cast-own")
    themes.apply()
    expect(castDrawn(tex, { 0, 0, 1, 1, 1, 0, 0, 0.8 })).toBe(true)
    -- only ghost and ink: the cast colours follow them (as before they had their own)
    themes.register({ id = "test-cast-ghost", colors = { ghost = { 0, 1, 0, 0.6 }, ink = { 0.2, 0.3, 0.4 } } })
    settings.setAccount("theme", "test-cast-ghost")
    themes.apply()
    expect(castDrawn(tex, { 0, 1, 0, 0, 0, 1, 0, 0.6 })).toBe(true)
    local er, eg, eb = draw.rgba("cast-edge")
    expect(near(er, 0.2) and near(eg, 0.3) and near(eb, 0.4)).toBe(true)
    -- SuuUI's again
    settings.setAccount("theme", nil)
    themes.apply()
    local gr, gg, gb = draw.rgba("ghost")
    expect(castDrawn(tex, { gr, gg, gb, 0, gr, gg, gb, 0.5 })).toBe(true)
    settings.setAccount("castColor", nil)
    themes.apply()
    expectNoErrors()
end
