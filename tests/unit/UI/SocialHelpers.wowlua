-- tests/unit/UI/SocialHelpers.wowlua
-- Shared by the ui-social tests (GroupFinder, GroupFinderListed,
-- GroupFinderListing, GroupFinderWho, Guild, GuildControl, Social).
--
--   tokenOf(region)    the colour token Draw's paint keeps for a region (nil:
--                      none, or set raw)
--   alphaOf(region)    the alpha multiplier kept with that token
--   themeChanged()     what a theme change tells the components
--   host(w, h)         a fresh, shown parent; the component fills it
--   cleanup()          hides every host made so far (an @afterEach)

import internal paints from "/UI/Draw"
import * as events from "/Core/Events"
import newParent from "../../helpers"
import * as frames from "wowlua:frames"

export function tokenOf(region: unknown): string?
    local r = frames.asRegion(region)
    local p = r and paints[r]
    return p and p.token
end

export function alphaOf(region: unknown): number?
    local r = frames.asRegion(region)
    local p = r and paints[r]
    return p and p.alpha
end

export function themeChanged()
    events.emit("SUUUI_THEME_CHANGED", "test")
end

local hosts: Frame[] = {}

export function host(width: number = 900, height: number = 600): Frame
    local p = newParent(width, height)
    hosts[#hosts + 1] = p
    return p
end

export function cleanup()
    for _, h in ipairs(hosts) do h:Hide() end
    hosts = {}
    GameTooltip:Hide()
end
