-- Helpers for the ui-hud tests (action bars, meters, trackers).
--
--   tokenOf(region)    the colour token Draw last painted the region with
--                      (paint, paintFill, a border's part), nil if none
--   borderToken(b)     a Draw border's token (its top part's)

import internal paints from "/UI/Draw"
import type Border from "/UI/Draw"
import * as frames from "wowlua:frames"

export function tokenOf(region: unknown): string?
    local r = frames.asRegion(region)
    local p = r and paints[r]
    return p and p.token or nil
end

export function borderToken(b: Border): string?
    return tokenOf(b.top)
end
