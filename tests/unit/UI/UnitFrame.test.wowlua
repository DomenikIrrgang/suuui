@test("a secure button: target on left click, the menu on right click")
local function secureButton()
    local f = keep(uf.unitFrame(parent, "target", { name = "SuuUITestUnitFrame" }))
    expect(f:GetName()).toBe("SuuUITestUnitFrame")
    expect(f:GetAttribute("unit")).toBe("target")
    expect(f:GetAttribute("*type1")).toBe("target")
    expect(f:GetAttribute("*type2")).toBe("togglemenu")
    expect(f:IsProtected()).toBe(true)
    -- md by default: its bar and height tokens
    expect(f:GetWidth()).toBe(T.size["bar-md"])
    expect(f:GetHeight()).toBe(T.size["unit-md"])
    expect(f.you:IsShown()).toBe(false)
    expect(f.crest).toBeNil()
end

@test("secure = false: a plain button without attributes")
local function plainButton()
    local f = keep(uf.unitFrame(parent, "target", { secure = false, size = "lg", width = 300, height = 40, you = true }))
    expect(f:GetAttribute("unit")).toBeNil()
    expect({ f:GetSize() }).toEqual({ 300, 40 })
    expect(f.you:IsShown()).toBe(true)
end

@test("opts.frame: a header's button is styled, its attributes left alone")
local function headerButton()
    local b = CreateFrame("Button", nil, parent, "SecureUnitButtonTemplate")
    b:SetAttribute("unit", "raid3")
    local f = keep(uf.unitFrame(nil, "raid3", { frame = b, size = "sm" }))
    expect(f).toBe(b)
    expect(f:GetAttribute("*type1")).toBeNil()
    expect(f:GetHeight()).toBe(T.size["unit-sm"])
    -- in combat a header's button keeps the size the header gave it
    local c = CreateFrame("Button", nil, parent, "SecureUnitButtonTemplate")
    c:SetSize(33, 11)
    mock.player:enterCombat()
    keep(uf.unitFrame(nil, "raid4", { frame = c, size = "sm" }))
    mock.player:leaveCombat()
    expect({ c:GetSize() }).toEqual({ 33, 11 })
end

@test("anchor: the power line inset inside the double gilt frame")
local function anchorFrame()
    local f = keep(uf.unitFrame(parent, "player", { anchor = true, size = "lg" }))
    local _, _, _, x, y = f.power:GetPoint(1)
    expect({ x, y }).toEqual({ 3, 3 })
    f:SetState("danger", "Aggro")
    f:SetState(nil, nil)
    expect(tokenOf(f.border.parts[1])).toBe("gilt-line")
end

@test("crest and dragon: the classification's crest, or the game's dragon")
local function crests()
    local p = priest()
    local a = api(p)
    a.UnitIsPlayer = function(_: string): boolean return false end
    local class = "elite"
    a.UnitClassification = function(_: string): string return class end
    local f = preview(p, { crest = true }, a)
    expect(f.crest.kind).toBe("elite")
    expect(f.dragon:IsShown()).toBe(false)
    local g = preview(p, { crest = true, dragon = true }, a)
    expect(g.crest.kind).toBeNil()
    expect(g.dragon:IsShown()).toBe(true)
    class = "normal"
    g:UpdateIdentity()
    expect(g.dragon:IsShown()).toBe(false)
    -- ShowDragon without a crest does nothing
    local h = preview(p)
    h:ShowDragon(nil)
    expect(h.dragon).toBeNil()
end

@test("the tooltip: the unit's, then the frame's own lines")
local function tooltips()
    local f = keep(uf.unitFrame(parent, "player", {}))
    local lines = mock.spy()
    f.onTooltip = function(self: any, tip: any) lines(self, tip) end
    mock.hover(f)
    expect(GameTooltip:IsShown()).toBe(true)
    expect(lines).toHaveBeenCalledWith(f, GameTooltip)
    mock.hover(nil)
    expect(GameTooltip:IsShown()).toBe(false)
    -- no unit: nothing
    f.unit = nil
    mock.hover(f)
    expect(GameTooltip:IsShown()).toBe(false)
    mock.hover(nil)
end

--------------------------------------------------------------------------------
-- Health
--------------------------------------------------------------------------------

@test("health text: percent, value, both, none")
local function healthTexts()
    expect(preview(priest()).right:GetText()).toBe("64%")
    expect(preview(priest(), { healthText = "value" }).right:GetText()).toBe("2.7k")
    expect(preview(priest(), { healthText = "both" }).right:GetText()).toBe("2.7k · 64%")
    expect(preview(priest(), { healthText = "none" }).right:GetText()).toBe("")
    -- sm frames show none unless asked
    expect(preview(priest(), { size = "sm" }).right:GetText()).toBe("")
    expect(preview(priest(), { size = "sm", textOnSmall = true }).right:GetText()).toBe("64%")
end

@test("health text without a percent from the client")
local function healthTextNoPercent()
    local p = priest()
    local a = api(p)
    a.UnitHealthPercent = nil
    expect(preview(p, { lowHealth = false }, a).right:GetText()).toBe("")
    expect(preview(p, { lowHealth = false, healthText = "both" }, a).right:GetText()).toBe("2.7k")
end

@test("health text from secret parts goes through the engine's formatting")
local function healthTextSecret()
    local p = priest()
    local a = api(p)
    a.UnitHealthPercent = function(_: string, _: boolean, curve: any): any
        if curve == CurveConstants.ScaleTo100 then return mock.secret(64) end
        return 0
    end
    local f = preview(p, {}, a)
    expect(issecretvalue(f.right:GetText())).toBe(true)
    expect(f.right.value).toBeNil()
    local g = preview(p, { healthText = "both" }, a)
    expect(g.right.value).toBeNil()
    a.UnitHealth = function(_: string): any return mock.secret(2000) end
    local h = preview(p, { healthText = "value" }, a)
    expect(h.right.value).toBeNil()
    expectNoErrors()
end

@test("dead, ghost and offline: an empty bar, the word, a faint name")
local function gone()
    local dead = preview(priest({ dead = true }))
    expect(dead.right:GetText()).toBe("Dead")
    expect(dead.health:GetValue()).toBe(0)
    expect(tokenOf(dead.name)).toBe("ink-faint")
    expect(tokenOf(dead.right)).toBe("ink-muted")
    expect(dead.healthLow:GetAlpha()).toBe(0)
    expect(dead.incoming:GetValue()).toBe(0)
    local p = priest({ dead = true })
    local a = api(p)
    a.UnitIsGhost = function(_: string): boolean return true end
    expect(preview(p, {}, a).right:GetText()).toBe("Ghost")
    local off = preview(priest({ offline = true }))
    expect(off.right:GetText()).toBe("Offline")
    expect(off.power:IsShown()).toBe(false)
    expect(tokenOf(off.name)).toBe("ink-faint")
end

@test("dying and coming back: the name and power line follow")
local function deathChanges()
    local p = priest()
    local f = preview(p)
    local seen = mock.spy()
    f.onHealth = function(self: any) seen(self) end
    expect(tokenOf(f.name)).toBe("class-priest")
    p.dead = true
    f:UpdateHealth(true)
    expect(tokenOf(f.name)).toBe("ink-faint")
    expect(seen).toHaveBeenCalledTimes(1)
    p.dead, p.offline = false, true
    f:UpdateHealth(true)
    expect(f.power:IsShown()).toBe(false)
    p.offline = false
    f:UpdateHealth(true)
    expect(f.power:IsShown()).toBe(true)
    expect(tokenOf(f.name)).toBe("class-priest")
end

@test("low health: the low fill below 35%, never with lowHealth = false")
local function lowHealth()
    expect(preview(priest({ health = 0.2 })).healthLow:GetAlpha()).toBe(1)
    expect(preview(priest({ health = 0.5 })).healthLow:GetAlpha()).toBe(0)
    expect(preview(priest({ health = 0.2 }), { lowHealth = false }).healthLow:GetAlpha()).toBe(0)
end

@test("low tint: the empty part warms from 70% down")
local function lowTint()
    expect(preview(priest({ health = 0.05 }), { lowTint = true }).tint:GetAlpha()).toBeCloseTo(0.55)
    expect(preview(priest({ health = 0.4 }), { lowTint = true }).tint:GetAlpha()).toBeCloseTo(0.275)
    expect(preview(priest({ health = 0.05 })).tint:GetAlpha()).toBe(0)
    expect(preview(priest({ health = 0.05, dead = true }), { lowTint = true }).tint:GetAlpha()).toBe(0)
end

@test("the ghost bar trails the fill after a hold")
local function ghostTrail()
    local p = priest({ health = 1 })
    local f = preview(p)
    expect(f.ghost:GetValue()).toBe(4200)
    p.health = 0.5
    f:UpdateHealth()
    expect(f.health:GetValue()).toBe(2100)
    expect(f.ghost:GetValue()).toBe(4200)
    p.health = 0.25
    f:UpdateHealth() -- one timer: the hold isn't restarted
    mock.advanceTime(0.2)
    mock.advanceFrames(60)
    expect(f.ghost:GetValue()).toBeCloseTo(1050)
    -- instant: the ghost jumps, a pending hold is cancelled
    p.health = 1
    f:UpdateHealth()
    p.health = 0.5
    f:UpdateHealth(true)
    expect(f.ghost:GetValue()).toBe(2100)
    expect(f.ghostTimer).toBeNil()
    mock.advanceTime(0.5)
    expect(f.ghost:GetValue()).toBe(2100)
end

@test("incoming heals and absorbs, never with incoming = false")
local function incoming()
    local f = preview(priest({ incoming = 0.1, absorb = 0.2 }))
    expect(f.incoming:GetValue()).toBeCloseTo(420)
    expect(f.absorb:GetValue()).toBeCloseTo(840)
    local g = preview(priest({ incoming = 0.1, absorb = 0.2 }), { incoming = false })
    expect(g.incoming:GetValue()).toBe(0)
    expect(g.absorb:GetValue()).toBe(0)
end

