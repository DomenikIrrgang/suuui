-- UI/UnitFrame: the unit frame component (health, power, identity, the
-- row's layout, state badges, raid markers, buff indicators, debuff-type
-- and ward slots, events) and its pure helpers and stand-ins.
--
-- On this client health and power are secret even out of combat, so the
-- drawing logic is driven through a stand-in API (opts.api, unitStandIn)
-- with plain numbers; real mock units drive the events and the secret paths.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as uf from "/UI/UnitFrame"
import * as events from "/Core/Events"
import tokens as T from "/Core/Tokens"
import internal shortNumber, isOffline, healthPercent, metaText, belowCurve, lowTintCurve, inYourGroup,
    indicatorKey, pointOffset, LOW_HEALTH, difficultyColor, groupTierIn from "/UI/UnitFrame"
import internal paints from "/UI/Draw"
import expectNoErrors, newParent from "../../helpers"

type Person = { [string]: any }

local parent: Frame
local built: Frame[] = {}
local wolf: mock.MockUnit? = nil

-- the colour token a region was painted with (UI/Draw keeps it)
local function tokenOf(region: any): string?
    local p = paints[region]
    return p and p.token
end

local function keep(f: any): any
    built[#built + 1] = f
    return f
end

-- A stand-in API reading `person` for every unit.
local function api(person: Person): { [string]: any }
    return uf.unitStandIn(function(_: string): Person return person end)
end

-- A frame drawn from a stand-in person (refreshed, not activated).
local function preview(person: Person, opts: { [string]: any }?, a: { [string]: any }?): any
    local o: { [string]: any } = opts or {}
    o.api = a or api(person)
    local f = keep(uf.unitFrame(parent, "party1", o))
    f:SetPoint("TOPLEFT", parent, "TOPLEFT", 10, -10)
    f:Refresh()
    return f
end

local function priest(extra: Person?): Person
    local p: Person = { name = "Anna", class = "PRIEST", health = 0.64, power = 0.6 }
    for k, v in pairs(extra or {}) do p[k] = v end
    return p
end

@beforeEach
local function setUp()
    parent = newParent(400, 300)
end

@afterEach
local function tearDown()
    if InCombatLockdown() then mock.player:leaveCombat() end -- secure frames hide out of combat only
    for _, f in ipairs(built) do
        if (f :: any).Deactivate then (f :: any):Deactivate() end
        f:Hide()
    end
    built = {}
    parent:Hide()
    if wolf then
        mock.player:target(nil)
        ;(wolf :: mock.MockUnit):despawn()
        wolf = nil
    end
end

--------------------------------------------------------------------------------
-- Pure helpers
--------------------------------------------------------------------------------

@test("shortNumber: plain numbers in the short forms")
local function shortNumbers()
    expect(shortNumber(nil)).toBeNil()
    expect(shortNumber(412)).toBe("412")
    expect(shortNumber(411.6)).toBe("412")
    expect(shortNumber(8500)).toBe("8.5k")
    expect(shortNumber(12345)).toBe("12k")
    expect(shortNumber(123456)).toBe("123k")
    expect(shortNumber(1234567)).toBe("1.2m")
end

@test("shortNumber: a secret value goes to the engine's formatting")
local function shortNumberSecret()
    local out = shortNumber(mock.secret(12345))
    expect(out ~= nil).toBe(true)
    expectNoErrors()
end

@test("shortNumber: a secret the engine can't abbreviate falls back to %d")
local function shortNumberSecretFallback()
    local out = shortNumber(mock.secret(7), function(_: any): string error("no") end)
    expect(issecretvalue(out) or out == "7").toBe(true)
end

@test("isOffline: only a player whose plain answer is 'not connected'")
local function offline()
    local a: { [string]: any } = { UnitIsPlayer = function(_: string): boolean return true end }
    expect(isOffline(a, "party1")).toBe(false) -- no UnitIsConnected
    a.UnitIsConnected = function(_: string): any return false end
    expect(isOffline(a, "party1")).toBe(true)
    a.UnitIsConnected = function(_: string): any return true end
    expect(isOffline(a, "party1")).toBe(false)
    a.UnitIsConnected = function(_: string): any return mock.secret(false) end
    expect(isOffline(a, "party1")).toBe(false)
    a.UnitIsConnected = function(_: string): any return false end
    a.UnitIsPlayer = function(_: string): boolean return false end
    expect(isOffline(a, "party1")).toBe(false)
end

@test("healthPercent: nil without UnitHealthPercent")
local function healthPercentMissing()
    expect(healthPercent({}, "party1")).toBeNil()
    local a = api(priest())
    expect(healthPercent(a, "party1")).toBeCloseTo(64)
end

@test("metaText: level and classification")
local function metaTexts()
    local level: any, class: any = 10, "normal"
    local a: { [string]: any } = {
        UnitLevel = function(_: string): any return level end,
        UnitClassification = function(_: string): any return class end,
    }
    expect(metaText(a, "target")).toBe("10")
    class = "elite"
    expect(metaText(a, "target")).toBe("10 Elite")
    class = "rareelite"
    expect(metaText(a, "target")).toBe("10 Rare Elite")
    class = "rare"
    expect(metaText(a, "target")).toBe("10 Rare")
    class = "worldboss"
    expect(metaText(a, "target")).toBe("?? Boss")
    class, level = "normal", -1
    expect(metaText(a, "target")).toBe("??")
    level = nil
    expect(metaText(a, "target")).toBe("??")
    level = mock.secret(10)
    expect(metaText(a, "target")).toBe("")
    level, class = 10, mock.secret("elite")
    expect(metaText(a, "target")).toBe("")
end

@test("levelColor: unknown levels are impossible; the client's own colours")
local function levelColors()
    expect(uf.levelColor(nil)).toBe("quest-impossible")
    expect(uf.levelColor(0)).toBe("quest-impossible")
    expect(uf.levelColor(mock.secret(10))).toBe("quest-impossible")
    -- Blizzard's QuestDifficultyColors for a level-1 character (its
    -- "difficult" is the yellow of an even level)
    expect(uf.levelColor(1)).toBe("quest-difficult")
    expect(uf.levelColor(4)).toBe("quest-very-difficult")
    expect(uf.levelColor(60)).toBe("quest-impossible")
end

@test("difficultyColor: each difficulty font's colour")
local function difficultyColors()
    local font: any = "QuestDifficulty_VeryDifficult"
    local function get(_: number): any return { font = font } end
    expect(difficultyColor(5, get)).toBe("quest-very-difficult")
    font = "QuestDifficulty_Difficult"
    expect(difficultyColor(5, get)).toBe("quest-difficult")
    font = "QuestDifficulty_Impossible"
    expect(difficultyColor(5, get)).toBe("quest-impossible")
    font = "QuestDifficulty_Standard"
    expect(difficultyColor(5, get)).toBe("quest-standard")
    font = "QuestDifficulty_Trivial"
    expect(difficultyColor(5, get)).toBe("quest-trivial")
    font = "SomethingElse"
    expect(difficultyColor(5, get)).toBe("quest-standard")
    font = nil
    expect(difficultyColor(5, get)).toBe("quest-standard")
    expect(difficultyColor(5, function(_: number): any error("refused") end)).toBe("quest-standard")
    -- a client without difficulty colours
    expect(difficultyColor(5, nil)).toBe("quest-standard")
end

@test("unitFrameCurveValue: the step curves, the tint curve and others")
local function curveValues()
    local below = belowCurve(LOW_HEALTH)
    expect(belowCurve(LOW_HEALTH)).toBe(below) -- built once
    expect(uf.unitFrameCurveValue(below, 0.2)).toBe(1)
    expect(uf.unitFrameCurveValue(below, 0.35)).toBe(0)
    expect(uf.unitFrameCurveValue(below, 0.9)).toBe(0)
    local tint = lowTintCurve()
    expect(lowTintCurve()).toBe(tint)
    expect(uf.unitFrameCurveValue(tint, 0)).toBeCloseTo(0.55)
    expect(uf.unitFrameCurveValue(tint, 0.05)).toBeCloseTo(0.55)
    expect(uf.unitFrameCurveValue(tint, 0.4)).toBeCloseTo(0.275)
    expect(uf.unitFrameCurveValue(tint, 0.9)).toBeCloseTo(0)
    expect(uf.unitFrameCurveValue(tint, 1.5)).toBe(0)
    expect(uf.unitFrameCurveValue({}, 0.5)).toBeNil()
    expect(uf.unitFrameCurveValue(nil, 0.5)).toBeNil()
end

@test("pointOffset and indicatorKey")
local function indicatorHelpers()
    expect({ pointOffset("TOPLEFT") }).toEqual({ 2, -2 })
    expect({ pointOffset("BOTTOMRIGHT") }).toEqual({ -2, 2 })
    expect({ pointOffset("CENTER") }).toEqual({ 0, 0 })
    expect(indicatorKey({})).toBe("icon||10||mine|")
    expect(indicatorKey({ kind = "square", point = "TOP", size = 8, color = "fel", source = "any", ids = { 1, 2 } }))
        .toBe("square|TOP|8|fel|any|1,2")
end

@test("groupTier: party, and the raid's smallest tier")
local function groupTiers()
    expect(uf.groupTier(3)).toBe("5")
    expect(uf.groupTier(nil)).toBe("5")
    expect(uf.groupTier(8)).toBe("10")
    expect(uf.groupTier(15)).toBe("20")
    expect(uf.groupTier(30)).toBe("40")
    local raid: { [string]: any } = {
        IsInRaid = function(): boolean return true end,
        GetNumGroupMembers = function(): number return 4 end,
    }
    expect(groupTierIn(nil, raid)).toBe("10") -- a raid of four is a 10
    expect(groupTierIn(3, raid)).toBe("10")
    expect(groupTierIn(25, raid)).toBe("40")
    raid.GetNumGroupMembers = nil
    expect(groupTierIn(nil, raid)).toBe("10")
end

@test("indicatorsFor: by group size")
local function indicatorsForTier()
    local a: { [string]: any } = { name = "a" }
    local b: { [string]: any } = { name = "b", sizes = {} }
    local c: { [string]: any } = { name = "c", sizes = { ["10"] = true } }
    local d: { [string]: any } = { name = "d", sizes = { ["40"] = true } }
    expect(uf.indicatorsFor({ a, b, c, d }, "10")).toEqual({ a, b, c })
    expect(uf.indicatorsFor(nil, "5")).toEqual({})
end

@test("group indicators and defensives: set, versioned, announced")
local function groupLists()
    local list0, v0 = uf.groupIndicators()
    local d0, dv0 = uf.groupDefensives()
    local heard: string[] = {}
    local owner: { [string]: any } = {}
    events.on("SUUUI_INDICATORS_CHANGED", function(name: string) heard[#heard + 1] = name end, owner)
    events.on("SUUUI_DEFENSIVES_CHANGED", function(name: string) heard[#heard + 1] = name end, owner)
    local mine: { [string]: any }[] = { { name = "Renew", ids = { 139 } } }
    uf.setGroupIndicators(mine)
    local l1, v1 = uf.groupIndicators()
    expect(l1).toBe(mine)
    expect(v1).toBe(v0 + 1)
    uf.setGroupIndicators(nil)
    local l2 = uf.groupIndicators()
    expect(l2).toEqual({})
    local d: { [string]: number[] } = { external = { 1 }, defensive = {}, warded = {}, all = { 1 } }
    uf.setGroupDefensives(d)
    local d1, dv1 = uf.groupDefensives()
    expect(d1).toBe(d)
    expect(dv1).toBe(dv0 + 1)
    uf.setGroupDefensives(nil)
    local d2 = uf.groupDefensives()
    expect(d2).toEqual({ external = {}, defensive = {}, warded = {}, all = {} })
    events.offAll(owner)
    expect(heard).toEqual({ "SUUUI_INDICATORS_CHANGED", "SUUUI_INDICATORS_CHANGED", "SUUUI_DEFENSIVES_CHANGED", "SUUUI_DEFENSIVES_CHANGED" })
    uf.setGroupIndicators(list0)
    uf.setGroupDefensives(d0)
end

@test("unitStandIn: a made-up person through the Unit* functions")
local function standIn()
    local p: Person = { name = "Bo", class = "WARRIOR", health = 0.5, max = 1000, incoming = 0.1, absorb = 0.2,
        power = 0.3, role = "TANK", you = true, marker = 3, dead = true, offline = true }
    local a = api(p)
    expect(a.UnitExists("x")).toBe(true)
    expect(a.UnitIsDeadOrGhost("x")).toBe(true)
    expect(a.UnitIsGhost("x")).toBe(false)
    expect(a.UnitHealthMax("x")).toBe(1000)
    expect(a.UnitHealth("x")).toBe(500)
    expect(a.UnitGetIncomingHeals("x")).toBe(100)
    expect(a.UnitGetTotalAbsorbs("x")).toBe(200)
    expect({ a.UnitPowerType("x") }).toEqual({ 1, "RAGE" })
    expect(a.UnitPowerMax("x")).toBe(100)
    expect(a.UnitPower("x")).toBeCloseTo(30)
    expect(a.UnitHealthPercent("x", true, CurveConstants.ScaleTo100)).toBeCloseTo(50)
    expect(a.UnitHealthPercent("x", true, {})).toBe(0)
    expect(a.UnitPowerPercent("x", 1, true, belowCurve(0.25))).toBe(0)
    expect(a.UnitLevel("x")).toBe(60)
    expect(a.UnitClassification("x")).toBe("normal")
    expect(a.UnitGroupRolesAssigned("x")).toBe("TANK")
    expect(a.UnitIsPlayer("x")).toBe(true)
    expect({ a.UnitClass("x") }).toEqual({ "WARRIOR", "WARRIOR" })
    expect(a.UnitName("x")).toBe("Bo")
    expect(a.UnitReaction("x", "player")).toBe(5)
    expect(a.UnitCreatureFamily("x")).toBeNil()
    expect(a.UnitIsUnit("x", "player")).toBe(true)
    expect(a.UnitIsUnit("x", "target")).toBe(false)
    expect(a.UnitIsConnected("x")).toBe(false)
    expect(a.GetRaidTargetIndex("x")).toBe(3)
    -- the defaults
    local b = api({ name = "Cy", class = "ROGUE", health = 1 })
    expect(b.UnitIsDeadOrGhost("x")).toBe(false)
    expect(b.UnitHealthMax("x")).toBe(4200)
    expect(b.UnitGetIncomingHeals("x")).toBe(0)
    expect({ b.UnitPowerType("x") }).toEqual({ 3, "ENERGY" })
    expect(b.UnitPower("x")).toBeCloseTo(60)
    expect(b.UnitGroupRolesAssigned("x")).toBe("NONE")
    expect(b.UnitIsUnit("x", "player")).toBe(false)
    expect({ api({ class = "MAGE" }).UnitPowerType("x") }).toEqual({ 0, "MANA" })
end

@test("inYourGroup: everyone outside a raid; your raid subgroup inside one")
local function yourGroup()
    expect(inYourGroup("party1")).toBe(true) -- the game's: no raid
    local subs: { [number]: number? } = { [1] = 1, [2] = 2, [3] = 1 }
    local me = 3
    local secretMe = false
    local A: { [string]: any } = {
        IsInRaid = function(): boolean return true end,
        GetNumGroupMembers = function(): number return 3 end,
        GetRaidRosterInfo = function(i: number): (string, number, number?) return "x", 0, subs[i] end,
        UnitIsUnit = function(a: string, b: string): any
            if secretMe then return mock.secret(true) end
            return b == "player" and a == "raid" .. me
        end,
    }
    expect(inYourGroup("party1", A)).toBe(true) -- not a raid token
    expect(inYourGroup("raid1", A)).toBe(true)
    expect(inYourGroup("raid2", A)).toBe(false)
    subs[3] = nil
    expect(inYourGroup("raid2", A)).toBe(true) -- your subgroup unknown
    subs[3] = 1
    me = 9
    expect(inYourGroup("raid2", A)).toBe(true) -- you weren't found
    secretMe = true
    expect(inYourGroup("raid2", A)).toBe(true)
end

--------------------------------------------------------------------------------
-- Raid markers
--------------------------------------------------------------------------------

@test("raidMarker and showRaidMarker: the cell of each index")
local function raidMarkers()
    local t = uf.raidMarker(parent, 16)
    expect(t:IsShown()).toBe(false)
    expect({ t:GetSize() }).toEqual({ 16, 16 })
    local index: any = 6
    local a: { [string]: any } = {
        UnitExists = function(_: string): boolean return true end,
        GetRaidTargetIndex = function(_: string): any return index end,
    }
    uf.showRaidMarker(t, "party1", a)
    expect(t:IsShown()).toBe(true)
    expect({ t:GetTexCoord() }).toEqual({ 0.25, 0.25, 0.25, 0.5, 0.5, 0.25, 0.5, 0.5 })
    index = 1
    uf.showRaidMarker(t, "party1", a)
    expect({ t:GetTexCoord() }).toEqual({ 0, 0, 0, 0.25, 0.25, 0, 0.25, 0.25 })
    index = 9
    uf.showRaidMarker(t, "party1", a)
    expect(t:IsShown()).toBe(false)
    index = 2
    uf.showRaidMarker(t, "party1", a)
    index = nil
    uf.showRaidMarker(t, "party1", a)
    expect(t:IsShown()).toBe(false)
    -- a secret index: the sprite sheet's cell, worked out by the engine
    index = mock.secret(4)
    uf.showRaidMarker(t, "party1", a)
    expect(t:IsShown()).toBe(true)
    -- no unit, no API, no such unit
    uf.showRaidMarker(t, nil, a)
    expect(t:IsShown()).toBe(false)
    index = 2
    uf.showRaidMarker(t, "party1", a)
    uf.showRaidMarker(t, "party1", { UnitExists = a.UnitExists })
    expect(t:IsShown()).toBe(false)
    uf.showRaidMarker(t, "party1", a)
    a.UnitExists = function(_: string): boolean return false end
    uf.showRaidMarker(t, "party1", a)
    expect(t:IsShown()).toBe(false)
    -- the game's own functions by default
    uf.showRaidMarker(t, "player")
    expect(t:IsShown()).toBe(false)
    local o = uf.raidMarker(parent, 10, "ARTWORK")
    expect(o:GetDrawLayer()).toBe("ARTWORK")
end

@test("a secret index the texture can't place hides the marker")
local function raidMarkerSecretRefused()
    local t: any = uf.raidMarker(parent, 16)
    t.SetSpriteSheetCell = function() error("refused") end
    uf.showRaidMarker(t, "party1", {
        UnitExists = function(_: string): boolean return true end,
        GetRaidTargetIndex = function(_: string): any return mock.secret(4) end,
    })
    expect(t:IsShown()).toBe(false)
end

@test("UpdateRaidMarker: the frame's marker, or never with raidMarker = false")
local function frameMarker()
    local f = preview(priest({ marker = 8 }))
    expect(f.marker:IsShown()).toBe(true)
    local g = preview(priest({ marker = 8 }), { raidMarker = false })
    expect(g.marker:IsShown()).toBe(false)
end

