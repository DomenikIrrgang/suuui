@test("the marker before the name: a role icon, else the class diamond")
local function roleMarker()
    local tank = preview(priest({ role = "TANK" }))
    expect(tank.role:IsShown()).toBe(true)
    expect(tank.classDot:IsShown()).toBe(false)
    expect(tokenOf(tank.role)).toBe("ink")
    local dps = preview(priest({ role = "DAMAGER" }))
    expect(tokenOf(dps.role)).toBe("ink-muted")
    local none = preview(priest())
    expect(none.role:IsShown()).toBe(false)
    expect(none.classDot:IsShown()).toBe(true)
    expect(tokenOf(none.classDot)).toBe("class-priest")
    -- a class without a colour, and a secret role: no marker
    local p = priest({ class = "NOBODY" })
    local a = api(p)
    a.UnitGroupRolesAssigned = function(_: string): any return mock.secret("TANK") end
    local odd = preview(p, {}, a)
    expect(odd.role:IsShown()).toBe(false)
    expect(odd.classDot:IsShown()).toBe(false)
    expect(tokenOf(odd.name)).toBe("ink")
end

@test("the name's colour: class, ink, or the NPC's reaction")
local function nameColors()
    expect(tokenOf(preview(priest(), { nameColor = "ink" }).name)).toBe("ink")
    local p = priest()
    local a = api(p)
    a.UnitIsPlayer = function(_: string): boolean return false end
    local r: any = 2
    a.UnitReaction = function(_: string, _: string): any return r end
    expect(tokenOf(preview(p, {}, a).name)).toBe("reaction-hostile")
    r = 4
    expect(tokenOf(preview(p, {}, a).name)).toBe("reaction-neutral")
    r = 5
    expect(tokenOf(preview(p, {}, a).name)).toBe("ink")
    r = nil
    expect(tokenOf(preview(p, {}, a).name)).toBe("ink")
    r = mock.secret(2)
    expect(tokenOf(preview(p, {}, a).name)).toBe("ink")
    expect(preview(p, {}, a).name:GetText()).toBe("Anna")
end

@test("meta: level and classification in the level's colour, or a pet's family")
local function metaLine()
    local f = preview(priest(), { meta = true })
    expect(f.meta:GetText()).toBe("60")
    expect(tokenOf(f.meta)).toBe("quest-impossible") -- 60 for a level-1 character
    expect(preview(priest()).meta:GetText()).toBe("")
    local p = priest()
    local a = api(p)
    local fam: any = "Wolf"
    a.UnitCreatureFamily = function(_: string): any return fam end
    expect(preview(p, { meta = "family" }, a).meta:GetText()).toBe("Wolf")
    fam = mock.secret("Wolf")
    expect(preview(p, { meta = "family" }, a).meta:GetText()).toBe("")
    a.UnitLevel = function(_: string): any return mock.secret(60) end
    local s = preview(p, { meta = true }, a)
    expect(s.meta:GetText()).toBe("")
end

@test("youWhenPlayer: the badge's alpha from 'is it you', secret too")
local function youBadge()
    local me = preview(priest({ you = true }), { youWhenPlayer = true })
    expect(me.you:IsShown()).toBe(true)
    expect(me.you:GetAlpha()).toBe(1)
    expect(preview(priest(), { youWhenPlayer = true }).you:GetAlpha()).toBe(0)
    local p = priest()
    local a = api(p)
    local s = mock.secret(true)
    a.UnitIsUnit = function(_: string, _: string): any return s end
    local f = preview(p, { youWhenPlayer = true }, a)
    local got: any = nil
    mock.stub(f.you, "SetAlphaFromBoolean", function(_: any, v: any) got = v end)
    f:UpdateIdentity()
    expect(issecretvalue(got)).toBe(true)
end

@test("UpdateIdentity does nothing for a unit that isn't there")
local function identityNoUnit()
    local p = priest()
    local a = api(p)
    local f = preview(p, {}, a)
    a.UnitExists = function(_: string): boolean return false end
    p.name = "Changed"
    f:UpdateIdentity()
    expect(f.name:GetText()).toBe("Anna")
    -- Refresh too: only the row is fitted
    f:Refresh()
    expect(f.name:GetText()).toBe("Anna")
end

@test("the row: a long name gets the room the meta and badges leave")
local function longName()
    local f = preview(priest({ name = string.rep("Bartholomew", 6) }), { meta = true, you = true })
    local room = f.row:GetWidth() - (5 + f.size.gap)
    expect(f.name:GetWidth() < room).toBe(true)
    expect(f.name:GetWidth() > 20).toBe(true)
    -- the meta and the you badge follow the name
    expect(f.meta).toBeAnchoredTo(f.name, "LEFT", "RIGHT")
    expect(f.you).toBeAnchoredTo(f.meta, "LEFT", "RIGHT")
    -- a short one sizes itself
    local g = preview(priest({ name = "Al" }), { you = true })
    expect(g.you).toBeAnchoredTo(g.name, "LEFT", "RIGHT")
end

@test("the row: a secret name gets the room, the meta and badges at the end")
local function secretName()
    local p = priest()
    local a = api(p)
    a.UnitName = function(_: string): any return mock.secret("Hidden") end
    local f = keep(uf.unitFrame(parent, "party1", { meta = true, you = true, api = a }))
    f:SetPoint("TOPLEFT", parent, "TOPLEFT", 10, -10)
    -- (the client gives a secret width for secret text; see the next test)
    mock.stub(f.name, "GetUnboundedStringWidth", function(): any return mock.secret(300) end)
    f:Refresh()
    expect(f.you).toBeAnchoredTo(f.row, "RIGHT", "RIGHT")
    expect(f.meta).toBeAnchoredTo(f.you, "RIGHT", "LEFT")
    f:SetState("danger", "Aggro")
    expect(f.you).toBeAnchoredTo(f.badge, "RIGHT", "LEFT")
    expectNoErrors()
end

@test("a FontString with secret text measures as secret")
local function secretTextWidth()
    local fs = parent:CreateFontString(nil, "OVERLAY", "GameFontNormal")
    fs:SetText(mock.secret("Hidden"))
    expect(issecretvalue(fs:GetUnboundedStringWidth())).toBe(true)
end

@test("the row on sm frames: badges from the end, the meta after the name")
local function smallRow()
    local f = preview(priest(), { size = "sm", meta = true, you = true })
    expect(f.you).toBeAnchoredTo(f.row, "RIGHT", "RIGHT")
    expect(f.meta).toBeAnchoredTo(f.name, "LEFT", "RIGHT")
    local g = preview(priest(), { size = "sm" })
    expect(g.meta:GetNumPoints()).toBe(0)
end

--------------------------------------------------------------------------------
-- State, fit, resize
--------------------------------------------------------------------------------

@test("SetState: border, glow and badge; nil clears")
local function states()
    local f = preview(priest())
    f:SetState("danger", "Aggro")
    expect(f.badge:IsShown()).toBe(true)
    expect(f.badge.text).toBe("Aggro")
    expect(tokenOf(f.border.parts[1])).toBe("ember")
    f:SetState("danger", "Aggro") -- the same: nothing
    f:SetState("curse", nil)
    expect(f.badge:IsShown()).toBe(false)
    expect(tokenOf(f.border.parts[1])).toBe("dispel-curse")
    f:SetState("warning", "Low")
    expect(tokenOf(f.border.parts[1])).toBe("amber")
    f:SetState(nil, nil)
    expect(f.badge:IsShown()).toBe(false)
    expect(tokenOf(f.border.parts[1])).toBe("gilt-hairline")
    -- with a role icon the row keeps it
    local t = preview(priest({ role = "TANK" }))
    t:SetState("danger", "Aggro")
    expect(t.role:IsShown()).toBe(true)
end

@test("FitRow: the row ends where the health text (and reserved room) begins")
local function fitRow()
    local f = preview(priest(), { reserveRight = 20 })
    local _, _, _, x = f.right:GetPoint(1)
    expect(x).toBe(-(f.size.pad + 20))
    local g = preview(priest(), { healthText = "none" })
    local _, _, _, gx = g.right:GetPoint(1)
    expect(gx).toBe(-g.size.pad)
    preview(priest(), { healthText = "bogus" })
    expectNoErrors()
end

@test("Resize: the size, the incoming bars, and a redraw when active")
local function resize()
    local f = preview(priest())
    f:Resize(200, 30)
    expect({ f:GetSize() }).toEqual({ 200, 30 })
    expect(f.incoming:GetWidth()).toBe(198)
    expect(f.absorb:GetWidth()).toBe(198)
    local refresh = mock.stub(f, "Refresh")
    f.active = true
    f:Resize(210, 30)
    f.active = false
    expect(refresh).toHaveBeenCalledTimes(1)
end

