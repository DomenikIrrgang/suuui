@test("SetDispelBadges: one set per mode, made once, one shown")
local function dispelBadges()
    local f = keep(uf.unitFrame(parent, "player", {}))
    f:SetDispelBadges("all")
    expect(#f.dispelSets.all).toBe(#uf.DEBUFF_TYPES)
    expect(f.dispelSets.all[1].container:IsShown()).toBe(true)
    local all = f.dispelSets.all
    f:SetDispelBadges("removable")
    expect(f.dispelSets.all[1].container:IsShown()).toBe(false)
    expect(f.dispelSets.removable[1].container:IsShown()).toBe(true)
    f:SetDispelBadges("all")
    expect(f.dispelSets.all).toBe(all)
    f:SetDispelBadges("off")
    expect(all[1].container:IsShown()).toBe(false)
    expect(f.dispelSets.removable[1].container:IsShown()).toBe(false)
    expectNoErrors()
end

@test("DispelDecoration: the type's border and badge, Magic on top")
local function dispelDecoration()
    local f = preview(priest())
    local magic = f:DispelDecoration(f, "Magic")
    local disease = f:DispelDecoration(f, "Disease")
    expect(magic:GetFrameLevel() > disease:GetFrameLevel()).toBe(true)
    expect(magic:GetFrameLevel()).toBe(f.over:GetFrameLevel() + 3 + 3)
end

@test("WardDecoration and SetWardSpells")
local function warded()
    local f = keep(uf.unitFrame(parent, "player", {}))
    local deco = f:WardDecoration(f)
    deco:SetWarded(false)
    expect(deco:IsShown()).toBe(false)
    expect(deco.glow:IsShown()).toBe(false)
    deco:SetWarded(true)
    expect(deco:IsShown()).toBe(true)
    f:SetWardSpells(nil)
    expect(f.wardSlot).toBeNil()
    f:SetWardSpells({})
    expect(f.wardSlot).toBeNil()
    f:SetWardSpells({ 17 })
    local slot = f.wardSlot
    expect(slot).toBeTruthy()
    local spells = mock.stub(slot, "SetGroupSpells")
    f:SetWardSpells(nil)
    expect(spells).toHaveBeenCalledWith(slot, "ward", {})
    expect(f.wardSlot).toBe(slot)
end

--------------------------------------------------------------------------------
-- Units and events
--------------------------------------------------------------------------------

@test("SetUnit: re-points the attribute, the slots, and the events")
local function setUnit()
    local f = keep(uf.unitFrame(parent, "player", {}))
    f:SetDispelBadges("all")
    f:SetIndicators({ { kind = "square", ids = { 139 } } })
    f:SetWardSpells({ 17 })
    f:Activate()
    f:SetUnit("player") -- the same: nothing
    local s1 = mock.spy()
    local c1 = f.dispelSets.all[1]
    mock.stub(c1, "SetUnit", function(_: any, u: string) s1(u) end)
    f:SetUnit("target")
    expect(f.unit).toBe("target")
    expect(f:GetAttribute("unit")).toBe("target")
    expect(f.active).toBe(true)
    expect(s1).toHaveBeenCalledWith("target")
    f:SetUnit(nil)
    expect(s1).toHaveBeenCalledWith("none")
    expect(f.active).toBe(false)
    -- keepAttribute: a header set it
    f:SetUnit("focus", true)
    expect(f:GetAttribute("unit")).toBeNil()
    local g = keep(uf.unitFrame(parent, "player", { secure = false }))
    g:SetUnit("target")
    expect(g:GetAttribute("unit")).toBeNil()
end

@test("Activate draws the target; its events redraw it")
local function targetEvents()
    wolf = mock.spawnUnit({ name = "Wolf", level = 10, reaction = "hostile", health = 800, healthMax = 1000, power = 50, powerMax = 100, powerType = 1 })
    local w = wolf :: mock.MockUnit
    mock.player:target(w)
    local f = keep(uf.unitFrame(parent, "target", { meta = true }))
    f:Activate()
    f:Activate() -- once
    expect(f.name:GetText()).toBe("Wolf")
    expect(tokenOf(f.name)).toBe("reaction-hostile")
    -- health and percent are secret here: the engine's formatting
    expect(f.right.value).toBeNil()
    local health = mock.stub(f, "UpdateHealth")
    local power = mock.stub(f, "UpdatePower")
    local identity = mock.stub(f, "UpdateIdentity")
    local marker = mock.stub(f, "UpdateRaidMarker")
    local refresh = mock.stub(f, "Refresh")
    w:damage(100)
    expect(health).toHaveBeenCalled()
    w:setPower(20)
    expect(power).toHaveBeenCalled()
    mock.fireUnitEvent("UNIT_NAME_UPDATE", "target")
    expect(identity).toHaveBeenCalled()
    mock.fireEvent("RAID_TARGET_UPDATE")
    expect(marker).toHaveBeenCalled()
    mock.fireEvent("PLAYER_TARGET_CHANGED")
    expect(refresh).toHaveBeenCalledTimes(1)
    mock.fireUnitEvent("UNIT_CONNECTION", "target", true)
    expect(refresh).toHaveBeenCalledTimes(2)
    mock.fireEvent("PLAYER_ENTERING_WORLD", false, true)
    expect(refresh).toHaveBeenCalledTimes(3)
    mock.resetSpies()
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    expect(identity).toHaveBeenCalledTimes(1)
    expect(power).toHaveBeenCalledTimes(1)
    mock.fireEvent("PLAYER_ROLES_ASSIGNED")
    expect(identity).toHaveBeenCalledTimes(2)
    f:Deactivate()
    f:Deactivate()
    mock.resetSpies()
    w:damage(10)
    expect(health).never.toHaveBeenCalled()
end

@test("a party frame redraws everything on a roster change")
local function partyRoster()
    local f = keep(uf.unitFrame(parent, "party1", {}))
    f:Activate()
    local refresh = mock.stub(f, "Refresh")
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    expect(refresh).toHaveBeenCalledTimes(1)
end

@test("focus, targettarget, pet and boss frames listen for their own changes")
local function tokenEvents()
    local focus = keep(uf.unitFrame(parent, "focus", {}))
    focus:Activate()
    local fr = mock.stub(focus, "Refresh")
    mock.fireEvent("PLAYER_FOCUS_CHANGED")
