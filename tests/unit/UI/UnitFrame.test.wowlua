    expect(pr).toHaveBeenCalledTimes(1)
    local boss = keep(uf.unitFrame(parent, "boss1", {}))
    boss:Activate()
    local br = mock.stub(boss, "Refresh")
    mock.fireEvent("INSTANCE_ENCOUNTER_ENGAGE_UNIT")
    expect(br).toHaveBeenCalledTimes(1)
end

@test("poll: redraws health and power while shown and the unit exists")
local function polling()
    local f = keep(uf.unitFrame(parent, "player", { poll = 0.5 }))
    f:Activate()
    local health = mock.stub(f, "UpdateHealth")
    mock.stub(f, "UpdatePower")
    mock.advanceTime(1.1)
    expect(health).toHaveBeenCalledTimes(2)
    expect(health).toHaveBeenCalledWith(f, true)
    f:Hide()
    mock.advanceTime(1)
    expect(health).toHaveBeenCalledTimes(2)
    f:Show()
    f:Deactivate()
    expect(f.ticker).toBeNil()
    mock.advanceTime(1)
    expect(health).toHaveBeenCalledTimes(2)
end

@test("a unit event the client lacks is skipped")
local function missingEvent()
    local f = keep(uf.unitFrame(parent, "player", {}))
    local real = events.onUnit
    mock.stub(events, "onUnit", function(event: string, unit: any, fn: any, owner: any)
        if event == "UNIT_HEAL_PREDICTION" then error("no such event") end
        return real(event, unit, fn, owner)
    end)
    f:Activate()
    expect(f.active).toBe(true)
end

@test("in combat: the secret answers draw without errors")
local function combatSecrets()
    wolf = mock.spawnUnit({ name = "Wolf", level = 10, reaction = "hostile", health = 800, healthMax = 1000 })
    local w = wolf :: mock.MockUnit
    mock.player:target(w)
    local f = keep(uf.unitFrame(parent, "target", { meta = true, healthText = "both", lowTint = true, youWhenPlayer = true, crest = true, dragon = true }))
    f:SetDispelBadges("removable")
    f:Activate()
    mock.player:enterCombat()
    w:damage(300)
    w:setPower(10)
    f:Refresh()
    f:SetState("danger", "Aggro")
    expectNoErrors()
end

-- Last in the file: the group it makes stays for the file's VM.
@test("on = group: looks and containers only on your own raid group")
local function groupScoped()
    local mate = mock.spawnUnit({ name = "Mate", class = "PRIEST", player = true, reaction = "friendly" })
    local other = mock.spawnUnit({ name = "Other", class = "MAGE", player = true, reaction = "friendly" })
    mock.group:add(mate, { raid = true, subgroup = 1 })
    mock.group:add(other, { raid = true, subgroup = 2 })
    local function raidToken(u: mock.MockUnit): string
        -- (token() gives a string here, though typed string[]: see the notes)
        local t: any = u:token()
        if type(t) == "string" then return t end
        for _, x in ipairs(t) do if x:find("^raid") then return x end end
        return "none"
    end
    local list: { [string]: any }[] = { { kind = "square", ids = { 139 }, show = "both", on = "group" },
                                         { kind = "border", ids = { 17 }, missingOn = "group" } }
    local near = keep(uf.unitFrame(parent, raidToken(mate), { secure = false }))
    near:SetIndicators(list)
    expect(near.missingLooks[1]:IsShown()).toBe(true)
    expect(near.indicatorContainers[1].container:IsShown()).toBe(true)
    local far = keep(uf.unitFrame(parent, raidToken(other), { secure = false }))
    far:SetIndicators(list)
    expect(far.missingLooks[1]:IsShown()).toBe(false)
    expect(far.indicatorContainers[1].container:IsShown()).toBe(false)
    expect(far.indicatorContainers[2].container:IsShown()).toBe(false)
    -- in combat the live containers keep the last answer
    mock.player:enterCombat()
    far:UpdateIndicatorPresence()
    expect(far.indicatorContainers[1].container:IsShown()).toBe(false)
    mock.player:leaveCombat()
end
