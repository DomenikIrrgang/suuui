-- Buff indicators
--------------------------------------------------------------------------------

@test("SetIndicators: one container per indicator, reused by identity")
local function liveIndicators()
    local f = keep(uf.unitFrame(parent, "player", {}))
    local list = {
        { kind = "icon", ids = { 139 }, point = "TOPRIGHT", size = 16 },
        { kind = "square", ids = { 17 }, point = "BOTTOMLEFT", color = "fel" },
        { kind = "border", ids = { 774 }, source = "any" },
        { kind = "fill", ids = { 8936 } },
        { kind = "icon", ids = {} }, -- nothing to watch: no container
        { kind = "icon", ids = { 1 }, point = "CENTER" },
        { kind = "icon", ids = { 2 }, point = "LEFT" },
    }
    f:SetIndicators(list)
    expect(#f.indicatorContainers).toBe(6)
    local first = f.indicatorContainers[1]
    f:SetIndicators({ list[1] })
    expect(#f.indicatorContainers).toBe(1)
    expect(f.indicatorContainers[1]).toBe(first)
    expect(first.container:IsShown()).toBe(true)
    f:SetIndicators(nil)
    expect(#f.indicatorContainers).toBe(0)
    expect(first.container:IsShown()).toBe(false)
    expectNoErrors()
end

@test("missing looks: shown while none of the spells is up, out of combat")
local function missingLooks()
    mock.defineSpell(139, { name = "Renew", iconID = 135953 })
    local f = keep(uf.unitFrame(parent, "player", {}))
    f:SetIndicators({
        { kind = "icon", ids = { 139 }, show = "missing", size = 12 },
        { kind = "square", ids = { 139 }, show = "both", missingColor = "amber" },
        { kind = "fill", ids = { 139 }, show = "both" }, -- a fill's "both" is "up"
    })
    expect(#f.missingLooks).toBe(2)
    expect(#f.indicatorContainers).toBe(2)
    local missing, both = f.missingLooks[1], f.missingLooks[2]
    expect(missing:IsShown()).toBe(true)
    expect(both:IsShown()).toBe(true)
    local id = mock.player:applyAura({ spellId = 139, name = "Renew", duration = 15, sourceUnit = "player", isHelpful = true })
    f:UpdateIndicatorPresence()
    expect(missing:IsShown()).toBe(false)
    expect(both:IsShown()).toBe(true)
    mock.player:removeAura(id)
    f:UpdateIndicatorPresence()
    expect(missing:IsShown()).toBe(true)
    -- in combat a missing look can't be known: hidden
    mock.player:enterCombat()
    f:UpdateIndicatorPresence()
    expect(missing:IsShown()).toBe(false)
    expect(both:IsShown()).toBe(true)
    mock.player:leaveCombat()
    -- the same list again reuses the looks
    f:SetIndicators({ { kind = "icon", ids = { 139 }, show = "missing", size = 12 } })
    expect(f.missingLooks[1]).toBe(missing)
    -- an "any" source's aura from someone else counts
    f:SetIndicators({ { kind = "square", ids = { 139 }, show = "missing", source = "any" } })
    local id2 = mock.player:applyAura({ spellId = 139, name = "Renew", duration = 15, sourceUnit = "party1", isHelpful = true })
    f:UpdateIndicatorPresence()
    expect(f.missingLooks[1]:IsShown()).toBe(false)
    mock.player:removeAura(id2)
end

@test("SetPreviewIndicators: the looks drawn as if the auras were up")
local function previewIndicators()
    mock.defineSpell(139, { name = "Renew", iconID = 135953 })
    local f = preview(priest())
    local list = {
        { kind = "icon", ids = { 139 }, size = 14 },
        { kind = "icon", ids = { 139 }, show = "missing" },
        { kind = "border", color = "ward" },
        { kind = "fill" },
        { kind = "square", point = "BOTTOM" },
        { kind = "icon" },
    }
    f:SetPreviewIndicators(list)
    expect(#f.previewLooks).toBe(6)
    for _, look in ipairs(f.previewLooks) do expect(look:IsShown()).toBe(true) end
    local first = f.previewLooks[1]
    f:SetPreviewIndicators({ list[1] })
    expect(f.previewLooks[1]).toBe(first)
    f:SetPreviewIndicators(nil)
    expect(first:IsShown()).toBe(false)
end

