@test("power: the line in the power's colour; mana's amber below 25%")
local function power()
    local f = preview(priest({ power = 0.1 }))
    expect(f.power:IsShown()).toBe(true)
    expect(f.power:GetValue()).toBeCloseTo(10)
    expect(tokenOf(f.power)).toBe("mana")
    expect(f.powerLow:IsShown()).toBe(true)
    expect(f.powerLow:GetAlpha()).toBe(1)
    local w = preview({ name = "Wu", class = "WARRIOR", health = 1, power = 0.1 })
    expect(tokenOf(w.power)).toBe("rage")
    expect(w.powerLow:IsShown()).toBe(false)
end

@test("power: off, filtered, empty, secret, unknown token")
local function powerCases()
    expect(preview(priest(), { power = false }).power:IsShown()).toBe(false)
    local asked: string[] = {}
    local f = preview(priest(), { powerFor = function(u: string, _: any): boolean asked[#asked + 1] = u return false end })
    expect(f.power:IsShown()).toBe(false)
    expect(asked[1]).toBe("party1")
    expect(preview(priest(), { powerFor = function(_: string, _: any): boolean return true end }).power:IsShown()).toBe(true)
    local p = priest()
    local a = api(p)
    a.UnitPowerMax = function(_: string, _: number): any return 0 end
    expect(preview(p, {}, a).power:IsShown()).toBe(false)
    a.UnitPowerMax = function(_: string, _: number): any return mock.secret(100) end
    expect(preview(p, {}, a).power:IsShown()).toBe(true)
    a.UnitPowerMax = function(_: string, _: number): any return 100 end
    a.UnitPowerType = function(_: string): (number, string) return 6, "RUNIC_POWER" end
    local r = preview(p, {}, a)
    expect(tokenOf(r.power)).toBe("mana")
    expect(r.powerLow:IsShown()).toBe(false)
end

