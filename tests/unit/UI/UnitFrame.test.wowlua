    local tot = keep(uf.unitFrame(parent, "targettarget", {}))
    tot:Activate()
    local tr = mock.stub(tot, "Refresh")
    mock.fireEvent("PLAYER_TARGET_CHANGED")
    mock.fireUnitEvent("UNIT_TARGET", "target")
    expect(tr).toHaveBeenCalledTimes(2)
    local pet = keep(uf.unitFrame(parent, "pet", {}))
    pet:Activate()
    local pr = mock.stub(pet, "Refresh")
