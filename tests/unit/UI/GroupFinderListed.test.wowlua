-- UI/GroupFinderListed: the My listing page, your listing and the ad.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import groupFinderListed, GroupFinderListed, ListedData from "/UI/GroupFinderListed"
import SelectOption from "/UI/Select"
import tokens as T from "/Core/Tokens"
import expectNoErrors from "../../helpers"
import tokenOf, host, cleanup, themeChanged from "./SocialHelpers"

@afterEach
local function done() cleanup() end

local function page(): GroupFinderListed
    local p = groupFinderListed(host(900, 500))
    p:SetAllPoints()
    mock.advanceFrames(1)
    return p
end

local CHANNELS: SelectOption<string>[] = { { value = "LookingForGroup", label = "LookingForGroup" }, { value = "General", label = "General" } }

local function full(): ListedData
    return {
        listing = { listedFor = "12m", left = "18m", category = "Dungeons", activities = { "Shadowfang Keep", "Deadmines" },
                    roles = { "healer", "tank" }, playstyle = "Relaxed", comment = "Quick run", voice = "None" },
        ad = { text = "LFM SFK, need dps", channel = "LookingForGroup", channels = CHANNELS, lastPost = "6m", max = 255 },
    }
end

@test("your listing: how long, the facts, your roles")
local function listing()
    local p = page()
    p:SetData(full())
    local c = p.listing
    expect(c.title).toHaveText("Listed")
    expect(c.time).toHaveText("for 12m · runs out in 18m")
    local f = c.facts
    expect(f[1].dt).toHaveText("Dungeons")
    expect(f[1].dd).toHaveText("Shadowfang Keep · Deadmines")
    expect(f[2].dt).toHaveText("Your roles")
    expect(f[2].dd).toHaveText("Healer, Tank")
    expect(c.roleIcons[1]).toBeShown()
    expect(c.roleIcons[1].glyph:GetTexture() :: string).toContain("RoleHealer")
    expect(c.roleIcons[2].glyph:GetTexture() :: string).toContain("RoleTank")
    expect(c.roleIcons[3]).never.toBeShown()
    expect(f[3].dd).toHaveText("Relaxed")
    expect(f[4].dt).toHaveText("Details")
    expect(f[4].dd).toHaveText("Quick run")
    expect(f[5].dd).toHaveText("None")
    for i = 1, 5 do expect(f[i].dd).toBeShown() end
    -- the cards as tall as the taller one
    expect(c:GetHeight()).toBe(math.max(p.listingH, p.adH or 0))
    expect(p.ad:GetHeight()).toBe(c:GetHeight())
    expectNoErrors()
end

@test("your listing: what isn't known is left out")
local function sparse()
    local p = page()
    p:SetData(full())
    p:SetData({ listing = { comment = "" } })
    local c, f = p.listing, p.listing.facts
    expect(c.time).toHaveText("for a moment")
    expect(f[1].dt).never.toBeShown()
    expect(f[1].dd).never.toBeShown()
    expect(f[2].dd).toBeShown()
    expect(f[2].dd).toHaveText("None chosen")
    for i = 1, 3 do expect(c.roleIcons[i]).never.toBeShown() end
    expect(f[3].dd).never.toBeShown()
    expect(f[4].dd).never.toBeShown()
    expect(f[5].dd).never.toBeShown()
    -- activities without a category
    p:SetData({ listing = { activities = { "Wetlands" } } })
    expect(f[1].dt).toHaveText("Activities")
    expect(f[1].dd).toHaveText("Wetlands")
    -- nothing at all
    p:SetData({})
    expect(c.time).toHaveText("for a moment")
    expect(p.ad.post.label).toHaveText("Post to chat")
    expect(p.ad.last).toHaveText("Not posted yet")
    expectNoErrors()
end

@test("the ad: channel, text, the Post button, when last posted")
local function ad()
    local p = page()
    p:SetData(full())
    local a = p.ad
    expect(a.title).toHaveText("Advertise in chat")
    expect(a.channel.value).toBe("LookingForGroup")
    expect(a.channel.text).toHaveText("LookingForGroup")
    expect(a.edit:GetText()).toBe("LFM SFK, need dps")
    expect(a.edit:GetCursorPosition()).toBe(0)
    expect(a.post.label).toHaveText("Post to LookingForGroup")
    expect(a.last).toHaveText("Last posted 6m ago")
    expect(a.count).toHaveText("17 / 255")
    expect(tokenOf(a.count)).toBe("ink-faint")
    expect(tokenOf(a.fieldEdge.top)).toBe("gilt-line")
    expect(a.post:IsEnabled()).toBe(true)
    expectNoErrors()
end

@test("the count: over the limit the edge is ember and Post is off; blank, Post is off")
local function count()
    local p = page()
    local d = full()
    local sent = d.ad
    if sent then
        sent.max = 10
        p:SetData(d)
        expect(p.ad.count).toHaveText("17 / 10")
        expect(tokenOf(p.ad.count)).toBe("ember-text")
        expect(tokenOf(p.ad.fieldEdge.top)).toBe("ember")
        expect(p.ad.post:IsEnabled()).toBe(false)
        sent.max, sent.text = nil, "   "
        p:SetData(d)
        expect(p.ad.count).toHaveText("3 / 255")
        expect(p.ad.post:IsEnabled()).toBe(false)
    end
    -- no data yet: 255
    local q = groupFinderListed(host())
    q.ad.edit:SetText("hi")
    q:Count()
    expect(q.ad.count).toHaveText("2 / 255")
    expectNoErrors()
end

@test("typing: the count follows, the text is reported; focus lights the edge")
local function typing()
    local p = page()
    local onText = mock.spy(function(_t: string) end)
    p.onText = onText
    p:SetData({ ad = { text = "", channel = "General", channels = CHANNELS } })
    mock.click(p.ad.field)
    expect(p.ad.edit:HasFocus()).toBe(true)
    expect(tokenOf(p.ad.fieldEdge.top)).toBe("arcane")
    mock.typeText(p.ad.edit, "LFM")
    expect(onText).toHaveBeenCalledWith("LFM")
    expect(p.ad.count).toHaveText("3 / 255")
    -- while typing, new data doesn't replace the text
    p:SetData({ ad = { text = "from the listing", channel = "General" } })
    expect(p.ad.edit:GetText()).toBe("LFM")
    mock.pressKey("ESCAPE")
    expect(p.ad.edit:HasFocus()).toBe(false)
    expect(tokenOf(p.ad.fieldEdge.top)).toBe("gilt-line")
    p:SetData({ ad = { text = "from the listing", channel = "General" } })
    expect(p.ad.edit:GetText()).toBe("from the listing")
    -- a change from code isn't the user's: not reported
    expect(onText).toHaveBeenCalledTimes(3)
    p.onText = nil
    mock.typeText(p.ad.edit, "x")
    expect(onText).toHaveBeenCalledTimes(3)
    expectNoErrors()
end

@test("the buttons report: Update, Delist, From my listing, Post, the channel")
local function buttons()
    local p = page()
    local onUpdate, onDelist, onRewrite = mock.spy(), mock.spy(), mock.spy()
    local onPost = mock.spy(function(_c: string?, _t: string) end)
    local onChannel = mock.spy(function(_v: any) end)
    p.onUpdate, p.onDelist, p.onRewrite, p.onPost, p.onChannel = onUpdate, onDelist, onRewrite, onPost, onChannel
    p:SetData(full())
    expect(p.listing.update.label).toHaveText("Update")
    expect(p.listing.delist.label).toHaveText("Delist")
    mock.click(p.listing.update)
    mock.click(p.listing.delist)
    mock.click(p.ad.rewrite)
    mock.click(p.ad.post)
    expect(onUpdate).toHaveBeenCalledTimes(1)
    expect(onDelist).toHaveBeenCalledTimes(1)
    expect(onRewrite).toHaveBeenCalledTimes(1)
    expect(onPost).toHaveBeenCalledWith("LookingForGroup", "LFM SFK, need dps")
    mock.click(p.ad.channel)
    local list = p.ad.channel.list
    if list then mock.click(list.rows[2]) end
    expect(onChannel).toHaveBeenCalledWith("General")
    -- no ad: no post; no listeners: nothing
    p:SetData({ ad = { text = "x" } })
    p.data = { listing = {} }
    mock.click(p.ad.post)
    expect(onPost).toHaveBeenCalledTimes(1)
    p.onUpdate, p.onDelist, p.onRewrite, p.onPost, p.onChannel = nil, nil, nil, nil, nil
    p:SetData(full())
    for _, b in ipairs({ p.listing.update, p.listing.delist, p.ad.rewrite, p.ad.post }) do mock.click(b) end
    mock.click(p.ad.channel)
    if list then mock.click(list.rows[1]) end
    expect(onUpdate).toHaveBeenCalledTimes(1)
    expect(onChannel).toHaveBeenCalledTimes(1)
    expectNoErrors()
end

@test("a new size, or a theme change, lays the page out again")
local function relayout()
    local parent = host(900, 500)
    local p = groupFinderListed(parent)
    p:SetAllPoints()
    -- before data the size changes nothing
    mock.script(p, "OnSizeChanged", 900, 500)
    expect(p.data).toBeNil()
    p:SetData(full())
    local before = p.listing.facts[1].dd:GetWidth()
    parent:SetWidth(1300)
    mock.script(p, "OnSizeChanged", 1300, 500)
    expect(p.listing.facts[1].dd:GetWidth() > before).toBe(true)
    p.listing.time:SetText("changed")
    p.listing.time.value = nil
    local idle = groupFinderListed(parent)
    themeChanged()
    expect(p.listing.time).toHaveText("for 12m · runs out in 18m")
    expect(idle.data).toBeNil()
    expect(p.adH).toBe(12 + T.type.header.lineHeight + 8 + T.type.caption.lineHeight * 2 + 8 + 30 + 8
        + p.ad.field:GetHeight() + 4 + 22 + 8 + 8 + 26 + 12)
    expectNoErrors()
end
