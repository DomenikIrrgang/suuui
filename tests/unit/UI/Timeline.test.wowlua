--------------------------------------------------------------------------------
-- Per event, per frame (X-2.1): laid out when the events change, and per
-- frame only what moved
--------------------------------------------------------------------------------

-- How often each of a region's setters ran.
local function counting(region: Region, names: string[]): { [string]: number }
    local calls: { [string]: number } = {}
    for _, name in ipairs(names) do
        calls[name] = 0
        hooksecurefunc(region, name, function()
            calls[name] = (calls[name] or 0) + 1
        end)
    end
    return calls
end

@test("laid out once per change of the events, never per frame")
local function layoutPerChange()
    local t = make()
    local layouts = t.layouts
    t:SetEvents({ inSec(1, "Axe", 20), inSec(2, "Bolt", 8), { id = 3, label = "Hold", paused = 12 } })
    expect(t.layouts).toBe(layouts + 1)
    -- 100 frames: moving, not laid out
    mock.advanceFrames(100)
    expect(t.layouts).toBe(layouts + 1)
    expect(t.evs[1].name).toHaveText("Bolt")
    -- one added, one cancelled: once each
    t:SetEvents({ inSec(1, "Axe", 18), inSec(2, "Bolt", 6), { id = 3, label = "Hold", paused = 12 }, inSec(4, "Doom", 9) })
    expect(t.layouts).toBe(layouts + 2)
    t:SetEvents({ inSec(1, "Axe", 18), { id = 3, label = "Hold", paused = 12 }, inSec(4, "Doom", 9) })
    expect(t.layouts).toBe(layouts + 3)
    -- the same variant again (the module sets it at each refresh): nothing
    t:SetVariant("track")
    expect(t.layouts).toBe(layouts + 3)
    -- one ending: the frames go on without a layout, the one left by the
    -- owner's next list is one more
    mock.advanceTime(9.5)
    mock.advanceFrames(2)
    expect(t.layouts).toBe(layouts + 3)
    expect(t.evs[1].time).toHaveText("0.0s")
    t:SetEvents({ inSec(1, "Axe", 8.5), { id = 3, label = "Hold", paused = 12 } })
    expect(t.layouts).toBe(layouts + 4)
    expectNoErrors()
end

@test("a resize lays it out once, with the new width")
local function resized()
    local t = make()
    -- (placed, as the module's mover does: a frame without a place has no
    -- size to change)
    t:SetPoint("TOP")
    t:SetEvents({ { id = 1, label = "Hold", paused = 15 } })
    mock.nextFrame()
    local layouts = t.layouts
    local track = t.track :: Frame
    track:SetWidth(320)
    mock.nextFrame()
    expect(t.layouts).toBe(layouts + 1)
    expect(pointOf(t.evs[1]).x).toBe(160)
    -- the same width again: nothing
    track:SetWidth(320)
    mock.nextFrame()
    expect(t.layouts).toBe(layouts + 1)
    expectNoErrors()
end

@test("per frame: a frame moves when its pixel changes, its text when its value does, its colours when it turns amber")
local function onlyWhatChanged()
    local t = make()
    -- (20.5 s: whole seconds, never amber; 6.05 s: tenths, amber after 1.05 s)
    t:SetEvents({ inSec(1, "Axe", 20.5), inSec(2, "Bolt", 6.05) })
    local bolt, axe = t.evs[1], t.evs[2]
    local axeFrame = counting(axe, { "SetPoint", "ClearAllPoints", "Show" })
    local axeTime = counting(axe.time, { "SetText", "SetTextColor" })
    local axeRing = counting(axe.ring.top, { "SetVertexColor", "SetColorTexture" })
    local boltTime = counting(bolt.time, { "SetText", "SetTextColor" })
    local seen: string[] = {}
    hooksecurefunc(bolt.time, "SetText", function(_: FontString, text: string)
        seen[#seen + 1] = text
    end)
    mock.advanceFrames(100)
    -- Axe: 20.5 s to 18.8 s along 640 px of 30 s: about 36 pixels, not 100
    -- moves; its text twice (20s, 19s, 18s); no colour
    expect(axeFrame.SetPoint).toBeLessThan(40)
    expect(axeFrame.SetPoint).toBeGreaterThan(30)
    expect(axeFrame.ClearAllPoints).toBe(axeFrame.SetPoint)
    expect(axeFrame.Show).toBe(0)
    expect(axeTime.SetText).toBe(2)
    expect(axeTime.SetTextColor).toBe(0)
    expect(axeRing).toEqual({ SetVertexColor = 0, SetColorTexture = 0 })
    expect(axe.time).toHaveText("18s")
    -- Bolt: a text per tenth (6.0s down to 4.4s), each a new one; amber once
    expect(boltTime.SetText).toBe(#seen)
    expect(#seen).toBeLessThan(20)
    for i = 2, #seen do
        expect(seen[i] ~= seen[i - 1]).toBe(true)
    end
    expect(boltTime.SetTextColor).toBe(1)
    expect(tokenOf(bolt.time)).toBe("amber")
    expectNoErrors()
end

@test("per frame: no garbage while the events stay the same")
local function noGarbage()
    local t = make()
    t:SetEvents({ inSec(1, "Axe", 25.2), inSec(2, "Bolt", 16.4), { id = 3, label = "Hold", paused = 12 }, inSec(4, "Rain", 52) })
    local list = make({ variant = "list" })
    list:SetEvents({ inSec(1, "Axe", 25.2), inSec(2, "Bolt", 16.4), { id = 3, label = "Hold", paused = 12 } })
    -- 100 frames' ticks of each, the clock moved between them (the whole
    -- seconds change once or twice: a few short strings)
    local kb = 0
    for _ = 1, 100 do
        mock.advanceTime(1 / 60)
        local before = collectgarbage("count")
        t:Tick()
        list:Tick()
        kb += collectgarbage("count") - before
    end
    expect(kb).toBeLessThan(1)
    expect(t.later).toHaveText("then Rain in 50s")
    expectNoErrors()
end

@test("nothing per frame while nothing moves: empty, all paused, every one ended, or hidden")
local function idle()
    local t = make()
    t:SetEvents({})
    expect(t:GetScript("OnUpdate")).toBeNil()
    -- paused ones are drawn, then nothing moves
    t:SetEvents({ { id = 1, label = "Hold", paused = 12 }, { id = 2, label = "Wait", paused = 3 } })
    expect(t:GetScript("OnUpdate")).toBeNil()
    expect(t.evs[1].name).toHaveText("Wait")
    expect(t.evs[2].time).toHaveText("12s")
    -- the last running one ends: the updates stop on that frame
    t:SetEvents({ inSec(1, "Axe", 0.5), { id = 2, label = "Wait", paused = 3 } })
    expect(t:GetScript("OnUpdate") ~= nil).toBe(true)
    mock.advanceTime(0.6)
    mock.nextFrame()
    expect(t:GetScript("OnUpdate")).toBeNil()
    expect(t.evs[1].time).toHaveText("0.0s")
    -- hidden: its OnUpdate doesn't run; shown again, it catches up
    t:SetEvents({ inSec(1, "Axe", 20) })
    local moves = counting(t.evs[1], { "SetPoint" })
    t:Hide()
    mock.advanceFrames(60)
    expect(moves.SetPoint).toBe(0)
    t:Show()
    mock.nextFrame()
    expect(moves.SetPoint).toBe(1)
    expect(t.evs[1].time).toHaveText("18s")
    expectNoErrors()
end

@test("one passing a paused one changes places on the frame it does")
local function passing()
    local t = make()
    t:SetEvents({ { id = 1, label = "Hold", paused = 10 }, inSec(2, "Axe", 10.5) })
    expect(t.evs[1].name).toHaveText("Hold")
    mock.advanceTime(0.4)
    mock.nextFrame()
    expect(t.evs[1].name).toHaveText("Hold")
    mock.advanceTime(0.2)
    mock.nextFrame()
    expect(t.evs[1].name).toHaveText("Axe")
    expect(t.evs[2].name).toHaveText("Hold")
    expect(t.evs[1].time).toHaveText("9.9s")
    expectNoErrors()
end

@test("the list: a row's event, time and drain set per frame only when they change")
local function listPerFrame()
    local t = make({ variant = "list" })
    t:SetEvents({ inSec(1, "Axe", 20.5), { id = 2, label = "Hold", paused = 12 } })
    local layouts = t.layouts
    local row = t.rows[2]
    local name = counting(row.name, { "SetText" })
    local drain = counting(row.drain, { "SetWidth" })
    local frame = counting(row, { "SetPoint" })
    mock.advanceFrames(100)
    expect(t.layouts).toBe(layouts)
    expect(name.SetText).toBe(0)
    expect(frame.SetPoint).toBe(0)
    -- 20.5 s to 18.8 s of 30 over 256 px: about 15 pixels
    expect(drain.SetWidth).toBeLessThan(18)
    expect(drain.SetWidth).toBeGreaterThan(12)
    expect(t.rows[2].time).toHaveText("18s")
    expect(t.rows[1].name).toHaveText("Hold")
    expectNoErrors()
end
