-- UI/Draw: token colours (rgba), kept paints and their repaint after a theme
-- change, letting go when the code sets a colour otherwise, sizes, fills,
-- borders, hairlines, the diamond, soft edges and shadows, the cross, and
-- the rescale that keeps lines one pixel.

import test, expect, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import tokens as T, Color from "/Core/Tokens"
import * as pixel from "/Core/Pixel"
import * as events from "/Core/Events"
import * as draw from "/UI/Draw"
import * as tbl from "wowlua:table"
import expectNoErrors, newParent from "../../helpers"
import paintOf, tokenOf, colorIs, setToken, restoreTokens, pointOf from "./PrimitivesHelpers"
import type KeptPaint from "./PrimitivesHelpers"

local parent: Frame? = nil

local function host(): Frame
    parent = newParent()
    return parent :: Frame
end

@afterEach
local function cleanup()
    restoreTokens()
    if parent then
        parent:SetScale(1)
        parent:Hide()
    end
    parent = nil
    expectNoErrors()
end

type Call = number[]

-- the calls of a region's method after now (a post-hook)
local function record(region: Region, method: string): Call[]
    local calls: Call[] = {}
    hooksecurefunc(region, method, function(_: Region, ...: number)
        calls[#calls + 1] = { ... }
    end)
    return calls
end

--------------------------------------------------------------------------------
-- rgba and size
--------------------------------------------------------------------------------

@test("rgba gives a token's colour, its alpha multiplied")
local function rgbaToken()
    local c: Color = T.color.arcane
    local r, g, b, a = draw.rgba("arcane")
    expect({ r, g, b, a }).toEqual({ c[1], c[2], c[3], c[4] })
    local _, _, _, half = draw.rgba("arcane", 0.5)
    expect(half).toBe(c[4] * 0.5)
end

@test("rgba of an unknown token is an error")
local function rgbaUnknown()
    expect(function()
        draw.rgba("no-such-token")
    end).toThrow("unknown colour token no-such-token")
end

@test("size passes numbers through and reads size and space tokens")
local function sizes()
    expect(draw.size(17)).toBe(17)
    expect(draw.size("icon-md")).toBe(T.size["icon-md"])
    expect(draw.size("space-4")).toBe(T.space["space-4"])
    expect(function()
        draw.size("nope")
    end).toThrow("unknown size token nope")
end

--------------------------------------------------------------------------------
-- paint and repaint
--------------------------------------------------------------------------------

@test("paint picks the kind from the region: text, bar or vertex colour")
local function paintKinds()
    local p = host()
    local fs = p:CreateFontString(nil, "OVERLAY")
    local edit = CreateFrame("EditBox", nil, p)
    local bar = CreateFrame("StatusBar", nil, p)
    bar:SetStatusBarTexture("Interface\\Buttons\\WHITE8X8")
    local tex = p:CreateTexture()
    draw.paint(fs, "ink")
    draw.paint(edit, "arcane", 0.5)
    draw.paint(bar, "ember")
    draw.paint(tex, "gilt")
    expect(assert(paintOf(fs)).kind).toBe("text")
    expect(assert(paintOf(edit)).kind).toBe("text")
    expect(assert(paintOf(edit)).alpha).toBe(0.5)
    expect(assert(paintOf(bar)).kind).toBe("bar")
    expect(assert(paintOf(tex)).kind).toBe("vertex")
    local r, g, b, a = fs:GetTextColor()
    expect(colorIs(r, g, b, a, "ink")).toBe(true)
    r, g, b, a = bar:GetStatusBarColor()
    expect(colorIs(r, g, b, a, "ember")).toBe(true)
    r, g, b, a = tex:GetVertexColor()
    expect(colorIs(r, g, b, a, "gilt")).toBe(true)
end

@test("a kept colour follows the token on repaint")
local function repaintFollows()
    local p = host()
    local fs = p:CreateFontString(nil, "OVERLAY")
    local tex = p:CreateTexture()
    local bar = CreateFrame("StatusBar", nil, p)
    bar:SetStatusBarTexture("Interface\\Buttons\\WHITE8X8")
    draw.paint(fs, "ink")
    draw.paint(tex, "ink", 0.5)
    draw.paint(bar, "ink")
    setToken("ink", 0.2, 0.4, 0.6)
    draw.repaint()
    local r, g, b = fs:GetTextColor()
    expect(colorIs(r, g, b, nil, "ink")).toBe(true)
    expect(colorIs(r, g, b, nil, "arcane")).toBe(false)
    local vr, vg, vb, va = tex:GetVertexColor()
    expect(colorIs(vr, vg, vb, va, "ink", 0.5)).toBe(true)
    local br, bg, bb = bar:GetStatusBarColor()
    expect(colorIs(br, bg, bb, nil, "ink")).toBe(true)
end

@test("setting a colour another way lets the kept one go")
@cases({ { "FontString", "SetTextColor" }, { "Texture", "SetVertexColor" }, { "StatusBar", "SetStatusBarColor" } })
local function letsGo(kind: string, setter: string)
    local p = host()
    local region: Region
    if kind == "FontString" then
        region = p:CreateFontString(nil, "OVERLAY")
    elseif kind == "Texture" then
        region = p:CreateTexture()
    else
        local bar = CreateFrame("StatusBar", nil, p)
        bar:SetStatusBarTexture("Interface\\Buttons\\WHITE8X8")
        region = bar
    end
    draw.paint(region, "ink")
    local set = tbl.field(region, setter)
    if type(set) == "function" then
        set(region, 1, 0, 0, 1)
    end
    expect(paintOf(region)).toBeNil()
    -- a repaint leaves the raw colour alone
    setToken("ink", 0.2, 0.4, 0.6)
    draw.repaint()
    local get = kind == "FontString" and "GetTextColor" or kind == "Texture" and "GetVertexColor" or "GetStatusBarColor"
    local read = tbl.field(region, get)
    local r: unknown, g: unknown, b: unknown = nil, nil, nil
    if type(read) == "function" then
        r, g, b = read(region)
    end
    expect({ r, g, b }).toEqual({ 1, 0, 0 })
end

@test("the same paint again sets nothing; another token, a colour set otherwise or a theme's new value does")
local function samePaint()
    local p = host()
    local t = p:CreateTexture()
    local fills = record(t, "SetColorTexture")
    draw.paintFill(t, "arcane", 0.5)
    draw.paintFill(t, "arcane", 0.5)
    expect(#fills).toBe(1)
    draw.paintFill(t, "arcane")
    draw.paintFill(t, "ink")
    expect(#fills).toBe(3)
    -- set another way, then painted the same token again: set again
    t:SetColorTexture(1, 0, 0, 1)
    draw.paintFill(t, "ink")
    expect(#fills).toBe(5)
    -- a theme: the repaint sets the new value; the same paint after it nothing
    setToken("ink", 0.2, 0.4, 0.6)
    draw.repaint()
    expect(#fills).toBe(6)
    draw.paintFill(t, "ink")
    expect(#fills).toBe(6)
    -- text: a font object brings its own colour, so the paint lets go
    local fs = p:CreateFontString(nil, "OVERLAY")
    local colors = record(fs, "SetTextColor")
    draw.paint(fs, "ink")
    draw.paint(fs, "ink")
    expect(#colors).toBe(1)
    fs:SetFontObject(GameFontNormal)
    expect(paintOf(fs)).toBeNil()
    draw.paint(fs, "ink")
    expect(#colors).toBe(2)
    -- a gradient the same: nothing; another end: set
    local g = p:CreateTexture()
    local grads = record(g, "SetGradient")
    draw.paintGradient(g, "VERTICAL", "ink", "arcane", 0.2, 0.8)
    draw.paintGradient(g, "VERTICAL", "ink", "arcane", 0.2, 0.8)
    expect(#grads).toBe(1)
    draw.paintGradient(g, "VERTICAL", "ink", "arcane", 0.2, 0.9)
    expect(#grads).toBe(2)
end

@test("paintFill keeps a solid colour; a texture or atlas lets it go")
local function fills()
    local p = host()
    local t = p:CreateTexture()
    local calls = record(t, "SetColorTexture")
    draw.paintFill(t, "arcane", 0.5)
    expect(paintOf(t)).toEqual({ kind = "fill", token = "arcane", alpha = 0.5 })
    expect(#calls).toBe(1)
    local c = calls[1]
    expect(colorIs(c[1], c[2], c[3], c[4], "arcane", 0.5)).toBe(true)
    setToken("arcane", 0.1, 0.2, 0.3)
    draw.repaint()
    expect(#calls).toBe(2)
    expect(colorIs(calls[2][1], calls[2][2], calls[2][3], nil, "arcane")).toBe(true)
    t:SetTexture("Interface\\Buttons\\WHITE8X8")
    expect(paintOf(t)).toBeNil()
    draw.paintFill(t, "ink")
    t:SetAtlas("UI-HUD-UnitFrame-Target-PortraitOn-Boss-Gold")
    expect(paintOf(t)).toBeNil()
end

@test("paintGradient keeps both ends and repaints them")
local function gradients()
    local p = host()
    local t = p:CreateTexture()
    local calls: { orientation: string, from: colorRGBA, to: colorRGBA }[] = {}
    hooksecurefunc(t, "SetGradient", function(_: Texture, orientation: string, from: colorRGBA, to: colorRGBA)
        calls[#calls + 1] = { orientation = orientation, from = from, to = to }
    end)
    draw.paintGradient(t, "VERTICAL", "ink", "arcane", 0.2, 0.8)
    expect(paintOf(t)).toEqual({
        kind = "gradient",
        token = "ink",
        alpha = 0.2,
        token2 = "arcane",
        alpha2 = 0.8,
        orientation = "VERTICAL",
    })
    expect(#calls).toBe(1)
    expect(calls[1].orientation).toBe("VERTICAL")
    local from, to = calls[1].from, calls[1].to
    expect(colorIs(from.r, from.g, from.b, from.a, "ink", 0.2)).toBe(true)
    expect(colorIs(to.r, to.g, to.b, to.a, "arcane", 0.8)).toBe(true)
    draw.repaint()
    expect(#calls).toBe(2)
    t:SetColorTexture(1, 1, 1, 1)
    expect(paintOf(t)).toBeNil()
end

@test("bind runs its function now and on every repaint, until the colour is set otherwise")
local function binds()
    local p = host()
    local t = p:CreateTexture()
    local seen: Texture[] = {}
    draw.bind(t, function(tex: Texture)
        seen[#seen + 1] = tex
        tex:SetVertexColor(0.5, 0.5, 0.5, 1) -- painting: not a let-go
    end)
    expect(seen).toEqual({ t })
    expect(assert(paintOf(t)).kind).toBe("fn")
    draw.repaint()
    expect(#seen).toBe(2)
    t:SetVertexColor(1, 1, 1, 1)
    draw.repaint()
    expect(#seen).toBe(2)
end

@test("a bind whose function errors keeps nothing and raises the error")
local function bindErrors()
    local p = host()
    local t = p:CreateTexture()
    expect(function()
        draw.bind(t, function(_: Texture)
            error("boom")
        end)
    end).toThrow("boom")
    expect(paintOf(t)).toBeNil()
end

@test("a paint with an unknown token keeps nothing and raises the error")
local function paintErrors()
    local p = host()
    local t = p:CreateTexture()
    expect(function()
        draw.paint(t, "no-such-token")
    end).toThrow("unknown colour token")
    expect(paintOf(t)).toBeNil()
end

@test("repaint reports a failing paint and still repaints the others")
local function repaintIsolates()
    local p = host()
    local bad, good = p:CreateTexture(), p:CreateFontString(nil, "OVERLAY")
    local fail = false
    draw.bind(bad, function(_: Texture)
        if fail then
            error("bound failed")
        end
    end)
    draw.paint(good, "ink")
    fail = true
    setToken("ink", 0.3, 0.3, 0.3)
    -- the error handler, faked: what reaches the real one stays in
    -- mock.errors() for the rest of the file
    local reported: string[] = {}
    mock.fake("geterrorhandler", function(): (err: unknown) -> ()
        return function(err: unknown)
            reported[#reported + 1] = tostring(err)
        end
    end)
    draw.repaint()
    expect(#reported).toBe(1)
    expect(reported[1]).toContain("bound failed")
    local r, g, b = good:GetTextColor()
    expect(colorIs(r, g, b, nil, "ink")).toBe(true)
    fail = false
    bad:SetVertexColor(1, 1, 1, 1) -- let it go
end

@test("a bind that paints another region during a repaint keeps both")
local function repaintAddsRegions()
    local p = host()
    local a, b = p:CreateTexture(), p:CreateTexture()
    draw.bind(a, function(_: Texture)
        draw.paint(b, "arcane")
    end)
    draw.repaint()
    expect(tokenOf(b)).toBe("arcane")
    expect(assert(paintOf(a)).kind).toBe("fn")
end

--------------------------------------------------------------------------------
-- fill, border, hairline
--------------------------------------------------------------------------------

@test("fill makes a painted texture on the background layer, or the one asked for")
local function fillTexture()
    local p = host()
    local t = draw.fill(p, "surface")
    expect(tokenOf(t)).toBe("surface")
    expect(t:GetDrawLayer()).toBe("BACKGROUND")
    local o = draw.fill(p, "ink", "OVERLAY", 3)
    local layer, sub = o:GetDrawLayer()
    expect({ layer, sub }).toEqual({ "OVERLAY", 3 })
end

@test("a border is four one-pixel lines in from the frame's edges")
local function borderLayout()
    local p = host()
    local b = draw.border(p, "gilt-line")
    expect(b.width).toBe(1)
    expect(b.inset).toBe(0)
    expect(#b.parts).toBe(4)
    local px = pixel.size(p)
    expect(b.top:GetHeight()).toBeCloseTo(px, 4)
    expect(b.left:GetWidth()).toBeCloseTo(px, 4)
    expect(pointOf(b.top)).toEqual({ point = "TOPLEFT", relativeTo = p, relativePoint = "TOPLEFT", x = 0, y = 0 })
    for _, t in ipairs(b.parts) do
        expect(tokenOf(t)).toBe("gilt-line")
        expect(t:GetDrawLayer()).toBe("BORDER")
    end
end

@test("a border's width and inset are physical pixels")
local function borderOptions()
    local p = host()
    local b = draw.border(p, "ink", { width = 3, inset = 2, layer = "OVERLAY", sublevel = 2 })
    local px = pixel.size(p)
    expect(b.bottom:GetHeight()).toBeCloseTo(3 * px, 4)
    local top = assert(pointOf(b.top))
    expect(top.x).toBeCloseTo(2 * px, 4)
    expect(top.y).toBeCloseTo(-2 * px, 4)
    local left = assert(pointOf(b.left))
    expect(left.y).toBeCloseTo(-5 * px, 4)
    local layer, sub = b.right:GetDrawLayer()
    expect({ layer, sub }).toEqual({ "OVERLAY", 2 })
end

@test("a border takes a token, a colour table or r, g, b, a, and shows and hides")
local function borderColors()
    local p = host()
    local b = draw.border(p, "ink")
    b:SetColor("arcane", 0.5)
    expect(paintOf(b.right)).toEqual({ kind = "fill", token = "arcane", alpha = 0.5 })
    local calls = record(b.top, "SetColorTexture")
    b:SetColor({ 1, 0, 0, 0.5 })
    expect(calls[1]).toEqual({ 1, 0, 0, 0.5 })
    expect(paintOf(b.top)).toBeNil()
    b:SetColor(0, 1, 0, 1)
    expect(calls[2]).toEqual({ 0, 1, 0, 1 })
    b:SetShown(false)
    for _, t in ipairs(b.parts) do
        expect(t).never.toBeShown()
    end
    b:SetShown(true)
    for _, t in ipairs(b.parts) do
        expect(t).toBeShown()
    end
end

@test("a rescale lays borders and hairlines out again at one physical pixel")
local function rescale()
    local p = host()
    local b = draw.border(p, "ink")
    local line = draw.hairline(p, "ink")
    p:SetScale(2)
    events.emit("SUUUI_ROOT_SCALED", 2)
    expect(b.top:GetHeight()).toBeCloseTo(pixel.size(p), 4)
    expect(line:GetHeight()).toBeCloseTo(pixel.size(line), 4)
    expect(b.top:GetHeight()).toBeCloseTo(pixel.size(UIParent) / 2, 4)
end

@test("a solid hairline is one filled texture one pixel high")
local function hairlineSolid()
    local p = host()
    local line = draw.hairline(p, "gilt-line")
    expect(line:GetParent()).toBe(p)
    expect(line:GetHeight()).toBeCloseTo(pixel.size(line), 4)
    local regions = { line:GetRegions() }
    expect(#regions).toBe(1)
    expect(paintOf(regions[1])).toEqual({ kind = "fill", token = "gilt-line" })
end

@test("a hairline fading out is one gradient, full to clear")
local function hairlineOut()
    local p = host()
    local line = draw.hairline(p, "gilt", "out")
    local regions = { line:GetRegions() }
    expect(#regions).toBe(1)
    expect(paintOf(regions[1])).toEqual({
        kind = "gradient",
        token = "gilt",
        alpha = 1,
        token2 = "gilt",
        alpha2 = 0,
        orientation = "HORIZONTAL",
    })
end

@test("a hairline fading both ways is two gradients meeting in the middle")
local function hairlineBoth()
    local p = host()
    local line = draw.hairline(p, "gilt", "both")
    local regions = { line:GetRegions() }
    expect(#regions).toBe(2)
    expect(assert(paintOf(regions[1])).alpha).toBe(0)
    expect(assert(paintOf(regions[1])).alpha2).toBe(1)
    expect(assert(paintOf(regions[2])).alpha).toBe(1)
    expect(assert(paintOf(regions[2])).alpha2).toBe(0)
    expect(regions[1]).toBeAnchoredTo(line, "BOTTOMRIGHT", "BOTTOM")
end

--------------------------------------------------------------------------------
-- diamond, soft edges, shadow, cross
--------------------------------------------------------------------------------

@test("a diamond is a square turned 45 degrees in gilt by default")
local function diamonds()
    local p = host()
    local d = draw.diamond(p, 7)
    expect(d).toHaveSize(7, 7)
    expect(d:GetRotation()).toBeCloseTo(math.rad(45), 4)
    expect(tokenOf(d)).toBe("gilt")
    local layer, sub = d:GetDrawLayer()
    expect({ layer, sub }).toEqual({ "OVERLAY", 7 })
    local e = draw.diamond(p, 4, "arcane", "ARTWORK", 2)
    expect(tokenOf(e)).toBe("arcane")
    layer, sub = e:GetDrawLayer()
    expect({ layer, sub }).toEqual({ "ARTWORK", 2 })
end

@test("a soft edge is a nine-slice behind its frame, blurred 8 in white")
local function softEdgeDefaults()
    local p = host()
    p:SetFrameLevel(5)
    local e = draw.softEdge(p)
    expect(e.holder:GetParent()).toBe(p)
    expect(e.holder:GetFrameLevel()).toBe(4)
    expect(#e.parts).toBe(9)
    expect(#e.corners).toBe(4)
    expect(e.corners[1]).toHaveSize(12, 12)
    expect(pointOf(e.holder)).toEqual({ point = "TOPLEFT", relativeTo = p, relativePoint = "TOPLEFT", x = -12, y = 12 })
    local r, g, b, a = e.parts[5]:GetVertexColor()
    expect({ r, g, b, a }).toEqual({ 1, 1, 1, 1 })
end

@test("a soft edge's blur and offset move its holder; tiny blurs are a pixel")
local function softEdgeBlur()
    local p = host()
    local e = draw.softEdge(p)
    e:SetBlur(4, 2, -3)
    expect(e.corners[4]).toHaveSize(6, 6)
    expect(pointOf(e.holder)).toEqual({ point = "TOPLEFT", relativeTo = p, relativePoint = "TOPLEFT", x = -4, y = 3 })
    expect(pointOf(e.holder, 2)).toEqual({
        point = "BOTTOMRIGHT",
        relativeTo = p,
        relativePoint = "BOTTOMRIGHT",
        x = 8,
        y = -9,
    })
    e:SetBlur(0)
    expect(e.corners[1]).toHaveSize(1, 1)
end

@test("a soft edge's colour: a token, a kept colour table, or raw r, g, b, a")
local function softEdgeColors()
    local p = host()
    local e = draw.softEdge(p)
    e:SetColor("arcane", 0.4)
    expect(paintOf(e.parts[1])).toEqual({ kind = "vertex", token = "arcane", alpha = 0.4 })
    -- a shadow layer's colour table: changed in place, followed on repaint
    local c = { 0.2, 0.3, 0.4, 0.5 }
    e:SetColor(c)
    local r, g, b, a = e.parts[2]:GetVertexColor()
    expect(colorIs(r, g, b, a, "ink")).toBe(false)
    expect(math.abs(r - 0.2) < 0.01 and math.abs(a - 0.5) < 0.01).toBe(true)
    c[1] = 0.9
    draw.repaint()
    r = e.parts[2]:GetVertexColor()
    expect(math.abs(r - 0.9) < 0.01).toBe(true)
    e:SetColor(1, 0, 0, 1)
    expect(paintOf(e.parts[3])).toBeNil()
    r, g, b, a = e.parts[3]:GetVertexColor()
    expect({ r, g, b, a }).toEqual({ 1, 0, 0, 1 })
    e:SetShown(false)
    expect(e.holder).never.toBeShown()
    e:SetShown(true)
    expect(e.holder).toBeShown()
end

@test("shadow draws a shadow token's first outer layer")
local function shadowToken()
    local p = host()
    local e = draw.shadow(p, "glow-arcane")
    local layer = T.shadow["glow-arcane"][1]
    local s = math.max(1, layer.blur * 1.5)
    expect(e.corners[1]).toHaveSize(s, s)
    local r, g, b, a = e.parts[1]:GetVertexColor()
    expect(math.abs(r - layer.color[1]) < 0.01 and math.abs(a - layer.color[4]) < 0.01).toBe(true)
    expect(g).toBeCloseTo(layer.color[2], 2)
    expect(b).toBeCloseTo(layer.color[3], 2)
    -- shadow-panel sits 12 below
    local panel = draw.shadow(p, "shadow-panel")
    local pl = T.shadow["shadow-panel"][1]
    expect(assert(pointOf(panel.holder)).y).toBe(pl.blur * 1.5 - pl.y)
end

@test("shadow of an unknown token, or one with inset layers only, is an error")
local function shadowErrors()
    local p = host()
    expect(function()
        draw.shadow(p, "nope")
    end).toThrow("unknown shadow token nope")
    expect(function()
        draw.shadow(p, "inset-anchor")
    end).toThrow()
end

--------------------------------------------------------------------------------
-- Skins: textures set by their texture token follow the theme
--------------------------------------------------------------------------------

-- a texture token's file swapped for the test, as a theme does (then reskin)
local function swapFile(token: string, file: string): () -> ()
    local files = T.texture :: { [string]: string }
    local was = assert(files[token])
    files[token] = file
    draw.reskin()
    return function()
        files[token] = was
        draw.reskin()
    end
end

@test("a repaint of the changed tokens sets those, every function, and the texts only when asked")
local function repaintChanged()
    local p = host()
    local arcane, ember = p:CreateTexture(), p:CreateTexture()
    local fs = p:CreateFontString(nil, "OVERLAY")
    local grad = p:CreateTexture()
    draw.paint(arcane, "arcane")
    draw.paint(ember, "ember")
    draw.paint(fs, "gilt")
    draw.paintGradient(grad, "HORIZONTAL", "surface", "arcane")
    local binds = 0
    draw.bind(p:CreateTexture(), function(_: Texture)
        binds += 1
    end)
    local arcaneSets, emberSets = record(arcane, "SetVertexColor"), record(ember, "SetVertexColor")
    local textSets, gradSets = record(fs, "SetTextColor"), record(grad, "SetGradient")
    setToken("arcane", 0.1, 0.2, 0.3)
    draw.repaint({ arcane = true })
    expect(#arcaneSets).toBe(1)
    local r, g, b = arcane:GetVertexColor()
    expect(colorIs(r, g, b, nil, "arcane")).toBe(true)
    expect(#emberSets).toBe(0)
    expect(#textSets).toBe(0)
    -- (a gradient's second token changed)
    expect(#gradSets).toBe(1)
    expect(binds).toBe(2)
    draw.repaint({}, true)
    expect(#textSets).toBe(1)
    expect(#arcaneSets).toBe(1)
    expect(binds).toBe(3)
    -- nothing given: all
    draw.repaint()
    expect(#emberSets).toBe(1)
    expect(#arcaneSets).toBe(2)
end

@test("a repaint sets the colour of what reskin set a file on, whatever changed, once")
local function repaintReskinned()
    local p = host()
    local bar = CreateFrame("StatusBar", nil, p)
    draw.skinBar(bar, "health-bar")
    draw.paint(bar, "ink")
    local sets = record(bar, "SetStatusBarColor")
    local restore = swapFile("health-bar", "Interface\\TargetingFrame\\UI-StatusBar")
    draw.repaint({})
    expect(#sets).toBe(1)
    local r, g, b = bar:GetStatusBarColor()
    expect(colorIs(r, g, b, nil, "ink")).toBe(true)
    draw.repaint({})
    expect(#sets).toBe(1)
    restore()
    draw.repaint({})
    expect(#sets).toBe(2)
end

@test("a skin sets a texture's or a bar's file from its token, stretched or tiled")
local function skins()
    local p = host()
    local t = p:CreateTexture()
    draw.skin(t, "role-tank")
    expect(t:GetTextureFilePath()).toBe(T.texture["role-tank"])
    expect(draw.skinOf(t)).toBe("role-tank")
    local hatch = p:CreateTexture()
    draw.skin(hatch, "absorb", true)
    expect(hatch:GetTextureFilePath()).toBe(T.texture.absorb)
    expect(hatch:GetHorizTile()).toBe(true)
    expect(hatch:GetVertTile()).toBe(true)
    local bar = CreateFrame("StatusBar", nil, p)
    draw.skinBar(bar, "cast-bar")
    expect(bar:GetStatusBarTexture():GetTextureFilePath()).toBe(T.texture["cast-bar"])
    expect(draw.skinOf(bar)).toBe("cast-bar")
    -- another token on the same texture: the new one is kept
    draw.skin(t, "role-healer")
    expect(t:GetTextureFilePath()).toBe(T.texture["role-healer"])
    expect(draw.skinOf(t)).toBe("role-healer")
    expect(draw.isTexture("absorb")).toBe(true)
    expect(draw.isTexture("gilt")).toBe(false)
    expect(function()
        draw.skin(t, "sparkle")
    end).toThrow("unknown texture token sparkle")
end

@test("reskin sets a changed token's new file; the texture keeps its cell and its colour")
local function reskinKeeps()
    local p = host()
    local marker = p:CreateTexture()
    draw.skin(marker, "raid-markers")
    marker:SetTexCoord(0.25, 0.5, 0, 0.25)
    draw.paint(marker, "ember")
    local bar = CreateFrame("StatusBar", nil, p)
    draw.skinBar(bar, "health-bar")
    draw.paint(bar, "mana")
    local tex = bar:GetStatusBarTexture()
    local back = swapFile("raid-markers", "Interface\\AddOns\\SuuUI\\Media\\Textures\\RingArc2.tga")
    expect(marker:GetTextureFilePath()).toBe("Interface\\AddOns\\SuuUI\\Media\\Textures\\RingArc2.tga")
    local l, top, _, _, _, _, r, bottom = marker:GetTexCoord()
    expect({ l, top, r, bottom }).toEqual({ 0.25, 0, 0.5, 0.25 })
    -- its colour still kept: a repaint sets it
    draw.repaint()
    expect(tokenOf(marker)).toBe("ember")
    -- an unchanged token: nothing set again
    expect(tex:GetTextureFilePath()).toBe(T.texture["health-bar"])
    back()
    expect(marker:GetTextureFilePath()).toBe(T.texture["raid-markers"])
    -- a bar keeps its texture object and its colour
    local back2 = swapFile("health-bar", "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga")
    expect(bar:GetStatusBarTexture()).toBe(tex)
    expect(tex:GetTextureFilePath()).toBe("Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga")
    draw.repaint()
    local br, bg, bb = bar:GetStatusBarColor()
    expect(colorIs(br, bg, bb, nil, "mana")).toBe(true)
    back2()
    expectNoErrors()
end

@test("glows take their file from the texture token glow; the panel's shadow stays Soft.tga")
local function glowSkin()
    local p = host()
    local glow = draw.shadow(p, "glow-ember")
    local panel = draw.shadow(p, "shadow-panel")
    expect(glow.token).toBe("glow")
    expect(panel.token).toBeNil()
    local back = swapFile("glow", "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleSoft.tga")
    for _, t in ipairs(glow.parts) do
        expect(t:GetTextureFilePath()).toBe("Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleSoft.tga")
    end
    -- the slice kept: the top-left corner is still the file's top-left quarter
    local l, top, _, _, _, _, r, bottom = glow.corners[1]:GetTexCoord()
    expect({ l, top, r, bottom }).toEqual({ 0, 0, 0.25, 0.25 })
    expect(panel.parts[1]:GetTextureFilePath()).toBe("Interface\\AddOns\\SuuUI\\Media\\Textures\\Soft.tga")
    back()
    expect(glow.parts[1]:GetTextureFilePath()).toBe(T.texture.glow)
    -- a soft edge of your own from a texture token; an unknown one is an error
    expect(draw.softEdge(p, "glow").parts[1]:GetTextureFilePath()).toBe(T.texture.glow)
    expect(function()
        draw.softEdge(p, "sparkle")
    end).toThrow("unknown texture token sparkle")
end

--------------------------------------------------------------------------------
-- Patterns, ornaments, dividers and textured edges (0.39): what a theme draws
-- in the windows; nothing more than before in SuuUI's own look
--------------------------------------------------------------------------------

local CAT = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Themes\\PinkCat\\"

@test("a pattern: nothing while its token's file is empty; a theme's file tiled over the ground in gilt, shown with it")
local function patterns()
    local p = host()
    local ground = draw.fill(p, "surface-sunk")
    ground:SetAllPoints()
    draw.pattern(ground, "track-pattern")
    -- SuuUI's own look: no texture made
    expect(T.texture["track-pattern"]).toBe("")
    expect(draw.patternOf(ground)).toBeNil()
    local before = #{ p:GetRegions() }
    local back = swapFile("track-pattern", CAT .. "TrackPattern.tga")
    local over = assert(draw.patternOf(ground))
    expect(#{ p:GetRegions() }).toBe(before + 1)
    expect(over:GetTextureFilePath()).toBe(CAT .. "TrackPattern.tga")
    expect(over:GetHorizTile()).toBe(true)
    expect(over:GetVertTile()).toBe(true)
    expect(tokenOf(over)).toBe("gilt")
    local layer, sub = over:GetDrawLayer()
    expect(layer).toBe("BACKGROUND")
    expect(sub).toBe(1)
    expect((assert(pointOf(over))).relativeTo).toBe(ground)
    -- in and out of sight with its ground
    ground:Hide()
    expect(over:IsShown()).toBe(false)
    ground:SetShown(true)
    expect(over:IsShown()).toBe(true)
    -- back to SuuUI's: hidden, kept for the next theme (not made again)
    back()
    expect(draw.patternOf(ground)).toBeNil()
    expect(over:IsShown()).toBe(false)
    local again = swapFile("track-pattern", CAT .. "TrackPattern.tga")
    expect(draw.patternOf(ground)).toBe(over)
    again()
    expect(function()
        draw.pattern(ground, "sparkle")
    end).toThrow("unknown texture token sparkle")
end

@test("a fill draws no pattern by itself; one given while the theme has a pattern gets it at once")
local function surfacePatterns()
    local p = host()
    local glass = draw.fill(p, "surface-glass")
    local back = swapFile("surface-pattern", CAT .. "SurfacePattern.tga")
    expect(draw.patternOf(glass)).toBeNil()
    local later = draw.fill(p, "surface")
    draw.pattern(later, "surface-pattern")
    expect(assert(draw.patternOf(later)):GetTextureFilePath()).toBe(CAT .. "SurfacePattern.tga")
    back()
    expect(draw.patternOf(later)).toBeNil()
end

@test("an ornament is SuuUI's diamond; a theme's file drawn upright at twice its side, and back")
local function ornaments()
    local p = host()
    local corner = draw.ornament(p, 7, "corner", "gilt")
    expect(corner:GetTextureFilePath()).toBe(T.texture.corner)
    expect(corner).toHaveSize(7, 7)
    expect(corner:GetRotation()).toBeCloseTo(math.rad(45), 4)
    expect(tokenOf(corner)).toBe("gilt")
    local back = swapFile("corner", CAT .. "CornerPaw.tga")
    expect(corner:GetTextureFilePath()).toBe(CAT .. "CornerPaw.tga")
    expect(corner).toHaveSize(7 * draw.ORNAMENT, 7 * draw.ORNAMENT)
    expect(corner:GetRotation()).toBeCloseTo(0, 4)
    -- its colour kept through the change
    expect(tokenOf(corner)).toBe("gilt")
    -- one made while the theme has its file: drawn from it at once
    local mark = draw.ornament(p, 5, "corner", "ink")
    expect(mark:GetTextureFilePath()).toBe(CAT .. "CornerPaw.tga")
    expect(mark).toHaveSize(10, 10)
    back()
    expect(corner:GetTextureFilePath()).toBe(T.texture.corner)
    expect(corner).toHaveSize(7, 7)
    expect(corner:GetRotation()).toBeCloseTo(math.rad(45), 4)
    expect(mark).toHaveSize(5, 5)
    expect(function()
        draw.ornament(p, 5, "sparkle")
    end).toThrow("unknown texture token sparkle")
end

@test("a divider is the hairline until a theme sets its file: then strips 8 px tall, faded like the line")
local function dividers()
    local p = host()
    local both = draw.hairline(p, "gilt-line", "both", "divider")
    both:SetPoint("TOPLEFT")
    both:SetPoint("TOPRIGHT")
    local out = draw.hairline(p, "gilt-line", "out", "divider")
    local solid = draw.hairline(p, "gilt-faint", nil, "divider")
    local plain = draw.hairline(p, "gilt-line", "both")
    expect(draw.dividerStrips(both)).toBeNil()
    local regions = #{ both:GetRegions() }
    local back = swapFile("divider", CAT .. "Divider.tga")
    local strips = assert(draw.dividerStrips(both))
    expect(#strips).toBe(2)
    expect(#{ both:GetRegions() }).toBe(regions + 2)
    expect(strips[1]:GetTextureFilePath()).toBe(CAT .. "Divider.tga")
    expect(strips[1]:GetHeight()).toBe(8)
    expect(strips[1]:GetHorizTile()).toBe(true)
    expect(strips[1]:IsShown()).toBe(true)
    -- faded at both ends, as the line is
    local a, b = paintOf(strips[1]), paintOf(strips[2])
    expect(a and a.kind).toBe("gradient")
    expect({ a and a.alpha, a and a.alpha2 }).toEqual({ 0, 1 })
    expect({ b and b.alpha, b and b.alpha2 }).toEqual({ 1, 0 })
    -- the line's own textures hidden
    for _, r in ipairs({ both:GetRegions() }) do
        local t = r :: Texture
        if t ~= strips[1] and t ~= strips[2] then
            expect(t:IsShown()).toBe(false)
        end
    end
    local o = assert(draw.dividerStrips(out))
    expect(#o).toBe(1)
    local op = paintOf(o[1])
    expect({ op and op.alpha, op and op.alpha2 }).toEqual({ 1, 0 })
    expect(tokenOf(assert(draw.dividerStrips(solid))[1])).toBe("gilt-faint")
    -- a hairline without the token stays a hairline
    expect(draw.dividerStrips(plain)).toBeNil()
    back()
    expect(draw.dividerStrips(both)).toBeNil()
    expect(strips[1]:IsShown()).toBe(false)
    for _, r in ipairs({ both:GetRegions() }) do
        local t = r :: Texture
        if t ~= strips[1] and t ~= strips[2] then
            expect(t:IsShown()).toBe(true)
        end
    end
end

@test("a textured edge: solid lines in SuuUI's look; a theme's file tiled in the edge's colour; a fill again")
local function texturedBorders()
    local p = host()
    p:SetSize(100, 50)
    local b = draw.border(p, "gilt-line", { texture = "border" })
    local plain = draw.border(p, "gilt-line")
    expect(paintOf(b.top) and (paintOf(b.top) :: KeptPaint).kind).toBe("fill")
    local back = swapFile("border", CAT .. "Stitch.tga")
    for _, t in ipairs(b.parts) do
        expect(t:GetTextureFilePath()).toBe(CAT .. "Stitch.tga")
        expect(t:GetHorizTile()).toBe(true)
        expect(t:GetVertTile()).toBe(true)
        local kept = paintOf(t)
        expect(kept and kept.kind).toBe("vertex")
        expect(tokenOf(t)).toBe("gilt-line")
    end
    -- a later colour: on the file
    b:SetColor("ember", 0.5)
    expect(tokenOf(b.left)).toBe("ember")
    expect(b.left:GetTextureFilePath()).toBe(CAT .. "Stitch.tga")
    b:SetColor(1, 0, 0, 1)
    local r, g, bl = b.left:GetVertexColor()
    expect({ r, g, bl }).toEqual({ 1, 0, 0 })
    b:SetColor("gilt-line")
    -- an edge without the option keeps its solid line
    expect(paintOf(plain.top) and (paintOf(plain.top) :: KeptPaint).kind).toBe("fill")
    back()
    for _, t in ipairs(b.parts) do
        local kept = paintOf(t)
        expect(kept and kept.kind).toBe("fill")
        expect(tokenOf(t)).toBe("gilt-line")
    end
    expect(function()
        draw.border(p, "gilt-line", { texture = "sparkle" })
    end).toThrow("unknown texture token sparkle")
end

@test("the plates' bars draw the unit frames' files until a theme gives them their own")
local function plateBars()
    local p = host()
    local health = CreateFrame("StatusBar", nil, p)
    draw.skinBar(health, "plate-health-bar")
    local cast = CreateFrame("StatusBar", nil, p)
    draw.skinBar(cast, "plate-cast-bar")
    expect(draw.textureFile("plate-health-bar")).toBe(T.texture["health-bar"])
    expect(draw.textureFile("plate-cast-bar")).toBe(T.texture["cast-bar"])
    -- the unit frames' file changes: the plates' too
    local back = swapFile("health-bar", CAT .. "PawBar.tga")
    expect(health:GetStatusBarTexture():GetTextureFilePath()).toBe(CAT .. "PawBar.tga")
    -- their own file wins
    local back2 = swapFile("plate-health-bar", CAT .. "PlateBar.tga")
    expect(health:GetStatusBarTexture():GetTextureFilePath()).toBe(CAT .. "PlateBar.tga")
    back2()
    expect(health:GetStatusBarTexture():GetTextureFilePath()).toBe(CAT .. "PawBar.tga")
    back()
    expect(health:GetStatusBarTexture():GetTextureFilePath()).toBe(T.texture["health-bar"])
    expect(cast:GetStatusBarTexture():GetTextureFilePath()).toBe(T.texture["cast-bar"])
end

-- A bar token's art repeated (as a theme's { file, height } does), undone by
-- the function returned.
local function repeatArt(token: string, file: string, height: number): () -> ()
    local files = T.texture :: { [string]: string }
    local was = assert(files[token])
    files[token] = file
    draw.setTiles({ [token] = height })
    draw.reskin()
    return function()
        files[token] = was
        draw.setTiles({})
        draw.reskin()
    end
end

@test(
    "a bar's art the theme repeats: copies along the bar at its height that follow the fill and its colours; stretched again after"
)
local function repeatedBars()
    local p = host()
    local bar = CreateFrame("StatusBar", nil, p)
    bar:SetSize(300, 8)
    bar:SetPoint("CENTER")
    draw.skinBar(bar, "bar")
    bar:SetMinMaxValues(0, 100)
    bar:SetValue(40)
    draw.paint(bar, "mana")
    local fill = bar:GetStatusBarTexture()
    -- SuuUI's own look: the white square stretched, nothing made
    expect(draw.repeatOf(bar)).toBeNil()
    local before = #{ bar:GetRegions() }
    local back = repeatArt("bar", CAT .. "BeanBar.tga", 16)
    local over = assert(draw.repeatOf(bar))
    expect(#{ bar:GetRegions() }).toBe(before + 1)
    expect(over:GetTextureFilePath()).toBe(CAT .. "BeanBar.tga")
    expect(over:GetHorizTile()).toBe(true)
    expect(over:GetVertTile()).toBe(false)
    -- each copy as tall as the bar: 16 px art at half its size
    expect(over:GetScale()).toBeCloseTo(0.5)
    -- over the fill, which shows nothing itself
    expect(fill:GetAlpha()).toBe(0)
    -- (where, on the screen: the copies' own units are scaled)
    local function onScreen(r: Region, x: number): number
        return x * r:GetEffectiveScale()
    end
    expect(onScreen(over, over:GetLeft())).toBeCloseTo(onScreen(fill, fill:GetLeft()))
    expect(onScreen(over, over:GetRight())).toBeCloseTo(onScreen(fill, fill:GetRight()))
    expect(onScreen(over, over:GetRight())).toBeCloseTo(onScreen(bar, bar:GetLeft() + 120))
    -- the fill's colours: the bar's, a gradient, a repaint
    draw.repaint()
    local r, g, b = over:GetVertexColor()
    expect(colorIs(r, g, b, nil, "mana")).toBe(true)
    bar:SetStatusBarColor(1, 0, 0, 1)
    r, g, b = over:GetVertexColor()
    expect({ r, g, b }).toEqual({ 1, 0, 0 })
    local gradients = record(over, "SetGradient")
    draw.paintGradient(fill, "HORIZONTAL", "unit-fill-deep", "unit-fill")
    expect(#gradients).toBe(1)
    -- the value moves: the copies with the fill
    bar:SetValue(90)
    expect(onScreen(over, over:GetRight())).toBeCloseTo(onScreen(bar, bar:GetLeft() + 270))
    -- the bar grows: the copies too
    bar:SetHeight(24)
    mock.advanceFrames(1)
    expect(over:GetScale()).toBeCloseTo(1.5)
    -- shown with the fill, its alpha theirs
    fill:Hide()
    expect(over:IsShown()).toBe(false)
    fill:Show()
    expect(over:IsShown()).toBe(true)
    fill:SetAlpha(0.5)
    expect(over:GetAlpha()).toBeCloseTo(0.5, 2)
    expect(fill:GetAlpha()).toBe(0)
    -- the theme stretches it again: the fill shows its file, the copies go
    back()
    expect(draw.repeatOf(bar)).toBeNil()
    expect(over:IsShown()).toBe(false)
    expect(fill:GetAlpha()).toBeCloseTo(0.5, 2)
    expect(fill:GetTextureFilePath()).toBe(T.texture.bar)
end

@test("a bar out of sight gets the repeated art's copies when it first shows, not before; none if the theme changed back")
local function repeatedHiddenBars()
    local p = host()
    local holder = CreateFrame("Frame", nil, p)
    holder:SetAllPoints()
    holder:Hide()
    local bar = CreateFrame("StatusBar", nil, holder)
    bar:SetSize(300, 8)
    bar:SetPoint("CENTER")
    draw.skinBar(bar, "bar")
    draw.paint(bar, "mana")
    local fill = bar:GetStatusBarTexture()
    local regions = #{ bar:GetRegions() }
    local back = repeatArt("bar", CAT .. "BeanBar.tga", 16)
    -- (its parent hidden: nothing made yet)
    expect(draw.repeatOf(bar)).toBeNil()
    expect(#{ bar:GetRegions() }).toBe(regions)
    holder:Show()
    local over = assert(draw.repeatOf(bar))
    expect(over:GetTextureFilePath()).toBe(CAT .. "BeanBar.tga")
    expect(over:GetScale()).toBeCloseTo(0.5)
    expect(fill:GetAlpha()).toBe(0)
    expect(over:IsVisible()).toBe(true)
    local r, g, b = over:GetVertexColor()
    expect(colorIs(r, g, b, nil, "mana")).toBe(true)
    back()
    expect(draw.repeatOf(bar)).toBeNil()
    -- out of sight again, the theme repeats, then stretches again: nothing
    -- made when it shows
    local other = CreateFrame("StatusBar", nil, holder)
    other:SetSize(100, 8)
    other:SetPoint("TOP")
    draw.skinBar(other, "bar")
    holder:Hide()
    local back2 = repeatArt("bar", CAT .. "BeanBar.tga", 16)
    back2()
    holder:Show()
    expect(draw.repeatOf(other)).toBeNil()
    expect(other:GetStatusBarTexture():GetAlpha()).toBe(1)
    -- and unskinned while waiting: nothing either
    holder:Hide()
    local back3 = repeatArt("bar", CAT .. "BeanBar.tga", 16)
    draw.unskin(other)
    holder:Show()
    expect(draw.repeatOf(other)).toBeNil()
    back3()
    expectNoErrors()
end

@test(
    "a bar showing a secret value (another unit's health): the theme's repeated art follows its fill without handing the fill's secret IsShown to SetShown"
)
local function repeatedSecretBars()
    -- (found in game, 2026-11-13: picking Stranglethorn Ruins raised
    -- "bad argument #1 to 'SetShown' (… Secret values are only allowed
    -- during untainted execution …)" for every nameplate)
    local p = host()
    local bar = CreateFrame("StatusBar", nil, p)
    bar:SetSize(300, 8)
    bar:SetPoint("CENTER")
    draw.skinBar(bar, "bar")
    bar:SetMinMaxValues(0, 100)
    bar:SetValue(mock.secret(40))
    local fill = bar:GetStatusBarTexture()
    local back = repeatArt("bar", CAT .. "BeanBar.tga", 16)
    local over = assert(draw.repeatOf(bar))
    -- shown, how much from the fill's secret answer
    expect(over:IsShown()).toBe(true)
    fill:Hide()
    fill:Show()
    expect(over:IsShown()).toBe(true)
    -- a plain value again: the copies follow the fill as before
    bar:SetValue(40)
    fill:Hide()
    expect(over:IsShown()).toBe(false)
    fill:Show()
    expect(over:IsShown()).toBe(true)
    back()
    expectNoErrors()
end

@test(
    "a bar out of sight gets its copies when it shows, in the gradient painted on its fill while it waited"
)
local function repeatedLateGradient()
    -- (found in game, 2026-11-13: Ulduar · Titan with NPC reaction colours,
    -- the nameplates' health white; the copies made at the bar's first show
    -- took its plain colour, not the gradient painted before)
    local p = host()
    local bar = CreateFrame("StatusBar", nil, p)
    bar:SetSize(300, 8)
    bar:SetPoint("CENTER")
    draw.skinBar(bar, "bar")
    bar:SetMinMaxValues(0, 100)
    bar:SetValue(40)
    bar:Hide()
    local back = repeatArt("bar", CAT .. "BeanBar.tga", 16)
    -- out of sight: no copies yet
    expect(draw.repeatOf(bar)).toBeNil()
    local fill = bar:GetStatusBarTexture()
    draw.paintGradient(fill, "HORIZONTAL", "unit-fill-deep", "unit-fill")
    -- which textures get a gradient from here on (the copies are made inside)
    local graded: { [unknown]: boolean } = {}
    local methods = (getmetatable(fill) :: { __index: { [string]: unknown } }).__index
    hooksecurefunc(methods, "SetGradient", function(t: unknown)
        graded[t] = true
    end)
    bar:Show()
    local over = assert(draw.repeatOf(bar))
    expect(graded[over]).toBe(true)
    back()
    expectNoErrors()
end

@test(
    "repeated art on a plain fill follows its size; the plates repeat the unit frames' art; the game's bars take the plain fill"
)
local function repeatedFills()
    local p = host()
    local t = draw.barFill(p, "progress-fill")
    t:SetPoint("TOPLEFT")
    local plate = CreateFrame("StatusBar", nil, p)
    plate:SetSize(140, 10)
    plate:SetPoint("CENTER")
    draw.skinBar(plate, "plate-health-bar")
    local game = CreateFrame("StatusBar", nil, p)
    game:SetSize(200, 4)
    game:SetPoint("BOTTOM")
    draw.skinBar(game, "health-bar", true)
    local back = repeatArt("bar", CAT .. "BeanBar.tga", 16)
    t:SetSize(200, 4)
    local over = assert(draw.repeatOf(t))
    expect(over:GetScale()).toBeCloseTo(0.25)
    expect(t:GetAlpha()).toBe(0)
    t:SetHeight(8)
    expect(over:GetScale()).toBeCloseTo(0.5)
    back()
    expect(t:GetAlpha()).toBe(1)
    local back2 = repeatArt("health-bar", CAT .. "PawBar.tga", 32)
    -- (no file of their own: the plates take health-bar's art and height)
    local plateOver = assert(draw.repeatOf(plate))
    expect(plateOver:GetTextureFilePath()).toBe(CAT .. "PawBar.tga")
    expect(plateOver:GetScale()).toBeCloseTo(10 / 32)
    -- the game's own bar: no copies (no hooks on it), the plain fill
    expect(draw.repeatOf(game)).toBeNil()
    expect(game:GetStatusBarTexture():GetTextureFilePath()).toBe("Interface\\Buttons\\WHITE8X8")
    back2()
    expect(draw.repeatOf(plate)).toBeNil()
    expect(game:GetStatusBarTexture():GetTextureFilePath()).toBe(T.texture["health-bar"])
end

@test("repeated art on a fill whose size is secret (another unit's health): no error, the frame holding it gives the height")
local function repeatedSecret()
    -- (in game at login, 2026-11-12: "attempt to compare local 'a' (a
    -- secret number value, while execution tainted by 'SuuUI')")
    local p = host()
    local holder = CreateFrame("Frame", nil, p)
    holder:SetSize(200, 8)
    holder:SetPoint("CENTER")
    local t = draw.barFill(holder, "progress-fill")
    t:SetPoint("TOPLEFT")
    t:SetSize(120, 8)
    mock.stub(t, "GetHeight", function(): number
        return mock.secret(8) :: unknown :: number
    end)
    local back = repeatArt("bar", CAT .. "BeanBar.tga", 16)
    local over = assert(draw.repeatOf(t))
    expect(over:GetScale()).toBeCloseTo(0.5)
    t:SetSize(60, 8)
    mock.advanceFrames(1)
    back()
    expectNoErrors()
end

@test("the cross is two crossed strokes in a square, recoloured together")
local function crosses()
    local p = host()
    local c = draw.cross(p, 10)
    expect(c).toHaveSize(10, 10)
    expect(#c.strokes).toBe(2)
    expect(c.strokes[1]:GetRotation()).toBeCloseTo(math.rad(45), 4)
    expect(c.strokes[2]:GetRotation()).toBeCloseTo(math.rad(-45), 4)
    expect(c.strokes[1]:GetWidth()).toBeCloseTo(11.5, 4)
    expect(tokenOf(c.strokes[1])).toBe("ink-muted")
    c:SetColor("ink")
    expect(tokenOf(c.strokes[2])).toBe("ink")
    local d = draw.cross(p, 8, "ember")
    expect(tokenOf(d.strokes[1])).toBe("ember")
end

@test(
    "relayoutPixels: a frame that refuses addon code (the game's aura buttons in a fight, IsForbidden false) is skipped; the rest laid"
)
local function relayoutRefused()
    -- (probed 2026-11-12: in combat an aura button answers IsForbidden false
    -- and refuses GetChildren and the rest)
    local f = CreateFrame("Frame", nil, UIParent)
    f:SetSize(40, 10)
    local locked = CreateFrame("Frame", nil, f)
    local open = CreateFrame("Frame", nil, f)
    open:SetSize(20, 10)
    local b = draw.border(open, "gilt-hairline")
    mock.stub(locked, "GetChildren", function(): Frame
        error("bad argument #1 to '?' (Attempt to access forbidden object from code tainted by an AddOn)")
    end)
    local other = CreateFrame("Frame", nil, WorldFrame)
    other:SetScale(0.5)
    f:SetParent(other)
    draw.relayoutPixels(f)
    local px = b.top:GetHeight() * b.top:GetEffectiveScale() / pixel.perfectScale()
    expect(math.abs(px - 1) < 0.001).toBe(true)
    f:Hide()
    other:Hide()
end

@test("relayoutPixels: a frame moved under a parent of another scale gets its lines one physical pixel again")
local function relayout()
    local f = CreateFrame("Frame", nil, UIParent)
    f:SetSize(40, 10)
    local b = draw.border(f, "gilt-hairline")
    local line = draw.hairline(f, "gilt-hairline")
    -- one physical pixel, in screen pixels
    local function px(r: Region, h: number): number
        return h * r:GetEffectiveScale() / pixel.perfectScale()
    end
    expect(math.abs(px(b.top, b.top:GetHeight()) - 1) < 0.001).toBe(true)
    -- under WorldFrame at half scale (the game's nameplates hang on WorldFrame)
    local other = CreateFrame("Frame", nil, WorldFrame)
    other:SetScale(0.5)
    f:SetParent(other)
    expect(math.abs(px(b.top, b.top:GetHeight()) - 1) < 0.001).toBe(false)
    draw.relayoutPixels(f)
    expect(math.abs(px(b.top, b.top:GetHeight()) - 1) < 0.001).toBe(true)
    expect(math.abs(px(b.left, b.left:GetWidth()) - 1) < 0.001).toBe(true)
    expect(math.abs(px(line, line:GetHeight()) - 1) < 0.001).toBe(true)
    -- a frame outside it: left as it was
    local outside = CreateFrame("Frame", nil, other)
    local ob = draw.border(outside, "gilt-hairline")
    outside:SetParent(UIParent)
    local before = ob.top:GetHeight()
    draw.relayoutPixels(f)
    expect(ob.top:GetHeight()).toBe(before)
    f:Hide()
    other:Hide()
    outside:Hide()
end

@test("layout: fn now and on each relayout; onLayout only on a relayout; a failing one is reported, the rest still run")
local function layoutKept()
    local f = host()
    local now, later = 0, 0
    draw.layout(f, function()
        now += 1
    end)
    draw.onLayout(f, function()
        later += 1
    end)
    expect(draw.laysOut(f)).toBe(true)
    expect(draw.laysOut(CreateFrame("Frame"))).toBe(false)
    expect({ now, later }).toEqual({ 1, 0 })
    draw.relayout()
    expect({ now, later }).toEqual({ 2, 1 })
    -- (the error handler faked, as for repaint)
    local reported: string[] = {}
    mock.fake("geterrorhandler", function(): (err: unknown) -> ()
        return function(err: unknown)
            reported[#reported + 1] = tostring(err)
        end
    end)
    local fail = true
    draw.onLayout(f, function()
        if fail then
            error("broken layout")
        end
    end)
    local ran = false
    draw.onLayout(f, function()
        ran = true
    end)
    draw.relayout()
    fail = false
    expect(#reported).toBe(1)
    expect(reported[1]).toContain("broken layout")
    expect(ran).toBe(true)
    expect({ now, later }).toEqual({ 3, 2 })
end
