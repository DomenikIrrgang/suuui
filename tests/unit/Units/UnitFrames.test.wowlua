-- Units/UnitFrames: the frames (player, target, target of target, focus,
-- pet, bosses) over Blizzard's stood-down ones, published for others to
-- attach to; each following its unit, off by its setting or hidden in
-- edit mode (after a fight); the player and target size (after a fight);
-- the options live; the out-of-combat fade; aggro on your frame in a
-- group; combo points; pet happiness; the rested sign and its tooltip lines; the
-- combat sign; the settings preview and rows; stopped.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, SECTION from "/Units/UnitFrames"
import expectNoErrors, expectPingable from "../../helpers"
import * as frames from "wowlua:frames"
import * as settings from "/Core/Settings"
import * as themes from "/Core/Themes"
import * as healthFill from "/UI/HealthFill"

-- One of the game's frames, by name.
local function game(name: string): Frame
    return assert(frames.find(name))
end
local T = SuuUI.Tokens

local wolf = mock.spawnUnit({ name = "Prowler", level = 9, reaction = "hostile", distance = 10 })
local tank = mock.spawnUnit({
    name = "Brannoc Ironhand",
    player = true,
    class = "WARRIOR",
    level = 30,
    reaction = "friendly",
})

@afterEach
local function cleanup()
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    mock.player:target(nil)
    wolf:setThreat(nil)
    wolf:setThreat(nil, tank)
    mock.group:leave()
    mock.setResting(false)
    settings.reset("ui", "reducedMotion")
    M:ResetAll({
        "showToT",
        "showFocus",
        "showPet",
        "showBoss",
        "fadeOutOfCombat",
        "showPower",
        "healthText",
        "nameColor",
        "showMeta",
        "eliteDragon",
        "raidMarkers",
        "comboPoints",
        "petHappiness",
        "width",
        "height",
        "debuffBadges",
        "restedSign",
        "restedShow",
        "restedAnimation",
        "restedHideCombat",
        "restedHideMax",
        "combatBadge",
        "combatPop",
        "targetPosition",
        "totPosition",
        "focusPosition",
        "petPosition",
        "bossPosition",
    })
    mock.advanceFrames(2)
    expectNoErrors()
end

-- A settings row as the tests read it.
type Row = { key?: string, disabled?: () -> (boolean?, string?) }
local function rows(): { [string]: Row }
    local out: { [string]: Row } = {}
    for _, g in ipairs(SECTION.groups or {}) do
        for _, r in ipairs(g.rows) do
            local row: Row = r
            if row.key then
                out[row.key] = row
            end
        end
    end
    return out
end
-- why a row is off
local function disabled(r: Row?): (boolean?, string?)
    return assert(assert(r).disabled)()
end

@test("every frame drawn over Blizzard's stood-down ones and published for other modules")
local function framesDrawn()
    expect(game("PlayerFrame"):IsShown()).toBe(false)
    expect(game("TargetFrame"):IsShown()).toBe(false)
    expect(assert(M.frames).player:IsShown()).toBe(true)
    expect(SuuUI.GetAnchor("player")).toBe(assert(M.frames).player)
    expect(SuuUI.GetAnchor("target")).toBe(assert(M.frames).target)
    expect(SuuUI.GetAnchor("targettarget")).toBe(assert(M.frames).tot)
    expect(SuuUI.GetAnchor("boss3")).toBe(M.bosses[3])
end

@test("each frame follows its unit; off by its setting or hidden in edit mode, after a fight")
local function follow()
    local target = assert(M.frames).target
    expect(target:IsShown()).toBe(false)
    mock.player:target(wolf)
    mock.advanceFrames(2)
    expect(target:IsShown()).toBe(true)
    -- the target's target: the wolf on you
    wolf:target(mock.player)
    mock.advanceFrames(12)
    expect(assert(M.frames).tot:IsShown()).toBe(true)
    M:Set("showToT", false)
    mock.advanceFrames(2)
    expect(assert(M.frames).tot:IsShown()).toBe(false)
    M:Set("showToT", true)
    mock.advanceFrames(2)
    expect(assert(M.frames).tot:IsShown()).toBe(true)
    -- in a fight: after it
    mock.player:enterCombat()
    mock.advanceFrames(1)
    M:Set("targetPosition", { point = "BOTTOM", x = 350, y = 308, hidden = true })
    expect(target:IsShown()).toBe(true)
    mock.player:leaveCombat()
    mock.advanceFrames(2)
    expect(target:IsShown()).toBe(false)
    M:Set("showBoss", false)
    M:Set("showFocus", false)
    M:Set("showPet", false)
end

@test("pingable: a ping over each frame pings its unit, as over the game's frames")
local function pingable()
    local f = assert(M.frames)
    local beast = mock.spawnUnit({ name = "Grimfang", level = 9, reaction = "friendly" })
    mock.setPet(beast)
    mock.player:target(wolf)
    mock.player:focus(wolf)
    wolf:target(mock.player)
    mock.advanceFrames(12)
    expectPingable(f.player, "player")
    expectPingable(f.target, "target")
    expectPingable(f.tot, "targettarget")
    expectPingable(f.focus, "focus")
    expectPingable(f.pet, "pet")
    expect(UnitGUID("target")).toBe(UnitGUID("focus"))
    -- the boss frames too (no boss here: the attribute alone)
    for _, b in ipairs(M.bosses) do
        expect(b:GetAttribute("ping-receiver")).toBe(true)
    end
    mock.player:focus(nil)
    mock.setPet(nil)
    beast:despawn()
end

@test("the player and target size, after a fight")
local function size()
    M:Set("width", 300)
    M:Set("height", 40)
    expect(assert(M.frames).player:GetWidth()).toBe(300)
    expect(assert(M.frames).target:GetHeight()).toBe(40)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    M:Set("width", 260)
    expect(assert(M.frames).player:GetWidth()).toBe(300)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(assert(M.frames).player:GetWidth()).toBe(260)
end

@test("the options live on every frame")
local function options()
    M:Set("showPower", false)
    M:Set("healthText", "both")
    M:Set("nameColor", "ink")
    M:Set("raidMarkers", false)
    M:Set("showMeta", false)
    M:Set("eliteDragon", true)
    local f = assert(M.frames).target
    expect(f.opts.power).toBe(false)
    expect(f.opts.healthText).toBe("both")
    expect(f.opts.nameColor).toBe("ink")
    expect(f.opts.raidMarker).toBe(false)
    expect(f.opts.meta).toBe(false)
    expect(f.opts.dragon).toBe(true)
    -- the target of target has no power line
    M:Set("showPower", true)
    expect(assert(M.frames).tot.opts.power).toBe(false)
    expect(assert(M.frames).player.opts.power).toBe(true)
end

@test(
    "out of combat at full health the frames rest dimmed (the game picks it from your secret health); hurt, in combat or hovered: full"
)
local function fade()
    local player, target = assert(M.frames).player, assert(M.frames).target
    -- (alphas are stored at 8 bits: the resting one as a plain frame reads it back)
    local probe = CreateFrame("Frame")
    probe:SetAlpha(T.opacity["opacity-ooc"])
    local rest = mock.secret(probe:GetAlpha())
    M:UpdateFade()
    expect(player:GetAlpha() :: unknown).toBe(rest)
    expect(target:GetAlpha() :: unknown).toBe(rest)
    -- hurt: shown in full, at once
    mock.player:damage(50)
    mock.advanceFrames(2)
    expect(player:GetAlpha() :: unknown).toBe(mock.secret(1))
    mock.player:heal(50)
    mock.advanceFrames(2)
    expect(player:GetAlpha() :: unknown).toBe(rest)
    -- hovered: full at once (a secret alpha can't be faded from; it reads
    -- back secret for good), then resting again
    mock.hover(player)
    expect(player:GetAlpha() :: unknown).toBe(mock.secret(1))
    mock.hover(nil)
    expect(player:GetAlpha() :: unknown).toBe(rest)
    -- in combat: full
    mock.player:enterCombat()
    mock.advanceFrames(2)
    expect(player:GetAlpha() :: unknown).toBe(mock.secret(1))
    mock.player:leaveCombat()
    mock.advanceFrames(2)
    -- the setting off: full, faded to
    M:Set("fadeOutOfCombat", false)
    mock.advanceFrames(120)
    expect(player:GetAlpha() :: unknown).toBe(mock.secret(1))
    expectNoErrors()
end

@test("aggro on your frame in a group (not as the tank); solo none")
local function aggro()
    local player = assert(M.frames).player
    mock.player:target(wolf)
    wolf:setThreat(100)
    mock.advanceFrames(1)
    expect(player.stateTone).toBeNil()
    tank:setRole("TANK")
    mock.group:add(tank)
    wolf:setThreat(80, tank)
    wolf:target(mock.player)
    mock.advanceFrames(1)
    expect(player.stateTone).toBe("danger")
    expect(player.stateWord).toBe("Aggro")
    -- the wolf back on the tank, you below it
    wolf:target(tank)
    wolf:setThreat(50)
    mock.advanceFrames(1)
    expect(player.stateTone).toBeNil()
end

@test("combo points on the target: a rogue's on an enemy; the setting off")
local function combo()
    local c = assert(M.combo)
    -- on the top edge at the left end, clear of the debuffs over the right
    -- end (found in game: they covered the points), over the frame's border
    local target = assert(SuuUI.GetAnchor("target"))
    local point, rel, relPoint, x, y = c:GetPoint(1)
    expect(point).toBe("LEFT")
    expect(rel).toBe(target)
    expect(relPoint).toBe("TOPLEFT")
    expect(x).toBe(6)
    expect(y).toBe(-0.5)
    expect(c:GetFrameLevel() > target:GetFrameLevel() + 9).toBe(true)
    mock.player:target(wolf)
    mock.advanceFrames(1)
    expect(c:IsShown()).toBe(false)
    mock.setPlayer({ class = "ROGUE" })
    c:Update()
    expect(c:IsShown()).toBe(true)
    expect(c.pips[1].lit:GetAlpha()).toBe(0)
    M:Set("comboPoints", false)
    expect(c:IsShown()).toBe(false)
    M:Set("comboPoints", true)
    -- a druid: in cat form (energy) only
    mock.setPlayer({ class = "DRUID" })
    c:Update()
    expect(c:IsShown()).toBe(false)
    mock.setPlayer({ class = "WARRIOR" })
end

@test("the rested sign while you rest and earn; full; carrying; hidden in combat and at the cap")
local function rested()
    local sign = assert(M.restedSign)
    expect(sign.look).toBeNil()
    mock.player:setStats({ restedXP = 400, xpMax = 1000 })
    mock.setResting(true)
    mock.advanceFrames(1)
    expect(sign.look).toBe("earn")
    mock.player:setStats({ restedXP = 1500 })
    mock.advanceFrames(1)
    expect(sign.look).toBe("full")
    -- in combat: gone; back after
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(sign.look).toBeNil()
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(sign.look).toBe("full")
    -- out of the inn with some left: only when asked
    mock.player:setStats({ restedXP = 400 })
    mock.setResting(false)
    mock.advanceFrames(1)
    expect(sign.look).toBeNil()
    M:Set("restedShow", "carrying")
    expect(sign.look).toBe("carry")
    -- at the cap: none, or the still sign in an inn
    mock.setPlayer({ level = 60 })
    M:UpdateRested()
    expect(sign.look).toBeNil()
    M:Set("restedHideMax", false)
    mock.setResting(true)
    mock.advanceFrames(1)
    expect(sign.look).toBe("rest")
    mock.setPlayer({ level = 1 })
    M:Set("restedSign", false)
    expect(sign.look).toBeNil()
end

@test("your frame's tooltip: the rested lines after the unit's")
local function tooltip()
    local lines: { string } = {}
    local tip = GameTooltip
    mock.stub(tip, "AddLine", function(_: unknown, text: string)
        lines[#lines + 1] = text
    end)
    mock.stub(tip, "AddDoubleLine", function(_: unknown, a: string, b: string)
        lines[#lines + 1] = a .. " | " .. b
    end)
    mock.player:setStats({ restedXP = 400, xpMax = 1000 })
    mock.setResting(true)
    mock.advanceFrames(1)
    M:AddRestedLines(tip)
    expect(lines[3]).toBe("Rested XP | 400 · 40% of a level")
    expect(lines[4]).toBe("Earning rested XP")
    expect(lines[5]).toBe("Logging out here is instant.")
    lines = {}
    mock.player:setStats({ restedXP = 1500 })
    M:AddRestedLines(tip)
    expect(lines[4]).toBe("Rested XP full")
    lines = {}
    mock.setResting(false)
    mock.player:setStats({ restedXP = 400 })
    M:Set("restedShow", "carrying")
    M:AddRestedLines(tip)
    expect(lines[4]).toBe("Kills give double XP until it's spent.")
    expect(#lines).toBe(5)
    lines = {}
    M:Set("restedSign", false)
    M:AddRestedLines(tip)
    expect(#lines).toBe(0)
    -- hovering your frame calls it
    expect(assert(M.frames).player.onTooltip ~= nil).toBe(true)
end

@test("edit mode: the sign stands still where it could show")
local function editMode()
    local active = true
    mock.stub(SuuUI.EditMode, "IsActive", function(): boolean
        return active
    end)
    M:Emit("SUUUI_EDITMODE_CHANGED", true)
    expect(assert(M.restedSign).look).toBe("rest")
    active = false
    M:Emit("SUUUI_EDITMODE_CHANGED", false)
end

-- Whether two regions' rectangles overlap.
local function overlap(a: Region, b: Region): boolean
    return a:GetLeft() < b:GetRight() and b:GetLeft() < a:GetRight() and a:GetBottom() < b:GetTop() and
        b:GetBottom() < a:GetTop()
end

-- Every combat sign animation done.
local function settle()
    mock.advanceTime(1)
    mock.advanceFrames(40)
end

@test("the combat sign: shown in combat, gone after; the pop and its ring once as combat starts")
local function combatSign()
    local badge = assert(M.combatBadge)
    settle() -- (an earlier test's fight fading out)
    expect(badge:IsShown()).toBe(false)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(badge:IsShown()).toBe(true)
    expect(badge.pop:IsPlaying()).toBe(true)
    expect(badge.ringPop:IsPlaying()).toBe(true)
    settle()
    expect(badge.pop:IsPlaying()).toBe(false)
    expect(badge.ringPop:IsPlaying()).toBe(false)
    expect(badge:IsShown()).toBe(true)
    -- a change mid-fight doesn't pop it again
    M:Set("combatPop", true)
    M:UpdateCombatBadge()
    expect(badge.pop:IsPlaying()).toBe(false)
    -- out of combat: it fades, then it is gone
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(badge.out:IsPlaying()).toBe(true)
    settle()
    expect(badge:IsShown()).toBe(false)
    -- the next fight pops it again
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(badge:IsShown()).toBe(true)
    expect(badge.pop:IsPlaying()).toBe(true)
end

@test("the combat sign without the pop: Pop when combat starts off, or Reduce motion on")
local function combatSignStill()
    local badge = assert(M.combatBadge)
    M:Set("combatPop", false)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(badge:IsShown()).toBe(true)
    expect(badge.pop:IsPlaying()).toBe(false)
    expect(badge.ringPop:IsPlaying()).toBe(false)
    mock.player:leaveCombat()
    settle()
    M:Set("combatPop", true)
    settings.set("ui", "reducedMotion", true)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(badge:IsShown()).toBe(true)
    expect(badge:GetAlpha()).toBe(1)
    expect(badge.pop:IsPlaying()).toBe(false)
    expect(badge.ringPop:IsPlaying()).toBe(false)
    -- and gone at once after the fight
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(badge:IsShown()).toBe(false)
    settings.reset("ui", "reducedMotion")
end

@test("the setting off: the combat sign never shows, in combat either; back on: it shows in combat again")
local function combatSignOff()
    local badge = assert(M.combatBadge)
    M:Set("combatBadge", false)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    settle()
    expect(badge:IsShown()).toBe(false)
    -- back on mid-fight: it fades in (no pop: the fight began before)
    M:Set("combatBadge", true)
    expect(badge:IsShown()).toBe(true)
    expect(badge.pop:IsPlaying()).toBe(false)
    -- off mid-fight: gone at once
    M:Set("combatBadge", false)
    expect(badge:IsShown()).toBe(false)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(badge:IsShown()).toBe(false)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    -- on again: the next fight shows and pops it
    M:Set("combatBadge", true)
    expect(badge:IsShown()).toBe(false)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(badge:IsShown()).toBe(true)
    expect(badge.pop:IsPlaying()).toBe(true)
end

@test("the combat sign sits across your frame's left edge, centred on it vertically, on its marker layer")
local function combatSignPlace()
    local player = assert(M.frames).player
    local badge = assert(M.combatBadge)
    expect(badge:GetParent()).toBe(player.markerLayer)
    expect(badge:IsMouseEnabled()).toBe(false)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    settle()
    local bx, by = badge:GetCenter()
    local _, py = player:GetCenter()
    expect(by).toBeCloseTo(py)
    expect(bx).toBeCloseTo(player:GetLeft() - 4)
    expect(badge:GetLeft() < player:GetLeft()).toBe(true)
    expect(badge:GetRight() > player:GetLeft()).toBe(true)
    -- clear of the role icon or class diamond at the row's start
    expect(badge:GetRight() <= player:GetLeft() + T.space["space-4"] - T.space["space-2"]).toBe(true)
    -- not a protected frame: shown and hidden in combat freely
    expect(badge:IsProtected()).toBe(false)
end

@test("the combat sign and the rested sign both up (Hide in combat off): apart")
local function combatAndRested()
    local badge = assert(M.combatBadge)
    local sign = assert(M.restedSign)
    M:Set("restedHideCombat", false)
    mock.player:setStats({ restedXP = 1500, xpMax = 1000 })
    mock.setResting(true)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    settle()
    expect(sign.look).toBe("full")
    expect(badge:IsShown()).toBe(true)
    for _, l in ipairs(sign.letters) do
        expect(overlap(badge, l.glyph)).toBe(false)
        expect(overlap(badge, l)).toBe(false)
    end
    expect(overlap(badge, assert(sign.letters[1].moon))).toBe(false)
    -- the sign right of the frame's middle, the badge left of it
    local px = assert(M.frames).player:GetCenter()
    expect(badge:GetRight() < px).toBe(true)
    expect(sign:GetLeft() > px).toBe(true)
end

@test("edit mode: the combat sign shows where it sits, without the pop")
local function combatSignEditMode()
    local badge = assert(M.combatBadge)
    local active = true
    mock.stub(SuuUI.EditMode, "IsActive", function(): boolean
        return active
    end)
    M:Emit("SUUUI_EDITMODE_CHANGED", true)
    expect(badge:IsShown()).toBe(true)
    expect(badge.pop:IsPlaying()).toBe(false)
    active = false
    M:Emit("SUUUI_EDITMODE_CHANGED", false)
    expect(badge:IsShown()).toBe(false)
end

@test("the settings preview: your frame at its size, the sign, the reason while it wouldn't show")
local function preview()
    local parent = CreateFrame("Frame", nil, UIParent)
    parent:SetSize(500, 200)
    local v = M:PreviewView(parent)
    expect(v:GetParent()).toBe(parent)
    expect(v.frame:GetWidth()).toBe(M:Get("width"))
    expect(v.reason.value).toBe("")
    M:Set("restedSign", false)
    expect(v.reason.value).toBe("The rested sign is off.")
    M:Set("restedSign", true)
    mock.setPlayer({ level = 60 })
    M:DrawPreview()
    expect(v.reason.value).toBe("Hidden at the level cap: there is no XP to rest for.")
    mock.setPlayer({ level = 1 })
    -- a narrow column: the frame's left end gives way
    parent:SetWidth(200)
    M:DrawPreview()
    expect(v:GetWidth()).toBe(200)
    M:Emit("SUUUI_SETTING_CHANGED", "ui", "reducedMotion")
end

@test("pet happiness: your hunter pet's mood on the pet frame's edge, lit up to it; the setting off")
local function petMood()
    local m = assert(M.petMood)
    local beast = mock.spawnUnit({ name = "Grimfang", level = 9, reaction = "friendly" })
    mock.setPlayer({ class = "HUNTER" })
    mock.setPet(beast, { hunter = true, happiness = 3 })
    mock.advanceFrames(1)
    expect(m:IsShown()).toBe(true)
    -- on the top edge at the left end, over the frame's border
    local pet = assert(M.frames).pet
    local point, rel, relPoint, x, y = m:GetPoint(1)
    expect(point).toBe("LEFT")
    expect(rel).toBe(pet)
    expect(relPoint).toBe("TOPLEFT")
    expect(x).toBe(6)
    expect(y).toBe(-0.5)
    expect(m:GetFrameLevel() > pet:GetFrameLevel() + 9).toBe(true)
    -- happy: all three, fel
    expect(m.pips[3].lit:GetAlpha()).toBe(1)
    local _, g = m.pips[3].lit:GetVertexColor()
    expect(g).toBeCloseTo(T.color.fel[2])
    -- unhappy (UNIT_HAPPINESS): one, ember
    mock.setPet(beast, { hunter = true, happiness = 1 })
    mock.advanceFrames(1)
    expect(m.mood).toBe(1)
    expect(m.pips[1].lit:GetAlpha()).toBe(1)
    expect(m.pips[2].lit:GetAlpha()).toBe(0)
    _, g = m.pips[1].lit:GetVertexColor()
    expect(g).toBeCloseTo(T.color.ember[2])
    -- the setting off
    M:Set("petHappiness", false)
    expect(m:IsShown()).toBe(false)
    M:Set("petHappiness", true)
    expect(m:IsShown()).toBe(true)
    -- another class's pet has no mood
    mock.setPlayer({ class = "WARLOCK" })
    m:Update()
    expect(m:IsShown()).toBe(false)
    -- the pet dismissed (UNIT_PET)
    mock.setPlayer({ class = "HUNTER" })
    m:Update()
    expect(m:IsShown()).toBe(true)
    mock.setPet(nil)
    mock.advanceFrames(1)
    expect(m:IsShown()).toBe(false)
    mock.setPlayer({ class = "WARRIOR" })
    beast:despawn()
end

-- A text drawn in a token's colour?
local function inColor(fs: FontString, token: string): boolean
    local r, g, b = fs:GetTextColor()
    local tr, tg, tb = SuuUI.UI.RGBA(token)
    return math.abs(r - tr) < 0.01 and math.abs(g - tg) < 0.01 and math.abs(b - tb) < 0.01
end

@test("class-coloured health: a player's in their class colour, the name in ink; NPCs as before; the setting off")
local function classHealth()
    local target = assert(M.frames).target
    mock.player:target(tank)
    mock.advanceFrames(1)
    -- off (the default): the fill, the name in its class colour
    expect(healthFill.byClass()).toBe(false)
    expect(target.fillClass).toBe("class-warrior")
    expect(inColor(target.name, "class-warrior")).toBe(true)
    -- on: the class colour drawn, the name in ink
    settings.setAccount("healthColor", "class")
    themes.apply()
    expect(healthFill.byClass()).toBe(true)
    expect(healthFill.lookOf(target.health)).toBe("class-warrior")
    expect(inColor(target.name, "ink")).toBe(true)
    -- an NPC: the fill, its name in its reaction colour
    mock.player:target(wolf)
    mock.advanceFrames(1)
    expect(healthFill.lookOf(target.health)).toBe(false)
    expect(inColor(target.name, "ink")).toBe(false)
    -- off again: the name's class colour back
    mock.player:target(tank)
    mock.advanceFrames(1)
    settings.setAccount("healthColor", nil)
    themes.apply()
    expect(healthFill.byClass()).toBe(false)
    expect(inColor(target.name, "class-warrior")).toBe(true)
    -- the toned colour: 55% over surface-sunk, the deep end at 75%
    local r1, _, _, r2 = healthFill.classColors("class-warrior")
    local cr = SuuUI.UI.RGBA("class-warrior")
    local sr = SuuUI.UI.RGBA("surface-sunk")
    expect(r2).toBeCloseTo(cr * 0.55 + sr * 0.45)
    expect(r1).toBeCloseTo(r2 * 0.75)
end

@test("the settings rows: combo points for rogues and druids; the rested rows wait for the sign")
local function rowsWait()
    local r = rows()
    local moodOff, moodWhy = disabled(r.petHappiness)
    expect(moodOff).toBe(true)
    expect(moodWhy).toBe("Only a hunter's pet has a mood.")
    mock.setPlayer({ class = "HUNTER" })
    expect((disabled(r.petHappiness))).toBe(false)
    mock.setPlayer({ class = "WARRIOR" })
    local off, why = disabled(r.comboPoints)
    expect(off).toBe(true)
    expect(why).toBe("Only rogues and druids use combo points.")
    mock.setPlayer({ class = "DRUID" })
    expect((disabled(r.comboPoints))).toBe(false)
    mock.setPlayer({ class = "WARRIOR" })
    expect((disabled(r.restedShow))).toBeNil()
    M:Set("restedSign", false)
    off, why = disabled(r.restedShow)
    expect(why).toBe("The rested sign is off.")
    -- the pop waits for the combat sign
    expect((disabled(r.combatPop))).toBeNil()
    M:Set("combatBadge", false)
    off, why = disabled(r.combatPop)
    expect(off).toBe(true)
    expect(why).toBe("The combat sign is off.")
    M:Set("debuffBadges", "off")
end

@test("the target tagged by someone else: grey; the tag gone (UNIT_FACTION): back")
local function tappedTarget()
    local target = assert(M.frames).target
    mock.player:target(wolf)
    -- (the game's unit watch shows the frame, on its timer)
    mock.advanceFrames(15, 20)
    expect(target.active).toBe(true)
    expect(target.tappedLook).toBe(false)
    local denied = true
    local a: { [string]: unknown } = setmetatable({
        UnitIsTapDenied = function(_: string): boolean
            return denied
        end,
    }, { __index = _G })
    mock.setField(target, "api", a)
    mock.fireUnitEvent("UNIT_FACTION", "target")
    expect(target.tappedLook).toBe(true)
    -- the tagger died: the tag goes
    denied = false
    mock.fireUnitEvent("UNIT_FACTION", "target")
    expect(target.tappedLook).toBe(false)
end

-- (last: the module off)
@test("stopped: the frames gone, their anchors withdrawn")
local function stopped()
    assert(M.OnDisable)(M)
    expect(assert(M.frames).player:IsShown()).toBe(false)
    expect(SuuUI.GetAnchor("player")).toBeNil()
    expect(assert(M.frames).player.onTooltip).toBeNil()
    expect(assert(M.combatBadge):IsShown()).toBe(false)
end
