import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"

@test("explore")
local function explore()
    local out = {}
    local function p(...: any) local t = {} for i = 1, select("#", ...) do t[#t+1] = tostring((select(i, ...))) end out[#out+1] = table.concat(t, " ") end
    local function safe(label: string, fn: () -> ()) local ok, err = pcall(fn) if not ok then p("ERR", label, err) end end
    -- talents
    local T: any = SuuUI.GetModule("talents")
    safe("talents", function()
        local d = T:Collect()
        local cand
        for _, t in ipairs(d.trees) do for _, n in ipairs(t.nodes) do
            p("node", t.name, n.id, n.name, n.col, n.row, n.rank, n.max, n.canPurchase, n.open, #n.conditions, n.requires and #n.requires or 0)
            if n.canPurchase and not cand then cand = n end
        end end
        p("cand", cand and cand.id)
        if cand then
            p("purchase", C_Traits.PurchaseRank(d.configID, cand.id))
            p("staged", C_Traits.ConfigHasStagedChanges(d.configID))
            local d2 = T:Collect()
            p("pending", d2.pending, d2.available)
            p("rollback", C_Traits.RollbackConfig(d.configID))
            p("staged2", C_Traits.ConfigHasStagedChanges(d.configID))
        end
        p("cond", C_Traits.GetConditionInfo(d.configID, 1))
        p("edit", T:Editable())
        p("inspect", T:Inspecting(), PlayerSpellsFrame.IsInspecting)
        p("canchange", C_ClassTalents.CanChangeTalents())
        p("viewcfg", Constants.TraitConsts.VIEW_TRAIT_CONFIG_ID, Constants.TraitConsts.INSPECT_TRAIT_CONFIG_ID)
        local pal = T:BuildTree("PALADIN")
        p("paltree", pal and #pal.trees, pal and pal.configID)
        local war = T:BuildTree("WARRIOR")
        p("wartree", war and #war.trees, war and war.configID)
        p("version", C_Traits.GetLoadoutSerializationVersion(), type(C_Traits.GetTreeHash(1117)))
        p("binding", GetBindingKey("TOGGLETALENTS"))
        p("talentsframe", PlayerSpellsFrame.TalentsFrame, PlayerSpellsFrame.SpellBookFrame)
    end)
    -- spellbook
    local S: any = SuuUI.GetModule("spellbook")
    safe("spellbook", function()
        p("sb", S:IsEnabled(), S.book)
        local schools = S:Schools()
        for _, s in ipairs(schools) do p("school", s.name, s.icon, s.first, s.count, #S:Learned(s)) end
        p("trainer", #(SuuUI.TrainerSpells() or {}))
        local ids = SuuUI.TrainerSpellIDs()
        local n = 0 for _ in pairs(ids) do n = n + 1 end
        p("ids", n)
        p("count", S:CountToTrain())
        p("ct", #(SuuUI.ClassTalents("WARRIOR") or {}))
        local t1 = (SuuUI.TrainerSpells() or {})[1]
        if t1 then p("t1", t1.name, t1.level, t1.school, t1.cost, t1.icon) end
        p("next", S:NextLevelUp() and S:NextLevelUp().title)
        p("cells", S.book and #S.book.cells)
        p("money", GetMoney())
    end)
    -- legacy
    local L: any = SuuUI.GetModule("legacy")
    safe("legacy", function()
        p("lg", L:IsEnabled(), L.pages, _G.LegacySystemFrame)
        local pts = L:Points()
        p("points", pts.earned, pts.total, pts.spent, pts.cap, pts.available)
        local cfg = L:ConfigID()
        p("cfg", cfg)
        if cfg then
            local trees, rows, pending = L:Trees(cfg)
            for _, t in ipairs(trees) do p("ltree", t.name, #t.nodes, t.points, t.placeholders, #t.links) end
            p("rows", rows, pending)
        end
        local ch = L:Challenges()
        p("challenges", #ch)
        for _, c in ipairs(ch) do p("cat", c.name, c.done, c.total, #c.groups) end
        local r = L:Rewards(pts.earned, pts.total)
        p("rewards", #r.stops, r.max, r.next)
    end)
    -- convergences
    local C: any = SuuUI.GetModule("convergences")
    safe("conv", function()
        p("cv", C:IsEnabled(), #C:Spots(), C:IsSkyborne(), UnitRace("player"))
        p("worldpos", C_Map.GetWorldPosFromMapPos ~= nil, CreateVector2D ~= nil, C_Map.GetMapPosFromWorldPos ~= nil)
        local mi = C_Map.GetMapInfo(2521)
        p("mapinfo", mi and mi.name)
        p("best", C_Map.GetBestMapForUnit("player"))
        p("size", pcall(C_Map.GetMapWorldSize, 2521))
        p("near", C:Near({ map = 2521, x = 0.4828, y = 0.2062 }))
        p("channels", #C:Channels())
        p("minimap", _G.Minimap, C_Minimap and C_Minimap.GetViewRadius)
        p("unitpos", pcall(UnitPosition, "player"))
        p("ufn", UnitFullName("player"))
        p("aura", pcall(C_UnitAuras.GetPlayerAuraBySpellID, 1270893))
    end)
    -- welcome
    local W: any = SuuUI.GetModule("welcome")
    safe("welcome", function()
        p("wl", W:IsEnabled(), SuuUI.AccountData("welcome").seen, W.panel)
        mock.advanceTime(3)
        p("wl2", W.panel, W.dim and W.dim:IsShown(), W.step)
        p("modes", #SuuUI.ColorVisionModes(), SuuUI.ColorVision())
        p("preset", SuuUI.RolePresetName("TANK"))
    end)
    expect(out).toEqual({})
end
