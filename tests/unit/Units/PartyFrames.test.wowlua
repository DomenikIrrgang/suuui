-- Units/PartyFrames: the party frames on the engine's group: shown in a
-- party (not solo, not in a raid), each following its unit, the layout's
-- direction and sizes, the power line by role, aggro, your target, range,
-- an offline member, the settings, the preview and edit mode's group
-- preview.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import internal M, powerFor from "/Units/PartyFrames"
import type PartyFrame from "/Units/PartyFrames"
import expectNoErrors, expectPingable, holdings, NOTHING from "../../helpers"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import * as modules from "/Core/Modules"
import internal ownOf from "/Core/Modules"
import migrations as settingMigrations from "/Core/Settings"
import SuuUI from "/Core/API"
import type Indicator, UnitFrame from "/UI/UnitFrame"

-- Placeholder party members.
local function member(name: string, class: string, role: ("TANK" | "HEALER" | "DAMAGER")?): mock.MockUnit
    local u = mock.spawnUnit({
        name = name,
        player = true,
        class = class,
        level = 60,
        reaction = "friendly",
        health = 3000,
        healthMax = 4000,
    })
    if role then
        u:setRole(role)
    end
    return u
end

local tank = member("Brannoc Ironhand", "WARRIOR", "TANK")
local healer = member("Tamsin Ashford", "PRIEST", "HEALER")

local function frame(unit: string): PartyFrame
    for _, f in ipairs(M.frames) do
        if f.unit == unit then
            return f
        end
    end
    error("no frame " .. unit)
end

-- the frames' holder
local function partyHolder(): Frame
    return assert(M.holder)
end

local function settle()
    mock.advanceFrames(2)
    mock.advanceTime(0.3)
end

@afterEach
local function cleanup()
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    mock.group:leave()
    mock.player:target(nil)
    M:ResetAll({
        "debuffKinds",
        "showSelf",
        "showSolo",
        "direction",
        "width",
        "height",
        "gap",
        "power",
        "auraSide",
        "debuffBadges",
        "buffIcons",
        "debuffIcons",
        "rangeAlpha",
        "healthText",
    })
    settle()
    expectNoErrors()
end

@test("solo: no party frames; with Show when solo, your own")
local function solo()
    settle()
    expect(partyHolder()).never.toBeShown()
    M:Set("showSolo", true)
    settle()
    expect(partyHolder()).toBeShown()
    expect(frame("player")).toBeShown()
end

@test("in a party: you and each member, the empty slots hidden; in a raid none")
local function party()
    mock.group:add(tank)
    settle()
    expect(partyHolder()).toBeShown()
    expect(frame("player")).toBeShown()
    expect(frame("party1")).toBeShown()
    expect(frame("party2")).never.toBeShown()
    mock.group:add(healer)
    settle()
    expect(frame("party2")).toBeShown()
    -- a raid: the raid frames' turn
    mock.group:leave()
    mock.group:add(tank, true)
    settle()
    expect(partyHolder()).never.toBeShown()
end

@test("pingable: a ping over a member's frame pings that member")
local function pingable()
    mock.group:add(tank)
    mock.group:add(healer)
    settle()
    expectPingable(frame("player"), "player")
    expectPingable(frame("party1"), "party1")
    expectPingable(frame("party2"), "party2")
end

@test("the layout: up from the bottom, down, across; the sizes; without yourself")
local function layout()
    mock.group:add(tank)
    settle()
    local w, h, gap = M:Get("width"), M:Get("height"), M:Get("gap")
    local holder = partyHolder()
    expect(holder:GetHeight()).toBe(5 * h + 4 * gap)
    local point, _, _, _, y = frame("party1"):GetPoint(1)
    expect(point).toBe("BOTTOMLEFT")
    expect(y).toBe(h + gap)
    M:Set("direction", "down")
    local _, _, _, _, y2 = frame("party1"):GetPoint(1)
    expect(y2).toBe(-(h + gap))
    M:Set("direction", "right")
    expect(holder:GetWidth()).toBe(5 * w + 4 * gap)
    local _, _, _, x3 = frame("party1"):GetPoint(1)
    expect(x3).toBe(w + gap)
    M:Set("showSelf", false)
    settle()
    local _, _, _, x4 = frame("party1"):GetPoint(1)
    expect(x4).toBe(0)
    expect(frame("player")).never.toBeShown()
    M:Set("width", 150)
    expect(frame("party1"):GetWidth()).toBe(150)
end

@test("the power line: tanks and healers, everyone or none; healing classes without roles")
local function power()
    mock.group:add(tank)
    mock.group:add(healer)
    settle()
    expect(powerFor("party1", frame("party1").api)).toBe(true)
    local dps = member("Kaelith Dawnmere", "MAGE", "DAMAGER")
    mock.group:add(dps)
    settle()
    expect(powerFor("party3", frame("party3").api)).toBe(false)
    local druid = member("Morrow Fenwick", "DRUID")
    mock.group:add(druid)
    settle()
    expect(powerFor("party4", frame("party4").api)).toBe(true)
    M:Set("power", "all")
    expect(powerFor("party3", frame("party3").api)).toBe(true)
    M:Set("power", "none")
    expect(powerFor("party1", frame("party1").api)).toBe(false)
end

@test("aggro: an enemy on you shows it on your frame; not on a tank's")
local function states()
    mock.group:add(tank)
    settle()
    -- (the engine keeps the player's threat: a kobold turns on you)
    local kobold = mock.spawnUnit({ name = "Kobold Worker", level = 5, reaction = "hostile" })
    kobold:setThreat(100)
    expect(frame("player").stateTone).toBe("danger")
    expect(frame("party1").stateTone).toBeNil()
    kobold:setThreat(nil)
    expect(frame("player").stateTone).toBeNil()
    -- the tank: no aggro badge, the enemy is meant to be on you
    mock.player:setRole("TANK")
    kobold:setThreat(100)
    expect(frame("player").stateTone).toBeNil()
    kobold:setThreat(nil)
    mock.player:setRole(nil)
end

@test("your target ringed")
local function selected()
    mock.group:add(tank)
    mock.group:add(healer)
    settle()
    mock.player:target(healer)
    expect(frame("party2").selected:GetAlpha()).toBe(1)
    expect(frame("party1").selected:GetAlpha()).toBe(0)
end

@test("out of range: the frame faint; offline: its auras gone")
local function rangeAndOffline()
    mock.group:add(tank)
    settle()
    M:Set("rangeAlpha", 0.5)
    -- (an alpha as the game keeps it: in a byte)
    local probe = CreateFrame("Frame")
    probe:SetAlpha(0.5)
    local half = probe:GetAlpha()
    tank:setDistance(80)
    mock.advanceTime(0.3)
    -- (range is secret: the engine sets the alpha from it, secret too)
    expect(frame("party1"):GetAlpha() :: unknown).toBe(mock.secret(half))
    tank:setDistance(10)
    mock.advanceTime(0.3)
    expect(frame("party1"):GetAlpha() :: unknown).toBe(mock.secret(1))
    local auras = assert(frame("party1").auras)
    tank:setOnline(false)
    expect(auras.container:GetAlpha()).toBe(0)
    tank:setOnline(true)
    expect(auras.container:GetAlpha()).toBe(1)
end

@test("the auras' side and counts; the settings' options on the frames")
local function options()
    mock.group:add(tank)
    settle()
    local f = frame("party1")
    M:Set("auraSide", "left")
    local _, rel, relPoint = f.auraClip:GetPoint(1)
    expect(rel).toBe(f)
    expect(relPoint).toBe("LEFT")
    -- the row's end: the state badge there
    expect(f.opts.badgeTop).never.toBe(true)
    local _, onRow = f.badge:GetPoint(1)
    expect(onRow).toBe(f.row)
    M:Set("auraSide", "inside")
    expect((f.opts.reserveRight or 0) > 0).toBe(true)
    -- the healer frames (icons inside): the badges on the top edge, smaller,
    -- the row left to the name (seen in game: the name cut to a letter)
    expect(f.opts.badgeTop).toBe(true)
    local point, rel, relPoint = f.badge:GetPoint(1)
    expect(point).toBe("RIGHT")
    expect(rel).toBe(f)
    expect(relPoint).toBe("TOPRIGHT")
    expect(f.badge:GetScale() < 1).toBe(true)
    -- the name runs under the icons (no health text): the row to the right end
    M:Set("healthText", "none")
    expect(f.opts.nameUnderIcons).toBe(true)
    local _, _, _, rowX = f.row:GetPoint(2)
    expect(rowX).toBe(-f.size.pad)
    for _, b in ipairs(f.edgeBadges) do
        local _, r, rp = b:GetPoint(1)
        expect(r).toBe(f)
        expect(rp).toBe("TOPRIGHT")
    end
    M:Set("buffIcons", 0)
    M:Set("debuffIcons", 0)
    expect(f.auraClip).never.toBeShown()
    M:Set("healthText", "value")
    expect(f.opts.healthText).toBe("value")
end

-- (the filter strings as the aura row writes them)
local KINDS_REST = "HARMFUL|!RAID_PLAYER_DISPELLABLE|DISPELLABLE"
local REST_ALL = "HARMFUL|!RAID_PLAYER_DISPELLABLE"

@test("debuffs by kind (typed and crowd control) by default, yours too; every debuff by the setting")
local function debuffKinds()
    mock.group:add(tank)
    settle()
    local groups = assert(frame("party1").auras).groups
    -- the game won't leave a friendly unit's debuff out by spell (probed):
    -- by kind, the typed ones and crowd control
    expect(assert(groups.all).filter).toBe("HARMFUL|DISPELLABLE")
    expect(assert(groups.cc).filter).toBe("HARMFUL|!DISPELLABLE|CROWD_CONTROL")
    expect(assert(groups.cc).max > 0).toBe(true)
    -- yours (the player's frame): the other typed ones, crowd control too
    M:Set("showSelf", true)
    settle()
    local mine = assert(frame("player").auras).groups
    expect(assert(mine.debuffs).filter).toBe(KINDS_REST)
    expect(assert(mine.cc).max > 0).toBe(true)
    M:Set("debuffKinds", "all")
    expect(assert(groups.all).filter).toBe("HARMFUL")
    expect(assert(groups.cc).max).toBe(0)
    expect(assert(mine.debuffs).filter).toBe(REST_ALL)
end

@test("the settings' preview: a made-up party with every setting; edit mode's group preview on the frames' place")
local function previews()
    local parent = CreateFrame("Frame", nil, UIParent)
    local view = M:PreviewView(parent)
    expect(view:GetWidth() > 0).toBe(true)
    for _, side in ipairs({ "left", "inside", "right" }) do
        M:Set("auraSide", side)
        M:DrawPreview(true)
    end
    local set = assert(M.previewSet)
    M:Set("debuffBadges", "removable")
    M:DrawPreview(true)
    expect(set.frames[5].dispelDecos.Poison).never.toBeShown()
    M:Set("debuffBadges", "all")
    M:DrawPreview(true)
    expect(set.frames[5].dispelDecos.Poison).toBeShown()
    -- the made-up party out of range and with aggro
    expect(set.frames[5]:GetAlpha()).toBeCloseTo(M:Get("rangeAlpha"))
    expect(set.frames[4].stateTone).toBe("danger")
    -- edit mode: a party of 5 with their auras over the real frames
    M:Emit("SUUUI_EDITMODE_GROUP_PREVIEW", 5, true)
    local screen = assert(M.screenSet)
    expect(screen.view).toBeShown()
    expect(partyHolder():GetAlpha()).toBe(0)
    M:Emit("SUUUI_EDITMODE_GROUP_PREVIEW", 20, false)
    expect(screen.view).never.toBeShown()
    expect(partyHolder():GetAlpha()).toBe(1)
    -- the preview again on another parent
    M:PreviewView(UIParent)
end

@test("buff indicators and defensives changed: applied out of combat, a burst once")
local function indicators()
    local applied = mock.spy(function(_: unknown) end)
    mock.stub(M, "ApplyIndicators", applied)
    M:Emit("SUUUI_INDICATORS_CHANGED")
    M:Emit("SUUUI_INDICATORS_CHANGED")
    mock.advanceTime(1.1)
    expect(applied).toHaveBeenCalledTimes(1)
    local defensives = mock.spy(function(_: unknown) end)
    mock.stub(M, "ApplyDefensives", defensives)
    M:Emit("SUUUI_DEFENSIVES_CHANGED")
    expect(defensives).toHaveBeenCalledTimes(1)
end

@test("a member's auras change: the frames' missing-buff indicators read again, after combat too")
local function presence()
    mock.group:add(tank)
    settle()
    local read = mock.spy(function(_: unknown) end)
    mock.stub(frame("party1"), "UpdateIndicatorPresence", read)
    mock.fireUnitEvent("UNIT_AURA", "party1", { isFullUpdate = true })
    expect(read).toHaveBeenCalledTimes(1)
    mock.player:enterCombat()
    mock.fireUnitEvent("UNIT_AURA", "party1", { isFullUpdate = true })
    mock.advanceFrames(1)
    mock.player:leaveCombat()
    expect(read).toHaveBeenCalledTimes(3)
end

-- Whether each of a party frame's live indicators shows.
local function indicatorsShown(unit: string): boolean[]
    local out: boolean[] = {}
    for i, c in ipairs(frame(unit).indicatorContainers) do
        out[i] = c.container:IsShown()
    end
    return out
end

@test("buff indicators limited to roles: on those roles only; a role change moves them; no role is Damage")
local function indicatorRoles()
    local before = SuuUI.UI.GroupIndicators()
    local dps = member("Kaelith Dawnmere", "MAGE", "DAMAGER")
    local none = member("Morrow Fenwick", "DRUID")
    mock.group:add(tank)
    mock.group:add(dps)
    mock.group:add(none)
    settle()
    local list: Indicator[] = {
        { name = "Tanks", kind = "square", ids = { 139 }, roles = { TANK = true } },
        { name = "Damage", kind = "border", ids = { 17 }, roles = { DAMAGER = true } },
        { name = "Old", kind = "icon", ids = { 774 } }, -- saved before roles: everyone
    }
    SuuUI.UI.SetGroupIndicators(list)
    mock.advanceTime(1.1)
    expect(indicatorsShown("party1")).toEqual({ true, false, true }) -- the tank
    expect(indicatorsShown("party2")).toEqual({ false, true, true }) -- damage
    expect(indicatorsShown("party3")).toEqual({ false, true, true }) -- no role: damage
    -- a role change (the roster update) moves them, on the roster pass (the
    -- next frame: one for the burst)
    tank:setRole("DAMAGER")
    dps:setRole("TANK")
    mock.nextFrame()
    expect(indicatorsShown("party1")).toEqual({ false, true, true })
    expect(indicatorsShown("party2")).toEqual({ true, false, true })
    -- no role (the game answers "NONE") is Damage
    dps:setRole(nil)
    mock.nextFrame()
    expect(indicatorsShown("party2")).toEqual({ false, true, true })
    -- in combat the live ones keep the last answer; after it they follow
    mock.player:enterCombat()
    dps:setRole("TANK")
    mock.nextFrame()
    expect(indicatorsShown("party2")).toEqual({ false, true, true })
    mock.player:leaveCombat()
    expect(indicatorsShown("party2")).toEqual({ true, false, true })
    -- the roles events: only a frame whose role changed is read again
    local first = mock.spy(function(_: unknown) end)
    local second = mock.spy(function(_: unknown) end)
    frame("party1").indicatorRole = "HEALER" -- (as if it had changed since)
    mock.stub(frame("party1"), "UpdateIndicatorPresence", first)
    mock.stub(frame("party2"), "UpdateIndicatorPresence", second)
    mock.fireEvent("PLAYER_ROLES_ASSIGNED")
    mock.nextFrame()
    expect(first).toHaveBeenCalledTimes(1)
    expect(second).toHaveBeenCalledTimes(0)
    mock.fireEvent("ROLE_CHANGED_INFORM", "Brannoc Ironhand", "Kaelith Dawnmere", "HEALER", "DAMAGER")
    mock.nextFrame()
    expect(first).toHaveBeenCalledTimes(1)
    expect(second).toHaveBeenCalledTimes(0)
    tank:setRole("TANK")
    SuuUI.UI.SetGroupIndicators(before)
    mock.advanceTime(1.1)
end

@test(
    "a burst of roster changes: one pass the frame after; only a frame with someone new on its token drawn and re-scanned"
)
local function rosterBurst()
    mock.group:add(tank)
    mock.group:add(healer)
    settle()
    local real = M.RosterPass
    local passes = 0
    mock.stub(M, "RosterPass", function(self: unknown)
        passes += 1
        real(M)
    end)
    type Count = { refresh: number, rescan: number }
    local function counter(f: PartyFrame): Count
        local c: Count = { refresh = 0, rescan = 0 }
        mock.stub(f, "Refresh", function()
            c.refresh += 1
        end)
        mock.stub(assert(f.auras), "Refresh", function()
            c.rescan += 1
        end)
        return c
    end
    local first, second = counter(frame("party1")), counter(frame("party2"))
    -- the tank leaves: the healer is party1 now; three more updates
    mock.group:remove(tank)
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    expect(passes).toBe(0)
    mock.nextFrame()
    expect(passes).toBe(1)
    expect(first).toEqual({ refresh = 1, rescan = 1 })
    -- (party2: no one now, hidden by its unit watch: nothing)
    expect(second).toEqual({ refresh = 0, rescan = 0 })
    -- a role change only: no redraw, no re-scan
    healer:setRole("DAMAGER")
    mock.nextFrame()
    expect(passes).toBe(2)
    expect(first).toEqual({ refresh = 1, rescan = 1 })
    healer:setRole("HEALER")
    expectNoErrors()
end

@test("in a raid the party frames do nothing on a roster change")
local function quietInRaid()
    mock.group:add(tank, true)
    mock.group:add(healer, true)
    settle()
    expect(partyHolder()).never.toBeShown()
    local passes = mock.stub(M, "RosterPass")
    local redraws = mock.stub(frame("party1"), "Refresh")
    local rescans = mock.stub(assert(frame("party1").auras), "Refresh")
    healer:setRole("DAMAGER")
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.fireEvent("PLAYER_ROLES_ASSIGNED")
    settle()
    expect(passes).toHaveBeenCalledTimes(0)
    expect(redraws).toHaveBeenCalledTimes(0)
    expect(rescans).toHaveBeenCalledTimes(0)
    healer:setRole("HEALER")
    expectNoErrors()
end

@test("your target in combat: ringed by the engine from a secret answer")
local function selectedInCombat()
    mock.group:add(tank)
    settle()
    mock.player:enterCombat()
    mock.player:target(tank)
    local a = frame("party1").selected:GetAlpha()
    expect(issecretvalue(a) or a == 1).toBe(true)
end

@test("earlier settings carried over: one aura row split in two, badges renamed")
local function migrations()
    for _, m in ipairs(settingMigrations()) do
        if m.namespace == "party" then
            local v: { [string]: unknown } = { auras = 4, showBuffs = true, badges = "removable" }
            m.fn(v)
            if m.id == "auraSplit" then
                expect(v.auras).toBeNil()
            end
            if m.id == "debuffBadges" then
                expect(v.debuffBadges).toBe("removable")
                expect(v.badges).toBeNil()
            end
        end
    end
end

--------------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------------

-- A member's pet (placeholder names).
local function petOf(owner: mock.MockUnit, name: string): mock.MockUnit
    local p = mock.spawnUnit({ name = name, reaction = "friendly", health = 800, healthMax = 1000, distance = 10 })
    mock.setPet(p, { owner = owner })
    return p
end

-- Whether a frame hears its unit's events and draws them (a health event,
-- drawn on the next frame). (Its unit's events are on a watch of its own,
-- not on the bus.)
local function hears(f: UnitFrame): boolean
    local heard = false
    local was = f.onHealth
    f.onHealth = function(_: UnitFrame)
        heard = true
    end
    mock.fireUnitEvent("UNIT_HEALTH", assert(f.unit))
    mock.nextFrame()
    f.onHealth = was
    return heard
end

@test("in a raid the hidden frames stand still; back in a party they listen and draw again")
local function standStillInRaid()
    mock.group:add(tank)
    settle()
    local f = frame("party1")
    expect(f.active).toBe(true)
    expect(hears(f)).toBe(true)
    -- a raid: the holder hidden by its state driver, every frame off
    mock.group:leave()
    mock.group:add(tank, true)
    settle()
    expect(partyHolder()).never.toBeShown()
    for _, each in ipairs(M:AllFrames()) do
        expect(each.active == true).toBe(false)
        expect(events.bus:count(each)).toBe(0)
    end
    expect(hears(f)).toBe(false)
    -- a party again: listening, and drawn afresh
    mock.group:leave()
    mock.group:add(tank)
    settle()
    expect(partyHolder()).toBeShown()
    f = frame("party1")
    expect(f.active).toBe(true)
    expect(hears(f)).toBe(true)
    expect(f.name).toHaveText("Brannoc Ironhand")
    -- the same in a fight: the driver hides and shows the holder in combat
    mock.player:enterCombat()
    mock.group:leave()
    mock.group:add(tank, true)
    settle()
    expect(partyHolder()).never.toBeShown()
    expect(frame("player").active == true).toBe(false)
    mock.group:leave()
    mock.group:add(tank)
    settle()
    expect(partyHolder()).toBeShown()
    expect(frame("party1").active).toBe(true)
    mock.player:leaveCombat()
    expectNoErrors()
end

-- Party frames are reloadToToggle: the registry turns them off in a session
-- only when OnEnable fails. Here they toggle live, as a module that isn't
-- would, so the registry's own disable and release run. (It ends with them
-- on again.)
@test(
    "turned off through the registry: frames and pets off and hidden, the anchor withdrawn, nothing held; on again, all back"
)
local function registryCycle()
    local own = ownOf(M)
    own.reloadToToggle = false
    mock.group:add(tank)
    local wolf = petOf(tank, "Wolf")
    settle()
    local before = holdings(M)
    expect(before.hooks).toBe(2)
    expect(before.timers).toBe(1)
    expect(SuuUI.GetAnchor("party")).toBe(partyHolder())
    settings.set("party", "enabled", false)
    expect(M.state).toBe(modules.ModuleState.Disabled)
    expect(holdings(M)).toEqual(NOTHING)
    expect(SuuUI.GetAnchor("party")).toBeNil()
    for _, each in ipairs(M:AllFrames()) do
        expect(each).never.toBeShown()
        expect(each.active == true).toBe(false)
    end
    -- the holder's hooks quiet: hidden and shown, nothing comes back on
    partyHolder():Hide()
    partyHolder():Show()
    expect(frame("party1").active == true).toBe(false)
    settle()
    expect(frame("party1")).never.toBeShown()
    -- on again: everything back, nothing doubled
    settings.set("party", "enabled", true)
    settle()
    expect(M.state).toBe(modules.ModuleState.Enabled)
    expect(holdings(M)).toEqual(before)
    expect(SuuUI.GetAnchor("party")).toBe(partyHolder())
    expect(frame("party1")).toBeShown()
    expect(frame("party1").active).toBe(true)
    expect(M.pets[2]).toBeShown()
    own.reloadToToggle = true
    mock.setPet(nil, { owner = tank })
    wolf:despawn()
    expectNoErrors()
end

@test(
    "pets: a member's pet on their row, beside them in a column past their auras, under them in a row; only while there is one"
)
local function pets()
    mock.group:add(tank)
    mock.group:add(healer)
    local wolf = petOf(tank, "Wolf")
    settle()
    local owner, p = frame("party1"), M.pets[2]
    expect(p.unit).toBe("partypet1")
    expect(p).toBeShown()
    -- drawn for it as it came
    expect(p.name).toHaveText("Wolf")
    -- the healer has none; the player's pet slot neither
    expect(M.pets[3]).never.toBeShown()
    expect(M.pets[1]).never.toBeShown()
    -- a column: right beside the owner, as tall; the owner's auras after it
    -- (seen in game: past the whole aura row, the pet sat far from its owner)
    local _, rel = p:GetPoint(1)
    expect(rel).toBe(owner)
    expect(p:GetHeight()).toBe(M:Get("height"))
    expect(p:GetWidth()).toBe(M:Get("petWidth"))
    local _, auraRel = owner.auraClip:GetPoint(1)
    expect(auraRel).toBe(p)
    -- the healer has no pet: their auras beside them
    local healerFrame = frame("party2")
    _, auraRel = healerFrame.auraClip:GetPoint(1)
    expect(auraRel).toBe(healerFrame)
    -- dismissed: the owner's auras back beside the owner; back: after the pet
    mock.setPet(nil, { owner = tank })
    settle()
    _, auraRel = owner.auraClip:GetPoint(1)
    expect(auraRel).toBe(owner)
    mock.setPet(wolf, { owner = tank })
    settle()
    _, auraRel = owner.auraClip:GetPoint(1)
    expect(auraRel).toBe(p)
    -- a row (the healer layout): under the owner, as wide
    M:Set("direction", "right")
    local point, rel2, relPoint = p:GetPoint(1)
    expect(point).toBe("TOPLEFT")
    expect(rel2).toBe(owner)
    expect(relPoint).toBe("BOTTOMLEFT")
    expect(p:GetWidth()).toBe(M:Get("width"))
    expect(p:GetHeight()).toBe(M:Get("petHeight"))
    -- dismissed: gone (its unit watch); back: shown
    mock.setPet(nil, { owner = tank })
    settle()
    expect(p).never.toBeShown()
    mock.setPet(wolf, { owner = tank })
    settle()
    expect(p).toBeShown()
    -- Show pets off: none
    M:Set("showPets", false)
    settle()
    expect(p).never.toBeShown()
    M:Set("showPets", true)
    settle()
    expect(p).toBeShown()
    mock.setPet(nil, { owner = tank })
    M:ResetAll({ "petWidth", "petHeight", "showPets" })
end

@test(
    "pets: the player's pet beside you; clickable and healed by mouseover (the mouse over it makes it the mouseover unit)"
)
local function petsClick()
    mock.group:add(tank)
    local imp = mock.spawnUnit({ name = "Imp", reaction = "friendly", distance = 5 })
    mock.setPet(imp)
    local wolf = petOf(tank, "Wolf")
    settle()
    local mine, theirs = M.pets[1], M.pets[2]
    expect(mine.unit).toBe("pet")
    expect(mine).toBeShown()
    expectPingable(theirs, "partypet1")
    mock.hover(theirs)
    expect(UnitName("mouseover")).toBe("Wolf")
    mock.hover(mine)
    expect(UnitName("mouseover")).toBe("Imp")
    mock.hover(nil)
    expect(UnitExists("mouseover")).toBe(false)
    -- a click targets it
    mock.click(theirs)
    expect(UnitName("target")).toBe("Wolf")
    mock.setPet(nil)
    mock.setPet(nil, { owner = tank })
    wolf:despawn()
end

@test("pets take the buff indicators, as their owners do")
local function petIndicators()
    local before = SuuUI.UI.GroupIndicators()
    mock.group:add(tank)
    petOf(tank, "Wolf")
    settle()
    local list: Indicator[] = { { name = "Mark", kind = "icon", ids = { 1126 } } }
    SuuUI.UI.SetGroupIndicators(list)
    mock.advanceTime(1.1)
    expect(#M.pets[2].indicatorContainers).toBe(1)
    expect(#frame("party1").indicatorContainers).toBe(1)
    SuuUI.UI.SetGroupIndicators(before)
    mock.advanceTime(1.1)
    mock.setPet(nil, { owner = tank })
end
