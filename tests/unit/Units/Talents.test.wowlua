-- Units/Talents: the Talents page and window, talent builds.
-- The trees come from a stand-in for C_Traits (TraitWorld): three trees of
-- three talents each, node IDs 11-13 (Arms), 21-23 (Fury), 31-33
-- (Protection); 12 needs 11 by an arrow and sits a row lower. The class is
-- the recorded warrior's (tree 1117); the paladin's tree (1100) is the
-- other class.

import test, expect, beforeEach, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import type Module from "/Core/Modules"
import * as events from "/Core/Events"
import internal clusterNodes, gridCell, talentedPoints, stepLevel, splitOf, nextStep, plural, copySteps, charKey from "/Units/Talents"
import * as world from "./TraitWorld"
import expectNoErrors from "../../helpers"

const M: Module = assert(SuuUI.GetModule("talents"))
const WARRIOR_TREE = 1117
const PALADIN_TREE = 1100
const CONFIG = 100
const VIEW = Constants.TraitConsts.VIEW_TRAIT_CONFIG_ID
const INSPECT = Constants.TraitConsts.INSPECT_TRAIT_CONFIG_ID

type Step = { node: number, entry?: number }

-- A page as Render and Fill drive it, recording what they set.
type FakePage = {
    visible: boolean,
    data: any,
    specs: any,
    specView: any,
    builds: any,
    order: any,
    drawn: any,
    orderLines: any,
    IsVisible: (self: FakePage) -> boolean,
    SetSpecs: (self: FakePage, list: any, view: any?) -> (),
    SetBuilds: (self: FakePage, b: any) -> (),
    SetOrder: (self: FakePage, o: any) -> (),
    SetData: (self: FakePage, d: any) -> (),
    MarkNode: (self: FakePage, id: number?) -> (),
}

local function fakePage(visible: boolean): FakePage
    local p: FakePage = {
        visible = visible, data = nil, specs = nil, specView = nil, builds = nil, order = nil, drawn = nil, orderLines = nil,
        IsVisible = function(self: FakePage): boolean return self.visible end,
        SetSpecs = function(self: FakePage, list: any, view: any?) self.specs, self.specView = list, view end,
        SetBuilds = function(self: FakePage, b: any) self.builds = b end,
        SetOrder = function(self: FakePage, o: any) self.order = o; self.orderLines = o end,
        SetData = function(self: FakePage, d: any) self.drawn = d end,
        MarkNode = function(_: FakePage, _: number?) end,
    }
    return p
end

local w: world.World
local savedPages: { windowPage: any, page: any } = { windowPage = nil, page = nil }
local heard: { [string]: number } = {}
local listener = {}

local function store(): { [any]: any }
    return SuuUI.AccountData("talentbuilds")
end

local function newWorld(): world.World
    local a = world.threeTrees(WARRIOR_TREE, { "Arms", "Fury", "Protection" })
    local p = world.threeTrees(PALADIN_TREE, { "Holy", "Protection", "Retribution" })
    -- the paladin's node IDs apart from the warrior's
    for _, n in ipairs(p.nodes) do
        n.id = n.id + 100
        for _, e in ipairs(n.edges or {}) do e.targetNode = e.targetNode + 100 end
    end
    local nw = world.new(CONFIG, { a, p })
    nw.configs[VIEW] = PALADIN_TREE
    nw.configs[INSPECT] = WARRIOR_TREE
    -- the warrior's and the paladin's trees, by their classes' first specs
    nw.specTrees[GetSpecializationInfoForClassID(1, 1) :: number] = WARRIOR_TREE
    nw.specTrees[GetSpecializationInfoForClassID(2, 1) :: number] = PALADIN_TREE
    return nw
end

local function wt(): world.Tree return assert(w.trees[WARRIOR_TREE]) end
local function pt(): world.Tree return assert(w.trees[PALADIN_TREE]) end

local function nodeIn(data: any, id: number): any
    for _, t in ipairs(data.trees) do
        for _, n in ipairs(t.nodes) do if n.id == id then return n end end
    end
    return nil
end

local function steps(...: number): Step[]
    local out: Step[] = {}
    for i = 1, select("#", ...) do out[i] = { node = (select(i, ...)) } end
    return out
end

@beforeEach
local function setup()
    w = newWorld()
    world.install(w)
    local d = store()
    d.builds, d.active, d.reset, d.nextID = {}, {}, {}, 1
    M.draft, M.buildView, M.planning, M.viewing = nil, nil, false, nil
    M.buildTrees, M.learned, M.learnedFor, M.data, M.classes = nil, nil, nil, nil, nil
    M.inspectUnit, M.inspectData, M.wipeAt, M.talented, M.unseenStaged = nil, nil, nil, nil, nil
    savedPages.windowPage, savedPages.page = M.windowPage, M.page
    heard = {}
    local messages: MessageName[] = { "SUUUI_TALENT_BUILD_CHANGED", "SUUUI_TALENTS_SHOWN" }
    for _, e in ipairs(messages) do
        events.on(e, function(name: string) heard[name] = (heard[name] or 0) + 1 end, listener)
    end
end

@afterEach
local function teardown()
    events.off("SUUUI_TALENT_BUILD_CHANGED", listener)
    events.off("SUUUI_TALENTS_SHOWN", listener)
    M.windowPage, M.page = savedPages.windowPage, savedPages.page
    if M.window and M.window:IsShown() then M.window:Hide() end
    for _, key in ipairs({ "mismatch", "newBuild", "share" }) do
        local p = M[key]
        if p then p:Hide() end
    end
    if InCombatLockdown() then mock.player:leaveCombat() end
    -- what a render queued runs with the fakes still in place
    mock.advanceTime(0.1)
end

--------------------------------------------------------------------------------
-- Pure pieces
--------------------------------------------------------------------------------

@test("clusterNodes sorts the nodes and starts a tree past the gap")
local function clusters()
    local nodes: any[] = {
        { x = 3000, y = 0 }, { x = 0, y = 600 }, { x = 0, y = 0 }, { x = 600, y = 0 }, { x = 2200, y = 0 },
    }
    local c = clusterNodes(nodes)
    expect(#c).toBe(2)
    expect(#c[1].nodes).toBe(3)
    expect(c[1].nodes[1].y).toBe(0)
    expect(c[1].nodes[2].y).toBe(600)
    expect(c[1].minX).toBe(0)
    expect(c[1].maxX).toBe(600)
    -- 2200 is 1600 past 600: another tree; 3000 is only 800 past 2200
    expect(#c[2].nodes).toBe(2)
    expect(c[2].minX).toBe(2200)
    expect(c[2].maxX).toBe(3000)
    expect(#clusterNodes({})).toBe(0)
end

@test("gridCell places columns from the left, or so the rightmost is column 3")
@cases({
    { 0, 0, 0, 1800, 0, 0, 0 },
    { 1800, 1200, 0, 1800, 0, 3, 2 },
    { 0, 0, 0, 600, 0, 2, 0 },
    { 600, 0, 0, 600, 0, 3, 0 },
    { 900, 300, 0, 1800, 0, 2, 1 },
    { 5000, -600, 0, 1800, 0, 3, 0 },
})
local function grid(x: number, y: number, minX: number, maxX: number, minY: number, col: number, row: number)
    local c, r = gridCell(x, y, minX, maxX, minY)
    expect(c).toBe(col)
    expect(r).toBe(row)
end

@test("talentedPoints: the currency over one a level from 10, 0 to 5")
@cases({ { 5, 1, 5 }, { 5, 9, 5 }, { 6, 10, 5 }, { 3, 12, 0 }, { 8, 8, 5 }, { 7, 11, 5 }, { 2, 10, 1 } })
local function talented(max: number, level: number, want: number)
    expect(talentedPoints(max, level)).toBe(want)
end

@test("stepLevel: Talented's points from level 5, then one a level from 10")
@cases({ { 1, 5, 5 }, { 5, 5, 9 }, { 6, 5, 10 }, { 1, 0, 10 }, { 3, 2, 10 }, { 51, 5, 55 } })
local function levels(i: number, t: number, want: number)
    expect(stepLevel(i, t)).toBe(want)
end

@test("plural, copySteps and charKey")
local function small()
    expect(plural(1, "point", "points")).toBe("point")
    expect(plural(0, "point", "points")).toBe("points")
    local s: Step[] = { { node = 1, entry = 5 }, { node = 2 } }
    local c = copySteps(s)
    expect(c :: any).toEqual({ { node = 1, entry = 5 }, { node = 2 } })
    expect(c[1] == s[1]).toBe(false)
    expect(copySteps(nil)).toEqual({})
    local guid: any = UnitGUID("player") -- (the player's own: never secret)
    expect(charKey()).toBe(guid)
    mock.fake("UnitGUID", function(): any return mock.secret("Player-1") end)
    local name: any = UnitName("player")
    expect(charKey()).toBe(name .. "-" .. GetRealmName())
end

@test("nextStep: the first step past the ranks you have")
local function next1()
    local s = steps(11, 13, 13, 21)
    local i, r = nextStep(s, {})
    expect(i).toBe(1)
    expect(r).toBe(1)
    i, r = nextStep(s, { [11] = 1, [13] = 1 })
    expect(i).toBe(3)
    expect(r).toBe(2)
    i = nextStep(s, { [11] = 1, [13] = 2, [21] = 1 })
    expect(i).toBeNil()
end

@test("splitOf: a build's points per tree")
local function split()
    local tree = M:BuildTree("WARRIOR")
    expect(splitOf(tree, steps(11, 13, 13, 21))).toBe("3 / 1 / 0")
    expect(splitOf(tree, steps(999))).toBe("0 / 0 / 0")
    expect(splitOf(nil, steps(11))).toBe("")
end

