@test("The window: Toggle, its size, your active build on show, Esc")
local function window()
    local f = M.window
    expect(f).never.toBeShown()
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M:SetActive(id)
    expect(SuuUI.ToggleTalents()).toBe(true)
    expect(f).toBeShown()
    expect(SuuUI.TalentsShown()).toBe(true)
    expect(heard.SUUUI_TALENTS_SHOWN).toBe(1)
    expect(M.buildView).toBe(id)
    expect(f:GetWidth()).toBe(SuuUI.UI.TALENT_TREE_W + 40 + SuuUI.UI.TALENT_ORDER_W)
    M:Toggle()
    expect(f).never.toBeShown()
    expect(SuuUI.TalentsShown()).toBe(false)
    -- a plan with changes stays open
    M.buildView = id
    M:Draft().dirty = true
    M:Toggle()
    expect(M.draft).never.toBeNil()
    M:Toggle()
    -- the height with two talent groups
    mock.fake("GetNumSpecGroups", function(): number return 2 end)
    expect(M:WindowHeight()).toBe(44 + 426 + 16 + 42)
    M.inspectUnit = "target"
    expect(M:WindowHeight()).toBe(44 + 426 + 16)
    M.inspectUnit = nil
end

@test("The window: another player's talents, the title, back to yours")
local function windowInspect()
    local other = mock.spawnUnit({ name = "Bram", level = 30, class = "WARRIOR", player = true, reaction = "friendly" })
    mock.player:target(other)
    M:ShowInspect(nil)
    expect(M.window).never.toBeShown()
    expect(SuuUI.ShowTalentsOf("target")).toBe(true)
    expect(M.window).toBeShown()
    expect(M.inspectUnit).toBe("target")
    expect(M.chrome.title).toHaveText("Talents · Bram")
    -- shown already: drawn again
    M:ShowInspect("target")
    expect(M.window).toBeShown()
    -- the key: back to yours
    M:Toggle()
    expect(M.window).toBeShown()
    expect(M.inspectUnit).toBeNil()
    expect(M.chrome.title).toHaveText("Talents")
    M:SetInspect(nil)
    M.window:Hide()
    mock.player:target(nil)
end

@test("The window's page: its callbacks reach the module")
local function wire()
    local page = M.windowPage
    local calls: string[] = {}
    for _, name in ipairs({ "PlanAdd", "Purchase", "PlanRemove", "Refund", "ShowPlanTip", "ShowTip", "Apply", "Undo", "MoveLine" }) do
        mock.stub(M, name, function() calls[#calls + 1] = name end)
    end
    page.onClick({ build = true })
    page.onClick({})
    page.onRemove({ build = true })
    page.onRemove({})
    page.onEnter(UIParent, { build = true })
    page.onEnter(UIParent, {})
    page.onApply()
    page.onUndo()
    page.onOrderMove(1, 2)
    expect(calls).toEqual({ "PlanAdd", "Purchase", "PlanRemove", "Refund", "ShowPlanTip", "ShowTip", "Apply", "Undo", "MoveLine" })
    page.onLeave()
    page.onOrderEnter({ node = 11 })
    page.onOrderLeave()
    -- another talent group
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M:SetActive(id, 2)
    page.onSpec(2)
    expect(M.viewing).toBe(2)
    expect(M.buildView).toBe(id)
    local active: number? = nil
    mock.fake("C_SpecializationInfo.SetActiveSpecGroup", function(g: number) active = g end)
    page.onActivate()
    expect(active).toBe(2)
    M.viewing = nil
    active = nil
    page.onActivate()
    expect(active).toBeNil()
    M.window:Show()
    page.onBack()
    expect(M.window).never.toBeShown()
end

@test("BindKeys binds the talents key to SuuUI's window, out of combat")
local function bindKeys()
    local bound: string[] = {}
    mock.fake("GetBindingKey", function(): string return "N" end)
    mock.fake("SetOverrideBindingClick", function(_: any, _: boolean, key: string, button: string) bound[#bound + 1] = key .. ">" .. button end)
    M:BindKeys()
    expect(bound).toEqual({ "N>SuuUITalentsToggle" })
    mock.player:enterCombat()
    M:BindKeys()
    expect(M.bindAfterCombat).toBe(true)
    mock.player:leaveCombat()
    expect(M.bindAfterCombat).toBeNil()
    expect(#bound).toBe(2)
    -- the toggle button
    local toggle: any = _G.SuuUITalentsToggle
    mock.click(toggle)
    expect(M.window).toBeShown()
    mock.click(toggle)
    expect(M.window).never.toBeShown()
end

@test("Size and Restore: the spells window at the tab's size and back")
local function sizeRestore()
    local f: any = _G.PlayerSpellsFrame
    local h, wd = f:GetHeight(), f:GetWidth()
    M.blizzHeight, M.blizzWidth = nil, nil
    f:SetSize(900, 700)
    M:Size()
    expect(f:GetWidth()).toBe(SuuUI.UI.TALENT_TREE_W + 40)
    expect(f:GetHeight()).toBe(44 + 426 + 16)
