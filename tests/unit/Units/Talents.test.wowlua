    expect(M:Talented()).toBe(3)
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): any return nil end)
    expect(M:Talented()).toBe(3)
end

@test("AddBuild, Builds, NewID, SetActive and ActiveID")
local function addBuild()
    expect(M:AddBuild("x", "DRUID", {})).toBeNil()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    expect(id).toBe("b1")
    local b = M:Builds()[id]
    expect(b.name).toBe("Arms")
    expect(b.class).toBe("WARRIOR")
    expect(b.classID).toBe(1)
    expect(b.treeID).toBe(WARRIOR_TREE)
    expect(b.split).toBe("2 / 0 / 0")
    expect(b.updated).toBe(time())
    expect(heard.SUUUI_TALENT_BUILD_CHANGED).toBe(1)
    expect(M:NewID()).toBe("b2")
    expect(M:ActiveID()).toBeNil()
    M:SetActive(id)
    expect(M:ActiveID()).toBe(id)
    expect(M:ActiveID(1)).toBe(id)
    expect(M:ActiveID(2)).toBeNil()
    M:SetActive("b9", 2)
    expect(M:ActiveID(2)).toBe("b9")
    M.viewing = 2
    expect(M:ActiveID()).toBe("b9")
    expect(store().active[charKey()]).toEqual({ id, "b9" })
end

@test("Viewed, Planning and Draft")
local function viewedPlanning()
    expect(M:Viewed()).toBeNil()
    expect(M:Planning()).toBe(false)
    expect(M:Draft()).toBeNil()
    local mine = assert(M:AddBuild("Arms", "WARRIOR", steps(11)))
    local theirs = assert(M:AddBuild("Holy", "PALADIN", {}))
    M.buildView = ""
    expect(M:Viewed()).toBeNil()
    M.buildView = mine
    expect(M:Viewed()).toBe(M:Builds()[mine])
    -- yours, not active: planning; active: only when asked
    expect(M:Planning()).toBe(true)
    M:SetActive(mine)
    expect(M:Planning()).toBe(false)
    M.planning = true
    expect(M:Planning()).toBe(true)
    M.inspectUnit = "target"
    expect(M:Planning()).toBe(false)
    M.inspectUnit = nil
    M.buildView = theirs
    expect(M:Planning()).toBe(true)
    -- the draft: a copy until saved
    M.buildView = mine
    local d = M:Draft()
    expect(d.id).toBe(mine)
    expect(d.dirty).toBe(false)
    expect(d.steps).toEqual(steps(11))
    expect(d.steps == M:Builds()[mine].steps).toBe(false)
    expect(M:Draft()).toBe(d)
    expect(M:Viewed()).toBe(d)
end

@test("Draft: a tree that changed keeps the steps that still fit")
local function draftTrim()
    local id = assert(M:AddBuild("Old", "WARRIOR", {}))
    M:Builds()[id].steps = steps(11, 13, 999, 21)
    M.buildView = id
    local d = M:Draft()
    expect(d.steps).toEqual(steps(11, 13))
    expect(d.dirty).toBe(true)
    expect(d.problem).toBe("Step 3 isn't a talent of this tree any more.")
end

@test("SaveDraft and DiscardDraft")
local function saveDiscard()
    M:SaveDraft()
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M.buildView = id
    local d = M:Draft()
    d.steps = steps(11, 21)
    d.name = "Renamed"
    d.dirty = true
    heard = {}
    M:SaveDraft()
    local b = M:Builds()[id]
    expect(b.name).toBe("Renamed")
    expect(b.steps).toEqual(steps(11, 21))
    expect(b.split).toBe("1 / 1 / 0")
    expect(d.dirty).toBe(false)
    expect(heard.SUUUI_TALENT_BUILD_CHANGED).toBe(1)
    M:DiscardDraft()
    expect(M.draft).toBeNil()
    -- a draft of a build deleted meanwhile: nothing to save into
    d = M:Draft()
    store().builds[id] = nil
    M:SaveDraft()
    expect(store().builds[id]).toBeNil()
end

@test("Leave asks first when the draft has changes")
local function leave()
    local asked: any = nil
    mock.stub(SuuUI.UI, "Confirm", function(def: any) asked = def end)
    local went = 0
    M:Leave(function() went = went + 1 end)
    expect(went).toBe(1)
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M.buildView = id
    M:Draft().dirty = true
    M:Leave(function() went = went + 1 end)
    expect(went).toBe(1)
    expect(asked.title).toBe("Discard changes?")
    expect(asked.text).toBe("Your changes to Arms aren't saved.")
    asked.onConfirm()
    expect(went).toBe(2)
    expect(M.draft).toBeNil()
    -- a clean draft goes without asking
    M:Draft()
    M:Leave(function() went = went + 1 end)
    expect(went).toBe(3)
    expect(M.draft).toBeNil()
end

@test("ShowBuild shows a build, not planning")
local function showBuild()
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M.planning = true
    M:ShowBuild(id)
    expect(M.buildView).toBe(id)
    expect(M.planning).toBe(false)
    M:ShowBuild(nil)
    expect(M.buildView).toBeNil()
end

@test("DeleteBuild forgets it everywhere")
local function deleteBuild()
    local dismissed: any[] = {}
    mock.stub(SuuUI, "DismissNotification", function(id: any) dismissed[#dismissed + 1] = id end)
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    local keep = assert(M:AddBuild("Fury", "WARRIOR", {}))
    M:SetActive(id, 1)
    M:SetActive(keep, 2)
    store().reset[charKey()] = { [1] = id }
    M.buildView = id
    M:Draft()
    M:DeleteBuild(id)
    expect(M:Builds()[id]).toBeNil()
    expect(M:Builds()[keep]).never.toBeNil()
    expect(M:ActiveID(1)).toBeNil()
    expect(M:ActiveID(2)).toBe(keep)
    expect(store().reset[charKey()][1]).toBeNil()
    expect(M.draft).toBeNil()
    expect(M.buildView).toBeNil()
    expect(dismissed).toEqual({ "suu:talentbuild:reset" })
end

@test("OrderLines: runs of a talent's ranks with their levels and states")
local function orderLines()
    local tree = M:BuildTree("WARRIOR")
    local s = steps(11, 13, 13, 21, 13)
    local lines = M:OrderLines(s, tree)
    expect(#lines).toBe(4)
    expect(lines[1]).toEqual({ node = 11, from = 1, to = 1, count = 1, state = nil, levels = "5", name = "Arms One", icon = 1011, ranks = "" })
    expect(lines[2].levels).toBe("6–7")
    expect(lines[2].ranks).toBe("1–2")
    expect(lines[2].count).toBe(2)
    expect(lines[4].ranks).toBe("3")
    -- learned and next
    lines = M:OrderLines(s, tree, { [11] = 1, [13] = 1 }, 3)
    expect(lines[1].state).toBe("learned")
    expect(lines[2].state).toBe("next")
    expect(lines[3].state).toBeNil()
    -- an unknown talent
    lines = M:OrderLines(steps(999), nil)
    expect(lines[1].name).toBe("?")
    expect(lines[1].ranks).toBe("")
end

@test("NextTalent: your active build's next step on your talents")
local function nextTalent()
    expect(M:NextTalent()).toBeNil()
    local other = assert(M:AddBuild("Holy", "PALADIN", steps(111)))
    M:SetActive(other)
    expect(M:NextTalent()).toBeNil()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13)))
