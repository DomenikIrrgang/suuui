-- The game's data
--------------------------------------------------------------------------------

@test("SpecGroups: one group unless the game says two; secrets read as one")
local function specGroups()
    expect({ M:SpecGroups() }).toEqual({ 1, 1 })
    mock.fake("GetNumSpecGroups", function(): number return 2 end)
    mock.fake("C_SpecializationInfo.GetActiveSpecGroup", function(): number return 2 end)
    expect({ M:SpecGroups() }).toEqual({ 2, 2 })
    mock.fake("GetNumSpecGroups", function(): any return mock.secret(2) end)
    mock.fake("C_SpecializationInfo.GetActiveSpecGroup", function(): any error("no") end)
    expect({ M:SpecGroups() }).toEqual({ 1, 1 })
end

@test("ConfigID: the active config, or the viewed talent group's")
local function configID()
    expect(M:ConfigID()).toBe(CONFIG)
    mock.fake("GetNumSpecGroups", function(): number return 2 end)
    mock.fake("C_SpecializationInfo.GetCombatConfigIDForSpecGroup", function(g: number): number return 200 + g end)
    M.viewing = 2
    expect(M:ConfigID()).toBe(202)
    M.viewing = 1
    expect(M:ConfigID()).toBe(CONFIG)
    M.viewing = 2
    mock.fake("C_SpecializationInfo.GetCombatConfigIDForSpecGroup", function(): any return nil end)
    expect(M:ConfigID()).toBe(CONFIG)
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): any return mock.secret(5) end)
    expect(M:ConfigID()).toBeNil()
end

@test("Collect: three trees laid out, their points, arrows and the points to spend")
local function collect()
    wt().nodes[1].rank = 1
    wt().spent = { [501] = 4 }
    local d = assert(M:Collect())
    expect(d.configID).toBe(CONFIG)
    expect(d.treeID).toBe(WARRIOR_TREE)
    expect(#d.trees).toBe(3)
    expect(d.trees[1].name).toBe("Arms")
    expect(d.trees[1].icon).toBe(2001)
    expect(d.trees[1].groupID).toBe(501)
    -- the game's count (4) over the ranks seen (1)
    expect(d.trees[1].points).toBe(4)
    expect(d.trees[2].points).toBe(0)
    local one, two, three = nodeIn(d, 11), nodeIn(d, 12), nodeIn(d, 13)
    expect(one.rank).toBe(1)
    expect(one.pending).toBe(0)
    expect(one.col).toBe(2)
    expect(one.row).toBe(0)
    expect(two.row).toBe(1)
    expect(three.col).toBe(3)
    expect(one.name).toBe("Arms One")
    expect(one.icon).toBe(1011)
    expect(one.entryID).toBe(110)
    expect(one.canPurchase).toBe(true)
    expect(two.open).toBe(false)
    expect(two.meetsEdges).toBe(false)
    expect(#d.trees[1].links).toBe(1)
    expect(d.trees[1].links[1].met).toBe(true)
    expect(two.requires[1]).toBe(one)
    expect(d.available).toBe(5)
    expect(d.pending).toBe(0)
    expect(d.staged).toBe(false)
    expect(M.unseenStaged).toBeNil()
end

@test("Collect: planned ranks are pending over what was learned before")
local function collectPlanned()
    assert(M:Collect())
    w.staged[13] = 1
    local d = assert(M:Collect())
    expect(d.staged).toBe(true)
    expect(nodeIn(d, 13).rank).toBe(0)
    expect(nodeIn(d, 13).pending).toBe(1)
    expect(d.pending).toBe(1)
    expect(d.trees[1].points).toBe(1)
    -- another config first seen while planned: the learned rank is the active one
    M.learnedFor = 999
    M.learned = {}
    d = assert(M:Collect())
    expect(nodeIn(d, 13).rank).toBe(1)
end

@test("Collect: staged changes the ranks don't show still count one")
local function collectUnseen()
    w.forceStaged = true
    local d = assert(M:Collect())
    expect(d.pending).toBe(1)
    expect(M.unseenStaged).toBe(true)
end

@test("Collect: nothing without a config, a tree or nodes; hidden and empty nodes left out")
local function collectNothing()
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): any return nil end)
    expect(M:Collect()).toBeNil()
    expect(M:Collect(12345)).toBeNil()
    for _, n in ipairs(wt().nodes) do n.visible = false end
    expect(M:Collect(CONFIG)).toBeNil()
    for _, n in ipairs(wt().nodes) do n.visible = true; n.noEntry = true end
    wt().nodes[1].noEntry = false
    wt().groups = {}
    local d = assert(M:Collect(CONFIG))
    expect(#d.trees).toBe(1)
    expect(d.trees[1].name).toBe("Tree 1")
    expect(d.trees[1].groupID).toBeNil()
end

@test("Collect: a talent without its own name takes the spell's")
local function collectSpellName()
    wt().nodes[1].spellName = true
    mock.defineSpell(11, { name = "Spell Eleven", iconID = 777 })
    local d = assert(M:Collect())
    expect(nodeIn(d, 11).name).toBe("Spell Eleven")
    expect(nodeIn(d, 11).icon).toBe(777)
end

@test("Requires: the tree's points, else the talent above it")
local function requires()
    w.conditions[7] = { isMet = false, spentAmountRequired = 5 }
    w.conditions[8] = { isMet = true, spentAmountRequired = 10 }
    wt().nodes[2].conditions = { 8, 7 }
    local d = assert(M:Collect())
    local two = nodeIn(d, 12)
    expect(M:Requires(d.configID, two)).toBe("Requires 5 points in Arms")
    w.conditions[7].isMet = true
    expect(M:Requires(d.configID, two)).toBe("Requires 1 point in Arms One")
    nodeIn(d, 11).rank = 1
    expect(M:Requires(d.configID, two)).toBeNil()
    -- a two-rank talent above
    two.requires = { nodeIn(d, 13) }
    expect(M:Requires(d.configID, two)).toBe("Requires 2 points in Arms Three")
    expect(M:Requires(d.configID, nodeIn(d, 11))).toBeNil()
end

@test("Editable: not in combat, not when the game says no, not another talent group")
local function editable()
    expect(M:Editable()).toBe(true)
    mock.fake("C_ClassTalents.CanChangeTalents", function(): (boolean, string) return false, "At a trainer only." end)
    expect({ M:Editable() }).toEqual({ false, "At a trainer only." })
    mock.fake("C_ClassTalents.CanChangeTalents", function(): (boolean, any) return false, mock.secret("x") end)
    expect({ M:Editable() }).toEqual({ false })
    mock.fake("C_ClassTalents.CanChangeTalents", function(): boolean return true end)
    M.viewing = 2
    expect({ M:Editable() }).toEqual({ false, "Activate this specialization to change its talents." })
    M.viewing = nil
    mock.player:enterCombat()
    expect({ M:Editable() }).toEqual({ false, "Talents can't change in combat." })
    mock.player:leaveCombat()
end

@test("Inspecting: the spells window's inspected unit, else nil")
local function inspecting()
    local f: any = _G.PlayerSpellsFrame
    expect(M:Inspecting()).toBeNil()
    mock.stub(f, "IsInspecting", function(): boolean return true end)
    mock.stub(f, "GetInspectUnit", function(): string return "party1" end)
    expect(M:Inspecting()).toBe("party1")
    mock.stub(f, "GetInspectUnit", function(): string error("gone") end)
    expect(M:Inspecting()).toBe("target")
    mock.stub(f, "IsInspecting", function(): boolean error("gone") end)
    expect(M:Inspecting()).toBeNil()
end

--------------------------------------------------------------------------------
-- Planning on your talents
--------------------------------------------------------------------------------

@test("Purchase, Refund, Undo and Apply go through the game's staging")
local function staging()
    M.data = assert(M:Collect())
    local one = nodeIn(M.data, 11)
    one.canSpend = false
    M:Purchase(one)
    expect(w.purchases).toBe(0)
    one.canSpend = true
    M:Purchase(one)
    expect(w.staged[11]).toBe(1)
    -- Render without pages keeps the data
    M.data = assert(M:Collect())
    expect(M.data.pending).toBe(1)
    M:Refund(nodeIn(M.data, 13)) -- nothing planned there
    expect(w.staged[11]).toBe(1)
    M:Refund(nodeIn(M.data, 11))
    expect(w.staged[11]).toBeNil()
    -- Undo: only with something planned
    M.data = assert(M:Collect())
    M:Undo()
    w.staged[13] = 1
    M.data = assert(M:Collect())
    M:Undo()
    expect(w.staged[13]).toBeNil()
    -- Apply
    w.staged[13] = 2
    M.data = assert(M:Collect())
    M:Apply()
    expect(w.commits).toBe(1)
    expect(wt().nodes[3].rank).toBe(2)
    mock.advanceTime(0.1)
    expectNoErrors()
end

@test("Apply says so when the game refuses; nothing in combat or without data")
local function applyRefused()
    M.data = nil
    M:Apply()
    M:Undo()
    M:Refund({ pending = 1 })
    M:Purchase({ canSpend = true })
    expect(w.commits).toBe(0)
    w.staged[13] = 1
    M.data = assert(M:Collect())
    w.commitResult = false
    M:Apply()
    expect(w.commits).toBe(1)
    local printed = mock.printed()
    expect(printed[#printed]).toContain("The talents couldn't be applied.")
    mock.player:enterCombat()
    M:Apply()
    M:Refund(nodeIn(M.data, 13))
    expect(w.commits).toBe(1)
    expect(w.staged[13]).toBe(1)
    mock.player:leaveCombat()
    -- the inspected config is never bought into
    M.data = assert(M:Collect(INSPECT))
    local one = nodeIn(M.data, 11)
    one.canSpend = true
    M:Purchase(one)
    expect(w.purchases).toBe(0)
end

@test("Apply without the class commit uses C_Traits.CommitConfig")
local function applyTraits()
    local ct: any = C_ClassTalents
    local commit = ct.CommitConfig
    ct.CommitConfig = nil
    w.staged[11] = 1
    M.data = assert(M:Collect())
    M:Apply()
    ct.CommitConfig = commit
    expect(w.commits).toBe(1)
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

@test("Pages: the visible ones; Render does nothing without one")
local function pages()
    local a, b = fakePage(true), fakePage(false)
    M.windowPage, M.page = a, b
    expect(M:Pages()).toEqual({ a })
    a.visible = false
    expect(#M:Pages()).toBe(0)
    M.data = "unchanged"
    M:Render()
    expect(M.data).toBe("unchanged")
end

@test("Fill: your talents on the spells window's page")
local function fillSpells()
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false), p
    wt().nodes[1].rank = 1
    wt().nodes[1].canPurchase = false
    M:Render()
    local d = p.drawn
    expect(p.data).toBe(M.data)
    expect(p.specs).toBeNil()
    expect(d.name).toBe("Arms")
    expect(#d.trees).toBe(3)
    expect(d.available).toBe(5)
    expect(d.editable).toBe(true)
    expect(d.readOnly).toBe(false)
    expect(d.hint).toBe("Click a talent to plan a point; nothing changes until you apply.")
    expect(d.back).toBeNil()
    local two, three = nodeIn(M.data, 12), nodeIn(M.data, 13)
    expect(two.locked).toBe(true)
    expect(three.canSpend).toBe(true)
    expect(nodeIn(M.data, 11).canSpend).toBe(false)
    expect(three.next).toBe(false)
    -- no points anywhere: the class's name; nothing to spend
    wt().nodes[1].rank = 0
    wt().available = 0
    M:Render()
    expect(p.drawn.name).toBe((UnitClass("player")))
    expect(nodeIn(M.data, 13).canSpend).toBe(false)
end

@test("Fill: no talents yet, two talent groups, not editable")
local function fillStates()
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false), p
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): any return nil end)
    M:Render()
    expect(p.drawn).toEqual({ hint = "No talents to show yet." })
    world.install(w)
    mock.fake("GetNumSpecGroups", function(): number return 2 end)
    M:Render()
    expect(p.specs).toEqual({
        { label = "Primary", name = "", active = true },
        { label = "Secondary", name = "", active = false },
    })
    expect(p.specView).toBe(1)
    mock.player:enterCombat()
    M:Render()
    expect(p.drawn.editable).toBe(false)
    expect(p.drawn.hint).toBe("Talents can't change in combat.")
    mock.player:leaveCombat()
end

@test("Fill: another player's talents on the spells window, read only")
local function fillInspected()
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false), p
    local f: any = _G.PlayerSpellsFrame
    local other = mock.spawnUnit({ name = "Tamsin", level = 42, class = "WARRIOR", player = true, reaction = "friendly" })
    mock.player:target(other)
    mock.stub(f, "IsInspecting", function(): boolean return true end)
    mock.stub(f, "GetInspectUnit", function(): string return "target" end)
    M:Render()
    local d = p.drawn
    expect(d.readOnly).toBe(true)
    expect(d.editable).toBe(false)
    expect(d.head.name).toBe("Tamsin")
    expect(d.head.class).toBe("WARRIOR")
    expect(d.head.line).toBe("Level 42 Warrior")
    expect(d.hint).toBe("Viewing Tamsin's talents. Nothing here can be changed.")
    expect(d.back).toBeNil()
    -- theirs haven't arrived: the hint says so
    w.configs[INSPECT] = nil
    M:Render()
    expect(p.drawn).toEqual({ hint = "Their talents haven't arrived yet." })
    mock.player:target(nil)
end

@test("Render on the window: another player's talents stay when the inspect ends")
local function renderWindowInspect()
    local p = fakePage(true)
    M.windowPage, M.page = p, fakePage(false)
    local other = mock.spawnUnit({ name = "Bram", level = 0, class = "WARRIOR", player = true, reaction = "friendly" })
    mock.player:target(other)
    M.inspectUnit = "target"
    M:Render()
    expect(p.drawn.back).toBe("Back to inspect")
    expect(p.drawn.head.line).toBe("Level ?? Warrior")
    expect(p.builds).toBeNil()
    local theirs = M.inspectData
    expect(theirs.configID).toBe(INSPECT)
    w.configs[INSPECT] = nil
    M:Render()
    expect(M.inspectData).toBe(theirs)
    mock.player:target(nil)
end

@test("Fill on the window: your builds' picker, no build shown")
local function fillWindow()
    local p = fakePage(true)
    M.windowPage, M.page = p, fakePage(false)
    M:Render()
    expect(p.builds.value).toBe("")
    expect(p.order).toBeNil()
    expect(p.drawn.readOnly).toBe(false)
end

@test("Fill on the window: the active build's order and its next talent ringed")
local function fillActiveBuild()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13)))
    M:SetActive(id)
    M.buildView = id
    wt().nodes[1].rank = 1
    local p = fakePage(true)
    M.windowPage, M.page = p, fakePage(false)
    M:Render()
    expect(p.builds.value).toBe(id)
    expect(p.builds.badge).toBe("Active")
    expect(#p.order).toBe(2)
    expect(p.order[1].state).toBe("learned")
    expect(p.order[2].state).toBe("next")
    expect(nodeIn(M.data, 13).next).toBe(true)
    expect(nodeIn(M.data, 11).next).toBe(false)
end

@test("QueueRender renders once on the next frame, while enabled")
local function queue()
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false), p
    M:QueueRender()
    M:QueueRender()
    expect(p.drawn).toBeNil()
    mock.advanceTime(0.05)
    expect(p.drawn).never.toBeNil()
    expect(M.renderQueued).toBeNil()
end

@test("ShowTip: the game's tooltip with what a talent still needs")
local function showTip()
    local d = assert(M:Collect())
    local seen: any = nil
    mock.stub(SuuUI.UI, "TraitTooltip", function(_: any, configID: number, nodeID: number, opts: any)
        seen = { configID = configID, nodeID = nodeID, opts = opts }
    end)
    M.data = nil
    M:ShowTip(UIParent, nodeIn(d, 12))
    expect(seen).toBeNil()
    M:ShowTip(UIParent, nodeIn(d, 12), d)
    expect(seen.nodeID).toBe(12)
    expect(seen.opts.needs).toEqual({ "Requires 1 point in Arms One" })
    expect(seen.opts.treeName).toBe("Arms")
    expect(seen.opts.blocked).toBeNil()
    mock.player:enterCombat()
    M:ShowTip(UIParent, nodeIn(d, 11), d)
    expect(seen.opts.blocked).toBe("Talents can't change in combat.")
    mock.player:leaveCombat()
    local theirs = assert(M:Collect(INSPECT))
    M:ShowTip(UIParent, nodeIn(theirs, 11), theirs)
    expect(seen.opts.blocked).toBeNil()
    expect(seen.configID).toBe(INSPECT)
end

