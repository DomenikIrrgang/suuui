@test("another class's builds by name within the class")
local function othersByName()
    assert(M:AddBuild("Retribution", "PALADIN", {}))
    assert(M:AddBuild("Holy", "PALADIN", {}))
    local list = M:PickerOptions()
    local labels: string[] = {}
    for _, o in ipairs(list.options or list) do
        if o.label == "Holy" or o.label == "Retribution" then labels[#labels + 1] = o.label end
    end
    expect(labels).toEqual({ "Holy", "Retribution" })
end

@test("a choice talent's entry: in SuuUI's text and the game's string, and read back")
local function choices()
    wt().nodes[3].choice = true
    M.buildTrees = nil
    local id = assert(M:AddBuild("Choice", "WARRIOR", { { node = 11 }, { node = 13, entry = 131 } }))
    local b = M:Builds()[id]
    local share = assert(M:ShareText(b))
    local game = assert(M:GameString(b))
    local fromShare = assert(M:ReadPasted(share))
    expect(fromShare.steps[2].entry).toBe(131)
    local fromGame = assert(M:ReadPasted(game))
    local entry: number? = nil
    for _, s in ipairs(fromGame.steps) do if s.node == 13 then entry = s.entry end end
    expect(entry).toBe(131)
end

