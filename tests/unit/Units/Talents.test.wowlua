@test("FillPlan: the build's ranks on its class's trees")
local function fillPlan()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    M.buildView = id
    local p = fakePage(true)
    M.windowPage, M.page = p, fakePage(false)
    M:Render()
    local d = p.drawn
    expect(#d.trees).toBe(3)
    expect(d.trees[1].points).toBe(2)
    local one = d.trees[1].nodes[1]
    expect(one.id).toBe(11)
    expect(one.rank).toBe(1)
    expect(one.build).toBe(true)
    -- 11 is full: another rank of it can't come
    expect(one.canSpend).toBe(false)
    expect(one.problem).toBe("Arms One has only 1 rank; step 3 would be rank 2.")
    local two = d.trees[1].nodes[2]
    expect(two.locked).toBe(true)
    expect(d.trees[1].links[1].met).toBe(true)
    expect(d.available).toBe(49)
    expect(d.unspent).toContain("49")
    expect(d.unspent).toContain("points left")
    expect(d.status).toBe("Click adds the next step, right-click takes the last back · drag a line to move it")
    expect(d.actions.primary.enabled).toBe(false)
    expect(#p.order).toBe(2)
    expect(p.builds.buttons[1].label).toBe("Use build")
    expect(M.planTree).toBe(M:BuildTree("WARRIOR"))
    -- changed: Save and Discard
    M.draft.dirty = true
    M:Render()
    expect(p.drawn.status).toBe("Not saved yet · click adds the next step, right-click takes the last back")
    expect(p.drawn.statusColor).toBe("arcane")
    expect(p.drawn.actions.primary.enabled).toBe(true)
    p.drawn.actions.primary.onClick()
    expect(M.draft.dirty).toBe(false)
    M.draft.dirty = true
    M:Render()
    p.drawn.actions.secondary.onClick()
    -- (the saved build drawn again: a fresh draft of it, unchanged)
    expect(M.draft.dirty).toBe(false)
    expect(M.draft.steps).toEqual(store().builds[M.draft.id].steps)
    -- a problem
    M:Draft().problem = "Step 3 isn't a talent of this tree any more."
    M:Render()
    expect(p.drawn.status).toBe("Needs a look: Step 3 isn't a talent of this tree any more.")
    expect(p.drawn.statusColor).toBe("ember")
end

@test("FillPlan: a class whose talents can't be read")
