@test("PickerOptions: your class's builds by name, then other classes'")
local function pickerOptions()
    local out = M:PickerOptions()
    expect(out[1]).toEqual({ value = "", label = "Your talents", note = "no build" })
    expect(out[2]).toEqual({ heading = "Warrior" })
    expect(out[3]).toEqual({ value = "__none", label = "No builds yet", disabled = true })
    expect(#out).toBe(3)
    local b = assert(M:AddBuild("beta", "WARRIOR", steps(11)))
    local a = assert(M:AddBuild("Alpha", "WARRIOR", {}))
    local h = assert(M:AddBuild("Holy", "PALADIN", {}))
    store().builds.bx = { id = "bx", name = "Lost", class = "DRUID" }
    M:SetActive(b)
    out = M:PickerOptions()
    expect(out[3].value).toBe(a)
    expect(out[4].value).toBe(b)
    expect(out[4].note).toBe("1 / 0 / 0 · Active")
    expect(out[4].diamond).toBe("class-warrior")
    expect(out[5]).toEqual({ heading = "Other classes" })
    -- by class name: DRUID (no class: its file) before Paladin
    expect(out[6].value).toBe("bx")
    expect(out[6].note).toBe(" · ")
    expect(out[7].value).toBe(h)
    expect(out[7].note).toBe("Paladin · 0 / 0 / 0")
end

