@test("AskNewBuild: a name and a class make a build to plan")
local function askNewBuild()
    M:AskNewBuild()
    local p = M.newBuild
    expect(p).toBeShown()
    -- no name: nothing
    mock.click(p.create)
    expect(p).toBeShown()
    mock.typeText(p.name.edit, "Levelling")
    mock.click(p.create)
    expect(p).never.toBeShown()
    local id = M.buildView
    expect(M:Builds()[id].name).toBe("Levelling")
    expect(M:Builds()[id].class).toBe("WARRIOR")
    expect(M.planning).toBe(true)
    expect(M.window).toBeShown()
    M:AskNewBuild()
    expect(p.name.edit:GetText()).toBe("")
    mock.click(p.cancel)
    expect(p).never.toBeShown()
end

@test("ShareText and GameString write a build out")
local function shareTexts()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    local b = M:Builds()[id]
    local text = assert(M:ShareText(b))
    expect(text:sub(1, 6)).toBe("SuuUI:")
    local back = assert(SuuUI.UI.DecodeTalentBuild(text))
    expect(back.name).toBe("Arms")
    expect(#back.steps).toBe(2)
    mock.fake("C_Traits.GetLoadoutSerializationVersion", function(): number return 2 end)
    mock.fake("C_Traits.GetTreeHash", function(): number[]
        local h: number[] = {}
        for i = 1, 16 do h[i] = i end
        return h
    end)
    local game = M:GameString(b)
    expect(type(game)).toBe("string")
    mock.fake("C_Traits.GetTreeHash", function(): any return nil end)
    expect(M:GameString(b)).toBeNil()
    expect(M:GameString({ class = "DRUID", steps = {} })).toBeNil()
end

@test("ReadPasted: SuuUI's text, the game's string, or why not")
local function readPasted()
    expect(M:ReadPasted(nil)).toBeNil()
    expect(M:ReadPasted("   ")).toBeNil()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    local text = assert(M:ShareText(M:Builds()[id]))
    local found = assert(M:ReadPasted(text))
    expect(found.name).toBe("Arms")
    expect(found.class).toBe("WARRIOR")
    expect(found.steps).toEqual({ { node = 11 }, { node = 13 } })
    expect(found.note).toBeNil()
    -- a bad order: a note
    local bad = assert(SuuUI.UI.EncodeTalentBuild({ name = "", classID = 1, treeID = WARRIOR_TREE, steps = steps(12) }))
    found = assert(M:ReadPasted(bad))
    expect(found.name).toBe("Shared build")
    expect(found.note).toContain("Needs a look: ")
    -- another tree version
    local other = assert(SuuUI.UI.EncodeTalentBuild({ name = "x", classID = 1, treeID = 9, steps = steps(11) }))
    expect(assert(M:ReadPasted(other)).note).toBe("Made for another version of the talents.")
    -- a class without talents here
    local druid = assert(SuuUI.UI.EncodeTalentBuild({ name = "x", classID = 11, treeID = 9, steps = {} }))
    expect({ M:ReadPasted(druid) }).toEqual({ nil, "That class has no talents here." })
    local _, why = M:ReadPasted("SuuUI:garbage")
    expect(type(why)).toBe("string")
    expect({ M:ReadPasted("hello") }).toEqual({ nil, "This isn't SuuUI's text or the game's talent string." })
end

@test("ReadPasted: the game's own talent string")
local function readPastedGame()
    mock.fake("C_Traits.GetLoadoutSerializationVersion", function(): number return 2 end)
    mock.fake("C_Traits.GetTreeHash", function(): number[]
        local h: number[] = {}
        for i = 1, 16 do h[i] = 0 end
        return h
    end)
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13)))
    local game = assert(M:GameString(M:Builds()[id]))
    local found = assert(M:ReadPasted(game))
    expect(found.name).toBe("Imported build")
    expect(found.fromGame).toBe(true)
    expect(found.class).toBe("WARRIOR")
    expect(#found.steps).toBe(3)
    expect(found.note).toBeNil()
end

@test("BuildSummary: points, per tree, levels")
local function buildSummary()
    expect(M:BuildSummary("WARRIOR", steps(11, 13, 21))).toBe("3 points · Arms 2, Fury 1, Protection 0 · levels 5–7, in order")
    expect(M:BuildSummary("WARRIOR", {})).toBe("0 points · Arms 0, Fury 0, Protection 0")
    expect(M:BuildSummary("DRUID", steps(1))).toBe("1 point · levels 5–5, in order")
end

@test("ShowShare: Copy shows the texts; Import previews and saves")
local function showShare()
    -- nothing shown: Import
    M:ShowShare("copy")
    local p = M.share
    expect(p).toBeShown()
    expect(p.mode).toBe("import")
    expect(p.ok:IsEnabled()).toBe(false)
    expect(p.previewLine).toHaveText("What you paste shows here before it's saved.")
    -- a pasted text
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    local text = assert(M:ShareText(M:Builds()[id]))
    M:PreviewPaste(text)
    expect(p.ok:IsEnabled()).toBe(true)
    expect(p.previewName).toHaveText("Arms")
    expect(p.previewClass).toHaveText("Warrior")
    expect(p.previewLine).toHaveText("2 points · Arms 2, Fury 0, Protection 0 · levels 5–6, in order")
    M:PreviewPaste("nonsense")
    expect(p.previewLine).toHaveText("This isn't SuuUI's text or the game's talent string.")
    expect(p.ok:IsEnabled()).toBe(false)
    mock.click(p.ok)
    expect(p).toBeShown()
    M:PreviewPaste(text)
    mock.click(p.ok)
    expect(p).never.toBeShown()
    expect(M:Builds()[M.buildView].name).toBe("Arms")
    expect(M.buildView).never.toBe(id)
    expect(M.planning).toBe(true)
    -- Copy: the build shown
    M:ShowShare("copy")
    expect(p.mode).toBe("copy")
    expect(p.text.edit:GetText()).toBe(text)
    -- (the game's own string too: the engine answers its version and the tree's hash)
    expect(p.game).toBeShown()
    expect(p.game.shared ~= "").toBe(true)
    mock.advanceTime(0.05)
    -- the copy fields stay as written
    p.text.edit:SetText("changed")
    p.reselect()
    expect(p.text.edit:GetText()).toBe(text)
    mock.click(p.ok)
    expect(p).never.toBeShown()
    -- the switch
    M:ShowShare("import")
    expect(p.mode).toBe("import")
    mock.click(p.cancel)
end

@test("PreviewPaste: the game's string notes what can't come along")
local function previewGame()
    mock.fake("C_Traits.GetLoadoutSerializationVersion", function(): number return 2 end)
    mock.fake("C_Traits.GetTreeHash", function(): number[]
        local h: number[] = {}
        for i = 1, 16 do h[i] = 0 end
        return h
    end)
    M:PreviewPaste("x")
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11)))
    M.buildView = id
    M:ShowShare("copy")
    local p = M.share
    expect(p.game).toBeShown()
    local game = p.game.edit:GetText()
    M:ShowShare("import")
    M:PreviewPaste(game)
    expect(p.previewNote:GetText()).toContain("From the game's string the order can't come along")
    mock.click(p.cancel)
end

