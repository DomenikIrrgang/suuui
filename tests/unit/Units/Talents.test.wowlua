    M:Restore()
    f:SetSize(wd, h)
end

@test("Events: a trainer's reset offer prices the notice; talent changes say so")
local function gameEvents()
    local notes: any[] = {}
    mock.stub(SuuUI, "Notify", function(def: any) notes[#notes + 1] = def end)
    wt().nodes[4].rank = 1
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11)))
    M:SetActive(id)
    store().reset[charKey()] = { [1] = id }
    mock.fireEvent("CONFIRM_TALENT_WIPE", 50000, 1)
    expect(M.wipeAt).toBe(GetTime())
    expect(notes[1].body).toContain("1 talent aren't in it")
    heard = {}
    mock.fireEvent("PLAYER_TALENT_UPDATE")
    expect(heard.SUUUI_TALENT_BUILD_CHANGED).toBe(1)
    -- a build waiting for a reset looks again half a second later
    wt().nodes[4].rank = 0
    mock.advanceTime(0.6)
    expect(store().reset[charKey()][1]).toBeNil()
    mock.fireEvent("INSPECT_READY", UnitGUID("player"))
    mock.fireEvent("UPDATE_BINDINGS")
    mock.advanceTime(0.1)
    expectNoErrors()
end

