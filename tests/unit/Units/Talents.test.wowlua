-- Units/Talents: the Talents module: its game data, the page and planning
-- on your talents, the builds' state, using a build, the events. The
-- stand-in trees and the shared setup are in Talents/TalentsHelpers; each
-- part's own tests are in tests/unit/Units/Talents/.

import internal M from "/Units/Talents"
import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import charKey from "/Units/Talents/Builds"
import SuuUI from "/Core/API"
import type TraitTooltipOptions from "/UI/TalentTree"
import * as secret from "wowlua:secret"
import * as frames from "wowlua:frames"
import * as world from "./TraitWorld"
import WARRIOR_TREE, CONFIG, INSPECT, heard, fakePage, drawn, order, store, wt, nodeIn, steps, build, window, captureNotes, captureDismissed, press, setup, teardown from "./Talents/TalentsHelpers"
import expectNoErrors, captureConfirm from "../../helpers"

local w: world.World

@beforeEach
local function before()
    w = setup()
end

@afterEach
local function after()
    teardown()
end

--------------------------------------------------------------------------------
-- The game's data
--------------------------------------------------------------------------------

@test("SpecGroups: one group unless the game says two; secrets read as one")
local function specGroups()
    expect({ M:SpecGroups() }).toEqual({ 1, 1 })
    mock.fake("GetNumSpecGroups", function(): number
        return 2
    end)
    mock.fake("C_SpecializationInfo.GetActiveSpecGroup", function(): number
        return 2
    end)
    expect({ M:SpecGroups() }).toEqual({ 2, 2 })
    mock.fake("GetNumSpecGroups", function()
        return mock.secret(2)
    end)
    mock.fake("C_SpecializationInfo.GetActiveSpecGroup", function()
        error("no")
    end)
    expect({ M:SpecGroups() }).toEqual({ 1, 1 })
end

@test("ConfigID: the active config, or the viewed talent group's")
local function configID()
    expect(M:ConfigID()).toBe(CONFIG)
    mock.fake("GetNumSpecGroups", function(): number
        return 2
    end)
    mock.fake("C_SpecializationInfo.GetCombatConfigIDForSpecGroup", function(g: number): number
        return 200 + g
    end)
    M.viewing = 2
    expect(M:ConfigID()).toBe(202)
    M.viewing = 1
    expect(M:ConfigID()).toBe(CONFIG)
    M.viewing = 2
    mock.fake("C_SpecializationInfo.GetCombatConfigIDForSpecGroup", function()
        return nil
    end)
    expect(M:ConfigID()).toBe(CONFIG)
    mock.fake("C_ClassTalents.GetActiveConfigID", function()
        return mock.secret(5)
    end)
    expect(M:ConfigID()).toBeNil()
end

@test("Editable: not in combat, not when the game says no, not another talent group")
local function editable()
    expect(M:Editable()).toBe(true)
    mock.fake("C_ClassTalents.CanChangeTalents", function(): (boolean, string)
        return false, "At a trainer only."
    end)
    expect({ M:Editable() }).toEqual({ false, "At a trainer only." })
    mock.fake("C_ClassTalents.CanChangeTalents", function(): (boolean, any)
        return false, mock.secret("x")
    end)
    expect({ M:Editable() }).toEqual({ false })
    mock.fake("C_ClassTalents.CanChangeTalents", function(): boolean
        return true
    end)
    M.viewing = 2
    expect({ M:Editable() }).toEqual({ false, "Activate this specialization to change its talents." })
    M.viewing = nil
    mock.player:enterCombat()
    expect({ M:Editable() }).toEqual({ false, "Talents can't change in combat." })
    mock.player:leaveCombat()
end

@test("Inspecting: the spells window's inspected unit, else nil")
local function inspecting()
    local f = assert(frames.find("PlayerSpellsFrame"))
    expect(M:Inspecting()).toBeNil()
    mock.stub(f, "IsInspecting", function(): boolean
        return true
    end)
    mock.stub(f, "GetInspectUnit", function(): string
        return "party1"
    end)
    expect(M:Inspecting()).toBe("party1")
    mock.stub(f, "GetInspectUnit", function(): string
        error("gone")
    end)
    expect(M:Inspecting()).toBe("target")
    mock.stub(f, "IsInspecting", function(): boolean
        error("gone")
    end)
    expect(M:Inspecting()).toBeNil()
end

--------------------------------------------------------------------------------
-- Planning on your talents
--------------------------------------------------------------------------------

@test("Purchase, Refund, Undo and Apply go through the game's staging")
local function staging()
    M.data = assert(M:Collect())
    local one = nodeIn(M.data, 11)
    one.canSpend = false
    M:Purchase(one)
    expect(w.purchases).toBe(0)
    one.canSpend = true
    M:Purchase(one)
    expect(w.staged[11]).toBe(1)
    -- Render without pages keeps the data
    M.data = assert(M:Collect())
    expect(M.data.pending).toBe(1)
    M:Refund(nodeIn(M.data, 13)) -- nothing planned there
    expect(w.staged[11]).toBe(1)
    M:Refund(nodeIn(M.data, 11))
    expect(w.staged[11]).toBeNil()
    -- Undo: only with something planned
    M.data = assert(M:Collect())
    M:Undo()
    w.staged[13] = 1
    M.data = assert(M:Collect())
    M:Undo()
    expect(w.staged[13]).toBeNil()
    -- Apply
    w.staged[13] = 2
    M.data = assert(M:Collect())
    M:Apply()
    expect(w.commits).toBe(1)
    expect(wt().nodes[3].rank).toBe(2)
    mock.advanceTime(0.1)
    expectNoErrors()
end

@test("Apply says so when the game refuses; nothing in combat or without data")
local function applyRefused()
    M.data = nil
    M:Apply()
    M:Undo()
    local loose = nodeIn(M:Collect(), 11)
    loose.pending, loose.canSpend = 1, true
    M:Refund(loose)
    M:Purchase(loose)
    expect(w.commits).toBe(0)
    w.staged[13] = 1
    M.data = assert(M:Collect())
    w.commitResult = false
    M:Apply()
    expect(w.commits).toBe(1)
    local printed = mock.printed()
    expect(printed[#printed]).toContain("The talents couldn't be applied.")
    mock.player:enterCombat()
    M:Apply()
    M:Refund(nodeIn(M.data, 13))
    expect(w.commits).toBe(1)
    expect(w.staged[13]).toBe(1)
    mock.player:leaveCombat()
    -- the inspected config is never bought into
    M.data = assert(M:Collect(INSPECT))
    local one = nodeIn(M.data, 11)
    one.canSpend = true
    M:Purchase(one)
    expect(w.purchases).toBe(0)
end

@test("Apply without the class commit uses C_Traits.CommitConfig")
local function applyTraits()
    mock.stub(C_ClassTalents, "CommitConfig") -- (put back after the test)
    rawset(C_ClassTalents, "CommitConfig", nil)
    w.staged[11] = 1
    M.data = assert(M:Collect())
    M:Apply()
    expect(w.commits).toBe(1)
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

@test("Pages: the visible ones; Render does nothing without one")
local function pages()
    local a, b = fakePage(true), fakePage(false)
    M.windowPage, M.page = a.page, b.page
    expect(M:Pages()).toEqual({ a.page })
    a.visible = false
    expect(#M:Pages()).toBe(0)
    local unchanged = assert(M:Collect())
    M.data = unchanged
    M:Render()
    expect(M.data).toBe(unchanged)
end

@test("Fill: your talents on the spells window's page")
local function fillSpells()
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false).page, p.page
    wt().nodes[1].rank = 1
    wt().nodes[1].canPurchase = false
    M:Render()
    local d = drawn(p)
    expect(M:PageData(p.page)).toBe(M.data)
    expect(p.specs).toBeNil()
    expect(d.name).toBe("Arms")
    expect(#assert(d.trees)).toBe(3)
    expect(d.available).toBe(5)
    expect(d.editable).toBe(true)
    expect(d.readOnly).toBe(false)
    expect(d.hint).toBe("Click a talent to plan a point; nothing changes until you apply.")
    expect(d.back).toBeNil()
    local two, three = nodeIn(M.data, 12), nodeIn(M.data, 13)
    expect(two.locked).toBe(true)
    expect(three.canSpend).toBe(true)
    expect(nodeIn(M.data, 11).canSpend).toBe(false)
    expect(three.next).toBe(false)
    -- no points anywhere: the class's name; nothing to spend
    wt().nodes[1].rank = 0
    wt().available = 0
    M:Render()
    expect(drawn(p).name).toBe(secret.asString((UnitClass("player"))))
    expect(nodeIn(M.data, 13).canSpend).toBe(false)
end

@test("Fill: a row opens with points in its own tree, whatever the game says of the others")
local function ownTree()
    -- (found in game: points in Arms opened Fury's next row)
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false).page, p.page
    w.conditions[9] = { isMet = true, spentAmountRequired = 3 }
    local furyTwo = wt().nodes[5]
    furyTwo.available, furyTwo.meetsEdges, furyTwo.canPurchase = true, true, true
    furyTwo.conditions = { 9 }
    wt().nodes[1].rank = 1
    wt().nodes[3].rank = 2
    M:Render()
    local two = nodeIn(M.data, 22)
    expect(two.locked).toBe(true)
    expect(two.canSpend).toBe(false)
    -- 3 points in Fury: open
    wt().nodes[4].rank = 1
    wt().nodes[6].rank = 2
    M:Render()
    two = nodeIn(M.data, 22)
    expect(two.locked).toBe(false)
    expect(two.canSpend).toBe(true)
end

@test("Fill: no talents yet, two talent groups, not editable")
local function fillStates()
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false).page, p.page
    mock.fake("C_ClassTalents.GetActiveConfigID", function()
        return nil
    end)
    M:Render()
    expect(p.drawn).toEqual({ hint = "No talents to show yet." })
    world.install(w)
    mock.fake("GetNumSpecGroups", function(): number
        return 2
    end)
    M:Render()
    expect(p.specs).toEqual({
        { label = "Primary", name = "", active = true },
        { label = "Secondary", name = "", active = false },
    })
    expect(p.specView).toBe(1)
    mock.player:enterCombat()
    M:Render()
    expect(drawn(p).editable).toBe(false)
    expect(drawn(p).hint).toBe("Talents can't change in combat.")
    mock.player:leaveCombat()
end

@test("Fill: another player's talents on the spells window, read only")
local function fillInspected()
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false).page, p.page
    local f = assert(frames.find("PlayerSpellsFrame"))
    local other = mock.spawnUnit({
        name = "Tamsin",
        level = 42,
        class = "WARRIOR",
        player = true,
        reaction = "friendly",
    })
    mock.player:target(other)
    mock.stub(f, "IsInspecting", function(): boolean
        return true
    end)
    mock.stub(f, "GetInspectUnit", function(): string
        return "target"
    end)
    M:Render()
    local d = drawn(p)
    expect(d.readOnly).toBe(true)
    expect(d.editable).toBe(false)
    expect(assert(d.head).name).toBe("Tamsin")
    expect(assert(d.head).class).toBe("WARRIOR")
    expect(assert(d.head).line).toBe("Level 42 Warrior")
    expect(d.hint).toBe("Viewing Tamsin's talents. Nothing here can be changed.")
    expect(d.back).toBeNil()
    -- theirs haven't arrived: the hint says so
    w.configs[INSPECT] = nil
    M:Render()
    expect(p.drawn).toEqual({ hint = "Their talents haven't arrived yet." })
    mock.player:target(nil)
end

@test("Render on the window: another player's talents stay when the inspect ends")
local function renderWindowInspect()
    local p = fakePage(true)
    M.windowPage, M.page = p.page, fakePage(false).page
    local other = mock.spawnUnit({ name = "Bram", level = 0, class = "WARRIOR", player = true, reaction = "friendly" })
    mock.player:target(other)
    M.inspectUnit = "target"
    M:Render()
    expect(drawn(p).back).toBe("Back to inspect")
    expect(assert(drawn(p).head).line).toBe("Level ?? Warrior")
    expect(p.builds).toBeNil()
    local theirs = assert(M.inspectData)
    expect(theirs.configID).toBe(INSPECT)
    w.configs[INSPECT] = nil
    M:Render()
    expect(M.inspectData).toBe(theirs)
    mock.player:target(nil)
end

@test("Fill on the window: your builds' picker, no build shown")
local function fillWindow()
    local p = fakePage(true)
    M.windowPage, M.page = p.page, fakePage(false).page
    M:Render()
    expect(assert(p.builds).value).toBe("")
    expect(p.order).toBeNil()
    expect(drawn(p).readOnly).toBe(false)
end

@test("Fill on the window: the active build's order and its next talent ringed")
local function fillActiveBuild()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13)))
    M:SetActive(id)
    M.buildView = id
    wt().nodes[1].rank = 1
    local p = fakePage(true)
    M.windowPage, M.page = p.page, fakePage(false).page
    M:Render()
    expect(assert(p.builds).value).toBe(id)
    expect(assert(p.builds).badge).toBe("Active")
    expect(#order(p)).toBe(2)
    expect(order(p)[1].state).toBe("learned")
    expect(order(p)[2].state).toBe("next")
    expect(nodeIn(M.data, 13).next).toBe(true)
    expect(nodeIn(M.data, 11).next).toBe(false)
end

@test("QueueRender renders once on the next frame, while enabled")
local function queue()
    local p = fakePage(true)
    M.windowPage, M.page = fakePage(false).page, p.page
    M:QueueRender()
    M:QueueRender()
    expect(p.drawn).toBeNil()
    mock.advanceTime(0.05)
    expect(p.drawn).never.toBeNil()
    expect(M.renderQueued).toBe(false)
end

type Seen = { configID: number, nodeID: number, opts: TraitTooltipOptions }

@test("ShowTip: the game's tooltip with what a talent still needs")
local function showTip()
    local d = assert(M:Collect())
    local last: Seen? = nil
    local function seen(): Seen
        return assert(last)
    end
    mock.stub(SuuUI.UI, "TraitTooltip", function(_: Frame, configID: number, nodeID: number, opts: TraitTooltipOptions?)
        last = { configID = configID, nodeID = nodeID, opts = assert(opts) }
    end)
    M.data = nil
    M:ShowTip(UIParent, nodeIn(d, 12))
    expect(last).toBeNil()
    M:ShowTip(UIParent, nodeIn(d, 12), d)
    expect(seen().nodeID).toBe(12)
    expect(seen().opts.needs).toEqual({ "Requires 1 point in Arms One" })
    expect(seen().opts.treeName).toBe("Arms")
    expect(seen().opts.blocked).toBeNil()
    mock.player:enterCombat()
    M:ShowTip(UIParent, nodeIn(d, 11), d)
    expect(seen().opts.blocked).toBe("Talents can't change in combat.")
    mock.player:leaveCombat()
    local theirs = assert(M:Collect(INSPECT))
    M:ShowTip(UIParent, nodeIn(theirs, 11), theirs)
    expect(seen().opts.blocked).toBeNil()
    expect(seen().configID).toBe(INSPECT)
end

--------------------------------------------------------------------------------
-- Talent builds
--------------------------------------------------------------------------------

@test("Talented and StepLevel follow the currency and your level")
local function talentedLevels()
    expect(M:Talented()).toBe(5)
    expect(M:StepLevel(1)).toBe(5)
    expect(M:StepLevel(6)).toBe(10)
    -- at 60 (or without the currency) the last answer stays
    mock.fake("UnitLevel", function(): number
        return 60
    end)
    wt().maxQuantity = 1
    expect(M:Talented()).toBe(5)
    M.talented = 0
    expect(M:Talented()).toBe(0)
    mock.fake("UnitLevel", function(): number
        return 12
    end)
    wt().maxQuantity = 6
    expect(M:Talented()).toBe(3)
    mock.fake("C_ClassTalents.GetActiveConfigID", function()
        return nil
    end)
    expect(M:Talented()).toBe(3)
end

@test("AddBuild, Builds, NewID, SetActive and ActiveID")
local function addBuild()
    expect(M:AddBuild("x", "DRUID", {})).toBeNil()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    expect(id).toBe("b1")
    local b = build(id)
    expect(b.name).toBe("Arms")
    expect(b.class).toBe("WARRIOR")
    expect(b.classID).toBe(1)
    expect(b.treeID).toBe(WARRIOR_TREE)
    expect(b.split).toBe("2 / 0 / 0")
    expect(b.updated).toBe(time())
    expect(heard.SUUUI_TALENT_BUILD_CHANGED).toBe(1)
    expect(M:NewID()).toBe("b2")
    expect(M:ActiveID()).toBeNil()
    M:SetActive(id)
    expect(M:ActiveID()).toBe(id)
    expect(M:ActiveID(1)).toBe(id)
    expect(M:ActiveID(2)).toBeNil()
    M:SetActive("b9", 2)
    expect(M:ActiveID(2)).toBe("b9")
    M.viewing = 2
    expect(M:ActiveID()).toBe("b9")
    expect(store().active[charKey()]).toEqual({ id, "b9" })
end

@test("Viewed, Planning and Draft")
local function viewedPlanning()
    expect(M:Viewed()).toBeNil()
    expect(M:Planning()).toBe(false)
    expect(M:Draft()).toBeNil()
    local mine = assert(M:AddBuild("Arms", "WARRIOR", steps(11)))
    local theirs = assert(M:AddBuild("Holy", "PALADIN", {}))
    M.buildView = ""
    expect(M:Viewed()).toBeNil()
    M.buildView = mine
    expect(M:Viewed()).toBe(M:Builds()[mine])
    -- yours, not active: planning; active: only when asked
    expect(M:Planning()).toBe(true)
    M:SetActive(mine)
    expect(M:Planning()).toBe(false)
    M.planning = true
    expect(M:Planning()).toBe(true)
    M.inspectUnit = "target"
    expect(M:Planning()).toBe(false)
    M.inspectUnit = nil
    M.buildView = theirs
    expect(M:Planning()).toBe(true)
    -- the draft: a copy until saved
    M.buildView = mine
    local d = assert(M:Draft())
    expect(d.id).toBe(mine)
    expect(d.dirty).toBe(false)
    expect(d.steps).toEqual(steps(11))
    expect(d.steps == build(mine).steps).toBe(false)
    expect(M:Draft()).toBe(d)
    expect(M:Viewed()).toBe(d)
end

@test("SaveDraft and DiscardDraft")
local function saveDiscard()
    M:SaveDraft()
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M.buildView = id
    local d = assert(M:Draft())
    d.steps = steps(11, 21)
    d.name = "Renamed"
    d.dirty = true
    wipe(heard)
    M:SaveDraft()
    local b = build(id)
    expect(b.name).toBe("Renamed")
    expect(b.steps).toEqual(steps(11, 21))
    expect(b.split).toBe("1 / 1 / 0")
    expect(d.dirty).toBe(false)
    expect(heard.SUUUI_TALENT_BUILD_CHANGED).toBe(1)
    M:DiscardDraft()
    expect(M.draft).toBeNil()
    -- a draft of a build deleted meanwhile: nothing to save into
    d = assert(M:Draft())
    store().builds[id] = nil
    M:SaveDraft()
    expect(store().builds[id]).toBeNil()
end

@test("Leave asks first when the draft has changes")
local function leave()
    local asked = captureConfirm().last
    local went = 0
    M:Leave(function()
        went = went + 1
    end)
    expect(went).toBe(1)
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M.buildView = id
    assert(M:Draft()).dirty = true
    M:Leave(function()
        went = went + 1
    end)
    expect(went).toBe(1)
    expect(asked().title).toBe("Discard changes?")
    expect(asked().text).toBe("Your changes to Arms aren't saved.")
    assert(asked().onConfirm)()
    expect(went).toBe(2)
    expect(M.draft).toBeNil()
    -- a clean draft goes without asking
    M:Draft()
    M:Leave(function()
        went = went + 1
    end)
    expect(went).toBe(3)
    expect(M.draft).toBeNil()
end

@test("ShowBuild shows a build, not planning")
local function showBuild()
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M.planning = true
    M:ShowBuild(id)
    expect(M.buildView).toBe(id)
    expect(M.planning).toBe(false)
    M:ShowBuild(nil)
    expect(M.buildView).toBeNil()
end

@test("DeleteBuild forgets it everywhere")
local function deleteBuild()
    local dismissed = captureDismissed()
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    local keep = assert(M:AddBuild("Fury", "WARRIOR", {}))
    M:SetActive(id, 1)
    M:SetActive(keep, 2)
    store().reset[charKey()] = { [1] = id }
    M.buildView = id
    M:Draft()
    M:DeleteBuild(id)
    expect(M:Builds()[id]).toBeNil()
    expect(M:Builds()[keep]).never.toBeNil()
    expect(M:ActiveID(1)).toBeNil()
    expect(M:ActiveID(2)).toBe(keep)
    expect(assert(store().reset[charKey()])[1]).toBeNil()
    expect(M.draft).toBeNil()
    expect(M.buildView).toBeNil()
    expect(dismissed).toEqual({ "suu:talentbuild:reset" })
end

@test("NextTalent: your active build's next step on your talents")
local function nextTalent()
    expect(M:NextTalent()).toBeNil()
    local other = assert(M:AddBuild("Holy", "PALADIN", steps(111)))
    M:SetActive(other)
    expect(M:NextTalent()).toBeNil()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13)))
    M:SetActive(id)
    wt().nodes[1].rank = 1
    local n = M:NextTalent()
    expect(n).toEqual({
        node = 13,
        name = "Arms Three",
        icon = 1013,
        rank = 1,
        max = 2,
        treeName = "Arms",
        build = "Arms",
        index = 2,
    })
    -- through the service
    expect(SuuUI.TalentBuildNext()).toEqual(n)
    wt().nodes[3].rank = 2
    expect(M:NextTalent()).toBeNil()
    mock.fake("C_ClassTalents.GetActiveConfigID", function()
        return nil
    end)
    expect(M:NextTalent(1, nil)).toBeNil()
end

--------------------------------------------------------------------------------
-- Using a build
--------------------------------------------------------------------------------

@test("StageFits plans the fits, after rolling back what was planned")
local function stageFits()
    local data = assert(M:Collect())
    expect(M:StageFits(steps(11, 13), data)).toBe(2)
    expect(w.staged).toEqual({ [11] = 1, [13] = 1 })
    data.staged = true
    expect(M:StageFits(steps(21), data)).toBe(1)
    expect(w.staged).toEqual({ [21] = 1 })
    w.purchaseResult = false
    expect(M:StageFits(steps(23), data)).toBe(0)
end

@test("UseBuild: what fits is planned, the build active")
local function useBuild()
    M:UseBuild("nope")
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    local dismissed = captureDismissed()
    M:UseBuild(id)
    expect(M:ActiveID()).toBe(id)
    expect(M.buildView).toBe(id)
    expect(M.planning).toBe(false)
    expect(w.staged).toEqual({ [11] = 1, [13] = 1 })
    expect(dismissed).toEqual({ "suu:talentbuild:planned", "suu:talentbuild:reset" })
    expect(assert(store().reset[charKey()])[1]).toBeNil()
end

@test("UseBuild: not now (combat, the game) says why")
local function useBuildBlocked()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11)))
    local asked = captureConfirm().last
    mock.player:enterCombat()
    M:UseBuild(id)
    expect(asked().title).toBe("Arms can't be used now")
    expect(asked().text).toBe("Talents can't change in combat.")
    mock.player:leaveCombat()
    mock.fake("C_ClassTalents.CanChangeTalents", function(): boolean
        return false
    end)
    M:UseBuild(id)
    expect(asked().text).toBe("Talents can't change right now.")
    expect(M:ActiveID()).toBeNil()
    -- no talents to read
    mock.fake("C_ClassTalents.CanChangeTalents", function(): boolean
        return true
    end)
    mock.fake("C_Traits.GetConfigInfo", function()
        return nil
    end)
    M:UseBuild(id)
    expect(M:ActiveID()).toBeNil()
end

@test("NotifyReset names the cost when the trainer offered it")
local function notifyReset()
    local notes = captureNotes()
    M:NotifyReset({ id = "b1", class = "WARRIOR", steps = {} }, 2, 10000)
    expect(assert(notes[1]).title).toBe("Reset at a trainer to use your build")
    expect(assert(notes[1]).body).toContain("2 talents aren't in it. Any warrior trainer can reset them (")
    expect(assert(notes[1])["until"]).toBe("Goes when you reset, or pick another build")
end

@test("CheckReset: after a trainer's reset the whole build is planned")
local function checkReset()
    local notes = captureNotes()
    local dismissed = captureDismissed()
    M:CheckReset()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    M:SetActive(id)
    store().reset[charKey()] = { [1] = id }
    -- still a talent learned: waits
    wt().nodes[4].rank = 1
    M:CheckReset()
    expect(assert(store().reset[charKey()])[1]).toBe(id)
    -- in combat: waits
    wt().nodes[4].rank = 0
    mock.player:enterCombat()
    M:CheckReset()
    mock.player:leaveCombat()
    expect(#notes).toBe(0)
    -- planned before the reset, the reset just offered: rolled back first
    w.staged[21] = 1
    M.wipeAt = GetTime()
    M:CheckReset()
    expect(assert(store().reset[charKey()])[1]).toBeNil()
    expect(w.staged).toEqual({ [11] = 1, [13] = 1 })
    expect(dismissed).toEqual({ "suu:talentbuild:reset" })
    expect(assert(notes[1]).title).toBe("Arms is planned")
    expect(assert(notes[1]).body).toBe("2 points in its order. Nothing is learned until you apply.")
    -- its buttons
    press(notes[1], 1)
    expect(w.commits).toBe(1)
    expect(dismissed[2]).toBe("suu:talentbuild:planned")
    press(notes[1], 2)
    expect(M.window).toBeShown()
    press(notes[1], 2)
    window():Hide()
end

@test("CheckReset: a build no longer active stops waiting; staged changes wait")
local function checkResetStale()
    local dismissed = captureDismissed()
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    store().reset[charKey()] = { [1] = id }
    M:CheckReset()
    expect(assert(store().reset[charKey()])[1]).toBeNil()
    expect(dismissed).toEqual({ "suu:talentbuild:reset" })
    store().reset[charKey()] = { [1] = "gone" }
    M:CheckReset()
    expect(assert(store().reset[charKey()])[1]).toBeNil()
    -- planned (not by the reset): waits
    M:SetActive(id)
    store().reset[charKey()] = { [1] = id }
    w.staged[21] = 1
    M:CheckReset()
    expect(assert(store().reset[charKey()])[1]).toBe(id)
    mock.fake("C_ClassTalents.GetActiveConfigID", function()
        return nil
    end)
    M:CheckReset()
    expect(assert(store().reset[charKey()])[1]).toBe(id)
end

--------------------------------------------------------------------------------
-- The events
--------------------------------------------------------------------------------

@test("Events: a trainer's reset offer prices the notice; talent changes say so")
local function gameEvents()
    local notes = captureNotes()
    wt().nodes[4].rank = 1
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11)))
    M:SetActive(id)
    store().reset[charKey()] = { [1] = id }
    mock.fireEvent("CONFIRM_TALENT_WIPE", 50000, 1)
    expect(M.wipeAt).toBe(GetTime())
    expect(assert(notes[1]).body).toContain("1 talent aren't in it")
    wipe(heard)
    mock.fireEvent("PLAYER_TALENT_UPDATE")
    expect(heard.SUUUI_TALENT_BUILD_CHANGED).toBe(1)
    -- a build waiting for a reset looks again half a second later
    wt().nodes[4].rank = 0
    mock.advanceTime(0.6)
    expect(assert(store().reset[charKey()])[1]).toBeNil()
    mock.fireEvent("INSPECT_READY", UnitGUID("player"))
    mock.fireEvent("UPDATE_BINDINGS")
    mock.advanceTime(0.1)
    expectNoErrors()
end
