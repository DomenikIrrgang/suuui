    -- through the service
    expect(SuuUI.TalentBuildNext()).toEqual(n)
    wt().nodes[3].rank = 2
    expect(M:NextTalent()).toBeNil()
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): any return nil end)
    expect(M:NextTalent(1, nil)).toBeNil()
end

