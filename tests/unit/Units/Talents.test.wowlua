@test("HeadButtons: Plan, Use build, Your talents, Delete, Rename")
local function headButtons()
    expect(M:HeadButtons(nil, false)).toEqual({})
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    local b = M:Builds()[id]
    local out = M:HeadButtons(b, false)
    expect(out[1].label).toBe("Plan")
    out[1].onClick()
    expect(M.planning).toBe(true)
    -- planning a build not active
    out = M:HeadButtons(b, true)
    expect(out[1].label).toBe("Use build")
    expect(out[1].disabled).toBeNil()
    expect(out[1].reason).toBe("Follow it on this character: what fits is planned, Apply learns it.")
    local used: string? = nil
    mock.stub(M, "UseBuild", function(_: any, which: string) used = which end)
    out[1].onClick()
    expect(used).toBe(id)
    M.buildView = id
    M:Draft().dirty = true
    out = M:HeadButtons(b, true)
    expect(out[1].disabled).toBe(true)
    expect(out[1].reason).toBe("Save it first.")
    M.draft = nil
    -- the active one: back to your talents
    M:SetActive(id)
    M.planning = true
    out = M:HeadButtons(b, true)
    expect(out[1].label).toBe("Your talents")
    out[1].onClick()
    expect(M.planning).toBe(false)
    -- Delete and Rename ask first
    local asked: any = nil
    mock.stub(SuuUI.UI, "Confirm", function(def: any) asked = def end)
    expect(out[2].label).toBe("Delete")
    out[2].onClick()
    expect(asked.title).toBe("Delete Arms?")
    expect(out[3].label).toBe("Rename")
    out[3].onClick()
    expect(asked.input.value).toBe("Arms")
    M:Draft()
    asked.onConfirm("Bladestorm")
    expect(M:Builds()[id].name).toBe("Bladestorm")
    expect(M.draft.name).toBe("Bladestorm")
    out[2].onClick()
    asked.onConfirm()
    expect(M:Builds()[id]).toBeNil()
    -- renaming a build gone meanwhile changes nothing
    out[3].onClick()
    asked.onConfirm("x")
    expect(M:Builds()[id]).toBeNil()
    -- another class's: Delete and Rename only
    local h = assert(M:AddBuild("Holy", "PALADIN", {}))
    out = M:HeadButtons(M:Builds()[h], true)
    expect(out[1].label).toBe("Delete")
    expect(#out).toBe(2)
end

@test("Picker: the head's picker for the build shown")
local function picker()
    local p = M:Picker(nil, false)
