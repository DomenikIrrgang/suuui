@test("Classes: every class with a tree, sorted by name, cached")
local function classes()
    local c = M:Classes()
    expect(c.WARRIOR.treeID).toBe(WARRIOR_TREE)
    expect(c.PALADIN.treeID).toBe(PALADIN_TREE)
    expect(c.list[1].file).toBe("PALADIN")
    expect(c.list[2].file).toBe("WARRIOR")
    expect(M:Classes()).toBe(c)
end

@test("BuildTree: your class's tree from your talents, cached")
local function buildTreeOwn()
    local t = assert(M:BuildTree("WARRIOR"))
    expect(t.configID).toBe(CONFIG)
    expect(t.treeID).toBe(WARRIOR_TREE)
    expect(#t.trees).toBe(3)
    expect(t.trees[1].name).toBe("Arms")
    expect(#t.trees[1].links).toBe(1)
    expect(t.byID[12].requires).toEqual({ 11 })
    expect(t.byID[12].requiresAll).toBeNil()
    expect(t.byID[12].row).toBe(1)
    expect(t.byID[13].treeName).toBe("Arms")
    expect(t.byID[21].treeIndex).toBe(2)
    expect(t.byID[11].choice).toBe(false)
    expect(t.order).toEqual({ 11, 12, 13, 21, 22, 23, 31, 32, 33 })
    expect(M:BuildTree("WARRIOR")).toBe(t)
    expect(M:BuildTree("DRUID")).toBeNil()
end

@test("BuildTree: arrows that are required, drawn only, or across trees")
local function buildTreeEdges()
    local nodes = wt().nodes
    nodes[1].edges = { { targetNode = 12, type = Enum.TraitEdgeType.RequiredForAvailability }, { targetNode = 13, type = Enum.TraitEdgeType.VisualOnly },
        { targetNode = 21 } }
    nodes[3].choice = true
    local t = assert(M:BuildTree("WARRIOR"))
    expect(t.byID[12].requiresAll).toBe(true)
    expect(t.byID[13].requires).toEqual({})
    expect(t.byID[21].requires).toEqual({ 11 })
    expect(#t.trees[1].links).toBe(1)
    expect(t.byID[13].choice).toBe(true)
    expect(t.byID[13].entryIDs).toEqual({ 130, 131 })
end

@test("BuildTree: another class's through the view loadout, else nothing")
local function buildTreeOther()
