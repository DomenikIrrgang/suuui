    expect(p.builds.value).toBe(id)
end

@test("PlanAdd adds the next step or says why not")
local function planAdd()
    M:PlanAdd({ id = 11 })
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    M.buildView = id
    M:PlanAdd({ id = 11, entryID = 110 })
    expect(M.draft.steps).toEqual(steps(11))
    expect(M.draft.dirty).toBe(true)
    M:PlanAdd({ id = 11 })
    expect(#M.draft.steps).toBe(1)
    local msgs: string[] = {}
    mock.stub(UIErrorsFrame, "AddMessage", function(_: any, text: string) msgs[#msgs + 1] = text end)
    M:PlanAdd({ id = 12 })
    expect(msgs[1]).toBe("Arms Two needs 5 points spent before it; at step 2 only 1 is.")
    -- a choice keeps its entry
    wt().nodes[3].choice = true
    M.buildTrees = nil
    M:PlanAdd({ id = 13, entryID = 131 })
    expect(M.draft.steps[2]).toEqual({ node = 13, entry = 131 })
end

@test("PlanRemove takes a talent's last step back, if the order allows")
local function planRemove()
    M:PlanRemove({ id = 11 })
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13, 21, 23, 12)))
    M.buildView = id
    M:PlanRemove({ id = 33 })
    expect(#M.draft.steps).toBe(6)
    expect(M.draft.dirty).toBe(false)
    local asked: any = nil
    mock.stub(SuuUI.UI, "Confirm", function(def: any) asked = def end)
    M:PlanRemove({ id = 11 })
    expect(asked.title).toBe("That rank can't go")
    expect(#M.draft.steps).toBe(6)
    M:PlanRemove({ id = 13 })
    expect(asked.title).toBe("That rank can't go")
    M:PlanRemove({ id = 12 })
    expect(M.draft.steps).toEqual(steps(11, 13, 13, 21, 23))
    M:PlanRemove({ id = 13 })
    expect(M.draft.steps).toEqual(steps(11, 13, 21, 23))
    expect(M.draft.dirty).toBe(true)
end

@test("MoveLine moves a run of steps, saving at once on your active build")
local function moveLine()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13, 21)))
    M.buildView = id
    local p = fakePage(true)
    M.windowPage, M.page = p, fakePage(false)
    M:Render()
    M:MoveLine(p, 9, 1)
    -- Fury's talent to the front (planning: the draft)
    M:MoveLine(p, 3, 1)
    expect(M.draft.steps).toEqual(steps(21, 11, 13, 13))
    expect(M.draft.dirty).toBe(true)
    -- the run of 13 to the end
    M:Render()
    M:MoveLine(p, 3, 4)
    expect(M.draft.steps).toEqual(steps(21, 11, 13, 13))
    M:MoveLine(p, 3, #p.orderLines + 1)
    expect(M.draft.steps).toEqual(steps(21, 11, 13, 13))
    M:MoveLine(p, 2, #p.orderLines + 1)
    expect(M.draft.steps).toEqual(steps(21, 13, 13, 11))
    -- not allowed: 12 in front of what it needs
    M.draft = nil
    store().builds[id].steps = steps(11, 13, 13, 21, 23, 12)
    M:Render()
    local asked: any = nil
    mock.stub(SuuUI.UI, "Confirm", function(def: any) asked = def end)
    M:MoveLine(p, 5, 1)
    expect(asked.title).toBe("Arms Two can't go there")
    asked.onConfirm()
    asked.onCancel()
    expect(M.draft.steps).toEqual(steps(11, 13, 13, 21, 23, 12))
    -- your active build shown on your talents: saved at once
    M.draft = nil
    M:SetActive(id)
    M:Render()
    heard = {}
    M:MoveLine(p, 4, 1)
    expect(store().builds[id].steps).toEqual(steps(23, 11, 13, 13, 21, 12))
    expect(heard.SUUUI_TALENT_BUILD_CHANGED).toBe(1)
    -- a class that can't be read: nothing
    M.buildTrees = {}
    M.classes = nil
    mock.fake("GetClassInfo", function(): any return nil end)
    M:MoveLine(p, 1, 2)
    M.classes = nil
end

-- GameTooltip's left texts, line by line.
local function tipLines(): string[]
    local out: string[] = {}
    for i = 1, GameTooltip:NumLines() do
        local fs: any = _G["GameTooltipTextLeft" .. i] -- (Blizzard's line globals: undeclared)
        out[#out + 1] = fs:GetText() or ""
    end
    return out
end

@test("ShowPlanTip: this build's rank, its steps and levels")
local function showPlanTip()
    M:ShowPlanTip(UIParent, { name = "x" })
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13)))
    M.buildView = id
    M:Draft()
    M:ShowPlanTip(UIParent, { id = 13, name = "Arms Three", rank = 2, max = 2, entryID = 130, problem = "Full." })
    expect(GameTooltip:IsShown()).toBe(true)
    local texts = tipLines()
    expect(texts[1]).toBe("Arms Three")
    expect(texts[2]).toBe("Rank 2/2 in this build")
    expect(texts).toContain("Steps 2–3 · levels 6–7")
    expect(texts).toContain("Full.")
    expect(texts).toContain("Right-click takes its last step back")
    M:ShowPlanTip(UIParent, { id = 21, name = "Fury One", rank = 0, max = 1 })
    texts = tipLines()
    expect(texts).toContain("Click: step 4, level 8")
    M:ShowPlanTip(UIParent, { id = 11, name = "Arms One", rank = 1, max = 1 })
    texts = tipLines()
    expect(texts).toContain("Step 1 · level 5")
    GameTooltip:Hide()
end

--------------------------------------------------------------------------------
-- Using a build
--------------------------------------------------------------------------------

@test("Fit: the steps that fit your points, the talents in the way")
local function fit()
    local nodes = wt().nodes
    nodes[1].rank = 1
    nodes[4].rank = 1 -- 21: not in the build
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 23, 12, 13)))
    local data = assert(M:Collect())
    local fits, conflicts, learned = M:Fit(M:Builds()[id], data)
    -- 11 learned; 13 and 23 fit; 12 needs 5 spent in the whole tree (4
    -- then: 11, 21, 13, 23): stops, the rest after it too
    expect(fits).toEqual(steps(13, 23))
    expect(conflicts).toEqual({ { node = 21, name = "Fury One", treeName = "Fury", ranks = 1 } })
    expect(learned[11]).toBe(1)
    -- out of points
    data.available = 1
    fits = M:Fit(M:Builds()[id], data)
    expect(fits).toEqual(steps(13))
end

@test("StageFits plans the fits, after rolling back what was planned")
local function stageFits()
    local data = assert(M:Collect())
    expect(M:StageFits(steps(11, 13), data)).toBe(2)
    expect(w.staged).toEqual({ [11] = 1, [13] = 1 })
    data.staged = true
    expect(M:StageFits(steps(21), data)).toBe(1)
    expect(w.staged).toEqual({ [21] = 1 })
    w.purchaseResult = false
    expect(M:StageFits(steps(23), data)).toBe(0)
end

@test("UseBuild: what fits is planned, the build active")
local function useBuild()
    M:UseBuild("nope")
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    local dismissed: any[] = {}
    mock.stub(SuuUI, "DismissNotification", function(n: any) dismissed[#dismissed + 1] = n end)
    M:UseBuild(id)
    expect(M:ActiveID()).toBe(id)
    expect(M.buildView).toBe(id)
    expect(M.planning).toBe(false)
    expect(w.staged).toEqual({ [11] = 1, [13] = 1 })
    expect(dismissed).toEqual({ "suu:talentbuild:planned", "suu:talentbuild:reset" })
    expect(store().reset[charKey()][1]).toBeNil()
end

@test("UseBuild: not now (combat, the game) says why")
local function useBuildBlocked()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11)))
    local asked: any = nil
    mock.stub(SuuUI.UI, "Confirm", function(def: any) asked = def end)
    mock.player:enterCombat()
    M:UseBuild(id)
    expect(asked.title).toBe("Arms can't be used now")
    expect(asked.text).toBe("Talents can't change in combat.")
    mock.player:leaveCombat()
    mock.fake("C_ClassTalents.CanChangeTalents", function(): boolean return false end)
    M:UseBuild(id)
    expect(asked.text).toBe("Talents can't change right now.")
    expect(M:ActiveID()).toBeNil()
    -- no talents to read
    mock.fake("C_ClassTalents.CanChangeTalents", function(): boolean return true end)
    mock.fake("C_Traits.GetConfigInfo", function(): any return nil end)
    M:UseBuild(id)
    expect(M:ActiveID()).toBeNil()
end

@test("UseBuild with talents in the way: asked first, then a reset waits")
local function useBuildMismatch()
    wt().nodes[4].rank = 1
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13, 13)))
    local notes: any[] = {}
    mock.stub(SuuUI, "Notify", function(def: any) notes[#notes + 1] = def end)
    M:UseBuild(id)
    local p = M.mismatch
    expect(p).toBeShown()
    expect(M:ActiveID()).toBeNil()
    expect(p.use.label).toHaveText("Use, plan the 3 that fit")
    local texts: string[] = {}
    for _, l in ipairs(p.lines) do if l:IsShown() then texts[#texts + 1] = l:GetText() end end
    expect(texts).toEqual({
        "Fits now", "Arms One, rank 1 · Arms", "Arms Three, ranks 1–2 · Arms",
        "Not in this build", "Fury One, 1 rank · Fury",
        "These stay until a trainer resets your talents. Once you do, the whole build is planned for you to apply.",
    })
    mock.click(p.use)
    expect(p).never.toBeShown()
    expect(M:ActiveID()).toBe(id)
    expect(store().reset[charKey()][1]).toBe(id)
    expect(notes[1].id).toBe("suu:talentbuild:reset")
    expect(notes[1].title).toBe("Reset at a trainer to use Arms")
    expect(notes[1].body).toBe("1 talent aren't in it. Any warrior trainer can reset them.")
    -- again, nothing fits: Cancel
    wt().available = 0
    w.staged = {}
    M:UseBuild(id)
    expect(p.use.label).toHaveText("Use it")
    texts = {}
    for _, l in ipairs(p.lines) do if l:IsShown() then texts[#texts + 1] = l:GetText() end end
    expect(texts[2]).toBe("Nothing yet: the talents in the way come first.")
    mock.click(p.cancel)
    expect(p).never.toBeShown()
end

@test("NotifyReset names the cost when the trainer offered it")
local function notifyReset()
    local notes: any[] = {}
    mock.stub(SuuUI, "Notify", function(def: any) notes[#notes + 1] = def end)
    M:NotifyReset({ name = nil }, 2, 10000)
    expect(notes[1].title).toBe("Reset at a trainer to use your build")
    expect(notes[1].body).toContain("2 talents aren't in it. Any warrior trainer can reset them (")
    expect(notes[1]["until"]).toBe("Goes when you reset, or pick another build")
end

@test("CheckReset: after a trainer's reset the whole build is planned")
local function checkReset()
    local notes: any[] = {}
    local dismissed: any[] = {}
    mock.stub(SuuUI, "Notify", function(def: any) notes[#notes + 1] = def end)
    mock.stub(SuuUI, "DismissNotification", function(n: any) dismissed[#dismissed + 1] = n end)
    M:CheckReset()
    local id = assert(M:AddBuild("Arms", "WARRIOR", steps(11, 13)))
    M:SetActive(id)
    store().reset[charKey()] = { [1] = id }
    -- still a talent learned: waits
    wt().nodes[4].rank = 1
    M:CheckReset()
    expect(store().reset[charKey()][1]).toBe(id)
    -- in combat: waits
    wt().nodes[4].rank = 0
    mock.player:enterCombat()
    M:CheckReset()
    mock.player:leaveCombat()
    expect(#notes).toBe(0)
    -- planned before the reset, the reset just offered: rolled back first
    w.staged[21] = 1
    M.wipeAt = GetTime()
    M:CheckReset()
    expect(store().reset[charKey()][1]).toBeNil()
    expect(w.staged).toEqual({ [11] = 1, [13] = 1 })
    expect(dismissed).toEqual({ "suu:talentbuild:reset" })
    expect(notes[1].title).toBe("Arms is planned")
    expect(notes[1].body).toBe("2 points in its order. Nothing is learned until you apply.")
    -- its buttons
    notes[1].actions[1].onClick()
    expect(w.commits).toBe(1)
    expect(dismissed[2]).toBe("suu:talentbuild:planned")
    notes[1].actions[2].onClick()
    expect(M.window).toBeShown()
    notes[1].actions[2].onClick()
    M.window:Hide()
end

@test("CheckReset: a build no longer active stops waiting; staged changes wait")
local function checkResetStale()
    local dismissed: any[] = {}
    mock.stub(SuuUI, "DismissNotification", function(n: any) dismissed[#dismissed + 1] = n end)
    local id = assert(M:AddBuild("Arms", "WARRIOR", {}))
    store().reset[charKey()] = { [1] = id }
    M:CheckReset()
    expect(store().reset[charKey()][1]).toBeNil()
    expect(dismissed).toEqual({ "suu:talentbuild:reset" })
    store().reset[charKey()] = { [1] = "gone" }
    M:CheckReset()
    expect(store().reset[charKey()][1]).toBeNil()
    -- planned (not by the reset): waits
    M:SetActive(id)
    store().reset[charKey()] = { [1] = id }
    w.staged[21] = 1
    M:CheckReset()
    expect(store().reset[charKey()][1]).toBe(id)
    mock.fake("C_ClassTalents.GetActiveConfigID", function(): any return nil end)
    M:CheckReset()
    expect(store().reset[charKey()][1]).toBe(id)
end

