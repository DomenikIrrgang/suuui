-- Units/MicroMenu: SuuUI's micro menu: its buttons in Blizzard's order (the
-- chosen ones this client has), each opening its window (a secure click on
-- Blizzard's micro button, or SuuUI's own window), lit while it's open; the
-- alerts (talent points, spells to train, Legacy points), the bags' free
-- slots and the gear's wear; the Buttons setting (in combat after the
-- fight); a plugin's buttons; the settings and the preview; stopped.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, SECTION from "/Units/MicroMenu"
import type MenuButton from "/UI/MicroMenu"
import asFrame from "/UI/Reskin"
import expectNoErrors from "../../helpers"

local function button(key: string): MenuButton
    return assert(assert(M.menu).buttons[key])
end

local function keys(): string[]
    local out: string[] = {}
    for _, item in ipairs(M:Items()) do out[#out + 1] = item.key end
    return out
end

-- The menu's OnUpdate looks at the windows a few times a second.
local function tick()
    mock.advanceFrames(3, 100)
end

@afterEach
local function cleanup()
    if InCombatLockdown() then mock.player:leaveCombat() end
    M:ResetAll({ "buttons", "shows", "bagCount", "seenPluginButtons" })
    for _, name in ipairs({ "CharacterFrame", "WorldMapFrame", "GameMenuFrame" }) do
        local f = asFrame(_G[name])
        if f and f:IsShown() then HideUIPanel(f) end
    end
    mock.advanceFrames(2)
    expectNoErrors()
end

@test("its buttons in Blizzard's order, the game menu last; Blizzard's micro menu out of sight")
local function order()
    local list = keys()
    expect(list[#list]).toBe("menu")
    expect(list[1]).toBe("character")
    for _, k in ipairs(list) do expect(button(k)).toBeShown() end
    -- the shop isn't chosen by default
    expect(assert(M.menu).buttons.shop).toBeNil()
    expect(M.blizzardHidden).toBe(true)
    -- in a row, left to right
    local _, _, _, x1 = button(list[1]):GetPoint(1)
    local _, _, _, x2 = button(list[2]):GetPoint(1)
    expect(x2 > x1).toBe(true)
end

@test("Character: a secure click on Blizzard's button opens its window; the button lit while it's open")
local function character()
    local b = button("character")
    expect(b:GetAttribute("clickbutton")).toBe(CharacterMicroButton)
    mock.click(b)
    mock.advanceFrames(2)
    expect(CharacterFrame:IsShown()).toBe(true)
    tick()
    expect(b.active).toBe(true)
    HideUIPanel(CharacterFrame)
    -- (Blizzard's button stays pushed a moment; the menu looks again)
    CharacterMicroButton:SetButtonState("NORMAL")
    tick()
    expect(b.active).toBe(false)
end

@test("the world map, the bags and the game menu: SuuUI's own buttons, lit while open")
local function ownButtons()
    mock.click(button("worldmap"))
    mock.advanceFrames(2)
    expect(WorldMapFrame:IsShown()).toBe(true)
    tick()
    expect(button("worldmap").active).toBe(true)
    HideUIPanel(WorldMapFrame)
    local bags = mock.spy(function() end)
    mock.stub(SuuUI, "ToggleBags", bags)
    mock.click(button("bags"))
    expect(bags).toHaveBeenCalled()
    mock.click(button("menu"))
    mock.advanceFrames(2)
    expect(GameMenuFrame:IsShown()).toBe(true)
    tick()
    expect(button("menu").active).toBe(true)
    HideUIPanel(GameMenuFrame)
    tick()
    expect(button("menu").active).toBe(false)
end

@test("the bags' state: SuuUI's bags, else Blizzard's combined or single bags")
local function bagsOpen()
    local open: (() -> boolean)? = nil
    for _, it in ipairs(M:Items()) do if it.key == "bags" then open = it.open end end
    local own = CreateFrame("Frame", "SuuUIBags", UIParent)
    own:Show()
    expect(assert(open)()).toBe(true)
    own:Hide()
    expect(assert(open)()).toBe(false)
    mock.setField(_G, "SuuUIBags", nil)
    expect(assert(open)()).toBe(false)
    local single = asFrame(_G.ContainerFrame1)
    if single then
        single:Show()
        expect(assert(open)()).toBe(true)
        single:Hide()
    end
end

@test("alerts: talent points, spells to train with their cost, Legacy points")
local function alerts()
    mock.stub(C_ClassTalents, "HasUnspentTalentPoints", function(): boolean return true end)
    M:UpdateAlerts()
    expect(button("talents").alertText).toBe("Talent points to spend")
    M:Emit("SUUUI_SPELLS_TO_TRAIN", 3, 12345)
    expect(button("spellbook").alertText).toBe("3 spells to train at your class trainer · 1g 23s 45c")
    M:Emit("SUUUI_SPELLS_TO_TRAIN", 1)
    expect(button("spellbook").alertText).toBe("1 spell to train at your class trainer")
    M:Emit("SUUUI_SPELLS_TO_TRAIN", 2, 50)
    expect(button("spellbook").alertText).toBe("2 spells to train at your class trainer · 50c")
    M:Emit("SUUUI_SPELLS_TO_TRAIN", 0)
    expect(button("spellbook").alertText).toBeNil()
    mock.stub(C_Traits, "GetConfigIDByTreeID", function(_: number): number return 7143863 end)
    mock.stub(C_Traits, "GetTreeCurrencyInfo", function(_: number, _: number, _: boolean): unknown return { { quantity = 2 } } end)
    M:UpdateAlerts()
    expect(button("legacy").alertText).toBe("2 Legacy points to spend")
    mock.stub(C_Traits, "GetTreeCurrencyInfo", function(_: number, _: number, _: boolean): unknown return { { quantity = 1 } } end)
    M:UpdateAlerts()
    expect(button("legacy").alertText).toBe("1 Legacy point to spend")
    -- unreadable: none
    mock.stub(C_Traits, "GetTreeCurrencyInfo", function(_: number, _: number, _: boolean): unknown return { { quantity = mock.secret(3) } } end)
    mock.stub(C_ClassTalents, "HasUnspentTalentPoints", function(): unknown return mock.secret(true) end)
    M:UpdateAlerts()
    expect(button("legacy").alertText).toBeNil()
    expect(button("talents").alertText).toBeNil()
end

@test("the bags' free slots on the Bags button: ember at none; off by the setting")
local function bagCount()
    mock.stub(C_Container, "GetContainerNumFreeSlots", function(bag: number): number return bag == 0 and 5 or 2 end)
    mock.fireEvent("BAG_UPDATE_DELAYED")
    local b = button("bags")
    expect(b.badge:IsShown()).toBe(true)
    expect(b.count:GetText()).toBe("13")
    mock.stub(C_Container, "GetContainerNumFreeSlots", function(_: number): number return 0 end)
    mock.fireEvent("BAG_UPDATE_DELAYED")
    expect(b.count:GetText()).toBe("0")
    M:Set("bagCount", false)
    expect(b.badge:IsShown()).toBe(false)
end

@test("the gear's wear on the Character button: the lowest piece's percent, ember once one breaks, the pieces in its tooltip")
local function durability()
    mock.stub(SuuUI, "Durability", function(): unknown
        return { state = "damaged", parts = { character = true }, lowest = { percent = 15 }, headline = "Badly damaged",
                 lines = { { "Legs", "15%" } } }
    end)
    M:UpdateDurability()
    local b = button("character")
    expect(b.count:GetText()).toBe("15%")
    expect(#assert(b.lines)).toBe(2)
    mock.stub(SuuUI, "Durability", function(): unknown
        return { state = "broken", parts = { character = true }, lowest = { percent = 0 }, headline = "Broken", lines = {} }
    end)
    M:Emit("SUUUI_DURABILITY_CHANGED")
    expect(b.count:GetText()).toBe("0%")
    -- fine, or the module off: nothing
    mock.stub(SuuUI, "Durability", function(): unknown return nil end)
    M:Emit("SUUUI_SERVICE_CHANGED", "durability")
    expect(b.badge:IsShown()).toBe(false)
    expect(b.lines).toBeNil()
end

@test("the Buttons setting: only the chosen; changed in a fight, laid out when it ends")
local function chosen()
    M:Set("buttons", { "character", "menu" })
    expect(keys()).toEqual({ "character", "menu" })
    expect(button("spellbook")).never.toBeShown()
    mock.player:enterCombat()
    mock.advanceFrames(1)
    M:Set("buttons", { "character", "spellbook", "menu" })
    expect(M.pendingLayout).toBe(true)
    expect(button("spellbook")).never.toBeShown()
    mock.player:leaveCombat()
    expect(M.pendingLayout).toBeNil()
    expect(button("spellbook")).toBeShown()
end

@test("a plugin's button: shown the first time, before the game menu; one you hid stays hidden; a built-in key ignored")
local function plugins()
    local clicked = mock.spy(function() end)
    local plugin = M
    plugin:AddMicroItem({ key = "planner", glyph = "map", label = "Planner", onClick = clicked })
    plugin:AddMicroItem({ key = "bags", glyph = "bag", label = "Other bags", onClick = function() end })
    local list = keys()
    expect(list[#list]).toBe("menu")
    expect(list[#list - 1]).toBe("planner")
    mock.click(button("planner"))
    expect(clicked).toHaveBeenCalled()
    -- hidden by you: stays hidden when plugins change again
    local without = {}
    for _, k in ipairs(M:Get("buttons")) do if k ~= "planner" then without[#without + 1] = k end end
    M:Set("buttons", without)
    plugin:AddMicroItem({ key = "planner2", glyph = "map", label = "Second", onClick = function() end })
    list = keys()
    local has = {}
    for _, k in ipairs(list) do has[k] = true end
    expect(has.planner).toBeNil()
    expect(has.planner2).toBe(true)
    -- in the settings' chips
    local row = SECTION.groups[1].rows[1]
    local chips: unknown = row.build(CreateFrame("Frame", nil, UIParent), function(_: string[]) end)
    expect(chips ~= nil).toBe(true)
end

@test("SuuUI's own Talents and Collections windows when those modules are on")
local function ownWindows()
    local talents = SuuUI.GetModule("talents")
    local collections = SuuUI.GetModule("collections")
    for _, it in ipairs(M:Items()) do
        if it.key == "talents" and talents and talents:Get("enabled") then
            expect(it.click).toBeNil()
            local toggled = mock.spy(function() end)
            mock.stub(SuuUI, "ToggleTalents", toggled)
            assert(it.onClick)()
            expect(toggled).toHaveBeenCalled()
            expect(type(assert(it.open)())).toBe("boolean")
        end
        if it.key == "collections" and collections and collections:Get("enabled") then
            expect(it.click).toBeNil()
            local toggled = mock.spy(function() end)
            mock.stub(SuuUI, "ToggleCollections", toggled)
            assert(it.onClick)()
            expect(toggled).toHaveBeenCalled()
            local _ = assert(it.open)()
        end
    end
end

@test("the settings' preview: the chosen buttons with an alert; Shows")
local function preview()
    local parent = CreateFrame("Frame", nil, UIParent)
    local view = M:PreviewView(parent)
    expect(view:GetParent()).toBe(parent)
    expect(assert(view.buttons.talents).alertText).toBe("Talent points to spend")
    M:Set("buttons", { "character", "menu" })
    view:Show()
    expect(assert(view.buttons.spellbook):IsShown()).toBe(false)
    M:Set("shows", "combat")
end

-- (last: the module off)
@test("stopped: hidden, its anchor withdrawn")
local function disabled()
    M:OnDisable()
    expect(M.menu).never.toBeShown()
end
