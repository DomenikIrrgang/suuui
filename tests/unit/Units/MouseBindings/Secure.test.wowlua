-- Units/MouseBindings/Secure: the attributes a binding's spells need, over
-- whom a key casts, and the restricted snippet that sets the bindings.

import test, expect, afterEach from "wowlua:test"
import castAttributes, refreshSnippet, whenOf, vbutton, MOUSEOVER_STATE from "/Units/MouseBindings/Secure"
import expectNoErrors from "../../../helpers"

@afterEach
local function noErrors()
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The secure part
--------------------------------------------------------------------------------

@test("the attributes of a binding: for anyone, or a friend's and an enemy's spell apart")
local function attributes()
    local a = castAttributes("*", "-mb1", 1, 78, nil, nil)
    expect(a).toEqual({ { "*type-mb1", "spell" }, { "*spell-mb1", 78 } })
    local b = castAttributes("shift-", "1", 2, nil, 10, 20)
    expect(b).toEqual({
        -- (the click's own type no action: not the frame's wildcard target)
        { "shift-type1", "" },
        { "shift-helpbutton1", "mb2h" },
        { "*type-mb2h", "spell" },
        { "*spell-mb2h", 10 },
        { "shift-harmbutton1", "mb2x" },
        { "*type-mb2x", "spell" },
        { "*spell-mb2x", 20 },
    })
    local s = refreshSnippet({ { input = "SHIFT-F", button = "mb1", when = "any" } }, {
        { input = "ALT-Q", button = "mb2", when = "help" },
    })
    expect(
        s:find('self:SetBindingClick(true, "SHIFT-F", self:GetFrameRef("frameButton"), "mb1")', 1, true) ~= nil
    ).toBe(true)
    -- a friend's spell alone: bound over friends only
    expect(
        s:find(
            'if r == "help" then self:SetBindingClick(true, "ALT-Q", self:GetFrameRef("worldButton"), "mb2") end',
            1,
            true
        ) ~=
            nil
    ).toBe(true)
end

@test("an input's virtual button, over whom its spells cast, and the mouseover state's condition")
local function names()
    expect(vbutton(3)).toBe("mb3")
    expect(whenOf(true, true, true)).toBe("any")
    expect(whenOf(false, true, true)).toBe("both")
    expect(whenOf(false, true, false)).toBe("help")
    expect(whenOf(false, false, true)).toBe("harm")
    expect(MOUSEOVER_STATE).toBe("[@mouseover,help] help; [@mouseover,harm] harm; [@mouseover,exists] other; off")
end
