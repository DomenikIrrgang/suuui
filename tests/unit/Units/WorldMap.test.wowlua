-- Units/WorldMap: the world map's pins as a whole: the first open (the
-- data built first), at the flight master, what changes the pins, the
-- settings' preview, Skyborne's group in Map filters, turned off and on,
-- Map filters' place in the header, and the real data.
--
-- The map is Blizzard's on the engine; SuuUI's generated quest and place
-- data (SuuUI.QuestStarts, SuuUI.MapPlaces) are small stand-ins here
-- (WorldMap/WorldMapHelpers), so each kind of pin is known exactly; one
-- test reads the real data.

import test, expect, afterEach, beforeEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as windowSkin from "/UI/WindowSkin"
import WindowChrome from "/UI/WindowSkin"
import type PinsPreview from "/Units/WorldMap"
import SuuUI from "/Core/API"
import internal M, SECTION from "/Units/WorldMap"
import * as lazyData from "/Core/Data"
import internal M as conv from "/Units/Convergences"
import internal M as flightMap from "/Units/FlightMap"
import expectNoErrors, holdings, cycle, NOTHING from "../../helpers"
import * as world from "./WorldMap/WorldMapHelpers"
import ELWYNN, realStarts, realPlaces, collect, openMap from "./WorldMap/WorldMapHelpers"
import * as modules from "/Core/Modules"
import type Border from "/UI/Draw"
import * as pixel from "/Core/Pixel"

@beforeEach
local function data()
    world.setup()
end

@afterEach
local function cleanup()
    world.cleanup()
end

@test("the first open: the quest and place pins once their data is built, the others at once")
local function dataFirst()
    local ready = false
    local function isReady(): boolean
        return ready
    end
    mock.stub(lazyData.questStarts, "Ready", isReady)
    mock.stub(lazyData.mapPlaces, "Ready", isReady)
    mock.stub(lazyData.mapOverlays, "Ready", isReady)
    local prepared = mock.spy()
    mock.stub(M, "PrepareData", prepared)
    WorldMapFrame:Show()
    mock.advanceFrames(2)
    M:Refresh()
    expect(prepared).toHaveBeenCalled()
    expect(collect()["Wolves Across the Border"]).toBeNil()
    -- built: its pins
    ready = true
    expect(collect()["Wolves Across the Border"] ~= nil).toBe(true)
    expectNoErrors()
end

@test("at the flight master the flight map's pins only: Map filters away")
local function atFlightMaster()
    openMap()
    mock.stub(flightMap, "AtMaster", function(): boolean
        return true
    end)
    M:Refresh()
    expect(M.menu).never.toBeShown()
    expect(#M.pins).toBe(0)
end

@test("what changes the pins: quests taken, marks, themes, the calendar")
local function refreshes()
    openMap()
    local refresh = mock.spy(function(_: unknown) end)
    mock.stub(M, "Refresh", refresh)
    mock.fireEvent("QUEST_ACCEPTED", 1)
    mock.advanceTime(0.3)
    expect(refresh).toHaveBeenCalledTimes(1)
    M:Emit("SUUUI_MARKS_CHANGED")
    M:Emit("SUUUI_CONVERGENCES_CHANGED")
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    expect(refresh).toHaveBeenCalledTimes(4)
    mock.fireEvent("CALENDAR_UPDATE_EVENT_LIST")
    expect(refresh).toHaveBeenCalledTimes(5)
end

@test("the settings' preview: the pins at the setting's opacity")
local function preview()
    local parent = CreateFrame("Frame", nil, UIParent)
    local view = assert(SECTION.preview)(parent) :: PinsPreview
    expect(#view.pins).toBe(4)
    M:Set("pinAlpha", 40)
    expect(view.pins[1]:GetAlpha()).toBeCloseTo(0.4)
end

@test("Skyborne's group in Map filters once the map shows for a Skyborne")
local function skyborneMenu()
    mock.stub(conv, "Shown", function(): boolean
        return true
    end)
    openMap()
    expect(M.skyborneMenu).toBe(true)
end

@test("turned off: no pins, the game's filter button back, nothing held; on again, all back, nothing doubled")
local function offAndOn()
    openMap()
    -- a layout waiting as it turns off: its timer goes with the module
    M:QueueLayout()
    M:Set("enabled", false)
    expect(#M.pins).toBe(0)
    expect(M.menu).never.toBeShown()
    expect(holdings(M)).toEqual(NOTHING)
    expect(M.layoutQueued).toBe(false)
    local track = frames.asFrame(tbl.field(WorldMapFrame, "WorldMapTrackingOptionsButton"))
    if track then
        expect(track:GetAlpha()).toBe(1)
    end
    M:Reset("enabled")
    expect(M.menu).toBeShown()
    -- laid out again on the next change
    local layout = mock.stub(M, "Layout", M.Layout)
    M:QueueLayout()
    mock.advanceFrames(1)
    expect(layout).toHaveBeenCalled()
    local c = cycle("worldmap")
    expect(c.stateOff).toBe(modules.ModuleState.Disabled)
    expect(c.off).toEqual(NOTHING)
    expect(c.after).toEqual(c.before)
    expect(c.stateOn).toBe(modules.ModuleState.Enabled)
    expectNoErrors()
end

@test("turned off and on again: one quest log hook, which does nothing while off")
local function oneLogHook()
    local update = rawget(_G, "QuestLogQuests_Update") :: unknown
    expect(type(update)).toBe("function")
    local styled = 0
    mock.stub(M, "StyleLogQuestPins", function(_: unknown)
        styled += 1
    end)
    for _ = 1, 3 do
        M:Set("enabled", false)
        M:Reset("enabled")
    end
    M:Set("enabled", false)
    local before = styled
    ;(update :: () -> ())()
    expect(styled).toBe(before)
    M:Reset("enabled")
    before = styled
    ;(update :: () -> ())()
    expect(styled).toBe(before + 1)
    expectNoErrors()
end

-- A border's four lines, each in physical pixels.
local function edgePixels(b: Border): number[]
    local out: number[] = {}
    for i, t in ipairs({ b.top, b.bottom }) do
        out[i] = t:GetHeight() * t:GetEffectiveScale() / pixel.perfectScale()
    end
    for _, t in ipairs({ b.left, b.right }) do
        out[#out + 1] = t:GetWidth() * t:GetEffectiveScale() / pixel.perfectScale()
    end
    return out
end

@test("Map filters in the scaled map's header: its edge one physical pixel on every side")
local function filtersEdge()
    -- (made under the map, at its scale; the header is at the usual one: its
    -- right edge came out under a pixel and vanished, a player's report
    -- 2026-11-14, any theme)
    openMap()
    local chrome = assert(windowSkin.chromeOf(WorldMapFrame), "no chrome")
    local menu = assert(M.menu, "no menu")
    expect(menu:GetParent()).toBe(chrome.head)
    expect(WorldMapFrame:GetEffectiveScale()).never.toBeCloseTo(chrome.head:GetEffectiveScale())
    for _, w in ipairs(edgePixels(menu.edge)) do
        expect(w).toBeCloseTo(1)
    end
    -- the map at another size: the header scaled again, the edge still one pixel
    chrome:SetBody(nil, 1)
    for _, w in ipairs(edgePixels(menu.edge)) do
        expect(w).toBeCloseTo(1)
    end
end

@test("Map filters over the map's top left without SuuUI's window skin")
local function filtersPlaced()
    openMap()
    mock.stub(SuuUI.UI, "WindowChrome", function(_: Frame?): WindowChrome?
        return nil
    end)
    M:PlaceFilters()
    local menu = M.menu
    assert(menu, "no menu")
    expect(menu:GetParent()).toBe(WorldMapFrame)
    local _, rel = menu:GetPoint(1)
    expect(rel == frames.asFrame(WorldMapFrame:GetCanvasContainer())).toBe(true)
end

@test("the real data: a new Human warrior's Elwynn Forest has quests to pick up, an innkeeper, mailboxes")
local function realData()
    mock.stub(SuuUI, "QuestStarts", realStarts)
    mock.stub(SuuUI, "MapPlaces", realPlaces)
    local kinds: { [string]: number } = {}
    for _, it in ipairs(M:Collect(ELWYNN)) do
        local k = it.key or it.kindName or "?"
        kinds[k] = (kinds[k] or 0) + 1
    end
    expect((kinds.available or 0) > 0).toBe(true)
    expect((kinds.inn or 0) > 0).toBe(true)
    expect((kinds.mail or 0) > 0).toBe(true)
    openMap()
    expect(#M.pins > 0).toBe(true)
end
