@test("turned off: no pins, the game's filter button back; on again")
local function offAndOn()
    openMap()
    M:Set("enabled", false)
    expect(#M.pins).toBe(0)
    expect(M.menu).never.toBeShown()
    M:Reset("enabled")
    expect(M.menu).toBeShown()
end

@test("two givers on one spot: one pin, its best quest's look")
local function crowded()
    crowd = true
    openMap()
    local pin = pinOf("Wolves Across the Border")
    expect(pin.group.distinct).toBe(2)
    expect(pin.countTab).toBeShown()
    crowd = false
end

-- A quest pin as the game's quest data provider makes one: its style, its
-- quest, tracked or not, its highlight.
local function gamePin(style: number, opts: { [string]: any }?): any
    local o = opts or {}
    local pin: any = CreateFrame("Button", nil, M.layer)
    pin:SetSize(20, 20)
    pin.questID = o.questID or 9005
    pin.HighlightTexture = pin:CreateTexture()
    pin.HighlightTexture:SetShown(o.lit == true)
    pin.NormalTexture = pin:CreateTexture()
    function pin:GetStyle(): number return style end
    function pin:IsSelected(): boolean return o.tracked == true end
    function pin:SetStyle(s: number) style = s end
    return pin
end

@test("the game's quest pins' looks: in progress, to turn in (a group's with its bar), a waypoint, disabled, tracked")
local function questLooks()
    openMap()
    local styles = POIButtonUtil.Style
    local progress = gamePin(styles.QuestInProgress)
    M:StyleQuestPin(progress)
    expect(progress.suuQuest).toBeShown()
    expect(progress.NormalTexture:GetAlpha()).toBe(0)
    expect(progress.suuQuest.glow).never.toBeShown()
    local turnIn = gamePin(styles.QuestComplete)
    M:StyleQuestPin(turnIn)
    expect(turnIn.suuQuest.glow).toBeShown()
    local waypoint = gamePin(styles.Waypoint, { lit = true })
    M:StyleQuestPin(waypoint)
    expect(waypoint.suuQuest.pin.hl).toBeShown()
    local tracked = gamePin(styles.QuestInProgress, { tracked = true })
    M:StyleQuestPin(tracked)
    expect(tracked.suuQuest.glow).toBeShown()
    -- the game's own style changes: ours follows
    tracked:SetStyle(styles.QuestDisabled)
    expect(tracked.suuQuest).never.toBeShown()
    tracked:SetStyle(99)
    expect(tracked.suuQuest).never.toBeShown()
    -- hovered: a tenth larger
    mock.hover(progress)
    expect(progress.suuQuest.hovered).toBe(true)
    mock.hover(nil)
    expect(progress.suuQuest.hovered).toBe(false)
end

@test("the cities' little houses hidden on the map")
local function townPins()
    openMap()
    local hidden = mock.spy(function(_: any) end)
    local house = { poiInfo = { name = "Stormwind" }, Hide = hidden }
    local camp = { poiInfo = { atlasName = "poi-town" }, Hide = hidden }
    mock.stub(G.WorldMapFrame, "EnumeratePinsByTemplate", function(_: any, template: string): any
        local list = template == "AreaPOIPinTemplate" and { house, camp } or {}
        local i = 0
        return function() i = i + 1; return list[i] end
    end)
    M:HideTownPins()
    expect(hidden).toHaveBeenCalledTimes(1)
end

@test("Map filters over the map's top left without SuuUI's window skin")
local function filtersPlaced()
    openMap()
    mock.setField(G.WorldMapFrame, "suuChrome", nil)
    M:PlaceFilters()
    expect(M.menu:GetParent()).toBe(G.WorldMapFrame)
    local _, rel = M.menu:GetPoint(1)
    expect(rel).toBe(G.WorldMapFrame:GetCanvasContainer())
end

@test("the real data: a new Human warrior's Elwynn Forest has quests to pick up, an innkeeper, mailboxes")
local function realData()
    mock.stub(SuuUI, "QuestStarts", realStarts)
    mock.stub(SuuUI, "MapPlaces", realPlaces)
    local kinds: { [string]: number } = {}
    for _, it in ipairs(M:Collect(ELWYNN)) do
        local k = it.key or it.kindName or "?"
        kinds[k] = (kinds[k] or 0) + 1
    end
    expect((kinds.available or 0) > 0).toBe(true)
    expect((kinds.inn or 0) > 0).toBe(true)
    expect((kinds.mail or 0) > 0).toBe(true)
    openMap()
    expect(#M.pins > 0).toBe(true)
end
