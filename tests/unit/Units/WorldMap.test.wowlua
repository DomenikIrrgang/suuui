-- A quest pin as the game's quest data provider makes one: its style, its
-- quest, tracked or not, its highlight.
class GamePin extends Button
    questID: number
    readonly HighlightTexture: Texture
    readonly NormalTexture: Texture
    shownStyle: number
    tracked: boolean

    constructor(parent: Frame, style: number, opts: { questID?: number, lit?: boolean, tracked?: boolean }?)
        super(nil, parent)
        local o = opts or {}
        self:SetSize(20, 20)
        self.shownStyle = style
        self.tracked = o.tracked == true
        self.questID = o.questID or 9005
        self.HighlightTexture = self:CreateTexture()
        self.HighlightTexture:SetShown(o.lit == true)
        self.NormalTexture = self:CreateTexture()
    end

    function GetStyle(): number
        return self.shownStyle
    end
    function IsSelected(): boolean
        return self.tracked
    end
    function SetStyle(s: number)
        self.shownStyle = s
    end
end

-- One of the game's quest pin styles.
local function style(name: string): number
    return secret.asNumber(tbl.field(_G, "POIButtonUtil", "Style", name)) or -1
end

local function gamePin(name: string, opts: { questID?: number, lit?: boolean, tracked?: boolean }?): GamePin
    local layer = M.layer
    assert(layer, "no layer")
    return GamePin.new(layer, style(name), opts)
end

-- SuuUI's look in a game pin.
local function lookOf(p: Frame)
    local look = M.looks[p]
    assert(look, "not styled")
    return look
end

@test("the game's quest pins' looks: in progress, to turn in (a group's with its bar), a waypoint, disabled, tracked")
local function questLooks()
    openMap()
    local progress = gamePin("QuestInProgress")
    M:StyleQuestPin(progress)
    expect(lookOf(progress)).toBeShown()
    expect(progress.NormalTexture:GetAlpha()).toBe(0)
    expect(lookOf(progress).glow).never.toBeShown()
    -- the same look again (the game restyles often): nothing drawn again
    local data = mock.stub(lookOf(progress).pin, "SetData")
    M:StyleQuestPin(progress)
    expect(data).toHaveBeenCalledTimes(0)
    local turnIn = gamePin("QuestComplete")
    M:StyleQuestPin(turnIn)
    expect(lookOf(turnIn).glow).toBeShown()
    local waypoint = gamePin("Waypoint", { lit = true })
    M:StyleQuestPin(waypoint)
    expect(lookOf(waypoint).pin.hl).toBeShown()
    local tracked = gamePin("QuestInProgress", { tracked = true })
    M:StyleQuestPin(tracked)
    expect(lookOf(tracked).glow).toBeShown()
    -- the game's own style changes: ours follows
    tracked:SetStyle(style("QuestDisabled"))
    expect(lookOf(tracked)).never.toBeShown()
    tracked:SetStyle(99)
    expect(lookOf(tracked)).never.toBeShown()
    -- hovered: a tenth larger
    mock.hover(progress)
    expect(lookOf(progress).hovered).toBe(true)
    mock.hover(nil)
    expect(lookOf(progress).hovered).toBe(false)
end

