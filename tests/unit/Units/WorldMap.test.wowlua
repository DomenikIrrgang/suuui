-- Units/WorldMap: the world map's pins (quests to pick up, quests from
-- items, entrances, flight masters, campfires, services, trainers,
-- mailboxes, rares, treasures, marks, convergences), its Map filters (the
-- game's quest settings among them, earlier layouts carried over), the
-- pins on the canvas (merged, hovered, clicked), the game's quest pins in
-- SuuUI's look, the unexplored areas, the settings.
--
-- The map is Blizzard's on the engine; SuuUI's generated quest and place
-- data (SuuUI.QuestStarts, SuuUI.MapPlaces) are small stand-ins here, so
-- each kind of pin is known exactly; one test reads the real data.

import test, expect, afterEach, beforeEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as secret from "wowlua:secret"
import * as windowSkin from "/UI/WindowSkin"
import WindowChrome from "/UI/WindowSkin"
import type PinsPreview from "/Units/WorldMap"
import SuuUI from "/Core/API"
import type QuestStarts from "/Data/QuestStarts"
import type MapPlaces from "/Data/MapPlaces"
import internal M, SECTION from "/Units/WorldMap"
import internal M as marks from "/Units/Marks"
import internal M as conv from "/Units/Convergences"
import internal M as campsite from "/Units/Campsite"
import internal M as flightMap from "/Units/FlightMap"
import type Item, Group, TipLine from "/Units/WorldMap/Arrange"
import expectNoErrors from "../../helpers"

local ELWYNN = 1429

-- SuuUI's quest data, small: a giver with two quests (one a group's), a
-- repeatable one, one far above you; a quest from an item two mobs drop;
-- three entrances (one the Horde's); a walking giver.
-- (`patrol`: a giver whose quest's group tag the game tells late)
local patrol = false
-- (`crowd`: a second giver beside the first)
local crowd = false
local function giverRows(): number[][]
    local rows: number[][] = { { 50, 50, 101, 9001, 9005 }, { 51.5, 50, 102, 9002 }, { 80, 80, 103, 9004 } }
    if patrol then rows[#rows + 1] = { 20, 80, 105, 9007 } end
    if crowd then rows[#rows + 1] = { 50.3, 50.2, 106, 9008 } end
    return rows
end
local function starts(): QuestStarts
    return {
        quests = {
            [9001] = { "Wolves Across the Border", 1, 2 },
            [9002] = { "Boar Hides", 1, 1, nil, nil, nil, nil, nil, nil, 1 },
            [9003] = { "A Torn Scroll", 1, 1 },
            [9004] = { "The Fallen Hero", 1, 30 },
            [9005] = { "The Kobold Lord", 1, 2 },
            [9007] = { "Elite Patrol", 1, 2 },
            [9008] = { "The Lost Necklace", 1, 1 },
        },
        objectives = { [9001] = "Kill 8 wolves for $N." },
        tags = { [9005] = 81 },
        group = { [9005] = "dungeon", [9007] = "elite" },
        maps = { [ELWYNN] = giverRows() },
        drops = { [ELWYNN] = { { 30, 30, 104, 7001, 9003 }, { 35, 30, -5, 7001, 9003 } } },
        items = { [7001] = "A Torn Scroll" },
        givers = { [101] = "Marshal Dughan", [102] = "Farmer Saldean", [103] = "A Guard", [104] = "Kobold Worker", [105] = "Sergeant Willem", [106] = "Farmer Furlbrow", [-5] = "Old Crate" },
        entrances = { [ELWYNN] = {
            { 40, 40, "The Deadmines", "dungeon" },
            { 41, 40, "Ragefire Chasm", "dungeon", "H" },
            { 60, 62, "Warsong Gulch", "battleground", nil, true },
        } },
        routes = { [101] = { [ELWYNN] = { { 50, 50, 55, 55, 60, 50 } } } },
    }
end

-- SuuUI's place data, small: an innkeeper who repairs, a smith, your class
-- trainer and another class's, a weapon master, an herbalist, the Horde's
-- innkeeper, a Winter Veil vendor, a walking vendor, a banker, mailboxes,
-- a rare elite at two spots, a walking rare, a chest.
local function places(): MapPlaces
    return {
        npcs = {
            [201] = { "Innkeeper Farley", "Innkeeper", "A", "inn,repair" },
            [202] = { "Smith Argus", "Weaponsmith", "A", "repair,vendor" },
            [203] = { "Lyria Du Lac", "Warrior Trainer", "A", "class:WARRIOR" },
            [204] = { "Khelden Bremen", "Mage Trainer", "A", "class:MAGE,inn" },
            [11867] = { "Woo Ping", "Weapon Master", "A", "trainer:weapon" },
            [206] = { "Herbalist Pomeroy", "Herbalism Trainer", "A", "trainer:herbalism" },
            [207] = { "Innkeeper Grosk", "Innkeeper", "H", "inn" },
            [208] = { "Winter Vendor", "Holiday Goods", "A", "vendor", nil, nil, nil, "winterVeil" },
            [209] = { "Hogger", nil, nil, nil, "rareElite", 11, 11 },
            [210] = { "Mother Fang", nil, nil, nil, "rare", 10, 12 },
            [211] = { "Wandering Peddler", "General Goods", "A", "goods" },
            [212] = { "Banker Marion", "Banker", "A", "bank" },
        },
        services = { [ELWYNN] = {
            42, 65, 201, 43, 65, 202, 44, 65, 203, 45, 65, 204, 20, 20, 11867, 21, 21, 206,
            46, 65, 207, 47, 65, 208, 60, 20, 211, 48, 65, 212,
        } },
        mailboxes = { [ELWYNN] = { 42, 66, 42.5, 66.2 } },
        rares = { [ELWYNN] = { 70, 70, 209, 71, 71, 209, 75, 20, 210 } },
        treasures = { [ELWYNN] = { 65, 35, "Mossy Chest" } },
        routes = { [211] = { [ELWYNN] = { { 60, 20, 62, 22 } } }, [210] = { [ELWYNN] = { { 75, 20, 76, 21 } } } },
    }
end

-- Map filters' choice: each group's values on.
type Choice = { [string]: string[] }

-- Every filter on.
local function all(): Choice
    return {
        quests = { "objectives", "levels", "colours", "available", "repeatable", "items", "trivial" },
        places = { "unexplored", "dungeons", "battlegrounds", "flight", "campfires" },
        services = { "inn", "repair", "goods", "food", "vendor", "stable", "battlemaster", "guild", "tabard", "spirit" },
        trading = { "auction", "mail", "bank" },
        trainers = { "class", "professions", "weapon", "riding" },
        rares = { "rares", "treasures" },
        marks = { "yours", "shared" },
    }
end

local function copy(c: Choice): Choice
    local out: Choice = {}
    for k, list in pairs(c) do
        local l: string[] = {}
        for i, v in ipairs(list) do l[i] = v end
        out[k] = l
    end
    return out
end

-- (the real data, for the one test that reads it)
local realStarts, realPlaces = SuuUI.QuestStarts, SuuUI.MapPlaces

@beforeEach
local function data()
    mock.stub(SuuUI, "QuestStarts", starts)
    mock.stub(SuuUI, "MapPlaces", places)
end

@afterEach
local function cleanup()
    mock.hover(nil)
    if WorldMapFrame:IsShown() then WorldMapFrame:Hide() end
    M:Reset("filters")
    M:Reset("pinAlpha")
    M:Char().taxi = nil
    mock.advanceTime(7)
    expectNoErrors()
end

-- The pins a map would show, by name.
local function collect(mapID: number?): { [string]: Item }
    local out: { [string]: Item } = {}
    for _, it in ipairs(M:Collect(mapID or ELWYNN)) do out[it.name] = it end
    return out
end

-- A pin's line under its card.
local function line(it: Item?, i: number): TipLine
    assert(it, "no pin")
    local more = it.more
    assert(more, "no lines")
    local l = more[i]
    assert(l, "no line " .. i)
    return l
end

-- The text of a pin's line.
local function text(it: Item?, i: number): string
    return line(it, i)[1] or ""
end

local function pin(it: Item?): Item
    assert(it, "no pin")
    return it
end

--------------------------------------------------------------------------------
-- Map filters
--------------------------------------------------------------------------------

@test("the filters: the defaults, each group's own")
local function defaults()
    local on = M:Layers()
    expect(on.quests.available).toBe(true)
    expect(on.places.flight).toBe(true)
    expect(on.services.inn).toBe(true)
    expect(on.services.repair).toBeNil()
    expect(on.trading.mail).toBe(true)
    expect(on.trainers.class).toBe(true)
    expect(M:MarksShown()).toEqual({ yours = true, shared = true })
end

@test("an earlier layout's choices carried over: mailboxes and trainers moved, new options on once")
local function carriedOver()
    M:Set("filters", { services = { "inn", "classTrainer", "trainers", "mail" }, quests = { "available" } })
    local saved = M:Saved()
    expect(saved.services).toEqual({ "inn" })
    expect(saved.trainers).toEqual({ "class", "professions" })
    expect(saved.trading).toEqual({ "mail" })
    -- (the versions' new options: quests from items, unexplored areas, marks, convergences)
    expect(saved.quests).toEqual({ "available", "items" })
    expect(saved.places).toEqual({ "unexplored" })
    expect(saved.marks).toEqual({ "yours", "shared" })
    expect(saved.skyborne).toEqual({ "convergences" })
    -- a saved layout of now: as it is
    M:Set("filters", { v = 5, quests = {}, marks = {} })
    expect(M:Saved().quests).toEqual({})
    expect(M:Saved().marks).toEqual({})
end

@test("the quest options that are the game's settings: read from it, set in it")
local function gameSettings()
    -- (from the map's own menu: the map open)
    WorldMapFrame:Show()
    C_CVar.SetCVar("questPOI", "1")
    C_CVar.SetCVar("showQuestLevel", "0")
    C_CVar.SetCVar("showQuestDifficultyColor", "1")
    local value = M:MenuValue()
    local quests = value.quests or {}
    expect(quests[1]).toBe("objectives")
    expect(quests[2]).toBe("colours")
    local v = copy(value)
    v.quests = { "levels", "available" }
    M:OnFilters(v)
    expect(C_CVar.GetCVar("questPOI")).toBe("0")
    expect(C_CVar.GetCVar("showQuestLevel")).toBe("1")
    expect(C_CVar.GetCVar("showQuestDifficultyColor")).toBe("0")
    expect(M:Get("filters").v).toBe(5)
    -- (a character without Skyborne keeps its saved choice)
    expect(M:Get("filters").skyborne).toEqual({ "convergences" })
    C_CVar.SetCVar("questPOI", "1")
    C_CVar.SetCVar("showQuestDifficultyColor", "1")
end

@test("another module's \"show me\": the filter on and the map open")
local function openWith()
    M:OpenWith("services", "repair")
    expect(M:Layers().services.repair).toBe(true)
    expect(WorldMapFrame).toBeShown()
    -- already on: the map only
    WorldMapFrame:Hide()
    M:OpenWith("services", "repair")
    expect(WorldMapFrame).toBeShown()
end

--------------------------------------------------------------------------------
-- What's on a map
--------------------------------------------------------------------------------

@test("quests to pick up: a pin per giver, the best quest's colour, the others listed, a group's bar")
local function questGivers()
    local pins = collect()
    local dughan = pin(pins["Wolves Across the Border"])
    expect(dughan.key).toBe("available")
    expect(dughan.x).toBe(0.5)
    expect(dughan.detail).toBe("Level 2 · Marshal Dughan")
    expect(dughan.difficulty).toBe("difficult")
    expect(dughan.quests).toEqual({ 9001, 9005 })
    -- his walk and the other quest
    expect(dughan.route ~= nil).toBe(true)
    expect(text(dughan, 1):find("Walks a route", 1, true) ~= nil).toBe(true)
    expect(line(dughan, 2).quest).toBe(9005)
    -- (one of them a dungeon's: the bar under the pin)
    expect(dughan.pin.bar).toBe("quest-difficult")
    expect(dughan.pin.arcs).toEqual({ "quest-difficult", "quest-difficult" })
    local farmer = pin(pins["Boar Hides"])
    expect(farmer.key).toBe("repeatable")
    expect(farmer.detail).toBe("Repeatable · Level 1 · Farmer Saldean")
    expect(farmer.pin.color).toBe("mana")
    -- far above you: not offered
    expect(pins["The Fallen Hero"]).toBeNil()
end

@test("quests from an item: where it drops, found or dropped")
local function itemQuests()
    local list = M:Collect(ELWYNN)
    local drops: Item[] = {}
    for _, it in ipairs(list) do if it.key == "itemQuest" then drops[#drops + 1] = it end end
    expect(#drops).toBe(2)
    expect(text(drops[1], 1)).toBe("Starts from A Torn Scroll")
    expect(text(drops[1], 2):find("Dropped by Kobold Worker", 1, true) ~= nil).toBe(true)
    expect(text(drops[2], 2):find("Found in Old Crate", 1, true) ~= nil).toBe(true)
    expect(drops[1].listDetail).toBe("Level 1 · A Torn Scroll · Kobold Worker")
end

@test("entrances: yours and everyone's, the levels, an approximate door")
local function entrances()
    local pins = collect()
    local mines = pin(pins["The Deadmines"])
    expect(mines.key).toBe("entrance")
    expect(mines.fixed).toBe(true)
    expect((mines.detail or ""):find("^Dungeon") ~= nil).toBe(true)
    -- the Horde's: not for you
    expect(pins["Ragefire Chasm"]).toBeNil()
    local wsg = pin(pins["Warsong Gulch"])
    expect(wsg.key).toBe("battleground")
    expect(text(wsg, #(wsg.more or {})):find("Approximate", 1, true) ~= nil).toBe(true)
end

@test("services by the filters: one pin per NPC for the first service shown; your class's trainer only")
local function services()
    local pins = collect()
    expect(pin(pins["Innkeeper Farley"]).kindName).toBe("Innkeeper")
    expect(pins["Smith Argus"]).toBeNil()
    expect(pin(pins["Lyria Du Lac"]).kindName).toBe("Class trainer")
    expect(pin(pins["Lyria Du Lac"]).pin.color).toBe("class-warrior")
    -- another class's trainer never, not even as an innkeeper
    expect(pins["Khelden Bremen"]).toBeNil()
    expect(pins["Innkeeper Grosk"]).toBeNil()
    expect(pin(pins["Banker Marion"]).kindName).toBe("Banker")
    expect(pin(pins["Mailbox"]).key).toBe("mail")
    -- the holiday's vendor only while it's on
    expect(pins["Winter Vendor"]).toBeNil()
end

@test("with every filter on: repair, the trainers, the weapon master's weapons, rares and treasures")
local function everything()
    M:OnFilters(all())
    local pins = collect()
    expect(pin(pins["Smith Argus"]).kindName).toBe("Repair")
    local woo = pin(pins["Woo Ping"])
    expect(woo.kindName).toBe("Weapon master")
    expect((woo.teaches or ""):find("Two-Handed Swords", 1, true) ~= nil).toBe(true)
    expect(text(woo, 1):find("^Teaches ") ~= nil).toBe(true)
    expect(pin(pins["Herbalist Pomeroy"]).kindName).toBe("Herbalism trainer")
    expect(pin(pins["Wandering Peddler"]).route ~= nil).toBe(true)
    local hogger = pin(pins["Hogger"])
    expect(hogger.key).toBe("rareElite")
    expect(hogger.detail).toBe("Rare elite · level 11")
    expect(text(hogger, 1):find("one of 2 spots", 1, true) ~= nil).toBe(true)
    local fang = pin(pins["Mother Fang"])
    expect(fang.detail).toBe("Rare · level 10-12")
    expect(fang.route ~= nil).toBe(true)
    expect(pin(pins["Mossy Chest"]).key).toBe("treasure")
end

@test("flight masters: found by this character's record, not checked on a continent before")
local function flightMasters()
    local list = M:Collect(1415)
    local masters: Item[] = {}
    for _, it in ipairs(list) do if it.pin.glyph == "wing" then masters[#masters + 1] = it end end
    expect(#masters > 0).toBe(true)
    expect(masters[1].detail).toBe("Flight master · not checked yet")
    -- this character's record: one found, the rest not
    local id: number = 0
    for _, n in ipairs(C_TaxiMap.GetTaxiNodesForMap(1415)) do
        if n.name == masters[1].name then id = n.nodeID end
    end
    M:Char().taxi = { known = { [id] = true }, checked = { [1415] = true } }
    list = M:Collect(1415)
    local found, notFound = 0, 0
    for _, it in ipairs(list) do
        if it.detail == "Flight master" then found = found + 1 end
        if it.detail == "Flight master · not found yet" then notFound = notFound + 1 end
    end
    expect(found).toBe(1)
    expect(notFound > 0).toBe(true)
end

@test("campfires you found, marks, and a Skyborne's convergences")
local function others()
    campsite:CharData().fires = { { map = ELWYNN, x = 0.3, y = 0.6, seen = 0 }, { map = 1, x = 0.1, y = 0.1, seen = 0 } }
    local mine = marks:Add(ELWYNN, 0.2, 0.8, { name = "Herbs" })
    local shared = marks:Add(ELWYNN, 0.25, 0.8, { name = "", from = "Brannoc" })
    mock.stub(conv, "Shown", function(): boolean return true end)
    conv:Add({ map = ELWYNN, x = 0.9, y = 0.1 })
    local pins = collect()
    expect(pin(pins["Campfire"]).key).toBe("campfire")
    expect(pin(pins["Herbs"]).mark).toBe(mine.id)
    expect(text(pins["Mark"], 1):find("Shared by Brannoc", 1, true) ~= nil).toBe(true)
    local c = pin(pins["Convergence of Elements"])
    expect(c.key).toBe("convergence")
    local tip = c.tip
    assert(tip, "no tooltip")
    expect(type(tip())).toBe("table")
    marks:Remove(mine.id)
    marks:Remove(shared.id)
    campsite:CharData().fires = nil
    local spots = conv:Spots()
    table.remove(spots)
end

@test("what an NPC should offer you, by the map's checks (for /suu probe givers)")
local function questsFor()
    local list, done = M:QuestsFor(101)
    expect(#list).toBe(2)
    expect(list[1].id).toBe(9001)
    expect(list[1].name).toBe("Wolves Across the Border")
    expect(list[1].state).toBe("available")
    expect(list[1].onQuest).toBe(false)
    expect(list[1].done).toBe(false)
    expect(type(done)).toBe("table")
    expect(M:QuestsFor(999)).toEqual({})
end

--------------------------------------------------------------------------------
-- On the canvas
--------------------------------------------------------------------------------

local function openMap(mapID: number?)
    WorldMapFrame:Show()
    WorldMapFrame:SetMapID(mapID or ELWYNN)
    mock.advanceFrames(3)
end

-- The pin showing a pin of this name.
local function pinOf(name: string)
    for _, p in ipairs(M.pins) do
        local g = p.group
        for _, it in ipairs(g and g.items or {}) do
            if it.name == name then return p end
        end
    end
    return nil
end

local function shownPin(name: string)
    local p = pinOf(name)
    assert(p, "no pin shows " .. name)
    return p
end

-- The pins merged into the one showing this name.
local function groupOf(name: string): Group
    local g = shownPin(name).group
    assert(g, "no group")
    return g
end

@test("the map open: pins merged where they crowd, in tiers, at the setting's opacity")
local function drawn()
    openMap()
    M:OnFilters(all())
    mock.advanceFrames(2)
    expect(#M.pins > 10).toBe(true)
    local mail = shownPin("Mailbox")
    expect(groupOf("Mailbox").distinct).toBe(2)
    expect(mail.countTab).toBeShown()
    local layer = M.layer
    assert(layer, "no layer")
    local base = layer:GetFrameLevel()
    expect(mail:GetFrameLevel()).toBe(base + 1)
    expect(shownPin("Wolves Across the Border"):GetFrameLevel()).toBe(base + 3)
    expect(shownPin("The Deadmines"):GetFrameLevel()).toBe(base + 5)
    M:Set("pinAlpha", 50)
    expect(shownPin("The Deadmines"):GetAlpha()).toBeCloseTo(0.5)
end

@test("a quest's pin hovered: its tooltip, every pin of its quests ringed, the rest faded, the giver's walk")
local function hovered()
    openMap()
    local giver = shownPin("Wolves Across the Border")
    mock.hover(giver)
    expect(M.hoveredPin).toBe(giver)
    expect(giver.hl).toBeShown()
    expect(shownPin("Innkeeper Farley"):GetAlpha()).toBeCloseTo(0.3)
    expect(M.routes).toBeShown()
    -- Shift: its objectives (the tooltip asked again)
    local refreshed = mock.spy(function(_: Region) end)
    mock.stub(SuuUI.UI, "RefreshTooltip", refreshed)
    mock.setModifiers({ shift = true })
    expect(refreshed).toHaveBeenCalledTimes(1)
    mock.setModifiers({})
    mock.hover(nil)
    expect(M.hoveredPin).toBeNil()
    expect(M.routes).never.toBeShown()
    expect(giver.hl).never.toBeShown()
end

@test("a rare's pin hovered: its every spot ringed")
local function rareHovered()
    openMap()
    M:OnFilters(all())
    mock.advanceFrames(2)
    local fang = shownPin("Mother Fang")
    mock.hover(fang)
    expect(fang.hl).toBeShown()
    expect(M.routes).toBeShown()
end

@test("a click on a merged pin zooms to it; on a mark its card; on another nothing")
local function clicks()
    openMap()
    local zoomed = mock.spy(function(_: unknown, _: number, _: number) end)
    mock.stub(WorldMapFrame, "PanAndZoomTo", zoomed)
    mock.click(shownPin("Mailbox"))
    expect(zoomed).toHaveBeenCalledTimes(1)
    mock.click(shownPin("Innkeeper Farley"))
    expect(zoomed).toHaveBeenCalledTimes(1)
    local mark = marks:Add(ELWYNN, 0.9, 0.9, { name = "Ore" })
    mock.advanceFrames(2)
    local opened = mock.spy(function(_: unknown, _: number, _: Region?) end)
    mock.stub(marks, "OpenCard", opened)
    mock.click(shownPin("Ore"))
    expect(opened).toHaveBeenCalledTimes(1)
    expect(M:PinForMark(mark.id)).toBe(pinOf("Ore"))
    marks:Remove(mark.id)
end

@test("at the flight master the flight map's pins only: Map filters away")
local function atFlightMaster()
    openMap()
    mock.stub(flightMap, "AtMaster", function(): boolean return true end)
    M:Refresh()
    expect(M.menu).never.toBeShown()
    expect(#M.pins).toBe(0)
end

@test("the flight masters this character found, noted at a flight master's map")
local function recordTaxi()
    mock.fake("C_TaxiMap.GetAllTaxiNodes", function(_: number?): unknown
        return {
            { nodeID = 2, name = "Stormwind, Elwynn", state = 0 },
            { nodeID = 4, name = "Sentinel Hill, Westfall", state = 1 },
            { nodeID = 5, name = "Lakeshire, Redridge", state = 2 },
            { nodeID = 99, name = "zzOLDSomewhere", state = 1 },
        }
    end)
    openMap()
    M:RecordTaxiNodes()
    local taxi = M:Char().taxi
    assert(taxi, "nothing noted")
    expect(taxi.known).toEqual({ [2] = true, [4] = true })
    expect(next(taxi.checked) ~= nil).toBe(true)
    -- none of them: nothing noted
    M:Char().taxi = nil
    mock.fake("C_TaxiMap.GetAllTaxiNodes", function(_: number?): unknown return {} end)
    M:RecordTaxiNodes()
    expect(M:Char().taxi).toBeNil()
end

@test("a quest's group tag the game tells late: the guess first, the map again when it differs")
local function lateTag()
    patrol = true
    local told: unknown = nil
    mock.fake("C_QuestLog.GetQuestTagInfo", function(id: number): unknown
        if id == 9007 then return told end
        -- (one the game knows at once: an elite quest)
        if id == 9008 then return { tagID = 1 } end
        return nil
    end)
    openMap()
    expect(groupOf("Elite Patrol").items[1].pin.bar).toBe("quest-difficult")
    told = { tagID = 0 }
    mock.advanceTime(2.1)
    mock.advanceFrames(2)
    expect(groupOf("Elite Patrol").items[1].pin.bar).toBeNil()
    -- a quest whose tag the game knows at once: its bar at once
    crowd = true
    M:Refresh()
    for _, it in ipairs(groupOf("The Lost Necklace").items) do
        if it.name == "The Lost Necklace" then expect(it.pin.bar).toBe("quest-difficult") end
    end
    crowd = false
    patrol = false
end

@test("the game's quest pins and the quest log's markers in SuuUI's look; the game's again when off")
local function questPins()
    local giver = mock.spawnUnit({ name = "Kargal Battlescar", level = 30, reaction = "friendly" })
    mock.defineQuest(959, { title = "Trouble at the Docks", giver = giver })
    giver:setDistance(3)
    mock.player:interact(giver)
    mock.advanceTime(1)
    AcceptQuest()
    mock.advanceTime(1)
    openMap(1412)
    local styled = 0
    for _, p in ipairs(frames.mapPins(WorldMapFrame, "QuestPinTemplate")) do
        if M.looks[p] then styled = styled + 1 end
    end
    expect(styled > 0).toBe(true)
    M:Set("enabled", false)
    for _, p in ipairs(frames.mapPins(WorldMapFrame, "QuestPinTemplate")) do
        local look = M.looks[p]
        if look then expect(look).never.toBeShown() end
    end
    M:Reset("enabled")
end

