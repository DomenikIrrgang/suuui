    M:Refresh()
    for _, it in ipairs(groupOf("The Lost Necklace").items) do
        if it.name == "The Lost Necklace" then
            expect(it.pin.bar).toBe("quest-difficult")
        end
    end
    crowd = false
    patrol = false
end

