-- Map filters' Hidden quests row, its checkboxes and Show all (the panel open).
type HiddenRow = { boxes: Checkbox[], labels: string[], showAll: SuuButton }
local function hiddenRow(): HiddenRow?
    local menu = assert(M.menu)
    local panel = assert(menu.panel)
    for _, row in ipairs(panel.rows) do
        if row.group.key == "hidden" then
            local boxes: Checkbox[], labels: string[] = {}, {}
            for i, b in ipairs(row.boxes or {}) do
                boxes[i] = b.box
                labels[i] = b.option.label
            end
            return { boxes = boxes, labels = labels, showAll = assert(row.action) }
        end
    end
    return nil
end

@test(
    "Map filters' Hidden quests: each by name, ticked; unticked or Show all, the pins back; gone when the map opens again"
)
local function hiddenMenu()
    openMap()
    local menu = assert(M.menu)
    -- nothing hidden: no group
    menu:Open()
    expect(hiddenRow()).toBeNil()
    menu:Close()
    M:HideQuests({ 9001, 9002 })
    menu:Open()
    local row = assert(hiddenRow())
    expect(row.labels).toEqual({ "Boar Hides", "Wolves Across the Border" })
    expect(row.boxes[1].value).toBe(true)
    expect(row.boxes[2].value).toBe(true)
    expect(row.showAll).toBeShown()
    -- unticked: Boar Hides back at once, still listed (to hide it again)
    mock.click(row.boxes[1])
    expect(M:IsQuestHidden(9002)).toBe(false)
    expect(pinOf("Boar Hides") ~= nil).toBe(true)
    expect(menu.panel).toBeShown()
    -- ticked again: away again
    mock.click(row.boxes[1])
    expect(M:IsQuestHidden(9002)).toBe(true)
    expect(pinOf("Boar Hides")).toBeNil()
    -- Show all: every one back, the ticks off
    mock.click(row.showAll)
    expect(M:Char().hiddenQuests).toBeNil()
    expect(pinOf("Boar Hides") ~= nil).toBe(true)
    expect(pinOf("Wolves Across the Border") ~= nil).toBe(true)
    local again = assert(hiddenRow())
    expect(again.boxes[1].value).toBe(false)
    expect(again.boxes[2].value).toBe(false)
    menu:Close()
    -- the map opened again: the group gone
    WorldMapFrame:Hide()
    openMap()
    menu:Open()
    expect(hiddenRow()).toBeNil()
    menu:Close()
end

