    local base = layer:GetFrameLevel()
    expect(mail:GetFrameLevel()).toBe(base + 1)
    expect(shownPin("Wolves Across the Border"):GetFrameLevel()).toBe(base + 3)
    expect(shownPin("The Deadmines"):GetFrameLevel()).toBe(base + 5)
    M:Set("pinAlpha", 50)
    expect(shownPin("The Deadmines"):GetAlpha()).toBeCloseTo(0.5)
end

