    -- another character (its own data): nothing hidden, the pin there
    local alt: { [string]: unknown } = {}
    local onAlt = true
    local real = M.CharData
    mock.stub(M, "CharData", function(_: unknown): { [string]: unknown }
        return onAlt and alt or real(M)
    end)
    expect(M:IsQuestHidden(9001)).toBe(false)
    expect(collect()["Wolves Across the Border"] ~= nil).toBe(true)
    M:HideQuests({ 9002 })
    expect(alt.hiddenQuests).toEqual({ [9002] = true })
    onAlt = false
    expect(M:IsQuestHidden(9002)).toBe(false)
    expect(M:IsQuestHidden(9001)).toBe(true)
end

