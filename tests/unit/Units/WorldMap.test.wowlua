-- A border's four lines, each in physical pixels.
local function edgePixels(b: Border): number[]
    local out: number[] = {}
    for i, t in ipairs({ b.top, b.bottom }) do
        out[i] = t:GetHeight() * t:GetEffectiveScale() / pixel.perfectScale()
    end
    for _, t in ipairs({ b.left, b.right }) do
        out[#out + 1] = t:GetWidth() * t:GetEffectiveScale() / pixel.perfectScale()
    end
    return out
end

@test("Map filters in the scaled map's header: its edge one physical pixel on every side")
local function filtersEdge()
    -- (made under the map, at its scale; the header is at the usual one: its
    -- right edge came out under a pixel and vanished, a player's report
    -- 2026-11-14, any theme)
    openMap()
    local chrome = assert(windowSkin.chromeOf(WorldMapFrame), "no chrome")
    local menu = assert(M.menu, "no menu")
    expect(menu:GetParent()).toBe(chrome.head)
    expect(WorldMapFrame:GetEffectiveScale()).never.toBeCloseTo(chrome.head:GetEffectiveScale())
    for _, w in ipairs(edgePixels(menu.edge)) do
        expect(w).toBeCloseTo(1)
    end
    -- the map at another size: the header scaled again, the edge still one pixel
    chrome:SetBody(nil, 1)
    for _, w in ipairs(edgePixels(menu.edge)) do
        expect(w).toBeCloseTo(1)
    end
end

@test("Map filters over the map's top left without SuuUI's window skin")
local function filtersPlaced()
    openMap()
    mock.stub(windowSkin, "chromeOf", function(_: Frame?): WindowChrome?
        return nil
    end)
    M:PlaceFilters()
    local menu = M.menu
    assert(menu, "no menu")
    expect(menu:GetParent()).toBe(WorldMapFrame)
    local _, rel = menu:GetPoint(1)
    expect(rel == frames.asFrame(WorldMapFrame:GetCanvasContainer())).toBe(true)
end

@test("the real data: a new Human warrior's Elwynn Forest has quests to pick up, an innkeeper, mailboxes")
local function realData()
    mock.stub(SuuUI, "QuestStarts", realStarts)
    mock.stub(SuuUI, "MapPlaces", realPlaces)
    local kinds: { [string]: number } = {}
    for _, it in ipairs(M:Collect(ELWYNN)) do
        local k = it.key or it.kindName or "?"
        kinds[k] = (kinds[k] or 0) + 1
    end
    expect((kinds.available or 0) > 0).toBe(true)
    expect((kinds.inn or 0) > 0).toBe(true)
    expect((kinds.mail or 0) > 0).toBe(true)
    openMap()
    expect(#M.pins > 0).toBe(true)
end

@test("a pin made in combat lets right-clicks through to the map after it (refused in combat)")
local function pinInCombat()
    local layer = assert(M.layer)
    -- (a pin made fresh: none to reuse)
    local spare = M.free
    M.free = {}
    mock.player:enterCombat()
    local made = M:Pin(layer)
    expect(#M.passLater).toBe(1)
    mock.player:leaveCombat()
    mock.advanceFrames(2)
    expect(#M.passLater).toBe(0)
    made:Hide()
    M.free = spare
    table.insert(M.free, made)
    -- the flight map's pins the same
    local fl = assert(flightMap.layer)
    local fspare = flightMap.free
    flightMap.free = {}
    mock.player:enterCombat()
    local fpin = flightMap:Pin(fl)
    expect(#flightMap.passLater).toBe(1)
    mock.player:leaveCombat()
    mock.advanceFrames(2)
    expect(#flightMap.passLater).toBe(0)
    fpin:Hide()
    flightMap.pins = {}
    flightMap.free = fspare
    table.insert(flightMap.free, fpin)
end
