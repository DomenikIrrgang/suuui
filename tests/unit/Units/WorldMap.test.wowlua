-- Map filters' choice: each group's values on.
type Choice = { [string]: string[] }

-- Every filter on.
local function all(): Choice
    return {
        quests = { "objectives", "levels", "colours", "available", "repeatable", "items", "trivial" },
        places = { "unexplored", "dungeons", "battlegrounds", "flight", "campfires" },
        services = {
            "inn",
            "repair",
            "goods",
            "food",
            "vendor",
            "stable",
            "battlemaster",
            "guild",
            "tabard",
            "spirit",
        },
        trading = { "auction", "mail", "bank" },
        trainers = { "class", "professions", "weapon", "riding" },
        rares = { "rares", "treasures" },
        marks = { "yours", "shared" },
    }
end

local function copy(c: Choice): Choice
    local out: Choice = {}
    for k, list in pairs(c) do
        local l: string[] = {}
        for i, v in ipairs(list) do
            l[i] = v
        end
        out[k] = l
    end
    return out
end

-- (the real data, for the one test that reads it)
local realStarts, realPlaces = SuuUI.QuestStarts, SuuUI.MapPlaces

@beforeEach
local function data()
    -- (the real data built, as the map has it after its first open; the
    -- stand-ins in its place)
    lazyData.questStarts:Get()
    lazyData.mapPlaces:Get()
    lazyData.mapOverlays:Get()
    mock.stub(SuuUI, "QuestStarts", starts)
    mock.stub(SuuUI, "MapPlaces", places)
    -- (the stand-ins and fakes change between tests without quest events)
    forgetQuests()
end

@afterEach
local function cleanup()
    mock.hover(nil)
    if WorldMapFrame:IsShown() then
        WorldMapFrame:Hide()
    end
    M:Reset("filters")
    M:Reset("pinAlpha")
    M:Char().taxi = nil
    M:Char().hiddenQuests = nil
    M:ListHidden()
    SuuUI.UI.CloseContextMenu()
    mock.advanceTime(7)
    expectNoErrors()
end

-- The pins a map would show, by name.
local function collect(mapID: number?): { [string]: Item }
    local out: { [string]: Item } = {}
    for _, it in ipairs(M:Collect(mapID or ELWYNN)) do
        out[it.name] = it
    end
    return out
end

-- A pin's line under its card.
local function line(it: Item?, i: number): TipLine
    assert(it, "no pin")
    local more = it.more
    assert(more, "no lines")
    local l = more[i]
    assert(l, "no line " .. i)
    return l
end

-- The text of a pin's line.
local function text(it: Item?, i: number): string
    return line(it, i)[1] or ""
end

local function pin(it: Item?): Item
    assert(it, "no pin")
    return it
end

--------------------------------------------------------------------------------
-- Map filters
--------------------------------------------------------------------------------

@test("the filters: the defaults, each group's own")
local function defaults()
    local on = M:Layers()
    expect(on.quests.available).toBe(true)
    expect(on.places.flight).toBe(true)
    expect(on.services.inn).toBe(true)
    expect(on.services.repair).toBeNil()
    expect(on.trading.mail).toBe(true)
    expect(on.trainers.class).toBe(true)
    expect(M:MarksShown()).toEqual({ yours = true, shared = true })
end

@test("the filters read once while they stay: the same tables; a change reads them again")
local function filtersCached()
    local on = M:Layers()
    expect(M:Layers()).toBe(on)
    expect(M:MarksShown()).toBe(M:MarksShown())
    local value = M:MenuValue()
    value.marks = { "yours" }
    M:OnFilters(value)
    local after = M:Layers()
    expect(after ~= on).toBe(true)
    expect(M:MarksShown()).toEqual({ yours = true })
    M:ResetAll({ "filters" })
    expect(M:MarksShown()).toEqual({ yours = true, shared = true })
    expectNoErrors()
end

@test("an earlier layout's choices carried over: mailboxes and trainers moved, new options on once")
local function carriedOver()
    M:Set("filters", { services = { "inn", "classTrainer", "trainers", "mail" }, quests = { "available" } })
    local saved = M:Saved()
    expect(saved.services).toEqual({ "inn" })
    expect(saved.trainers).toEqual({ "class", "professions" })
    expect(saved.trading).toEqual({ "mail" })
    -- (the versions' new options: quests from items, unexplored areas, marks, convergences)
    expect(saved.quests).toEqual({ "available", "items" })
    expect(saved.places).toEqual({ "unexplored" })
    expect(saved.marks).toEqual({ "yours", "shared" })
    expect(saved.skyborne).toEqual({ "convergences" })
    -- a saved layout of now: as it is
    M:Set("filters", { v = 5, quests = {}, marks = {} })
    expect(M:Saved().quests).toEqual({})
    expect(M:Saved().marks).toEqual({})
end

@test("the quest options that are the game's settings: read from it, set in it")
local function gameSettings()
    -- (from the map's own menu: the map open)
    WorldMapFrame:Show()
    C_CVar.SetCVar("questPOI", "1")
    C_CVar.SetCVar("showQuestLevel", "0")
    C_CVar.SetCVar("showQuestDifficultyColor", "1")
    local value = M:MenuValue()
    local quests = value.quests or {}
    expect(quests[1]).toBe("objectives")
    expect(quests[2]).toBe("colours")
    local v = copy(value)
    v.quests = { "levels", "available" }
    M:OnFilters(v)
    expect(C_CVar.GetCVar("questPOI")).toBe("0")
    expect(C_CVar.GetCVar("showQuestLevel")).toBe("1")
    expect(C_CVar.GetCVar("showQuestDifficultyColor")).toBe("0")
    expect(M:Get("filters").v).toBe(5)
    -- (a character without Skyborne keeps its saved choice)
    expect(M:Get("filters").skyborne).toEqual({ "convergences" })
    C_CVar.SetCVar("questPOI", "1")
    C_CVar.SetCVar("showQuestDifficultyColor", "1")
end

@test("another module's \"show me\": the filter on; the caller opens the map through a secure click")
local function openWith()
    WorldMapFrame:Hide()
    M:OpenWith("services", "repair")
    expect(M:Layers().services.repair).toBe(true)
    -- (opened from SuuUI's code, the map's pins were taken by it)
    expect(WorldMapFrame).never.toBeShown()
    M:OpenWith("services", "repair")
    expect(M:Layers().services.repair).toBe(true)
end

--------------------------------------------------------------------------------
-- What's on a map
--------------------------------------------------------------------------------

@test("each quest is judged once until a quest event; the turned-in list read once, a turn-in added to it")
local function judgedOnce()
    forgetCompleted()
    local asked = 0
    mock.fake("C_QuestLog.IsOnQuest", function(_: number): boolean
        asked = asked + 1
        return false
    end)
    local reads = 0
    mock.fake("C_QuestLog.GetAllCompletedQuestIDs", function(): number[]
        reads = reads + 1
        return {}
    end)
    collect()
    local first = asked
    expect(first > 0).toBe(true)
    expect(reads).toBe(1)
    -- the map drawn again (a pan, a zoom, three times as it opens): nothing read
    collect()
    collect()
    expect(asked).toBe(first)
    expect(reads).toBe(1)
    -- a quest accepted: judged again
    mock.fireEvent("QUEST_LOG_UPDATE")
    collect()
    expect(asked).toBe(2 * first)
    -- (the turned-in list isn't read again: only a turn-in changes it)
    expect(reads).toBe(1)
    mock.fireEvent("QUEST_TURNED_IN", 4242, 0, 0)
    expect(completedSet()[4242]).toBe(true)
    expect(reads).toBe(1)
    expectNoErrors()
end

@test("the first open: the quest and place pins once their data is built, the others at once")
local function dataFirst()
    local ready = false
    local function isReady(): boolean
        return ready
    end
    mock.stub(lazyData.questStarts, "Ready", isReady)
    mock.stub(lazyData.mapPlaces, "Ready", isReady)
    mock.stub(lazyData.mapOverlays, "Ready", isReady)
    local prepared = mock.spy()
    mock.stub(M, "PrepareData", prepared)
    WorldMapFrame:Show()
    mock.advanceFrames(2)
    M:Refresh()
    expect(prepared).toHaveBeenCalled()
    expect(collect()["Wolves Across the Border"]).toBeNil()
    -- built: its pins
    ready = true
    expect(collect()["Wolves Across the Border"] ~= nil).toBe(true)
    expectNoErrors()
end

@test("quests to pick up: a pin per giver, the best quest's colour, the others listed, a group's bar")
local function questGivers()
    local pins = collect()
    local dughan = pin(pins["Wolves Across the Border"])
    expect(dughan.key).toBe("available")
    expect(dughan.x).toBe(0.5)
    expect(dughan.detail).toBe("Level 2 · Marshal Dughan")
    expect(dughan.difficulty).toBe("difficult")
    expect(dughan.quests).toEqual({ 9001, 9005 })
    -- his walk and the other quest
    expect(dughan.route ~= nil).toBe(true)
    expect(text(dughan, 1):find("Walks a route", 1, true) ~= nil).toBe(true)
    expect(line(dughan, 2).quest).toBe(9005)
    -- (one of them a dungeon's: the bar under the pin)
    expect(dughan.pin.bar).toBe("quest-difficult")
    expect(dughan.pin.arcs).toEqual({ "quest-difficult", "quest-difficult" })
    local farmer = pin(pins["Boar Hides"])
    expect(farmer.key).toBe("repeatable")
    expect(farmer.detail).toBe("Repeatable · Level 1 · Farmer Saldean")
    expect(farmer.pin.color).toBe("mana")
    -- far above you: not offered
    expect(pins["The Fallen Hero"]).toBeNil()
end

@test("quests from an item: where it drops, found or dropped")
local function itemQuests()
    local list = M:Collect(ELWYNN)
    local drops: Item[] = {}
    for _, it in ipairs(list) do
        if it.key == "itemQuest" then
            drops[#drops + 1] = it
        end
    end
    expect(#drops).toBe(2)
    expect(text(drops[1], 1)).toBe("Starts from A Torn Scroll")
    expect(text(drops[1], 2):find("Dropped by Kobold Worker", 1, true) ~= nil).toBe(true)
    expect(text(drops[2], 2):find("Found in Old Crate", 1, true) ~= nil).toBe(true)
    expect(drops[1].listDetail).toBe("Level 1 · A Torn Scroll · Kobold Worker")
end

@test("entrances: yours and everyone's, the levels, an approximate door")
local function entrances()
    local pins = collect()
    local mines = pin(pins["The Deadmines"])
    expect(mines.key).toBe("entrance")
    expect(mines.fixed).toBe(true)
    expect((mines.detail or ""):find("^Dungeon") ~= nil).toBe(true)
    -- the Horde's: not for you
    expect(pins["Ragefire Chasm"]).toBeNil()
    local wsg = pin(pins["Warsong Gulch"])
    expect(wsg.key).toBe("battleground")
    expect(text(wsg, #(wsg.more or {})):find("Approximate", 1, true) ~= nil).toBe(true)
end

@test("services by the filters: one pin per NPC for the first service shown; your class's trainer only")
local function services()
    local pins = collect()
    expect(pin(pins["Innkeeper Farley"]).kindName).toBe("Innkeeper")
    expect(pins["Smith Argus"]).toBeNil()
    expect(pin(pins["Lyria Du Lac"]).kindName).toBe("Class trainer")
    expect(pin(pins["Lyria Du Lac"]).pin.color).toBe("class-warrior")
    -- another class's trainer never, not even as an innkeeper
    expect(pins["Khelden Bremen"]).toBeNil()
    expect(pins["Innkeeper Grosk"]).toBeNil()
    expect(pin(pins["Banker Marion"]).kindName).toBe("Banker")
    expect(pin(pins["Mailbox"]).key).toBe("mail")
    -- the holiday's vendor only while it's on
    expect(pins["Winter Vendor"]).toBeNil()
end

@test("with every filter on: repair, the trainers, the weapon master's weapons, rares and treasures")
local function everything()
    M:OnFilters(all())
    local pins = collect()
    expect(pin(pins["Smith Argus"]).kindName).toBe("Repair")
    local woo = pin(pins["Woo Ping"])
    expect(woo.kindName).toBe("Weapon master")
    expect((woo.teaches or ""):find("Two-Handed Swords", 1, true) ~= nil).toBe(true)
    expect(text(woo, 1):find("^Teaches ") ~= nil).toBe(true)
    expect(pin(pins["Herbalist Pomeroy"]).kindName).toBe("Herbalism trainer")
    expect(pin(pins["Wandering Peddler"]).route ~= nil).toBe(true)
    local hogger = pin(pins["Hogger"])
    expect(hogger.key).toBe("rareElite")
    expect(hogger.detail).toBe("Rare elite · level 11")
    expect(text(hogger, 1):find("one of 2 spots", 1, true) ~= nil).toBe(true)
    local fang = pin(pins["Mother Fang"])
    expect(fang.detail).toBe("Rare · level 10-12")
    expect(fang.route ~= nil).toBe(true)
    expect(pin(pins["Mossy Chest"]).key).toBe("treasure")
end

@test("flight masters: found by this character's record, not checked on a continent before")
local function flightMasters()
    local list = M:Collect(1415)
    local masters: Item[] = {}
    for _, it in ipairs(list) do
        if it.pin.glyph == "wing" then
            masters[#masters + 1] = it
        end
    end
    expect(#masters > 0).toBe(true)
    expect(masters[1].detail).toBe("Flight master · not checked yet")
    -- this character's record: one found, the rest not
    local id: number = 0
    for _, n in ipairs(C_TaxiMap.GetTaxiNodesForMap(1415)) do
        if n.name == masters[1].name then
            id = n.nodeID
        end
    end
    M:Char().taxi = { known = { [id] = true }, checked = { [1415] = true } }
    list = M:Collect(1415)
    local found, notFound = 0, 0
    for _, it in ipairs(list) do
        if it.detail == "Flight master" then
            found = found + 1
        end
        if it.detail == "Flight master · not found yet" then
            notFound = notFound + 1
        end
    end
    expect(found).toBe(1)
    expect(notFound > 0).toBe(true)
end

@test("campfires you found, marks, and a Skyborne's convergences")
local function others()
    campsite:CharData().fires = {
        { map = ELWYNN, x = 0.3, y = 0.6, seen = time() },
        { map = 1, x = 0.1, y = 0.1, seen = time() },
    }
    local mine = marks:Add(ELWYNN, 0.2, 0.8, { name = "Herbs" })
    local shared = marks:Add(ELWYNN, 0.25, 0.8, { name = "", from = "Brannoc" })
    mock.stub(conv, "Shown", function(): boolean
        return true
    end)
    conv:Add({ map = ELWYNN, x = 0.9, y = 0.1 })
    local pins = collect()
    expect(pin(pins["Campfire"]).key).toBe("campfire")
    expect(pin(pins["Herbs"]).mark).toBe(mine.id)
    expect(text(pins["Mark"], 1):find("Shared by Brannoc", 1, true) ~= nil).toBe(true)
    local c = pin(pins["Convergence of Elements"])
    expect(c.key).toBe("convergence")
    local tip = c.tip
    assert(tip, "no tooltip")
    expect(type(tip())).toBe("table")
    marks:Remove(mine.id)
    marks:Remove(shared.id)
    -- found by you, or by someone in your group or guild
    expect(pin(pins["Campfire"]).detail).toBe("One you found")
    campsite:CharData().fires = { { map = ELWYNN, x = 0.3, y = 0.6, seen = time() - 150, by = "Tam" } }
    local fire = pin(collect()["Campfire"])
    expect(fire.detail).toBe("Found by Tam")
    -- its tooltip: how long it burns (10 minutes from the last sighting)
    local tip = assert(fire.tip)()
    expect(tip.subtitle).toBe("Found by Tam")
    expect(assert(tip.lines)[1]).toEqual({ "Goes out in", "7:30" })
    campsite:CharData().fires = nil
    local spots = conv:Spots()
    table.remove(spots)
end

@test("what an NPC should offer you, by the map's checks (for /suu probe givers)")
local function questsFor()
    local list, done = M:QuestsFor(101)
    expect(#list).toBe(2)
    expect(list[1].id).toBe(9001)
    expect(list[1].name).toBe("Wolves Across the Border")
    expect(list[1].state).toBe("available")
    expect(list[1].onQuest).toBe(false)
    expect(list[1].done).toBe(false)
    expect(type(done)).toBe("table")
    expect(M:QuestsFor(999)).toEqual({})
end

@test("the givers' index is made a few maps a frame once the data is there; a tooltip before it's whole makes the rest")
local function giverIndexOverFrames()
    local data = starts()
    data.maps[1415] = { { 40, 70, 101, 9001, 9005 } }
    mock.stub(SuuUI, "QuestStarts", function(): QuestStarts
        return data
    end)
    local function fresh()
        mock.setField(M, "giverIndex", nil)
        mock.setField(M, "giverMade", nil)
        mock.setField(M, "giverAt", nil)
        mock.setField(M, "giverStarted", false)
        mock.setField(M, "giverFrom", nil)
    end
    -- a map at a time: not whole after one
    fresh()
    expect(M:IndexGivers(1)).toBe(false)
    expect(M.giverIndex).toBeNil()
    -- a tooltip's ask makes the rest: both of Dughan's places, the same as at once
    local list = M:QuestsFor(101)
    expect(#list).toBe(2)
    local whole = M:GiverPlaces(101)
    expect(#whole).toBe(4)
    fresh()
    expect(M:GiverPlaces(101)).toEqual(whole)
    -- over the frames, after the data's there
    fresh()
    M:IndexGiversSoon()
    mock.advanceFrames(3)
    expect(M.giverIndex ~= nil).toBe(true)
    expect(M:GiverPlaces(101)).toEqual(whole)
    expect(M:GiverPlaces(999)).toEqual({})
    expectNoErrors()
end

@test("an NPC's tooltip: the quests it gives you now, in their difficulty's colour with their level (asked in game)")
local function questTooltip()
    local giver = mock.spawnUnit({
        name = "Marshal Test",
        level = 25,
        reaction = "friendly",
        distance = 5,
        npcID = 101,
    })
    local nobody = mock.spawnUnit({ name = "Quiet Test", level = 25, reaction = "friendly", distance = 5, npcID = 999 })
    local function shown(): string[]
        local out: string[] = {}
        for i = 1, GameTooltip:NumLines() do
            local l = frames.asFontString(tbl.field(_G, "GameTooltipTextLeft" .. i))
            out[#out + 1] = l and l:GetText() or ""
        end
        return out
    end
    GameTooltip:SetOwner(UIParent, "ANCHOR_NONE")
    mock.player:target(giver)
    GameTooltip:SetUnit("target")
    local got = shown()
    local at: number? = nil
    for i, l in ipairs(got) do
        if l == "Quests" then
            at = i
        end
    end
    local i = assert(at, "no Quests line")
    expect(got[i + 1]:find("^Wolves Across the Border %(%d+%)$") ~= nil).toBe(true)
    -- one that gives nothing (or the module off): no Quests line
    GameTooltip:SetOwner(UIParent, "ANCHOR_NONE")
    mock.player:target(nobody)
    GameTooltip:SetUnit("target")
    for _, l in ipairs(shown()) do
        expect(l).never.toBe("Quests")
    end
    GameTooltip:Hide()
    mock.player:target(nil)
end

--------------------------------------------------------------------------------
-- On the canvas
--------------------------------------------------------------------------------

local function openMap(mapID: number?)
    WorldMapFrame:Show()
    WorldMapFrame:SetMapID(mapID or ELWYNN)
    mock.advanceFrames(3)
end

-- The pin showing a pin of this name.
local function pinOf(name: string)
    for _, p in ipairs(M.pins) do
        local g = p.group
        for _, it in ipairs(g and g.items or {}) do
            if it.name == name then
                return p
            end
        end
    end
    return nil
end

local function shownPin(name: string)
    local p = pinOf(name)
    assert(p, "no pin shows " .. name)
    return p
end

-- The pins merged into the one showing this name.
local function groupOf(name: string): Group
    local g = shownPin(name).group
    assert(g, "no group")
    return g
end

@test("the map open: pins merged where they crowd, in tiers, at the setting's opacity")
local function drawn()
    openMap()
