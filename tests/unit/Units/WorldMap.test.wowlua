@test("hidden quests: hidden, one shown again from Map filters, Show all; listed by name")
local function hiddenStore()
    expect(M:IsQuestHidden(9001)).toBe(false)
    M:HideQuests({ 9001 })
    M:HideQuests({ 9005, 9002 })
    expect(M:IsQuestHidden(9001)).toBe(true)
    expect(M:Char().hiddenQuests).toEqual({ [9001] = true, [9002] = true, [9005] = true })
    -- by name: Boar Hides, The Kobold Lord, Wolves Across the Border
    expect(M:HiddenQuests()).toEqual({ 9002, 9005, 9001 })
    expect(M.hiddenListed).toEqual({ 9002, 9005, 9001 })
    -- Map filters: the hidden ones ticked; one unticked is shown again
    local value = M:MenuValue()
    local ticked = value.hidden or {}
    table.sort(ticked)
    expect(ticked).toEqual({ "9001", "9002", "9005" })
    value.hidden = { "9001", "9005" }
    M:OnFilters(value)
    expect(M:IsQuestHidden(9002)).toBe(false)
    expect(M:IsQuestHidden(9001)).toBe(true)
    -- (not a filter: not saved with them)
    expect(M:Get("filters").hidden).toBeNil()
    -- a change from elsewhere (no Hidden quests in it) leaves them
    M:OnFilters(all())
    expect(M:IsQuestHidden(9005)).toBe(true)
    -- (it stays listed, unticked, until the map opens again)
    expect(M.hiddenListed).toEqual({ 9002, 9005, 9001 })
    M:ShowAllQuests()
    expect(M:IsQuestHidden(9001)).toBe(false)
    expect(M:Char().hiddenQuests).toBeNil()
    expect(M:HiddenQuests()).toEqual({})
end

@test("hidden quests are this character's: in its own data, not the profile; another's are its own")
