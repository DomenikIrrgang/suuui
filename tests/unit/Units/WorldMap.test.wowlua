end

@test("what changes the pins: quests taken, marks, themes, the calendar")
local function refreshes()
    openMap()
    local refresh = mock.spy(function(_: unknown) end)
    mock.stub(M, "Refresh", refresh)
    mock.fireEvent("QUEST_ACCEPTED", 1)
    mock.advanceTime(0.3)
    expect(refresh).toHaveBeenCalledTimes(1)
    M:Emit("SUUUI_MARKS_CHANGED")
    M:Emit("SUUUI_CONVERGENCES_CHANGED")
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    expect(refresh).toHaveBeenCalledTimes(4)
    mock.fireEvent("CALENDAR_UPDATE_EVENT_LIST")
    expect(refresh).toHaveBeenCalledTimes(5)
end

