-- The bank
--------------------------------------------------------------------------------

local function atBank(opts: { tabs?: { [string]: unknown }[], cost?: number }?)
    mock.player:setMoney(1000000)
    local banker = mock.spawnUnit({ name = "Banker", reaction = "friendly" })
    local o = opts or {}
    mock.defineBank(banker, {
        tabs = o.tabs or { { name = "Tab 1", slots = 28, items = { [1] = { id = CLOTH, count = 7 } } } },
        nextTabCost = o.cost or 10000,
    })
    mock.player:interact(banker)
    mock.advanceTime(0.5)
end

@test("at a banker: the bank window with its tabs, your bags beside it; away: back to their place")
local function bankWindow()
    open()
    atBank()
    expect(bank()).toBeShown()
    expect(mock.textOf(bank().note):find("slots", 1, true) ~= nil).toBe(true)
    expect((select(2, inv():GetPoint(1)))).toBe(bank())
    expect(BankFrame:GetAlpha()).toBe(0)
    BankFrame:SetPoint("CENTER") -- the game places it again: away again
    mock.advanceTime(0.01)
    expect((BankFrame:GetLeft() or 0) < 0).toBe(true)
    mock.fireEvent("BANKFRAME_CLOSED")
    expect(bank()).never.toBeShown()
    expect(M:Char().bank ~= nil).toBe(true)
end

@test("the bank rail: its own slots, the bank slots bought, the buy cell with its cost or why not")
local function bankRailCells()
    atBank()
    local r = bankRail()
    expect(r).toBeShown()
    local buy = r.buy
    assert(buy, "no buy cell")
    expect(buy).toBeShown()
    mock.hover(buy)
    expect(buy.skin.hover).toBe(true)
    mock.hover(nil)
    mock.stub(C_Bank, "FetchNextPurchasableBankTabData", function(_: number): unknown
        return { tabCost = 999999999, canAfford = false }
    end)
    M:DrawBankRail()
    expect((buy.why or ""):find("You need ", 1, true) ~= nil).toBe(true)
    mock.stub(C_Bank, "HasMaxBankTabs", function(_: number): boolean
        return true
    end)
    M:DrawBankRail()
    expect(buy.why).toBe("Every bank slot is bought.")
    mock.stub(C_Bank, "HasMaxBankTabs", function(_: number): boolean
        return false
    end)
    mock.stub(C_Bank, "FetchNextPurchasableBankTabData", function(_: number): unknown
        return nil
    end)
    M:DrawBankRail()
    expect(buy.why).toBe("The bank doesn't offer another slot right now.")
    -- a bank slot's tooltip
    mock.hover(r.cells[1])
    mock.hover(nil)
    mock.fireEvent("PLAYER_MONEY")
    mock.player:enterCombat()
    mock.player:leaveCombat()
    mock.fireEvent("BANKFRAME_CLOSED")
end

@test("the bank setting off: Blizzard's bank window as always")
local function bankOff()
    atBank()
    M:Set("bank", false)
    expect(bank()).never.toBeShown()
    expect(BankFrame:GetAlpha()).toBe(1)
    mock.fireEvent("BANKFRAME_CLOSED")
    M:Set("bank", true)
end

