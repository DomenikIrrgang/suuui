-- Units/Bags: SuuUI's bags and bank windows, the module itself (its parts
-- are tested in Bags/*: the windows opening and closing in Windows, the
-- rails in Rails, the secure use in Use, other characters in Saved, the sort
-- in SortRun and Sort, the game's bags read in Containers, the characters'
-- data in Characters). Which bags show; the slots (items, free counts, the
-- reagent bag, keyring and special bag sections, updates, cooldowns, quest
-- marks, slot buttons made ahead); the backpack's currencies in the foot;
-- the search across both windows and all characters; selling junk; the
-- settings rows, the preview, a theme; saving and turning off; the bank's
-- tabs, its cooldowns and its close.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as secret from "wowlua:secret"
import type SlotSection from "/UI/Inventory"
import internal M, SECTION, familyName, isSpecialBag from "/Units/Bags"
import * as containers from "/Units/Bags/Containers"
import * as ahead from "/Core/Ahead"
import expectNoErrors, newParent from "../../helpers"
import themeChanged from "../SettingsUI/UiSettingsHelpers"
import start as startBags, cleanup as cleanupBags, CLOTH, POTION, RAG, HERB, KEY, inv, bank, open, metaText, shownSlots, button, itemAt, shown, run, bankRail, atBank, OTHER, others, who, all from "./Bags/BagsHelpers"

@beforeEach
local function start()
    startBags()
end

@afterEach
local function cleanup()
    cleanupBags()
end

@test("the bags shown: the backpack and four bags, the reagent bag, the keyring (on unless turned off)")
local function bagList()
    expect(M:Bags()).toEqual({ 0, 1, 2, 3, 4, 5, -1 })
    M:Set("reagentBag", false)
    expect(M:Bags()).toEqual({ 0, 1, 2, 3, 4, -1 })
    M:Set("keyring", false)
    expect(M:Bags()).toEqual({ 0, 1, 2, 3, 4 })
end

@test(
    "an item that starts a quest has the yellow mark; one whose quest you have, and the others, don't; taken, it goes"
)
local function questStart()
    local NOTE = 990031
    mock.defineItem(NOTE, { name = "Torn Note", quality = 1, stackCount = 1, icon = 134939, classID = 12 }, {
        cached = true,
    })
    local function bagWith(active: boolean)
        mock.setBag(0, {
            slots = 16,
            items = {
                [1] = { id = CLOTH, count = 3 },
                [3] = { id = NOTE, questItem = true, questID = 9401, questActive = active },
                [4] = { id = NOTE, questItem = true, questID = 9402, questActive = true },
            },
        })
    end
    bagWith(false)
    open()
    local function marked(slot: number): boolean
        local skin = M.skins[button(0, slot)]
        local mark = skin and skin.questMark
        return mark ~= nil and mark:IsShown()
    end
    expect(shown(0, 3).questStart).toBe(true)
    expect(marked(3)).toBe(true)
    expect(marked(4)).toBe(false)
    expect(marked(1)).toBe(false)
    -- the quest taken (the note stays): no mark
    bagWith(true)
    mock.fireEvent("QUEST_ACCEPTED", 9401)
    mock.advanceFrames(2)
    expect(marked(3)).toBe(false)
    -- dropped again: back
    bagWith(false)
    mock.fireEvent("QUEST_REMOVED", 9401, false)
    mock.advanceFrames(2)
    expect(marked(3)).toBe(true)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- Slots
--------------------------------------------------------------------------------

@test("every bag's slots in one grid: the items, how many are free")
local function slots()
    open()
    expect(#shownSlots() >= 16).toBe(true)
    expect(metaText():find(" free of ", 1, true) ~= nil).toBe(true)
    expect(shown(0, 1).count).toBe(3)
    expect(shown(0, 2).quality).toBe("uncommon")
    expect(itemAt(0, 3)).toBe(nil)
    -- a bag that shrank: its extra slots hidden
    mock.setBag(0, { slots = 12, items = { [1] = { id = CLOTH, count = 3 } } })
    mock.advanceTime(0.1)
    expect(button(0, 16)).never.toBeShown()
end

@test("the reagent bag and the keyring as sections of their own; no reagent bag says where one goes")
local function sections()
    local laid: SlotSection[] = {}
    local slotsLaid: Button[] = {}
    mock.stub(inv(), "LayoutSlots", function(_: unknown, list: Button[], s: SlotSection[]?)
        laid = s or {}
        slotsLaid = list
    end)
    -- the keyring's buttons the window lays out, by slot
    local function keyringLaid(): number[]
        local out: number[] = {}
        for slot, b in pairs(M.buttons[-1] or {}) do
            for _, x in ipairs(slotsLaid) do
                if x == b then
                    out[#out + 1] = slot
                end
            end
        end
        table.sort(out)
        return out
    end
    open()
    expect(laid[1].note).toBe("No reagent bag · the reagent slot takes one")
    mock.setBag(5, { slots = 8, items = { [1] = { id = HERB, count = 4 } } })
    -- a keyring of twelve slots, two of them holding keys: only those show
    -- (asked: not the empty ones), the section counting the keys
    mock.setBag(-1, { slots = 12, items = { [2] = { id = KEY, count = 1 }, [5] = { id = KEY, count = 1 } } })
    M:Refresh()
    expect(laid[1].label).toBe("Reagents")
    expect(laid[1].meta).toBe("8 · 7 free")
    expect(laid[2].label).toBe("Keyring")
    expect(laid[2].meta).toBe("2")
    expect(keyringLaid()).toEqual({ 2, 5 })
    -- the keyring isn't in the free count
    expect(metaText()).toBe("14 free of 16")
    -- a third key: shown at once (a bag update lays the window out again)
    mock.setBag(-1, {
        slots = 12,
        items = { [2] = { id = KEY, count = 1 }, [5] = { id = KEY, count = 1 }, [9] = { id = KEY, count = 1 } },
    })
    M:Refresh()
    expect(laid[2].meta).toBe("3")
    expect(keyringLaid()).toEqual({ 2, 5, 9 })
    -- no keys: no keyring section
    mock.setBag(-1, { slots = 12 })
    M:Refresh()
    expect(#laid).toBe(1)
    expect(keyringLaid()).toEqual({})
    expect(button(-1, 2)).never.toBeShown()
end

@test("the currencies shown on the backpack: in the foot by the gold, on your own bags; updated as they change")
local function backpackCurrencies()
    local watched: { iconFileID: number, quantity: number }[] = {
        { iconFileID = 463446, quantity = 12 },
        { iconFileID = 133784, quantity = 340 },
    }
    mock.fake("C_CurrencyInfo.GetBackpackCurrencyInfo", function(i: number): unknown
        return watched[i]
    end)
    open()
    expect(inv().currencies[1]).toBeShown()
    expect(inv().currencies[2]).toBeShown()
    expect(inv().currencyTexts[2]:GetText()).toBe("340")
    -- marked in the Currency tab with the bags open: no event, the game's box
    -- calls SetCurrencyBackpack (it showed only once the bags were opened
    -- again: found in game)
    watched[3] = { iconFileID = 236521, quantity = 7 }
    C_CurrencyInfo.SetCurrencyBackpack(3, true)
    mock.advanceFrames(1)
    expect(inv().currencies[3]).toBeShown()
    expect(inv().currencyTexts[3]:GetText()).toBe("7")
    -- one unmarked (the Currency tab): gone at the next update
    watched = { { iconFileID = 463446, quantity = 15 } }
    mock.fireEvent("CURRENCY_DISPLAY_UPDATE")
    expect(inv().currencies[1]).toBeShown()
    expect(inv().currencyTexts[1]:GetText()).toBe("15")
    expect(inv().currencies[2]).never.toBeShown()
    -- a click opens the Currency tab (out of combat)
    local toggled = mock.fake("ToggleCharacter", function(_: string) end)
    mock.click(inv().currencies[1])
    expect(toggled).toHaveBeenCalledWith("TokenFrame")
    -- none marked: none shown
    watched = {}
    mock.fireEvent("CURRENCY_DISPLAY_UPDATE")
    expect(inv().currencies[1]).never.toBeShown()
end

@test("a quiver, a soul or profession bag: a section of its own after your bags, not in the free count")
local function specialBags()
    local laid: SlotSection[] = {}
    mock.stub(inv(), "LayoutSlots", function(_: unknown, _: unknown, s: SlotSection[]?)
        laid = s or {}
    end)
    mock.setBag(1, { slots = 10 })
    mock.setBag(2, { slots = 12, items = { [1] = { id = CLOTH, count = 2 } } })
    local real = C_Container.GetContainerNumFreeSlots
    -- (bag 2 a quiver: its family 1)
    mock.stub(C_Container, "GetContainerNumFreeSlots", function(bag: number): (number?, number?)
        if bag == 2 then
            return 11, 1
        end
        return real(bag)
    end)
    open()
    local general = C_Container.GetContainerNumSlots(0) + 10 + C_Container.GetContainerNumSlots(3) +
        C_Container.GetContainerNumSlots(4)
    local quiver = laid[1]
    expect(quiver.label).toBe("Quiver")
    expect(quiver.meta).toBe("12 · 11 free")
    -- after the general bags (bag 3 and 4 before it)
    expect(quiver.at).toBe(general + 1)
    -- the window's count: the general bags only
    expect(metaText():find(" of " .. general, 1, true) ~= nil).toBe(true)
    mock.setBag(1, nil)
    mock.setBag(2, nil)
end

@test("a bag's update, a lock and a cooldown redraw its slots")
local function updates()
    open()
    mock.setBag(0, {
        slots = 16,
        items = { [1] = { id = CLOTH, count = 9 }, [2] = { id = POTION, count = 2, locked = true } },
    })
    mock.fireEvent("BAG_UPDATE", 0)
    expect(shown(0, 1).count).toBe(9)
    mock.fireEvent("ITEM_LOCK_CHANGED", 0, 2)
    expect(shown(0, 2).locked).toBe(true)
    -- a cooldown: only the sweeps of slots with an item, no slot drawn again
    local slots = mock.stub(M, "UpdateSlot", M.UpdateSlot)
    local sweeps = mock.stub(M, "SlotCooldown", M.SlotCooldown)
    mock.setItemCooldown(POTION, 60, 30)
    mock.fireEvent("BAG_UPDATE_COOLDOWN")
    expect(slots).toHaveBeenCalledTimes(0)
    expect(sweeps).toHaveBeenCalled()
    local cd = assert(frames.asCooldown(tbl.field(button(0, 2), "Cooldown")))
    expect(select(2, cd:GetCooldownTimes()) > 0).toBe(true)
    mock.fireEvent("BAG_UPDATE", mock.secret(0)) -- unreadable: nothing
    mock.fireEvent("ITEM_LOCK_CHANGED", 16) -- a worn item's: not a bag slot
end

@test("an item looted: its slot and the counts drawn, the slots not laid out again; a new size lays them out")
local function lightUpdate()
    open()
    local before = metaText()
    local layouts = mock.spy(inv().LayoutSlots)
    mock.stub(inv(), "LayoutSlots", layouts)
    mock.setBag(0, {
        slots = 16,
        items = { [1] = { id = CLOTH, count = 3 }, [2] = { id = POTION, count = 2 }, [3] = { id = HERB, count = 4 } },
    })
    expect(shown(0, 3).count).toBe(4)
    expect(metaText()).never.toBe(before)
    expect(layouts).never.toHaveBeenCalled()
    -- a bigger backpack: every slot laid out again
    mock.setBag(0, { slots = 20, items = { [1] = { id = CLOTH, count = 3 } } })
    expect(layouts).toHaveBeenCalledTimes(1)
    expect(button(0, 20)).toBeShown()
    expect(itemAt(0, 3)).toBe(nil)
end

@test("a new bag's slot buttons are made ahead while the window is closed: a few a frame, none in combat")
local function slotsAhead()
    -- (what the login queued to build ahead, done: the bags' job alone)
    ahead.finish()
    local had = C_Container.GetContainerNumSlots(4)
    mock.setBag(4, nil)
    local made = #(M.buttons[4] or {})
    mock.player:enterCombat()
    mock.setBag(4, { slots = made + 7 })
    mock.advanceFrames(5, 1000 / 60)
    expect(#(M.buttons[4] or {})).toBe(made)
    mock.player:leaveCombat()
    -- on again a moment after the fight: three a frame
    mock.advanceFrames(70, 1000 / 60)
    expect(#(M.buttons[4] or {})).toBe(made + 7)
    -- (out of combat at once: the first frame makes three)
    mock.setBag(4, nil)
    mock.setBag(4, { slots = made + 11 })
    mock.advanceFrames(1, 1000 / 60)
    expect(#(M.buttons[4] or {})).toBe(made + 10)
    mock.advanceFrames(1, 1000 / 60)
    expect(#(M.buttons[4] or {})).toBe(made + 11)
    -- (bag 4 as it was)
    mock.setBag(4, had > 0 and { slots = had } or nil)
    expectNoErrors()
end

@test("the search: the game's item search on your bags; All characters lists what everyone carries")
local function searching()
    others()
    open()
    local set = mock.stub(C_Container, "SetItemSearch", function(_: string) end)
    run(inv().search.onTextChanged, "cloth")
    expect(set).toHaveBeenCalledWith("cloth")
    expect(bank().search:GetValue()).toBe("cloth")
    all().value = true
    run(all().onChange, true)
    mock.advanceTime(0.2)
    expect(M:ShowingResults()).toBe(true)
    expect(metaText():find("item", 1, true) ~= nil).toBe(true)
    local rows = inv().resultRows or {}
    local row = rows[1]
    if row then
        run(row.onEnter, row)
        run(row.onLeave, row)
    end
    -- closing ends the search
    all().value = false
    M:SetOpen(false)
    expect(inv().search:GetValue()).toBe("")
    -- another character's bags with a search dim what doesn't match
    open()
    run(who().onChange, OTHER)
    run(inv().search.onTextChanged, "potion")
    mock.advanceTime(0.2)
end

--------------------------------------------------------------------------------
-- Sell junk
--------------------------------------------------------------------------------

@test("at a vendor with grey items: Sell junk, one a moment, until none is left")
local function junk()
    mock.setBag(0, {
        slots = 16,
        items = {
            [1] = { id = RAG, count = 2 },
            [2] = { id = RAG, count = 1, locked = true },
            [3] = { id = CLOTH, count = 1 },
        },
    })
    open()
    mock.openMerchant({ name = "Vendor", items = {} })
    mock.advanceTime(0.2)
    expect(M:Junk()).toBe(1)
    local used: number[] = {}
    mock.stub(C_Container, "UseContainerItem", function(bag: number, slot: number)
        used[#used + 1] = bag * 100 + slot
    end)
    M:SellJunk()
    M:SellJunk() -- selling already: once
    mock.advanceTime(0.21)
    expect(used).toEqual({ 1 })
    mock.setBag(0, { slots = 16, items = { [3] = { id = CLOTH, count = 1 } } })
    mock.advanceTime(0.21)
    expect(M.selling).toBe(nil)
    mock.closeMerchant()
end

