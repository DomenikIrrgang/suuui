@test("the preview, the sort's tooltip, the columns, a theme")
local function settingsRest()
    local preview = assert(SECTION.preview)(newParent(400, 400))
    expect(preview).toBe(M:PreviewView(newParent(400, 400)))
    M:Set("sortDirection", "start")
    local description = secret.asString(tbl.field(inv().sort.tip, "description")) or ""
    expect(description:find("the start", 1, true) ~= nil).toBe(true)
    open()
    M:Set("columns", 12)
    themeChanged()
    M:Set("reagentBag", false)
    expect(inv()).toBeShown()
end

@test("money and the gear are saved for your other characters; off, both windows close")
local function saved()
    mock.player:setMoney(4242)
    mock.fireEvent("PLAYER_MONEY")
    expect(M:Char().money).toBe(4242)
    mock.fireEvent("PLAYER_EQUIPMENT_CHANGED", 1, false)
    mock.advanceTime(1.1)
    expect(type(M:Char().equipped)).toBe("table")
    mock.fireEvent("PLAYER_LOGOUT")
    open()
    M:OnDisable()
    expect(inv()).never.toBeShown()
end

@test("the bank: its tabs without the game's list, a bank slot's bag picked up, closing, its slots' cooldowns")
local function bankMore()
    atBank({
        tabs = {
            { name = "Tab 1", slots = 28, items = {} },
            { name = "Tab 2", slots = 20, icon = 133639, items = {} },
        },
    })
    mock.stub(C_Bank, "FetchPurchasedBankTabIDs", function(_: number): number[]
        return {}
    end)
    expect(#M:BankBags() >= 1).toBe(true)
    mock.fireEvent("BAG_UPDATE_COOLDOWN")
    -- a bought bank slot: picked up or swapped (the bank's own slots are fixed)
    local picked = mock.stub(C_Container, "PickupContainerItem", function(_: number, _: number) end)
    local cells = tbl.filter(bankRail().cells, function(c): boolean
        local e = c.entry
        return c:IsShown() and e ~= nil and (e.tab or 0) > 1
    end)
    local cell = cells[#cells]
    if cell then
        mock.script(cell, "OnClick", "LeftButton")
        mock.script(cell, "OnDragStart")
        expect(picked).toHaveBeenCalledTimes(2)
    end
    -- the window's close: the game's bank closes
    local closed = mock.stub(C_Bank, "CloseBankFrame", function() end)
    run(bank().onClose)
    expect(closed).toHaveBeenCalledTimes(1)
    mock.setField(C_Bank, "CloseBankFrame", nil) -- an older client: the global
    local global = mock.stub(_G, "CloseBankFrame", function() end)
    run(bank().onClose)
    expect(global).toHaveBeenCalledTimes(1)
    expect(closed).toHaveBeenCalledTimes(1)
    mock.fireEvent("BANKFRAME_CLOSED")
end

@test("familyName and isSpecialBag: Bags/Containers' under the module's names")
local function reexports()
    expect(familyName(4)).toBe(containers.familyName(4))
    expect(familyName(1024)).toBe("Mining bag")
    expect(isSpecialBag(0)).toBe(false)
    expect(isSpecialBag(1)).toBe(containers.isSpecialBag(1))
    expectNoErrors()
end
