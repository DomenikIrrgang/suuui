        local all: { [string]: { [string]: unknown } } = {}
        for k, v in pairs(real(M)) do
            all[k] = v
        end
        all[OTHER] = {
            name = "Otherplayer",
            realm = GetRealmName(),
            class = "MAGE",
            level = 50,
            money = 123456,
            seen = time() - 3600,
            bags = {
                slots = {
                    { t = 132889, c = 4, q = 1, l = "|cffffffff|Hitem:" .. CLOTH .. "::::::::|h[Test Cloth]|h|r" },
                    false,
                },
                size = 2,
                free = 1,
                seen = time() - 3600,
            },
            bank = {
                slots = {
                    { t = 134830, c = 1, q = 2, l = "|cff1eff00|Hitem:" .. POTION .. "::::::::|h[Test Potion]|h|r" },
                },
                size = 1,
                free = 0,
                seen = time() - 7200,
            },
            equipped = {},
        }
        return all
    end)
end

