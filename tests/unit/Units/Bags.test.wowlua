@test("the search: the game's item search on your bags; All characters lists what everyone carries")
local function searching()
    others()
    open()
    local set = mock.stub(C_Container, "SetItemSearch", function(_: string) end)
    run(inv().search.onTextChanged, "cloth")
    expect(set).toHaveBeenCalledWith("cloth")
    expect(bank().search:GetValue()).toBe("cloth")
    all().value = true
    run(all().onChange, true)
    mock.advanceTime(0.2)
    expect(M:ShowingResults()).toBe(true)
    expect(metaText():find("item", 1, true) ~= nil).toBe(true)
    local rows = inv().resultRows or {}
    local row = rows[1]
    if row then
        run(row.onEnter, row)
        run(row.onLeave, row)
    end
    -- closing ends the search
    all().value = false
    M:SetOpen(false)
    expect(inv().search:GetValue()).toBe("")
    -- another character's bags with a search dim what doesn't match
    open()
    run(who().onChange, OTHER)
    run(inv().search.onTextChanged, "potion")
    mock.advanceTime(0.2)
end

@test("item counts: which characters have how many, where, and the total")
local function counts()
    others()
    M:SaveMe()
    local lines: string[] = {}
    local tip: GameTooltip = mock.partial({
        AddLine = function(_: unknown, t: string)
            lines[#lines + 1] = t
        end,
        AddDoubleLine = function(_: unknown, l: string, r: string)
            lines[#lines + 1] = l .. " | " .. r
        end,
        Show = function(_: unknown) end,
    })
    M:AddCounts(tip, { id = CLOTH })
    expect(hasLine(lines, "Bags 3")).toBe(true)
    expect(hasLine(lines, "Bags 4")).toBe(true)
    expect(hasLine(lines, "Total | ")).toBe(true)
    lines = {}
    M:AddCounts(tip, { id = 1 }) -- nobody has it
    M:AddCounts(tip, { id = mock.secret(CLOTH) })
    M:Set("itemCounts", false)
    M:AddCounts(tip, { id = CLOTH })
    expect(#lines).toBe(0)
end

