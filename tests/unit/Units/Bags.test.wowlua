-- Units/Bags: SuuUI's bags and bank windows (the sort planning and the
-- characters' data are Bags/Sort's and Bags/Characters', tested there).
-- Which bags show; opening and closing with Blizzard's bag calls (opened
-- for a window and closed with it, one bag closing); the slots (items,
-- free counts, the reagent bag and keyring sections, updates, cooldowns);
-- the bag rails (cells, tooltips, lighting a bag's slots, putting a bag in
-- and taking it off); the bank (its window beside the bags, its rail and
-- the buy cell, Blizzard's frame off screen or back); other characters'
-- saved bags and bank, the search across all of them; item counts in
-- tooltips; selling junk; sorting (SuuUI's waves, the game's sort, what
-- stops one); the settings rows; Blizzard's bag frames kept hidden.

import test, expect, beforeEach, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as secret from "wowlua:secret"
import type Inventory, SlotItem, SlotSection from "/UI/Inventory"
import type SortSlot from "/Units/Bags/Sort"
import internal M, SECTION, familyName from "/Units/Bags"
import * as sort from "/Units/Bags/Sort"
import * as ahead from "/Core/Ahead"
import expectNoErrors, newParent from "../../helpers"
import printedSince, printedCount, hasLine, themeChanged from "../SettingsUI/UiSettingsHelpers"

local CLOTH, POTION, RAG, HERB = 990021, 990022, 990023, 990024
mock.defineItem(CLOTH, {
    name = "Test Cloth",
    quality = 1,
    stackCount = 20,
    icon = 132889,
    classID = 7,
    sellPrice = 10,
}, { cached = true })
mock.defineItem(POTION, {
    name = "Test Potion",
    quality = 2,
    stackCount = 5,
    icon = 134830,
    classID = 0,
    sellPrice = 50,
}, { cached = true })
mock.defineItem(RAG, { name = "Grey Rag", quality = 0, stackCount = 20, icon = 133722, classID = 15, sellPrice = 25 }, {
    cached = true,
})
mock.defineItem(HERB, { name = "Test Herb", quality = 1, stackCount = 20, icon = 134187, classID = 7, sellPrice = 5 }, {
    cached = true,
})

@beforeEach
local function start()
    mock.setBag(0, { slots = 16, items = { [1] = { id = CLOTH, count = 3 }, [2] = { id = POTION, count = 2 } } })
end

@afterEach
local function cleanup()
    if M.sorting then
        M:StopSort("the test ended")
    end
    ClearCursor()
    mock.setBag(5, nil) -- (the reagent bag one test filled)
    M:SetOpen(false)
    mock.advanceTime(0.5)
    M:ResetAll({
        "columns",
        "reagentBag",
        "keyring",
        "bank",
        "itemCounts",
        "bagSlots",
        "sortOrder",
        "sortDirection",
        "position",
    })
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    mock.advanceTime(1)
    expectNoErrors()
end

local function inv(): Inventory
    local i = M.inv
    assert(i, "no bags window")
    return i
end
local function bank(): Inventory
    local b = M.bank
    assert(b, "no bank window")
    return b
end

-- One of the game's frames by name.
local function frame(name: string): Frame
    local f = frames.find(name)
    assert(f, "no " .. name)
    return f
end

-- One of the game's functions by name, called.
local function call(name: string, ...: unknown)
    local fn = tbl.field(_G, name)
    assert(type(fn) == "function", "no " .. name)
    ;(fn :: (...unknown) -> ())(...)
end

local function open()
    M:SetOpen(true)
    mock.advanceTime(0.01)
end

-- The bags window's header meta ("18 free of 80").
local function metaText(): string
    local m = inv().meta
    assert(m, "no header meta")
    return m:GetText() or ""
end

local function shownSlots(): Button[]
    local out: Button[] = {}
    for _, slots in pairs(M.buttons) do
        for _, b in ipairs(slots) do
            if b:IsShown() then
                out[#out + 1] = b
            end
        end
    end
    return out
end

local function button(bag: number, slot: number): Button
    local list = M.buttons[bag]
    local b = list and list[slot]
    assert(b, "no slot " .. bag .. "/" .. slot)
    return b
end

-- What a slot shows (nil: empty).
local function itemAt(bag: number, slot: number): SlotItem?
    local skin = M.skins[button(bag, slot)]
    return skin and skin.item
end

local function shown(bag: number, slot: number): SlotItem
    local it = itemAt(bag, slot)
    assert(it, "nothing in " .. bag .. "/" .. slot)
    return it
end

local function run<A...>(fn: ((A...) -> ())?, ...: A...)
    assert(fn, "nothing to run")
    fn(...)
end

--------------------------------------------------------------------------------
-- Which bags, opening and closing
--------------------------------------------------------------------------------

@test("the bags shown: the backpack and four bags, the reagent bag, the keyring (on unless turned off)")
local function bagList()
    expect(M:Bags()).toEqual({ 0, 1, 2, 3, 4, 5, -1 })
    M:Set("reagentBag", false)
    expect(M:Bags()).toEqual({ 0, 1, 2, 3, 4, -1 })
    M:Set("keyring", false)
    expect(M:Bags()).toEqual({ 0, 1, 2, 3, 4 })
end

@test("Blizzard's bag calls open and close the window; a toggle, the close button, Toggle")
local function openClose()
    call("ToggleAllBags")
    mock.advanceTime(0.01)
    expect(inv()).toBeShown()
    call("ToggleAllBags")
    mock.advanceTime(0.01)
    expect(inv()).never.toBeShown()
    call("OpenBackpack")
    mock.advanceTime(0.01)
    expect(inv()).toBeShown()
    call("CloseBag", 1) -- one bag taken off: the window stays
    mock.advanceTime(0.01)
    expect(inv()).toBeShown()
    run(inv().onClose)
    expect(inv()).never.toBeShown()
    M:Toggle()
    expect(inv()).toBeShown()
    call("CloseBackpack")
    mock.advanceTime(0.01)
    expect(inv()).never.toBeShown()
end

@test("opened for a window (a vendor, the mail), it closes with it, unless it was open before")
local function openedFor()
    local mail = frame("MailFrame")
    call("OpenAllBags", mail)
    mock.advanceTime(0.01)
    expect(inv()).toBeShown()
    call("CloseAllBags", frame("MerchantFrame")) -- another window: stays
    mock.advanceTime(0.01)
    expect(inv()).toBeShown()
    call("CloseAllBags", mail)
    mock.advanceTime(0.01)
    expect(inv()).never.toBeShown()
    open()
    call("OpenAllBags", mail) -- open already: not the mail's
    call("CloseAllBags", mail)
    mock.advanceTime(0.01)
    expect(inv()).toBeShown()
end

--------------------------------------------------------------------------------
-- Slots
--------------------------------------------------------------------------------

@test("every bag's slots in one grid: the items, how many are free")
local function slots()
    open()
    expect(#shownSlots() >= 16).toBe(true)
    expect(metaText():find(" free of ", 1, true) ~= nil).toBe(true)
    expect(shown(0, 1).count).toBe(3)
    expect(shown(0, 2).quality).toBe("uncommon")
    expect(itemAt(0, 3)).toBe(nil)
    -- a bag that shrank: its extra slots hidden
    mock.setBag(0, { slots = 12, items = { [1] = { id = CLOTH, count = 3 } } })
    mock.advanceTime(0.1)
    expect(button(0, 16)).never.toBeShown()
end

@test(
    "a sort's bags by what they take: a profession bag in the reagent slot only its kind; a bag the game counts as any, by its own item"
)
local function sortFamilies()
    local LEATHER, HERBS = 8, 32
    mock.setBag(1, { slots = 4 })
    mock.setBag(5, { slots = 4 })
    local free: { [number]: number } = { [5] = LEATHER }
    mock.fake("C_Container.GetContainerNumFreeSlots", function(bag: number): (number, number)
        return 4, free[bag] or 0
    end)
    -- bag 1's item: a herb bag (the game's count says 0)
    mock.fake("GetInventoryItemID", function(_: string, slot: number): number?
        return slot == C_Container.ContainerIDToInventoryID(1) and 990090 or nil
    end)
    mock.fake("C_Item.GetItemFamily", function(id: unknown): number
        return id == 990090 and HERBS or 0
    end)
    local function familyAt(bag: number): sort.Family?
        for _, s in ipairs(M:SortSlots(false)) do
            if s.bag == bag then
                return s.family
            end
        end
        return nil
    end
    expect(familyAt(5)).toBe(LEATHER)
    expect(familyAt(1)).toBe(HERBS)
    expect(familyAt(0)).toBe(0)
    -- a family SuuUI has no name for (a skinning bag, reported by a
    -- player): still only its own kind
    free[5] = 0x200000
    expect(familyAt(5)).toBe(0x200000)
    -- a reagent bag (no family of its own, probed in game): any crafting reagent
    free[5] = nil
    expect(familyAt(5)).toBe("reagent")
    mock.setBag(1, nil)
    mock.setBag(5, nil)
end

@test(
    "a move the game refused: the bag at its end that isn't a plain one is left out of sorts from then on, said once (reported by a player)"
)
local function refusedBag()
    local SKIN = 990096
    mock.setBag(1, { slots = 4 })
    mock.fake("GetInventoryItemID", function(_: string, slot: number): number?
        return slot == C_Container.ContainerIDToInventoryID(1) and SKIN or nil
    end)
    local real = C_Item.GetItemInfoInstant
    mock.fake("C_Item.GetItemInfoInstant", function(id: number): ...unknown
        if id == SKIN then
            -- a container, not a plain bag (a profession bag)
            return SKIN, "Container", "Leatherworking Bag", "INVTYPE_BAG", 133640, 1, 7
        end
        return real(id)
    end)
    local before = #mock.printed()
    -- the backpack's cloth sent to bag 1; it didn't land there
    local from: SortSlot = { bag = 0, slot = 1, family = 0, item = { id = CLOTH, count = 3 } :: sort.SortItem }
    local to: SortSlot = { bag = 1, slot = 2, family = 0 }
    expect(M:Refused({ { from = from, to = to } })).toBe(true)
    expect(M.refusingBags[SKIN]).toBe(true)
    expect(hasLine(printedSince(before), "leaves your")).toBe(true)
    for _, s in ipairs(M:SortSlots(false)) do
        expect(s.bag).never.toBe(1)
    end
    -- the same again: nothing more to blame, nothing said
    before = #mock.printed()
    expect(M:Refused({ { from = from, to = to } })).toBe(false)
    expect(#printedSince(before)).toBe(0)
    -- only plain bags at both ends: nobody to blame (the sort stops as before)
    M.refusingBags = {}
    mock.fake("C_Item.GetItemInfoInstant", function(id: number): ...unknown
        if id == SKIN then
            return SKIN, "Container", "Bag", "INVTYPE_BAG", 133640, 1, 0
        end
        return real(id)
    end)
    expect(M:Refused({ { from = from, to = to } })).toBe(false)
    mock.setBag(1, nil)
end

@test("the reagent bag and the keyring as sections of their own; no reagent bag says where one goes")
local function sections()
    local laid: SlotSection[] = {}
    mock.stub(inv(), "LayoutSlots", function(_: unknown, _: unknown, s: SlotSection[]?)
        laid = s or {}
    end)
    open()
    expect(laid[1].note).toBe("No reagent bag · the reagent slot takes one")
    mock.setBag(5, { slots = 8, items = { [1] = { id = HERB, count = 4 } } })
    M:Set("keyring", true)
    mock.stub(C_Container, "GetContainerNumSlots", function(bag: number): number
        if bag == -1 then
            return 4
        end
        if bag == 0 then
            return 16
        end
        if bag == 5 then
            return 8
        end
        return 0
    end)
    M:Refresh()
    expect(laid[1].label).toBe("Reagents")
    expect(laid[1].meta).toBe("8 · 7 free")
    expect(laid[2].label).toBe("Keyring")
end

@test("a quiver, a soul or profession bag: a section of its own after your bags, not in the free count")
local function specialBags()
    local laid: SlotSection[] = {}
    mock.stub(inv(), "LayoutSlots", function(_: unknown, _: unknown, s: SlotSection[]?)
        laid = s or {}
    end)
    mock.setBag(1, { slots = 10 })
    mock.setBag(2, { slots = 12, items = { [1] = { id = CLOTH, count = 2 } } })
    local real = C_Container.GetContainerNumFreeSlots
    -- (bag 2 a quiver: its family 1)
    mock.stub(C_Container, "GetContainerNumFreeSlots", function(bag: number): (number?, number?)
        if bag == 2 then
            return 11, 1
        end
        return real(bag)
    end)
    open()
    local general = C_Container.GetContainerNumSlots(0) + 10 + C_Container.GetContainerNumSlots(3) +
        C_Container.GetContainerNumSlots(4)
    local quiver = laid[1]
    expect(quiver.label).toBe("Quiver")
    expect(quiver.meta).toBe("12 · 11 free")
    -- after the general bags (bag 3 and 4 before it)
    expect(quiver.at).toBe(general + 1)
    -- the window's count: the general bags only
    expect(metaText():find(" of " .. general, 1, true) ~= nil).toBe(true)
    mock.setBag(1, nil)
    mock.setBag(2, nil)
end

@test("familyName: each special bag's kind")
@cases({
    { 1, "Quiver" },
    { 2, "Ammo pouch" },
    { 4, "Soul bag" },
    { 32, "Herb bag" },
    { 64, "Enchanting bag" },
    { 1024, "Mining bag" },
    { 4096, "Special bag" },
})
local function families(family: number, out: string)
    expect(familyName(family)).toBe(out)
end

@test("a bag's update, a lock and a cooldown redraw its slots")
local function updates()
    open()
    mock.setBag(0, {
        slots = 16,
        items = { [1] = { id = CLOTH, count = 9 }, [2] = { id = POTION, count = 2, locked = true } },
    })
    mock.fireEvent("BAG_UPDATE", 0)
    expect(shown(0, 1).count).toBe(9)
    mock.fireEvent("ITEM_LOCK_CHANGED", 0, 2)
    expect(shown(0, 2).locked).toBe(true)
    -- a cooldown: only the sweeps of slots with an item, no slot drawn again
    local slots = mock.stub(M, "UpdateSlot", M.UpdateSlot)
    local sweeps = mock.stub(M, "SlotCooldown", M.SlotCooldown)
    mock.setItemCooldown(POTION, 60, 30)
    mock.fireEvent("BAG_UPDATE_COOLDOWN")
    expect(slots).toHaveBeenCalledTimes(0)
    expect(sweeps).toHaveBeenCalled()
    local cd = assert(frames.asCooldown(tbl.field(button(0, 2), "Cooldown")))
    expect(select(2, cd:GetCooldownTimes()) > 0).toBe(true)
    mock.fireEvent("BAG_UPDATE", mock.secret(0)) -- unreadable: nothing
    mock.fireEvent("ITEM_LOCK_CHANGED", 16) -- a worn item's: not a bag slot
end

@test("an item looted: its slot and the counts drawn, the slots not laid out again; a new size lays them out")
local function lightUpdate()
    open()
    local before = metaText()
    local layouts = mock.spy(inv().LayoutSlots)
    mock.stub(inv(), "LayoutSlots", layouts)
    mock.setBag(0, {
        slots = 16,
        items = { [1] = { id = CLOTH, count = 3 }, [2] = { id = POTION, count = 2 }, [3] = { id = HERB, count = 4 } },
    })
    expect(shown(0, 3).count).toBe(4)
    expect(metaText()).never.toBe(before)
    expect(layouts).never.toHaveBeenCalled()
    -- a bigger backpack: every slot laid out again
    mock.setBag(0, { slots = 20, items = { [1] = { id = CLOTH, count = 3 } } })
    expect(layouts).toHaveBeenCalledTimes(1)
    expect(button(0, 20)).toBeShown()
    expect(itemAt(0, 3)).toBe(nil)
end

@test("a new bag's slot buttons are made ahead while the window is closed: a few a frame, none in combat")
local function slotsAhead()
    -- (what the login queued to build ahead, done: the bags' job alone)
    ahead.finish()
    local had = C_Container.GetContainerNumSlots(4)
    mock.setBag(4, nil)
    local made = #(M.buttons[4] or {})
    mock.player:enterCombat()
    mock.setBag(4, { slots = made + 7 })
    mock.advanceFrames(5, 1000 / 60)
    expect(#(M.buttons[4] or {})).toBe(made)
    mock.player:leaveCombat()
    -- on again a moment after the fight: three a frame
    mock.advanceFrames(70, 1000 / 60)
    expect(#(M.buttons[4] or {})).toBe(made + 7)
    -- (out of combat at once: the first frame makes three)
    mock.setBag(4, nil)
    mock.setBag(4, { slots = made + 11 })
    mock.advanceFrames(1, 1000 / 60)
    expect(#(M.buttons[4] or {})).toBe(made + 10)
    mock.advanceFrames(1, 1000 / 60)
    expect(#(M.buttons[4] or {})).toBe(made + 11)
    -- (bag 4 as it was)
    mock.setBag(4, had > 0 and { slots = had } or nil)
    expectNoErrors()
end

@test("a spell waiting for an item (Disenchant): the left click puts it on the item through the secure button")
local function spellTarget()
    open()
    local targeting = true
    mock.fake("SpellCanTargetItem", function(): boolean
        return targeting
    end)
    local slot = assert(assert(M.buttons[0])[2])
    mock.hover(slot)
    local b = assert(M.useOver).button
    expect(b:GetAttribute("type1")).toBe("macro")
    expect(b:GetAttribute("macrotext1")).toBe("/use 0 2")
    -- the left click: the game's /use of that slot, from Blizzard's secure
    -- code (passed on to the slot from SuuUI's, "Forbidden:
    -- UseContainerItem()", reported in game); not passed on as well
    local ran = mock.spy(function(_: string, _: string) end)
    mock.stub(C_Macro, "RunMacroText", ran)
    mock.click(b)
    expect(ran).toHaveBeenCalledWith("/use 0 2", "LeftButton")
    expect(CursorHasItem()).toBe(false)
    -- the spell gone: the left click the slot's again (the item picked up)
    targeting = false
    mock.fireEvent("CURRENT_SPELL_CAST_CHANGED", false)
    expect(b:GetAttribute("type1")).toBeNil()
    mock.click(b)
    expect(CursorHasItem()).toBe(true)
    ClearCursor()
    mock.hover(nil)
end

@test(
    "the left button goes through SuuUI's secure button to the game's slot (its own drag and drop), except while a spell waits for an item"
)
local function leftThrough()
    open()
    local targeting = false
    mock.fake("SpellCanTargetItem", function(): boolean
        return targeting
    end)
    local slot = assert(assert(M.buttons[0])[2])
    mock.hover(slot)
    local b = assert(M.useOver).button
    expect(b:ShouldButtonPassThrough("LeftButton")).toBe(true)
    expect(b:ShouldButtonPassThrough("RightButton")).toBe(false)
    targeting = true
    mock.fireEvent("CURRENT_SPELL_CAST_CHANGED", false)
    expect(b:ShouldButtonPassThrough("LeftButton")).toBe(false)
    targeting = false
    mock.fireEvent("CURRENT_SPELL_CAST_CHANGED", false)
    expect(b:ShouldButtonPassThrough("LeftButton")).toBe(true)
    mock.hover(nil)
end

@test("drag and drop: an item dragged onto another slot is put there, once (asked in game)")
local function dragDrop()
    open()
    local slots = assert(M.buttons[0])
    -- (what the slots ask the game: the emulated client doesn't move an item
    -- onto an empty slot of its own bag yet, so the calls are what's checked)
    local calls: string[] = {}
    local real = C_Container.PickupContainerItem
    mock.fake("C_Container.PickupContainerItem", function(bag: number, slot: number)
        calls[#calls + 1] = bag .. "/" .. slot
        real(bag, slot)
    end)
    mock.hover(slots[1])
    local b = assert(M.useOver).button
    mock.hover(b)
    -- pressed and moved: picked up
    assert(b:GetScript("OnDragStart"))(b, "LeftButton")
    expect(calls).toEqual({ "0/1" })
    -- the secure button follows the mouse to slot 3; let go there: the game
    -- sends the release as the drop and as a click; put down once
    mock.hover(slots[3])
    mock.hover(b)
    assert(b:GetScript("OnReceiveDrag"))(b)
    assert(b:GetScript("PostClick"))(b, "LeftButton", false)
    expect(calls).toEqual({ "0/1", "0/3" })
    expect(CursorHasItem()).toBe(false)
    -- (the click first, then the drop: the same)
    mock.advanceFrames(2)
    calls = {}
    mock.hover(slots[1])
    mock.hover(b)
    assert(b:GetScript("OnDragStart"))(b, "LeftButton")
    mock.hover(slots[4])
    mock.hover(b)
    assert(b:GetScript("PostClick"))(b, "LeftButton", false)
    assert(b:GetScript("OnReceiveDrag"))(b)
    expect(calls).toEqual({ "0/1", "0/4" })
    -- the secure button left over the slot the drag began on (it didn't follow
    -- the mouse): the drop still goes to the slot under the mouse
    mock.advanceFrames(2)
    calls = {}
    mock.hover(slots[1])
    mock.hover(b)
    assert(b:GetScript("OnDragStart"))(b, "LeftButton")
    mock.hover(slots[3])
    M.useSlot, M.useAt = slots[1], { 0, 1 }
    assert(b:GetScript("OnReceiveDrag"))(b)
    expect(calls).toEqual({ "0/1", "0/3" })
    -- the secure button over an empty slot when the drag begins on an item
    -- (found in game: nothing picked up): taken from the slot under the mouse
    mock.advanceFrames(2)
    ClearCursor()
    calls = {}
    mock.hover(slots[1])
    M.useSlot, M.useAt = slots[9], { 0, 9 }
    assert(b:GetScript("OnDragStart"))(b, "LeftButton")
    expect(calls).toEqual({ "0/1" })
    expect(CursorHasItem()).toBe(true)
    ClearCursor()
    mock.hover(nil)
    -- the release reaching neither (as in game): the left button let go
    -- over slot 3, the item put there by the watch
    mock.advanceFrames(2)
    calls = {}
    local down = true
    mock.fake("IsMouseButtonDown", function(_: string?): boolean
        return down
    end)
    mock.hover(slots[1])
    mock.hover(b)
    assert(b:GetScript("OnDragStart"))(b, "LeftButton")
    mock.advanceFrames(1)
    expect(calls).toEqual({ "0/1" })
    mock.hover(slots[3])
    down = false
    mock.advanceFrames(1)
    expect(calls).toEqual({ "0/1", "0/3" })
    expect(CursorHasItem()).toBe(false)
    -- click and click still works: picked up, then put down
    mock.advanceFrames(2)
    calls = {}
    mock.hover(slots[1])
    mock.hover(b)
    mock.click(b)
    expect(CursorHasItem()).toBe(true)
    mock.hover(slots[2])
    mock.hover(b)
    mock.click(b)
    expect(calls).toEqual({ "0/1", "0/2" })
    ClearCursor()
    mock.hover(nil)
end

@test(
    "out of combat a right click uses the item through a secure button over the hovered slot; the rest goes on to the slot"
)
local function secureUse()
    open()
    local slot = assert(assert(M.buttons[0])[2])
    mock.hover(slot)
    local over = assert(M.useOver)
    local b = over.button
    expect(b).toBeShown()
    expect(M.useSlot).toBe(slot)
    expect(b:GetAttribute("type2")).toBe("macro")
    expect(b:GetAttribute("macrotext2")).toBe("/use 0 2")
    -- the mouse is on it now (it's over the slot): the slot lit, its tooltip
    mock.hover(b)
    expect(GameTooltip:IsOwned(slot)).toBe(true)
    -- the right click: the game's /use of that slot, run by Blizzard's secure
    -- button code (the emulated client's macros don't use items yet)
    local ran = mock.spy(function(_: string, _: string) end)
    mock.stub(C_Macro, "RunMacroText", ran)
    mock.click(b, "RightButton")
    expect(ran).toHaveBeenCalledWith("/use 0 2", "RightButton")
    -- Shift and a right click: Blizzard's own (the secure button runs nothing)
    mock.stub(C_Macro, "RunMacroText", function(_: string, _: string)
        error("a macro ran")
    end)
    mock.setModifiers({ shift = true })
    mock.click(b, "RightButton")
    mock.setModifiers({})
    -- a left click and a drag go on to the slot: the item picked up
    mock.click(b)
    expect(CursorHasItem()).toBe(true)
    ClearCursor()
    -- leaving it: gone
    mock.hover(nil)
    expect(b).never.toBeShown()
    -- in combat it can't come: the slot's own click
    mock.player:enterCombat()
    mock.hover(slot)
    expect(b).never.toBeShown()
    mock.hover(nil)
    mock.player:leaveCombat()
    -- at a vendor or the mailbox, Blizzard's click (sell, attach)
    mock.fireEvent("MERCHANT_SHOW")
    mock.hover(slot)
    expect(b).never.toBeShown()
    mock.hover(nil)
    mock.fireEvent("MERCHANT_CLOSED")
    mock.fireEvent("MAIL_SHOW")
    mock.hover(slot)
    expect(b).never.toBeShown()
    mock.hover(nil)
    mock.fireEvent("MAIL_CLOSED")
    -- shown, then combat starts: hidden
    mock.hover(slot)
    expect(b).toBeShown()
    mock.player:enterCombat()
    expect(b).never.toBeVisible()
    mock.player:leaveCombat()
    expect(b).never.toBeShown()
    mock.hover(nil)
end

