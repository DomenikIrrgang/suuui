-- Units/Readiness: the group's big cooldowns (everyone's own SuuUI shares
-- them by addon message), and the panel that shows them between pulls; how
-- little it sends (only what changed, a question only for those not heard
-- from and only with the panel wanted), what it takes (the group's channels,
-- checked, held to a rate), who left forgotten.

import test, cases, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, game, encodeShare, decodeShare, rowBefore, wanted, roster from "/Units/Readiness"
import expectNoErrors, newParent, cycle, NOTHING from "../../helpers"
import * as comm from "/Core/Comm"
import * as settings from "/Core/Settings"

-- The world around the module: the group, the spells you know. Replaced
-- in the module's `game` table, not in _G (a replacement there taints
-- Blizzard's code that reads it, for the rest of the file).
type World = {
    raid?: boolean,
    group?: boolean,
    lead?: boolean,
    kind?: string,
    members?: { [string]: { name: string?, class: string? } },
}

local SPELLS: { [string]: number } = { Rebirth = 20484, Innervate = 29166, Tranquility = 740 }
local NAMES: { [number]: string } = {
    [20484] = "Rebirth",
    [29166] = "Innervate",
    [740] = "Tranquility",
    [871] = "Shield Wall",
}

local function inWorld(w: World)
    mock.stub(game, "IsInRaid", function(): boolean
        return w.raid == true
    end)
    mock.stub(game, "IsInGroup", function(): boolean
        return w.group == true or w.raid == true
    end)
    mock.stub(game, "UnitIsGroupLeader", function(unit: string): boolean
        return unit == "player" and w.lead == true
    end)
    mock.stub(game, "UnitIsGroupAssistant", function(): boolean
        return false
    end)
    mock.stub(game, "IsInInstance", function(): (boolean, string)
        return w.kind ~= nil and w.kind ~= "none", w.kind or "none"
    end)
    local members = w.members or {}
    mock.stub(game, "UnitExists", function(unit: string): boolean
        return unit == "player" or members[unit] ~= nil
    end)
    mock.stub(game, "UnitIsUnit", function(a: string, b: string): boolean
        return a == b
    end)
    mock.stub(SuuUI, "FullName", function(unit: string?): unknown
        if unit == nil or unit == "player" then
            return "Ayla Dawnfeather"
        end
        local m = members[unit]
        return m and m.name
    end)
    mock.stub(game, "UnitClass", function(unit: string): (string?, string?)
        if unit == "player" then
            return "Druid", "DRUID"
        end
        local m = members[unit]
        return m and m.class, m and m.class
    end)
end

-- Your druid's spells: which you know, and their cooldowns.
local function knowSpells(known: { [number]: boolean }, cooldowns: { [number]: unknown })
    mock.stub(game, "GetSpellInfo", function(name: string): unknown
        local id = SPELLS[name]
        return id and { spellID = id, name = name }
    end)
    mock.stub(game, "IsPlayerSpell", function(id: number): boolean
        return known[id] == true
    end)
    mock.stub(game, "GetSpellCooldown", function(id: number): unknown
        return cooldowns[id]
    end)
    mock.stub(game, "GetSpellName", function(id: number): string?
        return NAMES[id]
    end)
end

-- What went out (prefix, text, channel), through SuuUI's sender: the
-- game's own refuses a party message out of a real group.
local sent: { [number]: unknown }[] = {}
local function captureSends()
    sent = {}
    mock.stub(C_ChatInfo, "SendAddonMessage", function(...: unknown): boolean
        sent[#sent + 1] = { ... }
        return true
    end)
end
local function sentTexts(): string[]
    local out: string[] = {}
    for _, m in ipairs(sent) do
        out[#out + 1] = tostring(m[2])
    end
    return out
end

@beforeEach
local function fresh()
    -- anything queued by an earlier test runs out first
    mock.advanceTime(12)
    M.heard, M.own, M.lastSend, M.shareQueued, M.encounter = nil, nil, nil, nil, nil
    M.members, M.newcomers, M.askedAt, M.shareForced = nil, nil, nil, nil
    comm.comm:forgetSent(M)
    sent = {}
end

@afterEach
local function undo()
    M:Reset("shows")
    M:Reset("position")
    if mock.player then
        mock.player:leaveCombat()
    end
end

--------------------------------------------------------------------------------
-- Pure parts
--------------------------------------------------------------------------------

@test("the share message: ids and whole seconds left")
local function encodes()
    expect(encodeShare({})).toBe("RDY\t")
    expect(encodeShare({ { id = 20484, left = 0 } })).toBe("RDY\t20484:0")
    expect(encodeShare({ { id = 20484, left = 89.4 }, { id = 29166, left = 89.5 } })).toBe("RDY\t20484:89,29166:90")
end

@test("a share message read back: each spell's end from now")
local function decodes()
    local spells = assert(decodeShare("RDY\t20484:0,29166:120", 100))
    expect(#spells).toBe(2)
    expect(spells[1].id).toBe(20484)
    expect(spells[1].endsAt).toBe(100)
    expect(spells[2].id).toBe(29166)
    expect(spells[2].endsAt).toBe(220)
    -- empty, junk between, and not a share at all
    expect(#(assert(decodeShare("RDY\t", 5)))).toBe(0)
    expect(#(assert(decodeShare("RDY\tx:1,7:2", 5)))).toBe(1)
    expect(decodeShare("RDYQ", 5)).toBe(nil)
    expect(decodeShare("MARK\t1", 5)).toBe(nil)
end

@test("the round trip keeps the message format")
local function roundTrip()
    local text = encodeShare({ { id = 740, left = 12 }, { id = 20484, left = 0 } })
    local back = assert(decodeShare(text, 0))
    expect(back[1].id).toBe(740)
    expect(back[1].endsAt).toBe(12)
    expect(back[2].endsAt).toBe(0)
end

@test("the rows' order: ready first, then the soonest, then group order")
local function order()
    local ready1 = { order = 2 }
    local ready2 = { order = 1, endsAt = 0 }
    local soon = { order = 1, endsAt = 50 }
    local later = { order = 0, endsAt = 90 }
    expect(rowBefore(ready1, soon)).toBe(true)
    expect(rowBefore(soon, ready1)).toBe(false)
    expect(rowBefore(soon, later)).toBe(true)
    expect(rowBefore(later, soon)).toBe(false)
    expect(rowBefore(ready2, ready1)).toBe(true)
    expect(rowBefore(ready1, ready2)).toBe(false)
    local tie1, tie2 = { order = 1, endsAt = 50 }, { order = 3, endsAt = 50 }
    expect(rowBefore(tie1, tie2)).toBe(true)
    expect(rowBefore(tie2, tie1)).toBe(false)
end

@test("where the panel is wanted")
@cases({
    { "always", false, "none", true },
    { "off", true, "raid", false },
    { "group", false, "none", false },
    { "group", true, "none", true },
    { "instance", true, "party", true },
    { "instance", true, "raid", true },
    { "instance", true, "none", false },
    { "instance", false, "raid", false },
})
local function wantedCases(shows: string, inGroup: boolean, kind: string, out: boolean)
    expect(wanted(shows, inGroup, kind) and true or false).toBe(out)
end

--------------------------------------------------------------------------------
-- Your own cooldowns
--------------------------------------------------------------------------------

@test("ReadOwn: the class's spells you know, with the time left")
local function readOwn()
    inWorld({})
    local now = GetTime()
    knowSpells({ [20484] = true, [29166] = true }, {
        [20484] = { startTime = now - 10, duration = 600 },
        [29166] = { startTime = now, duration = 1.5 }, -- the global cooldown
    })
    local own = assert(M:ReadOwn())
    expect(#own).toBe(2)
    expect(own[1].id).toBe(20484)
    expect(math.floor(own[1].left + 0.5)).toBe(590)
    expect(own[2].id).toBe(29166)
    expect(own[2].left).toBe(0)
end

@test("ReadOwn: a cooldown long over, a secret one, a secret spell")
local function readOwnEdges()
    inWorld({})
    local now = GetTime()
    knowSpells({ [20484] = true, [29166] = true, [740] = true }, {
        [20484] = { startTime = now - 900, duration = 600 },
        [29166] = mock.secret({ startTime = now, duration = 300 }),
        [740] = { startTime = mock.secret(now), duration = 300 },
    })
    local own = assert(M:ReadOwn())
    expect(#own).toBe(3)
    for _, c in ipairs(own) do
        expect(c.left).toBe(0)
    end
    -- a spell whose ID is secret is left out
    mock.stub(game, "GetSpellInfo", function(name: string): unknown
        return { spellID = name == "Rebirth" and mock.secret(20484) or SPELLS[name] }
    end)
    expect(#(assert(M:ReadOwn()))).toBe(2)
    -- an unknown spell (no info)
    mock.stub(game, "GetSpellInfo", function(): unknown
        return nil
    end)
    expect(#(assert(M:ReadOwn()))).toBe(0)
end

@test("ReadOwn: a class without big cooldowns, an unknown class, combat")
local function readOwnNone()
    inWorld({})
    mock.stub(game, "UnitClass", function(): (string, string)
        return "Rogue", "ROGUE"
    end)
    expect(#(assert(M:ReadOwn()))).toBe(0)
    mock.stub(game, "UnitClass", function(): (string, string)
        return "Monk", "MONK"
    end)
    expect(#(assert(M:ReadOwn()))).toBe(0)
    mock.player:enterCombat()
    expect(M:ReadOwn()).toBe(nil)
end

--------------------------------------------------------------------------------
-- Sending
--------------------------------------------------------------------------------

@test("Send: to the raid or party, never solo or in combat")
local function send()
    captureSends()
    inWorld({})
    M:Send("RDYQ")
    expect(#sent).toBe(0)
    expect(M.lastSend).toBe(nil)
    inWorld({ group = true })
    M:Send("RDYQ")
    expect(#sent).toBe(1)
    expect(sent[1][1]).toBe("SuuUI")
    expect(sent[1][2]).toBe("RDYQ")
    expect(sent[1][3]).toBe("PARTY")
    expect(assert(M.lastSend).ok).toBe(true)
    expect(assert(M.lastSend).result).toBe("true")
    expect(assert(M.lastSend).text).toBe("RDYQ")
    inWorld({ raid = true })
    M:Send("RDY", string.rep("1", 60))
    expect(sent[2][3]).toBe("RAID")
    expect(#assert(M.lastSend).text).toBe(40)
    mock.player:enterCombat()
    M:Send("RDYQ")
    expect(#sent).toBe(2)
end

@test("Send: what the game answered, an error or a secret")
local function sendAnswers()
    inWorld({ group = true })
    mock.stub(C_ChatInfo, "SendAddonMessage", function(): unknown
        error("throttled")
    end)
    M:Send("RDYQ")
    expect(assert(M.lastSend).ok).toBe(false)
    expect(assert(M.lastSend).result).toContain("throttled")
    mock.stub(C_ChatInfo, "SendAddonMessage", function(): unknown
        return mock.secret(0)
    end)
    M:Send("RDYQ")
    expect(assert(M.lastSend).ok).toBe(true)
    expect(assert(M.lastSend).result).toBe("secret")
end

@test("Share: your cooldowns as one message, only when they changed; nothing in combat or without any")
local function share()
    captureSends()
    inWorld({ group = true })
    local now = GetTime()
    knowSpells({ [20484] = true }, { [20484] = { startTime = now - 100, duration = 600 } })
    M:Share()
    expect(#sent).toBe(1)
    -- the exact text an older SuuUI reads
    expect(sent[1][2]).toBe("RDY\t20484:500")
    -- the same a while later (the time left counted down): not again
    mock.advanceTime(20)
    M:Share()
    expect(#sent).toBe(1)
    -- asked for: sent whatever
    M:Share(true)
    expect(#sent).toBe(2)
    expect(sent[2][2]).toBe("RDY\t20484:480")
    -- the cooldown changed (used again): sent
    knowSpells({ [20484] = true }, { [20484] = { startTime = GetTime(), duration = 600 } })
    M:Share()
    expect(#sent).toBe(3)
    -- ready now: sent once
    knowSpells({ [20484] = true }, {})
    M:Share()
    M:Share()
    expect(#sent).toBe(4)
    expect(sent[4][2]).toBe("RDY\t20484:0")
    mock.player:enterCombat()
    M:Share(true)
    expect(#sent).toBe(4)
    mock.player:leaveCombat()
    -- a class without big cooldowns: nothing at all
    mock.stub(game, "UnitClass", function(): (string, string)
        return "Rogue", "ROGUE"
    end)
    M:Share(true)
    expect(#sent).toBe(4)
end

@test("ShareSoon: a burst makes one share, two seconds on; an answer a moment later, sent whatever")
local function shareSoon()
    local s = mock.stub(M, "Share")
    M:ShareSoon()
    M:ShareSoon()
    M:ShareSoon()
    expect(s).never.toHaveBeenCalled()
    mock.advanceTime(2.1)
    expect(s).toHaveBeenCalledTimes(1)
    expect(s).toHaveBeenCalledWith(M, nil)
    expect(M.shareQueued).toBe(nil)
    M:ShareSoon(true)
    M:ShareSoon()
    mock.advanceTime(4.1)
    expect(s).toHaveBeenCalledTimes(2)
    expect(s).toHaveBeenCalledWith(M, true)
end

--------------------------------------------------------------------------------
-- Hearing
--------------------------------------------------------------------------------

@test("a share from someone in the group is kept, as an older SuuUI sends it")
local function hears()
    inWorld({})
    local now = GetTime()
    mock.receiveAddonMessage("SuuUI", "RDY\t20484:0,29166:60", "PARTY", "Member1 Lastname-Realm")
    local h = assert(assert(M.heard)["Member1 Lastname"])
    expect(h.at).toBe(now)
    expect(#h.spells).toBe(2)
    expect(h.spells[2].endsAt).toBe(now + 60)
    -- a newer share replaces it (one without spells too)
    mock.advanceTime(2.1)
    mock.receiveAddonMessage("SuuUI", "RDY\t", "RAID", "Member1 Lastname")
    expect(#assert(assert(M.heard)["Member1 Lastname"]).spells).toBe(0)
end

@test("what isn't a share from the group is ignored: other prefixes, secrets, whispers, guild, your own")
local function ignores()
    inWorld({})
    local function event(prefix: unknown, text: unknown, channel: unknown, sender: unknown)
        mock.fireEvent("CHAT_MSG_ADDON", prefix, text, channel, sender, "", 0, 0, "", 0)
    end
    event("Other", "RDY\t1:1", "PARTY", "Member1")
    event("SuuUI", mock.secret("RDY\t1:1"), "PARTY", "Member1")
    event("SuuUI", "RDY\t1:1", "PARTY", mock.secret("Member1"))
    event("SuuUI", "MARK\t1\t0.5\t0.5", "PARTY", "Member1")
    event("SuuUI", "RDY\t1:1", "WHISPER", "Stranger")
    event("SuuUI", "RDY\t1:1", "GUILD", "Member1")
    -- your own message coming back
    event("SuuUI", "RDY\t1:1", "PARTY", GetUnitName("player", true))
    expect(M.heard).toBe(nil)
    expectNoErrors()
end

@test("a share checked: spell IDs and seconds in range, at most twenty spells")
local function checked()
    inWorld({})
    local now = GetTime()
    mock.receiveAddonMessage("SuuUI", "RDY\t0:5,20484:999999,99999999999:1,871:-3,740:60", "PARTY", "Member1")
    local spells = assert(assert(M.heard).Member1).spells
    expect(#spells).toBe(1)
    expect(spells[1].id).toBe(740)
    expect(spells[1].endsAt).toBe(now + 60)
    local many: string[] = {}
    for i = 1, 30 do
        many[i] = (1000 + i) .. ":0"
    end
    mock.receiveAddonMessage("SuuUI", "RDY\t" .. table.concat(many, ","), "PARTY", "Member2")
    expect(#assert(assert(M.heard).Member2).spells).toBe(20)
end

@test("one sender's shares held to five in ten seconds; the panel drawn once for a burst")
local function shareFlood()
    inWorld({})
    local update = mock.stub(M, "Update")
    for i = 1, 50 do
        mock.receiveAddonMessage("SuuUI", "RDY\t740:" .. i, "PARTY", "Member1")
    end
    local spells = assert(assert(M.heard).Member1).spells
    expect(spells[1].endsAt).toBe(GetTime() + 5)
    mock.advanceTime(0.6)
    expect(update).toHaveBeenCalledTimes(1)
end

@test("RDYQ asks for yours: answered once per ten seconds, whoever asks; never a whisper's")
local function asked()
    inWorld({})
    local s = mock.stub(M, "ShareSoon")
    mock.receiveAddonMessage("SuuUI", "RDYQ", "WHISPER", "Stranger")
    expect(s).never.toHaveBeenCalled()
    mock.receiveAddonMessage("SuuUI", "RDYQ", "RAID", "Member1")
    expect(s).toHaveBeenCalledTimes(1)
    expect(s).toHaveBeenCalledWith(M, true)
    for i = 1, 20 do
        mock.receiveAddonMessage("SuuUI", "RDYQ", "RAID", "Member" .. i)
    end
    expect(s).toHaveBeenCalledTimes(1)
    mock.advanceTime(10.1)
    mock.receiveAddonMessage("SuuUI", "RDYQ", "RAID", "Member3")
    expect(s).toHaveBeenCalledTimes(2)
    expect(M.heard).toBe(nil)
end

@test("a real addon message reaches it")
local function wired()
    inWorld({})
    mock.receiveAddonMessage("SuuUI", "RDY\t20484:30", "PARTY", "Member1")
    mock.advanceFrames(1)
    expect(M.heard and assert(assert(M.heard)["Member1"])).toBeTruthy()
end

--------------------------------------------------------------------------------
-- The roster and the rows
--------------------------------------------------------------------------------

@test("roster: you first, then the party; secret names left out")
local function partyRoster()
    inWorld({
        group = true,
        members = {
            party1 = { name = "Brannoc Stone", class = "WARRIOR" },
            party2 = { name = "Veyra-Elsewhere", class = "SHAMAN" },
        },
    })
    local r = roster()
    expect(#r).toBe(3)
    expect(r[1].name).toBe("Ayla Dawnfeather")
    expect(r[1].class).toBe("DRUID")
    expect(r[1].you).toBe(true)
    expect(r[2].name).toBe("Brannoc Stone")
    expect(r[2].class).toBe("WARRIOR")
    expect(r[3].name).toBe("Veyra")
    mock.stub(SuuUI, "FullName", function(unit: string?): unknown
        if unit == "party1" then
            return mock.secret("Hidden")
        end
        if unit == "party2" then
            return nil
        end
        return "Ayla Dawnfeather"
    end)
    expect(#roster()).toBe(1)
    -- a secret class: kept, without one
    mock.stub(SuuUI, "FullName", function(unit: string?): unknown
        return unit == "party1" and "Brannoc" or "Ayla Dawnfeather"
    end)
    mock.stub(game, "UnitClass", function(unit: string): (unknown, unknown)
        if unit == "player" then
            return "Druid", "DRUID"
        end
        return "Warrior", mock.secret("WARRIOR")
    end)
    local r2 = roster()
    expect(r2[2].name).toBe("Brannoc")
    expect(r2[2].class).toBe(nil)
end

@test("roster: a raid's forty tokens, yourself once")
local function raidRoster()
    inWorld({
        raid = true,
        members = {
            raid1 = { name = "Ayla Dawnfeather", class = "DRUID" },
            raid7 = { name = "Oren", class = "PRIEST" },
        },
    })
    mock.stub(game, "UnitIsUnit", function(a: string, b: string): boolean
        return a == b or (a == "raid1" and b == "player")
    end)
    local r = roster()
    expect(#r).toBe(2)
    expect(r[2].name).toBe("Oren")
end

@test("Rows: yours and what others shared, ready first")
local function rows()
    inWorld({
        group = true,
        members = { party1 = { name = "Brannoc", class = "WARRIOR" }, party2 = { name = "Quiet", class = "MAGE" } },
    })
    local now = GetTime()
    knowSpells({ [20484] = true, [29166] = true }, { [29166] = { startTime = now - 10, duration = 300 } })
    M.heard = {
        Brannoc = { at = now, spells = { { id = 871, endsAt = now + 100 }, { id = 99999, endsAt = now - 5 } } },
    }
    local rows = M:Rows()
    expect(#rows).toBe(4)
    -- ready: yours (group order 1), then Brannoc's past one (order 2)
    expect(rows[1].spell).toBe("Rebirth")
    expect(rows[1].who).toBe("Ayla Dawnfeather")
    expect(rows[1].class).toBe("DRUID")
    expect(rows[1].endsAt).toBe(nil)
    expect(rows[2].spell).toBe("?")
    expect(rows[2].who).toBe("Brannoc")
    expect(rows[2].endsAt).toBe(nil)
    expect(rows[3].spell).toBe("Shield Wall")
    expect(rows[3].endsAt).toBe(now + 100)
    expect(rows[4].spell).toBe("Innervate")
    expect(rows[4].endsAt).toBe(now + 290)
    -- in combat: your last read stays
    mock.player:enterCombat()
    expect(#M:Rows()).toBe(4)
end

--------------------------------------------------------------------------------
-- The panel
--------------------------------------------------------------------------------

local function panelShown(): boolean
    return assert(M.panel):IsShown() and true or false
end

@test("Update: off, always, hidden by edit mode, combat, an encounter")
local function update()
    inWorld({})
    knowSpells({ [20484] = true }, {})
    M:Set("shows", "off")
    M:Update()
    expect(panelShown()).toBe(false)
    M:Set("shows", "always")
    M:Update()
    expect(panelShown()).toBe(true)
    expect(#assert(M.panel).data).toBe(1)
    expect(assert(M.panel).action).never.toBeShown()
    local pos = M:Get("position")
    pos.hidden = true
    M:Set("position", pos)
    M:Update()
    expect(panelShown()).toBe(false)
    M:Reset("position")
    M:Update()
    expect(panelShown()).toBe(true)
    M.encounter = true
    M:Update()
    expect(panelShown()).toBe(false)
    M.encounter = nil
    mock.player:enterCombat()
    M:Update()
    expect(panelShown()).toBe(false)
    expectNoErrors()
end

@test("Update: in a group or an instance; empty unless you can check")
local function updateGroup()
    knowSpells({}, {})
    inWorld({})
    M:Set("shows", "group")
    M:Update()
    expect(panelShown()).toBe(false)
    -- in a group, nobody shared, you can't start a ready check: nothing to show
    inWorld({ group = true })
    M:Update()
    expect(panelShown()).toBe(false)
    -- the leader: the panel for its Ready check button
    inWorld({ group = true, lead = true })
    M:Update()
    expect(panelShown()).toBe(true)
    expect(assert(M.panel).action).toBeShown()
    M:Set("shows", "instance")
    M:Update()
    expect(panelShown()).toBe(false)
    inWorld({ group = true, lead = true, kind = "party" })
    M:Update()
    expect(panelShown()).toBe(true)
    mock.stub(game, "UnitIsGroupLeader", function(): boolean
        return false
    end)
    mock.stub(game, "UnitIsGroupAssistant", function(): boolean
        return true
    end)
    M:Update()
    expect(panelShown()).toBe(true)
end

@test("Update without a panel does nothing")
local function noPanel()
    local panel = M.panel
    M.panel = nil
    M:Update()
    M.panel = panel
    expectNoErrors()
end

@test("the settings preview: four made-up rows, built once")
local function preview()
    local p1 = newParent()
    local view = M:PreviewView(p1)
    expect(#view.data).toBe(4)
    expect(view.action).toBeShown()
    local p2 = newParent()
    expect(M:PreviewView(p2)).toBe(view)
    expect(view:GetParent()).toBe(p2)
    p1:Hide()
    p2:Hide()
end

--------------------------------------------------------------------------------
-- Events, the heartbeat, the command
--------------------------------------------------------------------------------

@test("the roster changing while solo: an update, no message")
local function rosterEventSolo()
    captureSends()
    inWorld({})
    local soon = mock.stub(M, "ShareSoon")
    local update = mock.stub(M, "Update")
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.advanceTime(1.1)
    expect(update).toHaveBeenCalled()
    expect(#sent).toBe(0)
    expect(soon).never.toHaveBeenCalled()
end

@test("a burst of roster events: read once; someone new gets yours, and one question for who stays silent")
local function rosterBurst()
    captureSends()
    knowSpells({ [20484] = true }, {})
    M:Set("shows", "group")
    local members = { party1 = { name = "Member1", class = "WARRIOR" } }
    inWorld({ group = true, members = members })
    local changed = mock.spy(M.RosterChanged)
    mock.stub(M, "RosterChanged", changed)
    for _ = 1, 5 do
        mock.fireEvent("GROUP_ROSTER_UPDATE")
    end
    mock.advanceTime(1.1)
    expect(changed).toHaveBeenCalledTimes(1)
    -- yours a moment later (asked for: whatever it was); then the question,
    -- Member1 being silent
    mock.advanceTime(4)
    expect(sentTexts()).toEqual({ "RDY	20484:0" })
    mock.advanceTime(1.1)
    expect(sentTexts()).toEqual({ "RDY	20484:0", "RDYQ" })
    -- the same roster again: nothing new, nothing sent
    for _ = 1, 5 do
        mock.fireEvent("GROUP_ROSTER_UPDATE")
    end
    mock.advanceTime(12)
    expect(#sent).toBe(2)
    -- someone new who shares at once: no question
    members.party2 = { name = "Member2", class = "MAGE" }
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.advanceTime(1.1)
    mock.receiveAddonMessage("SuuUI", "RDY	871:0", "PARTY", "Member2")
    mock.advanceTime(12)
    expect(sentTexts()).toEqual({ "RDY	20484:0", "RDYQ", "RDY	20484:0" })
end

@test("with the panel off: yours still shared (others use it), never a question")
local function panelOff()
    captureSends()
    knowSpells({ [20484] = true }, {})
    M:Set("shows", "off")
    inWorld({ group = true, members = { party1 = { name = "Member1", class = "WARRIOR" } } })
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.advanceTime(12)
    expect(sentTexts()).toEqual({ "RDY	20484:0" })
    -- asked: answered
    mock.receiveAddonMessage("SuuUI", "RDYQ", "PARTY", "Member1")
    mock.advanceTime(4.1)
    expect(sentTexts()).toEqual({ "RDY	20484:0", "RDY	20484:0" })
    -- turned on: the silent are asked
    M:Set("shows", "group")
    mock.advanceTime(10.1)
    expect(sentTexts()[3]).toBe("RDYQ")
end

@test("who left is forgotten; leaving the group forgets everyone")
local function forgets()
    inWorld({
        group = true,
        members = { party1 = { name = "Member1", class = "WARRIOR" }, party2 = { name = "Member2", class = "MAGE" } },
    })
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.advanceTime(1.1)
    mock.receiveAddonMessage("SuuUI", "RDY	871:0", "PARTY", "Member1")
    mock.receiveAddonMessage("SuuUI", "RDY	871:0", "PARTY", "Member2")
    expect(assert(M.heard).Member2).toBeTruthy()
    inWorld({ group = true, members = { party1 = { name = "Member1", class = "WARRIOR" } } })
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.advanceTime(1.1)
    expect(assert(M.heard).Member1).toBeTruthy()
    expect(assert(M.heard).Member2).toBeNil()
    inWorld({})
    mock.fireEvent("GROUP_ROSTER_UPDATE")
    mock.advanceTime(1.1)
    expect(M.heard).toBeNil()
end

@test("casting between pulls: nothing sent while your cooldowns stay as they were")
local function castsUnchanged()
    captureSends()
    knowSpells({ [20484] = true }, {})
    inWorld({ group = true })
    M:Share(true)
    for _ = 1, 10 do
        mock.fireEvent("SPELL_UPDATE_COOLDOWN")
        mock.advanceTime(0.5)
    end
    mock.advanceTime(35)
    expect(#sent).toBe(1)
end

@test("a cooldown changing: a share soon, in a group and out of combat")
local function cooldownEvent()
    local soon = mock.stub(M, "ShareSoon")
    inWorld({})
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    expect(soon).never.toHaveBeenCalled()
    inWorld({ group = true })
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    expect(soon).toHaveBeenCalledTimes(1)
    mock.player:enterCombat()
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    expect(soon).toHaveBeenCalledTimes(1)
end

@test("combat hides it; a second after it ends it comes back and shares")
local function combatEvents()
    inWorld({})
    knowSpells({ [20484] = true }, {})
    M:Set("shows", "always")
    expect(panelShown()).toBe(true)
    local soon = mock.stub(M, "ShareSoon")
    mock.player:enterCombat()
    expect(panelShown()).toBe(false)
    mock.player:leaveCombat()
    expect(panelShown()).toBe(false)
    mock.advanceTime(1.1)
    expect(panelShown()).toBe(true)
    expect(soon).toHaveBeenCalledTimes(1)
end

@test("an encounter hides it until it ends; entering the world updates it")
local function encounterEvents()
    inWorld({})
    knowSpells({ [20484] = true }, {})
    M:Set("shows", "always")
    mock.fireEvent("ENCOUNTER_START", 1084, "Onyxia", 9, 40)
    expect(M.encounter).toBe(true)
    expect(panelShown()).toBe(false)
    mock.fireEvent("ENCOUNTER_END", 1084, "Onyxia", 9, 40, 1, {})
    expect(M.encounter).toBe(nil)
    expect(panelShown()).toBe(true)
    assert(M.panel):Hide()
    mock.fireEvent("PLAYER_ENTERING_WORLD", false, true)
    expect(panelShown()).toBe(true)
end

@test("the heartbeat shares every 30 seconds in a group, out of combat")
local function heartbeat()
    local share = mock.stub(M, "Share")
    inWorld({})
    mock.advanceTime(30)
    expect(share).never.toHaveBeenCalled()
    inWorld({ group = true })
    mock.advanceTime(30)
    expect(share).toHaveBeenCalledTimes(1)
    mock.player:enterCombat()
    mock.advanceTime(30)
    expect(share).toHaveBeenCalledTimes(1)
end

@test("/suu ready: who shared and the last message sent")
local function command()
    local before = #mock.printed()
    mock.slash("/suu ready")
    local out = mock.printed()
    expect(#out).toBe(before + 2)
    expect(out[before + 1]).toContain("nobody shared yet")
    expect(out[before + 2]).toContain("nothing sent yet")
    inWorld({ group = true })
    captureSends()
    mock.receiveAddonMessage("SuuUI", "RDY\t1:1,2:2", "PARTY", "Member1")
    M:Send("RDYQ")
    mock.slash("/suu ready")
    out = mock.printed()
    expect(out[before + 3]).toContain("heard from Member1 (2)")
    expect(out[before + 4]).toContain("ok, true (RDYQ)")
    assert(M.lastSend).ok = false
    mock.slash("/suu ready")
    expect(mock.printed()[before + 6]).toContain("error")
end

@test("the Ready check button starts a ready check")
local function readyCheck()
    local s = mock.fake("DoReadyCheck", function() end)
    inWorld({ group = true, lead = true })
    M:Set("shows", "group")
    expect(panelShown()).toBe(true)
    mock.click(assert(M.panel).action)
    expect(s).toHaveBeenCalledTimes(1)
end

@test("off and on through the registry: nothing left behind (its addon message handlers too), nothing doubled")
local function leavesNothing()
    -- (a first cycle settles what earlier tests queued)
    cycle("readiness")
    local c = cycle("readiness")
    expect(c.off).toEqual(NOTHING)
    expect(c.after).toEqual(c.before)
    expect(comm.count(M)).toBe(2)
    settings.set("readiness", "enabled", false)
    expect(comm.count(M)).toBe(0)
    -- off: neither a share nor a question is taken
    mock.receiveAddonMessage("SuuUI", "RDY\t871:0", "PARTY", "Member1")
    expect(M.heard).toBeNil()
    settings.set("readiness", "enabled", true)
    expectNoErrors()
end

@test("turned off: the panel goes")
local function disable()
    inWorld({})
    knowSpells({ [20484] = true }, {})
    M:Set("shows", "always")
    expect(panelShown()).toBe(true)
    mock.slash("/suu disable readiness")
    expect(M:IsEnabled()).toBe(false)
    expect(panelShown()).toBe(false)
    mock.slash("/suu enable readiness")
    expect(M:IsEnabled()).toBe(true)
    expect(panelShown()).toBe(true)
    expectNoErrors()
end

-- Last: a real group stays for the rest of the file.
@test("joining a real party: yours to them, then a question for the silent, on the game's own channel")
local function joinParty()
    M:Set("shows", "group")
    knowSpells({ [20484] = true }, {})
    -- (you: a druid; the rest of the world the game's own)
    local unitClass = game.UnitClass
    mock.stub(game, "UnitClass", function(unit: string): (unknown, unknown)
        if unit == "player" then
            return "Druid", "DRUID"
        end
        local name, file = unitClass(unit)
        return name, file
    end)
    local before = #mock.sentAddonMessages()
    local member = mock.spawnUnit({ name = "Member1", class = "WARRIOR", player = true })
    mock.group:add(member)
    -- (nothing at once: the roster is read once it settles)
    expect(#mock.sentAddonMessages()).toBe(before)
    mock.advanceTime(10)
    local sentNow = mock.sentAddonMessages()
    expect(#sentNow).toBe(before + 2)
    expect(sentNow[before + 1].prefix).toBe("SuuUI")
    expect(sentNow[before + 1].message).toBe("RDY\t20484:0")
    expect(sentNow[before + 1].chatType).toBe("PARTY")
    expect(sentNow[before + 2].message).toBe("RDYQ")
    expectNoErrors()
end
