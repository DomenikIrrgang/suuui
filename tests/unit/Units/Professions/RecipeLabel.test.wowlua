-- Units/Professions/RecipeLabel: the recipe list's label for a recipe name.

import test, expect from "wowlua:test"
import recipeLabel, ENCHANTING from "/Units/Professions/RecipeLabel"
import expectNoErrors from "../../../helpers"

@test("enchanting recipes lose their leading \"Enchant \"")
local function enchanting()
    expect(recipeLabel(ENCHANTING, "Enchant 2H Weapon - Greater Impact")).toBe("2H Weapon - Greater Impact")
    expect(recipeLabel(ENCHANTING, "Enchant Cloak - Lesser Shadow Resistance")).toBe("Cloak - Lesser Shadow Resistance")
    expectNoErrors()
end

@test("the name itself: other professions, enchanting names without the prefix, no name")
local function unchanged()
    -- Blacksmithing, Tailoring
    expect(recipeLabel(164, "Enchant Weapon - Fake")).toBeNil()
    expect(recipeLabel(197, "Enchanted Mageweave Pouch")).toBeNil()
    expect(recipeLabel(nil, "Enchant Boots - Minor Speed")).toBeNil()
    -- enchanting's own items and rods
    expect(recipeLabel(ENCHANTING, "Runed Copper Rod")).toBeNil()
    expect(recipeLabel(ENCHANTING, "Enchanted Thorium")).toBeNil()
    expect(recipeLabel(ENCHANTING, "Enchant")).toBeNil()
    expect(recipeLabel(ENCHANTING, "Enchant ")).toBeNil()
    expect(recipeLabel(ENCHANTING, nil)).toBeNil()
    expectNoErrors()
end
