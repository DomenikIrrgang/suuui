-- Units/RaidPlanner/Catalog: the catalog as the planner reads it, and the
-- rules about classes, trees and roles.

import test, expect from "wowlua:test"
import * as catalog from "/Units/RaidPlanner/Catalog"
import expectNoErrors from "../../../helpers"

@test("the catalog: read once (the module did as it started), its classes and items by key")
local function loaded()
    local classes, items = #catalog.CLASSES, #catalog.ITEMS
    expect(classes).toBe(9)
    expect(items > 0).toBe(true)
    catalog.loadCatalog()
    expect(#catalog.CLASSES).toBe(classes)
    expect(#catalog.ITEMS).toBe(items)
    expect(assert(catalog.CLASS.WARRIOR).name).toBe("Warrior")
    expect(assert(catalog.ITEM.fortitude).short).toBe("Fortitude")
    expect(assert(catalog.familyOf("party")).key).toBe("party")
    expect(catalog.familyOf("nothing")).toBeNil()
    expectNoErrors()
end

@test("roles: a tree's, the trees that can take one (Feral tanks), none for an unknown class")
local function roles()
    expect(catalog.treeRole("WARRIOR", 3)).toBe("TANK")
    expect(catalog.treeRole("WARRIOR", nil)).toBeNil()
    expect(catalog.treeRole(nil, 1)).toBeNil()
    expect(catalog.canPlay("DRUID", 2, "TANK")).toBe(true)
    expect(catalog.canPlay("DRUID", 1, "TANK")).toBe(false)
    expect(catalog.canPlay("SHAMAN", nil, "HEALER")).toBe(true)
    expect(catalog.canPlay("MAGE", nil, "HEALER")).toBe(false)
    expect(catalog.canPlay("NOBODY", nil, "DAMAGER")).toBe(false)
    expectNoErrors()
end

@test("words: a class's plural, a list joined with and (or another word), a name as a key")
local function words()
    expect(catalog.plural("PRIEST")).toBe("priests")
    expect(catalog.plural("NOBODY")).toBe("?")
    expect(catalog.joinAnd({})).toBe("")
    expect(catalog.joinAnd({ "a" })).toBe("a")
    expect(catalog.joinAnd({ "a", "b", "c" })).toBe("a, b and c")
    expect(catalog.joinAnd({ "a", "b" }, "or")).toBe("a or b")
    expect(catalog.key("Player")).toBe("Player")
    expect(catalog.MAX_GROUP).toBe(5)
    expect(catalog.ROLE_WORD.DAMAGER).toBe("damage")
    expect(catalog.ROLE_NAME.HEALER).toBe("Healer")
    expectNoErrors()
end
