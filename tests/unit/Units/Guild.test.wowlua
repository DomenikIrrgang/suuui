-- Units/Guild: SuuUI's pages over Blizzard's Communities window (opened
-- with J, its tabs clicked) on the engine's guild: the roster (online and
-- offline, search, sorting), what your rank allows with each member and
-- why not, the foot's secure Promote, Demote and Remove (Remove asks
-- twice), Invite to guild (a secure /ginvite), a member's details, the
-- Info page and the message of the day, the Log and Settings pages, the
-- club picker, a fight starting.


import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import SuuUI from "/Core/API"
import internal M from "/Units/Guild"
import type Member from "/Units/Guild"
import type GuildRoster, RosterData, GuildInfoData, GuildLogData from "/UI/Guild"
import type ConfirmDialog, ConfirmOptions from "/UI/Panel"
import type Overlay from "wowlua:secure"
import expectNoErrors, captureMenus, choose from "../../helpers"

local UI = SuuUI.UI

-- A guild of placeholders: you lead it.
local function joinGuild()
    mock.joinGuild({ name = "Wardens of Dawn", rank = 0, motd = "Raid at eight.", info = "A friendly guild.",
        members = {
            { name = "Brannoc Ironhand", class = "WARRIOR", level = 60, rank = 1, zone = "Ironforge", online = true, note = "tank" },
            { name = "Tamsin Ashford", class = "PRIEST", level = 42, rank = 3, zone = "Stormwind City", online = true,
              note = "healer", officerNote = "trial ends soon", status = 1 },
            { name = "Aster Vale", class = "MAGE", level = 20, rank = 4, online = false, lastOnline = { 0, 0, 3, 0 } },
        } })
    mock.advanceTime(1)
end

local function frame(): Frame? return frames.find("CommunitiesFrame") end
local function window(): Frame return assert(frame()) end
local function roster(): GuildRoster return assert(M.roster) end

local function open()
    local f = frame()
    if not f or not f:IsShown() then mock.pressKey("J") end
    mock.advanceFrames(3)
end

local function tabTo(key: string)
    open()
    local t = frames.asButton(tbl.field(window(), key))
    if t and t:IsShown() then mock.click(t) end
    mock.advanceFrames(3)
end

local function member(name: string): Member
    for _, m in ipairs((M:Members())) do if m.name == name then return m end end
    error("no member " .. name)
end

local function over(key: string): Button return assert(M.overs[key]).button end

-- What a print said, from now on.
local function prints(): string[]
    local said: string[] = {}
    mock.stub(M, "Print", function(_: unknown, text: string) said[#said + 1] = text end)
    return said
end

@afterEach
local function cleanup()
    if InCombatLockdown() then mock.player:leaveCombat() end
    local d = M.details
    if d and d.panel:IsShown() then d.panel:Hide() end
    local f = frame()
    if f and f:IsShown() then HideUIPanel(f) end
    M.search, M.sort, M.selected, M.ownPage = nil, "rank", nil, nil
    M:Reset("showOffline")
    mock.leaveGuild()
    mock.advanceFrames(3)
    expectNoErrors()
end

@test("J opens the guild's window: Blizzard's communities list folded away, the picker with your guild first")
local function opens()
    joinGuild()
    open()
    local f = window()
    expect(f:IsShown()).toBe(true)
    local list = assert(frames.asFrame(tbl.field(f, "CommunitiesList")))
    expect(list:GetAlpha()).toBe(0)
    expect(list:GetWidth()).toBe(1)
    local clubs = M:Clubs()
    expect(clubs[1].guild).toBe(true)
    expect(clubs[1].label).toBe("Wardens of Dawn")
    expect(M.picker ~= nil).toBe(true)
    -- Blizzard refolding it: folded again
    list:SetWidth(200)
    mock.advanceFrames(2)
    expect(list:GetWidth()).toBe(1)
end

@test("the roster: online members by rank; offline ones with the setting; search; every sort")
local function rosterPage()
    joinGuild()
    tabTo("RosterTab")
    local r = roster()
    expect(r:IsShown()).toBe(true)
    local drawn: RosterData? = nil
    mock.stub(r, "SetData", function(_: unknown, d: RosterData) drawn = d end)
    M:Render()
    local function data(): RosterData return assert(drawn) end
    local function shown(): Member[]
        local out: Member[] = {}
        for i, m in ipairs(data().members or {}) do out[i] = assert(M:MemberBy(m.key)) end
        return out
    end
    expect(data().total).toBe(4)
    expect(data().online).toBe(3)
    -- online only, by rank: you (the leader) first
    expect(#shown()).toBe(3)
    expect(shown()[1].you).toBe(true)
    expect(shown()[2].name).toBe("Brannoc Ironhand")
    assert(r.onShowOffline)(true)
    expect(#shown()).toBe(4)
    expect(member("Aster Vale").lastOnline).toBe("3 days ago")
    -- away and its note
    local tamsin = member("Tamsin Ashford")
    expect(tamsin.away).toBe(true)
    expect(tamsin.note).toBe("healer")
    local search = assert(r.onSearch)
    search("stormwind")
    mock.advanceTime(0.2)
    expect(#shown()).toBe(1)
    expect(shown()[1].name).toBe("Tamsin Ashford")
    search("")
    mock.advanceTime(0.2)
    local sort = assert(r.onSort)
    for _, key in ipairs({ "name", "level", "zone", "class", "note", "rank" }) do
        sort(key)
        expect(data().sort).toBe(key)
    end
    sort("level")
    expect((shown()[1].level or 0) >= (shown()[2].level or 0)).toBe(true)
end

@test("how long ago someone was online: years, months, days, hours, less than an hour")
local function lastOnline()
    joinGuild()
    local answer: number[] = { 0, 0, 0, 0 }
    mock.stub(_G, "GetGuildRosterLastOnline", function(_: number): ...unknown return answer[1], answer[2], answer[3], answer[4] end)
    local function ago(y: number, mo: number, d: number, h: number): string?
        answer = { y, mo, d, h }
        return member("Aster Vale").lastOnline
    end
    expect(ago(2, 0, 0, 0)).toBe("2 years ago")
    expect(ago(1, 0, 0, 0)).toBe("1 year ago")
    expect(ago(0, 1, 0, 0)).toBe("1 month ago")
    expect(ago(0, 0, 1, 0)).toBe("1 day ago")
    expect(ago(0, 0, 0, 5)).toBe("5 hours ago")
    expect(ago(0, 0, 0, 0)).toBe("less than an hour ago")
    mock.stub(_G, "GetGuildRosterLastOnline", function(_: number): ...unknown return nil end)
    expect(member("Aster Vale").lastOnline).toBe("Offline")
end

@test("what your rank allows with a member, and why not")
local function actions()
    joinGuild()
    local a = M:Actions(member("Tamsin Ashford"))
    for _, key in ipairs({ "whisper", "invite", "promote", "demote", "remove" }) do expect(assert(a[key]).enabled).toBe(true) end
    -- one rank under you: a promotion would reach yours
    local b = M:Actions(member("Brannoc Ironhand"))
    expect(assert(b.promote).enabled).toBe(false)
    expect(assert(b.promote).why).toBe("They'd reach your own rank.")
    -- at the lowest rank: no demotion; offline: no whisper or invite
    local c = M:Actions(member("Aster Vale"))
    expect(assert(c.demote).why).toBe("They're at the lowest rank already.")
    expect(assert(c.whisper).why).toBe("They're offline.")
    -- yourself
    local me: Member? = nil
    for _, m in ipairs((M:Members())) do if m.you then me = m end end
    local d = M:Actions(me)
    expect(assert(d.whisper).why).toBe("That's you.")
    expect(assert(d.remove).why).toBe("That's you.")
    -- a rank that may do nothing
    mock.stub(_G, "CanGuildPromote", function(): boolean return false end)
    mock.stub(_G, "CanGuildRemove", function(): boolean return false end)
    local e = M:Actions(member("Tamsin Ashford"))
    expect(assert(e.promote).why).toBe("Your rank can't promote.")
    expect(assert(e.remove).why).toBe("Your rank can't remove members.")
    -- in a group led by someone else: no invite
    local friend = mock.spawnUnit({ name = "Morrow Fenwick", player = true, class = "DRUID", reaction = "friendly" })
    mock.group:add(friend)
    mock.stub(_G, "UnitIsGroupLeader", function(_: string): boolean return false end)
    expect(assert(M:Actions(member("Tamsin Ashford")).invite).why).toBe("Only your group's leader or an assistant can invite.")
    mock.group:leave()
    -- nobody chosen: nothing to say about a member
    expect(M:Actions(nil).whisper).toBeNil()
end

@test("the foot's Promote, Demote and Remove: secure /gpromote, /gdemote, /gremove for the selected member; Remove asks twice")
local function foot()
    joinGuild()
    tabTo("RosterTab")
    local select = assert(roster().onSelect)
    select(member("Tamsin Ashford").key)
    mock.advanceFrames(2)
    local promote, remove = over("promote"), over("remove")
    expect(promote:IsShown()).toBe(true)
    expect(promote:GetAttribute("type1")).toBe("macro")
    expect(promote:GetAttribute("macrotext1")).toBe("/gpromote " .. member("Tamsin Ashford").full)
    expect(tostring(over("demote"):GetAttribute("macrotext1")):sub(1, 9)).toBe("/gdemote ")
    -- Remove: the first click arms it
    expect(remove:GetAttribute("type1")).toBeNil()
    mock.click(remove)
    expect(M.armed.remove).toBe(true)
    expect(remove:GetAttribute("type1")).toBe("macro")
    mock.click(remove)
    expect(M.armed.remove).toBeNil()
    mock.click(promote)
    mock.advanceTime(0.6)
    -- another member: disarmed; one you can't act on: no secure buttons
    select(member("Brannoc Ironhand").key)
    expect(promote:IsShown()).toBe(false)
    -- the plain button reached: the secure one wasn't there
    local said = prints()
    M:Act("promote", member("Brannoc Ironhand"))
    expect(assert(said[1]):sub(1, 8)).toBe("promote:")
    -- a fight: the secure buttons away
    select(member("Tamsin Ashford").key)
    mock.player:enterCombat()
    expect(promote:IsShown()).toBe(false)
end

@test("Whisper and Invite; a member's menu; Invite to guild runs a secure /ginvite with the typed name")
local function whisperInvite()
    joinGuild()
    local menu = captureMenus()
    tabTo("RosterTab")
    local r = roster()
    local tell = mock.stub(tbl.field(_G, "ChatFrameUtil"), "SendTell", function(_: string) end)
    local tamsin = member("Tamsin Ashford")
    local act = assert(r.onAction)
    act("whisper", tamsin)
    expect(tell).toHaveBeenCalledWith(tamsin.full)
    local invite = mock.stub(C_PartyInfo, "InviteUnit", function(_: string) end)
    act("invite", tamsin)
    expect(invite).toHaveBeenCalledWith(tamsin.full)
    assert(r.onMenu)(tamsin, assert(r.rows[1]))
    choose(menu, "Whisper")
    choose(menu, "Invite")
    expect(invite).toHaveBeenCalledTimes(2)
    M:Act("whisper", nil)
    -- Invite to guild: SuuUI's dialog, its Invite covered by a secure /ginvite
    local real = UI.Confirm
    local dialog: ConfirmDialog? = nil
    mock.stub(UI, "Confirm", function(opts: ConfirmOptions): ConfirmDialog
        local d = real(opts)
        dialog = d
        return d
    end)
    act("guildInvite", nil)
    local d = assert(dialog)
    local cover = assert(M.inviteOver).button
    expect(cover:IsShown()).toBe(true)
    expect(cover:GetAttribute("macrotext1")).toBe("/ginvite ")
    mock.typeText(d.field.edit, "Kaelith Dawnmere")
    expect(cover:GetAttribute("macrotext1")).toBe("/ginvite Kaelith Dawnmere")
    mock.click(cover)
    mock.advanceTime(1.1)
    expect(d:IsShown()).toBe(false)
    expect(cover:IsShown()).toBe(false)
    -- in a fight: not now
    local said = prints()
    mock.player:enterCombat()
    mock.advanceFrames(1)
    act("guildInvite", nil)
    expect(said[1]).toBe("Inviting to the guild works out of combat.")
end

@test("a member's details beside the window: who, where, the notes; whisper and invite there")
local function details()
    joinGuild()
    tabTo("RosterTab")
    local select = assert(roster().onSelect)
    select(member("Tamsin Ashford").key)
    local p = assert(M.details)
    expect(p.panel:IsShown()).toBe(true)
    expect(p.line1:GetText()).toBe("Level 42 Priest")
    expect(p.line2:GetText()).toBe("Member · Stormwind City")
    expect(p.note.text:GetText()).toBe("healer")
    -- the leader sees the officer note
    if p.officer.text:IsShown() then expect(p.officer.text:GetText()).toBe("trial ends soon") end
    local tell = mock.stub(tbl.field(_G, "ChatFrameUtil"), "SendTell", function(_: string) end)
    p.whisper:Click()
    expect(tell).toHaveBeenCalled()
    -- an offline member: when they were last on, no note
    assert(roster().onShowOffline)(true)
    select(member("Aster Vale").key)
    expect(p.line2:GetText()).toBe("Initiate · 3 days ago")
    expect((p.note.text:GetText() or ""):find("No note", 1, true) ~= nil).toBe(true)
    -- Edit's plain button reached: why it couldn't be the secure one
    local said = prints()
    if p.note.edit:IsEnabled() then
        p.note.edit:Click()
        expect(#said).toBe(1)
    end
    -- a theme change: drawn again; hidden with the window
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    HideUIPanel(window())
    mock.advanceFrames(2)
    expect(p.panel:IsShown()).toBe(false)
end

@test("the Info page: the guild's information and its ranks with their counts; Edit through Blizzard's own box")
local function info()
    joinGuild()
    tabTo("GuildInfoTab")
    local page = assert(M.infoPage)
    if not page:IsShown() then return end
    local drawn: GuildInfoData? = nil
    mock.stub(page, "SetData", function(_: unknown, d: GuildInfoData) drawn = d end)
    M:RenderInfo()
    local d = assert(drawn)
    local ranks = assert(d.ranks)
    expect(d.info).toBe("A friendly guild.")
    expect(ranks[1].count).toBe(1)
    expect(#ranks).toBe(5)
    -- Blizzard's edit button missing: why it can't be edited now (the game
    -- forbids saving it from addon code)
    local said = prints()
    mock.stub(M, "BlizzEdit", function(_: unknown, _: string): Frame? return nil end)
    M:EditInfo("motd")
    expect((said[1] or ""):find("message of the day", 1, true) ~= nil).toBe(true)
    M:EditInfo("info")
    expect((said[2] or ""):find("guild information", 1, true) ~= nil).toBe(true)
end

@test("the message of the day: the Chat tab's banner, a new one from its event before the game's copy")
local function motd()
    joinGuild()
    tabTo("ChatTab")
    expect(M:Motd()).toBe("Raid at eight.")
    mock.fireEvent("GUILD_MOTD", "Raid moved to nine.")
    expect(M:Motd()).toBe("Raid moved to nine.")
    -- the game's own copy caught up: it again
    mock.stub(_G, "GetGuildRosterMOTD", function(): string return "Raid moved to nine." end)
    expect(M:Motd()).toBe("Raid moved to nine.")
    expect(M.freshMotd).toBeNil()
end

@test("opened in a fight: the message of the day read before it (the game refuses it to addons then), nothing blocked")
local function motdInCombat()
    joinGuild()
    M.lastMotd, M.lastCanEdit = nil, false
    mock.player:enterCombat()
    mock.advanceFrames(1)
    tabTo("ChatTab")
    expect(M:Motd()).toBe("Raid at eight.")
    expect(#mock.refusals()).toBe(0)
    mock.player:leaveCombat()
    expectNoErrors()
end

@test("the Log page: invites, joins, promotions in words, newest first; the Settings page hosting Blizzard's guild control")
local function logAndSettings()
    joinGuild()
    open()
    local events: unknown[][] = {
        { "invite", "Brannoc Ironhand", "Tamsin Ashford", nil, 0, 0, 2, 0 },
        { "promote", "Brannoc Ironhand", "Tamsin Ashford", "Member", 0, 0, 0, 3 },
        { "join", "Tamsin Ashford", nil, nil, 1, 0, 0, 0 },
        { "unknown", "x", "y", nil, 0, 0, 0, 0 },
        { "quit", "Aster Vale", nil, nil, 0, 2, 0, 0 },
        { "remove", "Brannoc Ironhand", "Corwin Hale", nil, 0, 0, 0, 0 },
    }
    mock.stub(_G, "GetNumGuildEvents", function(): number return #events end)
    mock.stub(_G, "GetGuildEventInfo", function(i: number): ...unknown return unpack(assert(events[i]), 1, 8) end)
    M:ShowOwn("log")
    local page = assert(M.logPage)
    expect(page:IsShown()).toBe(true)
    local drawn: GuildLogData? = nil
    mock.stub(page, "SetData", function(_: unknown, d: GuildLogData) drawn = d end)
    M:RenderLog()
    local lines = assert(assert(drawn).lines)
    expect(#lines).toBe(5)
    expect(lines[1].text).toBe("Brannoc Ironhand removed Corwin Hale")
    expect(lines[1].when).toBe("just now")
    expect(lines[2].when).toBe("2 months ago")
    expect(lines[3].text).toBe("Tamsin Ashford joined the guild")
    expect(lines[3].when).toBe("1 year ago")
    expect(lines[4].text).toBe("Brannoc Ironhand promoted Tamsin Ashford to Member")
    expect(lines[4].when).toBe("3 hours ago")
    expect(lines[5].when).toBe("2 days ago")
    M:GuildSettings()
    expect(M.settingsCover).toBeShown()
    M:ShowOwn(nil)
    expect(M.settingsCover).never.toBeShown()
end

@test("the picker: Join or create when the game has no such entry; another club leaves SuuUI's pages")
local function picker()
    joinGuild()
    open()
    local said = prints()
    local plus = assert(M.plus)
    mock.script(plus, "OnEnter")
    mock.script(plus, "OnLeave")
    M:JoinOrCreate()
    if said[1] then expect(said[1]).toBe("The game's Join or Create Community isn't available here.") end
    mock.fireEvent("CLUB_UPDATED", C_Club.GetGuildClubId())
end

@test("a fight: every secure button over the window away at once; drawn again after")
local function fight()
    joinGuild()
    tabTo("RosterTab")
    local r = roster()
    assert(r.onSelect)(member("Tamsin Ashford").key)
    local row = assert(r.rows[1])
    assert(r.onRowEnter)(row, member("Tamsin Ashford"))
    local layer: Overlay = assert(M.rowOver)
    expect(layer.button:IsShown()).toBe(true)
    -- the row's own hover kept while the layer is over it; gone when it leaves
    assert(r.onRowLeave)(row)
    mock.player:enterCombat()
    for _, o in pairs(M.overs) do expect(o.button:IsShown()).toBe(false) end
    expect(layer.button:IsShown()).toBe(false)
    mock.player:leaveCombat()
    mock.advanceTime(0.3)
end
