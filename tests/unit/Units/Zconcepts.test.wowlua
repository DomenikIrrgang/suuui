-- Screenshot scenes for the raid theme concepts (concept branch only): each
-- concept's look over the character window, the player and target frames,
-- the minimap and chat.
--   wowlua screenshot tests/unit/Units/Zconcepts.test.wowlua --test karazhan-a -o out.png

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as errors from "wowlua:errors"
import * as settings from "/Core/Settings"
import * as themes from "/Core/Themes"

local function scene(id: string)
    local welcome = SuuUI.GetModule("welcome")
    if welcome then
        errors.tryMethod(welcome, "Close")
    end
    settings.setAccount("theme", id)
    themes.apply()
    local mob = mock.spawnUnit({ name = "Bloodscalp Hunter", level = 40, reaction = "hostile", distance = 12, health = 62, healthMax = 100 })
    mock.player:target(mob)
    mock.pressBinding("TOGGLECHARACTER0")
    mock.advanceTime(1)
    mock.advanceFrames(10)
    expect(true).toBe(true)
end

@test("karazhan-a")
local function karazhanA() scene("concept-karazhan-a") end
@test("karazhan-b")
local function karazhanB() scene("concept-karazhan-b") end
@test("karazhan-c")
local function karazhanC() scene("concept-karazhan-c") end
@test("sunwell-a")
local function sunwellA() scene("concept-sunwell-a") end
@test("sunwell-b")
local function sunwellB() scene("concept-sunwell-b") end
@test("sunwell-c")
local function sunwellC() scene("concept-sunwell-c") end
