-- Units/FlightMap/Window: the flight master's window's side panel, its
-- rows and tooltips, away from a flight master (the window at one is driven
-- through the whole module in Units/FlightMap's tests). The functions take
-- the module (Units/FlightMap's).

import test, expect from "wowlua:test"
import internal M from "/Units/FlightMap"
import * as flightWindow from "/Units/FlightMap/Window"
import type TaxiNode from "/Units/FlightMap/Route"
import expectNoErrors from "../../../helpers"

local CROSSROADS: TaxiNode = { slot = 3, id = 25, name = "Crossroads, The Barrens", kind = "REACHABLE", cost = 110 }

@test("away from a flight master: no tooltip, no bar, the side panel not placed")
local function away()
    expect(M.session).toBeNil()
    expect(flightWindow.tip(M, CROSSROADS)).toEqual({})
    flightWindow.updateBar(M)
    expect(M.bar).toBeNil()
    flightWindow.placeSide(M)
    flightWindow.fitWindow(M)
    expectNoErrors()
end

@test("the side panel made once; with no session it lists no destination")
local function sidePanel()
    local side = flightWindow.buildSide(M)
    expect(flightWindow.buildSide(M)).toBe(side)
    expect(flightWindow.fillSide(M)).toBe(side)
    expect(side.head.meta).toHaveText("0")
    expect(M.steps).toEqual({})
    expectNoErrors()
end

@test("a row made once; painted: filled while hovered, edged while chosen")
local function rows()
    local row = flightWindow.makeRow(M, 1)
    expect(flightWindow.makeRow(M, 1)).toBe(row)
    row.hover = true
    flightWindow.paintRow(M, row)
    expect(row.fill).toBeShown()
    expect(row.edge.top).never.toBeShown()
    row.hover = false
    row.node = CROSSROADS
    M.selected = CROSSROADS
    flightWindow.paintRow(M, row)
    expect(row.fill).toBeShown()
    expect(row.edge.top).toBeShown()
    M.selected = nil
    row.node = nil
    flightWindow.paintRow(M, row)
    expect(row.fill).never.toBeShown()
    expectNoErrors()
end
