-- Units/Notifications/Secure: a note's secure macro button, and its click
-- on one of the game's buttons.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import type Notification from "/UI/Notification"
import internal M from "/Units/Notifications"
import MacroButton from "/Units/Notifications/Secure"
import expectNoErrors from "../../../helpers"

local function tick(seconds: number?)
    -- the stack's tick runs on frames, ten a second
    mock.advanceFrames(math.max(1, math.floor((seconds or 0.2) * 10)), 100)
end

local function hideAll()
    for i = 1, 4 do
        local d = frames.find("StaticPopup" .. i)
        if d and d:IsShown() then
            d:Hide()
        end
    end
end

@afterEach
local function cleanup()
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    M:ResetAll({
        "requests",
        "max",
        "durability",
        "bagsFull",
        "talentPoints",
        "legacyPoints",
        "presenceBnetOnline",
        "presenceBnetOffline",
        "presenceFriendOnline",
        "presenceFriendOffline",
        "presenceGuildOnline",
        "presenceGuildOffline",
        "presenceHideChat",
    })
    hideAll()
    for id in pairs(M.notes) do
        M:Dismiss(id)
    end
    M.presence = nil
    mock.group:leave()
    tick(1)
    expectNoErrors()
end

@test("a note's macro action: a secure button over it, out of combat")
local function secureAction()
    local after = mock.spy(function(_: Notification) end)
    local id = M:Notify({
        kind = "sticky",
        category = "Group Finder",
        title = "Your listing",
        actions = { { label = "Open", variant = "primary", macro = "/run print(1)", onClick = after } },
    }) :: string
    M:SecureActions()
    local s = M.secure[id .. "#1"]
    if s then
        expect(s:GetAttribute("type1")).toBe("macro")
        expect(s:GetAttribute("macrotext1")).toBe("/run print(1)")
        mock.player:enterCombat()
        expect(s:IsShown()).toBe(false)
        mock.player:leaveCombat()
    end
    M:Dismiss(id)
    M:SecureActions()
end

@test("a note's click action: a secure click on the game's button, left out when it says so")
local function secureClick()
    local target = CreateFrame("Button", "SuuUITestNoteTarget", UIParent)
    local clicked = 0
    target:SetScript("OnClick", function()
        clicked = clicked + 1
    end)
    local skip, after = false, 0
    local id = M:Notify({
        kind = "sticky",
        category = "Durability",
        title = "Show me",
        actions = {
            {
                label = "Show",
                variant = "primary",
                click = function(): Frame?
                    return target
                end,
                skipClick = function(): boolean
                    return skip
                end,
                onClick = function()
                    after = after + 1
                end,
            },
        },
    }) :: string
    M:SecureActions()
    local s = assert(M.secure[id .. "#1"])
    expect(s:GetAttribute("type1")).toBe("click")
    expect(s:GetAttribute("clickbutton1")).toBe(target)
    mock.click(s)
    expect(clicked).toBe(1)
    expect(after).toBe(1)
    -- skipped: the onClick only, and the click is back for the next time
    skip = true
    mock.click(s)
    expect(clicked).toBe(1)
    expect(after).toBe(2)
    expect(s:GetAttribute("type1")).toBe("click")
    M:Dismiss(id)
    M:SecureActions()
end

@test("a secure button of its own: the hover passed to the button under it; released, hidden and empty")
local function macroButton()
    local s = MacroButton.new()
    local under = CreateFrame("Button", nil, UIParent)
    local entered, left = 0, 0
    under:SetScript("OnEnter", function()
        entered = entered + 1
    end)
    under:SetScript("OnLeave", function()
        left = left + 1
    end)
    s.over = under
    s:Pass("OnEnter")
    s:Pass("OnLeave")
    expect(entered).toBe(1)
    expect(left).toBe(1)
    s.after = function() end
    s.kind = "macro"
    s:Show()
    s:Release()
    expect(s:IsShown()).toBe(false)
    expect(s.over).toBeNil()
    expect(s.after).toBeNil()
    expect(s.kind).toBeNil()
    -- nothing under it: nothing passed
    s:Pass("OnEnter")
    expect(entered).toBe(1)
end
