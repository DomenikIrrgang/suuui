-- Units/Spellbook: the spells window opened for the first time in a fight
-- (never opened before it) at the size and place it has out of combat
-- (found in game: it opened against the top of the screen). Its own file:
-- no earlier test may open the window first.

import test, expect from "wowlua:test"
import * as frames from "wowlua:frames"
import * as mock from "wowlua:mock"
import expectNoErrors from "../../helpers"

@test("first opened in a fight: at the Spellbook's size and place, as out of combat")
local function firstInCombat()
    local f = assert(frames.find("PlayerSpellsFrame"))
    local key = GetBindingKey("TOGGLESPELLBOOK") :: string
    mock.advanceTime(2)
    mock.pressKey("ESCAPE") -- (SuuUI's welcome, as at a first login, gone)
    mock.advanceFrames(2)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    mock.pressKey(key)
    mock.advanceFrames(3)
    expect(f:IsShown()).toBe(true)
    local w, h = f:GetWidth(), f:GetHeight()
    local top, left = f:GetTop(), f:GetLeft()
    mock.pressKey(key)
    mock.advanceFrames(2)
    mock.player:leaveCombat()
    mock.advanceFrames(2)
    mock.pressKey(key)
    mock.advanceFrames(3)
    expect(f:IsShown()).toBe(true)
    expect(w).toBeCloseTo(f:GetWidth())
    expect(h).toBeCloseTo(f:GetHeight())
    expect(top).toBeCloseTo(f:GetTop())
    expect(left).toBeCloseTo(f:GetLeft())
    expectNoErrors()
end
