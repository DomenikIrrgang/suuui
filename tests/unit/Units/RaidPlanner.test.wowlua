-- Units/RaidPlanner: the module as a whole (its parts' tests are in
-- Units/RaidPlanner/): specs a day old forgotten as it starts, the
-- migration, off and on through the registry, stopped.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import internal M from "/Units/RaidPlanner"
import migrations as settingMigrations from "/Core/Settings"
import field from "wowlua:table"
import expectNoErrors, cycle, NOTHING from "../../helpers"
import * as comm from "/Core/Comm"
import cleanup, setup, window from "./RaidPlanner/Fixtures"

@afterEach
local function afterTest()
    cleanup()
end

@test("specs a day old are forgotten as the module starts")
local function staleSpecs()
    setup()
    M:NoteSpec("Raider Warrior", 3, "message")
    M:Data().specs["Raider Old"] = { tree = 1, at = time() - 2 * 86400 }
    rawset(M:Data().specs, "Raider Bad", 5)
    -- (started again: what it registers once left alone)
    for _, name in ipairs({ "RegisterSettings", "Provide", "RegisterCommand", "OnGameEvent", "On", "Watch", "OnAddonMessage" }) do
        mock.stub(M, name, function() end)
    end
    M:OnEnable()
    expect(M:Data().specs["Raider Old"]).toBeNil()
    expect(M:Data().specs["Raider Bad"]).toBeNil()
    expect(assert(M:Data().specs["Raider Warrior"]).tree).toBe(3)
    M:NoteSpec("Raider Warrior", 9, "message")
    expect(assert(M:Data().specs["Raider Warrior"]).tree).toBe(3)
end

@test("Strength of Earth and Grace of Air split: Grace of Air tracked wherever the pair was")
local function migration()
    local values: { [string]: unknown } = { tracked = { earth = true } }
    local ran = false
    for _, m in ipairs(settingMigrations()) do
        if m.namespace == "raidplanner" and m.id == "graceOfAir" then
            m.fn(values)
            ran = true
        end
    end
    expect(ran).toBe(true)
    expect(field(values, "tracked", "graceOfAir")).toBe(true)
end

@test("off and on through the registry: nothing left behind (its addon message handlers too), nothing doubled")
local function leavesNothing()
    -- (a first cycle settles what "specs a day old" doubled by starting it by hand)
    cycle("raidplanner")
    local c = cycle("raidplanner")
    expect(c.off).toEqual(NOTHING)
    expect(c.after).toEqual(c.before)
    expect(comm.count(M)).toBe(2)
    expectNoErrors()
end

-- (last: the module off)
@test("stopped: the window hidden, inspecting dropped")
local function disabled()
    setup()
    M:Toggle()
    M.inspecting = mock.partial({})
    M:OnDisable()
    expect(window():IsShown()).toBe(false)
    expect(M.inspecting).toBeNil()
end
