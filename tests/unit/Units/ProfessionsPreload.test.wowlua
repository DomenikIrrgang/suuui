-- Units/Professions: Blizzard's professions window loaded and made SuuUI's
-- at login, before any fight (found in game: first opened in a fight it
-- showed Blizzard's own). Its own file: no earlier test may open it.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import chromeOf from "/UI/WindowSkin"
import * as frames from "wowlua:frames"
import internal M from "/Units/Professions"

@test("ready at login: Blizzard's window loaded, SuuUI's skin and page on it")
local function readyAtLogin()
    mock.advanceTime(1)
    expect(C_AddOns.IsAddOnLoaded("Blizzard_Professions")).toBe(true)
    expect(chromeOf(assert(frames.find("ProfessionsFrame"))) ~= nil).toBe(true)
    expect(M.view ~= nil).toBe(true)
end
