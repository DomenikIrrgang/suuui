-- Units/Support: SuuUI's Support window around a Browser frame (toolbar,
-- loading mark, unavailable state), opened instead of the game's HelpFrame.

import test, expect, cases, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import internal M, call from "/Units/Support"
import type SupportWindow from "/Units/Support"

import expectNoErrors from "../../helpers"

-- what the module built
local function ui(): SupportWindow return assert(M.ui) end

@beforeEach
local function closed()
    ui().window:Hide()
    M:Loaded()
end

@afterEach
local function clean()
    ui().window:Hide()
    expectNoErrors()
end

@test("is on at login with its window built and hidden")
local function builtAtLogin()
    expect(M:IsEnabled()).toBe(true)
    expect(ui().window).toBe(_G.SuuUISupportWindow)
    expect(ui().window).never.toBeShown()
    expect(ui().browser).toBeTruthy()
    expect(M.hooked).toBe(true)
end

@test("call: only functions, and nothing when they fail")
local function callHelper()
    expect(call(nil)).toBeNil()
    expect(call("x")).toBeNil()
    expect(call(function(a: number): number return a * 2 end, 4)).toBe(8)
    expect(call(function() error("boom") end)).toBeNil()
end

@test("Open shows the window loading the knowledge base")
local function opens()
    local home = mock.spy()
    mock.stub(ui().browser, "NavigateHome", home)
    M:Open()
    expect(ui().window).toBeShown()
    expect(ui().over).toBeShown()
    expect(ui().over.mark).toBeShown()
    expect(ui().over.note).toHaveText("Loading support…")
    expect(ui().over.title).never.toBeShown()
    expect(ui().over.retry).never.toBeShown()
    expect(ui().where).toHaveText("Loading…")
    expect(M.loadingSince).toBe(GetTime())
    expect(home).toHaveBeenCalledWith(ui().browser, "KnowledgeBase")
end

@test("the mark gives way after 12 seconds when the page never says it's done")
local function loadLimit()
    M:Open()
    mock.advanceTime(11.5)
    expect(ui().over).toBeShown()
    mock.advanceTime(1)
    expect(ui().over).never.toBeShown()
    expect(ui().where).toHaveText("Blizzard support")
    expect(M.loadingSince).toBeNil()
end

@test("a newer load keeps the older one's limit from ending it")
local function newerLoad()
    M:Load("NavigateReload")
    mock.advanceTime(6)
    M:Load("NavigateReload")
    mock.advanceTime(7) -- the first limit passed
    expect(ui().over).toBeShown()
    mock.advanceTime(6) -- the second's
    expect(ui().over).never.toBeShown()
end

@test("the browser's done-loading ends the loading; other updates don't")
local function doneLoading()
    M:Open()
    mock.script(ui().browser, "OnButtonUpdate", "enableback")
    expect(ui().over).toBeShown()
    mock.script(ui().browser, "OnButtonUpdate", "doneloading")
    expect(ui().over).never.toBeShown()
    expect(ui().where).toHaveText("Blizzard support")
end

@test("the browser's error shows the unavailable state with Retry")
local function browserError()
    M:Open()
    mock.script(ui().browser, "OnError")
    expect(ui().over).toBeShown()
    expect(ui().over.mark).never.toBeShown()
    expect(ui().over.note).never.toBeShown()
    expect(ui().over.title).toHaveText("Support is unavailable right now")
    expect(ui().over.text).toHaveText("The support page didn't load. Check your connection and try again in a moment.")
    expect(ui().over.retry).toBeShown()
    expect(ui().where).toHaveText("")
    expect(M.loadingSince).toBeNil()
    -- Retry loads the knowledge base again
    local home = mock.spy()
    mock.stub(ui().browser, "NavigateHome", home)
    mock.click(ui().over.retry)
    expect(home).toHaveBeenCalledWith(ui().browser, "KnowledgeBase")
    expect(ui().over.retry).never.toBeShown()
    expect(ui().over.mark).toBeShown()
end

@test("the game's browser failure events while the window shows")
@cases({ { "SIMPLE_BROWSER_WEB_PROXY_FAILED" }, { "SIMPLE_BROWSER_WEB_ERROR" } })
local function failureEvents(event: string)
    local function fire()
        if event == "SIMPLE_BROWSER_WEB_ERROR" then mock.fireEvent(event, 1) else mock.fireEvent(event) end
    end
    -- hidden: nothing happens
    ui().over:Hide()
    fire()
    expect(ui().over).never.toBeShown()
    M:Open()
    fire()
    expect(ui().over.retry).toBeShown()
    expect(ui().over.title).toHaveText("Support is unavailable right now")
end

@test("the toolbar: back and forward call the browser, reload and home load")
local function toolbar()
    ui().window:Show()
    local back, forward, reload, home = mock.spy(), mock.spy(), mock.spy(), mock.spy()
    mock.stub(ui().browser, "NavigateBack", back)
    mock.stub(ui().browser, "NavigateForward", forward)
    mock.stub(ui().browser, "NavigateReload", reload)
    mock.stub(ui().browser, "NavigateHome", home)
    mock.click(ui().back)
    expect(back).toHaveBeenCalledTimes(1)
    expect(ui().over).never.toBeShown() -- back and forward don't show the mark
    mock.click(ui().forward)
    expect(forward).toHaveBeenCalledTimes(1)
    mock.click(ui().reload)
    expect(reload).toHaveBeenCalledTimes(1)
    expect(ui().over).toBeShown()
    mock.click(ui().home)
    expect(home).toHaveBeenCalledWith(ui().browser, "KnowledgeBase")
end

@test("Call skips a method the browser lacks, and a missing browser")
local function callMissing()
    M:Call("NoSuchMethod", 1)
    local b = ui().browser
    ui().browser = nil
    M:Call("NavigateBack")
    ui().browser = b
end

@test("without a browser a load is the unavailable state at once")
local function noBrowser()
    local b = ui().browser
    ui().browser = nil
    M:Open()
    ui().browser = b
    expect(ui().over.retry).toBeShown()
    expect(M.loadingSince).toBeNil()
end

@test("Toggle opens and closes")
local function toggles()
    M:Toggle()
    expect(ui().window).toBeShown()
    expect(ui().over).toBeShown()
    M:Toggle()
    expect(ui().window).never.toBeShown()
end

@test("the browser's own keys and links")
local function browserScripts()
    local focus = mock.spy()
    mock.stub(ui().browser, "ClearFocus", focus)
    mock.script(ui().browser, "OnEscapePressed")
    expect(focus).toHaveBeenCalledTimes(1)
    -- closing the window clears the browser's focus too
    M:Open()
    ui().window:Hide()
    expect(focus).toHaveBeenCalledTimes(2)
    -- a link out of the game: the game's question, the address without its query
    local show = mock.spy()
    mock.stub(_G, "StaticPopup_Show", show)
    mock.script(ui().browser, "OnExternalLink", "https://example.com/a?b=c")
    expect(show).toHaveBeenCalledWith("EXTERNAL_LINK", "https://example.com/a", nil,
        { url = "https://example.com/a?b=c", browser = ui().browser })
end

@test("the game's HelpFrame opens this window instead")
local function helpFrame()
    local help: Frame = _G.HelpFrame
    help:Show()
    expect(help).never.toBeShown()
    expect(ui().window).toBeShown()
    -- turned off (until the reload): the game's frame stays
    ui().window:Hide()
    mock.stub(M, "IsEnabled", function(): boolean return false end)
    help:Show()
    expect(ui().window).never.toBeShown()
    help:Hide()
end

-- last: OnEnable again adds its event handlers a second time
@test("OnDisable hides the window; OnEnable again builds nothing new")
local function disableEnable()
    M:Open()
    assert(M.OnDisable)(M)
    expect(ui().window).never.toBeShown()
    local w = ui().window
    assert(M.OnEnable)(M)
    expect(ui().window).toBe(w)
end
