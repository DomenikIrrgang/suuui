-- Units/CooldownManager: the Cooldown Manager module (the tracker itself is
-- UI/CooldownTracker's, tested there; the list work is CooldownManager/
-- Lists', Conditions' and Migrations'; the settings editor is
-- CooldownManager/Editor's, Rows', Behaviour's and EditorData's). The spec
-- from the talent trees, setups per class and spec from their presets, the
-- lists from before setups, what the tracker and the resource bar are
-- given, "Seen recently", Blizzard's Cooldown Manager switched off and
-- back, the settings rows. The character is an Unspecced warrior.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import type ListSet, Recent from "/Units/CooldownManager/Lists"
import * as Lists from "/Units/CooldownManager/Lists"
import internal M from "/Units/CooldownManager"
import * as modules from "/Core/Modules"
import * as cvars from "/Core/CVars"
import migrations as settingMigrations from "/Core/Settings"
import type Values from "/Core/Settings"
import expectNoErrors, testRow, TestRow, cycle, NOTHING from "../../helpers"
import setUp, tearDown, section, names, replaced from "./CooldownManager/EditorHelpers"

local UI = SuuUI.UI

@beforeEach
local function begin()
    setUp()
end

@afterEach
local function finish()
    tearDown()
end

local function rowOf(label: string): TestRow
    for _, g in ipairs(section().groups or {}) do
        for _, r in ipairs(g.rows) do
            if r.label == label then
                return testRow(r)
            end
        end
    end
    error("no row " .. label)
end

-- The kinds of "Seen recently" of this warrior (this character's data).
local function recentOf(kind: string): Recent[]
    local all = assert(M:CharData().recent) :: { [string]: Recent[] }
    return (assert(all[kind]))
end

--------------------------------------------------------------------------------
-- Spec and setups
--------------------------------------------------------------------------------

-- Three trees side by side, `ranks` points spent in each.
local function fakeTrees(ranks: number[])
    mock.stub(C_Traits, "GetConfigInfo", function(_: number): unknown
        return { treeIDs = { 1 } }
    end)
    mock.stub(C_Traits, "GetTreeNodes", function(_: number): unknown
        return { 11, 12, 13, 14 }
    end)
    mock.stub(C_Traits, "GetNodeInfo", function(_: number, node: number): unknown
        if node == 14 then
            return { posX = 30000 }
        end -- off the trees: not counted
        return { posX = (node - 11) * 3000, ranksPurchased = ranks[node - 10] }
    end)
end

@test("the spec is the tree with the most points; none spent: Unspecced; a broken read too")
local function spec()
    expect(M:DetectSpec()).toBe(0)
    fakeTrees({ 1, 5, 2 })
    local s, pts = M:DetectSpec()
    expect(s).toBe(2)
    expect(pts).toEqual({ 1, 5, 2 })
    local told = 0
    events.on(
        "SUUUI_COOLDOWNS_SETUP",
        function()
            told = told + 1
        end,
        "cd test"
    )
    M:UpdateSpec()
    expect(M.spec).toBe(2)
    expect(told).toBe(1)
    M:UpdateSpec() -- the same: nothing
    expect(told).toBe(1)
    -- new talent points: the spec checked again a moment later
    fakeTrees({ 0, 0, 0 })
    mock.fireEvent("CHARACTER_POINTS_CHANGED", 0)
    mock.advanceTime(0.3)
    expect(M.spec).toBe(0)
    mock.stub(C_Traits, "GetConfigInfo", function(_: number): unknown
        error("not ready")
    end)
    expect(M:DetectSpec()).toBe(0)
    events.offAll("cd test")
end

@test("a spec's setup starts from its preset; Load replaces it; a preset that isn't there loads nothing")
local function setups()
    expect(M:PresetId(1)).toBe("arms")
    expect(#assert(M:Lists(1).essential) > 0).toBe(true)
    expect(M:LoadPreset("fury", 1)).toBe(true)
    expect(M:PresetId(1)).toBe("fury")
    expect(M:LoadPreset("no such preset", 1)).toBe(false)
    M:SetLists(replaced(M:Lists(1), "essential", {}), 1)
    expect(#assert(M:Lists(1).essential)).toBe(0)
    expect(M:EditSpec()).toBe(0)
    M.editSpec = 3
    expect(M:EditSpec()).toBe(3)
end

@test("the lists from before setups go to this spec's setup once, unless it has one; another class's are dropped")
local function migrateLists()
    local old: ListSet = { essential = { { name = "Old Spell", ids = { 1 } } } }
    M.spec = 2 -- a spec without a setup yet
    M:Set("lists", old)
    M:Set("preset", "unspecced")
    M:MigrateLists()
    expect(names(M:Lists(2).essential)).toEqual({ "Old Spell" })
    expect(M:Get("lists")).toEqual({})
    expect(M:Get("preset")).toBe("")
    -- a setup there already: kept
    M:Set("lists", { essential = { { name = "Other", ids = { 2 } } } })
    M:Set("preset", "unspecced")
    M:MigrateLists()
    expect(names(M:Lists(2).essential)).toEqual({ "Old Spell" })
    -- nothing from before: nothing
    M:MigrateLists()
    -- a preset this class doesn't have (another class's lists): dropped
    M:Set("lists", { essential = { { name = "Mage Thing", ids = { 3 } } } })
    M:Set("preset", "frost")
    M:MigrateLists()
    expect(names(M:Lists(2).essential)).toEqual({ "Old Spell" })
    M.spec = 0
end

@test("the tracker gets this spec's lists and options; where and when it shows; the resource bar's options")
local function applied()
    local tracker = assert(M.tracker)
    local setLists = mock.stub(tracker, "SetLists", function(_: unknown, _: unknown) end)
    local setOptions = mock.stub(tracker, "SetOptions", function(_: unknown, _: unknown) end)
    M:Set("essentialSize", 44)
    expect(setOptions).toHaveBeenCalledTimes(1)
    expect(setLists).toHaveBeenCalledTimes(1)
    local vis = mock.stub(UI, "SetVisibility", function(_: unknown, _: string?) end)
    M:Set("shows", "combat")
    -- (0.47: the module as the owner)
    expect(vis).toHaveBeenCalledWith(tracker, "combat", nil, M)
    M:Set("position", { point = "BOTTOM", x = 0, y = 322, hidden = true })
    expect(vis).toHaveBeenCalledWith(tracker, "hidden", nil, M)
    local width: number? = nil
    local bar = assert(M.resource)
    mock.stub(bar, "SetOptions", function(_: unknown, o: { width?: number })
        width = o.width
    end)
    local stop = mock.stub(bar, "Stop", function(_: unknown) end)
    local start = mock.stub(bar, "Start", function(_: unknown) end)
    M:Set("resource", "off")
    expect(stop).toHaveBeenCalledTimes(1)
    M:Set("resource", "power")
    expect(start).toHaveBeenCalledTimes(1)
    M:Set("resourceWidth", "own")
    expect(width).toBe(M:Get("resourceOwnWidth"))
    M:Set("resourceWidth", "cast")
    local was = 340
    settings.set("castbars", "playerWidth", was + 20)
    expect(width).toBe(was + 20)
    settings.set("castbars", "playerWidth", was)
end

--------------------------------------------------------------------------------
-- Seen recently
--------------------------------------------------------------------------------

@test("seen recently: your spells with a cooldown as you cast them, the auras on you and your target out of combat")
local function seenRecently()
    mock.fake("IsPlayerSpell", function(id: number): boolean
        return id == 100
    end)
    mock.fake("GetSpellBaseCooldown", function(id: number): number
        return id == 100 and 15000 or 0
    end)
    mock.fireUnitEvent("UNIT_SPELLCAST_SUCCEEDED", "player", "Cast-1", 100)
    mock.fireUnitEvent("UNIT_SPELLCAST_SUCCEEDED", "player", "Cast-2", 78) -- not known
    expect(recentOf("cooldown")[1].ids).toEqual({ 100 })
    mock.player:applyAura({ spellId = 6673, name = "Battle Shout" })
    mock.advanceTime(1.1)
    expect(recentOf("aura")[1].name).toBe("Battle Shout")
    mock.fireEvent("PLAYER_TARGET_CHANGED")
    mock.advanceTime(0.6)
    -- in combat: not read
    mock.player:enterCombat()
    mock.player:applyAura({ spellId = 2457, name = "Battle Stance" })
    mock.advanceTime(1.1)
    expect(recentOf("aura")[1].name).toBe("Battle Shout")
end

@test("seen recently: kept out of the profile (no setting written on a cast); one scan waits at a time; none after the module is off")
local function seenRecentlyQuiet()
    mock.fake("IsPlayerSpell", function(id: number): boolean
        return id == 100
    end)
    mock.fake("GetSpellBaseCooldown", function(id: number): number
        return id == 100 and 15000 or 0
    end)
    local heard = 0
    events.on("SUUUI_SETTING_CHANGED", function(_: string, namespace: string)
        if namespace == "cooldowns" then
            heard += 1
        end
    end, "zz cooldowns test")
    mock.fireUnitEvent("UNIT_SPELLCAST_SUCCEEDED", "player", "Cast-1", 100)
    expect(recentOf("cooldown")[1].ids).toEqual({ 100 })
    expect(heard).toBe(0)
    events.offAll("zz cooldowns test")
    -- target changes and aura changes share one waiting scan
    local scans = 0
    mock.stub(Lists, "mergeRecent", function(): unknown
        scans += 1
        return nil
    end)
    for _ = 1, 5 do
        mock.fireEvent("PLAYER_TARGET_CHANGED")
    end
    mock.player:applyAura({ spellId = 6673, name = "Battle Shout" })
    mock.advanceTime(1.1)
    expect(scans).toBe(1)
    -- a scan waiting when the module turns off doesn't run
    mock.fireEvent("PLAYER_TARGET_CHANGED")
    settings.set("cooldowns", "enabled", false)
    mock.advanceTime(1.1)
    expect(scans).toBe(1)
    settings.set("cooldowns", "enabled", true)
    mock.fireEvent("PLAYER_TARGET_CHANGED")
    mock.advanceTime(0.6)
    expect(scans).toBe(2)
end

--------------------------------------------------------------------------------
-- Blizzard's Cooldown Manager, the settings rows
--------------------------------------------------------------------------------

const VIEWER = "cooldownViewerEnabled"

@test("Blizzard's Cooldown Manager is switched off while this runs, and back on after")
local function blizzardViewer()
    settings.set("cooldowns", "enabled", false)
    C_CVar.SetCVar(VIEWER, "1")
    settings.set("cooldowns", "enabled", true)
    expect(C_CVar.GetCVar(VIEWER)).toBe("0")
    expect(cvars.rememberedValue("cooldowns", VIEWER)).toBe("1")
    settings.set("cooldowns", "enabled", false)
    expect(C_CVar.GetCVar(VIEWER)).toBe("1")
    expect(cvars.remembered("cooldowns")).toBe(0)
    -- the player had it off: it stays off
    C_CVar.SetCVar(VIEWER, "0")
    settings.set("cooldowns", "enabled", true)
    settings.set("cooldowns", "enabled", false)
    expect(C_CVar.GetCVar(VIEWER)).toBe("0")
    C_CVar.SetCVar(VIEWER, "1")
    settings.set("cooldowns", "enabled", true)
end

@test("a profile switch that turns the module off gives Blizzard's manager back (X-11.a2)")
local function viewerProfileSwitch()
    settings.set("cooldowns", "enabled", false)
    C_CVar.SetCVar(VIEWER, "1")
    settings.set("cooldowns", "enabled", true)
    local before = settings.profiles.current()
    settings.profiles.create("ZZ Cooldowns Off")
    settings.profiles.use("ZZ Cooldowns Off")
    settings.set("cooldowns", "enabled", false)
    expect(M.state).toBe(modules.ModuleState.Disabled)
    expect(C_CVar.GetCVar(VIEWER)).toBe("1")
    settings.profiles.use(before)
    expect(M.state).toBe(modules.ModuleState.Enabled)
    expect(C_CVar.GetCVar(VIEWER)).toBe("0")
    settings.profiles.delete("ZZ Cooldowns Off")
end

@test("migration: viewerOff leaves the profile for this character's data, handed to the CVar memory at the next enable")
local function viewerMigration()
    local found = false
    for _, m in ipairs(settingMigrations()) do
        if m.namespace == "cooldowns" and m.id == "viewerOff-cvar" then
            found = true
            local data = M:CharData()
            local off: Values = { viewerOff = false, shows = "combat" }
            m.fn(off)
            expect(off).toEqual({ shows = "combat" })
            expect(data.viewerOff).toBeNil()
            local on: Values = { viewerOff = true }
            m.fn(on)
            expect(on.viewerOff).toBeNil()
            expect(data.viewerOff).toBe(true)
            m.fn(on)
            m.fn({})
            expect(data.viewerOff).toBe(true)
        end
    end
    expect(found).toBe(true)
    -- as after an update: an older SuuUI switched it off ("0"), the memory
    -- holds nothing
    settings.set("cooldowns", "enabled", false)
    C_CVar.SetCVar(VIEWER, "0")
    settings.set("cooldowns", "enabled", true)
    expect(cvars.rememberedValue("cooldowns", VIEWER)).toBe("1")
    expect(M:CharData().viewerOff).toBeNil()
    expect(C_CVar.GetCVar(VIEWER)).toBe("0")
    settings.set("cooldowns", "enabled", false)
    expect(C_CVar.GetCVar(VIEWER)).toBe("1")
    settings.set("cooldowns", "enabled", true)
end

@test("migration: this class's Seen recently leaves the profile for the character's data")
local function recentMigration()
    local found = false
    for _, m in ipairs(settingMigrations()) do
        if m.namespace == "cooldowns" and m.id == "recent-chardata-WARRIOR" then
            found = true
            M:CharData().recent = nil
            local stored: Values = {
                recent = {
                    WARRIOR = { cooldown = { { name = "Recent Spell", ids = { 133 } } } },
                    MAGE = { aura = { { name = "Arcane Intellect", ids = { 1459 } } } },
                },
            }
            m.fn(stored)
            expect(recentOf("cooldown")[1].name).toBe("Recent Spell")
            expect(stored).toEqual({ recent = { MAGE = { aura = { { name = "Arcane Intellect", ids = { 1459 } } } } } })
            -- a character with a list keeps it; the class's entry still goes
            local again: Values = { recent = { WARRIOR = { aura = {} } } }
            m.fn(again)
            expect(recentOf("cooldown")[1].name).toBe("Recent Spell")
            expect(again).toEqual({})
            local odd: Values = { recent = "x" }
            m.fn(odd)
            expect(odd).toEqual({})
        end
    end
    expect(found).toBe(true)
end

@test("the resource rows need the bar; combo points and druid mana are for their classes")
local function settingRows()
    expect((rowOf("Width").disabled())).toBe(false)
    expect((rowOf("Own width").disabled())).toBe(true)
    local _, why = rowOf("Combo points").disabled()
    expect(why).toBe("Only rogues and druids use combo points.")
    local _, druid = rowOf("Druid mana in forms").disabled()
    expect(druid).toBe("Only druids change forms.")
    M:Set("resourceWidth", "own")
    expect((rowOf("Own width").disabled())).toBe(false)
    M:Set("resource", "power")
    local _, points = rowOf("Combo points").disabled()
    expect(points).toBe("Turn on Power + points first.")
    M:Set("resource", "off")
    local _, off = rowOf("Width").disabled()
    expect(off).toBe("Turn the resource bar on first.")
    expect((rowOf("Own width").disabled())).toBe(true)
    expect((rowOf("Druid mana in forms").disabled())).toBe(true)
end

-- (last) The module toggles live: turned off through the registry nothing
-- of it stays; on again, it all comes back.
@test("turned off through the registry: the tracker hidden and let go, Blizzard's manager back, nothing held; on again, all back")
local function disabled()
    settings.set("cooldowns", "enabled", false)
    C_CVar.SetCVar(VIEWER, "1")
    settings.set("cooldowns", "enabled", true)
    local t = assert(M.tracker)
    expect(t:IsShown()).toBe(true)
    local c = cycle("cooldowns")
    expect(c.stateOff).toBe(modules.ModuleState.Disabled)
    expect(c.off).toEqual(NOTHING)
    expect(c.after).toEqual(c.before)
    expect(c.stateOn).toBe(modules.ModuleState.Enabled)
    expect(t:IsShown()).toBe(true)
    expect(t.running).toBe(true)
    expect(C_CVar.GetCVar(VIEWER)).toBe("0")
    settings.set("cooldowns", "enabled", false)
    expect(t:IsShown()).toBe(false)
    expect(t.running).toBe(false)
    expect(C_CVar.GetCVar(VIEWER)).toBe("1")
    -- edit mode doesn't bring it back
    SuuUI.EditMode.Enter()
    expect(t:IsShown()).toBe(false)
    SuuUI.EditMode.Exit()
    settings.set("cooldowns", "enabled", true)
    expect(t:IsShown()).toBe(true)
    expectNoErrors()
end
