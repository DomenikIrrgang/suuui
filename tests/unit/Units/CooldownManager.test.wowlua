-- Units/CooldownManager: the Cooldown Manager module (the tracker itself is
-- UI/CooldownTracker's, tested there; the list work is CooldownManager/
-- Lists', Conditions' and Migrations'). The spec from the talent trees,
-- setups per class and spec from their presets, the lists from before
-- setups, what the tracker and the resource bar are given, the preset bar
-- (the setup picker, Load and Reset with their questions), the list editor
-- (tabs, heads, rows of every kind and their summaries, folds, shown, Move
-- to, remove, "+ Add", shared slots, collections, weapon enchants, dragging
-- and dropping), the Behaviour panel (every kind of entry, every control,
-- the conditions), "Seen recently", Blizzard's Cooldown Manager switched
-- off and back, the settings rows. The character is an Unspecced warrior.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import * as registry from "/SettingsUI/Registry"
import expectNoErrors, newParent from "../../helpers"

local M: any = assert(SuuUI.GetModule("cooldowns"))
local UI: any = SuuUI.UI
local G: any = _G

local confirmed: any = nil

@beforeEach
local function start()
    confirmed = nil
    mock.stub(UI, "Confirm", function(opts: any) confirmed = opts end)
end

@afterEach
local function cleanup()
    M.editSpec = nil
    for _, key in ipairs({ "setups", "recent", "lists", "preset", "shows", "position", "resource", "resourceWidth",
                           "resourceOwnWidth", "resourcePoints", "essentialSize" }) do
        M:Reset(key)
    end
    for _, c in ipairs({ SuuUI.Root:GetChildren() }) do
        local x: any = c
        if x.sections and x.cond and x:IsShown() then x:Hide() end
    end
    if InCombatLockdown() then mock.player:leaveCombat() end
    expectNoErrors()
end

local function section(): registry.Section
    return registry.get("cooldowns") :: registry.Section
end

local function build(n: number): any
    local host = newParent(700, 900)
    local f = ((section().groups or {})[1]).rows[n].build(host)
    f:SetPoint("TOPLEFT", host, "TOPLEFT")
    return f
end

local function presetBar(): any return build(1) end
local function editor(): any return build(2) end

local function rowOf(label: string): any
    for _, g in ipairs(section().groups or {}) do
        for _, r in ipairs(g.rows) do if r.label == label then return r end end
    end
    error("no row " .. label)
end

-- The editor's shown row with this name (a collection's in capitals).
local function row(f: any, name: string): any
    for _, r in ipairs(f.rows) do
        if r:IsShown() and (r.name:GetText() == name or r.name:GetText() == name:upper()) then return r end
    end
    error("no row " .. name)
end

local function hasRow(f: any, name: string): boolean
    for _, r in ipairs(f.rows) do
        if r:IsShown() and (r.name:GetText() == name or r.name:GetText() == name:upper()) then return true end
    end
    return false
end

local function names(list: any[]): string[]
    local out: string[] = {}
    for _, e in ipairs(list or {}) do out[#out + 1] = e.name end
    return out
end

local function click(seg: any, value: any)
    for _, b in ipairs(seg.buttons) do
        if b.option.value == value then mock.click(b) return end
    end
    error("no option " .. tostring(value))
end

local function auras(f: any)
    click(f.tabs, "auras")
end

local function lists(): any return M:Lists(M:EditSpec()) end

-- The Behaviour panel for a row.
local function behaviour(f: any, name: string): any
    mock.click(row(f, name).behaviour)
    assert(f.behaviour and f.behaviour:IsShown(), "no Behaviour panel")
    return f.behaviour
end

local function options(sel: any): string[]
    local out: string[] = {}
    for _, o in ipairs(sel.options) do out[#out + 1] = o.heading and ("# " .. o.heading) or tostring(o.value) end
    return out
end

local function has(list: string[], v: string): boolean
    for _, x in ipairs(list) do if x == v then return true end end
    return false
end

--------------------------------------------------------------------------------
-- Spec and setups
--------------------------------------------------------------------------------

-- Three trees side by side, `ranks` points spent in each.
local function fakeTrees(ranks: number[])
    mock.stub(C_Traits, "GetConfigInfo", function(_: number): any return { treeIDs = { 1 } } end)
    mock.stub(C_Traits, "GetTreeNodes", function(_: number): any return { 11, 12, 13, 14 } end)
    mock.stub(C_Traits, "GetNodeInfo", function(_: number, node: number): any
        if node == 14 then return { posX = 30000 } end      -- off the trees: not counted
        return { posX = (node - 11) * 3000, ranksPurchased = ranks[node - 10] }
    end)
end

@test("the spec is the tree with the most points; none spent: Unspecced; a broken read too")
local function spec()
    expect(M:DetectSpec()).toBe(0)
    fakeTrees({ 1, 5, 2 })
    local s, pts = M:DetectSpec()
    expect(s).toBe(2)
    expect(pts).toEqual({ 1, 5, 2 })
    local told = 0
    events.on("SUUUI_COOLDOWNS_SETUP", function() told = told + 1 end, "cd test")
    M:UpdateSpec()
    expect(M.spec).toBe(2)
    expect(told).toBe(1)
    M:UpdateSpec()                                 -- the same: nothing
    expect(told).toBe(1)
    -- new talent points: the spec checked again a moment later
    fakeTrees({ 0, 0, 0 })
    mock.fireEvent("CHARACTER_POINTS_CHANGED", 0)
    mock.advanceTime(0.3)
    expect(M.spec).toBe(0)
    mock.stub(C_Traits, "GetConfigInfo", function(_: number): any error("not ready") end)
    expect(M:DetectSpec()).toBe(0)
    events.offAll("cd test")
end

@test("a spec's setup starts from its preset; Load replaces it; a preset that isn't there loads nothing")
local function setups()
    expect(M:PresetId(1)).toBe("arms")
    expect(#M:Lists(1).essential > 0).toBe(true)
    expect(M:LoadPreset("fury", 1)).toBe(true)
    expect(M:PresetId(1)).toBe("fury")
    expect(M:LoadPreset("no such preset", 1)).toBe(false)
    local l = M:Lists(1)
    local copy: any = { essential = {}, utility = l.utility, buffs = l.buffs, debuffs = l.debuffs, procs = l.procs }
    M:SetLists(copy, 1)
    expect(#M:Lists(1).essential).toBe(0)
    expect(M:EditSpec()).toBe(0)
    M.editSpec = 3
    expect(M:EditSpec()).toBe(3)
end

@test("the lists from before setups go to this spec's setup once, unless it has one; another class's are dropped")
local function migrateLists()
    local old = { essential = { { name = "Old Spell", ids = { 1 } } } }
    M.spec = 2                                     -- a spec without a setup yet
    M:Set("lists", old)
    M:Set("preset", "unspecced")
    M:MigrateLists()
    expect(names(M:Lists(2).essential)).toEqual({ "Old Spell" })
    expect(M:Get("lists")).toEqual({})
    expect(M:Get("preset")).toBe("")
    -- a setup there already: kept
    M:Set("lists", { essential = { { name = "Other", ids = { 2 } } } })
    M:Set("preset", "unspecced")
    M:MigrateLists()
    expect(names(M:Lists(2).essential)).toEqual({ "Old Spell" })
    -- nothing from before: nothing
    M:MigrateLists()
    -- a preset this class doesn't have (another class's lists): dropped
    M:Set("lists", { essential = { { name = "Mage Thing", ids = { 3 } } } })
    M:Set("preset", "frost")
    M:MigrateLists()
    expect(names(M:Lists(2).essential)).toEqual({ "Old Spell" })
    M.spec = 0
end

@test("the tracker gets this spec's lists and options; where and when it shows; the resource bar's options")
local function applied()
    local setLists = mock.stub(M.tracker, "SetLists", function(_: any, _: any) end)
    local setOptions = mock.stub(M.tracker, "SetOptions", function(_: any, _: any) end)
    M:Set("essentialSize", 44)
    expect(setOptions).toHaveBeenCalledTimes(1)
    expect(setLists).toHaveBeenCalledTimes(1)
    local vis = mock.stub(UI, "SetVisibility", function(_: any, _: string?) end)
    M:Set("shows", "combat")
    expect(vis).toHaveBeenCalledWith(M.tracker, "combat")
    M:Set("position", { point = "BOTTOM", x = 0, y = 322, hidden = true })
    expect(vis).toHaveBeenCalledWith(M.tracker, "hidden")
    local resource: any = nil
    mock.stub(M.resource, "SetOptions", function(_: any, o: any) resource = o end)
    local stop = mock.stub(M.resource, "Stop", function(_: any) end)
    local start = mock.stub(M.resource, "Start", function(_: any) end)
    M:Set("resource", "off")
    expect(stop).toHaveBeenCalledTimes(1)
    M:Set("resource", "power")
    expect(start).toHaveBeenCalledTimes(1)
    M:Set("resourceWidth", "own")
    expect(resource.width).toBe(M:Get("resourceOwnWidth"))
    M:Set("resourceWidth", "cast")
    local cast: any = SuuUI.GetModule("castbars")
    local was = cast:Get("playerWidth")
    cast:Set("playerWidth", was + 20)
    expect(resource.width).toBe(was + 20)
    cast:Set("playerWidth", was)
end

--------------------------------------------------------------------------------
-- The preset bar
--------------------------------------------------------------------------------

@test("the preset bar: which spec's setup, this character's spec and talents, what the lists are based on")
local function bar()
    local f = presetBar()
    expect(options(f.setup)).toEqual({ "0", "1", "2", "3" })
    expect(f.setup.options[1].label).toBe("Unspecced (active)")
    expect(f.active:GetText()).toBe("This character: Unspecced · talents 0 / 0 / 0")
    expect(f.status:GetText()).toBe("Based on Unspecced")
    f.setup.onChange(1)
    expect(M:EditSpec()).toBe(1)
    expect(f.status:GetText()).toBe("Based on Arms")
end

@test("Load: the same preset unchanged loads at once; another, or over changes, asks first")
local function loading()
    local f = presetBar()
    mock.click(f.load)
    expect(confirmed).toBe(nil)
    f.select.onChange("arms")
    mock.click(f.load)
    expect(confirmed.title).toBe("Load Arms?")
    expect(confirmed.text).toBe("Your Unspecced lists are replaced with Arms's.")
    confirmed.onConfirm()
    expect(M:PresetId(0)).toBe("arms")
    -- one change: counted, and named in the question
    local l = M:Lists(0)
    local changed: any = { essential = { l.essential[2] }, utility = l.utility, buffs = l.buffs, debuffs = l.debuffs, procs = l.procs }
    M:SetLists(changed, 0)
    expect(M:Changes() > 0).toBe(true)
    expect(f.status:GetText():find("Based on Arms · ", 1, true) ~= nil).toBe(true)
    confirmed = nil
    mock.click(f.load)
    expect(confirmed.text:find("are lost.", 1, true) ~= nil).toBe(true)
end

@test("Reset to preset undoes the changes, after asking; with none, nothing; no preset: none loaded")
local function resetting()
    local f = presetBar()
    mock.click(f.reset)
    expect(confirmed).toBe(nil)
    local l = M:Lists(0)
    M:SetLists({ essential = {}, utility = l.utility, buffs = l.buffs, debuffs = l.debuffs, procs = l.procs }, 0)
    mock.click(f.reset)
    expect(confirmed.title).toBe("Reset to preset?")
    confirmed.onConfirm()
    expect(M:Changes()).toBe(0)
    M:SaveSetup(0, { preset = "", lists = {} })
    events.emit("SUUUI_COOLDOWNS_SETUP")
    expect(f.status:GetText()).toBe("No preset loaded")
    mock.click(f.load)                             -- nothing chosen
    mock.click(f.reset)
    expect(M:Changes()).toBe(0)
end

--------------------------------------------------------------------------------
-- The list editor: rows
--------------------------------------------------------------------------------

@test("Cooldowns: Essential and Utility with their counts, each spell's rank and conditions in words")
local function cooldownRows()
    local f = editor()
    expect(f.heads[1].title:GetText()).toBe("Essential")
    expect(f.heads[1].count:GetText()).toBe(#lists().essential .. " spells")
    local overpower = row(f, "Overpower")
    expect(overpower.rank:GetText():find("Battle", 1, true) ~= nil).toBe(true)
    expect(overpower.move).toBeShown()
    expect(row(f, "Bloodrage").rank:GetText():find("shows its effect", 1, true) ~= nil).toBe(true)
    mock.hover(overpower)
    mock.hover(nil)
    expect(f.adds[1].newCollection).never.toBeShown()   -- collections are for auras
end

@test("Auras: a collection open with its entries, a shared slot folded with its members' icons; folds toggle")
local function auraRows()
    local f = editor()
    auras(f)
    expect(f.heads[1].title:GetText()).toBe("Buffs on you")
    local coll = row(f, "Physical Debuffs")
    expect(coll.rank:GetText():find("collection · ", 1, true) ~= nil).toBe(true)
    expect(coll.folder).toBeShown()
    local armor = row(f, "Armor Reduction")
    expect(armor.mark).toBeShown()
    expect(armor.rank:GetText():find("1 slot · 2 auras · anyone", 1, true) ~= nil).toBe(true)
    expect(armor.strip[1]).toBeShown()
    expect(hasRow(f, "Sunder Armor")).toBe(false)
    mock.click(armor.fold)
    expect(hasRow(f, "Sunder Armor")).toBe(true)
    expect(row(f, "Sunder Armor").shown).never.toBeShown()   -- a member: no switch of its own
    mock.hover(armor.fold)
    mock.hover(nil)
    mock.click(row(f, "Physical Debuffs").fold)
    expect(hasRow(f, "Armor Reduction")).toBe(false)
    expect(row(f, "Physical Debuffs").strip[1]).toBeShown()
    local stuns = row(f, "Stuns")
    expect(stuns.rank:GetText():find("missing: hide", 1, true) ~= nil).toBe(true)
    expect(f.heads[2].count:GetText():find("entries · ", 1, true) ~= nil).toBe(true)
end

@test("a row's switch hides it, Move to sends it to the other list, × removes it")
local function rowControls()
    local f = editor()
    mock.click(row(f, "Execute").shown)
    local function find(name: string): (any, string?)
        for _, k in ipairs({ "essential", "utility" }) do
            for _, e in ipairs(lists()[k]) do if e.name == name then return e, k end end
        end
        return nil, nil
    end
    expect(find("Execute").hidden).toBe(true)
    row(f, "Execute").move.onChange("utility")
    local _, key = find("Execute")
    expect(key).toBe("utility")
    row(f, "Execute").move.onChange(nil)
    mock.click(row(f, "Execute").remove)
    expect(find("Execute")).toBe(nil)
end

@test("+ Add: seen recently first, then everything by name; a typed ID finds any spell")
local function adding()
    M:Set("recent", { WARRIOR = { cooldown = { { name = "Recent Spell", ids = { 133 } } } } })
    local f = editor()
    local add = f.adds[1].select
    local opts = options(add)
    expect(opts[1]).toBe("# Seen recently")
    expect(opts[2]).toBe("Recent Spell")
    expect(has(opts, "# All")).toBe(true)
    add.onChange("Recent Spell")
    expect(lists().essential[#lists().essential].name).toBe("Recent Spell")
    expect(add.lookup("133")[1].value).toBe("id:133")
    expect(add.lookup("x")).toBe(nil)
    expect(add.lookup("999999999")).toBe(nil)
    add.onChange("id:133")
    expect(lists().essential[#lists().essential].ids).toEqual({ 133 })
    add.onChange(nil)
    add.onChange("not a spell anyone knows")
end

@test("+ Shared slot opens a new one with its + Add to; + Collection in aura lists; adding into both")
local function slotsAndCollections()
    local f = editor()
    mock.click(f.adds[1].newSlot)
    local slot = lists().essential[#lists().essential]
    expect(slot.group).toBe(true)
    expect(slot.name).toBe("New shared slot")
    local addTo = f.addTos[1]
    expect(addTo).toBeShown()
    expect(addTo.select.placeholder).toBe("+ Add to New shared slot…")
    addTo.select.onChange("id:133")
    expect(lists().essential[#lists().essential].members[1].ids).toEqual({ 133 })
    addTo.select.onChange(nil)
    addTo.select.onChange("not a spell")
    auras(f)
    mock.click(f.adds[2].newCollection)
    local coll = lists().debuffs[#lists().debuffs]
    expect(coll.collection).toBe(true)
    local into: any = nil
    for _, a in ipairs(f.addTos) do
        if a:IsShown() and a.select.placeholder == "+ Add to New collection…" then into = a end
    end
    into.select.onChange("id:133")
    expect(lists().debuffs[#lists().debuffs].entries[1].ids).toEqual({ 133 })
end

@test("a weapon enchant is offered first in Buffs on you, and stays there")
local function enchants()
    local f = editor()
    auras(f)
    local add = f.adds[1].select
    local opts = options(add)
    expect(opts[1]).toBe("# Weapon enchants")
    expect(opts[2]).toBe("enchant:main")
    add.onChange("enchant:main")
    local e = lists().buffs[#lists().buffs]
    expect(e.enchant).toBe("main")
    local r = row(f, "Main-hand enchant")
    expect(r.rank:GetText()).toBe("weapon enchant")
    expect(r.move).never.toBeShown()
    expect(has(options(f.adds[1].select), "enchant:main")).toBe(false)
end

--------------------------------------------------------------------------------
-- Dragging and dropping
--------------------------------------------------------------------------------

-- The cursor at a row's top quarter (before), middle (onto) or bottom (after).
local function cursorOn(r: any, where: string)
    local s = r:GetEffectiveScale()
    local x, top = r:GetCenter(), r:GetTop()
    local h = r:GetHeight()
    local y = where == "before" and (top - 2) or where == "onto" and (top - h / 2) or (top - h + 1)
    mock.setCursorPosition(x * s, y * s)
end

local function drag(f: any, from: any, to: any, where: string)
    mock.script(from, "OnDragStart")
    cursorOn(to, where)
    mock.advanceFrames(1)
    mock.script(from, "OnDragStop")
end

@test("a row dropped before or after another moves there; the line marks where")
local function dropMove()
    local f = editor()
    local first = lists().essential[1].name
    local exec = row(f, "Execute")
    mock.script(exec, "OnDragStart")
    expect(f.ghost).toBeShown()
    cursorOn(row(f, first), "before")
    mock.advanceFrames(1)
    expect(f.line).toBeShown()
    mock.script(exec, "OnDragStop")
    expect(lists().essential[1].name).toBe("Execute")
    expect(f.ghost).never.toBeShown()
    -- onto Utility's foot: the end of that list
    drag(f, row(f, "Execute"), f.adds[2], "before")
    expect(lists().utility[#lists().utility].name).toBe("Execute")
    -- let go nowhere: nothing
    mock.script(row(f, "Execute"), "OnDragStart")
    mock.setCursorPosition(1, 1)
    mock.advanceFrames(1)
    mock.script(row(f, "Execute"), "OnDragStop")
    expect(lists().utility[#lists().utility].name).toBe("Execute")
end

@test("onto a single spell: asks to make a shared slot of the two")
local function dropOntoEntry()
    local f = editor()
    drag(f, row(f, "Execute"), row(f, "Thunder Clap"), "onto")
    expect(confirmed.title).toBe("Make a shared slot?")
    expect(confirmed.text:find("Thunder Clap + Execute", 1, true) ~= nil).toBe(true)
    confirmed.onConfirm()
    local slot: any = nil
    for _, e in ipairs(lists().essential) do if e.group then slot = e end end
    expect(slot.name).toBe("Thunder Clap + Execute")
    expect(names(slot.members)).toEqual({ "Thunder Clap", "Execute" })
end

@test("onto a shared slot it joins it; onto a collection it goes last in it; a member dragged out is single again")
local function dropOntoBoxes()
    local f = editor()
    auras(f)
    mock.click(row(f, "Armor Reduction").fold)
    drag(f, row(f, "Rend"), row(f, "Armor Reduction"), "onto")
    local function coll(): any
        for _, e in ipairs(lists().debuffs) do if e.collection then return e end end
        return nil
    end
    expect(names(coll().entries[1].members)).toEqual({ "Sunder Armor", "Expose Armor", "Rend" })
    drag(f, row(f, "Hamstring"), row(f, "Physical Debuffs"), "onto")
    local entries = coll().entries
    expect(entries[#entries].name).toBe("Hamstring")
    drag(f, row(f, "Sunder Armor"), row(f, "Stuns"), "after")
    local last = lists().debuffs[#lists().debuffs]
    expect(last.name).toBe("Sunder Armor")
    expect(last.group).toBe(nil)
    -- onto an open slot's "+ Add to" row: last in the slot
    mock.click(row(f, "Stuns").fold)
    local addTo: any = nil
    for _, a in ipairs(f.addTos) do if a:IsShown() and a.select.placeholder == "+ Add to Stuns…" then addTo = a end end
    drag(f, row(f, "Hamstring"), addTo, "before")
    local stuns = lists().debuffs[#lists().debuffs - 1]
    expect(stuns.members[#stuns.members].name).toBe("Hamstring")
    -- a collection can't go into a collection: nothing lights
    mock.script(row(f, "Physical Debuffs"), "OnDragStart")
    cursorOn(row(f, "Physical Debuffs"), "onto")
    mock.advanceFrames(1)
    expect(f.target).toBe(nil)
    mock.script(row(f, "Physical Debuffs"), "OnDragStop")
end

--------------------------------------------------------------------------------
-- The Behaviour panel
--------------------------------------------------------------------------------

@test("Behaviour of a cooldown: when ready, pop, sound, on cooldown, show, unusable, edge, effect")
local function cooldownBehaviour()
    local f = editor()
    local b = behaviour(f, "Execute")
    expect(b.meta:GetText()).toBe("Cooldown · Essential")
    local played = mock.stub(UI, "TrackerSound", function(_: string) end)
    local function exec(): any
        for _, e in ipairs(lists().essential) do if e.name == "Execute" then return e end end
        return nil
    end
    click(b.ready, "glow")
    click(b.pop, "off")
    click(b.pop, "on")
    b.sound.onChange("chime")
    click(b.onCooldown, "dim")
    click(b.show, "ready")
    click(b.unusable, "hide")
    click(b.cdEdge, "gilt")
    click(b.effect, "you")
    local e = exec()
    expect(e.ready).toBe("glow")
    expect(e.pop).toBe(true)
    expect(e.sound).toBe("chime")
    expect(played).toHaveBeenCalledWith("chime")
    expect(e.onCooldown).toBe("dim")
    expect(e.show).toBe("ready")
    expect(e.unusable).toBe("hide")
    expect(e.border).toBe("gilt")
    expect(e.effect).toBe("you")
    -- the effect: an aura by name, a spell by ID, the spell itself
    b.effectAura.onChange("Battle Shout")
    expect(exec().effectName).toBe("Battle Shout")
    b.effectAura.onChange("id:133")
    expect(exec().effectIDs).toEqual({ 133 })
    expect(has(options(b.effectAura), "current")).toBe(true)   -- a name the presets don't know
    b.effectAura.onChange("current")
    b.effectAura.onChange("self")
    expect(exec().effectIDs).toBe(nil)
    click(b.pop, "default")
    b.sound.onChange("none")
    mock.click(b.reset)
    expect(exec().ready).toBe(nil)
    mock.click(b.done)
    expect(b).never.toBeShown()
end

@test("Behaviour of a cooldown shared slot: its name and shown; the note on its order")
local function cooldownSlot()
    local f = editor()
    drag(f, row(f, "Execute"), row(f, "Thunder Clap"), "onto")
    confirmed.onConfirm()
    local b = behaviour(f, "Thunder Clap + Execute")
    expect(b.meta:GetText()).toBe("Shared slot · 2 spells")
    expect(b.noteText:GetText()).toBe("Shows the last spell in the list you know: put upgrades last.")
    expect(b.slotShown).toBeShown()
    b.name.onChange("Clap or Execute")
    b.name.onChange("")
    b.slotShown.onChange(false)
    local slot: any = nil
    for _, e in ipairs(lists().essential) do if e.group then slot = e end end
    expect(slot.name).toBe("Clap or Execute")
    expect(slot.hidden).toBe(true)
    -- its members (it opened as it was made) have no Behaviour of their own
    expect(row(f, "Execute").behaviour).never.toBeShown()
end

@test("Behaviour of a single aura: whose, when missing, edge, size, glow, timer, stacks, amber, sounds")
local function auraBehaviour()
    local f = editor()
    auras(f)
    local b = behaviour(f, "Battle Shout")
    expect(b.meta:GetText()).toBe("Single aura")
    expect(b.missing).toBeShown()
    mock.stub(UI, "TrackerSound", function(_: string) end)
    click(b.source, "mine")
    click(b.missing, "hide")
    click(b.auEdge, "ink")
    click(b.size, "large")
    b.glow.onChange(true)
    b.digits.onChange(false)
    b.stacks.onChange(false)
    b.expiring.onChange(5)
    b.soundAppear.onChange("proc")
    b.soundStack.onChange("ping")
    b.soundDrop.onChange("none")
    local e = lists().buffs[1]
    expect(e.source).toBe("mine")
    expect(e.missing).toBe("hide")
    expect(e.border).toBe("ink")
    expect(e.size).toBe("large")
    expect(e.glow).toBe(true)
    expect(e.digits).toBe(false)
    expect(e.stacks).toBe(false)
    expect(e.expiring).toBe(5)
    expect(e.soundAppear).toBe("proc")
    expect(e.soundStack).toBe("ping")
    -- a debuff: "With a target" among the choices
    local d = behaviour(f, "Rend")
    expect(d.missingDebuff).toBeShown()
    click(d.missingDebuff, "target")
    expect(lists().debuffs[1].missing).toBe(nil)    -- the debuffs' default
end

@test("Behaviour of an aura shared slot: name, how many at once, the icon; a member's whose; a collection's name")
local function auraSlot()
    local f = editor()
    auras(f)
    local b = behaviour(f, "Stuns")
    expect(b.meta:GetText():find("Shared slot · ", 1, true) ~= nil).toBe(true)
    b.max.onChange(3)
    b.icon.onChange(b.icon.options[2].value)
    local stuns = lists().debuffs[#lists().debuffs]
    expect(stuns.max).toBe(3)
    expect(stuns.fixedIcon).toBe(true)
    b.icon.onChange("auto")
    expect(lists().debuffs[#lists().debuffs].fixedIcon).toBe(nil)
    b.icon.onChange(nil)
    click(b.source, "mine")
    expect(lists().debuffs[#lists().debuffs].source).toBe("mine")
    -- a member
    mock.click(row(f, "Stuns").fold)
    local member = row(f, "Stuns").entry.members[1].name
    local mb = behaviour(f, member)
    expect(mb.meta:GetText()).toBe("In Stuns")
    click(mb.memberSource, "others")
    expect(lists().debuffs[#lists().debuffs].members[1].source).toBe("others")
    -- a collection
    local cb = behaviour(f, "Physical Debuffs")
    expect(cb.meta:GetText():find("Collection · ", 1, true) ~= nil).toBe(true)
    expect(cb.condNote:GetText()).toBe("Applies to everything inside.")
    cb.name.onChange("Armour")
    expect(lists().debuffs[3].name).toBe("Armour")
    local inner = behaviour(f, "Armor Reduction")
    expect(inner.meta:GetText():find("Shared slot", 1, true) ~= nil).toBe(true)
end

@test("Behaviour of a weapon enchant: which weapon, when missing, the warning out of combat")
local function enchantBehaviour()
    local f = editor()
    auras(f)
    f.adds[1].select.onChange("enchant:main")
    local b = behaviour(f, "Main-hand enchant")
    expect(b.meta:GetText()).toBe("Weapon enchant")
    click(b.weapon, "off")
    expect(lists().buffs[#lists().buffs].enchant).toBe("off")
    click(b.weaponMissing, "grey")
    expect(row(f, "Off-hand enchant").rank:GetText():find("missing: grey", 1, true) ~= nil).toBe(true)
    click(b.weaponMissing, "warn")
    b.warnOoc.onChange(false)
    expect(lists().buffs[#lists().buffs].warnCombat).toBe(true)
end

@test("conditions: added by the first unused type, turned around, retyped, each type's controls, removed")
local function conditions()
    local f = editor()
    local b = behaviour(f, "Execute")
    local function when(): any
        for _, e in ipairs(lists().essential) do if e.name == "Execute" then return e.when end end
        return nil
    end
    expect(b.condSentence:GetText()).toBe("Always shows.")
    mock.click(b.addCondition)
    expect(when().conditions[1].type).toBe("group")
    local r = b.cond.rows[1]
    mock.click(r.notButton)
    expect(when().conditions[1]["not"]).toBe(true)
    click(r.group, "raid")
    expect(when().conditions[1].value).toBe("raid")
    for _, t in ipairs({ "classes", "role", "stance", "combat", "instance", "target", "talent" }) do
        r.type.onChange(t)
        expect(when().conditions[1].type).toBe(t)
        expect(when().conditions[1]["not"]).toBe(true)  -- Not carries over
    end
    r.type.onChange(nil)
    r.type.onChange("classes")
    for _, chip in ipairs(r.classesA.chips) do if chip.option.value == "DRUID" then mock.click(chip) end end
    expect(when().conditions[1].classes).toEqual({ "DRUID", "WARRIOR" })
    click(r.classesOthers, "others")
    expect(when().conditions[1].others).toBe(true)
    r.type.onChange("role")
    r.roles.onChange({ "HEALER" })
    r.type.onChange("stance")
    r.stances.onChange({ "berserker" })
    r.type.onChange("instance")
    r.instance.onChange({ "raid" })
    r.type.onChange("target")
    r.target.onChange({ "boss" })
    expect(when().conditions[1].kinds).toEqual({ "boss" })
    r.type.onChange("combat")
    expect(r.plain:GetText()).toBe("No options: while you're in combat.")
    -- talents: added from a class's list or by ID, removed
    r.type.onChange("talent")
    r.talentClassSelect.onChange("PRIEST")
    r.talentClassSelect.onChange(nil)
    r.addTalent.onChange("id:133")
    r.addTalent.onChange(133)
    r.addTalent.onChange("words")
    expect(when().conditions[1].talents).toEqual({ 133 })
    mock.click(r.talentRows[1].remove)
    expect(when().conditions[1].talents).toEqual({})
    -- two conditions, any of them
    mock.click(b.addCondition)
    click(b.match, "any")
    expect(when().match).toBe("any")
    expect(b.condSentence:GetText():find("Execute shows when ", 1, true) ~= nil).toBe(true)   -- (the talent one, empty, has no words)
    mock.click(b.cond.rows[2].remove)
    mock.click(b.cond.rows[1].remove)
    expect(when()).toBe(nil)
end

@test("the panel closes with the page, with another spec's lists, and when its entry is gone")
local function panelCloses()
    local f = editor()
    local b = behaviour(f, "Execute")
    f:Hide()
    expect(b).never.toBeShown()
    f:Show()
    b = behaviour(f, "Execute")
    events.emit("SUUUI_COOLDOWNS_SETUP")
    expect(b).never.toBeShown()
    b = behaviour(f, "Execute")
    mock.click(row(f, "Execute").remove)
    expect(b).never.toBeShown()
    f:OpenBehaviour({ key = "essential", i = 99 })   -- not there: nothing
end

--------------------------------------------------------------------------------
-- Seen recently
--------------------------------------------------------------------------------

@test("seen recently: your spells with a cooldown as you cast them, the auras on you and your target out of combat")
local function seenRecently()
    mock.stub(G, "IsPlayerSpell", function(id: number): boolean return id == 100 end)
    mock.stub(G, "GetSpellBaseCooldown", function(id: number): number return id == 100 and 15000 or 0 end)
    mock.fireUnitEvent("UNIT_SPELLCAST_SUCCEEDED", "player", "Cast-1", 100)
    mock.fireUnitEvent("UNIT_SPELLCAST_SUCCEEDED", "player", "Cast-2", 78)   -- not known
    local recent = M:Get("recent").WARRIOR
    expect(recent.cooldown[1].ids).toEqual({ 100 })
    mock.player:applyAura({ spellId = 6673, name = "Battle Shout" })
    mock.advanceTime(1.1)
    expect(M:Get("recent").WARRIOR.aura[1].name).toBe("Battle Shout")
    mock.fireEvent("PLAYER_TARGET_CHANGED")
    mock.advanceTime(0.6)
    -- in combat: not read
    mock.player:enterCombat()
    mock.player:applyAura({ spellId = 2457, name = "Battle Stance" })
    mock.advanceTime(1.1)
    expect(M:Get("recent").WARRIOR.aura[1].name).toBe("Battle Shout")
end

--------------------------------------------------------------------------------
-- Blizzard's Cooldown Manager, the settings rows
--------------------------------------------------------------------------------

@test("Blizzard's Cooldown Manager is switched off while this runs, and back on after")
local function blizzardViewer()
    settings.set("cooldowns", "enabled", false)
    C_CVar.SetCVar("cooldownViewerEnabled", "1")
    settings.set("cooldowns", "enabled", true)
    expect(C_CVar.GetCVar("cooldownViewerEnabled")).toBe("0")
    expect(M:Get("viewerOff")).toBe(true)
    settings.set("cooldowns", "enabled", false)
    expect(C_CVar.GetCVar("cooldownViewerEnabled")).toBe("1")
    expect(M:Get("viewerOff")).toBe(false)
    settings.set("cooldowns", "enabled", true)
end

@test("the resource rows need the bar; combo points and druid mana are for their classes")
local function settingRows()
    expect((rowOf("Width").disabled())).toBe(false)
    expect((rowOf("Own width").disabled())).toBe(true)
    local _, why = rowOf("Combo points").disabled()
    expect(why).toBe("Only rogues and druids use combo points.")
    local _, druid = rowOf("Druid mana in forms").disabled()
    expect(druid).toBe("Only druids change forms.")
    M:Set("resourceWidth", "own")
    expect((rowOf("Own width").disabled())).toBe(false)
    M:Set("resource", "power")
    local _, points = rowOf("Combo points").disabled()
    expect(points).toBe("Turn on Power + points first.")
    M:Set("resource", "off")
    local _, off = rowOf("Width").disabled()
    expect(off).toBe("Turn the resource bar on first.")
    expect((rowOf("Own width").disabled())).toBe(true)
    expect((rowOf("Druid mana in forms").disabled())).toBe(true)
end

@test("+ Add offers the presets' shared slots for the list, a copy of their own; auras on you now too")
local function presetSlots()
    mock.player:applyAura({ spellId = 2457, name = "Battle Stance" })
    local f = editor()
    auras(f)
    local opts = options(f.adds[2].select)
    expect(has(opts, "group:Healing Reduction")).toBe(true)     -- Arms's
    expect(has(opts, "Battle Stance") or has(options(f.adds[1].select), "Battle Stance")).toBe(true)
    f.adds[2].select.onChange("group:Healing Reduction")
    local slot = lists().debuffs[#lists().debuffs]
    expect(slot.group).toBe(true)
    expect(slot.uid ~= nil).toBe(true)
end

@test("talent conditions: any class's talents from the generated list; your own read live without it")
local function talentLists()
    local f = editor()
    local b = behaviour(f, "Execute")
    mock.click(b.addCondition)
    local r = b.cond.rows[1]
    r.type.onChange("talent")
    expect(#r.addTalent.options > 0).toBe(true)
    expect(r.addTalent.options[1].heading ~= nil).toBe(true)     -- by tree
    -- no generated list: your class's read from the talent trees, another's none
    mock.stub(SuuUI, "ClassTalents", function(class: string): any
        if class == "PRIEST" then return { { id = 17 } } end      -- a nameless entry: named by its spell
        return {}
    end)
    r.talentClassSelect.onChange("PRIEST")
    expect(r.addTalent.options[2].label).toBe(C_Spell.GetSpellName(17))
    r.talentClassSelect.onChange("MAGE")
    expect(#r.addTalent.options).toBe(0)
    -- your own class read from the active config's trees (once, every spell once)
    mock.stub(C_Traits, "GetConfigInfo", function(_: number): any return { treeIDs = { 1 } } end)
    mock.stub(C_Traits, "GetTreeNodes", function(_: number): any return { 21, 22 } end)
    mock.stub(C_Traits, "GetNodeInfo", function(_: number, _: number): any return { entryIDs = { 31 } } end)
    mock.stub(C_Traits, "GetEntryInfo", function(_: number, _: number): any return { definitionID = 41 } end)
    mock.stub(C_Traits, "GetDefinitionInfo", function(_: number): any return { spellID = 12294 } end)
    r.talentClassSelect.onChange("WARRIOR")
    expect(r.addTalent.options[2].value).toBe(12294)
    r.talentClassSelect.onChange("WARRIOR")      -- read once, kept
    mock.click(b.cond.rows[1].remove)
end
