import test, expect from "wowlua:test"
import SuuUI from "/Core/API"

@test("probe")
local function probe()
    local M = assert(SuuUI.GetModule("cooldowns"))
    local out: string[] = {}
    local function p(...: any) local t: string[] = {} for i = 1, select("#", ...) do t[#t + 1] = tostring((select(i, ...))) end out[#out + 1] = table.concat(t, " ") end
    p("class", UnitClass("player"))
    p("enabled", M:IsEnabled(), M.spec, M.points and table.concat(M.points, ","))
    for _, pr in ipairs(SuuUI.CooldownPresets()) do p("preset", pr.id, pr.name, pr.tree) end
    local s = M:Setup(M.spec)
    p("preset id", s.preset)
    for k, l in pairs(s.lists) do p(k, #l) end
    p("cvar", C_CVar.GetCVar("cooldownViewerEnabled"), M:Get("viewerOff"))
    p("cfg", C_ClassTalents.GetActiveConfigID())
    p("ct", #(SuuUI.ClassTalents("WARRIOR") or {}))
    p("spec()", SuuUI.Spec())
    p("defs", #SuuUI.Defensives())
    local ind = assert(SuuUI.GetModule("indicators"))
    p("ind", ind:IsEnabled(), #ind:List())
    local d = assert(SuuUI.GetModule("defensives"))
    p("def", d:IsEnabled(), #d:List())
    p("tracker", M.tracker and M.tracker:GetName(), M.tracker and M.tracker:IsShown())
    expect(out).toEqual({})
end
