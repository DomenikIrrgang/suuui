-- Units/GameMenu: SuuUI's game menu on Esc: the game's own menu kept out of
-- sight while this panel shows and hides with it, its entries opening the
-- game's windows, the secure Reload UI, Log Out and Exit Game (and Exit
-- Game's question), what's blocked in combat, the info line, a plugin's
-- entries, a theme change, stopped.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M from "/Units/GameMenu"
import type MenuItem from "/Units/GameMenu"
import type ConfirmOptions, ConfirmDialog from "/UI/Panel"
import expectNoErrors from "../../helpers"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"

local function open()
    if not GameMenuFrame:IsShown() then
        ShowUIPanel(GameMenuFrame)
    end
    mock.advanceFrames(2)
end

local function close()
    if GameMenuFrame:IsShown() then
        HideUIPanel(GameMenuFrame)
    end
    mock.advanceFrames(2)
end

-- The panel's entry by its label.
local function item(label: string): MenuItem
    for _, b in ipairs(M.items) do
        if b.label:GetText() == label then
            return b
        end
    end
    error("no entry " .. label)
end

-- The secure cover over an entry.
local function coverOf(label: string): Button?
    local b = item(label)
    for i, s in ipairs(M.secureItems or {}) do
        if s == b then
            local o = M.overs and M.overs[i]
            return o and o.button
        end
    end
    return nil
end

@afterEach
local function cleanup()
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    close()
    for _, name in ipairs({ "SettingsPanel", "EditModeManagerFrame", "MacroFrame", "AddonList" }) do
        local f = frames.asFrame(_G[name])
        if f and f:IsShown() then
            HideUIPanel(f)
        end
    end
    mock.advanceFrames(2)
    expectNoErrors()
end

@test("Esc: the game's menu out of sight, SuuUI's panel on a dimmed screen; gone again on Esc")
local function escape()
    -- (Esc clears a target first, as the game does)
    mock.player:target(nil)
    -- a first login: Esc skips SuuUI's welcome first, the menu stays shut
    local welcomeDim = frames.asFrame(tbl.field(SuuUI.GetModule("welcome"), "dim"))
    if welcomeDim and welcomeDim:IsShown() then
        mock.pressKey("ESCAPE")
        mock.advanceFrames(2)
        expect(welcomeDim:IsShown()).toBe(false)
        expect(GameMenuFrame:IsShown()).toBe(false)
    end
    mock.pressKey("ESCAPE")
    mock.advanceFrames(2)
    local g = GameMenuFrame
    expect(g:IsShown()).toBe(true)
    expect(M.dim).toBeShown()
    expect(g:GetAlpha()).toBe(0)
    local _, rel, relPoint = g:GetPoint(1)
    expect(rel).toBe(UIParent)
    expect(relPoint).toBe("TOPRIGHT")
    mock.pressKey("ESCAPE")
    mock.advanceFrames(2)
    expect(g:IsShown()).toBe(false)
    expect(M.dim).never.toBeShown()
end

@test("the game placing its menu again: put back out of sight")
local function keptAway()
    open()
    local g = GameMenuFrame
    g:ClearAllPoints()
    g:SetPoint("CENTER")
    g:SetAlpha(1)
    mock.advanceFrames(2)
    expect(g:GetAlpha()).toBe(0)
    local _, rel, relPoint = g:GetPoint(1)
    expect(rel).toBe(UIParent)
    expect(relPoint).toBe("TOPRIGHT")
end

@test("the info line: who and where; the frame rate and latency, every second while it shows")
local function infoLine()
    open()
    local name, realm = UnitFullName("player")
    expect(assert(M.who):GetText()).toBe(tostring(name) .. " · " .. tostring(realm))
    expect((assert(M.perf):GetText() or ""):find(" fps · ", 1, true) ~= nil).toBe(true)
    local drawn = mock.spy(function(_: unknown) end)
    mock.stub(M, "DrawPerf", drawn)
    mock.advanceTime(1.1)
    expect(drawn).toHaveBeenCalled()
end

@test("the game's windows: Options, Edit Mode, Macros, AddOns; SuuUI's settings; Support; each closes the menu")
local function entries()
    local function choose(label: string)
        open()
        item(label):Click()
        mock.advanceFrames(2)
        expect(GameMenuFrame:IsShown()).toBe(false)
    end
    choose("Options")
    expect(SettingsPanel:IsShown()).toBe(true)
    HideUIPanel(SettingsPanel)
    choose("Edit Mode")
    expect(EditModeManagerFrame:IsShown()).toBe(true)
    HideUIPanel(EditModeManagerFrame)
    mock.advanceFrames(2)
    -- (SuuUI's Macros module opens its own window for it)
    choose("Macros")
    local macros = frames.asFrame(_G.MacroFrame)
    if macros and macros:IsShown() then
        HideUIPanel(macros)
    end
    -- (SuuUI's Addons module opens its own window for it)
    choose("AddOns")
    if AddonList and AddonList:IsShown() then
        HideUIPanel(AddonList)
    end
    local settings = mock.spy(function() end)
    mock.stub(SuuUI, "OpenSettings", settings)
    choose("SuuUI settings")
    expect(settings).toHaveBeenCalled()
    local help = mock.spy(function() end)
    mock.stub(_G, "ToggleHelpFrame", help)
    choose("Support")
    expect(help).toHaveBeenCalled()
    -- Return to Game
    open()
    local back: Button? = nil
    for _, child in ipairs({ assert(M.panel).body:GetChildren() }) do
        local c = frames.asButton(child)
        if c and c:GetText() == "Return to Game" then
            back = c
        end
    end
    if back then
        back:Click()
        mock.advanceFrames(2)
        expect(GameMenuFrame:IsShown()).toBe(false)
    end
end

@test("Reload UI, Log Out: secure buttons over the entries while the menu shows")
local function secure()
    open()
    local reload, logout = assert(coverOf("Reload UI")), assert(coverOf("Log Out"))
    expect(reload:GetAttribute("type1")).toBe("macro")
    expect(reload:GetAttribute("macrotext1")).toBe("/reload")
    expect(logout:GetAttribute("macrotext1")).toBe("/logout")
    expect(reload:IsShown()).toBe(true)
    -- the cover's hover lights the entry under it
    mock.script(reload, "OnEnter")
    expect(item("Reload UI").hover:IsShown()).toBe(true)
    mock.script(reload, "OnLeave")
    -- a click: the menu closes a frame after
    mock.script(reload, "PostClick")
    mock.advanceFrames(2)
    expect(GameMenuFrame:IsShown()).toBe(false)
    expect(reload:IsShown()).toBe(false)
end

@test("in a fight: Reload UI, Log Out, Exit Game and Edit Mode blocked, their reason on hover; back after")
local function combat()
    open()
    mock.player:enterCombat()
    mock.advanceFrames(2)
    local b = item("Log Out")
    expect(b.blocked).toBe("Not in combat")
    expect(b:GetAlpha() < 1).toBe(true)
    expect(item("Edit Mode").blocked).toBe("Not in combat")
    -- (its secure cover can't be moved in a fight: off already as it began)
    expect(assert(coverOf("Log Out")):IsShown()).toBe(false)
    mock.hover(b)
    mock.hover(nil)
    -- a blocked entry does nothing
    b:Click()
    expect(GameMenuFrame:IsShown()).toBe(true)
    mock.player:leaveCombat()
    mock.advanceFrames(2)
    expect(item("Log Out").blocked).toBeNil()
    expect(assert(coverOf("Log Out")):IsShown()).toBe(true)
end

@test("Exit Game asks first: SuuUI's question, its button covered by a secure /quit")
local function exitGame()
    local asked: ConfirmOptions? = nil
    local real = SuuUI.UI.Confirm
    local dialog: ConfirmDialog? = nil
    mock.stub(SuuUI.UI, "Confirm", function(opts: ConfirmOptions): ConfirmDialog
        asked = opts
        local d = real(opts)
        dialog = d
        return d
    end)
    open()
    item("Exit Game"):Click()
    mock.advanceFrames(2)
    expect(assert(asked).title).toBe("Exit the game?")
    assert(assert(asked).onConfirm)()
    local over = assert(M.quitOver).button
    expect(over:GetAttribute("macrotext1")).toBe("/quit")
    expect(over:IsShown()).toBe(true)
    mock.script(over, "OnEnter")
    mock.script(over, "OnLeave")
    mock.script(over, "PreClick")
    -- the question gone: its cover too
    assert(dialog):Hide()
    expect(over:IsShown()).toBe(false)
    -- asked again: the same cover
    M:ConfirmQuit()
    expect(assert(M.quitOver).button).toBe(over)
    -- in a fight: not asked
    mock.player:enterCombat()
    mock.advanceFrames(1)
    asked = nil
    M:ConfirmQuit()
    expect(asked).toBeNil()
end

@test("on the way out already: Log Out and Exit Game say so")
local function onTheWayOut()
    mock.stub(_G, "StaticPopup_Visible", function(which: string): Frame?
        return which == "CAMP" and frames.asFrame(_G.StaticPopup1) or nil
    end)
    open()
    expect(item("Log Out").blocked).toBe("Already on the way out")
    expect(item("Exit Game").blocked).toBe("Already on the way out")
end

@test("a plugin's entries: in their group, or a group of their own before Session; built again on the next open")
local function plugins()
    local clicked = mock.spy(function() end)
    local plugin = M
    plugin:AddGameMenuItem({ group = "Help", label = "Plugin help", glyph = "chat", onClick = clicked })
    plugin:AddGameMenuItem({
        group = "Tools",
        label = "A tool",
        blocked = function(): string
            return "Not now"
        end,
    })
    expect(M.stale).toBe(true)
    open()
    expect(M.stale).toBeNil()
    item("Plugin help"):Click()
    expect(clicked).toHaveBeenCalled()
    open()
    expect(item("A tool").blocked).toBe("Not now")
    -- the groups in order: Session last
    local groups = M:Groups()
    expect(groups[#groups].name).toBe("Session")
    expect(groups[#groups - 1].name).toBe("Tools")
    -- in a fight: not rebuilt now
    close()
    mock.player:enterCombat()
    mock.advanceFrames(1)
    M.stale = true
    M:Rebuild()
    expect(M.stale).toBe(true)
end

@test("a theme with another caption height: built again on the next open")
local function theme()
    local was = M.builtLine
    M.builtLine = -1
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    expect(M.stale).toBe(true)
    open()
    expect(M.builtLine).toBe(was)
end

-- (last: the module off)
@test("stopped: the panel hidden, the game's menu left alone")
local function disabled()
    open()
    M:OnDisable()
    expect(M.dim).never.toBeShown()
    M:PutAway()
end
