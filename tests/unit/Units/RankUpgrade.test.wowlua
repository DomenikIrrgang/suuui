-- Units/RankUpgrade: a learned rank replaces your best rank before it on
-- every action slot (lower ranks stay), says so once, waits for the end of
-- combat and an empty cursor; off, nothing changes.

import test, expect, beforeEach from "wowlua:test"
import * as mock from "wowlua:mock"
import RankUpgrader from "/Units/RankUpgrade"
import type DeclinedRanks from "/Units/RankUpgrade"
import expectNoErrors from "../../helpers"

-- Test Bolt, ranks 1 to 4 (made up)
local R1, R2, R3, R4 = 990001, 990002, 990003, 990004
-- slots: the main bar, its second page, a form bar's, bar 5's
local MAIN, PAGE2, FORM, BAR5 = 1, 13, 75, 50

local said: string[] = {}
local on = true

local function upgrader(): RankUpgrader
    local u = RankUpgrader.new(function(text: string)
        said[#said + 1] = text
    end, function(): boolean
        return on
    end)
    u.best["Test Bolt"] = 3
    return u
end

local function slot(n: number): unknown
    local _, id = GetActionInfo(n)
    return id
end

@beforeEach
local function fresh()
    said = {}
    on = true
    for i, id in ipairs({ R1, R2, R3, R4 }) do
        mock.defineSpell(id, { name = "Test Bolt", subtext = "Rank " .. i })
    end
    mock.defineSpell(990100, { name = "Other Bolt", subtext = "Rank 3" })
    for _, n in ipairs({ MAIN, PAGE2, FORM, BAR5, 2, 3 }) do
        mock.setAction(n, nil)
    end
    mock.setAction(MAIN, { type = "spell", id = R3 })
    mock.setAction(PAGE2, { type = "spell", id = R3 })
    mock.setAction(FORM, { type = "spell", id = R3 })
    mock.setAction(BAR5, { type = "spell", id = R1 })
    mock.setAction(2, { type = "spell", id = 990100 })
    mock.setAction(3, { type = "spell", id = R2 })
end

@test("a learned rank replaces your best before it on every bar; lower ranks and other spells stay")
local function upgrades()
    local u = upgrader()
    u:Learned(R4)
    expect(slot(MAIN)).toBe(R4)
    expect(slot(PAGE2)).toBe(R4)
    expect(slot(FORM)).toBe(R4)
    expect(slot(BAR5)).toBe(R1)
    expect(slot(3)).toBe(R2)
    expect(slot(2)).toBe(990100)
    expect(GetCursorInfo()).toBeNil()
    expect(#said).toBe(1)
    expect(said[1]:find("Rank 4 replaced Rank 3 on 3 buttons.", 1, true) ~= nil).toBe(true)
    expect(u.best["Test Bolt"]).toBe(4)
    expectNoErrors()
end

@test("a rank skipped: your best before is still the one replaced")
local function skipped()
    local u = upgrader()
    u.best["Test Bolt"] = 2
    u:Learned(R4)
    expect(slot(3)).toBe(R4)
    expect(slot(MAIN)).toBe(R3)
    expect(said[1]:find("on 1 button.", 1, true) ~= nil).toBe(true)
end

@test("two ranks learned one after the other: each replaces the one before")
local function twoRanks()
    local u = upgrader()
    u.best["Test Bolt"] = 2
    u:Learned(R3)
    u:Learned(R4)
    expect(slot(3)).toBe(R4)
    expect(slot(MAIN)).toBe(R4)
    expect(slot(BAR5)).toBe(R1)
    expect(#said).toBe(2)
end

@test("off: nothing changes, but the best rank is still kept")
local function off()
    on = false
    local u = upgrader()
    u:Learned(R4)
    expect(slot(MAIN)).toBe(R3)
    expect(#said).toBe(0)
    expect(u.best["Test Bolt"]).toBe(4)
end

@test("a new spell or a lower rank learned: nothing to replace")
local function nothingBefore()
    local u = upgrader()
    u.best["Test Bolt"] = nil
    u:Learned(R4)
    expect(slot(MAIN)).toBe(R3)
    u.best["Test Bolt"] = 3
    u:Learned(R2)
    expect(slot(3)).toBe(R2)
    expect(#said).toBe(0)
end

@test("in combat it waits for the end of combat")
local function combat()
    local u = upgrader()
    mock.player:enterCombat()
    u:Learned(R4)
    expect(slot(MAIN)).toBe(R3)
    mock.player:leaveCombat()
    u:Apply()
    expect(slot(MAIN)).toBe(R4)
    expect(#said).toBe(1)
end

@test("with something on the cursor it waits until the cursor is empty")
local function cursorBusy()
    local u = upgrader()
    C_Spell.PickupSpell(990100)
    u:Learned(R4)
    expect(slot(MAIN)).toBe(R3)
    mock.advanceTime(1.1)
    expect(slot(MAIN)).toBe(R3)
    ClearCursor()
    mock.advanceTime(1.1)
    expect(slot(MAIN)).toBe(R4)
    expect(GetCursorInfo()).toBeNil()
end

--------------------------------------------------------------------------------
-- Dual spec
--------------------------------------------------------------------------------

@test("after a switch the bars as they are: the highest rank they hold of a spell offered, lower ones beside it stay")
local function staleAfterSwitch()
    local u = upgrader()
    -- Rank 4 learned (in the other spec); these bars: R3 on three slots, R1 and R2
    u.best["Test Bolt"], u.bestID["Test Bolt"] = 4, R4
    local list = u:Stale()
    local slots: number[] = {}
    for _, s in ipairs(list) do
        slots[#slots + 1] = s.slot
        expect(s.from).toBe(3)
        expect(s.to).toBe(4)
        expect(s.id).toBe(R4)
    end
    table.sort(slots)
    expect(slots).toEqual({ MAIN, PAGE2, FORM })
    -- placed: one line; the lower ranks and the other spell left
    expect(u:Place(list)).toBe(true)
    expect(slot(MAIN)).toBe(R4)
    expect(slot(PAGE2)).toBe(R4)
    expect(slot(FORM)).toBe(R4)
    expect(slot(BAR5)).toBe(R1)
    expect(slot(3)).toBe(R2)
    expect(slot(2)).toBe(990100)
    expect(#said).toBe(1)
    expect(said[1]:find("Rank 4 replaced Rank 3 on 3 buttons.", 1, true) ~= nil).toBe(true)
    expectNoErrors()
end

@test(
    "after a switch: a rank put there by hand is offered too (nothing remembered); only the highest of a spell's ranks"
)
local function staleByHand()
    local u = upgrader()
    u.best["Test Bolt"], u.bestID["Test Bolt"] = 4, R4
    -- (the user's case: the best rank taken off, Rank 2 and Rank 1 left)
    for _, n in ipairs({ MAIN, PAGE2, FORM }) do
        mock.setAction(n, nil)
    end
    local list = u:Stale()
    expect(#list).toBe(1)
    expect(list[1].slot).toBe(3)
    expect(list[1].from).toBe(2)
    expect(list[1].to).toBe(4)
end

@test("after a switch: a spell at your best rank somewhere on the bars, nothing of it offered")
local function staleAtBest()
    local u = upgrader()
    u.best["Test Bolt"], u.bestID["Test Bolt"] = 4, R4
    mock.setAction(BAR5, { type = "spell", id = R4 })
    expect(#u:Stale()).toBe(0)
    -- at Rank 3, the best: none either
    mock.setAction(BAR5, { type = "spell", id = R1 })
    u.best["Test Bolt"], u.bestID["Test Bolt"] = 3, R3
    expect(#u:Stale()).toBe(0)
end

@test("Not now to a rank: not offered again; a higher rank learned, offered")
local function staleDeclined()
    local u = upgrader()
    u.best["Test Bolt"], u.bestID["Test Bolt"] = 4, R4
    local declined: DeclinedRanks = { ["Test Bolt"] = 4 }
    expect(#u:Stale(declined)).toBe(0)
    u.best["Test Bolt"], u.bestID["Test Bolt"] = 5, 990005
    expect(#u:Stale(declined)).toBe(3)
end

@test("placing waits out combat and a busy cursor: false, nothing changed")
local function placeWaits()
    local u = upgrader()
    u.best["Test Bolt"], u.bestID["Test Bolt"] = 4, R4
    local list = u:Stale()
    mock.player:enterCombat()
    expect(u:Place(list)).toBe(false)
    mock.player:leaveCombat()
    C_Spell.PickupSpell(990100)
    expect(u:Place(list)).toBe(false)
    ClearCursor()
    expect(slot(MAIN)).toBe(R3)
    expect(u:Place(list)).toBe(true)
    expect(slot(MAIN)).toBe(R4)
end
