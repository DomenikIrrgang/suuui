import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"

local function dump(v: any, d: number?): string
    d = d or 0
    if type(v) ~= "table" or d > 2 then return tostring(v) end
    local out: string[] = {}
    for k, x in pairs(v) do out[#out + 1] = tostring(k) .. "=" .. dump(x, (d or 0) + 1) end
    table.sort(out)
    return "{" .. table.concat(out, ", ") .. "}"
end

@test("probe")
local function probe()
    local lines: string[] = {}
    local function out(s: string) lines[#lines + 1] = s end
    mock.defineItem(1001, { name = "Linen Cloth", quality = 1, stackCount = 20, sellPrice = 13, classID = 7, subclassID = 5, icon = 132889 })
    mock.defineItem(1003, { name = "Cached Thing", quality = 2, stackCount = 1, sellPrice = 13, classID = 7, subclassID = 5, icon = 132889 }, { cached = true })
    out("C " .. dump({ C_Item.GetItemInfo(1001) }))
    out("C3 " .. dump({ C_Item.GetItemInfo(1003) }))
    mock.setBag(0, { slots = 16, items = { [1] = { id = 1001, count = 5 } } })
    local info = C_Container.GetContainerItemInfo(0, 1)
    out("Clink " .. dump({ C_Item.GetItemInfo(info and info.hyperlink or "") }))
    C_Item.RequestLoadItemDataByID(1001)
    mock.advanceTime(1)
    out("after " .. dump({ C_Item.GetItemInfo(1001) }))
    mock.openMerchant({ name = "Vendor", items = { { id = 1001, price = 100, stack = 5 }, { id = 1003, price = 2000000 } }, canRepair = true, repairCost = 500 })
    mock.advanceTime(1)
    out("merchant n " .. tostring(GetMerchantNumItems()) .. " info " .. dump(C_MerchantFrame.GetItemInfo(1)) .. " link " .. tostring(GetMerchantItemLink(1)) .. " max " .. tostring(GetMerchantItemMaxStack(1)) .. " npc " .. tostring(UnitName("npc")))
    local merchant: any = assert(SuuUI.GetModule("merchant"))
    out("mwin " .. tostring(merchant.window:IsShown()) .. " rows " .. tostring(#merchant.rows) .. " title " .. tostring(merchant.window.title and merchant.window.title:GetText()))
    out("buyback " .. tostring(GetNumBuybackItems()) .. " repair " .. dump({ GetRepairAllCost() }) .. " can " .. tostring(CanMerchantRepair()) .. " guild " .. tostring(CanGuildBankRepair and CanGuildBankRepair()))
    local bags: any = assert(SuuUI.GetModule("bags"))
    out("atMerchant " .. tostring(bags.atMerchant) .. " bagsShown " .. tostring(bags.inv:IsShown()))
    mock.closeMerchant()
    mock.advanceTime(1)
    out("closed " .. tostring(merchant.window:IsShown()))
    local box = mock.spawnUnit({ name = "Mailbox", reaction = "friendly" })
    mock.defineMailbox(box, { letters = { { sender = "Bo", subject = "Hi", money = 500, daysLeft = 20, text = "hello", items = { { id = 1001, count = 2 } } },
        { sender = "Cy", subject = "COD", cod = 100, daysLeft = 2 } } })
    mock.player:interact(box)
    mock.advanceTime(2)
    local mail: any = assert(SuuUI.GetModule("mail"))
    out("mail open " .. tostring(mail.open) .. " shown " .. tostring(mail.window and mail.window:IsShown()) .. " n " .. dump({ GetInboxNumItems() }) .. " h " .. dump({ GetInboxHeaderInfo(1) }) .. " item " .. dump({ GetInboxItem(1, 1) }) .. " text " .. dump({ GetInboxText(1) }))
    out("chardata " .. dump(mail:CharData()))
    out("mtc " .. dump({ pcall(GetLootSlotInfo, 1) }) .. " " .. dump({ pcall(GetNumLootItems) }))
    out("guild " .. tostring(IsInGuild()) .. " fullname " .. tostring(SuuUI.FullName("player")) .. " realm " .. tostring(GetRealmName()))
    expect(lines).toEqual({})
end
