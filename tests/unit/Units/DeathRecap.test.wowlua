-- Units/DeathRecap: the hits that killed you from C_DeathRecap: what the
-- recap says (recapOf), and the window drawing it.

import test, expect, cases, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, group3, spellOf, extras from "/Units/DeathRecap"
import recapOf, Recap, DeathEvent from "/Units/DeathRecap"
import expectNoErrors from "../../helpers"

-- three hits, newest first as the game gives them: a fall, a wolf's swing
-- (partly absorbed), a mage's critical Fireball that killed
local function threeHits(): DeathEvent[]
    return {
        { timestamp = 103, amount = 500, currentHP = 300, spellId = 133, spellName = "Fireball", sourceName = "Mage",
          school = 4, critical = true, overkill = 200, event = "SPELL_DAMAGE" },
        { timestamp = 101.5, amount = 400, currentHP = 700, event = "SWING_DAMAGE", sourceName = "Wolf", absorbed = 50 },
        { timestamp = 100, amount = 300, currentHP = 1000, event = "ENVIRONMENTAL_DAMAGE", environmentalType = "Falling" },
    }
end

local recapEvents: unknown = nil
local recapMax: unknown = nil

@beforeEach
local function world()
    recapEvents, recapMax = threeHits(), 1000
    mock.stub(C_DeathRecap, "GetRecapEvents", function(_: number?): unknown return recapEvents end)
    mock.stub(C_DeathRecap, "GetRecapMaxHealth", function(_: number?): unknown return recapMax end)
end

@afterEach
local function clean()
    local parts = M.parts
    if parts then parts.window:Hide() end
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The pieces
--------------------------------------------------------------------------------

@test("group3 groups thousands and rounds")
@cases({ { 0, "0" }, { 100, "100" }, { 1956, "1,956" }, { 999.6, "1,000" }, { 1234567, "1,234,567" } })
local function grouping(n: number, out: string)
    expect(group3(n)).toBe(out)
end

@test("spellOf: a melee swing")
local function swing()
    local name, icon = spellOf({ event = "SWING_DAMAGE" })
    expect(name).toBe("Melee")
    local id = Constants.DeathRecapConsts.SWING_DAMAGE_SPELL_ID
    expect(icon).toBe(C_Spell.GetSpellTexture(id) or "Interface\\Icons\\INV_Sword_04")
end

@test("spellOf: environmental damage, known and unknown")
local function environmental()
    local name, icon = spellOf({ event = "ENVIRONMENTAL_DAMAGE", environmentalType = "Falling" })
    expect(name).toBe(ACTION_ENVIRONMENTAL_DAMAGE_FALLING)
    expect(icon).toBe("Interface\\Icons\\ability_rogue_quickrecovery")
    name, icon = spellOf({ event = "ENVIRONMENTAL_DAMAGE", environmentalType = "weird" })
    expect(name).toBe("Weird")
    expect(icon).toBe("Interface\\Icons\\ability_creature_cursed_05")
    -- no type: like any other hit
    name = spellOf({ event = "ENVIRONMENTAL_DAMAGE" })
    expect(name).toBe("Unknown")
end

@test("spellOf: a spell's name and icon; secret or missing ones")
local function spell()
    mock.defineSpell(990001, { name = "Shadow Bolt", iconID = 136197 })
    local name, icon = spellOf({ event = "SPELL_DAMAGE", spellId = 990001, spellName = "Shadow Bolt" })
    expect(name).toBe("Shadow Bolt")
    expect(icon).toBe(C_Spell.GetSpellTexture(990001))
    name, icon = spellOf({ spellName = mock.secret("Hidden"), spellId = mock.secret(5) })
    expect(name).toBe("Unknown")
    expect(icon).toBeNil()
    name = spellOf({ spellName = "" })
    expect(name).toBe("Unknown")
end

@test("extras: absorbed, resisted, blocked when readable and above zero")
local function extraBits()
    expect(extras({ absorbed = 1200, resisted = 0, blocked = 30 })).toEqual({ "1,200 absorbed", "30 blocked" })
    expect(extras({ absorbed = mock.secret(5), resisted = "x" })).toEqual({})
end

--------------------------------------------------------------------------------
-- recapOf
--------------------------------------------------------------------------------

@test("recapOf: the head, the health line and the rows of three hits")
local function threeHitRecap()
    local r: Recap = recapOf(threeHits(), 1000)
    expect(r.count).toBe(3)
    expect(r.span).toBe(3)
    expect(r.head).toEqual({ spell = "Fireball", by = "· Mage", detail = "500 Fire · critical · 200 overkill",
        health = "1,000 health to 0", span = "in 3.0 s, 3 hits" })
    expect(r.steps).toEqual({
        { from = 3, to = 2.94, hp = 1000 },
        { from = 3, to = 1.5, hp = 700 },
        { from = 1.5, to = 0, hp = 300 },
        { from = 0, to = 0, hp = 0 },
    })
    expect(r.marks).toEqual({ { t = 0, text = "0 s" }, { t = 2, text = "−2 s" } })
    local rows = r.rows
    expect(#rows).toBe(3)
    expect(rows[1].time).toBe("−3.0 s")
    expect(rows[1].spell).toBe(ACTION_ENVIRONMENTAL_DAMAGE_FALLING)
    expect(rows[1].by).toBe("")
    expect(rows[1].amount).toBe("−300")
    expect(rows[1].hp).toBe(700)
    expect(rows[1].spellID).toBeNil()
    expect(rows[1].killing).toBe(false)
    expect(rows[2].time).toBe("−1.5 s")
    expect(rows[2].spell).toBe("Melee")
    expect(rows[2].by).toBe("Wolf · 50 absorbed")
    expect(rows[2].hp).toBe(300)
    expect(rows[3].time).toBe("0 s")
    expect(rows[3].spellID).toBe(133)
    expect(rows[3].by).toBe("Mage")
    expect(rows[3].amount).toBe("−500")
    expect(rows[3].flag).toBe("critical · 200 overkill")
    expect(rows[3].hp).toBe(0)
    expect(rows[3].killing).toBe(true)
end

@test("recapOf: hits in the same moment share one health reading")
local function sameMoment()
    local r = recapOf({
        { timestamp = 10, amount = 100, currentHP = 1000 },
        { timestamp = 10, amount = 100, currentHP = 1000 },
    }, 1000)
    expect(r.rows[1].hp).toBe(900)
    expect(r.rows[2].hp).toBe(800)
    -- no span: no health line
    expect(r.span).toBe(0)
    expect(r.steps).toBeNil()
    expect(r.head.span).toBe("in 0.0 s, 2 hits")
end

@test("recapOf: without times, maximum or readable values")
local function unreadable()
    local r = recapOf({
        { amount = mock.secret(5), currentHP = mock.secret(9), sourceName = "Hidden", hideCaster = true, overkill = 0,
          spellId = 0 },
    }, nil)
    expect(r.span).toBeNil()
    expect(r.steps).toBeNil()
    expect(r.marks).toBeNil()
    expect(r.head).toEqual({ spell = "Unknown", by = "", detail = "", health = "", span = "1 hit" })
    expect(r.rows[1].time).toBe("")
    expect(r.rows[1].by).toBe("")
    expect(r.rows[1].amount).toBe("")
    expect(r.rows[1].flag).toBe("")
    expect(r.rows[1].hp).toBeNil()
    expect(r.rows[1].spellID).toBeNil()
end

@test("recapOf: an unknown school and a readable health after an unreadable one")
local function schoolAndHealth()
    local r = recapOf({
        { timestamp = 5, amount = 50, school = 3 },
        { timestamp = 4, amount = 50, currentHP = mock.secret(1) },
        { timestamp = 2, amount = 50, currentHP = 500 },
    }, 600)
    expect(r.head.detail).toBe("50")
    expect(r.head.health).toBe("500 health to 0")
    expect(r.rows[1].hp).toBe(450)
    expect(r.rows[2].hp).toBe(400)
    expect(r.rows[3].hp).toBe(350)
    -- the start without a reading of its own: the maximum
    r = recapOf({ { timestamp = 5, amount = 50 }, { timestamp = 1, amount = 50 } }, 600)
    expect(r.head.health).toBe("600 health to 0")
    expect(r.steps and r.steps[1]).toEqual({ from = 4, to = 3.92, hp = 600 })
    expect(r.steps and #r.steps).toBe(1) -- no readable health after the hits
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

@test("is on at login; the window is built on first use")
local function onAtLogin()
    expect(M:IsEnabled()).toBe(true)
    expect(M.hooked).toBe(true)
    expect(M.parts).toBeNil()
    M:Emit("SUUUI_THEME_CHANGED", "suuui") -- nothing built yet: nothing to do
    M:ShowRecap(nil)
    expect(M:Window().window:GetName()).toBe("SuuUIDeathRecap")
end

@test("ShowRecap draws the head, the line and a row per hit")
local function draws()
    M:ShowRecap(7)
    expect(M:Window().window).toBeShown()
    expect(M:Window().empty).never.toBeShown()
    expect(M:Window().head).toBeShown()
    expect(M:Window().head.spell).toHaveText("Fireball")
    expect(M:Window().head.by).toHaveText("· Mage")
    expect(M:Window().head.detail).toHaveText("500 Fire · critical · 200 overkill")
    expect(M:Window().head.health).toHaveText("1,000 health to 0")
    expect(M:Window().head.span).toHaveText("in 3.0 s, 3 hits")
    expect(M:Window().line).toBeShown()
    -- four steps, the last (at zero) hidden; two time marks
    expect(M:Window().line.steps[3]).toBeShown()
    expect(M:Window().line.steps[4]).never.toBeShown()
    expect(M:Window().line.marks[2]).toHaveText("−2 s")
    local r1, r3 = M:Window().rows[1], M:Window().rows[3]
    expect(r1).toBeShown()
    expect(r1.time).toHaveText("−3.0 s")
    expect(r1.hp).toHaveText("700")
    expect(r1.hpFill).toBeShown()
    expect(r1.rule).toBeShown()
    expect(r3.name).toHaveText("Fireball")
    expect(r3.amount).toHaveText("−500")
    expect(r3.flag).toHaveText("critical · 200 overkill")
    expect(r3.hpFill).never.toBeShown()
    expect(r3.rule).never.toBeShown()
    expect(r3.spellID).toBe(133)
end

@test("fewer hits the next time: the rows and steps beyond are hidden")
local function fewer()
    M:ShowRecap(1)
    recapEvents = { { timestamp = 10, amount = 100, currentHP = 100, spellName = "Bite", event = "SPELL_DAMAGE" } }
    M:ShowRecap(2)
    expect(M:Window().rows[1]).toBeShown()
    expect(M:Window().rows[2]).never.toBeShown()
    expect(M:Window().line.steps[2]).never.toBeShown()
    expect(M:Window().head.span).toHaveText("in 0.0 s, 1 hit")
end

@test("an unknown maximum: no health line, no health bars")
local function noMax()
    recapMax = 0
    M:ShowRecap(1)
    expect(M:Window().line.steps[1]).never.toBeShown()
    expect(M:Window().rows[1].hpFill).never.toBeShown()
    expect(M:Window().rows[1].hp).toHaveText("700")
    recapMax = mock.secret(1000)
    M:ShowRecap(1)
    expect(M:Window().rows[1].hpFill).never.toBeShown()
end

@test("no recap: an empty window says so")
local function empty()
    recapEvents = {}
    M:ShowRecap(1)
    expect(M:Window().window).toBeShown()
    expect(M:Window().head).never.toBeShown()
    expect(M:Window().line).never.toBeShown()
    expect(M:Window().empty).toHaveText("No recap for this death. The game recorded no hits for it.")
    recapEvents = nil
    M:ShowRecap(1)
    expect(M:Window().empty).toBeShown()
    mock.stub(C_DeathRecap, "GetRecapEvents", function(_: number?): unknown error("no recap") end)
    M:ShowRecap(1)
    expect(M:Window().empty).toBeShown()
end

@test("a secret recap: shown as secret until combat ends")
local function secretRecap()
    mock.fake("issecrettable", function(_: unknown): boolean return true end)
    M:ShowRecap(1)
    expect(M:Window().empty).toHaveText("The recap is secret until combat ends.")
end

@test("a row's tooltip: the spell's own, else ours")
local function rowTooltips()
    M:ShowRecap(1)
    local spellTip, ourTip = mock.spy(), mock.spy()
    mock.stub(SuuUI.UI, "SpellTooltip", spellTip)
    mock.stub(SuuUI.UI, "ShowTooltip", ourTip)
    mock.script(M:Window().rows[3], "OnEnter")
    expect(spellTip).toHaveBeenCalledWith(M:Window().rows[3], 133)
    mock.script(M:Window().rows[2], "OnEnter")
    expect(ourTip).toHaveBeenCalledWith(M:Window().rows[2], { title = "Melee", subtitle = "Wolf · 50 absorbed" })
    mock.script(M:Window().rows[1], "OnEnter")
    expect(ourTip).toHaveBeenCalledWith(M:Window().rows[1], { title = ACTION_ENVIRONMENTAL_DAMAGE_FALLING })
    mock.script(M:Window().rows[1], "OnLeave")
    expect(GameTooltip).never.toBeShown()
end

@test("Toggle: the same recap again closes it, another one shows")
local function toggles()
    M:Toggle(nil)
    expect(M:Window().window).toBeShown()
    expect(M.shownID).toBe(false)
    M:Toggle(nil)
    expect(M:Window().window).never.toBeShown()
    M:Toggle(4)
    expect(M.shownID).toBe(4)
    M:Toggle(5)
    expect(M:Window().window).toBeShown()
    expect(M.shownID).toBe(5)
end

@test("/suu recap toggles the last death's recap")
local function command()
    mock.slash("/suu recap")
    expect(M:Window().window).toBeShown()
    expect(M.shownID).toBe(false)
end

@test("the game's recap opens this one instead")
local function gameRecap()
    OpenDeathRecapUI(3)
    expect(M:Window().window).toBeShown()
    expect(M.shownID).toBe(3)
    local f = DeathRecapFrame
    if f then expect(f).never.toBeShown() end
    -- turned off (until the reload): left to the game
    M:Window().window:Hide()
    mock.stub(M, "IsEnabled", function(): boolean return false end)
    OpenDeathRecapUI(3)
    expect(M:Window().window).never.toBeShown()
    if f then f:Hide() end
end

@test("a theme change sizes the head again and lays out a shown recap")
local function themeChange()
    M:ShowRecap(1)
    recapEvents = { { timestamp = 10, amount = 100, currentHP = 100, spellName = "Bite" } }
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    expect(M:Window().head.spell).toHaveText("Bite")
    M:Window().window:Hide()
    recapEvents = threeHits()
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    expect(M:Window().head.spell).toHaveText("Bite") -- hidden: not drawn again
end

@test("Fit: as tall as the content, at most the screen less 80")
local function fit()
    M:ShowRecap(1)
    M:Fit(100000)
    expect(M:Window().window:GetHeight()).toBeCloseTo(UIParent:GetHeight() - 80)
    M:Fit(100)
    expect(M:Window().window.content:GetHeight()).toBeCloseTo(100)
    expect(M:Window().window:GetHeight() < UIParent:GetHeight() - 80).toBe(true)
end
