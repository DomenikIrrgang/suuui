-- Units/MouseBindings: spells on keys, clicks and the wheel cast on the
-- unit under the mouse, the module end to end (the inputs, what a binding
-- comes to, the ranks, the attributes and snippets, the boxes and the list
-- have their own tests in MouseBindings/). The secure part: a key over a
-- unit in the world and over a unit frame, a click on a frame, friends and
-- enemies apart, combat waiting; each tree's own bindings; the unit frames'
-- Target and Menu clicks moved, swapped, per tree, also for a spell; a Cmd
-- click on a unit frame; turned off and on.
--
-- The spellbook is the engine's (the default character: a level 1 Human
-- warrior).

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import SuuUI from "/Core/API"
import internal M, judge, ranksOf from "/Units/MouseBindings"
import type Bind from "/Units/MouseBindings"
import expectNoErrors, holdings, cycle, NOTHING from "../../helpers"
import * as modules from "/Core/Modules"
import * as settings from "/Core/Settings"

-- A spell the character knows: its name and highest rank's ID.
local function known(): (string, number)
    for _, name in ipairs({ "Heroic Strike", "Battle Shout", "Attack" }) do
        local ranks = ranksOf(name)
        local top = ranks[#ranks]
        if top then
            return name, top.id
        end
    end
    error("no known spell")
end

local function bind(input: string, spell: string, id: number, more: { reach?: string, react?: string }?): Bind
    local o = more or {}
    return {
        input = input,
        spell = spell,
        rank = "highest",
        spellID = id,
        reach = (o.reach or "both") :: "both",
        react = (o.react or "any") :: "any",
    }
end

-- Whether a key casts a binding now (its override one of this module's).
local function ours(key: string): boolean
    local action = GetBindingAction(key, true) or ""
    return action:find("SuuUIMouseBindings", 1, true) ~= nil
end

-- The casts the secure buttons make: { spell, unit }.
local casts: { id: unknown, unit: unknown }[] = {}
local hooked = false
local function watchCasts()
    casts = {}
    if hooked then
        return
    end
    hooked = true
    hooksecurefunc("CastSpellByID", function(id, unit)
        casts[#casts + 1] = { id = id, unit = unit }
    end)
end

@afterEach
local function cleanup()
    mock.setModifiers({})
    mock.player:mouseover(nil)
    mock.hover(nil)
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    M:Store().specs = {}
    M:Store().clicks = {}
    M:Store().clickSynced = nil
    local box = M.box
    if box then
        box:Close()
    end
    local clickBox = M.clickBox
    if clickBox and clickBox.panel:IsShown() then
        clickBox.cancelled, clickBox.after = nil, nil
        clickBox:Close()
    end
    M:Apply()
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The secure part
--------------------------------------------------------------------------------

@test("a key over a unit in the world casts on it; away from units it does what it did")
local function world()
    local name, id = known()
    watchCasts()
    M:Add(bind("SHIFT-F", name, id), nil)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    -- away from units: no override
    expect(ours("SHIFT-F")).toBe(false)
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-F", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb1")
    mock.pressKey("SHIFT-F")
    expect(casts[#casts] and casts[#casts].id).toBe(id)
    expect(casts[#casts] and casts[#casts].unit).toBe("mouseover")
    mock.player:mouseover(nil)
    mock.advanceFrames(15, 20)
    expect(ours("SHIFT-F")).toBe(false)
end

@test("a key over a SuuUI unit frame casts on the frame's unit; a frames-only key does nothing in the world")
local function overFrame()
    local name, id = known()
    watchCasts()
    M:Add(bind("SHIFT-G", name, id, { reach = "frames" }), nil)
    local player = assert(frames.find("SuuUIPlayerFrame"))
    mock.hover(player)
    mock.advanceFrames(1)
    expect(GetBindingAction("SHIFT-G", true)).toBe("CLICK SuuUIMouseBindingsFrame:mb1")
    mock.pressKey("SHIFT-G")
    expect(casts[#casts] and casts[#casts].unit).toBe("player")
    mock.hover(nil)
    mock.advanceFrames(1)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(ours("SHIFT-G")).toBe(false)
end

-- (CD-27) A frame that hides under the mouse: whether Forever sends OnLeave
-- then is unprobed, so both ways. Its keys go, the world's come back, in
-- combat too, and nothing is refused.
local FRAME_KEY = "CLICK SuuUIMouseBindingsFrame:mb1"
local function frameBound(): boolean
    return GetBindingAction("SHIFT-G", true) == FRAME_KEY
end

local function overTarget(mob: mock.MockUnit): Frame
    mock.player:target(mob)
    mock.advanceFrames(1)
    local tf = assert(frames.find("SuuUITargetFrame"))
    expect(tf:IsVisible()).toBe(true)
    mock.hover(nil)
    mock.hover(tf)
    mock.advanceFrames(1)
    expect(frameBound()).toBe(true)
    return tf
end

@test("a unit frame hidden under the mouse, with or without a leave, in or out of combat: its keys go, the world's come back")
local function hiddenUnderMouse()
    local name, id = known()
    M:Add(bind("SHIFT-G", name, id), nil)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    local other = mock.spawnUnit({ name = "Gnoll", reaction = "hostile", distance = 5 })
    -- hidden, no leave: the target cleared under the mouse
    local tf = overTarget(mob)
    mock.player:target(nil)
    mock.advanceFrames(1)
    expect(tf:IsVisible()).toBe(false)
    expect(frameBound()).toBe(false)
    -- the world's mouseover casting is back
    mock.player:mouseover(other)
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-G", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb1")
    mock.player:mouseover(nil)
    mock.advanceFrames(15, 20)
    expect(ours("SHIFT-G")).toBe(false)
    -- hidden, then the leave as well: done once, the second harmless
    tf = overTarget(mob)
    mock.player:target(nil)
    mock.advanceFrames(1)
    mock.hover(nil)
    mock.advanceFrames(1)
    expect(frameBound()).toBe(false)
    mock.player:mouseover(other)
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-G", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb1")
    mock.player:mouseover(nil)
    mock.advanceFrames(15, 20)
    -- in combat: the same, by the secure paths alone
    tf = overTarget(mob)
    mock.player:enterCombat()
    mock.player:target(nil)
    mock.advanceFrames(1)
    expect(tf:IsVisible()).toBe(false)
    expect(frameBound()).toBe(false)
    mock.player:mouseover(other)
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-G", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb1")
    mock.player:mouseover(nil)
    mock.advanceFrames(15, 20)
    expect(#mock.refusals()).toBe(0)
    mock.player:leaveCombat()
    -- a working enter and leave are as before
    local player = assert(frames.find("SuuUIPlayerFrame"))
    mock.hover(player)
    mock.advanceFrames(1)
    expect(frameBound()).toBe(true)
    -- the module turned off with the mouse on the frame: nothing of it bound
    settings.set("mousebindings", "enabled", false)
    expect(ours("SHIFT-G")).toBe(false)
    settings.set("mousebindings", "enabled", true)
    mock.advanceFrames(1)
    -- on again, still over it: its keys again; the leave takes them off
    expect(frameBound()).toBe(true)
    mock.hover(nil)
    mock.advanceFrames(1)
    expect(frameBound()).toBe(false)
    expectNoErrors()
end

@test("the frame state counts only while its frame shows and its unit exists (the snippet itself)")
local function staleFrameState()
    local name, id = known()
    M:Add(bind("SHIFT-G", name, id), nil)
    local owner = assert(M.owner)
    local player = assert(frames.find("SuuUIPlayerFrame"))
    mock.hover(player)
    mock.advanceFrames(1)
    expect(frameBound()).toBe(true)
    -- the frame's unit gone while it stays (a header's button reused): the
    -- frame button's unit no longer exists, so the next refresh binds nothing
    -- of the frame's
    assert(M.frameButton):SetAttribute("unit", "boss4")
    SecureHandlerExecute(owner, [=[ self:RunAttribute("_refresh") ]=])
    expect(frameBound()).toBe(false)
    mock.hover(nil)
    mock.advanceFrames(1)
    -- a frame state with no hovered frame (never seen entering): nothing
    owner:SetAttribute("state-frame", "harm")
    expect(frameBound()).toBe(false)
    owner:SetAttribute("state-frame", "off")
    expectNoErrors()
end

@test("a modified click on a unit frame casts on its unit; the plain click still targets")
local function frameClick()
    local name, id = known()
    watchCasts()
    M:Add(bind("SHIFT-BUTTON1", name, id), nil)
    local player = assert(frames.find("SuuUIPlayerFrame"))
    expect(player:GetAttribute("shift-type1")).toBe("spell")
    mock.setModifiers({ shift = true })
    mock.click(player, "LeftButton")
    expect(casts[#casts] and casts[#casts].unit).toBe("player")
    mock.setModifiers({})
    local before = #casts
    mock.click(player, "LeftButton")
    expect(#casts).toBe(before)
    expect(UnitIsUnit("target", "player")).toBe(true)
end

@test("one key, a friend's spell and an enemy's: each unit gets its own")
local function friendFoe()
    local name, id = known()
    watchCasts()
    M:Add(bind("CTRL-F", name, id, { react = "harm" }), nil)
    M:Add(bind("CTRL-F", "Friendly Spell", 4242, { react = "help" }), nil)
    -- (the friend's spell: one the client knows by ID)
    expect(#M:Binds()).toBe(2)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    mock.pressKey("CTRL-F")
    expect(casts[#casts] and casts[#casts].id).toBe(id)
    local friend = mock.spawnUnit({ name = "Ally", reaction = "friendly", distance = 5 })
    mock.player:mouseover(friend)
    mock.advanceFrames(15, 20)
    mock.pressKey("CTRL-F")
    expect(casts[#casts] and casts[#casts].id).toBe(4242)
end

@test("a key with a friend's spell only keeps its job over an enemy, in the world and on frames")
local function friendOnly()
    local name, id = known()
    watchCasts()
    SetBinding("2", "ACTIONBUTTON2")
    M:Add(bind("2", name, id, { react = "help" }), nil)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(ours("2")).toBe(false)
    expect(GetBindingAction("2", true)).never.toBe("")
    local friend = mock.spawnUnit({ name = "Ally", reaction = "friendly", distance = 5 })
    mock.player:mouseover(friend)
    mock.advanceFrames(15, 20)
    expect(ours("2")).toBe(true)
    mock.pressKey("2")
    expect(casts[#casts] and casts[#casts].id).toBe(id)
    mock.player:mouseover(nil)
    mock.advanceFrames(15, 20)
    -- your own frame: a friend
    mock.hover(assert(frames.find("SuuUIPlayerFrame")))
    mock.advanceFrames(1)
    expect(ours("2")).toBe(true)
    mock.hover(nil)
    mock.advanceFrames(1)
    expect(ours("2")).toBe(false)
    SetBinding("2")
end

@test("in combat a new binding waits for its end; the old ones still cast")
local function combat()
    local name, id = known()
    watchCasts()
    M:Add(bind("SHIFT-F", name, id), nil)
    mock.player:enterCombat()
    M:Add(bind("SHIFT-H", name, id), nil)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-F", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb1")
    expect(ours("SHIFT-H")).toBe(false)
    mock.player:leaveCombat()
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-H", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb2")
end

@test("each talent tree keeps its own; bindings made before any tree go to the first one")
local function specs()
    local name, id = known()
    local tree = 0
    mock.stub(SuuUI, "Spec", function(): number
        return tree
    end)
    M:Store().last = nil
    M:Add(bind("SHIFT-F", name, id), nil)
    expect(M:SpecKey()).toBe("0")
    -- the first tree takes them over
    tree = 2
    expect(M:SpecKey()).toBe("2")
    expect(#M:Binds()).toBe(1)
    -- another tree: its own, copied over on demand
    tree = 3
    expect(#M:Binds()).toBe(0)
    M:CopyFrom("2")
    expect(#M:Binds()).toBe(1)
    -- the talents read empty (after login): the last tree's
    tree = 0
    expect(M:SpecKey()).toBe("3")
end

--------------------------------------------------------------------------------
-- The unit frames' Target and Menu clicks
--------------------------------------------------------------------------------

@test("each tree keeps its own Target and Menu clicks; copied with its bindings")
local function clicksPerSpec()
    local tree = 2
    mock.stub(SuuUI, "Spec", function(): number
        return tree
    end)
    M:SetClick("target", "SHIFT-BUTTON1")
    tree = 3
    expect(M:Clicks()).toEqual({ target = "BUTTON1", menu = "BUTTON2" })
    M:CopyFrom("2")
    expect(M:Clicks().target).toBe("SHIFT-BUTTON1")
    tree = 2
    expect(M:Clicks().target).toBe("SHIFT-BUTTON1")
end

@test(
    "binding a spell to Target's click moves Target first: in the capture box and in bind mode; cancelled, nothing changes"
)
local function moveForSpell()
    local name, id = known()
    -- the capture box: Bind asks for Target's new click, then binds
    M:Edit({ name = name, spellID = id })
    local box = assert(M.box)
    box:Got("BUTTON1")
    expect(box.ok.label:GetText()).toBe("Move Target…")
    box:Confirm()
    local clickBox = assert(M.clickBox)
    expect(clickBox.panel:IsShown()).toBe(true)
    expect(clickBox.waiting).toBe(true)
    -- its own click again is no move
    clickBox:Got("BUTTON1")
    expect(clickBox.ok:IsEnabled()).toBe(false)
    clickBox:Got("SHIFT-BUTTON1")
    clickBox:Confirm()
    expect(M:Clicks().target).toBe("SHIFT-BUTTON1")
    expect(#M:Binds()).toBe(1)
    expect(M:Binds()[1].input).toBe("BUTTON1")
    expect(box.panel:IsShown()).toBe(false)
    -- bind mode: Menu's click; the box cancelled, not bound
    local said: string? = nil
    mock.stub(SuuUI.UI, "Confirm", function(opts: { onConfirm?: () -> () }): nil
        local confirm = opts.onConfirm
        if confirm then
            confirm()
        end
        return nil
    end)
    M:Press({ name = name, spellID = id }, "BUTTON2", function(title: string)
        said = title
    end)
    expect(clickBox.panel:IsShown()).toBe(true)
    expect(clickBox.kind).toBe("menu")
    clickBox:Close()
    expect(said).toBe("Not bound")
    expect(#M:Binds()).toBe(1)
    -- and saved: bound
    M:Press({ name = name, spellID = id }, "BUTTON2", function(title: string)
        said = title
    end)
    clickBox:Got("CTRL-BUTTON2")
    clickBox:Confirm()
    expect(said).toBe("Right click → " .. name)
    expect(M:Clicks().menu).toBe("CTRL-BUTTON2")
    expect(#M:Binds()).toBe(2)
end

-- The game's click bindings as Forever's (probed 2026-11-10): Target on Left
-- and the menu on Right without modifiers, the modifiers' bits by name (each
-- two, the left and the right key); what SuuUI writes to them.
type ClickBinding = { type: number, actionID: number, button: string, modifiers: number }
local function clickBindings(extra: ClickBinding[]?): ClickBinding[]
    local profile: ClickBinding[] = {
        { type = 3, actionID = 1, button = "LeftButton", modifiers = 0 },
        { type = 3, actionID = 2, button = "RightButton", modifiers = 0 },
    }
    for _, e in ipairs(extra or {}) do
        profile[#profile + 1] = e
    end
    local names: { [number]: string } = {
        [1] = "SHIFT",
        [2] = "SHIFT",
        [4] = "CTRL",
        [8] = "CTRL",
        [16] = "ALT",
        [32] = "ALT",
        [64] = "META",
        [128] = "META",
    }
    mock.fake("GetStringFromModifiers", function(m: number): string
        return names[m] or ""
    end)
    mock.fake("C_ClickBindings.GetProfileInfo", function(): ClickBinding[]
        return profile
    end)
    mock.fake("C_ClickBindings.SetProfileByInfo", function(info: ClickBinding[])
        for i = #profile, 1, -1 do
            table.remove(profile, i)
        end
        for i, e in ipairs(info) do
            profile[i] = e
        end
    end)
    return profile
end

-- An interaction's click in the game's click bindings: its button, modifiers.
local function interaction(profile: ClickBinding[], id: number): (string?, number?)
    for _, e in ipairs(profile) do
        if e.type == 3 and e.actionID == id then
            return e.button, e.modifiers
        end
    end
    return nil, nil
end

@test(
    "Target moved to Shift-Left: the game's click bindings' Target there, its other bindings kept, the frames' own attributes; back on Left, the game's again"
)
local function targetMoved()
    local name, id = known()
    local profile = clickBindings({ { type = 1, actionID = 139, button = "MiddleButton", modifiers = 0 } })
    local player = assert(frames.find("SuuUIPlayerFrame"))
    -- (Shift as the game read it while the click was picked: both its bits)
    M:SetClick("target", "SHIFT-BUTTON1", 3)
    expect(M:Clicks()).toEqual({ target = "SHIFT-BUTTON1", menu = "BUTTON2" })
    local button, mods = interaction(profile, 1)
    expect(button).toBe("LeftButton")
    expect(mods).toBe(3)
    button, mods = interaction(profile, 2)
    expect(button).toBe("RightButton")
    expect(mods).toBe(0)
    expect(#profile).toBe(3)
    expect(player:GetAttribute("*type1")).toBe("target")
    expect(player:GetAttribute("shift-type1")).toBe(nil)
    -- plain Left is free: bound without a question
    expect(judge(M:Binds(), bind("BUTTON1", name, id), nil, M:Clicks()).ask).toBe(nil)
    -- back on Left: the game's own again, no longer SuuUI's to keep
    M:SetClick("target", "BUTTON1", 0)
    button, mods = interaction(profile, 1)
    expect(button).toBe("LeftButton")
    expect(mods).toBe(0)
    expect(M:Store().clickSynced).toBe(nil)
    expect(#profile).toBe(3)
end

@test("never moved: the game's click bindings stay as its own window left them")
local function clicksUntouched()
    local profile = clickBindings()
    profile[1].modifiers = 48
    M:Apply()
    local _, mods = interaction(profile, 1)
    expect(mods).toBe(48)
end

@test("Target on Right swaps Menu onto Left, in the game's click bindings")
local function swapped()
    local profile = clickBindings()
    M:SetClick("target", "BUTTON2", 0)
    expect(M:Clicks()).toEqual({ target = "BUTTON2", menu = "BUTTON1" })
    expect(interaction(profile, 1)).toBe("RightButton")
    expect(interaction(profile, 2)).toBe("LeftButton")
    M:SetClick("target", "BUTTON1", 0)
    expect(interaction(profile, 1)).toBe("LeftButton")
    expect(interaction(profile, 2)).toBe("RightButton")
end

@test("a spell on Menu's new click keeps working in the world; a click's modifiers from the game's names when not read")
local function takenKeepsWorld()
    local name, id = known()
    local profile = clickBindings()
    M:Add(bind("ALT-BUTTON1", name, id), nil)
    M:SetClick("menu", "ALT-BUTTON1")
    local b = M:Binds()[1]
    expect(b and b.reach).toBe("world")
    local button, mods = interaction(profile, 2)
    expect(button).toBe("LeftButton")
    expect(mods).toBe(48)
    -- Cmd-Shift-Right for Target: Cmd's and Shift's bits
    M:SetClick("target", "META-SHIFT-BUTTON2")
    button, mods = interaction(profile, 1)
    expect(button).toBe("RightButton")
    expect(mods).toBe(195)
end

@test("a Cmd click on a unit frame: its spell's attributes on the renamed click, marked for the frame's wrap")
local function cmdClick()
    local name, id = known()
    local player = assert(frames.find("SuuUIPlayerFrame"))
    M:Add(bind("META-BUTTON1", name, id), nil)
    expect(player:GetAttribute("type-cmd-LeftButton")).toBe("spell")
    expect(player:GetAttribute("suuui-cmd-LeftButton")).toBe("1")
    M:Store().specs = {}
    M:Apply()
    expect(player:GetAttribute("suuui-cmd-LeftButton")).toBe(nil)
end

@test(
    "a friend's spell on a modified click casts on a friendly frame; the click doesn't fall back to the frame's target"
)
local function friendClick()
    local name, id = known()
    watchCasts()
    -- (Purify on Ctrl-Left did nothing in game: the click read as the frame's
    -- target, which the game's click bindings didn't have for it)
    M:Add(bind("CTRL-BUTTON1", name, id, { react = "help" }), nil)
    local player = assert(frames.find("SuuUIPlayerFrame"))
    expect(player:GetAttribute("ctrl-type1")).toBe("")
    expect(player:GetAttribute("ctrl-helpbutton1")).toBe("mb1h")
    mock.setModifiers({ ctrl = true })
    mock.click(player, "LeftButton")
    mock.setModifiers({})
    expect(casts[#casts] and casts[#casts].id).toBe(id)
    expect(casts[#casts] and casts[#casts].unit).toBe("player")
end

@test("turned off through the registry: keys, frame clicks and the moved Target click are given back; on again, all set again")
local function offAndOn()
    local name, id = known()
    local profile = clickBindings()
    local player = assert(frames.find("SuuUIPlayerFrame"))
    M:Add(bind("SHIFT-F", name, id), nil)
    M:Add(bind("SHIFT-BUTTON1", name, id), nil)
    M:SetClick("target", "ALT-BUTTON1", 48)
    expect(player:GetAttribute("shift-type1")).toBe("spell")
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(ours("SHIFT-F")).toBe(true)
    local _, mods = interaction(profile, 1)
    expect(mods).toBe(48)
    settings.set("mousebindings", "enabled", false)
    expect(M:IsEnabled()).toBe(false)
    mock.advanceFrames(15, 20)
    expect(ours("SHIFT-F")).toBe(false)
    expect(player:GetAttribute("shift-type1")).toBe(nil)
    local button
    button, mods = interaction(profile, 1)
    expect(button).toBe("LeftButton")
    expect(mods).toBe(0)
    settings.set("mousebindings", "enabled", true)
    mock.advanceFrames(15, 20)
    expect(player:GetAttribute("shift-type1")).toBe("spell")
    expect(ours("SHIFT-F")).toBe(true)
    _, mods = interaction(profile, 1)
    expect(mods).toBe(48)
end

-- (TEST-3) Off through the registry nothing of the module's stays on a unit
-- frame or the game: no key override, no click attribute, no mouseover state
-- driver, its boxes closed; on again, all of it back, nothing doubled.
@test("turned off: no override, no frame attribute, no state driver, the boxes closed, nothing held; on again, all back")
local function offLeavesNothing()
    local name, id = known()
    clickBindings()
    M:Add(bind("SHIFT-F", name, id), nil)
    M:Add(bind("SHIFT-BUTTON1", name, id), nil)
    local owner = assert(M.owner)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    local friend = mock.spawnUnit({ name = "Member1", player = true, reaction = "friendly", distance = 5 })
    -- on: the mouseover drives the owner's state
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(owner:GetAttribute("state-mo")).toBe("harm")
    expect(ours("SHIFT-F")).toBe(true)
    -- both boxes open as the module turns off
    M:Edit({ name = name, spellID = id })
    local box = assert(M.box)
    expect(box.panel).toBeShown()
    M:EditClick("target")
    local clickBox = assert(M.clickBox)
    clickBox.cancelled, clickBox.after = nil, nil
    expect(clickBox.panel).toBeShown()
    settings.set("mousebindings", "enabled", false)
    mock.advanceFrames(15, 20)
    expect(box.panel).never.toBeShown()
    expect(clickBox.panel).never.toBeShown()
    expect(holdings(M)).toEqual(NOTHING)
    expect(ours("SHIFT-F")).toBe(false)
    for _, f in ipairs(SuuUI.UI.SecureUnitFrames()) do
        expect(f:GetAttribute("shift-type1")).toBe(nil)
        expect(f:GetAttribute("shift-spell1")).toBe(nil)
    end
    expect(next(M.frameAttrs)).toBe(nil)
    expect(#M.buttonAttrs).toBe(0)
    expect(assert(M.worldButton):GetAttribute("type-v1")).toBe(nil)
    -- no state driver: the mouseover no longer reaches the owner
    mock.player:mouseover(friend)
    mock.advanceFrames(15, 20)
    expect(owner:GetAttribute("state-mo")).toBe("harm")
    expect(ours("SHIFT-F")).toBe(false)
    -- on again: all back
    settings.set("mousebindings", "enabled", true)
    mock.advanceFrames(15, 20)
    expect(M.state).toBe(modules.ModuleState.Enabled)
    expect(owner:GetAttribute("state-mo")).toBe("help")
    expect(ours("SHIFT-F")).toBe(true)
    expect(assert(frames.find("SuuUIPlayerFrame")):GetAttribute("shift-type1")).toBe("spell")
    -- and once more: nothing held while off, nothing doubled after
    local c = cycle("mousebindings")
    expect(c.stateOff).toBe(modules.ModuleState.Disabled)
    expect(c.off).toEqual(NOTHING)
    expect(c.after).toEqual(c.before)
    expect(c.stateOn).toBe(modules.ModuleState.Enabled)
    mob:despawn()
    friend:despawn()
    expectNoErrors()
end
