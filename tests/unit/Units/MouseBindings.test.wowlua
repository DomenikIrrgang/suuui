-- Units/MouseBindings: spells on keys, clicks and the wheel cast on the
-- unit under the mouse. The inputs as a person reads them; what a binding
-- comes to (movement keys refused, another spell's input and the frames'
-- Target's and Menu's clicks offered to move); the unit frames' Target and
-- Menu clicks moved, swapped, per tree; a Cmd click on a unit frame; the
-- secure part end to end: a key over a unit in the world and over a unit
-- frame, a click on a frame, friends and enemies apart, combat waiting.
--
-- The spellbook is the engine's (the default character: a level 1 Human
-- warrior).

import test, expect, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import SuuUI from "/Core/API"
import internal M, inputText, chipText, clickPrefix, clickSuffix, cmdMark, reachFor, isPlainClick, judge, judgeClick, castAttributes, refreshSnippet, ranksOf, bindLine from "/Units/MouseBindings"
import type Bind from "/Units/MouseBindings"
import expectNoErrors from "../../helpers"

-- A spell the character knows: its name and highest rank's ID.
local function known(): (string, number)
    for _, name in ipairs({ "Heroic Strike", "Battle Shout", "Attack" }) do
        local ranks = ranksOf(name)
        local top = ranks[#ranks]
        if top then
            return name, top.id
        end
    end
    error("no known spell")
end

local function bind(input: string, spell: string, id: number, more: { reach?: string, react?: string }?): Bind
    local o = more or {}
    return {
        input = input,
        spell = spell,
        rank = "highest",
        spellID = id,
        reach = (o.reach or "both") :: "both",
        react = (o.react or "any") :: "any",
    }
end

-- Whether a key casts a binding now (its override one of this module's).
local function ours(key: string): boolean
    local action = GetBindingAction(key, true) or ""
    return action:find("SuuUIMouseBindings", 1, true) ~= nil
end

-- The casts the secure buttons make: { spell, unit }.
local casts: { id: unknown, unit: unknown }[] = {}
local hooked = false
local function watchCasts()
    casts = {}
    if hooked then
        return
    end
    hooked = true
    hooksecurefunc("CastSpellByID", function(id, unit)
        casts[#casts + 1] = { id = id, unit = unit }
    end)
end

@afterEach
local function cleanup()
    mock.setModifiers({})
    mock.player:mouseover(nil)
    mock.hover(nil)
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    M:Store().specs = {}
    M:Store().clicks = {}
    local box = M.box
    if box then
        box:Close()
    end
    local clickBox = M.clickBox
    if clickBox and clickBox.panel:IsShown() then
        clickBox.cancelled, clickBox.after = nil, nil
        clickBox:Close()
    end
    M:Apply()
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- Inputs
--------------------------------------------------------------------------------

@test("an input as a person reads it, and as a chip")
@cases({
    { "SHIFT-F", "Shift-F", "Shift-F" },
    { "ALT-CTRL-BUTTON1", "Alt-Ctrl-Left click", "Alt-Ctrl-Left" },
    { "BUTTON2", "Right click", "Right" },
    { "SHIFT-MOUSEWHEELUP", "Shift-Wheel up", "Shift-Wheel up" },
    { "META-Q", "Cmd-Q", "Cmd-Q" },
    { "BUTTON4", "Button 4", "Button 4" },
})
local function inputs(input: string, text: string, chip: string)
    expect(inputText(input)).toBe(text)
    expect(chipText(bind(input, "Heroic Strike", 1))).toBe(chip)
end

@test("the book's ranks read once until the book changes; each answer the caller's own")
local function ranksOnce()
    mock.fireEvent("SPELLS_CHANGED")
    local reads = mock.stub(C_SpellBook, "GetNumSpellBookSkillLines", C_SpellBook.GetNumSpellBookSkillLines)
    local name = known()
    local a = ranksOf(name)
    local b = ranksOf(name)
    expect(reads).toHaveBeenCalledTimes(1)
    expect(a).toEqual(b)
    expect(a ~= b).toBe(true)
    expect(#ranksOf("No Such Spell")).toBe(0)
    mock.fireEvent("SPELLS_CHANGED")
    ranksOf(name)
    expect(reads).toHaveBeenCalledTimes(2)
end

@test("a click's attributes on unit frames: Alt, Ctrl, Shift in the secure buttons' order; Cmd a renamed button")
local function prefixes()
    expect(clickPrefix("ALT-SHIFT-BUTTON1")).toBe("alt-shift-")
    expect(clickPrefix("CTRL-BUTTON2")).toBe("ctrl-")
    expect(clickPrefix("BUTTON1")).toBe("")
    expect(clickSuffix("SHIFT-BUTTON3")).toBe("3")
    -- Cmd: not a prefix the secure buttons know; the frame's wrap renames it
    expect(clickPrefix("META-SHIFT-BUTTON1")).toBe("shift-")
    expect(clickSuffix("META-SHIFT-BUTTON1")).toBe("-cmd-LeftButton")
    expect(clickSuffix("META-BUTTON2")).toBe("-cmd-RightButton")
    expect(cmdMark("ALT-META-BUTTON4")).toBe("suuui-cmd-alt-Button4")
    expect(cmdMark("SHIFT-BUTTON1")).toBe(nil)
    expect(isPlainClick("BUTTON1")).toBe(true)
    expect(isPlainClick("SHIFT-BUTTON1")).toBe(false)
    expect(isPlainClick("BUTTON3")).toBe(false)
end

@test("where an input works: plain Left and Right on frames only; a Cmd click anywhere")
@cases({
    { "SHIFT-F", "both", "both" },
    { "BUTTON1", "both", "frames" },
    { "BUTTON1", "world", nil },
    { "META-BUTTON1", "both", "both" },
    { "META-BUTTON1", "frames", "frames" },
    { "SHIFT-BUTTON1", "world", "world" },
    { "MOUSEWHEELUP", "frames", "frames" },
})
local function reaches(input: string, wanted: string, out: string?)
    expect(reachFor(input, wanted :: "both") :: string?).toBe(out)
end

--------------------------------------------------------------------------------
-- What a binding comes to
--------------------------------------------------------------------------------

@test("a movement key is refused")
local function movement()
    SetBinding("SHIFT-W", "MOVEFORWARD")
    local v = judge({}, bind("SHIFT-W", "Heroic Strike", 1), nil)
    expect(v.refuse).toBe("Shift-W is Move Forward")
    expect(v.refuseDetail).toBe("It can't cast on mouseover. Pick another key.")
    SetBinding("SHIFT-W")
end

@test("another spell's input is asked first, and replaced; the same spell's is not asked")
local function takenFirst()
    local old = bind("SHIFT-F", "Battle Shout", 2)
    local v = judge({ old }, bind("SHIFT-F", "Heroic Strike", 1), nil)
    expect(v.ask and v.ask.title).toBe("Shift-F already casts Battle Shout")
    expect(v.ask and v.ask.confirm).toBe("Replace")
    expect(#v.takes).toBe(1)
    -- friends and enemies apart: no overlap, nothing taken
    local friendly = bind("SHIFT-F", "Battle Shout", 2, { react = "help" })
    local w = judge({ friendly }, bind("SHIFT-F", "Heroic Strike", 1, { react = "harm" }), nil)
    expect(w.ask).toBe(nil)
    expect(#w.takes).toBe(0)
    -- the same spell again
    local same = judge({ bind("SHIFT-F", "Heroic Strike", 1) }, bind("SHIFT-F", "Heroic Strike", 1), nil)
    expect(same.ask).toBe(nil)
end

@test("Target's and Menu's clicks offer to move them first; a click they've left is free; plain clicks on frames only")
local function plainClicks()
    local v = judge({}, bind("BUTTON1", "Heroic Strike", 1), nil)
    expect(v.reach).toBe("frames")
    expect(v.ask and v.ask.title).toBe("Left click targets on unit frames")
    expect(v.ask and v.ask.text).toBe("Move Target to another click? Then Left click casts Heroic Strike there.")
    expect(v.ask and v.ask.confirm).toBe("Move Target…")
    expect(v.ask and v.ask.move).toBe("target")
    expect(v.info[1]).toBe("Left click works on unit frames only.")
    local r = judge({}, bind("BUTTON2", "Heroic Strike", 1, { reach = "world" }), nil)
    expect(r.refuse).toBe("Right click can't work there")
    -- Target moved to Shift-Left: Left is free, Shift-Left offered to move
    local moved = { target = "SHIFT-BUTTON1", menu = "BUTTON2" }
    local free = judge({}, bind("BUTTON1", "Heroic Strike", 1), nil, moved)
    expect(free.ask).toBe(nil)
    local shift = judge({}, bind("SHIFT-BUTTON1", "Heroic Strike", 1), nil, moved)
    expect(shift.ask and shift.ask.move).toBe("target")
    -- in the world only: the frames' click isn't in its way
    local world = judge({}, bind("SHIFT-BUTTON1", "Heroic Strike", 1, { reach = "world" }), nil, moved)
    expect(world.ask).toBe(nil)
    local menu = judge({}, bind("BUTTON2", "Heroic Strike", 1), nil, moved)
    expect(menu.ask and menu.ask.title).toBe("Right click opens the unit's menu on unit frames")
    expect(menu.ask and menu.ask.move).toBe("menu")
end

@test(
    "a click for Target or Menu: a mouse button with Shift, Ctrl, Alt or Cmd; the other's click swapped; a spell's taken"
)
local function clickVerdicts()
    local clicks = { target = "BUTTON1", menu = "BUTTON2" }
    local key = judgeClick({}, clicks, "target", "SHIFT-F")
    expect(key.refuse).toBe("Shift-F isn't a mouse click")
    expect(key.refuseDetail).toBe("Target takes a mouse button, with Shift, Ctrl, Alt or Cmd.")
    expect(judgeClick({}, clicks, "target", "MOUSEWHEELUP").refuse).toBe("Wheel up isn't a mouse click")
    local cmd = judgeClick({}, clicks, "menu", "META-BUTTON2")
    expect(cmd.refuse).toBe(nil)
    -- the other's click: swapped
    local swap = judgeClick({}, clicks, "target", "BUTTON2")
    expect(swap.swap).toBe(true)
    expect(swap.ask and swap.ask.title).toBe("Right click opens the unit's menu on unit frames")
    expect(swap.ask and swap.ask.text).toBe("Swap them? Menu moves to Left click.")
    -- a spell's: taken, kept in the world where it can be
    local both = bind("SHIFT-BUTTON1", "Battle Shout", 2)
    local taken = judgeClick({ both }, clicks, "target", "SHIFT-BUTTON1")
    expect(taken.ask and taken.ask.title).toBe("Shift-Left click casts Battle Shout on unit frames")
    expect(taken.ask and taken.ask.text).toBe("Target takes it; Battle Shout keeps working in the world.")
    expect(taken.takes).toEqual({ both })
    expect(taken.info).toEqual({ "Left click on unit frames does nothing until you bind a spell to it." })
    local framesOnly = bind("BUTTON3", "Battle Shout", 2, { reach = "frames" })
    local gone = judgeClick({ framesOnly }, clicks, "menu", "BUTTON3")
    expect(gone.ask and gone.ask.text).toBe("Menu takes it; Battle Shout's binding goes.")
    -- a world-only spell on that click: nothing taken
    local world = judgeClick(
        { bind("CTRL-BUTTON1", "Battle Shout", 2, { reach = "world" }) },
        clicks,
        "target",
        "CTRL-BUTTON1"
    )
    expect(world.ask).toBe(nil)
    expect(#world.takes).toBe(0)
end

@test("a key with a job keeps it away from units, and says so")
local function keepsJob()
    SetBinding("SHIFT-E", "ACTIONBUTTON3")
    local v = judge({}, bind("SHIFT-E", "Heroic Strike", 1), nil)
    expect(v.info[#v.info]).toBe(
        "Away from units Shift-E stays " .. (_G.BINDING_NAME_ACTIONBUTTON3 or "ACTIONBUTTON3") .. "."
    )
    SetBinding("SHIFT-E")
end

@test("a binding's line: its rank, where and on whom")
local function lines()
    local name, id = known()
    local b = bind("SHIFT-F", name, id, { reach = "frames", react = "harm" })
    expect(bindLine(b):find("unit frames only · enemies", 1, true) ~= nil).toBe(true)
end

--------------------------------------------------------------------------------
-- The secure part
--------------------------------------------------------------------------------

@test("the attributes of a binding: for anyone, or a friend's and an enemy's spell apart")
local function attributes()
    local a = castAttributes("*", "-mb1", 1, 78, nil, nil)
    expect(a).toEqual({ { "*type-mb1", "spell" }, { "*spell-mb1", 78 } })
    local b = castAttributes("shift-", "1", 2, nil, 10, 20)
    expect(b).toEqual({
        { "shift-helpbutton1", "mb2h" },
        { "*type-mb2h", "spell" },
        { "*spell-mb2h", 10 },
        { "shift-harmbutton1", "mb2x" },
        { "*type-mb2x", "spell" },
        { "*spell-mb2x", 20 },
    })
    local s = refreshSnippet({ { input = "SHIFT-F", button = "mb1", when = "any" } }, {
        { input = "ALT-Q", button = "mb2", when = "help" },
    })
    expect(
        s:find('self:SetBindingClick(true, "SHIFT-F", self:GetFrameRef("frameButton"), "mb1")', 1, true) ~= nil
    ).toBe(true)
    -- a friend's spell alone: bound over friends only
    expect(
        s:find(
            'if r == "help" then self:SetBindingClick(true, "ALT-Q", self:GetFrameRef("worldButton"), "mb2") end',
            1,
            true
        ) ~=
            nil
    ).toBe(true)
end

@test("a key over a unit in the world casts on it; away from units it does what it did")
local function world()
    local name, id = known()
    watchCasts()
    M:Add(bind("SHIFT-F", name, id), nil)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    -- away from units: no override
    expect(ours("SHIFT-F")).toBe(false)
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-F", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb1")
    mock.pressKey("SHIFT-F")
    expect(casts[#casts] and casts[#casts].id).toBe(id)
    expect(casts[#casts] and casts[#casts].unit).toBe("mouseover")
    mock.player:mouseover(nil)
    mock.advanceFrames(15, 20)
    expect(ours("SHIFT-F")).toBe(false)
end

@test("a key over a SuuUI unit frame casts on the frame's unit; a frames-only key does nothing in the world")
local function overFrame()
    local name, id = known()
    watchCasts()
    M:Add(bind("SHIFT-G", name, id, { reach = "frames" }), nil)
    local player = assert(frames.find("SuuUIPlayerFrame"))
    mock.hover(player)
    mock.advanceFrames(1)
    expect(GetBindingAction("SHIFT-G", true)).toBe("CLICK SuuUIMouseBindingsFrame:mb1")
    mock.pressKey("SHIFT-G")
    expect(casts[#casts] and casts[#casts].unit).toBe("player")
    mock.hover(nil)
    mock.advanceFrames(1)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(ours("SHIFT-G")).toBe(false)
end

@test("a modified click on a unit frame casts on its unit; the plain click still targets")
local function frameClick()
    local name, id = known()
    watchCasts()
    M:Add(bind("SHIFT-BUTTON1", name, id), nil)
    local player = assert(frames.find("SuuUIPlayerFrame"))
    expect(player:GetAttribute("shift-type1")).toBe("spell")
    mock.setModifiers({ shift = true })
    mock.click(player, "LeftButton")
    expect(casts[#casts] and casts[#casts].unit).toBe("player")
    mock.setModifiers({})
    local before = #casts
    mock.click(player, "LeftButton")
    expect(#casts).toBe(before)
    expect(UnitIsUnit("target", "player")).toBe(true)
end

@test("one key, a friend's spell and an enemy's: each unit gets its own")
local function friendFoe()
    local name, id = known()
    watchCasts()
    M:Add(bind("CTRL-F", name, id, { react = "harm" }), nil)
    M:Add(bind("CTRL-F", "Friendly Spell", 4242, { react = "help" }), nil)
    -- (the friend's spell: one the client knows by ID)
    expect(#M:Binds()).toBe(2)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    mock.pressKey("CTRL-F")
    expect(casts[#casts] and casts[#casts].id).toBe(id)
    local friend = mock.spawnUnit({ name = "Ally", reaction = "friendly", distance = 5 })
    mock.player:mouseover(friend)
    mock.advanceFrames(15, 20)
    mock.pressKey("CTRL-F")
    expect(casts[#casts] and casts[#casts].id).toBe(4242)
end

@test("a key with a friend's spell only keeps its job over an enemy, in the world and on frames")
local function friendOnly()
    local name, id = known()
    watchCasts()
    SetBinding("2", "ACTIONBUTTON2")
    M:Add(bind("2", name, id, { react = "help" }), nil)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(ours("2")).toBe(false)
    expect(GetBindingAction("2", true)).never.toBe("")
    local friend = mock.spawnUnit({ name = "Ally", reaction = "friendly", distance = 5 })
    mock.player:mouseover(friend)
    mock.advanceFrames(15, 20)
    expect(ours("2")).toBe(true)
    mock.pressKey("2")
    expect(casts[#casts] and casts[#casts].id).toBe(id)
    mock.player:mouseover(nil)
    mock.advanceFrames(15, 20)
    -- your own frame: a friend
    mock.hover(assert(frames.find("SuuUIPlayerFrame")))
    mock.advanceFrames(1)
    expect(ours("2")).toBe(true)
    mock.hover(nil)
    mock.advanceFrames(1)
    expect(ours("2")).toBe(false)
    SetBinding("2")
end

@test("in combat a new binding waits for its end; the old ones still cast")
local function combat()
    local name, id = known()
    watchCasts()
    M:Add(bind("SHIFT-F", name, id), nil)
    mock.player:enterCombat()
    M:Add(bind("SHIFT-H", name, id), nil)
    local mob = mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 })
    mock.player:mouseover(mob)
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-F", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb1")
    expect(ours("SHIFT-H")).toBe(false)
    mock.player:leaveCombat()
    mock.advanceFrames(15, 20)
    expect(GetBindingAction("SHIFT-H", true)).toBe("CLICK SuuUIMouseBindingsWorld:mb2")
end

@test("each talent tree keeps its own; bindings made before any tree go to the first one")
local function specs()
    local name, id = known()
    local tree = 0
    mock.stub(SuuUI, "Spec", function(): number
        return tree
    end)
    M:Store().last = nil
    M:Add(bind("SHIFT-F", name, id), nil)
    expect(M:SpecKey()).toBe("0")
    -- the first tree takes them over
    tree = 2
    expect(M:SpecKey()).toBe("2")
    expect(#M:Binds()).toBe(1)
    -- another tree: its own, copied over on demand
    tree = 3
    expect(#M:Binds()).toBe(0)
    M:CopyFrom("2")
    expect(#M:Binds()).toBe(1)
    -- the talents read empty (after login): the last tree's
    tree = 0
    expect(M:SpecKey()).toBe("3")
end

--------------------------------------------------------------------------------
-- The unit frames' Target and Menu clicks
--------------------------------------------------------------------------------

@test(
    "Target moved to Shift-Left: a plain Left click casts its spell, Shift-Left targets; back on Left, the frame's own click again"
)
local function targetMoved()
    local name, id = known()
    watchCasts()
    local player = assert(frames.find("SuuUIPlayerFrame"))
    expect(player:GetAttribute("*type1")).toBe("target")
    M:SetClick("target", "SHIFT-BUTTON1")
    expect(M:Clicks()).toEqual({ target = "SHIFT-BUTTON1", menu = "BUTTON2" })
    expect(player:GetAttribute("*type1")).toBe(nil)
    expect(player:GetAttribute("shift-type1")).toBe("target")
    expect(player:GetAttribute("*type2")).toBe("togglemenu")
    -- Left is free: bound without a question, it casts on the frame's unit
    local v = judge(M:Binds(), bind("BUTTON1", name, id), nil, M:Clicks())
    expect(v.ask).toBe(nil)
    M:Add(bind("BUTTON1", name, id, { reach = "frames" }), nil)
    mock.click(player, "LeftButton")
    expect(casts[#casts] and casts[#casts].id).toBe(id)
    expect(casts[#casts] and casts[#casts].unit).toBe("player")
    -- (someone else targeted first: the click's target is seen)
    mock.player:target(mock.spawnUnit({ name = "Kobold", reaction = "hostile", distance = 5 }))
    expect(UnitIsUnit("target", "player")).toBe(false)
    mock.click(player, "LeftButton")
    expect(UnitIsUnit("target", "player")).toBe(false)
    local before = #casts
    mock.setModifiers({ shift = true })
    mock.click(player, "LeftButton")
    expect(#casts).toBe(before)
    expect(UnitIsUnit("target", "player")).toBe(true)
    mock.setModifiers({})
    -- back on Left: it takes the spell's click, the frame's own attributes back
    M:SetClick("target", "BUTTON1")
    expect(#M:Binds()).toBe(0)
    expect(player:GetAttribute("*type1")).toBe("target")
    expect(player:GetAttribute("shift-type1")).toBe(nil)
    expect(player:GetAttribute("type1")).toBe(nil)
end

@test("Target on Right swaps Menu onto Left")
local function swapped()
    local player = assert(frames.find("SuuUIPlayerFrame"))
    M:SetClick("target", "BUTTON2")
    expect(M:Clicks()).toEqual({ target = "BUTTON2", menu = "BUTTON1" })
    expect(player:GetAttribute("type2")).toBe("target")
    expect(player:GetAttribute("type1")).toBe("togglemenu")
    expect(player:GetAttribute("*type1")).toBe(nil)
    expect(player:GetAttribute("*type2")).toBe(nil)
    -- the defaults again: nothing kept
    M:SetClick("target", "BUTTON1")
    expect(M:Clicks()).toEqual({ target = "BUTTON1", menu = "BUTTON2" })
    expect(player:GetAttribute("*type1")).toBe("target")
    expect(player:GetAttribute("*type2")).toBe("togglemenu")
    expect(player:GetAttribute("type1")).toBe(nil)
    expect(player:GetAttribute("type2")).toBe(nil)
end

@test("a spell on Target's click keeps working in the world when Target takes it")
local function takenKeepsWorld()
    local name, id = known()
    M:Add(bind("ALT-BUTTON1", name, id), nil)
    M:SetClick("menu", "ALT-BUTTON1")
    local b = M:Binds()[1]
    expect(b and b.reach).toBe("world")
    local player = assert(frames.find("SuuUIPlayerFrame"))
    expect(player:GetAttribute("alt-type1")).toBe("togglemenu")
end

@test("each tree keeps its own Target and Menu clicks; copied with its bindings")
local function clicksPerSpec()
    local tree = 2
    mock.stub(SuuUI, "Spec", function(): number
        return tree
    end)
    M:SetClick("target", "SHIFT-BUTTON1")
    tree = 3
    expect(M:Clicks()).toEqual({ target = "BUTTON1", menu = "BUTTON2" })
    M:CopyFrom("2")
    expect(M:Clicks().target).toBe("SHIFT-BUTTON1")
    tree = 2
    expect(M:Clicks().target).toBe("SHIFT-BUTTON1")
end

@test("the list shows Target and Menu first; a click on one opens its click box")
local function listRows()
    local parent = CreateFrame("Frame", nil, UIParent)
    parent:SetSize(600, 400)
    parent:SetPoint("CENTER")
    M:List(parent, function() end)
    local list = assert(M.list)
    local target, menu = list.rows[1], list.rows[2]
    expect(target.name:GetText()).toBe("Target")
    expect(target.line:GetText()).toBe("Targets the unit · the game's own click")
    expect(menu.name:GetText()).toBe("Menu")
    expect(menu.line:GetText()).toBe("Opens the unit's menu · the game's own click")
    mock.click(target.frame)
    local box = assert(M.clickBox)
    expect(box.panel:IsShown()).toBe(true)
    expect(box.kind).toBe("target")
    -- a click picked in the box, saved: the row says so
    box:Got("CTRL-BUTTON1")
    box:Confirm()
    expect(box.panel:IsShown()).toBe(false)
    expect(list.rows[1].line:GetText()).toBe("Targets the unit · click to change")
    parent:Hide()
end

@test(
    "binding a spell to Target's click moves Target first: in the capture box and in bind mode; cancelled, nothing changes"
)
local function moveForSpell()
    local name, id = known()
    -- the capture box: Bind asks for Target's new click, then binds
    M:Edit({ name = name, spellID = id })
    local box = assert(M.box)
    box:Got("BUTTON1")
    expect(box.ok.label:GetText()).toBe("Move Target…")
    box:Confirm()
    local clickBox = assert(M.clickBox)
    expect(clickBox.panel:IsShown()).toBe(true)
    expect(clickBox.waiting).toBe(true)
    -- its own click again is no move
    clickBox:Got("BUTTON1")
    expect(clickBox.ok:IsEnabled()).toBe(false)
    clickBox:Got("SHIFT-BUTTON1")
    clickBox:Confirm()
    expect(M:Clicks().target).toBe("SHIFT-BUTTON1")
    expect(#M:Binds()).toBe(1)
    expect(M:Binds()[1].input).toBe("BUTTON1")
    expect(box.panel:IsShown()).toBe(false)
    -- bind mode: Menu's click; the box cancelled, not bound
    local said: string? = nil
    mock.stub(SuuUI.UI, "Confirm", function(opts: { onConfirm?: () -> () }): nil
        local confirm = opts.onConfirm
        if confirm then
            confirm()
        end
        return nil
    end)
    M:Press({ name = name, spellID = id }, "BUTTON2", function(title: string)
        said = title
    end)
    expect(clickBox.panel:IsShown()).toBe(true)
    expect(clickBox.kind).toBe("menu")
    clickBox:Close()
    expect(said).toBe("Not bound")
    expect(#M:Binds()).toBe(1)
    -- and saved: bound
    M:Press({ name = name, spellID = id }, "BUTTON2", function(title: string)
        said = title
    end)
    clickBox:Got("CTRL-BUTTON2")
    clickBox:Confirm()
    expect(said).toBe("Right click → " .. name)
    expect(M:Clicks().menu).toBe("CTRL-BUTTON2")
    expect(#M:Binds()).toBe(2)
end

@test(
    "a Cmd click on a unit frame: its spell's and Target's attributes on the renamed click, marked for the frame's wrap"
)
local function cmdClick()
    local name, id = known()
    local player = assert(frames.find("SuuUIPlayerFrame"))
    M:Add(bind("META-BUTTON1", name, id), nil)
    expect(player:GetAttribute("type-cmd-LeftButton")).toBe("spell")
    expect(player:GetAttribute("suuui-cmd-LeftButton")).toBe("1")
    M:SetClick("target", "META-SHIFT-BUTTON2")
    expect(player:GetAttribute("shift-type-cmd-RightButton")).toBe("target")
    expect(player:GetAttribute("suuui-cmd-shift-RightButton")).toBe("1")
    -- gone again: the marks too
    M:SetClick("target", "BUTTON1")
    M:Store().specs = {}
    M:Apply()
    expect(player:GetAttribute("suuui-cmd-LeftButton")).toBe(nil)
    expect(player:GetAttribute("suuui-cmd-shift-RightButton")).toBe(nil)
    expect(player:GetAttribute("*type1")).toBe("target")
end

@test("on a Mac with Cmd-Left as Right click, both boxes say so and turn the setting off")
local function macCmdLeft()
    local CVAR = "MacUseCommandLeftClickAsRightClick"
    local cvar = "1"
    local realMac = rawget(_G, "IsMacClient")
    rawset(_G, "IsMacClient", function(): boolean
        return true
    end)
    mock.stub(C_CVar, "GetCVar", function(name: string): string?
        return name == CVAR and cvar or nil
    end)
    local set = mock.stub(C_CVar, "SetCVar", function(name: string, value: string): boolean
        if name == CVAR then
            cvar = value
        end
        return true
    end)
    M:EditClick("target")
    local box = assert(M.clickBox)
    expect(box.mac.text:IsShown()).toBe(true)
    mock.click(box.mac.button)
    expect(set).toHaveBeenCalledWith(CVAR, "0")
    expect(box.mac.text:IsShown()).toBe(false)
    box:Close()
    -- the spell's box too; with the setting off, no note
    local name, id = known()
    cvar = "1"
    M:Edit({ name = name, spellID = id })
    local spellBox = assert(M.box)
    expect(spellBox.mac.text:IsShown()).toBe(true)
    cvar = "0"
    spellBox:Draw()
    expect(spellBox.mac.text:IsShown()).toBe(false)
    rawset(_G, "IsMacClient", realMac)
end
