-- Units/Nameplates: SuuUI's plates laid on the engine's nameplates: an
-- enemy's (Blizzard's frame hidden under it, the name, level, health text,
-- threat, your target, a quest objective, a raid marker), a friendly one
-- in the open world (class colour) and Blizzard's inside an instance,
-- your own left alone, a plate released; the game's nameplate settings
-- (alpha and scale, no plates at all, friendly players and NPCs); the
-- settings on live plates; the preview; the migration; stopped.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as tbl from "wowlua:table"
import * as errors from "wowlua:errors"
import * as secret from "wowlua:secret"
import internal M, byUnit, SECTION, pool, groupsAhead from "/Units/Nameplates"
import type Nameplate from "/Units/Nameplates"
import type UnitApi from "/UI/UnitFrame"
import migrations as settingMigrations from "/Core/Settings"
import expectNoErrors from "../../helpers"
import * as coreSettings from "/Core/Settings"
import * as themes from "/Core/Themes"
import * as healthFill from "/UI/HealthFill"
import * as events from "/Core/Events"

local UI, T = SuuUI.UI, SuuUI.Tokens

-- Placeholder units (made once).
local wolf = mock.spawnUnit({
    name = "Prowler",
    level = 9,
    reaction = "hostile",
    distance = 10,
    health = 80,
    healthMax = 100,
})
local bear = mock.spawnUnit({
    name = "Young Bear",
    level = 12,
    reaction = "hostile",
    distance = 12,
    classification = "elite",
})
local guard = mock.spawnUnit({ name = "Stormwind Guard", level = 30, reaction = "friendly", distance = 10 })
local mage = mock.spawnUnit({
    name = "Tamsin Ashford",
    player = true,
    class = "MAGE",
    level = 30,
    reaction = "friendly",
    distance = 10,
})

local function show(u: mock.MockUnit): Nameplate?
    u:showNameplate()
    mock.advanceFrames(3)
    return byUnit[u:token() :: string]
end

local function plateOf(u: mock.MockUnit): Nameplate
    return assert(show(u))
end

-- The game's plate for a unit.
local function gamePlate(unit: string): NamePlateFrame
    return assert(C_NamePlate.GetNamePlateForUnit(unit))
end

local function hasRGB(fs: FontString, tr: number, tg: number, tb: number): boolean
    local r, g, b = fs:GetTextColor()
    return math.abs(r - tr) < 0.01 and math.abs(g - tg) < 0.01 and math.abs(b - tb) < 0.01
end

local function hasColor(fs: FontString, token: string): boolean
    local tr, tg, tb = UI.RGBA(token)
    return hasRGB(fs, tr, tg, tb)
end

-- A health bar's fill drawn in these colours (the deep end, then the fill)?
local function drawsAs(bar: StatusBar, want: number[]): boolean
    local got = { healthFill.colorsOf(bar) }
    for i = 1, 6 do
        if math.abs(got[i] - want[i]) > 0.001 then
            return false
        end
    end
    return true
end

-- ... a gradient of two tokens; a token toned (a class's or a reaction's)
local function fillIs(bar: StatusBar, deep: string, fill: string): boolean
    local r1, g1, b1 = UI.RGBA(deep)
    local r2, g2, b2 = UI.RGBA(fill)
    return drawsAs(bar, { r1, g1, b1, r2, g2, b2 })
end
local function drawnToned(bar: StatusBar, token: string): boolean
    return drawsAs(bar, { healthFill.lookColors(token) })
end

-- A plate's own API table with some functions replaced: a stubbed global
-- would run Blizzard's plates tainted too.
local function fakeAPI(f: Nameplate, fns: { [string]: unknown })
    local api: UnitApi = mock.partial(setmetatable(fns, { __index = _G }))
    mock.setField(f, "api", api)
end

-- A settings row's "disabled" answer.
local function rowDisabled(key: string): (boolean?, string?)
    for _, g in ipairs(tbl.list(tbl.field(SECTION, "groups"))) do
        for _, r in ipairs(tbl.list(tbl.field(g, "rows"))) do
            if tbl.field(r, "key") == key then
                local off, why = errors.try(tbl.field(r, "disabled"))
                return secret.asBoolean(off), secret.asString(why)
            end
        end
    end
    return nil
end

@afterEach
local function cleanup()
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    for _, u in ipairs({ wolf, bear, guard, mage }) do
        u:hideNameplate()
    end
    mock.player:target(nil)
    mock.group:leave()
    if coreSettings.accountString("npcHealthColor") then
        coreSettings.setAccount("npcHealthColor", nil)
        themes.apply()
    end
    M:ResetAll({
        "width",
        "barHeight",
        "castHeight",
        "auras",
        "auraSize",
        "castBars",
        "castTarget",
        "castKick",
        "dimOthers",
        "threat",
        "healthText",
        "showPlates",
        "friendlyOpenWorld",
        "friendlyStyle",
        "friendlyNPCs",
        "questMarks",
        "levels",
        "eliteDragon",
        "raidMarker",
    })
    mock.advanceFrames(3)
    expectNoErrors()
end

@test("an enemy's plate: SuuUI's over Blizzard's (hidden, its auras out of the way), the name, level and health")
local function enemy()
    local f = plateOf(wolf)
    expect(f:IsShown()).toBe(true)
    local plate = gamePlate(wolf:token() :: string)
    expect(f:GetParent()).toBe(plate)
    expect(plate.UnitFrame:GetAlpha()).toBe(0)
    -- Blizzard setting it back: hidden again
    plate.UnitFrame:SetAlpha(1)
    expect(plate.UnitFrame:GetAlpha()).toBe(0)
    expect(f.name:GetText()).toBe("Prowler")
    expect(hasColor(f.name, "reaction-hostile")).toBe(true)
    expect(f.level:GetText()).toBe("9")
    -- another unit's health is secret: the text goes through it
    expect(f.pct:GetText() :: unknown).toBe(mock.secret("80%"))
    -- an elite: "+"
    local b = plateOf(bear)
    expect(b.level:GetText()).toBe("12+")
end

-- Every pixel line on a plate (thin BORDER textures), in physical pixels at
-- the scale it shows at now; the debuff icons' edges counted apart (reached
-- through the container: the game makes the icons forbidden).
local function plateLines(f: Nameplate): (number[], number)
    local _, h = GetPhysicalScreenSize()
    local out: number[] = {}
    local function add(t: Texture, thin: number)
        if thin > 0 and thin < 3 then
            out[#out + 1] = thin * t:GetEffectiveScale() / (768 / h)
        end
    end
    local function measure(t: Texture)
        add(t, math.min(t:GetHeight(), t:GetWidth()))
    end
    local function walk(fr: Frame)
        if fr:IsForbidden() then
            return
        end
        for _, r in ipairs({ fr:GetRegions() }) do
            if r:GetObjectType() == "Texture" and (r :: Texture):GetDrawLayer() == "BORDER" then
                measure(r :: Texture)
            end
        end
        for _, c in ipairs({ fr:GetChildren() }) do
            walk(c)
        end
    end
    walk(f)
    local icons = 0
    for _, b in ipairs(f.auras and f.auras.buttons or {}) do
        -- (their thickness as set: an icon without an aura isn't laid out)
        for _, edge in ipairs(b.edges) do
            add(edge.top, edge.top:GetHeight())
            add(edge.bottom, edge.bottom:GetHeight())
            add(edge.left, edge.left:GetWidth())
            add(edge.right, edge.right:GetWidth())
            icons = icons + 4
        end
    end
    return out, icons
end

@test(
    "a plate's lines are one physical pixel on the game's plate (which hangs on WorldFrame, not UIParent), the debuff icons' too"
)
local function pixelLines()
    -- (found in game, 0.6.32: made under UIParent, they came out under one
    -- pixel at a larger UI scale and vanished "depending on your camera
    -- angle")
    local f = plateOf(wolf)
    local plate = gamePlate(wolf:token() :: string)
    expect(plate:GetEffectiveScale() ~= UIParent:GetEffectiveScale()).toBe(true)
    expect(assert(assert(f.auras).groups.mine).added).toBe(true)
    local lines, icons = plateLines(f)
    expect(#lines > 8).toBe(true)
    expect(icons > 8).toBe(true)
    for _, px in ipairs(lines) do
        expect(math.abs(px - 1) < 0.001).toBe(true)
    end
end

@test(
    "debuff icons made before the game shows a plate: a pixel or more on it (the game makes them forbidden, their lines can't be laid again)"
)
local function iconsBeforePlate()
    -- (a player's report, 0.8.0: the debuffs' borders "missing most": the
    -- pool made the icons at WorldFrame's scale, the game's plates are at
    -- another, and the icons were forbidden by the time the pool took theirs)
    local function gameLike(scale: number): Frame
        local p = CreateFrame("Frame", nil, WorldFrame)
        p:SetScale(scale)
        p:SetSize(120, 20)
        p:SetPoint("CENTER")
        return p
    end
    -- the pool emptied, taken again (as after a reload): it fills up
    local saved: Nameplate[] = {}
    while #pool > 0 do
        saved[#saved + 1] = assert(table.remove(pool))
    end
    groupsAhead.made = 0
    mock.advanceFrames(1)
    M:Attach("nameplate42", gameLike(1), false)
    M:OnPlateRemoved("nameplate42")
    -- the plates' scale unknown again (the UI scale changed)
    events.emit("SUUUI_PIXEL_CHANGED", 1080, UIParent:GetEffectiveScale())
    mock.advanceFrames(30)
    expect(#pool > 4).toBe(true)
    -- not before a plate shows: no debuff groups made ahead
    expect(groupsAhead.made).toBe(0)
    -- a pooled plate's debuff group made now (a plate coming in a fight)
    -- (one without it yet, last in the pool: the next plate takes it)
    local f: Nameplate? = nil
    for i = #pool, 1, -1 do
        local pf = pool[i]
        local g = pf.aurasTried and pf.auras and pf.auras.groups.mine
        if g and not g.added then
            f = table.remove(pool, i)
            break
        end
    end
    table.insert(pool, assert(f))
    local auras = assert(assert(f).auras)
    auras:SetGroupMax("mine", 3)
    expect(assert(auras.groups.mine).added).toBe(true)
    -- the game's plate at UIParent's scale (not WorldFrame's)
    local ui, world = UIParent:GetEffectiveScale(), WorldFrame:GetEffectiveScale()
    expect(math.abs(ui - world) > 0.01).toBe(true)
    M:Attach("nameplate41", gameLike(ui / world), false)
    expect(byUnit["nameplate41"]).toBe(f)
    local lines, icons = plateLines(assert(f))
    expect(#lines > 8).toBe(true)
    expect(icons > 8).toBe(true)
    for _, px in ipairs(lines) do
        expect(px > 1 - 0.001 and px < 1.5).toBe(true)
    end
    M:OnPlateRemoved("nameplate41")
    events.emit("SUUUI_PIXEL_CHANGED", 1080, UIParent:GetEffectiveScale())
    for _, s in ipairs(saved) do
        pool[#pool + 1] = s
    end
end

@test("the health text: the value, both, none")
local function healthText()
    local f = plateOf(wolf)
    M:Set("healthText", "value")
    expect(f.pct:GetText() :: unknown).toBe(mock.secret("80"))
    M:Set("healthText", "both")
    expect(f.pct:GetText() :: unknown).toBe(mock.secret("80 · 80%"))
    M:Set("healthText", "none")
    expect(f.pct:IsShown()).toBe(false)
    -- health changing: drawn again
    M:Set("healthText", "percent")
    wolf:damage(30)
    mock.advanceFrames(2)
    expect(f.pct:GetText() :: unknown).toBe(mock.secret("50%"))
end

@test("your target in full, an ink border; the rest dim (off by the setting)")
local function target()
    local f, b = plateOf(wolf), plateOf(bear)
    mock.player:target(wolf)
    mock.advanceFrames(1)
    expect(f.isTarget).toBe(true)
    expect(f:GetAlpha()).toBe(1)
    expect(b:GetAlpha()).toBeCloseTo(T.opacity["opacity-plate"])
    M:Set("dimOthers", false)
    expect(b:GetAlpha()).toBe(1)
end

@test("threat: Aggro on what attacks you; as a tank in a group, Losing and Aggro; off by the setting")
local function threat()
    local f = plateOf(wolf)
    expect(f.badge:IsShown()).toBe(false)
    -- the wolf on you
    wolf:setThreat(100)
    mock.advanceFrames(1)
    expect(f.badge:IsShown()).toBe(true)
    expect(f.state).toBe("danger")
    wolf:setThreat(nil)
    -- a tank in a group
    local friend = mock.spawnUnit({
        name = "Brannoc Ironhand",
        player = true,
        class = "WARRIOR",
        reaction = "friendly",
    })
    mock.group:add(friend)
    mock.stub(SuuUI, "Role", function(): string
        return "TANK"
    end)
    local status = 3
    fakeAPI(f, {
        UnitThreatSituation = function(_: string, _: string?): number
            return status
        end,
    })
    status = 2
    f:UpdateThreat()
    expect(f.state).toBe("warning")
    status = 1
    f:UpdateThreat()
    expect(f.state).toBe("danger")
    status = 0
    f:UpdateThreat()
    expect(f.state).toBe("danger")
    M:Set("threat", false)
    expect(f.badge:IsShown()).toBe(false)
end

@test("a quest objective: the gilt mark and the count, from the unit's tooltip data")
local function quest()
    local LT = Enum.TooltipDataLineType
    local objective = {
        type = LT.QuestObjective,
        completed = false,
        leftText = "Prowler slain: 3/8",
        numFulfilled = 3,
        numRequired = 8,
    }
    mock.stub(C_TooltipInfo, "GetUnit", function(_: string): unknown
        return {
            lines = { { type = LT.UnitName, leftText = "Prowler" }, { type = LT.QuestTitle, id = 9001 }, objective },
        }
    end)
    mock.stub(C_QuestLog, "IsOnQuest", function(_: number): boolean
        return true
    end)
    local f = plateOf(wolf)
    expect(f.quest:IsShown()).toBe(true)
    expect(f.questCount:GetText()).toBe("3/8")
    -- a percentage, a single one, done
    objective.leftText, objective.numRequired = "Area explored 45%", 1
    mock.fireEvent("QUEST_WATCH_UPDATE", 9001)
    mock.advanceTime(0.6)
    expect(f.questCount:GetText()).toBe("45%")
    objective.leftText = "Find the den"
    mock.fireEvent("QUEST_WATCH_UPDATE", 9001)
    mock.advanceTime(0.6)
    expect(f.quest:IsShown()).toBe(true)
    expect(f.questCount:IsShown()).toBe(false)
    objective.completed = true
    mock.fireUnitEvent("UNIT_QUEST_LOG_CHANGED", "player")
    mock.advanceTime(0.6)
    expect(f.quest:IsShown()).toBe(false)
    -- a quest not in your log (a group member's): no mark
    objective.completed = false
    mock.stub(C_QuestLog, "IsOnQuest", function(_: number): boolean
        return false
    end)
    mock.fireEvent("QUEST_ACCEPTED", 1)
    mock.advanceTime(0.6)
    expect(f.quest:IsShown()).toBe(false)
    M:Set("questMarks", false)
end

@test("a raid marker left of the plate; off by the setting")
local function raidMarker()
    local f = plateOf(wolf)
    fakeAPI(f, {
        GetRaidTargetIndex = function(_: string): number?
            return 8
        end,
    })
    mock.fireEvent("RAID_TARGET_UPDATE")
    expect(f.raidMarker:IsShown()).toBe(true)
    M:Set("raidMarker", false)
    expect(f.raidMarker:IsShown()).toBe(false)
end

@test(
    "friendly plates: SuuUI's in the open world (a player in class colour), Blizzard's in an instance or with the look off"
)
local function friendly()
    local f = plateOf(mage)
    expect(f.friendly).toBe(true)
    local mageColor = assert(C_ClassColor.GetClassColor("MAGE"))
    expect(hasRGB(f.name, mageColor:GetRGB())).toBe(true)
    local g = plateOf(guard)
    expect(g.friendly).toBe(true)
    expect(hasColor(g.name, "reaction-friendly")).toBe(true)
    -- the look off: Blizzard's again
    M:Set("friendlyStyle", false)
    expect(byUnit[mage:token() :: string]).toBeNil()
    expect(gamePlate(mage:token() :: string).UnitFrame:GetAlpha()).toBe(1)
    M:Set("friendlyStyle", true)
    -- in a dungeon: Blizzard's
    mage:hideNameplate()
    mock.enterInstance("party")
    mock.advanceFrames(1)
    expect(show(mage)).toBeNil()
    mock.leaveInstance()
end

@test("class-coloured health on plates: a player's in their class colour, an NPC's the fill; the name keeps its colour")
local function classHealth()
    coreSettings.setAccount("healthColor", "class")
    themes.apply()
    local f = plateOf(mage)
    expect(f.fillClass).toBe("class-mage")
    expect(healthFill.lookOf(f.health)).toBe("class-mage")
    -- (above the bar: the class colour stays)
    local mageColor = assert(C_ClassColor.GetClassColor("MAGE"))
    expect(hasRGB(f.name, mageColor:GetRGB())).toBe(true)
    local w = plateOf(wolf)
    expect(fillIs(w.health, "unit-fill-deep", "unit-fill")).toBe(true)
    coreSettings.setAccount("healthColor", nil)
    themes.apply()
    expect(healthFill.byClass()).toBe(false)
end

@test(
    "NPC reaction colours on plates: off, the fill; on, hostile red, neutral yellow, friendly green; a player as before; the name keeps its colour"
)
local function reactionHealth()
    local boar = mock.spawnUnit({ name = "Old Boar", level = 8, reaction = "neutral", distance = 11 })
    local w, b, g, m = plateOf(wolf), plateOf(boar), plateOf(guard), plateOf(mage)
    -- off (the default): every NPC the theme's fill
    expect(healthFill.byReaction()).toBe(false)
    for _, f in ipairs({ w, b, g }) do
        expect(fillIs(f.health, "unit-fill-deep", "unit-fill")).toBe(true)
    end
    expect(w.fillReaction).toBe("reaction-hostile")
    expect(b.fillReaction).toBe("reaction-neutral")
    expect(g.fillReaction).toBe("reaction-friendly")
    -- on (live)
    coreSettings.setAccount("npcHealthColor", "reaction")
    themes.apply()
    expect(drawnToned(w.health, "reaction-hostile")).toBe(true)
    expect(drawnToned(b.health, "reaction-neutral")).toBe(true)
    expect(drawnToned(g.health, "reaction-friendly")).toBe(true)
    -- (above the bar: the name keeps its reaction colour)
    expect(hasColor(w.name, "reaction-hostile")).toBe(true)
    expect(hasColor(b.name, "reaction-neutral")).toBe(true)
    -- a player: as before
    expect(m.fillReaction).toBeNil()
    expect(healthFill.lookOf(m.health)).toBe("class-mage")
    expect(fillIs(m.health, "unit-fill-deep", "unit-fill")).toBe(true)
    -- the reaction changes (UNIT_FACTION): repainted
    boar:update({ reaction = "hostile" })
    mock.advanceFrames(1)
    local b2 = assert(byUnit[boar:token() :: string])
    expect(drawnToned(b2.health, "reaction-hostile")).toBe(true)
    expect(hasColor(b2.name, "reaction-hostile")).toBe(true)
    -- tagged by someone else: the tapped look wins
    local denied = true
    fakeAPI(w, {
        UnitIsTapDenied = function(_: string): boolean
            return denied
        end,
    })
    mock.fireUnitEvent("UNIT_FACTION", wolf:token() :: string)
    mock.advanceFrames(1)
    expect(healthFill.lookOf(w.health)).toBe("tapped")
    expect(fillIs(w.health, "unit-fill-tapped-deep", "unit-fill-tapped")).toBe(true)
    denied = false
    mock.fireUnitEvent("UNIT_FACTION", wolf:token() :: string)
    mock.advanceFrames(1)
    expect(drawnToned(w.health, "reaction-hostile")).toBe(true)
    -- off again (live): the fill
    coreSettings.setAccount("npcHealthColor", nil)
    themes.apply()
    expect(fillIs(w.health, "unit-fill-deep", "unit-fill")).toBe(true)
    boar:hideNameplate()
    boar:despawn()
end

@test("a plate gone: back in the pool")
local function released()
    local f = plateOf(wolf)
    wolf:hideNameplate()
    mock.advanceFrames(2)
    expect(byUnit[wolf:token() :: string or "nameplate1"]).toBeNil()
    expect(f:IsShown()).toBe(false)
    -- a plate SuuUI never laid: nothing to do
    M:OnPlateRemoved("nameplate40")
end

@test("the pool empty in a fight: one plate made a frame, the others a frame each")
local function oneAFrame()
    local boar = mock.spawnUnit({ name = "Old Boar", level = 10, reaction = "hostile", distance = 11 })
    -- the pool emptied (a big pull took every plate made ahead)
    local kept: Nameplate[] = {}
    while #pool > 0 do
        kept[#kept + 1] = assert(table.remove(pool))
    end
    mock.player:enterCombat()
    mock.advanceFrames(1)
    wolf:showNameplate()
    bear:showNameplate()
    boar:showNameplate()
    local function laid(): number
        local n = 0
        for _, u in ipairs({ wolf, bear, boar }) do
            if byUnit[u:token() :: string] then
                n = n + 1
            end
        end
        return n
    end
    expect(laid()).toBe(1)
    expect(#M.waiting).toBe(2)
    mock.advanceFrames(1)
    expect(laid()).toBe(2)
    mock.advanceFrames(1)
    expect(laid()).toBe(3)
    expect(#M.waiting).toBe(0)
    -- one gone while waiting: dropped
    for _, u in ipairs({ wolf, bear, boar }) do
        u:hideNameplate()
    end
    mock.advanceFrames(1)
    while #pool > 0 do
        kept[#kept + 1] = assert(table.remove(pool))
    end
    wolf:showNameplate()
    bear:showNameplate()
    expect(#M.waiting).toBe(1)
    bear:hideNameplate()
    expect(#M.waiting).toBe(0)
    mock.advanceFrames(2)
    expect(byUnit[bear:token() or "none"]).toBeNil()
    mock.player:leaveCombat()
    boar:despawn()
    for _, f in ipairs(kept) do
        pool[#pool + 1] = f
    end
    expectNoErrors()
end

@test("the pool made a step a frame out of combat: the plate, then its aura container")
local function poolSteps()
    mock.advanceFrames(120)
    expect(#pool >= 32).toBe(true)
    local kept: Nameplate[] = {}
    for _ = 1, 30 do
        kept[#kept + 1] = assert(table.remove(pool))
    end
    wolf:showNameplate()
    local sawBare = false
    for _ = 1, 10 do
        mock.advanceFrames(1)
        for _, f in ipairs(pool) do
            if not f.aurasTried then
                sawBare = true
            end
        end
    end
    expect(sawBare).toBe(true)
    mock.advanceFrames(120)
    for _, f in ipairs(pool) do
        expect(f.aurasTried).toBe(true)
    end
    for _, f in ipairs(kept) do
        pool[#pool + 1] = f
    end
    expectNoErrors()
end

@test("an enemy plate's debuff group goes in without reading its auras; a warrior's friends never get one")
local function lazyGroups()
    -- reading your debuffs from Lua finds nothing in game (0.6.30's plates
    -- then never showed any): an enemy's group goes into the engine anyway,
    -- a frame each, and the engine shows what it has
    mock.fake("C_UnitAuras.GetAuraDataByIndex", function(...: unknown): unknown
        return nil
    end)
    local f = plateOf(wolf)
    mock.advanceFrames(3)
    local auras = assert(f.auras)
    expect(assert(auras.groups.mine).added).toBe(true)
    expect(f.auraWait).toBe(false)
    -- a friend of a warrior: nothing to remove, no group, no waiting
    guard:showNameplate()
    mock.advanceFrames(2)
    local g = plateOf(guard)
    expect(assert(assert(g.auras).groups.removable).added).toBeFalsy()
    expect(g.auraWait).toBe(false)
    expectNoErrors()
end

-- The pool topped up again (as after a fight), and the frames for it.
local function refill()
    mock.player:enterCombat()
    mock.advanceFrames(1)
    mock.player:leaveCombat()
    mock.advanceFrames(240)
end

local function mineAdded(f: Nameplate): boolean
    return assert(assert(f.auras).groups.mine).added == true
end

@test("the pool's plates take an enemy's debuff group ahead, out of combat: a plate coming in a fight has it already")
local function enemyGroupAhead()
    -- (the plates other tests put in the pool on top of the login's)
    groupsAhead.made = 0
    refill()
    expect(#pool >= 32).toBe(true)
    -- (the plates taken first: the pool's end)
    local ready: { [Nameplate]: boolean } = {}
    for i = #pool, #pool - 31, -1 do
        local f = assert(pool[i])
        expect(mineAdded(f)).toBe(true)
        -- (a friend's group still waits for its first aura)
        expect(assert(assert(f.auras).groups.removable).added).toBeFalsy()
        ready[f] = true
    end
    mock.player:enterCombat()
    mock.advanceFrames(1)
    local f = plateOf(wolf)
    expect(ready[f]).toBe(true)
    local g = assert(assert(f.auras).groups.mine)
    expect(g.max).toBe(M:Get("auras"))
    expect(f.auraWait).toBe(false)
    -- on a friend the same plate shows none of yours
    wolf:hideNameplate()
    mock.advanceFrames(1)
    local h = plateOf(guard)
    expect(assert(assert(h.auras).groups.mine).max).toBe(0)
    expectNoErrors()
end

@test(
    "debuffs off: no debuff groups made ahead; on, only for the plates taken first, and thirty-two in all (not a crowd's pool)"
)
local function groupsAheadCapped()
    -- the plates taken first have theirs
    groupsAhead.made = 0
    refill()
    local kept: Nameplate[] = {}
    while #pool > 0 do
        kept[#kept + 1] = assert(table.remove(pool))
    end
    -- debuffs off: new plates, none made
    M:Set("auras", 0)
    refill()
    expect(#pool >= 32).toBe(true)
    local bare: Nameplate[] = {}
    for _, f in ipairs(pool) do
        expect(mineAdded(f)).toBe(false)
        bare[#bare + 1] = f
    end
    -- on again, with the old plates on top (as a crowd leaves the pool
    -- bigger): the plates under the first POOL stay bare
    M:Set("auras", 4)
    for i = #kept, 1, -1 do
        pool[#pool + 1] = kept[i]
    end
    refill()
    for _, f in ipairs(bare) do
        expect(mineAdded(f)).toBe(false)
    end
    -- alone in the pool, two left of the thirty-two made ahead: two made,
    -- the others wait for an enemy
    for _ = 1, #kept do
        table.remove(pool)
    end
    groupsAhead.made = 30
    refill()
    local made = 0
    for _, f in ipairs(bare) do
        if mineAdded(f) then
            made += 1
        end
    end
    expect(made).toBe(2)
    expect(groupsAhead.made).toBe(32)
    for i = #kept, 1, -1 do
        pool[#pool + 1] = kept[i]
    end
    expectNoErrors()
end

@test("a new target restyles only the plates whose look changed")
local function targetChangedOnly()
    local boar = mock.spawnUnit({ name = "Old Boar", level = 10, reaction = "hostile", distance = 11 })
    local f, b, c = plateOf(wolf), plateOf(bear), plateOf(boar)
    mock.player:target(wolf)
    mock.advanceFrames(1)
    local borders = mock.spy(c.UpdateBorder)
    mock.stub(c, "UpdateBorder", borders)
    mock.player:target(bear)
    mock.advanceFrames(1)
    -- the boar stays dimmed: nothing for it
    expect(borders).never.toHaveBeenCalled()
    expect(c:GetAlpha()).toBeCloseTo(T.opacity["opacity-plate"])
    expect(b.isTarget).toBe(true)
    expect(f.isTarget).toBe(false)
    expect(f:GetAlpha()).toBeCloseTo(T.opacity["opacity-plate"])
    -- no target: every plate in full again (its border as it was)
    mock.player:target(nil)
    mock.advanceFrames(1)
    expect(borders).never.toHaveBeenCalled()
    expect(c:GetAlpha()).toBe(1)
    -- the boar chosen: its border
    mock.player:target(boar)
    mock.advanceFrames(1)
    expect(borders).toHaveBeenCalledTimes(1)
    expect(c.isTarget).toBe(true)
    boar:hideNameplate()
    boar:despawn()
    expectNoErrors()
end

@test("the game's nameplate settings: full alpha and scale; none at all; friendly players and NPCs in the open world")
local function gameSettings()
    expect(C_CVar.GetCVar("nameplateMinAlpha")).toBe("1")
    expect(C_CVar.GetCVar("nameplateMaxScale")).toBe("1")
    M:Set("showPlates", false)
    expect(C_CVar.GetCVar("nameplateShowEnemies")).toBe("0")
    M:Set("showPlates", true)
    expect(C_CVar.GetCVar("nameplateShowEnemies")).toBe("1")
    -- friendly players: on outside, off in a dungeon
    mock.enterInstance("party")
    M:ApplyFriendly()
    local friendlyCVar = C_CVar.GetCVar("nameplateShowFriendlyPlayers") ~= nil and "nameplateShowFriendlyPlayers" or
        "nameplateShowFriends"
    expect(C_CVar.GetCVar(friendlyCVar)).toBe("0")
    M:ApplyFriendlyNPCs()
    if C_CVar.GetCVar("nameplateShowFriendlyNPCs") then
        expect(C_CVar.GetCVar("nameplateShowFriendlyNPCs")).toBe("0")
    end
    mock.leaveInstance()
    M:ApplyFriendly()
    expect(C_CVar.GetCVar(friendlyCVar)).toBe("1")
    M:Set("friendlyNPCs", false)
    M:Set("friendlyOpenWorld", false)
    -- in a fight: after it
    mock.player:enterCombat()
    mock.advanceFrames(1)
    M:ApplyGameSettings()
    mock.player:leaveCombat()
end

@test("the settings on live plates: sizes, casts, debuffs, levels, the elite dragon")
local function settings()
    local f = plateOf(wolf)
    M:Set("width", 160)
    expect(f:GetWidth()).toBe(160)
    M:Set("barHeight", 16)
    expect(f.bar:GetHeight()).toBe(16)
    M:Set("castHeight", 12)
    M:Set("auraSize", 22)
    M:Set("auras", 2)
    M:Set("castBars", false)
    expect(f.cast.active).toBeFalsy()
    M:Set("castBars", true)
    M:Set("castTarget", false)
    M:Set("castKick", false)
    M:Set("levels", false)
    expect(f.level:IsShown()).toBe(false)
    local b = plateOf(bear)
    M:Set("eliteDragon", true)
    expect(b.dragon:IsShown() or b.crest:IsShown() or true).toBe(true)
end

@test("a unit that turns attackable (a duel): its plate laid again")
local function duel()
    local f = plateOf(mage)
    expect(f.friendly).toBe(true)
    mock.stub(_G, "UnitCanAttack", function(_: string, _: string): boolean
        return true
    end)
    mock.fireUnitEvent("UNIT_FACTION", mage:token() :: string)
    local g = assert(byUnit[mage:token() :: string])
    expect(g.friendly).toBe(false)
    -- unchanged: only drawn again
    M:Recheck(mage:token() :: string)
end

@test("the preview: made-up plates, the friendly one with SuuUI's look; a theme change")
local function preview()
    local parent = CreateFrame("Frame", nil, UIParent)
    local view = M:PreviewView(parent)
    expect(view:GetParent()).toBe(parent)
    local plates = M.previewPlates
    expect(#plates).toBe(5)
    expect(plates[1].isTarget).toBe(true)
    expect(assert(plates[1].fakes).cast:IsShown()).toBe(true)
    expect(plates[2].questCount:GetText()).toBe("3/8")
    M:Set("friendlyStyle", false)
    expect(plates[5]:IsShown()).toBe(false)
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
end

@test("the health text, once a toggle, carried over")
local function migration()
    for _, m in ipairs(settingMigrations()) do
        if m.namespace == "nameplates" and m.id == "healthText" then
            local on: { [string]: unknown } = { healthText = true }
            m.fn(on)
            expect(on.healthText).toBe("percent")
            local off: { [string]: unknown } = { healthText = false }
            m.fn(off)
            expect(off.healthText).toBe("none")
        end
    end
end

@test("the settings' rows wait: cast rows for cast bars, the debuff size for debuffs")
local function rowsWait()
    expect((rowDisabled("castTarget"))).toBe(false)
    M:Set("castBars", false)
    local off, why = rowDisabled("castTarget")
    expect(off).toBe(true)
    expect(why).toBe("Turn Cast bars on first.")
    expect((rowDisabled("auraSize"))).toBe(false)
    M:Set("auras", 0)
    off, why = rowDisabled("auraSize")
    expect(off).toBe(true)
    expect(why).toBe("Set Debuff icons above 0 first.")
end

@test("cast bars off: a new plate has none; your level up redraws the levels")
local function castsOffAndLevelUp()
    M:Set("castBars", false)
    local f = plateOf(wolf)
    expect(f.cast.active).toBeFalsy()
    local drawn = mock.spy(function(_: unknown) end)
    mock.stub(f, "UpdateLevel", drawn)
    mock.fireEvent("PLAYER_LEVEL_UP", 61, 0, 0, 0, 0, 0, 0, 0, 0, 0)
    mock.advanceTime(0.6)
    expect(drawn).toHaveBeenCalled()
end

@test("your own plate stays Blizzard's")
local function ownPlate()
    mock.player:showNameplate()
    mock.advanceFrames(2)
    expect(gamePlate("player").UnitFrame:GetAlpha()).toBe(1)
    for unit in pairs(byUnit) do
        expect(UnitIsUnit(unit, "player")).toBe(false)
    end
    mock.player:hideNameplate()
end

-- (last: the module off)
@test("stopped: SuuUI's plates gone, Blizzard's back")
local function disabled()
    show(wolf)
    local plate = gamePlate(wolf:token() :: string)
    M:OnDisable()
    expect(plate.UnitFrame:GetAlpha()).toBe(1)
    expect(next(byUnit)).toBeNil()
end

@test("a mob tagged by someone else: its plate's health grey; the tag gone (UNIT_FACTION): back")
local function tappedPlate()
    local f = plateOf(wolf)
    expect(f.tappedLook).toBe(false)
    local denied = true
    fakeAPI(f, {
        UnitIsTapDenied = function(_: string): boolean
            return denied
        end,
    })
    mock.fireUnitEvent("UNIT_FACTION", wolf:token() :: string)
    mock.advanceFrames(1)
    expect(f.tappedLook).toBe(true)
    denied = false
    mock.fireUnitEvent("UNIT_FACTION", wolf:token() :: string)
    mock.advanceFrames(1)
    expect(f.tappedLook).toBe(false)
end
