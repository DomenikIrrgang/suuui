-- Units/Nameplates turned off for this load (tests/profiles/nameplates-off.json):
-- the last session had it on, so the game's nameplate CVars still hold
-- SuuUI's values (full alpha and scale, the enemies' plates off by "Show
-- nameplates", the friendly NPCs' on), and the player's own values are
-- remembered for this character. The module is reloadToToggle, so its
-- OnDisable never ran; at this login, with it off, the registry gives the
-- player's values back (UF-5, X-11.b2).

import test, expect, config from "wowlua:test"
import SuuUI from "/Core/API"
import * as cvars from "/Core/CVars"
import expectNoErrors from "../../helpers"

config({ profile = "nameplates-off" })

@test("turned off last session: the player's own nameplate CVars back at login, nothing left remembered")
local function givenBack()
    expect(assert(SuuUI.GetModule("nameplates")):IsEnabled()).toBe(false)
    expect(C_CVar.GetCVar("nameplateMinAlpha")).toBe("0.6")
    expect(C_CVar.GetCVar("nameplateSelectedScale")).toBe("1.2")
    expect(C_CVar.GetCVar("nameplateShowEnemies")).toBe("1")
    expect(C_CVar.GetCVar("nameplateShowFriendlyNPCs")).toBe("0")
    expect(cvars.remembered("nameplates")).toBe(0)
    expectNoErrors()
end
