-- Units/Trainer: the trainer window's services, Train and Train all, the
-- rows and headings, the game's frame out of sight.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import expectNoErrors from "../../helpers"
import type ConfirmOptions from "/UI/Panel"
import type SuuButton from "/UI/Controls"
import internal M, Service, service, learnable, coins, pickAffordable, arrange, trainAllText, yourProfessions, npcTitle, isPetTrainer, canCategorize from "/Units/Trainer"
import * as frames from "wowlua:frames"

const T = SuuUI.Tokens
const PET = Enum.TrainerType.Pet

local function coin(token: keyof typeof(T.color), text: string): string
    return "|cff" .. T.color[token].hex .. text .. "|r"
end

-- the game's trainer frame
local function game(): Frame
    return assert(frames.find("ClassTrainerFrame"))
end

-- what a button's tooltip says
local function tipOf(b: SuuButton): string?
    local tip = b.tooltip
    if type(tip) == "table" then
        return tip.description
    end
    return nil
end

-- A class trainer with `services` (the engine's), opened through its gossip.
-- Each call teaches new spell IDs: a spell learned in one test stays known.
local nextSpell = 90000
-- A service as the engine's trainer has it.
type TrainerService = { spell: number, name: string, icon: number, level: number, rank: string, cost: number }

local function openTrainer(services: TrainerService[]?): mock.MockUnit
    local npc = mock.spawnUnit({ name = "Bob", level = 30, reaction = "friendly" })
    nextSpell = nextSpell + 10
    mock.defineTrainer(npc, {
        greeting = "hi",
        services = services or
            {
                { spell = nextSpell + 1, name = "Charge", icon = 132337, level = 1, rank = "Rank 1", cost = 100 },
                { spell = nextSpell + 2, name = "Thunder Clap", icon = 136105, level = 1, rank = "Rank 1", cost = 300 },
                { spell = nextSpell + 3, name = "Rend", icon = 132155, level = 4, rank = "Rank 1", cost = 50 },
            },
    })
    mock.defineGossip(npc, {
        text = "hello",
        options = { { name = "Train me", icon = 132058, gossipOptionID = 7, opens = "trainer" } },
    })
    npc:setDistance(3)
    mock.player:interact(npc)
    mock.advanceTime(1)
    C_GossipInfo.SelectOption(7)
    mock.advanceTime(1)
    return npc
end

-- A service as the window keeps it.
type ServiceOptions = {
    name?: string,
    kind?: string,
    texture?: number,
    sub?: string,
    category?: string,
    profession?: boolean,
}
local function svc(index: number, cost: number, opts: ServiceOptions?): Service
    local o: ServiceOptions = opts or {}
    return {
        index = index,
        name = o.name or ("S" .. index),
        kind = o.kind or "available",
        texture = o.texture,
        sub = o.sub or "",
        category = o.category,
        cost = cost,
        profession = o.profession == true,
    }
end

-- The game's service list, faked: each { name, kind, texture, level, rank, category, cost, profession, skill, line }.
-- (an ability it needs: its name, whether you have it)
type FakeService = {
    name: string,
    kind?: string,
    texture?: number,
    level?: number,
    rank?: string,
    category?: string,
    cost?: number,
    profession?: boolean,
    skill?: string,
    skillRank?: number,
    abilities?: { [number]: string | boolean }[],
    line?: string,
}
local function fakeServices(list: FakeService[])
    mock.fake("GetNumTrainerServices", function()
        return #list
    end)
    mock.fake("GetTrainerServiceInfo", function(i: number)
        local s = list[i]
        if not s then
            return nil
        end
        return s.name, s.kind, s.texture, s.level, s.rank, s.category
    end)
    mock.fake("GetTrainerServiceCost", function(i: number)
        return list[i].cost, list[i].profession
    end)
    mock.fake("GetTrainerServiceSkillReq", function(i: number)
        return list[i].skill, list[i].skillRank
    end)
    mock.fake("GetTrainerServiceNumAbilityReq", function(i: number): number
        local abilities = list[i].abilities
        return abilities and #abilities or 0
    end)
    mock.fake("GetTrainerServiceAbilityReq", function(i: number, k: number): (unknown, unknown)
        local need = assert(list[i].abilities)[k]
        return need[1], need[2]
    end)
    mock.fake("GetTrainerServiceSkillLine", function(i: number)
        return list[i] and list[i].line
    end)
end

local function petTrainer(total: number, used: number)
    mock.fake("C_Trainer.GetTrainerType", function()
        return PET
    end)
    mock.fake("C_PetInfo.GetPetTrainingPoints", function()
        return total, used
    end)
end

-- UI.Confirm's options, not shown.
local confirmed: ConfirmOptions?
local function stubConfirm()
    confirmed = nil
    mock.stub(SuuUI.UI, "Confirm", function(opts: ConfirmOptions)
        confirmed = opts
    end)
end

local function confirmOpts(): ConfirmOptions
    return (assert(confirmed, "UI.Confirm wasn't called"))
end

@beforeEach
local function reset()
    mock.player:setMoney(500)
    M:ResetChoice()
    M.collapsed = {}
end

@afterEach
local function close()
    if M.open then
        CloseTrainer()
    end
    M.open = false
    assert(M.window):Hide()
    mock.advanceTime(1)
end

--------------------------------------------------------------------------------
-- Pure parts
--------------------------------------------------------------------------------

@test("coins: each coin in its colour, copper alone when nothing")
local function coinsText()
    expect(coins(0)).toBe(coin("coin-copper", "0c"))
    expect(coins(5)).toBe(coin("coin-copper", "5c"))
    expect(coins(12005)).toBe(
        coin("coin-gold", "1g") .. " " .. coin("coin-silver", "20s") .. " " .. coin("coin-copper", "5c")
    )
    expect(coins(10000)).toBe(coin("coin-gold", "1g"))
    expect(coins(300)).toBe(coin("coin-silver", "3s"))
end

@test("pickAffordable: the cheapest first while the money lasts")
local function pick()
    local list = { svc(1, 300), svc(2, 100), svc(3, 250), svc(4, 50) }
    local out, total = pickAffordable(list, 420)
    expect(#out).toBe(3)
    expect(out[1].index).toBe(4)
    expect(out[2].index).toBe(2)
    expect(out[3].index).toBe(3)
    expect(total).toBe(400)
    local none, zero = pickAffordable({ svc(1, 10) }, 5)
    expect(#none).toBe(0)
    expect(zero).toBe(0)
end

@test("arrange: the step first, uncategorized, then categories by name; spellbook lines by name and icon")
local function arrangeServices()
    local s = {
        svc(1, 0, { name = "Charge" }),
        svc(2, 0, { category = "Zeta" }),
        svc(3, 0, { name = "Rend", texture = 99 }),
        svc(4, 0, { category = "Alpha" }),
        svc(5, 0, { name = "Next rank" }),
        svc(6, 0, { category = "Alpha" }),
    }
    local list, groups = arrange(s, 5, true, { Charge = "Arms" }, { [99] = "Fury" })
    expect(#list).toBe(1)
    expect(list[1].index).toBe(5)
    expect(#groups).toBe(4)
    expect(groups[1].name).toBe("Alpha")
    expect(#groups[1].rows).toBe(2)
    expect(groups[2].name).toBe("Arms")
    expect(groups[3].name).toBe("Fury")
    expect(groups[4].name).toBe("Zeta")
    expect(s[3].category).toBe("Fury")
    -- not categorized: one list, the step still first
    local flat, none = arrange({ svc(1, 0, { category = "A" }), svc(2, 0) }, 2, false, {}, {})
    expect(#none).toBe(0)
    expect(flat[1].index).toBe(2)
    expect(flat[2].index).toBe(1)
end

@test("trainAllText: six names and how many more; or why nothing")
local function trainAllTip()
    expect(trainAllText({})).toBe("Nothing you can learn and afford right now.")
    expect(trainAllText({ svc(1, 0, { name = "A" }), svc(2, 0, { name = "B" }) })).toBe("A, B")
    local many: Service[] = {}
    for i = 1, 8 do
        many[i] = svc(i, 0, { name = "N" .. i })
    end
    expect(trainAllText(many)).toBe("N1, N2, N3, N4, N5, N6 and 2 more")
end

@test("service: what a row says, from the game's answers")
local function serviceInfo()
    fakeServices({
        {
            name = "Strike",
            kind = "unavailable",
            texture = 1,
            level = 10,
            rank = "Rank 2",
            category = "",
            cost = 50,
            skill = "Swords",
            skillRank = 50,
            abilities = { { "Strike (Rank 1)", false }, { "Battle Stance", true } },
        },
        { name = "Known", kind = "used", level = 10, rank = "", cost = 0, skill = "Swords" },
        { name = "Plain", kind = nil, level = 1, category = "Arms" },
    })
    expect(service(9)).toBeNil()
    local a = assert(service(1))
    expect(a.sub).toBe("(Rank 2) · Requires level 10 · Requires Swords 50 · Requires Strike (Rank 1)")
    expect(a.category).toBeNil()
    expect(a.cost).toBe(50)
    local b = assert(service(2))
    expect(b.sub).toBe("")
    expect(b.kind).toBe("used")
    local c = assert(service(3))
    expect(c.kind).toBe("available")
    expect(c.category).toBe("Arms")
    expect(c.cost).toBe(0)
    -- a skill without a rank
    mock.fake("GetTrainerServiceSkillReq", function()
        return "Daggers", nil
    end)
    expect(assert(service(3)).sub).toBe("Requires Daggers ")
end

@test("service: a pet trainer compares the pet's level")
local function servicePet()
    fakeServices({ { name = "Bite", kind = "available", level = 10, cost = 5 } })
    petTrainer(10, 0)
    mock.fake("UnitLevel", function(unit: string)
        return unit == "pet" and 20 or 1
    end)
    expect(assert(service(1)).sub).toBe("")
    expect(isPetTrainer()).toBe(true)
    expect(canCategorize()).toBe(false)
end

@test("learnable: known, unavailable, money and training points")
local function learnableCases()
    expect(learnable(nil)).toBe(false)
    local ok, why = learnable(svc(1, 0, { kind = "used" }))
    expect(ok).toBe(false)
    expect(why).toBe("You know this.")
    ok, why = learnable(svc(1, 0, { kind = "unavailable", sub = "Requires level 10" }))
    expect(why).toBe("Requires level 10")
    ok, why = learnable(svc(1, 0, { kind = "unavailable" }))
    expect(why).toBe("You can't learn this yet.")
    ok, why = learnable(svc(1, 600))
    expect(why).toBe("You can't afford it.")
    ok, why = learnable(svc(1, 500))
    expect(ok).toBe(true)
    expect(why).toBeNil()
    petTrainer(10, 6)
    ok, why = learnable(svc(1, 5))
    expect(why).toBe("Your pet doesn't have the training points.")
    expect((learnable(svc(1, 4)))).toBe(true)
    mock.fake("C_PetInfo.GetPetTrainingPoints", function()
        return nil
    end)
    expect((learnable(svc(1, 1)))).toBe(false)
end

@test("yourProfessions: the names of your professions")
local function professionsYouHave()
    mock.fake("GetProfessions", function()
        return 3, nil, 7
    end)
    mock.fake("GetProfessionInfo", function(i: number)
        return i == 3 and "Mining" or nil
    end)
    local mine = yourProfessions()
    expect(mine).toEqual({ Mining = true })
end

@test("npcTitle: the tooltip's second line, not a level line nor a secret")
local function title()
    local line2: unknown = "Warrior Trainer"
    mock.fake("C_TooltipInfo.GetUnit", function()
        return { lines = { { leftText = "Bob" }, { leftText = line2 } } }
    end)
    expect(npcTitle()).toBe("Warrior Trainer")
    line2 = "Level 30"
    expect(npcTitle()).toBeNil()
    line2 = mock.secret("Secret")
    expect(npcTitle()).toBeNil()
    mock.fake("C_TooltipInfo.GetUnit", function()
        return nil
    end)
    expect(npcTitle()).toBeNil()
end

--------------------------------------------------------------------------------
-- Train and Train all
--------------------------------------------------------------------------------

@test("Train: nothing chosen or not learnable does nothing; else buys")
local function train()
    fakeServices({ { name = "A", kind = "available", cost = 100 }, { name = "B", kind = "used", cost = 0 } })
    local buy = mock.fake("BuyTrainerService", function() end)
    M:Train()
    M:Choose(2)
    M:Train()
    expect(buy).never.toHaveBeenCalled()
    M:Choose(1)
    M:Train()
    expect(buy).toHaveBeenCalledWith(1)
end

@test("Train: a profession at a profession trainer asks first")
local function trainProfession()
    fakeServices({
        { name = "Apprentice Mining", kind = "available", cost = 10, profession = true, line = "Mining" },
        { name = "Journeyman", kind = "available", cost = 10, profession = true },
    })
    mock.fake("IsTradeskillTrainer", function()
        return true
    end)
    local buy = mock.fake("BuyTrainerService", function() end)
    stubConfirm()
    M:Choose(1)
    M:Train()
    expect(buy).never.toHaveBeenCalled()
    local opts = confirmOpts()
    expect(opts.title).toBe("Learn Mining?")
    expect(opts.text).toBe("You'll have Mining as a profession.")
    assert(opts.onConfirm)()
    expect(buy).toHaveBeenCalledWith(1)
    -- no skill line: the service's name
    M:Choose(2)
    M:Train()
    expect(confirmOpts().title).toBe("Learn Journeyman?")
end

@test("TrainAllList: available and affordable, your professions only, cheapest first")
local function trainAllList()
    mock.player:setMoney(1000)
    fakeServices({
        { name = "A", kind = "available", cost = 400 },
        { name = "B", kind = "unavailable", cost = 1 },
        { name = "C", kind = "available", cost = 100 },
        { name = "Mining rank", kind = "available", cost = 50, profession = true, line = "Mining" },
        { name = "Herbalism", kind = "available", cost = 50, profession = true, line = "Herbalism" },
        { name = "D", kind = "available", cost = 600 },
        { name = "E", kind = "available", cost = 2000 },
    })
    mock.fake("GetProfessions", function()
        return 1
    end)
    mock.fake("GetProfessionInfo", function()
        return "Mining"
    end)
    local list, total = M:TrainAllList()
    local names: string[] = {}
    for i, e in ipairs(list) do
        names[i] = e.name
    end
    expect(names).toEqual({ "Mining rank", "C", "A" })
    expect(total).toBe(550)
end

@test("TrainAllList: a pet trainer pays in training points")
local function trainAllPet()
    fakeServices({ { name = "Bite", kind = "available", cost = 3 }, { name = "Claw", kind = "available", cost = 4 } })
    petTrainer(10, 4)
    local list, total = M:TrainAllList()
    expect(#list).toBe(1)
    expect(total).toBe(3)
    mock.fake("C_PetInfo.GetPetTrainingPoints", function()
        return nil
    end)
    expect(#M:TrainAllList()).toBe(0)
end

@test("TrainAll: one at a time while the window is open, the list looked up again")
local function trainAll()
    openTrainer()
    local bought = 0
    local buy = mock.fake("BuyTrainerService", function()
        bought = bought + 1
    end)
    mock.stub(M, "TrainAllList", function()
        if bought >= 2 then
            return {}, 0
        end
        return { svc(bought + 1, 1) }, 1
    end)
    M:TrainAll()
    expect(buy).toHaveBeenCalledTimes(1)
    mock.advanceTime(0.4)
    expect(buy).toHaveBeenCalledTimes(2)
    mock.advanceTime(1)
    expect(buy).toHaveBeenCalledTimes(2)
    -- the window shut: nothing
    assert(M.window):Hide()
    bought = 0
    M:TrainAll()
    expect(buy).toHaveBeenCalledTimes(2)
end

@test("TrainAll: stops after 60 steps")
local function trainAllCap()
    openTrainer()
    local buy = mock.fake("BuyTrainerService", function() end)
    mock.stub(M, "TrainAllList", function()
        return { svc(1, 1) }, 1
    end)
    M:TrainAll()
    mock.advanceTime(30)
    expect(buy).toHaveBeenCalledTimes(60)
end

@test("TrainAll: buys through the real trainer")
local function trainAllWorld()
    -- (the server answers each purchase within the 0.35 s step)
    mock.setLatency(0.1)
    openTrainer()
    M:TrainAll()
    mock.advanceTime(2)
    -- Charge and Thunder Clap (Rend needs level 4): 400 of 500
    expect(GetMoney()).toBe(100)
    mock.setLatency(0.4)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

@test("TRAINER_SHOW opens the window with the services; TRAINER_CLOSED closes it")
local function opens()
    openTrainer()
    expect(M.open).toBe(true)
    expect(M.window).toBeShown()
    expect(assert(M.window).title).toHaveText("Bob")
    expect(M.rows[1]).toBeShown()
    expect(M.rows[1].name).toHaveText("Charge")
    expect(M.rows[3].name).toHaveText("Rend")
    expect(M.rows[3].sub).toHaveText("(Rank 1) · Requires level 4")
    expect(M.empty).never.toBeShown()
    -- the game's frame out of sight
    local f = game()
    expect(f:GetAlpha()).toBe(0)
    CloseTrainer()
    mock.advanceTime(0.5)
    expect(M.open).toBe(false)
    expect(M.window).never.toBeShown()
    expectNoErrors()
end

@test("the window's close asks the game to close the trainer")
local function closeAsks()
    openTrainer()
    local close = mock.fake("CloseTrainer", function() end)
    assert(M.window):Hide()
    expect(close).toHaveBeenCalled()
end

@test("Refresh: nothing while closed")
local function refreshClosed()
    M.open = false
    local n = mock.fake("GetNumTrainerServices", function()
        return 0
    end)
    M:Refresh()
    expect(n).never.toHaveBeenCalled()
end

@test("rows: click chooses, double click trains, hover shows the service")
local function rows()
    openTrainer()
    local row = M.rows[1]
    mock.click(row)
    expect(M.selected).toBe(1)
    expect(row.sel).toBeShown()
    expect(assert(M.train):IsEnabled()).toBe(true)
    expect(assert(M.train).tooltip).toBeNil()
    mock.hover(row)
    expect(row.hover).toBeShown()
    expect(GameTooltip:IsShown()).toBe(true)
    mock.hover(nil)
    expect(row.hover).never.toBeShown()
    local buy = mock.fake("BuyTrainerService", function() end)
    mock.script(M.rows[2], "OnDoubleClick")
    expect(M.selected).toBe(2)
    expect(buy).toHaveBeenCalledWith(2)
end

@test("Train's state: nothing chosen, can't afford")
local function trainState()
    openTrainer()
    expect(assert(M.train):IsEnabled()).toBe(false)
    expect(tipOf(assert(M.train))).toBe("Choose what to learn.")
    mock.player:setMoney(50)
    M:Choose(1)
    M:Refresh()
    expect(tipOf(assert(M.train))).toBe("You can't afford it.")
    -- the price in ember when short
    expect(M.rows[1].money).toBeShown()
    expect(assert(M.trainAll):IsEnabled()).toBe(false)
    expect(tipOf(assert(M.trainAll))).toBe("Nothing you can learn and afford right now.")
end

@test("Train all button: asks with the count and the cost, then trains")
local function trainAllButton()
    openTrainer()
    stubConfirm()
    mock.click(M.trainAll)
    local opts = confirmOpts()
    expect(opts.text).toBe("Learn 2 skills for " .. coins(400) .. ".")
    local trainAllSpy = mock.stub(M, "TrainAll", function() end)
    assert(opts.onConfirm)()
    expect(trainAllSpy).toHaveBeenCalled()
    -- one skill, a pet's points
    confirmed = nil
    fakeServices({ { name = "Bite", kind = "available", cost = 3 } })
    petTrainer(10, 0)
    mock.click(M.trainAll)
    expect(confirmOpts().text).toBe("Learn 1 skill for 3 training points.")
    -- nothing to learn: no question
    confirmed = nil
    fakeServices({})
    mock.script(M.trainAll, "OnClick")
    expect(confirmed).toBeNil()
end

@test("Train button trains the chosen one")
local function trainButton()
    openTrainer()
    local buy = mock.fake("BuyTrainerService", function() end)
    mock.click(M.rows[2])
    mock.click(M.train)
    expect(buy).toHaveBeenCalledWith(2)
end

@test("categories: headings fold and unfold; spellbook lines from SuuUI's data")
local function categories()
    mock.stub(SuuUI, "TrainerSpells", function()
        return {
            { name = "Charge", school = "Arms", icon = 132337 },
            { name = "Other", school = "Fury", icon = 136105 },
            { name = "Nameless" },
        }
    end)
    mock.fake("C_Trainer.GetCategorizeTrainerUI", function()
        return true
    end)
    openTrainer()
    -- Charge by name, Thunder Clap by icon; Rend uncategorized first
    expect(M.rows[1].name).toHaveText("Rend")
    local h1, h2 = M.heads[1], M.heads[2]
    expect(h1.name).toHaveText("Arms")
    expect(h1.count).toHaveText("1")
    expect(h2.name).toHaveText("Fury")
    expect(M.categorize).toBeShown()
    expect(assert(M.categorize).value).toBe(true)
    mock.click(h1)
    expect(M.collapsed.Arms).toBe(true)
    expect(M.heads[2].name).toHaveText("Fury")
    expect(M.rows[3]).never.toBeShown()
    mock.click(h1)
    expect(M.collapsed.Arms).toBeNil()
    expect(M.rows[3]).toBeShown()
    mock.hover(h1)
    mock.hover(nil)
    -- fewer headings later: the rest hidden
    mock.fake("C_Trainer.GetCategorizeTrainerUI", function()
        return false
    end)
    M:Refresh()
    expect(h1).never.toBeShown()
    expectNoErrors()
end

@test("Categorize toggles the game's setting")
local function categorizeToggle()
    openTrainer()
    local set = mock.fake("C_Trainer.SetCategorizeTrainerUI", function() end)
    assert(M.categorize):SetValue(false)
    mock.click(M.categorize)
    expect(set).toHaveBeenCalledWith(true)
    mock.click(M.categorize)
    expect(set).toHaveBeenCalledWith(false)
end

@test("Filters: shown from the game's, and set back to it")
local function filters()
    openTrainer()
    expect(assert(M.filters):GetValue().show).toEqual({ "available", "unavailable", "used" })
    local set = mock.fake("SetTrainerServiceTypeFilter", function() end)
    assert(M.filters):SetValue({ show = { "available" } })
    assert(M.filters):Changed()
    expect(set).toHaveBeenCalledWith("available", true)
    expect(set).toHaveBeenCalledWith("unavailable", false)
    expect(set).toHaveBeenCalledWith("used", false)
    mock.fake("GetTrainerServiceTypeFilter", function(kind: string)
        return kind == "used"
    end)
    M:Refresh()
    expect(assert(M.filters):GetValue().show).toEqual({ "used" })
end

@test("nothing to show: the empty line")
local function emptyList()
    openTrainer()
    fakeServices({})
    M:Refresh()
    expect(M.empty).toBeShown()
    expect(M.empty).toHaveText("Nothing to show with these filters.")
    expect(M.rows[1]).never.toBeShown()
end

@test("a profession trainer: the rank row, the next rank first")
local function professionRank()
    openTrainer()
    mock.fake("GetTrainerTradeskillRankValues", function()
        return 60, 150
    end)
    mock.fake("GetTrainerServiceStepIndex", function()
        return 2
    end)
    mock.fake("GetTrainerServiceSkillLine", function(i: number)
        return i == 2 and "Mining" or nil
    end)
    mock.fake("IsTradeskillTrainer", function()
        return true
    end)
    M:Refresh()
    expect(M.rank).toBeShown()
    expect(assert(M.rank).label).toHaveText("Mining")
    expect(assert(M.rank).n).toHaveText("60 / 150")
    expect(M.rows[1].name).toHaveText("Thunder Clap")
    -- no step: the first service's line, else "Rank"
    mock.fake("GetTrainerServiceStepIndex", function()
        return nil
    end)
    M:Refresh()
    expect(assert(M.rank).label).toHaveText("Rank")
    mock.fake("GetTrainerTradeskillRankValues", function()
        return 0, 0
    end)
    M:Refresh()
    expect(M.rank).never.toBeShown()
end

@test("a pet trainer: training points, no Categorize, rows in TP")
local function petWindow()
    openTrainer()
    petTrainer(12, 2)
    fakeServices({ { name = "Bite", kind = "available", cost = 3 }, { name = "Growl", kind = "used", cost = 0 } })
    M:Refresh()
    expect(M.points).toBeShown()
    expect(M.points).toHaveText("Training points: 10")
    expect(M.categorize).never.toBeShown()
    expect(M.rows[1].tp).toBeShown()
    expect(M.rows[1].tp).toHaveText("3 TP")
    expect(M.rows[1].money).never.toBeShown()
    expect(M.rows[2].tp).never.toBeShown()
    expect(M.rows[2]:GetAlpha()).toBeCloseTo(T.opacity["opacity-disabled"])
    mock.fake("C_PetInfo.GetPetTrainingPoints", function()
        return nil
    end)
    M:Refresh()
    expect(M.points).toHaveText("Training points: 0")
end

@test("Beast Training: Train is the secure click on the game's Train once it has the choice; no Train all")
local function petTrain()
    -- (the game refuses BuyTrainerService from SuuUI's code there: reported in game)
    openTrainer()
    petTrainer(10, 0)
    fakeServices({ { name = "Bite", kind = "available", cost = 3 }, { name = "Dash", kind = "available", cost = 5 } })
    local buy = mock.fake("BuyTrainerService", function() end)
    local told: number[] = {}
    local gameChoice: number? = nil
    mock.fake("SelectTrainerService", function(i: number)
        told[#told + 1] = i
    end)
    mock.fake("GetTrainerSelectionIndex", function(): number?
        return gameChoice
    end)
    local frame = assert(frames.find("ClassTrainerFrame")) :: Frame
        & { selectedService?: number, displayIndexToSkillIndex?: {} }
    frame.displayIndexToSkillIndex = nil
    -- chosen in SuuUI's list: the game told; Train waits for it to take it up
    M:Choose(2)
    M:Refresh()
    expect(told[#told]).toBe(2)
    local over = M.trainOver
    expect(over == nil or not over.button:IsShown()).toBe(true)
    expect(M.trainAll).never.toBeShown()
    -- the game has it (its frame's own choice too): the secure click on its Train
    gameChoice = 2
    frame.selectedService = 2
    M:Refresh()
    local b = assert(M.trainOver).button
    expect(b).toBeShown()
    expect(b:GetAttribute("type1")).toBe("click")
    expect(b:GetAttribute("clickbutton1")).toBe(frames.find("ClassTrainerTrainButton"))
    -- SuuUI's own buy never (a double click, Enter, Train all)
    M:Train()
    M:TrainAll()
    expect(buy).never.toHaveBeenCalled()
    -- an NPC trainer again: Train all back, no secure click
    mock.fake("C_Trainer.GetTrainerType", function()
        return Enum.TrainerType.Class or 0
    end)
    M:Refresh()
    expect(M.trainAll).toBeShown()
    expect(b).never.toBeShown()
    frame.selectedService = nil
end

-- A Beast Training list for the game's own frame too: `list` (faked), the
-- game's selection kept as the game keeps it (SelectTrainerService tells
-- its frame, TRAINER_DESCRIPTION_UPDATE at once), BuyTrainerService teaching
-- the service (it leaves the list, as the game's Used filter hides it, so
-- the ones after it move up; TRAINER_UPDATE), as the game's Train button
-- does it: nothing while that button is disabled (the game's Click on a
-- disabled button does nothing; the engine's runs it, so the fake checks).
-- What was bought, by name, in order.
local function beastTraining(list: FakeService[], points: number): string[]
    petTrainer(points, 0)
    fakeServices(list)
    local gameChoice: number? = nil
    mock.fake("SelectTrainerService", function(i: number)
        local was = gameChoice
        gameChoice = (i >= 1 and i <= #list) and i or nil
        -- (only a change: the game's own handler selects again)
        if gameChoice ~= was then
            mock.fireEvent("TRAINER_DESCRIPTION_UPDATE")
        end
    end)
    mock.fake("GetTrainerSelectionIndex", function(): number?
        return gameChoice
    end)
    local bought: string[] = {}
    local gameTrain = assert(frames.find("ClassTrainerTrainButton")) :: Button
    mock.fake("BuyTrainerService", function(i: number)
        local s = list[i]
        if not (gameTrain:IsEnabled() and s and s.kind == "available") then
            return
        end
        bought[#bought + 1] = s.name
        table.remove(list, i)
        mock.fireEvent("TRAINER_UPDATE")
    end)
    -- the game's frame lists them too
    mock.fireEvent("TRAINER_UPDATE")
    mock.advanceTime(0.1)
    return bought
end

-- Fifteen of a pet's abilities, more than the game's own list shows at once.
local function petAbilities(): FakeService[]
    local list: FakeService[] = {}
    for i = 1, 15 do
        list[i] = { name = "Ability " .. i, kind = "available", rank = "Rank 1", cost = 1, texture = 132140 }
    end
    return list
end

-- A row of SuuUI's list by its service's name.
local function rowOf(name: string)
    for _, r in ipairs(M.rows) do
        if r:IsShown() and r.name:GetText() == name then
            return r
        end
    end
    error("no row " .. name)
end

-- Train at a pet trainer: chooses `name` in SuuUI's list, then clicks Train
-- (the secure click on the game's Train while it has the choice).
local function petTrainClick(name: string)
    mock.click(rowOf(name))
    mock.advanceTime(0.1)
    local over = M.trainOver
    if over and over.button:IsShown() then
        mock.click(over.button)
    else
        mock.click(M.train)
    end
    mock.advanceTime(0.1)
end

@test("Beast Training: Train trains every time, wherever the choice sits in the list")
local function petTrainTwice()
    -- (reported: half the time Train did nothing until a reload. The game
    -- enables its Train only from its own list's row of the choice, which
    -- exists only while scrolled into sight)
    openTrainer()
    local list = petAbilities()
    -- (one the pet can't pay for: the game's own row of it turns its Train off)
    list[2].cost = 99
    local bought = beastTraining(list, 30)
    -- the first, then one far down (out of the game's own list's sight)
    -- after looking at the one it can't pay for, then one the list moved up
    petTrainClick("Ability 1")
    expect(bought).toEqual({ "Ability 1" })
    mock.click(rowOf("Ability 2"))
    mock.advanceTime(0.1)
    expect(assert(M.train):IsEnabled()).toBe(false)
    petTrainClick("Ability 14")
    expect(bought).toEqual({ "Ability 1", "Ability 14" })
    petTrainClick("Ability 3")
    expect(bought).toEqual({ "Ability 1", "Ability 14", "Ability 3" })
    -- the trained one gone from the list: nothing chosen, not the next one
    expect(M.selected).toBeNil()
    expect(tipOf(assert(M.train))).toBe("Choose what to learn.")
    -- closed and opened again: nothing chosen, Train still trains
    CloseTrainer()
    mock.advanceTime(0.5)
    openTrainer()
    expect(M.selected).toBeNil()
    bought = beastTraining(petAbilities(), 30)
    petTrainClick("Ability 12")
    expect(bought).toEqual({ "Ability 12" })
    -- a class trainer, then Beast Training again
    CloseTrainer()
    mock.advanceTime(0.5)
    mock.fake("C_Trainer.GetTrainerType", function()
        return Enum.TrainerType.Class or 0
    end)
    openTrainer()
    expect(M.trainAll).toBeShown()
    expect(M.trainOver == nil or not assert(M.trainOver).button:IsShown()).toBe(true)
    CloseTrainer()
    mock.advanceTime(0.5)
    openTrainer()
    bought = beastTraining(petAbilities(), 30)
    petTrainClick("Ability 15")
    petTrainClick("Ability 2")
    petTrainClick("Ability 9")
    expect(bought).toEqual({ "Ability 15", "Ability 2", "Ability 9" })
    expectNoErrors()
end

@test("Beast Training: the game's selection already the choice but its frame lost it: told again")
local function petTellAgain()
    openTrainer()
    beastTraining(petAbilities(), 30)
    local told: number[] = {}
    hooksecurefunc("SelectTrainerService", function(i: number)
        told[#told + 1] = i
    end)
    mock.click(rowOf("Ability 4"))
    mock.advanceTime(0.1)
    expect(M:GameHasChoice()).toBe(true)
    -- the game's frame forgets it (its list rebuilt), its selection stays
    local frame = game() :: Frame & { selectedService?: number }
    frame.selectedService = nil
    told = {}
    mock.fireEvent("TRAINER_UPDATE")
    mock.advanceTime(0.1)
    -- past the end, then the choice: a change the game's frame takes up
    -- (the game's own handler selects too)
    expect(told[1]).toBe(16)
    expect(told[#told]).toBe(4)
    expect(M:GameHasChoice()).toBe(true)
    expect(assert(M.trainOver).button).toBeShown()
    -- told once until the list changes again (no loop)
    told = {}
    M:Refresh()
    M:Refresh()
    expect(#told).toBe(0)
    expectNoErrors()
end

@test("Beast Training: what the pet knows is Used: hidden with Used off, dimmed with it on")
local function petKnown()
    -- (reported: the spells already taught to the pet in the list. The game
    -- lists them learnable with no cost)
    openTrainer()
    local wolf = mock.spawnUnit({ name = "Wolf", level = 40, reaction = "friendly" })
    mock.setPet(wolf, {
        hunter = true,
        spells = {
            { spell = 91001, name = "Growl", subName = "Rank 4" },
            { spell = 91002, name = "Fire Resistance", subName = "Passive", passive = true },
            { spell = 91003, name = "Great Stamina", subName = "Rank 5", passive = true },
        },
    })
    mock.advanceFrames(1)
    local list: FakeService[] = {
        { name = "Fire Resistance", kind = "available", rank = "Rank 2", cost = 0 },
        { name = "Great Stamina", kind = "available", rank = "Rank 5", cost = 0 },
        { name = "Growl", kind = "available", rank = "Rank 4", cost = 0 },
        { name = "Bite", kind = "available", rank = "Rank 5", cost = 13 },
        { name = "Great Stamina", kind = "available", rank = "Rank 6", cost = 25 },
        { name = "Growl", kind = "available", rank = "Rank 3", cost = 0 },
    }
    -- the services' spells (Fire Resistance's the pet's)
    local spells = { 91002, 92002, 92003, 92004, 92005, 92006 }
    mock.fake("C_TooltipInfo.GetTrainerService", function(i: number)
        return { id = spells[i], lines = {} }
    end)
    local used = false
    mock.fake("GetTrainerServiceTypeFilter", function(kind: string)
        return kind ~= "used" or used
    end)
    beastTraining(list, 30)
    M:Refresh()
    -- Used off (the default): Bite and Great Stamina's next rank only
    expect(M.rows[1].name).toHaveText("Bite")
    expect(M.rows[2].name).toHaveText("Great Stamina")
    expect(M.rows[2].sub).toHaveText("(Rank 6)")
    expect(M.rows[3]).never.toBeShown()
    local fire, bite = assert(service(1)), assert(service(4))
    expect(fire.kind).toBe("used")
    expect(fire.petKnows).toBe(true)
    expect(bite.kind).toBe("available")
    expect(bite.petKnows).toBeNil()
    -- Used on: listed, dimmed, Train off for them
    used = true
    M:Refresh()
    expect(M.rows[6]).toBeShown()
    expect(M.rows[1].name).toHaveText("Fire Resistance")
    expect(M.rows[1]:GetAlpha()).toBeCloseTo(T.opacity["opacity-disabled"])
    expect(M.rows[4]:GetAlpha()).toBe(1)
    mock.click(M.rows[3])
    expect(assert(M.train):IsEnabled()).toBe(false)
    expect(tipOf(assert(M.train))).toBe("Your pet knows this.")
    -- a known one chosen, then Used off: the choice goes with it
    used = false
    M:Refresh()
    expect(M.selected).toBeNil()
    mock.setPet(nil)
    wolf:despawn()
    expectNoErrors()
end

@test("the choice follows its service when the list moves; gone, nothing is chosen")
local function choiceFollows()
    openTrainer()
    local list: FakeService[] = {
        { name = "Charge", kind = "available", rank = "Rank 1", cost = 10 },
        { name = "Rend", kind = "available", rank = "Rank 1", cost = 10 },
        { name = "Rend", kind = "available", rank = "Rank 2", cost = 10 },
    }
    fakeServices(list)
    M:Refresh()
    mock.click(M.rows[3])
    expect(M.selected).toBe(3)
    -- Charge learned and gone: Rend 2 is the second now
    table.remove(list, 1)
    M:Refresh()
    expect(M.selected).toBe(2)
    expect(M.rows[2].sel).toBeShown()
    expect(M.rows[1].sel).never.toBeShown()
    local buy = mock.fake("BuyTrainerService", function() end)
    M:Train()
    expect(buy).toHaveBeenCalledWith(2)
    -- moved without a refresh: Train finds it where it is at the click
    table.insert(list, 1, { name = "Battle Shout", kind = "available", rank = "Rank 1", cost = 10 })
    M:Train()
    expect(buy).toHaveBeenCalledWith(3)
    -- gone: nothing chosen, nothing bought
    table.remove(list, 3)
    M:Train()
    expect(buy).toHaveBeenCalledTimes(2)
    expect(M.selected).toBeNil()
end

@test("a secret NPC name: the window says Trainer")
local function secretName()
    openTrainer()
    local secret = true
    mock.fake("UnitName", function()
        return secret and mock.secret("Bob") or "Bob"
    end)
    M:Refresh()
    secret = false
    expect(assert(M.window).title).toHaveText("Trainer")
end

@test("QueueRefresh: once per moment")
local function queue()
    openTrainer()
    local refresh = mock.stub(M, "Refresh", function() end)
    M:QueueRefresh()
    M:QueueRefresh()
    mock.advanceTime(0.1)
    expect(refresh).toHaveBeenCalledTimes(1)
    mock.fireEvent("TRAINER_UPDATE")
    mock.advanceTime(0.1)
    expect(refresh).toHaveBeenCalledTimes(2)
end

@test("Away: the game's frame stays out of sight when placed again; once only")
local function away()
    openTrainer()
    local f = game()
    f:SetAlpha(1)
    f:SetPoint("CENTER")
    mock.advanceTime(0.1)
    expect(f:GetAlpha()).toBe(0)
    local point, rel = f:GetPoint(1)
    expect(point).toBe("TOPLEFT")
    expect(rel).toBe(UIParent)
    -- shown again
    f:Hide()
    f:SetAlpha(1)
    f:Show()
    mock.advanceTime(0.1)
    expect(f:GetAlpha()).toBe(0)
    -- a second Away and a missing frame do nothing
    M:Away(f)
    M:Away(nil)
end

@test("Away: nothing while the module is off")
local function awayOff()
    openTrainer()
    local f = game()
    mock.stub(M, "IsEnabled", function()
        return false
    end)
    f:SetAlpha(1)
    f:SetPoint("CENTER")
    mock.advanceTime(0.1)
    expect(f:GetAlpha()).toBe(1)
    f:SetAlpha(0)
end

@test("/suu trainall explains each service")
local function explain()
    openTrainer()
    mock.fake("GetProfessions", function()
        return 1
    end)
    mock.fake("GetProfessionInfo", function()
        return "Mining"
    end)
    mock.slash("/suu trainall")
    local printed = table.concat(mock.printed(), "\n")
    expect(printed).toContain("3 services; your professions: Mining; money 500")
    expect(printed).toContain("1 Charge: kind=available cost=100 profession=false line=nil learnable=true")
    expect(printed).toContain("3 Rend: kind=unavailable")
    expect(printed).toContain("Train all would learn 2 for 400.")
end

@test("ExplainTrainAll: a missing service is skipped")
local function explainGap()
    fakeServices({ { name = "A", kind = "available", cost = 1 } })
    mock.fake("GetNumTrainerServices", function()
        return 2
    end)
    M:ExplainTrainAll()
    local printed = table.concat(mock.printed(), "\n")
    expect(printed).toContain("2 services")
    expect(printed).never.toContain("2 nil")
end

@test("OnDisable hides the window")
local function disable()
    openTrainer()
    assert(M.OnDisable)(M)
    expect(M.window).never.toBeShown()
end
