-- Units/Windows for a player who had chosen the game's fullscreen map
-- (tests/profiles/windows-fullscreen-map.json: miniWorldMap 0). The module
-- sets the small map (SuuUI's enlarged map stands in for the fullscreen one)
-- through its own CVar memory: the player's 0 is remembered for this
-- character and given back once the module is off (GRP-7, X-11.b2).

import test, expect, config from "wowlua:test"
import * as mock from "wowlua:mock"
import field from "wowlua:table"
import * as cvars from "/Core/CVars"
import * as settings from "/Core/Settings"
import internal M from "/Units/Windows"
import expectNoErrors from "../../helpers"

config({ profile = "windows-fullscreen-map" })

@test("the game's fullscreen map chosen before: the small map set, enlarged instead; the player's value remembered and given back")
local function fullscreenRemembered()
    -- (the map skinned as it opens, if not already)
    ShowUIPanel(WorldMapFrame)
    mock.advanceFrames(3)
    expect(C_CVar.GetCVar("miniWorldMap")).toBe("1")
    expect(M:Get("mapEnlarged")).toBe(true)
    expect(cvars.remembered("windows")).toBe(1)
    expect(field(settings.peekCharData("core"), "cvars", "windows", "miniWorldMap")).toBe("0")
    HideUIPanel(WorldMapFrame)
    mock.advanceFrames(1)
    -- what the release does when the module is off (at the next login)
    M:RestoreCVar("miniWorldMap")
    expect(C_CVar.GetCVar("miniWorldMap")).toBe("0")
    expect(cvars.remembered("windows")).toBe(0)
    expectNoErrors()
end
