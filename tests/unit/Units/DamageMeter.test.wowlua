-- Units/DamageMeter: Blizzard's meter off while SuuUI's runs (and back
-- after); up to three windows stacked, each with its own type and fight
-- (kept, a past fight not), one closed (the others move down); when it
-- shows (always, in a group, in combat, hidden); read every second in
-- combat, shortly after the meter's events out of it, twice after a fight;
-- the options live; the preview's made-up fight; the settings rows;
-- stopped.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, SECTION from "/Units/DamageMeter"
import type MeterViewChange, RecapEvent from "/UI/DamageMeter"
import * as modules from "/Core/Modules"
import * as settings from "/Core/Settings"
import * as cvars from "/Core/CVars"
import migrations as settingMigrations from "/Core/Settings"
import expectNoErrors, cycle, NOTHING from "../../helpers"

const CVAR = "damageMeterEnabled"

@afterEach
local function cleanup()
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    mock.group:leave()
    M:ResetAll({
        "shows",
        "numbers",
        "rows",
        "barColor",
        "marker",
        "nameColor",
        "pinYou",
        "windowCount",
        "views",
        "position",
    })
    mock.advanceTime(2)
    expectNoErrors()
end

-- Counts the windows' refreshes.
local function countRefreshes(): { n: number }
    local count = { n = 0 }
    local real = M.Refresh
    mock.stub(M, "Refresh", function(self: typeof(M))
        count.n = count.n + 1
        real(self)
    end)
    return count
end

@test("Blizzard's meter off while SuuUI's runs, what it was kept per character (not in the profile)")
local function blizzardOff()
    expect(C_CVar.GetCVar(CVAR)).toBe("0")
    expect(cvars.remembered("damagemeter")).toBe(1)
    expect(cvars.rememberedValue("damagemeter", CVAR) ~= "0").toBe(true)
end

@test("a profile switch that turns the meter off gives Blizzard's setting back; back again, off again")
local function profileSwitch()
    -- the player's own: Blizzard's meter on
    settings.set("damagemeter", "enabled", false)
    C_CVar.SetCVar(CVAR, "1")
    settings.set("damagemeter", "enabled", true)
    local was = cvars.rememberedValue("damagemeter", CVAR)
    expect(was).toBe("1")
    local before = settings.profiles.current()
    settings.profiles.create("ZZ Meter Off")
    settings.profiles.use("ZZ Meter Off")
    settings.set("damagemeter", "enabled", false)
    expect(M.state).toBe(modules.ModuleState.Disabled)
    expect(C_CVar.GetCVar(CVAR)).toBe(was)
    settings.profiles.use(before)
    expect(M.state).toBe(modules.ModuleState.Enabled)
    expect(C_CVar.GetCVar(CVAR)).toBe("0")
    expect(cvars.rememberedValue("damagemeter", CVAR)).toBe(was)
    settings.profiles.delete("ZZ Meter Off")
end

@test("migration: the value an older SuuUI kept in the profile moves to this character's data once")
local function migration()
    local found = false
    for _, m in ipairs(settingMigrations()) do
        if m.namespace == "damagemeter" and m.id == "blizzardWas-cvar" then
            found = true
            local data = M:CharData()
            data.blizzardWas = nil
            -- nothing kept (""): the key goes, nothing moves
            local empty: { [string]: unknown } = { blizzardWas = "", rows = 5 }
            m.fn(empty)
            expect(empty).toEqual({ rows = 5 })
            expect(data.blizzardWas).toBeNil()
            -- a value: moved; a second profile's doesn't replace it
            local one: { [string]: unknown } = { blizzardWas = "1" }
            m.fn(one)
            expect(one.blizzardWas).toBeNil()
            expect(data.blizzardWas).toBe("1")
            local two: { [string]: unknown } = { blizzardWas = "0" }
            m.fn(two)
            expect(data.blizzardWas).toBe("1")
            -- again, or without the key: nothing changes
            m.fn(one)
            m.fn({})
            expect(data.blizzardWas).toBe("1")
            data.blizzardWas = nil
        end
    end
    expect(found).toBe(true)
end

@test("a value moved by the migration is handed to the CVar memory at the next enable, then given back on off")
local function legacyHandover()
    -- as after an update: an older SuuUI turned the meter off ("0") and
    -- kept the player's "1" in the profile; the memory holds nothing
    settings.set("damagemeter", "enabled", false)
    C_CVar.SetCVar(CVAR, "0")
    M:CharData().blizzardWas = "1"
    settings.set("damagemeter", "enabled", true)
    expect(C_CVar.GetCVar(CVAR)).toBe("0")
    expect(cvars.rememberedValue("damagemeter", CVAR)).toBe("1")
    expect(M:CharData().blizzardWas).toBeNil()
    settings.set("damagemeter", "enabled", false)
    expect(C_CVar.GetCVar(CVAR)).toBe("1")
    settings.set("damagemeter", "enabled", true)
    expect(C_CVar.GetCVar(CVAR)).toBe("0")
end

@test("in combat the hand-over waits for its end")
local function legacyInCombat()
    settings.set("damagemeter", "enabled", false)
    C_CVar.SetCVar(CVAR, "0")
    M:CharData().blizzardWas = "1"
    mock.player:enterCombat()
    M:BlizzardOff()
    expect(M:CharData().blizzardWas).toBe("1")
    mock.player:leaveCombat()
    expect(M:CharData().blizzardWas).toBeNil()
    expect(cvars.rememberedValue("damagemeter", CVAR)).toBe("1")
    -- (the module is off: its memory given back by hand)
    cvars.restoreAll("damagemeter")
    expect(C_CVar.GetCVar(CVAR)).toBe("1")
    settings.set("damagemeter", "enabled", true)
end

@test("windows: one by default; more from a window's menu, at most three, stacked; their views kept, a past fight not")
local function windows()
    expect(M.windows[1]:IsShown()).toBe(true)
    local w1 = M.windows[1]
    assert(w1.opts.onNewWindow)()
    expect(M:Get("windowCount")).toBe(2)
    local w2 = M.windows[2]
    expect(w2:IsShown()).toBe(true)
    expect(w2.type).toBe("healing")
    local _, _, _, _, y = w2:GetPoint(1)
    expect(y > 0).toBe(true)
    assert(w1.opts.onNewWindow)()
    assert(w1.opts.onNewWindow)()
    expect(M:Get("windowCount")).toBe(3)
    -- a view chosen: kept; Overall kept, a past fight not
    assert(w2.opts.onView)("dps", "overall")
    expect(M:Get("views")[2].type).toBe("dps")
    expect(M:Get("views")[2].session).toBe("overall")
    assert(w2.opts.onView)("interrupts", 31)
    expect(M:Get("views")[2].session).toBeNil()
    -- window 2 closed: window 3's view moves down
    assert(w2.opts.onClose)()
    expect(M:Get("windowCount")).toBe(2)
    expect(M:Get("views")[2].type).toBe("deaths")
    expect(M.windows[3]:IsShown()).toBe(false)
    -- the first has no Close
    expect(w1.opts.onClose).toBeNil()
end

@test("its menu: Reset all fights, Settings")
local function menu()
    local reset = mock.spy(function() end)
    mock.stub(C_DamageMeter, "ResetAllCombatSessions", reset)
    local opened = mock.spy(function(_: string) end)
    mock.stub(SuuUI, "OpenSettings", opened)
    assert(M.windows[1].opts.onReset)()
    expect(reset).toHaveBeenCalled()
    assert(M.windows[1].opts.onSettings)()
    expect(opened).toHaveBeenCalledWith("damagemeter")
end

@test("shown always, in a group, in combat, or hidden (and hidden in edit mode); read every second in combat")
local function shows()
    local f = assert(M.frame)
    expect(f:IsShown()).toBe(true)
    M:Set("shows", "group")
    expect(f:IsShown()).toBe(false)
    mock.group:add(
        mock.spawnUnit({ name = "Brannoc Ironhand", player = true, class = "WARRIOR", reaction = "friendly" })
    )
    mock.advanceFrames(1)
    expect(f:IsShown()).toBe(true)
    M:Set("shows", "combat")
    expect(f:IsShown()).toBe(false)
    local count = countRefreshes()
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(f:IsShown()).toBe(true)
    expect(assert(M.driver):IsShown()).toBe(true)
    count.n = 0
    mock.advanceFrames(150)
    expect(count.n >= 2).toBe(true)
    -- the meter's events in combat: no extra reads
    count.n = 0
    mock.fireEvent("DAMAGE_METER_CURRENT_SESSION_UPDATED")
    mock.advanceTime(0.3)
    expect(count.n).toBe(0)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(f:IsShown()).toBe(false)
    -- in an instance (a dungeon or raid): entering and leaving
    M:Set("shows", "instance")
    expect(f:IsShown()).toBe(false)
    mock.enterInstance("party")
    mock.advanceFrames(1)
    expect(f:IsShown()).toBe(true)
    mock.leaveInstance()
    mock.advanceFrames(1)
    expect(f:IsShown()).toBe(false)
    M:Set("shows", "always")
    M:Set("position", { point = "BOTTOMRIGHT", x = -28, y = 28, hidden = true })
    expect(f:IsShown()).toBe(false)
    M:Set("shows", "hidden")
    expect(f:IsShown()).toBe(false)
end

@test("out of combat: one read shortly after a burst of the meter's events; twice after a fight")
local function soon()
    local count = countRefreshes()
    for _ = 1, 5 do
        mock.fireEvent("DAMAGE_METER_COMBAT_SESSION_UPDATED", Enum.DamageMeterType.DamageDone, 1)
    end
    expect(count.n).toBe(0)
    mock.advanceTime(0.3)
    expect(count.n).toBe(1)
    mock.fireEvent("DAMAGE_METER_RESET")
    mock.fireEvent("ADDON_RESTRICTION_STATE_CHANGED", 0, 0)
    mock.advanceTime(0.3)
    expect(count.n).toBe(2)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    mock.player:leaveCombat()
    count.n = 0
    mock.advanceTime(0.6)
    mock.advanceTime(1)
    expect(count.n >= 3).toBe(true)
end

@test("the options live on every window; rows and windows lay the stack out again")
local function options()
    M:Set("windowCount", 2)
    local got: { [number]: MeterViewChange } = {}
    for i, w in ipairs(M.windows) do
        mock.stub(w, "SetOptions", function(_: unknown, o: MeterViewChange)
            got[i] = o
        end)
    end
    M:Set("numbers", "complete")
    M:Set("barColor", "neutral")
    M:Set("marker", "diamond")
    M:Set("nameColor", "ink")
    M:Set("pinYou", false)
    expect(assert(got[1]).numbers).toBe("complete")
    expect(assert(got[2]).marker).toBe("diamond")
    expect(assert(got[2]).pinYou).toBe(false)
    local h = assert(M.frame):GetHeight()
    M:Set("rows", 5)
    expect(assert(M.frame):GetHeight() < h).toBe(true)
end

@test(
    "the preview: a made-up raid fight with you in it, its breakdowns, fights and death recap; the threat meter above"
)
local function preview()
    local parent = CreateFrame("Frame", nil, UIParent)
    local view = M:PreviewView(parent)
    expect(view:GetParent()).toBe(parent)
    local meter = assert(M.previewMeter)
    local api, recap = assert(meter.api), assert(meter.recapApi)
    local DT = Enum.DamageMeterType
    local s = api.GetCombatSessionFromType(0, DT.DamageDone)
    expect(#s.combatSources).toBe(12)
    local you: DamageMeterCombatSourceSecret? = nil
    for _, src in ipairs(s.combatSources) do
        if src.isLocalPlayer then
            you = src
        end
    end
    expect(assert(you).name).toBe((UnitName("player")) or "")
    expect(api.GetCombatSessionFromID(0, DT.HealingDone).combatSources[1].name).toBe("Ysolde")
    -- a source's spells: damage, or heals
    local first = s.combatSources[1].sourceGUID
    local spells = api.GetCombatSessionSourceFromType(0, DT.DamageDone, not issecretvalue(first) and first or nil)
    expect(spells.combatSpells[1].spellID).toBe(116)
    local mine = UnitGUID("player")
    local heals = api.GetCombatSessionSourceFromID(0, DT.HealingDone, not issecretvalue(mine) and mine or nil)
    expect(heals.combatSpells[1].spellID).toBe(2060)
    expect(#api.GetCombatSessionSourceFromType(0, DT.DamageDone, "nobody").combatSpells).toBe(0)
    expect(#api.GetAvailableCombatSessions()).toBe(3)
    expect(api.GetSessionDurationSeconds(Enum.DamageMeterSessionType.Overall)).toBe(385)
    expect(api.GetSessionDurationSeconds(Enum.DamageMeterSessionType.Current)).toBe(102)
    -- the death recap: newest first
    local events = recap.GetRecapEvents(1) :: RecapEvent[]
    expect(events[1].spellName).toBe("Magma Blast")
    expect(events[1].overkill).toBe(1018)
    expect(recap.GetRecapMaxHealth(1)).toBe(4000)
    -- the options and rows live on it; with the threat meter off, alone
    M:Set("numbers", "minimal")
    M:Set("rows", 6)
    local threat = assert(SuuUI.GetModule("threat"))
    mock.stub(threat, "IsEnabled", function(): boolean
        return false
    end)
    M:PreviewView(parent)
end

@test("the settings rows wait for the meter")
local function rowsWait()
    local function disabled(key: string): (boolean?, string?)
        for _, g in ipairs(SECTION.groups or {}) do
            for _, r in ipairs(g.rows) do
                if r.key == key then
                    return assert(r.disabled)()
                end
            end
        end
        error("no row " .. key)
    end
    expect((disabled("numbers"))).toBe(false)
    M:Set("shows", "hidden")
    local off, why = disabled("rows")
    expect(off).toBe(true)
    expect(why).toBe("Show the damage meter first.")
end

-- (last: the module off) The meter toggles live: turned off through the
-- registry nothing of it stays; on again, it all comes back.
@test("turned off through the registry: the meter gone, its anchor and Blizzard's setting back, nothing held; on again, all back")
local function disabled()
    settings.set("damagemeter", "enabled", false)
    C_CVar.SetCVar(CVAR, "1")
    settings.set("damagemeter", "enabled", true)
    -- (0.39) published while on: tooltips open clear of it
    expect(SuuUI.GetAnchor("damageMeter")).toBe(M.frame)
    local c = cycle("damagemeter")
    expect(c.stateOff).toBe(modules.ModuleState.Disabled)
    expect(c.off).toEqual(NOTHING)
    expect(c.after).toEqual(c.before)
    expect(c.stateOn).toBe(modules.ModuleState.Enabled)
    expect(assert(M.frame):IsShown()).toBe(true)
    expect(SuuUI.GetAnchor("damageMeter")).toBe(M.frame)
    expect(C_CVar.GetCVar(CVAR)).toBe("0")
    -- a refresh waiting when it turns off doesn't block the next one
    mock.fireEvent("DAMAGE_METER_RESET")
    expect(M.pending).toBe(true)
    settings.set("damagemeter", "enabled", false)
    settings.set("damagemeter", "enabled", true)
    local count = countRefreshes()
    mock.fireEvent("DAMAGE_METER_RESET")
    mock.advanceTime(0.3)
    expect(count.n).toBe(1)
    -- off: hidden, the anchor gone, Blizzard's setting back
    settings.set("damagemeter", "enabled", false)
    expect(assert(M.frame):IsShown()).toBe(false)
    expect(assert(M.driver):IsShown()).toBe(false)
    expect(SuuUI.GetAnchor("damageMeter")).toBeNil()
    expect(C_CVar.GetCVar(CVAR)).toBe("1")
    expectNoErrors()
end
