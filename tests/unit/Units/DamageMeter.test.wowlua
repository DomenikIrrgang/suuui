-- Units/DamageMeter: Blizzard's meter off while SuuUI's runs (and back
-- after); up to three windows stacked, each with its own type and fight
-- (kept, a past fight not), one closed (the others move down); when it
-- shows (always, in a group, in combat, hidden); read every second in
-- combat, shortly after the meter's events out of it, twice after a fight;
-- the options live; the preview's made-up fight; the settings rows;
-- stopped.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, SECTION from "/Units/DamageMeter"
import expectNoErrors from "../../helpers"

@afterEach
local function cleanup()
    if InCombatLockdown() then mock.player:leaveCombat() end
    mock.group:leave()
    M:ResetAll({ "shows", "numbers", "rows", "barColor", "marker", "nameColor", "pinYou", "windowCount", "views", "position" })
    mock.advanceTime(2)
    expectNoErrors()
end

-- Counts the windows' refreshes.
local function countRefreshes(): { n: number }
    local count = { n = 0 }
    local real = M.Refresh
    mock.stub(M, "Refresh", function(self: any) count.n = count.n + 1; real(self) end)
    return count
end

@test("Blizzard's meter off while SuuUI's runs, what it was kept")
local function blizzardOff()
    expect(C_CVar.GetCVar("damageMeterEnabled")).toBe("0")
    expect(M:Get("blizzardWas") ~= "").toBe(true)
end

@test("windows: one by default; more from a window's menu, at most three, stacked; their views kept, a past fight not")
local function windows()
    expect(M.windows[1]:IsShown()).toBe(true)
    local w1 = M.windows[1]
    w1.opts.onNewWindow()
    expect(M:Get("windowCount")).toBe(2)
    local w2 = M.windows[2]
    expect(w2:IsShown()).toBe(true)
    expect(w2.type).toBe("healing")
    local _, _, _, _, y = w2:GetPoint(1)
    expect(y > 0).toBe(true)
    w1.opts.onNewWindow()
    w1.opts.onNewWindow()
    expect(M:Get("windowCount")).toBe(3)
    -- a view chosen: kept; Overall kept, a past fight not
    w2.opts.onView("dps", "overall")
    expect(M:Get("views")[2].type).toBe("dps")
    expect(M:Get("views")[2].session).toBe("overall")
    w2.opts.onView("interrupts", 31)
    expect(M:Get("views")[2].session).toBeNil()
    -- window 2 closed: window 3's view moves down
    w2.opts.onClose()
    expect(M:Get("windowCount")).toBe(2)
    expect(M:Get("views")[2].type).toBe("deaths")
    expect(M.windows[3]:IsShown()).toBe(false)
    -- the first has no Close
    expect(w1.opts.onClose).toBeNil()
end

@test("its menu: Reset all fights, Settings")
local function menu()
    local reset = mock.spy(function() end)
    mock.stub(C_DamageMeter, "ResetAllCombatSessions", reset)
    local opened = mock.spy(function(_: string) end)
    mock.stub(SuuUI, "OpenSettings", opened)
    M.windows[1].opts.onReset()
    expect(reset).toHaveBeenCalled()
    M.windows[1].opts.onSettings()
    expect(opened).toHaveBeenCalledWith("damagemeter")
end

@test("shown always, in a group, in combat, or hidden (and hidden in edit mode); read every second in combat")
local function shows()
    local f = M.frame
    expect(f:IsShown()).toBe(true)
    M:Set("shows", "group")
    expect(f:IsShown()).toBe(false)
    mock.group:add(mock.spawnUnit({ name = "Brannoc Ironhand", player = true, class = "WARRIOR", reaction = "friendly" }))
    mock.advanceFrames(1)
    expect(f:IsShown()).toBe(true)
    M:Set("shows", "combat")
    expect(f:IsShown()).toBe(false)
    local count = countRefreshes()
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(f:IsShown()).toBe(true)
    expect(M.driver:IsShown()).toBe(true)
    count.n = 0
    mock.advanceFrames(150)
    expect(count.n >= 2).toBe(true)
    -- the meter's events in combat: no extra reads
    count.n = 0
    mock.fireEvent("DAMAGE_METER_CURRENT_SESSION_UPDATED")
    mock.advanceTime(0.3)
    expect(count.n).toBe(0)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(f:IsShown()).toBe(false)
    M:Set("shows", "always")
    M:Set("position", { point = "BOTTOMRIGHT", x = -28, y = 28, hidden = true })
    expect(f:IsShown()).toBe(false)
    M:Set("shows", "hidden")
    expect(f:IsShown()).toBe(false)
end

@test("out of combat: one read shortly after a burst of the meter's events; twice after a fight")
local function soon()
    local count = countRefreshes()
    for _ = 1, 5 do mock.fireEvent("DAMAGE_METER_COMBAT_SESSION_UPDATED", Enum.DamageMeterType.DamageDone, 1) end
    expect(count.n).toBe(0)
    mock.advanceTime(0.3)
    expect(count.n).toBe(1)
    mock.fireEvent("DAMAGE_METER_RESET")
    mock.fireEvent("ADDON_RESTRICTION_STATE_CHANGED", 0, 0)
    mock.advanceTime(0.3)
    expect(count.n).toBe(2)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    mock.player:leaveCombat()
    count.n = 0
    mock.advanceTime(0.6)
    mock.advanceTime(1)
    expect(count.n >= 3).toBe(true)
end

@test("the options live on every window; rows and windows lay the stack out again")
local function options()
    M:Set("windowCount", 2)
    local got: any[] = {}
    for i, w in ipairs(M.windows) do
        mock.stub(w, "SetOptions", function(_: any, o: any) got[i] = o end)
    end
    M:Set("numbers", "complete")
    M:Set("barColor", "neutral")
    M:Set("marker", "diamond")
    M:Set("nameColor", "ink")
    M:Set("pinYou", false)
    expect(got[1].numbers).toBe("complete")
    expect(got[2].marker).toBe("diamond")
    expect(got[2].pinYou).toBe(false)
    local h = M.frame:GetHeight()
    M:Set("rows", 5)
    expect(M.frame:GetHeight() < h).toBe(true)
end

@test("the preview: a made-up raid fight with you in it, its breakdowns, fights and death recap; the threat meter above")
local function preview()
    local parent = CreateFrame("Frame", nil, UIParent)
    local view = M:PreviewView(parent)
    expect(view:GetParent()).toBe(parent)
    local meter = M.previewMeter
    local api, recap = meter.api, meter.recapApi
    local DT = Enum.DamageMeterType
    local s = api.GetCombatSessionFromType(nil, DT.DamageDone)
    expect(#s.combatSources).toBe(12)
    local you: any
    for _, src in ipairs(s.combatSources) do if src.isLocalPlayer then you = src end end
    expect(you.name).toBe(UnitName("player"))
    expect(api.GetCombatSessionFromID(nil, DT.HealingDone).combatSources[1].name).toBe("Ysolde")
    -- a source's spells: damage, or heals
    local spells = api.GetCombatSessionSourceFromType(nil, DT.DamageDone, s.combatSources[1].sourceGUID)
    expect(spells.combatSpells[1].spellID).toBe(116)
    local heals = api.GetCombatSessionSourceFromID(nil, DT.HealingDone, UnitGUID("player"))
    expect(heals.combatSpells[1].spellID).toBe(2060)
    expect(#api.GetCombatSessionSourceFromType(nil, DT.DamageDone, "nobody").combatSpells).toBe(0)
    expect(#api.GetAvailableCombatSessions()).toBe(3)
    expect(api.GetSessionDurationSeconds(Enum.DamageMeterSessionType.Overall)).toBe(385)
    expect(api.GetSessionDurationSeconds(Enum.DamageMeterSessionType.Current)).toBe(102)
    -- the death recap: newest first
    local events = recap.GetRecapEvents(1)
    expect(events[1].spellName).toBe("Magma Blast")
    expect(events[1].overkill).toBe(1018)
    expect(recap.GetRecapMaxHealth(1)).toBe(4000)
    -- the options and rows live on it; with the threat meter off, alone
    M:Set("numbers", "minimal")
    M:Set("rows", 6)
    local threat: any = SuuUI.GetModule("threat")
    mock.stub(threat, "IsEnabled", function(): boolean return false end)
    M:PreviewView(parent)
end

@test("the settings rows wait for the meter")
local function rowsWait()
    local rows: { [string]: any } = {}
    for _, g in ipairs(SECTION.groups) do for _, r in ipairs(g.rows) do rows[r.key] = r end end
    expect((rows.numbers.disabled())).toBe(false)
    M:Set("shows", "hidden")
    local off, why = rows.rows.disabled()
    expect(off).toBe(true)
    expect(why).toBe("Show the damage meter first.")
end

-- (last: the module off)
@test("stopped: the meter gone, Blizzard's setting back")
local function disabled()
    local was = M:Get("blizzardWas")
    local m: any = M
    m:OnDisable()
    expect(M.frame:IsShown()).toBe(false)
    expect(C_CVar.GetCVar("damageMeterEnabled")).toBe(was)
    expect(M:Get("blizzardWas")).toBe("")
    -- on again: off again, kept again
    M:BlizzardOff()
    expect(C_CVar.GetCVar("damageMeterEnabled")).toBe("0")
end
