end

@test("the settings: on the Loot page; the tray in edit mode, at first high in the middle of the screen")
local function settingsAndMover()
    local s = registry.get("lootrolls") :: registry.Section
    expect(s.merge).toBe("loot")
    local found = false
    for _, m in ipairs(editMode.movers()) do
        if m.label == "Loot rolls" then
            found = true
        end
    end
    expect(found).toBe(true)
    expect(M:Get("position")).toEqual({ point = "TOP", x = 0, y = -80 })
    -- placed there: horizontally centred, its top in the screen's upper part
    roll(7)
    local t = tray()
    local root = SuuUI.Root
    expect(math.floor((t:GetLeft() + t:GetRight()) / 2 + 0.5)).toBe(math.floor(root:GetWidth() / 2 + 0.5))
    expect(math.floor(root:GetTop() - t:GetTop() + 0.5)).toBe(80)
end

-- (CHAT-23) Two of one drop: two open rolls for the same item.
@test("two rolls of one item: you answer the second; it is locked, the first stays answerable and its answer reaches its own roll")
local function sameItemYours()
    roll(7)
    roll(8)
    mock.click(option(8, "pass"))
    expect(rolled).toEqual({ { 8, LOOT_ROLL_TYPE_PASS or 0 } })
    -- the game's line about your vote: the roll you answered, not the oldest
    M:OnLootLine(line(LOOT_ROLL_PASSED_SELF, 12, ITEM_LINK))
    drawn()
    local first, second = assert(M.rolls[7]), assert(M.rolls[8])
    expect(second.choice).toBe("pass")
    expect(second.votes.pass).toEqual({ me() })
    expect(first.choice).toBe(nil)
    expect(first.votes.pass).toEqual({})
    expect(option(8, "pass").chosen).toBe(true)
    expect(option(7, "need").chosen).toBe(false)
    expect(option(7, "need").blocked).toBe(false)
    -- the first answered after: its own roll ID
    mock.click(option(7, "need"))
    expect(rolled).toEqual({ { 8, LOOT_ROLL_TYPE_PASS or 0 }, { 7, LOOT_ROLL_TYPE_NEED or 1 } })
    M:OnLootLine(line(LOOT_ROLL_NEED_SELF, 12, ITEM_LINK))
    expect(first.votes.need).toEqual({ me() })
    expect(second.votes.pass).toEqual({ me() })
    expect(first.choice).toBe("need")
    expect(second.choice).toBe("pass")
end

@test("two rolls of one item, one decided: only its row goes; the other stays, still answerable, and its answer reaches its roll")
local function sameItemDecided()
    roll(7)
    roll(8)
    mock.click(option(8, "pass"))
    M:OnLootLine(line(LOOT_ROLL_PASSED_SELF, 12, ITEM_LINK))
    M:OnLootLine(line(LOOT_ROLL_NEED, 12, "Tamsin", ITEM_LINK))
    M:OnLootLine(line(LOOT_ROLL_NEED, 12, "Tamsin", ITEM_LINK))
    -- the chat line names only the item: it could be either roll's, so no
    -- row goes (the result is shown)
    M:OnLootLine(line(LOOT_ROLL_WON, 12, "Tamsin", ITEM_LINK))
    expect(M.rolls[7] ~= nil).toBe(true)
    expect(M.rolls[8] ~= nil).toBe(true)
    expect(#M.results).toBe(1)
    -- the loot history's drop says your vote on it was a pass: the second
    local drop: { [string]: unknown } = {
        itemHyperlink = ITEM_LINK,
        allPassed = false,
        winner = { playerName = "Tamsin" },
        playerRollState = 5,
    }
    mock.fake("C_LootHistory.GetSortedInfoForDrop", function(): unknown
        return drop
    end)
    mock.fireEvent("LOOT_HISTORY_UPDATE_DROP", 2, 9)
    expect(M.rolls[8]).toBe(nil)
    expect(M.rolls[7] ~= nil).toBe(true)
    -- (the same decision twice: one result)
    expect(#M.results).toBe(1)
    -- the drop updated again: told once, the first stays
    mock.fireEvent("LOOT_HISTORY_UPDATE_DROP", 2, 9)
    expect(M.rolls[7] ~= nil).toBe(true)
    -- the first still answerable, on its own ID
    expect(row(7).choices:Option("greed") ~= nil).toBe(true)
    mock.click(option(7, "greed"))
    expect(rolled[#rolled]).toEqual({ 7, LOOT_ROLL_TYPE_GREED or 2 })
    -- its own result: now every roll of the item is decided, it goes
    M:OnLootLine(line(LOOT_ROLL_WON, 12, "Ashford", ITEM_LINK))
    expect(M.rolls[7]).toBe(nil)
    expect(#M.results).toBe(2)
end

@test("two rolls of one item, results from chat only: no row goes on the first, both on the second")
local function sameItemLines()
