@test("three rolls of one item, votes from several players arriving interleaved: each player's first vote on the first roll, and so on")
local function sameItemInterleaved()
    roll(7)
    roll(8)
    roll(9)
    local votes: { [number]: string }[] = {
        { "Tamsin", LOOT_ROLL_NEED },
        { "Ashford", LOOT_ROLL_GREED },
        { "Tamsin", LOOT_ROLL_PASSED },
        { "Corwen", LOOT_ROLL_NEED },
        { "Ashford", LOOT_ROLL_PASSED },
        { "Tamsin", LOOT_ROLL_GREED },
        { "Ashford", LOOT_ROLL_NEED },
        { "Corwen", LOOT_ROLL_PASSED },
        { "Corwen", LOOT_ROLL_GREED },
    }
    for _, v in ipairs(votes) do
        M:OnLootLine(line(assert(v[2]), 12, assert(v[1]), ITEM_LINK))
    end
    drawn()
    local a, b, c = assert(M.rolls[7]), assert(M.rolls[8]), assert(M.rolls[9])
    expect(a.votes).toEqual({ need = { "Tamsin", "Corwen" }, greed = { "Ashford" }, pass = {} })
    expect(b.votes).toEqual({ need = {}, greed = {}, pass = { "Tamsin", "Ashford", "Corwen" } })
    expect(c.votes).toEqual({ need = { "Ashford" }, greed = { "Tamsin", "Corwen" }, pass = {} })
    -- (counted on each row; nobody's vote answered or locked a row of yours)
    expect(option(8, "pass").badge.label:GetText()).toBe("3")
    for _, r in ipairs({ a, b, c }) do
        expect(r.choice).toBe(nil)
    end
    -- a fourth vote of one player: no roll left for it, it goes nowhere
    M:OnLootLine(line(LOOT_ROLL_NEED, 12, "Tamsin", ITEM_LINK))
    expect(#a.votes.need + #b.votes.need + #c.votes.need).toBe(3)
end

@test("a vote line with nobody to put it on: your own with two rolls of the item unanswered locks neither; one about no roll is ignored")
local function unattributed()
    roll(7)
