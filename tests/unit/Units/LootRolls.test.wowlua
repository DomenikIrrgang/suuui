@test("an item whose name can't be read yet: its row stays (the link's name), answerable, named once the game has it")
local function lateName()
    roll(7, { nameless = true, name = "Dusk Mantle of the Owl" })
    local r = assert(M.rolls[7])
    expect(r.unnamed).toBe(true)
    expect(row(7).name:GetText()).toBe("Dusk Mantle")
    mock.click(option(7, "greed"))
    expect(rolled).toEqual({ { 7, LOOT_ROLL_TYPE_GREED or 2 } })
    -- the item's data in: named on the next tick
    assert(known[7]).nameless = false
    mock.advanceFrames(3, 100)
    expect(r.unnamed).toBe(nil)
    expect(row(7).name:GetText()).toBe("Dusk Mantle of the Owl")
    expect(row(7).chipLabel:GetText()).toBe("Greed") -- (yours: the only roll, answered)
    -- no link either: the game's placeholder; a secret name: kept too
    roll(8, { nameless = true, noLink = true })
    expect(row(8).name:GetText()).toBe(RETRIEVING_ITEM_INFO or "Item")
    mock.stub(_G, "GetLootRollItemInfo", function(_: number): ...unknown
        return 135033, mock.secret("Hidden"), 1, 2, false, true, true, false, 0, 0, 0
    end)
    roll(9)
    expect(M.rolls[9] ~= nil).toBe(true)
end

@test("folded or hidden: vote lines draw nothing; the rows drawn when it shows again")
local function hiddenTray()
    roll(7)
    roll(8, { name = "Ember Pants", link = OTHER_LINK, quality = 3 })
    -- (the items' data in first: it draws the tray again on its own)
    mock.advanceFrames(10, 100)
    local t = tray()
    local sets, updates = 0, 0
    local setData = t.SetData
    mock.stub(t, "SetData", function(self: LootRollTray, d: RollTrayData)
        sets = sets + 1
        setData(self, d)
    end)
    for _, r in ipairs(t.rows) do
        local update = r.Update
        mock.stub(r, "Update", function(self: LootRollRow, d: RollRowData, compact: boolean): boolean
            updates = updates + 1
            return update(self, d, compact)
        end)
    end
    mock.click(t.fold)
    sets = 0
    for _, name in ipairs({ "Tamsin", "Ashford", "Corwen" }) do
        M:OnLootLine(line(LOOT_ROLL_NEED, 12, name, ITEM_LINK))
    end
    mock.advanceFrames(5, 100)
    expect(sets).toBe(0)
    expect(updates).toBe(0)
    -- open again: drawn, with the votes
    mock.click(t.tabOpen)
    expect(sets).toBe(1)
    expect(option(7, "need").badge.label:GetText()).toBe("3")
    -- (the tray's own frame hidden: the same, drawn on the frame it shows)
    t:Hide()
    sets = 0
    M:OnLootLine(line(LOOT_ROLL_GREED, 12, "Tamsin", OTHER_LINK))
    mock.advanceFrames(2, 100)
    expect(sets).toBe(0)
    expect(updates).toBe(0)
    M:Refresh()
    expect(option(8, "greed").badge.label:GetText()).toBe("1")
end

-- (late: it makes a raid, left again at its end)
@test("a 40-player raid with five rolls open: a vote line draws only its roll's row, with no walk over the raid")
local function raidVotes()
    mock.group:leave()
    local classes = { "WARRIOR", "PRIEST", "MAGE", "ROGUE", "DRUID" }
    local raiders: mock.MockUnit[] = {}
    for i = 1, 39 do
        local u = mock.spawnUnit({
            name = "Raider" .. i,
            player = true,
            class = assert(classes[i % #classes + 1]),
            level = 60,
            reaction = "friendly",
        })
        mock.group:add(u, { raid = true })
        raiders[i] = u
    end
    expect(GetNumGroupMembers()).toBe(40)
    local links: string[] = {}
    for i = 1, 5 do
        links[i] = "|cff1eff00|Hitem:" .. (6000 + i) .. "::::::::|h[Raid Drop " .. i .. "]|h|r"
        roll(40 + i, { name = "Raid Drop " .. i, link = links[i] })
    end
    drawn()
    -- (who's still choosing: the other 39, in class colours)
    expect(#M.group:Others()).toBe(39)
    local tip = assert(assert(tray().data.rolls[1]).whoTip)
    expect((assert(tip.description)):find("Choosing · 39", 1, true) ~= nil).toBe(true)
    local names, sets = 0, 0
    local updates: number[] = {}
    local fullName = SuuUI.FullName
    mock.stub(SuuUI, "FullName", function(unit: string?): (string | Secret<string>)?
        names = names + 1
        return fullName(unit)
    end)
    local t = tray()
    local setData = t.SetData
    mock.stub(t, "SetData", function(self: LootRollTray, d: RollTrayData)
        sets = sets + 1
        setData(self, d)
    end)
    for _, r in ipairs(t.rows) do
        local update = r.Update
        mock.stub(r, "Update", function(self: LootRollRow, d: RollRowData, compact: boolean): boolean
            updates[#updates + 1] = d.id
            return update(self, d, compact)
        end)
    end
    M:OnLootLine(line(LOOT_ROLL_NEED, 12, "Raider7", assert(links[3])))
    drawn()
    expect(names).toBe(0)
    expect(sets).toBe(0)
    expect(updates).toEqual({ 43 })
    expect(option(43, "need").badge.label:GetText()).toBe("1")
    expect(option(42, "need").badge.label:GetText()).toBe("0")
    -- ten lines in one frame: one draw of the row
    updates = {}
    for i = 10, 19 do
        M:OnLootLine(line(LOOT_ROLL_GREED, 12, "Raider" .. i, assert(links[3])))
    end
    drawn()
    expect(updates).toEqual({ 43 })
    expect(names).toBe(0)
    expect(option(43, "greed").badge.label:GetText()).toBe("10")
    -- the group changing: read again once, at the next look
    mock.group:remove(assert(raiders[39]))
    M:OnLootLine(line(LOOT_ROLL_PASSED, 12, "Raider20", assert(links[3])))
    drawn()
    expect(names > 0).toBe(true)
    expect(#M.group:Others()).toBe(38)
    mock.group:leave()
end

-- (last: the module off) Loot rolls is reloadToToggle: the registry turns
-- it off in a session only when its OnEnable fails. Here it toggles live, as
-- a module that isn't would, so the registry's own disable runs.
@test("turned off through the registry: the tray gone, Blizzard's roll frames seen again where they were; on again, away with the rolls still running")
local function turnedOff()
    local own = ownOf(M)
    own.reloadToToggle = false
    local f = assert(frames.find("GroupLootContainer"))
    local home = assert(M.rollsHome)
    roll(7)
    expect(tray()).toBeShown()
    settings.set("lootrolls", "enabled", false)
    expect(M.state).toBe(modules.ModuleState.Disabled)
    expect(tray()).never.toBeShown()
    expect(next(M.rolls)).toBeNil()
    expect(f:GetAlpha()).toBe(1)
    expect(f:IsClampedToScreen() and true or false).toBe(home.clamped)
    -- (where they were: none at login, the game places them with a roll)
    expect(f:GetNumPoints()).toBe(#home.points)
    -- the game placing them: they stay there, seen
    f:ClearAllPoints()
    f:SetPoint("CENTER")
    mock.advanceTime(0.01)
    expect((f:GetPoint(1))).toBe("CENTER")
    expect(f:GetAlpha()).toBe(1)
    -- on again: away at once; the roll still running back in the tray
    mock.stub(_G, "GetActiveLootRollIDs", function(): unknown
        return { 7 }
    end)
    settings.set("lootrolls", "enabled", true)
    expect(M.state).toBe(modules.ModuleState.Enabled)
    expect(f:GetAlpha()).toBe(0)
    expect((f:GetPoint(1))).toBe("BOTTOMRIGHT")
    expect(row(7) ~= nil).toBe(true)
    own.reloadToToggle = true
    expectNoErrors()
end
