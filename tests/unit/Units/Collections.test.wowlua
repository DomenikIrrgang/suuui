-- Units/Collections: SuuUI's collections window. Where something comes
-- from (a line and a card, from SuuUI's generated sources or the game's
-- source kind); the mounts, toys and appearances it lists, yours first;
-- the day SuuUI first saw one of yours; the Mounts tab (the strip, paging,
-- the search and filters, the stage with the model, the card, Summon or
-- Dismiss, the favourite star); the Toys shelf (what a toy does, its
-- cooldown, Use); Appearances (the doll's slots, the weapon kinds, the
-- tiles, trying one on); the foot; opening it (the key, the game's
-- journal); the game's news.
--
-- The game's journals answer from the account's mounts, toys and
-- collected appearances the tests set (`mock.setMounts`, `mock.setToys`,
-- `mock.setAppearances`; the wardrobe's catalogue is the client's); the
-- tests give SuuUI's source data themselves.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as events from "/Core/Events"
import internal M, filterEntries, actionLabel, readyIn, toyWhy, day, status, toyCooldown from "/Units/Collections"
import internal Entry, Parts, Cell, SlotButton from "/Units/Collections"
import type CollectionSources from "/Data/CollectionSources"
import type TooltipData from "/UI/Tooltip"
import * as frames from "wowlua:frames"
import expectNoErrors from "../../helpers"
import tokenOf from "../SettingsUI/UiSettingsHelpers"

-- SuuUI's generated sources: creatures and objects by ID, then each
-- mount's, toy's and item's sources.
local SOURCES: CollectionSources = {
    npc = { [1] = "Vendor Brom|Elwynn Forest|20|Alliance", [2] = "Kobold Miner|Elwynn Forest|5|", [3] = "Boar|||" },
    obj = { [1] = "Old Chest|Westfall", [2] = "Crate|" },
    mount = {
        [101] = { v = { 1, 2 } },
        [102] = { q = { 10, 11 } },
    },
    toys = { 201, 202, 203 },
    toy = { [201] = { x = "From a holiday" } },
    item = { [56] = { d = { 2 }, dn = 3 } },
}

-- The account's mounts, by mount ID: the game's journal holds them.
local MOUNTS: { [number]: mock.MountData } = {}
local function mount(id: number, name: string, opts: { favorite?: boolean, collected?: boolean, hidden?: boolean, usable?: boolean }?)
    local o = opts or {}
    MOUNTS[id] = { name = name, spellID = id * 10, icon = 132000 + id, sourceType = 1, display = 9000 + id,
                   favorite = o.favorite, collected = o.collected, hidden = o.hidden, usable = o.usable }
end

local mounted = false

@beforeEach
local function start()
    MOUNTS = {}
    mount(101, "Brown Horse")
    mount(102, "Swift Ram", { favorite = true })
    mount(103, "Zebra", { collected = false })
    mount(104, "Hidden Steed", { hidden = true })
    mount(105, "Night Saber", { usable = false })
    mock.setMounts(MOUNTS)
    mounted = false
    mock.stub(SuuUI, "CollectionSources", function() return SOURCES end)
    mock.fake("IsMounted", function() return mounted end)
    mock.stub(C_QuestLog, "GetTitleForQuestID", function(id: number): string? return id == 10 and "The Ram Trial" or nil end)
end

-- The window's parts (built as the module started).
local function ui(): Parts return assert(M.ui) end

-- An entry with only what a test needs.
local function entry(fields: { [string]: unknown }): Entry return mock.partial(fields) end

-- What SuuUI.UI.ShowTooltip was asked last.
local function captureTooltips(): () -> TooltipData
    local shown: TooltipData? = nil
    mock.stub(SuuUI.UI, "ShowTooltip", function(_: unknown, opts: TooltipData) shown = opts end)
    return function(): TooltipData return (assert(shown, "no tooltip")) end
end

@afterEach
local function cleanup()
    if ui().window:IsShown() then ui().window:Hide() end
    mock.advanceTime(0.5)
    M.chosen, M.page, M.slotCounts, M.weaponKind, M.tried = nil, 1, nil, {}, nil
    ui().tools.search:SetValue("")
    ui().tools.have:SetValue("all")
    ui().tools.list:SetValue("all")
    M:Saved().learned, M:Saved().last = nil, nil
    expectNoErrors()
end

local function open(tab: string?)
    M:Toggle(tab or "mounts")
    mock.advanceTime(0.01)
end

local function cells(): Cell[]
    local out: Cell[] = {}
    for _, b in ipairs(ui().strip.cells) do if b:IsShown() then out[#out + 1] = b end end
    return out
end

--------------------------------------------------------------------------------
-- Where it comes from
--------------------------------------------------------------------------------

@test("a source as one line: vendor, quest, world drop, drop, object, container, crafted, the game's text, the item; else the kind")
local function sourceLines()
    expect(M:SourceLine({ v = { 1, 2 } }, "mount", 1)).toBe("Vendor · Vendor Brom, Elwynn Forest +1")
    expect(M:SourceLine({ v = { 99 }, q = { 10, 11 } }, "mount", 1)).toBe("Quest · The Ram Trial +1")
    expect(M:SourceLine({ q = { 12 } }, "mount", 1)).toBe("Quest")
    expect(M:SourceLine({ dn = 40 }, "mount", 1)).toBe("World drop")
    expect(M:SourceLine({ d = { 2 }, dn = 3 }, "mount", 1)).toBe("Drop · Kobold Miner, Elwynn Forest · 5 +2")
    expect(M:SourceLine({ d = { 3, 2 } }, "mount", 1)).toBe("Drop · Boar +1")
    expect(M:SourceLine({ o = { 1 } }, "mount", 1)).toBe("Found in · Old Chest, Westfall")
    expect(M:SourceLine({ o = { 2, 1 } }, "mount", 1)).toBe("Found in · Crate +1")
    mock.stub(C_Item, "GetItemNameByID", function(id: number): string? return id == 501 and "Locked Box" or nil end)
    expect(M:SourceLine({ c = { 501 } }, "mount", 1)).toBe("Inside · Locked Box")
    expect(M:SourceLine({ c = { 502 } }, "mount", 1)).toBe("Inside · a container")
    expect(M:SourceLine({ p = "Engineering" }, "mount", 1)).toBe("Crafted · Engineering")
    expect(M:SourceLine({ x = "A gift from the event" }, "mount", 1)).toBe("A gift from the event")
    expect(M:SourceLine({ i = 501 }, "mount", 1)).toBe("Taught by · Locked Box")
    expect(M:SourceLine({ i = 502 }, "mount", 1)).toBe("Taught by · an item")
    -- unknown creatures and objects: on to the next
    expect(M:SourceLine({ v = { 99 }, d = { 99 }, o = { 99 } }, "mount", -1)).toBe("Source unknown")
    -- the game's kinds: a mount's by the pet journal's words, an appearance's by the transmog ones
    expect(M:SourceLine(nil, "mount", 0)).toBe(BATTLE_PET_SOURCE_1)
    expect(M:SourceLine(nil, "appearance", 1)).toBe(TRANSMOG_SOURCE_1)
    expect(M:SourceLine(nil, "mount", nil)).toBe("Source unknown")
    expect(M:SourceLine(nil, "mount", 999)).toBe("Source unknown")
end

@test("a source as a card: every kind with its places, a world drop, more dropping it, the item, the game's kind")
local function sourceCards()
    mock.stub(C_Item, "GetItemNameByID", function(id: number): string? return id == 501 and "Locked Box" or nil end)
    local card = M:SourceCard({ v = { 1, 2, 99 }, q = { 10, 12 }, d = { 2, 3 }, dn = 5, o = { 1, 99 }, c = { 501, 502 }, p = "Engineering", x = "Event" }, "mount", 1)
    local function lines(title: string): string[]?
        for _, s in ipairs(card) do if s.title == title then return s.lines end end
        return nil
    end
    expect(lines("Sold by")).toEqual({ "Vendor Brom, Elwynn Forest (Alliance)", "Kobold Miner, Elwynn Forest" })
    expect(lines("Quest")).toEqual({ "The Ram Trial", "Quest 12" })
    expect(lines("Dropped by")).toEqual({ "Kobold Miner, Elwynn Forest · level 5", "Boar", "and 3 more" })
    expect(lines("Found in")).toEqual({ "Old Chest, Westfall" })
    expect(lines("Inside")).toEqual({ "Locked Box", "Item 502" })
    expect(lines("Crafted by")).toEqual({ "Engineering" })
    expect(lines("In the game")).toEqual({ "Event" })
    expect(lines("Taught by")).toBe(nil)
    -- a world drop; the teaching item alone
    expect(M:SourceCard({ dn = 50 }, "mount", 1)[1]).toEqual({ title = "World drop", lines = { "Dropped by 50 creatures across the world" } })
    expect(M:SourceCard({ i = 502 }, "mount", 1)[1]).toEqual({ title = "Taught by", lines = { "Item 502" } })
    expect(M:SourceCard({ i = 501 }, "mount", 1)[1].lines).toEqual({ "Locked Box" })
    -- nothing known: the game's kind, else nothing
    expect(M:SourceCard(nil, "appearance", 1)[1]).toEqual({ title = TRANSMOG_SOURCE_1, lines = { "Nothing more is known." } })
    expect(#M:SourceCard({ v = { 99 } }, "mount", -1)).toBe(0)
end

--------------------------------------------------------------------------------
-- What there is
--------------------------------------------------------------------------------

@test("the mounts: yours first, favourites first among them, then by name; hidden ones left out; their sources")
local function mounts()
    local list = M:Mounts()
    local names: string[] = {}
    for _, e in ipairs(list) do names[#names + 1] = e.name end
    expect(names).toEqual({ "Swift Ram", "Brown Horse", "Night Saber", "Zebra" })
    expect(list[2].source).toBe(SOURCES.mount[101])
    expect(list[1].display).toBe(9102)
    expect(list[4].learned).toBe(nil)
end

@test("the day SuuUI first saw one of yours: what you had before SuuUI is from before; later ones dated; the last collected")
local function learned()
    expect(M:Learned("mount", 1, true)).toBe(0)
    expect(M:Learned("mount", 1, false)).toBe(nil)
    mock.advanceTime(10)
    local now = time()
    expect(M:Learned("mount", 2, true)).toBe(now)
    expect(M:Learned("mount", 2, true)).toBe(now)
    expect(day(nil)).toBe(nil)
    expect(day(0)).toBe("before SuuUI")
    expect(day(now)).toBe((date("%d %b", now):gsub("^0", "")))
    expect({ status(entry({ collected = false })) }).toEqual({ "Not collected", "ink-faint" })
    expect({ status(entry({ collected = true, learned = 0 })) }).toEqual({ "Collected · before SuuUI", "gilt-text" })
    expect({ status(entry({ collected = true })) }).toEqual({ "Collected", "gilt-text" })
    M:NoteLast("Brown Horse", 100)
    M:NoteLast("Older", 50)
    M:NoteLast(nil, 200)
    M:NoteLast("Nothing", 0)
    expect(M:CharData().last).toEqual({ name = "Brown Horse", at = 100 })
end

@test("the toys: every toy of Forever, yours first, favourites, by name; names the game hasn't sent yet")
local function toys()
    -- the third's item not loaded yet: no name, the question mark
    mock.defineItem(201, { name = "Toy Drum", icon = 134001 })
    mock.defineItem(202, { name = "Bubble Wand", icon = 134002 })
    mock.setToys({ [201] = { favorite = true }, [202] = { usable = false }, [203] = { collected = false } })
    M.namesPending = false
    local list = M:Toys()
    local names: string[] = {}
    for _, e in ipairs(list) do names[#names + 1] = e.name end
    expect(names).toEqual({ "Toy Drum", "Bubble Wand", "Toy 203" })
    expect(list[1].source).toBe(SOURCES.toy[201])
    expect(list[1].icon).toBe(134001)
    expect(list[2].usable).toBe(false)
    expect(list[3].collected).toBe(false)
    expect(list[3].icon).toBe(134400)
    expect(M.namesPending).toBe(true)
end

-- The wardrobe is the client's (its categories, appearances and sources):
-- the chest has 438 appearances to show, the main hand's kinds (one-handed
-- swords and maces, two-handed maces) 242. Yours: the chest's 63239 (the
-- robe, item 56) and 63305 (by its second source, the vest), a sword
-- (130253); 63305 a favourite. You wear item 57 (the chest's 63240).
local CHEST_ALL = 438
local MAIN_ALL = 242
local function wardrobeData()
    mock.defineItem(56, { name = "Gilded Robe", quality = 4, equipLoc = "INVTYPE_ROBE" })
    mock.defineItem(57, { name = "Worn Tunic", quality = 1, equipLoc = "INVTYPE_CHEST" })
    mock.defineItem(281284, { name = "Plain Vest", quality = 1, equipLoc = "INVTYPE_CHEST" })
    mock.setAppearances({ collected = { 156056, 316091, 311021 }, favorites = { 63305 } })
    mock.player:equip(5, 57)
end

@test("the weapon kinds a hand can use; each slot's yours of all; a slot without a kind for this class says why")
local function slotCounts()
    wardrobeData()
    local main = M:WeaponKinds("main")
    expect(#main).toBe(3)
    expect(main[1]).toEqual({ category = 14, name = "One-Handed Swords" })
    expect(#M:WeaponKinds("off")).toBe(2)
    expect(#M:WeaponKinds("ranged")).toBe(0)
    local counts = M:SlotCounts("Warriors")
    expect(assert(counts.CHESTSLOT)).toEqual({ have = 2, all = CHEST_ALL })
    expect(assert(counts.MAINHANDSLOT)).toEqual({ have = 1, all = MAIN_ALL })
    expect(assert(counts.RANGEDSLOT).reason).toBe("No ranged weapons for Warriors")
    expect(assert(M:SlotCounts(nil).RANGEDSLOT).reason).toBe("No ranged weapons for this class")
end

@test("a slot's appearances: what you wear first, then yours, each with its first collected source; names to come")
local function appearances()
    wardrobeData()
    M.namesPending = false
    local list = M:Appearances(4, "CHESTSLOT")
    expect(#list).toBe(CHEST_ALL)
    local ids: number[] = {}
    for i = 1, 4 do ids[i] = list[i].visualID or 0 end
    expect(ids).toEqual({ 63240, 63239, 63305, 63242 })
    expect(list[1].worn).toBe(true)
    expect(list[1].name).toBe("Worn Tunic")
    expect(list[2].source).toBe(SOURCES.item[56])
    expect(list[2].camera).toBe(545)
    expect(list[3].sourceID).toBe(316091)
    expect(list[3].favourite).toBe(true)
    -- an item the client hasn't loaded yet: its name to come
    expect(list[4].name).toBe("…")
    expect(M.namesPending).toBe(true)
    -- nothing worn in the slot
    mock.player:equip(5, nil)
    expect(M:Worn("CHESTSLOT")).toBe(nil)
    expect(M:Appearances(4, nil)[1].visualID).toBe(63239)
end

@test("the search and the filters: yours, missing, favourites, recent (newest first, from before SuuUI last)")
local function filters()
    local all: Entry[] = {
        entry({ name = "Alpha", collected = true, favourite = true, learned = 0 }),
        entry({ name = "Beta", collected = false }),
        entry({ name = "Gamma", collected = true, learned = 200 }),
        entry({ name = "Delta", collected = true, learned = 100 }),
        entry({ name = "Epsilon", collected = true, learned = 0 }),
    }
    local function names(list: Entry[]): string[]
        local out: string[] = {}
        for _, e in ipairs(list) do out[#out + 1] = e.name end
        return out
    end
    expect(names(filterEntries(all, "a", "all", "all"))).toEqual({ "Alpha", "Beta", "Gamma", "Delta" })
    expect(names(filterEntries(all, "", "have", "all"))).toEqual({ "Alpha", "Gamma", "Delta", "Epsilon" })
    expect(names(filterEntries(all, "", "missing", "all"))).toEqual({ "Beta" })
    expect(names(filterEntries(all, "", "all", "fav"))).toEqual({ "Alpha" })
    expect(names(filterEntries(all, "", "all", "recent"))).toEqual({ "Gamma", "Delta", "Alpha", "Epsilon" })
end

@test("the stage's action, a toy's Use and when it's ready")
local function actions()
    expect({ actionLabel(true, nil) }).toEqual({ "Dismiss" })
    expect({ actionLabel(false, nil) }).toEqual({ "Summon", "Choose a mount." })
    expect({ actionLabel(false, entry({ collected = false })) }).toEqual({ "Summon", "You don't have this mount yet." })
    expect({ actionLabel(false, entry({ collected = true, usable = false })) }).toEqual({ "Summon", "You can't ride this mount here." })
    expect({ actionLabel(false, entry({ collected = true, usable = true })) }).toEqual({ "Summon" })
    expect(readyIn(100, 3900, 100)).toBe("Ready in 1 h 5 min")
    expect(readyIn(100, 2460, 100)).toBe("Ready in 41 min")
    expect(readyIn(100, 30, 100)).toBe("Ready in 30 s")
    expect(readyIn(100, 30, 200)).toBe("Ready in 0 s")
    expect(toyWhy(entry({ collected = false }), 0, 0)).toBe("You don't have this toy yet.")
    expect(toyWhy(entry({ collected = true }), GetTime(), 60)).toBe("Ready in 1 min.")
    expect(toyWhy(entry({ collected = true, usable = false }), 0, 0)).toBe("You can't use this toy here.")
    expect(toyWhy(entry({ collected = true, usable = true }), 0, 0)).toBe(nil)
    -- a toy's cooldown: the game's, if it lasts beyond the global cooldown
    mock.stub(C_Container, "GetItemCooldown", function(id: number): (unknown, unknown)
        if id == 1 then return 50, 120 end
        if id == 2 then return 50, 1 end
        return mock.secret(1), mock.secret(2)
    end)
    expect({ toyCooldown(1) }).toEqual({ 50, 120 })
    expect({ toyCooldown(2) }).toEqual({ 0, 0 })
    expect({ toyCooldown(3) }).toEqual({ 0, 0 })
end

--------------------------------------------------------------------------------
-- The Mounts tab
--------------------------------------------------------------------------------

@test("Mounts: the strip of yours first, the first chosen on the stage with its card; the count; the foot")
local function mountsTab()
    open()
    expect(ui().window).toBeShown()
    local list = cells()
    expect(#list).toBe(4)
    expect(assert(list[1].entry).name).toBe("Swift Ram")
    expect(list[1].star).toBeShown()
    expect(list[1].jewel).toBeShown()
    expect(list[4].icon:IsDesaturated()).toBe(true)
    expect(assert(M.chosen).name).toBe("Swift Ram")
    expect(ui().card.name:GetText()).toBe("Swift Ram")
    expect(ui().card.status:GetText()).toBe("Collected · before SuuUI")
    expect(ui().tools.count:GetText():find("^3 ") ~= nil).toBe(true)
    expect(ui().foot:GetText():find("Mounts") ~= nil).toBe(true)
    expect(ui().last:GetText()).toBe("Nothing collected yet")
    -- the card: the chosen one's source
    mock.click(list[2])
    expect(assert(M.chosen).name).toBe("Brown Horse")
    local texts: string[] = {}
    for _, t in ipairs(ui().card.texts) do if t:IsShown() then texts[#texts + 1] = t:GetText() end end
    expect(texts[1]).toBe("Sold by")
    -- a mount without any source: the game's kind
    mock.click(list[4])
    expect(ui().card.texts[1]:GetText()).toBe(BATTLE_PET_SOURCE_2 or "Source unknown")
    -- the last collected in the foot
    M:NoteLast("Brown Horse", time())
    M:DrawFoot()
    expect(ui().last:GetText():find("Brown Horse") ~= nil).toBe(true)
end

@test("a cell's tooltip: the name, collected, its source; hovered and new ones look so")
local function cellTips()
    local shown = captureTooltips()
    open()
    local b = cells()[2]
    mock.hover(b)
    expect(shown().title).toBe("Brown Horse")
    expect(shown().description).toBe("Vendor · Vendor Brom, Elwynn Forest +1")
    mock.hover(nil)
    -- a new one (this week): its diamond
    assert(b.entry).learned = time() - 60
    M:DrawCell(b)
    expect(b.fresh).toBeShown()
    -- an empty cell
    b.entry = nil
    mock.hover(b)
    mock.hover(nil)
end

@test("paging: 36 a page, the arrows, the wheel; the search and the filters; nothing left: the stage says so")
local function paging()
    for i = 1, 40 do mount(1000 + i, ("Test Mount %02d"):format(i)) end
    mock.setMounts(MOUNTS)
    open()
    expect(M.pages).toBe(2)
    expect(ui().strip.next).toBeShown()
    expect(ui().strip.pageText:GetText()).toBe("1 / 2")
    mock.click(ui().strip.next)
    expect(M.page).toBe(2)
    expect(#cells()).toBe(44 - 36)
    mock.click(ui().strip.prev)
    expect(M.page).toBe(1)
    mock.script(ui().strip, "OnMouseWheel", -1)
    expect(M.page).toBe(2)
    mock.script(cells()[1], "OnMouseWheel", 1)
    expect(M.page).toBe(1)
    M:Page(-5)
    expect(M.page).toBe(1)
    -- the search
    ui().tools.search:SetValue("ram")
    assert(ui().tools.search.onTextChanged)("ram")
    expect(#cells()).toBe(1)
    -- not collected only
    ui().tools.search:SetValue("")
    assert(ui().tools.search.onTextChanged)("")
    ui().tools.have:SetValue("missing")
    assert(ui().tools.have.onChange)("missing")
    expect(#cells()).toBe(1)
    expect(assert(cells()[1].entry).name).toBe("Zebra")
    -- favourites, then nothing
    ui().tools.have:SetValue("all")
    ui().tools.list:SetValue("fav")
    assert(ui().tools.list.onChange)("fav")
    expect(#cells()).toBe(1)
    ui().tools.search:SetValue("zzz")
    assert(ui().tools.search.onTextChanged)("zzz")
    expect(#cells()).toBe(0)
    expect(ui().strip.empty:GetText()).toBe("No mounts match.")
    expect(ui().stage.empty).toBeShown()
    expect(ui().stage.empty.title:GetText()).toBe("No mounts match")
    expect(ui().card).never.toBeShown()
end

@test("the model: the icon while it loads, then placed on the floor and shown; the same one again is left; no answer: shown anyway")
local function modelLoads()
    open()
    local m = ui().model
    local stage = ui().stage
    expect(stage.loading).toBeShown()
    mock.stub(m, "GetCameraPosition", function(): ...unknown return 6, 0, 1.2 end)
    mock.stub(m, "GetCameraTarget", function(): ...unknown return 0, 0, 1 end)
    mock.stub(m, "GetModelFileID", function() return 123410 end)
    local placed = mock.stub(m, "SetPosition", function() end)
    mock.script(m, "OnModelLoaded")
    mock.advanceTime(0.2)
    expect(stage.loading).never.toBeShown()
    expect(placed).toHaveBeenCalled()
    expect(m:GetAlpha() > 0).toBe(true)
    -- the same mount again: left as it is
    M:ShowMount(assert(M.chosen))
    expect(stage.loading).never.toBeShown()
    -- another, with no answer: shown after two seconds
    mock.click(cells()[2])
    expect(stage.loading).toBeShown()
    mock.advanceTime(2.2)
    expect(stage.loading).never.toBeShown()
    -- a camera that can't be read, or reads nothing useful: not placed
    mock.resetSpies()
    mock.stub(m, "GetCameraPosition", function(): ...unknown return mock.secret(1), 0, 0 end)
    M:PlaceModel()
    mock.stub(m, "GetCameraPosition", function(): ...unknown return 0, 0, 1 end)
    M:PlaceModel()
    expect(placed).never.toHaveBeenCalled()
    M:ModelLoaded()
end

@test("turning and zooming the mount: drag, the wheel, the stage's buttons")
local function turnZoom()
    open()
    local m = ui().model
    local facing = mock.stub(m, "SetFacing", function() end)
    mock.setCursorPosition(100, 100)
    mock.script(m, "OnMouseDown", "LeftButton")
    mock.setCursorPosition(160, 100)
    mock.nextFrame()
    expect(facing).toHaveBeenCalled()
    mock.script(m, "OnMouseUp", "LeftButton")
    mock.script(m, "OnMouseDown", "RightButton")
    mock.resetSpies()
    mock.nextFrame()
    expect(facing).never.toHaveBeenCalled()
    local before = M.camScale
    mock.script(m, "OnMouseWheel", 1)
    expect(M.camScale < before).toBe(true)
    for _ = 1, 20 do M:Zoom(1) end
    mock.advanceTime(0.1)
    local buttons = ui().stage.buttons
    for _, b in ipairs(buttons) do mock.click(b) end
    expect(facing).toHaveBeenCalled()
    -- their look and tooltips
    mock.hover(buttons[1])
    expect(tokenOf(buttons[1].glyph)).toBe("ink")
    mock.hover(nil)
    expect(tokenOf(buttons[1].glyph)).toBe("ink-muted")
end

@test("Summon: the mount's spell on SuuUI's secure button; why it's off; mounted, Dismiss; in combat it waits")
local function summon()
    open()
    local act = ui().act
    expect(act.look.label:GetText()).toBe("Summon")
    expect(act:GetAttribute("type")).toBe("spell")
    expect(act:GetAttribute("spell")).toBe(1020)
    -- not yours
    M:Choose(M:Mounts()[4])
    expect(act.why).toBe("You don't have this mount yet.")
    expect(act:GetAttribute("type")).toBe(nil)
    local shown = captureTooltips()
    mock.hover(act)
    expect(shown().description).toBe("You don't have this mount yet.")
    mock.hover(nil)
    -- mounted: Dismiss
    mounted = true
    mock.fireEvent("PLAYER_MOUNT_DISPLAY_CHANGED")
    expect(act.look.label:GetText()).toBe("Dismiss")
    expect(act:GetAttribute("macrotext")).toBe("/dismount")
    -- in combat: the look now, the button after
    mounted = false
    mock.player:enterCombat()
    mock.fireEvent("MOUNT_JOURNAL_USABILITY_CHANGED")
    expect(act.look.label:GetText()).toBe("Summon")
    expect(act:GetAttribute("macrotext")).toBe("/dismount")
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(M.actionAfterCombat).toBe(false)
end

-- Three toys: the drum yours, the wand yours (a favourite, not usable
-- here), the kite not yet. The game's toy tooltip has only the name: what
-- a toy does is the test's.
local function toyData()
    mock.defineItem(201, { name = "Toy Drum", icon = 134201 })
    mock.defineItem(202, { name = "Bubble Wand", icon = 134202 })
    mock.defineItem(203, { name = "Kite", icon = 134203 })
    mock.setToys({ [201] = {}, [202] = { favorite = true, usable = false }, [203] = { collected = false } })
    mock.stub(C_TooltipInfo, "GetToyByItemID", function(id: number): unknown
        if id == 201 then return { lines = { { leftText = "Toy Drum" }, { leftText = "Use: Plays a drum." } } } end
        return { lines = {} }
    end)
end

@test("the favourite star: a mount's by its place in the game's list; a toy's; an appearance's")
local function favourites()
    open()
    mock.click(cells()[2])
    expect(assert(M.chosen).name).toBe("Brown Horse")
    mock.click(ui().stage.star)
    expect(select(7, C_MountJournal.GetMountInfoByID(101))).toBe(true)
    mock.advanceTime(0.2)
    toyData()
    M.chosen = entry({ kind = "toy", itemID = 201, favourite = false })
    M:ToggleFavourite()
    expect(C_ToyBox.GetIsFavorite(201)).toBe(true)
    M.chosen = entry({ kind = "appearance", visualID = 11257, favourite = false })
    M:ToggleFavourite()
    expect(C_TransmogCollection.GetIsAppearanceFavorite(11257)).toBe(true)
    -- a mount the game's list doesn't show (not yours), or nothing chosen: nothing
    M.chosen = entry({ kind = "mount", id = 103 })
    M:ToggleFavourite()
    M.chosen = nil
    M:ToggleFavourite()
    expect(select(7, C_MountJournal.GetMountInfoByID(103))).toBe(false)
    mock.advanceTime(0.2)
    -- the star's tooltip
    local shown = captureTooltips()
    M:Refresh()
    mock.hover(nil)
    mock.hover(ui().stage.star)
    expect(shown().title).toBe(ui().stage.star.on and "Remove from favourites" or "Add to favourites")
    mock.hover(nil)
end

--------------------------------------------------------------------------------
-- The Toys tab
--------------------------------------------------------------------------------

@test("Toys: a card each with what it does, where it comes from, Use on SuuUI's secure button; yours first")
local function toysTab()
    toyData()
    open("toys")
    expect(ui().shelf).toBeShown()
    expect(ui().stage).never.toBeShown()
    local cards = ui().shelf.cards
    expect(cards[1].name:GetText()).toBe("Bubble Wand")
    expect(cards[2].name:GetText()).toBe("Toy Drum")
    expect(cards[2].use:GetText()).toBe("Plays a drum.")
    expect(cards[2].src:GetText()).toBe("From a holiday")
    expect(cards[2].check).toBeShown()
    expect(cards[2].act:GetAttribute("type")).toBe("toy")
    expect(cards[2].act:GetAttribute("toy")).toBe(201)
    -- not usable here; not yours
    expect(cards[1].act.why).toBe("You can't use this toy here.")
    expect(cards[3].act.why).toBe("You don't have this toy yet.")
    expect(cards[3].act:GetAttribute("type")).toBe(nil)
    expect(tokenOf(cards[3].name)).toBe("ink-muted")
    -- the first filter's label follows the tab
    expect(ui().tools.list.buttons[1].label:GetText()).toBe("Toys")
    -- a card's tooltip: all of its source
    local shown = captureTooltips()
    mock.hover(cards[2])
    expect(shown().title).toBe("Toy Drum")
    expect(shown().description).toBe("Plays a drum.")
    expect(assert(shown().lines)[1][1]).toBe("In the game")
    mock.hover(nil)
    mock.hover(cards[3])
    expect(assert(shown().lines)[1][1]).toBe("Source unknown")
    mock.hover(nil)
    -- Use's tooltip says why
    mock.hover(cards[3].act)
    expect(shown().description).toBe("You don't have this toy yet.")
    mock.hover(nil)
    -- nothing matches
    ui().tools.search:SetValue("zzz")
    assert(ui().tools.search.onTextChanged)("zzz")
    expect(ui().shelf.empty).toBeShown()
end

@test("a toy on cooldown: when it's ready, again each second and when the game says; its star; in combat the buttons wait")
local function toyCooldowns()
    toyData()
    open("toys")
    local drum = ui().shelf.cards[2]
    mock.setItemCooldown(201, 600)
    expect(drum.src:GetText()).toBe("Ready in 10 min")
    mock.advanceTime(1.1)
    expect(drum.src:GetText()).toBe("Ready in 10 min")
    expect(tokenOf(drum.src)).toBe("arcane")
    expect(drum.act.why).toBe("Ready in 10 min.")
    mock.setItemCooldown(201, 0)
    expect(drum.src:GetText()).toBe("From a holiday")
    -- the star: yours only
    mock.click(drum.star)
    expect(C_ToyBox.GetIsFavorite(201)).toBe(true)
    mock.click(ui().shelf.cards[3].star)
    expect(C_ToyBox.GetIsFavorite(203)).toBe(false)
    mock.advanceTime(0.2)
    -- in combat: drawn, the secure part after
    mock.player:enterCombat()
    M:Refresh()
    expect(M.shelfAfterCombat).toBe(true)
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(M.shelfAfterCombat).toBe(false)
end

--------------------------------------------------------------------------------
-- The Appearances tab
--------------------------------------------------------------------------------

local function slotButton(slot: string): SlotButton
    for _, b in ipairs(ui().wardrobe.slots) do if b.slot == slot then return b end end
    error("no slot " .. slot)
end

@test("Appearances: the doll, the slots with yours of all, the chest's tiles; one chosen tried on with its card")
local function wardrobe()
    wardrobeData()
    mock.defineItem(60, { name = "Silk Tunic", quality = 2, equipLoc = "INVTYPE_CHEST" })
    open("wardrobe")
    expect(ui().wardrobe).toBeShown()
    expect(ui().tools.title:GetText()).toBe("Chest")
    expect(slotButton("CHESTSLOT").n:GetText()).toBe("2/" .. CHEST_ALL)
    expect(slotButton("RANGEDSLOT").n:GetText()).toBe("—")
    expect(slotButton("CHESTSLOT").glow).toBeShown()
    M:LayoutTiles()
    local tiles = ui().strip.tiles
    expect(tiles[1]).toBeShown()
    expect(tiles[1].worn).toBeShown()
    expect(tiles[3].star).toBeShown()
    expect(tiles[4]).toBeShown()
    -- the first is chosen and tried on, its card with Worn
    expect(assert(M.chosen).visualID).toBe(63240)
    expect(ui().card.extra:GetText()).toBe("Worn")
    local try = mock.stub(ui().wardrobe.doll, "TryOn", function() end)
    mock.click(tiles[2])
    expect(try).toHaveBeenCalledWith(ui().wardrobe.doll, 156056)
    expect(tokenOf(ui().card.name)).toBe("quality-epic")
    -- a tile's tooltip
    local shown = captureTooltips()
    mock.hover(tiles[4])
    expect(shown().subtitle).toBe("Not collected")
    expect(shown().titleColor).toBe("quality-uncommon")
    expect(tiles[4].dim).never.toBeShown()
    mock.hover(nil)
    expect(tiles[4].dim).toBeShown()
    -- the tile's model loaded, or after two seconds
    mock.script(tiles[1].model, "OnModelLoaded")
    expect(tiles[1].icon).never.toBeShown()
    mock.advanceTime(2.1)
    -- Undress: back to what you wear
    local dress = mock.stub(ui().wardrobe.doll, "Dress", function() end)
    mock.click(ui().wardrobe.undress)
    expect(dress).toHaveBeenCalled()
    expect(M.tried).toBe(nil)
    -- the tiles' page by the wheel
    mock.script(tiles[1], "OnMouseWheel", -1)
    -- no Summon here
    mock.fireEvent("PLAYER_MOUNT_DISPLAY_CHANGED")
    expect(ui().act).never.toBeShown()
end

@test("a slot: hover says yours of all or why not; a click chooses it; a weapon slot's kind; the class")
local function wardrobeSlots()
    wardrobeData()
    open("wardrobe")
    local shown = captureTooltips()
    mock.hover(slotButton("CHESTSLOT"))
    expect(shown().description).toBe("2 of " .. CHEST_ALL .. " collected")
    mock.hover(slotButton("RANGEDSLOT"))
    expect((shown().description or ""):find("^No ranged weapons for ") ~= nil).toBe(true)
    mock.hover(nil)
    -- a slot without a kind: not chosen
    mock.click(slotButton("RANGEDSLOT"))
    expect(M.slot).toBe("CHESTSLOT")
    -- the main hand: its kind chosen, shown in the title
    mock.click(slotButton("MAINHANDSLOT"))
    expect(M.slot).toBe("MAINHANDSLOT")
    expect(ui().tools.title:GetText()).toBe("Main hand · One-Handed Swords")
    expect(ui().wardrobe.kind).toBeShown()
    assert(ui().wardrobe.kind.onChange)(15)
    expect(M.weaponKind.main).toBe(15)
    -- the class
    assert(ui().wardrobe.class.onChange)(2)
    expect(C_TransmogCollection.GetClassFilter()).toBe(2)
    expect(M.slotCounts ~= nil).toBe(true)
    -- the doll turns and zooms
    local d = ui().wardrobe.doll
    local facing = mock.stub(d, "SetFacing", function() end)
    M:Turn(1)
    expect(facing).toHaveBeenCalled()
    for _ = 1, 15 do M:Zoom(1) end
    expect(M.dollScale).toBe(2.5)
    for _ = 1, 15 do M:Zoom(-1) end
    expect(M.dollScale).toBe(0.6)
    mock.setCursorPosition(100, 100)
    mock.script(d, "OnMouseDown", "LeftButton")
    mock.setCursorPosition(130, 100)
    mock.nextFrame()
    mock.script(d, "OnMouseUp", "LeftButton")
    mock.script(d, "OnMouseWheel", 1)
    M.slot = "CHESTSLOT"
end

--------------------------------------------------------------------------------
-- Opening it, the game's news, off
--------------------------------------------------------------------------------

@test("opening: SuuUI's toggle, the game's Collections key, the game's journal closed for ours")
local function opening()
    M:Toggle()
    expect(ui().window).toBeShown()
    M:Toggle()
    expect(ui().window).never.toBeShown()
    -- the key: an override onto SuuUI's button
    SetBinding("SHIFT-P", "TOGGLECOLLECTIONS")
    mock.fireEvent("UPDATE_BINDINGS")
    mock.setModifiers({ shift = true })
    mock.pressKey("P")
    mock.setModifiers({})
    expect(ui().window).toBeShown()
    ui().window:Hide()
    -- in combat the keys wait
    mock.player:enterCombat()
    M:BindKeys()
    expect(M.bindAfterCombat).toBe(true)
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(M.bindAfterCombat).toBe(false)
    -- the game's journal opened by something else
    C_AddOns.LoadAddOn("Blizzard_Collections")
    mock.advanceTime(0.1)
    ShowUIPanel(assert(frames.find("CollectionsJournal")))
    mock.advanceTime(0.1)
    expect(frames.find("CollectionsJournal")).never.toBeShown()
    expect(ui().window).toBeShown()
    expect(SuuUI.CollectionsShown()).toBe(true)
end

@test("the game's news: a new mount or toy noted and drawn; names arriving; the wardrobe changing; a theme")
local function news()
    open()
    local refresh = mock.stub(M, "Refresh")
    mock.fireEvent("NEW_MOUNT_ADDED", 101)
    expect(assert(M:Saved().last).name).toBe("Brown Horse")
    expect(refresh).toHaveBeenCalled()
    toyData()
    mock.advanceTime(1)
    mock.fireEvent("NEW_TOY_ADDED", 201)
    expect(assert(M:Saved().last).name).toBe("Toy Drum")
    mock.resetSpies()
    mock.fireEvent("TOYS_UPDATED", 201, false, false)
    expect(refresh).toHaveBeenCalled()
    -- names the game sends: drawn once, a moment later
    mock.resetSpies()
    M.namesPending = true
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 202, true)
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 203, true)
    expect(refresh).never.toHaveBeenCalled()
    mock.advanceTime(0.4)
    expect(refresh).toHaveBeenCalledTimes(1)
    mock.resetSpies()
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 204, true)
    expect(refresh).never.toHaveBeenCalled()
    -- the wardrobe
    M.tab = "wardrobe"
    M.slotCounts = {}
    mock.fireEvent("TRANSMOG_COLLECTION_UPDATED", nil, nil, nil, nil)
    expect(M.slotCounts).toBeNil()
    mock.fireEvent("PLAYER_EQUIPMENT_CHANGED", 5, false)
    expect(ui().wardrobe.doll.dressed).toBe(false)
    expect(refresh).toHaveBeenCalledTimes(2)
    M.tab = "mounts"
    events.emit("SUUUI_THEME_CHANGED", "suuui")
    expect(refresh).toHaveBeenCalledTimes(3)
end

@test("off: the window closes, the key goes back to the game's")
local function off()
    open()
    M:OnDisable()
    expect(ui().window).never.toBeShown()
end
