-- Units/Collections: SuuUI's collections window. Where something comes
-- from (a line and a card, from SuuUI's generated sources or the game's
-- source kind); the mounts, toys and appearances it lists, yours first;
-- the day SuuUI first saw one of yours; the Mounts tab (the strip, paging,
-- the search and filters, the stage with the model, the card, Summon or
-- Dismiss, the favourite star); the Toys shelf (what a toy does, its
-- cooldown, Use); Appearances (the doll's slots, the weapon kinds, the
-- tiles, trying one on); the foot; opening it (the key, the game's
-- journal); the game's news.
--
-- What each part does alone is tested beside it (tests/unit/Units/Collections/:
-- Sources, Catalog, Actions, Stage, Gifts, Strip, Wardrobe, Shelf); the
-- shared setup is CollectionsHelpers there.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as events from "/Core/Events"
import internal M from "/Units/Collections"
import day, status from "/Units/Collections/Catalog"
import * as frames from "wowlua:frames"
import start, cleanup, entry, open, ui, cells, toyData, petJournal from "./Collections/CollectionsHelpers"

@beforeEach
local function setUp()
    start()
end

@afterEach
local function tearDown()
    cleanup()
end

@test(
    "the day SuuUI first saw one of yours: what you had before SuuUI is from before; later ones dated; the last collected"
)
local function learned()
    expect(M:Learned("mount", 1, true)).toBe(0)
    expect(M:Learned("mount", 1, false)).toBe(nil)
    mock.advanceTime(10)
    local now = time()
    expect(M:Learned("mount", 2, true)).toBe(now)
    expect(M:Learned("mount", 2, true)).toBe(now)
    expect(day(nil)).toBe(nil)
    expect(day(0)).toBe("before SuuUI")
    expect(day(now)).toBe((date("%d %b", now):gsub("^0", "")))
    expect({ status(entry({ collected = false })) }).toEqual({ "Not collected", "ink-faint" })
    expect({ status(entry({ collected = true, learned = 0 })) }).toEqual({ "Collected · before SuuUI", "gilt-text" })
    expect({ status(entry({ collected = true })) }).toEqual({ "Collected", "gilt-text" })
    M:NoteLast("Brown Horse", 100)
    M:NoteLast("Older", 50)
    M:NoteLast(nil, 200)
    M:NoteLast("Nothing", 0)
    expect(M:CharData().last).toEqual({ name = "Brown Horse", at = 100 })
end

--------------------------------------------------------------------------------
-- The Mounts tab
--------------------------------------------------------------------------------

@test("Mounts: the strip of yours first, the first chosen on the stage with its card; the count; the foot")
local function mountsTab()
    open()
    expect(ui().window).toBeShown()
    local list = cells()
    expect(#list).toBe(4)
    expect(assert(list[1].entry).name).toBe("Swift Ram")
    expect(list[1].star).toBeShown()
    expect(list[1].jewel).toBeShown()
    expect(list[4].icon:IsDesaturated()).toBe(true)
    expect(assert(M.chosen).name).toBe("Swift Ram")
    expect(ui().card.name:GetText()).toBe("Swift Ram")
    expect(ui().card.status:GetText()).toBe("Collected · before SuuUI")
    expect(mock.textOf(ui().tools.count):find("^3 ") ~= nil).toBe(true)
    expect(mock.textOf(ui().foot):find("Mounts") ~= nil).toBe(true)
    expect(ui().last:GetText()).toBe("Nothing collected yet")
    -- the card: the chosen one's source
    mock.click(list[2])
    expect(assert(M.chosen).name).toBe("Brown Horse")
    local texts: string[] = {}
    for _, t in ipairs(ui().card.texts) do
        if t:IsShown() then
            texts[#texts + 1] = mock.textOf(t)
        end
    end
    expect(texts[1]).toBe("Sold by")
    -- a mount without any source: the game's kind
    mock.click(list[4])
    expect(ui().card.texts[1]:GetText()).toBe(BATTLE_PET_SOURCE_2 or "Source unknown")
    -- the last collected in the foot
    M:NoteLast("Brown Horse", time())
    M:DrawFoot()
    expect(mock.textOf(ui().last):find("Brown Horse") ~= nil).toBe(true)
end

--------------------------------------------------------------------------------
-- Opening it, the game's news, off
--------------------------------------------------------------------------------

@test("opening: SuuUI's toggle, the game's Collections key, the game's journal closed for ours")
local function opening()
    M:Toggle()
    expect(ui().window).toBeShown()
    M:Toggle()
    expect(ui().window).never.toBeShown()
    -- the key: an override onto SuuUI's button
    SetBinding("SHIFT-P", "TOGGLECOLLECTIONS")
    mock.fireEvent("UPDATE_BINDINGS")
    mock.setModifiers({ shift = true })
    mock.pressKey("P")
    mock.setModifiers({})
    expect(ui().window).toBeShown()
    ui().window:Hide()
    -- in combat the keys wait
    mock.player:enterCombat()
    M:BindKeys()
    expect(M.bindAfterCombat).toBe(true)
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(M.bindAfterCombat).toBe(false)
    -- the game's journal opened by something else
    C_AddOns.LoadAddOn("Blizzard_Collections")
    mock.advanceTime(0.1)
    ShowUIPanel(assert(frames.find("CollectionsJournal")))
    mock.advanceTime(0.1)
    expect(frames.find("CollectionsJournal")).never.toBeShown()
    expect(ui().window).toBeShown()
    expect(SuuUI.CollectionsShown()).toBe(true)
end

@test(
    "in a fight: opened by its toggle, the tools left where they stand till after; Escape closes it (found in game: blocked)"
)
local function combatWindow()
    -- (out of combat: the tools over the strip, for Mounts)
    open("mounts")
    ui().window:Hide()
    mock.advanceTime(0.1)
    expect(M.toolsFor).toBe(false)
    M.tab = "toys"
    mock.player:enterCombat()
    mock.click(rawget(_G, "SuuUICollectionsToggle") :: Button)
    mock.advanceFrames(2)
    expect(ui().window).toBeShown()
    -- Toys wants them over the shelf: after the fight
    expect(M.toolsFor).toBe(false)
    expect(M.layoutAfterCombat).toBe(true)
    -- Escape: the window's secure binding, not the game's UISpecialFrames
    expect(tContains(UISpecialFrames, "SuuUICollectionsWindow")).toBe(false)
    mock.pressKey("ESCAPE")
    mock.advanceFrames(2)
    expect(ui().window).never.toBeShown()
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(M.toolsFor).toBe(true)
    -- Escape unbound again once it's closed: the game menu's
    expect(GetBindingAction("ESCAPE", true)).never.toBe("CLICK SuuUICollectionsWindowEscape:LeftButton")
    M.tab = "mounts"
end

@test(
    "in a fight the tabs still swap the page: Pets or Mounts to Toys and back, through their secure buttons (found in game)"
)
local function combatTabs()
    open("mounts")
    expect(ui().stage).toBeShown()
    expect(ui().shelf).never.toBeShown()
    mock.player:enterCombat()
    mock.click(assert(M.secureTabs.toys))
    mock.advanceFrames(2)
    expect(M.tab).toBe("toys")
    expect(ui().shelf).toBeShown()
    expect(ui().stage).never.toBeShown()
    expect(ui().strip).never.toBeShown()
    -- the tools can't move in a fight: unseen till they can
    expect(ui().tools:GetAlpha()).toBe(0)
    -- no toy cards made yet (their Use is secure: made after the fight): said so
    local cards = ui().shelf.cards
    rawset(ui().shelf :: {}, "cards", {})
    M.entries = { entry({ kind = "toy", itemID = 201 }) }
    M:DrawShelf()
    expect(ui().shelf.empty).toBeShown()
    expect(ui().shelf.empty).toHaveText("Your toys show once this fight is over.")
    rawset(ui().shelf :: {}, "cards", cards)
    mock.click(assert(M.secureTabs.mounts))
    mock.advanceFrames(2)
    expect(M.tab).toBe("mounts")
    expect(ui().stage).toBeShown()
    expect(ui().shelf).never.toBeShown()
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(ui().tools:GetAlpha()).toBe(1)
    -- (a disabled tab gets none: its cover says why)
    expect(M.secureTabs.heirlooms).toBeNil()
    -- out of a fight too, through Pets and Appearances and back: the tools
    -- keep their place and the stage its height (found in game: the tools lost
    -- their anchors, the stage was 0 high)
    for _, key in ipairs({ "pets", "wardrobe", "toys", "mounts" }) do
        mock.click(assert(M.secureTabs[key]))
        mock.advanceFrames(2)
        expect(ui().tools:GetNumPoints() > 0).toBe(true)
    end
    expect(ui().stage:GetHeight() > 0).toBe(true)
    expect(assert(ui().tools:GetBottom()) > assert(ui().strip:GetTop())).toBe(true)
end

@test("the game's news: a new mount or toy noted and drawn; names arriving; the wardrobe changing; a theme")
local function news()
    open()
    local refresh = mock.stub(M, "Refresh")
    mock.fireEvent("NEW_MOUNT_ADDED", 101)
    expect(assert(M:Saved().last).name).toBe("Brown Horse")
    expect(refresh).toHaveBeenCalled()
    toyData()
    mock.advanceTime(1)
    mock.fireEvent("NEW_TOY_ADDED", 201)
    expect(assert(M:Saved().last).name).toBe("Toy Drum")
    mock.resetSpies()
    mock.fireEvent("TOYS_UPDATED", 201, false, false)
    expect(refresh).toHaveBeenCalled()
    -- names the game sends: drawn once, a moment later
    mock.resetSpies()
    M.namesPending = true
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 202, true)
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 203, true)
    expect(refresh).never.toHaveBeenCalled()
    mock.advanceTime(0.4)
    expect(refresh).toHaveBeenCalledTimes(1)
    mock.resetSpies()
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 204, true)
    expect(refresh).never.toHaveBeenCalled()
    -- the wardrobe
    M.tab = "wardrobe"
    M.slotCounts = {}
    mock.fireEvent("TRANSMOG_COLLECTION_UPDATED", nil, nil, nil, nil)
    expect(M.slotCounts).toBeNil()
    mock.fireEvent("PLAYER_EQUIPMENT_CHANGED", 5, false)
    expect(ui().wardrobe.doll.dressed).toBe(false)
    expect(refresh).toHaveBeenCalledTimes(2)
    M.tab = "mounts"
    events.emit("SUUUI_THEME_CHANGED", "suuui")
    expect(refresh).toHaveBeenCalledTimes(3)
end

@test("off: the window closes, the key goes back to the game's")
local function off()
    open()
    M:OnDisable()
    expect(ui().window).never.toBeShown()
end

--------------------------------------------------------------------------------
-- The Pets tab
--------------------------------------------------------------------------------

@test(
    "the Pets tab: the pet on the stage, its card; Summon and Dismiss; the star; a random favourite; shift-click links it"
)
local function petsTab()
    local calls = petJournal()
    open("pets")
    local e = assert(M.chosen)
    expect(e.name).toBe("Mechanical Squirrel")
    expect(ui().model).toBeShown()
    -- the card: where it comes from, what it is
    local texts: string[] = {}
    for _, t in ipairs(ui().card.texts) do
        if t:IsShown() then
            texts[#texts + 1] = t:GetText() or ""
        end
    end
    expect(texts).toEqual({ "Where it comes from", "Profession: Engineering", "About", "A small friend." })
    -- Summon (no secure action: not protected), then Dismiss
    local act = ui().act
    expect(act.look.label:GetText()).toBe("Summon")
    expect(act:GetAttribute("type")).toBeNil()
    mock.click(act)
    expect(calls.summoned).toBe("Pet-A")
    mock.fireEvent("COMPANION_UPDATE", "CRITTER")
    expect(act.look.label:GetText()).toBe("Dismiss")
    mock.click(act)
    expect(calls.summoned).toBeNil()
    -- the star: a favourite (one of its copies) unmarked
    mock.click(ui().stage.star)
    expect(calls.favourite).toEqual({ { "Pet-A", 0 } })
    mock.advanceTime(0.2)
    -- the journal locked (found in game on Forever): the star faint, saying
    -- why, its click nothing
    calls.locked = true
    M:Refresh()
    expect(ui().stage.star.why).never.toBeNil()
    mock.click(ui().stage.star)
    expect(#calls.favourite).toBe(1)
    calls.locked = false
    M:Refresh()
    expect(ui().stage.star.why).toBeNil()
    -- a random favourite
    expect(ui().random).toBeShown()
    mock.click(ui().random)
    expect(calls.random).toEqual({ true })
    -- shift-click: its link in chat
    mock.fake("IsModifiedClick", function(_: string?): boolean
        return true
    end)
    mock.fake("ChatFrameUtil.InsertLink", function(link: string)
        calls.links[#calls.links + 1] = link
    end)
    mock.click(cells()[3])
    expect(calls.links).toEqual({ "|cff1eff00|Hcompanion:4|h[pet]|h|r" })
    expect(assert(M.chosen).name).toBe("Mechanical Squirrel")
    -- (not on another tab)
    open("mounts")
    expect(ui().random).never.toBeShown()
end
