@test("opening: SuuUI's toggle, the game's Collections key, the game's journal closed for ours")
local function opening()
    M:Toggle()
    expect(ui().window).toBeShown()
    M:Toggle()
    expect(ui().window).never.toBeShown()
    -- the key: an override onto SuuUI's button
    SetBinding("SHIFT-P", "TOGGLECOLLECTIONS")
    mock.fireEvent("UPDATE_BINDINGS")
    mock.setModifiers({ shift = true })
    mock.pressKey("P")
    mock.setModifiers({})
    expect(ui().window).toBeShown()
    ui().window:Hide()
    -- in combat the keys wait
    mock.player:enterCombat()
    M:BindKeys()
    expect(M.bindAfterCombat).toBe(true)
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(M.bindAfterCombat).toBe(false)
    -- the game's journal opened by something else
    C_AddOns.LoadAddOn("Blizzard_Collections")
    mock.advanceTime(0.1)
    ShowUIPanel(assert(frames.find("CollectionsJournal")))
    mock.advanceTime(0.1)
    expect(frames.find("CollectionsJournal")).never.toBeShown()
    expect(ui().window).toBeShown()
    expect(SuuUI.CollectionsShown()).toBe(true)
end

@test(
    "in a fight: opened by its toggle, the tools left where they stand till after; Escape closes it (found in game: blocked)"
)
local function combatWindow()
    -- (out of combat: the tools over the strip, for Mounts)
    open("mounts")
    ui().window:Hide()
    mock.advanceTime(0.1)
    expect(M.toolsFor).toBe(false)
    M.tab = "toys"
    mock.player:enterCombat()
    mock.click(rawget(_G, "SuuUICollectionsToggle") :: Button)
    mock.advanceFrames(2)
    expect(ui().window).toBeShown()
    -- Toys wants them over the shelf: after the fight
    expect(M.toolsFor).toBe(false)
    expect(M.layoutAfterCombat).toBe(true)
    -- Escape: the window's secure binding, not the game's UISpecialFrames
    expect(tContains(UISpecialFrames, "SuuUICollectionsWindow")).toBe(false)
    mock.pressKey("ESCAPE")
    mock.advanceFrames(2)
    expect(ui().window).never.toBeShown()
    mock.player:leaveCombat()
    mock.advanceTime(0.1)
    expect(M.toolsFor).toBe(true)
    -- Escape unbound again once it's closed: the game menu's
    expect(GetBindingAction("ESCAPE", true)).never.toBe("CLICK SuuUICollectionsWindowEscape:LeftButton")
    M.tab = "mounts"
end

@test("the game's news: a new mount or toy noted and drawn; names arriving; the wardrobe changing; a theme")
local function news()
    open()
    local refresh = mock.stub(M, "Refresh")
    mock.fireEvent("NEW_MOUNT_ADDED", 101)
    expect(assert(M:Saved().last).name).toBe("Brown Horse")
    expect(refresh).toHaveBeenCalled()
    toyData()
    mock.advanceTime(1)
    mock.fireEvent("NEW_TOY_ADDED", 201)
    expect(assert(M:Saved().last).name).toBe("Toy Drum")
    mock.resetSpies()
    mock.fireEvent("TOYS_UPDATED", 201, false, false)
    expect(refresh).toHaveBeenCalled()
    -- names the game sends: drawn once, a moment later
    mock.resetSpies()
    M.namesPending = true
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 202, true)
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 203, true)
    expect(refresh).never.toHaveBeenCalled()
    mock.advanceTime(0.4)
    expect(refresh).toHaveBeenCalledTimes(1)
    mock.resetSpies()
    mock.fireEvent("GET_ITEM_INFO_RECEIVED", 204, true)
    expect(refresh).never.toHaveBeenCalled()
    -- the wardrobe
    M.tab = "wardrobe"
    M.slotCounts = {}
    mock.fireEvent("TRANSMOG_COLLECTION_UPDATED", nil, nil, nil, nil)
    expect(M.slotCounts).toBeNil()
    mock.fireEvent("PLAYER_EQUIPMENT_CHANGED", 5, false)
    expect(ui().wardrobe.doll.dressed).toBe(false)
    expect(refresh).toHaveBeenCalledTimes(2)
    M.tab = "mounts"
    events.emit("SUUUI_THEME_CHANGED", "suuui")
    expect(refresh).toHaveBeenCalledTimes(3)
end

--------------------------------------------------------------------------------
-- Gifts: what the game wraps
--------------------------------------------------------------------------------

-- The gift icon as a texture answers it (the game's file for the path).
local function giftTexture(): number | string | nil
    local probe = UIParent:CreateTexture()
    probe:SetTexture(GIFT_ICON)
    return probe:GetTexture()
end

-- Mount 102 (the Swift Ram) wrapped until the game is told it was opened.
local function wrappedRam(): { number }
    local cleared: { number } = {}
    local unwrapped = false
    mock.fake("C_MountJournal.NeedsFanfare", function(id: number): boolean
        return id == 102 and not unwrapped
    end)
    mock.fake("C_MountJournal.GetNumMountsNeedingFanfare", function(): number
        return unwrapped and 0 or 1
    end)
    mock.fake("C_MountJournal.ClearFanfare", function(id: number)
        cleared[#cleared + 1] = id
        unwrapped = true
    end)
    return cleared
end

-- The game's present in a mount's model scene (the tests' client has no
-- model scenes): its "wrapped" actor, the unwrap playing 3 seconds.
local function fakePresent(): { file?: number, scale?: number, z?: number }
    local gift = ui().gift :: {}
    local playing = false
    -- (the game's display for it missing, as in Forever: no model)
    local actor: {
        file?: number,
        scale?: number,
        z?: number,
        GetModelFileID: () -> number?,
        SetModelByFileID: (unknown, number) -> (),
        GetPosition: () -> (number, number, number),
        SetPosition: (unknown, number, number, number) -> (),
        SetScale: (unknown, number) -> (),
        GetScale: () -> number,
    } = {
        GetModelFileID = function(): number?
            return nil
        end,
        SetModelByFileID = function(_: unknown, _id: number) end,
        GetPosition = function(): (number, number, number)
            return 0, 0, 0
        end,
        SetPosition = function(_: unknown, _x: number, _y: number, _z: number) end,
        SetScale = function(_: unknown, _k: number) end,
        GetScale = function(): number
            return 1
        end,
    }
    actor.SetPosition = function(_: unknown, _x: number, _y: number, z: number)
        actor.z = z
    end
    actor.SetScale = function(_: unknown, k: number)
        actor.scale = k
    end
    actor.GetScale = function(): number
        return actor.scale or 1
    end
    actor.SetModelByFileID = function(_: unknown, id: number)
        actor.file = id
    end
    mock.stub(gift, "GetActorByTag", function(_: unknown, tag: string): {}?
        return tag == "wrapped" and actor or nil
    end)
    mock.stub(gift, "StartUnwrapAnimation", function(_: unknown, done: () -> ())
        playing = true
        C_Timer.After(3, function()
            playing = false
            done()
        end)
    end)
    mock.stub(gift, "IsUnwrapAnimating", function(): boolean
        return playing
    end)
    -- its ground point 100 px over the frame's bottom, 20 px left of its middle
    mock.stub(gift, "Transform3DPointTo2D", function(): (number, number)
        local s = ui().gift:GetEffectiveScale()
        return (760 / 2 - 20) * s, 100 * s
    end)
    return actor
end

@test("gifts: wrapped mounts, toys and pets as the game says; counted")
local function giftsRead()
    wrappedRam()
    toyData()
    mock.setToys({ [201] = { fanfare = true }, [202] = {}, [203] = { collected = false } })
    mock.fake("C_PetJournal.PetNeedsFanfare", function(guid: string): boolean
        return guid == "BattlePet-0-1"
    end)
    mock.fake("C_PetJournal.GetNumPetsNeedingFanfare", function(): number
        return 1
    end)
    expect(wrapped("mount", 102)).toBe(true)
    expect(wrapped("mount", 101)).toBe(false)
    expect(wrapped("toy", 201)).toBe(true)
    expect(wrapped("pet", "BattlePet-0-1")).toBe(true)
    expect(wrapped("appearance", 1)).toBe(false)
    expect(giftCounts({ 201, 202, 203 })).toEqual({ mounts = 1, toys = 1, pets = 1 })
    -- yours first, the gifts first among them
    local list = M:Mounts()
    expect(list[1].name).toBe("Swift Ram")
    expect(list[1].wrapped).toBe(true)
    expect(list[2].wrapped).toBeNil()
    expect(M:Toys()[1].wrapped).toBe(true)
    expect((status(list[1]))).toBe("A gift · unwrap it")
    expect((actionLabel(false, list[1]))).toBe("Unwrap")
end

@test("a wrapped mount: the gift in the strip, the present on the stage; Unwrap opens it and the mount shows")
local function giftMount()
    local cleared = wrappedRam()
    local present = fakePresent()
    open()
    local e = assert(M.chosen)
    expect(e.name).toBe("Swift Ram")
    expect(cells()[1].icon:GetTexture()).toBe(giftTexture())
    expect(cells()[1].fresh).toBeShown()
    expect(ui().gift).toBeShown()
    -- the present's model from Forever's files (its display isn't there),
    -- stood on the floor shadow (72 px over the stage's bottom) as a mount
    expect(present.file).toBe(1401005)
    -- smaller, raised in its scene (its base off the scene's bottom edge)
    expect(present.scale).toBe(0.6)
    expect(present.z).toBeCloseTo(1 / 0.6)
    local gift, stage = ui().gift, ui().stage
    expect(assert(gift:GetBottom()) + 100).toBeCloseTo(assert(stage:GetBottom()) + 72)
    expect(assert(gift:GetLeft()) + 360).toBeCloseTo((assert(stage:GetLeft()) + assert(stage:GetRight())) / 2)
    expect(ui().model).never.toBeShown()
    expect(ui().stage.hint:GetText()).toBe("Click the gift to unwrap it")
    -- Unwrap: the secure button's action left out, the click opens it
    local act = ui().act
    expect(act.look.label:GetText()).toBe("Unwrap")
    expect(act:GetAttribute("type")).toBeNil()
    expect(assert(ui().window.tabButtons)[1].countText).toBe("1")
    -- (the mount shown after it opens, counted)
    local shows = 0
    local show = M.ShowMount
    mock.stub(M, "ShowMount", function(me: typeof(M), shown: Entry)
        shows += 1
        show(me, shown)
    end)
    mock.click(act)
    -- (the present unwraps first)
    mock.advanceTime(1)
    expect(cleared).toEqual({})
    expect(ui().gift).toBeShown()
    mock.advanceTime(2.1)
    expect(cleared).toEqual({ 102 })
    -- shown, then once more a frame later (its camera read once laid out)
    expect(shows).toBe(1)
    mock.advanceFrames(1)
    expect(shows).toBe(2)
    expect(ui().gift).never.toBeShown()
    expect(ui().model).toBeShown()
    expect(act.look.label:GetText()).toBe("Summon")
    expect(act:GetAttribute("type")).toBe("spell")
    expect(assert(ui().window.tabButtons)[1].countText).toBeNil()
end

