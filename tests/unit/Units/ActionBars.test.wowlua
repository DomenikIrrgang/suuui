-- Units/ActionBars: Blizzard's bars stood down (the main bar invisible and
-- deaf, kept so); the dock (bars 1-4, its button size, its visibility, the
-- XP bar along its foot with rested XP and its tooltip, or the watched
-- reputation at the cap); bar 1's page in its buttons' tooltips; bars 5-8
-- (shown, their columns, count, size, gap, visibility; hidden in edit
-- mode); key bindings on the bars chosen; attaching to the dock (dropped
-- on it, toggled, the dock moved by an attached bar, reset); the settings
-- rows and Keybinds; the migrations.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, SECTION, KEYBINDS from "/Units/ActionBars"
import internal migrations as settingMigrations from "/Core/Settings"
import internal moverList from "/EditMode/EditMode"
import expectNoErrors from "../../helpers"

local G: any = _G

local KEYS = { "position", "showKeys", "keyBars", "showEmpty", "showXP", "showStance", "showPet", "dockSize", "dockVisibility",
    "textSize", "showTotem", "stancePosition", "petPosition", "attachStance", "attachPet", "offStance", "offPet" }
for id = 5, 8 do
    for _, k in ipairs({ "count", "size", "gap", "vis", "attach", "off", "show", "cols", "pos" }) do KEYS[#KEYS + 1] = k .. id end
end

@afterEach
local function cleanup()
    if InCombatLockdown() then mock.player:leaveCombat() end
    mock.hover(nil)
    for _, k in ipairs(KEYS) do M:Reset(k) end
    mock.advanceFrames(2)
    expectNoErrors()
end

local function attachable(key: string): any
    for _, a in ipairs(M.attachable) do if a.key == key then return a end end
    return nil
end

local function rows(section: any): { [string]: any }
    local out: { [string]: any } = {}
    for _, g in ipairs(section.groups) do
        for _, r in ipairs(g.rows) do out[r.key or r.text or r.label] = r end
    end
    return out
end

@test("Blizzard's bars stood down: the main bar invisible and deaf, again when the game shows it")
local function blizzard()
    local main = G.MainActionBar
    expect(main:GetAlpha()).toBe(0)
    expect(main:IsMouseEnabled()).toBe(false)
    main:SetAlpha(1)
    main:Show()
    expect(main:GetAlpha()).toBe(0)
    expect(G.ActionButton1:IsMouseEnabled()).toBe(false)
    expect(G.MultiBarBottomLeft:GetAlpha() == 0 or not G.MultiBarBottomLeft:IsVisible()).toBe(true)
end

@test("the dock: bars 1-4 at its button size; stance and pet at 9/10; out of combat")
local function dock()
    local d = M.dock
    local w = d:GetWidth()
    M:Set("dockSize", 30)
    expect(d:GetWidth() > w).toBe(true)
    expect(M.bars[1].buttons[1]:GetWidth()).toBe(30)
    expect(M.stance.size).toBe(27)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    local now = d:GetWidth()
    M:Set("dockSize", 20)
    expect(d:GetWidth()).toBe(now)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(d:GetWidth() < now).toBe(true)
end

@test("the XP bar along the dock's foot, rested XP after it; off: the dock shorter; its tooltip")
local function xp()
    mock.player:setStats({ xp = 300, xpMax = 1000, restedXP = 200 })
    mock.advanceFrames(1)
    expect(M.xp:IsShown()).toBe(true)
    expect(M.xp.ghost:GetValue()).toBe(500)
    local h = M.dock:GetHeight()
    M:Set("showXP", false)
    expect(M.xp:IsShown()).toBe(false)
    expect(M.dock:GetHeight() < h).toBe(true)
    M:Set("showXP", true)
    mock.hover(M.xp)
    local tip = G.GameTooltip
    expect(tip:IsShown()).toBe(true)
    expect(G.GameTooltipTextLeft1:GetText()).toBe("Level " .. UnitLevel("player"))
    expect(G.GameTooltipTextLeft2:GetText()).toBe("300 / 1,000 XP (30%)")
    expect(G.GameTooltipTextLeft3:GetText()).toBe("Rested 200")
    mock.hover(nil)
    expect(tip:IsShown()).toBe(false)
end

@test("at the level cap: the watched reputation instead; none watched: no bar")
local function reputation()
    mock.setPlayer({ level = 60 })
    local watched: any = nil
    mock.stub(C_Reputation, "GetWatchedFactionData", function(): any return watched end)
    M:UpdateXP()
    expect(M.xpShown).toBe(false)
    watched = { name = "Stormwind", currentStanding = 4500, currentReactionThreshold = 3000, nextReactionThreshold = 9000 }
    M:UpdateXP()
    expect(M.xpShown).toBe(true)
    expect(M.xp.ghost:GetValue()).toBe(1500)
    mock.hover(M.xp)
    expect(G.GameTooltipTextLeft1:GetText()).toBe("Stormwind")
    expect(G.GameTooltipTextLeft2:GetText()).toBe("1,500 / 6,000")
    mock.hover(nil)
    mock.setPlayer({ level = 1 })
    M:UpdateXP()
end

@test("bar 1's page in its buttons' tooltips")
local function page()
    local bar = M.bars[1]
    bar.onPage(bar, 2)
    expect(bar.buttons[1].tooltipNote).toBe("Bar 1: Page 2")
    bar.onPage(bar, 1)
    -- page 1: the stance it belongs to
    expect(bar.buttons[1].tooltipNote).toBe("Bar 1: Battle Stance")
    bar.onPage(bar, 12)
    expect(bar.buttons[1].tooltipNote).toBeNil()
end

@test("bars 5-8: off until turned on; their columns, count, size, gap and visibility; hidden in edit mode")
local function freeBars()
    local bar = M.bars[5]
    expect(bar.header:IsShown()).toBe(false)
    M:Set("show5", true)
    expect(bar.header:IsShown()).toBe(true)
    M:Set("cols5", 12)
    M:Set("size5", 24)
    M:Set("gap5", 4)
    expect(bar.header:GetWidth()).toBe(12 * 24 + 11 * 4)
    M:Set("count5", 6)
    expect(bar.header:GetWidth()).toBe(6 * 24 + 5 * 4)
    M:Set("vis5", "combat")
    M:Set("pos5", { point = "TOPLEFT", x = 624, y = -208, hidden = true })
    expect(bar.header:IsShown()).toBe(false)
end

@test("key bindings on the bars chosen; off for all; the text size")
local function keys()
    M:Set("keyBars", { "1", "stance" })
    expect(M.bars[1].hotkeysShown).toBe(true)
    expect(M.bars[2].hotkeysShown).toBeFalsy()
    M:Set("showKeys", false)
    expect(M.bars[1].hotkeysShown).toBeFalsy()
    M:Set("textSize", 14)
    M:Set("showEmpty", false)
    expect(M.bars[1].buttons[1].showEmpty).toBe(false)
end

@test("attaching: a bar dropped on the dock attaches there, keeps its offset, and moves the dock when dragged; detached again")
local function attach()
    M:Set("show5", true)
    local a = attachable("5")
    local dl, db, dw, dh = SuuUI.EditMode.Rect(M.dock)
    local l, b = dl :: number, db :: number
    -- dropped above the dock's middle
    expect(M:Dropped(a, l + (dw :: number) / 2 - 10, b + (dh :: number) + 4, 20, 100)).toBe(true)
    expect(M:Get("attach5")).toBe(true)
    local off = M:Get("off5")
    expect(off.point).toBe("BOTTOM")
    expect(off.rel).toBe("TOP")
    expect(a.header:GetParent()).toBe(M.dock)
    -- dragged while attached: the dock moves by as much
    local cl, cb = SuuUI.EditMode.Rect(a.header)
    M:Dropped(a, (cl :: number) + 30, (cb :: number) + 10, 20, 100)
    expect(M:Get("position").x).toBe(30)
    -- toggled off: on its own where it was
    M:ToggleAttach(a)
    expect(M:Get("attach5")).toBe(false)
    expect(a.header:GetParent()).toBe(SuuUI.Root)
    -- far from the dock: stays free
    expect(M:Dropped(a, 10, 600, 20, 100)).toBe(false)
    -- toggled on: attached at its offset from the nearest edge (left, below)
    a.header:ClearAllPoints()
    a.header:SetPoint("TOPLEFT", M.dock, "BOTTOMLEFT", 0, -6)
    M:ToggleAttach(a)
    expect(M:Get("attach5")).toBe(true)
    expect(M:Get("off5").point).toBe("TOPLEFT")
    expect(M:Get("off5").rel).toBe("BOTTOMLEFT")
end

@test("edit mode's movers: dragging an attached bar drags the dock; Reset puts the dock back, or a free bar to its default; the toolbar's Attach/Detach")
local function movers()
    local function mover(frame: any): any
        for _, m in ipairs(moverList) do if m.frame == frame then return m end end
        return nil
    end
    M:Set("show6", true)
    local a = attachable("6")
    local m = mover(a.header)
    expect(m.dragFrame()).toBe(a.header)
    expect(m.action.label()).toBe("Attach to dock")
    m.action.onClick()
    expect(M:Get("attach6")).toBe(true)
    expect(m.action.label()).toBe("Detach")
    expect(m.dragFrame()).toBe(M.dock)
    -- attached: Reset puts the dock back
    M:Set("position", { point = "BOTTOM", x = 40, y = 28 })
    m.onReset()
    expect(M:Get("position").x).toBe(0)
    -- free: the bar back to its default place (and stance attached again)
    m.action.onClick()
    M:Set("pos6", { point = "RIGHT", x = -200, y = 0 })
    m.onReset()
    expect(M:Get("pos6").x).toBe(-52)
    local stance = mover(attachable("Stance").header)
    M:Set("attachStance", false)
    stance.onReset()
    expect(M:Get("attachStance")).toBe(true)
    m.customPlace()
end

@test("stance and pet start attached above the dock's outer edges; the pet bar while you have a pet")
local function stancePet()
    local stance, pet = attachable("Stance"), attachable("Pet")
    expect(stance.header:GetParent()).toBe(M.dock)
    expect(pet.header:GetParent()).toBe(M.dock)
    expect(pet.enabled()).toBe(true)
    M:Set("showPet", false)
    expect(pet.enabled()).toBe(false)
    expect(stance.enabled() == false or stance.enabled() == true).toBe(true)
    M:Set("showStance", false)
    M:Set("stancePosition", { point = "BOTTOM", x = -220, y = 120, hidden = true })
end

@test("the settings rows: bars 5-8's wait for the bar; Keybinds' list waits for the switch, its chips, Keybind mode")
local function settingRows()
    local r = rows(SECTION)
    local off, why = r.vis5.disabled()
    expect(off).toBe(true)
    expect(why).toBe("Turn the bar on first.")
    M:Set("show5", true)
    expect((r.vis5.disabled())).toBe(false)
    expect(r.textSize.format(12.5)).toBe("12.5px")
    local k = rows(KEYBINDS)
    expect((k.keyBars.disabled())).toBe(false)
    M:Set("showKeys", false)
    off, why = k.keyBars.disabled()
    expect(why).toBe("Turn Show key bindings on first.")
    local changed: any
    local chips = k.keyBars.build(UIParent, function(v: any) changed = v end)
    expect(chips ~= nil).toBe(true)
    local entered = mock.spy(function() end)
    mock.stub(SuuUI.KeybindMode, "Enter", entered)
    k["Keybind mode"].onClick()
    expect(entered).toHaveBeenCalled()
    expect(changed).toBeNil()
end

@test("the migrations: bars 5-8's seeding flag gone; one key toggle per bar became the list")
local function migrations()
    local found = 0
    for _, m in ipairs(settingMigrations :: any[]) do
        if m.namespace == "actionbars" and m.id == "dropSeeded" then
            found = found + 1
            local v: { [string]: any } = { seeded = true }
            m.fn(v)
            expect(v.seeded).toBeNil()
        elseif m.namespace == "actionbars" and m.id == "keyBars" then
            found = found + 1
            local v: { [string]: any } = { keys2 = false, keysPet = false }
            m.fn(v)
            expect(table.concat(v.keyBars, ",")).toBe("1,3,4,5,6,7,8,stance")
            expect(v.keys2).toBeNil()
        end
    end
    expect(found).toBe(2)
end
