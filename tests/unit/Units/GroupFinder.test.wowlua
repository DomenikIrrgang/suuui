@test("Configure: channels (Say and Yell as the chat's), languages, expiry, LookingForGroup")
local function configure()
    local got: unknown = nil
    mock.stub(LFG, "Configure", function(t: unknown) got = t end)
    M:Set("channels", { "Trade", "Say", "Yell" })
    expect(tbl.field(got, "channels")).toEqual({ Trade = true, SAY = true, YELL = true })
    M:Set("extraLanguages", { "deDE" })
    expect(tbl.field(got, "extraLanguages")).toEqual({ deDE = true })
    M:Set("joinLFG", false)
    expect(tbl.field(got, "joinLookingForGroup")).toBe(false)
    expect(tbl.field(got, "hideLookingForGroup")).toBe(false)
    M:Set("chatExpiry", 120)
    expect(tbl.field(got, "chatExpiry")).toBe(120)
    expect(tbl.field(got, "staleAfter")).toBe(300)
end

@test("the settings section: every row builds; the slider reads and writes minutes")
local function settingsSection()
    local parent = newParent(600, 400)
    local section = M:SettingsSection()
    expect(section.id).toBe("groupfinder")
    for _, g in ipairs(groupsOf(section)) do
        for _, row in ipairs(g.rows) do
            local build, get = row.build, row.get
            if build then expect(build(parent, function() end)).toBeTruthy() end
            if get then
                expect(get()).toBe(5)
                assert(row.set)(3)
                expect(M:Get("chatExpiry")).toBe(180)
                expect(assert(row.isDefault)()).toBe(false)
                assert(row.reset)()
                expect(assert(row.isDefault)()).toBe(true)
            end
        end
    end
    -- Also read without language modules: a plain line
    local lang = LFG.Lang
    local saved = lang.modules
    lang.modules = {}
    for _, g in ipairs(groupsOf(M:SettingsSection())) do
        for _, row in ipairs(g.rows) do
            if row.key == "extraLanguages" then
                local built = assert(row.build)(parent, function() end)
                local plain = built :: unknown :: { text: FontString, SetValue: (self: unknown, v: string) -> () }
                expect(plain.text:GetText()).toBe("No other language modules yet.")
                plain:SetValue("ignored")
            end
        end
    end
    -- with a Latin-script module: its chip
    lang.modules = { deDE = mock.partial({}) }
    for _, g in ipairs(groupsOf(M:SettingsSection())) do
        for _, row in ipairs(g.rows) do
            if row.key == "extraLanguages" then expect(assert(row.build)(parent, function() end)).toBeTruthy() end
        end
    end
    lang.modules = saved
    -- the preview: two notes, built once
    local p1 = M:SettingsPreview(parent)
    expect(M:SettingsPreview(parent)).toBe(p1)
    -- the theme: the plain texts fit again
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    parent:Hide()
    expect(errorsSoFar()).toEqual({})
end

