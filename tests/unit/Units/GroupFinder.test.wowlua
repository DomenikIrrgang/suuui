@test("Allowed: the tool when wanted; chat when wanted and sure enough")
local function allowed()
    local tool = entry({ sources = { tool = {} } })
    local chat = entry({ sources = { chat = { confidence = 0.6 } } })
    local chatEntry = entry({ sources = { chat = {} }, confidence = 0.8 })
    expect(M:Allowed(tool, { tool = true })).toBe(true)
    expect(M:Allowed(tool, { tool = false, chat = true })).toBe(false)
    expect(M:Allowed(chat, { chat = true, conf = 50 })).toBe(true)
    expect(M:Allowed(chat, { chat = true, conf = 70 })).toBe(false)
    expect(M:Allowed(chat, { chat = true })).toBe(true)
    expect(M:Allowed(chatEntry, { chat = true, conf = 80 })).toBe(true)
    expect(M:Allowed(entry({ sources = { chat = {} }, confidence = 0 }), { chat = true, conf = 1 })).toBe(false)
    expect(M:Allowed(chat, { chat = false })).toBe(false)
end

@test("Note: off: nothing; on: shown with its sound; held in combat and instances, the latest five")
local function note()
    local sounds = mock.stub(SuuUI.UI, "TrackerSound", function(_: string) end)
    local built = 0
    local function build(): NotificationData? built = built + 1; return { id = "n" .. built } end
    local n = M:Get("notify")
    assert(n["role"]).on = false
    M:Set("notify", n)
    M:Note("role", build)
    M:Note("nope", build)
    expect(built).toBe(0)
    M:Note("player", build)
    expect(noteAt(1).id).toBe("n1")
    expect(sounds).toHaveBeenCalledWith("chime")
    M:Note("fresh", build)
    expect(sounds).toHaveBeenCalledTimes(1)
    -- nothing to show
    M:Note("fresh", function(): NotificationData? return nil end)
    expect(#notes).toBe(2)
    -- in combat: held
    mock.player:enterCombat()
    for _ = 1, 7 do M:Note("fresh", build) end
    expect(#notes).toBe(2)
    expect(#assert(M.held)).toBe(5)
    -- runout shows in combat? no: combat false; delisted neither
    mock.player:leaveCombat()
    expect(M.held).toBeNil()
    expect(#notes).toBe(7)
    -- in an instance: held unless the kind says otherwise
    mock.enterInstance("party")
    M:Note("fresh", build)
    expect(#notes).toBe(7)
    M:Note("runout", build)
    expect(#notes).toBe(8)
    -- out again (the game's loading screen fires PLAYER_ENTERING_WORLD, which
    -- flushes; the emulator's leaveInstance doesn't, and a PLAYER_ENTERING_WORLD
    -- fired by hand trips Blizzard's arena frames: Docs/test-notes/units-social.md)
    mock.leaveInstance()
    expect(#notes).toBe(8)
    M:FlushHeld()
    expect(#notes).toBe(9)
    M:FlushHeld()
    expect(#notes).toBe(9)
end

@test("OnMatch: one note for the most telling reason the settings allow, not again within 5 minutes, never your own")
local function onMatch()
    local e = entry({ key = "Kessra", intent = "group", activities = { "dungeon:rfk" }, members = { 3, 5 },
        roles = { needed = { healer = 1 } }, leader = { name = "Kessra", class = "MAGE", level = 31 }, sources = { tool = {} } })
    entries = { e }
    M:OnMatch(entry({ key = "Me", you = true }), { MatchReason.Role })
    expect(#notes).toBe(0)
    M:OnMatch(e, { MatchReason.Zone, MatchReason.Role })
    expect(#notes).toBe(1)
    expect(noteAt(1).category).toBe("Your role is needed")
    M:OnMatch(e, { MatchReason.Role })
    expect(#notes).toBe(1)
    now = now + 301
    -- role off: the next reason
    local n = M:Get("notify")
    assert(n["role"]).on = false
    M:Set("notify", n)
    M:OnMatch(e, { MatchReason.Zone, MatchReason.Role })
    expect(noteAt(2).category).toBe("In your zone")
    -- nothing allowed: no note, not marked
    now = now + 301
    M:OnMatch(e, { MatchReason.Boss })
    expect(#notes).toBe(2)
    -- gone by the time it would show: nothing
    now = now + 301
    entries = {}
    M:OnMatch(e, { MatchReason.Zone })
    expect(#notes).toBe(2)
end

@test("MatchNote: each kind's title, body, icon and actions")
local function matchNotes()
    mock.fake("GetGeneralPlaystyleString", function(_: number): string return "Learning" end)
    mock.fake("C_QuestLog.GetTitleForQuestID", function(_: number): string? return "Blood Shards" end)
    mock.fake("GetRealZoneText", function(): string return "The Barrens" end)
    mock.stub(LFG, "Social", function(name: unknown): string? return name == "Kessra" and "guild" or (name == "Morrow" and "friend" or nil) end)
    local mage = tostring(tbl.field(_G, "LOCALIZED_CLASS_NAMES_MALE", "MAGE"))
    local g = entry({ key = "Kessra", intent = "group", activities = { "dungeon:rfk" }, members = { 3, 5 }, level = { 29 },
        quests = { 5 }, leader = { name = "Kessra", class = "MAGE", level = 31 }, roles = { needed = { healer = 1, tank = 2 } },
        sources = { tool = { playstyle = 1 }, chat = { channel = "SAY", text = "LFM" } } })
    local role = M:MatchNote("role", g)
    expect(role.id).toBe("lfg:Kessra")
    expect(role.title).toBe("Kessra needs a healer for Razorfen Kraul")
    expect(role.body).toBe("3/5 · Lvl 31 " .. mage .. " · Learning · 29+")
    expect(role.duration).toBe(12)
    expect(tostring(assert(role.icon).texture)).toContain("RoleHealer")
    expect(action(role, 1).variant).toBe("primary")
    expect(role.source).toEqual({ tool = true, channel = "Say", text = "LFM" })
    click(role, 1)
    expect(whispered[#whispered]).toBe(g)
    -- your role not among its needs: "your role", the class icon
    interest.roles = { damage = true }
    local other = M:MatchNote("role", g)
    expect(other.title).toBe("Kessra needs your role for Razorfen Kraul")
    expect(assert(other.icon).coords :: unknown).toEqual(tbl.field(_G, "CLASS_ICON_TCOORDS", "MAGE"))
    local fresh = M:MatchNote("fresh", g)
    expect(fresh.title).toBe("A group for Razorfen Kraul")
    expect(fresh.body).toBe("Kessra · 3/5 · needs 2 tanks and a healer · Learning")
    expect(fresh.actions).toBeNil()
    expect(M:MatchNote("quest", g).title).toBe("A group for Blood Shards")
    expect(M:MatchNote("quest", g).body).toBe("Razorfen Kraul · Kessra · 3/5 · a quest in your log")
    expect(M:MatchNote("zone", g).title).toBe("A group in The Barrens")
    expect(M:MatchNote("boss", g).title).toBe("A raid forming for Razorfen Kraul")
    expect(M:MatchNote("boss", g).body).toBe("Kessra · 3 of 5")
    expect(M:MatchNote("friends", g).title).toBe("Kessra’s group for Razorfen Kraul")
    expect(M:MatchNote("friends", g).body).toBe("Guild · Lvl 31 " .. mage .. " · needs 2 tanks and a healer · Learning")
    -- a player looking, from chat, no activity
    local p = entry({ key = "Morrow", intent = "player", roles = { offered = { damage = true } },
        sources = { chat = { channel = "LookingForGroup", text = "lfg" } } })
    expect(M:MatchNote("quest", p).title).toBe("Morrow is looking for a quest")
    expect(M:MatchNote("zone", p).title).toBe("Morrow is looking for a group here")
    expect(M:MatchNote("friends", p).title).toBe("Morrow is looking for a group")
    expect(M:MatchNote("friends", p).body).toBe("Friend · offers damage")
    expect(M:MatchNote("fresh", p).title).toBe("A group for your activity")
    expect(M:MatchNote("boss", p).title).toBe("A raid forming for a world boss")
    expect(M:MatchNote("role", p).title).toBe("Morrow needs your role for a group")
    local player = M:MatchNote("player", p)
    expect(player.kind).toBe("sticky")
    expect(player.duration).toBeNil()
    expect(player.title).toBe("Morrow wants your activity")
    expect(player.body).toBe("offers damage")
    expect(#assert(player.actions)).toBe(1)
    -- from the tool: Invite, which dismisses the note
    p.sources.tool = mock.partial({})
    local inv = M:MatchNote("player", p)
    expect(action(inv, 2).label).toBe("Invite")
    click(inv, 2)
    expect(invited[#invited]).toBe(p)
    expect(dismissed).toEqual({ "lfg:Morrow" })
    -- no quest at all, no zone text, no social tie
    mock.fake("GetRealZoneText", function(): unknown return nil end)
    local bare = entry({ key = "X", intent = "group" })
    expect(M:MatchNote("quest", bare).title).toBe("A group for a quest in your log")
    expect(M:MatchNote("zone", bare).title).toBe("A group in your zone")
    expect(M:MatchNote("friends", bare).title).toBe("X’s group for an activity")
    expect(M:MatchNote("friends", bare).body).toBe("")
    expect(M:MatchNote("other", bare).title).toBeNil()
end

@test("OnContacted: reposted, full or gone; nothing when off or not allowed")
local function contacted()
    mock.stub(LFG, "ContactedAt", function(key: string?): number? return key == "Kessra" and now - 180 or nil end)
    local g = entry({ key = "Kessra", intent = "group", activities = { "dungeon:rfk" }, members = { 4, 5 },
        roles = { needed = { healer = 1 } }, leader = { name = "Kessra" }, sources = { tool = {} } })
    M:OnContacted(g, "reposted")
    local d = noteAt(1)
    expect(d.id).toBe("lfg:contacted:Kessra")
    expect(d.title).toBe("Kessra posted again, still needing a healer")
    expect(d.body).toBe("Razorfen Kraul · 4/5 · you whispered 3m ago")
    click(d, 1)
    expect(whispered[#whispered]).toBe(g)
    M:OnContacted(g, "full")
    expect(noteAt(2).title).toBe("Kessra’s group for Razorfen Kraul is full")
    expect(noteAt(2).body).toBe("You whispered Kessra 3m ago.")
    M:OnContacted(g, "gone")
    expect(noteAt(3).title).toBe("Kessra delisted Razorfen Kraul")
    expect(noteAt(3).source).toBeNil()
    -- from chat, never whispered, no activity
    local c = entry({ key = "Y", sources = { chat = { confidence = 0.9 } } })
    M:OnContacted(c, "gone")
    expect(noteAt(4).title).toBe("Y stopped posting for the group")
    expect(noteAt(4).body).toBeNil()
    M:OnContacted(c, "full")
    expect(noteAt(5).title).toBe("Y’s group for its activity is full")
    M:OnContacted(c, "reposted")
    expect(noteAt(6).title).toBe("Y posted again")
    expect(noteAt(6).body).toBe("")
    -- not allowed (unsure chat), and off
    M:OnContacted(entry({ sources = { chat = { confidence = 0.1 } } }), "full")
    local n = M:Get("notify")
    assert(n["contacted"]).on = false
    M:Set("notify", n)
    M:OnContacted(g, "full")
    expect(#notes).toBe(6)
end

@test("OnStale: only with a listing or a watch; Delist and Refresh dismiss it")
local function stale()
    M:OnStale(2, 600)
    expect(#notes).toBe(0)
    mock.stub(LFG, "Watches", function(): { [string]: boolean } return { ["dungeon:rfk"] = true } end)
    M:OnStale(2, nil)
    expect(noteAt(1).title).toBe("The tool hasn’t searched yet")
    expect(noteAt(1).body).toBe("Chat stays live; the tool only searches on your click.")
    expect(#assert(noteAt(1).actions)).toBe(1)
    listing = listingOf({ activities = { "dungeon:rfk", "dungeon:sfk" } })
    M:OnStale(2, 600)
    local d = noteAt(2)
    expect(d.title).toBe("Tool results are 10 minutes old")
    expect(d.body).toBe("You’re listed for Razorfen Kraul and 1 more. Chat stays live; the tool only searches on your click.")
    local delist = mock.stub(LFG, "Delist", function(): (boolean?, unknown) return true end)
    click(d, 1)
    expect(delist).toHaveBeenCalled()
    click(d, 2)
    expect(refreshed).toEqual({ 2 })
    expect(M.searching).toBe(true)
    mock.stub(LFG, "Refresh", function(_: number?): boolean return false end)
    M.searching = nil
    click(d, 2)
    expect(M.searching).toBeNil()
    expect(dismissed).toEqual({ "lfg:stale", "lfg:stale", "lfg:stale" })
end

@test("OnExpiring: minutes left, the listing's names, Delist and Open listing (not in combat)")
local function expiring()
    M:OnExpiring(90)
    expect(#notes).toBe(0)
    listing = listingOf({ activities = { "dungeon:rfk", "dungeon:sfk" } })
    M:OnExpiring(90)
    local d = noteAt(1)
    expect(d.title).toBe("Your listing runs out in 2 minutes")
    expect(d.body).toBe("Razorfen Kraul · Shadowfang Keep")
    expect(d.remaining).toBe(90)
    M:OnExpiring(10)
    expect(noteAt(2).title).toBe("Your listing runs out in 1 minute")
    click(d, 1)
    expect(dismissed).toEqual({ "lfg:runout" })
    local macro = assert(action(d, 2).macro)
    expect(type(macro) == "function" and macro() or macro).toBe("/click LFDMicroButton\n/click LFGParentFrameTab1")
    click(d, 2)
    expect(dismissed).toEqual({ "lfg:runout", "lfg:runout" })
    mock.player:enterCombat()
    click(d, 2)
    expect(#dismissed).toBe(2)
    local printed = mock.printed()
    expect(printed[#printed]).toContain("The listing opens out of combat.")
end

@test("OnListingChanged and OnDelisted: how long, for what; not when you delisted yourself")
local function delisted()
    M:OnListingChanged(nil)
    expect(M.listedAt).toBeNil()
    local l = listingOf({ activities = { "dungeon:rfk", "dungeon:sfk" } })
    M:OnListingChanged(l)
    expect(M.listedAt).toBe(now)
    now = now + 600
    M:OnListingChanged(l)
    expect(M.listedAt).toBe(1000)
    M:OnDelisted()
    expect(dismissed).toEqual({ "lfg:runout", "lfg:stale" })
    expect(noteAt(1).title).toBe("Your listing has ended")
    expect(noteAt(1).body).toBe("Listed 10 minutes for Razorfen Kraul and Shadowfang Keep.")
    expect(M.listedAt).toBeNil()
    -- never listed (that we saw): no body; a watch keeps the stale note
    mock.stub(LFG, "Watches", function(): { [string]: boolean } return { x = true } end)
    M:OnDelisted()
    expect(noteAt(2).body).toBeNil()
    expect(dismissed).toEqual({ "lfg:runout", "lfg:stale", "lfg:runout" })
    -- your own Unlist (the game's RemoveListing): quiet
    mock.fake("C_LFGList.RemoveListing", function() end)
    M.delistedByYou = GetTime()
    M:OnListingChanged(l)
    M:OnDelisted()
    expect(#notes).toBe(2)
end

@test("the game's RemoveListing marks your own delisting")
local function removeListingHook()
    M.delistedByYou = nil
    pcall(C_LFGList.RemoveListing)
    expect(rawget(M, "delistedByYou")).toBe(GetTime())
end

@test("the library's events reach the notes and the pages")
local function libraryEvents()
    local g = entry({ key = "Kessra", intent = "group", activities = { "dungeon:rfk" }, roles = { needed = { healer = 1 } },
        leader = { name = "Kessra" }, sources = { tool = {} } })
    entries = { g }
    LFG.Fire("Match", g, { "role" })
    expect(#notes).toBe(1)
    LFG.Fire("Contacted", g, "full")
    expect(#notes).toBe(2)
    listing = listingOf({ activities = { "dungeon:rfk" } })
    LFG.Fire("ToolStale", 2, 600)
    expect(#notes).toBe(3)
    LFG.Fire("ToolSearched")
    expect(dismissed[#dismissed]).toBe("lfg:stale")
    LFG.Fire("ListingExpiring", 120)
    expect(#notes).toBe(4)
    LFG.Fire("ListingChanged", listing)
    expect(M.lastListing).toBe(listing)
    LFG.Fire("Delisted")
    expect(notes[#notes].title).toBe("Your listing has ended")
    M.searching = true
    LFG.Fire("ToolSearchFailed")
    expect(M.searching).toBeNil()
    LFG.Fire("EntryAdded", g)
    mock.advanceTime(16)
    expect(errorsSoFar()).toEqual({})
end

@test("/suu lfgnotes: one note of each kind, none of them whispering anyone")
local function testNotes()
    mock.slash("/suu lfgnotes")
    expect(#notes).toBe(7)
    local ids: string[] = {}
    for i, d in ipairs(notes) do ids[i] = tostring(d.id) end
    expect(ids).toEqual({ "lfg:Kessra:role", "lfg:Brannoc:fresh", "lfg:Dorran:zone", "lfg:Morrow:friends", "lfg:Morrow:player",
                          "lfg:test:stale", "lfg:test:delisted" })
    for _, d in ipairs(notes) do
        for _, a in ipairs(d.actions or {}) do assert(a.onClick)(mock.partial({})) end
    end
    expect(#whispered).toBe(0)
    expect(#dismissed).toBe(6)
end

@test("StartNotes runs once; OnDisable stops the library")
local function lifecycle()
    expect(M.notesOn).toBe(true)
    M:StartNotes()
    local stop = mock.stub(LFG, "Stop", function() end)
    assert(M.OnDisable)(M)
    expect(stop).toHaveBeenCalled()
    -- the 15 s tick redraws what shows
    openBrowse()
    browsePage().data = nil
    mock.advanceTime(15)
    expect(browsePage().data).toBeTruthy()
    -- a Blizzard addon loading: Build again, which does nothing once built
    local browse = M.browse
    mock.fireEvent("ADDON_LOADED", "Blizzard_Nothing", false)
    expect(M.browse).toBe(browse)
    expect(errorsSoFar()).toEqual({})
end
