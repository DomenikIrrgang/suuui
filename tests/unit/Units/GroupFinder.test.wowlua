-- Units/GroupFinder: the Group Finder module over the game's window. The
-- library (SuuUI.LFG) is faked through its own table: its entries, listing,
-- interest and tool answers are stubbed per test; the module's pages are
-- read back from what they were given (`page.data`).

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import SuuUI from "/Core/API"
import * as settings from "/Core/Settings"
import internal M from "/Units/GroupFinder"
import * as logic from "/Units/GroupFinder/Logic"
import type Interest, Listing from "foreverlfg"
import MatchReason from "foreverlfg/Interest"
import type NotificationData, NotificationAction from "/UI/Notification"
import type GroupFinderBrowse from "/UI/GroupFinder"
import type GroupFinderListed, ListedData, ListedFacts, ListedAd from "/UI/GroupFinderListed"
import type GroupFinderWho, WhoData from "/UI/GroupFinderWho"
import * as tbl from "wowlua:table"
import errorsSoFar, newParent from "../../helpers"

type Entry = logic.Entry

const ID = "groupfinder"
local LFG = SuuUI.LFG

local NAMES: { [string]: string } = { ["dungeon:rfk"] = "Razorfen Kraul", ["dungeon:sfk"] = "Shadowfang Keep",
    ["dungeon:wc"] = "Wailing Caverns", ["zone:wetlands"] = "Wetlands" }

-- the library's answers, set per test
local entries: Entry[] = {}
local listing: Listing? = nil
local interest: Interest = mock.partial({})
local reasons: { [string]: string[] } = {}
local toolAge: number? = nil
local now = 1000
local notes: NotificationData[] = {}
local dismissed: string[] = {}
local refreshed: (number?)[] = {}
local whispered: (Entry?)[] = {}
local invited: (Entry?)[] = {}

-- A record with the given fields over the defaults.
local function over<T>(defaults: { [string]: unknown }, t: { [string]: unknown }): T
    for k, v in pairs(t) do defaults[k] = v end
    return mock.partial(defaults)
end

-- An entry with the fields the library always fills.
local function entry(t: { [string]: unknown }): Entry
    local e: Entry = over({ key = "Kessra", activities = {}, quests = {}, roles = {}, classes = {}, sources = {}, text = "", leader = {},
                             confidence = 1, you = false, firstSeen = 0, lastSeen = 0 }, t)
    for _, part in ipairs({ "needed", "offered" }) do
        if rawget(e.roles, part) == nil then rawset(e.roles, part, {}) end
    end
    return e
end

-- Your listing, with the fields a test gives.
local function listingOf(t: { [string]: unknown }): Listing
    return over({ activities = {}, roles = {} }, t)
end

-- A note shown, by its place.
local function noteAt(i: number): NotificationData return (assert(notes[i], "no note " .. i)) end
local function action(d: NotificationData, i: number): NotificationAction return (assert(assert(d.actions)[i])) end
local function click(d: NotificationData, i: number) assert(action(d, i).onClick)(mock.partial({})) end

-- What you're after, with the fields a test gives.
local function interestWith(t: { [string]: unknown }): Interest
    return over({ listed = {}, roles = {}, quests = {}, level = 0, watches = {} }, t)
end

-- The module's pages, and what they were given.
local function browsePage(): GroupFinderBrowse return (assert(M.browse)) end
local function listedPage(): GroupFinderListed return (assert(M.listed)) end
local function whoPage(): GroupFinderWho return (assert(M.who)) end
local function listedData(): ListedData return (assert(listedPage().data)) end
local function facts(): ListedFacts return (assert(listedData().listing)) end
local function ad(): ListedAd return (assert(listedData().ad)) end
local function whoData(): WhoData return (assert(M.whoData)) end
-- One of the game's frames.
local function gameFrame(name: string): Frame return (assert(frames.find(name), name)) end


-- The settings section's rows, as the tests use them.
type TestRow = {
    key?: string, build?: (parent: Frame, onChange: () -> ()) -> Frame, get?: () -> number, set?: (v: number) -> (),
    isDefault?: () -> boolean, reset?: () -> (),
}
local function groupsOf(section: { [string]: unknown }): { rows: TestRow[] }[]
    return section.groups :: unknown :: { rows: TestRow[] }[]
end

@beforeEach
local function fakeLibrary()
    entries, listing, reasons, toolAge, now = {}, nil, {}, nil, 1000
    interest = over({ watches = {} }, { level = 30, roles = { healer = true }, listed = {}, quests = {} })
    notes, dismissed, refreshed, whispered, invited = {}, {}, {}, {}, {}
    mock.stub(LFG.Catalogue, "Name", function(key: string): string return NAMES[key] or key end)
    mock.stub(LFG.Catalogue, "Expand", function(key: string): string[] return { key } end)
    mock.stub(LFG.Catalogue, "Get", function(key: string): unknown
        if key == "dungeon:rfk" then return { key = key, kind = "dungeon", level = { 25, 35 } } end
        return nil
    end)
    mock.stub(LFG.Catalogue, "All", function(kind: string?): unknown
        if kind == "dungeon" then return { { key = "dungeon:sfk" }, { key = "dungeon:rfk" } } end
        if kind == "zone" then return { { key = "zone:wetlands" } } end
        return {}
    end)
    mock.stub(LFG, "Entries", function(_: unknown): Entry[] return entries end)
    mock.stub(LFG, "Entry", function(key: string): Entry?
        for _, e in ipairs(entries) do if e.key == key then return e end end
        return nil
    end)
    mock.stub(LFG, "Listing", function(): Listing? return listing end)
    mock.stub(LFG, "Interest", function(): Interest return interest end)
    mock.stub(LFG, "MatchReasons", function(e: Entry, _: unknown): string[] return reasons[e.key] or {} end)
    mock.stub(LFG, "Now", function(): number return now end)
    mock.stub(LFG, "CanInvite", function(e: Entry): boolean return e.sources.tool ~= nil end)
    mock.stub(LFG, "ToolAge", function(_: number?): number? return toolAge end)
    mock.stub(LFG, "Refresh", function(category: number?): boolean refreshed[#refreshed + 1] = category; return true end)
    mock.stub(LFG, "Watches", function(): { [string]: boolean } return {} end)
    mock.stub(LFG, "Delist", function(): (boolean?, unknown) return true end)
    mock.stub(LFG, "Whisper", function(e: Entry?) whispered[#whispered + 1] = e end)
    mock.stub(LFG, "Invite", function(e: Entry?) invited[#invited + 1] = e end)
    mock.stub(SuuUI, "Notify", function(def: NotificationData): unknown notes[#notes + 1] = def; return def.id end)
    mock.stub(SuuUI, "DismissNotification", function(id: string) dismissed[#dismissed + 1] = id end)
    M.held, M.noted, M.search, M.searching, M.editing, M.adEdited, M.adText = nil, {}, nil, nil, nil, nil, nil
    M.lastPost, M.listedAt, M.lastListing, M.delistedByYou = nil, nil, nil, nil
end

@afterEach
local function undo()
    for _, key in ipairs({ "category", "activities", "fits", "show", "collapsed", "adChannel", "notify", "channels",
                           "joinLFG", "chatExpiry", "extraLanguages", "staleAfter" }) do
        settings.reset(ID, key)
    end
    if mock.player then mock.player:leaveCombat() end
    local f = gameFrame("LFGParentFrame")
    if f and f:IsShown() then HideUIPanel(f) end
end

--------------------------------------------------------------------------------
-- Rows and the Browse page's data
--------------------------------------------------------------------------------

@test("Row: a group from the tool and chat: names, reason, sources, age, spots, who, post")
local function rowGroup()
    mock.fake("GetGeneralPlaystyleString", function(p: number): string return p == 2 and "Learning" or "" end)
    local e = entry({ key = "Kessra", intent = "group", activities = { "dungeon:rfk", "dungeon:sfk", "dungeon:wc" },
        members = { 3, 5 }, level = { 29 }, leader = { name = "Kessra", class = "MAGE", level = 31 },
        roles = { needed = { healer = 1 } },
        sources = { tool = { age = 30, seenAt = 990, newPlayerFriendly = true, playstyle = 2 },
                    chat = { channel = "SAY", text = "LFM heal RFK", lastPost = 900 } } })
    reasons.Kessra = { "zone", "role" }
    local row = M:Row(e, interest)
    expect(row.activity).toBe("Razorfen Kraul, Shadowfang Keep, +1")
    expect(row.level).toBe("29+")
    expect(row.reason).toBe("Needs your role")
    expect(row.match).toBe(true)
    expect(row.sources).toEqual({ "Tool", "Say" })
    expect(row.age).toBe("now") -- 30 + (1000 - 990)
    expect(row.slots).toEqual({ "has:none", "has:none", "has:none", "need:healer", "open" })
    expect(row.rolesTip).toBe("Has: 3 without a role\nNeeds: 1 Healer")
    expect(row.who).toBe("Lvl 31 " .. LOCALIZED_CLASS_NAMES_MALE["MAGE"])
    expect(row.post).toBe("LFM heal RFK")
    expect(row.playstyle).toBe("Learning")
    expect(row.newPlayerFriendly).toBe(true)
    expect(row.canInvite).toBe(true)
    expect(row.isPlayer).toBe(false)
    expect(row.leader).toBe("Kessra")
end

@test("Row: a player from chat: offered roles, chat age, a quest for a name, the key for a leader")
local function rowPlayer()
    mock.fake("C_QuestLog.GetTitleForQuestID", function(_: number): string? return nil end)
    now = 1000 + 600
    local e = entry({ key = "Morrow", intent = "player", quests = { 42 }, roles = { offered = { tank = true, damage = true } },
        sources = { chat = { channel = "YELL", text = "", lastPost = 1000 } }, text = "listing comment" })
    local row = M:Row(e, interest)
    expect(row.activity).toBe("Quest 42")
    expect(row.slots).toEqual({ "tank", "damage" })
    expect(row.sources).toEqual({ "Yell" })
    expect(row.age).toBe("10m")
    expect(row.leader).toBe("Morrow")
    expect(row.who).toBeNil()
    expect(row.post).toBeNil() -- the chat post is empty
    expect(row.reason).toBeNil()
    expect(row.match).toBe(false)
    expect(row.isPlayer).toBe(true)
    expect(row.rolesTip).toBeNil()
    expect(row.level).toBeNil()
end

@test("Row: the listing's comment when there's no chat post; a secret one left out; the level alone as who")
local function rowComment()
    local e = entry({ intent = "group", leader = { name = "A", level = 12 }, text = "tool comment", sources = { tool = {} } })
    local row = M:Row(e, interestWith({ roles = {} }))
    expect(row.post).toBe("tool comment")
    expect(row.who).toBe("Lvl 12 ")
    expect(row.age).toBe("")
    local s = entry({ intent = "group", text = mock.secret("hidden"), sources = { tool = { playstyle = 1 } } })
    mock.fake("GetGeneralPlaystyleString", function(_: number): string return "" end)
    expect(M:Row(s, interestWith({ roles = {} })).post).toBeNil()
    expect(M:Row(s, interestWith({ roles = {} })).playstyle).toBeNil()
end

@test("Data: entries by intent, matches first then newest, the filter, the category's options and tool state")
local function data()
    local old = entry({ key = "Old", intent = "group", activities = { "dungeon:rfk" }, lastSeen = 1 })
    local new = entry({ key = "New", intent = "group", activities = { "dungeon:sfk" }, lastSeen = 5 })
    local hit = entry({ key = "Hit", intent = "group", activities = { "dungeon:wc" }, lastSeen = 0 })
    local p = entry({ key = "P", intent = "player", activities = { "dungeon:rfk" } })
    entries = { old, new, hit, p }
    reasons.Hit = { "activity" }
    local filter: unknown = nil
    mock.stub(LFG, "Entries", function(f: unknown): Entry[] filter = f; return entries end)
    toolAge = 400
    M.search = "rfk"
    M.searching = true
    local d = M:Data()
    local keys: string[] = {}
    for i, r in ipairs(assert(d.groups)) do keys[i] = r.key or "" end
    expect(keys).toEqual({ "Hit", "New", "Old" })
    expect(#assert(d.players)).toBe(1)
    expect(filter).toEqual({ minConfidence = 0, notYou = false, search = "rfk" })
    expect(d.tool).toEqual({ age = 400, stale = true, searching = true, loading = false })
    expect(d.category).toBe("all")
    expect(#assert(d.categories)).toBe(6)
    -- every kind's activities, by name
    expect(d.activityOptions).toEqual({ { value = "dungeon:rfk", label = "Razorfen Kraul" },
        { value = "dungeon:sfk", label = "Shadowfang Keep" }, { value = "zone:wetlands", label = "Wetlands" } })
    expect(d.search).toBe("rfk")
    expect(d.show).toBe("both")
end

@test("Data: a category's kinds and chosen activities go to the filter; show and fits narrow the rows")
local function dataFiltered()
    local filter: unknown = nil
    mock.stub(LFG, "Entries", function(f: unknown): Entry[] filter = f; return entries end)
    entries = {
        entry({ key = "Fits", intent = "group", activities = { "dungeon:rfk" }, roles = { needed = { healer = 1 } } }),
        entry({ key = "NotMyRole", intent = "group", activities = { "dungeon:rfk" }, roles = { needed = { tank = 1 } } }),
        entry({ key = "TooHigh", intent = "group", activities = { "x" }, level = { 60 } }),
        entry({ key = "Player", intent = "player", activities = { "dungeon:rfk" } }),
    }
    M:Set("category", "zone")
    M:Set("activities", { "zone:wetlands" })
    M:Set("fits", true)
    M:Set("show", "group")
    local d = M:Data()
    expect(tbl.field(filter, "kinds")).toEqual({ zone = true, quest = true })
    expect(tbl.field(filter, "activities")).toEqual({ ["zone:wetlands"] = true })
    expect(#assert(d.groups)).toBe(1)
    expect(assert(d.groups)[1].key).toBe("Fits")
    expect(#assert(d.players)).toBe(0)
    expect(d.activityOptions).toEqual({ { value = "zone:wetlands", label = "Wetlands" } })
    expect(assert(d.tool).loading).toBeFalsy()
    -- loading: searching with no result yet
    M.searching = true
    toolAge = nil
    expect(M:Data().tool).toEqual({ searching = true, loading = true })
    -- an unknown category reads as All
    settings.set(ID, "category", "nope")
    expect(M:Data().category).toBe("all")
end

--------------------------------------------------------------------------------
-- The window
--------------------------------------------------------------------------------

local function openBrowse()
    local f = gameFrame("LFGParentFrame")
    ShowUIPanel(f)
    gameFrame("LFGBrowseFrame"):Show()
    gameFrame("LFGListingFrame"):Hide()
    gameFrame("LFGWhoListFrame"):Hide()
    M:Follow()
end

@test("the window: Browse over the game's page, the cover with it; opening searches the tool")
local function window()
    expect(M.browse).toBeTruthy()
    toolAge = nil
    openBrowse()
    expect(refreshed).toEqual({ 2 })
    expect(M.browse).toBeShown()
    expect(M.cover).toBeShown()
    expect(gameFrame("LFGBrowseFrame"):GetAlpha()).toBe(0)
    expect(browsePage().data).toBeTruthy()
    HideUIPanel(gameFrame("LFGParentFrame"))
    expect(browsePage():IsVisible()).toBe(false)
    expect(errorsSoFar()).toEqual({})
end

@test("SearchOnOpen: not again within a minute of the last search")
local function searchOnOpen()
    toolAge = 30
    M:SearchOnOpen()
    expect(refreshed).toEqual({})
    toolAge = 61
    M:Set("category", "custom")
    M:SearchOnOpen()
    expect(refreshed).toEqual({ 120 })
    expect(M.searching).toBe(true)
end

@test("Render and QueueRender: the page's data once, 0.2 s later; nothing while hidden")
local function render()
    openBrowse()
    browsePage().data = nil
    M:QueueRender()
    M:QueueRender()
    expect(browsePage().data).toBeNil()
    mock.advanceTime(0.25)
    expect(browsePage().data).toBeTruthy()
    HideUIPanel(gameFrame("LFGParentFrame"))
    browsePage().data = nil
    M:Render()
    expect(browsePage().data).toBeNil()
end

@test("the Browse page's controls: filter, refresh, clear, whisper, invite, collapse")
local function controls()
    openBrowse()
    local b = browsePage()
    assert(b.onFilter)({ category = "raid" })
    expect(M:Get("category")).toBe("raid")
    expect(M:Get("activities")).toEqual({})
    assert(b.onFilter)({ activities = { "raid:mc" }, fits = true, show = "player", search = "mc" })
    expect(M:Get("activities")).toEqual({ "raid:mc" })
    expect(M:Get("fits")).toBe(true)
    expect(M:Get("show")).toBe("player")
    expect(M.search).toBe("mc")
    assert(b.onFilter)({ fits = false })
    expect(M:Get("fits")).toBe(false)
    mock.stub(LFG, "Refresh", function(_: number?): boolean return false end)
    assert(b.onRefresh)()
    expect(M.searching).toBeNil()
    mock.stub(LFG, "Refresh", function(_: number?): boolean return true end)
    assert(b.onRefresh)()
    expect(M.searching).toBe(true)
    assert(b.onClear)()
    expect(M:Get("category")).toBe("all")
    expect(M:Get("show")).toBe("both")
    expect(M.search).toBeNil()
    local row = M:Row(entry({}), interest)
    assert(b.onWhisper)(row)
    assert(b.onInvite)(row)
    expect(whispered[1]).toBe(row.entry)
    expect(invited[1]).toBe(row.entry)
    assert(b.onToggle)("groups")
    expect(M:Get("collapsed")["groups"]).toBe(true)
    assert(b.onToggle)("groups")
    expect(M:Get("collapsed")["groups"]).toBe(false)
    mock.advanceTime(0.3)
end

@test("Follow: My listing over the game's panel while listed, the panel back for Update")
local function myListing()
    listing = listingOf({ activities = { "dungeon:rfk" }, roles = { healer = true }, duration = 1800, comment = "hi" })
    local f = gameFrame("LFGParentFrame")
    ShowUIPanel(f)
    gameFrame("LFGBrowseFrame"):Hide()
    gameFrame("LFGListingFrame"):Show()
    M:Follow()
    expect(M.listed).toBeShown()
    expect(gameFrame("LFGListingFrame"):GetAlpha()).toBe(0)
    expect(M.cover).toBeShown()
    expect(facts().activities).toEqual({ "Razorfen Kraul" })
    expect(facts().roles).toEqual({ "healer" })
    expect(facts().left).toBe("30m")
    expect(facts().comment).toBe("hi")
    expect(facts().voice).toBe("None")
    expect(ad().channel).toBe("General")
    expect(#assert(ad().channels)).toBe(5)
    expect(ad().max).toBe(255)
    -- Update: the game's panel back until it hides or the listing changes
    assert(listedPage().onUpdate)()
    expect(M.editing).toBe(true)
    expect(listedPage():IsShown()).toBe(false)
    expect(gameFrame("LFGListingFrame"):GetAlpha()).toBe(1)
    gameFrame("LFGListingFrame"):Hide()
    expect(M.editing).toBeNil()
    -- not listed: no page
    listing = nil
    gameFrame("LFGListingFrame"):Show()
    expect(listedPage():IsShown()).toBe(false)
end

@test("RenderListed: playstyle, category, how long listed, the ad written for you until you edit it")
local function renderListed()
    mock.fake("GetGeneralPlaystyleString", function(_: number): string return "Serious" end)
    mock.fake("C_LFGList.GetLfgCategoryInfo", function(_: number): unknown return { name = "Dungeons" } end)
    listing = listingOf({ activities = { "dungeon:sfk" }, roles = { tank = true }, playstyle = 3, category = 2, comment = mock.secret("x") })
    M.listedAt = now - 125
    local f = gameFrame("LFGParentFrame")
    ShowUIPanel(f)
    gameFrame("LFGListingFrame"):Show()
    M:Follow()
    expect(facts().playstyle).toBe("Serious")
    expect(facts().category).toBe("Dungeons")
    expect(facts().listedFor).toBe("2m")
    expect(facts().comment).toBeNil()
    expect(ad().text).toBe(M:AdFromListing(listing))
    -- the voice chat's label, when the game has one
    local savedVoice: unknown = rawget(_G, "LFGVoiceChat")
    rawset(_G, "LFGVoiceChat", { VoiceModeLabels = { [2] = "Party voice" } })
    local l = assert(listing)
    l.voiceMode = 2
    M:RenderListed()
    expect(facts().voice).toBe("Party voice")
    rawset(_G, "LFGVoiceChat", savedVoice)
    -- your own words stay; Rewrite writes it again
    assert(listedPage().onText)("my ad")
    M:RenderListed()
    expect(ad().text).toBe("my ad")
    assert(listedPage().onRewrite)()
    expect(ad().text).toBe(M:AdFromListing(listing))
    assert(listedPage().onChannel)("Trade")
    expect(M:Get("adChannel")).toBe("Trade")
    expect(ad().channel).toBe("Trade")
    assert(listedPage().onDelist)()
    -- gone meanwhile: nothing drawn
    listing = nil
    listedPage().data = nil
    M:RenderListed()
    expect(listedPage().data).toBeNil()
end

@test("AdFromListing: empty without a listing, else the ad for who you are now")
local function adFromListing()
    expect(M:AdFromListing(nil)).toBe("")
    local l = listingOf({ activities = { "dungeon:rfk" }, roles = { damage = true } })
    expect(M:AdFromListing(l)).toBe(logic.adText(l, logic.adContext()))
end

@test("PostAd: Say directly, a channel by its number, not joined: told; blank: nothing")
local function postAd()
    local sent: unknown[][] = {}
    mock.fake("C_ChatInfo.SendChatMessage", function(...: unknown) sent[#sent + 1] = { ... } end)
    mock.fake("GetChannelList", function(): ...unknown return 1, "General - Durotar", false end)
    mock.fake("GetChannelName", function(_: string): number return 0 end)
    M:PostAd("Say", "   ")
    M:PostAd("Say", nil)
    expect(#sent).toBe(0)
    M:PostAd("Say", "LFG RFK")
    expect(sent[1]).toEqual({ "LFG RFK", "SAY" })
    expect(M.lastPost).toBe(GetTime())
    M:PostAd("General", "LFG RFK")
    expect(sent[2]).toEqual({ "LFG RFK", "CHANNEL", nil, 1 })
    M:PostAd("Trade", "LFG RFK")
    expect(#sent).toBe(2)
    local printed = mock.printed()
    expect(printed[#printed]).toContain("You're not in Trade; join it to post there.")
    -- the page's Post goes the same way
    assert(listedPage().onPost)("Say", "again")
    expect(#sent).toBe(3)
end

--------------------------------------------------------------------------------
-- Who
--------------------------------------------------------------------------------

@test("ReadWho: the results (secret names left out), capped when the server had more")
local function readWho()
    mock.fake("C_FriendList.GetNumWhoResults", function(): (number, number) return 3, 50 end)
    mock.fake("C_FriendList.GetWhoInfo", function(i: number): unknown
        if i == 2 then return { fullName = mock.secret("x") } end
        return { fullName = "P" .. i, level = 10 + i, raceStr = "Orc", filename = "WARRIOR", classStr = "Warrior",
                 fullGuildName = "G", area = "Durotar" }
    end)
    M.whoQuery = "orc"
    M:ReadWho()
    expect(whoData().state).toBe("results")
    expect(whoData().query).toBe("orc")
    expect(whoData().total).toBe(50)
    expect(whoData().capped).toBe(true)
    expect(whoData().results).toEqual({
        { name = "P1", level = 11, race = "Orc", class = "WARRIOR", className = "Warrior", guild = "G", zone = "Durotar" },
        { name = "P3", level = 13, race = "Orc", class = "WARRIOR", className = "Warrior", guild = "G", zone = "Durotar" } })
    -- none; and a failed read keeps what was there
    mock.fake("C_FriendList.GetNumWhoResults", function(): (number, number?) return 0, nil end)
    M.whoQuery = nil
    M:ReadWho()
    expect(M.whoData).toEqual({ state = "none", query = "", total = 0, capped = false, results = {} })
    mock.fake("C_FriendList.GetNumWhoResults", function(): unknown error("no") end)
    M:ReadWho()
    expect(whoData().state).toBe("none")
end

@test("Who: the page over the game's, its search box off; the list from WHO_LIST_UPDATE; the actions")
local function who()
    local f = gameFrame("LFGParentFrame")
    ShowUIPanel(f)
    gameFrame("LFGBrowseFrame"):Hide()
    gameFrame("LFGListingFrame"):Hide()
    M.whoData = nil
    gameFrame("LFGWhoListFrame"):Show()
    expect(M.who).toBeShown()
    expect(whoPage().data).toEqual({ state = "idle" })
    expect(gameFrame("LFGWhoListFrame"):GetAlpha()).toBe(0)
    mock.fake("C_FriendList.GetNumWhoResults", function(): (number, number) return 1, 1 end)
    mock.fake("C_FriendList.GetWhoInfo", function(_: number): unknown return { fullName = "Zug", level = 5 } end)
    mock.fireEvent("WHO_LIST_UPDATE")
    expect(assert(assert(whoPage().data).results)[1].name).toBe("Zug")
    -- the search goes out with the game's filters
    local sentWho: unknown[] = {}
    mock.fake("C_FriendList.SetWhoToUi", function(_: boolean) end)
    mock.fake("C_FriendList.SendWho", function(...: unknown) sentWho = { ... } end)
    assert(whoPage().onSearch)("zug")
    expect(M.whoQuery).toBe("zug")
    expect(sentWho[1]).toBe("zug")
    assert(whoPage().onSearch)("")
    expect(sentWho[1]).toBe("")
    -- the row's actions
    local tells: string[] = {}
    mock.stub(ChatFrameUtil, "SendTell", function(name: string) tells[#tells + 1] = name end)
    assert(whoPage().onWhisper)({ name = "Zug" })
    expect(tells).toEqual({ "Zug" })
    local invitedNames: string[] = {}
    mock.fake("C_PartyInfo.InviteUnit", function(name: string) invitedNames[#invitedNames + 1] = name end)
    assert(whoPage().onInvite)({ name = "Zug" })
    expect(invitedNames).toEqual({ "Zug" })
    mock.stub(SuuUI, "AddFriend", function(name: unknown): boolean return name == "Zug" end)
    assert(whoPage().onAddFriend)({ name = "Zug" })
    local printed = mock.printed()
    expect(printed[#printed]).toContain("Friend request sent to Zug.")
    assert(whoPage().onAddFriend)({ name = "Nope" })
    expect(mock.printed()[#mock.printed()]).toContain("Friend request sent to Zug.")
    local menu: unknown[] = {}
    mock.fake("FriendsFrame_ShowDropdown", function(...: unknown) menu = { ... } end)
    assert(whoPage().onMenu)({ name = "Zug" })
    expect(menu).toEqual({ "Zug", 1 })
    -- the game's filter menu, opened under our button (once restyled)
    local dd = frames.asFrame(tbl.field(_G, "LFGWhoListFrame", "FilterDropdown"))
    if dd then
        local opened = mock.stub(dd, "OpenMenu", function() end)
        assert(whoPage().onFilter)(whoPage().filter)
        assert(whoPage().onFilter)(whoPage().filter)
        expect(opened).toHaveBeenCalledTimes(2)
        expect(M.whoDropdownSkinned).toBe(true)
    end
    gameFrame("LFGWhoListFrame"):Hide()
    expect(whoPage():IsShown()).toBe(false)
    expect(gameFrame("LFGWhoListFrame"):GetAlpha()).toBe(1)
end

@test("Who's filter: nothing without the game's dropdown; a dropdown without OpenMenu is clicked")
local function whoFilterFallbacks()
    local page = gameFrame("LFGWhoListFrame")
    local real: unknown = rawget(page, "FilterDropdown")
    rawset(page, "FilterDropdown", nil)
    assert(whoPage().onFilter)(whoPage().filter)
    local clicked = mock.spy()
    local plain = CreateFrame("Frame")
    rawset(plain, "Click", clicked)
    rawset(page, "FilterDropdown", plain)
    M.whoDropdownSkinned = true
    assert(whoPage().onFilter)(whoPage().filter)
    expect(clicked).toHaveBeenCalled()
    rawset(page, "FilterDropdown", real)
end

