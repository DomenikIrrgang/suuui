-- Units/Ledger/Days: the Ledger's calendar is the price store's
-- (SuuUI.Calendar): the same day numbers, dates, weekdays and periods.

import test, expect from "wowlua:test"
import SuuUI from "/Core/API"
import * as days from "/Units/Ledger/Days"
import expectNoErrors from "../../../helpers"

@test("the same calendar as the price store's")
local function sameCalendar()
    local C = SuuUI.Calendar
    local n = days.dayNumber(2026, 11, 18)
    expect(n).toBe(C.DayNumber(2026, 11, 18))
    expect(n).toBe(20775)
    local y, m, d = days.dateOf(n)
    expect({ y, m, d }).toEqual({ 2026, 11, 18 })
    expect(days.weekday(n)).toBe(3)
    expect(days.periodOfHour(12)).toBe(days.NOON)
    expect({ days.NIGHT, days.MORNING, days.NOON, days.EVENING }).toEqual({ 1, 2, 3, 4 })
    expect(days.PERIODS[days.EVENING]).toBe("Evening")
    expect(days.WEEKDAYS[1]).toBe("Monday")
    local at = time({ year = 2026, month = 11, day = 18, hour = 7, min = 30 })
    local day, period = days.dayOf(at)
    expect(day).toBe(n)
    expect(period).toBe(days.MORNING)
    local now, p = days.dayOf()
    local cn, cp = C.DayOf()
    expect({ now, p }).toEqual({ cn, cp })
    expectNoErrors()
end
