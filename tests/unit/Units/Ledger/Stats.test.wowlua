-- Units/Ledger/Stats: change, deals, and when an item is cheapest (each
-- look against its own week; 3 looks a row; 4 % apart). The usual price is
-- the price store's (Core/Prices/Store).

import test, expect, cases from "wowlua:test"
import * as stats from "/Units/Ledger/Stats"
import type WhenRow from "/Units/Ledger/Stats"
import type PriceLook from "/Core/API"
import * as days from "/Units/Ledger/Days"
import expectNoErrors from "../../../helpers"

@test("the median: the middle one, or the two middle ones' mean; the list left as it was")
local function median()
    local list = { 5, 1, 4, 2, 3 }
    expect(stats.median(list)).toBe(3)
    expect(list).toEqual({ 5, 1, 4, 2, 3 })
    expect(stats.median({ 4, 1, 3, 2 })).toBe(2.5)
    expect(stats.median({ 9, 1, 3, 2 }, 3)).toBe(3)
    expect(stats.median({})).toBeNil()
    expect(stats.median({ 1 }, 0)).toBeNil()
    expect(stats.median({ 7 })).toBe(7)
end

@test("change: the lowest now against the usual price, in percent")
@cases({ { 74, 100, -26 }, { 100, 100, 0 }, { 150, 100, 50 }, { 10, 0, 0 } })
local function change(low: number, usualPrice: number, out: number)
    expect(stats.change(low, usualPrice)).toBe(out)
end

@test("a deal: at least the threshold under the usual price; under vendor price; their order")
local function deals()
    expect(stats.dealUnder(74, 100, 25)).toBe(26)
    expect(stats.dealUnder(75, 100, 25)).toBe(25)
    expect(stats.dealUnder(76, 100, 25)).toBeNil()
    expect(stats.dealUnder(50, nil, 25)).toBeNil()
    expect(stats.dealUnder(50, 0, 25)).toBeNil()
    expect(stats.dealUnder(0, 100, 25)).toBeNil()
    expect(stats.underVendor(99, 100)).toBe(true)
    expect(stats.underVendor(100, 100)).toBe(false)
    expect(stats.underVendor(99, nil)).toBe(false)
    expect(stats.underVendor(99, 0)).toBe(false)
    expect(stats.underVendor(0, 100)).toBe(false)
    -- the order: how far under the usual price, else under the vendor's
    expect(stats.dealOrder(31, 69, nil)).toBe(31)
    expect(stats.dealOrder(nil, 80, 100)).toBe(20)
    expect(stats.dealOrder(nil, 120, 100)).toBe(0)
    expect(stats.dealOrder(nil, 80, nil)).toBe(0)
end

local function row(pct: number, looks: number): WhenRow
    return { pct = pct, looks = looks }
end

@test("a set of rows: enough looks in each; one stands out only 4 % apart")
local function whenInfo()
    -- a row with too few looks: not enough
    local short = stats.whenInfo({ row(-10, 9), row(2, 2), row(3, 9), row(1, 9) })
    expect(short).toEqual({ enough = false, out = false, best = 0, worst = 0 })
    expect(stats.whenInfo({})).toEqual({ enough = false, out = false, best = 0, worst = 0 })
    -- 3.9 apart: none stands out
    expect(stats.whenInfo({ row(-2, 3), row(1.9, 3), row(0, 3), row(1, 3) })).toEqual({
        enough = true,
        out = false,
        best = 0,
        worst = 0,
    })
    -- 4 apart: the cheapest and the dearest (the first of equals)
    expect(stats.whenInfo({ row(1, 3), row(-2, 3), row(2, 3), row(-2, 3) })).toEqual({
        enough = true,
        out = true,
        best = 2,
        worst = 3,
    })
end

@test("when it's cheapest: Tuesdays and nights, on a rising price; each look against its week")
local function whenCheapest()
    -- eight weeks, a look each Night and Evening; the price rises 1 % a day;
    -- Tuesdays 10 % under, nights 6 % under
    local first = days.dayNumber(2026, 9, 21) -- a Monday
    local list: PriceLook[] = {}
    for d = first + 55, first, -1 do
        local base = 10000 * (1.01 ^ (d - first))
        if days.weekday(d) == 2 then
            base = base * 0.9
        end
        list[#list + 1] = { day = d, period = days.EVENING, low = math.floor(base), most = 0, qty = 5, n = 5 }
        list[#list + 1] = { day = d, period = days.NIGHT, low = math.floor(base * 0.94), most = 0, qty = 5, n = 5 }
    end
    local w = stats.whenCheapest(list)
    expect(#w.weekdays).toBe(7)
    expect(#w.times).toBe(4)
    expect(w.weekdays[2].looks).toBe(8)
    expect(w.days.enough).toBe(true)
    expect(w.days.out).toBe(true)
    expect(w.days.best).toBe(2)
    -- about 10 % under its week, not more: the rise doesn't add to it
    expect(w.weekdays[2].pct < -8 and w.weekdays[2].pct > -12).toBe(true)
    -- the other days within a few percent
    for i = 1, 7 do
        if i ~= 2 then
            expect(math.abs(w.weekdays[i].pct) < 5).toBe(true)
        end
    end
    -- Morning and Noon never seen: not enough for the time of day
    expect(w.times[days.NIGHT].looks).toBe(56)
    expect(w.times[days.MORNING].looks).toBe(0)
    expect(w.periods.enough).toBe(false)
    expect(w.times[days.NIGHT].pct < w.times[days.EVENING].pct - 4).toBe(true)
    -- nothing seen: rows of nothing
    local none = stats.whenCheapest({})
    expect(none.weekdays[1]).toEqual({ pct = 0, looks = 0 })
    expect(none.days.enough).toBe(false)
    expectNoErrors()
end
