-- Units/BuffIndicators: buff indicators on group frames. A list per class
-- and spec (a spec's first list from the class's defaults; the older one
-- list per class), what the group frames get (the active spec's), the
-- editor (the spec picker, rows and their summaries, "+ Add" by name or ID,
-- remove, reordering by the grip), the Edit indicator modal (its previews,
-- each field and what applies, Reset, Done; the live frames waiting for it
-- to close), the preview, a new spec, turning the module off and on. The
-- character is a warrior: Protection (3) starts with Battle Shout.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import expectNoErrors, newParent from "../../helpers"

import internal M, buildEditor from "/Units/BuffIndicators"
import type IndicatorEditor, IndicatorRow, IndicatorEditPanel from "/Units/BuffIndicators"
import type Indicator from "/UI/UnitFrame"
import type Segmented from "/UI/Inputs"

local UI = SuuUI.UI

-- No talents spent (the engine's default warrior has some): Unspecced,
-- unless a test spends them.
@beforeEach
local function unspecced()
    mock.stub(C_Traits, "GetConfigInfo", function(_: number): unknown
        return { treeIDs = {} }
    end)
end

@afterEach
local function cleanup()
    M.editSpec = nil
    M:Reset("lists")
    local panel = M.editPanel
    if panel then
        panel:Hide()
    end
    expectNoErrors()
end

local function editor(): IndicatorEditor
    local host = newParent(600, 600)
    local f = buildEditor(host)
    f:SetPoint("TOPLEFT", host, "TOPLEFT")
    return f
end

local function shownRows(f: IndicatorEditor): IndicatorRow[]
    local out: IndicatorRow[] = {}
    for _, r in ipairs(f.rows) do
        if r:IsShown() then
            out[#out + 1] = r
        end
    end
    return out
end

local function names(list: Indicator[]): string[]
    local out: string[] = {}
    for _, e in ipairs(list) do
        out[#out + 1] = e.name or ""
    end
    return out
end

-- The Edit indicator modal, open (it's made the first time).
local function editPanel(f: IndicatorEditor, index: number): IndicatorEditPanel
    mock.click(shownRows(f)[index].edit)
    local p = assert(M.editPanel, "no Edit indicator modal")
    assert(p:IsShown(), "no Edit indicator modal")
    return p
end

local function click(seg: Segmented<string>, value: string)
    for _, b in ipairs(seg.buttons) do
        if b.option.value == value then
            mock.click(b)
            return
        end
    end
    error("no option " .. tostring(value))
end

--------------------------------------------------------------------------------
-- The lists
--------------------------------------------------------------------------------

@test("a spec's first list comes from the class's defaults, with every rank's IDs; Unspecced starts empty")
local function defaults()
    expect(M:List(0)).toEqual({})
    local prot = M:List(3)
    expect(names(prot)).toEqual({ "Battle Shout" })
    expect(prot[1].source).toBe("any")
    expect(prot[1].show).toBe("missing")
    expect(#assert(prot[1].ids) > 5).toBe(true)
end

@test("lists are kept per class and spec; one saved before specs serves every spec")
local function perSpec()
    M:SetList({ { name = "Mine", ids = { 6673 } } }, 2)
    expect(names(M:List(2))).toEqual({ "Mine" })
    expect(M:List(1)).toEqual({})
    M:SetList({ { name = "Active", ids = { 6673 } } }) -- the active spec's
    expect(names(M:List())).toEqual({ "Active" })
    -- the older shape: one list for the class
    settings.set("indicators", "lists", { WARRIOR = { { name = "Old", ids = { 6673 } } } })
    expect(names(M:List(1))).toEqual({ "Old" })
    expect(names(M:List(3))).toEqual({ "Old" })
    M:SetList({}, 1)
    expect(M:List(1)).toEqual({})
    expect(names(M:List(2))).toEqual({ "Old" })
end

@test("the group frames get the active spec's list; turned off, none")
local function published()
    mock.stub(M, "ActiveSpec", function(_: unknown): number
        return 3
    end)
    M:Publish()
    expect(names((UI.GroupIndicators()))).toEqual({ "Battle Shout" })
    settings.set("indicators", "enabled", false)
    expect(#(UI.GroupIndicators())).toBe(0)
    settings.set("indicators", "enabled", true)
    expect(names((UI.GroupIndicators()))).toEqual({ "Battle Shout" })
end

@test("a new spec: its list goes on the frames and the editor follows")
local function specChanged()
    local f = editor()
    M.editSpec = 2
    mock.stub(M, "ActiveSpec", function(_: unknown): number
        return 3
    end)
    events.emit("SUUUI_SPEC_CHANGED", 3)
    expect(M.editSpec).toBe(nil)
    expect(names((UI.GroupIndicators()))).toEqual({ "Battle Shout" })
    expect(#shownRows(f)).toBe(1)
end

--------------------------------------------------------------------------------
-- The editor
--------------------------------------------------------------------------------

@test("the editor: the spec picker (the active one marked), its rows with their summaries")
local function rows()
    local f = editor()
    expect(f.spec.options[1].label).toBe("Unspecced (active)")
    expect(f.spec.options[4].label).toBe("Protection")
    expect(f.empty).toBeShown()
    expect(f.specNote:GetText()).toBe("Shown on your frames now.")
    assert(f.spec.onChange)(3)
    expect(f.specNote:GetText()).toBe("Shown when you switch to this spec.")
    local r = shownRows(f)[1]
    expect(r.name:GetText()).toBe("Battle Shout")
    expect(r.summary:GetText()).toBe("Icon · Centre · 24px · While missing · My group · Anyone's")
    expect(f.hint).never.toBeShown()
    f:Hide()
    f:Show()
    -- a tree no preset names
    mock.stub(SuuUI, "CooldownPresets", function(): unknown[]
        return {}
    end)
    f:Refresh()
    expect(f.spec.options[2].label).toBe("Tree 1")
end

@test("summaries: each kind, colour, show mode, missing colour and group sizes")
local function summaries()
    M:SetList(
        {
            {
                name = "A",
                ids = { 139 },
                kind = "square",
                point = "TOPLEFT",
                size = 8,
                color = "ward",
                show = "both",
                missingColor = "amber",
            },
            {
                name = "B",
                ids = { 139 },
                kind = "border",
                color = "nonesuch",
                show = "missing",
                sizes = { ["5"] = true, ["10"] = true },
            },
            {
                name = "C",
                ids = { 139 },
                kind = "fill",
                show = "both",
                sizes = { ["5"] = true, ["10"] = true, ["20"] = true, ["40"] = true },
            },
            { name = "D", ids = { 139 } },
        },
        0
    )
    local f = editor()
    local r = shownRows(f)
    expect(r[1].summary:GetText()).toBe("Square · Top left · 8px · Pale gold · Up or missing (amber)")
    expect(r[2].summary:GetText()).toBe("Border · nonesuch · While missing (red) · Party, 10")
    expect(r[3].summary:GetText()).toBe("Bar colour · Green · While up")
    expect(r[4].summary:GetText()).toBe("Icon · Top right · 10px · While up")
    expect(f.hint).toBeShown()
end

@test("+ Add: a buff the presets know, by name, or any spell by its ID; × removes one")
local function adding()
    local f = editor()
    assert(f.add.onChange)("Battle Shout")
    expect(names(M:List(0))).toEqual({ "Battle Shout" })
    expect(M:List(0)[1].kind).toBe("icon")
    expect(assert(assert(assert(f.add.lookup)("6673"))[1]).value).toBe("id:6673")
    expect(assert(f.add.lookup)("words")).toBe(nil)
    expect(assert(f.add.lookup)("999999999")).toBe(nil)
    assert(f.add.onChange)("id:6673")
    expect(#M:List(0)).toBe(2)
    ;(assert(f.add.onChange) :: (v: string?) -> ())(nil)
    assert(f.add.onChange)("Not a buff")
    expect(#M:List(0)).toBe(2)
    mock.click(shownRows(f)[1].remove)
    expect(#M:List(0)).toBe(1)
end

@test("a row dragged by its grip lands where the line marks; a drop in place changes nothing")
local function reorder()
    M:SetList({ { name = "A", ids = { 139 } }, { name = "B", ids = { 139 } }, { name = "C", ids = { 139 } } }, 0)
    local f = editor()
    local r = shownRows(f)
    local s = f:GetEffectiveScale()
    local function cursorAt(row: IndicatorRow, dy: number)
        local x, y = row:GetCenter()
        mock.setCursorPosition(x * s, (y + dy) * s)
    end
    -- A below C
    cursorAt(r[1], 0)
    mock.script(r[1].grip, "OnMouseDown", "LeftButton")
    cursorAt(r[3], -20)
    mock.advanceFrames(1)
    expect(f.line).toBeShown()
    mock.script(r[1].grip, "OnMouseUp", "LeftButton")
    expect(names(M:List(0))).toEqual({ "B", "C", "A" })
    -- the last row onto itself
    r = shownRows(f)
    cursorAt(r[3], 0)
    mock.script(r[3].grip, "OnMouseDown", "LeftButton")
    mock.advanceFrames(1)
    mock.script(r[3].grip, "OnMouseUp", "LeftButton")
    expect(names(M:List(0))).toEqual({ "B", "C", "A" })
    -- C before B
    cursorAt(r[2], 0)
    mock.script(r[2].grip, "OnMouseDown", "LeftButton")
    cursorAt(r[1], 10)
    mock.advanceFrames(1)
    mock.script(r[2].grip, "OnMouseUp", "LeftButton")
    expect(names(M:List(0))).toEqual({ "C", "B", "A" })
    -- let go without a drag: nothing
    f:StopDrag()
end

--------------------------------------------------------------------------------
-- The Edit indicator modal
--------------------------------------------------------------------------------

@test("Edit: the indicator's look, when it shows and where; what doesn't apply says why")
local function editing()
    M:SetList(
        {
            {
                name = "Renewal",
                ids = { 139 },
                kind = "icon",
                point = "TOPRIGHT",
                size = 12,
                color = "fel",
                source = "mine",
            },
        },
        0
    )
    local f = editor()
    local p = editPanel(f, 1)
    expect(assert(assert(p.title):GetText()):find("Renewal", 1, true) ~= nil).toBe(true)
    expect(p.previews[1].holder).toBeShown() -- up only
    expect(p.previews[2].holder).never.toBeShown()
    expect(p.color.reason:GetText()).toBe("An icon shows the spell's own art.")
    expect(p.point.reason:GetText()).toBe("Its time shows from 16px.")
    -- a square: the colour applies
    click(p.kind.control, "square")
    expect(M:List(0)[1].kind).toBe("square")
    expect(p.color.reason:GetText()).toBe("")
    assert(p.color.control.onChange)("ward")
    expect(M:List(0)[1].color).toBe("ward")
    assert(p.point.control.onChange)("BOTTOM")
    assert(p.size.onChange)(9)
    expect(M:List(0)[1].point).toBe("BOTTOM")
    expect(M:List(0)[1].size).toBe(9)
    -- a border: no position
    click(p.kind.control, "border")
    expect(p.point.reason:GetText()).toBe("A border goes around the whole frame.")
    -- while missing: both previews' places, the missing colour
    click(p.show.control, "both")
    expect(p.previews[2].holder).toBeShown()
    assert(p.missingColor.control.onChange)("amber")
    expect(M:List(0)[1].missingColor).toBe("amber")
    assert(p.missingColor.control.onChange)("ember")
    expect(M:List(0)[1].missingColor).toBe(nil)
    click(p.show.control, "missing")
    expect(p.previews[1].holder).never.toBeShown()
    click(p.show.control, "up")
    expect(p.missingColor.reason:GetText()).toBe("Only for While missing and Up or missing.")
    -- a bar colour: no position, no "both"
    click(p.kind.control, "fill")
    expect(p.point.reason:GetText()).toBe("A bar colour tints the whole health fill.")
    -- an icon while missing: grey
    click(p.kind.control, "icon")
    click(p.show.control, "missing")
    expect(p.missingColor.reason:GetText()).toBe("An icon shows grey while it's missing.")
    -- where
    click(p.source.control, "any")
    click(p.on.control, "group")
    expect(M:List(0)[1].on).toBe("group")
    click(p.on.control, "all")
    expect(M:List(0)[1].on).toBe(nil)
    assert(p.sizes.control.onChange)({ "5", "10" })
    expect(M:List(0)[1].sizes).toEqual({ ["5"] = true, ["10"] = true })
    assert(p.sizes.control.onChange)({ "5", "10", "20", "40" })
    expect(M:List(0)[1].sizes).toBe(nil)
    mock.click(p.reset)
    local e = M:List(0)[1]
    expect(e.kind).toBe("icon")
    expect(e.show).toBe(nil)
    expect(e.source).toBe("mine")
    mock.click(p.done)
    expect(p).never.toBeShown()
end

@test("while Edit is open the live frames wait; they get the changes when it closes")
local function waiting()
    mock.stub(M, "ActiveSpec", function(_: unknown): number
        return 0
    end)
    M:SetList({ { name = "Renewal", ids = { 139 }, kind = "icon" } }, 0)
    local f = editor()
    local p = editPanel(f, 1)
    local before = select(2, UI.GroupIndicators())
    click(p.kind.control, "square")
    expect(select(2, UI.GroupIndicators())).toBe(before)
    expect(M.publishPending).toBe(true)
    mock.click(p.done)
    expect(select(2, UI.GroupIndicators()) > before).toBe(true)
    expect((UI.GroupIndicators())[1].kind).toBe("square")
end

@test("Edit closes when its indicator goes, another spec is chosen, or the page hides")
local function editCloses()
    M:SetList({ { name = "A", ids = { 139 } }, { name = "B", ids = { 139 } } }, 0)
    local f = editor()
    local p = editPanel(f, 2)
    mock.click(shownRows(f)[2].remove)
    expect(p).never.toBeShown()
    p = editPanel(f, 1)
    assert(f.spec.onChange)(1)
    expect(p).never.toBeShown()
    assert(f.spec.onChange)(0)
    p = editPanel(f, 1)
    f:Hide()
    expect(p).never.toBeShown()
    M:RefreshEdit() -- closed: nothing
end

--------------------------------------------------------------------------------
-- The preview
--------------------------------------------------------------------------------

@test("the preview: three made-up players at the healer size, with the list being edited")
local function preview()
    M:SetList({ { name = "Renewal", ids = { 139 }, kind = "square", color = "fel" } }, 0)
    local view = M:PreviewView(newParent(300, 200))
    expect(#M.previewFrames).toBe(3)
    expect(view:GetHeight() > 70).toBe(true)
    local first = assert(M.previewFrames[1])
    local draw = mock.stub(first, "SetPreviewIndicators", first.SetPreviewIndicators)
    M:SetList({}, 0)
    expect(draw).toHaveBeenCalledTimes(1)
    M:PreviewView(newParent(300, 200))
end
