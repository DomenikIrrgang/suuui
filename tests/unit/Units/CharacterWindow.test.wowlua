-- Units/CharacterWindow: Blizzard's Character window restyled in place.
-- The header and the mode tabs; the identity line; the Pet tab (only with a
-- pet: the paper doll's pet view); the gear slots (quality,
-- empty), their popout arrows and the item flyout; the new-set popup; the
-- stats as a StatList (heads, labels, values in their colours, resistance
-- icons); the Stats | Sets | Titles row; New Set lined up with Equip and
-- Save; the right pane's toggle; the other tabs reskinned; the window's
-- addon loading late. The gear's wear (bars, the Durability block) is
-- tested with the Durability module.
--
-- Blizzard's window is driven as a player does (the key, clicks), and its
-- fields are changed only with mock.setField: anything the test writes or
-- calls into it directly runs tainted, and Blizzard's code would read it
-- tainted for the rest of the file.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, identityLine, petLine, statColor from "/Units/CharacterWindow"
import errorsSoFar from "../../helpers"
import tokenOf from "../SettingsUI/UiSettingsHelpers"
import type SkinTab from "/UI/WindowSkin"
import type ItemSlotSkin from "/UI/Inventory"
import type Sidebar from "/Units/CharacterWindow"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as errors from "wowlua:errors"

-- One of the game's frames by its global name.
local function frame(name: string): Frame
    return (assert(frames.find(name), name))
end
local function button(name: string): Button
    return (assert(frames.asButton(tbl.field(_G, name)), name))
end
-- The window's tabs, a tab's "chosen?"
local function tabsOf(): SkinTab[]
    return assert(assert(M.chrome).tabs)
end
local function chosen(t: SkinTab): unknown
    return assert(t.selected)()
end
local function sideRow(): Sidebar
    return assert(M.sidebar)
end
local function sideButton(i: number): Button
    return sideRow().tabs[i].button
end
local function slotSkin(name: string): ItemSlotSkin
    return assert(M.slotSkins[frame(name)])
end
local function popout(slot: string): Button
    return assert(frames.asButton(tbl.field(frame("Character" .. slot .. "Slot"), "popoutButton")))
end

local HELM, RING = 990301, 990302
mock.defineItem(HELM, { name = "Test Helm", quality = 4, equipLoc = "INVTYPE_HEAD", icon = 133071 })
mock.defineItem(RING, { name = "Test Band", quality = 1, equipLoc = "INVTYPE_FINGER", icon = 133344 })

local function open()
    if not frame("CharacterFrame"):IsShown() then
        mock.pressBinding("TOGGLECHARACTER0")
    end
    mock.advanceFrames(2)
end

local function tab(i: number)
    mock.click(frame("CharacterFrameModeTab" .. i))
    mock.advanceFrames(2)
end

-- wowlua 0.13.8 lacks the client's CR_PET_DODGE_BASE_STAT_TOOLTIP: with a
-- hunter's pet, Blizzard's pet stats stop at their dodge row's format
-- (newer wowlua has the string). Left out of the errors until then.
local EMULATOR_GAPS = { "PaperDollFrame.lua:792: bad argument #1 to 'format'" }

local function expectNoErrors()
    local errs: string[] = {}
    for _, e in ipairs(errorsSoFar()) do
        local gap = false
        for _, known in ipairs(EMULATOR_GAPS) do
            if e:find(known, 1, true) then
                gap = true
            end
        end
        if not gap then
            errs[#errs + 1] = e
        end
    end
    expect(errs).toEqual({})
end

@afterEach
local function cleanup()
    if frame("CharacterFrame"):IsShown() then
        mock.pressBinding("TOGGLECHARACTER0")
    end
    mock.advanceTime(0.1)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The shell, the identity
--------------------------------------------------------------------------------

@test("the header and the mode tabs in the design's order; the chosen tab by Blizzard's look, else its pane")
local function tabs()
    open()
    local labels: string[] = {}
    for _, t in ipairs(tabsOf()) do
        labels[#labels + 1] = t.label
    end
    -- (Pet: only while there's a pet, see below)
    expect(labels).toEqual({
        "Character",
        "Pet",
        "Reputation",
        "Currency",
        "Player vs. Player",
        "Skills",
        "Statistics",
    })
    expect(chosen(tabsOf()[1])).toBe(true)
    expect(chosen(tabsOf()[3])).toBe(false)
    -- a tab without Blizzard's selected texture: chosen while its pane shows
    local rep = tabsOf()[3]
    mock.setField(rep.button, "SelectedTexture", nil)
    expect(chosen(rep)).toBe(false)
    tab(2)
    expect(chosen(rep)).toBe(true)
    tab(1)
    -- a pane the client lacks: not chosen
    local gone = tabsOf()[7]
    mock.setField(gone.button, "SelectedTexture", nil)
    mock.setField(_G, "StatisticsFrame", nil)
    expect(chosen(gone)).toBe(false)
end

@test("opened straight on Reputation (U): the model's box and the name line stay hidden (found in game: over the list)")
local function openedOnReputation()
    open()
    expect(assert(M.modelBox)).toBeShown()
    mock.pressBinding("TOGGLECHARACTER0")
    mock.advanceFrames(2)
    -- as after a reload: the Character pane shown in the closed window, the
    -- box with it (closing the window had hidden both)
    frame("PaperDollFrame"):Show()
    assert(M.modelBox):Show()
    assert(M.identity):Show()
    mock.pressBinding("TOGGLECHARACTER2")
    mock.advanceFrames(2)
    expect(frame("ReputationFrame")).toBeShown()
    expect(assert(M.modelBox):IsShown()).toBe(false)
    -- the name line too (found in game: it stayed over Reputation)
    expect(assert(M.identity):IsShown()).toBe(false)
    -- the Character tab and back: shown, then gone
    tab(1)
    expect(assert(M.modelBox)).toBeShown()
    expect(assert(M.identity)).toBeShown()
    tab(2)
    expect(assert(M.modelBox):IsShown()).toBe(false)
    expect(assert(M.identity):IsShown()).toBe(false)
end

@test("the identity line: the class diamond, the name, level, race and class; again at a level up")
local function identity()
    open()
    local id = assert(M.identity)
    expect(id).toBeShown()
    expect(id.name:GetText() :: unknown).toBe(SuuUI.FullName("player"))
    local className, class = UnitClass("player")
    expect(id.line:GetText()).toBe(identityLine(UnitLevel("player"), UnitRace("player") :: string, className :: string))
    expect(tokenOf(id.diamond)).toBe("class-" .. (class :: string):lower())
    expect(identityLine(nil, nil, nil)).toBe("Level ?")
    expect(identityLine(5, "Orc", nil)).toBe("Level 5 · Orc")
    -- a level up: drawn again
    local update = mock.stub(M, "UpdateIdentity")
    mock.fireEvent("PLAYER_LEVEL_UP", 61, 0, 0, 0, 0, 0, 0, 0, 0, 0)
    expect(update).toHaveBeenCalled()
    -- off the Character tab: hidden
    tab(2)
    expect(id).never.toBeShown()
    tab(1)
    expect(id).toBeShown()
end

--------------------------------------------------------------------------------
-- The Pet tab
--------------------------------------------------------------------------------

local function petTab(): Button
    return assert(M.petTab)
end
local function petPane(): Frame
    return frame("CharacterStatsPanePetScrollBox")
end
-- Blizzard's own Pet side button: out of sight, not clickable
local function expectGameButtonHidden()
    local b = button("PaperDollSidebarTab4")
    expect(b:GetAlpha()).toBe(0)
    expect(b:IsMouseEnabled()).toBe(false)
end

-- A hunter's wolf (gone again: dismissPet).
local function tamePet(): mock.MockUnit
    local wolf = mock.spawnUnit({
        name = "Fang",
        level = 19,
        reaction = "friendly",
        health = 400,
        maxHealth = 400,
        creatureType = "Beast",
        creatureFamily = "Wolf",
        creatureFamilyID = 1,
    })
    mock.setPet(wolf, { hunter = true, happiness = 3, loyalty = "Loyalty Level 2", xp = 300, xpMax = 1200 })
    mock.advanceFrames(2)
    return wolf
end
local function dismissPet(wolf: mock.MockUnit)
    mock.setPet(nil)
    mock.advanceFrames(2)
    wolf:despawn()
end

@test("the pet's line: level, family, loyalty, a hunter's pet's mood in its colour")
local function petLines()
    local c = SuuUI.Tokens.color
    expect(petLine(19, "Wolf", nil, nil)).toBe("Level 19 · Wolf")
    expect(petLine(nil, nil, nil, 1)).toBe("Level ? · |cff" .. c["ember-text"].hex .. PET_HAPPINESS1 .. "|r")
    expect(petLine(5, "Imp", nil, 2)).toBe("Level 5 · Imp · |cff" .. c.amber.hex .. PET_HAPPINESS2 .. "|r")
    -- no such mood: left out
    expect(petLine(5, "Imp", nil, 7)).toBe("Level 5 · Imp")
end

@test("without a pet: no Pet tab; Blizzard's Pet side button out of sight")
local function noPet()
    open()
    expect(HasPetUI()).toBe(false)
    expect(petTab():IsShown()).toBe(false)
    expect(chosen(tabsOf()[2])).toBe(false)
    expectGameButtonHidden()
end

@test(
    "a hunter's pet: the Pet tab after Character; chosen, the pet's view without Stats | Sets | Titles; Character again: the stats"
)
local function petView()
    local wolf = tamePet()
    open()
    local pet = petTab()
    expect(pet).toBeShown()
    -- in the row right after Character
    local point, rel, relPoint = pet:GetPoint(1)
    expect(point).toBe("BOTTOMLEFT")
    expect(rel).toBe(frame("CharacterFrameModeTab1"))
    expect(relPoint).toBe("BOTTOMRIGHT")
    expect(chosen(tabsOf()[2])).toBe(false)
    -- chosen: Blizzard's pet side pane (the model, the stats, the experience)
    mock.click(pet)
    mock.advanceFrames(2)
    expect(petPane()).toBeShown()
    expect(frame("CharacterStatsPaneScrollBox"):IsShown()).toBe(false)
    expect(tbl.field(frame("PaperDollFrame"), "selectedTab")).toBe(4)
    expect(frame("PaperDollItemsFrame"):IsShown()).toBe(false)
    expect(frame("PetPaperDollFrameExpBar")).toBeShown()
    expect(chosen(tabsOf()[2])).toBe(true)
    expect(chosen(tabsOf()[1])).toBe(false)
    expect(sideRow().row:IsShown()).toBe(false)
    expect(sideButton(1):GetAlpha()).toBe(0)
    -- the identity line the pet's
    local id = assert(M.identity)
    expect(id.name:GetText()).toBe("Fang")
    expect(id.line:GetText()).toBe(petLine(19, "Wolf", "Loyalty Level 2", 3))
    expect(id.line:GetText()).toBe(
        "Level 19 · Wolf · Loyalty Level 2 · |cff" .. SuuUI.Tokens.color.fel.hex .. PET_HAPPINESS3 .. "|r"
    )
    expectGameButtonHidden()
    -- Blizzard's happiness face: here only
    expect(frame("PetPaperDollPetHappinessInfo"):GetAlpha()).toBe(1)
    -- the experience bar in SuuUI's progress look
    local fill = assert(frames.asTexture(tbl.field(frame("PetPaperDollFrameExpBar"), "Fill")))
    local r, g, b = fill:GetVertexColor()
    local want = SuuUI.Tokens.color["progress-fill"]
    expect(r).toBeCloseTo(want[1])
    expect(g).toBeCloseTo(want[2])
    expect(b).toBeCloseTo(want[3])
    -- Character again: the stats, the row, the player's line
    tab(1)
    expect(frame("CharacterStatsPaneScrollBox")).toBeShown()
    expect(petPane():IsShown()).toBe(false)
    expect(frame("PaperDollItemsFrame")).toBeShown()
    expect(chosen(tabsOf()[1])).toBe(true)
    expect(chosen(tabsOf()[2])).toBe(false)
    expect(sideRow().row).toBeShown()
    expect(sideButton(1):GetAlpha()).toBe(1)
    expect(id.name:GetText() :: unknown).toBe(SuuUI.FullName("player"))
    expectGameButtonHidden()
    -- (the face sat over the head slot)
    expect(frame("PetPaperDollPetHappinessInfo"):GetAlpha()).toBe(0)
    expect(frame("PetPaperDollPetHappinessInfo"):IsMouseEnabled()).toBe(false)
    dismissPet(wolf)
end

@test("your model changing (a fight: the weapons drawn) keeps the pet in its view; Character again: yours")
local function petModelKept()
    local wolf = tamePet()
    open()
    mock.click(petTab())
    mock.advanceFrames(2)
    expect(M:PetShowing()).toBe(true)
    local setPet = mock.spy(function() end)
    mock.stub(_G, "PaperDollFrame_SetPet", setPet)
    -- the game sets the scene to you on UNIT_MODEL_CHANGED: the pet again
    -- (called as the game calls it: wowlua 0.13.8's paper doll stops its
    -- OnShow before it registers that event, see EMULATOR_GAPS)
    PaperDollFrame_SetPlayer()
    expect(setPet).toHaveBeenCalledTimes(1)
    -- the Character tab again: the game sets you, and you stay
    tab(1)
    mock.advanceFrames(2)
    expect(M:PetShowing()).toBe(false)
    expect(setPet).toHaveBeenCalledTimes(1)
    dismissPet(wolf)
end

@test("the Pet tab from another tab: the Character pane in its pet view")
local function petFromReputation()
    local wolf = tamePet()
    open()
    tab(2)
    expect(frame("ReputationFrame")).toBeShown()
    mock.click(petTab())
    mock.advanceFrames(2)
    expect(frame("ReputationFrame"):IsShown()).toBe(false)
    expect(frame("PaperDollFrame")).toBeShown()
    expect(petPane()).toBeShown()
    expect(chosen(tabsOf()[2])).toBe(true)
    -- closed: the pet's view over (Blizzard forgets its side pane), the row back
    mock.pressBinding("TOGGLECHARACTER0")
    mock.advanceFrames(2)
    expect(M:PetMode()).toBe(false)
    expect(sideRow().row).toBeShown()
    open()
    expect(chosen(tabsOf()[2])).toBe(false)
    expect(chosen(tabsOf()[1])).toBe(true)
    dismissPet(wolf)
end

@test("the pet dismissed while its tab shows: the tab goes, the Character tab's stats again")
local function petDismissed()
    local wolf = tamePet()
    open()
    mock.click(petTab())
    mock.advanceFrames(2)
    expect(petPane()).toBeShown()
    dismissPet(wolf)
    expect(petTab():IsShown()).toBe(false)
    expect(petPane():IsShown()).toBe(false)
    expect(frame("CharacterStatsPaneScrollBox")).toBeShown()
    expect(chosen(tabsOf()[1])).toBe(true)
    expect(sideRow().row).toBeShown()
    expectGameButtonHidden()
    -- a pet again (summoned in a fight: SuuUI's own button, shown in combat too)
    mock.player:enterCombat()
    local again = tamePet()
    expect(petTab()).toBeShown()
    expectGameButtonHidden()
    mock.player:leaveCombat()
    dismissPet(again)
end

--------------------------------------------------------------------------------
-- The gear
--------------------------------------------------------------------------------

@test("a gear slot: its quality edge, an empty one dimmed; a piece equipped or taken off redraws it")
local function slots()
    open()
    local skin = slotSkin("CharacterHeadSlot")
    mock.player:equip(1, HELM)
    mock.advanceTime(0.1)
    expect(assert(skin.item).quality).toBe("epic")
    expect(assert(skin.item).dim).toBe(false)
    mock.player:equip(1, nil)
    mock.advanceTime(0.1)
    expect(assert(skin.item).dim).toBe(true)
    -- a plain item: common
    mock.player:equip(11, RING)
    mock.advanceTime(0.1)
    expect(assert(slotSkin("CharacterFinger0Slot").item).quality).toBe("common")
    mock.player:equip(11, nil)
end

local function glyphOf(slot: string): Texture
    for _, r in ipairs({ popout(slot):GetRegions() }) do
        local t = r:GetObjectType() == "Texture" and r :: Texture
        if t and t:GetTexture() and tostring(t:GetTextureFilePath()):find("Glyphs") then
            return t
        end
    end
    error("no glyph")
end

@test("the popout arrows point away from their slot (down for weapons) and light up on hover")
local function popouts()
    open()
    expect(tostring(glyphOf("Head"):GetTextureFilePath()):find("chevronRight") ~= nil).toBe(true)
    expect(tostring(glyphOf("Hands"):GetTextureFilePath()):find("chevronLeft") ~= nil).toBe(true)
    expect(tostring(glyphOf("MainHand"):GetTextureFilePath()):find("chevronDown") ~= nil).toBe(true)
    -- in Sets mode the arrows show
    mock.click(sideButton(2))
    mock.advanceFrames(2)
    local p = popout("Head")
    mock.hover(p)
    expect(tokenOf(glyphOf("Head"))).toBe("gilt")
    mock.hover(nil)
    expect(tokenOf(glyphOf("Head"))).toBe("gilt-text")
    mock.click(sideButton(1))
end

@test("the item flyout: glass in a gilt edge, its items as SuuUI slots")
local function flyout()
    mock.setBag(0, { slots = 16, items = { [1] = { id = HELM } } })
    open()
    mock.click(sideButton(2))
    mock.advanceFrames(2)
    mock.click(popout("Head"))
    mock.advanceFrames(2)
    local fly = frame("EquipmentFlyoutFrame")
    expect(fly).toBeShown()
    local holder = frames.asFrame(tbl.field(fly, "buttonFrame")) or fly
    expect(tokenOf(M.flyoutGlass[holder])).toBe("surface-glass")
    expect(M.flyoutSkins[frame("EquipmentFlyoutFrameButton1")] ~= nil).toBe(true)
    mock.click(popout("Head"))
    mock.click(sideButton(1))
    mock.setBag(0, { slots = 16, items = {} })
end

@test("the new-set popup: glass, beside the window, its icon grid above Okay and Cancel")
local function setPopup()
    open()
    mock.click(sideButton(2))
    mock.advanceFrames(2)
    mock.click(button("PaperDollFrameNewSet"))
    mock.advanceFrames(2)
    local pop = frames.find("GearManagerPopupFrame") or
        assert(frames.asFrame(tbl.field(frame("PaperDollFrame"), "GearManagerPopupFrame")))
    expect(pop).toBeShown()
    local point, rel, relPoint = pop:GetPoint(1)
    expect(point).toBe("TOPLEFT")
    expect(rel).toBe(frame("CharacterFrame"))
    expect(relPoint).toBe("TOPRIGHT")
    mock.pressKey("ESCAPE")
    mock.advanceFrames(2)
    mock.click(sideButton(1))
end

--------------------------------------------------------------------------------
-- The stats
--------------------------------------------------------------------------------

-- A row with texts { text, r, g, b }, left to right; the row and its texts.
type StatText = { text: string, r: number, g: number, b: number }
local function statRow(texts: StatText[], height: number?): (Frame, FontString[])
    local row = CreateFrame("Frame", nil, UIParent)
    row:SetSize(200, height or 16)
    local made: FontString[] = {}
    for i, t in ipairs(texts) do
        local fs = row:CreateFontString(nil, "ARTWORK", "GameFontNormal")
        fs:SetText(t.text)
        fs:SetTextColor(t.r, t.g, t.b)
        fs:SetPoint("LEFT", (i - 1) * 100, 0)
        made[i] = fs
    end
    return row, made
end
local function st(text: string, r: number, g: number, b: number): StatText
    return { text = text, r = r, g = g, b = b }
end

@test("a stat row: a head in gilt-text; a label ink-muted, a value fel for a bonus, ember for a malus, else ink")
local function statRows()
    -- a head: one text
    local head, ht = statRow({ st("Attributes", 1, 1, 1) })
    M:SkinStatRow(head)
    expect(tokenOf(ht[1])).toBe("gilt-text")
    expect(M.statRules[head]).never.toBeShown()
    -- a stat: label and value found left to right
    local row, rt = statRow({ st("Strength", 1, 1, 1), st("42", 0.1, 1, 0.1) })
    M:SkinStatRow(row)
    expect(tokenOf(rt[1])).toBe("ink-muted")
    expect(tokenOf(rt[2])).toBe("fel")
    expect(M.statRules[row]).toBeShown()
    expect(statColor(1, 0.1, 0.1)).toBe("ember-text")
    expect(statColor(1, 1, 1)).toBe("ink")
    -- Blizzard's own keys, and a resistance's icon in a child frame: kept, made 18 px
    local res, rs = statRow({ st("Fire", 1, 1, 1), st("10", 1, 1, 1) })
    mock.setField(res, "Label", rs[1])
    mock.setField(res, "Value", rs[2])
    local holder = CreateFrame("Frame", nil, res)
    local icon = holder:CreateTexture(nil, "ARTWORK")
    icon:SetSize(23, 23)
    local text = holder:CreateFontString(nil, "ARTWORK", "GameFontNormal")
    text:SetText("x")
    local banner = holder:CreateTexture(nil, "BACKGROUND")
    banner:SetSize(200, 16)
    M:SkinStatRow(res)
    expect(icon:GetWidth()).toBe(18)
    expect(icon:GetAlpha()).toBe(1)
    expect(banner:GetAlpha()).toBe(0)
    -- texts whose places can't be read (secret, in combat): taken in order
    local secret, sc = statRow({ st("Agility", 1, 1, 1), st("7", 1, 1, 1) })
    mock.stub(sc[1], "GetLeft", function(): unknown
        return mock.secret(5)
    end)
    M:SkinStatRow(secret)
    expect(tokenOf(sc[1])).toBe("ink-muted")
end

@test("the stats pane without a view: its rows from the box's children")
local function statsPane()
    local pane = CreateFrame("Frame", nil, UIParent)
    local box = CreateFrame("Frame", nil, pane)
    local target = CreateFrame("Frame", nil, box)
    mock.setField(pane, "ScrollBox", box)
    mock.setField(box, "ScrollTarget", target)
    local row, texts = statRow({ st("Stamina", 1, 1, 1), st("9", 1, 1, 1) })
    row:SetParent(target)
    mock.setField(_G, "CharacterStatsPaneScrollBox", pane)
    M:SkinStatsPane()
    expect(tokenOf(texts[1])).toBe("ink-muted")
end

--------------------------------------------------------------------------------
-- The side row, the sets, the right pane, the other tabs
--------------------------------------------------------------------------------

@test("Stats | Sets | Titles: the chosen one arcane, a hovered one ink; New Set as wide as Equip and Save")
local function sidebar()
    open()
    local b = sideRow().tabs
    expect(tokenOf(b[1].label)).toBe("arcane")
    mock.hover(b[2].button)
    expect(tokenOf(b[2].label)).toBe("ink")
    mock.hover(nil)
    expect(tokenOf(b[2].label)).toBe("ink-muted")
    mock.click(b[2].button)
    mock.advanceFrames(2)
    expect(tokenOf(b[2].label)).toBe("arcane")
    -- the sets: New Set lined up
    local new, equip, save = frame("PaperDollFrameNewSet"),
        frame("PaperDollFrameEquipSet"),
        frame("PaperDollFrameSaveSet")
    expect(math.abs(new:GetWidth() - (assert(save:GetRight()) - assert(equip:GetLeft()))) < 0.5).toBe(true)
    -- in combat the edges read secret: left as it is
    mock.stub(equip, "GetLeft", function(): unknown
        return mock.secret(1)
    end)
    M:AlignSetList()
    mock.click(b[1].button)
end

@test("the right pane's toggle: a chevron the way the pane goes, lit on hover")
local function rightToggle()
    open()
    local toggle = button("CharacterFrameRightPaneToggleButton")
    local chev = assert(M.toggleChevron)
    local right = frame("CharacterFrameRightPaneHost")
    local function pointsLeft(): boolean
        return tostring(chev:GetTextureFilePath()):find("chevronLeft") ~= nil
    end
    expect(pointsLeft()).toBe(right:IsShown())
    mock.click(toggle)
    mock.advanceFrames(2)
    expect(pointsLeft()).toBe(right:IsShown())
    mock.click(toggle)
    mock.advanceFrames(2)
    expect(pointsLeft()).toBe(right:IsShown())
    mock.hover(toggle)
    expect(tokenOf(chev)).toBe("ink")
    mock.hover(nil)
    expect(tokenOf(chev)).toBe("ink-muted")
end

@test("the other tabs and the titles: Blizzard's lists reskinned when shown")
local function panes()
    open()
    local reskin = mock.stub(SuuUI.UI, "Reskin", function() end)
    tab(2)
    expect(reskin).toHaveBeenCalledWith(frame("ReputationFrame"))
    tab(1)
end

@test("a detail pane's wrapped rows: in caption, as tall as their text (SuuUI's font ran them past the window)")
local function sidePaneRows()
    open()
    tab(3)
    local pane = assert(frames.asFrame(tbl.field(frame("SkillsFrame"), "SkillDetailFrame")))
    errors.tryMethod(pane, "ResetRows")
    local text = "Chance to Hit, and to avoid being Dodged or Parried: -10.92%. Chance to Critically Hit: -10.92%. Glancing Blows occur 100% of the time and deal 89% less damage."
    errors.tryMethod(pane, "AddWrappedRow", text)
    errors.tryMethod(pane, "LayoutRows")
    -- (as SuuUI's pass runs a frame after the pane shows)
    mock.advanceFrames(2)
    local pools = tbl.field(pane, "rowPools")
    local iter, state, init = errors.tryMethod(
        pools,
        "EnumerateActiveByTemplate",
        "CharacterFrameSidePaneWrappedRowTemplate"
    )
    local step = iter :: (unknown, unknown) -> unknown
    local row = assert(frames.asFrame(step(state, init)))
    local label = assert(frames.asFontString(tbl.field(row, "Label")))
    expect(label:GetFontObject()).toBe(SuuUI.Fonts.Get("caption"))
    expect(math.abs(row:GetHeight() - label:GetStringHeight()) < 0.5).toBe(true)
    tab(1)
end

@test(
    "a detail pane's description as tall as its text in the room it has, its scroll bar only when it doesn't fit (found in game)"
)
local function sidePaneDescription()
    open()
    tab(3)
    local pane = assert(frames.asFrame(tbl.field(frame("SkillsFrame"), "SkillDetailFrame")))
    local desc = assert(frames.asFrame(tbl.field(pane, "Description")))
    local bar = assert(frames.asFrame(tbl.field(pane, "DescriptionScrollBar")))
    errors.tryMethod(pane, "ResetRows")
    local text = "Higher fishing skill increases your chance of catching fish in bodies of water around the world. If you are having trouble catching fish in a given area, move to a lower level area or purchase a better fishing pole."
    -- the game's height for a skill (120): taller for SuuUI's font, no bar
    errors.tryMethod(pane, "SetDescription", text, 120)
    errors.tryMethod(pane, "LayoutRows")
    local fs = assert(frames.asFontString(errors.tryMethod(desc, "GetFontString")))
    expect(desc:GetHeight() >= fs:GetStringHeight() + select(2, fs:GetFont()) * 0.5).toBe(true)
    expect(bar:IsShown()).toBe(false)
    -- its font changed after (SuuUI's pass, a frame later): fitted again
    fs:SetFontObject(SuuUI.Fonts.Get("header"))
    expect(desc:GetHeight() >= fs:GetStringHeight() + select(2, fs:GetFont()) * 0.5).toBe(true)
    -- far more than the pane holds: as tall as the room, with its bar
    errors.tryMethod(pane, "SetDescription", text:rep(20), 120)
    errors.tryMethod(pane, "LayoutRows")
    expect(desc:GetHeight() < fs:GetStringHeight()).toBe(true)
    expect(bar:IsShown()).toBe(true)
    tab(1)
end

@test("the window's addon loading after SuuUI: skinned then")
local function lateWindow()
    local skin = mock.stub(M, "Skin", function() end)
    local cf = frame("CharacterFrame")
    mock.setField(_G, "CharacterFrame", nil)
    M:OnEnable()
    expect(skin).never.toHaveBeenCalled()
    mock.setField(_G, "CharacterFrame", cf)
    mock.fireEvent("ADDON_LOADED", "Blizzard_CharacterUI", false)
    expect(skin).toHaveBeenCalled()
end
