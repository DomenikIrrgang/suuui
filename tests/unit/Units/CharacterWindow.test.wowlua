import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M from "/Units/CharacterWindow"
import internal M as DM from "/Units/DressingRoom"
import internal M as IM from "/Units/Inspect"
import internal M as CM from "/Units/Collections"

@test("probe world")
local function probe()
    for _, n in ipairs({ "CharacterFrame", "PaperDollFrame", "CharacterFrameLeftPaneHost", "CharacterFrameRightPaneHost", "CharacterModelScene",
        "CharacterHeadSlot", "CharacterStatsPaneScrollBox", "PaperDollSidebarTabs", "PaperDollSidebarTab1", "EquipmentFlyoutFrame",
        "GearManagerPopupFrame", "CharacterFrameRightPaneToggleButton", "ReputationFrame", "TokenFrame", "SkillsFrame", "PVPRankFrame",
        "StatisticsFrame", "CharacterFrameModeTab1", "PaperDollFrameNewSet", "InspectFrame", "DressUpFrame", "CollectionsJournal",
        "DurabilityFrame", "InspectFrame_Show", "DressUpItemTransmogInfoList", "TooltipDataProcessor", "C_GameRules", "LinkUtil", "ChatFrameUtil" }) do
        print(n, type(_G[n]))
    end
    for _, id in ipairs({ "character", "inspect", "dressingroom", "collections", "durability", "talents" }) do
        local m = SuuUI.GetModule(id)
        print(id, m and m.state)
    end
    local cm = M
    print("chrome", cm.chrome ~= nil, cm.identity ~= nil, cm.wearBlock ~= nil, cm.sidebar ~= nil, cm.modelBox ~= nil)
    print("load inspect", C_AddOns.LoadAddOn("Blizzard_InspectUI"))
    print("InspectFrame", type(_G.InspectFrame), type(_G.InspectFrame_Show))
    local im = IM
    print("inspect hooked", im.hooked)
    local f = _G.DressUpFrame :: any
    print("dressup", f and f.ModelScene, f and f.GetMode, f and f.ResetButton, f and f.GetLastLink, f and f.OnDressModel, f and f.SetMode)
    local dm = DM
    print("dress hooked", dm.hooked, dm.borrowed)
    print("collections mounts", #CM:Mounts(), #CM:Toys())
    print("TC", type(C_TransmogCollection), C_TransmogCollection and type(C_TransmogCollection.GetCategoryAppearances))
    print("MJ", type(C_MountJournal), C_MountJournal and C_MountJournal.GetMountIDs and #C_MountJournal.GetMountIDs())
    print("toys", #(SuuUI.CollectionSources().toys or {}))
    print("classInfo", GetClassInfo and GetClassInfo(2))
    print("UnitClass", UnitClass("player"), UnitRace("player"), UnitLevel("player"), SuuUI.FullName("player"))
    ShowUIPanel(_G.CharacterFrame)
    mock.advanceFrames(2)
    print("cf shown", _G.CharacterFrame:IsShown(), cm.identity and cm.identity:IsShown())
    print("names", cm.identity and cm.identity.name:GetText(), cm.identity and cm.identity.line:GetText())
    print("errors", #mock.errors())
    for _, e in ipairs(mock.errors()) do print(e) end
end
