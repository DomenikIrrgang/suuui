-- Units/AuctionHouse/Scan: Scan all: the house asked once, the mark and
-- progress, the list read a slice a frame, its wait; a late list, a scan
-- ended or the house closed meanwhile, a refused one; the Ledger's deals in
-- the foot after it. The engine's house
-- has no Scan all: stubbed (replicate, in the helpers).

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import internal M from "/Units/AuctionHouse"
import * as events from "/Core/Events"
import internal M as Ledger from "/Units/Ledger"
import ORE, BLADE, buy, setUp, tearDown, open, note, tipText, replicate from "./AuctionHouseHelpers"

local AH = C_AuctionHouse
-- the game's wait between two Scan alls
const SCAN_MINUTES = 15

@beforeEach
local function start()
    setUp()
end

@afterEach
local function cleanup()
    tearDown()
end

--------------------------------------------------------------------------------
-- Scan all
--------------------------------------------------------------------------------

@test("Scan all: the house asked once; while it runs the mark, the progress, the categories and Search wait")
local function scanRunning()
    open()
    expect(buy().scanWhen:GetText()).toBe("Not scanned yet")
    expect(buy().scanButton:IsEnabled()).toBe(true)
    local scan, setGot = replicate()
    mock.click(buy().scanButton)
    expect(scan).toHaveBeenCalled()
    expect(buy().scanView).toBeShown()
    expect(buy().catBlock).toBeShown()
    expect(buy().results).never.toBeShown()
    expect(buy().searchButton:IsEnabled()).toBe(false)
    expect(tipText(buy().searchButton)).toBe("Scanning: back when the scan is done.")
    expect(buy().scanButton:IsEnabled()).toBe(false)
    expect(buy().scanWhen:GetText()).toBe("Scanning…")
    expect(buy().scanCaption:GetText()).toBe("Asking the house for every auction… 0 s")
    mock.advanceTime(2)
    expect(buy().scanCaption:GetText()).toBe("Asking the house for every auction… 2 s")
    -- again while it runs: nothing more
    M:Scan()
    expect(scan).toHaveBeenCalledTimes(1)
    -- the auctions coming in
    setGot(1200)
    mock.advanceTime(0.3)
    expect(buy().scanCaption:GetText()).toBe("Received 1,200 auctions…")
    -- the categories' cover says why
    mock.hover(buy().catBlock)
    mock.hover(nil)
    -- (0.48) every item's look told at the end, in one flat list
    local scanned: unknown[][] = {}
    local listener = { name = "AuctionHouseScanTest" }
    events.on(
        "SUUUI_AUCTION_SCANNED",
        function(_, looks, items, names, qualities)
            scanned[#scanned + 1] = { looks, items, names, qualities }
        end,
        listener
    )
    -- the list came: read a slice a frame
    setGot(5000)
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    mock.advanceTime(0.01)
    expect(buy().scanCaption:GetText()).toBe("Reading 2,500 of 5,000…")
    -- told again while reading: nothing more
    M:ReadScan()
    mock.advanceTime(0.01)
    expect(M.scanning).toBe(nil)
    expect(note():find("^Scan done: 5,000 auctions, 2 items, in 2 s.") ~= nil).toBe(true)
    expect(assert(M:LowestSeen(ORE)).price).toBe(100)
    expect(assert(M:LowestSeen(BLADE)).price).toBe(40000)
    expect(assert(M:LowestSeen(BLADE)).qty).toBe(4990 - 998)
    local d = M:CharData()
    expect(d.scanCount).toBe(5000)
    expect(d.scanSeconds).toBe(2)
    expect(#scanned).toBe(1)
    expect(scanned[1][2]).toBe(2)
    local looks = scanned[1][1] :: number[]
    expect(#looks).toBe(10)
    -- (in the order the scan's items come)
    local byItem: { [number]: number[] } = {}
    for k = 0, 1 do
        byItem[looks[k * 5 + 1]] = { looks[k * 5 + 2], looks[k * 5 + 3], looks[k * 5 + 4], looks[k * 5 + 5] }
    end
    expect(byItem[ORE]).toEqual({ 100, 0, 200, 10 })
    expect(byItem[BLADE]).toEqual({ 40000, 0, 3992, 3992 })
    -- the names the house told, by item (not the blade's: its auctions'
    -- names differ by their suffixes)
    expect(scanned[1][3]).toEqual({ [ORE] = "Test Ore" })
    expect(scanned[1][4]).toEqual({ [ORE] = 1 })
    events.offAll(listener)
    -- after: the game's wait
    expect(buy().scanView).never.toBeShown()
    expect(buy().searchButton:IsEnabled()).toBe(true)
    expect(buy().scanButton:IsEnabled()).toBe(false)
    expect(buy().scanWhen:GetText()).toBe("Again in 15 min")
    expect(assert(tipText(buy().scanButton)):find("one full scan every 15 minutes") ~= nil).toBe(true)
    -- the list told with nothing asked: nothing
    M:ReadScan()
    expect(M.scanning).toBe(nil)
end

-- (X-4.5) The reader is kept: a scan that ends while its list is read
-- stops it, so no slice is read and nothing is told after.
@test("a scan ended while its list is read: the reader stops, nothing kept or told")
local function scanEndedMidRead()
    open()
    local d = M:CharData()
    d.scanCount = 7
    local _, setGot = replicate()
    mock.click(buy().scanButton)
    setGot(5000)
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    mock.advanceTime(0.01)
    expect(buy().scanCaption:GetText()).toBe("Reading 2,500 of 5,000…")
    local reader = assert(M.readTicker)
    M:EndScan()
    expect(M.readTicker).toBe(nil)
    expect(reader:IsCancelled()).toBe(true)
    mock.advanceTime(0.1)
    expect(note():find("^Scan done") == nil).toBe(true)
    expect(d.scanCount).toBe(7)
    -- a reader still running when its scan is gone stops itself (asked
    -- directly: the button waits the game's 15 minutes from the request)
    expect(buy().scanButton:IsEnabled()).toBe(false)
    M:Scan()
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    local again = assert(M.readTicker)
    M.scanning = nil
    mock.advanceTime(0.01)
    expect(again:IsCancelled()).toBe(true)
    expect(note():find("^Scan done") == nil).toBe(true)
    expect(d.scanCount).toBe(7)
    M:EndScan()
end

@test(
    "Scan all's wait counts down while the window is open; the last scan's time; its size for the next one's progress"
)
local function scanWait()
    mock.advanceTime(3600) -- (the emulated clock starts at midnight: a scan 15 min ago today)
    open()
    local d = M:CharData()
    d.scanAt = time() - 14 * 60
    M:DrawScan()
    expect(buy().scanWhen:GetText()).toBe("Again in 1 min")
    -- the window's ticker (every 30 s): one after the wait's end
    mock.advanceTime(91)
    expect(mock.textOf(buy().scanWhen):find("^Last scan today %d%d:%d%d$") ~= nil).toBe(true)
    expect(buy().scanButton:IsEnabled()).toBe(true)
    d.scanAt = time() - 86400 - 3600
    M:DrawScan()
    expect(buy().scanWhen:GetText()).toBe("Last scan yesterday")
    d.scanAt = time() - 3 * 86400 - 60
    M:DrawScan()
    expect(buy().scanWhen:GetText()).toBe("Last scan 3 days ago")
    -- the last scan took 30 s and read 48,183
    d.scanSeconds, d.scanCount = 30, 48183
    local _, setGot = replicate()
    mock.click(buy().scanButton)
    expect(buy().scanCaption:GetText()).toBe("Asking the house for every auction… about 30 s left")
    mock.advanceTime(31)
    expect(buy().scanCaption:GetText()).toBe("Asking the house for every auction… any moment now")
    setGot(1000)
    mock.advanceTime(0.3)
    expect(buy().scanCaption:GetText()).toBe("Received 1,000 of about 48,183 auctions…")
    -- no list in a minute: the game didn't run it
    setGot(0)
    mock.advanceTime(30)
    expect(M.scanning).toBe(nil)
    expect(note()).toBe("The scan didn't come back; try again later.")
end

-- (BAG-17) The game counts its 15 minutes from the request: the wait is kept
-- when the house is asked, the view gives up after a minute (or twice the
-- last scan's time), and a list that comes later while the house is open
-- is still read.
@test("Scan all: the wait counts from the request; a list after the view gave up is still read")
local function scanLateList()
    mock.advanceTime(3600)
    open()
    local d = M:CharData()
    local _, setGot = replicate()
    mock.click(buy().scanButton)
    expect(d.scanAsked).toBe(time())
    expect(d.scanAt).toBe(nil)
    mock.advanceTime(61)
    expect(M.scanning).toBe(nil)
    expect(note()).toBe("The scan didn't come back; try again later.")
    -- no second request the game would refuse
    expect(buy().scanButton:IsEnabled()).toBe(false)
    expect(buy().scanWhen:GetText()).toBe("Again in 14 min")
    -- the list after all
    setGot(5000)
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    expect(buy().scanView).toBeShown()
    mock.advanceTime(0.01)
    mock.advanceTime(0.01)
    expect(M.scanning).toBe(nil)
    expect(note():find("^Scan done: 5,000 auctions, 2 items") ~= nil).toBe(true)
    expect(assert(M:LowestSeen(ORE)).price).toBe(100)
    expect(d.scanCount).toBe(5000)
    -- told again: nothing more
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    expect(M.scanning).toBe(nil)
    -- a slow last scan: the view waits twice as long
    d.scanSeconds = 50
    mock.advanceTime(SCAN_MINUTES * 60)
    setGot(0)
    M:Scan()
    mock.advanceTime(90)
    expect(M.scanning ~= nil).toBe(true)
    mock.advanceTime(11)
    expect(M.scanning).toBe(nil)
end

-- (X-4.5) Closing the house ends a running scan: the reader and the progress
-- stop, what was read is dropped (nothing half kept), the request still counts
-- for the game's wait, and the next open shows the button waiting, not
-- scanning.
@test("closing the house while a scan waits for its list ends it; reopened, the button waits the game's time")
local function scanClosedWaiting()
    mock.advanceTime(3600)
    open()
    local d = M:CharData()
    local _, setGot = replicate()
    mock.click(buy().scanButton)
    mock.advanceTime(2)
    local ticker = assert(M.scanTicker)
    AH.CloseAuctionHouse()
    mock.advanceTime(0.01)
    expect(M.scanning).toBe(nil)
    expect(M.scanTicker).toBe(nil)
    expect(ticker:IsCancelled()).toBe(true)
    expect(d.scanAsked ~= nil).toBe(true)
    -- the list arriving after the close: not read
    setGot(5000)
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    mock.advanceTime(0.1)
    expect(M.scanning).toBe(nil)
    expect(M.readTicker).toBe(nil)
    expect(M:LowestSeen(ORE)).toBe(nil)
    -- the minute's timeout says nothing more
    mock.advanceTime(60)
    -- reopened: no scanning view; the button waits from the request
    open()
    expect(buy().scanView).never.toBeShown()
    expect(buy().searchButton:IsEnabled()).toBe(true)
    expect(buy().scanButton:IsEnabled()).toBe(false)
    expect(buy().scanWhen:GetText()).toBe("Again in 14 min")
    expect(note()).toBe("The last scan stopped when the house closed; nothing of it was kept.")
    -- once the game's wait is over: ready again
    mock.advanceTime(SCAN_MINUTES * 60)
    M:DrawScan()
    expect(buy().scanButton:IsEnabled()).toBe(true)
    expect(buy().scanWhen:GetText()).toBe("Not scanned yet")
end

@test("closing the house while a scan reads its list stops the reader; nothing of it is kept")
local function scanClosedReading()
    mock.advanceTime(3600)
    open()
    local d = M:CharData()
    d.scanCount, d.scanSeconds = 7, 3
    local _, setGot = replicate()
    mock.click(buy().scanButton)
    setGot(5000)
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    mock.advanceTime(0.01)
    expect(buy().scanCaption:GetText()).toBe("Reading 2,500 of 5,000…")
    local reader = assert(M.readTicker)
    AH.CloseAuctionHouse()
    expect(reader:IsCancelled()).toBe(true)
    expect(M.readTicker).toBe(nil)
    expect(M.scanning).toBe(nil)
    mock.advanceTime(0.1)
    -- nothing of the half read: no prices, the last complete scan's size kept
    expect(M:LowestSeen(ORE)).toBe(nil)
    expect(M:LowestSeen(BLADE)).toBe(nil)
    expect(d.scanAt).toBe(nil)
    expect(d.scanCount).toBe(7)
    open()
    expect(buy().scanView).never.toBeShown()
    expect(buy().scanButton:IsEnabled()).toBe(false)
    expect(buy().scanWhen:GetText()).toBe("Again in 15 min")
    expect(note()).toBe("The last scan stopped when the house closed; nothing of it was kept.")
    -- the same list told again on this visit: not read (nothing asked)
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    expect(M.scanning).toBe(nil)
end

@test("Scan all that doesn't go out says so")
local function scanRefused()
    open()
    mock.stub(AH, "ReplicateItems", function()
        error("not now")
    end)
    mock.click(buy().scanButton)
    expect(M.scanning).toBe(nil)
    expect(note():find("^Couldn't scan: ") ~= nil).toBe(true)
    expect(buy().scanView).never.toBeShown()
end

@test("after Scan all, once the Ledger read it: the foot says its deals; none found, the house's own note stays")
local function scanDeals()
    -- the ore's usual 2s: the scan's 1c each is far under (the blade has
    -- no look before, so no deal)
    for k = 3, 1, -1 do
        Ledger:RecordLook(ORE, 200, 0, 10, 2, time() - k * 86400)
    end
    open()
    local _, setGot = replicate()
    mock.click(buy().scanButton)
    setGot(5000)
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    mock.advanceTime(0.01)
    mock.advanceTime(0.01)
    expect(M.scanning).toBe(nil)
    -- the Ledger reads it, then tells
    for _ = 1, 3 do
        mock.advanceTime(0.01)
    end
    expect(assert(Ledger:LastScan()).deals).toBe(1)
    expect(note()).toBe("Scan done: 1 deal, 0 under vendor price.")
    -- another note since: left alone
    M:Note("Bought.", "ok")
    M:ScanDeals()
    expect(note()).toBe("Bought.")
    -- a scan without deals: the house's own note stays
    local d = Ledger:Data()
    d.prices, d.scans = nil, nil
    Ledger:DropIndexes()
    M:Note("Scan done: 5,000 auctions, 2 items, in 2 s.")
    Ledger:Emit("SUUUI_AUCTION_SCANNED", { ORE, 100, 0, 10, 1 }, 1)
    for _ = 1, 3 do
        mock.advanceTime(0.01)
    end
    expect(note()).toBe("Scan done: 5,000 auctions, 2 items, in 2 s.")
    d.prices, d.scans = nil, nil
    Ledger:DropIndexes()
end
