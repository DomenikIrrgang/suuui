import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import expectNoErrors, layoutThemes, useTheme, COMPACT from "../../../helpers"
import tokenOf from "../../SettingsUI/UiSettingsHelpers"
import internal M from "/Units/AuctionHouse"
import type CatButton, Category from "/Units/AuctionHouse/Buy"
import internal M as Bags from "/Units/Bags"
import internal M as Professions from "/Units/Professions"
import AUCTION_HOUSE from "/Core/ServiceKeys"
import type TextField from "/UI/Inputs"
import ORE, BLADE, GEM, state, buy, setUp, tearDown, open, win, note, search, shown, resultNamed, recordQueries from "./AuctionHouseHelpers"
import FavButton from "/Units/AuctionHouse/Buy"
import type AuctionHouseModule from "/Units/AuctionHouse"
import newParent from "../../../helpers"
import internal M as Ledger from "/Units/Ledger"
import * as priceStore from "../../Core/Prices/PricesHelpers"
