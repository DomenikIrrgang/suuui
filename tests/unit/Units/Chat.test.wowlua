-- Units/Chat: SuuUI's chat over Blizzard's (the emulated client runs
-- Blizzard's chat frames). The panel and where ChatFrame1 goes, the mirrors
-- (lines copied, formatted, timed, raw, secret, trimmed, redrawn), links
-- (copy a line, a player's menu, items, tooltips), the mouse wheel, names'
-- classes, whispers kept and whisper windows, the input's history (Enter,
-- your own lines, Up and Down, combat, lockdown), the tabs (order, select,
-- unread, right-click, the combat log's bar, fonts, names, new and closed
-- windows, dragging, edit mode, sliding), kept chat (saved, loaded,
-- restored, dimmed, the divider, cleared), the Search tab, the idle fade,
-- the Global tab, the settings section, a theme change.

import test, expect, beforeEach, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import * as secret from "wowlua:secret"
import * as chat from "wowlua:chat"
import SuuUI from "/Core/API"
import * as events from "/Core/Events"
import * as registry from "/SettingsUI/Registry"
import * as editMode from "/EditMode/EditMode"
import internal M, TabButton, SearchPage, SearchHeader, SearchChip, WindowsEditor, WindowRow, Mirror, Line, Kept from "/Units/Chat"
import expectNoErrors, newParent, captureMenus, choose, captureConfirm, testRow, TestRow from "../../helpers"
import printedSince, printedCount, hasLine, themeChanged from "../SettingsUI/UiSettingsHelpers"

local UI = SuuUI.UI
local T = SuuUI.Tokens
local CF1, CF2 = ChatFrame1, ChatFrame2

local LINE = "|Hplayer:Tamsin:12|h[Tamsin]|h says: hello there"

-- The module's windows ready (their mirrors are made a frame after login).
local function ready()
    if not M.mirrors[CF1] then mock.advanceFrames(2) end
end

local function mirror(cf: chat.Window): Mirror
    ready()
    return (assert(M.mirrors[cf], "no mirror"))
end

-- A window's message frame in SuuUI's panel.
local function frameOf(cf: chat.Window): ScrollingMessageFrameMixin & Frame
    return mirror(cf).frame
end

local function lastLine(cf: chat.Window): Line
    local m = mirror(cf)
    return m.lines[#m.lines]
end

-- A line's text, readable.
local function textOf(line: Line): string return secret.asString(line.text) or "" end
local function rendered(line: Line, withTime: boolean?): string return secret.asString(M:Render(line, withTime)) or "" end

-- The window named `name` (Blizzard's settings for it, or a whisper's player).
local function window(name: string): chat.Window?
    for _, cf in ipairs(M:Windows()) do
        local _, target = chat.conversation(cf)
        if GetChatWindowInfo(cf:GetID()) == name or target == name then return cf end
    end
    return nil
end

local function windowOf(name: string): chat.Window return (assert(window(name), "no window " .. name)) end

-- The shown tab button with this name.
local function findTab(name: string): TabButton?
    for _, b in ipairs(M:Panel().tabButtons) do
        if b:IsShown() and b.label:GetText() == name then return b end
    end
    return nil
end

local function tab(name: string): TabButton return (assert(findTab(name), "no tab " .. name)) end

-- A frame's left edge in UIParent units.
local function leftOf(f: Region): number
    return assert(f:GetLeft()) * f:GetEffectiveScale() / UIParent:GetEffectiveScale()
end

-- A message that isn't from Discord.
local NO_DISCORD = { userID = 0, globalName = "", lastOnlineGUID = "", lastOnlineName = "", hasAttachment = false,
    hasPoll = false, hasEmbed = false, hasSticker = false, hasEmoji = false, hasError = false,
    hasForwardedMessage = false, forwardedMessage = "", fromDiscord = false }

-- A chat event with every argument the client sends (lineID, the sender's GUID).
local function chatEvent(event: string, text: string, sender: string, guid: string, lineID: number)
    mock.fireEvent(event, text, sender, "", "", "", "", 0, 0, "", 0, lineID, guid, 0, false, false, false, false, NO_DISCORD)
end

-- A row of the chat's settings: what the tests use of it.
local function rowOf(label: string): TestRow
    local s = registry.get("chat") :: registry.Section
    for _, g in ipairs(s.groups or {}) do
        for _, r in ipairs(g.rows) do if r.label == label then return testRow(r) end end
    end
    error("no row " .. label)
end

-- The edit box with the keyboard focus, which must be there.
local function focused(): EditBox
    return (assert(frames.asEditBox(GetCurrentKeyBoardFocus()), "nothing has the keyboard focus"))
end

@beforeEach
local function start()
    ready()
end

@afterEach
local function cleanup()
    if editMode.isActive() then editMode.exit() end
    if InCombatLockdown() then mock.player:leaveCombat() end
    mock.setModifiers({ shift = false })
    if M.drag or M.press then M:EndDrag(false) end
    M:ResetAll({ "logHeight", "fadeIdle", "idleDelay", "globalTab", "timestamps", "classDiamonds",
                           "classNames", "shortChannels", "recall", "keepHistory", "tabReorder", "position" })
    M:CharData().tabOrder = nil
    M:CharData().history = nil
    M:CharData().kept = nil
    M.keyCapture, M.recall = nil, nil
    local focus: EditBox? = GetCurrentKeyBoardFocus()
    if focus then focus:ClearFocus() end
    M:Select(CF1)
    mock.advanceTime(1)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The panel
--------------------------------------------------------------------------------

@test("the panel: chat-w wide, its height from the lines' area; ChatFrame1 placed in it")
local function panel()
    local w, h = M:PanelSize()
    expect(w).toBe(UI.Size("chat-w"))
    expect(M:Panel():GetHeight()).toBeCloseTo(h)
    local left, bottom = M:LogRect()
    expect(leftOf(CF1)).toBeCloseTo(assert(left))
    expect(assert(CF1:GetBottom()) * CF1:GetEffectiveScale() / UIParent:GetEffectiveScale()).toBeCloseTo(bottom)
    M:Set("logHeight", M:Get("logHeight") + 40)
    expect(M:Panel():GetHeight()).toBeCloseTo(h + 40)
end

@test("a protected ChatFrame1 in combat is placed after it; Blizzard, edit mode or a new scale place it again")
local function placing()
    mock.protect(CF1, true)
    mock.player:enterCombat()
    M:PlaceChat()
    expect(M.pendingPlace).toBe(true)
    mock.player:leaveCombat()
    expect(M.pendingPlace).toBe(nil)
    mock.protect(CF1, false)
    if CF1.ApplySystemAnchor then
        pcall(CF1.ApplySystemAnchor, CF1)
        mock.advanceTime(0.01)
    end
    expect(leftOf(CF1)).toBeCloseTo(assert((M:LogRect())))
    M:Set("position", { point = "BOTTOMLEFT", x = 60, y = 28 })
    mock.advanceTime(0.01)
    expect(leftOf(CF1)).toBeCloseTo(assert((M:LogRect())))
    events.emit("SUUUI_ROOT_SCALED", UIParent:GetEffectiveScale())
    mock.advanceTime(0.01)
    expect(leftOf(CF1)).toBeCloseTo(assert((M:LogRect())))
    -- the game's own window events: skinned and placed a frame later
    mock.fireEvent("UPDATE_CHAT_WINDOWS")
    chatEvent("CHAT_MSG_WHISPER_INFORM", "x", "Tamsin", "", 1)
    mock.advanceTime(0.01)
    expect(leftOf(CF1)).toBeCloseTo(assert((M:LogRect())))
end

--------------------------------------------------------------------------------
-- Mirrors and lines
--------------------------------------------------------------------------------

@test("a line Blizzard adds is copied in the design's form: no brackets, the verb gone, the time while awake")
local function copied()
    CF1:AddMessage(LINE, 1, 1, 1)
    local line = lastLine(CF1)
    expect(line.src).toBe(LINE)
    expect(textOf(line):find("[Tamsin]", 1, true)).toBe(nil)
    expect(textOf(line):find("|h: hello there", 1, true) ~= nil).toBe(true)
    M.awake = true
    expect(rendered(line, M:ShowTimes()):find(date("%H:%M", line.at), 1, true) ~= nil).toBe(true)
    M:Set("timestamps", false)
    expect(M:Render(line, M:ShowTimes())).toBe(line.text)
end

@test("the combat log's lines and secret ones go in as they are")
local function raw()
    local log = mirror(CF2)
    expect(log.raw).toBe(true)
    CF2:AddMessage("|Hplayer:Tamsin|h[Tamsin]|h hits", 1, 1, 1)
    expect(log.lines[#log.lines].text).toBe("|Hplayer:Tamsin|h[Tamsin]|h hits")
    local hidden = mock.secret("hidden words")
    CF1:AddMessage(hidden, 1, 1, 1)
    expect(lastLine(CF1).raw).toBe(true)
    -- nothing to copy
    local add = CF1.AddMessage :: unknown :: (self: Frame, text: unknown) -> ()
    add(CF1, nil)
end

@test("a mirror keeps 500 lines")
local function trimmed()
    local m = mirror(CF1)
    for i = 1, 510 do CF1:AddMessage("line " .. i) end
    expect(#m.lines).toBe(500)
    expect(m.lines[500].src).toBe("line 510")
end

@test("the time coming and going redraws the lines where they were scrolled")
local function redraw()
    local m = mirror(CF1)
    for i = 1, 60 do CF1:AddMessage("scroll " .. i) end
    M.awake = true
    m.drawnWithTime = nil
    M:Redraw(m)
    m.frame:ScrollUp()
    M:Set("timestamps", false)
    expect(m.drawnWithTime).toBe(false)
    M:Redraw(m)                                    -- the same: nothing
    expect(m.drawnWithTime).toBe(false)
    M:Redraw(mirror(CF2))                          -- the combat log: never
end

@test("the mouse wheel scrolls; with Shift to the top and the bottom")
local function wheel()
    local m = frameOf(CF1)
    for i = 1, 60 do CF1:AddMessage("wheel " .. i) end
    mock.wheel(m, 1)
    expect(m:GetScrollOffset() > 0).toBe(true)
    mock.wheel(m, -1)
    mock.setModifiers({ shift = true })
    mock.wheel(m, 1)
    expect(m:GetScrollOffset() > 0).toBe(true)
    mock.wheel(m, -1)
    expect(m:GetScrollOffset()).toBe(0)
end

@test("names: the class from the line's sender, from chat events, or none")
local function classes()
    mock.spawnUnit({ name = "Otherplayer", class = "WARRIOR", player = true, guid = "Player-0000-00000000" })
    mock.stub(C_ChatInfo, "GetChatLineSenderGUID", function(_: number): string return "Player-0000-00000000" end)
    CF1:AddMessage("|Hplayer:Otherplayer:7|h[Otherplayer]|h says: hi")
    expect(textOf(lastLine(CF1)):find(T.color["class-warrior"].hex, 1, true) ~= nil).toBe(true)
    expect(assert(lastLine(CF1).classes)[1]).toBe("WARRIOR")
    mock.stub(C_ChatInfo, "GetChatLineSenderGUID", function(_: number): string return "" end)
    -- a chat event tells the sender's class, kept by name
    chatEvent("CHAT_MSG_SAY", "hey", "Otherplayer-Ashford", "Player-0000-00000000", 9)
    CF1:AddMessage("|Hplayer:Otherplayer-Ashford|h[Otherplayer-Ashford]|h says: again")
    expect(assert(lastLine(CF1).classes)[1]).toBe("WARRIOR")
    CF1:AddMessage("|Hplayer:Tester|h[Tester]|h says: who")
    expect(assert(lastLine(CF1).classes)[1]).toBe(false)
end

--------------------------------------------------------------------------------
-- Links
--------------------------------------------------------------------------------

@test("the class diamond copies the line: a box with it as plain text; Enter or Esc closes")
local function copyLine()
    mock.spawnUnit({ name = "Otherplayer", class = "WARRIOR", player = true })
    CF1:AddMessage("|Hplayer:Otherplayer|h[Otherplayer]|h says: copy me")
    local line = lastLine(CF1)
    mock.script(frameOf(CF1), "OnHyperlinkClick", "addon:suuui:copy:" .. tostring(line.id), "", "LeftButton")
    expect(focused():GetText()).toBe(date("%H:%M", line.at) .. "  Otherplayer: copy me")
    mock.advanceTime(0.01)
    local box = focused()
    mock.pressKey("ESCAPE")
    expect(box:IsVisible()).toBe(false)
    box:ClearFocus()                               -- (the engine keeps a hidden box's focus)
    M:CopyLine(999999)                             -- gone: nothing
    M:CopyLine(line.id)
    mock.pressKey("ENTER")
    expect(box:IsVisible()).toBe(false)
    box:ClearFocus()
end

@test("a right-click on a name: SuuUI's menu (whisper, window, invite, copy, friend, ignore)")
local function playerMenu()
    local menu = captureMenus()
    local m = frameOf(CF1)
    local function click(link: unknown, text: string, button: string) mock.script(m, "OnHyperlinkClick", link, text, button) end
    click("player:Tamsin:5", "[Tamsin]", "RightButton")
    for _, label in ipairs({ "Whisper", "Whisper window", "Invite", "Copy name", "Add friend", "Ignore" }) do
        expect(menu[label] ~= nil).toBe(true)
    end
    local tell = mock.stub(ChatFrameUtil, "SendTell", function(_: string, _: unknown) end)
    choose(menu, "Whisper")
    expect(tell).toHaveBeenCalledTimes(1)
    local invite = mock.stub(C_PartyInfo, "InviteUnit", function(_: string) end)
    choose(menu, "Invite")
    expect(invite).toHaveBeenCalledWith("Tamsin")
    choose(menu, "Copy name")
    expect(focused():GetText()).toBe("Tamsin")
    focused():ClearFocus()
    local friend = mock.stub(SuuUI, "AddFriend", function(_: string): boolean return true end)
    local n = printedCount()
    choose(menu, "Add friend")
    expect(friend).toHaveBeenCalledWith("Tamsin")
    expect(hasLine(printedSince(n), "Friend request sent to Tamsin.")).toBe(true)
    local ignore = mock.stub(C_FriendList, "AddIgnore", function(_: string) end)
    choose(menu, "Ignore")
    expect(ignore).toHaveBeenCalledWith("Tamsin")
    local open = mock.stub(M, "OpenWhisperWindow", function(_: unknown, _: string) end)
    choose(menu, "Whisper window")
    expect(open).toHaveBeenCalledTimes(1)
    -- other links open as the game's do; a secret one does nothing
    local ref = mock.fake("SetItemRef", function(...: unknown) end)
    click("item:6948", "[Hearthstone]", "LeftButton")
    click("player:Tamsin", "[Tamsin]", "LeftButton")
    expect(ref).toHaveBeenCalledTimes(2)
    click(mock.secret("item:1"), "", "LeftButton")
    expect(ref).toHaveBeenCalledTimes(2)
end

@test("hovering a link: the copy hint, an item's tooltip, nothing for others")
local function linkTips()
    local m = frameOf(CF1)
    local function enter(link: unknown) mock.script(m, "OnHyperlinkEnter", link, "") end
    local function leave() mock.script(m, "OnHyperlinkLeave", "", "") end
    enter("addon:suuui:copy:1")
    expect(GameTooltip).toBeShown()
    leave()
    expect(GameTooltip).never.toBeShown()
    local set = mock.stub(GameTooltip, "SetHyperlink", function(...: unknown) end)
    enter("item:6948")
    expect(set).toHaveBeenCalledTimes(1)
    leave()
    enter("player:Tamsin")
    enter(mock.secret("item:1"))
    expect(set).toHaveBeenCalledTimes(1)
end

--------------------------------------------------------------------------------
-- Whispers
--------------------------------------------------------------------------------

local function whisper(text: string)
    CF1:AddMessage(text, 1, 0.5, 1, nil, nil, nil, "CHAT_MSG_WHISPER")
end

@test("whispers are kept by player (once, 300 at most); a name finds its realm's lines too")
local function whispers()
    M.whispers = {}
    whisper("|Hplayer:Tamsin-Ashford|h[Tamsin-Ashford]|h whispers: one")
    whisper("|Hplayer:Tamsin-Ashford|h[Tamsin-Ashford]|h whispers: one")   -- the same line twice
    whisper("no player in it")
    CF1:AddMessage("|Hplayer:Otherplayer|h[Otherplayer]|h says: not a whisper", 1, 1, 1, nil, nil, nil, "CHAT_MSG_SAY")
    expect(#M.whispers).toBe(1)
    expect(#M:WhispersWith("Tamsin")).toBe(1)
    expect(#M:WhispersWith("tamsin-ashford")).toBe(1)
    expect(#M:WhispersWith("Otherplayer")).toBe(0)
    for i = 1, 305 do whisper("|Hplayer:Tamsin|h[Tamsin]|h whispers: n" .. i) end
    expect(#M.whispers).toBe(300)
end

@test("a whisper window opens with the kept whispers; an open one is chosen again; a right-click closes it")
local function whisperWindow()
    M.whispers = {}
    whisper("|Hplayer:Tamsin|h[Tamsin]|h whispers: before the window")
    M:OpenWhisperWindow("Tamsin")
    mock.advanceTime(0.01)
    local cf = windowOf("Tamsin")
    expect(M.selected).toBe(cf)
    local m = mirror(cf)
    expect(m.lines[1].src).toBe("|Hplayer:Tamsin|h[Tamsin]|h whispers: before the window")
    M:Select(CF1)
    M:OpenWhisperWindow("tamsin-Ashford")
    mock.advanceTime(0.01)
    expect(M.selected).toBe(cf)
    local menu = captureMenus()
    M:UpdateTabs()
    mock.click(tab("Tamsin"), "RightButton")
    choose(menu, "Close")
    expect(M.selected).toBe(CF1)
end

--------------------------------------------------------------------------------
-- The input's history
--------------------------------------------------------------------------------

local function input(): EditBox
    local box = CreateFrame("EditBox", nil, UIParent)
    box:SetSize(200, 20)
    box:SetPoint("CENTER")
    box:SetAutoFocus(false)
    M:HistoryFor(box)
    M:HistoryFor(box)                              -- once
    return box
end

@test("Enter keeps what was sent, as the command that sends it again")
local function enterKeeps()
    local box = input()
    box:SetAttribute("chatType", "PARTY")
    box:SetText("on my way")
    mock.script(box, "OnKeyDown", "ENTER")
    box:SetText("/dance")
    mock.script(box, "OnKeyDown", "NUMPADENTER")
    mock.script(box, "OnKeyDown", "NUMPADENTER")    -- the same again: once
    box:SetText("")
    mock.script(box, "OnKeyDown", "ENTER")
    mock.script(box, "OnKeyDown", "A")
    expect(M:History()).toEqual({ "/p on my way", "/dance" })
end

@test("your own lines come back as chat events and fill in, until Enter reaches SuuUI")
local function sentLines()
    local me = UnitGUID("player") :: string
    chatEvent("CHAT_MSG_SAY", "hello all", "Player", me, 3)
    chatEvent("CHAT_MSG_WHISPER_INFORM", "see you", "Tamsin", "", 4)
    chatEvent("CHAT_MSG_SAY", "not mine", "Otherplayer", "", 5)
    expect(M:History()).toEqual({ "/s hello all", "/w Tamsin see you" })
    M.keyCapture = true
    chatEvent("CHAT_MSG_SAY", "after enter", "Player", me, 6)
    expect(#M:History()).toBe(2)
end

@test("Up and Down recall; in combat past protected commands; nothing in a lockdown, with recall off, or the palette open")
local function recall()
    local box = input()
    M:CharData().history = { "/s one", "/cast Fireball", "/s two" }
    box:SetFocus()
    mock.script(box, "OnArrowPressed", "UP")
    expect(box:GetText()).toBe("/s two")
    mock.script(box, "OnArrowPressed", "UP")
    expect(box:GetText()).toBe("/cast Fireball")
    mock.script(box, "OnArrowPressed", "DOWN")
    mock.script(box, "OnArrowPressed", "DOWN")
    expect(box:GetText()).toBe("")
    mock.script(box, "OnArrowPressed", "DOWN")     -- past the end: nowhere
    expect(box:GetText()).toBe("")
    mock.script(box, "OnArrowPressed", "LEFT")
    -- a new start once the text isn't the recalled line
    box:SetText("typed")
    mock.player:enterCombat()
    mock.script(box, "OnArrowPressed", "UP")
    mock.script(box, "OnArrowPressed", "UP")
    expect(box:GetText()).toBe("/s one")
    mock.player:leaveCombat()
    box:SetText("x")
    mock.stub(C_ChatInfo, "InChatMessagingLockdown", function(): boolean return true end)
    mock.script(box, "OnArrowPressed", "UP")
    expect(box:GetText()).toBe("x")
    mock.stub(C_ChatInfo, "InChatMessagingLockdown", function(): boolean return false end)
    local palette = assert(SuuUI.GetModule("chatcommands"))
    mock.stub(palette, "TakesArrows", function(_: unknown, _: unknown): boolean return true end)
    mock.script(box, "OnArrowPressed", "UP")
    expect(box:GetText()).toBe("x")
    mock.stub(palette, "TakesArrows", function(_: unknown, _: unknown): boolean return false end)
    M:Set("recall", false)
    mock.script(box, "OnArrowPressed", "UP")
    expect(box:GetText()).toBe("x")
    M:Set("recall", true)
    M:CharData().history = {}
    mock.script(box, "OnArrowPressed", "UP")
    expect(box:GetText()).toBe("x")
end

--------------------------------------------------------------------------------
-- Tabs
--------------------------------------------------------------------------------

@test("the tabs: General first, then Global, the other windows, Search last; a click chooses one")
local function tabs()
    M:UpdateTabs()
    local names: string[] = {}
    for _, cf in ipairs(M:OrderedWindows()) do names[#names + 1] = GetChatWindowInfo(cf:GetID()) end
    expect(names[1]).toBe("General")
    expect(names[2]).toBe("Global")
    expect(findTab("Search") ~= nil).toBe(true)
    expect(tab("General").active).toBe(true)
    mock.click(tab("Log"))
    expect(M.selected).toBe(CF2)
    expect(frameOf(CF2)).toBeShown()
    expect(frameOf(CF1)).never.toBeShown()
    local bar = frames.find("CombatLogQuickButtonFrame_Custom")
    if bar then
        expect(bar).toBeShown()
        expect(bar:GetParent()).toBe(M:Panel().log)
    end
    mock.click(tab("General"))
    if bar then expect(bar).never.toBeShown() end
    -- hovering a tab that isn't chosen
    local log = tab("Log")
    mock.hover(log)
    expect(log.hover).toBe(true)
    mock.hover(nil)
    expect(log.hover).toBe(false)
    mock.hover(tab("General"))
    mock.hover(nil)
end

@test("a line in another tab marks it unread until it's chosen")
local function unread()
    local global = windowOf("Global")
    global:AddMessage("news")
    M:UpdateTabs()
    expect(tab("Global").unread).toBeShown()
    mock.click(tab("Global"))
    expect(tab("Global").unread).never.toBeShown()
end

@test("a right-click on a window's tab opens Blizzard's chat settings for it; Search has none")
local function tabSettings()
    mock.click(tab("Global"), "RightButton")
    expect(CURRENT_CHAT_FRAME_ID).toBe(windowOf("Global"):GetID())
    expect(ChatConfigFrame).toBeShown()
    M:OpenChatSettings(CF1)                        -- open already: again for this one
    expect(CURRENT_CHAT_FRAME_ID).toBe(1)
    HideUIPanel(ChatConfigFrame)
    mock.click(tab("Search"), "RightButton")
end

@test("a window's font size, its name, a new window and closing one")
local function windows()
    M:SetFontSize(CF1, 16)
    expect(select(2, frameOf(CF1):GetFont())).toBeCloseTo(16)
    local global = windowOf("Global")
    M:RenameWindow(global, "Worldwide")
    expect(findTab("Worldwide") ~= nil).toBe(true)
    M:RenameWindow(global, "")                     -- no name: kept
    M:RenameWindow(global, "Global")
    M:SetFontSize(CF1, 14)
    local before = #M:Windows()
    M:NewWindow("Extra")
    M:NewWindow("")
    mock.advanceTime(0.01)
    local extra = window("Extra")
    if extra then
        expect(#M:Windows()).toBe(before + 1)
        expect(M.selected).toBe(extra)
        M:CloseWindow(extra)
        expect(M.selected).toBe(CF1)
    end
end

@test("a whisper window's font size is SuuUI's own")
local function tempFont()
    M:OpenWhisperWindow("Otherplayer")
    mock.advanceTime(0.01)
    local cf = windowOf("Otherplayer")
    M:SetFontSize(cf, 18)
    expect(select(2, frameOf(cf):GetFont())).toBeCloseTo(18)
    M:RenameWindow(cf, "Never")                    -- a whisper window keeps its player
    M:CloseWindow(cf)
end

@test("the tabs' order is kept per character; Reset brings the starting order back")
local function order()
    local global = windowOf("Global")
    M:SaveTabOrder({ CF2, global, CF1 })
    expect(M:HasTabOrder()).toBe(true)
    expect(M:OrderedWindows()[1]).toBe(CF2)
    M:UpdateTabs()
    M:ResetTabOrder()
    expect(M:HasTabOrder()).toBe(false)
    expect(M:OrderedWindows()[1]).toBe(CF1)
    mock.advanceFrames(10, 50)
    expect(tab("General").slide).toBe(nil)
end

-- A press on a tab and the pointer moved `dx` along the row, the left
-- button held (the engine holds none: faked).
local held = { left = false, right = false }
local function press(b: TabButton, dx: number)
    mock.fake("IsMouseButtonDown", function(button: string?): boolean
        if button == "RightButton" then return held.right end
        return held.left
    end)
    held.left, held.right = true, false
    local s = b:GetEffectiveScale()
    local x, y = b:GetCenter()
    x, y = assert(x), assert(y)
    mock.setCursorPosition(x * s, y * s)
    mock.script(b, "OnMouseDown", "LeftButton")
    mock.advanceFrames(1)
    mock.setCursorPosition((x + dx) * s, y * s)
    mock.advanceFrames(1)
end

@test("dragging a tab along the row gives it a new place, kept; the others slide aside")
local function dragging()
    M:UpdateTabs()
    local general = tab("General")
    press(general, 120)
    expect(M.drag ~= nil).toBe(true)
    expect(general.plate).toBeShown()
    mock.advanceFrames(3, 50)
    mock.hover(general)                            -- let go on the row
    held.left = false
    mock.advanceFrames(1)
    expect(M.drag).toBe(nil)
    expect(M:HasTabOrder()).toBe(true)
    expect(M:OrderedWindows()[1] ~= CF1).toBe(true)
    -- the release isn't a click
    mock.script(general, "OnClick", "LeftButton")
    mock.advanceFrames(10, 50)
    expect(general.slide).toBe(nil)
end

@test("a drag ends without a new place on Esc, a right click, or letting go away from the row")
local function dragCancel()
    M:UpdateTabs()
    local general = tab("General")
    press(general, 120)
    local dragger = assert(M:Panel().dragger)
    mock.script(dragger, "OnKeyDown", "A")
    mock.script(dragger, "OnKeyDown", "ESCAPE")
    expect(M.drag).toBe(nil)
    press(general, 120)
    held.right = true
    mock.advanceFrames(1)
    expect(M.drag).toBe(nil)
    press(general, 120)
    local s = general:GetEffectiveScale()
    local x, y = general:GetCenter()
    mock.setCursorPosition(assert(x) * s, (assert(y) + 300) * s)
    mock.hover(nil)                                -- away from the row
    held.left = false
    mock.advanceFrames(1)
    expect(M.drag).toBe(nil)
    expect(M:HasTabOrder()).toBe(false)
    -- a press let go before it moved far enough: a click
    press(general, 2)
    held.left = false
    mock.advanceFrames(1)
    expect(M.press).toBe(nil)
    -- with reduced motion it drops at once
    mock.stub(SuuUI.Motion, "Reduced", function(): boolean return true end)
    press(general, 120)
    held.left = false
    mock.advanceFrames(1)
    expect(general.plate).never.toBeShown()
end

@test("tabs drag only in edit mode when set so; there they show grips and a hint, a press arranges")
local function editTabs()
    M:Set("tabReorder", "edit")
    expect(M:CanDrag()).toBe(false)
    M:PressTab(tab("Log"))
    expect(M.press).toBe(nil)
    editMode.enter()
    expect(M:CanDrag()).toBe(true)
    expect(M:Panel().editHint).toBeShown()
    expect(tab("General").grip).toBeShown()
    expect(tab("Search").grip).toBe(nil)
    mock.click(tab("Log"))                         -- arranging: no switch
    expect(M.selected).toBe(CF1)
    editMode.exit()
    expect(M:Panel().editHint).never.toBeShown()
    expect(tab("General").grip).never.toBeShown()
    -- the setting changed mid-drag ends it
    M:Set("tabReorder", "drag")
    press(tab("General"), 120)
    M:Set("tabReorder", "edit")
    expect(M.drag).toBe(nil)
end

--------------------------------------------------------------------------------
-- Kept chat
--------------------------------------------------------------------------------

@test("at logout each tab's last lines, the whispers and their names' classes are saved; nothing with keeping off")
local function saving()
    mock.spawnUnit({ name = "Otherplayer", class = "WARRIOR", player = true, guid = "Player-0000-00000000" })
    chatEvent("CHAT_MSG_SAY", "hey", "Otherplayer", "Player-0000-00000000", 9)
    whisper("|Hplayer:Otherplayer|h[Otherplayer]|h whispers: and me")
    CF1:AddMessage("|Hplayer:Otherplayer|h[Otherplayer]|h says: keep me", 1, 1, 0)
    mock.fireEvent("PLAYER_LOGOUT")
    local kept = M:CharData().kept :: unknown :: Kept
    local general = assert(kept.windows[1])
    expect(general.name).toBe("General")
    expect(general.lines[#general.lines].text).toBe("|Hplayer:Otherplayer|h[Otherplayer]|h says: keep me")
    expect(general.lines[#general.lines].rgb).toBe("ffff00")
    expect(kept.whispers[#kept.whispers].who).toBe("otherplayer")
    expect(kept.classes.otherplayer).toBe("WARRIOR")
    M:Set("keepHistory", false)
    expect(M:CharData().kept).toBe(nil)
    M:SaveHistory()
    expect(M:CharData().kept).toBe(nil)
end

local HOUR = 3600

@test("kept chat comes back dimmed above an 'Earlier' divider, in the window it came from")
local function restoring()
    M:CharData().kept = {
        at = time() - 2 * HOUR,
        windows = {
            [1] = { name = "General", lines = { { text = "|Hplayer:Tamsin|h[Tamsin]|h says: old news", at = time() - 3 * HOUR, rgb = "ff8000" }, "junk" } },
            [7] = { name = "Renamed since", lines = { { text = "gone", at = 1 } } },
        },
        whispers = { { who = "tamsin", text = "|Hplayer:Tamsin|h[Tamsin]|h whispers: earlier", at = time() - 3 * HOUR, rgb = "ff80ff" }, 5 },
        classes = { tamsin = "MAGE", [3] = "x" },
    }
    M.historyLoaded, M.whispers = nil, {}
    M:LoadHistory()
    M:LoadHistory()                                -- once
    expect(#M.whispers).toBe(1)
    expect(M.whispers[1].old).toBe(true)
    local m: Mirror = { frame = M:MirrorFrame(), lines = {}, raw = false }
    M:RestoreKept(CF1, m)
    expect(#m.lines).toBe(2)
    expect(m.lines[1].old).toBe(true)
    expect(assert(m.lines[1].classes)[1]).toBe("MAGE")
    expect(m.lines[2].divider).toBe(true)
    expect(M:DividerText(m, m.lines[2].at):find("Earlier · logged out 2 h ago", 1, true) ~= nil).toBe(true)
    -- with room, the gilt rules either side
    m.frame:ClearAllPoints()
    m.frame:SetSize(3000, 100)
    expect(M:DividerText(m, m.lines[2].at):find("WHITE8X8", 1, true) ~= nil).toBe(true)
    M:RestoreKept(CF1, m)                          -- used up
    expect(#m.lines).toBe(2)
    M:RestoreKept(assert(chat.window("ChatFrame7")), m)                 -- another name now
    expect(#m.lines).toBe(2)
    -- a whisper window with them: the earlier whispers, then the divider
    whisper("|Hplayer:Tamsin|h[Tamsin]|h whispers: now")
    M:OpenWhisperWindow("Tamsin")
    mock.advanceTime(0.01)
    local w = mirror(windowOf("Tamsin"))
    expect(w.lines[1].old).toBe(true)
    expect(w.lines[2].divider).toBe(true)
    M:CloseWindow(windowOf("Tamsin"))
    -- keeping off: nothing loaded
    M:Set("keepHistory", false)
    M.historyLoaded = nil
    M:LoadHistory()
end

@test("Clear kept chat forgets the kept lines and whispers and empties the tabs (not the combat log)")
local function clearing()
    local asked = captureConfirm().last
    CF1:AddMessage("to forget")
    CF2:AddMessage("combat stays")
    rowOf("Kept chat").onClick()
    assert(asked().onConfirm)()
    expect(#mirror(CF1).lines).toBe(0)
    expect(#mirror(CF2).lines > 0).toBe(true)
    expect(M.whispers).toEqual({})
end

--------------------------------------------------------------------------------
-- Search
--------------------------------------------------------------------------------

local function openSearch(): SearchPage
    mock.click(tab("Search"))
    local s = assert(M.search)
    for _, b in ipairs(s.chips) do if b.value == "all" then mock.click(b) end end
    return s
end

@test("the Search tab: the kept lines with a word, by player, how many, where from")
local function searching()
    CF1:AddMessage("|Hplayer:Tamsin|h[Tamsin]|h says: the dragon flies", 1, 1, 1)
    CF1:AddMessage("|Hplayer:Tamsin|h[Tamsin]|h says: a dragon again", 1, 1, 1)
    CF1:AddMessage("|Hplayer:Tamsin|h[Tamsin]|h says: and one more dragon", 1, 1, 1)
    CF1:AddMessage("|Hplayer:Otherplayer|h[Otherplayer]|h says: dragonflies", 1, 1, 1)
    CF1:AddMessage("a dragon with no one", 1, 1, 1)
    local s = openSearch()
    expect(s).toBeShown()
    expect(s.note:GetText()).toBe("A player's name or a word: every tab and whisper kept.")
    mock.typeText(s.field.edit, "dragon")
    expect(s.count:GetText()).toBe("5 lines")
    expect(s.headers[1].name:GetText()).toBe("Other lines")
    expect(s.rows[1].ground).toBeShown()           -- the match marked
    local found: SearchHeader? = nil
    for _, h in ipairs(s.headers) do if h:IsShown() and h.name:GetText() == "Tamsin" then found = h end end
    local tamsin = assert(found)
    expect(mock.textOf(tamsin.count):find("3 lines · last", 1, true) ~= nil).toBe(true)
    -- two lines a player, then "1 more"
    local more = s.mores[1]
    expect(more).toBeShown()
    expect(more.label:GetText()).toBe("1 more")
    mock.hover(more)
    mock.hover(nil)
    mock.click(more)
    expect(more).never.toBeShown()
    -- the whisper button opens their window
    local open = mock.stub(M, "OpenWhisperWindow", function(_: unknown, _: string) end)
    mock.click(tamsin.whisper)
    expect(open).toHaveBeenCalledTimes(1)
    s.field.edit:SetText("zzz")
    M:RunSearch()
    expect(s.note:GetText()).toBe("Nothing kept matches.")
end

@test("the chips choose where to look; a whisper line is one, wherever it showed")
local function chips()
    M.whispers = {}
    whisper("|Hplayer:Tamsin|h[Tamsin]|h whispers: secret plan")
    CF1:AddMessage("|Hplayer:Otherplayer|h[Otherplayer]|h says: open plan", 1, 1, 1)
    local s = openSearch()
    s.field.edit:SetText("plan")
    M:RunSearch()
    expect(s.count:GetText()).toBe("2 lines")
    local chip: SearchChip? = nil
    for _, b in ipairs(s.chips) do if b.value == "whisper" then chip = b end end
    local whispersChip = assert(chip)
    mock.hover(whispersChip)
    mock.hover(nil)
    mock.click(whispersChip)
    expect(s.count:GetText()).toBe("1 line")
    expect(s.headers[1].count:GetText()).toBe("1 line · Whispers")
    mock.hover(whispersChip)                       -- the chosen one keeps its look
    mock.hover(nil)
end

@test("a long line is cut to show its match, the match marked; your own lines have no Whisper button")
local function longLines()
    local long = "|Hplayer:Player|h[Player]|h says: " .. string.rep("words and more words ", 12) .. "needle at the end"
    CF1:AddMessage(long, 1, 1, 1)
    local s = openSearch()
    s.field.edit:SetText("needle")
    M:RunSearch()
    local row = s.rows[1]
    expect(row).toBeShown()
    expect(mock.textOf(row.text):find("… ", 1, true) ~= nil).toBe(true)
    expect(s.headers[1].whisper).never.toBeShown()
    -- links work in the rows; leaving the tab drops the field's focus
    mock.script(row, "OnHyperlinkLeave", "", "")
    s.field.edit:SetFocus()
    M:Select(CF1)
    expect(s.field.edit:HasFocus()).toBe(false)
    mock.click(tab("General"))
    expect(s).never.toBeShown()
end

--------------------------------------------------------------------------------
-- The idle fade
--------------------------------------------------------------------------------

@test("idle: the ground, tabs and input fade after the delay; hovering or typing wakes them")
local function idle()
    mock.hover(nil)
    M:Set("idleDelay", 5)
    M:Tick()
    M.lastActive = GetTime() - 10
    M:Tick()
    expect(M.awake).toBe(false)
    mock.advanceFrames(40, 50)
    expect(M:Panel().tabs:GetAlpha()).toBeCloseTo(0)
    mock.hover(M:Panel())
    M:Tick()
    expect(M.awake).toBe(true)
    mock.hover(nil)
    -- a whisper wakes it
    M.lastActive = GetTime() - 10
    M:Tick()
    chatEvent("CHAT_MSG_WHISPER", "psst", "Tamsin", "", 2)
    M:Tick()
    expect(M.awake).toBe(true)
    -- the fade off: always awake
    M:Set("fadeIdle", false)
    M.lastActive = GetTime() - 100
    M:Tick()
    expect(M.awake).toBe(true)
    -- the driver ticks every 0.2 s
    mock.advanceFrames(5, 50)
end

--------------------------------------------------------------------------------
-- The Global tab
--------------------------------------------------------------------------------

@test("the Global tab gets every channel General had; General keeps the rest")
local function globalTab()
    mock.setChannels({ joined = { { name = "General" }, { name = "Trade" }, { name = "LookingForGroup" } } })
    mock.fake("GetChatWindowChannels", function(_: number): ...unknown return "General", 1, "Custom", 5 end)
    local global = windowOf("Global")
    local added: string[], removed: string[] = {}, {}
    mock.stub(global, "AddChannel", function(_: unknown, name: string) added[#added + 1] = name end)
    mock.stub(global, "RemoveChannel", function(_: unknown, name: string) removed[#removed + 1] = name end)
    mock.stub(SuuUI.LFG, "IsHiddenChannel", function(name: string): boolean return name == "LookingForGroup" end)
    M:ApplyGlobalTab()
    expect(hasLine(added, "Trade")).toBe(true)
    expect(hasLine(added, "Custom")).toBe(true)
    expect(hasLine(removed, "LookingForGroup")).toBe(true)
    -- in combat, or off: nothing
    local n = #added
    mock.player:enterCombat()
    M:ApplyGlobalTab()
    M:Set("globalTab", false)
    mock.player:leaveCombat()
    M:ApplyGlobalTab()
    expect(#added).toBe(n)
end

@test("no Global window: a Guild tab becomes it, else a new one")
local function globalMade()
    local global = windowOf("Global")
    local id = global:GetID()
    SetChatWindowName(id, "Guild")
    local renamed = mock.fake("FCF_SetWindowName", function(f: Frame, name: string) SetChatWindowName(f:GetID(), name) end)
    M:ApplyGlobalTab()
    expect(renamed).toHaveBeenCalledTimes(1)
    expect(GetChatWindowInfo(id)).toBe("Global")
    SetChatWindowName(id, "Elsewhere")
    -- a new window, as the game makes one
    local made = CreateFrame("ScrollingMessageFrame")
    made:SetID(9)
    for _, name in ipairs({ "RemoveAllMessageGroups", "AddChannel", "RemoveChannel" }) do rawset(made, name, function() end) end
    local opened = mock.fake("FCF_OpenNewWindow", function(_: string): Frame return made end)
    M:ApplyGlobalTab()
    expect(opened).toHaveBeenCalledWith("Global")
    SetChatWindowName(id, "Global")
end

