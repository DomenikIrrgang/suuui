-- A theme change
--------------------------------------------------------------------------------

@test("a theme change formats the lines again with the classes they were shown with")
local function theme()
    mock.spawnUnit({ name = "Otherplayer", class = "WARRIOR", player = true, guid = "Player-0000-00000000" })
    mock.stub(C_ChatInfo, "GetChatLineSenderGUID", function(_: number): string return "Player-0000-00000000" end)
    CF1:AddMessage("|Hplayer:Otherplayer:3|h[Otherplayer]|h says: colours", 1, 1, 1)
    local line = lastLine(CF1)
    M.whispers = {}
    whisper("|Hplayer:Otherplayer|h[Otherplayer]|h whispers: hi")
    M:KeptLines()
    line.text = "stale"
    themeChanged()
    expect(textOf(line) ~= "stale").toBe(true)
    expect(assert(line.classes)[1]).toBe("WARRIOR")
    openSearch()
    themeChanged()
end

@test("a client without AddChannel on its chat windows: said once, the tabs left alone")
local function noChannels()
    local add: unknown = rawget(CF1, "AddChannel")
    rawset(CF1, "AddChannel", nil)
    local n = printedCount()
    M.warnedGlobal = nil
    M:ApplyGlobalTab()
    M:ApplyGlobalTab()
    rawset(CF1, "AddChannel", add)
    local said = 0
    for _, l in ipairs(printedSince(n)) do
        if l:find("the Global tab can't be set up", 1, true) then said = said + 1 end
    end
    expect(said).toBe(1)
end

@test("a dragged tab whose window closes mid-drag drops back where it lands")
@cases({ { "gliding", false }, { "reduced motion", true } })
local function closedMidDrag(_: string, reduced: boolean)
    mock.stub(SuuUI.Motion, "Reduced", function(): boolean return reduced end)
    M:OpenWhisperWindow("Otherplayer")
    mock.advanceTime(0.01)
    local cf = windowOf("Otherplayer")
    M:UpdateTabs()
    local b = tab("Otherplayer")
    press(b, -60)
    expect(M.drag ~= nil).toBe(true)
    M:CloseWindow(cf)
    held.left = false
    mock.advanceFrames(1)
    expect(M.drag).toBe(nil)
    mock.advanceFrames(10, 50)
    expect(b.y).toBe(0)
end
