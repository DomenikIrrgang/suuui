-- Units/Chat: SuuUI's chat over Blizzard's (the emulated client runs
-- Blizzard's chat frames). The panel and where ChatFrame1 goes, the idle
-- fade and the windows' refresh, the settings section, a theme change, a
-- failed enable. The parts' tests are beside them in Units/Chat/ (the
-- links, the mirrors, whispers and whisper windows, the input's history,
-- the tabs, the windows, kept chat, the Search tab, the Global tab).

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as chat from "wowlua:chat"
import SuuUI from "/Core/API"
import * as events from "/Core/Events"
import internal M from "/Units/Chat"
import expectNoErrors, useTheme, layoutThemes, COMPACT, holdings, NOTHING, errorsSoFar from "../../helpers"
import * as settings from "/Core/Settings"
import * as modules from "/Core/Modules"
import internal ownOf from "/Core/Modules"
import * as fault from "/Core/Fault"
import themeChanged from "../SettingsUI/UiSettingsHelpers"
import ready, frameOf, lastLine, textOf, windowOf, findTab, tab, leftOf, chatEvent, rowOf, whisper, openSearch, resetChat from "./Chat/ChatHelpers"

local UI = SuuUI.UI
local CF1, CF2 = ChatFrame1, ChatFrame2

@beforeEach
local function start()
    ready()
end

@afterEach
local function cleanup()
    resetChat()
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The panel
--------------------------------------------------------------------------------

@test("the panel: chat-w wide, its height from the lines' area; ChatFrame1 placed in it")
local function panel()
    local w, h = M:PanelSize()
    expect(w).toBe(UI.Size("chat-w"))
    expect(M:Panel():GetHeight()).toBeCloseTo(h)
    local left, bottom = M:LogRect()
    expect(leftOf(CF1)).toBeCloseTo(assert(left))
    expect(assert(CF1:GetBottom()) * CF1:GetEffectiveScale() / UIParent:GetEffectiveScale()).toBeCloseTo(bottom)
    M:Set("logHeight", M:Get("logHeight") + 40)
    expect(M:Panel():GetHeight()).toBeCloseTo(h + 40)
end

@test("the edit box covers the field, at SuuUI's scale too (in game 0.533 against UIParent's 0.64)")
local function inputOnField()
    ready()
    local eb = assert(chat.editBox(CF1))
    local field = M:Panel().field
    local was = SuuUI.Root:GetScale()
    SuuUI.Root:SetScale(was * 0.533 / 0.64)
    M:SkinFrame(CF1)
    local function screen(f: Region): (number, number, number, number)
        local k = f:GetEffectiveScale()
        return assert(f:GetLeft()) * k, assert(f:GetBottom()) * k, assert(f:GetRight()) * k, assert(f:GetTop()) * k
    end
    local l, b, r, t = screen(eb)
    local fl, fb, fr, ft = screen(field)
    SuuUI.Root:SetScale(was)
    M:SkinFrame(CF1)
    expect(l).toBeCloseTo(fl)
    expect(b).toBeCloseTo(fb)
    expect(r).toBeCloseTo(fr)
    expect(t).toBeCloseTo(ft)
end

@test("a protected ChatFrame1 in combat is placed after it; Blizzard, edit mode or a new scale place it again")
local function placing()
    mock.protect(CF1, true)
    mock.player:enterCombat()
    M:PlaceChat()
    expect(M.pendingPlace).toBe(true)
    mock.player:leaveCombat()
    expect(M.pendingPlace).toBe(nil)
    mock.protect(CF1, false)
    if CF1.ApplySystemAnchor then
        pcall(CF1.ApplySystemAnchor, CF1)
        mock.advanceTime(0.01)
    end
    expect(leftOf(CF1)).toBeCloseTo(assert((M:LogRect())))
    M:Set("position", { point = "BOTTOMLEFT", x = 60, y = 28 })
    mock.advanceTime(0.01)
    expect(leftOf(CF1)).toBeCloseTo(assert((M:LogRect())))
    events.emit("SUUUI_ROOT_SCALED", UIParent:GetEffectiveScale())
    mock.advanceTime(0.01)
    expect(leftOf(CF1)).toBeCloseTo(assert((M:LogRect())))
    -- the game's own window events: skinned and placed a frame later
    mock.fireEvent("UPDATE_CHAT_WINDOWS")
    chatEvent("CHAT_MSG_WHISPER_INFORM", "x", "Tamsin", "", 1)
    mock.advanceTime(0.01)
    expect(leftOf(CF1)).toBeCloseTo(assert((M:LogRect())))
end

--------------------------------------------------------------------------------
-- The idle fade
--------------------------------------------------------------------------------

@test("idle: the ground, tabs and input fade after the delay; hovering or typing wakes them")
local function idle()
    mock.hover(nil)
    M:Set("idleDelay", 5)
    M:Tick()
    M.lastActive = GetTime() - 10
    M:Tick()
    expect(M.awake).toBe(false)
    mock.advanceFrames(40, 50)
    expect(M:Panel().tabs:GetAlpha()).toBeCloseTo(0)
    mock.hover(M:Panel())
    M:Tick()
    expect(M.awake).toBe(true)
    mock.hover(nil)
    -- a whisper wakes it
    M.lastActive = GetTime() - 10
    M:Tick()
    chatEvent("CHAT_MSG_WHISPER", "psst", "Tamsin", "", 2)
    M:Tick()
    expect(M.awake).toBe(true)
    -- the fade off: always awake
    M:Set("fadeIdle", false)
    M.lastActive = GetTime() - 100
    M:Tick()
    expect(M.awake).toBe(true)
    -- the driver ticks every 0.2 s
    mock.advanceFrames(5, 50)
end

@test("the driver's tick only checks the fade; the windows refresh a frame after what changes them")
local function refreshOnChange()
    ready()
    local refresh = mock.spy(M.RefreshWindows)
    mock.stub(M, "RefreshWindows", refresh)
    -- ten seconds of ticks: the windows aren't walked
    mock.advanceFrames(50, 200)
    expect(refresh).never.toHaveBeenCalled()
    -- Blizzard's tab menu: a font size, a name
    FCF_SetChatWindowFontSize(nil, CF1, 17)
    local global = windowOf("Global")
    FCF_SetWindowName(global, "Worldwide")
    expect(refresh).never.toHaveBeenCalled()
    mock.advanceFrames(1)
    -- once for both
    expect(refresh).toHaveBeenCalledTimes(1)
    expect(select(2, frameOf(CF1):GetFont())).toBeCloseTo(17)
    expect(findTab("Worldwide") ~= nil).toBe(true)
    FCF_SetWindowName(global, "Global")
    FCF_SetChatWindowFontSize(nil, CF1, 14)
    mock.advanceFrames(1)
    expect(findTab("Global") ~= nil).toBe(true)
    -- a line in another tab: its unread mark a frame later
    global:AddMessage("news")
    mock.advanceFrames(1)
    expect(tab("Global").unread).toBeShown()
    mock.click(tab("Global"))
    mock.click(tab("General"))
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

@test("Settings: the tab order's reset, its note; the idle delay needs the fade")
local function settingRows()
    local reset = rowOf("Tab order")
    expect((reset.disabled())).toBe(true)
    expect(reset.description()).toBe(
        "Reset puts General and Global first, your other windows after them, whispers last. Kept for this character."
    )
    M:SaveTabOrder({ CF2, CF1 })
    expect((reset.disabled())).toBe(false)
    expect(reset.description():find("changed", 1, true) ~= nil).toBe(true)
    reset.onClick()
    expect(M:HasTabOrder()).toBe(false)
    local delay = rowOf("Idle after")
    expect((delay.disabled())).toBe(false)
    M:Set("fadeIdle", false)
    expect((delay.disabled())).toBe(true)
end

--------------------------------------------------------------------------------
-- A theme change
--------------------------------------------------------------------------------

@test("a theme change formats the lines again with the classes they were shown with")
local function theme()
    mock.spawnUnit({ name = "Otherplayer", class = "WARRIOR", player = true, guid = "Player-0000-00000000" })
    mock.stub(C_ChatInfo, "GetChatLineSenderGUID", function(_: number): string
        return "Player-0000-00000000"
    end)
    CF1:AddMessage("|Hplayer:Otherplayer:3|h[Otherplayer]|h says: colours", 1, 1, 1)
    local line = lastLine(CF1)
    M.whispers = {}
    whisper("|Hplayer:Otherplayer|h[Otherplayer]|h whispers: hi")
    M:KeptLines()
    line.text = "stale"
    themeChanged()
    expect(textOf(line) ~= "stale").toBe(true)
    expect(assert(line.classes)[1]).toBe("WARRIOR")
    openSearch()
    themeChanged()
end

@test(
    "a theme's body face is the lines' (the window, SuuUI's copy, the edit box), header's the tabs', live; sizes stay"
)
local function themeFont()
    local FONTS = "Interface\\AddOns\\SuuUI\\Media\\Fonts\\"
    local body, header = SuuUI.Tokens.type.body.file, SuuUI.Tokens.type.header.file
    local _, size = frameOf(CF1):GetFont()
    local eb = assert(chat.editBox(CF1))
    local label = tab("General").label
    expect(select(2, label:GetFont())).toBeCloseTo(12)
    SuuUI.RegisterTheme({
        id = "test-chat-font",
        fonts = {
            body = { file = FONTS .. "Figtree-Medium.ttf" },
            header = { file = FONTS .. "Figtree-SemiBold.ttf", size = 15 },
        },
    })
    useTheme("test-chat-font")
    local file, now = frameOf(CF1):GetFont()
    expect(file).toBe(FONTS .. "Figtree-Medium.ttf")
    expect(now).toBeCloseTo(assert(size))
    expect((CF1:GetFont())).toBe(FONTS .. "Figtree-Medium.ttf")
    expect((eb:GetFont())).toBe(FONTS .. "Figtree-Medium.ttf")
    local tabFile, tabSize = label:GetFont()
    expect(tabFile).toBe(FONTS .. "Figtree-SemiBold.ttf")
    expect(tabSize).toBeCloseTo(14)
    -- a size the player sets keeps the theme's face
    M:SetFontSize(CF1, assert(size) + 2)
    expect(frameOf(CF1):GetFont()).toBe(FONTS .. "Figtree-Medium.ttf")
    M:SetFontSize(CF1, assert(size))
    -- SuuUI's again
    useTheme(nil)
    expect((frameOf(CF1):GetFont())).toBe(body)
    expect((eb:GetFont())).toBe(body)
    tabFile, tabSize = label:GetFont()
    expect(tabFile).toBe(header)
    expect(tabSize).toBeCloseTo(12)
end

@test("a theme's spacing: the chat panel's padding, its size and Blizzard's lines in it; SuuUI's again exactly")
local function themeSpacing()
    layoutThemes()
    ready()
    local p = M:Panel()
    local function look(): { tabsX: number, logY: number, h: number, w: number }
        local _, _, _, tabsX = p.tabs:GetPoint(1)
        local _, _, _, _, logY = p.log:GetPoint(1)
        return { tabsX = tabsX :: number, logY = logY :: number, h = p:GetHeight(), w = p:GetWidth() }
    end
    local design = look()
    expect(design.tabsX).toBe(12)
    expect(design.logY).toBe(-(4 + 24 + 6))
    useTheme(COMPACT)
    local compact = look()
    expect(compact.tabsX).toBe(8)
    expect(compact.logY).toBe(-(2 + 24 + 4))
    expect(compact.h).toBe(design.h - (4 - 2) - (6 - 4) * 2 - (12 - 8))
    expect(compact.w).toBe(design.w)
    useTheme(nil)
    mock.advanceFrames(1)
    expect(look()).toEqual(design)
    expectNoErrors()
end

-- (last: the module through the registry) X-11.a7: Chat is reloadToToggle,
-- so its OnDisable runs only after a failed OnEnable. Here it toggles live
-- for the test, so the registry's own disable, enable and fail run, and the
-- enable fails right after the anchor is published.
@test("an OnEnable that fails after the anchor: the panel and its driver hidden, the anchor withdrawn; on again, back")
local function failedEnable()
    ready()
    local own = ownOf(M)
    own.reloadToToggle = false
    settings.set("chat", "enabled", false)
    expect(M.state).toBe(modules.ModuleState.Disabled)
    local target = M :: unknown :: { [string]: unknown }
    rawset(target, "RegisterSettings", function()
        error("chat-enable-failed")
    end)
    settings.set("chat", "enabled", true)
    rawset(target, "RegisterSettings", nil)
    expect(M.state).toBe(modules.ModuleState.Errored)
    expect(M:Panel():IsShown()).toBe(false)
    expect(assert(M.driver):IsShown()).toBe(false)
    expect(SuuUI.GetAnchor("chat")).toBeNil()
    expect(holdings(M)).toEqual(NOTHING)
    local said = errorsSoFar()
    expect(#said).toBe(1)
    expect(said[1]).toContain("chat-enable-failed")
    fault.log:clear()
    -- on again (a retry): shown, the anchor published, the driver running
    own.state = modules.ModuleState.Disabled
    settings.set("chat", "enabled", false)
    settings.set("chat", "enabled", true)
    mock.advanceFrames(2)
    expect(M.state).toBe(modules.ModuleState.Enabled)
    expect(M:Panel():IsShown()).toBe(true)
    expect(assert(M.driver):IsShown()).toBe(true)
    expect(SuuUI.GetAnchor("chat")).toBe(M:Panel().box)
    own.reloadToToggle = true
    expectNoErrors()
end
