import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"

@test("probe")
local function probe()
    local out: string[] = {}
    local function p(...: any) local t = {} for i = 1, select("#", ...) do t[i] = tostring((select(i, ...))) end out[#out + 1] = table.concat(t, " ") end
    local M: any = SuuUI.GetModule("chat")
    p("enabled", M:IsEnabled())
    mock.advanceFrames(3)
    local n = 0
    for cf, m in pairs(M.mirrors or {}) do n += 1; p("mirror", cf:GetName(), #m.lines, m.raw) end
    p("count", n, "selected", M.selected and M.selected:GetName())
    ChatFrame1:AddMessage("hello |Hplayer:Bob:12|h[Bob]|h says: hi", 1, 1, 0)
    local m = M.mirrors[ChatFrame1]
    p("last", m.lines[#m.lines].text)
    p("windows", #M:Windows(), _G.GENERAL_CHAT_DOCK ~= nil, NUM_CHAT_WINDOWS, _G.CHAT_SAY_GET, _G.CHAT_WHISPER_GET, _G.CHAT_YELL_GET, _G.CHAT_BN_WHISPER_GET, _G.CHAT_MSG_YELL)
    for _, cf in ipairs(M:Windows()) do p("w", cf:GetName(), GetChatWindowInfo(cf:GetID())) end
    p("cvar", GetCVar("showTimestamps"))
    p("palette", (SuuUI.GetModule("chatcommands") :: any):IsEnabled())
    p("ChatTypeInfo", ChatTypeInfo and ChatTypeInfo.WHISPER and ChatTypeInfo.WHISPER.r, ChatTypeInfo and ChatTypeInfo.PARTY and ChatTypeInfo.PARTY.r)
    p("fcf", _G.FCF_OpenTemporaryWindow, _G.FCF_OpenNewWindow, _G.FCF_Close, _G.ChatConfigFrame, _G.IsSecureCmd, _G.C_ChatInfo.InChatMessagingLockdown, _G.C_ChatInfo.GetChatLineSenderGUID)
    p("panel", M.panel:GetLeft(), M.panel:GetBottom(), M.panel:GetWidth(), M.panel:GetHeight())
    p("eb", _G.ChatFrame1EditBox, ChatFrame1.ScrollBar, ChatFrame1.ScrollToBottomButton, ChatFrame1.FontStringContainer)
    p("SCL", type(SlashCmdList), _G.hash_ChatTypeInfoList ~= nil, _G.MAXEMOTEINDEX, _G.EMOTE1_TOKEN, _G.EMOTE1_CMD1, _G.SLASH_INVITE1, _G.ChatEdit_CustomTabPressed, _G.AutoCompleteBox)
    p("tabs", #M.panel.tabButtons, M.panel.tabButtons[1] and M.panel.tabButtons[1].label:GetText())
    p("rec", _G.CombatLogQuickButtonFrame_Custom, _G.EventRegistry ~= nil)
    expect(out).toEqual({})
end
