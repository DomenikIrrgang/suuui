local doras = mock.spawnUnit({
    name = "Doras",
    npcID = 3310,
    level = 55,
    reaction = "friendly",
    classification = "elite",
})
mock.defineGossip(doras, {
    text = "You haven't lived until you've looked down on the world from the back of a wind rider.",
    options = { { name = "I need a ride.", icon = 132057, gossipOptionID = 98541, opens = "taxi" } },
})
mock.defineTaxi(doras, { mapID = 1464, nodes = NODES })
doras:setDistance(3)

-- In Orgrimmar, by the flight master.
local function home()
    mock.moveTo({ mapID = ORGRIMMAR, x = 0.451, y = 0.639 })
end
home()

-- A flight master's place on Kalimdor, as the client gives it.
local function placeOf(nodeID: number): (number, number)
    for _, n in ipairs(C_TaxiMap.GetTaxiNodesForMap(KALIMDOR)) do
        if n.nodeID == nodeID then
            return n.position:GetXY()
        end
    end
    error("no node " .. nodeID)
end

-- The player at a flight master (on Kalimdor's map).
local function at(nodeID: number)
    local x, y = placeOf(nodeID)
    mock.moveTo({ mapID = KALIMDOR, x = x, y = y })
end

-- A shown button by its text.
local function button(root: Frame?, text: string, depth: number?): Button?
    local d = depth or 0
    if d > 8 or not root then
        return nil
    end
    local b = frames.asButton(root)
    if b and b:IsVisible() then
        if secret.asString(b:GetText()) == text then
            return b
        end
        for _, r in ipairs(frames.fontStrings(b)) do
            if r:GetText() == text then
                return b
            end
        end
    end
    for _, c in ipairs(frames.children(root)) do
        local found = button(c, text, d + 1)
        if found then
            return found
        end
    end
    return nil
end

-- One of the game's frames by name.
local function frame(name: string): Frame
    local f = frames.find(name)
    assert(f, "no " .. name)
    return f
end

-- The module's parts, there.
local function side()
    local s = M.side
    assert(s, "no side panel")
    return s
end
local function session()
    local s = M.session
    assert(s, "not at a flight master")
    return s
end
local function node(id: number): TaxiNode
    local n = session().byID[id]
    assert(n, "no node " .. id)
    return n
end
local function timer()
    local t = M.timer
    assert(t, "no flight bar")
    return t
end
local function ink()
    local i = M.ink
    assert(i, "no drawing")
    return i
end
local function flyBar()
    local b = M.bar
    assert(b, "no bar")
    return b
end
local function flight()
    local f = M.flight
    assert(f, "not in the air")
    return f
end
local function hovered(): TaxiNode
    local h = M.hovered
    assert(h, "nothing hovered")
    return h
end
local function selected(): TaxiNode
    local h = M.selected
    assert(h, "nothing chosen")
    return h
end
local function kept()
    local k = M:Char().flight
    assert(k, "no flight kept")
    return k
end
-- The pin of a flight master.
local function pinOf(id: number)
    for _, pin in ipairs(M.pins) do
        local n = pin.node
        if n and n.id == id then
            return pin
        end
    end
    error("no pin " .. id)
end

-- Talk to Doras and ask for a ride: his taxi map opens.
local function openMaster()
    mock.player:target(doras)
    mock.player:interact(doras)
    mock.advanceTime(1)
    local ride = button(frame("GossipFrame"), "I need a ride.")
    assert(ride, "no ride")
    mock.click(ride)
    mock.advanceTime(1)
    mock.advanceFrames(2)
end

-- The side panel's row of a destination, by its short name.
local function row(name: string)
    for _, r in ipairs(side().rows) do
        if r:IsShown() and r.node and r.name:GetText() == name then
            return r
        end
    end
    error("no row " .. name)
end

local function rowNames(): string[]
    local out: string[] = {}
    for _, r in ipairs(side().rows) do
        if r:IsShown() then
            out[#out + 1] = mock.textOf(r.name)
        end
    end
    return out
end

-- Fly: the flight taken (the server's answer a moment later), in the air.
local function takeOff()
    mock.advanceTime(1)
    mock.advanceFrames(2)
end

-- The rest of a flight of `seconds`, already `flown` in, landing where
-- the player is moved to first.
local function land(nodeID: number, seconds: number, flown: number)
    mock.advanceTime(seconds - flown - 5)
    at(nodeID)
    mock.advanceTime(10)
    mock.advanceFrames(2)
end

local function routes(): { [string]: RouteRecord }
    local data = SuuUI.AccountData("flightmap") :: unknown :: { routes?: { [string]: RouteRecord } }
    local list = data.routes or {}
    data.routes = list
    return list
end

local function route(key: string): RouteRecord
    local r = routes()[key]
    assert(r, "no route " .. key)
    return r
end

@afterEach
local function cleanup()
    mock.hover(nil)
    if WorldMapFrame:IsShown() then
        WorldMapFrame:Hide()
    end
    if frame("GossipFrame"):IsShown() then
        frame("GossipFrame"):Hide()
    end
    -- a flight still in the air lands
    if UnitOnTaxi("player") then
        mock.advanceTime(200)
    end
    mock.advanceTime(1)
    mock.player:target(nil)
    M:ForgetTimes()
    M:Reset("confirm")
    M:Reset("atMaster")
    M:Reset("inFlight")
    M:Reset("timer")
    M.flight, M.pending = nil, nil
    M:Char().flight = nil
    home()
    mock.advanceTime(0.5)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- At the flight master
--------------------------------------------------------------------------------

@test("at the flight master: the world map on the continent, the game's map unseen underneath")
local function atTheMaster()
    openMaster()
    expect(M:AtMaster()).toBe(true)
    local taxi = frame("TaxiFrame")
    expect(taxi).toBeShown()
    expect(taxi:GetAlpha()).toBe(0)
    expect(taxi:IsMouseEnabled()).toBe(false)
    expect(WorldMapFrame).toBeShown()
    expect(WorldMapFrame:GetMapID()).toBe(KALIMDOR)
    local chrome = chromeOf(WorldMapFrame)
    assert(chrome, "no window skin")
    expect(chrome.title).toHaveText("Flight master · Orgrimmar")
    expect(M.side).toBeShown()
    expect((session().current or node(0)).id).toBe(23)
end

@test("the destinations: the ones you can fly to by name, their stops and estimated times")
local function destinations()
    openMaster()
    expect(side().head.meta).toHaveText("5")
    expect(rowNames()).toEqual({ "Camp Taurajo", "Crossroads", "Ratchet", "Sun Rock Retreat", "Thunder Bluff" })
    expect(mock.textOf(row("Crossroads").stops):find("^Direct")).toBe(1)
    expect(row("Camp Taurajo").stops).toHaveText("1 stop")
    -- (3335 yards at 30.3 yards a second)
    expect(row("Crossroads").time).toHaveText("~1:50")
    -- the junk node left out, the ones not found listed but not flown to
    expect(session().byID[3208]).toBeNil()
    expect(node(30).kind).toBe("DISTANT")
end

@test("on the map: a pin for each master, the time beside each destination, you are here")
local function pins()
    openMaster()
    local here, crossroads, distant = pinOf(23), pinOf(25), pinOf(30)
    expect(here.tag.text).toHaveText("You are here")
    expect(crossroads.tag.text).toHaveText("~1:50")
    expect(distant.tag).never.toBeShown()
    expect(#M.pins).toBe(21)
end

@test("a destination hovered: its route drawn, its tooltip; away, the network only")
local function hovering()
    openMaster()
    local before = ink().pools.ARTWORK.n
    mock.hover(row("Camp Taurajo"))
    mock.advanceFrames(2)
    expect(hovered().id).toBe(77)
    expect(ink().pools.ARTWORK.n > before).toBe(true)
    local tip = M:Tip(hovered())
    expect(tip.title).toBe("Camp Taurajo, The Barrens")
    expect(tip.subtitle).toBe("via Crossroads")
    expect((tip.lines or {})[2]).toEqual({ "Time", "about 3:21" })
    expect(tip.meta).toBe("Click to fly")
    mock.hover(nil)
    mock.advanceFrames(2)
    expect(M.hovered).toBeNil()
    expect(ink().pools.ARTWORK.n).toBe(before)
end

@test("the tooltips of where you are and of a master not found yet")
local function otherTips()
    openMaster()
    expect(M:Tip(node(23)).subtitle).toBe("Flight master · you are here")
    expect(M:Tip(node(30)).subtitle).toBe("Flight master · not found yet")
end

--------------------------------------------------------------------------------
-- A flight
--------------------------------------------------------------------------------

@test("a click flies: the map closes, the flight bar counts down, the flight's time is learned")
local function flying()
    openMaster()
    mock.click(row("Crossroads"))
    takeOff()
    expect(UnitOnTaxi("player")).toBe(true)
    expect(M:AtMaster()).toBe(false)
    expect(WorldMapFrame).never.toBeShown()
    local bar = timer()
    expect(bar).toBeShown()
    expect(bar.name).toHaveText("Crossroads")
    expect(mock.textOf(bar.time):sub(1, 1)).toBe("~")
    expect(mock.textOf(bar.next):find("^Not timed yet · estimated")).toBe(1)
    land(25, 110.176, 2)
    expect(UnitOnTaxi("player")).toBe(false)
    expect(bar).never.toBeShown()
    local r = route("23>25")
    expect(r.n).toBe(1)
    expect(r.t).toBeCloseTo(110.176, 0)
    -- the character's speed a quarter of the way to what it flew
    expect(M:Speed()).toBeCloseTo(30.3 + 0.25 * (3335 / (r.t or 1) - 30.3), 2)
    expect(M:Char().flights).toBe(1)
end

@test("a flight flown before shows its time; the bar's fill solid")
local function timedFlight()
    routes()["23>25"] = { t = 100, n = 1, v = 30.3 }
    openMaster()
    expect(row("Crossroads").time).toHaveText("1:40")
    mock.click(row("Crossroads"))
    takeOff()
    expect(mock.textOf(timer().time):sub(1, 1)).never.toBe("~")
    expect(mock.textOf(timer().lands):find("^lands ")).toBe(1)
    expect(timer().next).toHaveText("Direct")
end

@test("Confirm before flying: a click chooses, the bar's Fly flies")
local function confirming()
    M:Set("confirm", true)
    openMaster()
    mock.click(row("Ratchet"))
    expect(selected().id).toBe(80)
    expect(M.bar).toBeShown()
    expect(flyBar().name).toHaveText("Ratchet")
    expect(flyBar().via).toHaveText("via Crossroads")
    expect(M:Tip(selected()).meta).toBe("Fly in the bar below")
    expect(UnitOnTaxi("player")).toBe(false)
    mock.click(flyBar().fly)
    takeOff()
    expect(UnitOnTaxi("player")).toBe(true)
end

@test("Confirm turned off at the master: the choice let go")
local function confirmOff()
    M:Set("confirm", true)
    openMaster()
    mock.click(row("Ratchet"))
    expect(M.bar).toBeShown()
    M:Set("confirm", false)
    expect(M.selected).toBeNil()
    expect(M.bar).never.toBeShown()
end

@test("the map closed at the flight master closes the master too")
local function closing()
    openMaster()
    WorldMapFrame:Hide()
    mock.advanceTime(0.5)
    expect(M:AtMaster()).toBe(false)
    expect(frame("TaxiFrame")).never.toBeShown()
    expect(frame("TaxiFrame"):GetAlpha()).toBe(1)
end

@test("with the setting off, the game's own flight map")
local function gamesOwn()
    M:Set("atMaster", false)
    openMaster()
    expect(M:AtMaster()).toBe(false)
    expect(frame("TaxiFrame")).toBeShown()
    expect(frame("TaxiFrame"):GetAlpha()).toBe(1)
    expect(WorldMapFrame).never.toBeShown()
    CloseTaxiMap()
    mock.advanceTime(0.5)
end

@test("the setting turned off at the master: the game's map back")
local function settingOff()
    openMaster()
    M:Set("atMaster", false)
    expect(M:AtMaster()).toBe(false)
    expect(frame("TaxiFrame"):GetAlpha()).toBe(1)
end

--------------------------------------------------------------------------------
-- In the air
--------------------------------------------------------------------------------

@test("a flight with a stop: the next stop, Land at sets you down there")
local function landAt()
    local asked = mock.spy(function() end)
    mock.fake("TaxiRequestEarlyLanding", asked)
    openMaster()
    mock.click(row("Camp Taurajo"))
    takeOff()
    mock.advanceTime(1)
    local bar = timer()
    expect(mock.textOf(bar.next):find("^Not timed yet")).toBe(1)
    expect(bar.land).toBeShown()
    expect(bar.land.label).toHaveText("Land at Crossroads")
    mock.click(bar.land)
    expect(asked).toHaveBeenCalledTimes(1)
    expect(flight().early).toBe(2)
    expect(kept().early).toBe(2)
    expect(bar.land).never.toBeShown()
    expect(bar.name).toHaveText("Crossroads")
    land(25, 110.176, 3)
    -- timed as the flight to the Crossroads
    expect(route("23>25").n).toBe(1)
    expect(routes()["23>25>77"]).toBeNil()
end

@test("the map opened in the air: the continent with your route, the time left by the destination")
local function routeInFlight()
    openMaster()
    mock.click(row("Crossroads"))
    takeOff()
    expect(M.timer).toBeShown()
    ToggleWorldMap()
    mock.advanceFrames(3)
    expect(WorldMapFrame:GetMapID()).toBe(KALIMDOR)
    expect(M.timer).never.toBeShown()
    expect(ink().pools.ARTWORK.n > 0).toBe(true)
    expect(ink().left).toBeShown()
    expect(mock.textOf(ink().left.text):find("left$") ~= nil).toBe(true)
    -- the clock once a second
    mock.advanceTime(1.1)
    mock.advanceFrames(2)
    expect(ink().left).toBeShown()
    -- without the setting, no route
    M:Set("inFlight", false)
    mock.advanceFrames(2)
    expect(ink().pools.ARTWORK.n).toBe(0)
    WorldMapFrame:Hide()
    expect(M.timer).toBeShown()
end

@test("a reload in the air: the flight shown again, not timed")
local function reload()
    openMaster()
    mock.click(row("Crossroads"))
    takeOff()
    local stored = kept()
    expect(stored.path).toEqual({ 23, 25 })
    M.flight = nil
    mock.fireEvent("PLAYER_ENTERING_WORLD", false, true)
    expect(flight().reloaded).toBe(true)
    mock.advanceTime(1.1)
    expect(mock.textOf(timer().next):find("^Not timed yet") ~= nil).toBe(true)
    land(25, 110.176, 3.1)
    expect(routes()["23>25"]).toBeNil()
end

@test("a kept flight too old, or on the ground: dropped")
local function staleFlight()
    M:Char().flight = { path = { 23, 25 }, wall = time() - 60 }
    M:ResumeFlight()
    expect(M.flight).toBeNil()
    expect(M:Char().flight).toBeNil()
    M:Char().flight = { path = { 23, 25 } }
    M:ResumeFlight()
    expect(M.flight).toBeNil()
end

@test("the flight bar off by its setting, and in edit mode a sample to place")
local function barSetting()
    M:Set("timer", false)
    openMaster()
    mock.click(row("Crossroads"))
    takeOff()
    expect(M.timer).never.toBeShown()
    M:Set("timer", true)
    expect(M.timer).toBeShown()
    land(25, 110.176, 2)
    mock.stub(SuuUI.EditMode, "IsActive", function(): boolean
        return true
    end)
    M:Emit("SUUUI_EDITMODE_CHANGED", true)
    expect(M.timer).toBeShown()
    expect(timer().name).toHaveText("Crossroads")
    expect(timer().land.label).toHaveText("Land at Camp Taurajo")
end

--------------------------------------------------------------------------------
-- Settings
--------------------------------------------------------------------------------

@test("the settings: the times summary and Forget")
local function settings()
    expect(M:TimesSummary():find("30.3 yards a second (not flown yet)", 1, true) ~= nil).toBe(true)
    routes()["23>25"] = { t = 100, n = 1, v = 30.3 }
    M:Char().flights = 2
    expect(M:TimesSummary():find("(from 2 flights)", 1, true) ~= nil).toBe(true)
    expect(M:TimesSummary():find("Routes timed for the account: 1.", 1, true) ~= nil).toBe(true)
    M:ForgetTimes()
    expect(routes()["23>25"]).toBeNil()
    expect(M:Char().flights).toBeNil()
    local confirm = assert(SECTION.groups)[1].rows[2]
    expect(assert(confirm.disabled)()).toBe(false)
    M:Set("atMaster", false)
    expect(assert(confirm.disabled)()).toBe(true)
end

@test("turned off at the master: the game's map back; on again")
local function offAndOn()
    openMaster()
    M:Set("enabled", false)
    expect(M:IsEnabled()).toBe(false)
    expect(M:AtMaster()).toBe(false)
    expect(frame("TaxiFrame"):GetAlpha()).toBe(1)
    M:Reset("enabled")
    expect(M:IsEnabled()).toBe(true)
end

