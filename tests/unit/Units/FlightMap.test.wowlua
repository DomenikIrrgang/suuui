import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"

local out: string[] = {}
local function p(...: any)
    local t = {}
    for i = 1, select("#", ...) do t[#t + 1] = tostring((select(i, ...))) end
    out[#out + 1] = table.concat(t, " ")
end

@test("spike")
local function spike()
    local M: any = SuuUI.GetModule("flightmap")
    p("enabled", M:IsEnabled(), M.map, M.timer)
    p("map", C_Map.GetBestMapForUnit("player"), UnitOnTaxi("player"))
    mock.moveTo({ mapID = 1412, x = 0.5, y = 0.5 })
    p("map2", C_Map.GetBestMapForUnit("player"))
    local pos = C_Map.GetPlayerMapPosition(1412, "player")
    p("pos", pos and pos:GetXY())
    local info = C_Map.GetMapInfo(1412)
    p("info", info and info.name, info and info.mapType, info and info.parentMapID)
    local ok, list = pcall(C_TaxiMap.GetTaxiNodesForMap, 1414)
    p("taxinodes", ok, type(list) == "table" and #list or list)
    if ok and type(list) == "table" and list[1] then p("n1", list[1].nodeID, list[1].name, list[1].position and list[1].position:GetXY()) end
    local ok2, w = pcall(C_Map.GetWorldPosFromMapPos, 1414, CreateVector2D(0.5, 0.5))
    p("worldpos", ok2, w, select(3, pcall(C_Map.GetWorldPosFromMapPos, 1414, CreateVector2D(0.5, 0.5))))
    p("maptopos", pcall(C_Map.GetMapPosFromWorldPos, 1, CreateVector2D(0, 0), 1414))
    p("numtaxi", pcall(NumTaxiNodes))
    p("routes", SuuUI.FlightRoutes()[22] and next(SuuUI.FlightRoutes()[22]))
    p("taxiframe", _G.TaxiFrame)
    p("quests", pcall(C_QuestLog.GetQuestsOnMap, 1412))
    p("children", pcall(C_Map.GetMapChildrenInfo, 1414, nil, true))
    expect(table.concat(out, "\n")).toBe("")
end
