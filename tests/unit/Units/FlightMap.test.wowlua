@test("no nodes from the game yet: asked again a moment later, else the game's own map")
local function noNodes()
    mock.fake("NumTaxiNodes", function(): number return 0 end)
    openMaster()
    mock.advanceTime(0.3)
    expect(M:AtMaster()).toBe(false)
    expect(G.TaxiFrame:GetAlpha()).toBe(1)
    CloseTaxiMap()
end

@test("the destinations beside the map while the quest log is closed; over it again when it opens")
local function besideTheMap()
    openMaster()
    G.WorldMapFrame:SetQuestLogPanelShown(false)
    mock.advanceFrames(2)
    expect(M.side.edge.top).toBeShown()
    local _, rel, relPoint = M.side:GetPoint(1)
    expect(rel).toBe(G.WorldMapFrame)
    expect(relPoint).toBe("TOPRIGHT")
    G.WorldMapFrame:SetQuestLogPanelShown(true)
    mock.advanceFrames(2)
    expect(M.side.edge.top).never.toBeShown()
end

@test("a pin hovered: its route and tooltip; a click flies")
local function pinHover()
    openMaster()
    local crossroads
    for _, pin in ipairs(M.pins) do if pin.node.id == 25 then crossroads = pin end end
    mock.hover(crossroads)
    expect(M.hovered.id).toBe(25)
    mock.hover(nil)
    expect(M.hovered).toBeNil()
    mock.click(crossroads)
    takeOff()
    expect(UnitOnTaxi("player")).toBe(true)
end

@test("the quests near a destination: in its row and its tooltip")
local function questSteps()
    -- (a quest taken: the map shows it where the client did)
    local giver = mock.spawnUnit({ name = "Kargal Battlescar", level = 30, reaction = "friendly" })
    mock.defineQuest(959, { title = "Trouble at the Docks", giver = giver })
    giver:setDistance(3)
    mock.player:interact(giver)
    mock.advanceTime(1)
    AcceptQuest()
    mock.advanceTime(1)
    expect(C_QuestLog.IsOnQuest(959)).toBe(true)
    openMaster()
    local found: any = nil
    for id, steps in pairs(M.steps) do
        for _, q in ipairs(steps) do if q == 959 then found = M.session.byID[id] end end
    end
    expect(found ~= nil).toBe(true)
    expect(row(found.name:match("^[^,]+")).stops:GetText():find("1 quest step nearby", 1, true) ~= nil).toBe(true)
    local tip = M:Tip(found)
    -- (no objectives: ready to turn in)
    expect(tip.lines[3]).toEqual({ "Trouble at the Docks", "turn in" })
end

@test("a flight timed before, with a stop: the next stop and its time; landing early")
local function timedWithStop()
    routes()["23>25>77"] = { t = 110.176, n = 1, v = 30.3 }
    local asked = mock.spy(function() end)
    mock.fake("TaxiRequestEarlyLanding", asked)
    openMaster()
    mock.click(row("Camp Taurajo"))
    takeOff()
    mock.advanceTime(1)
    local bar = M.timer
    expect(bar.next:GetText():find("^Next stop Crossroads · ") ~= nil).toBe(true)
    mock.click(bar.land)
    expect(bar.next).toHaveText("Landing early")
end

@test("a flight with no estimate: the time flown over a sweep; still with Reduce motion")
local function sweep()
    openMaster()
    mock.click(row("Crossroads"))
    takeOff()
    -- (a route the data doesn't know, as after a reload from an older SuuUI)
    M.flight = nil
    M:CharData().flight = { path = { 23, 99999 }, wall = time() - 3 }
    M:ResumeFlight()
    M:TickTimer()
    local bar = M.timer
    expect(bar.sweep).toBeShown()
    expect(bar.next).toHaveText("Not timed yet")
    expect(bar.lands).toHaveText("so far")
    expect(bar.name).toHaveText("?")
    mock.advanceFrames(3)
    mock.stub(SuuUI.Motion, "Reduced", function(): boolean return true end)
    M:TickTimer()
    mock.advanceFrames(2)
    -- a fresh flight not yet timed says it's being timed
    local v = M:TimerView({ path = { 23, 99999 }, started = GetTime(), names = {} })
    expect(v.left).toBe("Not timed yet · timing this flight")
end

@test("a kept flight's stops named from the continent's masters")
local function namesFromMap()
    openMaster()
    mock.click(row("Crossroads"))
    takeOff()
    M.flight = nil
    M:CharData().flight = { path = { 23, 25 }, wall = time() - 2 }
    M:ResumeFlight()
    expect(M:StopName(M.flight, 25)).toBe("Crossroads")
end

@test("the landing time on the game's 24-hour clock")
local function militaryTime()
    C_CVar.SetCVar("timeMgrUseMilitaryTime", "1")
    openMaster()
    mock.click(row("Crossroads"))
    takeOff()
    expect(M.timer.lands:GetText():find("^about %d%d:%d%d$") ~= nil).toBe(true)
    C_CVar.SetCVar("timeMgrUseMilitaryTime", "0")
end

@test("the route in flight by the time flown when the game doesn't say where you are")
local function byTime()
    openMaster()
    mock.click(row("Crossroads"))
    takeOff()
    mock.fake("C_Map.GetPlayerMapPosition", function(): any return nil end)
    ToggleWorldMap()
    mock.advanceFrames(3)
    expect(M.ink.pools.ARTWORK.n > 0).toBe(true)
    local fl = M.flight
    fl.route = nil
    expect(M:Flown(fl, false)).toBeCloseTo((GetTime() - fl.started) / fl.expected, 3)
    -- untimed: from the start
    local points = { { 0, 0 }, { 10, 0 } }
    fl.expected = nil
    expect({ M:Along(points, 100, 100) }).toEqual({ 1, 0, 0 })
end

@test("Forget asks first, then forgets; a theme measures the bar again")
local function forgetAndTheme()
    routes()["23>25"] = { t = 100, n = 1, v = 30.3 }
    mock.stub(SuuUI.UI, "Confirm", function(opts: any) opts.onConfirm() end)
    SECTION.groups[3].rows[1].onClick()
    expect(routes()["23>25"]).toBeNil()
    expect((SECTION.groups[3].rows[1].description :: any)()).toBe(M:TimesSummary())
    M:Set("confirm", true)
    openMaster()
    mock.click(row("Ratchet"))
    M:Emit("SUUUI_THEME_CHANGED")
    mock.advanceFrames(2)
    expect(M.bar).toBeShown()
end
