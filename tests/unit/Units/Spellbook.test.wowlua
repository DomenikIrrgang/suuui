-- Units/Spellbook: SuuUI's Spellbook page in the spells window's Spellbook
-- tab (the schools, the learned spells and the trainer's still to come,
-- the switches, pages, tooltips, dragging, cooldowns, combat), the
-- window's size, the training count and cost, and the level-up card.
--
-- The spellbook is the engine's (the default character: a level 1 Human
-- warrior); the trainer's list is SuuUI's data (Data/Trainer).

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import expectNoErrors from "../../helpers"
import internal M from "/Units/Spellbook"
import type BookEntry, School from "/Units/Spellbook"
import type Spellbook from "/UI/Spellbook"
import type LevelUpDef from "/UI/LevelUp"
import type TooltipData from "/UI/Tooltip"
import type TrainerSpell from "/Data/Trainer"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"

-- The spells window (once Blizzard's addon loaded), SuuUI's page in it.
local function window(): Frame?
    return frames.find("PlayerSpellsFrame")
end
local function book(): Spellbook
    return (assert(M.book))
end
local function button(name: string): Button
    return (assert(frames.asButton(tbl.field(_G, name)), name))
end
-- An action button's slot.
local function slotOf(b: Button): number
    return b:GetAttribute("action") :: number
end

-- Opened by its key, as the player does (the game's code opening it from
-- the test would leave the window's tab tainted).
local function open()
    local f = window()
    if not f or not f:IsShown() then
        mock.pressKey(GetBindingKey("TOGGLESPELLBOOK") :: string)
    end
    mock.advanceFrames(2)
end

local function cellTexts(): string[]
    local out: string[] = {}
    for _, c in ipairs(book().cells) do
        -- (an empty slot keeps its cell, see-through)
        if c:IsShown() and c:GetAlpha() > 0 then
            out[#out + 1] = c.label:GetText() or ""
        end
    end
    return out
end

-- The test's pet (the Pet school's tests), dismissed.
local petUnit: mock.MockUnit? = nil
local function noPetBar()
    if petUnit then
        mock.setPet(nil)
        ;(petUnit :: mock.MockUnit):despawn()
        petUnit = nil
    end
end

@afterEach
local function cleanup()
    mock.hover(nil)
    local f = window()
    if f and f:IsShown() then
        HideUIPanel(f)
    end
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    M:Reset("unlearned")
    M:Reset("allRanks")
    M:Reset("levelUp")
    M:Reset("untrained")
    M:Reset("trainingCost")
    M:Reset("levelUpFor")
    M.school, M.page = nil, nil
    noPetBar()
    mock.advanceTime(20)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- What you know and what the trainer has
--------------------------------------------------------------------------------

@test("the schools: General, then the warrior's three trees")
local function schools()
    local names: string[] = {}
    for i, s in ipairs(M:Schools()) do
        names[i] = s.name
    end
    expect(names[1]).toBe("General")
    expect({ names[2], names[3], names[4] }).toEqual({ "Arms", "Fury", "Protection" })
end

@test("a school's learned spells: the spellbook's, with their levels; the passive's own words")
local function learned()
    local arms = M:Schools()[2]
    local list = M:Learned(arms)
    expect(#list > 0).toBe(true)
    for _, s in ipairs(list) do
        expect(s.status == "learned" or s.status == "passive").toBe(true)
    end
end

@test("what's still to train: by your best rank's level; trainable now or later, cheapest first")
local function unlearned()
    local entries: TrainerSpell[] = {
        { name = "Heroic Strike", level = 1, cost = 10, icon = 1, school = "Arms" },
        { name = "Heroic Strike", level = 8, cost = 100, icon = 1, school = "Arms" },
        { name = "Rend", level = 4, cost = 100, icon = 2, school = "Arms" },
        { name = "Parry", level = 1, cost = 0, icon = 3, school = "Arms" },
    }
    local learnedAll: BookEntry[] = {
        { label = "Heroic Strike", level = 1, rank = 1, status = "learned" },
        { label = "Parry", level = 0, status = "passive" },
    }
    local out = M:Unlearned(entries, learnedAll, 4)
    expect(#out).toBe(2)
    expect(out[1].label).toBe("Rend")
    expect(out[1].status).toBe("trainable")
    expect(out[1].sub).toBe("Train now · 1s")
    expect(out[1].fresh).toBe(true)
    expect(out[2].label).toBe("Heroic Strike")
    expect(out[2].rank).toBe(2)
    expect(out[2].status).toBe("future")
    expect(out[2].sub).toBe("Level 8")
end

@test("a talent's trainer ranks: none without the talent; with it, from Rank 2")
local function talentRanks()
    local entries: TrainerSpell[] = {
        { name = "Mortal Strike", level = 48, cost = 10, icon = 1, school = "Arms" },
        { name = "Mortal Strike", level = 54, cost = 20, icon = 1, school = "Arms" },
    }
    expect(#M:Unlearned(entries, {}, 50)).toBe(0)
    local out = M:Unlearned(entries, { { label = "Mortal Strike", level = 40, rank = 1, status = "learned" } }, 50)
    expect(#out).toBe(2)
    expect(out[1].rank).toBe(2)
    expect(out[1].status).toBe("trainable")
    expect(out[2].rank).toBe(3)
    -- without levels to go by: the talent's rank 1 isn't the trainer's first
    local noLevels = M:Unlearned(entries, { { label = "Mortal Strike", level = 0, rank = 1, status = "learned" } }, 50)
    expect(#noLevels).toBe(2)
    expect(noLevels[1].rank).toBe(2)
    -- a learned trainer rank: the next one after it
    local second = M:Unlearned(entries, { { label = "Mortal Strike", level = 48, rank = 2, status = "learned" } }, 60)
    expect(#second).toBe(1)
    expect(second[1].rank).toBe(3)
end

@test("a rank's tooltip line: train now and its cost, or the level it comes at")
local function trainLine()
    expect(
        M:TrainLine({ label = "Rend", status = "trainable", level = 1, cost = 10 }):find(
            "Train now at your class trainer",
            1,
            true
        ) ~=
            nil
    ).toBe(true)
    expect(
        M:TrainLine({ label = "Rend", status = "future", level = 30, cost = 12345 }):find(
            "Learn at level 30",
            1,
            true
        ) ~=
            nil
    ).toBe(true)
end

--------------------------------------------------------------------------------
-- The page
--------------------------------------------------------------------------------

@test("the Spellbook tab: SuuUI's page over Blizzard's, the window shortened to it")
local function page()
    open()
    local f = assert(window())
    expect(book()).toBeShown()
    expect(f:GetHeight()).toBe(528)
    expect(#cellTexts() > 0).toBe(true)
    expect(book().title:GetText()).toBe("Arms")
    -- Blizzard's own spells off screen
    local paged = assert(frames.asFrame(tbl.field(frames.asFrame(tbl.field(f, "SpellBookFrame")), "PagedSpellsFrame")))
    local _, _, _, x = paged:GetPoint(1)
    expect(x).toBe(5000)
    -- Blizzard's height back for the other tabs
    HideUIPanel(f)
    mock.advanceFrames(2)
    expect(M.blizzHeight).toBeNil()
end

@test("the schools, the switches and the pages")
local function navigate()
    open()
    local before = #cellTexts()
    assert(book().onSchool)(1)
    expect(book().title:GetText()).toBe("General")
    assert(book().onSchool)(2)
    assert(book().onSwitch)("unlearned", false)
    expect(M:Get("unlearned")).toBe(false)
    expect(#cellTexts() <= before).toBe(true)
    assert(book().onSwitch)("allRanks", true)
    expect(M:Get("allRanks")).toBe(true)
    assert(book().onPage)(1)
    expect(M.page).toBe(1)
end

@test("a learned spell: the game's tooltip, a click casts it, a drag picks it up")
local function learnedCell()
    open()
    assert(book().onSchool)(1)
    local c, i = book().cells[1], 1
    expect(c.button:GetAttribute("type")).toBe("spell")
    assert(book().onEnter)(i, c)
    expect(GameTooltip:IsShown()).toBe(true)
    assert(book().onLeave)(1, book().cells[1])
    expect(GameTooltip:IsShown()).toBe(false)
    -- dragged onto an action button: the slot holds it
    local target = button("SuuUIActionBar1Button12")
    mock.dragTo(c.button, target)
    local kind, id = GetActionInfo(slotOf(target))
    expect(kind).toBe("spell")
    expect(id).toBe(c.button:GetAttribute("spell") :: number)
    ClearCursor()
end

@test("in combat a learned spell drags onto an action button too (the game's secure drag handler picks it up)")
local function dragInCombat()
    open()
    assert(book().onSchool)(1)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    local c = book().cells[1]
    local target = button("SuuUIActionBar1Button11")
    mock.dragTo(c.button, target)
    local kind, id = GetActionInfo(slotOf(target))
    expect(kind).toBe("spell")
    expect(id).toBe(c.button:GetAttribute("spell") :: number)
    ClearCursor()
    expectNoErrors()
end

@test("a spell still to train: SuuUI's tooltip with when and what it costs; no click")
local function unlearnedCell()
    open()
    for i = 2, 4 do
        assert(book().onSchool)(i)
        for j, s in ipairs(assert(M.slice)) do
            if s.status == "future" or s.status == "trainable" then
                local c = book().cells[j]
                expect(c.button:GetAttribute("type")).toBeNil()
                assert(book().onEnter)(j, c)
                assert(book().onLeave)(1, book().cells[1])
                -- a drag picks nothing up
                mock.dragTo(c.button, button("SuuUIActionBar1Button12"))
                expect((GetCursorInfo())).toBeNil()
                return
            end
        end
    end
    error("no spell to train")
end

-- What each learned cell's button casts, by the cell's spell.
local function castsMatch(): boolean
    for i, c in ipairs(book().cells) do
        local s = M.slice and M.slice[i]
        local want = s and s.status == "learned" and s.spellID or nil
        if c.button:GetAttribute("spell") ~= want then
            return false
        end
    end
    return true
end

@test("a spell icon casts on the release, whatever the game's cast on key down says: the press starts a drag")
local function castOnRelease()
    open()
    mock.setCVar("ActionButtonUseKeyDown", "1")
    local found: Button? = nil
    for i, c in ipairs(book().cells) do
        local s = M.slice and M.slice[i]
        if s and s.status == "learned" and c.button:GetAttribute("spell") then
            found = c.button
            break
        end
    end
    local b = assert(found)
    expect(b:GetAttribute("useOnKeyDown")).toBe(false)
    -- (the cast the secure button makes, watched through a secure hook)
    local casts = 0
    hooksecurefunc("CastSpellByID", function()
        casts = casts + 1
    end)
    -- the press alone: nothing
    mock.script(b, "OnClick", "LeftButton", true)
    expect(casts).toBe(0)
    -- a whole click: cast once, on the release
    mock.click(b)
    expect(casts).toBe(1)
    mock.setCVar("ActionButtonUseKeyDown", "0")
end

@test(
    "in combat: the schools and pages switch, the buttons casting the new page's spells; the switches wait for its end"
)
local function combat()
    open()
    expect(castsMatch()).toBe(true)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    -- General's tab: clicked through its secure button
    mock.click(book().tabs[1].secure)
    expect(book().title:GetText()).toBe("General")
    expect(castsMatch()).toBe(true)
    local general: unknown = book().cells[1].button:GetAttribute("spell")
    expect(general ~= nil).toBe(true)
    -- back to Arms
    mock.click(book().tabs[2].secure)
    expect(book().title:GetText()).toBe("Arms")
    expect(castsMatch()).toBe(true)
    -- the pager: within the school's pages, both sides agree
    mock.click(assert(book().nextSecure))
    mock.click(assert(book().prevSecure))
    expect(M.page).toBe(1)
    expect(castsMatch()).toBe(true)
    -- a switch changes what the pages hold: after combat
    assert(book().onSwitch)("unlearned", false)
    expect(M.renderAfterCombat).toBe(true)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(M.renderAfterCombat).toBe(false)
    expect(castsMatch()).toBe(true)
    expectNoErrors()
end

@test("the cooldown sweeps follow the game's cooldowns")
local function cooldowns()
    open()
    local set = mock.spy(function(_: unknown, _: number, _: unknown, _: unknown, _: unknown) end)
    mock.stub(book(), "SetCooldown", set)
    mock.fireEvent("SPELL_UPDATE_COOLDOWN")
    expect(set).toHaveBeenCalled()
    assert(book().onCooldownDone)()
    mock.advanceTime(0.2)
end

--------------------------------------------------------------------------------
-- Training and the level-up card
--------------------------------------------------------------------------------

@test("how much there is to train, told to the rest of SuuUI; its cost by the setting")
local function toTrain()
    local told: { n: number, cost?: number }[] = {}
    M:On("SUUUI_SPELLS_TO_TRAIN", function(_: unknown, n: number, cost: number?)
        told[#told + 1] = { n = n, cost = cost }
    end)
    local n, cost = M:CountToTrain()
    M:SayToTrain()
    mock.advanceTime(1.1)
    expect(told[#told]).toEqual({ n = n, cost = cost })
    M:Set("trainingCost", false)
    mock.advanceTime(1.1)
    expect(told[#told].cost).toBeNil()
end

@test("the level-up card: the spells a level brings, its cost, gone after its time")
local function levelUpCard()
    local shown: LevelUpDef[] = {}
    mock.stub(SuuUI, "ShowLevelUp", function(_: string, def: LevelUpDef)
        shown[#shown + 1] = def
    end)
    local hidden = mock.spy(function(_: string) end)
    mock.stub(SuuUI, "HideAlert", hidden)
    local def = assert(M:NextLevelUp())
    local level = assert(tonumber(assert(def.title):match("%d+")))
    expect(M:ShowLevelUp(level)).toBe(true)
    expect(shown[1].title).toBe(def.title)
    mock.advanceTime(4 + math.min(#assert(def.spells), 10) + 0.1)
    expect(hidden).toHaveBeenCalledTimes(1)
    -- the setting's own seconds
    M:Set("levelUpFor", 5)
    M:ShowLevelUp(level)
    mock.advanceTime(5.1)
    expect(hidden).toHaveBeenCalledTimes(2)
    -- nothing to learn at a level (earlier ones' left out): no card
    M:Set("untrained", false)
    expect(M:ShowLevelUp(1000)).toBe(false)
end

@test("a level gained: the card half a second later, or once combat ends")
local function levelGained()
    local shown: LevelUpDef[] = {}
    mock.stub(SuuUI, "ShowLevelUp", function(_: string, def: LevelUpDef)
        shown[#shown + 1] = def
    end)
    local def = assert(M:NextLevelUp())
    local level = assert(tonumber(assert(def.title):match("%d+")))
    mock.player:enterCombat()
    M:LevelGained(level)
    mock.advanceTime(1)
    expect(#shown).toBe(0)
    mock.player:leaveCombat()
    mock.advanceTime(1)
    expect(#shown).toBe(1)
    -- the card off: nothing
    M:Set("levelUp", false)
    M:LevelGained(level)
    mock.advanceTime(1)
    expect(#shown).toBe(1)
end

@test("/suu levelup: the next level's card, a given level's, or why not")
local function command()
    local shown: LevelUpDef[] = {}
    mock.stub(SuuUI, "ShowLevelUp", function(_: string, def: LevelUpDef)
        shown[#shown + 1] = def
    end)
    mock.slash("/suu levelup")
    expect(#shown).toBe(1)
    mock.slash("/suu levelup 20")
    expect(shown[2].title).toBe("Level 20")
    -- a level that brings nothing
    mock.stub(M, "ShowLevelUp", function(): boolean
        return false
    end)
    local before = #mock.printed()
    mock.slash("/suu levelup 7")
    expect(#mock.printed() > before).toBe(true)
end

@test("the settings' preview: the next level's card")
local function preview()
    local parent = CreateFrame("Frame", nil, UIParent)
    M:PreviewView(parent)
    local view = assert(M.previewView)
    expect(view.card:GetWidth() > 0).toBe(true)
    M:Set("untrained", false)
    expect(view.card).toBeShown()
end

@test("the game's level-up toast out of sight while the card is on")
local function toasts()
    local f = assert(frames.find("EventToastManagerFrame"))
    -- (its mixin's, undeclared)
    local display = tbl.field(f, "DisplayToast") :: (self: Frame, also: boolean) -> ()
    -- the game's next toast (the server's: a level reached, then a flight
    -- point found)
    local next: { [string]: unknown }? = {
        eventType = Enum.EventToastEventType.LevelUp,
        displayType = Enum.EventToastDisplayType.NormalSingleLine,
        title = "Level 2",
    }
    mock.fake("C_EventToastManager.GetNextToastToDisplay", function(): unknown
        return next
    end)
    display(f, true)
    expect(f:GetAlpha()).toBe(0)
    next = {
        eventType = Enum.EventToastEventType.FlightpointDiscovered,
        displayType = Enum.EventToastDisplayType.NormalSingleLine,
        title = "Crossroads",
    }
    display(f, true)
    expect(f:GetAlpha()).toBe(1)
    next = nil
    display(f, true)
end

@test("a flyout's spells unpacked, but not those with their own entry; dragged by spell")
local function flyouts()
    -- (the game's answers for a warrior with a stances flyout: the default
    -- character has none)
    mock.fake("C_SpellBook.GetNumSpellBookSkillLines", function(): number
        return 1
    end)
    mock.fake("C_SpellBook.GetSpellBookSkillLineInfo", function(_: number): unknown
        return { name = "Protection", iconID = 1, itemIndexOffset = 0, numSpellBookItems = 2 }
    end)
    mock.fake("C_SpellBook.GetSpellBookItemInfo", function(slot: number, _: unknown): unknown
        if slot == 1 then
            return { itemType = Enum.SpellBookItemType.Spell, spellID = 2457, name = "Battle Stance" }
        end
        return { itemType = Enum.SpellBookItemType.Flyout, actionID = 93 }
    end)
    mock.fake("GetFlyoutInfo", function(_: number): (string, string, number, boolean)
        return "Stances", "", 2, true
    end)
    mock.fake("GetFlyoutSlotInfo", function(_: number, j: number): (number, nil, boolean, string)
        if j == 1 then
            return 2457, nil, true, "Battle Stance"
        end
        return 71, nil, true, "Defensive Stance"
    end)
    local school: School = { name = "Protection", icon = 1, first = 1, count = 2 }
    local list = M:Learned(school)
    local names: string[] = {}
    for i, s in ipairs(list) do
        names[i] = s.label
    end
    expect(names).toEqual({ "Battle Stance", "Defensive Stance" })
    -- (a flyout's spell has no slot of its own: cast and dragged by its ID)
    expect(list[2].slot).toBeNil()
    expect(list[2].spellID).toBe(71)
end

@test("a spell to train without its ID known: SuuUI's own tooltip")
local function ownTip()
    local got: TooltipData? = nil
    mock.stub(SuuUI.UI, "ShowTooltip", function(_: unknown, def: TooltipData)
        got = def
    end)
    M:ShowUnlearnedTip(UIParent, { label = "Made Up", level = 70, rank = 2, cost = 5, status = "future", text = "x" })
    local shown = assert(got)
    expect(shown.title).toBe("Made Up")
    expect(shown.subtitle).toBe("Rank 2")
    expect(shown.meta).toBe("Learn at level 70")
end

@test("Blizzard places its spells again: off screen once more, a frame later")
local function spellsAway()
    open()
    local spells = assert(
        frames.asFrame(tbl.field(frames.asFrame(tbl.field(window(), "SpellBookFrame")), "PagedSpellsFrame"))
    )
    spells:SetPoint("TOPLEFT", UIParent, "TOPLEFT")
    mock.advanceFrames(2)
    local _, _, _, x = spells:GetPoint(1)
    expect(x).toBe(5000)
end

@test("nothing left to learn: said so")
local function nothingLeft()
    mock.stub(M, "ShowLevelUp", function(): boolean
        return false
    end)
    local before = #mock.printed()
    M:PreviewLevelUp()
    expect(#mock.printed()).toBe(before + 1)
end

@test("the Character window resized while the Spellbook shows: the same height; money and themes redraw")
local function redraws()
    open()
    local render = mock.spy(function(_: unknown, _: unknown) end)
    M:MeasureCharacter()
    expect(assert(window()):GetHeight()).toBe(528)
    mock.stub(M, "Render", render)
    mock.player:setMoney(12345)
    expect(render).toHaveBeenCalled()
    local parent = CreateFrame("Frame", nil, UIParent)
    M:PreviewView(parent)
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    expect(render).toHaveBeenCalledTimes(2)
end

@test(
    "opened in a fight (by its key): at the Spellbook's size and in its place, as out of combat (the window's secure placer)"
)
local function openedInCombat()
    open()
    local f = assert(window())
    HideUIPanel(f)
    mock.advanceFrames(2)
    mock.pressKey(GetBindingKey("TOGGLESPELLBOOK") :: string)
    mock.advanceFrames(3)
    expect(f:IsShown()).toBe(true)
    local w, h = f:GetWidth(), f:GetHeight()
    local point, rel, relPoint, x, y = f:GetPoint(1)
    mock.pressKey(GetBindingKey("TOGGLESPELLBOOK") :: string)
    mock.advanceFrames(2)
    expect(f:IsShown()).toBe(false)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    mock.pressKey(GetBindingKey("TOGGLESPELLBOOK") :: string)
    mock.advanceFrames(3)
    expect(f:IsShown()).toBe(true)
    local p2, r2, rp2, x2, y2 = f:GetPoint(1)
    expect(f:GetWidth()).toBeCloseTo(w)
    expect(f:GetHeight()).toBeCloseTo(h)
    expect(p2).toBe(point)
    expect(r2).toBe(rel)
    expect(rp2).toBe(relPoint)
    expect(x2).toBeCloseTo(x)
    expect(y2).toBeCloseTo(y)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The pet's school
--------------------------------------------------------------------------------

-- A pet's spell as its book holds it, and its autocast (allowed, on).
type PetSpell = {
    name: string,
    spellID: number,
    icon: number,
    sub?: string,
    passive?: boolean,
    auto?: boolean,
    on?: boolean,
}

-- A hunter's pet's book (the engine has no pet bank: the game's answers,
-- faked); `spells` nil: no pet. Returns the book and the book's autocast
-- toggle's spy: forbidden to addons on Forever (found in game), it fails
-- when called.
type PetBook = { spells: PetSpell[]? }
local function fakePet(spells: PetSpell[]?): (PetBook, (...unknown) -> ...unknown)
    local pet: PetBook = { spells = spells }
    local realInfo, realAuto = C_SpellBook.GetSpellBookItemInfo, C_SpellBook.GetSpellBookItemAutoCast
    local function spell(slot: number, bank: unknown): PetSpell?
        local list = pet.spells
        return bank == Enum.SpellBookSpellBank.Pet and list and list[slot] or nil
    end
    mock.fake("C_SpellBook.HasPetSpells", function(): (number?, string?)
        local list = pet.spells
        if list and #list > 0 then
            return #list, "PET"
        end
        return nil, nil
    end)
    mock.fake("PetHasSpellbook", function(): boolean
        return pet.spells ~= nil
    end)
    mock.fake("C_SpellBook.GetSpellBookItemInfo", function(slot: number, bank: SpellBookSpellBank): unknown
        if bank ~= Enum.SpellBookSpellBank.Pet then
            return realInfo(slot, bank)
        end
        local s = spell(slot, bank)
        return s and
            {
                itemType = Enum.SpellBookItemType.PetAction,
                name = s.name,
                spellID = s.spellID,
                iconID = s.icon,
                subName = s.sub or "",
                isPassive = s.passive == true,
            } or
            nil
    end)
    mock.fake("C_SpellBook.GetSpellBookItemAutoCast", function(
        slot: number,
        bank: SpellBookSpellBank
    ): (boolean?, boolean?)
        if bank ~= Enum.SpellBookSpellBank.Pet then
            return realAuto(slot, bank)
        end
        local s = spell(slot, bank)
        if not s then
            return nil, nil
        end
        return s.auto == true, s.on == true
    end)
    local toggle = mock.fake("C_SpellBook.ToggleSpellBookItemAutoCast", function(_: number, _: SpellBookSpellBank)
        error("Forbidden: ToggleSpellBookItemAutoCast()")
    end)
    mock.fake("C_SpellBook.SetSpellBookItemAutoCastEnabled", function(_: number, _: SpellBookSpellBank, _: boolean)
        error("Forbidden: SetSpellBookItemAutoCastEnabled()")
    end)
    return pet, toggle
end

local function wolf(): PetSpell[]
    return {
        { name = "Bite", spellID = 17253, icon = 132278, sub = "Rank 2", auto = true, on = true },
        { name = "Growl", spellID = 2649, icon = 132270, sub = "Rank 1", auto = true, on = false },
        { name = "Great Stamina", spellID = 4187, icon = 136112, passive = true },
    }
end

-- The Pet school's tab (its index), when shown.
local function petTab(): number?
    for i, t in ipairs(book().tabs) do
        if t:IsShown() and t.label == "Pet" then
            return i
        end
    end
    return nil
end

@test("no pet: no Pet school")
local function noPet()
    open()
    expect(petTab()).toBeNil()
    expect(M:PetSchool()).toBeNil()
end

@test(
    "a pet's spells: the Pet school after the class's, its spells with their icons, ranks and autocast; a click casts"
)
local function petSchool()
    fakePet(wolf())
    open()
    local i = assert(petTab())
    expect(i).toBe(#M:Schools() + 1)
    assert(book().onSchool)(i)
    expect(book().title:GetText()).toBe("Pet")
    expect(cellTexts()).toEqual({ "Bite", "Growl", "Great Stamina" })
    local cells = book().cells
    expect(cells[1].icon.art:GetTexture()).toBe(132278)
    expect(cells[3].icon.art:GetTexture()).toBe(136112)
    -- its rank, and whether it casts on its own (on: arcane, and the icon's border)
    local bite = cells[1].sub:GetText() or ""
    expect(bite:find("Rank 2 · ", 1, true) ~= nil).toBe(true)
    expect(bite:find("Autocast on", 1, true) ~= nil).toBe(true)
    expect(cells[1].icon.borderToken).toBe("arcane")
    expect(cells[2].sub:GetText()).toBe("Rank 1 · Autocast off")
    expect(cells[2].icon.borderToken).toBe("gilt-hairline")
    expect(cells[3].sub:GetText()).toBe("Passive")
    -- a click casts it (by its name, as /cast does); the passive casts nothing
    expect(cells[1].button:GetAttribute("type")).toBe("spell")
    expect(cells[1].button:GetAttribute("spell")).toBe("Bite")
    expect(cells[3].button:GetAttribute("type")).toBeNil()
    local cast: unknown = nil
    hooksecurefunc("CastSpellByName", function(name: unknown)
        cast = name
    end)
    mock.click(cells[1].button)
    expect(cast).toBe("Bite")
    -- the game's tooltip from the pet's book
    local tip = mock.spy(function(_: unknown, _: number, _: unknown) end)
    mock.stub(GameTooltip, "SetSpellBookItem", tip)
    assert(book().onEnter)(2, cells[2])
    expect(tip).toHaveBeenCalledWith(GameTooltip, 2, Enum.SpellBookSpellBank.Pet)
    assert(book().onLeave)(2, cells[2])
end

-- The pet (a hunter's wolf) and its bar: `bar[slot]` the spell there
-- (attack, follow and stay in 1 to 3, the modes in 8 to 10).
local function petBar(bar: { [number]: PetSpell })
    local actions: { [number]: mock.PetAction } = {}
    for slot = 4, 7 do
        local s = bar[slot]
        -- (an empty slot: nothing in it)
        actions[slot] = s and
            {
                spell = s.spellID,
                name = s.name,
                icon = s.icon,
                autocast = s.on == true,
                autocastAllowed = s.auto == true,
            } or
            {}
    end
    local unit = petUnit or mock.spawnUnit({ name = "Wolf", level = 10, reaction = "friendly" })
    petUnit = unit
    mock.setPet(unit, { hunter = true, actions = actions })
    mock.advanceFrames(1)
end
-- What a right click on a cell runs: the macro's text, or "" (nothing).
local function rightClick(i: number): string
    local b = book().cells[i].button
    if b:GetAttribute("type2") == "macro" then
        return b:GetAttribute("macrotext2") :: string
    end
    return b:GetAttribute("type2") :: string
end

@test(
    "a right click on a pet's spell clicks the pet bar's button for its slot: its autocast, in combat too; never the book's toggle"
)
local function petAutocast()
    local list = wolf()
    local _, toggle = fakePet(list)
    petBar({ [4] = list[1] })
    open()
    assert(book().onSchool)(assert(petTab()))
    local cells = book().cells
    -- Bite on slot 4: the game's PetActionButton4 (as SuuUI's pet bar does)
    expect(cells[1].button:GetAttribute("type2")).toBe("macro")
    expect(rightClick(1)).toBe("/click PetActionButton4 RightButton")
    -- Growl on no slot, the passive: a right click does nothing
    expect(rightClick(2)).toBe("")
    expect(rightClick(3)).toBe("")
    -- right clicked: no menu, nothing of the book's; the macro's /click
    -- (the engine runs no /click from a macro: here as /click does it, the
    -- button clicked with the right button) has the game's pet bar button
    -- turn it, as SuuUI's own pet bar does
    local turned: unknown[] = {}
    hooksecurefunc("TogglePetAutocast", function(slot: unknown)
        turned[#turned + 1] = slot
    end)
    for i = 1, 3 do
        mock.click(cells[i].button, "RightButton")
    end
    button("PetActionButton4"):Click("RightButton")
    expect(turned).toEqual({ 4 })
    -- the page shows it (the bar's word for it, PET_BAR_UPDATE)
    expect((cells[1].sub:GetText() or ""):find("Autocast off", 1, true) ~= nil).toBe(true)
    expect(cells[1].icon.borderToken).toBe("gilt-hairline")
    -- in combat too: the right click stays, the page follows the bar
    mock.player:enterCombat()
    mock.advanceFrames(1)
    mock.click(cells[1].button, "RightButton")
    expect(rightClick(1)).toBe("/click PetActionButton4 RightButton")
    button("PetActionButton4"):Click("RightButton")
    expect(turned).toEqual({ 4, 4 })
    expect((cells[1].sub:GetText() or ""):find("Autocast on", 1, true) ~= nil).toBe(true)
    expect(toggle).toHaveBeenCalledTimes(0)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    noPetBar()
    expectNoErrors()
end

@test("a pet's spell on no pet bar slot: its tooltip says to right click it on the pet bar")
local function petAutocastTip()
    local list = wolf()
    fakePet(list)
    petBar({ [4] = list[1] })
    open()
    assert(book().onSchool)(assert(petTab()))
    local cells = book().cells
    mock.stub(GameTooltip, "SetSpellBookItem", function(_: unknown, _: number, _: unknown) end)
    local lines: string[] = {}
    mock.stub(GameTooltip, "AddLine", function(_: unknown, text: unknown)
        lines[#lines + 1] = tostring(text)
    end)
    -- Growl: on no slot
    assert(book().onEnter)(2, cells[2])
    expect(lines).toEqual({ "Autocast: right click it on the pet bar." })
    assert(book().onLeave)(2, cells[2])
    -- Bite (on the bar) and the passive: no such line
    assert(book().onEnter)(1, cells[1])
    assert(book().onEnter)(3, cells[3])
    expect(#lines).toBe(1)
    assert(book().onLeave)(3, cells[3])
    noPetBar()
end

@test("the pet bar changed: the right click follows the spell to its slot; in combat once it ends")
local function petAutocastFollows()
    local list = wolf()
    local _, toggle = fakePet(list)
    petBar({ [4] = list[1] })
    open()
    assert(book().onSchool)(assert(petTab()))
    expect(rightClick(1)).toBe("/click PetActionButton4 RightButton")
    -- Bite moved to slot 6, Growl put on slot 4 (PET_BAR_UPDATE), the window closed too
    HideUIPanel(assert(window()))
    petBar({ [4] = list[2], [6] = list[1] })
    expect(rightClick(1)).toBe("/click PetActionButton6 RightButton")
    expect(rightClick(2)).toBe("/click PetActionButton4 RightButton")
    open()
    assert(book().onSchool)(assert(petTab()))
    -- in combat the secure attributes stay; they follow once it ends
    mock.player:enterCombat()
    mock.advanceFrames(1)
    petBar({ [7] = list[1] })
    expect(rightClick(1)).toBe("/click PetActionButton6 RightButton")
    expect(M.renderAfterCombat).toBe(true)
    -- switching schools in combat: the router carries the right clicks
    mock.click(book().tabs[1].secure)
    expect(rightClick(1)).toBe("")
    mock.click(book().tabs[assert(petTab())].secure)
    expect(rightClick(1)).toBe("/click PetActionButton6 RightButton")
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(rightClick(1)).toBe("/click PetActionButton7 RightButton")
    expect(rightClick(2)).toBe("")
    expect(toggle).toHaveBeenCalledTimes(0)
    noPetBar()
    expectNoErrors()
end

@test("a right click on a class spell casts nothing")
local function classRightClick()
    open()
    assert(book().onSchool)(1)
    local b = book().cells[1].button
    expect(b:GetAttribute("type")).toBe("spell")
    expect(b:GetAttribute("type2")).toBe("")
    local casts = 0
    hooksecurefunc("CastSpellByID", function()
        casts = casts + 1
    end)
    mock.click(b, "RightButton")
    expect(casts).toBe(0)
end

@test("a pet's spell dragged out of combat: picked up from the pet's book")
local function petDrag()
    fakePet(wolf())
    open()
    assert(book().onSchool)(assert(petTab()))
    local pickup = mock.fake("C_SpellBook.PickupSpellBookItem", function(_: number, _: SpellBookSpellBank) end)
    assert(book().onDragStart)(2, book().cells[2])
    expect(pickup).toHaveBeenCalledWith(2, Enum.SpellBookSpellBank.Pet)
    -- the passive: nothing
    assert(book().onDragStart)(3, book().cells[3])
    expect(pickup).toHaveBeenCalledTimes(1)
end

@test("the pet gone: its school goes; in a fight it waits for the end (the tabs are secure)")
local function petGone()
    local pet = fakePet(wolf())
    open()
    expect(petTab() ~= nil).toBe(true)
    pet.spells = nil
    mock.fireEvent("UNIT_PET", "player")
    expect(petTab()).toBeNil()
    -- back, then gone in a fight: there till it ends, its page empty
    pet.spells = wolf()
    mock.fireEvent("UNIT_PET", "player")
    local i = assert(petTab())
    assert(book().onSchool)(i)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    pet.spells = nil
    mock.fireEvent("UNIT_PET", "player")
    expect(petTab()).toBe(i)
    expect(#cellTexts()).toBe(0)
    expect(M.renderAfterCombat).toBe(true)
    mock.player:leaveCombat()
    mock.advanceFrames(1)
    expect(petTab()).toBeNil()
    expect(book().title:GetText() ~= "Pet").toBe(true)
    expectNoErrors()
end
