-- Units/Timeline: the encounter timeline (hidden while nothing is on it;
-- the test's five abilities; the timeline or the list; off; a finished
-- one leaving), the pull countdown (/suu pull through the game's own
-- countdown: its alert, the last ten seconds or none, the voice, Pull! at
-- zero; cancelled by 0, by the countdown's cancel or by combat; started by
-- someone else's countdown or SuuUI message; without the game's countdown
-- SuuUI's own message), Blizzard's numbers kept away, boss mods (DBM's and
-- BigWigs' timers on the timeline, their bars and DBM's warnings hidden),
-- the preview and the settings rows; the old voices carried over;
-- stopped.
--
-- Forever has the game's own timeline off (`IsFeatureAvailable()` false),
-- but an addon's timers still go on it (seen in game): the engine's
-- timeline carries them here.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M, SECTION from "/Units/Timeline"
import migrations as settingMigrations from "/Core/Settings"
import expectNoErrors, cycle, holdings, NOTHING from "../../helpers"
import * as settings from "/Core/Settings"
import * as comm from "/Core/Comm"

import type EncounterTimeline from "/UI/Timeline"
import * as tbl from "wowlua:table"

local ET = C_EncounterTimeline

-- The timeline (made when the module came on).
local function tl(): EncounterTimeline
    return assert(M.timeline)
end
-- its first and second events' badge
local function badgeText(i: number): string?
    return assert(assert(tl().events)[i].badge).text
end

-- A boss mod's callback; a DBM bar; a LibCandyBar bar (its data on it).
type Callback = (...unknown) -> ()
type Bar = { frame: Frame }
type CandyBar = Frame & { data: { [string]: unknown } }

-- A settings row as the tests read it.
type Row = {
    key?: string,
    text?: string,
    onClick?: () -> (),
    disabled?: () -> (boolean?, string?),
    description?: unknown,
}
local function rowsBy(field: string): { [string]: Row }
    local out: { [string]: Row } = {}
    for _, g in ipairs(SECTION.groups or {}) do
        for _, r in ipairs(g.rows) do
            local row: Row = r
            local name = field == "key" and row.key or (row.text or row.key)
            if name then
                out[name] = row
            end
        end
    end
    return out
end
local friend = mock.spawnUnit({
    name = "Brannoc Ironhand",
    player = true,
    class = "WARRIOR",
    level = 30,
    reaction = "friendly",
})

-- The alerts raised: their title by key.
local function alerts(): { [string]: string }
    local shown: { [string]: string } = {}
    mock.stub(SuuUI, "ShowAlert", function(key: string, _: string, title: string, detail: string?)
        shown[key] = title .. (detail and (" · " .. detail) or "")
    end)
    mock.stub(SuuUI, "HideAlert", function(key: string)
        shown[key] = nil
    end)
    return shown
end

-- An addon message as the game sends it.
local function addonMessage(prefix: string, text: string, sender: string, channel: string?)
    mock.fireEvent("CHAT_MSG_ADDON", prefix, text, channel or "PARTY", sender, "", 0, 0, "", 0)
end

local function labels(sorted: boolean?): string
    local out: string[] = {}
    for _, e in ipairs(tl().events or {}) do
        out[#out + 1] = e.label or ""
    end
    if sorted then
        table.sort(out)
    end
    return table.concat(out, ", ")
end

@afterEach
local function cleanup()
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    M:CancelPull(true)
    mock.group:leave()
    M:ResetAll({ "variant", "position", "pullSeconds", "pullAlert", "pullVoice", "source", "hideTheirs" })
    M.labels, M.badges, M.addonTimers = {}, {}, {}
    ET.CancelAllScriptEvents()
    mock.advanceTime(2)
    expectNoErrors()
end

@test(
    "hidden while nothing is on it; the test's five abilities, the timeline or the list; off; one leaving as it runs out"
)
local function timeline()
    M:Refresh()
    expect(tl():IsShown()).toBe(false)
    M:Test()
    expect(tl():IsShown()).toBe(true)
    expect(labels()).toBe("Shield Wall, Frost Nova, Rain of Fire, Death Coil, Whirlwind")
    expect(badgeText(1)).toBe("Tank")
    expect(tl().variant).toBe("track")
    M:Set("variant", "list")
    expect(tl().variant).toBe("list")
    M:Set("variant", "off")
    expect(tl():IsShown()).toBe(false)
    expect(SuuUI.GetAnchor("encounterTimeline")).toBeNil()
    M:Set("variant", "track")
    expect(SuuUI.GetAnchor("encounterTimeline")).toBe(M.timeline)
    -- Shield Wall's 4 seconds run out: it leaves
    mock.advanceTime(4.2)
    expect(labels()).toBe("Frost Nova, Rain of Fire, Death Coil, Whirlwind")
    M:Set("position", { point = "TOP", x = 0, y = -28, hidden = true })
    expect(tl():IsShown()).toBe(false)
end

@test("an ability's danger badge from its icons; a secret name or time left out; a paused one")
local function badges()
    local set = Enum.EncounterTimelineIconSet
    ET.AddScriptEvent({
        spellID = 122,
        iconFileID = 1,
        duration = 8,
        overrideName = "Nova",
        icons = bit.lshift(1, set.Deadly),
    })
    ET.AddScriptEvent({ spellID = 123, iconFileID = 1, duration = 9, overrideName = "Hold", paused = true })
    M:Refresh()
    expect(badgeText(1)).toBe("Lethal")
    expect(assert(tl().events)[2].paused).toBe(9)
    -- (a name the game keeps secret)
    local info = ET.GetEventInfo
    mock.stub(ET, "GetEventInfo", function(id: number): unknown
        local e = info(id)
        e.spellName = mock.secret(e.spellName :: string)
        return e
    end)
    M:Refresh()
    expect(assert(tl().events)[1].label).toBe("")
end

@test("/suu pull: the game's countdown, its alert to Pull!, the voice for the last ten seconds")
local function pull()
    local shown = alerts()
    local played: { string } = {}
    mock.fake("PlaySoundFile", function(path: string)
        played[#played + 1] = path
        return true
    end)
    mock.slash("/suu pull 12")
    expect(M.pullEnds ~= nil).toBe(true)
    expect(shown.pull).toBe("Pull in 12")
    expect(labels()).toBe("Pull")
    mock.advanceTime(5.1)
    expect(shown.pull).toBe("Pull in 7")
    -- 10, 9, 8 and 7 spoken
    expect(#played).toBe(4)
    expect(played[1]:find("Bella\\10.ogg", 1, true) ~= nil).toBe(true)
    mock.advanceTime(7)
    expect(shown.pull).toBe("Pull!")
    expect(played[#played]:find("pull.ogg", 1, true) ~= nil).toBe(true)
    mock.advanceTime(2)
    expect(shown.pull).toBeNil()
    expect(M.pullEnds).toBeNil()
end

@test("the countdown's alert: the last ten seconds, or none (Blizzard's numbers then)")
local function alertModes()
    local shown = alerts()
    M:Set("pullAlert", "last10")
    M:StartPull(15)
    expect(shown.pull).toBeNil()
    mock.advanceTime(5.1)
    expect(shown.pull).toBe("Pull in 10")
    M:CancelPull()
    expect(shown.pull).toBeNil()
    M:Set("pullAlert", "off")
    expect(M.trackerOff).toBeNil()
    M:StartPull(3)
    mock.advanceTime(3.5)
    expect(shown.pull).toBeNil()
    M:Set("pullAlert", "all")
    expect(M.trackerOff).toBe(true)
end

@test("cancelled by /suu pull 0, by the game's cancel and by combat")
local function cancel()
    local shown = alerts()
    M:Pull(10)
    expect(shown.pull ~= nil).toBe(true)
    M:Pull(0)
    expect(shown.pull).toBeNil()
    expect(M.pullEnds).toBeNil()
    M:Pull(10)
    mock.fireEvent("CANCEL_PLAYER_COUNTDOWN", UnitGUID("player"), false)
    expect(M.pullEnds).toBeNil()
    M:Pull(10)
    mock.player:enterCombat()
    mock.advanceFrames(1)
    expect(M.pullEnds).toBeNil()
end

@test(
    "someone else's countdown, or their SuuUI message: from them; the same countdown twice kept; secret or in combat ignored"
)
local function fromOthers()
    local shown = alerts()
    mock.group:add(friend)
    mock.fireEvent("START_PLAYER_COUNTDOWN", UnitGUID("party1"), 8, 8, false)
    expect(shown.pull).toBe("Pull in 8 · from Brannoc Ironhand")
    local ends = M.pullEnds
    mock.fireEvent("START_PLAYER_COUNTDOWN", UnitGUID("party1"), 8, 8, false)
    expect(M.pullEnds).toBe(ends)
    M:CancelPull()
    M:OnCountdown(mock.secret("x"), 8)
    expect(M.pullEnds).toBeNil()
    addonMessage("SuuUI", "PULL\t9", "Brannoc Ironhand-Realm")
    expect(shown.pull).toBe("Pull in 9 · from Brannoc Ironhand")
    M:CancelPull()
    -- not ours, our own echo, nonsense: nothing
    addonMessage("Other", "PULL\t9", "Brannoc Ironhand-Realm")
    addonMessage("SuuUI", "HELLO", "Brannoc Ironhand-Realm")
    addonMessage("SuuUI", "PULL\t9", tostring(GetUnitName("player", true)))
    expect(M.pullEnds).toBeNil()
    mock.player:enterCombat()
    mock.advanceFrames(1)
    M:OnCountdown(UnitGUID("party1"), 8)
    expect(M.pullEnds).toBeNil()
end

@test("without the game's countdown: SuuUI's own message to the group; the game's countdown silent: SuuUI's anyway")
local function fallback()
    mock.group:add(friend)
    mock.setField(C_PartyInfo, "DoCountdown", nil)
    local sent: { string } = {}
    mock.stub(C_ChatInfo, "SendAddonMessage", function(prefix: string, text: string, channel: string)
        sent[#sent + 1] = prefix .. " " .. text .. " " .. channel
        return true
    end)
    M:Pull(6)
    expect(sent[1]).toBe("SuuUI PULL\t6 PARTY")
    expect(M.pullEnds ~= nil).toBe(true)
    M:CancelPull()
    -- a countdown that never comes back
    mock.setField(C_PartyInfo, "DoCountdown", function(_: number)
        return true
    end)
    M:Pull(6)
    expect(M.pullEnds).toBeNil()
    mock.advanceTime(0.6)
    expect(M.pullEnds ~= nil).toBe(true)
end

@test("the voice: off, or quiet while a boss mod feeds the timeline; Hear the voice")
local function voice()
    local played: { string } = {}
    mock.fake("PlaySoundFile", function(path: string)
        played[#played + 1] = path
        return true
    end)
    M:Set("pullVoice", "off")
    M:StartPull(3)
    mock.advanceTime(3.5)
    expect(#played).toBe(0)
    M:Speak(3, "Heart")
    M:Speak(11, "Heart")
    expect(#played).toBe(1)
    M:Set("pullVoice", "Michael")
    local rows = rowsBy("text")
    assert(assert(rows["Hear the voice"]).onClick)()
    mock.advanceTime(4)
    expect(#played).toBe(5)
    M:Set("pullVoice", "off")
    expect((assert(assert(rows["Hear the voice"]).disabled)())).toBe(true)
    assert(assert(rows["Start a pull countdown"]).onClick)()
    assert(assert(rows["Show a test timeline"]).onClick)()
end

@test(
    "DBM as the source: its timers on the timeline (paused, updated, stopped), its bars and warnings hidden and given back"
)
local function dbm()
    local callbacks: { [string]: Callback } = {}
    local function fire(event: string, ...: unknown)
        assert(callbacks[event])(...)
    end
    local dbmBars: Bar[] = {}
    local options = { HideDBMWarnings = false }
    local bars = {
        CreateBar = function(_: unknown): Bar
            local bar = { frame = CreateFrame("Frame") }
            dbmBars[#dbmBars + 1] = bar
            return bar
        end,
    }
    mock.setField(_G, "DBM", {
        Options = options,
        RegisterCallback = function(_: unknown, event: string, fn: Callback)
            callbacks[event] = fn
        end,
    })
    mock.setField(_G, "DBT", bars)
    M.hooked, M.hookedParts = nil, {}
    M:HookSources()
    M:HookDisplays()
    expect(#M:SourceOptions()).toBe(2)
    M:Set("source", "dbm")
    expect(options.HideDBMWarnings).toBe(true)
    expect(M:CharData().dbmWarningsWas).toBe("false")
    fire("DBM_TimerBegin", nil, "t1", "Lava Burst", 12, 135813, nil, nil, 4)
    fire("DBM_TimerBegin", nil, "t2", "Pull in", 10, nil)
    expect(labels()).toBe("Lava Burst")
    expect(badgeText(1)).toBe("Kick")
    fire("DBM_TimerPause", nil, "t1")
    expect(assert(tl().events)[1].paused ~= nil).toBe(true)
    fire("DBM_TimerResume", nil, "t1")
    fire("DBM_TimerUpdate", nil, "t1", 2, 12)
    expect(assert(tl().events)[1].endsAt ~= nil).toBe(true)
    fire("DBM_TimerStop", nil, "t1")
    expect(labels()).toBe("")
    -- its bars kept see-through
    local bar = (bars.CreateBar :: (self: unknown) -> Bar)(bars)
    expect(bar.frame:GetAlpha()).toBe(0)
    bar.frame:SetAlpha(1)
    expect(bar.frame:GetAlpha()).toBe(0)
    -- its own warnings back
    M:Set("hideTheirs", false)
    expect(options.HideDBMWarnings).toBe(false)
    M:Set("source", "suui")
    M.hooked = nil
end

@test("BigWigs as the source: its bars' timers, stop all; its own bars hidden, another addon's not")
local function bigwigs()
    local messages: { [string]: Callback } = {}
    local function send(msg: string, ...: unknown)
        assert(messages[msg])(...)
    end
    mock.setField(_G, "BigWigsLoader", {
        RegisterMessage = function(_: unknown, msg: string, fn: Callback)
            messages[msg] = fn
        end,
    })
    local proto = {
        Start = function(_: unknown) end,
        Get = function(bar: CandyBar, key: string): unknown
            return bar.data[key]
        end,
    }
    mock.provideLibrary("LibCandyBar-3.0", { barPrototype = proto })
    M.hooked, M.hookedParts = nil, {}
    M:HookSources()
    M:HookDisplays()
    M:Set("source", "bigwigs")
    local mod = {}
    send("BigWigs_StartBar", nil, mod, nil, "Magma Blast", 15, 135820)
    send("BigWigs_StartBar", nil, mod, nil, "Breath", 20, nil)
    expect(labels(true)).toBe("Breath, Magma Blast")
    send("BigWigs_PauseBar", nil, mod, "Breath")
    send("BigWigs_ResumeBar", nil, mod, "Breath")
    send("BigWigs_StopBar", nil, mod, "Magma Blast")
    expect(labels()).toBe("Breath")
    send("BigWigs_StopBars", nil)
    expect(labels()).toBe("")
    -- (LibCandyBar's bars: frames with its prototype's methods)
    local ours, theirs = CreateFrame("Frame"), CreateFrame("Frame")
    mock.setField(ours, "Get", proto.Get)
    mock.setField(ours, "data", { ["bigwigs:module"] = mod })
    mock.setField(theirs, "Get", proto.Get)
    mock.setField(theirs, "data", {})
    local start = tbl.field(proto, "Start")
    assert(type(start) == "function")
    ;(start :: (bar: Frame) -> ())(ours)
    ;(start :: (bar: Frame) -> ())(theirs)
    expect(ours:GetAlpha()).toBe(0)
    expect(theirs:GetAlpha()).toBe(1)
    M:Set("source", "suui")
    M.hooked = nil
end

@test("the preview: the test's abilities, held; the list")
local function preview()
    local parent = CreateFrame("Frame", nil, UIParent)
    local p = M:PreviewView(parent)
    expect(p:GetParent()).toBe(parent)
    expect(#assert(p.events)).toBe(5)
    M:Set("variant", "list")
    expect(p.variant).toBe("list")
end

@test("the settings rows: the boss mods not installed named; Hide their bars waits for one")
local function rowsWait()
    local rows = rowsBy("key")
    local describe = assert(rows.source).description
    assert(type(describe) == "function")
    expect(((describe :: () -> string)()):find("Install DBM or BigWigs", 1, true) ~= nil).toBe(true)
    local off, why = assert(assert(rows.hideTheirs).disabled)()
    expect(off).toBe(true)
    expect(why).toBe("Choose DBM or BigWigs first.")
end

@test("the old voices and Last 5 seconds carried over")
local function migrations()
    local found = 0
    for _, m in ipairs(settingMigrations()) do
        if m.namespace == "timeline" and m.id == "pullVoice-kokoro-3" then
            found = found + 1
            for old, new in pairs({ David = "Michael", Jim = "Bella", Heart = "Heart" }) do
                local v: { [string]: unknown } = { pullVoice = old }
                m.fn(v)
                expect(v.pullVoice).toBe(new)
            end
        elseif m.namespace == "timeline" and m.id == "pullAlert-last10" then
            found = found + 1
            local v: { [string]: unknown } = { pullAlert = "last5" }
            m.fn(v)
            expect(v.pullAlert).toBe("last10")
        end
    end
    expect(found).toBe(2)
end

-- (last: the module off)
@test("stopped: the timeline gone, the countdown cancelled, Blizzard's numbers back")
local function disabled()
    M:StartPull(10)
    assert(M.OnDisable)(M)
    expect(M.pullEnds).toBeNil()
    expect(tl():IsShown()).toBe(false)
    expect(M.trackerOff).toBeNil()
end

@test("turned off and on through the registry with DBM's warnings hidden: given back while off, hidden again when on")
local function dbmWarningsAcrossToggle()
    local options = { HideDBMWarnings = false }
    mock.setField(_G, "DBM", { Options = options, RegisterCallback = function() end })
    M:Set("source", "dbm")
    expect(options.HideDBMWarnings).toBe(true)
    expect(M:CharData().dbmWarningsWas).toBe("false")
    settings.set("timeline", "enabled", false)
    expect(options.HideDBMWarnings).toBe(false)
    expect(M:CharData().dbmWarningsWas).toBeNil()
    -- on again (as at every login): hidden again, the player's value kept
    settings.set("timeline", "enabled", true)
    expect(M:IsEnabled()).toBe(true)
    expect(options.HideDBMWarnings).toBe(true)
    expect(M:CharData().dbmWarningsWas).toBe("false")
    M:Set("source", "suui")
    expect(options.HideDBMWarnings).toBe(false)
    expectNoErrors()
end

@test("DBM's warnings across a profile switch: given back in a profile that doesn't hide them, hidden again on the way back")
local function dbmWarningsAcrossProfiles()
    local options = { HideDBMWarnings = false }
    mock.setField(_G, "DBM", { Options = options, RegisterCallback = function() end })
    -- (a profile with SuuUI as the source, made first)
    local was = settings.profiles.current()
    settings.profiles.create("ZZ Timeline")
    M:Set("source", "dbm")
    expect(options.HideDBMWarnings).toBe(true)
    settings.profiles.use("ZZ Timeline")
    expect(M:Get("source")).toBe("suui")
    expect(options.HideDBMWarnings).toBe(false)
    expect(M:CharData().dbmWarningsWas).toBeNil()
    -- the player's own value, changed meanwhile, is what's kept next time
    options.HideDBMWarnings = true
    settings.profiles.use(was)
    expect(options.HideDBMWarnings).toBe(true)
    expect(M:CharData().dbmWarningsWas).toBe("true")
    options.HideDBMWarnings = true
    M:Set("source", "suui")
    expect(options.HideDBMWarnings).toBe(true)
    settings.profiles.delete("ZZ Timeline")
    expectNoErrors()
end

@test("DBM's warnings at logout: the player's own value saved, hidden again at the next login; a profile's old value moved")
local function dbmWarningsAtLogout()
    local options = { HideDBMWarnings = false }
    mock.setField(_G, "DBM", { Options = options, RegisterCallback = function() end })
    M:Set("source", "dbm")
    expect(options.HideDBMWarnings).toBe(true)
    mock.fireEvent("PLAYER_LOGOUT")
    expect(options.HideDBMWarnings).toBe(false)
    expect(M:CharData().dbmWarningsWas).toBe("false")
    -- the next login
    settings.set("timeline", "enabled", false)
    options.HideDBMWarnings = true
    M:CharData().dbmWarningsWas = nil
    -- (what 0.46 left in the profile: the player's value "false")
    M:Set("dbmWarningsWas", "false")
    settings.set("timeline", "enabled", true)
    expect(M:Get("dbmWarningsWas")).toBe("")
    expect(M:CharData().dbmWarningsWas).toBe("false")
    expect(options.HideDBMWarnings).toBe(true)
    M:Set("source", "suui")
    expect(options.HideDBMWarnings).toBe(false)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The pull countdown from other players' SuuUI (GRP-21, TEST-10)
--------------------------------------------------------------------------------

-- Placeholder group members, made once.
local member1 = mock.spawnUnit({ name = "Member1", player = true, class = "MAGE", level = 30, reaction = "friendly" })
local member2 = mock.spawnUnit({ name = "Member2", player = true, class = "PRIEST", level = 30, reaction = "friendly" })

@test("PULL as an older SuuUI sends it: from someone in your party, by its exact text")
local function pullWire()
    local shown = alerts()
    mock.group:add(member1)
    mock.receiveAddonMessage("SuuUI", "PULL\t10", "PARTY", "Member1-Realm")
    expect(shown.pull).toBe("Pull in 10 · from Member1")
    -- 0 cancels, a negative number too (an old SuuUI sends what was typed)
    mock.advanceTime(2.1)
    mock.receiveAddonMessage("SuuUI", "PULL\t0", "PARTY", "Member1-Realm")
    expect(M.pullEnds).toBeNil()
    M:StartPull(10)
    mock.advanceTime(2.1)
    mock.receiveAddonMessage("SuuUI", "PULL\t-5", "PARTY", "Member1-Realm")
    expect(M.pullEnds).toBeNil()
    -- more than a minute: held to one
    mock.advanceTime(2.1)
    mock.receiveAddonMessage("SuuUI", "PULL\t90", "PARTY", "Member1-Realm")
    expect(math.floor(assert(M.pullEnds) - GetTime() + 0.5)).toBe(60)
end

@test("PULL refused: a whisper, a stranger, a raid member who neither leads nor assists, nonsense, combat")
local function pullRefused()
    local shown = alerts()
    -- a whisper from anyone on the realm
    mock.receiveAddonMessage("SuuUI", "PULL\t10", "WHISPER", "Stranger-Realm")
    expect(M.pullEnds).toBeNil()
    -- someone the group doesn't hold, on the party's channel
    mock.group:add(member1)
    mock.receiveAddonMessage("SuuUI", "PULL\t10", "PARTY", "Stranger-Realm")
    expect(M.pullEnds).toBeNil()
    -- nonsense and numbers out of range
    for _, text in ipairs({ "PULL\t99999999", "PULL\t1e3", "PULL\t", "PULL\t5.5", "PULL\tten", "PULL" }) do
        mock.receiveAddonMessage("SuuUI", text, "PARTY", "Member1-Realm")
    end
    expect(M.pullEnds).toBeNil()
    -- in a raid: the leader's only (you lead it; Member2 doesn't)
    mock.group:add(member2, true)
    mock.receiveAddonMessage("SuuUI", "PULL\t10", "RAID", "Member2-Realm")
    expect(M.pullEnds).toBeNil()
    for i = 1, 3 do
        local n = UnitName("raid" .. i)
        if not issecretvalue(n) and n == "Member2" then
            C_PartyInfo.PromoteToLeader("raid" .. i)
        end
    end
    mock.advanceTime(1)
    local leader = "Member2-Realm"
    mock.receiveAddonMessage("SuuUI", "PULL\t10", "RAID", leader)
    expect(M.pullEnds ~= nil).toBe(true)
    M:CancelPull()
    -- in combat: ignored, as the game's own countdown
    mock.player:enterCombat()
    mock.advanceTime(2.1)
    mock.receiveAddonMessage("SuuUI", "PULL\t10", "RAID", leader)
    expect(M.pullEnds).toBeNil()
    expect(shown.pull).toBeNil()
end

@test("PULL flooded: one sender's starts held to two in two seconds")
local function pullFlood()
    local starts = 0
    local start = M.StartPull
    mock.stub(M, "StartPull", function(self: unknown, given: unknown, from: string?)
        starts += 1
        start(M, given, from)
    end)
    mock.group:add(member1)
    for _ = 1, 50 do
        mock.receiveAddonMessage("SuuUI", "PULL\t10", "PARTY", "Member1-Realm")
    end
    expect(starts).toBe(2)
    mock.advanceTime(2.1)
    mock.receiveAddonMessage("SuuUI", "PULL\t10", "PARTY", "Member1-Realm")
    expect(starts).toBe(3)
    expectNoErrors()
end

@test("PULL sent as an older SuuUI reads it: to the group's channel, nothing out of a group or in a fight")
local function pullSent()
    mock.setField(C_PartyInfo, "DoCountdown", nil)
    local function pulls(): string[]
        local out: string[] = {}
        for _, m in ipairs(mock.sentAddonMessages()) do
            if m.message:sub(1, 4) == "PULL" then
                out[#out + 1] = m.message .. " " .. m.chatType
            end
        end
        return out
    end
    local before = #pulls()
    M:Pull(8)
    expect(#pulls()).toBe(before)
    M:CancelPull()
    mock.group:add(member1)
    M:Pull(8)
    local sent = pulls()
    expect(sent[#sent]).toBe("PULL\t8 PARTY")
    M:CancelPull()
end

@test("turned off: a boss mod's timer doesn't bring the timeline back, and its anchor is gone")
local function offStaysOff()
    local callbacks: { [string]: Callback } = {}
    mock.setField(_G, "DBM", {
        Options = {},
        RegisterCallback = function(_: unknown, event: string, fn: Callback)
            callbacks[event] = fn
        end,
    })
    M.hooked = nil
    M:HookSources()
    M:Set("source", "dbm")
    expect(SuuUI.GetAnchor("encounterTimeline")).toBe(M.timeline)
    settings.set("timeline", "enabled", false)
    expect(SuuUI.GetAnchor("encounterTimeline")).toBeNil()
    expect(comm.count(M)).toBe(0)
    assert(callbacks.DBM_TimerBegin)(nil, "t1", "Lava Burst", 12, 135813)
    assert(callbacks.DBM_TimerUpdate)(nil, "t1", 2, 12)
    expect(tl():IsShown()).toBe(false)
    expect(next(M.addonTimers)).toBeNil()
    -- nor a pull from the group
    mock.group:add(member1)
    mock.receiveAddonMessage("SuuUI", "PULL\t10", "PARTY", "Member1-Realm")
    expect(M.pullEnds).toBeNil()
    settings.set("timeline", "enabled", true)
    expect(SuuUI.GetAnchor("encounterTimeline")).toBe(M.timeline)
    assert(callbacks.DBM_TimerBegin)(nil, "t2", "Lava Burst", 12, 135813)
    expect(tl():IsShown()).toBe(true)
    M:Set("source", "suui")
    M.hooked = nil
    expectNoErrors()
end

@test("off and on through the registry: nothing left behind (its addon message handler too), nothing doubled")
local function leavesNothing()
    local handlers = comm.count(M)
    expect(handlers).toBe(1)
    -- (a refresh timer an earlier test left goes with a first cycle)
    cycle("timeline")
    local c = cycle("timeline")
    expect(c.off).toEqual(NOTHING)
    expect(c.after).toEqual(c.before)
    expect(comm.count(M)).toBe(handlers)
    -- a countdown under way: its timers go with the module
    M:StartPull(10)
    settings.set("timeline", "enabled", false)
    expect(M.pullEnds).toBeNil()
    expect(holdings(M)).toEqual(NOTHING)
    settings.set("timeline", "enabled", true)
    expectNoErrors()
end
