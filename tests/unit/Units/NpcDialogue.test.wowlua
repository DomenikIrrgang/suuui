-- a quest AutoQuests accepts as its page opens
local scout = mock.spawnUnit({ name = "Scout Alder", level = 30, reaction = "friendly", distance = 3 })
local SCOUTED = 9103
mock.defineQuest(SCOUTED, {
    title = "Tracks in the Snow",
    text = "Follow the tracks, $N.",
    objective = "Follow the tracks.",
    giver = scout,
    level = 5,
})

local talker = mock.spawnUnit({ name = "Innkeeper Morwen", level = 30, reaction = "friendly", distance = 3 })
mock.defineGossip(talker, {
    text = "Welcome to the inn, traveller.",
    options = {
        { name = "Make this inn your home.", icon = 132052, gossipOptionID = 1 },
        { name = "What can I buy here?", icon = 132060, gossipOptionID = 2 },
        { name = "Tell me a story.", icon = 999999, gossipOptionID = 3 },
    },
})

local function settle()
    mock.advanceTime(0.5)
    mock.advanceFrames(3)
end

local function talkTo(npc: mock.MockUnit)
    mock.player:interact(npc)
    settle()
end

-- The answer pills shown, by label.
local function pill(label: string): AnswerPill
    for _, b in ipairs(M.pills) do
        if b:IsShown() and b.label == label then
            return b
        end
    end
    error("no pill " .. label)
end

local function labels(): string[]
    local out: string[] = {}
    for _, a in ipairs(M.answerList) do
        out[#out + 1] = a.label or ""
    end
    return out
end

-- (the dialogue itself: nothing accepted or turned in for you)
@beforeEach
local function manual()
    AutoQuests:Set("accept", false)
    AutoQuests:Set("turnIn", false)
end

@afterEach
local function cleanup()
    AutoQuests:Reset("accept")
    AutoQuests:Reset("turnIn")
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    if scene().root:IsShown() then
        M:Leave()
    end
    mock.setModifiers({})
    M:Reset("hideUI")
    mock.advanceTime(1)
    mock.advanceFrames(2)
    local id = C_QuestLog.GetLogIndexForQuestID(OFFERED)
    if id then
        C_QuestLog.SetSelectedQuest(OFFERED)
        C_QuestLog.SetAbandonQuest()
        C_QuestLog.AbandonQuest()
        settle()
    end
    expectNoErrors()
end

@test("a quest offered: its title and level, the line typing in, what they ask, the rewards, Accept and Decline")
local function offered()
    talkTo(offer)
    expect(M:View()).toBe("detail")
    expect(scene().root).toBeShown()
    expect(scene().qhead.title:GetText()).toBe("Wolves Across the Border")
    expect(scene().plate.name:GetText()).toBe("Quartermaster Hale")
    -- the line types in; Space shows it all
    expect(assert(M.fullText):find("Kill wolves", 1, true)).toBe(1)
    M.shown = 0
    M.typed = 0
    M:ShowTyped()
    expect(scene().speech.skip).toBeShown()
    mock.advanceFrames(5)
    expect(M.shown > 0).toBe(true)
    expect(M:Key("SPACE")).toBe(true)
    expect(scene().speech.text:GetText() :: unknown).toBe(M.fullText)
    expect(scene().speech.skip).never.toBeShown()
    expect(M:Key("SPACE")).toBe(false)
    expect(scene().ask.text:GetText()).toBe("Kill 5 wolves.")
    -- the rewards: two to choose from (one may be chosen), one anyway, money and experience
    expect(scene().cards.caption:GetText()).toBe("You may choose one")
    expect(scene().cards.list[1].name:GetText()).toBe("Militia Shortsword")
    expect(scene().cards.list[3].name:GetText()).toBe("Worn Cap")
    expect(scene().cards.money).toBeShown()
    expect(scene().cards.xp:GetText()).toBe("450 XP")
    expect(labels()).toEqual({ "Accept", "Decline" })
    -- the choice that sells for the most: a gold coin on its icon, nothing
    -- written (it replaced the "Upgrade" mark: asked 2026-11-12)
    local cards = M:Rewards(false)
    expect(cards[1].mostGold).toBeNil()
    expect(cards[2].mostGold).toBe(true)
    expect(cards[3].mostGold).toBeNil()
    expect(scene().cards.list[2].coin).toBeShown()
    expect(scene().cards.list[1].coin).never.toBeShown()
    expect(scene().cards.list[3].coin).never.toBeShown()
    expect(scene().cards.list[1].right:GetText()).toBe("")
    -- a card clicked: its link to the chat, the game's way
    local handled = mock.spy(function(_: string) end)
    mock.stub(_G, "HandleModifiedItemClick", handled)
    scene().cards.list[3]:Click()
    expect(handled).toHaveBeenCalled()
    -- Enter accepts
    expect(M:Key("ENTER")).toBe(true)
    settle()
    expect(C_QuestLog.GetLogIndexForQuestID(OFFERED) ~= nil).toBe(true)
    expect(scene().root).never.toBeShown()
end

@test("a quest declined: the scene ends")
local function declined()
    talkTo(offer)
    pill("Decline"):Click()
    settle()
    expect(scene().root).never.toBeShown()
    expect(C_QuestLog.GetLogIndexForQuestID(OFFERED)).toBeNil()
end

@test("gossip: the options with their glyphs, Goodbye last; an option chosen; Goodbye leaves")
local function gossip()
    talkTo(talker)
    expect(M:View()).toBe("gossip")
    expect(M.fullText).toBe("Welcome to the inn, traveller.")
    local l = labels()
    expect(l[#l]).toBe("Goodbye")
    expect(#l).toBe(4)
    -- the inn's glyph is SuuUI's; an unknown icon its own
    expect(M.answerList[1].glyph).toBe("inn")
    expect(M.answerList[3].glyph).toBe(999999)
    -- a number answers; Esc's pill isn't a number's
    expect(M:Key("4")).toBe(false)
    expect(M:Key("1")).toBe(true)
    settle()
    talkTo(talker)
    pill("Goodbye"):Click()
    settle()
    expect(scene().root).never.toBeShown()
    expect(gossipFrame():IsShown()).toBe(false)
end

@test("gossip's quests: one to take, one to hand in (ready), daily and repeatable tagged")
local function gossipQuests()
    talkTo(talker)
    mock.stub(C_GossipInfo, "GetAvailableQuests", function(): unknown
        return {
            { questID = 1, title = "A Daily Errand", frequency = 1 },
            { questID = 2, title = "Again and Again", repeatable = true },
            { questID = 3, title = "Easy Work", isTrivial = true },
        }
    end)
    mock.stub(C_GossipInfo, "GetActiveQuests", function(): unknown
        return {
            { questID = 4, title = "Bring the Pelts", isComplete = true },
            { questID = 5, title = "Still Hunting" },
        }
    end)
    local selected = mock.spy(function(_: number) end)
    mock.stub(C_GossipInfo, "SelectAvailableQuest", selected)
    local active = mock.spy(function(_: number) end)
    mock.stub(C_GossipInfo, "SelectActiveQuest", active)
    M:Draw()
    expect(labels()).toEqual({
        "Make this inn your home.",
        "What can I buy here?",
        "Tell me a story.",
        "Bring the Pelts",
        "Still Hunting",
        "A Daily Errand",
        "Again and Again",
        "Easy Work",
        "Goodbye",
    })
    expect(assert(M.answerList[4].tag).text).toBe("Ready")
    expect(assert(M.answerList[6].tag).text).toBe("Daily")
    expect(assert(M.answerList[7].tag).text).toBe("Repeatable")
    assert(M.answerList[4].act)()
    expect(active).toHaveBeenCalledWith(4)
    assert(M.answerList[6].act)()
    expect(selected).toHaveBeenCalledWith(1)
end

@test("handing in: what's asked for and how many you have, not done yet; done, the reward to choose, completed")
local function handIn()
    talkTo(offer)
    AcceptQuest()
    settle()
    -- back with nothing: what's asked for
    talkTo(offer)
    expect(M:View()).toBe("progress")
    expect(M.fullText).toBe("Are the wolves gone?")
    expect(scene().cards.list[1].right:GetText()).toBe("0 / 2")
    local a = M.answerList[1]
    expect(a.label).toBe("Hand them over")
    expect(assert(a.off):find("You need 2 more", 1, true)).toBe(1)
    -- a pill that's off: its reason as the tooltip, nothing on a click
    local b = pill("Hand them over")
    mock.script(b, "OnEnter")
    b:Click()
    mock.script(b, "OnLeave")
    expect(M:View()).toBe("progress")
    pill("I'll be back"):Click()
    settle()
    -- the pelts looted from a wolf: back, done
    local wolf = mock.spawnUnit({ name = "Prowler", level = 1, reaction = "hostile", distance = 3 })
    mock.player:swing(wolf, 99999, { kill = { xp = 0, loot = { { id = PELT, count = 2 } } } })
    settle()
    mock.player:loot(wolf, { auto = true })
    mock.advanceTime(2)
    mock.advanceFrames(3)
    talkTo(offer)
    expect(scene().cards.list[1].right:GetText()).toBe("2 / 2")
    expect(M.answerList[1].off).toBeNil()
    M:Key("ENTER")
    settle()
    expect(M:View()).toBe("reward")
    expect(scene().cards.caption:GetText()).toBe("Choose your reward")
    expect(M.answerList[1].off).toBe("Choose a reward first")
    -- a choice: lit, the button free
    scene().cards.list[2]:Click()
    expect(M.chosen).toBe(2)
    expect(scene().cards.list[2].on).toBe(true)
    expect(M.answerList[1].off).toBeNil()
    -- a card's tooltip: the quest item's
    local card = scene().cards.list[1]
    mock.script(card, "OnEnter")
    mock.script(card, "OnLeave")
    pill("Complete quest"):Click()
    mock.advanceTime(3)
    mock.advanceFrames(3)
    expect(scene().root).never.toBeShown()
    expect(C_QuestLog.GetLogIndexForQuestID(OFFERED)).toBeNil()
end

@test("rewards that all sell for the same: no gold coin on any")
local function evenRewards()
    talkTo(even)
    expect(M:View()).toBe("detail")
    local cards = M:Rewards(false)
    expect(cards[1].mostGold).toBeNil()
    expect(cards[2].mostGold).toBeNil()
    expect(scene().cards.list[1].coin).never.toBeShown()
    expect(scene().cards.list[2].coin).never.toBeShown()
end

@test("the keys: a modifier held leaves them to the game; numbers answer; others pass")
local function keys()
    talkTo(talker)
    mock.setModifiers({ shift = true })
    expect(M:Key("1")).toBe(false)
    mock.setModifiers({})
    expect(M:Key("Q")).toBe(false)
    expect(M:Key("ENTER")).toBe(false)
    -- the bar's own key handler: the game gets what isn't handled
    mock.script(scene().bar, "OnKeyDown", "Q")
    -- in combat the keys are the game's
    mock.player:enterCombat()
    mock.script(scene().bar, "OnKeyDown", "1")
    expect(M:View()).toBe("gossip")
    mock.player:leaveCombat()
end

-- (UI.Dismissable's rules) The bar takes the keyboard only out of a fight, every
-- key passing on at rest; a key it answers is kept for that key only; a fight
-- lets the keyboard go before the lockdown.
@test("the bar's keyboard: keys pass on at rest, an answer kept for one key; a fight lets go, its end takes it back")
local function barKeyboard()
    talkTo(talker)
    local bar = scene().bar
    expect(bar:IsKeyboardEnabled()).toBe(true)
    expect(bar:GetPropagateKeyboardInput()).toBe(true)
    mock.script(bar, "OnKeyDown", "Q")
    expect(bar:GetPropagateKeyboardInput()).toBe(true)
    mock.script(bar, "OnKeyDown", "SPACE")
    expect(bar:GetPropagateKeyboardInput()).toBe(false)
    mock.advanceFrames(1)
    expect(bar:GetPropagateKeyboardInput()).toBe(true)
    mock.player:enterCombat()
    expect(bar:IsKeyboardEnabled()).toBe(false)
    expect(bar:GetPropagateKeyboardInput()).toBe(true)
    -- nothing taken while the fight lasts
    M:ArmKeys()
    expect(bar:IsKeyboardEnabled()).toBe(false)
    mock.player:leaveCombat()
    expect(bar:IsKeyboardEnabled()).toBe(true)
    expect(bar:GetPropagateKeyboardInput()).toBe(true)
    expect(#mock.refusals()).toBe(0)
    expectNoErrors()
end

@test("the speaker: their name and role, friend or foe; the portrait kept for the same speaker")
local function speaker()
    talkTo(talker)
    expect(scene().plate.name:GetText()).toBe("Innkeeper Morwen")
    local guid = M.speakerGUID
    M:DrawSpeaker()
    expect(M.speakerGUID).toBe(guid)
    mock.stub(C_TooltipInfo, "GetUnit", function(_: string): unknown
        return { lines = { { leftText = "Innkeeper Morwen" }, { leftText = "Innkeeper" } } }
    end)
    M:DrawSpeaker()
    expect(scene().plate.role:GetText()).toBe("Innkeeper")
    mock.stub(C_TooltipInfo, "GetUnit", function(_: string): unknown
        return { lines = { { leftText = "Innkeeper Morwen" }, { leftText = "Level 30" } } }
    end)
    M:DrawSpeaker()
    expect(scene().plate.role:GetText()).toBe("")
end

@test(
    "the rest of the UI fades out while you talk, the minimap hidden, and back after; at once in a fight; off by the setting"
)
local function hideUI()
    Minimap:Show()
    talkTo(talker)
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(0)
    expect(scene().root:GetEffectiveAlpha()).toBe(1)
    -- (its own drawing doesn't take the alpha: hidden, seen in game)
    expect(Minimap).never.toBeShown()
    mock.player:enterCombat()
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(1)
    expect(Minimap).toBeShown()
    mock.player:leaveCombat()
    M:Leave()
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(1)
    -- off: the bar over the action bars, the UI stays
    M:Set("hideUI", false)
    talkTo(talker)
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(1)
    expect(Minimap).toBeShown()
    local _, _, _, _, y = scene().bar:GetPoint(1)
    expect(y).toBe(28)
    M:Set("hideUI", true)
end

@test("the game's frames out of sight however they're placed")
local function away()
    talkTo(talker)
    local g = gossipFrame()
    g:ClearAllPoints()
    g:SetPoint("CENTER")
    g:SetAlpha(1)
    mock.advanceFrames(2)
    expect(g:GetAlpha()).toBe(0)
    local _, rel = g:GetPoint(1)
    expect(rel).toBe(UIParent)
end

@test("a greeting: their quests to hand in and to take, Goodbye")
local function greeting()
    mock.stub(_G, "GetGreetingText", function(): string
        return "Greetings, $N."
    end)
    mock.stub(_G, "GetNumActiveQuests", function(): number
        return 1
    end)
    mock.stub(_G, "GetActiveTitle", function(_: number): (string, boolean)
        return "Bring the Pelts", true
    end)
    mock.stub(_G, "GetNumAvailableQuests", function(): number
        return 2
    end)
    mock.stub(_G, "GetAvailableQuestInfo", function(i: number): (boolean, number, boolean)
        return i == 2, i == 1 and 1 or 0, false
    end)
    mock.stub(_G, "GetAvailableTitle", function(i: number): string
        return i == 1 and "A Daily Errand" or "Easy Work"
    end)
    local active = mock.spy(function(_: number) end)
    mock.stub(_G, "SelectActiveQuest", active)
    local available = mock.spy(function(_: number) end)
    mock.stub(_G, "SelectAvailableQuest", available)
    local c = M:Content("greeting")
    expect(c.text).toBe("Greetings, $N.")
    expect(#c.answers).toBe(4)
    expect(assert(c.answers[1].tag).text).toBe("Ready")
    expect(assert(c.answers[2].tag).text).toBe("Daily")
    assert(c.answers[1].act)()
    expect(active).toHaveBeenCalledWith(1)
    assert(c.answers[3].act)()
    expect(available).toHaveBeenCalledWith(2)
end

@test("a long line scrolls, its foot fading; a theme change draws it again")
local function longLine()
    talkTo(talker)
    M.fullText = nil
    mock.stub(C_GossipInfo, "GetText", function(): string
        return string.rep("A long story about the old days. ", 60)
    end)
    M:Draw()
    M:RevealAll()
    expect(scene().speech.fade).toBeShown()
    scene().speech.scroll:SetVerticalScroll(10000)
    M:DrawFade()
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    mock.advanceFrames(2)
    mock.fireEvent("QUEST_ITEM_UPDATE")
    mock.advanceFrames(2)
end

@test("text typed in whole characters: colour codes and textures at once")
local function typedWhole()
    talkTo(talker)
    M.fullText = nil
    mock.stub(C_GossipInfo, "GetText", function(): string
        return "Ä |cffff0000red|r |TInterface\\Icons\\Temp:0|t end"
    end)
    M:Draw()
    M.shown, M.typed = 0, 0
    M:Type(0.02)
    expect(scene().speech.text:GetText()).toBe("Ä")
    M:Type(0.02)
    M:Type(0.02)
    expect(mock.textOf(scene().speech.text):find("|cffff0000", 1, true) ~= nil).toBe(true)
end

--------------------------------------------------------------------------------
-- The alpha to return to (MAP-1): never read half-way through our own fade
--------------------------------------------------------------------------------

-- (a fade takes dur-base, 0.18 s; 40 frames end it, 3 frames are inside it)
local function fadeEnds()
    mock.advanceFrames(40)
end

-- The scene closes and the next step of the talk draws it again (as when
-- the game closes a quest's page and the NPC's list comes back): the UI
-- fades back, then out again.
local function closeScene()
    scene().root:Hide()
end
local function reopen()
    M:Draw()
end

@test("closed and opened again inside the fade back: the UI ends at full alpha after the second close")
local function reopenInFade()
    Minimap:Show()
    talkTo(talker)
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(0)
    closeScene()
    mock.advanceFrames(3)
    -- half-way back
    local mid = UIParent:GetAlpha()
    expect(mid > 0 and mid < 1).toBe(true)
    reopen()
    expect(scene().root).toBeShown()
    expect(M.uiAlpha).toBe(1)
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(0)
    M:Leave()
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(1)
    expect(Minimap).toBeShown()
end

@test("a hitch in the fade back (no frames past its time): the next talk still returns to full alpha")
local function hitch()
    Minimap:Show()
    M:HideUI(true)
    fadeEnds()
    M:HideUI(false)
    mock.advanceFrames(2)
    -- a second without a frame, then the next conversation
    mock.advanceTime(1)
    M:HideUI(true)
    expect(M.uiAlpha).toBe(1)
    fadeEnds()
    M:HideUI(false)
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(1)
end

@test("ten quick conversations, each inside the last one's fade: the UI back at full alpha")
local function quickCycles()
    Minimap:Show()
    for i = 1, 10 do
        M:HideUI(true)
        mock.advanceFrames(1 + i % 4)
        M:HideUI(false)
        mock.advanceFrames(1 + (i * 3) % 5)
    end
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(1)
    expect(M.uiAlpha).toBe(1)
    expect(Minimap).toBeShown()
end

@test("an alpha another module set before the talk is returned to exactly; read anew once the fade is over")
local function otherAlpha()
    UIParent:SetAlpha(0.8)
    talkTo(talker)
    fadeEnds()
    closeScene()
    mock.advanceFrames(3)
    reopen()
    fadeEnds()
    M:Leave()
    fadeEnds()
    expect(UIParent:GetAlpha()).toBeCloseTo(0.8)
    -- the fade over, someone sets another: the next talk returns to that one
    mock.advanceTime(1)
    UIParent:SetAlpha(0.6)
    talkTo(talker)
    fadeEnds()
    M:Leave()
    fadeEnds()
    expect(UIParent:GetAlpha()).toBeCloseTo(0.6)
    UIParent:SetAlpha(1)
end

@test("turned off, or a fight starting, half-way through either fade: the UI back at full alpha")
local function offMidFade()
    Minimap:Show()
    -- off half-way out
    talkTo(talker)
    closeScene()
    -- (frames, not advanceTime: the emulator runs no OnUpdate in that, so
    -- the fade wouldn't move while the clock does; the game has no such gap)
    fadeEnds()
    mock.advanceTime(1)
    reopen()
    mock.advanceFrames(3)
    M:OnDisable()
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(1)
    expect(Minimap).toBeShown()
    -- off half-way back, a talk opened meanwhile
    talkTo(talker)
    fadeEnds()
    M:Leave()
    mock.advanceFrames(3)
    M:HideUI(true)
    mock.advanceFrames(2)
    M:OnDisable()
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(1)
    -- a fight half-way out
    mock.advanceTime(1)
    talkTo(talker)
    closeScene()
    mock.advanceFrames(3)
    reopen()
    mock.advanceFrames(3)
    mock.player:enterCombat()
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(1)
    expect(Minimap).toBeShown()
    mock.player:leaveCombat()
end

@test("a quest accepted for you (AutoQuests) as the page opens: the UI at full alpha after")
local function autoAccepted()
    Minimap:Show()
    AutoQuests:Set("accept", true)
    mock.player:interact(scout)
    mock.advanceTime(2)
    mock.advanceFrames(3)
    expect(C_QuestLog.GetLogIndexForQuestID(SCOUTED) ~= nil).toBe(true)
    if scene().root:IsShown() then
        M:Leave()
    end
    fadeEnds()
    expect(UIParent:GetAlpha()).toBe(1)
    expect(Minimap).toBeShown()
    C_QuestLog.SetSelectedQuest(SCOUTED)
    C_QuestLog.SetAbandonQuest()
    C_QuestLog.AbandonQuest()
    settle()
end

--------------------------------------------------------------------------------
-- Steps AutoQuests answers itself: no scene, no fade, the minimap kept (MAP-20)
--------------------------------------------------------------------------------

-- An NPC offering three quests. The emulator gives a giver one quest at a
-- time and opens no quest from a gossip list, so the NPC's list is a
-- gossip whose SelectAvailableQuest answers as the game does, a round trip
-- later: the list closes and the quest's page opens (from a giver of its
-- own beside the NPC). Each quest taken leaves the list.
local board = mock.spawnUnit({ name = "Sergeant Brask", level = 30, reaction = "friendly", distance = 3 })
local BOARD = { 9104, 9105, 9106 }
local boardGivers: { [number]: mock.MockUnit } = {}
local boardList: { [string]: unknown }[] = {}
for i, id in ipairs(BOARD) do
    local g = mock.spawnUnit({ name = "Sergeant Brask", level = 30, reaction = "friendly", distance = 3 })
    boardGivers[id] = g
    mock.defineQuest(id, {
        title = "Patrol Duty " .. i,
        text = "Walk the wall, $N.",
        objective = "Walk the wall.",
        giver = g,
        level = 5,
    })
end
mock.defineGossip(board, { text = "Plenty of work on the wall.", options = {}, availableQuests = boardList })

local function boardOpen()
    for i = #boardList, 1, -1 do
        table.remove(boardList, i)
    end
    for i, id in ipairs(BOARD) do
        boardList[i] = { questID = id, title = "Patrol Duty " .. i }
    end
    mock.fake("C_GossipInfo.SelectAvailableQuest", function(id: number)
        C_Timer.After(0.3, function()
            for i, q in ipairs(boardList) do
                if q.questID == id then
                    table.remove(boardList, i)
                    break
                end
            end
            C_GossipInfo.CloseGossip()
            mock.player:interact(assert(boardGivers[id]))
        end)
    end)
end

local function abandon(id: number)
    if C_QuestLog.GetLogIndexForQuestID(id) then
        C_QuestLog.SetSelectedQuest(id)
        C_QuestLog.SetAbandonQuest()
        C_QuestLog.AbandonQuest()
        settle()
    end
end

-- What the player saw, frame by frame: the scene, the UI faded (any part
-- of the way), the minimap hidden.
type Seen = { scene: boolean, faded: boolean, minimap: boolean }
local function watch(count: number, seen: Seen?): Seen
    local s: Seen = seen or { scene = false, faded = false, minimap = false }
    for _ = 1, count do
        mock.advanceFrames(1)
        s.scene = s.scene or scene().root:IsShown()
        s.faded = s.faded or M.uiHidden or UIParent:GetAlpha() ~= 1
        s.minimap = s.minimap or not Minimap:IsShown()
    end
    return s
end

@test("three quests accepted for you from one NPC: no scene, the UI never faded, the minimap never hidden")
local function autoThree()
    Minimap:Show()
    AutoQuests:Set("accept", true)
    boardOpen()
    local seen: Seen = { scene = false, faded = false, minimap = false }
    for _ = 1, 3 do
        mock.player:interact(board)
        watch(90, seen)
    end
    for _, id in ipairs(BOARD) do
        expect(C_QuestLog.GetLogIndexForQuestID(id) ~= nil).toBe(true)
    end
    expect(seen).toEqual({ scene = false, faded = false, minimap = false })
    -- the list again, nothing left for AutoQuests: the conversation shows
    mock.player:interact(board)
    watch(40)
    expect(scene().root).toBeShown()
    expect(M:View()).toBe("gossip")
    M:Leave()
    watch(40)
    for _, id in ipairs(BOARD) do
        abandon(id)
    end
end

@test("AutoQuests paused with Shift, or off: the NPC's list and the quest's page show as before")
local function autoPausedOrOff()
    Minimap:Show()
    AutoQuests:Set("accept", true)
    boardOpen()
    -- Shift held: the list shows, nothing taken
    mock.setModifiers({ shift = true })
    mock.player:interact(board)
    local seen = watch(40)
    expect(seen.scene).toBe(true)
    expect(M:View()).toBe("gossip")
    expect(UIParent:GetAlpha()).toBe(0)
    expect(Minimap).never.toBeShown()
    M:Leave()
    watch(40)
    mock.setModifiers({})
    -- off: a quest offered shows its page, not accepted
    settings.set("autoquests", "enabled", false)
    talkTo(scout)
    watch(40)
    expect(M:View()).toBe("detail")
    expect(scene().root).toBeShown()
    expect(UIParent:GetAlpha()).toBe(0)
    expect(C_QuestLog.GetLogIndexForQuestID(SCOUTED)).toBeNil()
    M:Leave()
    watch(40)
    settings.set("autoquests", "enabled", true)
    expect(UIParent:GetAlpha()).toBe(1)
    expect(Minimap).toBeShown()
end

@test("the game refuses the accept: the page shows once AutoQuests' second is over")
local function autoRefused()
    Minimap:Show()
    AutoQuests:Set("accept", true)
    mock.fake("AcceptQuest", function() end)
    mock.player:interact(scout)
    -- the round trip, then most of the second: nothing
    local seen = watch(60)
    expect(M:View()).toBe("detail")
    expect(seen).toEqual({ scene = false, faded = false, minimap = false })
    -- past it: the page, as without AutoQuests
    watch(60)
    expect(scene().root).toBeShown()
    expect(scene().qhead.title:GetText()).toBe("Tracks in the Snow")
    expect(Minimap).never.toBeShown()
    M:Leave()
    watch(40)
    expect(UIParent:GetAlpha()).toBe(1)
    expect(Minimap).toBeShown()
end

@test("AutoQuests turned off while it answers: the page shows at once")
local function autoOffMidway()
    Minimap:Show()
    AutoQuests:Set("accept", true)
    mock.fake("AcceptQuest", function() end)
    mock.player:interact(scout)
    local seen = watch(35)
    expect(M:View()).toBe("detail")
    expect(seen.scene).toBe(false)
    settings.set("autoquests", "enabled", false)
    -- (a look every 0.1 s: well inside AutoQuests' second)
    watch(10)
    expect(scene().root).toBeShown()
    expect(scene().qhead.title:GetText()).toBe("Tracks in the Snow")
    settings.set("autoquests", "enabled", true)
    M:Leave()
    watch(40)
    expect(UIParent:GetAlpha()).toBe(1)
end

-- (last: the module off)
@test("stopped: the scene hidden, the UI back")
local function disabled()
    talkTo(talker)
    M:OnDisable()
    expect(scene().root).never.toBeShown()
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(1)
end

@test(
    "the portrait's ground: shades of surface-sunk and surface-raised, the design's warm browns; a theme's surfaces show, live"
)
local function portraitGround()
    local p = Portrait.new(UIParent)
    local seen = recordGradients(p.base)
    SuuUI.RegisterTheme({
        id = "test-portrait-ground",
        colors = { ["surface-sunk"] = { 0.5, 0.25, 0.1 }, ["surface-raised"] = { 0.2, 0.4, 0.6 } },
    })
    useTheme("test-portrait-ground")
    local g = assert(seen[#seen])
    expectRGB(g.from, 0.285, 0.1425, 0.057)
    expectRGB(g.to, 0.234, 0.468, 0.702)
    -- SuuUI's again: the browns it had before themes reached it (within 2/255)
    useTheme(nil)
    g = assert(seen[#seen])
    expectRGB(g.from, 0.047, 0.039, 0.031, 2)
    expectRGB(g.to, 0.129, 0.110, 0.090, 2)
    p:Hide()
end
