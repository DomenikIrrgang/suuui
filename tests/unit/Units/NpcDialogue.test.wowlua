-- Units/NpcDialogue: talking to the engine's NPCs as a scene: a quest
-- offered (its title, line typing in, what they ask, rewards, Accept and
-- Decline), gossip (options, quests, Goodbye), handing a quest in (what's
-- asked for, not done yet, the reward to choose, completing), the keys,
-- the speaker's plate, the rest of the UI faded out and back, the game's
-- frames kept out of sight, the greeting, a theme change, stopped. Steps
-- AutoQuests answers itself: never drawn (MAP-20).

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import internal M from "/Units/NpcDialogue"
import internal M as AutoQuests from "/Units/AutoQuests"
import expectNoErrors, useTheme, recordGradients, expectRGB from "../../helpers"
import type AnswerPill, Scene from "/Units/NpcDialogue"
import Portrait from "/Units/NpcDialogue"
import SuuUI from "/Core/API"
import * as frames from "wowlua:frames"
import * as settings from "/Core/Settings"

local function scene(): Scene
    return M:Scene()
end
local function gossipFrame(): Frame
    return (assert(frames.find("GossipFrame")))
end

-- Placeholder NPCs and quests (made once: the engine keeps them).
local SWORD, SHIELD, CAP, PELT = 990201, 990202, 990203, 990204
mock.defineItem(PELT, { name = "Wolf Pelt", quality = 1, icon = 134366 })
mock.defineItem(SWORD, {
    name = "Militia Shortsword",
    quality = 2,
    icon = 135274,
    equipLoc = "INVTYPE_WEAPON",
    itemLevel = 12,
    sellPrice = 245,
})
mock.defineItem(SHIELD, {
    name = "Militia Buckler",
    quality = 2,
    icon = 134955,
    equipLoc = "INVTYPE_SHIELD",
    itemLevel = 12,
    sellPrice = 1312,
})
mock.defineItem(CAP, { name = "Worn Cap", quality = 1, icon = 133117 })

local offer = mock.spawnUnit({ name = "Quartermaster Hale", level = 30, reaction = "friendly", distance = 3 })
local OFFERED = 9101
mock.defineQuest(OFFERED, {
    title = "Wolves Across the Border",
    text = "Kill wolves, $N. They come every night.",
    objective = "Kill 5 wolves.",
    giver = offer,
    level = 5,
    xp = 450,
    money = 75,
    header = "Elwynn Forest",
    choices = { SWORD, SHIELD },
    rewards = { { id = CAP, count = 2 } },
    progress = "Are the wolves gone?",
    completion = "Well done.",
    objectives = { { text = "Wolf Pelt", item = PELT, required = 2 } },
})

-- two choices that sell for the same: no coin
local RING, AMULET = 990205, 990206
mock.defineItem(RING, { name = "Copper Band", quality = 2, icon = 133344, sellPrice = 100 })
mock.defineItem(AMULET, { name = "Bone Charm", quality = 2, icon = 133296, sellPrice = 100 })
local even = mock.spawnUnit({ name = "Warden Sorrel", level = 30, reaction = "friendly", distance = 3 })
local EVEN = 9102
mock.defineQuest(EVEN, {
    title = "An Even Trade",
    text = "Either will do.",
    objective = "Talk to me again.",
    giver = even,
    level = 5,
    choices = { RING, AMULET },
