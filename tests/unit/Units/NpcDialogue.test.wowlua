-- Units/NpcDialogue: talking to the engine's NPCs as a scene: a quest
-- offered (its title, line typing in, what they ask, rewards, Accept and
-- Decline), gossip (options, quests, Goodbye), handing a quest in (what's
-- asked for, not done yet, the reward to choose, completing), the keys,
-- the speaker's plate, the rest of the UI faded out and back, the game's
-- frames kept out of sight, the greeting, a theme change, stopped.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M from "/Units/NpcDialogue"
import expectNoErrors from "../../helpers"

local G: any = _G

-- Placeholder NPCs and quests (made once: the engine keeps them).
local SWORD, SHIELD, CAP, PELT = 990201, 990202, 990203, 990204
mock.defineItem(PELT, { name = "Wolf Pelt", quality = 1, icon = 134366 })
mock.defineItem(SWORD, { name = "Militia Shortsword", quality = 2, icon = 135274, equipLoc = "INVTYPE_WEAPON", itemLevel = 12 })
mock.defineItem(SHIELD, { name = "Militia Buckler", quality = 2, icon = 134955, equipLoc = "INVTYPE_SHIELD", itemLevel = 12 })
mock.defineItem(CAP, { name = "Worn Cap", quality = 1, icon = 133117 })

local offer = mock.spawnUnit({ name = "Quartermaster Hale", level = 30, reaction = "friendly", distance = 3 })
local OFFERED = 9101
mock.defineQuest(OFFERED, { title = "Wolves Across the Border", text = "Kill wolves, $N. They come every night.",
    objective = "Kill 5 wolves.", giver = offer, level = 5, xp = 450, money = 75, header = "Elwynn Forest",
    choices = { SWORD, SHIELD }, rewards = { { id = CAP, count = 2 } },
    progress = "Are the wolves gone?", completion = "Well done.",
    objectives = { { text = "Wolf Pelt", item = PELT, required = 2 } } })

local talker = mock.spawnUnit({ name = "Innkeeper Morwen", level = 30, reaction = "friendly", distance = 3 })
mock.defineGossip(talker, { text = "Welcome to the inn, traveller.", options = {
    { name = "Make this inn your home.", icon = 132052, gossipOptionID = 1 },
    { name = "What can I buy here?", icon = 132060, gossipOptionID = 2 },
    { name = "Tell me a story.", icon = 999999, gossipOptionID = 3 },
} })

local function settle()
    mock.advanceTime(0.5)
    mock.advanceFrames(3)
end

local function talkTo(npc: mock.MockUnit)
    mock.player:interact(npc)
    settle()
end

-- The answer pills shown, by label.
local function pill(label: string): any
    for _, b in ipairs(M.pills) do if b:IsShown() and b.label == label then return b end end
    return nil
end

local function labels(): string[]
    local out: string[] = {}
    for _, a in ipairs(M.answerList or {}) do out[#out + 1] = a.label end
    return out
end

@afterEach
local function cleanup()
    if InCombatLockdown() then mock.player:leaveCombat() end
    if M.root:IsShown() then M:Leave() end
    mock.setModifiers({})
    M:Reset("hideUI")
    mock.advanceTime(1)
    mock.advanceFrames(2)
    local id = C_QuestLog.GetLogIndexForQuestID(OFFERED)
    if id then
        C_QuestLog.SetSelectedQuest(OFFERED)
        C_QuestLog.SetAbandonQuest()
        C_QuestLog.AbandonQuest()
        settle()
    end
    expectNoErrors()
end

@test("a quest offered: its title and level, the line typing in, what they ask, the rewards, Accept and Decline")
local function offered()
    talkTo(offer)
    expect(M:View()).toBe("detail")
    expect(M.root).toBeShown()
    expect(M.qhead.title:GetText()).toBe("Wolves Across the Border")
    expect(M.plate.name:GetText()).toBe("Quartermaster Hale")
    -- the line types in; Space shows it all
    expect(M.fullText:find("Kill wolves", 1, true)).toBe(1)
    M.shown = 0
    M.typed = 0
    M:ShowTyped()
    expect(M.speech.skip).toBeShown()
    mock.advanceFrames(5)
    expect(M.shown > 0).toBe(true)
    expect(M:Key("SPACE")).toBe(true)
    expect(M.speech.text:GetText()).toBe(M.fullText)
    expect(M.speech.skip).never.toBeShown()
    expect(M:Key("SPACE")).toBe(false)
    expect(M.ask.text:GetText()).toBe("Kill 5 wolves.")
    -- the rewards: two to choose from (one may be chosen), one anyway, money and experience
    expect(M.cards.caption:GetText()).toBe("You may choose one")
    expect(M.cards.list[1].name:GetText()).toBe("Militia Shortsword")
    expect(M.cards.list[3].name:GetText()).toBe("Worn Cap")
    expect(M.cards.money).toBeShown()
    expect(M.cards.xp:GetText()).toBe("450 XP")
    expect(labels()).toEqual({ "Accept", "Decline" })
    -- a reward better than what you wear (a level 1 character has no weapon worn): an upgrade
    local cards = M:Rewards(false)
    expect(cards[1].upgrade).toBe(true)
    expect(cards[3].upgrade).toBeNil()
    -- a card clicked: its link to the chat, the game's way
    local handled = mock.spy(function(_: string) end)
    mock.stub(G, "HandleModifiedItemClick", handled)
    M.cards.list[3]:Click()
    expect(handled).toHaveBeenCalled()
    -- Enter accepts
    expect(M:Key("ENTER")).toBe(true)
    settle()
    expect(C_QuestLog.GetLogIndexForQuestID(OFFERED) ~= nil).toBe(true)
    expect(M.root).never.toBeShown()
end

@test("a quest declined: the scene ends")
local function declined()
    talkTo(offer)
    pill("Decline"):Click()
    settle()
    expect(M.root).never.toBeShown()
    expect(C_QuestLog.GetLogIndexForQuestID(OFFERED)).toBeNil()
end

@test("gossip: the options with their glyphs, Goodbye last; an option chosen; Goodbye leaves")
local function gossip()
    talkTo(talker)
    expect(M:View()).toBe("gossip")
    expect(M.fullText).toBe("Welcome to the inn, traveller.")
    local l = labels()
    expect(l[#l]).toBe("Goodbye")
    expect(#l).toBe(4)
    -- the inn's glyph is SuuUI's; an unknown icon its own
    expect(M.answerList[1].glyph).toBe("inn")
    expect(M.answerList[3].glyph).toBe(999999)
    -- a number answers; Esc's pill isn't a number's
    expect(M:Key("4")).toBe(false)
    expect(M:Key("1")).toBe(true)
    settle()
    talkTo(talker)
    pill("Goodbye"):Click()
    settle()
    expect(M.root).never.toBeShown()
    expect(G.GossipFrame:IsShown()).toBe(false)
end

@test("gossip's quests: one to take, one to hand in (ready), daily and repeatable tagged")
local function gossipQuests()
    talkTo(talker)
    mock.stub(C_GossipInfo, "GetAvailableQuests", function(): any
        return { { questID = 1, title = "A Daily Errand", frequency = 1 }, { questID = 2, title = "Again and Again", repeatable = true },
                 { questID = 3, title = "Easy Work", isTrivial = true } }
    end)
    mock.stub(C_GossipInfo, "GetActiveQuests", function(): any
        return { { questID = 4, title = "Bring the Pelts", isComplete = true }, { questID = 5, title = "Still Hunting" } }
    end)
    local selected = mock.spy(function(_: number) end)
    mock.stub(C_GossipInfo, "SelectAvailableQuest", selected)
    local active = mock.spy(function(_: number) end)
    mock.stub(C_GossipInfo, "SelectActiveQuest", active)
    M:Draw()
    expect(labels()).toEqual({ "Make this inn your home.", "What can I buy here?", "Tell me a story.", "Bring the Pelts",
        "Still Hunting", "A Daily Errand", "Again and Again", "Easy Work", "Goodbye" })
    expect(M.answerList[4].tag[1]).toBe("Ready")
    expect(M.answerList[6].tag[1]).toBe("Daily")
    expect(M.answerList[7].tag[1]).toBe("Repeatable")
    M.answerList[4].act()
    expect(active).toHaveBeenCalledWith(4)
    M.answerList[6].act()
    expect(selected).toHaveBeenCalledWith(1)
end

@test("handing in: what's asked for and how many you have, not done yet; done, the reward to choose, completed")
local function handIn()
    talkTo(offer)
    AcceptQuest()
    settle()
    -- back with nothing: what's asked for
    talkTo(offer)
    expect(M:View()).toBe("progress")
    expect(M.fullText).toBe("Are the wolves gone?")
    expect(M.cards.list[1].right:GetText()).toBe("0 / 2")
    local a = M.answerList[1]
    expect(a.label).toBe("Hand them over")
    expect(a.off:find("You need 2 more", 1, true)).toBe(1)
    -- a pill that's off: its reason as the tooltip, nothing on a click
    local b = pill("Hand them over")
    b:GetScript("OnEnter")(b)
    b:Click()
    b:GetScript("OnLeave")(b)
    expect(M:View()).toBe("progress")
    pill("I'll be back"):Click()
    settle()
    -- the pelts looted from a wolf: back, done
    local wolf = mock.spawnUnit({ name = "Prowler", level = 1, reaction = "hostile", distance = 3 })
    mock.player:swing(wolf, 99999, { kill = { xp = 0, loot = { { id = PELT, count = 2 } } } })
    settle()
    mock.player:loot(wolf, { auto = true })
    mock.advanceTime(2)
    mock.advanceFrames(3)
    talkTo(offer)
    expect(M.cards.list[1].right:GetText()).toBe("2 / 2")
    expect(M.answerList[1].off).toBeNil()
    M:Key("ENTER")
    settle()
    expect(M:View()).toBe("reward")
    expect(M.cards.caption:GetText()).toBe("Choose your reward")
    expect(M.answerList[1].off).toBe("Choose a reward first")
    -- a choice: lit, the button free
    M.cards.list[2]:Click()
    expect(M.chosen).toBe(2)
    expect(M.cards.list[2].on).toBe(true)
    expect(M.answerList[1].off).toBeNil()
    -- a card's tooltip: the quest item's
    local card = M.cards.list[1]
    card:GetScript("OnEnter")(card)
    card:GetScript("OnLeave")(card)
    pill("Complete quest"):Click()
    mock.advanceTime(3)
    mock.advanceFrames(3)
    expect(M.root).never.toBeShown()
    expect(C_QuestLog.GetLogIndexForQuestID(OFFERED)).toBeNil()
end

@test("the keys: a modifier held leaves them to the game; numbers answer; others pass")
local function keys()
    talkTo(talker)
    mock.setModifiers({ shift = true })
    expect(M:Key("1")).toBe(false)
    mock.setModifiers({})
    expect(M:Key("Q")).toBe(false)
    expect(M:Key("ENTER")).toBe(false)
    -- the bar's own key handler: the game gets what isn't handled
    M.bar:GetScript("OnKeyDown")(M.bar, "Q")
    -- in combat the keys are the game's
    mock.player:enterCombat()
    M.bar:GetScript("OnKeyDown")(M.bar, "1")
    expect(M:View()).toBe("gossip")
    mock.player:leaveCombat()
end

@test("the speaker: their name and role, friend or foe; the portrait kept for the same speaker")
local function speaker()
    talkTo(talker)
    expect(M.plate.name:GetText()).toBe("Innkeeper Morwen")
    local guid = M.speakerGUID
    M:DrawSpeaker()
    expect(M.speakerGUID).toBe(guid)
    mock.stub(C_TooltipInfo, "GetUnit", function(_: string): any
        return { lines = { { leftText = "Innkeeper Morwen" }, { leftText = "Innkeeper" } } }
    end)
    M:DrawSpeaker()
    expect(M.plate.role:GetText()).toBe("Innkeeper")
    mock.stub(C_TooltipInfo, "GetUnit", function(_: string): any
        return { lines = { { leftText = "Innkeeper Morwen" }, { leftText = "Level 30" } } }
    end)
    M:DrawSpeaker()
    expect(M.plate.role:GetText()).toBe("")
end

@test("the rest of the UI fades out while you talk, and back after; at once in a fight; off by the setting")
local function hideUI()
    talkTo(talker)
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(0)
    expect(M.root:GetEffectiveAlpha()).toBe(1)
    mock.player:enterCombat()
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(1)
    mock.player:leaveCombat()
    M:Leave()
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(1)
    -- off: the bar over the action bars, the UI stays
    M:Set("hideUI", false)
    talkTo(talker)
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(1)
    local _, _, _, _, y = M.bar:GetPoint(1)
    expect(y).toBe(28)
    M:Set("hideUI", true)
end

@test("the game's frames out of sight however they're placed")
local function away()
    talkTo(talker)
    local g = G.GossipFrame
    g:ClearAllPoints()
    g:SetPoint("CENTER")
    g:SetAlpha(1)
    mock.advanceFrames(2)
    expect(g:GetAlpha()).toBe(0)
    local _, rel = g:GetPoint(1)
    expect(rel).toBe(UIParent)
end

@test("a greeting: their quests to hand in and to take, Goodbye")
local function greeting()
    mock.stub(G, "GetGreetingText", function(): string return "Greetings, $N." end)
    mock.stub(G, "GetNumActiveQuests", function(): number return 1 end)
    mock.stub(G, "GetActiveTitle", function(_: number): (string, boolean) return "Bring the Pelts", true end)
    mock.stub(G, "GetNumAvailableQuests", function(): number return 2 end)
    mock.stub(G, "GetAvailableQuestInfo", function(i: number): (boolean, number, boolean)
        return i == 2, i == 1 and 1 or 0, false
    end)
    mock.stub(G, "GetAvailableTitle", function(i: number): string return i == 1 and "A Daily Errand" or "Easy Work" end)
    local active = mock.spy(function(_: number) end)
    mock.stub(G, "SelectActiveQuest", active)
    local available = mock.spy(function(_: number) end)
    mock.stub(G, "SelectAvailableQuest", available)
    local c = M:Content("greeting")
    expect(c.text).toBe("Greetings, $N.")
    expect(#c.answers).toBe(4)
    expect(c.answers[1].tag[1]).toBe("Ready")
    expect(c.answers[2].tag[1]).toBe("Daily")
    c.answers[1].act()
    expect(active).toHaveBeenCalledWith(1)
    c.answers[3].act()
    expect(available).toHaveBeenCalledWith(2)
end

@test("a long line scrolls, its foot fading; a theme change draws it again")
local function longLine()
    talkTo(talker)
    M.fullText = nil
    mock.stub(C_GossipInfo, "GetText", function(): string return string.rep("A long story about the old days. ", 60) end)
    M:Draw()
    M:RevealAll()
    expect(M.speech.fade).toBeShown()
    M.speech.scroll:SetVerticalScroll(10000)
    M:DrawFade()
    M:Emit("SUUUI_THEME_CHANGED")
    mock.advanceFrames(2)
    mock.fireEvent("QUEST_ITEM_UPDATE")
    mock.advanceFrames(2)
end

@test("text typed in whole characters: colour codes and textures at once")
local function typedWhole()
    talkTo(talker)
    M.fullText = nil
    mock.stub(C_GossipInfo, "GetText", function(): string return "Ä |cffff0000red|r |TInterface\\Icons\\Temp:0|t end" end)
    M:Draw()
    M.shown, M.typed = 0, 0
    M:Type(0.02)
    expect(M.speech.text:GetText()).toBe("Ä")
    M:Type(0.02)
    M:Type(0.02)
    expect(M.speech.text:GetText():find("|cffff0000", 1, true) ~= nil).toBe(true)
end

-- (last: the module off)
@test("stopped: the scene hidden, the UI back")
local function disabled()
    talkTo(talker)
    local m: any = M
    m:OnDisable()
    expect(M.root).never.toBeShown()
    mock.advanceFrames(40)
    expect(UIParent:GetAlpha()).toBe(1)
    M:PutAway(G.GossipFrame)
end
