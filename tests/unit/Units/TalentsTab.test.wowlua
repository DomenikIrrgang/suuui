-- Units/Talents with Blizzard's spells window: SuuUI's page in place of its
-- Talents tab, on the engine's talents (a recorded warrior's trees), not
-- the stand-in Talents.test.wowlua uses: Blizzard's own talent frame runs
-- underneath and reads the same trees.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import internal M from "/Units/Talents"
import expectNoErrors from "../../helpers"
import * as frames from "wowlua:frames"
import field from "wowlua:table"

-- The spells window and Blizzard's Talents tab in it.
local function spells(): Frame
    return assert(frames.find("PlayerSpellsFrame"))
end
local function talentsTab(): Frame
    return assert(frames.asFrame(field(spells(), "TalentsFrame")))
end

-- (talents from level 5)
mock.setPlayer({ level = 20 })

@afterEach
local function cleanup()
    local f = frames.find("PlayerSpellsFrame")
    if f and f:IsShown() then
        HideUIPanel(f)
    end
    mock.advanceFrames(2)
    expectNoErrors()
end

@test("Blizzard's Talents tab: SuuUI's page with it, in the middle; its tab kept off screen")
local function spellsWindowTab()
    PlayerSpellsUtil.OpenToClassTalentsTab()
    mock.advanceFrames(2)
    local f = spells()
    local page = assert(M.page)
    expect(page).toBeShown()
    expect(talentsTab():GetAlpha()).toBe(0)
    -- Blizzard places its tab again: off screen once more, a frame later
    talentsTab():SetPoint("TOPLEFT", f, "TOPLEFT")
    mock.advanceFrames(2)
    local _, _, _, x = talentsTab():GetPoint(1)
    expect(x).toBe(5000)
    HideUIPanel(f)
    mock.advanceFrames(2)
    expect(page).never.toBeShown()
end
