-- Units/Social: SuuUI's pages over Forever's social window (opened with
-- its key, its tabs clicked): Contacts (Battle.net and character friends,
-- online first, each kind's line and actions, notes, removing, adding,
-- ignoring, your status), Recent allies (pinned first, the menu), Friend
-- requests, the Raid page (members, moves and swaps, the leader's menu,
-- the made-up test raid, lockouts), a probe asking the pages to step
-- aside.
--
-- The engine has no friends, Battle.net friends, ignores or recent allies:
-- the game's calls answer as the client would for the ones the test lists.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as services from "/Core/Services"
import internal M from "/Units/Social"
import expectNoErrors, captureMenus, choose, captureConfirm from "../../helpers"
import type Confirms from "../../helpers"
import type Friend, ContactsData, Contacts, RaidMember from "/UI/Social"
import named, part, ask, asFrame, asButton from "/UI/Reskin"

local function frame(): Frame return (assert(asFrame(named("SocialUIFrame")))) end
local function view(): Contacts return (assert(M.view)) end
local function friendsList(): Frame return (assert(M:FriendsList())) end
-- The confirm dialog's OK with this text.
local function confirmWith(c: Confirms, text: string?) assert(c.last().onConfirm)(text) end

local function open()
    if not frame():IsShown() then mock.pressKey("O") end
    mock.advanceFrames(3)
end

-- A tab of the window by its type ("Friends", "RecentAllies", "FriendRequests", "RaidList").
local function tab(kind: string): Button?
    local want = part(named("SocialUITabType"), kind)
    local step, state, init = ask(part(frame(), "socialTabPool"), "EnumerateActive")
    if type(step) ~= "function" then return nil end
    for t in step :: (unknown, unknown) -> unknown, state, init do
        if part(part(t, "tabData"), "tabType") == want then return asButton(t) end
    end
    return nil
end

local function openTab(kind: string)
    open()
    local b = tab(kind)
    if b then mock.click(b) end
    mock.advanceFrames(3)
end

-- Battle.net friends as the client gives them (C_BattleNet.GetFriendAccountInfo).
local FACTION = UnitFactionGroup("player")
local OTHER = FACTION == "Alliance" and "Horde" or "Alliance"
type Fake = { [string]: unknown }
local function bnetFriends(list: Fake[])
    mock.stub(_G, "BNGetNumFriends", function(): (number, number, number, number) return #list, #list, 0, 0 end)
    mock.stub(C_BattleNet, "GetFriendAccountInfo", function(i: number): BNetAccountInfo? return list[i] :: unknown :: BNetAccountInfo? end)
end

local function wowGame(over: Fake?): Fake
    local g: Fake = { isOnline = true, clientProgram = BNET_CLIENT_WOW or "WoW", characterName = "Brannoc Ironhand",
        className = "Warrior", characterLevel = 60, areaName = "Ironforge", wowProjectID = WOW_PROJECT_ID, gameAccountID = 77,
        factionName = FACTION }
    for k, v in pairs(over or {}) do g[k] = v end
    return g
end

-- Character friends as the client gives them (C_FriendList.GetFriendInfoByIndex).
local function characterFriends(list: Fake[])
    mock.stub(C_FriendList, "GetNumFriends", function(): number return #list end)
    mock.stub(C_FriendList, "GetFriendInfoByIndex", function(i: number): FriendInfo? return list[i] :: unknown :: FriendInfo? end)
end

@afterEach
local function cleanup()
    if InCombatLockdown() then mock.player:leaveCombat() end
    if M.raidTest then M:TestRaid() end
    local panel = M:LockoutPanel()
    if panel and panel:IsShown() then M:ToggleLockouts() end
    if frame():IsShown() then HideUIPanel(frame()) end
    mock.group:leave()
    M.selected, M.mode, M.pinWanted = nil, nil, nil
    mock.advanceFrames(3)
    expectNoErrors()
end

@test("the window on its key: SuuUI's Contacts page over it, Blizzard's friends list out of sight")
local function opens()
    open()
    expect(frame():IsShown()).toBe(true)
    expect(M.view).toBeShown()
    expect(friendsList():GetAlpha()).toBe(0)
    local _, rel, relPoint = friendsList():GetPoint(1)
    expect(rel).toBe(UIParent)
    expect(relPoint).toBe("TOPRIGHT")
    -- Blizzard places it again: away once more
    friendsList():ClearAllPoints()
    friendsList():SetPoint("CENTER")
    mock.advanceFrames(2)
    local _, rel2 = friendsList():GetPoint(1)
    expect(rel2).toBe(UIParent)
end

@test("friends: online first, then by name; each kind's line and why it can't be invited")
local function friends()
    bnetFriends({
        { bnetAccountID = 1, accountName = "|Kq1|k", battleTag = "Brannoc#1137", note = "raid lead", gameAccountInfo = wowGame() },
        { bnetAccountID = 2, accountName = "|Kq2|k", battleTag = "Aster#2001", gameAccountInfo = wowGame({ factionName = OTHER, characterName = "Aster Vale" }) },
        { bnetAccountID = 3, accountName = "|Kq3|k", battleTag = "Corwin#3001", gameAccountInfo = wowGame({ wowProjectID = -1 }) },
        { bnetAccountID = 4, accountName = "|Kq4|k", battleTag = "Dara#4001", isAFK = true, gameAccountInfo = { isOnline = true, clientProgram = "WTCG" } },
        { bnetAccountID = 5, accountName = "|Kq5|k", battleTag = "Elian#5001", lastOnlineTime = time() - 3 * 86400, gameAccountInfo = { isOnline = false } },
        { bnetAccountID = 6, accountName = "|Kq6|k", battleTag = "Fenn#6001", gameAccountInfo = { isOnline = false } },
    })
    characterFriends({
        { name = "Tamsin Ashford", connected = true, level = 42, className = "Priest", area = "Stormwind City", notes = "healer" },
        { name = "Morrow Fenwick", connected = false, className = "Druid" },
    })
    local list, online = M:Friends()
    expect(#list).toBe(8)
    expect(online).toBe(5)
    -- online first
    for i = 1, 5 do expect(list[i].online).toBe(true) end
    local rows: { [string]: Friend } = {}
    for _, r in ipairs(list) do rows[assert(r.key)] = r end
    local function by(key: string): Friend return (assert(rows[key], key)) end
    local b1 = by("bn:1")
    expect(b1.character).toBe("Brannoc Ironhand")
    expect(b1.detail).toBe("Level 60 Warrior · Ironforge")
    expect(b1.invite).toBe(true)
    expect(b1.note).toBe("raid lead")
    expect(by("bn:2").why).toBe("They're in the other faction.")
    expect(by("bn:3").why).toBe("They're playing another version of World of Warcraft.")
    expect(by("bn:4").detail).toBe("Playing Hearthstone")
    expect(by("bn:4").away).toBe(true)
    expect(by("bn:5").detail).toBe("Last online 3 days ago")
    expect(by("bn:6").detail).toBe("Offline")
    local tamsin = by("c:Tamsin Ashford")
    expect(tamsin.detail).toBe("Level 42 Priest · Stormwind City")
    expect(tamsin.color).toBe("class-priest")
    expect(by("c:Morrow Fenwick").why).toBe("They're offline.")
    -- drawn: the page gets them with your status and BattleTag
    mock.stub(_G, "BNGetInfo", function(): (number?, string, number, string, boolean, boolean, boolean) return 1, "Tamsin#1234", 1, "", false, true, false end)
    local drawn: ContactsData? = nil
    open()
    mock.stub(view(), "SetData", function(_: unknown, d: ContactsData) drawn = d end)
    M:Render()
    local d = assert(drawn)
    expect(d.total).toBe(8)
    expect(d.online).toBe(5)
    expect(d.me).toBe("Tamsin#1234")
    expect(d.status).toBe("busy")
end

@test("how long ago: hours, days, months")
local function ago()
    local now = time()
    local function lastOnline(seconds: number): string
        bnetFriends({ { bnetAccountID = 9, accountName = "x", battleTag = "X#1", lastOnlineTime = now - seconds, gameAccountInfo = { isOnline = false } } })
        characterFriends({})
        return assert((M:Friends())[1].detail)
    end
    expect(lastOnline(60)).toBe("Last online less than an hour ago")
    expect(lastOnline(3600)).toBe("Last online 1 hour ago")
    expect(lastOnline(5 * 3600)).toBe("Last online 5 hours ago")
    expect(lastOnline(86400)).toBe("Last online 1 day ago")
    expect(lastOnline(40 * 86400)).toBe("Last online 1 month ago")
    expect(lastOnline(90 * 86400)).toBe("Last online 3 months ago")
end

@test("the page's actions: whisper, invite, your status, add a friend or a BattleTag, ignore and unignore")
local function actions()
    local confirms = captureConfirm()
    open()
    local v = view()
    local tell = mock.spy(function(_: string) end)
    local bnTell = mock.spy(function(_: string) end)
    mock.stub(ChatFrameUtil, "SendTell", tell)
    mock.stub(ChatFrameUtil, "SendBNetTell", bnTell)
    assert(v.onWhisper)({ name = "Tamsin Ashford" })
    expect(tell).toHaveBeenCalledWith("Tamsin Ashford")
    assert(v.onWhisper)({ bnet = true, name = "|Kq1|k" })
    expect(bnTell).toHaveBeenCalledWith("|Kq1|k")
    local bnInvite = mock.spy(function(_: number) end)
    mock.stub(C_BattleNet, "InviteFriend", bnInvite)
    assert(v.onInvite)({ gameAccountID = 77 })
    expect(bnInvite).toHaveBeenCalledWith(77)
    local invite = mock.spy(function(_: string) end)
    mock.stub(C_PartyInfo, "InviteUnit", invite)
    assert(v.onInvite)({ inviteName = "Tamsin Ashford" })
    expect(invite).toHaveBeenCalledWith("Tamsin Ashford")
    -- status: away, busy
    local afk = mock.spy(function(_: boolean) end)
    local dnd = mock.spy(function(_: boolean) end)
    mock.stub(C_BattleNet, "SetAFK", afk)
    mock.stub(C_BattleNet, "SetDND", dnd)
    assert(v.onStatus)("busy")
    expect(afk).toHaveBeenCalledWith(false)
    expect(dnd).toHaveBeenCalledWith(true)
    mock.advanceTime(0.5)
    -- add: a BattleTag or a character
    assert(v.onAdd)()
    local sent = mock.spy(function(_: string) end)
    mock.stub(_G, "BNSendFriendInvite", sent)
    confirmWith(confirms, "Brannoc#1137")
    expect(sent).toHaveBeenCalledWith("Brannoc#1137")
    assert(v.onAdd)()
    local said: string[] = {}
    mock.stub(M, "Print", function(_: unknown, text: string) said[#said + 1] = text end)
    mock.stub(SuuUI, "AddFriend", function(_: string): boolean return true end)
    confirmWith(confirms, "Brannoc Ironhand")
    expect(said[1]).toBe("Friend request sent to Brannoc Ironhand.")
    -- ignore and unignore
    local ignored = mock.spy(function(_: string) end)
    mock.stub(C_FriendList, "AddIgnore", ignored)
    assert(v.onIgnore)()
    confirmWith(confirms, "Corwin Hale")
    expect(ignored).toHaveBeenCalledWith("Corwin Hale")
    local unignored = mock.spy(function(_: string) end)
    mock.stub(C_FriendList, "DelIgnore", unignored)
    assert(v.onUnignore)("Corwin Hale")
    expect(unignored).toHaveBeenCalledWith("Corwin Hale")
    -- views and the selection
    assert(v.onView)("ignored")
    expect(M.mode).toBe("ignored")
    assert(v.onSelect)("bn:1")
    expect(M.selected).toBe("bn:1")
    -- the ignored list
    mock.stub(C_FriendList, "GetNumIgnores", function(): number return 1 end)
    mock.stub(C_FriendList, "GetIgnoreName", function(_: number): string return "Corwin Hale" end)
    expect(M:Ignored()).toEqual({ "Corwin Hale" })
    mock.advanceTime(0.5)
end

@test("a friend's menu: whisper, invite, a note, ignore, remove (a character's and a Battle.net friend's)")
local function friendMenu()
    local menu = captureMenus()
    local confirms = captureConfirm()
    open()
    local row: Friend = { name = "Tamsin Ashford", whisper = true, invite = true, inviteName = "Tamsin Ashford", note = "healer" }
    local tell = mock.spy(function(_: string) end)
    mock.stub(ChatFrameUtil, "SendTell", tell)
    assert(view().onMenu)(row, view())
    choose(menu, "Whisper")
    expect(tell).toHaveBeenCalled()
    local invite = mock.spy(function(_: string) end)
    mock.stub(C_PartyInfo, "InviteUnit", invite)
    choose(menu, "Invite")
    expect(invite).toHaveBeenCalled()
    local notes = mock.spy(function(_: string, _: string) end)
    mock.stub(C_FriendList, "SetFriendNotes", notes)
    choose(menu, "Set note")
    expect(assert(confirms.last().input).value).toBe("healer")
    confirmWith(confirms, "tank now")
    expect(notes).toHaveBeenCalledWith("Tamsin Ashford", "tank now")
    choose(menu, "Ignore")
    expect(confirms.last().title).toBe("Ignore Tamsin Ashford?")
    local removed = mock.spy(function(_: string) end)
    mock.stub(C_FriendList, "RemoveFriend", removed)
    choose(menu, "Remove friend")
    confirmWith(confirms, nil)
    expect(removed).toHaveBeenCalledWith("Tamsin Ashford")
    -- a Battle.net friend: no Ignore; its note and removal by account
    local bnRow: Friend = { bnet = true, bnetID = 5, name = "|Kq1|k", character = "Brannoc Ironhand", whisper = true }
    assert(view().onMenu)(bnRow, view())
    expect(menu["Ignore"]).toBeNil()
    local bnNote = mock.spy(function(_: number, _: string) end)
    mock.stub(_G, "BNSetFriendNote", bnNote)
    choose(menu, "Set note")
    confirmWith(confirms, "old friend")
    expect(bnNote).toHaveBeenCalledWith(5, "old friend")
    local bnRemove = mock.spy(function(_: number) end)
    mock.stub(_G, "BNRemoveFriend", bnRemove)
    choose(menu, "Remove friend")
    confirmWith(confirms, nil)
    expect(bnRemove).toHaveBeenCalledWith(5)
    mock.advanceTime(0.5)
end

-- Recent allies as the client gives them (C_RecentAllies.GetRecentAllies).
local function allies(pinned: { [string]: boolean })
    mock.stub(C_RecentAllies, "GetRecentAllies", function(): RecentAllyData[]
        local list: Fake[] = {
            { characterData = { guid = "Player-0000-00000001", fullName = "Tamsin Ashford", classID = 5, level = 42 },
              stateData = { isOnline = true, currentLocation = "Stormwind City" },
              interactionData = { note = "good healer", interactions = { { description = "Grouped in The Stockade" } } } },
            { characterData = { guid = "Player-0000-00000002", name = "Brannoc Ironhand", classID = 1, level = 60 },
              stateData = { isOnline = false, friendRequestSentThisSession = true } },
            { characterData = { guid = "Player-0000-00000003", name = "Aster Vale", classID = 8 },
              stateData = { isOnline = false } },
        }
        return list :: unknown :: RecentAllyData[]
    end)
    mock.stub(C_RecentAllies, "IsRecentAllyPinned", function(guid: string): boolean return pinned[guid] or false end)
end

@test("recent allies: pinned first, then online, then by name; how you met; add friend or already requested")
local function recentAllies()
    allies({ ["Player-0000-00000003"] = true })
    local list = M:Allies()
    expect(list[1].name).toBe("Aster Vale")
    expect(list[1].pinned).toBe(true)
    expect(list[2].name).toBe("Tamsin Ashford")
    local t = list[2]
    expect(t.detail).toBe("Level 42 · Stormwind City · Grouped in The Stockade")
    expect(t.note).toBe("good healer")
    expect(t.color).toBe("class-priest")
    local acts = assert(t.actions)
    expect(acts[1].label).toBe("Whisper")
    expect(acts[2].label).toBe("Add friend")
    local b = list[3]
    local bActs = assert(b.actions)
    expect(bActs[1].label).toBe("Requested")
    expect(bActs[1].disabled).toBe(true)
    -- Add friend: a request, the list again a moment later
    mock.stub(SuuUI, "AddFriend", function(_: string): boolean return false end)
    assert(acts[2].onClick)(t)
    mock.advanceTime(0.6)
    -- the page on its tab
    openTab("RecentAllies")
    local page = M.alliesPage
    if page then
        expect(page:IsShown()).toBe(true)
        expect(assert(asFrame(part(frame(), "RecentAlliesList"))):GetAlpha()).toBe(0)
    end
end

@test("an ally's menu: whisper, invite, pin (at once, before the game agrees), ignore, a note")
local function allyMenu()
    local menu = captureMenus()
    local confirms = captureConfirm()
    local pinned: { [string]: boolean } = {}
    allies(pinned)
    local set = mock.spy(function(_: string, _: boolean) end)
    mock.stub(C_RecentAllies, "SetRecentAllyPinned", set)
    local row = M:Allies()[1]
    expect(row.name).toBe("Tamsin Ashford")
    M:AllyMenu(row, UIParent)
    local tell = mock.spy(function(_: string) end)
    mock.stub(ChatFrameUtil, "SendTell", tell)
    choose(menu, "Whisper")
    expect(tell).toHaveBeenCalledWith("Tamsin Ashford")
    local invite = mock.spy(function(_: string) end)
    mock.stub(C_PartyInfo, "InviteUnit", invite)
    choose(menu, "Invite")
    expect(invite).toHaveBeenCalledWith("Tamsin Ashford")
    choose(menu, "Pin")
    expect(set).toHaveBeenCalledWith("Player-0000-00000001", true)
    -- wanted until the game's own data says so
    expect(M:Pinned("Player-0000-00000001")).toBe(true)
    pinned["Player-0000-00000001"] = true
    expect(M:Pinned("Player-0000-00000001")).toBe(true)
    expect(assert(M.pinWanted)["Player-0000-00000001"]).toBeNil()
    mock.advanceTime(1.1)
    choose(menu, "Ignore")
    expect(confirms.last().title).toBe("Ignore Tamsin Ashford?")
    mock.stub(C_RecentAllies, "CanSetRecentAllyNote", function(): boolean return true end)
    local noted = mock.spy(function(_: string, _: string) end)
    mock.stub(C_RecentAllies, "SetRecentAllyNote", noted)
    M:AllyMenu(row, UIParent)
    choose(menu, "Set note")
    confirmWith(confirms, "tank too")
    expect(noted).toHaveBeenCalledWith("Player-0000-00000001", "tank too")
    mock.advanceTime(0.3)
    expect(M:Pinned(nil)).toBe(false)
end

@test("friend requests: who and when, accept or decline")
local function requests()
    mock.stub(_G, "BNGetNumFriendInvites", function(): number return 2 end)
    mock.stub(_G, "BNGetFriendInviteInfo", function(i: number): (number, string, boolean, nil, number?)
        if i == 1 then return 11, "|Kq7|k", false, nil, time() - 2 * 3600 end
        return 12, "|Kq8|k", false, nil, nil
    end)
    local list = M:Requests()
    expect(#list).toBe(2)
    expect(list[1].detail).toBe("Sent 2 hours ago")
    expect(list[2].detail).toBe("Wants to be your Battle.net friend")
    local accepted = mock.spy(function(_: number) end)
    local declined = mock.spy(function(_: number) end)
    mock.stub(_G, "BNAcceptFriendInvite", accepted)
    mock.stub(_G, "BNDeclineFriendInvite", declined)
    assert(assert(list[1].actions)[2].onClick)(list[1])
    expect(accepted).toHaveBeenCalledWith(11)
    assert(assert(list[2].actions)[1].onClick)(list[2])
    expect(declined).toHaveBeenCalledWith(12)
    openTab("FriendRequests")
    mock.fireEvent("BN_FRIEND_INVITE_ADDED", 13)
    mock.advanceTime(0.2)
end

-- Placeholder raiders, made once.
local raiders: mock.MockUnit[] = {}
for i, class in ipairs({ "WARRIOR", "PRIEST", "MAGE" }) do
    raiders[i] = mock.spawnUnit({ name = ({ "Brannoc Ironhand", "Tamsin Ashford", "Aster Vale" })[i], player = true, class = class,
        level = 60, reaction = "friendly" })
end

@test("the Raid page: the raid's members by group, moves and swaps, the leader's menu, its buttons")
local function raid()
    local menu = captureMenus()
    for i, u in ipairs(raiders) do mock.group:add(u, { raid = true, subgroup = i == 3 and 2 or 1, quiet = i < 3 }) end
    mock.advanceTime(0.6)
    openTab("RaidList")
    local page = assert(M.raidPage)
    expect(page:IsShown()).toBe(true)
    local move, swap, member = assert(page.onMove), assert(page.onSwap), assert(page.onMember)
    local members = M:RaidMembers()
    expect(#members).toBe(4)
    local found: RaidMember? = nil
    for _, m in ipairs(members) do if m.you then found = m end end
    local me = assert(found)
    expect(me.leader).toBe(true)
    -- moved to another group, swapped
    local function memberNamed(name: string): RaidMember
        for _, m in ipairs(M:RaidMembers()) do if m.name == name then return m end end
        error("no " .. name)
    end
    local aster = memberNamed("Aster Vale")
    move(aster.index, 3)
    mock.advanceTime(0.6)
    local function groupOf(name: string): number?
        for _, m in ipairs(M:RaidMembers()) do if m.name == name then return m.group end end
        return nil
    end
    expect(groupOf("Aster Vale")).toBe(3)
    local tamsin = memberNamed("Tamsin Ashford")
    swap(tamsin.index, aster.index)
    mock.advanceTime(0.6)
    expect(groupOf("Tamsin Ashford")).toBe(3)
    expect(groupOf("Aster Vale")).toBe(1)
    -- in combat: not moved
    mock.player:enterCombat()
    mock.advanceFrames(1)
    move(tamsin.index, 2)
    swap(tamsin.index, aster.index)
    mock.player:leaveCombat()
    -- a member's menu: the leader's choices
    local promote = mock.spy(function(_: string) end)
    mock.stub(_G, "PromoteToAssistant", promote)
    member(tamsin, "RightButton", page)
    expect(menu["Promote to assistant"] ~= nil).toBe(true)
    choose(menu, "Promote to assistant")
    expect(promote).toHaveBeenCalledWith(assert(tamsin.unit))
    local tell = mock.spy(function(_: string) end)
    mock.stub(ChatFrameUtil, "SendTell", tell)
    choose(menu, "Whisper")
    expect(tell).toHaveBeenCalledWith("Tamsin Ashford")
    local leader = mock.spy(function(_: string) end)
    mock.stub(_G, "PromoteToLeader", leader)
    choose(menu, "Make leader")
    expect(leader).toHaveBeenCalledWith(assert(tamsin.unit))
    local remove = mock.spy(function(_: string) end)
    mock.stub(C_PartyInfo, "UninviteUnit", remove)
    choose(menu, "Remove from group")
    expect(remove).toHaveBeenCalledWith(assert(tamsin.unit))
    choose(menu, "Ignore")
    -- an assistant: Demote
    tamsin.assistant = true
    member(tamsin, "RightButton", page)
    expect(menu["Demote from assistant"] ~= nil).toBe(true)
    local demote = mock.spy(function(_: string) end)
    mock.stub(_G, "DemoteAssistant", demote)
    choose(menu, "Demote from assistant")
    expect(demote).toHaveBeenCalled()
    -- yourself: no whisper; a left click: no menu
    member(me, "RightButton", page)
    expect(menu["Whisper"]).toBeNil()
    member(tamsin, "LeftButton", page)
    -- the buttons: ready check, role check, convert, plan
    local ready = mock.spy(function() end)
    mock.stub(_G, "DoReadyCheck", ready)
    assert(page.onReadyCheck)()
    expect(ready).toHaveBeenCalled()
    local roles = mock.spy(function() end)
    mock.stub(_G, "InitiateRolePoll", roles)
    assert(page.onRoleCheck)()
    expect(roles).toHaveBeenCalled()
    local convert = mock.spy(function() end)
    mock.stub(C_PartyInfo, "ConvertToRaid", convert)
    assert(page.onConvert)()
    expect(convert).toHaveBeenCalled()
    local planned = mock.spy(function() end)
    -- a planner as a plugin would provide it
    services.provide("raidplanner", { Toggle = planned }, "SocialTest")
    assert(page.onPlan)()
    services.unregister("SocialTest")
    expect(planned).toHaveBeenCalled()
    -- the roster's changes: drawn again
    mock.fireEvent("PARTY_LEADER_CHANGED")
    mock.advanceTime(0.2)
end

@test("Raid Info: your lockouts in a panel beside the window; none")
local function lockouts()
    mock.stub(_G, "GetNumSavedInstances", function(): number return 2 end)
    mock.stub(_G, "GetSavedInstanceInfo", function(i: number): (string, number, number, number, boolean, boolean, number, boolean, number, string, number, number, boolean, number)
        if i == 1 then return "Molten Core", 1, 3 * 86400, 9, true, false, 0, true, 40, "40 Player", 10, 3, false, 409 end
        return "The Stockade", 2, 0, 1, false, false, 0, false, 5, "Normal", 6, 6, false, 34
    end)
    local list = M:Lockouts()
    expect(#list).toBe(1)
    expect(list[1].name).toBe("Molten Core")
    openTab("RaidList")
    assert(assert(M.raidPage).onRaidInfo)()
    local p = assert(M.lockouts)
    expect(p.panel:IsShown()).toBe(true)
    expect(p.rows[1].name:GetText()).toBe("Molten Core")
    expect(p.rows[1].progress:GetText()).toBe("3 / 10")
    expect((p.rows[1].detail:GetText() or ""):find("40 Player", 1, true)).toBe(1)
    mock.fireEvent("UPDATE_INSTANCE_INFO")
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
    -- extended, no bosses counted
    mock.stub(_G, "GetSavedInstanceInfo", function(_: number): (string, number, number, number, boolean, boolean, number, boolean, number, string, number, number, boolean, number)
        return "Onyxia's Lair", 3, 0, 9, false, true, 0, true, 40, "", 0, 0, false, 249
    end)
    M:DrawLockouts()
    expect(p.rows[1].detail:GetText()).toBe("extended")
    mock.stub(_G, "GetNumSavedInstances", function(): number return 0 end)
    M:DrawLockouts()
    expect(p.empty:IsShown()).toBe(true)
    M:ToggleLockouts()
    expect(p.panel:IsShown()).toBe(false)
end

@test("/suu raidtest: 17 made-up members to drag around; again to end it")
local function testRaid()
    openTab("RaidList")
    mock.stub(M, "Print", function(_: unknown, _: string) end)
    mock.slash("/suu raidtest")
    expect(#M:RaidMembers()).toBe(17)
    local page = assert(M.raidPage)
    assert(page.onMove)(2, 8)
    expect(assert(M.raidTest)[2].group).toBe(8)
    assert(page.onSwap)(2, 3)
    expect(assert(M.raidTest)[2].group).toBe(assert(M.raidTest)[2].group)
    mock.slash("/suu raidtest")
    expect(M.raidTest).toBeNil()
end

@test("a probe that shows Blizzard's own social pages: SuuUI's step aside")
local function probeAside()
    mock.stub(SuuUI, "ProbeShowsBlizzardSocial", function(): boolean return true end)
    open()
    M:Follow()
    expect(M.view).never.toBeShown()
    expect(friendsList():GetAlpha()).toBe(1)
end
