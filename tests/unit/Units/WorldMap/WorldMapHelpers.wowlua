-- tests/unit/Units/WorldMap/WorldMapHelpers.wowlua
-- The world map tests' world (Units/WorldMap and its parts): SuuUI's quest
-- and place data, small stand-ins so each kind of pin is known exactly
-- (the real data kept for the one test that reads it), Map filters with
-- every filter on, each test's start and end, and the pins a map would
-- show or shows, by name.
--
--   @beforeEach local function data() world.setup() end
--   @afterEach local function cleanup() world.cleanup() end

import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import type QuestStarts from "/Data/QuestStarts"
import type MapPlaces from "/Data/MapPlaces"
import internal M from "/Units/WorldMap"
import forgetQuests from "/Units/WorldMap/Collect"
import * as lazyData from "/Core/Data"
import type Item, Group, TipLine from "/Units/WorldMap/Arrange"
import expectNoErrors from "../../../helpers"

export const ELWYNN = 1429

-- SuuUI's quest data, small: a giver with two quests (one a group's), a
-- repeatable one, one far above you; a quest from an item two mobs drop;
-- three entrances (one the Horde's); a walking giver.
-- (`flags.patrol`: a giver whose quest's group tag the game tells late;
-- `flags.crowd`: a second giver beside the first)
export const flags = { patrol = false, crowd = false }
local function giverRows(): number[][]
    local rows: number[][] = { { 50, 50, 101, 9001, 9005 }, { 51.5, 50, 102, 9002 }, { 80, 80, 103, 9004 } }
    if flags.patrol then
        rows[#rows + 1] = { 20, 80, 105, 9007 }
    end
    if flags.crowd then
        rows[#rows + 1] = { 50.3, 50.2, 106, 9008 }
    end
    return rows
end
export function starts(): QuestStarts
    return {
        quests = {
            [9001] = { "Wolves Across the Border", 1, 2 },
            [9002] = { "Boar Hides", 1, 1, nil, nil, nil, nil, nil, nil, 1 },
            [9003] = { "A Torn Scroll", 1, 1 },
            [9004] = { "The Fallen Hero", 1, 30 },
            [9005] = { "The Kobold Lord", 1, 2 },
            [9007] = { "Elite Patrol", 1, 2 },
            [9008] = { "The Lost Necklace", 1, 1 },
        },
        objectives = { [9001] = "Kill 8 wolves for $N." },
        tags = { [9005] = 81 },
        group = { [9005] = "dungeon", [9007] = "elite" },
        maps = { [ELWYNN] = giverRows() },
        drops = { [ELWYNN] = { { 30, 30, 104, 7001, 9003 }, { 35, 30, -5, 7001, 9003 } } },
        items = { [7001] = "A Torn Scroll" },
        givers = {
            [101] = "Marshal Dughan",
            [102] = "Farmer Saldean",
            [103] = "A Guard",
            [104] = "Kobold Worker",
            [105] = "Sergeant Willem",
            [106] = "Farmer Furlbrow",
