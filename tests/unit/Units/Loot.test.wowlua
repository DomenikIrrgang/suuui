-- Units/Loot: SuuUI's loot window. What the corpse holds (items, money as
-- copper, a money line it can't read), whose loot, beside the cursor or at
-- its place, auto loot, taking, linking, tooltips, closing; Blizzard's frame
-- off screen. (The rolls: Units/LootRolls.) The client's loot API is stubbed.

import test, expect, beforeEach, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as registry from "/SettingsUI/Registry"
import * as editMode from "/EditMode/EditMode"
import unregisterCommands from "/Core/Init"
import expectNoErrors, newParent from "../../helpers"

import internal M from "/Units/Loot"
import type LootWindow, LootRow from "/UI/Loot"
import * as frames from "wowlua:frames"
import migrations as settingMigrations from "/Core/Settings"
import type Profile from "/Core/Settings"

local MONEY = (Enum.LootSlotType and Enum.LootSlotType.Money) or 2

-- The corpse: { icon, name, count, quality, locked, kind, link } per slot.
type CorpseSlot = {
    icon?: number,
    name: string,
    count: number,
    quality?: number,
    locked?: boolean,
    kind?: number,
    link?: string,
}
local corpse: CorpseSlot[] = {}

local function fakeLoot()
    mock.stub(_G, "GetNumLootItems", function(): number
        return #corpse
    end)
    mock.stub(_G, "GetLootSlotInfo", function(slot: number): ...unknown
        local s = corpse[slot]
        return s.icon, s.name, s.count, nil, s.quality, s.locked
    end)
    mock.stub(_G, "GetLootSlotType", function(slot: number): number
        return corpse[slot].kind or 1
    end)
    mock.stub(_G, "GetLootSlotLink", function(slot: number): string?
        return corpse[slot].link
    end)
end

@beforeEach
local function start()
    corpse = {
        { icon = 134367, name = "Worn Pelt", count = 2, quality = 1, link = "item:2318" },
        { icon = 135033, name = "Dusk Mantle", count = 1, quality = 2, link = "item:4704" },
        { icon = 133784, name = "42 Silver\n3 Copper", count = 0, kind = MONEY },
    }
    fakeLoot()
end

@afterEach
local function cleanup()
    if M:Shown() then
        mock.fireEvent("LOOT_CLOSED")
    end
    M:Reset("atCursor")
    M:Reset("position")
    mock.advanceTime(40)
    expectNoErrors()
end

local function win(): LootWindow
    return assert(M.window)
end

--------------------------------------------------------------------------------
-- The loot window
--------------------------------------------------------------------------------

@test("what the corpse holds: items with their counts and qualities, money in copper")
local function items()
    local list = M:Items()
    expect(#list).toBe(3)
    expect(list[1]).toEqual({
        index = 1,
        icon = 134367,
        label = "Worn Pelt",
        count = 2,
        quality = "common",
        locked = false,
    })
    expect(list[2].quality).toBe("uncommon")
    expect(list[3].copper).toBe(4203)
    expect(list[3].count).toBe(nil)
    corpse[3].name = "A pouch\nof something" -- money it can't read: the text in one line
    expect(M:Items()[3].label).toBe("A pouch of something")
    corpse[1].icon = nil -- an emptied slot
    expect(#M:Items()).toBe(2)
    mock.stub(_G, "GetNumLootItems", function(): unknown
        return mock.secret(3)
    end)
    expect(M:Items()).toEqual({})
end

@test("opened beside the cursor with the first item under it, or at its own place")
local function placed()
    mock.setCursorPosition(400, 300)
    mock.fireEvent("LOOT_OPENED", false, false)
    expect(win()).toBeShown()
    local p, rel = win():GetPoint(1)
    expect(p).toBe("TOPLEFT")
    expect(rel).toBe(UIParent)
    mock.fireEvent("LOOT_CLOSED")
    expect(win()).never.toBeShown()
    M:Set("atCursor", false)
    mock.fireEvent("LOOT_OPENED", false, false)
    expect((select(2, win():GetPoint(1)))).toBe(SuuUI.Root)
end

@test("whose loot: Fishing, the dead target, or nothing")
@cases({ { "fishing", "Fishing" }, { "target", "Ember Hound" }, { "other", "" } })
local function source(kind: string, shown: string)
    mock.stub(_G, "IsFishingLoot", function(): boolean
        return kind == "fishing"
    end)
    local hound = mock.spawnUnit({
        name = "Ember Hound",
        reaction = "hostile",
        guid = "Creature-0-0-0-0-123-0000000001",
    })
    mock.player:target(hound)
    mock.stub(_G, "GetLootSourceInfo", function(_: number): unknown
        return kind == "target" and UnitGUID("target") or "Creature-0-0-0-0-9-0000000009"
    end)
    local said: string? = nil
    mock.stub(win(), "SetSource", function(_: unknown, s: string)
        said = s
    end)
    mock.fireEvent("LOOT_OPENED", false, false)
    expect(said).toBe(shown)
end

@test("auto loot: the window only for what stays behind; an empty corpse opens nothing")
local function autoLoot()
    mock.fireEvent("LOOT_OPENED", true, false)
    expect(win()).never.toBeShown()
    mock.advanceTime(0.31)
    expect(win()).toBeShown()
    mock.fireEvent("LOOT_CLOSED")
    corpse = {}
    mock.fireEvent("LOOT_OPENED", true, false)
    mock.advanceTime(0.31)
    expect(win()).never.toBeShown()
end

@test("a click takes the item; a modified click links it; a slot taken updates the list; ✕ closes the loot")
local function taking()
    mock.fireEvent("LOOT_OPENED", false, false)
    local took = mock.stub(_G, "LootSlot", function(_: number) end)
    assert(win().onClick)(1, "LeftButton")
    expect(took).toHaveBeenCalledWith(1)
    mock.stub(_G, "IsModifiedClick", function(_: string?): boolean
        return true
    end)
    local link = mock.stub(_G, "HandleModifiedItemClick", function(_: string): boolean
        return true
    end)
    assert(win().onClick)(2, "LeftButton")
    expect(link).toHaveBeenCalledWith("item:4704")
    expect(took).toHaveBeenCalledTimes(1)
    table.remove(corpse, 1)
    local set = mock.stub(win(), "SetItems", win().SetItems)
    mock.fireEvent("LOOT_SLOT_CLEARED", 1)
    expect(set).toHaveBeenCalledTimes(1)
    local close = mock.stub(_G, "CloseLoot", function() end)
    assert(win().onClose)()
    expect(close).toHaveBeenCalledTimes(1)
end

@test("a row's tooltip: the item's, the currency's, none for money")
local function tooltips()
    mock.fireEvent("LOOT_OPENED", false, false)
    local row = CreateFrame("Button", nil, UIParent) :: LootRow
    local item = mock.stub(GameTooltip, "SetLootItem", function(_: unknown, _: number) end)
    assert(win().onEnter)(1, row)
    expect(item).toHaveBeenCalledTimes(1)
    assert(win().onEnter)(3, row)
    expect(GameTooltip).never.toBeShown()
    corpse[2].kind = (Enum.LootSlotType and Enum.LootSlotType.Currency) or 3
    local currency = mock.stub(GameTooltip, "SetLootCurrency", function(_: unknown, _: number) end)
    assert(win().onEnter)(2, row)
    expect(currency).toHaveBeenCalledTimes(1)
    assert(win().onLeave)(0, row)
    expect(GameTooltip).never.toBeShown()
end

@test("Blizzard's loot frame stays out of sight, however the game places it")
local function blizzardAway()
    local f = assert(frames.find("LootFrame"))
    expect(f:GetAlpha()).toBe(0)
    f:ClearAllPoints()
    f:SetPoint("CENTER")
    mock.advanceTime(0.01)
    expect((f:GetPoint(1))).toBe("BOTTOMRIGHT")
    f:Hide()
    f:Show()
    expect(f:GetAlpha()).toBe(0)
end

@test("the settings preview: a made-up corpse")
local function preview()
    local s = registry.get("loot") :: registry.Section
    local view = (s.preview :: (parent: Frame) -> Frame)(newParent(300, 300))
    expect(view).toBe(M:PreviewView(newParent(300, 300)))
end

@test("set up again after a reload; turned off, the window closes")
local function reloaded()
    registry.unregister(M)
    editMode.unregister(M)
    unregisterCommands(M)
    M:OnEnable()
    mock.fireEvent("LOOT_OPENED", false, false)
    expect(win()).toBeShown()
    M:OnDisable()
    expect(win()).never.toBeShown()
end

@test("Rolls in the notification stack switched off: the Loot rolls module starts off (once)")
local function rollsMigration()
    local found = false
    for _, m in ipairs(settingMigrations()) do
        if m.namespace == "loot" and m.id == "rolls" then
            found = true
            local off: { [string]: unknown } = { rolls = false, atCursor = false }
            local profile: Profile = { loot = off }
            m.fn(off, profile)
            expect(off.rolls).toBeNil()
            expect(off.atCursor).toBe(false)
            expect(profile.lootrolls).toEqual({ enabled = false })
            -- on (the old default): the tray stays as it is
            local on: { [string]: unknown } = { rolls = true }
            local other: Profile = { loot = on, lootrolls = { results = false } }
            m.fn(on, other)
            expect(on.rolls).toBeNil()
            expect(other.lootrolls).toEqual({ results = false })
        end
    end
    expect(found).toBe(true)
end
