import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import internal M from "/Units/Professions"

local function try(name: string, fn: () -> ...any)
    print(name, pcall(fn))
end

@test("probe")
local function probe()
    print("view", M.view, _G.ProfessionsFrame)
    try("profs", function() return GetProfessions() end)
    try("ready", function() return C_TradeSkillUI.IsTradeSkillReady() end)
    try("open", function() mock.player:openTradeSkill(2018, "Blacksmithing") end)
    mock.advanceTime(2)
    print("view", M.view, _G.ProfessionsFrame, M.mode)
    try("profs", function() return GetProfessions() end)
    try("pinfo", function() return GetProfessionInfo((GetProfessions())) end)
    try("ready", function() return C_TradeSkillUI.IsTradeSkillReady() end)
    try("base", function() local b = C_TradeSkillUI.GetBaseProfessionInfo(); return b and b.professionName, b and b.professionID, b and b.skillLevel end)
    try("ids", function() return #C_TradeSkillUI.GetAllRecipeIDs() end)
    local ids = C_TradeSkillUI.GetAllRecipeIDs()
    try("info", function() local i: any = C_TradeSkillUI.GetRecipeInfo(ids[1]); return i.name, i.categoryID, i.learned, i.relativeDifficulty, i.hyperlink end)
    try("sch", function() local s: any = C_TradeSkillUI.GetRecipeSchematic(ids[1], false); return s.outputItemID, #s.reagentSlotSchematics end)
    try("cat", function() local i: any = C_TradeSkillUI.GetRecipeInfo(ids[1]); local c: any = C_TradeSkillUI.GetCategoryInfo(i.categoryID); return c.name, c.parentCategoryID, c.type end)
    try("req", function() return C_TradeSkillUI.GetRecipeRequirements(ids[1]) end)
    try("cd", function() return C_TradeSkillUI.GetRecipeCooldown(ids[1]) end)
    try("tracked", function() return C_TradeSkillUI.IsRecipeTracked(ids[1], false) end)
    try("min", function() return C_Minimap.GetNumTrackingTypes() end)
    try("visible", function() return M.view and M.view:IsVisible() end)
    expect(1).toBe(2)
end
