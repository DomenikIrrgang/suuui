-- Units/Mail: SuuUI's mail window over the game's (kept open, out of
-- sight), on the emulated mailbox. The inbox (each mail's sender, subject,
-- days left, money, items or COD; read and unread), the open mail (its text,
-- an invoice's lines, attachments, money, COD, Reply, Delete, Return),
-- taking (COD asks; not enough money; the inbox moving before the answer:
-- only the mail asked about, at its amount), rows and the open mail found
-- again after the inbox moved (Delete, Return, a click, a modified click),
-- Collect all and Collect money through the window (COD and a game
-- master's never taken, the game's refusal told, the player taking over;
-- the run itself: Mail/Collect), sending (what Send needs, money
-- or COD, attachments naming the subject, success, failure, a cancelled
-- confirmation, never stuck), To's suggestions (your characters, recent,
-- the guild; arrows, Enter, Tab, a click), the Sent list, /suu mailsuggest;
-- the inbox kept per character (SuuUI.Holdings' "mail"), off and on.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import expectNoErrors, captureConfirm from "../../helpers"
import type Confirms from "../../helpers"
import printedSince, printedCount, hasLine, themeChanged, tokenOf from "../SettingsUI/UiSettingsHelpers"
import internal M from "/Units/Mail"
import type MailRow, OpenMail, SendForm, Inbox, Sent, SuggestList from "/Units/Mail"
import type Left from "/Units/Mail/Collect"
import type WindowFrame from "/UI/Panel"
import type ConfirmOptions from "/UI/Panel"
import type TooltipData from "/UI/Tooltip"
import * as frames from "wowlua:frames"
import SuuUI from "/Core/API"
import confirm from "/UI/Panel"
import * as events from "/Core/Events"
import * as settings from "/Core/Settings"
import * as realm from "/Core/Realm"
import internal ownOf from "/Core/Modules"

const LISTENER = { name = "MailTest" }

local WATER, TOME = 990011, 990012
mock.defineItem(WATER, { name = "Test Water", quality = 1, stackCount = 20, icon = 134400 }, { cached = true })
mock.defineItem(TOME, { name = "Test Tome", quality = 3, stackCount = 1, icon = 133744 }, { cached = true })

local confirms: Confirms? = nil
local box: mock.MockUnit? = nil

type Letter = { [string]: unknown }
local function letters(): Letter[]
    return {
        {
            sender = "Tamsin",
            subject = "Hello",
            money = 5000,
            daysLeft = 2.5,
            wasRead = false,
            text = "Hi there",
            canReply = true,
        },
        {
            sender = "Ashford",
            subject = "Supplies",
            items = { { id = WATER, count = 5 } },
            daysLeft = 20,
            wasRead = true,
            canReply = true,
        },
        {
            sender = "Tester",
            subject = "Pay up",
            cod = 20000,
            items = { { id = TOME, count = 1 } },
            daysLeft = 0.5,
            wasRead = true,
        },
        {
            sender = "Auction House",
            subject = "Auction successful",
            money = 9000,
            daysLeft = 29,
            wasRead = true,
            invoice = { "seller", "Test Tome", "Ashford", 10000, 0, 200, 500 },
        },
        { sender = "Game Master", subject = "A note", money = 100, isGM = true, daysLeft = 10, wasRead = true },
    }
end

local function openMailbox(list: Letter[]?)
    local mailbox = box or mock.spawnUnit({ name = "Mailbox", reaction = "neutral" })
    box = mailbox
    mock.defineMailbox(mailbox, { letters = list or letters() })
    mock.player:interact(mailbox)
    mock.advanceTime(0.5)
end

@beforeEach
local function start()
    confirms = captureConfirm()
    mock.player:setMoney(1000000)
    mock.setBag(0, { slots = 20, items = {} })
end

@afterEach
local function cleanup()
    if M.open then
        CloseMail()
    end
    local s = M.send
    if s then
        s.to:SetValue("")
        s.subject:SetValue("")
        s.body:SetText("")
        s.money:Clear()
        s.mode:SetValue("send")
    end
    M.sending, M.pending = false, nil
    local focus: EditBox? = GetCurrentKeyBoardFocus()
    if focus then
        focus:ClearFocus()
    end
    mock.advanceTime(1)
    M:MailData().sent = nil
    expectNoErrors()
end

local function win(): WindowFrame
    return (assert(M.window))
end
local function inbox(): Inbox
    return (assert(M.inbox))
end
local function send(): SendForm
    return (assert(M.send))
end
local function sent(): Sent
    return (assert(M.sent))
end
local function confirmed(): ConfirmOptions
    return assert(confirms).last()
end
local function mailFrame(): Frame
    return (assert(frames.find("MailFrame")))
end

local function row(sender: string): MailRow
    for _, r in ipairs(inbox().rows) do
        if r:IsShown() and r.sender:GetText() == sender then
            return r
        end
    end
    error("no mail from " .. sender)
end

local function pane(): OpenMail
    return inbox().open
end

--------------------------------------------------------------------------------
-- The inbox
--------------------------------------------------------------------------------

@test("the mailbox opens SuuUI's window over the game's; closing it closes the mailbox")
local function opening()
    openMailbox()
    expect(win()).toBeShown()
    expect(mailFrame():GetAlpha()).toBe(0)
    mailFrame():SetPoint("CENTER")
    mock.advanceTime(0.01)
    expect(assert(mailFrame():GetLeft()) > assert(UIParent:GetRight())).toBe(true)
    local close = mock.stub(_G, "CloseMail", function() end)
    win():Hide()
    expect(close).toHaveBeenCalledTimes(1)
end

@test("walking away from the mailbox closes SuuUI's window and stops collecting")
local function walkAway()
    openMailbox()
    mock.stub(_G, "TakeInboxMoney", function(_: number) end)
    mock.click(inbox().collect)
    expect(M:Collecting()).toBe(true)
    -- the game hides the mailbox's interaction (the emulator's mailbox
    -- doesn't close with distance: told here as the game tells it)
    mock.fireEvent("PLAYER_INTERACTION_MANAGER_FRAME_HIDE", Enum.PlayerInteractionType.MailInfo)
    expect(win()).never.toBeShown()
    expect(mailFrame()).never.toBeShown()
    expect(M.open).toBe(false)
    expect(M:Collecting()).toBe(false)
    -- another interaction's hide leaves an open mailbox alone
    openMailbox()
    mock.fireEvent("PLAYER_INTERACTION_MANAGER_FRAME_HIDE", Enum.PlayerInteractionType.Merchant)
    expect(win()).toBeShown()
    expect(M.open).toBe(true)
end

@test("each mail: who from (unread in gilt), the subject, the days left (amber under 3), what it carries")
local function inboxRows()
    openMailbox()
    expect(inbox().count:GetText()).toBe("5 mails")
    local hello = row("Tamsin")
    expect(tokenOf(hello.sender)).toBe("gilt-text")
    expect((hello.right:GetText() or ""):find("2 d", 1, true) ~= nil).toBe(true)
    expect((hello.right2:GetText() or ""):find("50", 1, true) ~= nil).toBe(true)
    expect(row("Ashford").right2:GetText()).toBe("1 item")
    expect((row("Tester").right2:GetText() or ""):find("COD", 1, true) ~= nil).toBe(true)
    expect((row("Tester").right:GetText() or ""):find("12 h", 1, true) ~= nil).toBe(true)
    expect(inbox().none).toBeShown()
    mock.hover(hello)
    expect(hello.hl).toBeShown()
    mock.hover(nil)
    expect(hello.hl).never.toBeShown()
end

@test("an empty mailbox says so; more mail than the inbox holds says how many wait")
local function empty()
    openMailbox({})
    expect(inbox().empty).toBeShown()
    expect(inbox().count:GetText()).toBe("0 mails")
    mock.stub(_G, "GetInboxNumItems", function(): (number, number)
        return 0, 3
    end)
    M:Refresh()
    expect(inbox().count:GetText()).toBe("0 mails, 3 more once these are gone")
end

--------------------------------------------------------------------------------
-- The open mail
--------------------------------------------------------------------------------

@test("a click opens a mail: its subject, who from, the text, its money to take; Reply fills Send")
local function opened()
    openMailbox()
    mock.click(row("Tamsin"))
    local p = pane()
    expect(p).toBeShown()
    expect(p.subject:GetText()).toBe("Hello")
    expect(p.from:GetText()).toBe("From Tamsin")
    expect(p.body:GetText()).toBe("Hi there")
    expect(p.moneyRow).toBeShown()
    expect(p.delete:IsEnabled()).toBe(false)
    expect((p.delete.tooltip :: TooltipData).description).toBe("Take what's attached first.")
    local take = mock.stub(_G, "TakeInboxMoney", function(_: number) end)
    mock.click(p.takeMoney)
    expect(take).toHaveBeenCalledWith(1)
    mock.click(p.reply)
    expect(send().to:GetValue()).toBe("Tamsin")
    expect(send().subject:GetValue()).toBe("RE: Hello")
end

@test("an invoice: what sold, to whom, for how much, the deposit, the cut and what you got")
local function invoice()
    openMailbox()
    mock.click(row("Auction House"))
    local text = pane().body:GetText() or ""
    expect(text:find("Item sold: Test Tome", 1, true) ~= nil).toBe(true)
    expect(text:find("Buyer: Ashford", 1, true) ~= nil).toBe(true)
    expect(text:find("Amount received: ", 1, true) ~= nil).toBe(true)
    mock.stub(_G, "GetInboxInvoiceInfo", function(
        _: number
    ): (string?, string?, string?, number, number, number, number, number, number, number, number, boolean)
        return "buyer", "Test Water", "Tamsin", 300, 0, 0, 0, 0, 0, 0, 0, false
    end)
    M:Refresh()
    expect((pane().body:GetText() or ""):find("Item bought: Test Water", 1, true) ~= nil).toBe(true)
end

@test("attachments: shown, their tooltip, a click takes one, a modified click links it")
local function attachments()
    openMailbox()
    mock.click(row("Ashford"))
    local slot = pane().slots[1]
    expect(slot).toBeShown()
    local tip = mock.stub(GameTooltip, "SetInboxItem", function(_: unknown, _: number, _: number) end)
    mock.hover(slot)
    expect(tip).toHaveBeenCalledWith(GameTooltip, 2, 1)
    mock.hover(nil)
    local took = mock.stub(_G, "TakeInboxItem", function(_: number, _: number) end)
    mock.click(slot)
    expect(took).toHaveBeenCalledWith(2, 1)
    mock.stub(_G, "IsModifiedClick", function(_: string?): boolean
        return true
    end)
    local link = mock.stub(_G, "HandleModifiedItemClick", function(_: string): boolean
        return true
    end)
    mock.click(slot)
    expect(link).toHaveBeenCalledTimes(1)
    expect(took).toHaveBeenCalledTimes(1)
end

@test("cash on delivery: asked first; without the money, told so")
local function cod()
    openMailbox()
    mock.click(row("Tester"))
    expect(pane().codRow).toBeShown()
    local took = mock.stub(_G, "TakeInboxItem", function(_: number, _: number) end)
    mock.click(pane().slots[1])
    expect(confirmed().title).toBe("Pay cash on delivery?")
    assert(confirmed().onConfirm)(nil)
    expect(took).toHaveBeenCalledWith(3, 1)
    mock.player:setMoney(100)
    mock.click(pane().slots[1])
    expect(confirmed().title).toBe("Not enough money")
end

-- A confirmation's text without its colours.
local function plain(text: string?): string
    return ((text or ""):gsub("|c%x%x%x%x%x%x%x%x", ""):gsub("|r", ""))
end

local function codBox(): Letter[]
    return {
        { sender = "Tamsin", subject = "Hello", money = 5000, daysLeft = 9 },
        { sender = "Tester", subject = "Pay up", cod = 20000, items = { { id = TOME, count = 1 } }, daysLeft = 3 },
    }
end
local function otherCod(): Letter
    return { sender = "Tester", subject = "Pay up", cod = 50000, items = { { id = WATER, count = 5 } }, daysLeft = 30 }
end

@test("COD: the inbox changes before the confirmation; the mail asked about is taken, at the amount shown")
local function codShifted()
    openMailbox(codBox())
    mock.click(row("Tester"))
    mock.click(pane().slots[1])
    expect(plain(confirmed().text)).toBe("Pay 2g to Tester for Test Tome?")
    -- Tamsin's mail deleted, two new ones at the top (one COD from the same sender)
    local list = codBox()
    mock.defineMailbox(assert(box), {
        letters = { otherCod(), { sender = "Ashford", subject = "New", money = 10, daysLeft = 30 }, list[2] },
    })
    mock.fireEvent("MAIL_INBOX_UPDATE")
    local take = TakeInboxItem
    local took = mock.stub(_G, "TakeInboxItem", function(i: number, a: number)
        take(i, a)
    end)
    assert(confirmed().onConfirm)(nil)
    expect(took).toHaveBeenCalledTimes(1)
    expect(took).toHaveBeenCalledWith(3, 1)
    mock.advanceTime(1)
    expect(C_Item.GetItemCount(TOME)).toBe(1)
    expect(C_Item.GetItemCount(WATER)).toBe(0)
end

@test("COD: the mail gone or another amount by the confirmation, or the mailbox closed: nothing taken")
local function codGone()
    openMailbox(codBox())
    mock.click(row("Tester"))
    mock.click(pane().slots[1])
    -- the same sender's other COD now where it was, the one asked about gone
    mock.defineMailbox(assert(box), { letters = { codBox()[1], otherCod() } })
    mock.fireEvent("MAIL_INBOX_UPDATE")
    local took = mock.stub(_G, "TakeInboxItem", function(_: number, _: number) end)
    assert(confirmed().onConfirm)(nil)
    expect(took).toHaveBeenCalledTimes(0)
    expect(inbox().note:GetText()).toBe("That mail changed or is gone: nothing was taken or paid.")
    -- asked, then the money spent elsewhere
    openMailbox(codBox())
    mock.click(row("Tester"))
    mock.click(pane().slots[1])
    mock.player:setMoney(100)
    assert(confirmed().onConfirm)(nil)
    expect(took).toHaveBeenCalledTimes(0)
    expect(inbox().note:GetText()).toBe("Not enough money for the cash on delivery: nothing was taken.")
    mock.player:setMoney(1000000)
    -- asked, then the mailbox closed and opened again
    openMailbox(codBox())
    mock.click(row("Tester"))
    mock.click(pane().slots[1])
    local ask = confirmed()
    CloseMail()
    openMailbox(codBox())
    assert(ask.onConfirm)(nil)
    expect(took).toHaveBeenCalledTimes(0)
end

@test("the question to pay a COD closes with the mailbox; another question stays")
local function codClosed()
    mock.stub(SuuUI.UI, "Confirm", confirm)
    openMailbox(codBox())
    mock.click(row("Tester"))
    mock.click(pane().slots[1])
    local dialog = assert(M.codAsk)
    expect(dialog).toBeShown()
    CloseMail()
    expect(dialog).never.toBeShown()
    expect(M.codAsk).toBe(nil)
    -- the shared dialog asking something else: left alone
    openMailbox(codBox())
    mock.click(row("Tester"))
    mock.click(pane().slots[1])
    local other = confirm({ title = "Something else" })
    CloseMail()
    expect(other).toBeShown()
    other:Hide()
end

@test("Collect all never pays a COD; a COD mail's row never loots it")
local function codUntouched()
    openMailbox(codBox())
    local took = mock.stub(_G, "TakeInboxItem", function(_: number, _: number) end)
    local loot = mock.stub(_G, "AutoLootMailItem", function(_: number) end)
    mock.click(inbox().collect)
    mock.advanceTime(10)
    expect(M:Collecting()).toBe(false)
    expect(took).toHaveBeenCalledTimes(0)
    expect(inbox().collect:IsEnabled()).toBe(false) -- nothing it may take
    mock.stub(_G, "IsModifiedClick", function(_: string?): boolean
        return true
    end)
    mock.click(row("Tester"))
    expect(loot).toHaveBeenCalledTimes(0)
end

@test("a row clicked after the inbox moved opens (and loots) the mail it showed, not what is there now")
local function rowShifted()
    openMailbox(codBox())
    local tamsin = row("Tamsin")
    local list = codBox()
    mock.defineMailbox(assert(box), { letters = { otherCod(), list[1], list[2] } })
    mock.stub(_G, "IsModifiedClick", function(_: string?): boolean
        return true
    end)
    local loot = mock.stub(_G, "AutoLootMailItem", function(_: number) end)
    mock.click(tamsin) -- drawn as Tamsin's at 1; the other COD is there now
    expect(loot).toHaveBeenCalledTimes(1)
    expect(loot).toHaveBeenCalledWith(2)
    expect(M.openIndex).toBe(2)
    expect(pane().from:GetText()).toBe("From Tamsin")
    -- a row whose mail is gone opens nothing
    local stale = inbox().rows[3] -- (drawn again: the 20g COD, now at 3)
    expect(stale.sender:GetText()).toBe("Tester")
    mock.defineMailbox(assert(box), { letters = { otherCod() } })
    mock.click(stale)
    expect(loot).toHaveBeenCalledTimes(1)
    expect(M.openIndex).toBe(nil)
    expect(pane()).never.toBeShown()
end

@test("Delete and Return act on the open mail where it is now; a changed one is left alone")
local function deleteShifted()
    local function words(sender: string, money: number?): Letter
        return { sender = sender, subject = "Words", text = "x", money = money, daysLeft = 5, wasRead = true }
    end
    openMailbox({ words("Tamsin"), words("Ashford") })
    mock.stub(_G, "InboxItemCanDelete", function(_: number): boolean
        return true
    end)
    mock.click(row("Ashford"))
    local del = mock.stub(_G, "DeleteInboxItem", function(_: number) end)
    mock.defineMailbox(assert(box), { letters = { words("Partyone"), words("Tamsin"), words("Ashford") } })
    mock.click(pane().delete) -- (not drawn again yet: the pane still shows Ashford's)
    expect(del).toHaveBeenCalledWith(3)
    -- the open mail changed under the pane: nothing done
    mock.stub(_G, "InboxItemCanDelete", function(_: number): boolean
        return false
    end)
    mock.click(row("Tamsin"))
    local ret = mock.stub(_G, "ReturnInboxItem", function(_: number) end)
    mock.defineMailbox(assert(box), { letters = { words("Partyone"), words("Tamsin", 300), words("Ashford") } })
    mock.click(pane().ret)
    expect(ret).toHaveBeenCalledTimes(0)
    expect(inbox().note:GetText()).toBe("That mail changed: nothing was done. Look at it again.")
end

@test("the open mail stays open as things are taken from it, and follows it when the inbox moves")
local function openFollows()
    openMailbox({
        { sender = "Tamsin", subject = "Hello", money = 5000, daysLeft = 9 },
        {
            sender = "Ashford",
            subject = "Bits",
            items = { { id = WATER, count = 5 }, { id = TOME, count = 1 } },
            daysLeft = 9,
        },
    })
    mock.click(row("Ashford"))
    local water = C_Item.GetItemCount(WATER)
    mock.click(pane().slots[1])
    mock.advanceTime(1)
    expect(C_Item.GetItemCount(WATER)).toBe(water + 5)
    expect(pane()).toBeShown()
    expect(pane().from:GetText()).toBe("From Ashford")
    -- Tamsin's gone: Ashford's moves up, still open
    mock.defineMailbox(assert(box), {
        letters = {
            {
                sender = "Ashford",
                subject = "Bits",
                items = { { id = WATER, count = 5, taken = true }, { id = TOME, count = 1 } },
                daysLeft = 9,
            },
        },
    })
    mock.fireEvent("MAIL_INBOX_UPDATE")
    mock.advanceTime(0.1)
    expect(M.openIndex).toBe(1)
    expect(pane().from:GetText()).toBe("From Ashford")
end

@test("Delete for an empty mail, Return for a player's; the open mail goes")
local function deleteReturn()
    openMailbox({
        { sender = "Tamsin", subject = "Just words", text = "x", daysLeft = 5, wasRead = true, canReply = true },
    })
    mock.click(row("Tamsin"))
    local del = mock.stub(_G, "DeleteInboxItem", function(_: number) end)
    mock.stub(_G, "InboxItemCanDelete", function(_: number): boolean
        return true
    end)
    M:Refresh()
    expect(pane().delete:IsEnabled()).toBe(true)
    mock.click(pane().delete)
    expect(del).toHaveBeenCalledWith(1)
    expect(M.openIndex).toBe(nil)
    mock.stub(_G, "InboxItemCanDelete", function(_: number): boolean
        return false
    end)
    mock.click(row("Tamsin"))
    expect(pane().ret).toBeShown()
    local ret = mock.stub(_G, "ReturnInboxItem", function(_: number) end)
    mock.click(pane().ret)
    expect(ret).toHaveBeenCalledWith(1)
end

@test("a modified click on a mail loots it whole, unless it's COD")
local function autoLoot()
    openMailbox()
    mock.stub(_G, "IsModifiedClick", function(_: string?): boolean
        return true
    end)
    local loot = mock.stub(_G, "AutoLootMailItem", function(_: number) end)
    mock.click(row("Ashford"))
    mock.click(row("Tester"))
    expect(loot).toHaveBeenCalledTimes(1)
end

--------------------------------------------------------------------------------
-- Collect all
--------------------------------------------------------------------------------

@test("Collect all takes every money and item, each once the game answered, skipping COD and a game master's")
local function collectAll()
    openMailbox()
    local takeItem, takeMoney = TakeInboxItem, TakeInboxMoney
    local items = mock.stub(_G, "TakeInboxItem", function(i: number, a: number)
        takeItem(i, a)
    end)
    local money = mock.stub(_G, "TakeInboxMoney", function(i: number)
        takeMoney(i)
    end)
    local before = GetMoney()
    local water, tome = C_Item.GetItemCount(WATER), C_Item.GetItemCount(TOME)
    mock.click(inbox().collect)
    expect(inbox().collect.label:GetText()).toBe("Collecting…")
    M:CollectAll(false) -- collecting already: once
    expect(money).toHaveBeenCalledTimes(1)
    mock.advanceTime(10)
    expect(M:Collecting()).toBe(false)
    expect(inbox().collect.label:GetText()).toBe("Collect all")
    expect(money).toHaveBeenCalledTimes(2) -- Tamsin's, the auction's
    expect(items).toHaveBeenCalledTimes(1) -- the water; the COD's tome never
    expect(C_Item.GetItemCount(WATER)).toBe(water + 5)
    expect(C_Item.GetItemCount(TOME)).toBe(tome)
    expect(GetMoney()).toBe(before + 5000 + 9000)
    expect(inbox().note:GetText()).toBe("Collected.")
    -- the COD mail and the game master's as they were
    mock.click(row("Tester"))
    expect(pane().slots[1]).toBeShown()
    expect(row("Game Master").right2:GetText() ~= "").toBe(true)
end

@test("the inbox kept per character: read on a visit and again after Collect all; SuuUI.Holdings' mail, told; the module off: not read, the kept inbox stays")
local function inboxKept()
    local key = assert(M:CharKey())
    M:MailData().inbox = nil
    M.held = {}
    expect(SuuUI.Holdings.Of(key, "mail")).toBeNil()
    local heard: string[] = {}
    events.on("SUUUI_HOLDINGS_CHANGED", function(_, place: string, who: string)
        heard[#heard + 1] = place .. " " .. who
    end, LISTENER)
    openMailbox()
    mock.advanceTime(1)
    expect(heard).toContain("mail " .. key)
    local h = assert(SuuUI.Holdings.Of(key, "mail"))
    expect(h.items).toEqual({ [WATER] = 5, [TOME] = 1 })
    -- Tamsin's, the auction's and the game master's money; the tome's COD
    expect({ h.money, h.cod }).toEqual({ 5000 + 9000 + 100, 20000 })
    expect(assert(M:MailData().inbox).at).toBe(h.seen)
    -- the same holding until the inbox is read again
    expect(SuuUI.Holdings.Of(key, "mail") == h).toBe(true)
    -- Collect all: the money and the water taken, kept again
    mock.click(inbox().collect)
    mock.advanceTime(10)
    local after = assert(SuuUI.Holdings.Of(key, "mail"))
    expect(after.items).toEqual({ [TOME] = 1 })
    expect({ after.money, after.cod }).toEqual({ 100, 20000 })
    events.offAll(LISTENER)
    CloseMail()
    mock.advanceTime(0.5)
    -- off: the place isn't read (no mail anywhere), the kept inbox stays
    local own = ownOf(M)
    own.reloadToToggle = false
    settings.set("mail", "enabled", false)
    expect(SuuUI.Holdings.Kept("mail")).toBe(false)
    expect(SuuUI.Holdings.Of(key, "mail")).toBeNil()
    expect(M:MailData().inbox).never.toBeNil()
    settings.set("mail", "enabled", true)
    own.reloadToToggle = true
    expect(assert(SuuUI.Holdings.Of(key, "mail")).items).toEqual({ [TOME] = 1 })
    M:MailData().inbox = nil
end

@test("Collect all: what the game refuses is left, the rest collected, and the player told why")
local function collectRefused()
    openMailbox()
    local takeItem = TakeInboxItem
    mock.stub(_G, "TakeInboxItem", function(i: number, a: number)
        local _, id = GetInboxItem(i, a)
        if id == WATER then
            C_Timer.After(0.4, function()
                mock.fireEvent("UI_ERROR_MESSAGE", 1, "You can't carry any more of those items.")
                mock.fireEvent("MAIL_FAILED", WATER)
            end)
            return
        end
        takeItem(i, a)
    end)
    local before = GetMoney()
    local n = printedCount()
    mock.click(inbox().collect)
    mock.advanceTime(10)
    expect(M:Collecting()).toBe(false)
    expect(GetMoney()).toBe(before + 5000 + 9000) -- the mails after it too
    expect(inbox().note:GetText()).toBe("1 thing left in the mail: You can't carry any more of those items.")
    local lines = printedSince(n)
    expect(hasLine(lines, "Collect all left 1 thing in the mail:")).toBe(true)
    expect(hasLine(lines, "Test Water x5 from Ashford: You can't carry any more of those items.")).toBe(true)
end

@test("a long list of what was left: the first ten in chat, then how many more; reasons differing: see chat")
local function longReport()
    openMailbox()
    local left: Left[] = {}
    for k = 1, 12 do
        left[k] = { sender = "Ashford", name = "Test Water", count = 1, money = false, why = k == 1 and "a" or "b" }
    end
    local n = printedCount()
    M:CollectDone(left, 0)
    expect(inbox().note:GetText()).toBe("12 things left in the mail: see chat")
    local lines = printedSince(n)
    expect(hasLine(lines, "and 2 more")).toBe(true)
    expect(hasLine(lines, "Test Water from Ashford: a")).toBe(true)
    M:CollectDone({}, 0)
    expect(inbox().note:GetText()).toBe("")
end

@test("taking from the open mail stops Collect all first")
local function takeOver()
    openMailbox()
    mock.stub(_G, "TakeInboxMoney", function(_: number) end)
    mock.click(row("Tamsin"))
    mock.click(inbox().collect)
    expect(M:Collecting()).toBe(true)
    mock.click(pane().takeMoney)
    expect(M:Collecting()).toBe(false)
    expect(inbox().note:GetText()).toBe("Collect all stopped.")
end

@test("Collect money takes only the money; a command waiting at the server waits")
local function collectMoney()
    openMailbox({
        {
            sender = "Ashford",
            subject = "Supplies",
            items = { { id = WATER, count = 5 } },
            daysLeft = 20,
            wasRead = true,
        },
    })
    expect(inbox().money:IsEnabled()).toBe(false) -- no money
    openMailbox()
    local pending = true
    mock.stub(C_Mail, "IsCommandPending", function(): boolean
        return pending
    end)
    local took = mock.stub(_G, "TakeInboxMoney", function(_: number) end)
    mock.click(inbox().money)
    mock.advanceTime(0.26)
    expect(took).toHaveBeenCalledTimes(0)
    pending = false
    mock.advanceTime(0.26)
    expect(took).toHaveBeenCalledTimes(1)
    mock.fireEvent("MAIL_CLOSED")
    expect(M:Collecting()).toBe(false)
end

--------------------------------------------------------------------------------
-- Send
--------------------------------------------------------------------------------

local function sendTab()
    openMailbox()
    win():SetTab("send")
end

local function reason(): string?
    local tip = send().go.tooltip
    return tip and (tip :: TooltipData).description
end

@test("Send needs someone, a subject, an attachment for COD, and the money")
local function sendNeeds()
    sendTab()
    local s = send()
    expect(reason()).toBe("Who is it for?")
    s.to:SetValue("Tamsin")
    M:DrawSendState()
    expect(reason()).toBe("Give it a subject.")
    s.subject:SetValue("Hi")
    M:DrawSendState()
    expect(reason()).toBe(nil)
    expect(s.go:IsEnabled()).toBe(true)
    s.mode:SetValue("cod")
    M:DrawSendState()
    expect(reason()).toBe("Cash on delivery needs an amount and an attachment.")
    s.mode:SetValue("send")
    s.money:SetCopper(5000000)
    M:DrawSendState()
    expect(reason()).toBe("You don't have enough money.")
    expect(mock.textOf(s.postage):find("in all", 1, true) ~= nil).toBe(true)
end

@test("Send: money or COD set, the mail sent; on success it's in Sent and the form clears")
local function sending()
    sendTab()
    local s = send()
    s.to:SetValue("Tamsin")
    s.subject:SetValue("Gold")
    s.body:SetText("for you")
    s.money:SetCopper(100)
    M:DrawSendState() -- (Send checks again as you type)
    local out: string[]? = nil
    mock.stub(_G, "SendMail", function(to: string, subject: string, body: string?)
        out = { to, subject, body or "" }
    end)
    local money = mock.stub(_G, "SetSendMailMoney", function(_: number) end)
    mock.click(s.go)
    expect(out).toEqual({ "Tamsin", "Gold", "for you" })
    expect(money).toHaveBeenCalledWith(100)
    expect(s.go.label:GetText()).toBe("Sending…")
    mock.fireEvent("MAIL_SEND_SUCCESS")
    expect(assert(M:MailData().sent)[1].to).toBe("Tamsin")
    expect(s.subject:GetValue()).toBe("")
    -- COD
    s.subject:SetValue("Pay me")
    s.money:SetCopper(100)
    s.mode:SetValue("cod")
    local cod = mock.stub(_G, "SetSendMailCOD", function(_: number) end)
    M:Send()
    expect(cod).toHaveBeenCalledWith(100)
    mock.fireEvent("MAIL_FAILED")
    expect(M.sending).toBe(false)
    expect(#assert(M:MailData().sent)).toBe(1)
end

@test("a cancelled confirmation, or nothing back for 30 s, gives Send back")
local function neverStuck()
    sendTab()
    local s = send()
    s.to:SetValue("Tamsin")
    s.subject:SetValue("x")
    mock.stub(_G, "SendMail", function(_: string, _: string, _: string?) end)
    M:Send()
    mock.fireEvent("SECURE_TRANSFER_CANCEL")
    expect(M.sending).toBe(false)
    M:Send()
    mock.advanceTime(30.1)
    expect(M.sending).toBe(false)
    mock.fireEvent("MAIL_FAILED") -- not sending: nothing
end

@test("attachments: a click or a drop puts the cursor's item in; the first names an empty subject")
local function sendAttach()
    sendTab()
    local s = send()
    local clicked = mock.stub(_G, "ClickSendMailItemButton", function(_: number, _: boolean?) end)
    mock.click(s.slots[1])
    mock.click(s.slots[1], "RightButton")
    mock.script(s.slots[2], "OnReceiveDrag")
    expect(clicked).toHaveBeenCalledTimes(3)
    mock.stub(_G, "HasSendMailItem", function(a: unknown): boolean
        return a == 1
    end)
    mock.stub(_G, "GetSendMailItem", function(_: number): (string, number, number, number, number)
        return "Test Water", 0, 134400, 5, 1
    end)
    M:DrawSendState()
    expect(s.subject:GetValue()).toBe("Test Water")
    local tip = mock.stub(GameTooltip, "SetSendMailItem", function(_: unknown, _: number) end)
    mock.hover(nil) -- (the click left the pointer on it)
    mock.hover(s.slots[1])
    expect(tip).toHaveBeenCalledWith(GameTooltip, 1)
    mock.hover(s.slots[2]) -- empty: no tooltip
    expect(tip).toHaveBeenCalledTimes(1)
    mock.hover(nil)
    -- what goes out is kept for Sent
    s.to:SetValue("Tamsin")
    mock.stub(_G, "SendMail", function(_: string, _: string, _: string?) end)
    M:Send()
    mock.fireEvent("MAIL_SEND_SUCCESS")
    win():SetTab("sent")
    expect(sent().rows[1].sender:GetText()).toBe("To Tamsin")
end

@test("the message counts its characters; a click in its well focuses it")
local function message()
    sendTab()
    local e = send().body
    mock.typeText(e, "hello")
    expect((send().counter:GetText() or ""):find("5 / ", 1, true) ~= nil).toBe(true)
    e:ClearFocus()
    mock.script(send().well, "OnMouseDown", "LeftButton")
    expect(e:HasFocus()).toBe(true)
    mock.pressKey("ESCAPE")
    expect(e:HasFocus()).toBe(false)
end

