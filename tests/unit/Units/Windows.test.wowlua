-- Units/Windows: Blizzard's other windows in SuuUI's look: each skinned as
-- its addon loads (SuuUI's header, Blizzard's frame art away); their tabs
-- as text tabs along the top, the lit one following Blizzard's own: the
-- spells window (its title and key following the tab), Legacy, the social
-- windows, the guild window (with the Guild module's own pages), the group
-- finder (My listing, its gear), the collections (an empty collection
-- greyed), the trainer (while SuuUI's own is off); the world map (its
-- title, a level up, the coordinates, the quest log restyled, enlarged
-- and small); a theme change.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"
import * as errors from "wowlua:errors"
import SuuUI from "/Core/API"
import internal M, WindowsModule, trackEyes, paneTabs, trainerRows from "/Units/Windows"
import type WindowChrome, SkinTab from "/UI/WindowSkin"
import expectNoErrors from "../../helpers"

local field = tbl.field

-- (the spells window's tabs from level 10)
mock.setPlayer({ level = 20 })

-- The windows' addons load on demand: loaded here, as opening them would.
for _, a in ipairs({ "Blizzard_PlayerSpells", "Blizzard_LegacySystem", "Blizzard_Professions", "Blizzard_Communities",
                     "Blizzard_Collections", "Blizzard_GroupFinder_VanillaStyle", "Blizzard_SocialUI", "Blizzard_TrainerUI" }) do
    C_AddOns.LoadAddOn(a)
end

-- A quest to take (placeholder names).
local WOLVES = 90101
local giver = mock.spawnUnit({ name = "Quartermaster Hale", level = 30, reaction = "friendly", distance = 3 })
mock.defineQuest(WOLVES, { title = "Wolves Across the Border", text = "Kill wolves, $N.", objective = "Kill 5 wolves.",
    giver = giver, level = 5, header = "Elwynn Forest",
    objectives = { { text = "Prowler slain, a long objective that wraps onto a second line in the log", required = 5 } } })

local function takeQuest()
    if C_QuestLog.GetLogIndexForQuestID(WOLVES) then return end
    mock.player:interact(giver)
    mock.advanceTime(0.5)
    mock.advanceFrames(3)
    AcceptQuest()
    mock.advanceTime(0.5)
    mock.advanceFrames(3)
end

-- One of the game's windows, loaded above.
local function win(name: string): Frame return assert(frames.find(name)) end
local function part(f: unknown, ...: string): Frame return assert(frames.asFrame(field(f, ...))) end

-- A chrome's tab defs by label, and the lit one's label.
local function tabs(chrome: WindowChrome): { [string]: SkinTab }
    local out: { [string]: SkinTab } = {}
    for _, def in ipairs(chrome.tabs or {}) do out[def.label] = def end
    return out
end

local function tab(chrome: WindowChrome, label: string): SkinTab return assert(tabs(chrome)[label]) end

local function lit(chrome: WindowChrome): string?
    local marker = chrome.tabMarker
    for _, def in ipairs(chrome.tabs or {}) do
        if marker and marker.chosen == def.button then return def.label end
    end
    return nil
end

local function labels(chrome: WindowChrome): string
    local out: string[] = {}
    for _, def in ipairs(chrome.tabs or {}) do out[#out + 1] = def.label end
    return table.concat(out, ", ")
end

local function title(chrome: WindowChrome?): unknown return assert(chrome).title.value end

@afterEach
local function cleanup()
    if InCombatLockdown() then mock.player:leaveCombat() end
    for _, n in ipairs({ "PlayerSpellsFrame", "LegacySystemFrame", "ProfessionsFrame", "FriendsFrame", "SocialUIFrame",
                         "CommunitiesFrame", "LFGParentFrame", "WorldMapFrame", "ClassTrainerFrame", "CollectionsJournal" }) do
        local f = frames.find(n)
        if f and f:IsShown() then HideUIPanel(f) end
    end
    M:Reset("mapEnlarged")
    mock.advanceFrames(2)
    expectNoErrors()
end

@test("each window in SuuUI's look as its addon loads: SuuUI's header, Blizzard's frame art away")
local function skinned()
    for _, chrome in ipairs({ M.spells, M.legacy, M.professions, M.friends, M.social, M.communities, M.groupFinder, M.worldMap,
                              M.collections }) do
        expect(chrome ~= nil).toBe(true)
    end
    expect(part(win("PlayerSpellsFrame"), "NineSlice"):GetAlpha()).toBe(0)
    expect(title(M.professions)).toBe("Professions")
    expect(title(M.friends)).toBe("Social")
    -- a second load: not skinned twice
    local spells = M.spells
    M:SkinAll()
    expect(M.spells).toBe(spells)
end

@test("the spells window: the title and key following the open page (Forever has no tab row)")
local function spells()
    local f = win("PlayerSpellsFrame")
    expect(labels(assert(M.spells))).toBe("Specialization, Talents, Spellbook")
    errors.try(field(_G, "PlayerSpellsUtil", "OpenToSpellBookTab"))
    mock.advanceFrames(2)
    expect(part(f, "TabSystem"):IsShown()).toBe(false)
    expect(title(M.spells)).toBe("Spellbook")
    HideUIPanel(f)
    errors.try(field(_G, "PlayerSpellsUtil", "OpenToClassTalentsTab"))
    mock.advanceFrames(2)
    expect(title(M.spells)).toBe("Talents")
end

@test("the Legacy window: Tree and Challenges; the reward track's tab away while SuuUI's pages have it")
local function legacy()
    local chrome = assert(M.legacy)
    expect(labels(chrome)).toBe("Tree, Challenges")
    ShowUIPanel(win("LegacySystemFrame"))
    mock.advanceFrames(2)
    expect(lit(chrome) ~= nil).toBe(true)
end

@test("the social windows: Contacts and Raid; Forever's own with its four side buttons as tabs")
local function social()
    local friends, own = assert(M.friends), assert(M.social)
    expect(labels(friends)).toBe("Contacts, Raid")
    ShowUIPanel(win("FriendsFrame"))
    mock.advanceFrames(2)
    expect(lit(friends)).toBe("Contacts")
    expect(win("FriendsFrameTab4"):GetAlpha()).toBe(0)
    HideUIPanel(win("FriendsFrame"))
    ShowUIPanel(win("SocialUIFrame"))
    mock.advanceFrames(2)
    expect(labels(own)).toBe("Friends, Recent allies, Requests, Raid")
    expect(lit(own)).toBe("Friends")
    mock.click(tab(own, "Raid").button)
    mock.advanceFrames(2)
    expect(lit(own)).toBe("Raid")
end

@test("the guild window: Chat, Roster, Info and the Guild module's Log; Blizzard's tab not lit over SuuUI's page")
local function guild()
    local ch = assert(M.communities)
    -- (the Guild Master's Settings too)
    expect(labels(ch)).toBe("Chat, Roster, Info, Log, Settings")
    local g = assert(SuuUI.GetModule("guild"))
    ShowUIPanel(win("CommunitiesFrame"))
    mock.advanceFrames(2)
    local shown: string[] = {}
    mock.stub(g, "ShowOwn", function(_: unknown, key: string?)
        mock.setField(g, "ownPage", key)
        shown[#shown + 1] = key or "none"
    end)
    mock.click(assert(M.logTab))
    expect(shown[1]).toBe("log")
    expect(lit(ch)).toBe("Log")
    mock.click(tab(ch, "Roster").button)
    mock.advanceFrames(1)
    expect(shown[2]).toBe("none")
end

@test("the group finder: wider; Browse, List yourself (My listing while listed), Who; its gear opens the settings")
local function groupFinder()
    local f = win("LFGParentFrame")
    local chrome = assert(M.groupFinder)
    expect(f:GetWidth()).toBe(WindowsModule.GROUP_FINDER_SIZE[1])
    expect(labels(chrome)).toBe("Browse, List yourself, Who")
    mock.postLFGListing({ activityIDs = { 799 } })
    mock.advanceTime(2)
    expect(labels(chrome)).toBe("Browse, My listing, Who")
    mock.delistLFG()
    mock.advanceTime(2)
    expect(labels(chrome)).toBe("Browse, List yourself, Who")
    local opened = mock.stub(SuuUI, "OpenSettings", function(_: string) end)
    ShowUIPanel(f)
    mock.advanceFrames(2)
    local gear = assert(M.gear)
    mock.hover(gear)
    mock.hover(nil)
    mock.click(gear)
    expect(opened).toHaveBeenCalledWith("groupfinder")
end

@test("the collections: five text tabs; one the game hides, or with nothing in it, greyed")
local function collections()
    local f = win("CollectionsJournal")
    ShowUIPanel(f)
    mock.advanceFrames(3)
    local ch = assert(M.collections)
    expect(labels(ch)).toBe("Mounts, Pets, Toys, Heirlooms, Appearances")
    expect(assert(tab(ch, "Heirlooms").disabled)()).toBe(true)
    for _, def in ipairs(ch.tabs or {}) do
        local off = def.disabled
        if not (off and off()) and def.button:IsVisible() then
            mock.click(def.button)
            mock.advanceFrames(3)
            expect(lit(ch)).toBe(def.label)
        end
    end
    -- in a fight: left for after it
    mock.player:enterCombat()
    mock.advanceFrames(1)
    M:SetCollectionTabs()
    mock.player:leaveCombat()
    -- the appearances: Items and Sets as text tabs
    local items = frames.asFrame(field(_G, "WardrobeCollectionFrame", "ItemsTab"))
    if items then
        expect(paneTabs[items] ~= nil).toBe(true)
        mock.hover(items)
        mock.hover(nil)
    end
end

@test("the world map: Continent › Zone in the header; a click on it goes up a level")
local function worldMap()
    local f = WorldMapFrame
    mock.moveTo({ mapID = 1429, x = 0.42, y = 0.65 })
    ShowUIPanel(f)
    mock.advanceFrames(3)
    f:SetMapID(1429)
    mock.advanceFrames(1)
    local ch = assert(M.worldMap)
    expect(ch.title.value).toBe("Eastern Kingdoms › Elwynn Forest")
    local up: Frame? = nil
    for _, c in ipairs(frames.children(ch.head)) do
        local _, rel = c:GetPoint(1)
        if rel == ch.title then up = c end
    end
    local button = assert(up)
    mock.hover(button)
    mock.hover(nil)
    mock.click(button)
    expect(f:GetMapID()).toBe(1415)
    -- the coordinates: yours off the map
    mock.advanceTime(0.1)
    expect(assert(M.status):GetAlpha()).toBe(1)
end

@test("the world map enlarged, small, in a fight a theme change waits")
local function mapSize()
    local f = WorldMapFrame
    ShowUIPanel(f)
    mock.advanceFrames(3)
    local big = f:GetWidth()
    local mm = frames.asFrame(field(f, "BorderFrame", "MaximizeMinimizeFrame"))
    if mm then
        mock.click(part(mm, "MinimizeButton"))
        expect(M:Get("mapEnlarged")).toBe(false)
        expect(f:GetWidth() < big).toBe(true)
        mock.click(part(mm, "MaximizeButton"))
        expect(M:Get("mapEnlarged")).toBe(true)
    end
    M:Emit("SUUUI_SETTING_CHANGED", "worldmap", "enlargedSize")
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
end

@test("the quest log beside the map: rows measured for SuuUI's fonts, headers in label ink, a tracked quest's eye, the details' buttons centred")
local function questLog()
    takeQuest()
    local f = WorldMapFrame
    mock.moveTo({ mapID = 1429, x = 0.42, y = 0.65 })
    ShowUIPanel(f)
    mock.advanceFrames(3)
    -- (the log lists the quests of the map shown)
    f:SetMapID(1429)
    errors.tryMethod(f, "SetQuestLogPanelShown", true)
    errors.try(field(_G, "QuestLogQuests_Update"))
    mock.advanceFrames(2)
    local list = win("QuestScrollFrame")
    -- its zone header opened, as you'd click it
    for _, header in ipairs(frames.rows(field(list, "headerFramePool"))) do mock.click(header) end
    mock.advanceFrames(2)
    -- each quest's track box: the eye, shown while it's tracked
    local rows = 0
    for _, row in ipairs(frames.rows(field(list, "titleFramePool"))) do
        rows = rows + 1
        local cb = part(row, "Checkbox")
        local eye = assert(trackEyes[cb])
        expect(eye:IsShown()).toBe(assert(frames.asTexture(field(cb, "CheckMark"))):IsShown())
    end
    expect(rows).toBe(1)
    for _, row in ipairs(frames.rows(field(list, "headerFramePool"))) do
        expect(assert(frames.asButton(row)):GetNormalFontObject()).toBe(assert(M.questFont))
    end
    -- the details: Abandon, Share and Track in one row of equal widths
    errors.try(field(_G, "QuestMapFrame_ShowQuestDetails"), WOLVES)
    mock.advanceFrames(3)
    local d = part(win("QuestMapFrame"), "DetailsFrame")
    if d:IsVisible() then
        expect(part(d, "AbandonButton"):GetWidth()).toBe(part(d, "TrackButton"):GetWidth())
    end
    M:Emit("SUUUI_THEME_CHANGED", "suuui")
end

@test("the map's status line: the cursor's spot over the map, yours off it")
local function status()
    local f = WorldMapFrame
    mock.hover(nil) -- (the mouse away from the map)
    mock.moveTo({ mapID = 1429, x = 0.42, y = 0.65 })
    ShowUIPanel(f)
    mock.advanceFrames(3)
    f:SetMapID(1429)
    local st = assert(M.status)
    mock.advanceTime(0.1)
    mock.advanceFrames(6) -- (it reads the map every 0.05 s)
    expect(st:GetAlpha()).toBe(1)
    local text = assert(frames.fontStrings(st)[1])
    expect((text:GetText() or ""):find("you", 1, true) ~= nil).toBe(true)
    -- the cursor over the map: its spot
    local sc = part(f, "ScrollContainer")
    local scale = sc:GetEffectiveScale()
    mock.setCursorPosition((sc:GetLeft() + sc:GetWidth() / 2) * scale, (sc:GetBottom() + sc:GetHeight() / 2) * scale)
    mock.hover(sc)
    mock.advanceTime(0.1)
    mock.advanceFrames(3)
    local x: number, y: number = f:GetNormalizedCursorPosition()
    expect(text:GetText()).toBe(("%.1f, %.1f"):format(x * 100, y * 100))
    expect(st:GetAlpha()).toBe(1)
    -- off the map, on one you're not on: nothing
    mock.hover(nil)
    f:SetMapID(1414)
    mock.advanceTime(0.1)
    mock.advanceFrames(6)
    expect(st:GetAlpha()).toBe(0)
end

@test("the trainer window restyled while SuuUI's own trainer is off: its rows, headings, price and money")
local function trainer()
    local own = assert(SuuUI.GetModule("trainer"))
    mock.stub(own, "IsEnabled", function(): boolean return false end)
    M:SkinTrainer()
    expect(M.trainer ~= nil).toBe(true)
    local npc = mock.spawnUnit({ name = "Brannoc Ironhand", level = 30, reaction = "friendly" })
    mock.defineTrainer(npc, { greeting = "hi", services = {
        { spell = 90201, name = "Charge", icon = 132337, level = 1, rank = "Rank 1", cost = 100 },
        { spell = 90202, name = "Thunder Clap", icon = 136105, level = 1, rank = "Rank 1", cost = 99999999 },
        { spell = 90203, name = "Battle Shout", icon = 132333, level = 1, rank = "Rank 1", cost = 0 },
    } })
    mock.defineGossip(npc, { text = "hello", options = { { name = "Train me", icon = 132058, gossipOptionID = 7, opens = "trainer" } } })
    npc:setDistance(3)
    mock.player:interact(npc)
    mock.advanceTime(1)
    C_GossipInfo.SelectOption(7)
    mock.advanceTime(1)
    mock.advanceFrames(3)
    local f = win("ClassTrainerFrame")
    expect(f:IsShown()).toBe(true)
    expect(title(M.trainer)).toBe("Brannoc Ironhand")
    -- each row: SuuUI's money, ember while you can't afford it, none when free
    local prices: { [string]: Frame } = {}
    local moneyText: { [string]: FontString } = {}
    for _, b in ipairs(frames.children(part(f, "ScrollBox", "ScrollTarget"))) do
        local row = trainerRows[b]
        local name = frames.asFontString(field(b, "name"))
        local label = name and name:GetText()
        if row and label then
            prices[label] = row.money
            moneyText[label] = row.money.text
        end
    end
    expect(assert(prices["Charge"]):IsShown()).toBe(true)
    expect(assert(prices["Battle Shout"]):IsShown()).toBe(false)
    local r, g, bl = assert(moneyText["Thunder Clap"]):GetTextColor()
    local er, eg, eb = SuuUI.UI.RGBA("ember-text")
    expect(math.abs(r - er) + math.abs(g - eg) + math.abs(bl - eb) < 0.03).toBe(true)
    CloseTrainer()
end
