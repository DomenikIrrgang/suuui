-- Units/AuctionHouse: SuuUI's auction house window over the game's (kept
-- open, out of sight). Opening and closing with the auctioneer; the foot's
-- note; the Ledger's button; the settings; the service's Price; turned off
-- through the registry.
-- Each page's tests are beside this file, in AuctionHouse/ (the parts'
-- test files), on the shared AuctionHouse/AuctionHouseHelpers.

import test, expect, beforeEach, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import * as events from "/Core/Events"
import expectNoErrors, holdings, NOTHING from "../../helpers"
import * as coreSettings from "/Core/Settings"
import * as modules from "/Core/Modules"
import internal ownOf from "/Core/Modules"
import internal M, SECTION from "/Units/AuctionHouse"
import AUCTION_HOUSE from "/Core/ServiceKeys"
import type LedgerOpenOptions from "/Core/API"
import CHARM, buy, setUp, tearDown, open, win, gameFrame, note, replicate from "./AuctionHouse/AuctionHouseHelpers"

local AH = C_AuctionHouse

@beforeEach
local function start()
    setUp()
end

@afterEach
local function cleanup()
    tearDown()
end

--------------------------------------------------------------------------------
-- Opening and closing
--------------------------------------------------------------------------------

@test("an auctioneer opens SuuUI's window on Buy, over the game's (out of sight); closing either closes both")
local function opening()
    open()
    expect(win()).toBeShown()
    expect(M.tab).toBe("buy")
    expect(gameFrame():GetAlpha()).toBe(0)
    expect(gameFrame():GetLeft() > UIParent:GetRight()).toBe(true)
    -- the game placing its frame again: off screen again
    gameFrame():ClearAllPoints()
    gameFrame():SetPoint("CENTER")
    mock.advanceTime(0.01)
    expect(gameFrame():GetLeft() > UIParent:GetRight()).toBe(true)
    -- the window's close: the house closes
    win():Hide()
    mock.advanceTime(1)
    expect(M.open).toBe(false)
    expect(gameFrame()).never.toBeShown()
    -- the house closing: the window goes
    open()
    AH.CloseAuctionHouse()
    mock.advanceTime(1)
    expect(win()).never.toBeShown()
    -- placed while the module is off: left be
    open()
    mock.stub(M, "IsEnabled", function()
        return false
    end)
    gameFrame():SetPoint("CENTER")
    mock.advanceTime(0.01)
    expect(gameFrame():GetAlpha()).toBe(0)
end

@test("the Ledger's button at the tab row's right opens it beside the window; there while the Ledger has a window")
local function ledgerButton()
    -- (the Ledger's window as its service gives it: not in this build)
    local svc = assert(SuuUI.UseService(SuuUI.Services.LEDGER))
    local had = svc.Open
    local asked: { view?: string, opts?: LedgerOpenOptions }[] = {}
    svc.Open = function(view: string?, opts: LedgerOpenOptions?)
        asked[#asked + 1] = { view = view, opts = opts }
    end
    open()
    local b = assert(M.ledgerButton)
    local row = assert(win().tabRow)
    expect(b).toBeShown()
    expect(b:GetParent()).toBe(row)
    local point, rel, relPoint = b:GetPoint(1)
    expect({ point, relPoint }).toEqual({ "RIGHT", "RIGHT" })
    expect(rel).toBe(row)
    expect(b.label:GetText()).toBe("Ledger")
    mock.click(b)
    expect(#asked).toBe(1)
    expect(asked[1].view).toBeNil()
    expect(assert(asked[1].opts).beside).toBe(win())
    -- the Ledger off: no button
    coreSettings.set("ledger", "enabled", false)
    mock.advanceTime(0.1)
    expect(b).never.toBeShown()
    coreSettings.set("ledger", "enabled", true)
    mock.advanceTime(0.1)
    -- no window to open: none either
    local again = assert(SuuUI.UseService(SuuUI.Services.LEDGER))
    again.Open = nil
    M:DrawLedgerButton()
    expect(b).never.toBeShown()
    again.Open = had
    M:DrawLedgerButton()
end

@test("the game's errors, a failed search and money changes show in the foot")
local function feet()
    open()
    mock.fireEvent("AUCTION_HOUSE_SHOW_ERROR", 3)
    expect(note()).toBe("The auction house said no (3).")
    mock.fireEvent("AUCTION_HOUSE_BROWSE_FAILURE")
    expect(note()).toBe("The search failed; try again in a moment.")
    mock.player:setMoney(12345)
    mock.advanceTime(0.1)
    expect(assert(M.money).copper).toBe(12345)
    -- a theme drawn again
    events.emit("SUUUI_THEME_CHANGED", "suuui")
    mock.advanceTime(0.1)
    expect(win()).toBeShown()
end

--------------------------------------------------------------------------------
-- The settings; off
--------------------------------------------------------------------------------

@test("the settings: the cheap-few sliders off with their check, the tooltip rows off with the prices")
local function settings()
    local rows: { [string]: () -> (boolean?, string?) } = {}
    for _, g in ipairs(SECTION.groups or {}) do
        for _, r in ipairs(g.rows) do
            if r.key and r.disabled then
                rows[r.key] = r.disabled
            end
        end
    end
    M:Set("cheapCheck", false)
    expect(assert(rows.cheapPercent)()).toBe(true)
    expect(assert(rows.cheapShare)()).toBe(true)
    M:Set("cheapCheck", true)
    expect(assert(rows.cheapPercent)()).toBe(false)
    M:Set("tipShow", false)
    expect(assert(rows.tipMost)()).toBe(true)
    expect(assert(rows.tipOffered)()).toBe(true)
    expect(assert(rows.tipStack)()).toBe(true)
end

@test("the service's Price: what the house showed last for an item and when; never seen, nil (0.44)")
local function servicePrice()
    local price = assert(assert(SuuUI.UseService(AUCTION_HOUSE)).Price)
    M:Seen(CHARM, 4321)
    local p = assert(price(CHARM))
    expect(p.price).toBe(4321)
    expect(math.abs(p.at - time()) <= 1).toBe(true)
    expect(price(990299)).toBeNil()
end

-- (last: the module off) Auction house is reloadToToggle: the registry turns
-- it off in a session only when its OnEnable fails. Here it toggles live, as
-- a module that isn't would, so the registry's own disable and release run.
@test("turned off through the registry: the window closes; its tickers, a scan's reader among them, stop; on again")
local function off()
    open()
    local _, setGot = replicate()
    mock.click(buy().scanButton)
    setGot(5000)
    mock.fireEvent("REPLICATE_ITEM_LIST_UPDATE")
    mock.advanceTime(0.01)
    local wait, scan, reader = assert(M.waitTicker), assert(M.scanTicker), assert(M.readTicker)
    local own = ownOf(M)
    own.reloadToToggle = false
    coreSettings.set("auctionhouse", "enabled", false)
    expect(M.state).toBe(modules.ModuleState.Disabled)
    expect(win()).never.toBeShown()
    expect(wait:IsCancelled()).toBe(true)
    expect(scan:IsCancelled()).toBe(true)
    expect(reader:IsCancelled()).toBe(true)
    expect(holdings(M)).toEqual(NOTHING)
    mock.advanceTime(0.1)
    expect(note():find("^Scan done") == nil).toBe(true)
    -- on again: the wait's ticker anew
    coreSettings.set("auctionhouse", "enabled", true)
    expect(M.state).toBe(modules.ModuleState.Enabled)
    local fresh = assert(M.waitTicker)
    expect(fresh ~= wait).toBe(true)
    expect(fresh:IsCancelled()).toBe(false)
    own.reloadToToggle = true
    expectNoErrors()
end
