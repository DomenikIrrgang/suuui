-- Units/Marks: your marks on the map: made, changed, removed (room kept),
-- placed on other maps, showing the way (the game's waypoint and its
-- navigation), posted to your group and shared back, on the minimap, the
-- mark card (yours and a shared one), Ctrl+click on the world map, the
-- game's own waypoint pin while following, a /reload while following.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import SuuUI from "/Core/API"
import internal M from "/Units/Marks"
import minimapPlace, decodeMark, isOwnSender from "/Units/Marks"
import type TooltipData from "/UI/Tooltip"
import expectNoErrors from "../../helpers"
import * as frames from "wowlua:frames"
import * as tbl from "wowlua:table"

local ELWYNN, KINGDOMS = 1429, 1415

-- the world map's scroll frame
local function scroll(): Region
    return assert(frames.asRegion(tbl.field(WorldMapFrame, "ScrollContainer")))
end

local function clear()
    for _, m in ipairs(M:Marks()) do M:Remove(m.id) end
    local list = M:Marks()
    for i = #list, 1, -1 do table.remove(list, i) end
end

@afterEach
local function cleanup()
    mock.hover(nil)
    M:CloseCard()
    M:Follow(nil)
    clear()
    mock.group:leave()
    if InCombatLockdown() then mock.player:leaveCombat() end
    if WorldMapFrame:IsShown() then WorldMapFrame:Hide() end
    mock.advanceTime(0.2)
    expectNoErrors()
end

@test("a mark made, changed and removed; at the most marks the oldest shared one goes first")
local function marks()
    local heard = 0
    M:On("SUUUI_MARKS_CHANGED", function() heard = heard + 1 end)
    local a = M:Add(ELWYNN, 0.4, 0.6, { name = "Copper", symbol = "nope" })
    expect(a.symbol).toBe("star")
    expect(M:Mark(a.id)).toBe(a)
    M:Update(a.id, { symbol = "moon" })
    expect(a.symbol).toBe("moon")
    M:Update(a.id, { symbol = "bogus" })
    expect(a.symbol).toBe("star")
    expect(M:Update(9999, { name = "x" })).toBeNil()
    M:Remove(a.id)
    expect(M:Mark(a.id)).toBeNil()
    expect(heard >= 4).toBe(true)
    -- full: a shared one goes, then the oldest
    local shared = M:Add(ELWYNN, 0.1, 0.1, { from = "Brannoc" })
    for i = 1, 199 do M:Add(ELWYNN, i / 1000, 0.5) end
    local newest = M:Add(ELWYNN, 0.9, 0.9)
    expect(M:Mark(shared.id)).toBeNil()
    expect(#M:Marks()).toBe(200)
    M:Add(ELWYNN, 0.8, 0.8)
    expect(M:Mark(newest.id) ~= nil).toBe(true)
    expect(#M:Marks()).toBe(200)
end

@test("a mark on another map: its zone's on the continent; off a map, nowhere")
local function placed()
    local m = M:Add(ELWYNN, 0.42, 0.65)
    expect({ M:PlaceOn(m, ELWYNN) }).toEqual({ 0.42, 0.65 })
    local x, y = M:PlaceOn(m, KINGDOMS)
    expect(x ~= nil and y ~= nil).toBe(true)
    expect({ M:PlaceOn(m, 1414) }).toEqual({})
end

@test("showing the way: the game's waypoint, super-tracked, its navigation on; your setting back after")
local function follow()
    C_CVar.SetCVar("showInGameNavigation", "0")
    local m = M:Add(ELWYNN, 0.42, 0.65)
    M:Follow(m.id)
    expect(M:Following()).toBe(m.id)
    expect(C_Map.HasUserWaypoint()).toBe(true)
    expect(C_SuperTrack.IsSuperTrackingUserWaypoint()).toBe(true)
    expect(C_CVar.GetCVar("showInGameNavigation")).toBe("1")
    M:Follow(nil)
    expect(M:Following()).toBeNil()
    expect(C_Map.HasUserWaypoint()).toBe(false)
    expect(C_CVar.GetCVar("showInGameNavigation")).toBe("0")
    -- a waypoint of your own in its place ends it
    M:Follow(m.id)
    C_Map.SetUserWaypoint(UiMapPoint.CreateFromCoordinates(ELWYNN, 0.1, 0.1))
    expect(M:Following()).toBeNil()
end

@test("posting: a chat line with the game's map pin link and the mark to SuuUI players; not alone, not in a fight")
local function post()
    local m = M:Add(ELWYNN, 0.42, 0.65, { name = "Herbs\there", symbol = "moon" })
    expect(M:Post(m.id)).toBe(false)
    local sent: { text: string, channel: string }[] = {}
    mock.stub(C_ChatInfo, "SendChatMessage", function(text: string, channel: string) sent[#sent + 1] = { text = text, channel = channel } end)
    local friend = mock.spawnUnit({ name = "Tamsin Ashford", player = true, reaction = "friendly" })
    mock.group:add(friend)
    expect(M:GroupChannel()).toBe("PARTY")
    expect(M:Post(m.id)).toBe(true)
    expect(sent[1].channel).toBe("PARTY")
    expect(sent[1].text:find("^Herbs here · ") ~= nil).toBe(true)
    local msgs = mock.sentAddonMessages()
    local last = msgs[#msgs]
    expect(last.prefix).toBe("SuuUI")
    expect(last.message).toBe(("MARK\t%d\t0.4200\t0.6500\tmoon\tHerbs here"):format(ELWYNN))
    mock.player:enterCombat()
    expect(M:Post(m.id)).toBe(false)
end

@test("a shared mark from a group member: kept, its name updated when posted again; yours coming back ignored")
local function shared()
    mock.receiveAddonMessage("SuuUI", ("MARK\t%d\t0.3000\t0.3000\tskull\tBoss"):format(ELWYNN), "PARTY", "Brannoc-Realm")
    local list = M:Marks()
    expect(#list).toBe(1)
    expect(list[1].from).toBe("Brannoc-Realm")
    expect(list[1].symbol).toBe("skull")
    mock.receiveAddonMessage("SuuUI", ("MARK\t%d\t0.3000\t0.3000\tskull\tBoss here"):format(ELWYNN), "PARTY", "Brannoc-Realm")
    expect(#M:Marks()).toBe(1)
    expect(M:Marks()[1].name).toBe("Boss here")
    -- not a mark, off the map, another prefix
    mock.receiveAddonMessage("SuuUI", "HELLO\t1", "PARTY", "Brannoc-Realm")
    mock.receiveAddonMessage("SuuUI", ("MARK\t%d\t3\t0.3\tstar\tX"):format(ELWYNN), "PARTY", "Brannoc-Realm")
    mock.receiveAddonMessage("Other", ("MARK\t%d\t0.5\t0.5\tstar\tX"):format(ELWYNN), "PARTY", "Brannoc-Realm")
    expect(#M:Marks()).toBe(1)
    -- your own post coming back
    local name, realm = UnitFullName("player")
    -- (as the game names you: with your last name or realm when you have one)
    local own = realm and (tostring(name) .. " " .. tostring(realm)) or tostring(name)
    M:OnMessage("SuuUI", ("MARK	%d	0.6	0.6	star	Mine"):format(ELWYNN), "PARTY", own)
    expect(#M:Marks()).toBe(1)
    expect(isOwnSender("A B", "A", "B")).toBe(true)
    expect(isOwnSender("A", "A", nil)).toBe(true)
    expect(isOwnSender("C-B", "A", "B")).toBe(false)
    expect({ decodeMark("MARK\tx\t0.1\t0.1\tstar\tn") }).toEqual({})
end

@test("on the minimap: a mark in reach where it is, one further on the ring pointing its way")
local function minimap()
    local p = minimapPlace(30, 40, 100, 70, 0)
    expect(p.edge).toBe(false)
    expect(p.yards).toBe(50)
    local far = minimapPlace(300, 400, 100, 70, 0)
    expect(far.edge).toBe(true)
    expect(math.sqrt(far.x ^ 2 + far.y ^ 2)).toBeCloseTo(70 * 0.86)
    -- turned with you
    local turned = minimapPlace(0, 50, 100, 70, math.pi / 2)
    expect(turned.x).toBeCloseTo(-35)
    -- your marks there, the filters applied
    mock.moveTo({ mapID = ELWYNN, x = 0.42, y = 0.65 })
    M:Add(ELWYNN, 0.425, 0.65, { name = "Close" })
    M:Add(ELWYNN, 0.9, 0.1, { name = "Away", from = "Brannoc" })
    local places = M:MinimapPlaces()
    expect(#places).toBe(2)
    M:UpdateMinimap()
    local layer = assert(M.mmLayer)
    expect(layer.pins[1]).toBeShown()
    C_CVar.SetCVar("rotateMinimap", "1")
    expect(#M:MinimapPlaces()).toBe(2)
    C_CVar.SetCVar("rotateMinimap", "0")
    -- a pin's tooltip
    local pin = layer.pins[1]
    local shown: TooltipData? = nil
    mock.stub(SuuUI.UI, "ShowTooltip", function(_: unknown, def: TooltipData) shown = def end)
    mock.script(pin, "OnEnter")
    expect(assert(shown).title ~= nil).toBe(true)
    mock.script(pin, "OnLeave")
    -- only the shown kinds
    local wm = assert(SuuUI.GetModule("worldmap"))
    mock.stub(wm, "MarksShown", function(): { yours: boolean } return { yours = true } end)
    expect(#M:Filtered(places)).toBe(1)
end

@test("the card of your mark: its name, its symbol, showing the way, Delete, Post by your group")
local function card()
    WorldMapFrame:Show()
    WorldMapFrame:SetMapID(ELWYNN)
    mock.advanceFrames(2)
    local m = M:Add(ELWYNN, 0.42, 0.65, { name = "Copper" })
    local c = assert(M:OpenCard(m.id, scroll()))
    expect(c).toBeShown()
    expect(c.name:GetValue()).toBe("Copper")
    expect(c.post:IsEnabled()).toBe(false)
    expect((c.post.tooltip :: TooltipData).title).toBe("Join a group to post it.")
    mock.typeText(c.name.edit, " vein")
    mock.pressKey("ENTER")
    expect(m.name).toBe("Copper vein")
    mock.click(c.symbols[5])
    expect(m.symbol).toBe("moon")
    expect(M.lastSymbol).toBe("moon")
    local onChange = assert(c.way.onChange)
    onChange(true)
    expect(M:Following()).toBe(m.id)
    onChange(false)
    expect(M:PinLook(m).ring).toBe("mark-moon")
    -- a raid's label
    local friend = mock.spawnUnit({ name = "Tamsin Ashford", player = true, reaction = "friendly" })
    mock.group:add(friend, true)
    M:OpenCard(m.id, scroll())
    expect(c.post.label:GetText()).toBe("Post to raid")
    mock.click(c.delete)
    expect(c).never.toBeShown()
    expect(M:Mark(m.id)).toBeNil()
end

@test("a shared mark's card: who shared it, Remove; the card goes with the map, or with no pin")
local function sharedCard()
    WorldMapFrame:Show()
    mock.advanceFrames(2)
    local m = M:Add(ELWYNN, 0.42, 0.65, { name = "", symbol = "skull", from = "Brannoc" })
    local c = assert(M:OpenCard(m.id, scroll()))
    expect(c.sharedName:GetText()).toBe("Mark")
    expect(c.sharedBy:GetText()).toBe("Shared by Brannoc")
    expect(c.delete.label:GetText()).toBe("Remove")
    mock.advanceFrames(1)
    M:AnchorCard(nil)
    expect(c).never.toBeShown()
    M:OpenCard(m.id, scroll())
    WorldMapFrame:Hide()
    expect(c).never.toBeShown()
    expect(M:OpenCard(9999, nil)).toBeNil()
end

@test("Ctrl+click on the world map: a mark there, its card to name it; a plain click closes the card")
local function ctrlClick()
    WorldMapFrame:Show()
    WorldMapFrame:SetMapID(ELWYNN)
    mock.advanceFrames(2)
    local handler = assert(M.clickHandler)
    expect(handler(WorldMapFrame, "RightButton", 0.5, 0.5)).toBe(false)
    mock.setModifiers({ ctrl = true })
    expect(handler(WorldMapFrame, "LeftButton", 0.5, 0.5)).toBe(true)
    mock.setModifiers({})
    expect(#M:Marks()).toBe(1)
    mock.advanceTime(0.1)
    mock.advanceFrames(2)
    expect(M.card).toBeShown()
    expect(handler(WorldMapFrame, "LeftButton", 0.5, 0.5)).toBe(false)
    expect(M.card).never.toBeShown()
end

@test("while a mark shows the way the game's own waypoint pin goes; a waypoint of your own stays")
local function gamePin()
    local alpha = 1
    local provider = { pin = { SetAlpha = function(_: unknown, a: number) alpha = a end, EnableMouse = function(_: unknown, _: boolean) end } }
    local m = M:Add(ELWYNN, 0.42, 0.65)
    M:Follow(m.id)
    M:HideGamePin(provider)
    expect(alpha).toBe(0)
    M:Follow(nil)
    M:HideGamePin(provider)
    expect(alpha).toBe(1)
    M:HideGamePin({})
end

@test("a /reload while following: still following while the game kept its waypoint")
local function reloaded()
    local m = M:Add(ELWYNN, 0.42, 0.65)
    M:Follow(m.id)
    M.following = nil
    M:OnEnable()
    expect(M:Following()).toBe(m.id)
    -- the waypoint gone: the setting back
    C_Map.ClearUserWaypoint()
    M.following = nil
    M:OnEnable()
    expect(M:Following()).toBeNil()
end

@test("turned off: the card closed, the minimap's marks hidden")
local function off()
    M:UpdateMinimap()
    M:Set("enabled", false)
    expect(M.mmLayer).never.toBeShown()
    M:Reset("enabled")
    expect(M.mmLayer).toBeShown()
end
