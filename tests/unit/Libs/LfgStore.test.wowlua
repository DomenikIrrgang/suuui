-- ForeverLFG's store on its own: a clock, events and a catalogue of the
-- test's, so nothing of the running library (its list, its listeners) is
-- touched.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import EntryStore from "foreverlfg/Store"
import type Entry from "foreverlfg/Store"
import type CatalogueApi from "foreverlfg/Catalogue"
import type ChatSource from "foreverlfg/Chat"
import config from "foreverlfg/LFG"

-- A catalogue where every activity is its own: a dungeon.
const catalogue = {
    Expand = function(key: string): string[] return { key } end,
    Get = function(key: string): unknown return { key = key, kind = "dungeon" } end,
} :: CatalogueApi

-- A store whose clock the test sets, its events kept in `told`.
local function own(): (EntryStore, string[], { t: number })
    local told: string[] = {}
    local clock = { t = 100 }
    local store = EntryStore.new(function(event: string, e: Entry, reason: unknown)
        told[#told + 1] = event .. " " .. e.key .. (reason and (" " .. tostring(reason)) or "")
    end, function(): number return clock.t end, catalogue, config)
    return store, told, clock
end

-- A chat post with only what the store reads.
local function post(text: string, activities: string[], lastPost: number): ChatSource
    return mock.partial({ text = text, activities = activities, lastPost = lastPost })
end

@test("a store of its own: added, updated, refreshed and dropped, each told")
local function lifecycle()
    local store, told = own()
    store:put("Tamsin Ashford", "chat", post("LF tank", { "deadmines" }, 100))
    store:put("Tamsin Ashford", "chat", post("LF tank", { "deadmines" }, 100))
    store:put("Tamsin Ashford", "chat", post("LF healer", { "deadmines" }, 100))
    expect((store:entry("Tamsin Ashford") :: Entry).text).toBe("LF healer")
    store:drop("Tamsin Ashford", "chat", "gone")
    expect(store:entry("Tamsin Ashford")).toBeNil()
    expect(told).toEqual({
        "EntryAdded Tamsin Ashford", "EntryRefreshed Tamsin Ashford", "EntryUpdated Tamsin Ashford",
        "EntryRemoved Tamsin Ashford gone",
    })
end

@test("a store of its own: chat posts expire by its clock and the config's expiry")
local function expiry()
    local store, told, clock = own()
    store:put("Brannoc Ironhand", "chat", post("LFG", {}, 100))
    clock.t = 100 + (config.chatExpiry or 300) + 1
    store:expire()
    expect(store:entry("Brannoc Ironhand")).toBeNil()
    expect(told[#told]).toBe("EntryRemoved Brannoc Ironhand expired")
end

@test("a store of its own: entries filtered by kind and search, newest first")
local function filtered()
    local store, _, clock = own()
    store:put("Tamsin Ashford", "chat", post("LF tank for the den", { "den" }, 100))
    clock.t = 200
    store:put("Brannoc Ironhand", "chat", post("LFG anything", {}, 200))
    local all = store:entries()
    expect(#all).toBe(2)
    expect(all[1].key).toBe("Brannoc Ironhand")
    local dungeons = store:entries({ kinds = { dungeon = true } })
    expect(#dungeons).toBe(1)
    expect(dungeons[1].key).toBe("Tamsin Ashford")
    expect(#store:entries({ search = "DEN" })).toBe(1)
end
