-- Diagnostics/CVarProbe: "/suu probe cvars" records where each CVar is kept.

import test, expect from "wowlua:test"
import * as DB from "/Core/DB"
import * as cvarProbe from "/Diagnostics/CVarProbe"
import expectNoErrors from "../../helpers"

type Row = { [string]: unknown }
type Saved = { at: string, hasInfo: boolean, rows: { [string]: Row } }

@test("the list: a row per CVar with its value and where it is kept")
local function list()
    cvarProbe.command("")
    local saved = DB.probe.cvars :: unknown :: Saved
    expect(saved.at).toBeTruthy()
    expect(saved.rows.nameplateShowEnemies).toBeTruthy()
    local row = assert(saved.rows.miniWorldMap)
    expect(row.getCVar).toBeTruthy()
end

@test("named CVars: only those, an unknown one included without an error")
local function named()
    cvarProbe.command("uiScale noSuchCVarAtAll")
    local saved = DB.probe.cvars :: unknown :: Saved
    expect(saved.rows.uiScale).toBeTruthy()
    expect(saved.rows.noSuchCVarAtAll).toBeTruthy()
    expect(saved.rows.miniWorldMap).toBeNil()
    expectNoErrors()
end
