-- Diagnostics/Watch/Taint: who started a whisper, read from the stack at
-- the moment the chat input opened (the moments themselves are tested
-- through "/suu probe all" in tests/unit/Diagnostics/AllProbe).

import test, expect from "wowlua:test"
import startedBySuuUI from "/Diagnostics/Watch/Taint"

@test("who started a whisper: the frame below the game's SendTell")
local function whisperOrigin()
    local suu = table.concat({
        "[string \"@Interface/AddOns/SuuUI/SuuUI.lua\"]:10: in function <probe>",
        "[string \"@Interface/AddOns/Blizzard_ChatFrameBase/Shared/ChatFrameUtil.lua\"]:376: in function `SendTellWithMessage'",
        "[string \"@Interface/AddOns/Blizzard_ChatFrameBase/Shared/ChatFrameUtil.lua\"]:385: in function `SendTell'",
        "[C]: in function `call'",
        "[string \"@Interface/AddOns/SuuUI/SuuUI.lua\"]:900: in function `whisper'",
    }, "\n")
    expect(startedBySuuUI(suu)).toBe(true)
    local blizzard = table.concat({
        "[string \"@Interface/AddOns/Blizzard_ChatFrameBase/Shared/ChatFrameUtil.lua\"]:385: in function `SendTell'",
        "[string \"@Interface/AddOns/Blizzard_UnitPopup/UnitPopupButtons.lua\"]:50: in function `OnClick'",
    }, "\n")
    expect(startedBySuuUI(blizzard)).toBe(false)
    expect(startedBySuuUI("no tell here")).toBe(false)
end
