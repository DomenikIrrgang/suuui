-- SettingsUI/Sections: the General sections SuuUI registers itself.
-- Appearance (scale, theme, colour vision, Edit layout, the welcome),
-- Motion, Profiles (the profile, a new one, copy from and delete with a
-- second click, the role presets, by role, export and import, reset
-- everything) and Modules (built in, plugins, every state's description,
-- what can't be turned on, a module without a proper id, a module
-- registered later).

import test, expect, afterEach, cases from "wowlua:test"
import * as mock from "wowlua:mock"
import * as settings from "/Core/Settings"
import * as themes from "/Core/Themes"
import * as vision from "/Core/Vision"
import * as roles from "/Core/Roles"
import * as rolePresets from "/Core/RolePresets"
import * as services from "/Core/Services"
import * as events from "/Core/Events"
import * as modules from "/Core/Modules"
import userScale from "/Core/Root"
import SuuUI from "/Core/API"
import * as editMode from "/EditMode/EditMode"
import * as registry from "/SettingsUI/Registry"
import * as settingsWindow from "/SettingsUI/Window"
import _ from "/SettingsUI/Sections"
import expectNoErrors, newParent from "../../helpers"
import printedSince, printedCount, hasLine from "./UiSettingsHelpers"
import type TextField from "/UI/Inputs"
import type SuuButton from "/UI/Controls"
import type Select, SelectOption from "/UI/Select"

local profiles = settings.profiles

local parent: Frame? = nil
local startProfile: string? = nil

local function host(): Frame
    parent = newParent(600, 200)
    return parent :: Frame
end

@afterEach
local function cleanup()
    if parent then
        parent:Hide()
    end
    parent = nil
    if startProfile and profiles.current() ~= startProfile then
        profiles.use(startProfile)
    end
    for _, name in ipairs(profiles.list()) do
        if name:find("^Test ") or rolePresets.NAME.TANK == name then
            profiles.delete(name)
        end
    end
    settings.setAccount("theme", nil)
    settings.setAccount("colorVision", nil)
    settings.reset("ui", "scale")
    expectNoErrors()
end

-- A row of a section, by its label.
local function rowDef(id: string, label: string): registry.RowDef
    local s = registry.get(id)
    assert(s, "no section " .. id)
    for _, g in ipairs(s.groups or {}) do
        for _, r in ipairs(g.rows) do
            if r.label == label then
                return r
            end
        end
    end
    error("no row " .. label .. " in " .. id)
end

-- A row as these tests use it: the functions of the rows they read.
type Row = {
    key?: string,
    namespace?: string,
    label?: string,
    description: () -> string,
    get: () -> unknown,
    set: (value: unknown) -> (boolean?, string?),
    isDefault: () -> boolean,
    reset: () -> (),
    options: () -> SelectOption<string>[],
    disabled: () -> (boolean?, string?),
    onClick: () -> (),
    format: (v: number) -> string,
    build: (parent: Frame) -> Frame,
}
local function row(id: string, label: string): Row
    return rowDef(id, label) :: Row
end

-- A row's description, written or worked out.
local function describe(r: registry.RowDef): string?
    local d = r.description
    if type(d) == "function" then
        return d()
    end
    return d
end

-- The parts of the profile rows' controls.
type NameAndButton = Frame & { name: TextField, button: SuuButton }
type PickAndButton = Frame & { select: Select<string>, button: SuuButton }

local function remember()
    startProfile = profiles.current()
end

--------------------------------------------------------------------------------
-- Appearance and motion
--------------------------------------------------------------------------------

@test("the General sections are registered in their order")
local function registered()
    local appearance = registry.get("appearance") :: registry.Section
    expect(appearance.category).toBe("General")
    expect(appearance.order).toBe(10)
    expect((registry.get("motion") :: registry.Section).order).toBe(20)
    expect((registry.get("profiles") :: registry.Section).order).toBe(40)
    expect((registry.get("modules") :: registry.Section).build ~= nil).toBe(true)
    expect(row("motion", "Reduce motion").key).toBe("reducedMotion")
    expect(row("appearance", "Hide the issue reporter").key).toBe("hideIssueReporter")
end

@test("automatic scale: on at 0, off keeps the scale you have; the slider off while it's on")
local function scale()
    local auto, slider = row("appearance", "Automatic scale"), row("appearance", "Scale")
    settings.set("ui", "scale", 0)
    expect(auto.get()).toBe(true)
    expect(auto.isDefault()).toBe(true)
    local off, why = slider.disabled()
    expect(off).toBe(true)
    expect(why).toBe("Turn automatic scale off first.")
    expect(auto.set(false)).toBe(true)
    expect(settings.get("ui", "scale")).toBe(userScale())
    expect(auto.get()).toBe(false)
    expect(slider.set(1.25)).toBe(true)
    expect(slider.get()).toBeCloseTo(userScale())
    expect(slider.format(1.25)).toBe("125%")
    expect(slider.format(0.5)).toBe("50%")
    expect((slider.disabled())).toBe(false)
    auto.set(true)
    expect(settings.get("ui", "scale")).toBe(0)
    slider.set(1.5)
    slider.reset()
    auto.reset()
    expect(settings.get("ui", "scale")).toBe(0)
end

@test("the theme: every theme as an option, the chosen one's description, set for the account")
local function theme()
    local r = row("appearance", "Theme")
    local apply = mock.stub(themes, "apply", function() end)
    local options = r.options()
    expect(#options).toBe(#themes.all())
    expect(options[1].value).toBe(themes.all()[1].id)
    expect(r.get()).toBe(themes.DEFAULT)
    expect(r.isDefault()).toBe(true)
    local other = themes.all()[2]
    expect(r.set(other.id)).toBe(true)
    expect(settings.account("theme")).toBe(other.id)
    expect(apply).toHaveBeenCalledTimes(1)
    expect(r.isDefault()).toBe(false)
    expect(r.description()).toBe(assert(other.description))
    -- back to SuuUI's: nothing kept
    r.set(themes.DEFAULT)
    expect(settings.account("theme")).toBeNil()
    -- a plugin's theme that isn't loaded
    settings.setAccount("theme", "gone")
    expect(r.description()).toBe("Its plugin isn't loaded: SuuUI's own applies.")
    r.reset()
    expect(settings.account("theme")).toBeNil()
    expect(apply).toHaveBeenCalledTimes(3)
end

@test("colour vision: the modes there are, the hint and the ones still to come; set for the account")
local function colourVision()
    local r = row("appearance", "Colours")
    mock.stub(themes, "apply", function() end)
    local options = r.options()
    local expected: string[] = {}
    for _, m in ipairs(vision.MODES) do
        if vision.available(m) then
            expected[#expected + 1] = m
        end
    end
    expect(#options).toBe(#expected)
    expect(r.get()).toBe("normal")
    expect(r.isDefault()).toBe(true)
    expect(r.description():find(vision.HINT.normal :: string, 1, true) ~= nil).toBe(true)
    -- a mode without its colours yet
    mock.stub(vision, "available", function(m: string): boolean
        return m ~= "blueyellow"
    end)
    expect(r.description():find("Blue-yellow comes with the design's colours for it.", 1, true) ~= nil).toBe(true)
    expect(#r.options()).toBe(2)
    r.set("redgreen")
    expect(settings.account("colorVision")).toBe("redgreen")
    expect(r.isDefault()).toBe(false)
    r.set("normal")
    expect(settings.account("colorVision")).toBeNil()
    settings.setAccount("colorVision", "unknown")
    expect(r.description()).toBe(" Blue-yellow comes with the design's colours for it.")
    r.reset()
    expect(settings.account("colorVision")).toBeNil()
end

@test("Edit layout: edit mode, the window closed when it starts")
local function editLayout()
    local r = row("appearance", "Move frames")
    local toggle = mock.stub(settingsWindow, "toggle", function() end)
    mock.stub(editMode, "enter", function(): boolean
        return false
    end)
    r.onClick()
    expect(toggle).never.toHaveBeenCalled()
    mock.stub(editMode, "enter", function(): boolean
        return true
    end)
    r.onClick()
    expect(toggle).toHaveBeenCalledTimes(1)
end

@test("the welcome again: off without its module, else the window closed and the welcome shown")
local function welcome()
    local r = row("appearance", "First steps")
    local close = mock.stub(settingsWindow, "close", function() end)
    local show = mock.stub(SuuUI, "ShowWelcome", function() end)
    mock.stub(services, "get", function(_n: string): { [string]: unknown }?
        return nil
    end)
    local off, why = r.disabled()
    expect(off).toBe(true)
    expect(why).toBe("The Welcome module is off (Settings › Modules).")
    mock.stub(services, "get", function(_n: string): { [string]: unknown }?
        return {}
    end)
    expect((r.disabled())).toBe(false)
    r.onClick()
    expect(close).toHaveBeenCalledTimes(1)
    expect(show).toHaveBeenCalledTimes(1)
end

--------------------------------------------------------------------------------
-- Profiles
--------------------------------------------------------------------------------

@test("this character's profile: every profile as an option, switched by the row")
local function profileRow()
    remember()
    local r = row("profiles", "Profile")
    profiles.create("Test A")
    local names: string[] = {}
    for _, o in ipairs(r.options()) do
        names[#names + 1] = o.value or ""
    end
    expect(names).toContain("Test A")
    expect(r.get()).toBe(profiles.current())
    expect(r.set("Test A")).toBe(true)
    expect(profiles.current()).toBe("Test A")
end

@test("a new profile: Create with its name, Enter too; a bad name printed")
local function newProfile()
    remember()
    local f = row("profiles", "New profile").build(host()) :: NameAndButton
    f.name:SetValue("Test New")
    mock.click(f.button)
    expect(profiles.current()).toBe("Test New")
    expect(f.name:GetValue()).toBe("")
    -- Enter in the field
    f.name:SetValue("  Test Enter ")
    f.name.edit:SetFocus()
    mock.script(f.name.edit, "OnEnterPressed")
    expect(profiles.current()).toBe("Test Enter")
    expect(f.name.edit:HasFocus()).toBe(false)
    -- the same name again: why not, in chat; the name kept
    local before = printedCount()
    f.name:SetValue("Test Enter")
    mock.click(f.button)
    expect(#printedSince(before)).toBe(1)
    expect(f.name:GetValue()).toBe("Test Enter")
end

@test("copy from: choose a profile, a click arms it, a second within three seconds copies")
local function copyFrom()
    remember()
    profiles.create("Test Source")
    -- (stubbed first: the row hands the function to its control when built)
    local copy = mock.stub(profiles, "copyFrom", function(_n: string): (boolean, string?)
        return true, nil
    end)
    local f = row("profiles", "Copy settings from").build(host()) :: PickAndButton
    -- nothing chosen: nothing
    mock.click(f.button)
    expect(f.button.label).toHaveText("Copy")
    local names: string[] = {}
    for _, o in ipairs(f.select.options) do
        names[#names + 1] = o.value or ""
    end
    expect(names).toContain("Test Source")
    expect(names).never.toContain(profiles.current())
    assert(f.select.onChange)("Test Source")
    mock.click(f.button)
    expect(f.button.label).toHaveText("Click again")
    expect(copy).never.toHaveBeenCalled()
    -- the time runs out: disarmed
    mock.advanceTime(3.1)
    expect(f.button.label).toHaveText("Copy")
    mock.click(f.button)
    mock.click(f.button)
    expect(copy).toHaveBeenCalledWith("Test Source")
    expect(f.button.label).toHaveText("Copy")
    expect(f.select.value).toBeNil()
    -- a failure printed
    mock.stub(profiles, "copyFrom", function(_n: string): (boolean, string?)
        return false, "SuuUI: that didn't work"
    end)
    f = row("profiles", "Copy settings from").build(host()) :: PickAndButton
    assert(f.select.onChange)("Test Source")
    local before = printedCount()
    mock.click(f.button)
    mock.click(f.button)
    expect(hasLine(printedSince(before), "that didn't work")).toBe(true)
end

@test("the list follows profiles made and deleted elsewhere; a chosen one gone is dropped")
local function follows()
    remember()
    local f = row("profiles", "Delete a profile").build(host()) :: PickAndButton
    profiles.create("Test Gone")
    local names: string[] = {}
    for _, o in ipairs(f.select.options) do
        names[#names + 1] = o.value or ""
    end
    expect(names).toContain("Test Gone")
    assert(f.select.onChange)("Test Gone")
    mock.click(f.button)
    expect(f.button.label).toHaveText("Click again")
    profiles.delete("Test Gone")
    expect(f.select.value).toBeNil()
    expect(f.button.label).toHaveText("Delete")
    -- a chosen one still there is kept
    profiles.create("Test Kept")
    assert(f.select.onChange)("Test Kept")
    profiles.create("Test Other")
    events.emit("SUUUI_PROFILES_CHANGED")
    mock.click(f.button)
    mock.click(f.button)
    local left: string[] = {}
    for _, o in ipairs(f.select.options) do
        left[#left + 1] = o.value or ""
    end
    expect(left).never.toContain("Test Kept")
end

@test("a role preset: Create, then Reset its layout with a second click; what happened printed")
local function presets()
    remember()
    local b = row("profiles", "Tank").build(host()) :: SuuButton
    local name = rolePresets.NAME.TANK :: string
    expect(b.label).toHaveText("Create " .. name)
    local before = printedCount()
    mock.click(b)
    expect(rolePresets.exists("TANK")).toBe(true)
    expect(hasLine(printedSince(before), name .. " is ready")).toBe(true)
    expect(b.label).toHaveText("Reset " .. name .. "'s layout")
    mock.click(b)
    expect(b.label).toHaveText("Click again to reset")
    mock.advanceTime(3.1)
    expect(b.label).toHaveText("Reset " .. name .. "'s layout")
    mock.click(b)
    mock.click(b)
    expect(b.label).toHaveText("Reset " .. name .. "'s layout")
    -- a failure printed with the preset's name
    mock.stub(rolePresets, "apply", function(_r: string): (boolean, string?)
        return false, "not in combat"
    end)
    before = printedCount()
    mock.click(b)
    mock.click(b)
    expect(hasLine(printedSince(before), name .. ": not in combat")).toBe(true)
    -- shown again: its label as things are
    profiles.use(startProfile :: string)
    profiles.delete(name)
    b:Hide()
    b:Show()
    expect(b.label).toHaveText("Create " .. name)
    -- armed while hidden and shown: the armed label kept
    mock.stub(rolePresets, "exists", function(_r: string): boolean
        return true
    end)
    b:SetLabel("x")
    mock.click(b)
    b:Hide()
    b:Show()
    expect(b.label).toHaveText("Click again to reset")
end

@test("by role: Automatic with the role now, each role's profile or Don't switch")
local function byRole()
    remember()
    profiles.create("Test Tank")
    local yours = row("profiles", "Your role")
    local options = yours.options()
    expect(options[1].value).toBe("auto")
    local now = roles.LABEL[(select(1, roles.current()))] :: string
    if profiles.chosenRole() == "auto" then
        expect(options[1].label).toBe("Automatic (now " .. now .. ")")
    end
    expect(yours.get()).toBe(profiles.chosenRole())
    expect(yours.set("TANK")).toBe(true)
    expect(profiles.chosenRole()).toBe("TANK")
    expect(yours.options()[1].label).toBe("Automatic")
    yours.set("auto")
    local tank = row("profiles", "Tank profile")
    expect(rowDef("profiles", "Tank profile").description).toBe(
        "When you're a " .. (roles.LABEL.TANK :: string) .. ", use this profile."
    )
    expect(tank.options()[1]).toEqual({ value = "none", label = "Don't switch" })
    expect(tank.get()).toBe("none")
    expect(tank.set("Test Tank")).toBe(true)
    expect(tank.get()).toBe("Test Tank")
    tank.set("none")
    expect(profiles.roleProfile("TANK")).toBeNil()
end

@test("export and import: the window's dialogs")
local function share()
    local export = mock.stub(settingsWindow, "export", function() end)
    local import = mock.stub(settingsWindow, "import", function() end)
    row("profiles", "Export").onClick()
    row("profiles", "Import").onClick()
    expect(export).toHaveBeenCalledTimes(1)
    expect(import).toHaveBeenCalledTimes(1)
end

@test("reset everything: a first click arms, a second resets the profile and says so")
local function resetEverything()
    local b = row("profiles", "Reset every setting").build(host()) :: SuuButton
    local reset = mock.stub(settings, "reset", function(_n: string?, _k: string?): boolean
        return true
    end)
    mock.click(b)
    expect(b.label).toHaveText("Click again to reset")
    expect(reset).never.toHaveBeenCalled()
    mock.advanceTime(3.1)
    expect(b.label).toHaveText("Reset everything")
    local before = printedCount()
    mock.click(b)
    mock.click(b)
    expect(reset).toHaveBeenCalledTimes(1)
    expect(b.label).toHaveText("Reset everything")
    expect(hasLine(printedSince(before), "is back to its default")).toBe(true)
end

--------------------------------------------------------------------------------
-- Modules
--------------------------------------------------------------------------------

type FakePage = {
    groups: registry.GroupDef[],
    Clear: (self: FakePage) -> (),
    AddGroup: (self: FakePage, g: registry.GroupDef) -> Frame,
    Refresh: (self: FakePage) -> (),
    refreshed: number,
    badModuleSaid?: boolean,
}

local function page(): FakePage
    local p: FakePage = {
        groups = {},
        refreshed = 0,
        Clear = function(self: FakePage)
            self.groups = {}
        end,
        AddGroup = function(self: FakePage, g: registry.GroupDef): Frame
            self.groups[#self.groups + 1] = g
            return CreateFrame("Frame")
        end,
        Refresh = function(self: FakePage)
            self.refreshed += 1
        end,
    }
    return p
end

-- The modules page, built on a fake page.
local function buildModules(p: FakePage)
    assert((registry.get("modules") :: registry.Section).build)(p)
end

local function fakeModule(over: { [string]: unknown }): modules.AnyModule
    local m: { [string]: unknown } = {
        id = "zzfake",
        name = "Fake",
        builtIn = true,
        source = "SuuUI",
        state = "enabled",
    }
    for k, v in pairs(over) do
        m[k] = v
    end
    local fake: modules.AnyModule = mock.partial(m)
    return fake
end

@test("the modules page: built in, plugins when there are any, the developer's toggle; drawn")
local function modulesPage()
    local p = page()
    mock.stub(modules, "all", function(): modules.AnyModule[]
        return {
            fakeModule({ id = "a", name = "A", description = "Bars" }),
            fakeModule({ id = "b", name = "B", builtIn = false, source = "Plug" }),
        }
    end)
    buildModules(p)
    expect(#p.groups).toBe(3)
    expect(p.groups[1].title).toBe("Built in")
    expect(p.groups[2].title).toBe("Plugins")
    expect(p.groups[3].rows[1].key).toBe("debug")
    expect(p.refreshed).toBe(1)
    local a, b = p.groups[1].rows[1], p.groups[2].rows[1]
    expect(a.namespace).toBe("a")
    expect(a.key).toBe("enabled")
    expect(describe(a)).toBe("Bars · Built in · On")
    expect(describe(b)).toBe("From Plug · On")
    -- no plugins: no group for them
    mock.stub(modules, "all", function(): modules.AnyModule[]
        return { fakeModule({}) }
    end)
    events.emit("SUUUI_MODULE_REGISTERED", "plug")
    expect(#p.groups).toBe(2)
    expect(p.refreshed).toBe(2)
end

@test("a module's description by its state")
@cases({
    { { state = "disabled" }, "Built in · Off" },
    { { state = "registered" }, "Built in · Waiting for login" },
    { { state = "odd" }, "Built in · odd" },
    { { replacedBy = "Plug Bars" }, "Built in · Replaced by Plug Bars" },
    { { replaces = "a", builtIn = false, source = "Plug" }, "From Plug · Replaces A (after a reload) · On" },
    { { replaces = "nothing" }, "Built in · Replaces nothing (after a reload) · On" },
    { { pendingReload = true, enabledAtLoad = true }, "Built in · On, off after a reload" },
    { { pendingReload = true, enabledAtLoad = false, state = "disabled" }, "Built in · Off, on after a reload" },
    {
        { state = "errored", error = "OnEnable failed" },
        "Built in · Errored: OnEnable failed. Turn it off and on to try again",
    },
    { { state = "errored" }, "Built in · Errored: . Turn it off and on to try again" },
})
local function descriptions(over: { [string]: unknown }, shown: string)
    mock.stub(modules, "get", function(id: string): modules.AnyModule?
        return id == "a" and mock.partial({ name = "A" }) or nil
    end)
    local p = page()
    mock.stub(modules, "all", function(): modules.AnyModule[]
        return { fakeModule(over) }
    end)
    buildModules(p)
    local rows = #p.groups[1].rows > 0 and p.groups[1].rows or p.groups[2].rows
    expect(describe(rows[1])).toBe(shown)
end

@test("an errored module that reloads to toggle: it tries again after a reload")
local function erroredRetry()
    local p = page()
    mock.stub(modules, "all", function(): modules.AnyModule[]
        return {
            fakeModule({
                id = "diagnostics",
                state = "errored",
                reloadToToggle = true,
                pendingReload = true,
                error = "OnEnable failed",
            }),
        }
    end)
    buildModules(p)
    expect(describe(p.groups[1].rows[1])).toBe("Built in · Errored: OnEnable failed. It tries again after a reload")
end

@test("what can't be turned on: one that can't load, one a plugin stands in for")
local function cannot()
    local p = page()
    mock.stub(modules, "all", function(): modules.AnyModule[]
        return {
            fakeModule({ name = "Old", state = "incompatible", error = "needs SuuUI API 2" }),
            fakeModule({ name = "Bars", replacedBy = "Plug Bars" }),
            fakeModule({ name = "Fine" }),
            fakeModule({ name = "Odd", state = "incompatible" }),
        }
    end)
    buildModules(p)
    local rows = p.groups[1].rows
    local off, why = assert(rows[1].disabled)()
    expect(off).toBe(true)
    expect(why).toBe("Old needs SuuUI API 2.")
    off, why = assert(rows[2].disabled)()
    expect(why).toBe("Plug Bars stands in for Bars: turn that off to use this again.")
    expect((assert(rows[3].disabled)())).toBe(false)
    off, why = assert(rows[4].disabled)()
    expect(why).toBe("Odd can't load.")
end

@test("a module without a proper id: left out, said once")
local function badModule()
    local p = page()
    mock.stub(modules, "all", function(): modules.AnyModule[]
        return { fakeModule({ id = 5, name = "Broken", source = "Plug" }), fakeModule({}) }
    end)
    local before = printedCount()
    buildModules(p)
    expect(#p.groups[1].rows).toBe(1)
    local said = printedSince(before)
    expect(hasLine(said, "left out a module without a proper id (Broken, from Plug)")).toBe(true)
    buildModules(p)
    expect(#printedSince(before)).toBe(#said)
end
