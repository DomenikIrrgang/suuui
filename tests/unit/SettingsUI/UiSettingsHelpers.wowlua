-- tests/unit/SettingsUI/UiSettingsHelpers.wowlua
-- Shared by the ui-settings tests (TalentTree, TalentBuilds, Spellbook,
-- Timeline, the settings window, edit mode).
--
--   tokenOf(region)        the colour token Draw keeps for a region (nil: none)
--   pointOf(region, i?)    a region's i-th point as a table
--   printedSince(n)        chat lines printed after the first n
--   printedCount()         how many lines were printed so far
--   hasLine(lines, part)   a line containing `part`
--   themeChanged()         what a theme change tells the components

import * as mock from "wowlua:mock"
import * as events from "/Core/Events"
import internal paints from "/UI/Draw"

export function tokenOf(region: any): string?
    local p = paints[region]
    return p and p.token
end

export type Point = { point: string, relativeTo: any, relativePoint: string, x: number, y: number }

export function pointOf(region: any, i: number?): Point
    local point, relativeTo, relativePoint, x, y = region:GetPoint(i or 1)
    assert(point, "the region has no point " .. tostring(i or 1))
    return { point = point, relativeTo = relativeTo, relativePoint = relativePoint, x = x, y = y }
end

export function printedCount(): number
    return #mock.printed()
end

export function printedSince(from: number): string[]
    local out: string[] = {}
    local all = mock.printed()
    for i = from + 1, #all do out[#out + 1] = all[i] end
    return out
end

export function hasLine(lines: string[], part: string): boolean
    for _, l in ipairs(lines) do
        if l:find(part, 1, true) then return true end
    end
    return false
end

export function themeChanged()
    events.emit("SUUUI_THEME_CHANGED", "test")
end
