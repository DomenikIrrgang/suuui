-- debug lines
--------------------------------------------------------------------------------

@test("debug: printed only while core.debug is on, which says so")
local function debug()
    local on = printedBy(function() settings.set("core", "debug", true) end)
    expect(on).toContain(P .. "Debug lines on.")
    expect(printedBy(function() settings.debug("x", 1) end)).toEqual({ P .. "|cffa39b8b[debug]|r x 1" })
    local off = printedBy(function() settings.set("core", "debug", false) end)
    expect(off).toContain(P .. "Debug lines off.")
    expect(printedBy(function() settings.debug("x") end)).toEqual({})
end

--------------------------------------------------------------------------------
-- Chat commands
--------------------------------------------------------------------------------

@test("parse: a typed value from text, by the default's type")
local function parses()
    for _, word in ipairs({ "true", "ON", "yes", "1" }) do expect((parse(word, false))).toBe(true) end
    for _, word in ipairs({ "false", "Off", "no", "0" }) do expect((parse(word, true))).toBe(false) end
    local v, err = parse("maybe", true)
    expect(v).toBeNil()
    expect(err).toBe("expected on or off")
    expect((parse("2.5", 1))).toBe(2.5)
    v, err = parse("lots", 1)
    expect(err).toBe("expected a number")
    expect((parse("words here", "x"))).toBe("words here")
    v, err = parse("x", {})
    expect(err).toBe("this setting can only be changed in the settings window")
    expect(show({})).toBe("(table)")
    expect(show(false)).toBe("false")
    expect({ splitPath("a.b.c") }).toEqual({ "a", "b.c" })
    expect(splitPath("abc")).toBeNil()
end

@test("/suu get: every setting with the profile, or one")
local function getCommand()
    settings.set("zzsa", "num", 5)
    local all = printedBy(function() mock.slash("/suu get") end)
    expect(all[1]).toBe(P .. "Profile: Main")
    expect(all).toContain("  zzsa.num = 5  (changed)")
    expect(all).toContain("  zzsa.flag = false")
    expect(all).toContain("  zzsa.list = (table)")
    expect(printedBy(function() mock.slash("/suu get zzsa.num") end)).toEqual({ P .. "zzsa.num = 5  (changed)" })
    expect(printedBy(function() mock.slash("/suu get zzsa.text") end)).toEqual({ P .. "zzsa.text = a" })
    expect(printedBy(function() mock.slash("/suu get zzsa.nope") end)).toEqual({ P .. "No setting called zzsa.nope." })
    expect(printedBy(function() mock.slash("/suu get zzsa") end)).toEqual({ P .. "No setting called zzsa." })
    expect(printedBy(function() mock.slash("/suu get zznope.x") end)).toEqual({ P .. "No setting called zznope.x." })
end

@test("/suu set: parses by type, sets, says what happened")
local function setCommand()
    expect(printedBy(function() mock.slash("/suu set zzsa.flag on") end)).toEqual({ P .. "zzsa.flag = true" })
    expect(settings.get("zzsa", "flag")).toBe(true)
    expect(printedBy(function() mock.slash("/suu set zzsa.text two words") end)).toEqual({ P .. "zzsa.text = two words" })
    expect(printedBy(function() mock.slash("/suu set zzsa.num lots") end)).toEqual({ P .. "zzsa.num: expected a number." })
    expect(printedBy(function() mock.slash("/suu set zzsa.list 1") end))
        .toEqual({ P .. "zzsa.list: this setting can only be changed in the settings window." })
    expect(printedBy(function() mock.slash("/suu set zzsa.num 500") end)).toEqual({ P .. "zzsa.num wasn't changed: too big" })
    settings.veto("zzsa", "num", function(): (boolean?, string?) return false, nil end, VETO)
    expect(printedBy(function() mock.slash("/suu set zzsa.num 5") end)).toEqual({ P .. "zzsa.num wasn't changed: refused" })
    local usage = { P .. "Usage: /suu set <namespace.key> <value>. /suu get lists them." }
    expect(printedBy(function() mock.slash("/suu set zzsa.num") end)).toEqual(usage)
    expect(printedBy(function() mock.slash("/suu set zzsa 5") end)).toEqual(usage)
    expect(printedBy(function() mock.slash("/suu set zzsa.nope 5") end)).toEqual(usage)
    expect(printedBy(function() mock.slash("/suu set") end)).toEqual(usage)
end

@test("/suu reset: a setting, a namespace, or all")
local function resetCommand()
    settings.set("zzsa", "num", 5)
    settings.set("zzsa", "flag", true)
    expect(printedBy(function() mock.slash("/suu reset zzsa.num") end)).toEqual({ P .. "zzsa.num is back to its default." })
    expect(settings.get("zzsa", "num")).toBe(1)
    expect(printedBy(function() mock.slash("/suu reset zzsa") end)).toEqual({ P .. "zzsa is back to its default." })
    expect(settings.get("zzsa", "flag")).toBe(false)
    settings.set("zzsb", "level", 2)
    expect(printedBy(function() mock.slash("/suu reset all") end))
        .toContain(P .. "Every setting in Main is back to its default.")
    expect(settings.get("zzsb", "level")).toBe(5)
    local usage = { P .. "Usage: /suu reset <namespace.key> | <namespace> | all" }
    expect(printedBy(function() mock.slash("/suu reset zznope") end)).toEqual(usage)
    expect(printedBy(function() mock.slash("/suu reset zzsa.nope") end)).toEqual(usage)
end

@test("/suu profile: list, use, new, delete")
local function profileCommand()
    local listing = printedBy(function() mock.slash("/suu profile") end)
    expect(listing).toEqual({ P .. "Profile: Main", "  Empty", "  Main  (current)", "  Other" })
    local made = printedBy(function() mock.slash("/suu profile new ZzCmd") end)
    expect(made[1]).toBe(P .. "Profile: ZzCmd")
    expect(profiles.current()).toBe("ZzCmd")
    local used = printedBy(function() mock.slash("/suu profile use main") end)
    expect(used[1]).toBe(P .. "Profile: Main")
    local deleted = printedBy(function() mock.slash("/suu profile delete zzcmd") end)
    expect(deleted[1]).toBe(P .. "Deleted ZzCmd.")
    expect(deleted[2]).toBe(P .. "Profile: Main")
    expect(printedBy(function() mock.slash("/suu profile delete main") end))
        .toEqual({ P .. "You are using Main; switch to another profile first." })
    expect(printedBy(function() mock.slash("/suu profile new main") end))
        .toEqual({ P .. "A profile called Main already exists." })
    local usage = { P .. "Usage: /suu profile [use|new|delete <name>]" }
    expect(printedBy(function() mock.slash("/suu profile list") end)).toEqual(usage)
    expect(printedBy(function() mock.slash("/suu profile rename a") end)).toEqual(usage)
end
