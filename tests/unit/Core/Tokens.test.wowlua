-- Core/Tokens (generated by tools/gen_tokens.py): the shape every reader
-- relies on. In the test's login no theme or colour vision is applied, so the
-- tokens are the design's own.

import test, expect from "wowlua:test"
import tokens as T, TextStyle, Color, Easing, ShadowLayer from "/Core/Tokens"

const FAMILIES: string[] = { "color", "space", "size", "radius", "opacity", "duration", "easing", "shadow", "type" }

-- each family as a map by name (the records read by a name held in a string)
type Family = { [string]: any }
local byFamily: { [string]: Family } = {
    color = T.color :: Family, space = T.space :: Family, size = T.size :: Family, radius = T.radius :: Family,
    opacity = T.opacity :: Family, duration = T.duration :: Family, easing = T.easing :: Family,
    shadow = T.shadow :: Family, type = T.type :: Family,
}

local function keys(t: { [string]: any }): string[]
    local out: string[] = {}
    for k in pairs(t) do out[#out + 1] = k end
    table.sort(out)
    return out
end

local function sorted(list: string[]): string[]
    local out: string[] = {}
    for i, v in ipairs(list) do out[i] = v end
    table.sort(out)
    return out
end

local function byte(hex: string, i: number): number
    return (tonumber(hex:sub(i, i + 1), 16) :: number) / 255
end

@test("the version is the design system's v2")
local function version()
    expect(T.version).toBe(2)
end

@test("every family is there, and its order lists each of its tokens once")
local function orders()
    for _, family in ipairs(FAMILIES) do
        local t = assert(byFamily[family])
        local order = assert(T.order[family], family .. " has no order")
        expect(sorted(order)).toEqual(keys(t))
    end
    expect(sorted(keys(T.order))).toEqual(sorted(FAMILIES))
end

@test("a colour is r, g, b, a in 0-1 and its hex matches r, g, b")
local function colors()
    local n = 0
    for name, c in pairs(T.color :: { [string]: Color }) do
        n += 1
        expect(#c).toBe(4)
        for i = 1, 4 do
            expect(type(c[i])).toBe("number")
            if c[i] < 0 or c[i] > 1 then error(name .. " component out of range") end
        end
        expect(type(c.hex)).toBe("string")
        expect(c.hex:match("^%x%x%x%x%x%x$")).toBe(c.hex)
        for i = 1, 3 do
            if math.abs(c[i] - byte(c.hex, i * 2 - 1)) > 0.0025 then
                error(("%s: component %d %.4f does not match its hex %s"):format(name, i, c[i], c.hex))
            end
        end
    end
    expect(n).toBe(#assert(T.order.color))
end

@test("the map marks' colours (SuuUI's own) are colours like the design's")
local function marks()
    for _, mark in ipairs({ "star", "circle", "diamond", "triangle", "moon", "square", "cross", "skull" }) do
        expect(T.color["mark-" .. mark]).toBeTruthy()
    end
    expect(T.color["mark-skull"].hex).toBe("ffffff")
end

@test("space, size, opacity and duration are numbers; radius-round is 50%")
local function numbers()
    for _, family in ipairs({ "space", "size", "opacity", "duration" }) do
        for name, v in pairs(assert(byFamily[family])) do
            if type(v) ~= "number" then error(family .. "." .. name .. " is not a number") end
        end
    end
    for name, v in pairs(T.opacity :: { [string]: number }) do
        if v < 0 or v > 1 then error(name .. " out of range") end
    end
    expect(T.radius["radius-round"]).toBe("50%")
    expect(T.radius["radius-sm"]).toBe(2)
    expect(T.duration["dur-instant"]).toBe(0)
    expect(T.duration["dur-base"]).toBe(0.18)
end

@test("an easing names an AnimationGroup smoothing")
local function easings()
    local valid: { [string]: boolean } = { IN = true, OUT = true, IN_OUT = true, NONE = true }
    for name, e in pairs(T.easing :: { [string]: Easing }) do
        if not valid[e.smoothing] then error(name .. ": " .. tostring(e.smoothing)) end
        if e.bezier then expect(#e.bezier).toBe(4) end
    end
    expect(T.easing["ease-linear"].bezier).toBeNil()
end

@test("a shadow is a list of layers with a colour each")
local function shadows()
    for name, layers in pairs(T.shadow :: { [string]: ShadowLayer[] }) do
        expect(#layers > 0).toBe(true)
        for _, l in ipairs(layers) do
            for _, v in ipairs({ l.x, l.y, l.blur, l.spread }) do
                if type(v) ~= "number" then error(name .. ": a layer's offset, blur or spread") end
            end
            expect(type(l.inset)).toBe("boolean")
            expect(#l.color).toBe(4)
        end
    end
end

@test("a text style has a font file, size, line height and the rest")
local function styles()
    for name, s in pairs(T.type :: { [string]: TextStyle }) do
        expect(s.file:match("^Interface\\AddOns\\SuuUI\\Media\\Fonts\\.+%.ttf$")).toBe(s.file)
        expect(s.size > 0).toBe(true)
        if s.lineHeight < s.size then error(name .. ": line height under the size") end
        expect(type(s.family)).toBe("string")
        expect(type(s.weight)).toBe("number")
        expect(type(s.letterSpacing)).toBe("number")
        expect(type(s.tabular)).toBe("boolean")
        expect(type(s.sample)).toBe("string")
    end
    -- the design's tabular styles use the tabular face
    expect(T.type.numeric.tabular).toBe(true)
    expect(T.type.micro.tabular).toBe(true)
    expect(T.type.numeric.file:find("Tabular", 1, true) ~= nil).toBe(true)
end

@test("every text style has a usage note")
local function usage()
    for name in pairs(T.type :: { [string]: TextStyle }) do
        expect(type(T.usage[name])).toBe("string")
    end
end

@test("the colour vision presets are filled in (Core/VisionPresets)")
local function vision()
    expect(T.vision).toBeTruthy()
    expect(sorted(keys(T.vision or {}))).toEqual({ "blueyellow", "redgreen" })
end
