-- Core/Util: deep copies, equality, sorted keys and owner names.

import test, cases, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import * as util from "/Core/Util"

@test("copy: tables deeply, other values as they are")
local function copies()
    local inner = { 1, 2 }
    local t = { a = inner, b = "x", n = { deep = { 3 } } }
    local c = util.copy(t)
    expect(c).toEqual(t)
    expect(c == t).toBe(false)
    expect(c.a == inner).toBe(false)
    expect(c.n.deep == t.n.deep).toBe(false)
    c.a[1] = 9
    expect(inner[1]).toBe(1)
    expect(util.copy(5)).toBe(5)
    expect(util.copy("s")).toBe("s")
    expect(util.copy(true)).toBe(true)
    local f = function() end
    expect(util.copy(f)).toBe(f)
end

@test("copy: a table met twice stays one table in the copy, cycles too")
local function shared()
    local s = { 1 }
    local t: { [string]: any } = { a = s, b = s }
    t.self = t
    local c = util.copy(t)
    expect(c.a == c.b).toBe(true)
    expect(c.a == s).toBe(false)
    expect(c.self == c).toBe(true)
end

@test("equal: deep equality of plain data")
@cases({
    { 1, 1, true },
    { 1, 2, false },
    { "a", "a", true },
    { "1", 1, false },
    { true, false, false },
})
local function equalScalars(a: any, b: any, out: boolean)
    expect(util.equal(a, b)).toBe(out)
end

@test("equal: tables by their keys and values, in both directions")
local function equalTables()
    expect(util.equal({ a = { 1, 2 } }, { a = { 1, 2 } })).toBe(true)
    expect(util.equal({ a = { 1, 2 } }, { a = { 1, 3 } })).toBe(false)
    expect(util.equal({ a = 1 }, { a = 1, b = 2 })).toBe(false)
    expect(util.equal({ a = 1, b = 2 }, { a = 1 })).toBe(false)
    expect(util.equal({}, {})).toBe(true)
    expect(util.equal({}, 1)).toBe(false)
    expect(util.equal(nil, nil)).toBe(true)
    expect(util.equal(nil, false)).toBe(false)
end

@test("equal: a secret value never equals anything, itself included")
local function equalSecret()
    local s = mock.secret(5)
    expect(util.equal(s, s)).toBe(false)
    expect(util.equal(s, 5)).toBe(false)
    expect(util.equal(5, s)).toBe(false)
end

@test("sortedKeys: sorted as strings, mixed key types included")
local function sortedKeys()
    expect(util.sortedKeys({ b = 1, a = 2, c = 3 })).toEqual({ "a", "b", "c" })
    expect(util.sortedKeys({})).toEqual({})
    local mixed: { [any]: any } = { [10] = true, [2] = true, x = true, ["1"] = true }
    -- as strings: "1" < "10" < "2" < "x"
    expect(util.sortedKeys(mixed)).toEqual({ "1", 10, 2, "x" })
end

@test("ownerName: a module's name, then its id, a mover's label, a frame's name, else tostring")
local function ownerNames()
    expect(util.ownerName({ name = "Bags", id = "bags" })).toBe("Bags")
    expect(util.ownerName({ id = "bags" })).toBe("bags")
    expect(util.ownerName({ label = "Player" })).toBe("Mover: Player")
    local odd: { [string]: any } = { name = 5, id = 6, label = 7 }
    expect(util.ownerName(odd)).toBe(tostring(odd))
    expect(util.ownerName("Core")).toBe("Core")
    expect(util.ownerName(42)).toBe("42")
    expect(util.ownerName(nil)).toBe("nil")
    local named = CreateFrame("Frame", "SuuUICoreATestOwnerFrame")
    expect(util.ownerName(named)).toBe("SuuUICoreATestOwnerFrame")
    local anonymous = CreateFrame("Frame")
    expect(util.ownerName(anonymous)).toBe(tostring(anonymous))
    local plain = {}
    expect(util.ownerName(plain)).toBe(tostring(plain))
end
