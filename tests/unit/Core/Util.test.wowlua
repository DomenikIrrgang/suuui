-- Core/Util: owner names (copies, equality and sorted keys are wowlua:table's).

import test, expect from "wowlua:test"
import * as util from "/Core/Util"

@test("ownerName: a module's name, then its id, a mover's label, a frame's name, else tostring")
local function ownerNames()
    expect(util.ownerName({ name = "Bags", id = "bags" })).toBe("Bags")
    expect(util.ownerName({ id = "bags" })).toBe("bags")
    expect(util.ownerName({ label = "Player" })).toBe("Mover: Player")
    local odd: { [string]: unknown } = { name = 5, id = 6, label = 7 }
    expect(util.ownerName(odd)).toBe(tostring(odd))
    expect(util.ownerName("Core")).toBe("Core")
    expect(util.ownerName(42)).toBe("42")
    expect(util.ownerName(nil)).toBe("nil")
    local named = CreateFrame("Frame", "SuuUICoreATestOwnerFrame")
    expect(util.ownerName(named)).toBe("SuuUICoreATestOwnerFrame")
    local anonymous = CreateFrame("Frame")
    expect(util.ownerName(anonymous)).toBe(tostring(anonymous))
    local plain = {}
    expect(util.ownerName(plain)).toBe(tostring(plain))
end
