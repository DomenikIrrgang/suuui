-- Core/Modes: a mode hands over how it closes; closing by name runs it, and
-- a name nothing handed over does nothing. SuuUI's own: edit mode and the
-- settings window.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import * as modes from "/Core/Modes"
import * as editMode from "/EditMode/EditMode"
import * as frames from "wowlua:frames"
import expectNoErrors from "../../helpers"

@test("a mode closed by name: its own closer runs; an unknown name does nothing")
local function byName()
    local closed = mock.spy(function() end)
    modes.onClose("zz-test", closed)
    modes.close("zz-test")
    modes.close("zz-nothing")
    expect(closed).toHaveBeenCalledTimes(1)
    expectNoErrors()
end

@test("SuuUI's: edit mode and the settings window close by name")
local function own()
    expect(editMode.enter()).toBe(true)
    expect(editMode.isActive()).toBe(true)
    modes.close("editmode")
    expect(editMode.isActive()).toBe(false)
    -- closing it again while it is closed does nothing
    modes.close("editmode")
    mock.slash("/suu")
    local window = assert(frames.find("SuuUISettings"))
    expect(window:IsShown()).toBe(true)
    modes.close("settings")
    expect(window:IsShown()).toBe(false)
    expectNoErrors()
end
