-- Data
--------------------------------------------------------------------------------

@test("the data accessors hand out SuuUI's data")
local function data()
    expect(SuuUI.QuestStarts()).toBe(questStarts)
    expect(SuuUI.AuraCatalog()).toBe(auraCatalog)
    expect(SuuUI.ClassTalents("MAGE")).toBe(classTalents.MAGE)
    expect(SuuUI.ClassTalents("MONK")).toBeNil()
    for id, sources in pairs(recipeSources) do
        expect(SuuUI.RecipeSources(id)).toBe(sources)
        break
    end
    expect(SuuUI.RecipeSources(-1)).toBeNil()
    for _, fn in ipairs({ SuuUI.CooldownPresets, SuuUI.TrainerSpells, SuuUI.TrainerSpellIDs, SuuUI.Defensives,
        SuuUI.RaidCatalog, SuuUI.MapPlaces, SuuUI.MapOverlays, SuuUI.InstanceLevels, SuuUI.FlightRoutes,
        SuuUI.FlightPaths, SuuUI.CollectionSources } :: { () -> any }) do
        expect(type(fn())).toBe("table")
    end
end

--------------------------------------------------------------------------------
-- Role presets, colour vision, account data
--------------------------------------------------------------------------------

@test("RolePresetName names a role's preset profile")
local function presetName()
    expect(SuuUI.RolePresetName("TANK")).toBe("SuuTank")
    expect(SuuUI.RolePresetName("WIZARD")).toBeNil()
end

@test("ApplyRolePreset makes the preset; with switch the character uses it")
local function applyPreset()
    local before = assert(settings.profiles.current())
    expect(SuuUI.ApplyRolePreset("DAMAGER")).toBe(true)
    expect(settings.profiles.current()).toBe(before)
    expect(SuuUI.ApplyRolePreset("DAMAGER", true)).toBe(true)
    expect(settings.profiles.current()).toBe("SuuDps")
    settings.profiles.use(before)
    settings.profiles.setRoleProfile("DAMAGER", nil)
    settings.profiles.delete("SuuDps")
end

@test("ApplyRolePreset says why it couldn't")
local function applyPresetRefused()
    local ok, why = SuuUI.ApplyRolePreset("WIZARD")
    expect(ok).toBe(false)
    expect(why).toBe("No such role.")
    mock.stub(rolePresets, "apply", function(_: string): (boolean, string?) return true end)
    mock.stub(settings.profiles, "find", function(_: string?): (string?, string?) return nil, "gone" end)
    ok, why = SuuUI.ApplyRolePreset("TANK", true)
    expect(ok).toBe(false)
    expect(why).toBe("The preset's profile is missing.")
end

@test("ColorVisionModes lists the presets the design has values for")
local function visionModes()
    local modes = SuuUI.ColorVisionModes()
    expect(#modes).toBe(3)
    expect(modes[1]).toEqual({ id = "normal", label = "Normal", hint = vision.HINT.normal })
    expect(modes[2].id).toBe("redgreen")
    local presets = T.vision
    T.vision = nil
    local onlyNormal = SuuUI.ColorVisionModes()
    T.vision = presets
    expect(#onlyNormal).toBe(1)
end

@test("SetColorVision chooses the account's preset and applies it at once")
local function setVision()
    expect(SuuUI.ColorVision()).toBe("normal")
    expect(SuuUI.SetColorVision("redgreen")).toBe(true)
    local chosen, applied = SuuUI.ColorVision()
    expect(chosen).toBe("redgreen")
    expect(applied).toBe("redgreen")
    expect(T.color.ember.hex).toBe("ec6b00")
    expect(SuuUI.SetColorVision("normal")).toBe(true)
    expect(settings.account("colorVision")).toBeNil()
    expect(vision.appliedMode()).toBe("normal")
    local ok, why = SuuUI.SetColorVision("purple")
    expect(ok).toBe(false)
    expect(why).toBe("No such colour vision preset.")
end

@test("SetColorVision refuses a preset the design has no values for")
local function setVisionUnavailable()
    local presets = T.vision
    T.vision = { redgreen = {} }
    local ok = SuuUI.SetColorVision("redgreen")
    T.vision = presets
    expect(ok).toBe(false)
end

@test("ColorVisionColor: a token as a preset draws it, whatever is applied")
local function visionColor()
    local design = { T.color.ember[1], T.color.ember[2], T.color.ember[3], T.color.ember[4] }
    SuuUI.SetColorVision("blueyellow")
    -- normal: the design's, though blue-yellow is applied
    local r, g, b, a = SuuUI.ColorVisionColor("normal", "ember")
    expect({ r, g, b, a }).toEqual(design)
    -- a preset's: its values, alpha the design's
    r, g, b, a = SuuUI.ColorVisionColor("redgreen", "ember")
    expect({ r, g, b }).toEqual({ 0.9255, 0.4196, 0 })
    expect(a).toBe(design[4])
    -- a preset colour with its own alpha
    local _, _, _, fa = SuuUI.ColorVisionColor("redgreen", "fel-incoming")
    expect(fa).toBe(0.4)
    -- a token the preset leaves alone: the design's
    r = SuuUI.ColorVisionColor("redgreen", "gilt")
    expect(r).toBe(T.color.gilt[1])
    expect(function() SuuUI.ColorVisionColor("normal", "glitter") end).toThrow("SuuUI: unknown colour token glitter")
end

@test("ColorVisionColor without the presets gives the design's colour")
local function visionColorNoPresets()
    local presets = T.vision
    T.vision = nil
    local r = SuuUI.ColorVisionColor("redgreen", "ember")
    T.vision = presets
    expect(r).toBe(SuuUI.ColorVisionColor("normal", "ember"))
end

@test("ColorVisionColor for a colour without an alpha reads it as opaque")
local function visionColorNoAlpha()
    local presets = T.vision
    T.vision = { redgreen = { ["glitter"] = { 1, 0, 1, hex = "ff00ff" } :: any } }
    local _, _, _, a = SuuUI.ColorVisionColor("redgreen", "glitter")
    T.vision = presets
    expect(a).toBe(1)
end

@test("AccountData: a module's own account-wide table, made on first use")
local function accountData()
    local d = SuuUI.AccountData("apitest")
    expect(d).toEqual({})
    d.seen = true
    expect(SuuUI.AccountData("apitest")).toBe(d)
    expect(settings.account("data").apitest).toBe(d)
    expect(SuuUI.AccountData("apitest-other")).never.toBe(d)
    -- a broken saved value is replaced
    local saved = settings.account("data")
    settings.setAccount("data", "broken")
    expect(SuuUI.AccountData("apitest")).toEqual({})
    settings.setAccount("data", saved)
    expect(function() SuuUI.AccountData(nil :: any) end).toThrow("SuuUI.AccountData: a namespace is required")
end
