@test("FullName: the whole name, else UnitName's")
local function fullName()
    mock.fake("GetUnitName", function(unit: string, _: boolean): string return unit == "player" and "Tamsin Ashford" or "" end)
    mock.fake("UnitName", function(_: string): (string, string?) return "Brannoc", "Ironhand" end)
    expect(SuuUI.FullName()).toBe("Tamsin Ashford")
    expect(SuuUI.FullName("target")).toBe("Brannoc")
    local api2 = _G.GetUnitName
    _G.GetUnitName = nil
    local fallback = SuuUI.FullName("player")
    local own = SuuUI.FullName()
    _G.GetUnitName = api2
    expect(fallback).toBe("Brannoc")
    expect(own).toBe("Brannoc")
end

@test("AddFriend: Forever's title friend invite, else the classic list")
local function addFriend()
    local invites = mock.fake("C_BattleNet.SendTitleFriendInviteByName", function(_: string) end)
    local legacy = false
    mock.fake("C_FriendList.IsLegacyFriendSystemEnabled", function(): boolean return legacy end)
    local added = mock.fake("C_FriendList.AddFriend", function(_: string) end)
    expect(SuuUI.AddFriend("Tamsin Ashford")).toBe(true)
    expect(invites).toHaveBeenCalledWith("Tamsin Ashford")
    expect(added).never.toHaveBeenCalled()
    -- the classic list on
    legacy = true
    expect(SuuUI.AddFriend("Brannoc")).toBe(true)
    expect(added).toHaveBeenCalledWith("Brannoc")
    -- the invite failing falls back to the list
    legacy = false
    mock.fake("C_BattleNet.SendTitleFriendInviteByName", function(_: string) error("refused") end)
    expect(SuuUI.AddFriend("Kaelith")).toBe(true)
    expect(added).toHaveBeenCalledWith("Kaelith")
    -- the legacy flag unreadable: the invite is tried
    mock.fake("C_FriendList.IsLegacyFriendSystemEnabled", function(): boolean error("unknown") end)
    local inviteAgain = mock.fake("C_BattleNet.SendTitleFriendInviteByName", function(_: string) end)
    expect(SuuUI.AddFriend("Ashmaw")).toBe(true)
    expect(inviteAgain).toHaveBeenCalledWith("Ashmaw")
    -- the list failing too
    mock.fake("C_BattleNet.SendTitleFriendInviteByName", function(_: string) error("refused") end)
    mock.fake("C_FriendList.AddFriend", function(_: string) error("refused") end)
    expect(SuuUI.AddFriend("Kaelith")).toBe(false)
end

@test("AddFriend without the client's friend APIs")
local function addFriendNoApi()
    local all: { [string]: any } = _G :: any
    local fl, bn = all.C_FriendList, all.C_BattleNet
    local added = mock.fake("C_FriendList.AddFriend", function(_: string) end)
    -- no Battle.net invite: the classic list
    all.C_BattleNet = nil
    local viaList = SuuUI.AddFriend("Kaelith")
    all.C_BattleNet = { }
    local viaListToo = SuuUI.AddFriend("Kaelith")
    -- no legacy flag: the invite
    all.C_BattleNet = { SendTitleFriendInviteByName = function(_: string) end }
    all.C_FriendList = { AddFriend = fl.AddFriend }
    local viaInvite = SuuUI.AddFriend("Brannoc")
    -- nothing at all
    all.C_BattleNet = nil
    all.C_FriendList = nil
    local nothing = SuuUI.AddFriend("Brannoc")
    all.C_FriendList = {}
    local noAdd = SuuUI.AddFriend("Brannoc")
    all.C_FriendList, all.C_BattleNet = fl, bn
    expect({ viaList, viaListToo, viaInvite, nothing, noAdd }).toEqual({ true, true, true, false, false })
    expect(added).toHaveBeenCalledTimes(2)
end

@test("AddFriend needs a name")
local function addFriendNoName()
    expect(SuuUI.AddFriend(nil)).toBe(false)
    expect(SuuUI.AddFriend("")).toBe(false)
    expect(SuuUI.AddFriend(42)).toBe(false)
end

