-- Services stood in for, provided by name as a plugin's would be: each
-- reads its functions from this table when called.
local standIns: { [string]: { [string]: unknown } } = {}
local STAND_IN = "APITestServices"
local function withServices()
    for _, name in ipairs({ "talents", "collections", "welcome", "bags", "professions", "notifications", "alerts", "durability" }) do
        services.provide(name, setmetatable({}, { __index = function(_: unknown, k: string): unknown
            local t = standIns[name]
            return t and t[k]
        end }), STAND_IN)
    end
end

@afterEach
local function cleanUp()
    standIns = {}
    services.unregister(STAND_IN)
    settings.setAccount("colorVision", nil)
    settings.setAccount("theme", nil)
    themes.apply()
end

--------------------------------------------------------------------------------
-- What is there
--------------------------------------------------------------------------------

@test("the global SuuUI is the API")
local function global()
    expect(_G.SuuUI).toBe(SuuUI)
end

@test("every documented name is there")
local function documented()
    local missing: string[] = {}
    for _, path in ipairs(DOCUMENTED) do
        if at(path) == nil then missing[#missing + 1] = path end
    end
    for _, name in ipairs(DOCUMENTED_UI) do
        if at("UI." .. name) == nil then missing[#missing + 1] = "UI." .. name end
    end
    expect(missing).toEqual({})
end

@test("every UI component is in Raw.UI too, under the same name")
local function rawUI()
    local raw: { [string]: any } = SuuUI.Raw.UI
    local missing: string[] = {}
    for name, v in pairs(SuuUI.UI :: { [string]: any }) do
        if raw[name] ~= v then missing[#missing + 1] = name end
    end
    table.sort(missing)
    expect(missing).toEqual({})
    expect(raw.actionButtons).toBeTruthy()
end

@test("the version and the API version")
local function versions()
    expect(SuuUI.API_VERSION).toBe(modules.API_VERSION)
    expect(SuuUI.API_VERSION).toBe("0.19.0")
    expect(SuuUI.version).toBe(version)
    expect(SuuUI.APIAtLeast("0.1")).toBe(true)
    expect(SuuUI.APIAtLeast("0.99")).toBe(false)
end

@test("the core's parts are the core modules' own")
local function parts()
    expect(SuuUI.Root).toBe(root)
    expect(SuuUI.Tokens).toBe(T)
    expect(SuuUI.Pixel.Size).toBe(pixel.size)
    expect(SuuUI.Pixel.Snap).toBe(pixel.snap)
    expect(SuuUI.Pixel.PerfectScale).toBe(pixel.perfectScale)
    expect(SuuUI.Fonts.Get).toBe(fonts.get)
    expect(SuuUI.Fonts.Apply).toBe(fonts.apply)
    expect(SuuUI.Motion.FadeIn).toBe(motion.fadeIn)
    expect(SuuUI.Motion.AlphaTo).toBe(motion.alphaTo)
    expect(SuuUI.Motion.Reduced).toBe(motion.reduced)
    expect(SuuUI.PublishAnchor).toBe(anchors.publish)
    expect(SuuUI.GetAnchor).toBe(anchors.get)
    expect(SuuUI.SuppressBlizzard).toBe(blizzard.suppress)
    expect(SuuUI.RestoreBlizzard).toBe(blizzard.restore)
    expect(SuuUI.IsSuppressed).toBe(blizzard.isSuppressed)
    expect(SuuUI.UI.CooldownConditionMet).toBe(cooldownTracker.cooldownConditionMet)
    expect(SuuUI.Raw.Module).toBe(modules.get)
    expect(type(SuuUI.Raw.ns)).toBe("table")
    expect(type(SuuUI.Raw.Mixins)).toBe("table")
end

--------------------------------------------------------------------------------
-- Modules
--------------------------------------------------------------------------------

@test("GetModule finds a module by id")
local function getModule()
    local first = modules.all()[1]
    expect(SuuUI.GetModule(first.id) :: unknown).toBe(first)
    expect(SuuUI.GetModule("no-such-module")).toBeNil()
end

@test("ListModules is a snapshot of every module")
local function listModules()
    local list = SuuUI.ListModules()
    local all = modules.all()
    expect(#list).toBe(#all)
    for i, m in ipairs(all) do
        local row = list[i]
        expect(row.id).toBe(m.id)
        expect(row.name).toBe(m.name)
        expect(row.state).toBe(m.state)
        expect(row.builtIn).toBe(m.builtIn)
    end
    -- a copy: changing it changes nothing
    list[1].state = "changed"
    expect(all[1].state == "changed").toBe(false)
end

@test("Commands lists every /suu subcommand")
local function commands()
    local names: { [string]: boolean } = {}
    for _, c in ipairs(SuuUI.Commands()) do names[c.name] = true end
    expect(names.perf).toBe(true)
    expect(names.pixel).toBe(true)
end

--------------------------------------------------------------------------------
-- Delegating functions
--------------------------------------------------------------------------------

@test("RegisterTheme registers a theme")
local function registerTheme()
    SuuUI.RegisterTheme({ id = "api-test-theme", name = "API test" })
    expect(assert(themes.get("api-test-theme")).name).toBe("API test")
    expect(function() SuuUI.RegisterTheme({ id = "api-test-theme" }) end).toThrow("is taken")
end

@test("Role and Spec are Roles' current and spec")
local function roleSpec()
    mock.stub(roles, "current", function(): (string, string) return "HEALER", "assigned" end)
    mock.stub(roles, "spec", function(): (number, number[]) return 2, { 1, 9, 0 } end)
    local role, source = SuuUI.Role()
    expect(role).toBe(roles.Role.Healer)
    expect(source).toBe(roles.RoleSource.Assigned)
    local tree, pts = SuuUI.Spec()
    expect(tree).toBe(2)
    expect(pts).toEqual({ 1, 9, 0 })
end

@test("the settings window, settings sections and movers go to their modules")
local function settingsWindow()
    local opened = mock.stub(window, "open", function(_: string?) end)
    local toggled = mock.stub(window, "toggle", function() end)
    local section = {}
    mock.stub(registry, "register", function(_: { [string]: any }, _: any): any return section end)
    local mover = {}
    mock.stub(editMode, "register", function(_: any, _: { [string]: any }, _: any?): any return mover end)
    SuuUI.OpenSettings("general")
    expect(opened).toHaveBeenCalledWith("general")
    SuuUI.OpenSettings()
    expect(opened).toHaveBeenCalledTimes(2)
    SuuUI.ToggleSettings()
    expect(toggled).toHaveBeenCalledTimes(1)
    expect(SuuUI.RegisterSettings({ id = "x" }) :: unknown).toBe(section)
    expect(SuuUI.RegisterMover(CreateFrame("Frame"), { namespace = "ui", key = "x" })).toBe(mover)
end

@test("ProbeShowsBlizzardSocial is the social probe's answer")
local function socialProbeAnswer()
    mock.stub(socialProbe, "showsBlizzardSocial", function(): boolean return true end)
    expect(SuuUI.ProbeShowsBlizzardSocial()).toBe(true)
end

--------------------------------------------------------------------------------
-- Services
--------------------------------------------------------------------------------

@test("with the modules off, the service functions do nothing and say so")
local function servicesOff()
    withServices()
    local bags = mock.fake("ToggleAllBags", function() end)
    expect(SuuUI.ToggleTalents()).toBe(false)
    expect(SuuUI.ShowTalentsOf("target")).toBe(false)
    expect(SuuUI.ToggleCollections("mounts")).toBe(false)
    expect(SuuUI.CollectionsShown()).toBe(false)
    expect(SuuUI.TalentsShown()).toBe(false)
    expect(SuuUI.TalentBuildNext()).toBeNil()
    expect(SuuUI.ShowWelcome()).toBe(false)
    expect(SuuUI.ShownRecipe()).toBeNil()
    expect(SuuUI.Notify({ title = "x" })).toBeNil()
    expect(SuuUI.Durability()).toBeNil()
    SuuUI.ExpectRecipe(1)
    SuuUI.DismissNotification("1")
    SuuUI.ShowAlert("k", "info", "Title", "Detail")
    SuuUI.ShowLevelUp("k", {})
    SuuUI.HideAlert("k")
    -- the bags: Blizzard's
    SuuUI.ToggleBags()
    expect(bags).toHaveBeenCalledTimes(1)
    expectNoErrors()
end

@test("with a service there, the calls reach it")
local function servicesOn()
    withServices()
    local s = mock.spy()
    local toggleBags = mock.spy()
    local next: TalentNext = { node = 1, name = "Next", icon = 1, rank = 1, max = 1, treeName = "Arms", build = "b", index = 1 }
    standIns.talents = { Toggle = s, ShowInspect = s, IsShown = function(): boolean return true end,
        NextTalent = function(): TalentNext return next end }
    -- (a plugin's answer that is only truthy)
    standIns.collections = { Toggle = s, IsShown = function(): number return 1 end }
    standIns.welcome = { Show = s }
    standIns.bags = { Toggle = toggleBags }
    standIns.professions = { ExpectRecipe = s, ShownRecipe = function(): number return 77 end, OpenRecipe = s }
    standIns.notifications = { Notify = function(_: unknown): string return "id-1" end, Dismiss = s }
    standIns.alerts = { Show = s, ShowLevelUp = s, Hide = s }
    local wear: DurabilityInfo = { line = 20, pieces = {}, bySlot = {}, damaged = 0, broken = 0, state = "fine",
                                   headline = "Durability", lines = {},
                                   parts = { figure = true, character = true, gear = true, gearBars = "always", note = true } }
    standIns.durability = { Get = function(): DurabilityInfo return wear end }
    expect(SuuUI.ToggleTalents()).toBe(true)
    expect(SuuUI.ShowTalentsOf("target")).toBe(true)
    expect(s).toHaveBeenCalledWith("target")
    expect(SuuUI.ToggleCollections("toys")).toBe(true)
    expect(s).toHaveBeenCalledWith("toys")
    expect(SuuUI.CollectionsShown()).toBe(true)
    expect(SuuUI.TalentsShown()).toBe(true)
    expect(SuuUI.TalentBuildNext()).toBe(next)
    expect(SuuUI.ShowWelcome()).toBe(true)
    SuuUI.ToggleBags()
    expect(toggleBags).toHaveBeenCalledTimes(1)
    SuuUI.OpenRecipe(12)
    expect(s).toHaveBeenCalledWith(12)
    SuuUI.ExpectRecipe(13)
    expect(s).toHaveBeenCalledWith(13)
    expect(SuuUI.ShownRecipe()).toBe(77)
    expect(SuuUI.Notify({ title = "Hi" })).toBe("id-1")
    SuuUI.DismissNotification("id-1")
    expect(s).toHaveBeenCalledWith("id-1")
    SuuUI.ShowAlert("pull", "warning", "Pull", "in %d", 5)
    expect(s).toHaveBeenCalledWith("pull", "warning", "Pull", "in %d", 5)
    SuuUI.ShowLevelUp("lvl", { title = "Level 20" })
    SuuUI.HideAlert("pull")
    expect(s).toHaveBeenCalledWith("pull")
    expect(SuuUI.Durability()).toBe(wear)
    -- answers that are false or nothing
    standIns.collections.IsShown = function(): boolean return false end
    standIns.talents.IsShown = function(): boolean return false end
    standIns.professions.ShownRecipe = function(): number? return nil end
    expect(SuuUI.CollectionsShown()).toBe(false)
    expect(SuuUI.TalentsShown()).toBe(false)
    expect(SuuUI.ShownRecipe()).toBeNil()
end

@test("a service without the function asked for is treated as off")
local function partialService()
    withServices()
    standIns.talents = {}
    standIns.collections = {}
    standIns.welcome = {}
    standIns.professions = {}
    standIns.notifications = {}
    standIns.alerts = {}
    standIns.durability = {}
    standIns.bags = {}
    mock.fake("ToggleAllBags", function() end)
    expect(SuuUI.ToggleTalents()).toBe(false)
    expect(SuuUI.ShowTalentsOf("target")).toBe(false)
    expect(SuuUI.TalentsShown()).toBe(false)
    expect(SuuUI.TalentBuildNext()).toBeNil()
    expect(SuuUI.ToggleCollections()).toBe(false)
    expect(SuuUI.CollectionsShown()).toBe(false)
    expect(SuuUI.ShowWelcome()).toBe(false)
    expect(SuuUI.ShownRecipe()).toBeNil()
    expect(SuuUI.Notify({})).toBeNil()
    expect(SuuUI.Durability()).toBeNil()
    SuuUI.ExpectRecipe(1)
    SuuUI.DismissNotification("1")
    SuuUI.ShowAlert("k")
    SuuUI.ShowLevelUp("k", {})
    SuuUI.HideAlert("k")
    SuuUI.AllowAlertOutOfCombat("k")
    SuuUI.ToggleBags()
    expectNoErrors()
end

@test("keys allowed out of combat reach the alerts service, also one that comes later")
local function anytime()
    withServices()
    SuuUI.AllowAlertOutOfCombat("api-pull")
    local allowed: string[] = {}
    standIns.alerts = { AllowOutOfCombat = function(key: string) allowed[#allowed + 1] = key end }
    SuuUI.AllowAlertOutOfCombat("api-countdown")
    expect(allowed).toEqual({ "api-countdown" })
    -- another service changing: nothing
    allowed = {}
    events.emit("SUUUI_SERVICE_CHANGED", "bags")
    expect(allowed).toEqual({})
    -- a new alerts service: every key so far
    events.emit("SUUUI_SERVICE_CHANGED", "alerts")
    expect(allowed).toContain("api-countdown")
    expect(allowed).toContain("api-pull")
    -- one without AllowOutOfCombat
    standIns.alerts = {}
    events.emit("SUUUI_SERVICE_CHANGED", "alerts")
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- Professions
--------------------------------------------------------------------------------

@test("OpenRecipe without SuuUI's window opens the recipe's profession (its parent line first)")
local function openRecipeFallback()
    withServices()
    local opened = mock.fake("C_TradeSkillUI.OpenTradeSkill", function(_: number) end)
    mock.fake("C_TradeSkillUI.GetTradeSkillLineForRecipe", function(recipe: number): (number, string, number)
        if recipe == 1 then return 171, "Alchemy", 0 end
        return 2550, "Classic Cooking", 185
    end)
    SuuUI.OpenRecipe(1)
    expect(opened).toHaveBeenCalledWith(171)
    SuuUI.OpenRecipe(2)
    expect(opened).toHaveBeenCalledWith(185)
end

@test("OpenRecipe with nothing known about the recipe, or no API for it, opens nothing")
local function openRecipeUnknown()
    withServices()
    local opened = mock.fake("C_TradeSkillUI.OpenTradeSkill", function(_: number) end)
    mock.fake("C_TradeSkillUI.GetTradeSkillLineForRecipe", function(_: number): any return nil end)
    SuuUI.OpenRecipe(3)
    -- (the client's tables seen untyped, to take functions away)
    local tradeSkill: { [string]: any } = C_TradeSkillUI :: any
    local lineFor = tradeSkill.GetTradeSkillLineForRecipe
    tradeSkill.GetTradeSkillLineForRecipe = nil
    SuuUI.OpenRecipe(3)
    tradeSkill.GetTradeSkillLineForRecipe = lineFor
    local all: { [string]: any } = _G :: any
    local saved = all.C_TradeSkillUI
    all.C_TradeSkillUI = nil
    SuuUI.OpenRecipe(3)
    all.C_TradeSkillUI = saved
    -- a professions service without OpenRecipe falls back; no OpenTradeSkill: nothing opens
    standIns.professions = {}
    mock.fake("C_TradeSkillUI.GetTradeSkillLineForRecipe", function(_: number): (number, string, number) return 171, "Alchemy", 0 end)
    local open = tradeSkill.OpenTradeSkill
    tradeSkill.OpenTradeSkill = nil
    SuuUI.OpenRecipe(4)
    tradeSkill.OpenTradeSkill = open
    expect(opened).never.toHaveBeenCalled()
    SuuUI.OpenRecipe(4)
    expect(opened).toHaveBeenCalledWith(171)
end

type Spell = { id: number, passive?: boolean, crafts?: boolean }
type Profession = { line: number, offset: number, spells: { [number]: Spell } }

local function professions(lines: { [number]: Profession })
    mock.fake("GetProfessions", function(): (number?, number?) return 1, 2 end)
    mock.fake("GetProfessionInfo", function(index: number): (string, number, number, number, number, number, number)
        local p = assert(lines[index])
        local n = 0
        for _ in pairs(p.spells) do n += 1 end
        return "name", 0, 1, 300, n, p.offset, p.line
    end)
    mock.fake("C_SpellBook.GetSpellBookItemInfo", function(slot: number, _: any): any
        for _, p in pairs(lines) do
            local s = p.spells[slot - p.offset]
            if s then return { spellID = s.id, isPassive = s.passive == true } end
        end
        return nil
    end)
    mock.fake("C_TradeSkillUI.CanTradeSkillShowCraftingUI", function(id: number): boolean
        for _, p in pairs(lines) do
            for _, s in pairs(p.spells) do if s.id == id then return s.crafts ~= false end end
        end
        return false
    end)
end

@test("ProfessionOpener: the profession's active spell that opens its window")
local function opener()
    professions({
        [1] = { line = 186, offset = 10, spells = { [1] = { id = 2656, passive = true }, [2] = { id = 2575, crafts = false }, [3] = { id = 2656 + 1 } } },
        [2] = { line = 393, offset = 20, spells = { [1] = { id = 8613 } } },
    })
    expect(SuuUI.ProfessionOpener(186)).toBe(2657)
    expect(SuuUI.ProfessionOpener(393)).toBe(8613)
    expect(SuuUI.ProfessionOpener(999)).toBeNil()
end

@test("ProfessionOpener copes with gaps in the client's answers")
local function openerGaps()
    mock.fake("GetProfessions", function(): (number?, number?) return 1, nil end)
    mock.fake("GetProfessionInfo", function(_: number): (string, number, number, number, number?, number?, number)
        return "name", 0, 1, 300, nil, nil, 186
    end)
    expect(SuuUI.ProfessionOpener(186)).toBeNil()
    -- slots with no info, or info without a spell
    local slot = 0
    mock.fake("GetProfessionInfo", function(_: number): (string, number, number, number, number?, number?, number)
        return "name", 0, 1, 300, 3, nil, 186
    end)
    mock.fake("C_SpellBook.GetSpellBookItemInfo", function(_: number, _: any): any
        slot += 1
        if slot == 1 then return nil end
        if slot == 2 then return { isPassive = false } end
        return { spellID = 2580, isPassive = false }
    end)
    mock.fake("C_TradeSkillUI.CanTradeSkillShowCraftingUI", function(_: number): boolean return true end)
    -- a client without the spell bank enum
    local enumAll: { [string]: any } = Enum :: any
    local banks = enumAll.SpellBookSpellBank
    enumAll.SpellBookSpellBank = nil
    local answer = SuuUI.ProfessionOpener(186)
    enumAll.SpellBookSpellBank = banks
    expect(answer).toBe(2580)
end

@test("ProfessionOpener without the client's profession API is nil")
local function openerNoApi()
    local answers: (number | boolean)[] = {}
    for _, name in ipairs({ "GetProfessions", "C_SpellBook", "C_TradeSkillUI" }) do
        local saved = _G[name]
        _G[name] = nil
        answers[#answers + 1] = SuuUI.ProfessionOpener(186) or false
        _G[name] = saved
    end
    expect(answers).toEqual({ false, false, false })
end

