import recipeSources from "/Data/RecipeSources"
import expectNoErrors from "../../helpers"

-- The API read by a name held in a string (the list below).
local api: { [string]: any } = SuuUI :: any

local function at(path: string): any
    local v: any = api
    for part in path:gmatch("[^%.]+") do
        if type(v) ~= "table" then return nil end
        v = v[part]
    end
    return v
end

-- Every SuuUI.* name Docs/API.md documents (and the UI components it lists
-- by name), as of API 0.17.
