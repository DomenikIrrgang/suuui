-- Core/Themes: registering themes, and applying the chosen one (then colour
-- vision) over the design's tokens, in place.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import tokens as T from "/Core/Tokens"
import * as themes from "/Core/Themes"
import * as settings from "/Core/Settings"
import * as events from "/Core/Events"
import * as vision from "/Core/Vision"
import * as draw from "/UI/Draw"
import * as fontObjects from "/Core/Fonts"
import * as controls from "/UI/Controls"
import * as barModule from "/UI/Bar"
import * as inputs from "/UI/Inputs"
import * as stage from "/UI/Stage"
import * as legacy from "/UI/Legacy"
import * as layout from "/UI/Layout"
import * as panel from "/UI/Panel"
import expectNoErrors, newParent, layoutThemes, COMPACT, ROOMY from "../../helpers"

const OWNER = "ThemesTest"

local changed: string[] = {}
events.on(
    "SUUUI_THEME_CHANGED",
    function(_: string, id: string)
        changed[#changed + 1] = id
    end,
    OWNER
)

local design = {
    gilt = { T.color.gilt[1], T.color.gilt[2], T.color.gilt[3], T.color.gilt[4], hex = T.color.gilt.hex },
    ember = { T.color.ember[1], T.color.ember[2], T.color.ember[3], hex = T.color.ember.hex },
    label = { file = T.type.label.file, size = T.type.label.size, lineHeight = T.type.label.lineHeight },
}

local function use(id: string?, colorVision: string?)
    settings.setAccount("theme", id)
    settings.setAccount("colorVision", colorVision)
    themes.apply()
end

@afterEach
local function back()
    settings.setAccount("healthColor", nil)
    settings.setAccount("npcHealthColor", nil)
    use(nil, nil)
    changed = {}
end

@test("SuuUI's own theme is the default and comes first")
local function default()
    expect(themes.DEFAULT).toBe("suuui")
    local first = themes.all()[1]
    expect(first.id).toBe("suuui")
    expect(first.name).toBe("SuuUI")
    expect(themes.get("suuui")).toBe(first)
    expect(themes.appliedTheme()).toBe("suuui")
    expect(themes.get("no-such-theme")).toBeNil()
end

@test("health colour: class colours by default; the setting's The theme's: the theme's fill, or its health = \"class\"")
local function health()
    -- (class colours the default since 2026-11-14, asked; whatever the theme says)
    expect(themes.health()).toBe("class")
    themes.register({ id = "test-health", health = "class" })
    themes.register({ id = "test-health-fill" })
    use("test-health-fill")
    expect(themes.health()).toBe("class")
    -- the setting on The theme's: what the theme says
    settings.setAccount("healthColor", "theme")
    expect(themes.health()).toBe("fill")
    use("test-health")
    expect(themes.health()).toBe("class")
    use(nil)
    expect(themes.health()).toBe("fill")
    -- an older save's explicit "class": class colours
    settings.setAccount("healthColor", "class")
    expect(themes.health()).toBe("class")
    settings.setAccount("healthColor", nil)
    expect(themes.health()).toBe("class")
    expect(function()
        themes.register({ id = "test-health-bad", health = "rainbow" })
    end).toThrow('SuuUI.RegisterTheme: test-health-bad\'s health is "fill" or "class", not "rainbow"')
    expect(themes.get("test-health-bad")).toBeNil()
end

@test("cast bar colour: class colours by default; the setting's The theme's: the theme's fill, or its cast = \"class\"")
local function cast()
    -- (asked 2026-11-14: class colours by default, the look before as an option)
    expect(themes.cast()).toBe("class")
    themes.register({ id = "test-cast", cast = "class" })
    themes.register({ id = "test-cast-fill" })
    use("test-cast-fill")
    expect(themes.cast()).toBe("class")
    settings.setAccount("castColor", "theme")
    expect(themes.cast()).toBe("fill")
    use("test-cast")
    expect(themes.cast()).toBe("class")
    use(nil)
    expect(themes.cast()).toBe("fill")
    settings.setAccount("castColor", nil)
    expect(themes.cast()).toBe("class")
    expect(function()
        themes.register({ id = "test-cast-bad", cast = "rainbow" })
    end).toThrow('SuuUI.RegisterTheme: test-cast-bad\'s cast is "fill" or "class", not "rainbow"')
    expect(themes.get("test-cast-bad")).toBeNil()
end

@test("NPC reaction colours: on by default whatever the theme; the setting's off turns them off; class colours apart")
local function reactionHealth()
    -- (on by default since 2026-11-14, asked)
    expect(themes.reactionHealth()).toBe(true)
    themes.register({ id = "test-reaction", health = "class" })
    use("test-reaction")
    expect(themes.reactionHealth()).toBe(true)
    use(nil)
    settings.setAccount("npcHealthColor", "off")
    expect(themes.reactionHealth()).toBe(false)
    -- (players' health is its own setting)
    expect(themes.health()).toBe("class")
    -- an older save's explicit "reaction": on
    settings.setAccount("npcHealthColor", "reaction")
    expect(themes.reactionHealth()).toBe(true)
    settings.setAccount("npcHealthColor", nil)
    expect(themes.reactionHealth()).toBe(true)
end

@test("a registered theme is listed and found; its name defaults to its id")
local function register()
    local n = #themes.all()
    local t = themes.register({ id = "test-plain" })
    expect(t.id).toBe("test-plain")
    expect(t.name).toBe("test-plain")
    expect(t.description).toBeNil()
    expect(t.colors).toEqual({})
    expect(t.fonts).toEqual({})
    expect(#themes.all()).toBe(n + 1)
    expect(themes.all()[n + 1]).toBe(t)
    expect(themes.get("test-plain")).toBe(t)
    local named = themes.register({ id = "test-named", name = "Named", description = "One line." })
    expect(named.name).toBe("Named")
    expect(named.description).toBe("One line.")
end

@test("a theme needs a free id, real colour tokens and real text styles")
local function refused()
    themes.register({ id = "test-taken" })
    expect(function()
        themes.register(nil)
    end).toThrow("SuuUI.RegisterTheme: a theme needs an id")
    expect(function()
        themes.register("x")
    end).toThrow("SuuUI.RegisterTheme: a theme needs an id")
    expect(function()
        themes.register({ name = "No id" })
    end).toThrow("SuuUI.RegisterTheme: a theme needs an id")
    expect(function()
        themes.register({ id = "" })
    end).toThrow("SuuUI.RegisterTheme: a theme needs an id")
    expect(function()
        themes.register({ id = "test-taken" })
    end).toThrow("SuuUI.RegisterTheme: the theme test-taken is taken")
    expect(function()
        themes.register({ id = "test-bad", colors = { glitter = { 1, 1, 1 } } })
    end).toThrow('SuuUI.RegisterTheme: test-bad has no colour token "glitter"')
    expect(function()
        themes.register({ id = "test-bad", fonts = { shouting = { size = 30 } } })
    end).toThrow('SuuUI.RegisterTheme: test-bad has no text style "shouting"')
    expect(themes.get("test-bad")).toBeNil()
end

@test("applying a theme sets its colours in place, with their hex, keeping alpha unless given")
local function colors()
    themes.register({ id = "test-colors", colors = { gilt = { 1, 0, 0.5 }, ["gilt-line"] = { 0, 1, 0, 0.25 } } })
    local gilt = T.color.gilt
    use("test-colors")
    expect(themes.appliedTheme()).toBe("test-colors")
    expect(T.color.gilt).toBe(gilt)
    expect({ gilt[1], gilt[2], gilt[3], gilt[4] }).toEqual({ 1, 0, 0.5, assert(design.gilt[4]) })
    expect(gilt.hex).toBe("ff0080")
    expect(T.color["gilt-line"][4]).toBe(0.25)
    expect(T.color["gilt-line"].hex).toBe("00ff00")
    expect(changed).toEqual({ "test-colors" })
    -- back to the design's
    use(nil)
    expect({ gilt[1], gilt[2], gilt[3], gilt[4] }).toEqual({
        assert(design.gilt[1]),
        assert(design.gilt[2]),
        assert(design.gilt[3]),
        assert(design.gilt[4]),
    })
    expect(gilt.hex).toBe(design.gilt.hex)
    expect(changed).toEqual({ "test-colors", "suuui" })
    expectNoErrors()
end

@test("a theme's fonts set a style's face, size and line height, each only if given")
local function fonts()
    themes.register({
        id = "test-fonts",
        fonts = { label = { size = 30 }, caption = { file = T.type.alert.file, lineHeight = 40 } },
    })
    use("test-fonts")
    expect(T.type.label.size).toBe(30)
    expect(T.type.label.file).toBe(design.label.file)
    expect(T.type.label.lineHeight).toBe(design.label.lineHeight)
    expect(T.type.caption.file).toBe(T.type.alert.file)
    expect(T.type.caption.lineHeight).toBe(40)
    -- the Font objects follow
    local _, size = fontObjects.get("label"):GetFont()
    expect(size).toBeCloseTo(30, 4)
    use(nil)
    expect(T.type.label.size).toBe(design.label.size)
end

@test("a style a theme names that is gone by the time it applies is skipped")
local function fontsGone()
    local t = themes.register({ id = "test-fonts-gone" })
    t.fonts = { ["no-such-style"] = { size = 99 } }
    use("test-fonts-gone")
    expect(themes.appliedTheme()).toBe("test-fonts-gone")
    expectNoErrors()
end

@test("a chosen theme that isn't registered (a plugin gone) applies SuuUI's")
local function missing()
    use("test-uninstalled")
    expect(themes.appliedTheme()).toBe("suuui")
    expect(T.color.gilt.hex).toBe(design.gilt.hex)
    expect(changed).toEqual({ "suuui" })
end

@test("worked-out colours are asked for your class")
local function worked()
    local asked: string[] = {}
    local _, class = UnitClass("player")
    themes.register({
        id = "test-worked",
        colors = function(c: string?): { [string]: number[] }
            asked[#asked + 1] = c or "?"
            return { gilt = { 0, 0, 1 }, ["not-a-token"] = { 1, 1, 1 } }
        end,
    })
    use("test-worked")
    expect(asked).toEqual({ class :: string })
    expect(T.color.gilt.hex).toBe("0000ff")
    expectNoErrors()
end

@test("worked-out colours that error or aren't a table leave the design's")
local function workedBroken()
    themes.register({
        id = "test-erroring",
        colors = function(_: string?): { [string]: number[] }
            error("broken")
        end,
    })
    themes.register({
        id = "test-not-table",
        colors = function(_: string?): themes.ThemeColors
            return "red" :: unknown :: themes.ThemeColors
        end,
    })
    use("test-erroring")
    expect(themes.appliedTheme()).toBe("test-erroring")
    expect(T.color.gilt.hex).toBe(design.gilt.hex)
    use("test-not-table")
    expect(T.color.gilt.hex).toBe(design.gilt.hex)
    expectNoErrors()
end

@test("colour vision applies on top of the theme")
local function visionOnTop()
    themes.register({ id = "test-ember", colors = { ember = { 0, 0, 0 }, gilt = { 0, 0, 0 } } })
    use("test-ember", "redgreen")
    expect(vision.appliedMode()).toBe("redgreen")
    expect(T.color.ember.hex).toBe("ec6b00")
    expect(T.color.gilt.hex).toBe("000000")
    use(nil, nil)
    expect(vision.appliedMode()).toBe("normal")
    expect(T.color.ember.hex).toBe(design.ember.hex)
end

@test("applying repaints what UI.Paint keeps")
local function repaint()
    local spy = mock.stub(draw, "repaint", function() end)
    themes.apply()
    expect(spy).toHaveBeenCalledTimes(1)
end

@test("applying sets again the colours whose token changed and leaves the rest; texts when the type changed")
local function repaintChanged()
    themes.register({ id = "test-repaint", colors = { gilt = { 1, 0, 0.5 } } })
    themes.register({ id = "test-repaint-type", colors = { gilt = { 1, 0, 0.5 } }, fonts = { label = { size = 15 } } })
    local p = newParent()
    local gilt, ember, text = p:CreateTexture(), p:CreateTexture(), p:CreateFontString(nil, "OVERLAY")
    draw.paint(gilt, "gilt")
    draw.paint(ember, "ember")
    draw.paint(text, "ember")
    local sets = { gilt = 0, ember = 0, text = 0 }
    hooksecurefunc(gilt, "SetVertexColor", function()
        sets.gilt += 1
    end)
    hooksecurefunc(ember, "SetVertexColor", function()
        sets.ember += 1
    end)
    hooksecurefunc(text, "SetTextColor", function()
        sets.text += 1
    end)
    use("test-repaint")
    expect(sets).toEqual({ gilt = 1, ember = 0, text = 0 })
    local r = gilt:GetVertexColor()
    expect(r).toBeCloseTo(1, 3)
    use("test-repaint-type")
    expect(sets).toEqual({ gilt = 1, ember = 0, text = 1 })
    use(nil)
    expect(sets).toEqual({ gilt = 2, ember = 0, text = 2 })
    r = gilt:GetVertexColor()
    expect(r).toBeCloseTo(assert(design.gilt[1]), 3)
    p:Hide()
    expectNoErrors()
end

@test("a theme's textures: real texture tokens, each a file path")
local function texturesRefused()
    expect(function()
        themes.register({ id = "test-tex-bad", textures = { sparkle = "Interface\\AddOns\\X\\a.tga" } })
    end).toThrow('SuuUI.RegisterTheme: test-tex-bad has no texture token "sparkle"')
    expect(function()
        themes.register({ id = "test-tex-bad", textures = { absorb = "" } })
    end).toThrow("SuuUI.RegisterTheme: test-tex-bad's texture absorb needs a file path")
    expect(function()
        local wrong: unknown = { absorb = 7 }
        themes.register({ id = "test-tex-bad", textures = wrong :: { [string]: string } })
    end).toThrow("SuuUI.RegisterTheme: test-tex-bad's texture absorb needs a file path")
    expect(function()
        local wrong: unknown = "Smooth.tga"
        themes.register({ id = "test-tex-bad", textures = wrong :: { [string]: string } })
    end).toThrow("SuuUI.RegisterTheme: test-tex-bad's textures are a table of texture tokens")
    expect(themes.get("test-tex-bad")).toBeNil()
end

@test("applying a theme sets its texture files on what was skinned; another theme brings SuuUI's back")
local function textures()
    local hatch, white = T.texture.absorb, T.texture["health-bar"]
    themes.register({
        id = "test-textures",
        textures = {
            absorb = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleDash.tga",
            ["health-bar"] = "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga",
        },
    })
    themes.register({ id = "test-textures-none", colors = { gilt = { 1, 0, 0 } } })
    -- a texture and a bar set by their tokens, live: they follow
    local f = CreateFrame("Frame")
    local shield = f:CreateTexture()
    draw.skin(shield, "absorb", true)
    local bar = CreateFrame("StatusBar", nil, f)
    draw.skinBar(bar, "health-bar")
    draw.paint(bar, "ember")
    use("test-textures")
    expect(T.texture.absorb).toBe("Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleDash.tga")
    expect(draw.textureFile("absorb")).toBe("Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleDash.tga")
    expect(T.texture["cast-bar"]).toBe(white)
    expect(shield:GetTextureFilePath()).toBe("Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleDash.tga")
    expect(shield:GetHorizTile()).toBe(true)
    expect(bar:GetStatusBarTexture():GetTextureFilePath()).toBe(
        "Interface\\AddOns\\SuuUI\\Media\\Textures\\CircleFill.tga"
    )
    -- the bar keeps its colour
    local r, g, b = bar:GetStatusBarColor()
    local er, eg, eb = draw.rgba("ember")
    expect(r).toBeCloseTo(er, 2)
    expect(g).toBeCloseTo(eg, 2)
    expect(b).toBeCloseTo(eb, 2)
    -- another theme without textures: SuuUI's files again
    use("test-textures-none")
    expect(T.texture.absorb).toBe(hatch)
    expect(shield:GetTextureFilePath()).toBe(hatch)
    expect(bar:GetStatusBarTexture():GetTextureFilePath()).toBe(white)
    use(nil)
    expect(T.texture["health-bar"]).toBe(white)
    expectNoErrors()
end

@test("a bar's art that repeats (0.39): { file, height } on the bar tokens only; applied live, stretched again after")
local function repeatingBars()
    local BEANS = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Themes\\PinkCat\\BeanBar.tga"
    expect(function()
        themes.register({ id = "test-rep-bad", textures = { absorb = { file = BEANS, height = 16 } } })
    end).toThrow("SuuUI.RegisterTheme: test-rep-bad's texture absorb is a file path (only a bar's fill repeats)")
    for _, wrong in ipairs({ { file = BEANS }, { file = "", height = 16 }, { file = BEANS, height = 0 } }) do
        expect(function()
            local given: unknown = { bar = wrong }
            themes.register({ id = "test-rep-bad", textures = given :: themes.ThemeTextures })
        end).toThrow("SuuUI.RegisterTheme: test-rep-bad's texture bar is { file = path, height = px }")
    end
    expect(themes.get("test-rep-bad")).toBeNil()
    themes.register({ id = "test-rep", textures = { bar = { file = BEANS, height = 16 } } })
    local f = newParent()
    local b = barModule.statusBar(f, { width = 300, height = 10, border = false })
    b:SetPoint("CENTER")
    local fill = b.bar:GetStatusBarTexture()
    use("test-rep")
    expect(T.texture.bar).toBe(BEANS)
    local over = assert(draw.repeatOf(b.bar))
    expect(over:GetTextureFilePath()).toBe(BEANS)
    expect(over:GetScale()).toBeCloseTo(10 / 16)
    expect(fill:GetAlpha()).toBe(0)
    use(nil)
    expect(draw.repeatOf(b.bar)).toBeNil()
    expect(fill:GetAlpha()).toBe(1)
    expect(fill:GetTextureFilePath()).toBe(T.texture.bar)
    expectNoErrors()
end

@test("a theme's window textures (0.39): validated like the others, set live on a panel, SuuUI's look back after")
local function windowTextures()
    local CAT = "Interface\\AddOns\\SuuUI\\Media\\Textures\\Themes\\PinkCat\\"
    -- an empty file is SuuUI's own: a theme can't give one
    expect(function()
        themes.register({ id = "test-win-bad", textures = { ["surface-pattern"] = "" } })
    end).toThrow("SuuUI.RegisterTheme: test-win-bad's texture surface-pattern needs a file path")
    themes.register({
        id = "test-windows",
        textures = {
            ["surface-pattern"] = CAT .. "SurfacePattern.tga",
            ["border"] = CAT .. "Stitch.tga",
            ["corner"] = CAT .. "CornerPaw.tga",
            ["jewel"] = CAT .. "Heart.tga",
            ["divider"] = CAT .. "Divider.tga",
        },
    })
    local p = panel.panel(UIParent, { title = "Test", ornament = true, width = 200, height = 100 })
    -- a plain panel (the bags, the character window: asked 2026-11-12) keeps
    -- its ground without the pattern, its other textures themed
    local plain = panel.panel(UIParent, { title = "Plain", plain = true, width = 200, height = 100 })
    expect(draw.patternOf(p.bg)).toBeNil()
    expect(p.border.top:GetTextureFilePath()).toBeNil()
    use("test-windows")
    expect(assert(draw.patternOf(p.bg)):GetTextureFilePath()).toBe(CAT .. "SurfacePattern.tga")
    expect(draw.patternOf(plain.bg)).toBeNil()
    expect(plain.border.top:GetTextureFilePath()).toBe(CAT .. "Stitch.tga")
    plain:Hide()
    expect(p.border.top:GetTextureFilePath()).toBe(CAT .. "Stitch.tga")
    expect(assert(p.ornTL):GetTextureFilePath()).toBe(CAT .. "CornerPaw.tga")
    expect(assert(p.jewel):GetTextureFilePath()).toBe(CAT .. "Heart.tga")
    expect(#assert(draw.dividerStrips(assert(p.divider)))).toBe(2)
    use(nil)
    expect(draw.patternOf(p.bg)).toBeNil()
    expect(p.border.top:GetTextureFilePath()).toBeNil()
    expect(assert(p.ornTL):GetTextureFilePath()).toBe("Interface\\Buttons\\WHITE8X8")
    expect(assert(p.ornTL):GetRotation()).toBeCloseTo(math.rad(45), 4)
    expect(draw.dividerStrips(assert(p.divider))).toBeNil()
    p:Hide()
    expectNoErrors()
end

-- a glow's colour as drawn (its first part's vertex colour)
local function glowIs(e: draw.SoftEdge, token: string)
    local r, g, b = e.parts[1]:GetVertexColor()
    local c = T.color[token]
    expect(r).toBeCloseTo(c[1], 3)
    expect(g).toBeCloseTo(c[2], 3)
    expect(b).toBeCloseTo(c[3], 3)
end

@test(
    "glows follow a theme's arcane, ember and ward live; the design's come back, and colour vision back to Normal too"
)
local function glows()
    themes.register({ id = "test-glows", colors = { arcane = { 1, 0, 0 }, ember = { 0, 1, 0 }, ward = { 0, 0, 1 } } })
    local f = CreateFrame("Frame")
    f:SetSize(20, 20)
    local arcane, ember, ward = draw.shadow(f, "glow-arcane"), draw.shadow(f, "glow-ember"), draw.shadow(f, "glow-ward")
    local alpha = T.shadow["glow-arcane"][1].color[4]
    use("test-glows")
    expect(T.color.arcane.hex).toBe("ff0000")
    glowIs(arcane, "arcane")
    glowIs(ember, "ember")
    glowIs(ward, "ward")
    -- the glow keeps its own alpha
    expect(select(4, arcane.parts[1]:GetVertexColor())).toBeCloseTo(alpha, 3)
    -- back to SuuUI's: the design's glows
    use(nil)
    expect(T.color.arcane.hex).toBe("3fd0ff")
    glowIs(arcane, "arcane")
    glowIs(ember, "ember")
    -- colour vision, then Normal again: the preset's glow goes
    use(nil, "redgreen")
    expect(T.color.ember.hex).toBe("ec6b00")
    glowIs(ember, "ember")
    use(nil, "normal")
    expect(T.color.ember.hex).toBe(design.ember.hex)
    glowIs(ember, "ember")
    -- a glow made while a theme is on takes it too
    use("test-glows")
    glowIs(draw.shadow(f, "glow-ember"), "ember")
    expectNoErrors()
end

@test("a theme's chat colours are left out, with a warning: the game's chat settings colour chat lines")
local function chatColors()
    local before = #mock.printed()
    themes.register({ id = "test-chat", colors = { ["chat-say"] = { 1, 0, 0 }, gilt = { 0, 1, 0 } } })
    local printed = mock.printed()
    expect(#printed).toBe(before + 1)
    expect(printed[#printed]).toBe(
        "SuuUI.RegisterTheme: test-chat sets chat-say, which is left out: chat colours come from the game's chat settings"
    )
    use("test-chat")
    expect(themes.appliedTheme()).toBe("test-chat")
    expect(T.color["chat-say"].hex).toBe("ffffff")
    expect({ T.color["chat-say"][1], T.color["chat-say"][2], T.color["chat-say"][3] }).toEqual({ 1, 1, 1 })
    -- the rest of the theme applies; the warning came once
    expect(T.color.gilt.hex).toBe("00ff00")
    expect(#mock.printed()).toBe(before + 1)
    -- worked out for your class: left out when it applies
    themes.register({
        id = "test-chat-fn",
        colors = function(_class: string?): themes.ThemeColors
            return { ["chat-loot"] = { 1, 0, 0 } }
        end,
    })
    use("test-chat-fn")
    expect(T.color["chat-loot"].hex).toBe("00aa00")
    printed = mock.printed()
    expect(#printed).toBe(before + 2)
    expect(printed[#printed]).toBe(
        "SuuUI.RegisterTheme: test-chat-fn sets chat-loot, which is left out: chat colours come from the game's chat settings"
    )
    use("test-chat-fn")
    expect(#mock.printed()).toBe(before + 2)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- 0.37: icons by name, the rest of the UI's textures, shade, sizes
--------------------------------------------------------------------------------

-- SuuUI's own files (a file that isn't there reads back nil)
local MEDIA = "Interface\\AddOns\\SuuUI\\Media\\Textures\\"

@test("a theme's glyphs: real glyph names, each a file path")
local function glyphsRefused()
    expect(function()
        themes.register({ id = "test-glyph-bad", glyphs = { sparkle = MEDIA .. "Glyphs\\star.tga" } })
    end).toThrow('SuuUI.RegisterTheme: test-glyph-bad has no glyph "sparkle"')
    expect(function()
        themes.register({ id = "test-glyph-bad", glyphs = { bag = "" } })
    end).toThrow("SuuUI.RegisterTheme: test-glyph-bad's glyph bag needs a file path")
    expect(function()
        local wrong: unknown = { bag = 7 }
        themes.register({ id = "test-glyph-bad", glyphs = wrong :: { [string]: string } })
    end).toThrow("SuuUI.RegisterTheme: test-glyph-bad's glyph bag needs a file path")
    expect(function()
        local wrong: unknown = "bag.tga"
        themes.register({ id = "test-glyph-bad", glyphs = wrong :: { [string]: string } })
    end).toThrow("SuuUI.RegisterTheme: test-glyph-bad's glyphs are a table of glyph names")
    expect(themes.get("test-glyph-bad")).toBeNil()
end

@test(
    "a theme's glyph replaces the icon live, keeping its colour, size and cut; another theme brings SuuUI's back; one set otherwise since is left alone"
)
local function glyphs()
    local bag, search = T.glyph.bag, T.glyph.search
    local star, skull = MEDIA .. "Glyphs\\star.tga", MEDIA .. "Glyphs\\skull.tga"
    themes.register({ id = "test-glyphs", glyphs = { bag = star, search = skull } })
    themes.register({ id = "test-glyphs-none", colors = { gilt = { 1, 0, 0 } } })
    local f = CreateFrame("Frame")
    local icon = f:CreateTexture()
    draw.glyph(icon, "bag")
    draw.paint(icon, "ember")
    icon:SetSize(14, 14)
    icon:SetTexCoord(0.1, 0.9, 0.2, 0.8)
    expect(icon:GetTextureFilePath()).toBe(bag)
    expect(draw.glyphOf(icon)).toBe("bag")
    -- a texture given a glyph, then an item's icon: let go
    local other = f:CreateTexture()
    draw.glyph(other, "bag")
    other:SetTexture(MEDIA .. "Hatch.tga")
    expect(draw.glyphOf(other)).toBeNil()
    -- a button's icon (a component's glyph by name)
    local b = controls.button(f, { text = "Find" })
    b:SetIcon("search")
    use("test-glyphs")
    expect(T.glyph.bag).toBe(star)
    expect(draw.glyphFile("bag")).toBe(star)
    expect(T.glyph.close).toBe(MEDIA .. "Glyphs\\close.tga")
    expect(icon:GetTextureFilePath()).toBe(star)
    expect(icon:GetWidth()).toBe(14)
    local l, t, _, _, _, _, r, bottom = icon:GetTexCoord()
    expect(l).toBeCloseTo(0.1, 3)
    expect(t).toBeCloseTo(0.2, 3)
    expect(r).toBeCloseTo(0.9, 3)
    expect(bottom).toBeCloseTo(0.8, 3)
    local ir, ig, ib = icon:GetVertexColor()
    local er, eg, eb = draw.rgba("ember")
    expect(ir).toBeCloseTo(er, 2)
    expect(ig).toBeCloseTo(eg, 2)
    expect(ib).toBeCloseTo(eb, 2)
    expect(other:GetTextureFilePath()).toBe(MEDIA .. "Hatch.tga")
    expect((assert(b.icon)):GetTextureFilePath()).toBe(skull)
    -- made while the theme is on: the theme's; inline marks too
    local late = f:CreateTexture()
    draw.glyph(late, "search")
    expect(late:GetTextureFilePath()).toBe(skull)
    themes.register({ id = "test-glyphs-check", glyphs = { check = star } })
    use("test-glyphs-check")
    expect(draw.inlineMark("check", "fel"):find(star, 1, true) ~= nil).toBe(true)
    -- another theme: SuuUI's again
    use("test-glyphs-none")
    expect(T.glyph.bag).toBe(bag)
    expect(icon:GetTextureFilePath()).toBe(bag)
    expect(late:GetTextureFilePath()).toBe(search)
    expect((assert(b.icon)):GetTextureFilePath()).toBe(search)
    expect(draw.inlineMark("check", "fel"):find(MEDIA .. "Glyphs\\check.tga", 1, true) ~= nil).toBe(true)
    -- a name that isn't a glyph: set as before, not kept
    local odd = f:CreateTexture()
    draw.glyph(odd, "compassRose")
    expect(draw.glyphOf(odd)).toBeNil()
    expectNoErrors()
end

local function file(t: Texture): string?
    return t:GetTextureFilePath()
end

@test(
    "a theme's bar, circles, swing hatch and checkbox tick reach SuuUI's bars, stage, swing timer and checkboxes live"
)
local function look()
    local white, soft, tick = T.texture.bar, T.texture["circle-soft"], T.texture.check
    themes.register({
        id = "test-look",
        textures = {
            bar = MEDIA .. "Hatch.tga",
            ["circle-soft"] = MEDIA .. "CircleDash.tga",
            ["swing-delay"] = MEDIA .. "Soft.tga",
            check = MEDIA .. "Glyphs\\check.tga",
        },
    })
    local parent = newParent()
    local b = barModule.statusBar(parent, { fill = "progress-fill" })
    local fill = draw.barFill(parent, "progress-fill")
    local mark = inputs.check(parent, 12)
    local st = stage.modelStage(CreateFrame("Frame", nil, parent))
    expect(file(b.bar:GetStatusBarTexture())).toBe(white)
    expect(draw.skinOf(mark)).toBe("check")
    expect(file(st.light)).toBe(soft)
    use("test-look")
    expect(file(b.bar:GetStatusBarTexture())).toBe(MEDIA .. "Hatch.tga")
    expect(file(fill)).toBe(MEDIA .. "Hatch.tga")
    expect(file(mark)).toBe(MEDIA .. "Glyphs\\check.tga")
    expect(file(st.light)).toBe(MEDIA .. "CircleDash.tga")
    -- the fill keeps its colour
    local r, g = fill:GetVertexColor()
    local pr, pg = draw.rgba("progress-fill")
    expect(r).toBeCloseTo(pr, 2)
    expect(g).toBeCloseTo(pg, 2)
    use(nil)
    expect(file(b.bar:GetStatusBarTexture())).toBe(white)
    expect(file(fill)).toBe(white)
    expect(draw.textureFile("check")).toBe(tick)
    expect(file(st.light)).toBe(soft)
    expectNoErrors()
end

@test("shade: black by default; a theme's shade colours the dark overlays live, each at its own strength")
local function shade()
    themes.register({ id = "test-shade", colors = { shade = { 0.3, 0, 0.4 } } })
    local st = stage.modelStage(CreateFrame("Frame", nil, newParent()))
    local r, g, b, a = st.shadow:GetVertexColor()
    expect({ r, g, b }).toEqual({ 0, 0, 0 })
    expect(a).toBeCloseTo(0.4, 2)
    use("test-shade")
    r, g, b, a = st.shadow:GetVertexColor()
    expect(r).toBeCloseTo(0.3, 2)
    expect(g).toBeCloseTo(0, 2)
    expect(b).toBeCloseTo(0.4, 2)
    expect(a).toBeCloseTo(0.4, 2)
    use(nil)
    r, g, b, a = st.shadow:GetVertexColor()
    expect({ r, g, b }).toEqual({ 0, 0, 0 })
    expect(a).toBeCloseTo(0.4, 2)
    expectNoErrors()
end

@test("a size of its own follows its text style: px on SuuUI's theme, scaled with a theme's size, live on what shows")
local function sizes()
    expect(fontObjects.size("alert", 21)).toBe(21)
    expect(fontObjects.size("header", 9.5)).toBe(9.5)
    themes.register({
        id = "test-sizes",
        fonts = { numeric = { size = 18, lineHeight = 22 }, body = { lineHeight = 24 } },
    })
    local points = legacy.legacyPoints(newParent())
    local _, big = points.account.big:GetFont()
    expect(big).toBeCloseTo(20, 1)
    use("test-sizes")
    expect(fontObjects.size("numeric", 20)).toBeCloseTo(30, 3)
    _, big = points.account.big:GetFont()
    expect(big).toBeCloseTo(30, 1)
    use(nil)
    _, big = points.account.big:GetFont()
    expect(big).toBeCloseTo(20, 1)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- Spacing, sizes and radii (0.38)
--------------------------------------------------------------------------------

@test("a theme's spacing, sizes and radii: real tokens, numbers in range")
local function geometryRefused()
    local function refused(def: themes.ThemeDef, message: string)
        expect(function()
            themes.register(def)
        end).toThrow(message)
    end
    refused(
        { id = "test-geo", space = { ["space-9"] = 4 } },
        'SuuUI.RegisterTheme: test-geo has no spacing token "space-9"'
    )
    refused(
        { id = "test-geo", sizes = { ["icon-xl"] = 40 } },
        'SuuUI.RegisterTheme: test-geo has no size token "icon-xl"'
    )
    refused(
        { id = "test-geo", radius = { ["radius-lg"] = 4 } },
        'SuuUI.RegisterTheme: test-geo has no radius token "radius-lg"'
    )
    -- spacing from 0 to four times the design's
    refused(
        { id = "test-geo", space = { ["space-2"] = 17 } },
        "SuuUI.RegisterTheme: test-geo's spacing token space-2 is a number from 0 to 16 px (the design's is 4), not 17"
    )
    refused(
        { id = "test-geo", space = { ["space-2"] = -1 } },
        "SuuUI.RegisterTheme: test-geo's spacing token space-2 is a number from 0 to 16 px"
    )
    local text: unknown = "8"
    refused(
        { id = "test-geo", space = { ["space-4"] = text :: number } },
        "SuuUI.RegisterTheme: test-geo's spacing token space-4 is a number from 0 to 32 px (the design's is 8), not 8"
    )
    -- sizes from a quarter to four times
    refused(
        { id = "test-geo", sizes = { ["icon-md"] = 5 } },
        "SuuUI.RegisterTheme: test-geo's size token icon-md is a number from 6 to 96 px (the design's is 24), not 5"
    )
    refused(
        { id = "test-geo", sizes = { slot = 145 } },
        "SuuUI.RegisterTheme: test-geo's size token slot is a number from 9 to 144 px"
    )
    -- radii: px, or a share for radius-round
    refused(
        { id = "test-geo", radius = { ["radius-md"] = 13 } },
        "SuuUI.RegisterTheme: test-geo's radius radius-md is a number from 0 to 12 px, not 13"
    )
    refused(
        { id = "test-geo", radius = { ["radius-round"] = "60%" } },
        'SuuUI.RegisterTheme: test-geo\'s radius radius-round is a share from "0%" to "50%", not 60%'
    )
    refused(
        { id = "test-geo", radius = { ["radius-round"] = 8 } },
        'SuuUI.RegisterTheme: test-geo\'s radius radius-round is a share from "0%" to "50%", not 8'
    )
    local wrong: unknown = 4
    refused(
        { id = "test-geo", space = wrong :: { [string]: number } },
        "SuuUI.RegisterTheme: test-geo's space are a table of spacing tokens"
    )
    refused(
        { id = "test-geo", sizes = wrong :: { [string]: number } },
        "SuuUI.RegisterTheme: test-geo's sizes are a table of size tokens"
    )
    expect(themes.get("test-geo")).toBeNil()
    -- the edges are fine
    themes.register({
        id = "test-geo-edges",
        space = { ["space-1"] = 0, ["space-7"] = 112 },
        sizes = { ["icon-sm"] = 4, minimap = 704 },
        radius = { ["radius-sm"] = 0, ["radius-round"] = "0%" },
    })
    expect(themes.get("test-geo-edges")).never.toBeNil()
end

@test("applying a theme's spacing and sizes sets the tokens in place; another theme brings the design's back")
local function geometryApplied()
    layoutThemes()
    local space, size, radius = T.space, T.size, T.radius
    local before = { s2 = space["space-2"], s5 = space["space-5"], slot = size.slot, icon = size["icon-md"] }
    expect(before).toEqual({ s2 = 4, s5 = 12, slot = 36, icon = 24 })
    use(COMPACT)
    expect(T.space).toBe(space)
    expect(space["space-2"]).toBe(2)
    expect(space["space-5"]).toBe(8)
    expect(size.slot).toBe(30)
    expect(size["icon-md"]).toBe(20)
    -- what the theme leaves alone stays the design's
    expect(size["chat-w"]).toBe(444)
    expect(radius["radius-md"]).toBe(3)
    use(ROOMY)
    expect(space["space-2"]).toBe(6)
    expect(size.slot).toBe(42)
    -- a theme without any: every one the design's again, exactly
    themes.register({ id = "test-geo-none", colors = { gilt = { 1, 0, 0 } } })
    use("test-geo-none")
    expect({ s2 = space["space-2"], s5 = space["space-5"], slot = size.slot, icon = size["icon-md"] }).toEqual(before)
    use(COMPACT)
    use(nil)
    expect({ s2 = space["space-2"], s5 = space["space-5"], slot = size.slot, icon = size["icon-md"] }).toEqual(before)
    expect(changed[#changed]).toBe("suuui")
    themes.register({ id = "test-geo-radius", radius = { ["radius-md"] = 6, ["radius-round"] = "25%" } })
    use("test-geo-radius")
    expect(radius["radius-md"]).toBe(6)
    expect(radius["radius-round"]).toBe("25%")
    use(nil)
    expect(radius["radius-md"]).toBe(3)
    expect(radius["radius-round"]).toBe("50%")
    expectNoErrors()
end

@test("what keeps its layout is laid out again when the spacing or sizes move, not for a colour")
local function relaidOut()
    layoutThemes()
    local f = newParent()
    local runs = 0
    draw.layout(f, function(frame: Frame)
        runs += 1
        frame:SetSize(T.size.slot, T.space["space-4"])
    end)
    expect(runs).toBe(1)
    expect({ f:GetSize() }).toEqual({ 36, 8 })
    use(COMPACT)
    expect(runs).toBe(2)
    expect({ f:GetSize() }).toEqual({ 30, 5 })
    -- a theme with the same spacing and sizes (or a colour vision change): no
    -- layout
    use(COMPACT, "deuteranopia")
    expect(runs).toBe(2)
    use(nil)
    expect(runs).toBe(3)
    expect({ f:GetSize() }).toEqual({ 36, 8 })
    -- stacks and grids with token gaps and padding follow too
    local box = newParent()
    local s = layout.stack(box, { gap = "space-3", padding = { "space-5", 0, "space-2", 0 } })
    local a, b = CreateFrame("Frame", nil, box), CreateFrame("Frame", nil, box)
    a:SetSize(10, 10)
    b:SetSize(10, 10)
    s:Add(a)
    s:Add(b)
    s:ApplyNow()
    expect(select(5, b:GetPoint())).toBe(-(4 + 10 + 6))
    expect(select(4, b:GetPoint())).toBe(12)
    use(ROOMY)
    s:ApplyNow()
    expect(select(5, b:GetPoint())).toBe(-(6 + 10 + 9))
    expect(select(4, b:GetPoint())).toBe(18)
    use(nil)
    s:ApplyNow()
    expect(select(5, b:GetPoint())).toBe(-(4 + 10 + 6))
    expectNoErrors()
end

@test("in combat a protected frame's layout waits for the end of the fight; the rest moves at once")
local function relayoutInCombat()
    layoutThemes()
    local secure = CreateFrame("Button", nil, UIParent, "SecureActionButtonTemplate")
    local plain = newParent()
    draw.layout(secure, function(frame: Frame)
        frame:SetSize(T.size.slot, T.size.slot)
    end)
    draw.layout(plain, function(frame: Frame)
        frame:SetSize(T.size.slot, T.size.slot)
    end)
    mock.player:enterCombat()
    use(COMPACT)
    expect(secure:GetWidth()).toBe(36)
    expect(plain:GetWidth()).toBe(30)
    -- (the tokens then: changed twice in the fight, laid out once at its end)
    use(ROOMY)
    expect(secure:GetWidth()).toBe(36)
    mock.player:leaveCombat()
    expect(secure:GetWidth()).toBe(42)
    use(nil)
    expect(secure:GetWidth()).toBe(36)
    expectNoErrors()
end
