-- Core/RolePresets: a profile per role with its layout, put in its role's
-- place under Profiles › By role; plugins' values per role.

import test, expect, afterEach from "wowlua:test"
import * as tbl from "wowlua:table"
import * as mock from "wowlua:mock"
import * as rolePresets from "/Core/RolePresets"
import * as settings from "/Core/Settings"
import * as extend from "/Core/Extend"
import expectNoErrors from "../../helpers"

local profiles = settings.profiles

local function stored(profileName: string): settings.Profile
    local exported = assert(profiles.export(profileName))
    return exported.data
end

@afterEach
local function cleanUp()
    if InCombatLockdown() then
        mock.player:leaveCombat()
    end
    for _, role in ipairs(rolePresets.ROLES) do
        profiles.setRoleProfile(role, nil)
        local name = profiles.find(rolePresets.NAME[role])
        if name then
            profiles.delete(name)
        end
    end
    local other = profiles.find("SuuHealer2")
    if other then
        profiles.delete(other)
    end
end

@test("three roles, each with its profile's name and a layout")
local function roles()
    expect(rolePresets.ROLES).toEqual({ "TANK", "HEALER", "DAMAGER" })
    expect(rolePresets.NAME).toEqual({ TANK = "SuuTank", HEALER = "SuuHeal", DAMAGER = "SuuDps" })
    -- the default layout; pets: tanks in the party, DPS none
    expect(rolePresets.LAYOUT.TANK).toEqual({ raid = { showPets = false } })
    expect(rolePresets.LAYOUT.DAMAGER).toEqual({ party = { showPets = false }, raid = { showPets = false } })
    local healer = assert(rolePresets.LAYOUT.HEALER)
    expect(assert(healer.party).position).toEqual({ point = "BOTTOM", x = 0, y = 306 })
    expect(assert(healer.swingtimer).position).toEqual({ point = "BOTTOM", x = 0, y = 271, hidden = true })
    expect((assert(healer.raid).position :: { y: number }).y).toBe(332 - (8 * 20 + 7 * 4))
end

@test("exists: only a profile of exactly the preset's name (any letter case)")
local function exists()
    expect(rolePresets.exists("TANK")).toBe(false)
    expect(rolePresets.exists("WIZARD")).toBe(false)
    -- a profile whose name only starts with the preset's isn't it
    expect(profiles.create("SuuHealer2")).toBe(true)
    expect(rolePresets.exists("HEALER")).toBe(false)
    expect(profiles.create("suutank")).toBe(true)
    expect(rolePresets.exists("TANK")).toBe(true)
end

@test("applying a preset makes its profile and puts it in the role's place")
local function apply()
    local before = profiles.current()
    expect(rolePresets.apply("TANK")).toBe(true)
    expect(rolePresets.exists("TANK")).toBe(true)
    expect(profiles.roleProfile("TANK")).toBe("SuuTank")
    -- the profile in use doesn't change
    expect(profiles.current()).toBe(before)
    expectNoErrors()
end

@test("the healer preset stores its layout; values at their default aren't stored")
local function healer()
    expect(rolePresets.apply("HEALER")).toBe(true)
    local data = stored("SuuHeal")
    expect(tbl.field(data, "party", "width")).toBe(120)
    expect(tbl.field(data, "party", "direction")).toBe("right")
    expect(tbl.field(data, "unitframes", "playerPosition")).toEqual({ point = "BOTTOM", x = -474, y = 300 })
    expect(tbl.field(data, "raid", "arrangement")).toBe("rows")
    -- the raid's pets under the groups up to 20, above the chat from 21
    expect(tbl.field(data, "raid", "petPlace")).toBe("below")
    expect(tbl.field(data, "raid", "petPlaceLarge")).toBe("own")
    -- (its own place above the chat: the setting's default, not stored)
    expect(tbl.field(data, "raid", "petPosition")).toBeNil()
end

@test("a preset's false is stored: DPS without pets, tanks without raid pets")
local function falseValues()
    expect(rolePresets.apply("DAMAGER")).toBe(true)
    local dps = stored("SuuDps")
    expect(tbl.field(dps, "party", "showPets")).toBe(false)
    expect(tbl.field(dps, "raid", "showPets")).toBe(false)
    expect(rolePresets.apply("TANK")).toBe(true)
    local tank = stored("SuuTank")
    expect(tbl.field(tank, "raid", "showPets")).toBe(false)
    -- (the party's pets on: the default, not stored)
    expect(tbl.field(tank, "party", "showPets")).toBeNil()
end

@test("applying again puts the layout back")
local function again()
    expect(rolePresets.apply("HEALER")).toBe(true)
    -- a player's edit of the preset's profile
    profiles.setValues("SuuHeal", { { "party", "width", 161 } })
    expect(tbl.field(stored("SuuHeal"), "party", "width")).toBe(161)
    expect(rolePresets.apply("HEALER")).toBe(true)
    expect(tbl.field(stored("SuuHeal"), "party", "width")).toBe(120)
end

@test("a preset of the profile in use applies through the settings at once")
local function inUse()
    expect(rolePresets.apply("HEALER")).toBe(true)
    local before = assert(profiles.current())
    expect(profiles.use("SuuHeal")).toBe(true)
    settings.set("party", "width", 150)
    expect(rolePresets.apply("HEALER")).toBe(true)
    expect(settings.get("party", "width")).toBe(120)
    expect(profiles.use(before)).toBe(true)
end

@test("not in combat, and not for a role that isn't one")
local function refused()
    local ok, why = rolePresets.apply("WIZARD")
    expect(ok).toBe(false)
    expect(why).toBe("No such role.")
    mock.player:enterCombat()
    ok, why = rolePresets.apply("TANK")
    expect(ok).toBe(false)
    expect(why).toBe("After the fight.")
    expect(rolePresets.exists("TANK")).toBe(false)
end

@test("a plugin's values for the role are stored; another role's keys go to their default")
local function additions()
    mock.stub(extend, "additions", function(listName: string): unknown[]
        expect(listName).toBe("rolepresets")
        return {
            { role = "HEALER", namespace = "ui", values = { reducedMotion = true } },
            { role = "TANK", namespace = "ui", values = { reducedMotion = false, hideIssueReporter = false } },
            { role = "TANK", namespace = "ui", values = { hideIssueReporter = false } },
            -- an addition without values
            { role = "DAMAGER", namespace = "ui" },
        }
    end)
    expect(rolePresets.apply("HEALER")).toBe(true)
    local healer = stored("SuuHeal")
    expect(tbl.field(healer, "ui", "reducedMotion")).toBe(true)
    expect(tbl.field(healer, "ui", "hideIssueReporter")).toBeNil()
    expect(rolePresets.apply("TANK")).toBe(true)
    local tank = stored("SuuTank")
    expect(tbl.field(tank, "ui", "hideIssueReporter")).toBe(false)
    expect(tbl.field(tank, "ui", "reducedMotion")).toBeNil()
end

@test("a preset whose values can't be stored says why")
local function cannotStore()
    mock.stub(profiles, "setValues", function(_: string?, _: { [number]: unknown }[]): (boolean, string?)
        return false, "A profile needs a name."
    end)
    local ok, why = rolePresets.apply("DAMAGER")
    expect(ok).toBe(false)
    expect(why).toBe("A profile needs a name.")
    expect(profiles.roleProfile("DAMAGER")).toBeNil()
end

@test("a preset fills a layout for each screen size: 1080p's side layout three groups side by side from 21 players")
local function bySize()
    expect(rolePresets.SIZES).toEqual({ "1920x1080", "2560x1440", "3840x2160", "3440x1440" })
    expect(rolePresets.apply("TANK")).toBe(true)
    local data = stored("SuuTank")
    for _, size in ipairs(rolePresets.SIZES) do
        expect(tbl.field(data, "__layouts", size) ~= nil).toBe(true)
    end
    expect(tbl.field(data, "__layouts", "1920x1080", "raid", "perBandLarge")).toBe(3)
    -- wider screens: the default (four), not stored
    expect(tbl.field(data, "__layouts", "2560x1440", "raid", "perBandLarge")).toBeNil()
    expect(tbl.field(data, "__layouts", "3440x1440", "raid", "perBandLarge")).toBeNil()
    -- from 1440p the groups grow up from the chat; 1080p keeps the default
    expect(tbl.field(data, "__layouts", "1920x1080", "raid", "growth")).toBeNil()
    for _, size in ipairs({ "2560x1440", "3840x2160", "3440x1440" }) do
        expect(tbl.field(data, "__layouts", size, "raid", "growth")).toBe("up")
    end
    -- the healer's layout at every size
    expect(rolePresets.apply("HEALER")).toBe(true)
    local healer = stored("SuuHeal")
    for _, size in ipairs(rolePresets.SIZES) do
        expect(tbl.field(healer, "__layouts", size, "party", "width")).toBe(120)
        expect(tbl.field(healer, "__layouts", size, "raid", "arrangement")).toBe("rows")
    end
    -- a player's edit at one size, then the preset again: back
    profiles.setValues("SuuHeal", { { "party", "width", 161, "2560x1440" } })
    expect(tbl.field(stored("SuuHeal"), "__layouts", "2560x1440", "party", "width")).toBe(161)
    expect(rolePresets.apply("HEALER")).toBe(true)
    expect(tbl.field(stored("SuuHeal"), "__layouts", "2560x1440", "party", "width")).toBe(120)
end
