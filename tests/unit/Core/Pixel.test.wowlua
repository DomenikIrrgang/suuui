-- Core/Pixel: physical pixels in UI units, and SUUUI_PIXEL_CHANGED when the
-- screen height or UIParent's scale really changed.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as pixel from "/Core/Pixel"
import * as events from "/Core/Events"
import newParent, expectNoErrors from "../../helpers"

const OWNER = "PixelTest"

type Change = { height: number, scale: number }
local changes: Change[] = {}
events.on("SUUUI_PIXEL_CHANGED", function(_: string, h: number, s: number)
    changes[#changes + 1] = { height = h, scale = s }
end, OWNER)

local function screen(width: number, height: number)
    mock.fake("GetPhysicalScreenSize", function(): (number, number) return width, height end)
end

@afterEach
local function resync()
    -- the fakes are gone: back to the client's screen, heard by everyone
    mock.fireEvent("DISPLAY_SIZE_CHANGED")
    changes = {}
end

@test("the screen height is the physical screen's")
local function height()
    screen(2560, 1440)
    expect(pixel.screenHeight()).toBe(1440)
end

@test("the pixel-perfect scale is 768 over the screen height")
local function perfect()
    screen(1920, 1080)
    expect(pixel.perfectScale()).toBeCloseTo(768 / 1080, 6)
    screen(3840, 2160)
    expect(pixel.perfectScale()).toBeCloseTo(768 / 2160, 6)
end

@test("one pixel in a region's own units, UIParent's by default")
local function size()
    screen(2560, 1440)
    local p = newParent()
    p:SetScale(2)
    expect(pixel.size()).toBeCloseTo((768 / 1440) / UIParent:GetEffectiveScale(), 6)
    expect(pixel.size(p)).toBeCloseTo((768 / 1440) / p:GetEffectiveScale(), 6)
    expect(pixel.size(p)).toBeCloseTo(pixel.size() / 2, 6)
    p:Hide()
end

@test("snap rounds to whole physical pixels")
local function snap()
    screen(2560, 1440)
    local p = pixel.size()
    expect(pixel.snap(0)).toBe(0)
    expect(pixel.snap(p * 3.4)).toBeCloseTo(p * 3, 6)
    expect(pixel.snap(p * 3.6)).toBeCloseTo(p * 4, 6)
    expect(pixel.snap(p * 2.5)).toBeCloseTo(p * 3, 6)
    expect(pixel.snap(-p * 1.2)).toBeCloseTo(-p, 6)
    local f = newParent()
    f:SetScale(0.5)
    expect(pixel.snap(pixel.size(f) * 7.2, f)).toBeCloseTo(pixel.size(f) * 7, 6)
    f:Hide()
end

@test("a new screen height is announced once, with the scale")
local function announced()
    screen(3000, 1987)
    mock.fireEvent("DISPLAY_SIZE_CHANGED")
    expect(#changes).toBe(1)
    expect(changes[1].height).toBe(1987)
    expect(changes[1].scale).toBe(UIParent:GetEffectiveScale())
    mock.fireEvent("UI_SCALE_CHANGED")
    mock.fireEvent("DISPLAY_SIZE_CHANGED")
    expect(#changes).toBe(1)
    expectNoErrors()
end

@test("UIParent's scale changing is announced")
local function scaleChange()
    screen(3000, 1988)
    mock.fireEvent("UI_SCALE_CHANGED")
    local before = UIParent:GetScale()
    UIParent:SetScale(before * 0.9)
    mock.fireEvent("UI_SCALE_CHANGED")
    UIParent:SetScale(before)
    expect(#changes).toBe(2)
    expect(changes[2].scale).toBeCloseTo(changes[1].scale * 0.9, 6)
end

@test("only the UI scale CVars are checked on CVAR_UPDATE")
local function cvars()
    screen(3000, 1989)
    mock.fireEvent("CVAR_UPDATE", "gamma", "1.2")
    expect(#changes).toBe(0)
    mock.fireEvent("CVAR_UPDATE", "uiScale", "0.9")
    expect(#changes).toBe(1)
    screen(3000, 1990)
    mock.fireEvent("CVAR_UPDATE", "useUiScale", "1")
    expect(#changes).toBe(2)
end

@test("/suu pixel prints the screen, the scales and one pixel")
local function command()
    screen(2560, 1440)
    local before = #mock.printed()
    mock.slash("/suu pixel")
    local lines = mock.printed()
    expect(#lines).toBe(before + 1)
    local line = lines[#lines]
    expect(line:find("Screen 2560x1440", 1, true) ~= nil).toBe(true)
    expect(line:find(("pixel-perfect scale %.3f"):format(768 / 1440), 1, true) ~= nil).toBe(true)
    expectNoErrors()
end
