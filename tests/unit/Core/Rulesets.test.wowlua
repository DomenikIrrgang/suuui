-- Core/Rulesets: this character's ruleset (for now the realm's name), its
-- name as SuuUI shows it, and the ruleset of a character's key.

import test, expect from "wowlua:test"
import * as mock from "wowlua:mock"
import * as rulesets from "/Core/Rulesets"

@test("the ruleset: the realm's name for now; shown as \"… Ruleset\"")
local function current()
    local realm = GetRealmName()
    expect(rulesets.current()).toBe(realm)
    expect(rulesets.displayName("PvP Roleplay")).toBe("PvP Roleplay Ruleset")
    -- the client telling nothing
    mock.stub(_G, "GetRealmName", function(): string
        return ""
    end)
    expect(rulesets.current()).toBe("?")
end

@test("a character's key says its ruleset by its realm")
local function ofCharKey()
    expect(rulesets.ofCharKey("Aster - Normal")).toBe("Normal")
    expect(rulesets.ofCharKey("Aster - PvP Roleplay")).toBe("PvP Roleplay")
    expect(rulesets.ofCharKey("Aster")).toBeNil()
end

@test("the ruleset is the last word of Forever's server name")
local function kinds()
    expect(rulesets.displayName("CAMWOW EU5 Realm 3 PvE")).toBe("Normal Ruleset")
    expect(rulesets.displayName("CAMWOW EU5 Realm 4 PvP")).toBe("PvP Ruleset")
    expect(rulesets.displayName("CAMWOW EU5 Realm 5 RP")).toBe("Roleplay Ruleset")
    expect(rulesets.displayName("CAMWOW EU5 Realm 6 RPPvP")).toBe("PvP Roleplay Ruleset")
    expect(rulesets.displayName("Normal")).toBe("Normal Ruleset")
    -- a name that says no ruleset is shown whole
    expect(rulesets.displayName("Somewhere")).toBe("Somewhere Ruleset")
    expect(rulesets.kind("Somewhere")).toBeNil()
end
