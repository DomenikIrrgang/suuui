-- Core/ThemesBuiltin: SuuUI's own themes, their colours, and the class
-- accent worked out per class (contrast and OKLCH maths).

import test, expect, afterEach, cases from "wowlua:test"
import tokens as T, Color from "/Core/Tokens"
import * as themes from "/Core/Themes"
import type Theme, ThemeColors, ThemeTile from "/Core/Themes"
import * as settings from "/Core/Settings"
import internal hex, linear, gamma, ratio, cbrt, hue, oklch, LINE_A, HAIRLINE_A, FAINT_A, PINKCAT_GLYPHS from "/Core/ThemesBuiltin"
import * as draw from "/UI/Draw"
import text as uiText from "/UI/Text"
import expectNoErrors, newParent from "../../helpers"

const BUILT_IN: string[] = {
    "highcontrast",
    "highcontrast-ink",
    "classaccent",
    "classhue",
    "darker",
    "oled",
    "blacktemple",
    "moltencore",
    "naxxramas",
    "karazhan",
    "sunwell",
    "blacktemple-temple",
    "blacktemple-chains",
    "blacktemple-runes",
    "moltencore-obsidian",
    "moltencore-basalt",
    "moltencore-flames",
    "naxxramas-necropolis",
    "naxxramas-bones",
    "naxxramas-frost",
    "karazhan-library",
    "karazhan-opera",
    "karazhan-nether",
    "sunwell-sunburst",
    "sunwell-phoenix",
    "sunwell-naaru",
    "pinkcat",
    "stvruins",
    "stvcanopy",
}
const CLASSES: string[] = { "WARRIOR", "PALADIN", "HUNTER", "ROGUE", "PRIEST", "SHAMAN", "MAGE", "WARLOCK", "DRUID" }

local function theme(id: string): Theme
    return (assert(themes.get(id), id))
end

-- A theme's colours (worked out for `class` when they are).
local function colorsOf(id: string, class: string?): ThemeColors
    local c = theme(id).colors
    if type(c) == "function" then
        return c(class)
    end
    return c
end

-- A theme texture's file (a repeating bar's too).
local function fileOf(v: string | ThemeTile | nil): string?
    if type(v) == "table" then
        return v.file
    end
    return v
end

local function rgb(c: number[]?): number[]
    local v = assert(c)
    return { v[1], v[2], v[3] }
end

local function close(a: number[], b: number[], digits: number)
    expect(#a).toBe(#b)
    for i = 1, #a do
        expect(a[i]).toBeCloseTo(b[i], digits)
    end
end

@afterEach
local function back()
    settings.setAccount("theme", nil)
    themes.apply()
end

@test("SuuUI's themes are registered after its own, in order")
local function registered()
    local ids: string[] = {}
    for i, t in ipairs(themes.all()) do
        if i > 1 and i <= #BUILT_IN + 1 then
            ids[#ids + 1] = t.id
        end
    end
    expect(ids).toEqual(BUILT_IN)
    for _, id in ipairs(BUILT_IN) do
        expect(type(theme(id).name)).toBe("string")
        expect(type(theme(id).description)).toBe("string")
    end
end

@test("hex colours read as 0-1 components, with an alpha when given")
@cases({
    { "#FFFFFF", { 1, 1, 1 } },
    { "#000000", { 0, 0, 0 } },
    { "#E3C27499", { 0xE3 / 255, 0xC2 / 255, 0x74 / 255, 0x99 / 255 } },
    { "#GG0000", { 0, 0, 0 } },
})
local function hexes(text: string, want: number[])
    close(hex(text), want, 6)
end

@test("High contrast: brighter ink and gilt, captions and micro a size up")
local function contrast()
    local c = colorsOf("highcontrast")
    close(assert(c.ink), { 1, 0xFD / 255, 0xF7 / 255 }, 6)
    expect(#assert(c["surface-glass"])).toBe(4)
    expect(assert(c["gilt-line"])[4]).toBeCloseTo(0xBF / 255, 6)
    local ink = colorsOf("highcontrast-ink")
    close(rgb(ink["gilt-line"]), { 0xF1 / 255, 0xEA / 255, 0xDB / 255 }, 6)
    for _, id in ipairs({ "highcontrast", "highcontrast-ink" }) do
        local f = theme(id).fonts
        expect(f.caption).toEqual({ size = 12, lineHeight = 15 })
        expect(f.micro).toEqual({ size = 10.5, lineHeight = 13 })
    end
end

@test("Darker and OLED change the surfaces only")
local function darker()
    for _, id in ipairs({ "darker", "oled" }) do
        local names: string[] = {}
        for name in pairs(colorsOf(id)) do
            names[#names + 1] = name
        end
        table.sort(names)
        expect(names).toEqual({ "surface", "surface-glass", "surface-raised", "surface-sunk", "track" })
    end
    close(rgb(colorsOf("oled").surface), { 0, 0, 0 }, 6)
    expect(assert(colorsOf("oled")["surface-glass"])[4]).toBe(1)
end

@test("no theme of SuuUI's changes a signal or game colour")
local function signals()
    local signal: { [string]: boolean } = {}
    for _, name in ipairs({ "arcane", "ember", "amber", "fel", "ward", "on-signal", "unit-fill-low" }) do
        signal[name] = true
    end
    for _, id in ipairs(BUILT_IN) do
        for _, class in ipairs(CLASSES) do
            for name in pairs(colorsOf(id, class)) do
                local game = name:find("^class%-") or name:find("^quest%-") or name:find("^dispel%-") or
                    name:find("^reaction%-") or
                    name:find("^quality%-") or
                    name:find("^mark%-")
                if signal[name] or game then
                    error(
                        `{id} changes {name}`
                    )
                end
                expect((T.color :: { [string]: Color })[name]).toBeTruthy()
            end
        end
    end
end

@test("Class accent: gilt in your class colour, its text lightened to 7:1 on surface")
@cases({
    { "WARRIOR" },
    { "PALADIN" },
    { "HUNTER" },
    { "ROGUE" },
    { "PRIEST" },
    { "SHAMAN" },
    { "MAGE" },
    { "WARLOCK" },
    { "DRUID" },
})
local function classAccent(class: string)
    local c = colorsOf("classaccent", class)
    local own: Color = assert((T.color :: { [string]: Color })["class-" .. class:lower()])
    close(rgb(c.gilt), rgb(own), 6)
    local text = rgb(c["gilt-text"])
    expect(ratio(text, rgb(T.color.surface)) >= 7).toBe(true)
    for i = 1, 3 do
        expect(text[i] >= own[i] - 1e-9).toBe(true)
    end
    expect(assert(c["gilt-line"])[4]).toBe(LINE_A)
    expect(assert(c["gilt-hairline"])[4]).toBe(HAIRLINE_A)
    expect(assert(c["gilt-faint"])[4]).toBe(FAINT_A)
end

@test("Class accent · toned: the class's hue at gilt's lightness")
@cases({ { "WARRIOR" }, { "MAGE" }, { "DRUID" }, { "PRIEST" } })
local function classHue(class: string)
    local c = colorsOf("classhue", class)
    local own: Color = assert((T.color :: { [string]: Color })["class-" .. class:lower()])
    local gilt = rgb(c.gilt)
    for i = 1, 3 do
        expect(gilt[i] >= 0 and gilt[i] <= 1).toBe(true)
    end
    -- the same hue as the class colour (white priests: any)
    if class ~= "PRIEST" then
        local d = math.abs(hue(gilt[1], gilt[2], gilt[3]) - hue(own[1], own[2], own[3]))
        expect(math.min(d, 2 * math.pi - d) < 0.15).toBe(true)
    end
    expect(assert(c["gilt-line"])[4]).toBe(LINE_A)
    expect(ratio(rgb(c["gilt-text"]), rgb(T.color.surface)) > ratio(gilt, rgb(T.color.surface))).toBe(true)
end

@test("a class without a colour, or none, keeps the design's gilt")
local function noClass()
    for _, id in ipairs({ "classaccent", "classhue" }) do
        expect(colorsOf(id, "MONK")).toEqual({})
        expect(colorsOf(id, nil)).toEqual({})
    end
end

@test("the text stops lightening after 50 steps where 7:1 can't be had")
local function capped()
    local surface = T.color.surface
    local saved = { surface[1], surface[2], surface[3] }
    surface[1], surface[2], surface[3] = 1, 1, 1
    local c = colorsOf("classaccent", "MAGE")
    surface[1], surface[2], surface[3] = saved[1], saved[2], saved[3]
    local text = rgb(c["gilt-text"])
    -- 50 steps of 5% toward white: almost white, still under 7:1 on white
    for i = 1, 3 do
        expect(text[i] > 0.9).toBe(true)
    end
end

@test("the colour maths: sRGB transfer both ways, contrast, cube root, OKLCH round trip")
local function maths()
    for _, v in ipairs({ 0, 0.02, 0.04045, 0.2, 0.5, 1 }) do
        expect(gamma(linear(v))).toBeCloseTo(v, 6)
    end
    expect(gamma(-1)).toBe(0)
    expect(gamma(2)).toBe(1)
    expect(ratio({ 1, 1, 1 }, { 0, 0, 0 })).toBeCloseTo(21, 6)
    expect(ratio({ 0, 0, 0 }, { 1, 1, 1 })).toBeCloseTo(21, 6)
    expect(ratio({ 0.5, 0.5, 0.5 }, { 0.5, 0.5, 0.5 })).toBe(1)
    expect(cbrt(27)).toBeCloseTo(3, 9)
    expect(cbrt(-8)).toBeCloseTo(-2, 9)
    local h = hue(0.2, 0.4, 0.9)
    local back = oklch(0.6, 0.1, h)
    expect(hue(back[1], back[2], back[3])).toBeCloseTo(h, 3)
end

@test("every theme of SuuUI's applies without errors")
local function applies()
    for _, id in ipairs(BUILT_IN) do
        settings.setAccount("theme", id)
        themes.apply()
        expect(themes.appliedTheme()).toBe(id)
    end
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- Pink Cat
--------------------------------------------------------------------------------

-- A colour of Pink Cat's, or the design's where it keeps it.
local function pinkcat(token: string): number[]
    local own = colorsOf("pinkcat")[token]
    if own then
        return own
    end
    local c: Color = assert((T.color :: { [string]: Color })[token], token)
    return { c[1], c[2], c[3], c[4] }
end

-- `top` over `ground` at top's own alpha.
local function over(top: number[], ground: number[]): number[]
    local a = top[4] or 1
    return { top[1] * a + ground[1] * (1 - a), top[2] * a + ground[2] * (1 - a), top[3] * a + ground[3] * (1 - a) }
end

@test("Pink Cat: every glyph and texture it names is a file SuuUI ships")
local function pinkcatFiles()
    local t = theme("pinkcat")
    local parent = newParent()
    local tex = parent:CreateTexture()
    local names: string[] = {}
    for name, file in pairs(t.glyphs) do
        names[#names + 1] = name
        -- (a glyph SuuUI has, drawn from a file that exists: a missing one
        -- reads back nil)
        expect((T.glyph :: { [string]: string })[name]).toBeTruthy()
        tex:SetTexture(file)
        expect(tex:GetTextureFilePath()).toBe(file)
    end
    table.sort(names)
    local want: string[] = {}
    for _, name in ipairs(PINKCAT_GLYPHS) do
        want[#want + 1] = name
    end
    table.sort(want)
    expect(names).toEqual(want)
    expect(#names).toBe(30)
    local tokens: string[] = {}
    for token, value in pairs(t.textures) do
        tokens[#tokens + 1] = token
        local file = assert(fileOf(value))
        tex:SetTexture(file)
        expect(tex:GetTextureFilePath()).toBe(file)
    end
    table.sort(tokens)
    -- every texture token but geometry and the game's own signs
    local kept: { [string]: boolean } = {}
    for _, token in ipairs({ "glow", "raid-markers", "circle-fill", "circle-soft", "circle-band", "circle-edge",
        "ring-arc-2", "ring-arc-3", "ring-arc-4" }) do
        kept[token] = true
    end
    local all: string[] = {}
    for token in pairs(T.texture :: { [string]: string }) do
        if not kept[token] then
            all[#all + 1] = token
        end
    end
    table.sort(all)
    expect(tokens).toEqual(all)
    expectNoErrors()
end

@test("Pink Cat: text, fills and edges at the ratios the tokens' usage notes ask")
@cases({
    -- ink on every surface (≥14.7:1) and on the health fills (≥4.8:1)
    { "ink", "surface", 14.7 },
    { "ink", "surface-sunk", 14.7 },
    { "ink", "surface-raised", 14.7 },
    { "ink", "unit-fill", 4.8 },
    { "ink", "unit-fill-low", 4.8 },
    -- secondary text (6.8:1), titles (11.9:1)
    { "ink-muted", "surface", 6.8 },
    { "ink-muted", "surface-sunk", 6.8 },
    { "gilt-text", "surface", 11.9 },
    { "gilt-text", "surface-sunk", 11.9 },
    -- the signal colours as text keep theirs on the new surfaces
    { "arcane", "surface", 10.4 },
    { "arcane", "surface-sunk", 10.4 },
    { "amber", "surface", 10.4 },
    { "ember-text", "surface", 8.5 },
    { "ember-text", "surface-sunk", 8.5 },
    -- fills against their ground
    { "unit-fill", "surface-sunk", 3.05 },
    { "fel-incoming", "surface-sunk", 3.25 }, -- (SuuUI's own: 3.29)
    { "focus", "track", 4.2 },
    { "progress-fill", "track", 3.9 },
    { "mana", "track", 4.2 },
    { "rage", "track", 3.36 },
    { "energy", "track", 9.5 },
    -- a panel's 1px edge keeps SuuUI's (2.18:1, 1.8:1)
    { "gilt-line", "surface", 2.15 },
    { "gilt-hairline", "surface", 1.78 },
})
local function pinkcatContrast(fg: string, bg: string, least: number)
    local ground = pinkcat(bg)
    local r = ratio(over(pinkcat(fg), ground), rgb(ground))
    if r < least then
        error(`{fg} on {bg}: {string.format("%.2f", r)}:1, under {least}:1`)
    end
end

@test("Pink Cat: disabled text stays dimmer than secondary text, and readable")
local function pinkcatFaint()
    local r = ratio(rgb(pinkcat("ink-faint")), rgb(pinkcat("surface")))
    expect(r >= 3.5 and r < 4.5).toBe(true)
    expect(r < ratio(rgb(pinkcat("ink-muted")), rgb(pinkcat("surface")))).toBe(true)
end

-- The windows' pattern's strongest alpha (tools/pinkcat_art.py,
-- PATTERN_ALPHA: the paws and hearts at most this, in gilt).
const PATTERN_ALPHA = 0.16

@test("Pink Cat: text stays readable over the brightest pixels of its windows' pattern")
@cases({
    { "ink", 7 },
    { "gilt-text", 7 },
    { "ink-muted", 4.5 },
    { "ink-faint", 3 },
})
local function pinkcatPattern(fg: string, least: number)
    -- the glass over the dark world, the pattern's gilt over that
    for _, ground in ipairs({ "surface", "surface-glass" }) do
        local g = over(pinkcat(ground), { 0, 0, 0 })
        local gilt = pinkcat("gilt")
        local brightest = over({ gilt[1], gilt[2], gilt[3], PATTERN_ALPHA }, g)
        local r = ratio(rgb(pinkcat(fg)), brightest)
        if r < least then
            error(`{fg} on the pattern over {ground}: {string.format("%.2f", r)}:1, under {least}:1`)
        end
    end
end

@test("Pink Cat: its glass hides what's behind it (the zone's name showed through)")
local function pinkcatGlass()
    expect(pinkcat("surface-glass")[4] >= 0.98).toBe(true)
end

@test("Pink Cat: the power colours stay apart (mana, rage, energy, focus)")
local function pinkcatPower()
    local names = { "mana", "rage", "energy", "focus" }
    for i = 1, #names do
        for j = i + 1, #names do
            local a, b = pinkcat(names[i]), pinkcat(names[j])
            local d = math.abs(hue(a[1], a[2], a[3]) - hue(b[1], b[2], b[3]))
            -- at least 25° apart in OKLab hue
            if math.min(d, 2 * math.pi - d) < math.rad(25) then
                error(`{names[i]} and {names[j]} are too close`)
            end
        end
    end
    -- mana stays the blue one, rage the red one
    local mana, rage = pinkcat("mana"), pinkcat("rage")
    expect(mana[3] > mana[1] and mana[3] > mana[2]).toBe(true)
    expect(rage[1] > rage[2] and rage[1] > rage[3]).toBe(true)
end

@test("Pink Cat: a little more room, within the design's ranges")
local function pinkcatRoom()
    local t = theme("pinkcat")
    for token, px in pairs(t.space) do
        local d = assert((T.space :: { [string]: number })[token])
        expect(px >= d and px <= d * 1.2).toBe(true)
    end
    for token, px in pairs(t.sizes) do
        local d = assert((T.size :: { [string]: number })[token])
        expect(px >= d and px <= d * 1.2).toBe(true)
    end
end

@test("Pink Cat applies, and switching back to SuuUI's restores every token and frame")
local function pinkcatRoundTrip()
    local before = {
        ink = rgb(T.color.ink),
        health = T.texture["health-bar"],
        check = T.texture.check,
        bag = T.glyph.bag,
        flag = T.glyph.flag,
        space = T.space["space-4"],
        slot = T.size.slot,
    }
    local cat = theme("pinkcat")
    local catBag, catHealth = assert(cat.glyphs.bag), assert(fileOf(cat.textures["health-bar"]))
    local parent = newParent()
    local icon = parent:CreateTexture()
    draw.glyph(icon, "bag")
    local bar = CreateFrame("StatusBar", nil, parent)
    draw.skinBar(bar, "health-bar")
    local plate = CreateFrame("StatusBar", nil, parent)
    draw.skinBar(plate, "plate-health-bar")
    -- (0.39) a window's ground, corner, jewel, mark and divider
    local ground = draw.fill(parent, "surface-glass")
    draw.pattern(ground, "surface-pattern")
    local corner = draw.ornament(parent, 7, "corner")
    local jewel = draw.ornament(parent, 6, "jewel")
    local mark = draw.ornament(parent, 5, "mark", "ink")
    local divider = draw.hairline(parent, "gilt-line", "both", "divider")
    settings.setAccount("theme", "pinkcat")
    themes.apply()
    expect(themes.appliedTheme()).toBe("pinkcat")
    expect(plate:GetStatusBarTexture():GetTextureFilePath()).toBe(fileOf(cat.textures["plate-health-bar"]))
    expect(assert(draw.patternOf(ground)):GetTextureFilePath()).toBe(fileOf(cat.textures["surface-pattern"]))
    expect(corner:GetTextureFilePath()).toBe(fileOf(cat.textures.corner))
    expect(corner:GetRotation()).toBeCloseTo(0, 4)
    expect(jewel:GetTextureFilePath()).toBe(fileOf(cat.textures.jewel))
    expect(mark:GetTextureFilePath()).toBe(fileOf(cat.textures.mark))
    expect(draw.dividerStrips(divider)).never.toBeNil()
    close(rgb(T.color.ink), { 1, 0xF4 / 255, 0xE8 / 255 }, 6)
    expect(T.glyph.bag).toBe(catBag)
    expect(T.glyph.flag).toBe(before.flag)
    expect(icon:GetTextureFilePath()).toBe(catBag)
    expect(bar:GetStatusBarTexture():GetTextureFilePath()).toBe(catHealth)
    -- the bars' art repeats at their height (stretched, the beans were
    -- long ovals: a player's report, 2026-11-12)
    expect(assert(draw.repeatOf(bar)):GetTextureFilePath()).toBe(catHealth)
    expect(draw.repeatOf(plate)).never.toBeNil()
    for token in pairs(themes.BAR_TOKENS) do
        expect(type(cat.textures[token])).toBe("table")
    end
    expect(T.space["space-4"]).toBe(9)
    expect(T.size.slot).toBe(38)
    settings.setAccount("theme", nil)
    themes.apply()
    expect(themes.appliedTheme()).toBe(themes.DEFAULT)
    close(rgb(T.color.ink), before.ink, 6)
    expect(T.texture["health-bar"]).toBe(before.health)
    expect(T.texture.check).toBe(before.check)
    expect(T.glyph.bag).toBe(before.bag)
    expect(icon:GetTextureFilePath()).toBe(before.bag)
    expect(bar:GetStatusBarTexture():GetTextureFilePath()).toBe(before.health)
    expect(plate:GetStatusBarTexture():GetTextureFilePath()).toBe(before.health)
    expect(draw.repeatOf(bar)).toBeNil()
    expect(draw.repeatOf(plate)).toBeNil()
    expect(draw.patternOf(ground)).toBeNil()
    expect(corner:GetTextureFilePath()).toBe("Interface\\Buttons\\WHITE8X8")
    expect(corner:GetRotation()).toBeCloseTo(math.rad(45), 4)
    expect(mark).toHaveSize(5, 5)
    expect(draw.dividerStrips(divider)).toBeNil()
    expect(T.space["space-4"]).toBe(before.space)
    expect(T.size.slot).toBe(before.slot)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- Stranglethorn (Ruins and Canopy, 0.40): the jungle's art and its contrast
--------------------------------------------------------------------------------

const STV: string[] = { "stvruins", "stvcanopy" }

-- A token's colour in a theme (its own, else SuuUI's).
local function colorIn(id: string, token: string): number[]
    local own = colorsOf(id)[token]
    if own then
        return own
    end
    local c: Color = assert((T.color :: { [string]: Color })[token], token)
    return { c[1], c[2], c[3], c[4] }
end

@test("Stranglethorn: every texture, header and piece it names is a file SuuUI ships")
local function stvFiles()
    local tex = newParent():CreateTexture()
    local function ships(file: string)
        tex:SetTexture(file)
        expect(tex:GetTextureFilePath()).toBe(file)
    end
    for _, id in ipairs(STV) do
        local t = theme(id)
        for _, value in pairs(t.textures) do
            ships(assert(fileOf(value)))
        end
        local kinds = 0
        for _, kind in pairs(t.dress) do
            kinds += 1
            if kind.header then
                ships(kind.header)
            end
            for _, p in ipairs(kind.pieces or {}) do
                ships(p.file)
            end
            if kind.motes then
                ships(kind.motes.file)
            end
        end
        -- windows, the minimap, the unit frames and the chat all dressed
        expect(kinds).toBe(4)
        -- every one of SuuUI's icons as a vine
        local icons = 0
        for name, file in pairs(t.glyphs) do
            icons += 1
            expect((T.glyph :: { [string]: string })[name]).toBeTruthy()
            ships(file)
        end
        local all = 0
        for _ in pairs(T.glyph :: { [string]: string }) do
            all += 1
        end
        expect(icons).toBe(all)
        expect(all).toBe(95)
        expect((t.fonts.header or {}).file).toBe("Fonts\\MORPHEUS.TTF")
    end
end

@test("Stranglethorn: text, fills and edges at the ratios the tokens' usage notes ask")
@cases({
    { "stvruins", "ink", "surface", 7 },
    { "stvruins", "ink", "surface-raised", 7 },
    { "stvruins", "ink", "unit-fill", 4.8 },
    { "stvruins", "ink-muted", "surface", 4.5 },
    { "stvruins", "gilt-text", "surface", 7 },
    { "stvruins", "unit-fill", "surface-sunk", 3.05 },
    { "stvcanopy", "ink", "surface", 7 },
    { "stvcanopy", "ink", "surface-raised", 7 },
    { "stvcanopy", "ink", "unit-fill", 4.8 },
    { "stvcanopy", "ink-muted", "surface", 4.5 },
    { "stvcanopy", "gilt-text", "surface", 7 },
    { "stvcanopy", "unit-fill", "surface-sunk", 3.05 },
})
local function stvContrast(id: string, fg: string, bg: string, least: number)
    local ground = colorIn(id, bg)
    local r = ratio(over(colorIn(id, fg), ground), rgb(ground))
    if r < least then
        error(`{id}: {fg} on {bg}: {string.format("%.2f", r)}:1, under {least}:1`)
    end
end

@test("Stranglethorn: disabled text stays dimmer than secondary text, and readable")
local function stvFaint()
    for _, id in ipairs(STV) do
        local r = ratio(rgb(colorIn(id, "ink-faint")), rgb(colorIn(id, "surface")))
        expect(r >= 3).toBe(true)
        expect(r < ratio(rgb(colorIn(id, "ink-muted")), rgb(colorIn(id, "surface")))).toBe(true)
    end
end

@test("Stranglethorn: text stays readable over the brightest pixels of its windows' pattern")
@cases({
    { "ink", 7 },
    { "gilt-text", 7 },
    { "ink-muted", 4.5 },
    { "ink-faint", 3 },
})
local function stvPattern(fg: string, least: number)
    -- (tools/stv_art.py's PATTERN_ALPHA: the stonework and the leaves at
    -- most this, in gilt)
    for _, id in ipairs(STV) do
        for _, ground in ipairs({ "surface", "surface-glass" }) do
            local g = over(colorIn(id, ground), { 0, 0, 0 })
            local gilt = colorIn(id, "gilt")
            local brightest = over({ gilt[1], gilt[2], gilt[3], PATTERN_ALPHA }, g)
            local r = ratio(rgb(colorIn(id, fg)), brightest)
            if r < least then
                error(`{id}: {fg} on the pattern over {ground}: {string.format("%.2f", r)}:1, under {least}:1`)
            end
        end
    end
end

@test("Stranglethorn: its glass hides what's behind it")
local function stvGlass()
    for _, id in ipairs(STV) do
        expect(colorIn(id, "surface-glass")[4] >= 0.96).toBe(true)
    end
end

@test("Stranglethorn: titles in the game's own carved font, back to SuuUI's after")
local function stvFont()
    local before = T.type.header.file
    for _, id in ipairs(STV) do
        settings.setAccount("theme", id)
        themes.apply()
        expect(T.type.header.file).toBe("Fonts\\MORPHEUS.TTF")
        local title = uiText(newParent(), "header", "gilt-text")
        title:SetValue("Character")
        local file = title:GetFont()
        expect(file).toBe("Fonts\\MORPHEUS.TTF")
    end
    settings.setAccount("theme", nil)
    themes.apply()
    expect(T.type.header.file).toBe(before)
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- The raid themes with art (ThemesRaids): three per raid
--------------------------------------------------------------------------------

-- Each raid theme: its id, its header face (and size, where Friz Quadrata
-- is a size down so the meters' titles fit), the strongest alpha of its
-- windows' pattern (tools/raid_art.py, PATTERN), and the dress kinds it
-- wears (every one of them: windows, chat, the minimap, the unit frames).
type Raid = { id: string, font: string, size?: number, pattern: number }
const MORPHEUS = "Fonts\\MORPHEUS.TTF"
const FRIZ = "Fonts\\FRIZQT__.TTF"
const ARIALN = "Fonts\\ARIALN.TTF"
const SKURRI = "Fonts\\SKURRI.TTF"
local RAIDS: Raid[] = {
    { id = "blacktemple-temple", font = MORPHEUS, pattern = 0.13 },
    { id = "blacktemple-chains", font = SKURRI, pattern = 0.12 },
    { id = "blacktemple-runes", font = FRIZ, size = 12, pattern = 0.13 },
    { id = "moltencore-obsidian", font = MORPHEUS, pattern = 0.14 },
    { id = "moltencore-basalt", font = FRIZ, size = 12, pattern = 0.13 },
    { id = "moltencore-flames", font = SKURRI, pattern = 0.13 },
    { id = "naxxramas-necropolis", font = MORPHEUS, pattern = 0.13 },
    { id = "naxxramas-bones", font = FRIZ, size = 12, pattern = 0.1 },
    { id = "naxxramas-frost", font = ARIALN, pattern = 0.13 },
    { id = "karazhan-library", font = MORPHEUS, pattern = 0.13 },
    { id = "karazhan-opera", font = FRIZ, size = 12, pattern = 0.13 },
    { id = "karazhan-nether", font = ARIALN, pattern = 0.15 },
    { id = "sunwell-sunburst", font = FRIZ, size = 12, pattern = 0.1 },
    { id = "sunwell-phoenix", font = MORPHEUS, pattern = 0.12 },
    { id = "sunwell-naaru", font = ARIALN, pattern = 0.1 },
}

@test("Raid themes: every texture, glyph and dress file they name ships, on all four kinds of frame")
local function raidFiles()
    local tex = newParent():CreateTexture()
    local function ships(file: string)
        tex:SetTexture(file)
        expect(tex:GetTextureFilePath()).toBe(file)
    end
    for _, raid in ipairs(RAIDS) do
        local t = theme(raid.id)
        for _, value in pairs(t.textures) do
            ships(assert(fileOf(value)))
        end
        for _, kind in ipairs({ "window", "chat", "minimap", "unit" }) do
            local k = assert(t.dress[kind], `{raid.id}: {kind}`)
            expect(#(k.pieces or {}) > 0).toBe(true)
            if k.header then
                ships(k.header)
            end
            for _, p in ipairs(k.pieces or {}) do
                ships(p.file)
            end
            if k.motes then
                ships(k.motes.file)
            end
        end
        expect(assert(t.dress.window).header).toBeTruthy()
        local icons = 0
        for name, file in pairs(t.glyphs) do
            icons += 1
            expect((T.glyph :: { [string]: string })[name]).toBeTruthy()
            ships(file)
        end
        expect(icons).toBe(95)
        for token in pairs(themes.BAR_TOKENS) do
            expect(type(t.textures[token])).toBe("table")
        end
    end
end

@test("Raid themes: text, fills and edges at the ratios the tokens' usage notes ask")
@cases({
    { "ink", "surface", 7 },
    { "ink", "surface-raised", 7 },
    { "ink", "unit-fill", 4.8 },
    { "ink", "unit-fill-low", 4.8 },
    { "ink-muted", "surface", 4.5 },
    { "gilt-text", "surface", 7 },
    { "unit-fill", "surface-sunk", 3.05 },
    { "gilt-line", "surface", 2.15 },
    { "gilt-hairline", "surface", 1.78 },
})
local function raidContrast(fg: string, bg: string, least: number)
    for _, raid in ipairs(RAIDS) do
        local ground = colorIn(raid.id, bg)
        local r = ratio(over(colorIn(raid.id, fg), ground), rgb(ground))
        if r < least then
            error(`{raid.id}: {fg} on {bg}: {string.format("%.2f", r)}:1, under {least}:1`)
        end
    end
end

@test("Raid themes: disabled text stays dimmer than secondary text, and readable; the glass hides what's behind")
local function raidFaint()
    for _, raid in ipairs(RAIDS) do
        local r = ratio(rgb(colorIn(raid.id, "ink-faint")), rgb(colorIn(raid.id, "surface")))
        expect(r >= 3).toBe(true)
        expect(r < ratio(rgb(colorIn(raid.id, "ink-muted")), rgb(colorIn(raid.id, "surface")))).toBe(true)
        expect(colorIn(raid.id, "surface-glass")[4] >= 0.96).toBe(true)
    end
end

@test("Raid themes: text stays readable over the brightest pixels of their windows' pattern")
@cases({
    { "ink", 7 },
    { "gilt-text", 7 },
    { "ink-muted", 4.5 },
    { "ink-faint", 3 },
})
local function raidPattern(fg: string, least: number)
    for _, raid in ipairs(RAIDS) do
        for _, ground in ipairs({ "surface", "surface-glass" }) do
            local g = over(colorIn(raid.id, ground), { 0, 0, 0 })
            local gilt = colorIn(raid.id, "gilt")
            local brightest = over({ gilt[1], gilt[2], gilt[3], raid.pattern }, g)
            local r = ratio(rgb(colorIn(raid.id, fg)), brightest)
            if r < least then
                error(`{raid.id}: {fg} on the pattern over {ground}: {string.format("%.2f", r)}:1, under {least}:1`)
            end
        end
    end
end

@test("Raid themes: titles in each theme's own face, back to SuuUI's after")
local function raidFonts()
    local before, size = T.type.header.file, T.type.header.size
    for _, raid in ipairs(RAIDS) do
        settings.setAccount("theme", raid.id)
        themes.apply()
        expect(themes.appliedTheme()).toBe(raid.id)
        expect(T.type.header.file).toBe(raid.font)
        expect(T.type.header.size).toBe(raid.size or size)
        local title = uiText(newParent(), "header", "gilt-text")
        title:SetValue("Damage done")
        local file = title:GetFont()
        expect(file).toBe(raid.font)
    end
    settings.setAccount("theme", nil)
    themes.apply()
    expect(T.type.header.file).toBe(before)
    expect(T.type.header.size).toBe(size)
    expectNoErrors()
end
