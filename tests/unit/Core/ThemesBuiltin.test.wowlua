-- Core/ThemesBuiltin: SuuUI's own themes, their colours, and the class
-- accent worked out per class (contrast and OKLCH maths).

import test, expect, afterEach, cases from "wowlua:test"
import tokens as T, Color from "/Core/Tokens"
import * as themes from "/Core/Themes"
import type Theme, ThemeColors from "/Core/Themes"
import * as settings from "/Core/Settings"
import internal hex, linear, gamma, ratio, cbrt, hue, oklch, LINE_A, HAIRLINE_A, FAINT_A, PINKCAT_GLYPHS from "/Core/ThemesBuiltin"
import * as draw from "/UI/Draw"
import expectNoErrors, newParent from "../../helpers"

const BUILT_IN: string[] = {
    "highcontrast",
    "highcontrast-ink",
    "classaccent",
    "classhue",
    "darker",
    "oled",
    "blacktemple",
    "moltencore",
    "naxxramas",
    "karazhan",
    "sunwell",
    "pinkcat",
}
const CLASSES: string[] = { "WARRIOR", "PALADIN", "HUNTER", "ROGUE", "PRIEST", "SHAMAN", "MAGE", "WARLOCK", "DRUID" }

local function theme(id: string): Theme
    return (assert(themes.get(id), id))
end

-- A theme's colours (worked out for `class` when they are).
local function colorsOf(id: string, class: string?): ThemeColors
    local c = theme(id).colors
    if type(c) == "function" then
        return c(class)
    end
    return c
end

local function rgb(c: number[]?): number[]
    local v = assert(c)
    return { v[1], v[2], v[3] }
end

local function close(a: number[], b: number[], digits: number)
    expect(#a).toBe(#b)
    for i = 1, #a do
        expect(a[i]).toBeCloseTo(b[i], digits)
    end
end

@afterEach
local function back()
    settings.setAccount("theme", nil)
    themes.apply()
end

@test("SuuUI's themes are registered after its own, in order")
local function registered()
    local ids: string[] = {}
    for i, t in ipairs(themes.all()) do
        if i > 1 and i <= #BUILT_IN + 1 then
            ids[#ids + 1] = t.id
        end
    end
    expect(ids).toEqual(BUILT_IN)
    for _, id in ipairs(BUILT_IN) do
        expect(type(theme(id).name)).toBe("string")
        expect(type(theme(id).description)).toBe("string")
    end
end

@test("hex colours read as 0-1 components, with an alpha when given")
@cases({
    { "#FFFFFF", { 1, 1, 1 } },
    { "#000000", { 0, 0, 0 } },
    { "#E3C27499", { 0xE3 / 255, 0xC2 / 255, 0x74 / 255, 0x99 / 255 } },
    { "#GG0000", { 0, 0, 0 } },
})
local function hexes(text: string, want: number[])
    close(hex(text), want, 6)
end

@test("High contrast: brighter ink and gilt, captions and micro a size up")
local function contrast()
    local c = colorsOf("highcontrast")
    close(assert(c.ink), { 1, 0xFD / 255, 0xF7 / 255 }, 6)
    expect(#assert(c["surface-glass"])).toBe(4)
    expect(assert(c["gilt-line"])[4]).toBeCloseTo(0xBF / 255, 6)
    local ink = colorsOf("highcontrast-ink")
    close(rgb(ink["gilt-line"]), { 0xF1 / 255, 0xEA / 255, 0xDB / 255 }, 6)
    for _, id in ipairs({ "highcontrast", "highcontrast-ink" }) do
        local f = theme(id).fonts
        expect(f.caption).toEqual({ size = 12, lineHeight = 15 })
        expect(f.micro).toEqual({ size = 10.5, lineHeight = 13 })
    end
end

@test("Darker and OLED change the surfaces only")
local function darker()
    for _, id in ipairs({ "darker", "oled" }) do
        local names: string[] = {}
        for name in pairs(colorsOf(id)) do
            names[#names + 1] = name
        end
        table.sort(names)
        expect(names).toEqual({ "surface", "surface-glass", "surface-raised", "surface-sunk", "track" })
    end
    close(rgb(colorsOf("oled").surface), { 0, 0, 0 }, 6)
    expect(assert(colorsOf("oled")["surface-glass"])[4]).toBe(1)
end

@test("no theme of SuuUI's changes a signal or game colour")
local function signals()
    local signal: { [string]: boolean } = {}
    for _, name in ipairs({ "arcane", "ember", "amber", "fel", "ward", "on-signal", "unit-fill-low" }) do
        signal[name] = true
    end
    for _, id in ipairs(BUILT_IN) do
        for _, class in ipairs(CLASSES) do
            for name in pairs(colorsOf(id, class)) do
                local game = name:find("^class%-") or name:find("^quest%-") or name:find("^dispel%-") or
                    name:find("^reaction%-") or
                    name:find("^quality%-") or
                    name:find("^mark%-")
                if signal[name] or game then
                    error(
                        `{id} changes {name}`
                    )
                end
                expect((T.color :: { [string]: Color })[name]).toBeTruthy()
            end
        end
    end
end

@test("Class accent: gilt in your class colour, its text lightened to 7:1 on surface")
@cases({
    { "WARRIOR" },
    { "PALADIN" },
    { "HUNTER" },
    { "ROGUE" },
    { "PRIEST" },
    { "SHAMAN" },
    { "MAGE" },
    { "WARLOCK" },
    { "DRUID" },
})
local function classAccent(class: string)
    local c = colorsOf("classaccent", class)
    local own: Color = assert((T.color :: { [string]: Color })["class-" .. class:lower()])
    close(rgb(c.gilt), rgb(own), 6)
    local text = rgb(c["gilt-text"])
    expect(ratio(text, rgb(T.color.surface)) >= 7).toBe(true)
    for i = 1, 3 do
        expect(text[i] >= own[i] - 1e-9).toBe(true)
    end
    expect(assert(c["gilt-line"])[4]).toBe(LINE_A)
    expect(assert(c["gilt-hairline"])[4]).toBe(HAIRLINE_A)
    expect(assert(c["gilt-faint"])[4]).toBe(FAINT_A)
end

@test("Class accent · toned: the class's hue at gilt's lightness")
@cases({ { "WARRIOR" }, { "MAGE" }, { "DRUID" }, { "PRIEST" } })
local function classHue(class: string)
    local c = colorsOf("classhue", class)
    local own: Color = assert((T.color :: { [string]: Color })["class-" .. class:lower()])
    local gilt = rgb(c.gilt)
    for i = 1, 3 do
        expect(gilt[i] >= 0 and gilt[i] <= 1).toBe(true)
    end
    -- the same hue as the class colour (white priests: any)
    if class ~= "PRIEST" then
        local d = math.abs(hue(gilt[1], gilt[2], gilt[3]) - hue(own[1], own[2], own[3]))
        expect(math.min(d, 2 * math.pi - d) < 0.15).toBe(true)
    end
    expect(assert(c["gilt-line"])[4]).toBe(LINE_A)
    expect(ratio(rgb(c["gilt-text"]), rgb(T.color.surface)) > ratio(gilt, rgb(T.color.surface))).toBe(true)
end

@test("a class without a colour, or none, keeps the design's gilt")
local function noClass()
    for _, id in ipairs({ "classaccent", "classhue" }) do
        expect(colorsOf(id, "MONK")).toEqual({})
        expect(colorsOf(id, nil)).toEqual({})
    end
end

@test("the text stops lightening after 50 steps where 7:1 can't be had")
local function capped()
    local surface = T.color.surface
    local saved = { surface[1], surface[2], surface[3] }
    surface[1], surface[2], surface[3] = 1, 1, 1
    local c = colorsOf("classaccent", "MAGE")
    surface[1], surface[2], surface[3] = saved[1], saved[2], saved[3]
    local text = rgb(c["gilt-text"])
    -- 50 steps of 5% toward white: almost white, still under 7:1 on white
    for i = 1, 3 do
        expect(text[i] > 0.9).toBe(true)
    end
end

@test("the colour maths: sRGB transfer both ways, contrast, cube root, OKLCH round trip")
local function maths()
    for _, v in ipairs({ 0, 0.02, 0.04045, 0.2, 0.5, 1 }) do
        expect(gamma(linear(v))).toBeCloseTo(v, 6)
    end
    expect(gamma(-1)).toBe(0)
    expect(gamma(2)).toBe(1)
    expect(ratio({ 1, 1, 1 }, { 0, 0, 0 })).toBeCloseTo(21, 6)
    expect(ratio({ 0, 0, 0 }, { 1, 1, 1 })).toBeCloseTo(21, 6)
    expect(ratio({ 0.5, 0.5, 0.5 }, { 0.5, 0.5, 0.5 })).toBe(1)
    expect(cbrt(27)).toBeCloseTo(3, 9)
    expect(cbrt(-8)).toBeCloseTo(-2, 9)
    local h = hue(0.2, 0.4, 0.9)
    local back = oklch(0.6, 0.1, h)
    expect(hue(back[1], back[2], back[3])).toBeCloseTo(h, 3)
end

@test("every theme of SuuUI's applies without errors")
local function applies()
    for _, id in ipairs(BUILT_IN) do
        settings.setAccount("theme", id)
        themes.apply()
        expect(themes.appliedTheme()).toBe(id)
    end
    expectNoErrors()
end

--------------------------------------------------------------------------------
-- Pink Cat
--------------------------------------------------------------------------------

-- A colour of Pink Cat's, or the design's where it keeps it.
local function pinkcat(token: string): number[]
    local own = colorsOf("pinkcat")[token]
    if own then
        return own
    end
    local c: Color = assert((T.color :: { [string]: Color })[token], token)
    return { c[1], c[2], c[3], c[4] }
end

-- `top` over `ground` at top's own alpha.
local function over(top: number[], ground: number[]): number[]
    local a = top[4] or 1
    return { top[1] * a + ground[1] * (1 - a), top[2] * a + ground[2] * (1 - a), top[3] * a + ground[3] * (1 - a) }
end

@test("Pink Cat: every glyph and texture it names is a file SuuUI ships")
local function pinkcatFiles()
    local t = theme("pinkcat")
    local parent = newParent()
    local tex = parent:CreateTexture()
    local names: string[] = {}
    for name, file in pairs(t.glyphs) do
        names[#names + 1] = name
        -- (a glyph SuuUI has, drawn from a file that exists: a missing one
        -- reads back nil)
        expect((T.glyph :: { [string]: string })[name]).toBeTruthy()
        tex:SetTexture(file)
        expect(tex:GetTextureFilePath()).toBe(file)
    end
    table.sort(names)
    local want: string[] = {}
    for _, name in ipairs(PINKCAT_GLYPHS) do
        want[#want + 1] = name
    end
    table.sort(want)
    expect(names).toEqual(want)
    expect(#names).toBe(30)
    local tokens: string[] = {}
    for token, file in pairs(t.textures) do
        tokens[#tokens + 1] = token
        tex:SetTexture(file)
        expect(tex:GetTextureFilePath()).toBe(file)
    end
    table.sort(tokens)
    -- every texture token but geometry and the game's own signs
    local kept: { [string]: boolean } = {}
    for _, token in ipairs({ "glow", "raid-markers", "circle-fill", "circle-soft", "circle-band", "circle-edge",
        "ring-arc-2", "ring-arc-3", "ring-arc-4" }) do
        kept[token] = true
    end
    local all: string[] = {}
    for token in pairs(T.texture :: { [string]: string }) do
        if not kept[token] then
            all[#all + 1] = token
        end
    end
    table.sort(all)
    expect(tokens).toEqual(all)
    expectNoErrors()
end

@test("Pink Cat: text, fills and edges at the ratios the tokens' usage notes ask")
@cases({
    -- ink on every surface (≥14.7:1) and on the health fills (≥4.8:1)
    { "ink", "surface", 14.7 },
    { "ink", "surface-sunk", 14.7 },
    { "ink", "surface-raised", 14.7 },
    { "ink", "unit-fill", 4.8 },
    { "ink", "unit-fill-low", 4.8 },
    -- secondary text (6.8:1), titles (11.9:1)
    { "ink-muted", "surface", 6.8 },
    { "ink-muted", "surface-sunk", 6.8 },
    { "gilt-text", "surface", 11.9 },
    { "gilt-text", "surface-sunk", 11.9 },
    -- the signal colours as text keep theirs on the new surfaces
    { "arcane", "surface", 10.4 },
    { "arcane", "surface-sunk", 10.4 },
    { "amber", "surface", 10.4 },
    { "ember-text", "surface", 8.5 },
    { "ember-text", "surface-sunk", 8.5 },
    -- fills against their ground
    { "unit-fill", "surface-sunk", 3.05 },
    { "fel-incoming", "surface-sunk", 3.25 }, -- (SuuUI's own: 3.29)
    { "focus", "track", 4.2 },
    { "progress-fill", "track", 3.9 },
    { "mana", "track", 4.2 },
    { "rage", "track", 3.36 },
    { "energy", "track", 9.5 },
    -- a panel's 1px edge keeps SuuUI's (2.18:1, 1.8:1)
    { "gilt-line", "surface", 2.15 },
    { "gilt-hairline", "surface", 1.78 },
})
local function pinkcatContrast(fg: string, bg: string, least: number)
    local ground = pinkcat(bg)
    local r = ratio(over(pinkcat(fg), ground), rgb(ground))
    if r < least then
        error(`{fg} on {bg}: {string.format("%.2f", r)}:1, under {least}:1`)
    end
end

@test("Pink Cat: disabled text stays dimmer than secondary text, and readable")
local function pinkcatFaint()
    local r = ratio(rgb(pinkcat("ink-faint")), rgb(pinkcat("surface")))
    expect(r >= 3.5 and r < 4.5).toBe(true)
    expect(r < ratio(rgb(pinkcat("ink-muted")), rgb(pinkcat("surface")))).toBe(true)
end

@test("Pink Cat: the power colours stay apart (mana, rage, energy, focus)")
local function pinkcatPower()
    local names = { "mana", "rage", "energy", "focus" }
    for i = 1, #names do
        for j = i + 1, #names do
            local a, b = pinkcat(names[i]), pinkcat(names[j])
            local d = math.abs(hue(a[1], a[2], a[3]) - hue(b[1], b[2], b[3]))
            -- at least 25° apart in OKLab hue
            if math.min(d, 2 * math.pi - d) < math.rad(25) then
                error(`{names[i]} and {names[j]} are too close`)
            end
        end
    end
    -- mana stays the blue one, rage the red one
    local mana, rage = pinkcat("mana"), pinkcat("rage")
    expect(mana[3] > mana[1] and mana[3] > mana[2]).toBe(true)
    expect(rage[1] > rage[2] and rage[1] > rage[3]).toBe(true)
end

@test("Pink Cat: a little more room, within the design's ranges")
local function pinkcatRoom()
    local t = theme("pinkcat")
    for token, px in pairs(t.space) do
        local d = assert((T.space :: { [string]: number })[token])
        expect(px >= d and px <= d * 1.2).toBe(true)
    end
    for token, px in pairs(t.sizes) do
        local d = assert((T.size :: { [string]: number })[token])
        expect(px >= d and px <= d * 1.2).toBe(true)
    end
end

@test("Pink Cat applies, and switching back to SuuUI's restores every token and frame")
local function pinkcatRoundTrip()
    local before = {
        ink = rgb(T.color.ink),
        health = T.texture["health-bar"],
        check = T.texture.check,
        bag = T.glyph.bag,
        flag = T.glyph.flag,
        space = T.space["space-4"],
        slot = T.size.slot,
    }
    local cat = theme("pinkcat")
    local catBag, catHealth = assert(cat.glyphs.bag), assert(cat.textures["health-bar"])
    local parent = newParent()
    local icon = parent:CreateTexture()
    draw.glyph(icon, "bag")
    local bar = CreateFrame("StatusBar", nil, parent)
    draw.skinBar(bar, "health-bar")
    settings.setAccount("theme", "pinkcat")
    themes.apply()
    expect(themes.appliedTheme()).toBe("pinkcat")
    close(rgb(T.color.ink), { 1, 0xF4 / 255, 0xE8 / 255 }, 6)
    expect(T.glyph.bag).toBe(catBag)
    expect(T.glyph.flag).toBe(before.flag)
    expect(icon:GetTextureFilePath()).toBe(catBag)
    expect(bar:GetStatusBarTexture():GetTextureFilePath()).toBe(catHealth)
    expect(T.space["space-4"]).toBe(9)
    expect(T.size.slot).toBe(38)
    settings.setAccount("theme", nil)
    themes.apply()
    expect(themes.appliedTheme()).toBe(themes.DEFAULT)
    close(rgb(T.color.ink), before.ink, 6)
    expect(T.texture["health-bar"]).toBe(before.health)
    expect(T.texture.check).toBe(before.check)
    expect(T.glyph.bag).toBe(before.bag)
    expect(icon:GetTextureFilePath()).toBe(before.bag)
    expect(bar:GetStatusBarTexture():GetTextureFilePath()).toBe(before.health)
    expect(T.space["space-4"]).toBe(before.space)
    expect(T.size.slot).toBe(before.slot)
    expectNoErrors()
end
