-- Core/Init: the addon's name and version, chat output and the /suu
-- command registry.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as init from "/Core/Init"
import * as fault from "/Core/Fault"
import * as settingsWindow from "/SettingsUI/Window"
import API_VERSION from "/Core/Modules"

const PREFIX = "|cff9fd3c7SuuUI|r "
const OWNER = { name = "Init Test" }
const OTHER = { name = "Init Test Other" }

@afterEach
local function cleanup()
    init.unregisterCommands(OWNER)
    init.unregisterCommands(OTHER)
    mock.slash("/suu errors clear")
end

-- What was printed while fn ran.
local function printedBy(fn: () -> ()): string[]
    local before = #mock.printed()
    fn()
    local all = mock.printed()
    local out: string[] = {}
    for i = before + 1, #all do out[#out + 1] = all[i] end
    return out
end

local function names(): string[]
    local out: string[] = {}
    for _, c in ipairs(init.listCommands()) do out[#out + 1] = c.name end
    return out
end

local function info(name: string): init.CommandInfo?
    for _, c in ipairs(init.listCommands()) do
        if c.name == name then return c end
    end
    return nil
end

@test("the addon's name, version and the mixins table")
local function identity()
    expect(init.name).toBe("SuuUI")
    expect(type(init.version)).toBe("string")
    expect(init.version ~= "").toBe(true)
    expect(type(init.mixins)).toBe("table")
end

@test("print: SuuUI's prefix, every argument as text")
local function prints()
    local out = printedBy(function() init.print("a", 1, nil, true) end)
    expect(out).toContain(PREFIX .. "a 1 nil true")
end

@test("registerCommand: lower case, in registration order, with help and words")
local function registers()
    init.registerCommand("CoreATestOne", "First.", function() end, OWNER, { "on", "off" })
    init.registerCommand("coreatesttwo", "Second.", function() end, OWNER)
    local list = names()
    local one, two = 0, 0
    for i, n in ipairs(list) do
        if n == "coreatestone" then one = i end
        if n == "coreatesttwo" then two = i end
    end
    expect(one > 0 and two == one + 1).toBe(true)
    expect(info("coreatestone")).toEqual({ name = "coreatestone", help = "First.", args = { "on", "off" } })
    expect(info("coreatesttwo")).toEqual({ name = "coreatesttwo", help = "Second." })
    -- the core's own come first
    expect(list[1]).toBe("version")
end

@test("registerCommand: a name that exists, in any case, is refused")
local function duplicate()
    expect(function() init.registerCommand("VERSION", "Again.", function() end) end).toThrow("the command /suu version already exists")
end

@test("listCommands: a word list from a function; nil when it errors or gives no table")
local function argFunctions()
    init.registerCommand("coreatestfn", "Fn.", function() end, OWNER, function(): string[] return { "a", "b" } end)
    init.registerCommand("coreatesterr", "Err.", function() end, OWNER, function(): string[] error("no words") end)
    init.registerCommand("coreatestbad", "Bad.", function() end, OWNER, function(): string[] return "words" :: any end)
    expect((info("coreatestfn") :: init.CommandInfo).args).toEqual({ "a", "b" })
    expect((info("coreatesterr") :: init.CommandInfo).args).toBeNil()
    expect((info("coreatestbad") :: init.CommandInfo).args).toBeNil()
end

@test("unregisterCommands: the owner's commands go, the others keep their order")
local function unregisters()
    init.registerCommand("coreatesta", "A.", function() end, OWNER)
    init.registerCommand("coreatestb", "B.", function() end, OTHER)
    init.registerCommand("coreatestc", "C.", function() end, OWNER)
    init.unregisterCommands(OWNER)
    expect(info("coreatesta")).toBeNil()
    expect(info("coreatestc")).toBeNil()
    expect(info("coreatestb")).never.toBeNil()
    -- a removed name can be registered again
    init.registerCommand("coreatesta", "A again.", function() end, OWNER)
    expect((info("coreatesta") :: init.CommandInfo).help).toBe("A again.")
end

@test("/suu <command>: the rest of the line goes to it, trimmed; the name in any case")
local function dispatches()
    local got = mock.spy(function(_: string) end)
    init.registerCommand("coreatestrun", "Run.", got, OWNER)
    mock.slash("/suu CoreATestRun   some  rest  ")
    expect(got).toHaveBeenCalledWith("some  rest")
    mock.slash("/suuui coreatestrun")
    expect(got).toHaveBeenCalledWith("")
    expect(got).toHaveBeenCalledTimes(2)
end

@test("/suu <command> that errors: reported under the command, chat carries on")
local function commandError()
    init.registerCommand("coreatestboom", "Boom.", function() error("init-err-command") end, OWNER)
    mock.slash("/suu coreatestboom")
    local found: fault.Entry? = nil
    for _, e in ipairs(fault.entries()) do
        if e.message:find("init-err-command", 1, true) then found = e end
    end
    expect(found and found.source).toBe("/suu coreatestboom")
end

@test("/suu help lists every command; an unknown one says so first")
local function help()
    init.registerCommand("coreatesthelp", "Helps.", function() end, OWNER)
    local out = printedBy(function() mock.slash("/suu help") end)
    expect(out[1]).toBe(PREFIX .. "version " .. init.version)
    expect(out).toContain("  /suu coreatesthelp  -  Helps.")
    expect(out).toContain("  /suu version  -  Show the SuuUI and client versions.")
    local unknown = printedBy(function() mock.slash("/suu nosuchcommand") end)
    expect(unknown[1]).toBe(PREFIX .. "Unknown command \"nosuchcommand\".")
    expect(unknown[2]).toBe(PREFIX .. "version " .. init.version)
    expect(#unknown).toBe(#out + 1)
end

@test("/suu version: SuuUI's version and API, the client's build")
local function versionCommand()
    local clientVersion, clientBuild, _, toc = GetBuildInfo()
    local out = printedBy(function() mock.slash("/suu version") end)
    expect(out).toEqual({ PREFIX .. ("SuuUI %s (API %s) on client %s (build %s, interface %d)")
        :format(init.version, API_VERSION, clientVersion, clientBuild, toc) })
end

@test("/suu alone toggles the settings window")
local function bare()
    local original = settingsWindow.toggle
    local toggled = mock.spy(function() end)
    mock.module(settingsWindow, { toggle = toggled })
    mock.slash("/suu")
    mock.slash("/suu   ")
    mock.module(settingsWindow, { toggle = original })
    expect(toggled).toHaveBeenCalledTimes(2)
end
