-- Core/Timers: timers kept per owner, their errors under the owner's name,
-- all of an owner's cancelled at once.

import test, expect, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
import * as timers from "/Core/Timers"
import type Gate from "/Core/Util"
import FakeReporter from "../../fakes"
import expectNoErrors from "../../helpers"

const A = { name = "Timers Test A" }
const B = { name = "Timers Test B" }

-- an owner that is on
const alive: Gate = { on = true }

@afterEach
local function cleanup()
    timers.cancelAll(A)
    timers.cancelAll(B)
end

@test("after: runs once, then is dropped; cancelAll stops the owner's only")
local function afterRuns()
    local ran: string[] = {}
    timers.after(A, "A", alive, 1, function()
        ran[#ran + 1] = "a"
    end)
    timers.after(B, "B", alive, 1, function()
        ran[#ran + 1] = "b"
    end)
    timers.after(A, "A", alive, 2, function()
        ran[#ran + 1] = "a2"
    end)
    expect(timers.count(A)).toBe(2)
    mock.advanceTime(1.1)
    expect(ran).toEqual({ "a", "b" })
    expect(timers.count(A)).toBe(1)
    expect(timers.count(B)).toBe(0)
    timers.cancelAll(A)
    mock.advanceTime(2)
    expect(ran).toEqual({ "a", "b" })
    expect(timers.count(A)).toBe(0)
    expectNoErrors()
end

@test("every: each interval, `times` times; a handle cancelled by its owner doesn't count")
local function everyTicks()
    local n, m = 0, 0
    timers.every(A, "A", alive, 1, function()
        n += 1
    end, 2)
    local ticker = timers.every(A, "A", alive, 1, function()
        m += 1
    end)
    mock.advanceTime(3.5)
    expect(n).toBe(2)
    expect(m).toBe(3)
    expect(timers.count(A)).toBe(1)
    ticker:Cancel()
    expect(timers.count(A)).toBe(0)
    mock.advanceTime(2)
    expect(m).toBe(3)
    expectNoErrors()
end

@test("a registry of its own: an error goes under the source")
local function ownErrors()
    local r = FakeReporter.new()
    local own = timers.TimerOwners.new(r)
    own:after(A, "Timers Source", alive, 0.5, function()
        error("timers-boom")
    end)
    mock.advanceTime(1)
    expect(r.errors).toEqual({ "Timers Source: timers-boom" })
    expect(own:count(A)).toBe(0)
end

@test("an owner is required")
local function needsOwner()
    expect(function()
        timers.after(nil, "x", alive, 1, function() end)
    end).toThrow("an owner is required")
end

@test("an owner that is off: nothing starts, nothing is kept, the handle is already cancelled")
local function offOwner()
    local live: Gate = { on = false }
    local ran = 0
    local once = timers.after(A, "A", live, 1, function()
        ran += 1
    end)
    local ticker = timers.every(A, "A", live, 1, function()
        ran += 1
    end)
    expect(once:IsCancelled()).toBe(true)
    expect(ticker:IsCancelled()).toBe(true)
    expect(timers.count(A)).toBe(0)
    -- turned on later: the refused ones stay refused
    live.on = true
    mock.advanceTime(3)
    expect(ran).toBe(0)
    expectNoErrors()
end

@test("asked for while on: the release (cancelAll) is what stops it, not the owner's state later")
local function goesOff()
    local live: Gate = { on = true }
    local ran: string[] = {}
    timers.after(A, "A", live, 1, function()
        ran[#ran + 1] = "once"
    end)
    timers.every(A, "A", live, 1, function()
        ran[#ran + 1] = "tick"
    end, 2)
    live.on = false
    mock.advanceTime(1.1)
    expect(ran).toEqual({ "once", "tick" })
    timers.cancelAll(A)
    mock.advanceTime(2)
    expect(ran).toEqual({ "once", "tick" })
    expect(timers.count(A)).toBe(0)
    expectNoErrors()
end

@test("the cheap path: each timer runs through the reporter's run; one set per owner, kept while its timers come and go")
local function cheapPath()
    local r = FakeReporter.new()
    local own = timers.TimerOwners.new(r)
    local sets = (own :: any).byOwner :: { [unknown]: unknown }
    local ran = 0
    own:after(A, "A", alive, 0.5, function()
        ran += 1
    end)
    local set = sets[A]
    expect(set ~= nil).toBe(true)
    mock.advanceTime(1)
    expect(ran).toBe(1)
    expect(own:count(A)).toBe(0)
    -- (no table made for the next one: the same set)
    own:after(A, "A", alive, 0.5, function()
        ran += 1
    end)
    own:every(A, "A", alive, 0.5, function()
        ran += 1
    end, 2)
    expect(sets[A]).toBe(set)
    mock.advanceTime(1.1)
    expect(ran).toBe(4)
    expect(r.runs).toBe(4)
    expect(r.calls).toBe(0)
    expect(own:count(A)).toBe(0)
    -- released: the set goes with it
    own:cancelAll(A)
    expect(sets[A]).toBe(nil)
end

@test("handles the owner cancels itself (a debounce) don't pile up: the set stays near what is live")
local function selfCancelled()
    local own = timers.TimerOwners.new(FakeReporter.new())
    local owned = function(): { [unknown]: boolean }
        return ((own :: any).byOwner[A] :: any).handles
    end
    local function size(): number
        local n = 0
        for _ in pairs(owned()) do
            n += 1
        end
        return n
    end
    local ran = 0
    -- a long-lived ticker, then a thousand debounces: each cancels the last
    own:every(A, "A", alive, 1, function() end)
    local pending: TimerHandle? = nil
    for _ = 1, 1000 do
        local was = pending
        if was then
            was:Cancel()
        end
        pending = own:after(A, "A", alive, 5, function()
            ran += 1
        end)
    end
    expect(size() <= 2 * 32 + 2).toBe(true)
    expect(own:count(A)).toBe(2)
    -- the live ones are still kept: the last debounce runs, the release
    -- cancels the ticker
    mock.advanceTime(5.5)
    expect(ran).toBe(1)
    expect(own:count(A)).toBe(1)
    own:cancelAll(A)
    expect(own:count(A)).toBe(0)
end
