-- tests/unit/Core/Prices/PricesHelpers.wowlua
-- Shared by the tests that need prices in the price store (Core/Prices):
-- the auction house's, the Ledger's.
--
--   look(itemID, low, most?, qty?, n?, at?, name?, quality?)
--                                             one look kept, as a search's
--   scan(looks, items, names?, qualities?)   a Scan all's looks kept, every
--                                             slice run (SUUUI_PRICES_SCANNED
--                                             told)
--   wipe()                                    the store emptied

import * as mock from "wowlua:mock"
import * as prices from "/Core/Prices"

export function look(
    itemID: number,
    low: number,
    most: number?,
    qty: number?,
    n: number?,
    at: number?,
    name: string?,
    quality: number?
): boolean
    return prices.record(itemID, low, most, qty, n, name, quality, at)
end

export function scan(looks: number[], items: number, names: { [number]: string }?, qualities: { [number]: number }?)
    prices.recordScan(looks, items, names, qualities)
    local guard = 0
    while prices.scanning() and guard < 1000 do
        mock.advanceFrames(1)
        guard += 1
    end
end

export function wipe()
    while prices.scanning() do
        mock.advanceFrames(1)
    end
    local d = prices.data()
    d.prices, d.names, d.pruned = nil, nil, nil
end
