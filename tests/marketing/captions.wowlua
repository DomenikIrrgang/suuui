-- tests/marketing/captions.wowlua
-- The marketing images in their order: the file each becomes, the scene
-- screenshot it is made from (dist/screenshots/<test file>/<name>.png) and
-- its caption. tools/marketing_caption.py reads this file too: keep each
-- entry's fields in this order, each string on one line.

export type Caption = { file: string, shot: string, headline: string, subline: string }

