-- The quest log: the zone's and the endgame's.
type Quest = { title: string, zone: string, level: number, objective: string, required: number }
const QUESTS: Quest[] = {
    {
        title = "Wanted: Lieutenant Fangore",
        zone = "Eastern Plaguelands",
        level = 58,
        objective = "Lieutenant Fangore slain",
        required = 1,
    },
    {
        title = "Demon Dogs",
        zone = "Eastern Plaguelands",
        level = 54,
        objective = "Plaguehound Runt slain",
        required = 20,
    },
    {
        title = "Blood Tinged Skies",
        zone = "Eastern Plaguelands",
        level = 54,
        objective = "Plaguebat slain",
        required = 30,
    },
    {
        title = "The Scourge Cauldrons",
        zone = "Western Plaguelands",
        level = 52,
        objective = "Felstone Field Cauldron Key",
        required = 1,
    },
    {
        title = "Winterfall Activity",
        zone = "Winterspring",
        level = 60,
        objective = "Winterfall Shaman slain",
        required = 8,
    },
    { title = "Wildkin of Elune", zone = "Winterspring", level = 57, objective = "Wildkin Feather", required = 15 },
    {
        title = "Broodling Essence",
        zone = "Burning Steppes",
        level = 59,
        objective = "Broodling Essence",
        required = 8,
    },
    {
        title = "Attunement to the Core",
        zone = "Blackrock Depths",
        level = 60,
        objective = "Core Fragment",
        required = 1,
    },
}

local function takeQuests()
    for i, q in ipairs(QUESTS) do
        local id = 9100 + i
        local giver = mock.spawnUnit({ name = "Quartermaster", level = 60, reaction = "friendly", distance = 3 })
        mock.defineQuest(id, {
            title = q.title,
            text = "Go, $N.",
            objective = q.objective,
            giver = giver,
            level = q.level,
            header = q.zone,
            objectives = { { text = q.objective, required = q.required } },
        })
        mock.player:interact(giver)
        mock.advanceTime(0.5)
        scene.frames(3)
        AcceptQuest()
        mock.advanceTime(0.5)
        scene.frames(3)
        giver:despawn()
    end
end

-- The mount journal: horses, sabers and rams from the Alliance's vendors,
-- the Deathcharger, the swift ones (journal IDs as Forever's; the horses'
-- creature displays for the preview).
type Mount = { id: number, spell: number, name: string, display?: number, collected?: boolean, favorite?: boolean }
const MOUNTS: Mount[] = {
    { id = 9, spell = 470, name = "Black Stallion", display = 2402, collected = true, favorite = true },
    { id = 6, spell = 458, name = "Brown Horse", display = 2404, collected = true },
    { id = 11, spell = 472, name = "Pinto", display = 2409, collected = true },
    { id = 18, spell = 6648, name = "Chestnut Mare", display = 2405, collected = true },
    { id = 93, spell = 23229, name = "Swift Brown Steed", collected = true, favorite = true },
    { id = 92, spell = 23228, name = "Swift White Steed", collected = true },
    { id = 91, spell = 23227, name = "Swift Palomino" },
    { id = 26, spell = 8394, name = "Striped Frostsaber", collected = true },
    { id = 31, spell = 10789, name = "Spotted Frostsaber" },
    { id = 34, spell = 10793, name = "Striped Nightsaber", collected = true },
    { id = 55, spell = 17229, name = "Winterspring Frostsaber" },
    { id = 85, spell = 23221, name = "Swift Frostsaber" },
    { id = 87, spell = 23219, name = "Swift Mistsaber" },
    { id = 21, spell = 6777, name = "Gray Ram", collected = true },
    { id = 24, spell = 6898, name = "White Ram" },
    { id = 25, spell = 6899, name = "Brown Ram" },
    { id = 95, spell = 23239, name = "Swift Gray Ram" },
    { id = 96, spell = 23240, name = "Swift White Ram" },
    { id = 69, spell = 17481, name = "Deathcharger", collected = true, favorite = true },
}

local function stable()
    local journal: { [number]: mock.MountData } = {}
    for _, m in ipairs(MOUNTS) do
        journal[m.id] = {
            spellID = m.spell,
            name = m.name,
            icon = C_Spell.GetSpellTexture(m.spell),
            sourceType = 3,
            display = m.display,
            faction = 1,
            collected = m.collected or false,
            favorite = m.favorite,
        }
    end
    mock.setMounts(journal)
end

local function setup()
    scene.begin()
    mock.moveTo({ mapID = 1429, zone = "Elwynn Forest", subZone = "Goldshire", x = 0.42, y = 0.65, facing = 0.8 })
    mage.dress()
    scene.fillBags(BAGS)
    stable()
    takeQuests()
    local book = SuuUI.GetModule("spellbook")
    if book then
        book:Set("unlearned", false)
    end
    scene.say("CHAT_MSG_GUILD", "Odrik", "raid invites for Molten Core at 8, bring fire resist")
    scene.say("CHAT_MSG_GUILD", "Maevria", "grats on the staff Elowyn!")
    scene.say("CHAT_MSG_SAY", "Brannoc", "anyone selling Runecloth?")
    scene.say("CHAT_MSG_CHANNEL", "Corwen", "LFM Scholomance, need healer and 1 dps", {
        index = 4,
        name = "LookingForGroup",
    })
    scene.say("CHAT_MSG_WHISPER", "Liraleth", "bring water for the raid pls <3")
    scene.say("CHAT_MSG_GUILD", "Seldra", "o/ evening all")
    scene.seconds(6)
end

local function close()
    if CharacterFrame and CharacterFrame:IsShown() then
        mock.pressBinding("TOGGLECHARACTER0")
    end
    scene.frames(10)
end

@if(features.marketing)
@test("character")
local function character()
    setup()
    mock.pressBinding("TOGGLECHARACTER0")
    scene.seconds(1)
    -- (in the emulator the side tabs' marker covers the chosen tab's label,
    -- "Stats", at the same frame level: the tabs lifted over it)
    for i = 1, 3 do
        local tab = frames.asButton(tbl.field(_G, "PaperDollSidebarTab" .. i))
        if tab then
            tab:SetFrameLevel(tab:GetFrameLevel() + 4)
        end
    end
    scene.frames(2)
    mock.screenshot("character")
end

@if(features.marketing)
@test("bags")
local function bags()
    close()
    SuuUI.ToggleBags()
    scene.seconds(1)
    mock.screenshot("bags")
    SuuUI.ToggleBags()
end

@if(features.marketing)
@test("spellbook")
local function spellbook()
    scene.frames(10)
    mock.pressBinding("TOGGLESPELLBOOK")
    scene.seconds(1)
    mock.screenshot("spellbook")
    mock.pressBinding("TOGGLESPELLBOOK")
end

@if(features.marketing)
@test("world map")
local function worldMap()
    scene.frames(10)
    -- the tracker away (the map's quest log lists the same)
    local tracker = frames.asFrame(tbl.field(trackerModule, "frame"))
    if tracker then
        tracker:SetAlpha(0)
    end
    scene.frames(5)
    mock.pressBinding("TOGGLEWORLDMAP")
    scene.seconds(1)
    mock.screenshot("world-map")
    mock.pressBinding("TOGGLEWORLDMAP")
    if tracker then
        tracker:SetAlpha(1)
    end
end

@if(features.marketing)
@test("collections")
local function collections()
    scene.frames(10)
    SuuUI.ToggleCollections("mounts")
    -- (the model shown after two seconds without the game's answer)
    scene.seconds(3)
    mock.screenshot("collections")
    SuuUI.ToggleCollections()
end

@if(features.marketing)
@test("settings")
local function settingsPage()
    scene.frames(10)
    SuuUI.OpenSettings("nameplates")
    scene.seconds(1)
    mock.screenshot("settings")
end
