@if(features.marketing)
@test("guild")
local function guild()
    local members: mock.GuildMemberData[] = {}
    for _, m in ipairs(GUILD) do
        members[#members + 1] = {
            name = m.name,
            class = m.class,
            race = m.race,
            level = m.name == "Dorrin" and 47 or 60,
            rank = m.rank,
            zone = m.zone,
            note = m.note,
            online = m.online or false,
            status = m.status,
            lastOnline = m.away,
        }
    end
    mock.joinGuild({
        name = "Wardens of the Dawn",
        rank = 2,
        ranks = {
            { name = "Guild Master" },
            { name = "Officer" },
            { name = "Raider" },
            { name = "Member" },
            { name = "Initiate" },
        },
        motd = "Molten Core tonight at 8. Bring fire resist and flasks!",
        info = "A friendly raiding guild. Raids Wed, Sun.",
        members = members,
    })
    mock.advanceTime(1)
    scene.frames(10)
    mock.pressBinding("TOGGLEGUILDTAB")
    scene.frames(5)
    -- its roster
    local tab = frames.asButton(tbl.field(gameFrame("CommunitiesFrame"), "RosterTab"))
    if tab and tab:IsShown() then
        mock.click(tab)
        mock.hover(nil)
    end
    scene.seconds(1)
    mock.screenshot("guild")
end
