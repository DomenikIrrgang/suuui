--- Her character sheet's numbers (the client's answers).
export function stats()
    mock.player:setStats(
        ({
            stat = {
                [1] = { 40, 40, 0, 0 },
                [2] = { 42, 42, 0, 0 },
                [3] = { 214, 214, 0, 0 },
                [4] = { 318, 318, 0, 0 },
                [5] = { 126, 126, 0, 0 },
            },
            armor = { 1342, 1342, 1342, 0, 0 },
            itemLevel = { 76.4, 76.4 },
            movement = { 0, 7, 7, 4.72 },
            damage = { 104, 156, 0, 0, 0, 0, 1 },
            attackSpeed = { 2.9, 0 },
            attackPower = { 80, 0, 0 },
        } :: unknown) :: mock.PlayerStats
    )
end

--- Elowyn dressed, her bars and spellbook set.
export function dress()
    scene.wear(GEAR)
    scene.spellbook(SPELLBOOK, { name = "Mage", icon = 626001 })
    scene.bars(BARS)
    stats()
end
