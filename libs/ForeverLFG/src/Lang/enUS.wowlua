-- ForeverLFG/Lang/enUS.wowlua
-- English for the chat parser: what players type besides the activity names
-- the tool gives (abbreviations, nicknames, slang), the words for looking
-- for a group or for more, roles, classes, and what isn't group content.
-- Tuned on recorded chat (/suu probe lfg record, tools/lfg_parse.lua).

import type LangModule, ParseResult, Hits from "../Parser"

-- registered by init as LFG.Lang.Register("enUS", enUS)
export const enUS = {
    script = "latin",
    words = {
        -- a group looking for players
        group = {
            "lfm",
            "lf1m",
            "lf2m",
            "lf3m",
            "lf4m",
            "need",
            "needs",
            "needed",
            "looking for more",
            "lf more",
            "lf1",
            "lf2",
            "lf3",
            "lf4",
            "1 more",
            "2 more",
            "3 more",
            "4 more",
            "last spot",
            "spot open",
            "spots open",
            "wtj",
        },
        -- a player looking for a group
        player = {
            "lfg",
            "lf group",
            "lf grp",
            "looking for group",
            "looking for a group",
            "lf party",
            "lf a group",
            "lfp",
            "lf dungeon",
            "lf dung",
            "need group",
            "need a group",
            "any group",
            "looking for a party",
            "lookin for group",
            "can join",
            "can tank",
            "can heal",
        },
        -- not group content
        noise = {
            "wts",
            "wtb",
            "wtt",
            "lfw",
            "selling",
            "buying",
            "recruiting",
            "is recruiting",
            "recruit",
            "recruits",
            "boost",
            "boosts",
            "boosting",
            "carry",
            "carries",
            "summons",
            "summoning",
            "ports",
            "portals",
            "enchants",
            "tips welcome",
            "free tips",
        },
        roles = {
            tank = { "tank", "tanks", "tanky", "tankie", "tanking", "tnk", "mt", "prot" },
            healer = { "heal", "heals", "healer", "healers", "healz", "heals", "hlr", "resto", "holy", "disc" },
            damage = { "dps", "dd", "damage", "rdps", "mdps", "ranged dps", "melee dps", "caster dps", "caster" },
        },
        classes = {
            WARRIOR = { "warrior", "warriors", "warr", "warri", "war" },
            PALADIN = { "paladin", "paladins", "pala", "pally", "pal" },
            HUNTER = { "hunter", "hunters", "hunt", "hunta" },
            ROGUE = { "rogue", "rogues", "rog" },
            PRIEST = { "priest", "priests" },
            SHAMAN = { "shaman", "shamans", "shammy", "sham", "shamy" },
            MAGE = { "mage", "mages" },
            WARLOCK = { "warlock", "warlocks", "lock", "locks" },
            DRUID = { "druid", "druids", "drood", "dudu", "boomkin", "feral" },
        },
    },
    -- "lf" before a role is a group ("LF tank for RFK"); before an activity
    -- it's a player ("LF RFK")
    Extract = function(hay: string, r: ParseResult, hits: Hits, norm: string)
        if hay:find(" lf ", 1, true) then
            if next(r.roles) or next(r.classes) then
                hits.group = true
            else
                hits.player = true
            end
        end
        -- "1 tank", "2 dps": that many open for the role
        local open = 0
        for _, w in ipairs({ "tanks?", "heals?", "healers?", "dps" }) do
            local n = norm:match(" (%d) " .. w .. " ")
            if n then
                open = open + (tonumber(n) or 0)
            end
        end
        if open > 0 then
            r.need = r.need or open
            hits.group = true
        end
    end,
    activities = {
        ["dungeon:rfc"] = { "ragefire chasm", "ragefire", "rfc" },
        ["dungeon:wc"] = { "wailing caverns", "wailing", "wc" },
        ["dungeon:dm"] = { "deadmines", "deadmine", "dead mines", "van cleef", "vancleef", "vc", "dm" },
        ["dungeon:sfk"] = { "shadowfang keep", "shadowfang", "sfk" },
