-- ForeverLFG/Lang/zhCN.wowlua
-- Chinese for the chat parser, Simplified and Traditional in one module
-- (both are posted on Forever's English shards, found in game): the
-- dungeons' Chinese names and nicknames ("怒焰", "墓地", "達拉然"), the
-- recruiting words ("缺", "来个", "-1"), roles with counts ("缺1補 1坦
-- 2DPS", "DPS-1", "来个N": N is 奶, a healer). Chinese writes without
-- spaces, so phrases match anywhere in a line.
-- Tuned on recorded chat (2026-10-15: 25 Chinese lines, /suu probe lfg
-- record, tools/lfg_parse.lua --lang zhCN); only names that are certain.

import type LangModule, ParseResult, Hits from "../Parser"

-- A role's words as they come with a count (lower case: the parser's
-- normalising lowers "DPS" and "N").
local ROLE: { [string]: string } = { ["坦"] = "tank", ["t"] = "tank", ["補"] = "healer", ["补"] = "healer", ["奶"] = "healer",
               ["n"] = "healer", ["治療"] = "healer", ["治疗"] = "healer", ["dps"] = "damage", ["輸出"] = "damage",
               ["输出"] = "damage" }
local ROLE_WORDS = { "治療", "治疗", "輸出", "输出", "dps", "坦", "補", "补", "奶", "n", "t" }

-- registered by init as LFG.Lang.Register("zhCN", zhCN)
export const zhCN = {
    script = "han",
    words = {
        -- a group looking for players: 缺 (short of), 来个 (one more), 招 (recruiting)
        group = { "來個", "来个", "來一個", "来一个", "缺", "招人", "招", "速來", "速来", "+++" },
        -- a player looking for a group: 求組 (looking for a group), 可坦 (can tank)
        player = { "求組", "求组", "求隊", "求队", "找隊", "找队", "找團", "找团", "可坦", "可補", "可补", "可奶" },
        -- not group content: guilds, trading, boosting
        noise = { "公會", "公会", "出售", "收購", "收购", "代練", "代练", "金幣", "金币" },
        roles = {
            tank = { "坦克", "坦" },
            healer = { "治療", "治疗", "奶爸", "奶媽", "奶妈", "奶", "補", "补" },
            damage = { "輸出", "输出" },
        },
        classes = {
            WARRIOR = { "戰士", "战士" },
            PALADIN = { "聖騎士", "圣骑士", "聖騎", "圣骑" },
            HUNTER = { "獵人", "猎人" },
            ROGUE = { "盜賊", "盗贼" },
            PRIEST = { "牧師", "牧师" },
            SHAMAN = { "薩滿", "萨满" },
            MAGE = { "法師", "法师" },
            WARLOCK = { "術士", "术士" },
            DRUID = { "德魯伊", "德鲁伊", "小德" },
        },
    },
    -- counts: "缺1補", "1坦", "2dps", "dps-1", "-1 補", "来个n" (one healer)
    Extract = function(hay: string, r: ParseResult, hits: Hits, norm: string)
        local open = 0
        local text = norm
        local function take(role: string, n: string | number)
            open = open + (tonumber(n) or 1)
            local key = ROLE[role]
            if key then r.roles[key] = true end
        end
        for _, w in ipairs(ROLE_WORDS) do
            text = text:gsub("缺 ?(%d) ?" .. w, function(n) take(w, n); return " " end)
            text = text:gsub(w .. " ?%-(%d)", function(n) take(w, n); return " " end)
            text = text:gsub("%-(%d) ?" .. w, function(n) take(w, n); return " " end)
            text = text:gsub("(%d) ?" .. w, function(n) take(w, n); return " " end)
        end
        -- "DPS-1" reaches here as "dps 1" (the parser splits a word from a dash)
        text = text:gsub("dps (%d)", function(n) take("dps", n); return " " end)
        for _, one in ipairs({ "来个n", "來個n", "来n", "來n", "来个 n", "來個 n" }) do
            if text:find(one, 1, true) then take("n", 1) end
        end
        if open > 0 then r.need = r.need or open; hits.group = true end
        -- "可坦" (can tank), "可補" (can heal): the role a player offers
        for phrase, role in pairs({ ["可坦"] = "tank", ["可補"] = "healer", ["可补"] = "healer", ["可奶"] = "healer" }) do
            if norm:find(phrase, 1, true) then r.roles[role] = true end
        end
    end,
    activities = {
        ["dungeon:rfc"] = { "怒焰裂谷", "怒焰" },
        ["dungeon:wc"] = { "哀嚎洞穴", "哀嚎" },
        ["dungeon:dm"] = { "死亡礦井", "死亡矿井", "礦井", "矿井" },
        ["dungeon:sfk"] = { "影牙城堡", "影牙" },
        ["dungeon:bfd"] = { "黑暗深淵", "黑暗深渊" },
        ["dungeon:stocks"] = { "暴風城監獄", "暴风城监狱", "監獄", "监狱" },
        ["dungeon:gnomer"] = { "諾莫瑞根", "诺莫瑞根", "諾莫", "诺莫" },
        ["dungeon:rfk"] = { "剃刀沼澤", "剃刀沼泽", "沼澤", "沼泽" },
        ["dungeon:smgy"] = { "血色墓地", "墓地" },
        ["dungeon:smlib"] = { "血色圖書館", "血色图书馆", "圖書館", "图书馆" },
        ["dungeon:smarm"] = { "血色武器庫", "血色武器库", "武器庫", "武器库" },
        ["dungeon:smcath"] = { "血色大教堂", "大教堂" },
        ["dungeon:sm"] = { "血色修道院", "血色" },
        ["dungeon:rfd"] = { "剃刀高地" },
        ["dungeon:ulda"] = { "奧達曼", "奥达曼" },
        ["dungeon:zf"] = { "祖爾法拉克", "祖尔法拉克" },
        ["dungeon:mara"] = { "瑪拉頓", "玛拉顿" },
        ["dungeon:st"] = { "阿塔哈卡神廟", "阿塔哈卡神庙", "神廟", "神庙" },
        ["dungeon:brd"] = { "黑石深淵", "黑石深渊" },
        ["dungeon:lbrs"] = { "黑石塔下層", "黑石塔下层", "黑下" },
        ["dungeon:ubrs"] = { "黑石塔上層", "黑石塔上层", "黑上" },
        ["dungeon:diremaul"] = { "厄運之槌", "厄运之槌", "厄運", "厄运" },
        ["dungeon:strat"] = { "斯坦索姆" },
        ["dungeon:scholo"] = { "通靈學院", "通灵学院", "通靈", "通灵" },
        ["dungeon:excavation"] = { "挖掘場", "挖掘场" },
        ["dungeon:lordaeron"] = { "洛丹倫廢墟", "洛丹伦废墟", "洛丹倫", "洛丹伦" },
        ["dungeon:dalaran"] = { "達拉然", "达拉然" },
        ["raid:mc"] = { "熔火之心", "熔火" },
        ["raid:ony"] = { "奧妮克希亞", "奥妮克希亚" },
        ["raid:bwl"] = { "黑翼之巢", "黑翼" },
        ["raid:zg"] = { "祖爾格拉布", "祖尔格拉布" },
        ["raid:naxx"] = { "納克薩瑪斯", "纳克萨玛斯" },
        ["zone:wetlands"] = { "濕地", "湿地" },
        ["zone:barrens"] = { "貧瘠之地", "贫瘠之地" },
        ["zone:ashenvale"] = { "灰谷" },
        ["zone:stranglethorn"] = { "荊棘谷", "荆棘谷" },
        ["zone:duskwood"] = { "暮色森林" },
        ["zone:westfall"] = { "西部荒野" },
        ["zone:durotar"] = { "杜隆塔爾", "杜隆塔尔" },
        ["zone:mulgore"] = { "莫高雷" },
        ["zone:hillsbrad"] = { "希爾斯布萊德丘陵", "希尔斯布莱德丘陵" },
        ["zone:arathi"] = { "阿拉希高地" },
    },
} :: LangModule
