-- ForeverLFG/init.wowlua
-- The package's main module ("foreverlfg"): the public table, LFG, as SuuUI
-- publishes it (SuuUI.LFG, Docs/API.md, Docs/ForeverLFG.md), with the
-- language modules registered. The other modules are importable on their
-- own ("foreverlfg/Store", ...) under the names in their headers.
--
--   import lfg from "foreverlfg"
--   import type ForeverLFG, Entry from "foreverlfg"
-- (wowlua 0.9.1 types values imported from another package as any: annotate
-- with ForeverLFG where the type matters, see Docs/port-notes/foreverlfg.md)

import * as core from "./LFG"
import * as cat from "./Catalogue"
import * as chatSource from "./Chat"
import * as interest from "./Interest"
import * as parse from "./Parser"
import * as list from "./Store"
import * as tool from "./Tool"
import enUS from "./Lang/enUS"
import koKR from "./Lang/koKR"
import zhCN from "./Lang/zhCN"

-- The types a user of the library needs, from here.
export type Config = core.Config
export type Listener = core.Listener
export type Part = core.Part
export type Activity = cat.Activity
export type ChatSource = chatSource.ChatSource
export type Interest = interest.Interest
export type ParseResult = parse.ParseResult
export type LangModule = parse.LangModule
export type Entry = list.Entry
export type Filter = list.Filter
export type ToolSource = tool.ToolSource
export type Listing = tool.Listing

-- The public table (SuuUI.LFG), typed.
export type ForeverLFG = core.ForeverLFG

-- Every language module ships with the library and is registered here;
-- only the chosen ones are used (LFG.Languages(), and by script).
parse.lang.Register("enUS", enUS)
parse.lang.Register("koKR", koKR)
parse.lang.Register("zhCN", zhCN)

-- The sources and the matching, started and stopped with the library, in
-- the order they always had (Chat, Interest, Tool; stopped the other way).
core.addPart(chatSource.part)
core.addPart(interest.part)
core.addPart(tool.part)

-- The public table: LFG.wowlua made it with its own fields; the rest here.
export const lfg = core.lfg
lfg.Catalogue = cat.catalogue
lfg.Chat = chatSource.chat
lfg.IsHiddenChannel = chatSource.isHiddenChannel
lfg.Interest = interest.interest
lfg.Watch = interest.watch
lfg.Watches = interest.watches
lfg.Languages = interest.languages
lfg.MatchReasons = interest.matchReasons
lfg.ContactedAt = interest.contactedAt
lfg.Social = interest.social
lfg.Parser = parse.parser
lfg.Lang = parse.lang
lfg.Store = list.store
lfg.Entries = list.entries
lfg.Entry = list.entry
lfg.Tool = tool.tool
lfg.Refresh = tool.refresh
lfg.ToolAge = tool.toolAge
lfg.Listing = tool.listing
lfg.Delist = tool.delist
lfg.CanInvite = tool.canInvite
lfg.Invite = tool.invite
lfg.Whisper = tool.whisper
