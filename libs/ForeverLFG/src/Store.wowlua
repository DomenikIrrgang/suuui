-- ForeverLFG/Store.wowlua
-- The merged list. One entry per leader (their whole name, "Suther
-- Stargazer"): what the tool says about them and what they posted in chat,
-- side by side in entry.sources, merged into the entry's own fields with
-- the tool's word first. Chat posts expire (LFG.config.chatExpiry) unless
-- posted again; tool results go when a search no longer has them.
--
--   LFG.Entries(filter) / LFG.Entry(key)        (entries, entry)
--   events: EntryAdded(entry), EntryUpdated(entry), EntryRemoved(entry, reason)
--
-- entry = {
--   key, intent ("group" | "player"), activities = { key }, quests = { id },
--   roles = { needed = { tank = n|true, healer, damage }, offered = { ... },
--             has = { tank = n, healer, damage, none } (a group's members by role, from the tool) },
--   classes = { WARRIOR = true, ... }, need, members = { have, max },
--   level = { min, max }, leader = { name, class, level, guid },
--   text, confidence, firstSeen, lastSeen, you,
--   sources = { tool = { ... } | nil, chat = { ... } | nil },
-- }

import config, fire, now from "./LFG"
import catalogue from "./Catalogue"
import type ToolSource from "./Tool"
import type ChatSource from "./Chat"

-- Roles by count (a group's open spots, n) or true (asked for, offered).
export type RoleMap = { [string]: number | boolean }

export type Leader = { name?: string, class?: string, level?: number, guid?: string }

export type Entry = {
    key: string,
    intent?: string,                -- "group" | "player"
    activities: string[],
    quests: number[],
    roles: { needed: RoleMap, offered: RoleMap, has?: { [string]: number } },
    classes: { [string]: boolean },
    need?: number,
    members?: number[],             -- { have, max }
    level?: { [number]: number? },  -- { min, max }
    leader: Leader,
    text: string,
    confidence: number,
    you: boolean,
    firstSeen: number,
    lastSeen: number,
    sources: { tool?: ToolSource, chat?: ChatSource },
}

-- What LFG.Entries keeps.
export type Filter = {
    intent?: string,
    kinds?: { [string]: boolean },
    activities?: { [string]: boolean },
    sources?: { [string]: boolean },
    minConfidence?: number,
    search?: string,
    notYou?: boolean,
}

export type StoreApi = {
    Put: (key: string?, source: string, data: any) -> Entry?,
    Drop: (key: string, source: string, reason: string) -> (),
    Rename: (old: string, new: string) -> (),
    Each: (fn: (key: string, e: Entry) -> ()) -> (),
    Clear: () -> (),
    Expire: () -> (),
}

export const store = {} :: StoreApi
local S = store

local byKey: { [string]: Entry } = {}

local function union(into: any[], list: any[]?, seen: { [any]: boolean })
    for _, v in ipairs(list or {}) do
        if not seen[v] then seen[v] = true; into[#into + 1] = v end
    end
end

-- A short fingerprint of what a viewer sees, to tell an update from a repost.
local function signature(e: Entry): string
    local members = e.members
    local parts: string[] = { e.intent or "", table.concat(e.activities, ","), e.text or "", tostring(e.need),
                              members and (members[1] .. "/" .. members[2]) or "" }
    for _, side in ipairs({ "needed", "offered" }) do
        for _, role in ipairs({ "tank", "healer", "damage" }) do parts[#parts + 1] = tostring((e.roles :: any)[side][role]) end
    end
    for _, role in ipairs({ "tank", "healer", "damage", "none" }) do parts[#parts + 1] = tostring(e.roles.has and e.roles.has[role]) end
    return table.concat(parts, "|")
end

-- The entry's own fields from its sources (the tool's first).
local function rebuild(e: Entry)
    local tool, chat = e.sources.tool, e.sources.chat
    local acts: string[], seen: { [any]: boolean } = {}, {}
    union(acts, tool and tool.activities, seen)
    union(acts, chat and chat.activities, seen)
    e.activities = acts
    local quests: number[], seenQ: { [any]: boolean } = {}, {}
    union(quests, chat and chat.quests, seenQ)
    e.quests = quests
    e.intent = (tool and tool.intent) or (chat and chat.intent)
    e.roles = { needed = {}, offered = {} }
    if tool then
        if tool.has then
            local has: { [string]: number } = {}
            for k, v in pairs(tool.has) do has[k] = v end
            e.roles.has = has
        end
        for k, v in pairs(tool.needed or {}) do e.roles.needed[k] = v end
        for k, v in pairs(tool.offered or {}) do e.roles.offered[k] = v end
    elseif chat then
        local side: RoleMap = chat.intent == "player" and e.roles.offered or e.roles.needed
        for k, v in pairs(chat.roles or {}) do side[k] = v end
    end
    e.classes = (chat and chat.classes) or {}
    e.need = (tool and tool.need) or (chat and chat.need)
    e.members = (tool and tool.members) or (chat and chat.members)
    local leader = tool and tool.leader
    local lvl = leader and leader.level
    e.level = (chat and chat.level) or (lvl and { lvl, lvl })
    e.leader = (tool and tool.leader) or { name = e.key, guid = chat and chat.guid, class = chat and chat.class }
    e.leader.name = e.leader.name or e.key
    local comment = tool and tool.comment
    e.text = (comment and comment ~= "") and comment or (chat and chat.text) or ""
    e.confidence = tool and 1 or (chat and chat.confidence) or 0
    e.you = (tool and tool.self) or (chat and chat.self) or false
end

function S.Put(key: string?, source: string, data: any): Entry?
    if not key or key == "" then return end
    local t = now()
    local e = byKey[key]
    local new = not e
    if not e then
        e = { key = key, sources = {}, firstSeen = t } :: Entry
        byKey[key] = e
    end
    local before = not new and signature(e)
    local sources = e.sources :: any
    sources[source] = data
    e.lastSeen = t
    rebuild(e)
    if new then
        fire("EntryAdded", e)
    elseif signature(e) ~= before then
        fire("EntryUpdated", e)
    else
        -- the same again (a repost): only fresher
        fire("EntryRefreshed", e)
    end
    return e
end

function S.Drop(key: string, source: string, reason: string)
    local e = byKey[key]
    local sources = e and e.sources :: any
    if not (e and sources[source]) then return end
    sources[source] = nil
    if not next(sources) then
        byKey[key] = nil
        fire("EntryRemoved", e, reason)
    else
        rebuild(e)
        fire("EntryUpdated", e)
    end
end

-- A key changing (a tool result whose leader's name came later).
function S.Rename(old: string, new: string)
    local e = byKey[old]
    if not e or old == new then return end
    byKey[old] = nil
    local other = byKey[new]
    if other then
        local into = other.sources :: any
        for source, data in pairs(e.sources :: any) do into[source] = into[source] or data end
        rebuild(other)
        fire("EntryRemoved", e, "merged")
        fire("EntryUpdated", other)
    else
        e.key = new
        byKey[new] = e
        rebuild(e)
        fire("EntryUpdated", e)
    end
end

function S.Each(fn: (key: string, e: Entry) -> ())
    for key, e in pairs(byKey) do fn(key, e) end
end

function S.Clear()
    for key, e in pairs(byKey) do
        byKey[key] = nil
        fire("EntryRemoved", e, "stopped")
    end
end

-- Chat posts out of date.
function S.Expire()
    local t, limit = now(), config.chatExpiry or 300
    local gone: string[] = {}
    for key, e in pairs(byKey) do
        local chat = e.sources.chat
        if chat and t - (chat.lastPost or 0) > limit then gone[#gone + 1] = key end
    end
    for _, key in ipairs(gone) do S.Drop(key, "chat", "expired") end
end

--------------------------------------------------------------------------------
-- Reading the list
--------------------------------------------------------------------------------

export function entry(key: string): Entry? return byKey[key] end

-- filter = { intent, kinds = { dungeon = true, ... }, activities = { key = true },
--            sources = { tool = true, chat = true }, minConfidence, search, notYou }
export function entries(filter: Filter?): Entry[]
    local f: Filter = filter or {}
    local wanted: { [string]: boolean }?
    if f.activities then
        local w: { [string]: boolean } = {}
        for key in pairs(f.activities) do
            for _, k in ipairs(catalogue.Expand(key)) do w[k] = true end
        end
        wanted = w
    end
    local out: Entry[] = {}
    for _, e in pairs(byKey) do
        local keep = true
        if f.intent and e.intent ~= f.intent then keep = false end
        if keep and f.notYou and e.you then keep = false end
        if keep and f.minConfidence and e.confidence < f.minConfidence then keep = false end
        local sources = f.sources
        if keep and sources then
            keep = false
            for source in pairs(e.sources :: any) do if sources[source] then keep = true end end
        end
        local kinds = f.kinds
        if keep and (kinds or wanted) then
            keep = false
            for _, key in ipairs(e.activities) do
                for _, k in ipairs(catalogue.Expand(key)) do
                    local a = catalogue.Get(k)
                    if (not kinds or (a and kinds[a.kind])) and (not wanted or wanted[k]) then keep = true end
                end
            end
            if not keep and kinds and kinds.quest and #e.quests > 0 then keep = true end
        end
        local search = f.search
        if keep and search and search ~= "" then
            local hay = (e.key .. " " .. (e.text or "")):lower()
            keep = hay:find(search:lower(), 1, true) ~= nil
        end
        if keep then out[#out + 1] = e end
    end
    table.sort(out, function(a: Entry, b: Entry) return (a.lastSeen or 0) > (b.lastSeen or 0) end)
    return out
end
